			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "Paimon ha una domanda: quando il seme germoglierà, crescerà qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420102,
					"content": "Non lo so, ma so che l'importante è il metodo, non il risultato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420103,
					"content": "Usare l'alchimia per risvegliare a Teyvat la vita proveniente da altri mondi sarebbe un grande passo nella mia comprensione dell'essenza della vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420104,
					"content": "Dopo il risveglio, ogni creazione sarà possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420105,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420106,
					"content": "Ahah... È ancora difficile da comprendere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420107,
					"content": "N-No! Paimon non è scema! Ma cosa diventerà il seme? Non è più interessante di quello che stavi dicendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420108,
					"content": "Non sembra che tu abbia capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "Beh, se dovesse diventare un frutto delizioso, offrirò io la cena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420111,
					"content": "Sì! Paimon ci conta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420112,
					"content": "Sai come accontentare Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "Beh, diciamo che... a volte devo prendermi cura di una bambina. È un'altra lunga storia, temo. Immagino sia una delle poche discipline non legate all'alchimia in cui me la cavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420115,
					"content": "L'oggetto della mia prima ricerca erano gli elementi. In questo mondo, manipolare gli elementi richiede una Visione, anche se non vedo niente di simile con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420116,
					"content": "Devo ancora capire come tu faccia a manipolare liberamente la forza elementale. Ho qualche domanda al riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420117,
					"content": "Prima di tutto: hai qualche organo in più? Due cuori, quattro stomaci... Cose del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420118,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "Affascinante. E questa bambina fluttuante è... collegata al tuo corpo in qualche modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420121,
					"content": "Che domanda stupida! Non vedi la distanza tra noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420122,
					"content": "E un'altra cosa, si dice PAIMON! Non \"bambina fluttuante\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420123,
					"content": "Stavo considerando la vaga possibilità che tu fossi un organo esterno. Magari c'è una forza invisibile che vi collega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420124,
					"content": "Ho incontrato Paimon durante i miei viaggi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "Oh, questo esclude tale possibilità. Mi chiedo se Paimon non abbia condotto il potere elementale a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420127,
					"content": "Ma questo significherebbe che il potere elementale di Paimon riuscirebbe a perforare quella roccia a una profondità di almeno dieci metri. O a invertire il flusso della cascata a sud del Villaggio Acquachiara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420128,
					"content": "Mmmh. No, non può essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420129,
					"content": "Ehi! Non si può mai sapere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420130,
					"content": "In quel caso, sembrerebbe che non ci sia alcuna differenza palese tra la composizione del tuo corpo e quello degli umani di questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420131,
					"content": "Dato che c'è una discrepanza evidente nella ricerca, pare che solo la sperimentazione condurrà a una risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420132,
					"content": "Per prima cosa, questo misterioso potere elementale. Vorrei esaminare il modo esatto in cui si manifesta all'esterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420133,
					"content": "Permettimi di attirare alcuni Melmosi in quest'area. Sconfiggili usando il metodo che sia più naturale per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420134,
					"content": "Eh? Non mi sembra molto scientifico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420135,
					"content": "Un'osservazione chiara e diretta è obbligatoria per la riuscita di un esperimento. Questo è solo un semplice esercizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420136,
					"content": "Ovviamente, se desideri affrontare una sfida più impegnativa, posso richiamare sei Oceanidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420137,
					"content": "Melmosi! I Melmosi vanno benissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420138,
					"content": "Non so, mi sembra una seccatura inutile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "Beh, preparati. I Melmosi saranno qui da un momento all'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420139,
					"content": "L'importante è che non mi ritrovi in mezzo a un attacco di imitatori di Hydro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "Ho pescato Paimon con una canna da pesca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "Non che io sappia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "Hai capito i secondi fini di Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "È quello che voglio sapere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
		{
			"id": 1104203,
			"completionStepIds": [
				1104203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104203",
							"2"
						],
						"stepId": 1104203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420301,
					"content": "Ottimo lavoro. Hai sentito qualcosa al di fuori dell'ordinario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420302,
					"content": "#Se ti sei ferit{F#a}{M#o}, ho alcune pozioni di emergenza pronte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420303,
					"content": "Neanche un graffio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "Eccellente. Secondo le mie osservazioni, la manifestazione del flusso elementale esterno è avvenuta secondo le previsioni, le reazioni elementali sono normali. Niente di anomalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420306,
					"content": "Ora che sappiamo che il flusso esterno si manifesta normalmente, testiamo il flusso interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420307,
					"content": "Flusso interno... Come si testa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420308,
					"content": "È semplice. Uso l'alchimia per creare una pozione che estragga il potere elementale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420309,
					"content": "Se il potere elementale è conservato o accumulato fisicamente dentro il tuo corpo, questa pozione potrebbe portare a una reazione elementale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420310,
					"content": "Mi si rivolterà lo stomaco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "Terrificante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420313,
					"content": "Non preoccuparti, nel normale corso degli eventi sentirai solo un po' di nausea, non subirai danni fisici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420314,
					"content": "E nell'anomalo corso degli eventi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420315,
					"content": "Ho già ultimato i preparativi necessari qualora dovesse succedere qualcosa di inaspettato. Cerca di non preoccuparti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420316,
					"content": "Non è molto rassicurante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "Beh, non è vero che non ci sono rischi. Ma se qualcosa blocca il tuo flusso elementale, saremo in grado di localizzarlo con questo test.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420318,
					"content": "Ti avverto solo di una cosa: se avviene una reazione elementale interna per qualsiasi altra ragione, quello è un brutto segno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420319,
					"content": "È come un esame medico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "Sì! È un modo eccellente per verificare la situazione. Prima di iniziare, alla pozione che useremo per il test manca un catalizzatore. Dobbiamo trovarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420321,
					"content": "È un tipo di minerale chiamato Argento astrale, ma purtroppo non tutto fa al caso nostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420322,
					"content": "Ti porto al mio accampamento. Possiamo raccogliere Argento astrale durante il tragitto: ti mostrerò i candidati adatti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420323,
					"content": "Se tutto andrà secondo i piani, potremo iniziare a preparare la pozione una volta arrivati all'accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420324,
					"content": "Paimon ha ancora dubbi sulla sicurezza di questo test, ma sembra che ci sia un lato positivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420325,
					"content": "Teniamo gli occhi aperti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420311,
					"content": "Si cristallizzerà dentro il mio stomaco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "Ho solo un po' di freddo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104205",
							"2"
						],
						"stepId": 1104205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "Questo è il mio accampamento. Ho aggiunto al miscuglio i materiali che abbiamo raccolto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420502,
					"content": "Mentre aspettiamo, dai un'occhiata qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420503,
					"content": "Il mio assistente Timaeus mi sta aiutando con la ricerca. Immagino che vi siate già incontrati a Mondstadt, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420504,
					"content": "Ciao, ho appena esaminato i dati dell'esperimento. Il rapporto è già qui sulla lavagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420505,
					"content": "Wow! Guarda quanti dati! Hai ottenuto tutti questi risultati da una battaglia contro i Melmosi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420506,
					"content": "Ahah, non li chiamerei risultati. Direi più inferenze, e forse qualche tentativo di risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420507,
					"content": "#Credo che la direzione più razionale sarebbe espandere la relazione filogenetica tra {M#questo viaggiatore}{F#questa viaggiatrice} e i Melmosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420508,
					"content": "Razionale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "Mmmh, considera questo: non hai una Visione, ma puoi manipolare l'energia elementale. Neanche i Melmosi hanno una Visione, eppure anche loro sono in grado di manipolare gli elementi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420511,
					"content": "Seguendo questa linea di pensiero, sono certo che riusciremo a stabilire una teoria di base.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420512,
					"content": "Non è male come inizio. Ma, parlando in senso stretto, i Melmosi sono forme di vita elementali. In altre parole, esseri costituiti interamente da elementi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420513,
					"content": "Un Regisreptus di Cryo, o persino un Malefiore, sarebbero un'analogia migliore. Ma per ripercorrere le relazioni filogenetiche tra piante e animali... si dovrebbe risalire alle origini del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420514,
					"content": "In tal caso, le cose potrebbero farsi complicate, non trovi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420515,
					"content": "Oh! Sì, signore. È vero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420516,
					"content": "#Dopotutto, abbiamo già i nostri dati principali. {M#Questo viaggiatore}{F#Questa viaggiatrice} proviene da un altro mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420517,
					"content": "Se saltasse fuori che ha una relazione filogenetica con questo mondo... sarebbe una scoperta senza pari, non trovi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420518,
					"content": "Aaah! Sì, certamente! Chiedo scusa, mi sono fatto prendere dall'entusiasmo a causa dei dati. La prossima volta, procederò con più calma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420519,
					"content": "A proposito di dati: per completare la nostra ricerca ce ne serviranno altri. Io me ne starò qui a condurre analisi. Se volete aggiornamenti, venite a trovarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420520,
					"content": "Ottimo, ti lascio al tuo lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420521,
					"content": "Mmmh, sembra che la pozione sia pronta. L'assaggerò prima io, poi la darò a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420509,
					"content": "Pensavo che persino io e Paimon avessimo un legame più stretto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
		{
			"id": 1104206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104206",
							"2"
						],
						"stepId": 1104206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420601,
					"content": "L'ho appena assaggiata, corrisponde alle mie aspettative.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420602,
					"content": "Ricorda di mantenere la calma in ogni momento e respira profondamente se non ti senti bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420603
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420603,
					"content": "Io annoterò tutti i risultati osservabili e i punti salienti dei dati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104207,
			"completionStepIds": [
				1104207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104207",
							"2"
						],
						"stepId": 1104207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#Com'è? Hai un'espressione buffa, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420702,
					"content": "Brucia un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "#Hai detto di averla già assaggiata! Sei certo che fosse pronta? Cosa {M#gli}{F#le} è preso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420705,
					"content": "Mmmh? Questo è il risultato che mi aspettavo, ed è anche molto positivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420706,
					"content": "Questa pozione incanala il potere elementale nel corpo. In circostanze normali, ci si aspetta un rigetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420707,
					"content": "Ma, se il flusso elementale interno è privo di ostacoli, si prova solo un disagio momentaneo. Una volta che il flusso è completo, non ci saranno altri effetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420708,
					"content": "Allora, sapevi che saresti stato male ma hai bevuto comunque?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420709,
					"content": "Eheh, è la mia pozione, è naturale che io stesso facessi da cavia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420710,
					"content": "Per... considerazione verso il soggetto del test?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "Ma certo! Mi stai assistendo, per logica sarebbe sbagliato da parte mia esporti a un rischio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420714,
					"content": "In sostanza, direi che abbiamo la nostra conclusione! Per quanto riguarda l'energia elementale, non c'è differenza tra te e chiunque altro in questo mondo. Niente di particolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420715,
					"content": "Oh, Paimon voleva che succedesse qualcosa di più interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420716,
					"content": "Ma, d'altronde, è meglio un risultato ordinario di uno particolare. I risultati particolari tendono a essere... di tipo indesiderato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420717,
					"content": "Sembra che ti stia riferendo a qualcosa di specifico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "Il lato positivo dell'essere \"ordinario\" è che tutto può essere oggetto di riferimento, e tutti ti capiscono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420719,
					"content": "Le persone sono tutte uguali: comprendono, simpatizzano, si incoraggiano e si supportano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420720,
					"content": "Quando stai male, un dottore può fare una diagnosi perché è come te. Quando qualcosa va storto, puoi chiedere a qualcuno che ha compiuto lo stesso errore di raccontarti la sua esperienza, perché tu sei come quel qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420721,
					"content": "Ma una persona particolare... non ha molte risorse per le cose che diamo per scontate. L'essenza della sua vita è fondamentalmente differente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420722,
					"content": "Per esempio... Un umano non può capire la vita di un Regisreptus di Pyro, o di un Occhio del ciclone. Mi sono spiegato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420723,
					"content": "Credo di capire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "Per riassumere, il risultato è stato positivo. Puoi ricorrere al tuo potere elementale senza timore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420726,
					"content": "Timaeus, i risultati del nuovo esperimento sono disponibili. Se potessi confrontarli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420727,
					"content": "Solo un momento, signore! Ci penso io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420728,
					"content": "Mi ha dato tanto a cui pensare, ha allargato i miei confini. Ora riesco a pensare molto più chiaramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420729,
					"content": "Paragonarti a un animale non è stato corretto da parte mia, ma iniziare con le premesse di una forma di vita elementale?! Questo sì che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420730,
					"content": "Non è niente male, credo sia un'interessante linea di indagine. Qualsiasi sia la verità in questione, vorrei che ti focalizzassi sulla tua ricerca, anziché sul mio giudizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420731,
					"content": "Può contare su di me, signore! Giungerò a un risultato soddisfacente per tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420732,
					"content": "Vuole unirsi all'ordine dei cavalieri? Sta iniziando a rispondere come un ruffiano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420733,
					"content": "Ehm... Paimon voleva dire... Questo è lo spirito giusto! Signor Albedo, di' qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420734,
					"content": "Mmmh... Prima di procedere con la nostra ricerca, devo... preparare una cosa. Aspettate un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420735,
					"content": "Se vi va, date un'occhiata in giro. Il tempo passerà più in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420724,
					"content": "Comunque, sembra che ci sia ancora... qualcos'altro, dietro le tue parole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "E non pensi al rischio a cui ti sei esposto tu?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "Forse è solo frutto della sicurezza di sé propria dei ricercatori, e di certo ha sveltito le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420703,
					"content": "Tu l'hai bevuta?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
