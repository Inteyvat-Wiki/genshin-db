					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120423,
					"content": "Se fai una promessa con il mignolo, devi mantenerla per tutta la vita. E se la infrangi, Paimon ti butta nel ghiaccio! Il freddo ti farà cadere il mignolo con cui hai tradito il tuo amico, e il gelo ti congelerà la lingua così non mentirai mai più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120424,
					"content": "Hihihi... È una promessa allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120425
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120425,
					"content": "Ciao Teucer, fai buon viaggio!",
