			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Il Principe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "Eccoci! Benvenuti all'Istituto di ricerca sui giocattoli di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120102,
					"content": "Sì, ci siamo! Sento già il rumore dei macchinari all'interno. Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120103,
					"content": "Cos'è questo posto? Come lo conosci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120104,
					"content": "Basandomi sulle mie limitate conoscenze, credo che sia uno dei centri di ricerca di Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120105,
					"content": "Dottore è un altro dei Messaggeri dei Fatui. Ama armeggiare con le antichità, è una sua... passione personale. Ha convertito questo luogo in un laboratorio di ricerca sulle Guardie delle rovine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120106,
					"content": "Eh? Quindi le Guardie delle rovine sono state costruite dai Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120107,
					"content": "No. Hanno legami molto più stretti con l'Abisso, quindi, in senso stretto, sono nemici nostri come di chiunque altro... Noi facciamo solo ricerca, niente di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120108,
					"content": "Per quanto riguarda il motivo per cui le Guardie delle rovine di recente siano uscite da quest'area... posso solo immaginare che si sia stufato di giocare con loro e abbia perso interesse per questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120109,
					"content": "Chi l'avrebbe mai detto, un altro Messaggero con un caratteraccio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120110,
					"content": "Almeno questo spiega perché eri d'accordo a portare Teucer qui... Ti eri preparato in anticipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120111,
					"content": "Beh... non direi proprio preparato, in realtà non ho idea di come sia questo posto all'interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120112,
					"content": "A-Aspetta, quindi... ti preoccupi per la sicurezza di tuo fratello o no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120113,
					"content": "Certo che sì... ma qualsiasi sia il pericolo, io lo neutralizzerò. Non è quello che farebbe ogni fratello maggiore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120114,
					"content": "Lo capisce persino Teucer, ora che ha un motivo per combattere... È lo stesso che anima me, ormai da tanti anni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120115,
					"content": "Allora, la smettiamo di chiacchierare? Forza, entriamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120116,
					"content": "Ahah, va bene! Seguitemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Il Principe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "Meno male che mi avete trovato prima voi... Usare la Trasformazione dell'Eredità immonda mentre ero ancora ferito è stato più pesante del previsto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120202,
					"content": "Non so cosa farei se Teucer mi vedesse così... sgonfio come un palloncino scoppiato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120203,
					"content": "Non hai paura che io possa approfittarne per darti il colpo di grazia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "#Ahah! Se ricordo bene, anche tu hai {M#una sorella}{F#un fratello}, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120205,
					"content": "Ho dedotto che non mi avresti fatto fuori davanti al mio fratellino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120206,
					"content": "La stai proprio sfruttando questa situazione, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120208,
					"content": "Come ho già detto... non mi lascio mai sfuggire un'opportunità di mettermi alla prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120209,
					"content": "Ed è per questo che io, Tartaglia, divento sempre più forte. Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120210,
					"content": "In ogni caso, i sogni d'infanzia vengono infranti troppo facilmente. Anche se non si fa nulla, il tempo li sgretola pezzo per pezzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120211,
					"content": "Quindi, qualcuno dovrà pure proteggerli, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120212,
					"content": "Se fai una promessa, la mantieni; se fai un errore, ti scusi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120213,
					"content": "E se regali un sogno a qualcuno, lo difendi fino alla fine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120214,
					"content": "È questo il senso della famiglia, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "Aha... Ti ho ricordato qualcosa, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120217,
					"content": "*tossisce* Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120218,
					"content": "Smettila di fare il duro! Devi andare subito da un medico, signorino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120219,
					"content": "Un buon consiglio, ma prima... ho una cosina per Teucer. Per favore, dategliela da parte mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120220,
					"content": "Ma questo è... un modellino del signor Ciclope?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120221,
					"content": "Esatto... L'ho ordinato a un fabbro qualche tempo fa. Volevo regalarglielo al mio ritorno a Snezhnaya, ma ora sembra un souvenir perfetto per questa situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120222,
					"content": "Wow... Ora che Paimon ci pensa, la famiglia del Principe è davvero fortunata ad averlo, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120223,
					"content": "Eh... Dovrete anche spiegare a Teucer la mia brusca partenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120224
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120224,
					"content": "Mi aiuterete, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120225,
						110120226
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120225,
					"content": "\"Se fai una promessa con il mignolo, devi mantenerla per tutta la vita...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120227,
					"content": "Ahahah... \"Il freddo ti farà cadere il mignolo con cui hai tradito il tuo amico, e il gelo ti congelerà la lingua così non mentirai mai più\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120228
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120228,
					"content": "Ah, questa filastrocca mi riporta alla mente tanti bei ricordi. Ve l'ha insegnata Teucer, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120229
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120229,
					"content": "Vai pure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120230
					]
				},
				{
					"id": 110120230,
					"content": "Ok... Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120226,
					"content": "E se la infrango, mi butti nel ghiaccio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120207,
					"content": "Ne è valsa la pena?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120208
					]
				}
			]
		},
