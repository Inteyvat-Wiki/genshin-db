			},
			"dialogs": [
				{
					"id": 110120401,
					"content": "#{M#Viaggiatore}{F#Viaggiatrice}, signorino Teucer, la stavo aspettando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120402
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120402,
					"content": "Ti ha mandato il Principe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120403,
					"content": "Esatto. Il nobile Principe mi ha incaricato di organizzare il viaggio di ritorno del signorino Teucer. Prego, venga con me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120404
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120404,
					"content": "E tu chi sei? Mio fratello dice sempre di non andare mai con gli sconosciuti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120405
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120405,
					"content": "#Ma ci hai seguit{M#i}{F#e} per tutto il tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120406,
					"content": "Sì, perché ho sempre saputo che siete delle brave persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120407
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120407,
					"content": "Ehm... Cosa?!?",
