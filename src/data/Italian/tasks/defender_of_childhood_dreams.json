				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120901,
					"content": "Oh, la porta si è aperta, sei stato tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120902
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120902,
					"content": "Esatto. Ma dammi un attimo, Teucer. Devo assicurarmi che sia tutto a posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120903
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120903,
					"content": "*sospira* Forse non avrei dovuto viziarlo così tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				}
			]
		},
		{
			"id": 1101210,
			"completionStepIds": [
				1101203,
				1101214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101214",
							"2"
						],
						"stepId": 1101214,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121001,
					"content": "Fiuuu... Rieccoci, finalmente. Non ti sei fatto male, vero, Teucer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121002
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121002,
					"content": "Male? Per nulla! È stato davvero divertente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121003
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121003,
					"content": "Divertente per te, forse... Noi eravamo spaventati a morte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121004,
					"content": "Cosa c'è laggiù? Wow, questa stanza è enorme! È qui che il signor Ciclope porta i suoi amici quando vengono a trovarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121005
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121005,
					"content": "Proprio così. Impressionante, vero? Ora che ne dici di giocare a nascondino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121006
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121006,
					"content": "Eh? Adesso? Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121007
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121007,
					"content": "Eheh... Ho una sorpresa per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121008
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121008,
					"content": "Una sorpresa?!? Che tipo di sorpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121009
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121009,
					"content": "Non preoccuparti, potrai cercarla più tardi... Prima però devi chiudere gli occhi, girarti e contare alla rovescia partendo da sessanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121010
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121010,
					"content": "Ok... da sessanta è davvero tanto, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101211,
			"completionStepIds": [
				1101215
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101215",
							"2"
						],
						"stepId": 1101215,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Il Principe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121101,
					"content": "Ehi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121102
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121102,
					"content": "Il Principe? Allora sei stato qui tutto il tempo... Come mai ti nascondi? Perché non sei venuto a salutare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121103,
					"content": "Gli addii sono momenti speciali. Se avesse passato gli ultimi momenti a Liyue vedendomi così debole e abbattuto... Non voglio che parta con quel ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121104,
					"content": "Però mi dispiace di non averlo potuto salutare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121105,
					"content": "*sospira* Avrei dovuto essere io a riaccompagnarlo. Ho dei subordinati che lo scortano, ma mi sento comunque un po' in colpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121106,
					"content": "Cavoli, non pensi di averlo già viziato abbastanza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121107,
					"content": "Ahah! Non so spiegarlo, ma in qualche modo mi sono sentito molto meglio ad affidarlo a voi... E pensare che non molto tempo fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121108,
					"content": "Ah, sì, quasi dimenticavo: il compenso per i vostri servizi... Questa volta non avrei proprio potuto farne a meno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121109,
					"content": "Aha, allora ce l'hai un cuore, dopotutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121110,
					"content": "Un'altra cosa... Non dimenticare la nostra promessa. Faremo la rivincita alla prima occasione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121111,
					"content": "E questa volta ci sarà in gioco il mio onore di Messaggero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121112,
					"content": "Non vedo l'ora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "È meglio se ti riposi, prima! Non metterti a frignare quando perderai di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121115,
					"content": "Ahahah... Che io vinca o perda il nostro prossimo incontro, vorrei comunque invitarvi a casa mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121116,
					"content": "Vi presenterò gli altri miei fratelli, Tonia e Anthon. Sono ragazzi fantastici e mi riempiono d'orgoglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121117,
					"content": "Accettiamo l'offerta! Soprattutto perché abbiamo già fatto una promessa con il mignolo a Teucer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121118,
					"content": "Ahah, sono sicuro che anche lui sarà felicissimo di vedervi. Beh, siamo d'accordo allora. Non vedo l'ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121119,
					"content": "Arrivederci, amici miei... Al nostro prossimo incontro, a Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110121113,
					"content": "Non ho intenzione di perdere con te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
	]
}