					"nextDialogs": [
						110120417
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120417,
					"content": "Beh, allora... a presto, brave persone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120418
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120418,
					"content": "Vi aspetterò a casa. Prima o poi dovrete davvero venire a visitare Snezhnaya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120419,
						110120421
					],
					"speakerTitle": "Teucer"
				},
