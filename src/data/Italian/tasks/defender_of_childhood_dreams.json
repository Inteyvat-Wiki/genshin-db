				{
					"id": 110120802,
					"content": "Oh, davvero? Che cosa sciocca da dire... e tu non dovresti ripeterla, Teucer, sei troppo giovane per parlare di argomenti così violenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120803
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120803,
					"content": "Sì, sapevo che era una bugia comunque... il signor Ciclope è qui per sconfiggere i cattivi e proteggere il mondo. È il mio giocattolo preferito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120804
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120804,
					"content": "Esatto! Con il signor Ciclope in giro, i cattivi non ti prenderanno mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120805
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120805,
					"content": "Hihihi, giusto! Ok, ora vado a giocare con il signor Ciclope!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120806,
					"content": "Ehi, Teucer, aspetta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 110120807,
					"content": "L-La porta si è chiusa! Teucer starà bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120808,
					"content": "Possiamo passare di qua... Muoviamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				}
			]
		},
		{
			"id": 1101209,
			"completionStepIds": [
				1101213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
