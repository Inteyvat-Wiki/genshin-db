			"dialogs": [
				{
					"id": 110120301,
					"content": "Non lo trovo da nessuna parte... Dov'è finito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120302,
						110120304
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120302,
					"content": "Ho trovato tuo fratello un momento fa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120303
					]
				},
				{
					"id": 110120303,
					"content": "Davvero? Dov'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120306,
					"content": "Un sacco di persone volevano improvvisamente comprare un signor Ciclope!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120307
					]
				},
				{
					"id": 110120307,
					"content": "S-Sì, quindi ha dovuto andarsene in fretta e furia, non ti ha abbandonato qui di proposito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120308,
					"content": "Oh... È... è fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120309,
					"content": "Però speravo che potessimo giocare qui un po' più a lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120310,
						110120311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120310,
					"content": "Questo è per te, da parte di tuo fratello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120312,
					"content": "Wow! Ma è stupendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120313
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120313,
					"content": "Non sapevo che facessero dei signor Ciclope di queste dimensioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120314
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120314,
					"content": "Guardate, c'è anche il mio nome sopra! È il mio signor Ciclope personale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120315,
					"content": "Ti piace molto, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120316,
					"content": "Puoi scommetterci! Mio fratello è il miglior fratello di sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120317
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120317,
					"content": "Hai fatto un giro a Liyue, hai incontrato tuo fratello, hai visitato l'Istituto di ricerca sui giocattoli e ora hai pure un souvenir... Questo è quello che noi guide turistiche chiamiamo il viaggio perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120318,
					"content": "Pensi di essere pronto a tornare al Snezhnaya ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120319,
					"content": "Eheh... non preoccupatevi, so che non posso ottenere sempre quello che voglio... Non sarebbe giusto nei confronti degli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120320
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120320,
					"content": "Allora... andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120311,
					"content": "Il signor Ciclope ti terrà compagnia per lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120304,
					"content": "Sta già tornando indietro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120305
					]
				},
				{
					"id": 110120305,
					"content": "Cosa? Perché... Perché se n'è andato senza di me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				}
			]
		},
