					"nextDialogs": [
						110120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120408,
					"content": "Mio fratello ci ha raccontato tutto di voi in una lettera che mi ha letto mia sorella Tonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120409
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120409,
					"content": "#Vi ho riconosciut{M#i}{F#e} appena vi ho vist{M#i}{F#e}, solo che... non riuscivo a ricordare i vostri nomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120410
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120410,
					"content": "Che strano scherzo del destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120411,
						110120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120411,
					"content": "Anche per noi è stato un piacere conoscerti, Teucer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120412
					]
				},
				{
					"id": 110120412,
					"content": "Hihihi...",
