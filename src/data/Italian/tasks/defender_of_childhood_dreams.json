					"nextDialogs": [
						110120426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120421,
					"content": "Vuoi prometterlo con il mignolo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120422
					]
				},
				{
					"id": 110120422,
					"content": "Sììì! Promessa con il mignolo, promessa con il mignolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120413,
					"content": "Tuo fratello non ha scritto niente di male su di noi, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120414
					]
				},
				{
					"id": 110120414,
					"content": "Niente affatto, anzi, ha scritto che avrebbe volentieri lasciato il lavoro per unirsi alle vostre avventure, però non può!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120415
