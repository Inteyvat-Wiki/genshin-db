			"dialogs": [
				{
					"id": 200190201,
					"content": "Hai trovato la mia chiave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190202
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190202,
					"content": "Temo di no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190203
					]
				},
				{
					"id": 200190203,
					"content": "Ok, l'area in cui cercare è molto vasta... Buona fortuna!",
