				{
					"id": 200190401,
					"content": "Hai già trovato la chiave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190402
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190402,
					"content": "Ho trovato questa chiave. È tua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200190403
					]
				},
				{
					"id": 200190403,
					"content": "Sì! È proprio lei. Non posso permettermi che accada di nuovo... Devo proprio darmi una regolata con l'alcol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200190404
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200190404,
					"content": "Ah, tieni. Grazie per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
