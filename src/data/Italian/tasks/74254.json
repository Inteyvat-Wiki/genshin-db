			"dialogs": [
				{
					"id": 742540601,
					"content": "Che giornata tranquilla e piacevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540602,
						742540603
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540602,
					"content": "(Restiamo seduti così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742540604,
					"content": "Mh-mh, grazie per l'invito. Sandrone... O preferisci che ti chiami \"sorellina\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540603,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
