			"dialogs": [
				{
					"id": 742540501,
					"content": "Seymour, quanto tempo! E c'è anche Mamère!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540502,
					"content": "Eheh, Seymour non ha fatto altro che dirmi quanto gli siete mancate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540503,
					"content": "Affermativo. Non ho mai smesso di pensare a Mademoiselle Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540504,
					"content": "E grazie per aver organizzato questo tè, Sandrone. È davvero piacevole ritrovarsi e chiacchierare dei nostri viaggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540505,
					"content": "Non c'è di che. Sento che siamo tutti una famiglia, in un certo senso, con una lunga storia in comune. Beh, almeno così la vedo io. Non c'è nulla di male a ritrovarsi quando siamo tutti liberi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742540506,
					"content": "Una famiglia? Non so perché, ma sentirtelo dire mi riempie di gioia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540507,
					"content": "Quindi questo fa di Sandrone la nostra... sorellina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540508,
					"content": "Ehm... Possiamo evitare questa faccenda della parentela, per ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742540509,
					"content": "Affermativo. In quanto prototipo creato da Monsieur Alain, Mademoiselle Sandrone dovrebbe propriamente considerarmi come \"fratello maggiore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540510,
					"content": "Umpf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742540511,
					"content": "Ahh, che bello. Posso fare parte anch'io della famiglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540512,
					"content": "Ma certo! Non siamo esattamente una \"famiglia convenzionale\", dopotutto... Aggiungere una Melusina sembra la cosa più naturale del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742540513,
					"content": "Affermativo. Mademoiselle Mamère è già parte della mia famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540514,
					"content": "Eheh. Sono così felice! Che ne dite se ci faccio un ritratto di famiglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540515,
					"content": "Un ritratto di famiglia? È passato tanto tempo dall'ultima volta che ho posato per uno di quelli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540516,
					"content": "Voglio che tu mi faccia sembrare maestosa, come una perfetta sorellona di famiglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540517,
					"content": "Ci puoi contare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540518,
					"content": "Ah... Perché no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
