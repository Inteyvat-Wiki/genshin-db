			},
			"dialogs": [
				{
					"id": 718030301,
					"content": "Miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "Cenerino"
				},
				{
					"id": 718030302,
					"content": "Eh? Che ci fa un gatto qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030303,
					"content": "Miao, miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Cenerino"
				},
				{
					"id": 718030304,
					"content": "Un gatto grigio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "Un gatto grigio, perso fuori città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030306,
					"content": "Ah! Lan parlava di un incarico sulla ricerca di un gatto grigio, potrebbe trattarsi di lui! Paimon ricorda che si chiamava Cenerino o qualcosa di simile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030307,
					"content": "Chi avrebbe mai pensato di trovarlo qui... Sarà rimasto nascosto per tutto il tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030311,
					"content": "Immagino che il Lawachurl Mantodipietra impedisse a chiunque di venire a cercarlo in questo posto. Il gatto avrà avuto troppa paura ed è rimasto nascosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030312,
					"content": "#Per fortuna siamo venut{F#e}{M#i} qui. Avrebbe rischiato di aspettare ancora a lungo, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030313,
					"content": "Miao... miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Cenerino"
				},
				{
					"id": 718030314,
					"content": "Miao, miao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "Ehi, che stai facendo? Secondo Paimon, il gatto non capisce comunque quello che dici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030316,
					"content": "Portiamolo da Lan. Lo riconsegnerà alla persona che ha pubblicato l'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030319,
					"content": "Miao... miao! Miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Cenerino"
				},
				{
					"id": 718030320,
					"content": "Miao... miao! Miao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "Dai, andiamo! Puoi imitarlo quanto ti pare, non ti capisce! Portiamolo con noi e basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030322,
					"content": "Sembra che sia d'accordo con noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "Ma come hai... No, non voglio saperlo. Riportiamolo da Lan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030317,
					"content": "Riportiamo il gatto da Lan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "Già, direi che non possiamo fare molto altro, adesso. Ci penserà lei a riconsegnarlo al suo padrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030308,
					"content": "Forse è Cenerino...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "Un gatto grigio, perso fuori città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030310,
					"content": "Hai ragione! È l'incarico di cui stava parlando Lan prima, vero? Chi avrebbe mai pensato di trovare il gatto qui... Sarà rimasto nascosto per tutto il tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				}
			]
		},
