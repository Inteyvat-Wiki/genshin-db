						718030502
					],
					"speakerTitle": "Cenerino"
				},
				{
					"id": 718030502,
					"content": "Questo gatto è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030503,
					"content": "Potrebbe essere Cenerino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030504
					]
				},
				{
					"id": 718030504,
					"content": "Dammi un attimo, devo confrontare il suo aspetto con la descrizione fornita nell'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030505,
					"content": "Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030506
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030506,
					"content": "Corrisponde pressoché del tutto. Sembra proprio il gatto che stavamo cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030508
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030508,
					"content": "L'autore dell'incarico sarà contento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030509
					]
				},
				{
					"id": 718030509,
					"content": "E così, alla fine, siamo comunque tornati a occuparci di gatti smarriti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030510
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030510,
					"content": "Non so cosa dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030511,
					"content": "Farò rapporto alle persone che hanno pubblicato gli incarichi. Grazie infinite. Accetta questa ricompensa per il favore che ci hai fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030512,
					"content": "Uhm, sembra che l'autore dell'incarico per il gatto si sia trasferito. Ci metterò un po' a contattarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030513
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030513,
					"content": "Immagino che dovrò prendermi cura io di questo malandrino, nel frattempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030514
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030514,
					"content": "Miao, miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cenerino"
				}
			]
