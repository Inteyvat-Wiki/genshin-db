			"dialogs": [
				{
					"id": 718030401,
					"content": "Hai sconfitto il Lawachurl Mantodipietra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030402,
						718030404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030402,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030403
					]
				},
				{
					"id": 718030403,
					"content": "Grazie, ci hai fatto un favore. Con questo successo in tasca, non avremo problemi a dimostrare le capacità della Gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 718030404,
					"content": "L'abbiamo sconfitto e abbiamo anche trovato Cenerino...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030405
					]
				},
				{
					"id": 718030405,
					"content": "Grazie, ci hai fatto un fav... Come hai detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
