				"objectNames": [
					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721850301,
					"content": "#Viaggiat{F#rice}{M#ore}, sei tornat{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850302,
					"content": "Com'è andata? Qualche commento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850303,
					"content": "A proposito dei commenti dei clienti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "La pizza ai funghi originale... Mmm, vale la pena provare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850305,
					"content": "Gli ingredienti per prepararla sono formaggio, cavolo e funghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850306,
					"content": "Abbiamo tutti gli altri ingredienti, ma di solito non facciamo scorta di formaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850307,
					"content": "#Viaggiat{F#rice}{M#ore}, potrei chiederti di procurarmi un pezzo di formaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850308,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "Conto su di te, allora. Basta un solo pezzo di formaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850310,
					"content": "Davvero non usate il formaggio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "Non è che non lo usiamo affatto, è solo che lo utilizziamo molto raramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850312,
					"content": "Dopotutto, non sono tanti i piatti in cui usiamo il formaggio, quindi non ne abbiamo mai una grossa scorta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850313,
					"content": "#Conto su di te, viaggiat{F#rice}{M#ore}. Ti prego di aiutarmi a recuperare un pezzo di formaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
		},
