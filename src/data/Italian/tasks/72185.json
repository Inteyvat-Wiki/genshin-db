			"dialogs": [
				{
					"id": 721850501,
					"content": "Grazie, questi ingredienti andranno bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850502
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850502,
					"content": "L'originale pizza ai funghi di Mondstadt... Non so se riuscirò a prepararla come si deve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850503
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850503,
					"content": "Finito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850504
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850504,
					"content": "Questa pizza sembra... piuttosto buona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850505
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850505,
					"content": "#Grazie per l'aiuto, viaggiat{F#rice}{M#ore}. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850506
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850506,
					"content": "Ora penserò a godermi il sapore di questa pizza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850507
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850507,
					"content": "Se non è male... verrà inserita ufficialmente come nuovo piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
