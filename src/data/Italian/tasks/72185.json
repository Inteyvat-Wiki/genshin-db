			"dialogs": [
				{
					"id": 721850201,
					"content": "*sospira* Esiste qualcosa al mondo in grado di soddisfare le mie papille gustative?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850202
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850202,
					"content": "A proposito della pizza del Ristorante Kiminami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850203
					]
				},
				{
					"id": 721850203,
					"content": "Oh, la pizza di cui parli ha un sapore davvero buono, e ha anche un sacco di ingredienti locali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850204
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850204,
					"content": "Tuttavia, in passato ho provato l'autentica pizza ai funghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850205
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850205,
					"content": "Ricordo che la pizza era fatta con formaggio, cavolo e funghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850206
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 721850206,
					"content": "Ahahah! Quando si parla di manicaretti stranieri, credo sia sempre meglio attenersi alla ricetta originale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matsumoto"
				}
			]
		},
		{
			"id": 7218503,
			"completionStepIds": [
				7218503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
