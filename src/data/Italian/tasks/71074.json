		{
			"id": 7107408,
			"completionStepIds": [
				7107407
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
