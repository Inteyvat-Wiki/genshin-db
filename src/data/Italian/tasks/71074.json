		{
			"id": 7107406,
			"completionStepIds": [
				7107405
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740601,
					"content": "Altre tre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740602
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740602,
					"content": "#Sarò ben felice di accettare le Pietre arcaiche consegnate da due cittadin{F#e}{M#i} modello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740603
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740603,
					"content": "Non mi aspettavo che ne avreste trovate due così velocemente. E la loro qualità è anche migliore di quelle che ho visto in precedenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740604
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740604,
					"content": "*sospira*... Mi ricordano quella che avevo un tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740605
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740605,
					"content": "Hai una Pietra arcaica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740606,
						710740607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740606,
					"content": "E allora perché hai mandato noi a cercarla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				},
				{
					"id": 710740608,
					"content": "Ce l'avevo UN TEMPO.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740609
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740609,
					"content": "Un giorno, il mio vecchio consegnò dei minerali all'Unione di Shenglu. Quella pietra era uno scarto di bassa qualità, quindi me la regalò per giocarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740610
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740610,
					"content": "All'epoca litigavamo di continuo. Non avevo mai avuto un lavoro e, come se non bastasse, ero quasi sempre alla Sala da tè Yanshang. Di conseguenza, mi ritrovai con grossi debiti... e in enorme difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740611
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740611,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740612,
					"content": "Mi dispiace...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740613
					]
				},
				{
					"id": 710740613,
					"content": "Beh, chi non ha mai fatto qualche sciocchezza da giovane? Comunque, ero nei guai e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740614
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740614,
					"content": "Qualcuno ha riconosciuto la mia Pietra arcaica e si è offerto di comprarla a un buon prezzo. Per me non è stato un problema, anzi avrei scambiato una pietra per una somma di Mora che mi avrebbe tirato subito fuori da quella brutta situazione. È stato un ottimo affare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740615
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740615,
					"content": "Ma l'altro giorno mio padre è venuto da me e mi chiesto dove avessi messo la pietra che mi aveva regalato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740616
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740616,
					"content": "Non sono riuscito a dirgli altro se non che era soltanto una pietra e che l'avevo persa da tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740617
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740617,
					"content": "Eppure, mi chiedo cosa sarebbe successo se non l'avessi venduta... Se l'avessi mostrata a mio padre quando l'ha menzionata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740618
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740618,
					"content": "...Lasciamo stare. Non ha senso chiedersi come sarebbe potuta andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740619
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740619,
					"content": "Almeno, il figliol prodigo è tornato a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740620,
					"content": "Hai ragione... Ma ho ancora molta strada da fare prima di poter cancellare il mio debito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740621
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740621,
					"content": "Ho divagato. Se trovate altre pietre, portatemele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740622,
						710740623
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740622,
					"content": "Queste non ti bastano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740624,
					"content": "Mmm... Portatemene altre tre. Poi dovrebbero bastare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740625
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740625,
					"content": "Le Pietre arcaiche sono rare. Anche se l'Unione di Huishan ne volesse altre, dubito fortemente che le potremmo trovare qui nella Voragine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740623,
					"content": "Ma quante te ne servono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740607,
					"content": "Forza, consegna prima la tua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				}
			]
		},
