				"points": []
			},
			"dialogs": [
				{
					"id": 710740101,
					"content": "Le Pietre arcaiche... *sospira* In tutti gli anni che ho lavorato nella Voragine, ne avrò vista a malapena una. Che diamine passa per la testa dei pezzi grossi dell'Unione di Huishan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740102,
					"content": "Che se lo facciano da soli questo lavoro, così magari capiscono che è impossibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740103
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740103,
					"content": "Muning...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740104,
					"content": "Oh, siete voi! Come mai state ancora vagando nei livelli superiori della Voragine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740105,
					"content": "Uhm... Non mi fraintendere, non è che non vi voglia da queste parti, è solo che... Ehm, non avete delle faccende urgenti da sbrigare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740106,
					"content": "Uff, abbiamo solo fatto un salto per vedere come stai, visto che sembravi preoccupato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740107,
						710740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740107,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				},
				{
					"id": 710740109,
					"content": "*sospira* ...Cosa sai della Pietra arcaica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740110
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740110,
					"content": "È un minerale raro... È così raro che non è detto che si riesca a trovarne uno nelle miniere. Sono qui alla Voragine da anni, e ne avrò visti solo due o tre. È una pietra preziosa meravigliosa, dalla bellezza indescrivibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740111
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740111,
					"content": "Si dice che, guardando dentro una Pietra arcaica purissima, si possano vedere dei raggi di luce brillanti e sottili come un capello, e che il colore di queste pietre ricordi quello dell'orizzonte del mare al crepuscolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740112
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740112,
					"content": "È una pietra come questa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740113
					]
				},
				{
					"id": 710740113,
					"content": "Ah... Ne hai trovata una! E non ne ho mai vista nessuna di questa qualità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740114
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740114,
					"content": "#{NICKNAME}, me la venderesti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740115,
						710740116
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740115,
					"content": "Mai e poi mai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740117,
					"content": "Infatti! Ce l'hanno regalata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740118,
					"content": "Inoltre, Paimon dubita che tu possa permetterti di comprare una pietra simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740119,
					"content": "Beh, ho un acquirente, quindi i soldi non sono un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740120
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740120,
					"content": "Un acquirente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740121,
					"content": "Già. Non so perché, ma i pezzi grossi dell'Unione di Huishan sono interessati a questa pietra e vogliono esaminarla, quindi mi hanno mandato qui alla Voragine per cercarne qualcuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740122
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740122,
					"content": "Ma io sono troppo impegnato a togliermi questo lavoro dalle scat... Ehm, voglio dire, a lavorare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740123
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740123,
					"content": "#Perché non stringiamo un accordo, {NICKNAME}? Portami tutte le Pietre arcaiche che trovi, e in cambio ti darò le ricompense promesse dall'Unione di Huishan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740124
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740124,
					"content": "Possono anche essere di qualità inferiore rispetto alla tua, basta che siano delle Pietre arcaiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740125
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740125,
					"content": "Ricompense dell'Unione di Huishan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740126,
					"content": "Di solito mi occupo personalmente degli incarichi come questo, ma ultimamente devo gestire un bel po' di questioni della Voragine, quindi avrei bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740127
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740127,
					"content": "*sospira* ...Detto ciò, non so di preciso quante ne vogliano. Perché per iniziare non me ne porti tre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740128
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740128,
					"content": "E va bene, va bene, abbiamo capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740116,
					"content": "Ti piacerebbe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740108,
					"content": "C'è qualche problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				}
			]
		},
