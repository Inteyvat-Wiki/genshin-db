					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740214,
					"content": "#A proposito... {NICKNAME}, che ne dici di aiutarmi a cercare una pietra come quella che ti ho descritto?",
