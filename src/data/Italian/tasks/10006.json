					}
				]
			},
			"dialogs": [
				{
					"id": 100060901,
					"content": "In effetti, da un punto di vista biologico, non sono affatto un gatto, ma un essere alchemico. Non ti considereresti uno Spettro solo perché fluttui nell'aria come uno di loro, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060902
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060902,
					"content": "Uno Spettro? Cosa stai cercando di dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060903,
					"content": "Ah, ho capito! Sebas sta insinuando che sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060904
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060904,
					"content": "Forse è meglio non finire la frase, Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060905
					]
				},
				{
					"id": 100060905,
					"content": "Che frase? Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060906,
					"content": "Oh, e considerando com'è finito il messaggio della maestra Rhinedottir, suppongo che questa tecnica sia ormai inutile. La distruggerò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060907
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060907,
					"content": "Sono davvero poche le persone che riescono a farle cambiare idea. Un risultato davvero impressionante, giovanotto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060908
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060908,
					"content": "Detto questo, ora me ne vado. Ho un altro messaggio da consegnare. Forse un giorno c'incontreremo di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
