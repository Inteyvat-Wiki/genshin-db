					"content": "Ben fatto, Sebas. Non dev'essere facile essere te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060703
					]
				},
				{
					"id": 100060703,
					"content": "Eh. Vedere un gatto in grado di imitare la voce di qualcun altro è sempre strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060704,
					"content": "Beh, non c'è da stupirsi. Non sono affatto un gatto comune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
