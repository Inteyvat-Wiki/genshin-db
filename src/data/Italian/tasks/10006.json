			"dialogs": [
				{
					"id": 100060601,
					"content": "Mmm. A quanto pare Albedo non si era sbagliato, dopotutto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060602
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060602,
					"content": "La prossima volta, magari evita di tenderci un'imboscata con un branco di mostri solo per dimostrare qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060603,
					"content": "Tuttavia, sento di essere in grado di controllare il mio potere più liberamente, ora che li abbiamo sconfitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060604
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060604,
					"content": "\"Dopo aver sentito parlare di te, ho preparato una tecnica che sigillerà il potere oscuro nel tuo sangue. Avevo pianificato di cogliere questa opportunità per trasmettertela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060605
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060605,
					"content": "Naturalmente, utilizzarla ha un prezzo. Anche se manterrebbe la tua esistenza a Teyvat, indebolirebbe anche il tuo legame con questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060606
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060606,
					"content": "E tu, in fin dei conti, sei il figlio di 'M'. Come potrei mai permettere a quel potere incontrollato di portarti sulla stessa strada del bambino che è venuto prima di te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060607
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060607,
					"content": "Ma, vedendoti ora, sembra che le mie preoccupazioni fossero infondate. 'M' era una madre straordinaria, molto più capace di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060608
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060608,
					"content": "E devo ammettere che sono piuttosto curiosa di vedere fin dove riuscirai ad arrivare... Come farai tu, un essere alchemico veramente integrato in questo mondo, a trovare il tuo posto nella società umana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060609
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060609,
					"content": "Non ho mai condotto un esperimento del genere prima d'ora. Per questo motivo, potresti essere tu a custodire la chiave di alcune risposte inaspettate.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060610
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060610,
					"content": "Ehi! Ti sbagli su una cosa. Durin non è un esperimento! È nostro amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060611,
					"content": "Non sono sicuro di capire, ma... apprezzo la tua gentilezza, zia Rhinedottir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				}
			]
		},
