			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "Come pensavo: un'altra anima miserabile che non fa che ripetere gli stessi errori. Devo ammettere che sono un po' delusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150302,
					"content": "Per anni ha cercato di non commettere errori, ma, alla fine... Significa che i cattivi non possono mai cambiare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150303,
					"content": "È più difficile continuare a fare del bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "Ogni decisione è stata sua. Anche ora, avrebbe potuto scegliere di ammettere i suoi errori. Ma ha scelto la via della violenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150306,
					"content": "Ha fatto solo passi falsi, e ognuno di questi lo ha condotto alla sua fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150307,
					"content": "#Ma basta parlare di lui. I miei complimenti per il lavoro svolto. {NICKNAME}, puoi portare la prova della taglia a Leszek, come concordato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150308,
					"content": "È stato un piacere avervi al timone! È come se fossi stata in vacanza oggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150309,
					"content": "Eheh. Ora che è finita, credo sia arrivato il momento di pensare al prossimo incarico, vero, Jahoda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150310
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150310,
					"content": "Ehhh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150304,
					"content": "Ha preso delle decisioni sbagliate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				}
			]
		}
	]
}