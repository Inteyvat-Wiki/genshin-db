			"dialogs": [
				{
					"id": 761150101,
					"content": "Eh? Nefer e Jahoda! Cosa ci fate qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150102,
					"content": "Stiamo lavorando, ovviamente! Finalmente abbiamo una pista per il nostro incarico non ancora terminato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150103,
					"content": "Jahoda ti racconta tutto sul bersaglio della taglia, Hark Mascella rotta, e sulle informazioni raccolte dal Consiglio dei segreti...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761150104
					]
				},
				{
					"id": 761150104,
					"content": "Iniziamo dalla nostra conclusione: Derwent, il vero eremita, probabilmente è morto, e l'uomo che risiede nella sua capanna è l'obiettivo della taglia, Hark Mascella rotta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150105,
					"content": "I frammenti del diario di Jahoda sono sufficienti a dimostrare che, nonostante sapesse chi fosse, Derwent lo accolse comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150106,
					"content": "Non dovrebbe sorprendere il fatto che Hark abbia fatto ritorno alle sue vecchie abitudini. Dopo aver eliminato Derwent, ha assunto l'identità dell'eremita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150107,
					"content": "Quando sono andata a indagare, non si è fatto vedere, ma, a prescindere da come la si pensi, l'uomo in quella capanna non può essere Derwent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150108,
					"content": "Assumere il ruolo di eremita significa anche che Hark può dedicarsi ad attività bizzarre di ogni tipo senza destare sospetti. La maschera che indossa non ha nulla a che fare con il suo \"addestramento\"... È per nascondere la cicatrice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150109,
					"content": "Quanto al mercante scomparso, nel peggiore dei casi, è già morto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150110,
					"content": "Come si fa a essere così... malvagi?! Ripagare la gentilezza con l'omicidio... Fa ribollire il sangue di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150111,
					"content": "Per quanto mi riguarda, non credo che Hark abbia rubato quelle merci dal Circolo itinerante. Non aveva un movente abbastanza solido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150112,
					"content": "Non ha fatto nulla di male per dieci anni. Il prezzo di qualche oggetto rubato è davvero sufficiente a fargli buttare al vento tutto ciò che ha fatto? Non credo proprio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150113
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150113,
					"content": "Quindi, avanziamo qualche ipotesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150114
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150114,
					"content": "Sappiamo già che è tornato al relitto dell'Atlas e ha attaccato i Cacciatori di tesori in cerca del tesoro. Quando le persone sono nei guai, spesso tornano istintivamente dove tutto è iniziato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150115,
					"content": "Quando era ancora il timoniere dell'Atlas, aveva fama, ricchezza... tutto ciò che potesse desiderare. Ma cos'è successo dopo che si è unito al Circolo itinerante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150116,
					"content": "Anche dopo dieci anni di buona condotta, non appena qualcuno rubò qualcosa, lo accusarono tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150117,
					"content": "E ancora più difficile da accettare deve essere stato il fatto che nessuno sospettasse Juhani, che un tempo era un pirata, seppur meno rinomato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150118,
					"content": "Accusò Juhani, ma nessuno gli credette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150119,
					"content": "Spinto dalla delusione e dalla rabbia, commise il primo errore. Da lì cambiò tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150120,
					"content": "Quello che è successo nella capanna dell'eremita dev'essere stato qualcosa di simile... Per una persona come lui, anche il minimo conflitto può diventare una questione di vita o di morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150121,
					"content": "#Ehi, {NICKNAME}. Non possiamo permettere a una persona così pericolosa di compiere azioni così malvagie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150122,
						761150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150122,
					"content": "Mi occuperò io di questo pericoloso criminale!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				},
				{
					"id": 761150124,
					"content": "#Dato che {NICKNAME} è più che disponibile, dovresti riposarti un po', Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150125,
					"content": "Bene, ho dovuto fare gli straordinari per questa indagine, quindi credo di meritarmi una vacanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150126
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150126,
					"content": "Quanto alle mie ipotesi, scopriremo presto se si riveleranno vere o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150123,
					"content": "Ricompensa o no, me ne occuperò io!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				}
			]
		},
