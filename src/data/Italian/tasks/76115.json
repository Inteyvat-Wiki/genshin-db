							8985.423
						],
						"pointId": 14157
					}
				]
			},
			"dialogs": [
				{
					"id": 761150201,
					"content": "...Non ho mai fatto niente a nessuno di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150202,
					"content": "Sembra che tu sappia già perché siamo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150203,
					"content": "Tutto ciò appartiene al passato. Voglio solo vivere una vita tranquilla, adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150204,
					"content": "Impersonando gli altri? Prima Juhani, e non ha funzionato, e adesso Derwent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150205,
					"content": "Le cattive esibizioni non ingannano il pubblico a lungo. Non ci saranno più vittime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150206,
					"content": "Juhani...? Stai dicendo che ho rubato la sua identità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150207,
					"content": "Non se l'è mai meritata! Ciò che aveva l'ha ottenuto grazie al suo bell'aspetto e alle sue belle parole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150208,
					"content": "Non c'era alcuna differenza tra noi! Ciò che aveva... apparteneva a me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150209,
					"content": "Cosa mi dici del signor Derwent e del mercante, allora? Che cosa ti hanno fatto di male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150210,
					"content": "Hanno... Hanno fatto delle domande che non avrebbero dovuto fare. Proprio come te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150211,
					"content": "Muori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Derwent"
				}
			]
		},
