			},
			"dialogs": [
				{
					"id": 401970201,
					"content": "Grandioso! <color=#C4D6EAFF>Bianchi</color> ti andrebbero bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "Alla panna, eh? Un grande classico.... ma sempre delizioso! Mh, hai la mia approvazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970401,
					"content": "#Perfetto! Ora che sei {F#la fiera proprietaria}{M#il fiero proprietario} di questa mappa commemorativa, potrai disegnare baffi di tutti i gusti che vuoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970402,
					"content": "Hihi, sembra una mappa molto saporita. Ne faremo tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970403,
					"content": "Ottimo! La vostra soddisfazione è il nostro miglior premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970404,
					"content": "Ora che è tutto in ordine, è il momento di rilassarsi. Mettiamo da parte il lavoro e godiamoci il parco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
