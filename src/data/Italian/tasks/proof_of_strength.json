							3518.57,
							214.513,
							-283.78
						],
						"pointId": 16827
					}
				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "Ineffa! Ineffa! Hai visto quel mulino a vento?! Devi fare un rapporto sul suo funzionamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960302,
					"content": "Ricevuto. Mi preparo a fotografare il mulino a vento. Preferisci essere inclusa nella foto, questa volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960303,
					"content": "#Eh? {NICKNAME} e Paimon? E anche Lohen?! Ma ciao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960304,
					"content": "Ohhhh... Informazioni da Nod-Krai su un potente drago antico... Paimon ha capito cosa sta succedendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960305,
					"content": "Analisi della situazione... Sembra che il signor Lohen desideri combattere contro di me. È corretto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960306,
					"content": "In poche parole, sì: è esattamente quello che speravo di fare. Quando la spedizione era a Nod-Krai, non avevo motivo di sospettare che avessi un passato così straordinario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960307,
					"content": "Ma questo è un altro discorso. È da tempo che volevo mettere alla prova le mie abilità contro di te, quindi... Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960308,
					"content": "Ihih! Ineffa, fagli vedere chi comanda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960309,
					"content": "Domando scusa. Secondo il programma odierno, dobbiamo ancora recarci a Mondstadt per procurarci alcuni componenti speciali. Le mie valutazioni indicano che combattere contro di te ora potrebbe compromettere le nostre operazioni successive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960310,
					"content": "Oh, già... quasi dimenticavo! Abbiamo sentito dire che c'è una specie di robot gigante a Mondstadt... Ecco perché siamo qui! Ma poi mi sono un po' distratta, e così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960311,
					"content": "Non c'è problema... Capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960312,
					"content": "Lohen... Non vorrai mica arrenderti così facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960313,
					"content": "Se vi aiuto a occuparvi delle Guardie delle rovine, questo dovrebbe farvi guadagnare un po' di tempo, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		},
