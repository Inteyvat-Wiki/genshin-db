				]
			},
			"dialogs": [
				{
					"id": 700960601,
					"content": "Che meraviglia... Ora, stando alla profezia di Barbeloth, l'umano bisognoso di una guida dovrebbe arrivare a momenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960602
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960602,
					"content": "Battute d'ingresso... memorizzate. Effetti d'entrata... confermati. Eheh, questa volta nulla potrà andare storto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960603
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960603,
					"content": "Ehi... Secondo voi, perché la \"profezia finale\" vuole che Lohen venga qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960604,
					"content": "Oh, no, sono già arrivati? Durin non ha finito le sue battute? Uh... Devo stare in silenzio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960605
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960605,
					"content": "La \"potenza del drago\" finale potrebbe riferirsi a Dvalin? Però non sembra essere qui, oggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960606,
					"content": "Tecnicamente parlando, l'ho già visto quando sono tornato a casa da Nod-Krai per la prima volta. Era proprio accanto a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960607
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960607,
					"content": "Ah, già! Nel Regno dei Lupi, mentre consegnavi le lettere per Varka! Aspetta... Questo significa che la profezia si è già avverata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960608,
					"content": "Se vogliamo essere generosi con l'interpretazione, tecnicamente ho già \"affrontato tre volte la potenza del drago\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960609
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960609,
					"content": "Ma hai \"compreso il vero significato della forza\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960610
					]
				},
				{
					"id": 700960610,
					"content": "Immagino sia per questo che la profezia mi ha guidato qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960611
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960611,
					"content": "Prima che fosse conosciuto come il \"Covo di Terrore alato\", questo luogo era il dominio di Decarabian, il Dio delle tempeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960612
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960612,
					"content": "Ma il potente dio, che poteva evocare tempeste per isolare il mondo dal resto, non riuscì a contenere il desiderio di libertà che ardeva tra le sue stesse mura di vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960613
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960613,
					"content": "Eppure, il Dio del Vento del Nord, col quale si era conteso il trono divino, trovò la risposta che aveva sempre cercato solo dopo aver abbandonato il suo potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960614
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960614,
					"content": "Eh? Sembra che questo ragazzino nasconda più di quanto Varka mi abbia fatto credere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960615
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960615,
					"content": "Lo Specchio dell'albore, Durin... Per un certo periodo, anche loro furono preda di confusione e dubbi. Ciò che li condusse alla forza fu ben più del semplice potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960616
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960616,
					"content": "Ma bene... Sembra che tu stia davvero capendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960617
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960617,
					"content": "E anche Ursa, il mostro che un tempo era stato un angelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960618
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960618,
					"content": "...Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960619
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960619,
					"content": "Paimon pensa che tu possa aver capito qualcosa, Lohen... Ma, ehm, stai parlando in modo un po' strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960620,
						700960621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960620,
					"content": "Prima Durin... Ora Lohen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				},
				{
					"id": 700960622,
					"content": "\"L'angelo che scelse il potere desiderava ancora restare vicino all'umanità, e finì per cadere e diventare un mostro miserabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960623
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960623,
					"content": "O umani che avete assistito a questi eventi, anelate voi ancora al potere?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960624
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960624,
					"content": "Ehi! Quelle sono le mie battute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960625
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960625,
					"content": "Che cos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960626,
					"content": "Oh, cielo... Ormai la frittata è fatta, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960627
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960627,
					"content": "È un piacere conoscerti, Lady Nicole. Ho letto il tuo copione e devo dire che ne sono rimasto molto colpito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960628
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960628,
					"content": "*sospira*... Perché ho la sensazione che Durin abbia perso la sua copia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960629
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960629,
					"content": "Eh? Quindi anche quello faceva parte della profezia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960630
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960630,
					"content": "Nient'affatto. Se l'avessi saputo in anticipo, avrei semplicemente evitato di... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960631
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960631,
					"content": "In ogni caso, era una sceneggiatura ben scritta. Molto divertente, come una piccola fiaba confortante. Devo dire però che non amo particolarmente farmi fare la predica... Nemmeno da un angelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960632
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960632,
					"content": "Sceglierò di credere che fosse rivolta alla mia ex collega... Quella che ha scelto il potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960633
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960633,
					"content": "Visto che hai letto il mio copione, suppongo che tu sappia già tutto quello che ho da dirti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960634
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960634,
					"content": "Infatti, e lo considererò un suggerimento prezioso. Ora, c'era dell'altro... o posso tornare a compilare il mio Manuale dei nemici formidabili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960635,
						700960636
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960635,
					"content": "(Non ha detto che intende seguire il suggerimento...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960637,
					"content": "Devo ammettere, però, che è stata una giornata piuttosto produttiva. Sono sicuro di essere diventato almeno un pochino più forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960638
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960638,
					"content": "#Grazie a {F#tutte}{M#tutti}... E porgete i miei saluti alla troupe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960639
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960639,
					"content": "*sospira* Perché gli umani sono sempre così difficili da gestire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960640
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960640,
					"content": "Ehm, qualcuno può spiegare a Paimon cosa sta succedendo? Si sente... molto, molto confusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960641,
					"content": "Ricordate quando avete affrontato Dottore e il veleno lasciato da Ursa a Mondstadt? Mi hanno riferito che anche Lohen ha dovuto sopportare la sua dose di dolore, in quel periodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960642
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960642,
					"content": "Poiché si trattava di una calamità causata da un angelo caduto, era naturale che toccasse a un angelo effettivo rimettere le cose a posto... Anche se le \"cose\" non sono andate esattamente come avevo previsto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960643
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960643,
					"content": "Sembra che il futuro dell'umanità sia destinato a essere sempre più imprevedibile... La guida degli angeli non è più l'unica cosa che li conduce verso il domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960644
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960644,
					"content": "Ma tutte quelle infinite possibilità... Forse è proprio in loro che risiede la vera forza dell'umanità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960636,
					"content": "#(Sono abbastanza {F#sicura}{M#sicuro} che continuerà a compilare il suo manuale, qualsiasi cosa gli dica lei...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960621,
					"content": "Perché sembra che tutti stiano recitando un copione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				}
			]
		},
