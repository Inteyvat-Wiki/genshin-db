			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Slazhnev",
					"Leifhelm"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700960201,
					"content": "Il nostro capitano non è solo forte, ha persino sviluppato un composto in grado di contrastare l'Abisso! Scommetto che non lo sapevi, eh, saputello? E ti permetti di dire che sono un \"falso esperto\" che non sa niente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960202
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960202,
					"content": "Beh, lo sai quanto è veloce il nostro Gran Maestro? Ha usato le linee geomantiche per viaggiare da Nod-Krai fino a Mondstadt in meno tempo di quanto ne impieghi tu ad allacciarti le scarpe... Ammesso che tu sappia farlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leifhelm"
				}
			]
		},
