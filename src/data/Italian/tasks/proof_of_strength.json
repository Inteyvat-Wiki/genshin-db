					"id": 700960701,
					"content": "*sospira* Comunque, anche se era il mio primo tentativo, non riesco a credere che le cose siano andate così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960702,
						700960704
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960702,
					"content": "Iniziare non è mai facile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960703
					]
				},
				{
					"id": 700960703,
					"content": "E poi, non è andata tanto male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960704,
					"content": "Il tuo primo tentativo di cosa, di preciso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "Ah... I miei primi Compiti della strega. Ti spiegherò tutto più in là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
