						],
						"pointId": 16843
					}
				]
			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "...Cercatore del Potere, Seguace del Fato, finalmente sei giunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960502,
					"content": "È Durin... Paimon non è affatto sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960503,
					"content": "C'è qualcosa di strano nel suo modo di parlare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "Un sommo sovrano, la creazione di una maga e un discendente degli angeli... Tutti esercitano poteri disparati, eppure tutti sono stati incoronati come draghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960505,
					"content": "...Questo perché i draghi sono il simbolo del potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960506,
					"content": "Quindi \"combattere contro i grandi draghi\" è diventato un modo per dimostrare la propria forza? Mh, inizio a capire un po' meglio il pensiero della Gran Maestra fondatrice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960507,
					"content": "...Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960508,
					"content": "Vedo che hai ancora molto da dire, ma suggerisco di incrociare le lame, piuttosto. Dopotutto, un solo colpo di spada vale più di mille parole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960509,
					"content": "A-Aspetta! G-Giovane umano, la prova che cerchi è lontana da qui. Devi avventurarti fino al Covo di Terrore alato e affrontare la profezia finale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960510,
					"content": "Perché parla così in fretta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "Tutto bene, Durin? Oggi sembri un po' sfasato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960513,
					"content": "(Ahhh, uff... Credo di aver detto le cose più importanti... Anche se ho dovuto saltare un bel po' di battute!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960514,
					"content": "Uhm, credo che Albedo abbia bisogno di aiuto per un esperimento, quindi è meglio che torni da lui. Scusatemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960515,
					"content": "Beh, se n'è andato di gran carriera... Che peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960516,
					"content": "Ehi, questo cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960517,
					"content": "Uhm... Che ci faceva Durin qui, esattamente? A parte quell'ultima frase sull'\"avventurarsi fino al Covo di Terrore alato\", il suo discorso sembrava solo un mare di sciocchezze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960518,
					"content": "Ho come la sensazione che...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "Interessante. Inizio a essere curioso di scoprire come si avvererà esattamente questa \"profezia\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960519,
					"content": "...fosse qui solo perché il prossimo drago potesse essere considerato il terzo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "Sembra un attore che non vede l'ora di uscire di scena!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
		{
