			"dialogs": [
				{
					"id": 102010301,
					"content": "Un portale verso un dominio! Il Mago dell'Abisso deve essersi nascosto lì dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010302,
					"content": "Allora non ha via d'uscita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "*ansimando*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010305,
					"content": "Klee, hai bisogno di fermarti un attimo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010306,
					"content": "Perché non aspetti qui mentre recuperiamo il tuo tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010307,
					"content": "No, vengo con voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010308,
					"content": "È il mio tesoro che il signor Palladipelo ha rubato... e sta a me riprenderlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010309,
					"content": "Ammiro il tuo coraggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "Eheh, non preoccuparti, Klee se la sa cavare benissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010312,
					"content": "#Coraggio, prode Cavaliere Onorari{F#a}{M#o}! Andiamooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010310,
					"content": "Ma questi luoghi possono essere pericolosi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "Continuiamo l'inseguimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
		{
