			"dialogs": [
				{
					"id": 102010101,
					"content": "Ci siamo! È il posto giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010102,
					"content": "Guarda, qui è dov'era sepolto il mio enooorme tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010103,
					"content": "E ora c'è un'enooorme buca vuota...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010104,
					"content": "Aspetta... Chi è quello laggiù?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "È un... Mago dell'Abisso?!? Ehi, forse è quello di cui parlava Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010106,
					"content": "Cos'ha in mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010107,
					"content": "Il mio tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010108,
					"content": "Cooosa?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010109,
					"content": "Tsk. Vedo che la ragazzina ha portato con sé i suoi amici! È ora di cambiare piano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010110,
					"content": "Ehi, tu! Se ti senti così forte, torna qui e combatti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010111,
					"content": "Prendiamolo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
