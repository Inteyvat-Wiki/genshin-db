					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "Tsk. Mi avete seguito, devo dire che sono colpito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010402,
					"content": "Però siete al capolinea, ormai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010403,
					"content": "Ah, sì? E cosa avresti intenzione di fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010404,
					"content": "Muhahaha! Ahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010405,
					"content": "Oh, la propensione umana al pettegolezzo ci ha fornito tutti gli strumenti che ci servono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010406,
					"content": "Abbiamo scoperto che la vostra piccola amica in rosso aveva il tesoro più potente di tutta Mondstadt tra le mani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010407,
					"content": "E ora è nelle mie! Non potete farci nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010408,
					"content": "Adesso questo prezioso tesoro sarà la vostra rovina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010409,
					"content": "No, no, aspetta! N-Non toccarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010410,
					"content": "Oh, guarda come ti agiti ora che la situazione ti è finalmente chiara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010411,
					"content": "Vediamo un po', cosa abbiamo qui... Un simbolo a forma di fiamma? Muhahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010412,
					"content": "*forte esplosione*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 102010501,
					"content": "NO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010502,
					"content": "Ho infranto le regole di sopravvivenza... \"Le esplosioni feriscono le persone, Jean può essere terribile\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010503,
					"content": "È la fine... Questa volta sono spacciata... *piagnucola*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010505,
					"content": "Aspetta, quindi il tesoro di Klee era una bomba?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010506,
					"content": "Che finale esplosivo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "Ora capisco perché dicono che Klee sia il combattente più forte di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010509,
					"content": "Paimon non vorrebbe proprio averla come nemica... Mai e poi mai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010510,
					"content": "Aspetta... Perché è scappata via di corsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010511,
					"content": "Ha detto qualcosa sulle regole di sopravvivenza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "Sembrerebbe così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010514,
					"content": "Oh, beh, allora andiamo al <color=#00E1FFFF>quartier generale dei Cavalieri</color> e facciamo rapporto a Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010512,
					"content": "Credo che abbia a che fare con Jean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010507,
					"content": "Ha completamente spazzato via quel Mago dell'Abisso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				}
			]
		},
