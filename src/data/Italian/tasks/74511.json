			"trigger": {
				"objectNames": [
					"Frejus",
					"Chenee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745110101,
					"content": "#Salve, {F#amiche}{M#amici}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110102,
					"content": "Ehm, cosa vogliono da noi gli agenti della Garde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110103,
					"content": "Eheh, provate a usare l'immaginazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110104,
					"content": "È perché saltiamo e voliamo da un muro all'altro della città?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "Ah, avete fatto anche quello? Bene, lasciate che l'aggiunga alla lista delle accuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110107,
					"content": "Ehi, stai cercando di gabbarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110108,
					"content": "No, sto scherzando. Immagino che le presentazioni siano d'uopo. Io sono Chenee, e lui è Frejus, il mio superiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110109,
					"content": "Il mio superiore ha realizzato una nuova invenzione che va testata. Vi andrebbe di darci una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110110,
					"content": "Una nuova invenzione? Di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110111,
					"content": "Un cannone telecomandato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110112,
					"content": "Come potete vedere, i modelli precedenti di torretta richiedono un operatore nelle vicinanze. In questo caso, a un nemico basta puntare al cannone per eliminare arma e operatore. Ma se queste armi potessero essere controllate da remoto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110113,
					"content": "...potremmo minimizzare le vittime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110114,
					"content": "E l'hai inventato così facilmente! Voglio dire, ecco perché ti chiamano \"il membro della Garde che ha rifiutato l'invito dell'Istituto di ricerca di Fontaine per ben tre volte\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110115,
					"content": "Rifiutato tre volte? L'Istituto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "Beh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110117,
					"content": "Esattamente! Non puoi capire, gli avevano messo gli occhi addosso. L'avrebbero pagato a peso d'oro pur di fargli fare delle ricerche per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110118,
					"content": "Ma è rimasto tutto questo tempo perché ama il suo lavoro! Ah, che dedizione commovente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110119,
					"content": "Ciononostante, non sopporta che i suoi talenti vengano sprecati, e quindi crea nuove invenzioni di tanto in tanto per aiutarci nel lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110120,
					"content": "Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110121,
					"content": "Ehm, mi lusinghi, Chenee. Ricordi cosa ti ho detto prima? Più sei intelligente, più è importante essere umile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110122,
					"content": "Sissignore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110123,
					"content": "In ogni caso, vorrei che ci aiutaste a verificare quanto sia fattibile creare questo cannone telecomandato. Abbiamo già preparato il \"campo\" e gli \"obiettivi\", e non temete: riceverete una bella ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110124,
					"content": "Hihi, in tal caso ti sei rivolto alle persone giuste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110125,
					"content": "Abbiamo visto un sacco di cose durante i nostri viaggi. Possiamo aiutarti a capire se la tua invenzione è valida o no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110126,
					"content": "Bene! In tal caso, buona fortuna a tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110127,
					"content": "Allora... Da questa parte, prego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110105,
					"content": "È perché mi esercito con la spada in città?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}