			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "Oh, hai trovato tutte le repliche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950202,
					"content": "Magnifico! Hai davvero un talento innato, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950203,
					"content": "Benissimo, ecco un regalo per te. Grazie per aver partecipato all'evento del nostro darsana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950204,
					"content": "#Spero che questo piccolo assaggio di archeologia sia stato di tuo gradimento, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950205,
					"content": "Detto questo, la vera archeologia tende a essere un lavoro abbastanza monotono e usurante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950206,
					"content": "Ma quando trovi proprio l'artefatto che stavi cercando, capisci che tutta quella fatica ha un valore inestimabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950207,
					"content": "E se non trovi niente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Beh, quando non si trova nulla, è \"tutta fatica sprecata\", come si suol dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950210,
					"content": "Sinceramente, tra le due, è anche l'eventualità più comune. Le volte in cui si trova qualcosa di effettivamente prezioso sono più uniche che rare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950211,
					"content": "Ma per fare gli archeologi bisogna sapersi abituare alle circostanze e rimanere ottimisti. Se non lo facessimo, rischieremmo di crollare da un momento all'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950208,
					"content": "Di sicuro capitano anche situazioni in cui non si riesce a trovare nulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
