			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732561201,
					"content": "Come pensavo. Il problema sono questi trasmettitori. L'energia dei nuclei non riesce ad arrivarci. Dobbiamo trovare un modo per connetterli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561202
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561202,
					"content": "E alcuni dei trasmettitori che sono qui sono sigillati nel cristallo... ma siccome queste rovine non usano le impurità come fonte energetica, l'attività della Khvarena non dovrebbe essere arrivata fin qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561203
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561203,
					"content": "L'unica spiegazione plausibile è che questo posto sia stato intenzionalmente sigillato da qualcuno in grado di manipolare la Khvarena. Ma a che scopo? Cosa avevano intenzione di nascondere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561204
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561204,
					"content": "Ah, beh, ne parleremo più tardi. L'obiettivo più impellente ora è usare la Khvarena per rimuovere i Cristalli grigi che hanno creato quei sigilli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561205
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561205,
					"content": "Dovrebbero esserci degli Spirinuclei contenenti il potere della Khvarena, nei paraggi. Confido che anche lei, potente Emissaria, riesca a percepirli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561206
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561206,
					"content": "Ehm... Umpf, mi sembra ovvio! Stai forse dubitando del maestoso potere della Guardiana della fioritura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561207
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732561207,
					"content": "Tutt'altro, non mi permetterei mai! La prego di guidarci, grande ed eminente Emissaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561208
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561208,
					"content": "Dobbiamo soltanto trovare gli Spirinuclei e rimuovere i Cristalli grigi; dopodiché, useremo di nuovo il convertitore per connettere i trasmettitori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
