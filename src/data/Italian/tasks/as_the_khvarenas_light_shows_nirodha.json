			"dialogs": [
				{
					"id": 732560901,
					"content": "Che succede? Qualche problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560902
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560902,
					"content": "Dovete solo seguire gli schemi, trovare il blocco di energia e tornare qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325610,
			"completionStepIds": [
				7325610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
