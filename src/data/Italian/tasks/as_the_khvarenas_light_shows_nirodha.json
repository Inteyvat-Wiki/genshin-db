				{
					"id": 732562003,
					"content": "Hai proprio una sfrenata immaginazione, Pallidina volante. Il Nasuraia non ha forse detto che questo luogo è stato modificato rispetto al progetto originario, per adibirlo alla sperimentazione funzionale dei macchinari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562004
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562004,
					"content": "A quanto pare, il dispositivo che abbiamo sbloccato serviva ad attivare il terreno di prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562005
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562005,
					"content": "Stando a come appare, le modifiche non prevedevano lo smantellamento dei dispositivi originali. Una scoperta decisamente utile, invero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562006
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562006,
					"content": "#In tal caso, {F#mia}{M#mio} Yasnapati, lascio a te l'onore di adoperare questo cannone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
		{
			"id": 7325623,
			"completionStepIds": [
				7325623
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325623",
							"2"
						],
						"stepId": 7325623,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "#Potente Emissaria, e {F#sua}{M#suo} onorat{F#a}{M#o} Yasnapati, temo di non potervi assistere oltre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562302,
					"content": "Che problema c'è, stavolta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "Stando ai testi, la strada più avanti è colma di pericoli a cui i comuni mortali non potrebbero sopravvivere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562304,
					"content": "Una volta entrati, saremo nel terreno di prova che i dahriani usavano per sperimentare i loro macchinari. Tra quelle c'è perfino un prototipo incompleto di macchina gigante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562305,
					"content": "La copia delle cronache dahriane che ho tra le mie note dice che questo posto venne modificato per essere usato come fortificazione da cui poter attaccare i mostri, ma sembra che non sia mai stato usato molto in questo senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562306,
					"content": "Strano, non trovate? Perché i dahriani, che accesero la miccia dell'empio disastro, avrebbero creato delle macchine per combattere i mostri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562307,
					"content": "Inoltre, ora che abbiamo attivato i sistemi di controllo di queste rovine, anche i meccanismi difensivi all'interno del terreno di prova saranno operativi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562308,
					"content": "Il Grande Canto che stiamo cercando dovrebbe trovarsi all'interno di quel Golem. Non potrò aiutarvi, ma sono sicuro che per voi sarà una passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562309,
					"content": "Permettetemi di aspettare qui il vostro ritorno, così potremo ottenere tutti i Grandi Canti di Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562310,
					"content": "In effetti, tu non sei che un comune umano. È una richiesta del tutto lecita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562311,
					"content": "Con permesso, dunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562312,
					"content": "Bene, Nasejuna se l'è sfangata all'ultimo secondo. Se non altro, Paimon ora è contenta che non sentirà per un po' i vostri discorsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7325624,
			"completionStepIds": [
				7325624
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
