			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562701,
					"content": "Proprio come dicono gli appunti... Mmh? Siete già di ritorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562702
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562702,
					"content": "A giudicare dal vostro aspetto, avete trovato il blocco di energia che ci serve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562703,
					"content": "Ho esaminato questi nuclei energetici... Il loro stato di conservazione è davvero notevole. Ora non rimane che innestarvi il blocco di energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562704
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562704,
					"content": "E questo... lo lascio fare a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
