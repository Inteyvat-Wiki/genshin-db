			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562401,
					"content": "#Ah, come ci si aspettava dalla potente Emissaria e dal{F#la} {F#sua}{M#suo} Yasnapati. Non esiste macchinario dahriano o creatura di Dev che possa fermarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562402,
					"content": "Eh? Come hai fatto ad arrivare fin qui, Nasejuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562403,
					"content": "Oh, mi ero messo in disparte a osservare la vostra mirabolante battaglia, e che spettacolo incredibile è stato! Ovviamente, quando ho visto che avevate recuperato il Grande Canto, mi sono affrettato a raggiungervi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562404
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562404,
					"content": "#Avete fatto tutt{F#e}{M#i} un ottimo lavoro. E, visto che siamo in tema, volete che pensi io a custodire i Grandi Canti di Khvarena? Un simile compito potrebbe, beh... come dire... darmi un maggior senso di partecipazione a questa grande impresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562405,
					"content": "Ma tu non hai fatto granché fin dall'inizio. E comunque Zurvan ha detto che non è saggio affidare i Grandi Canti di Khvarena a gente a caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562406,
					"content": "Oh, non dire così. Voglio dire, ho svolto ricerche approfondite su di loro! Se le esaminassi un po' anch'io potrebbe tornarci utile più tardi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562407
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562407,
					"content": "Ad esempio, potremmo capire come mai questi Grandi Canti di Khvarena sono stati nascosti proprio in queste rovine, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562408,
					"content": "Non è il momento per pensare alle storie, Nasuraia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562409
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562409,
					"content": "Infatti! Dobbiamo raggiungere il prossimo luogo e trovare un'altra Khvarena, o sbaglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562410,
					"content": "Quando li avremo presi tutti, potrai raccontarci tutte le storie che vuoi, Nasejuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562411,
					"content": "Beh... d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
