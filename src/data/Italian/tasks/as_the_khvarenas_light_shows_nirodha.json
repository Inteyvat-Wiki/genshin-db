			"dialogs": [
				{
					"id": 732562801,
					"content": "Se venissi anch'io, credo che vi sarei solo d'impaccio. Preferisco restare qui ad aspettarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562802
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562802,
					"content": "Ma in fondo, che si tratti di macchinari dahriani o mostri di Dev, credo che nulla potrà ostacolare te o la grande Emissaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		}
	]
