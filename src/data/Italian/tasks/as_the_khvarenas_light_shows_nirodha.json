				"objectNames": [
					"Nasejuna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732561001,
					"content": "I nuclei energetici sono pieni. Ora potremo attivare i sistemi di controllo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561002
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561002,
					"content": "Eh? C'è qualcosa che non torna. Che ci sia qualche intoppo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561003
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561003,
					"content": "Pare che dovremo dare un'occhiata al centro di controllo dove si trovano i trasmettitori. Poco male, è comunque sulla strada che porta al terreno di prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561004
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561004,
					"content": "Beh, pare che il centro di controllo si trovi nella direzione da cui siete venuti prima. Già che ci siamo, direi di andarci insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325612,
			"completionStepIds": [
				7325612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325612",
							"2"
						],
						"stepId": 7325612,
						"stateName": "QUEST_STATE_UNFINISHED"
