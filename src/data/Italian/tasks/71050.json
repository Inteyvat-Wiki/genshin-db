			"dialogs": [
				{
					"id": 710500401,
					"content": "A proposito di questi funghi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "#Ecco perché ti considerano {F#un'}{M#un }avventurier{F#a}{M#e} espert{F#a}{M#o}... Hai trovato subito qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500403,
					"content": "#Uh? Sicur{F#a}{M#o} di averli trovati qui? Che strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500404,
					"content": "Trovi strano che dei funghi crescano sottoterra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "Non intendevo questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500406,
					"content": "È che hanno un aspetto simile a un fungo tipico di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500407,
					"content": "Non so ancora dire di cosa si tratti ma, se ne avessi abbastanza, potrei arrivare a una conclusione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500408,
					"content": "A proposito... Dato che li hai trovati, saprai anche dove prenderne degli altri. Puoi aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500409,
					"content": "Portami abbastanza funghi e ti pagherò profumatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500410,
					"content": "Quanti sono abbastanza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "Mmmh, fammi pensare. Diciamo otto, per cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500412,
					"content": "Non temere. Se me li porti, salderò il mio debito, te l'assicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105007,
			"completionStepIds": [
				7105003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
