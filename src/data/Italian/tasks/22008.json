						220080402
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080402,
					"content": "Ehi, se prendi la tua medicina, ti darò del tofu di mandorle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080403
					]
				},
				{
					"id": 220080403,
					"content": "Tofu di mandorle? Ma devo comunque prendere la medicina prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080404
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080404,
					"content": "Doudou, dai, fai la brava, starai meglio se prendi la medicina... E poi... c'è del tofu di mandorle che ti aspetta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080405
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080405,
					"content": "Uffa... Non capisco, il signor Baizhu è così intelligente... perché non può fare una medicina al gusto di tofu di mandorle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hongdou"
				}
