						],
						"stepId": 2200801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Doudou, dai, fai la brava, starai meglio se prendi la medicina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "No! Non voglio! Non mi piace, ha un sapore disgustoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "#Oh, ciao, viaggiat{F#rice}{M#ore}. Doudou è una bambina piuttosto cagionevole di salute. Il dottor Baizhu le ha prescritto questa medicina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "Ma lei non vuole prenderla. Si lamenta perché non le piace il sapore... *sospira* Purtroppo, tutte le medicine a base di erbe sono amare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "Riesco a farle prendere la medicina solo se dopo mangia una ciotola di tofu di mandorle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti andare a prendermi una porzione di tofu di mandorle? Io rimango qui, non sono ancora riuscita a convincerla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Grazie. Una porzione sarà sufficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "Che malattia ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "*sospira* Vorrei saperlo anch'io. Qualunque cosa sia, il dottor Baizhu dice che è quasi impossibile da curare, e che solo per tenere sotto controllo i sintomi occorrono molte medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "Ho paura che dovrà prendere medicine per tutta la sua vita. Eppure è così piccola ancora... Non riesco nemmeno a pensarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "Vorrei essere io quella con la malattia... L'unica cosa che posso fare, invece, è sperare che la mia povera piccola possa stare meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "In ogni caso, vai a prendermi un po' di tofu di mandorle. Una sola porzione andrà bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Ehi, Doudou. Non ti piace la medicina, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "È disgustosa!!! La medicina che prende Lulu è molto meno amara della mia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Doudou... Lulu e i suoi amici stavano solo fingendo, non stavano realmente bevendo una medicina, ma dell'acqua zuccherata avanzata da una ciotola di tofu di mandorle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "Oh... Quindi il tofu di mandorle non mi farà stare meglio? Allora... Mi sa che dovrò prendere quella medicina disgustosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "Brava, piccolina mia. Appena starai meglio potrai mangiare tutto ciò che vuoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "Perché le medicine non possono avere lo stesso sapore dolce del tofu di mandorle? Non è giusto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "*sospira* Non c'è modo di convincerla... In ogni caso, vai a prendermi un po' di tofu di mandorle. Una sola porzione andrà bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
