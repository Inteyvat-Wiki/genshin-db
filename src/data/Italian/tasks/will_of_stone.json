					"nextDialogs": [
						708151103
					]
				},
				{
					"id": 708151103,
					"content": "Perfetto. Sono i suoi giocattoli preferiti. Per favore, accetta questa ricompensa come segno della mia gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151104,
					"content": "Tua figlia preferirebbe che tu tornassi a casa.",
