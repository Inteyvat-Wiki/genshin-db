					"nextDialogs": [
						708151003
					]
				},
				{
					"id": 708151003,
					"content": "Oh, davvero... Rimane il fatto, però, che ciò che la Piccola Liu vuole veramente è rivedere suo padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
