					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150401,
					"content": "*sospira* Stavo già contando i giorni prima di partire. Mancavano solo un paio di giorni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150402,
					"content": "Con tutte le ferie che ho accumulato fino a ora, avrei potuto passare più di una settimana con la Piccola Liu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150403,
					"content": "Invece, con un solo ordine hanno annullato tutte le ferie. Hanno pure richiamato coloro che erano già partiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150404,
					"content": "Questo significa che non ho speranza di tornare al Villaggio di Qingce almeno per un altro mese, lo so bene. Che sfortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
