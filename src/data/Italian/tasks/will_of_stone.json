					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708151004,
					"content": "Quella bambina è cresciuta in un batter d'occhio, come il bambù intorno al villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151005
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708151005,
					"content": "I giorni in cui i bambini sono piccoli non tornano più. È un vero peccato perderseli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonna Ruoxin"
