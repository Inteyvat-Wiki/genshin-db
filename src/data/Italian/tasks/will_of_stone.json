					"nextDialogs": [
						708151105
					]
				},
				{
					"id": 708151105,
					"content": "Anch'io vorrei tornare, ma, data la situazione al Porto di Liyue, dubito che in questo periodo sarà possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151106,
					"content": "In ogni caso, grazie mille. Spero che i miei regali le tireranno un po' su il morale. Sono i suoi giochi preferiti, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151107,
					"content": "Per favore, accetta questa ricompensa come ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
