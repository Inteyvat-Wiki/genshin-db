				{
					"id": 708151001,
					"content": "#Sei tornat{M#o}{F#a}. Grazie mille dell'aiuto. La Piccola Liu è già tornata a casa e aveva con sé anche i suoi regali.",
					"roleType": "TALK_ROLE_NPC",
