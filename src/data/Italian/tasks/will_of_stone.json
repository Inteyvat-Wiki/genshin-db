					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nonna Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "Oh, dov'è finita quella bambina...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150502,
					"content": "Sto cercando la Piccola Liu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "Oh, davvero? *sospira* Che pessimo tempismo. Non so dove se ne sia andata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150504,
					"content": "Ha ricevuto una lettera dal Porto di Liyue, che suo padre ha fatto spedire da qualcuno. Il messaggio diceva che sarebbe tornato presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150505,
					"content": "La Piccola Liu era così felice. Ha detto che voleva preparare un regalo per suo padre ed è andata a raccogliere frutti e fiori insieme ad altri bambini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150506,
					"content": "Qualche giorno dopo, però, suo padre ha comunicato di non riuscire a tornare per colpa di un incarico ricevuto all'ultimo minuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150507,
					"content": "Ha cominciato a fare tanti capricci e non c'è stato modo di toglierle dalla testa l'idea che se lui non poteva tornare, sarebbe andata lei al Porto di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150508,
					"content": "Per un po' abbiamo pensato che stesse scherzando, ma questa mattina non c'era più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150509,
					"content": "*sospira* Ho già mandato qualcuno a cercarla, ma potresti provare a cercarla anche tu, se ti va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150510,
					"content": "Farò un tentativo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "Mi scuso per il disturbo. *sospira* Ah, che bambina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150512,
					"content": "Dove pensi sia andata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "Dubito sia molto lontana. Probabilmente è ancora qui intorno, ma potrebbe essere in pericolo... Per favore, trovala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonna Ruoxin"
				}
			]
		},
		{
			"id": 7081506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
