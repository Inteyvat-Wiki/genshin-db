			"dialogs": [
				{
					"id": 708150901,
					"content": "Bambole... aquiloni... girandole... Papà mi ha mandato ancora queste cose, proprio come pensavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150902
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150902,
					"content": "*sospira* Volevo mandargli dei regali anch'io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150903
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150903,
					"content": "Li porto io al tuo papà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150904
					]
				},
				{
					"id": 708150904,
					"content": "Mi aiuterai? Beh... anche se nemmeno tu hai una Visione, non hai avuto difficoltà a sconfiggere quei mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150905
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150905,
					"content": "Allora, penso che possiamo fare così. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150906
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150906,
					"content": "*sospira* Se solo fossi forte come te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Liu"
				}
			]
