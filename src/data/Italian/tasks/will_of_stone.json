			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccola Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "#Sei venut{M#o}{F#a} a prendermi per riportarmi al Villaggio di Qingce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150702,
					"content": "Nonna Ruoxin è molto preoccupata per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "#Umpf, e quindi sei venut{M#o}{F#a} a prendermi. Non voglio tornare lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150706,
					"content": "Torna indietro e di' agli abitanti del villaggio che sto andando al Porto di Liyue per cercare il mio papà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150707,
					"content": "Non devono preoccuparsi. Quando l'avrò trovato, staremo un po' insieme e poi tornerò a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150704,
					"content": "Ho qualcosa per te...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "Non mi serve niente. Stai solo cercando di convincermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Piccola Liu"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081508",
							"2"
						],
						"stepId": 7081508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccola Liu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "Perché continui a seguirmi? Ho detto che voglio andare al Porto di Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150802,
					"content": "Riuscirò a evitare questi mostri da sola. Non mi scopriranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150803,
					"content": "Non trattarmi come una bambina! Sono grande adesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150804,
					"content": "Ho delle cose per te, da parte di tuo padre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "Da parte di papà? Ti ha chiesto lui di portarle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150806,
					"content": "Scommetto che sono solo giocattoli per bambini... Cose come aquiloni, oppure bambole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150807,
					"content": "Non ti piacciono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "Sì, mi piacciono. Sono dei regali del mio papà, come potrebbero non piacermi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150809,
					"content": "Ma se continuano a piacermi queste cose, non vuol dire che rimarrò per sempre una bambina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150810,
					"content": "Se continuo a giocare con queste cose, quando potrò diventare un'avventuriera oppure ottenere una Visione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150811,
					"content": "E perché mai vorresti una Visione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "Se avessi una Visione, potrei fare tante cose, come guadagnare soldi o altro ancora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150813,
					"content": "Così papà non avrebbe più bisogno di lavorare sempre al Porto di Liyue. Potrebbe tornare a casa e stare con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150814,
					"content": "Adesso, senza una Visione, non posso neanche andare da sola fino al Porto di Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150815,
					"content": "Ora che papà ti ha mandato qui con i suoi regali però, se andassi a cercarlo, gli causerei più problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>Anch'io ho preparato dei regali per lui</color>. Volevo fargli una sorpresa, ma ora... non posso portarglieli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "Piccola Liu"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>Se solo qualcuno potesse aiutarmi</color>... Va bene, torno indietro. Non c'è bisogno che tu mi segua, so come tornare a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Liu"
				}
			]
		},
