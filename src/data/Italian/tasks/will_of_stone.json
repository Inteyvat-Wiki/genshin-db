					"Nonna Ruoxin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150601,
					"content": "E anche Jiayi. Come ha potuto rimangiarsi la parola così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150602,
					"content": "Ormai si vedono solo poche volte all'anno. È così che si comporta un buon padre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150603,
					"content": "Ha dovuto farlo per il Porto di Liyue...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "È quello che dice ogni anno, ormai ho perso il conto di quante volte ho sentito quelle parole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150605,
					"content": "Sta solo facendo il suo dovere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "Beh, anche prendersi cura di sua figlia è un dovere. La Piccola Liu cresce di giorno in giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150607,
					"content": "Se non si sbriga, quando tornerà sarà lei quella a dover lasciare casa per andare a lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Nonna Ruoxin"
				},
				{
					"id": 708150608,
					"content": "Questi due non riescono proprio a passare un po' di tempo insieme, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonna Ruoxin"
				}
			]
		},
		{
			"id": 7081507,
			"completionStepIds": [
				7081505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
