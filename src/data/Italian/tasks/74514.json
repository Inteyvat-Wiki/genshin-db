				]
			},
			"dialogs": [
				{
					"id": 745140101,
					"content": "S-Si gela... Non sarei dovuta uscire con questo vento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140102,
					"content": "#...Eh? {NICKNAME}! Paimon! Siete vo... ETCIÙÙÙ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140103,
					"content": "Asagiri? Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "Stai bene? Come hai fatto ad arrivare fin qui da sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745140105,
					"content": "Io... Beh... Ora sto molto meglio! Non ho più nemmeno la tosse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140106,
					"content": "Ahah... Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140107,
					"content": "Ne sei sicura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "#Woah! Non ce n'è bisogno! Lo ammetto, sono uscita di nascosto! {F#Contenta}{M#Contento}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140110,
					"content": "Non... Non ho avuto scelta. Come farei a creare delle belle immagini se passassi tutto il tempo a Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140111,
					"content": "Anche se vi facessi andare in giro per scattare delle foto per me, le immagini di riferimento non sarebbero paragonabili a quello che vedrei con i miei occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140112,
					"content": "Così ho chiesto a un autore con cui lavoravo di mettermi in contatto con una nave mercantile, e ho scroccato un passaggio per poter viaggiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140113,
					"content": "E hai perfino portato con te tutti i tuoi strumenti da disegno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "Ma certamente! I miei strumenti sono tutto per me! Come potrei mai dimenticarmeli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140115,
					"content": "Inoltre, i miei lavori stanno vendendo davvero bene a Fontaine. Alcuni scrittori mi hanno persino chiesto di realizzare la copertina dei loro romanzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140116,
					"content": "Anche se, a quanto pare, non hanno l'abitudine di inserire illustrazioni all'interno dei romanzi! Strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140117,
					"content": "#Ah, a proposito... Visto che sei qui, {NICKNAME}... Ti andrebbe di aiutarmi a raccogliere dei materiali di riferimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140118,
					"content": "Molto volentieri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "Perfetto! Con il tuo aiuto, il mio lavoro sarà una passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140123,
					"content": "Va bene, fammi dare un'occhiata. Si dà il caso che abbia appena ricevuto dei nuovi incarichi da parte di alcuni scrittori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140120,
					"content": "Bene, allora! Ma non cominciare a correre in giro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "#{F#Tranquilla}{M#Tranquillo}! Non voglio rischiare d'incontrare dei Mekautomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140122,
					"content": "#Quando si tratta di affrontare dei mostri strani, qui l'{F#esperta}{M#esperto} sei tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "Asagiri"
				},
				{
					"id": 745140108,
					"content": "Scriverò alla casa editrice per verificare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}