			"dialogs": [
				{
					"id": 150421501,
					"content": "Perfetto, allora contiamoci. Uno, due, tre, quattro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421502,
					"content": "Uh, siamo uno in più rispetto a prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421503
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421503,
					"content": "Oh, salve! Immagino che siate qui per la sfida principale della Baia Ondosa, dico bene? Purtroppo c'è stato un piccolo inconveniente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421504
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421504,
					"content": "Ma, ehm... Se vi serve una foto ricordo per il vostro album, posso scattarvela comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421505
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421505,
					"content": "No... Questo è assolutamente fuori discussione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421506,
					"content": "Le foto sono solo un modo per conservare un ricordo, qualcosa da guardare in futuro per ripensare a dei momenti felici. Ciò che per noi conta davvero è vivere l'esperienza in prima persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421507
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421507,
					"content": "Beh, c'è da dire che queste specifiche foto vanno scambiate con dei premi, ma... Sì, Paimon concorda con te. Farsi la foto e andarsene via così non avrebbe molto senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421508,
					"content": "Capisco, e mi dispiace che la situazione sia questa. Portate pazienza, faremo il possibile per risolvere il problema al più presto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421509
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421509,
					"content": "Quanto credi ci sarà da aspettare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421510,
					"content": "Beh, difficile a dirsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421511
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421511,
					"content": "Eh? Come mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421512,
					"content": "Possiamo dare una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421513
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421513,
					"content": "Mmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421514
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421514,
					"content": "Ho notato che non avete molte persone a occuparsi delle attrazioni minori della Baia Ondosa, e anche il personale saurico sembra piuttosto stanco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421515
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421515,
					"content": "Immagino sia per via dei problemi tecnici dell'attrazione principale: la maggior parte del personale è stata spostata lì per aiutare con la riparazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421516
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421516,
					"content": "Tranquilla, di sicuro ci sono cose che non puoi divulgare. Non voglio renderti le cose ancora più difficili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421517
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421517,
					"content": "Anzi, a dirla tutta, potremmo esserti utili: i miei compagni sono tutti molto in gamba e pronti a dare una mano. Hanno appena finito di collaudare sia la Crociera al tramonto che la Corsa degli Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421518
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421518,
					"content": "Se ci dici qual è il problema, sono sicura che potremmo aiutarti a risolverlo in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421519
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421519,
					"content": "Wow, come negoziatrice è veramente discreta! Dev'essere un potere nascosto del suo ruolo di Pacificatrice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421520,
					"content": "Un momento, Chasca... Tu come fai a saperlo? Non ci avrai mica spiati dalla cima di qualche albero, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421521,
					"content": "Ha davvero importanza, in questo momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421522
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421522,
					"content": "Ciò che conta... è che siamo ottimi aiutanti! Pertanto, se c'è qualche problema, faremo del nostro meglio per risolverlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421523
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421523,
					"content": "Beh, hai davvero occhio: sei riuscita perfino a capire le condizioni dei nostri Saurici... Vi chiedo scusa, non avrei dovuto tentare di nascondervelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421524
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421524,
					"content": "Beh, in pratica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421525
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421525,
					"content": "Durante il collaudo, ci siamo resi conto che la verniciatura del Megascivolo Baldobrio lascia MOLTO a desiderare. E dato che va spruzzata percorrendo lo Spirisentiero, si tratta a dir poco di una sfida formidabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421526
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421526,
					"content": "Per non ritardare l'apertura ufficiale del resort, abbiamo dovuto chiudere temporaneamente questa specifica attrazione. Ora come ora, è una corsa contro il tempo per cercare di sistemare tutto il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421527
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421527,
					"content": "Ahah... E questa me la chiami sfida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421528
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421528,
					"content": "Dimmi dov'è la vernice e me ne occuperò io in un baleno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421529
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421529,
					"content": "Eh? Ma tu... come pensi di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421530
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421530,
					"content": "Ah, è perché non l'hai mai incontrata. Lei è Mualani \"Um{RUBY#[S]Unità}oja\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421531
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421531,
					"content": "Mualani... Aspetta, hai detto Mualani?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421532
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421532,
					"content": "Vuoi dire... QUELLA Mualani?! Una dei Sei Eroi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuksina"
				}
			]
		},
