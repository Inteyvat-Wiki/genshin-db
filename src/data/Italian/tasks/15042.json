			"dialogs": [
				{
					"id": 150421401,
					"content": "Che te ne pare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421402,
						150421404,
						150421406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421402,
					"content": "Un po' facile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421403
					]
				},
				{
					"id": 150421403,
					"content": "#Eheh, sei così {F#sicura}{M#sicuro} di te! Tutto sommato, però, te la sei cavata benissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421408,
					"content": "Forse posso parlare col personale responsabile e dare loro qualche suggerimento per rendere il tutto ancora migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421409
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421409,
					"content": "A parer mio... dovrebbero permettere una sfida diretta tra due concorrenti per decidere il migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421404,
					"content": "Ho la vista... completamente annebbiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421405
					]
				},
				{
					"id": 150421405,
					"content": "Ahah! Mantenere la concentrazione consuma molte energie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421406,
					"content": "È stato divertente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421407
					]
				},
				{
					"id": 150421407,
					"content": "Vero? Quindi siamo giunti alla stessa conclusione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421408
					],
					"speakerTitle": "Chasca"
				}
			]
		},
