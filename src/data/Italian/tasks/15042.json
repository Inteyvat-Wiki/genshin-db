			"dialogs": [
				{
					"id": 150421701,
					"content": "Ottimo lavoro, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421702,
					"content": "Fiuu... È stato PAZZESCO! Come me la sono cavata? Non male, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421703,
					"content": "È incredibile! Un'opera veramente eroica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421704,
					"content": "Mentre eri via, Paimon mi ha raccontato tutto di te: sono rimasto a bocca aperta nel sapere di tutte le imprese che hai compiuto! Sento un ardore travolgente dentro di me solo a pensarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421705,
					"content": "Ahhh, ma grazie, ahah! Ora mi sento così esaltata che potrei festeggiare fino a dopodomani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421706,
					"content": "Oh, guardate! C'è il personale della Baia Ondosa! Dopo tutto quel lavoro, saranno felici di potersi rilassare un po', finalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421707,
					"content": "Credo che la loro idea sia tutt'altra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421708,
					"content": "Eh? In che senso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421709,
					"content": "Mualani, Mualani! Posso avere il tuo autografo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421710,
					"content": "Anche a me, ti prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150421711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "Cucciolo di Iktomisauro"
				},
				{
					"id": 150421712,
					"content": "Sembra che la tua copertura sia saltata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
					"id": 150421713,
					"content": "Oh-oh... Sbrighiamoci e scattiamo la foto, prima che quella folla ci raggiunga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421714
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421714,
					"content": "Bene! Mettetevi in posa e fate un bel sorriso! Pensate all'oceano e ai vostri colori portafortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421715
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421715,
					"content": "Tre, due, uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421716
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421716,
					"content": "Koholasauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421717,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
