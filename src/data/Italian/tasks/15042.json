			"dialogs": [
				{
					"id": 150420101,
					"content": "Yuhuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420102,
					"content": "Sole, mare e Koholasauri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420103,
					"content": "E appena vede l'acqua, è come se tutti noi non esistessimo. Paimon pensava che \"Um{RUBY#[S]Unità}oja\" volesse dire che nessuno rimane indietro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420104,
					"content": "Veloci, da questa parte! Forza, non cincischiate... Sbrigatevi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420105,
					"content": "Oh! Arriviamo, sì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420106,
					"content": "Ecco, ditemi cosa vedete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420107,
					"content": "Una tavola di legno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420108,
					"content": "Non una tavola di legno qualsiasi. Guarda bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420109,
					"content": "Oooh, è una cartina turistica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420110,
					"content": "Esatto! Ed è come una chiave preziosa per una cassaforte colma di tesori incredibili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420111,
					"content": "Già, sottoscrivo! È come il preludio di un'avventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420112,
					"content": "Sì! O come una brace ardente di Flogisto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420113,
					"content": "Flogisto? Ah... È un tipo di energia, dico bene? Vuoi dire che... basta guardarla per sentirsi infiammati di entusiasmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420114,
					"content": "Proprio così! E, proprio come il Flogisto, le mappe sono importantissime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420115,
					"content": "Con una mappa a portata di mano, puoi tracciare il tuo percorso d'avventura come più ti aggrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420116,
					"content": "Eheh, libertà e avventura! Musica per le mie orecchie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420117,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150420118,
					"content": "Ehi, ehi, andateci piano... Perché Paimon ha la sensazione che Mualani ci stia nascondendo qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420119,
					"content": "Bene, gente, siete liberi di andare dove preferite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420120,
					"content": "Ehi, aspetta! Siamo appena arrivati e vuoi liquidarci tutti così? Che razza di guida turistica sei?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420121,
					"content": "Forse Mualani vuole andarsene a zonzo per conto suo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "#Eheh, sei {F#una vera amica}{M#un vero amico}. Saprò sdebitarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420124,
					"content": "Eheh, guardate qua. Queste due attrazioni sono indicate come \"in fase di collaudo\". Devono aver avuto qualche problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420125,
					"content": "Se ci dividiamo, possiamo visitare le attrazioni che c'interessano di più e al contempo dare una mano coi collaudi! Forse riusciremo a rimettere in sesto la Baia Ondosa prima del previsto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420126,
					"content": "Oh, allora stavi davvero pensando al gruppo... Scusa. Paimon credeva volessi piantarci in asso per andartene a giocare con l'acqua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420127,
					"content": "Eheh, non fa niente. Che ne dite di riunirci vicino all'edificio enorme a forma di Koholasauro, quando abbiamo finito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420128,
					"content": "In base alla mia esperienza come guida, che ho maturato nel corso di anni di attività, l'ingresso per la sfida principale deve trovarsi qui da qualche parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420129,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150420130,
					"content": "Benissimo, allora dividiamoci. E non dimenticate di controllare la mappa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420122,
					"content": "Anche una \"guida\" ha bisogno di una vacanza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
		{
			"id": 1504213,
