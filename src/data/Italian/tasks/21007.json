			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "Se ne sono andati... Se ne sono andati tutti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070502,
					"content": "Yuan Qing, Yuan Liang e Yuan Cheng... Siete solo degli sciocchi. Dovete riflettere di più e fare più attenzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100708",
							"3"
						],
						"stepId": 2100708,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Qing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "Ehi, guarda! Sono i tipi di prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210070602,
					"content": "L'albero solitario non ha foreste da chiamare casa... Ahah, è vero, non si ottiene niente da soli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070603,
					"content": "Le splendide rosse foglie autunnali, sparse in giro ma non da vento alcuno... Se solo mi potessi fidare dei miei fratelli e di mio padre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070604,
					"content": "Le splendide rosse foglie autunnali sono sparse da una brezza passeggera... Il tesoro... Perso tutto, per colpa del tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070605,
					"content": "Gli alberi dovrebbero fondere le loro radici e l'ombra, perché è lì la casa... Bambini, dovremmo essere una famiglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070606,
					"content": "Avete davvero pensato che avessi nascosto il tesoro nella miniera...? *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070607,
					"content": "Eppure c'è un tesoro... Vi ricordate dell'albero che abbiamo piantato insieme come una famiglia quando eravate piccoli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070608,
					"content": "Vengo qui ogni anno a lasciarci qualcosa, sperando che un giorno, quando sarete più grandi, potremo dissotterrarlo insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070609,
					"content": "E poi usarlo per comprarci qualcosa di goloso, o una bottiglia di vino... Per festeggiare insieme, come una famiglia... Ah, i vecchi tempi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070610,
					"content": "Oh, bambini, i miei cari bambini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		}
	]
}