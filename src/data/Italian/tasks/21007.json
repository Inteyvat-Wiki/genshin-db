			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Qing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070201,
					"content": "Oh, no! Cos'ho fatto di male per meritarmi tutto questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070202,
					"content": "Finalmente sono riuscito a sgattaiolare via mentre non guardavano, così da poter arrivare per primo alla miniera e trovare il tesoro... Ma da dove vengono tutti quei mostri?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070203,
					"content": "Ci rinuncio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Qing"
				}
			]
		},
