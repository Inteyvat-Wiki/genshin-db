			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Cheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "Tsk, che schifosi i miei fratelli maggiori! Li importa solo di tenersi le cose migliori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070302,
					"content": "E papà sta perdendo il senno con la vecchiaia... O non ne sa assolutamente niente, o fa finta di non vedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070303,
					"content": "Penso non abbiano ancora capito che il tesoro è nella miniera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070304,
					"content": "Devo metterci le mani sopra... e poi allontanarmi il più possibile da qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Cheng"
				}
			]
		},
		{
			"id": 2100704,
