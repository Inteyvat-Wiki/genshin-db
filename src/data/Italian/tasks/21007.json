			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Liang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "Eheheh... Il tesoro sarà mio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070402,
					"content": "I miei fratelli sono così stupidi... Dopo aver letto un paio di righe pensavano di aver già capito tutto. Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070403,
					"content": "Onora la volontà di tuo padre? Bah! C'era una sola riga che valeva la pena leggere, ed era la parte sul tesoro nascosto nella miniera. A proposito... Fra poco sarà tutto mio! Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Liang"
				}
			]
		},
