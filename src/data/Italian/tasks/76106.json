				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060101,
					"content": "#Mmh? Non credo di averti mai vist{F#a}{M#o} prima. Sei nuov{F#a}{M#o} da queste parti, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060201,
					"content": "...Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "Te lo dico per il tuo bene: non andare a curiosare in giro per l'Istituto di Progettazione, soprattutto non al secondo piano! Un'eccessiva esposizione al Kuuvahki può causare mal di testa e persino nausea. Non dire che non ti avevo avvertito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "Davvero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "Certo! Tutti quelli che lavorano lì ricevono una porzione extra di sidro di mele. Pensaci: se non fosse dannoso per la salute, perché dovrebbero corrompere le persone con qualcosa di così buono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060303,
					"content": "E poi, l'ho visto con i miei occhi nel territorio degli Eredi della Luna gelata! Alle loro sacerdotesse sono cresciute delle corna... sulle loro teste! Pensi davvero che sia normale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060304,
					"content": "Capisco... Grazie per l'avvertimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "Ma è terrificante! A-Anche Paimon si trasformerà in un mostro...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761060306,
					"content": "*sospira* Mandano sempre i novellini per gli incarichi più rischiosi... Fai attenzione e non rimanere lì dentro troppo a lungo, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610604,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060401,
					"content": "È questo tutto ciò di cui sono capaci i potenti Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "Tsk, la sfacciataggine è un requisito per essere assunti di questi tempi...? Aspetta un attimo. Tu non sei una delle nuove reclute che abbiamo appena assunto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060403,
					"content": "#Pensavi di infiltrarti, eh? Purtroppo per te, ti ho smascherato subito... Prendetel{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610605,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
