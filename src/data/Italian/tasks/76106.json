					"Veroslava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060501,
					"content": "Sono la tua nemesi da tempo! Piacere di conoscerti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060502
					]
				},
				{
					"id": 761060502,
					"content": "Argh, un attacco nemico... Tutte le unità, all'attacco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
			"id": 7610606,
