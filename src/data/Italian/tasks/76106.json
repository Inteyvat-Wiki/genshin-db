			"dialogs": [
				{
					"id": 761060701,
					"content": "Per niente. Non sono debole come te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060702
					]
				},
				{
					"id": 761060702,
					"content": "#Eh?! La sfacciataggine è un requisito per essere assunti di questi tempi...? A-Aspetta un attimo. Tu non sei una delle nuove reclute! D-Devi essere una spia! Prendetel{F#a}{M#o}, adesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
