			"dialogs": [
				{
					"id": 761060801,
					"content": "Scusami, credo di aver sbagliato strada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060802
					]
				},
				{
					"id": 761060802,
					"content": "Questa è una zona militare! Se hai qualcosa da sbrigare qui, datti una mossa. Altrimenti, smettila di gironzolare.",
