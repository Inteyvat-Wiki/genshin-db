					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "Sì, sì. Hanno il coraggio di inseguire qualsiasi cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000102,
					"content": "I Sette, i draghi, gli dèi... Non esiste manufatto antico che possa sfuggire alle loro avide ambizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000103,
					"content": "Però, stavolta è diverso... Chi si credono di essere per andare a cercare i tesori dell'Ordine dell'Abisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000104,
					"content": "#Oh, viaggiat{M#ore}{F#rice}, sei tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000105,
					"content": "Eh? Ganyu, cosa ci fai qui con Lan? Avete un incarico da affidare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000106,
					"content": "#Ciao, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000107,
					"content": "Stavamo discutendo dei Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000108,
					"content": "Sì, stavamo giusto dicendo che persino gli audaci Cacciatori di tesori dovrebbero astenersi dall'intralciare l'Abisso... Sono troppo malvagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000109,
					"content": "Ma abbiamo da poco ricevuto informazioni dal Ministero degli Affari Civili riguardo a due Cacciatori di tesori di alto livello, a Liyue e Mondstadt, che starebbero pianificando un'importante operazione congiunta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000110,
					"content": "\"Due Cacciatori di tesori di alto livello\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000111,
					"content": "Sì, sono conosciuti come \"Grande sorella del Sud\" e \"Raptor del Nord\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000112,
					"content": "Aaah! Raptor! Paimon ricorda che ha cercato di fuggire da Amber a Mondstadt... Ma chi è la \"Grande sorella del Sud\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000113,
					"content": "Ma è \"Grande sorella\" nel senso che è superiore agli altri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "Esatto. Lei è il capo dei Cacciatori di tesori a Liyue. A quanto ho capito, la chiamano \"Boss\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000117,
					"content": "Alcuni dicono che il Dio dei ladri le abbia persino concesso un dono per le sue gesta, rendendola la \"Grande sorella degli Dèi\"... Ma si tratta probabilmente di una diceria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000118,
					"content": "Comunque, i Cacciatori di tesori hanno scoperto delle rovine precedentemente inesplorate. L'Ordine dell'Abisso le ha sorvegliate per tanto tempo nell'ombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000119,
					"content": "Nonostante l'evidente pericolosità, i Cacciatori di tesori non pensano ad altro che alla varietà di tesori che le rovine potrebbero celare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000120,
					"content": "Hanno già escogitato un piano: invieranno un diversivo per distogliere l'attenzione delle forze dell'Ordine dell'Abisso dalle rovine, e poi manderanno un ladro esperto al loro interno per rubare il tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000121,
					"content": "A tal fine, la Grande sorella e Raptor hanno già reclutato un certo \"Gran Razziatore\" da Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000122,
					"content": "\"Gran Razziatore\"? Che titolo altisonante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000123,
					"content": "Sì, è un individuo straordinario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000124,
					"content": "Il Gran Razziatore gode di grande rispetto tra i Cacciatori di tesori, nello stesso modo in cui noi avventurieri ammiriamo le gesta di grandi avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000125,
					"content": "Come la famosa avventuriera, Alice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "Ah, quindi conosci l'autrice della Guida di viaggio di Teyvat? Proprio così, il Gran Razziatore è celebre tanto quanto lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000129,
					"content": "Quindi, nonostante siano relativamente di alto livello a Liyue e Mondstadt, la Grande sorella e Raptor hanno dovuto faticare molto per convincere un saccheggiatore del suo calibro a supervisionare di persona questa operazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000130,
					"content": "Per via dei grandi cambiamenti avvenuti recentemente a Liyue, il Ministero degli Affari Civili e i Milleliti hanno le mani legate. Non hanno tempo per indagare sulle dicerie riguardo all'attività dei Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000131,
					"content": "Ma tutto ciò che ha a che fare con l'Abisso mi fa pensare che ci sia qualche pericolo sconosciuto in agguato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000132,
					"content": "Così, ho deciso di andare dalla Gilda degli avventurieri per fissare un incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000133,
					"content": "Beh, dato che sono qui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "Sì! Affida l'incarico a noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000136,
					"content": "Oh, grazie davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000137,
					"content": "È bello sapere che la questione è nelle mani di un membro affidabile della Gilda. Beh, allora, buona fortuna. La Gilda si occuperà dei dettagli di questo incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000134,
					"content": "Anch'io comprendo i pericoli dell'Abisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "Come il grande avventuriere, Stanley?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "Ah, hai incontrato la leggenda vivente in persona mentre eri a Mondstadt? Proprio così, il Gran Razziatore è tanto celebre quanto lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 80000114,
					"content": "È lei il \"Boss\" a cui si riferiscono i Cacciatori di tesori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "Allora sapete già qualcosa. Immagino che avrete incontrato tante volte i Cacciatori di tesori sul vostro cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 800002,
			"completionStepIds": [
				800004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800004",
