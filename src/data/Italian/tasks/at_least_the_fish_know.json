						240140204
					]
				},
				{
					"id": 240140204,
					"content": "Salve. Piacere di conoscerti. Mi chiamo Linorea e sono una giornalista specializzata in reportage sull'ambiente. Sto... mettendo degli avannotti in queste acque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140205
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140205,
					"content": "Un attimo... Hai un aspetto familiare. Eri con Semaine quando l'abbiamo visto l'ultima volta, Linorea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140206,
					"content": "Devi essere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140207
					]
				},
				{
					"id": 240140207,
					"content": "#Conoscete Semaine? Siete... Oh, siete quell{F#e}{M#i} che l'hanno aiutato a portare quei regali? Grazie, grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140208
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140208,
					"content": "Semaine me l'ha raccontato solo una volta finito di guardare l'opera, quando ero già tornata a casa. Ad essere sinceri, ho cercato di invitarvi a mangiare a casa mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140209
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140209,
					"content": "Non pensavo di incontrarvi qui... Solo che non è il momento ideale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140210
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140210,
					"content": "Hai detto che vuoi mettere degli avannotti in acqua, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140211,
					"content": "È perché lo stai facendo, esattamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140212
					]
				},
				{
					"id": 240140212,
					"content": "Sai qualcosa dei Mekapesci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140213,
