			"dialogs": [
				{
					"id": 240140601,
					"content": "Hai messo gli avannotti in acqua per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140602
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140602,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140603
					]
				},
				{
					"id": 240140603,
					"content": "Grazie mille. Quando avrò riparato la mia tuta da immersione continuerò il mio lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140604
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140604,
					"content": "Spero che quei pesci crescano sani e salvi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140605
					]
				},
				{
					"id": 240140605,
					"content": "#Tranquill{F#a}{M#o}, ho preparato molte specie di avannotti per ogni tipo d'acqua e ambienti diversi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140606
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140606,
					"content": "Gli esemplari che hai rilasciato prima sono stati scelti specificamente per questa regione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140607
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140607,
					"content": "Rilascerò qualche altro esemplare, e poi gli avventurieri che abbiamo ingaggiato verranno a rimuovere i Mekapesci nell'area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140608
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140608,
					"content": "Credo che questo gruppetto crescerà forte e sano e ripristinerà l'ecosistema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140609
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140609,
					"content": "Quando abbastanza specchi d'acqua si saranno rigenerati, scriverò un lungo rapporto. Racconterò al pubblico quello che l'Istituto di ricerca di Fontaine ha fatto per l'ambiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140610
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140610,
					"content": "Aspetta e vedrai, Damestier. Non mi fermerai stavolta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				}
			]
		},
