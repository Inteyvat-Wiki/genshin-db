			"dialogs": [
				{
					"id": 240140101,
					"content": "Il numero di pesci qui è diminuito di nuovo. Non è che i Mekapesci stanno facendo di nuovo le bizze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140102,
					"content": "Devo mettere gli avannotti nelle acque profonde... Uh, perché la mia tuta da immersione doveva cedere proprio adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140103,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "Salve. Piacere di conoscerti. Mi chiamo Linorea e sono una giornalista specializzata in reportage sull'ambiente. Sto... mettendo degli avannotti in queste acque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140105,
					"content": "Una giornalista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "Esatto, di quelle che conosci tu. Ma non sono come quei giornalisti che pubblicano dicerie sui personaggi pubblici o che rigurgitano vecchie novità tutto il giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140107,
					"content": "Ciò che mi preoccupa è una grave questione in atto che minaccia la sicurezza del pubblico qui alla Corte di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140108,
					"content": "Ecco perché sono qui a mettere degli avannotti nell'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140110,
					"content": "Sai qualcosa dei Mekapesci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140111,
					"content": "Mai sentiti nominare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "Si tratta di una specie endemica della Corte di Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "È perché lo stai facendo, esattamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140110
					]
				}
			]
		},
