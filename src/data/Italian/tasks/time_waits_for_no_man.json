			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206030501,
					"content": "Già di ritorno? Bene, immagino che non sia successo niente di grave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030502,
					"content": "A dire la verità c'è ancora un'intensa attività di mostri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "Cosa? I mostri vanno ancora in giro e sono più numerosi di prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030504,
					"content": "Che strano! La grande mandria di mostri che ha attaccato Mondstadt non era già stata sconfitta? Perché si aggirano ancora in zona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030505,
					"content": "Che abbiano altri piani? Devo radunare gli avventurieri e riassegnare gli incarichi. Non possiamo prendere questi mostri alla leggera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030506,
					"content": "Svolgere delle indagini accurate sulle attività dei mostri rientra nelle competenze della Gilda degli avventurieri. È ora di mostrare a tutti di che pasta siamo fatti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030507,
					"content": "Ah, sì! Eccoti una ricompensa di ringraziamento per i tuoi sforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
	]
