			"dialogs": [
				{
					"id": 741910201,
					"content": "Imperator. Imperator, va tutto bene? Stava sognando di nuovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910202
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910202,
					"content": "Umpf, che chiasso. Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910203
					]
				},
				{
					"id": 741910203,
					"content": "Il popolo si è riunito nella grande sala. Credo che abbiano delle domande da porle, Imperator.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910204
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910204,
					"content": "Di recente, la melodia di Phobos è stata interrotta più volte, e pertanto hanno diverse preoccupazioni a riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910205
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910205,
					"content": "Non ho altra scelta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910206
					]
				},
				{
					"id": 741910206,
					"content": "Mi fido del suo giudizio saggio, naturalmente, e mi sono giunte voci sui recenti avvenimenti... C'è qualcosa che non va con Phobos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910207
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910207,
					"content": "Phobos ha pianificato il percorso per tutti, e il suo scopo è far raggiungere la felicità all'umanità intera. Non ci dovrebbero essere problemi, grazie all'aiuto dei poteri di calcolo quasi illimitati di Sybilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910208
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910208,
					"content": "Ma ho sentito lamenti di dolore nella musica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910209
					]
				},
				{
					"id": 741910209,
					"content": "Qualcuno forse ha alterato in segreto lo spartito di Phobos? No, nessuno è in grado di farlo tranne me e gli altri Armosti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910210
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910210,
					"content": "Forse la profetessa ci ha tenuto nascosto qualcosa? Impossibile. Non aveva già sacrificato la sua vita intera per la causa? La veridicità della sua profezia è stata confermata dalla Signora delle Acque. Non avrebbe mai covato un piano tanto egoista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910211
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910211,
					"content": "O forse è proprio perché \"lei\" non aveva alcun desiderio intrinseco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910212
					]
				},
				{
					"id": 741910212,
					"content": "Oggi tutti fanno affidamento sul giudizio di Phobos. I cittadini temono che, se qualcosa andasse storto, ogni cosa discenderebbe nel caos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910213,
						741910214
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910213,
					"content": "Vai da coloro che si aggrappano alla fede cieca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				},
				{
					"id": 741910215,
					"content": "Vale a dire che vorrebbe separare la mia melodia dalla \"Grandiosa Sinfonia\" nell'eventualità che accadesse qualcosa di brutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910216
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910216,
					"content": "No, no, è ancora troppo presto. Temo che la mia anima non sia in grado di far fronte a un destino così grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910217,
						741910218
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910217,
					"content": "Credo in te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910219,
					"content": "Capisco. Ho preso la mia decisione. Se questo è il suo desiderio, Imperator, porterò a termine il mio incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910220,
						741910221
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910220,
					"content": "Ouranopolis, la città del futuro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910222,
					"content": "Dopo la partenza di ████, attraversi dei corridoi dorati, e il suono di gente che discute si avvicina sempre di più.\\nL'area si ammanta di silenzio, ma solo per un attimo, quando raggiungi il podio centrale della sala principale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910223
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910223,
					"content": "O Grande Sebastos, la prego di darci delle istruzioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910224
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910224,
					"content": "Ultimamente molti di noi non sono riusciti ad ascoltare la melodia di Phobos. La gente ha paura, Imperator, ed è molto confusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910225
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910225,
					"content": "Il nostro grandioso piano stava procedendo normalmente. I barbari nascosti nelle ombre venivano eliminati l'uno dopo l'altro, e l'Icore purificava le acque inquinate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910226
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910226,
					"content": "Eppure, mio Imperator, ha in programma di interrompere la nostra nobile guerra senza un motivo valido. Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910227
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910227,
					"content": "Ho agito secondo il mio giudizio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910228
					]
				},
				{
					"id": 741910228,
					"content": "Grande Sebastos, non intendo mettere in discussione la sua autorità, ma credo che sia stato già fin troppo clemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910229
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910229,
					"content": "Abbiamo diffuso una armonia gloriosa sulla terra. Le porte di Remuria sono aperte per coloro che vogliono unirsi al nostro ordine dorato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910230
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910230,
					"content": "E invece cosa hanno fatto costoro? Hanno distrutto le nostre torri e massacrato i nostri musicisti. Le loro anime deturpate non meritano la salvezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910231
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910231,
					"content": "Ripuliamo con il sangue le loro terre barbare, affinché ordine e civiltà fioriscano dopo la distruzione. È il massimo della pietà che si meritano quei selvaggi ignoranti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910232
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910232,
					"content": "Non è ciò che voglio io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910233
					]
				},
				{
					"id": 741910233,
					"content": "Ma non dovrebbero esserci ombre sotto il sole. Non è anche questo il suo grande ideale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910234
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910234,
					"content": "Se posso permettermi, Imperator, credo che sia il desiderio di tutti i cittadini di Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910235
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910235,
					"content": "Sebastos, dia l'ordine, la prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910221,
					"content": "Chiamati con questo nuovo nome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910218,
					"content": "Ma d'ora in poi non sarai più \"uno di noi\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910214,
					"content": "Per questo motivo, devo consegnarti il libero arbitrio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				}
			]
		}
	]
}