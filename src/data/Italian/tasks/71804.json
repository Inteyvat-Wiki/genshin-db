			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040201,
					"content": "Questa è la bacheca del Pendio di Feiyun. Qui vengono pubblicate le notizie sulla comunità e gli annunci dei negozi. Si prega di non pubblicare annunci su questioni irrilevanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 718040202,
					"content": "Consultiamo le informazioni sui trasferimenti di personale del Ministero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "\"Di seguito sono riportati i trasferimenti di personale del Ministero degli Affari Civili...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 718040204,
					"content": "Aspetta un attimo. Non ha niente a che vedere con le licenze commerciali, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040205,
					"content": "Consultiamo le informazioni sulla contaminazione delle acque del Pendio di Feiyun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "\"Riguardo alla recente contaminazione delle acque del Pendio di Feiyun...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 718040207,
					"content": "Forza, Ivanovich ha molto da fare. Non abbiamo tempo per preoccuparci di questo, adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040208,
					"content": "Consultiamo le novità sulle domande per le nuove licenze commerciali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "\"Per fare domanda per una nuova licenza commerciale bisogna seguire le seguenti procedure...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 718040210,
					"content": "Dev'essere per la nuova licenza commerciale che Ivanovich vuole richiedere. Trascriviamo le procedure necessarie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180403",
							"2"
						],
						"stepId": 7180403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "Allora, hai trovato il comunicato sulla licenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040302,
					"content": "Te l'ho trascritto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "Magnifico! Fammi vedere bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040304,
					"content": "Un permesso d'uscita in mare, i certificati di sicurezza e proprietà dei locali commerciali e la licenza commerciale vecchia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040305,
					"content": "Va bene, va bene. Ho fatto firmare quei documenti qualche giorno fa, ed è stata praticamente una maratona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040306,
					"content": "#Viaggiat{F#rice}{M#ore}, puoi aiutarmi a presentare ognuno di questi documenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040307,
					"content": "Detto questo... *tossisce* sappi che molte persone staranno cercando di presentare i propri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040308,
					"content": "Il <color=#00E1FFFF>permesso d'uscita in mare</color> va consegnato ad An il Nervoso. I <color=#00E1FFFF>certificati di sicurezza e proprietà dei locali commerciali</color>, invece, vanno dati a Jiayi, un soldato dei Milleliti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040309,
					"content": "Infine, la <color=#00E1FFFF>licenza commerciale vecchia</color> va presentata alla segretaria Zhao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040310,
					"content": "#Per favore, aiutami a presentarli, viaggiat{F#rice}{M#ore}. Mi assicurerò di darti una giusta ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040311,
					"content": "Certamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "Spero davvero che le procedure siano finite qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040313,
					"content": "Anche io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "A te difficilmente capiterà di doverlo fare di nuovo... ma io mi ritroverò nella stessa situazione, a un certo punto, se voglio fare affari qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040315,
					"content": "*sospira* È vero che questi metodi trasmettono un certo senso di sicurezza, ma come vorrei che fossero più semplici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
