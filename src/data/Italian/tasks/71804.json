			"dialogs": [
				{
					"id": 718040501,
					"content": "Restate in fila, prego! Restate in fila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040502,
						718040504
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040502,
					"content": "Ivanovich vuole richiedere una nuova licenza commerciale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "#Ah, sei qui in veste di delegat{F#a}{M#o}? Capisco. Potrei avere il certificato di sicurezza e... Com'è che si chiamava? Ah, giusto... Il certificato di proprietà dei locali commerciali. Li hai portati entrambi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040504,
					"content": "Sei tu il responsabile di questi certificati?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040505
					]
				},
				{
					"id": 718040505,
					"content": "No, no, sto solo aiutando, come te. La segretaria Zhao è piena di cose da fare, al momento, quindi mi ha chiesto di aiutarla a raccogliere e registrare i certificati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040506,
					"content": "*sospira* È davvero stancante... Allora, hai con te i certificati di sicurezza e proprietà dei locali commerciali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7180406,
