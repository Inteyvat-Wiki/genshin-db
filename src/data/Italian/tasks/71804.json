			},
			"dialogs": [
				{
					"id": 718040601,
					"content": "Salve. Domande? Qualcosa da dichiarare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040602
					],
					"speakerTitle": "Segretaria Zhao"
				},
				{
					"id": 718040602,
					"content": "Ivanovich vuole richiedere una nuova licenza commerciale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040603
					]
				},
				{
					"id": 718040603,
					"content": "Sei qui in sua vece? Va bene. La sua <color=#00E1FFFF>licenza commerciale vecchia</color>, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040604
					],
					"speakerTitle": "Segretaria Zhao"
				},
				{
					"id": 718040604,
					"content": "Se ce l'hai, consegnamela. Ne ho bisogno per rilasciarne una nuova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Segretaria Zhao"
				}
			]
		},
		{
			"id": 7180407,
