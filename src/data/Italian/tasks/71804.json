			"dialogs": [
				{
					"id": 718040401,
					"content": "Ecco altre scartoffie incomplete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040402
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 718040402,
					"content": "Ivanovich vuole richiedere una nuova licenza commerciale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "Ivanovich? Ah, sì, mi ricordo di lui. È stato qui un paio di volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 718040404,
					"content": "Vuole richiedere una nuova licenza? Ahah... allora deve essere parecchio indaffarato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 718040405,
					"content": "Immagino che tu sia qui per aiutarlo. Hai portato con te il suo <color=#00E1FFFF>permesso d'uscita in mare</color>? Ricordo di avergli già detto che mancavano dei documenti e che doveva procurarseli altrove...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An il Nervoso"
				}
			]
		},
