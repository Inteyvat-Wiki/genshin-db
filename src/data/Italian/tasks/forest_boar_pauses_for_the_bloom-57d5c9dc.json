				]
			},
			"dialogs": [
				{
					"id": 700610101,
					"content": "*sospira* Ancora? Perché continua a succedere? Il campo è un disastro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610102,
					"content": "Di questo passo, non riuscirò a consegnare i fiori in tempo. Cosa dico ai miei clienti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610103,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "Guardati intorno. L'intero campo è distrutto... Questi fiori stavano crescendo magnificamente, e ora sono rovinati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610105,
					"content": "Tutto per colpa di quella peste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610106,
					"content": "È disumano!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "Vero?! Beh... In effetti, è proprio così. È un cinghiale della foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610108,
					"content": "Per qualche motivo, ultimamente continua a scendere da queste parti, sgranocchia i fiori e poi si rotola in mezzo al campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610109,
					"content": "Ed è inafferrabile. Appena qualcuno lo sente e si avvicina, se la dà a zampe. Poco fa ha quasi travolto un anziano passandogli accanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610110,
					"content": "È uno scandalo. Quello là è un vero maiale, parola mia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610111,
					"content": "#Oh, aspetta... un momento. Tu non sei {F#la Cavaliere Onoraria}{M#il Cavaliere Onorario}? L'{F#eroina}{M#eroe} che ha salvato Mondstadt? Allora ti prego, devi assolutamente aiutarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610112,
					"content": "Va bene. Lo scaccerò!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "Che sollievo... Credo che si sia diretto verso la valle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610114,
					"content": "Quella bestia è furba. Potresti doverla attirare con dei fiori... anche se, beh, puoi vedere cosa ne resta dei miei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610115,
					"content": "Prova a raccogliere qualche Fiore Ventoquiete lungo la strada e usalo come esca. Per una volta sarà lui a farsi ingannare, gli sarà di lezione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		},
