					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760490709,
					"content": "Abbiamo attraversato nuvole e nebbia, e siamo stati testimoni della risposta sulla luna... La sua bellezza è come la musica che stanno cantando ora le tue corde.",
					"roleType": "TALK_ROLE_NPC",
