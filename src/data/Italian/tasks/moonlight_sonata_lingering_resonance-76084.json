				]
			},
			"dialogs": [
				{
					"id": 760840101,
					"content": "Ah, siete voi. Le Kuuhenki stanno suonando di nuovo la lira. Potreste eseguire una canzone per loro come l'ultima volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760840102,
					"content": "E anche io ho voglia di sentire qualcosa di diverso, a dire il vero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760840103,
					"content": "(Mmmh, cosa potrei suonare?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7608402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
