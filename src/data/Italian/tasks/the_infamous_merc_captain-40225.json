				]
			},
			"dialogs": [
				{
					"id": 402250101,
					"content": "Un attimo, ma questa è...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250102,
					"content": "L'Alcor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "In realtà, questa è la seconda nave della nostra flotta. L'Alcor si trova a casa, a sorvegliare la Foresta di pietra di Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250104,
					"content": "Beidou! La famigerata capitana mercenaria che solca i mari aperti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250105,
					"content": "Ehm, sì, ahah. Ci conosciamo da un bel po', no? Perché tanti cerimoniali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250106,
					"content": "È una lunga storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250107,
					"content": "Beh, non stiamocene qui in piedi. Sedetevi e raccontatemi tutto. Dirò ai miei uomini di avere il massimo riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250108,
					"content": "Ho capito. Quindi, conoscete l'alto papavero del Consiglio dei segreti, eh... La vostra rete di contatti è veramente notevole, non c'è che dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250109,
					"content": "Hihi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250110,
					"content": "Parlando della registrazione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "Ah, giusto! Ci hanno incaricato di registrare quelli che partecipano alla fiera e cosa intendono commerciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250112,
					"content": "Bene, allora segnate pure me e alcuni membri dell'equipaggio... Gli altri resteranno sulla nave. Riguardo alla merce... Date un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250113,
					"content": "Di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250114,
					"content": "Qualche tempo fa, Ningguang ha creato una versione aggiornata della balista Guizhong. La meraviglia che vedete qui è uno dei suoi nuovissimi modelli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250115,
					"content": "Ha una potenza di fuoco pazzesca, ed è dotata di un sistema di controllo a distanza per colpire con precisione anche da lontano. Sono certa che la gente farà a gara per metterci le mani sopra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250116,
					"content": "Ma sei sicura di poter vendere roba del genere?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250117,
					"content": "Ahah, non preoccuparti. Rispetto al modello usato dai Milleliti, questo è poco più che un'anticaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250118,
					"content": "Nefer non scherzava quando ha detto \"nessuna restrizione\", eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250119,
					"content": "Ma a chi potrebbe interessare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "Oh, qualcuno di sicuro abboccherà. Dopotutto, saranno presenti acquirenti da ogni angolo di Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250121,
					"content": "...Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250122,
					"content": "Ah, già. Ero impegnata col carico e ho dimenticato di dirvi che c'è anche Yelan. Scusate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250123,
					"content": "No, tranquilla. Anche tu qui per la fiera, Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250124,
					"content": "No, sono qui solo per lavoro. La capitana Beidou è stata così gentile da darmi un passaggio, quindi non c'è bisogno di registrarmi tra i partecipanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250125,
					"content": "#Comunque è passato un po' di tempo, {NICKNAME}. Se ne hai l'occasione, porta i miei saluti alla direttrice del Consiglio dei segreti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250126,
					"content": "Che tipo di lavoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "Del tipo... confidenziale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250128,
					"content": "Questo significa che indagare oltre potrebbe essere un problema, eh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250129,
					"content": "Direi proprio di sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "Bene, allora io vado. Una volta finito, vi offro da bere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250131,
					"content": "Alla grande! Non vedo l'ora di ammirare Nod-Krai dal fondo di una bottiglia, ahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250132,
					"content": "Bene, la registrazione è finita. Seguici, ti porteremo al luogo dell'evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
