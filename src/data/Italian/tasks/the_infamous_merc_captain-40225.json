			"dialogs": [
				{
					"id": 402250201,
					"content": "Beidou ordina al suo equipaggio di scaricare la merce e vi segue fino al luogo dell'evento.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "Quindi il posto è questo, eh? Niente male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250203,
					"content": "Quando avete un po' di tempo, aiutatemi a collaudare il comando a distanza di questo aggeggio. È eccitante da morire, scommetto che vi piacerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				}
			]
		}
