			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bonifaz",
					"Nachtigal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552701,
					"content": "Dove sono Omid e Mirsad? Sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552702,
					"content": "Niente paura, stanno bene entrambi. È solo che... hanno altri progetti, quindi non continueranno a lavorare con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552703,
					"content": "Eh? Che facciamo? Non possiamo gestire tutto il lavoro solo noi due. Dobbiamo assumere altre persone! Ma chi mai vorrebbe venire al Villaggio di Aaru...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552704,
					"content": "Lascia perdere, ne parliamo dopo. Comunque, Cyrus è tornato sano e salvo. Almeno questo è qualcosa di cui essere felici, no? Non gli permetterò più di andare in un posto così pericoloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552705,
					"content": "Che cosa dici? Siamo mercanti di bestie da soma. Cosa mangeremo se le nostre bestie da soma non lavorano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552706,
					"content": "Il vento non è cibo, non puoi mangiarlo e riempirtici lo stomaco. E anche se si potesse, ti garantisco che aprendo la bocca ti ritroveresti solo con un bel boccone di sabbia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552707,
					"content": "Ma non possiamo permettere che Cyrus corra dei rischi. Tu mi sembri piuttosto forte, perché non porti tu le nostre merci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552708,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nachtigal"
				}
			]
		}
	]
