			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "Mi dispiace... Non sono ancora in grado di controllare bene le mie emozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552602,
					"content": "Non scusarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "Sì... Sappiamo che stai attraversando un momento difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730552604,
					"content": "Grazie... Che i vostri viaggi possano proseguire senza intoppi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552605,
					"content": "Paimon si augura che tutto vada per il meglio anche a te... Paimon è sicura che sarà così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7305527,
