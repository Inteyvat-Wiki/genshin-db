			"trigger": {
				"objectNames": [
					"Tirzad"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "...Ah, sei tu. C'è qualcos'altro di cui vorresti parlare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552502,
					"content": "Parliamo di Jebrael.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "E pensare che ho avuto dubbi su di lui fino alla fine. Sono una persona davvero orribile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552504,
					"content": "Ora, per lui non provo che gratitudine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552505,
					"content": "Prima di tutto questo mi è stato impossibile impegnarmi in qualcosa, sia in ambito accademico che nella vita... Ma adesso basta. Intraprenderò la strada in cui credo, per quanto difficile possa essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552506,
					"content": "Questo è il minimo che posso fare per rendergli omaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552507,
					"content": "Voglio parlare di Re Deshret.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "In tutta onestà, comincio a dubitare della credibilità degli articoli che ho letto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552509,
					"content": "Quella preghiera... mi dà una strana sensazione che non riesco a descrivere. E anche quello che ha detto Samail... Penso che dovrò approfondire il tutto una volta tornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552510,
					"content": "Naturalmente, la mia missione principale rimane quella di scrivere la tesi, come nei piani originali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552511,
					"content": "Parliamo di Jeht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "*sospira* Anch'io vorrei poter fare qualcosa per lei, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552513,
					"content": "Non posso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552514,
					"content": "Si rifiuta di parlare. Se solo esprimesse i suoi desideri, farei qualsiasi cosa in mio potere per aiutarla...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				}
			]
		},
		{
			"id": 7305526,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
