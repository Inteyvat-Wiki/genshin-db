			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740430201,
					"content": "Cosa voglio? Più diritti per i lavoratori! Quando li voglio? Ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430202,
					"content": "Ehi, ho portato i nuclei che volevi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "Mmm? Fammi vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430204,
					"content": "Perché sei qui a protestare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "Ovvio, perché dobbiamo rialzarci proprio lì dove siamo caduti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430206,
					"content": "Cos'è che dovevo fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "Oh, ma dimmi come devo fare con te? Qualcuno ha installato delle strane macchine di questo tipo sopra il terreno e sott'acqua. Sono anche molto facili da identificare, basta cercare la luce strana che li circonda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430208,
					"content": "Liberati di loro e portami questi nuclei specializzati. Me ne servono <color=#00E1FFFF>7</color> in tutto. Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				}
			]
		},
