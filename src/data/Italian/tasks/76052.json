						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520102,
					"content": "Colombina, stai bene? Hai un aspetto un po' strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520103,
					"content": "Oh, siete voi... Sto bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520104,
					"content": "(Sta di nuovo pensando alla luna...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "Possiamo aiutarti in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520108,
					"content": "Non c'è problema! Diccelo e basta! Anche se è una cosa piccola, ti sentirai molto meglio una volta che avrai tirato fuori tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520109,
					"content": "Vorrei... andare a bere qualcosa in una taverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520110,
					"content": "...Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520111,
					"content": "...*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520112,
					"content": "Scusa... Paimon era solo un po' sorpresa. Non dici mai di volere qualcosa per te, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520113,
					"content": "E poi è tutto qui? Solo... qualcosa da bere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520114,
					"content": "Che c'è, credevi che pensasse in grande?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "Sì, un po'. Almeno qualcosa di più monumentale... Tipo: \"Portatemi la luna\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520116,
					"content": "Ma, a pensarci bene, ha senso. Colombina non può andare dove vuole adesso, quindi una gita alla taverna potrebbe benissimo essere un viaggio sulla luna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520117,
					"content": "Non è solo come stanno ora le cose. Anche quando ero coi Fatui, prima dell'ordine di cattura... Mantenevano tutti la distanza quando uscivo per una passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520118,
					"content": "(La terza dei Messaggeri dei Fatui... Solo questo titolo basta a spaventare le persone che non la conoscono...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "Aspetta un attimo, a pensarci bene... Forse non è così difficile come Paimon pensava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520120,
					"content": "#Una taverna è un po' fuori discussione, ma una bevanda... Beh, possiamo farcela! Ci pensa {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520121,
					"content": "...Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520122,
					"content": "Ah, ma non aspettarti troppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520123,
					"content": "Qualche preferenza a livello di sapore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Sapore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520125,
					"content": "Non ho molta esperienza con le bevande, quindi non saprei proprio da dove cominciare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520126,
					"content": "Forse qualcosa di non troppo... Pesante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520127,
					"content": "Mmmh, cosa intendi con \"pesante\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520128,
					"content": "Pesante come... il cappotto dei Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520129,
					"content": "Questo paragone confonde solo ulteriormente le cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520130,
					"content": "Qualcosa di delicato e leggero, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "Sì, fai come preferisci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520131,
					"content": "Lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
