				"points": [
					{
						"sceneId": 3,
						"position": [
							2155.005,
							109.349,
							11195.66
						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520202,
					"content": "Che ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520203,
					"content": "Mi ricorda di un tempo ormai molto lontano, quando vivevo con gli Eredi della Luna gelata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520204,
					"content": "Le persone preparavano un tipo di tè con le foglie di menta fresche, le spezie e delle bacche essiccate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520205,
					"content": "Quando passavo vicino alle loro case, dalle finestre si sentiva sempre un lieve aroma di erbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520206,
					"content": "Lo hai mai provato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520207,
					"content": "Volevo, ma non ne ho mai avuto modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520208,
					"content": "Oh, e perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520209,
					"content": "Quando una \"dea\" bussa alla porta di casa e chiede: \"Posso provare il tuo tè?\"... Nessuno osa offrirle del \"tè rustico\" creato per il proprio consumo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520210,
					"content": "Ah... Paimon ha capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520211,
					"content": "Quello che ricevevo alla fine era più un'\"offerta\" per il divino, con tanto di confezione decorata e tutto il resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520212,
					"content": "Non che fosse cattivo di per sé... Ma gli mancava un certo senso di... \"casa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520213,
					"content": "Beh, ora puoi berne quanto vuoi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520215,
					"content": "Il sapore è delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520216,
					"content": "...Anche se devo dire che l'idea di aggiungere del latte mi sembra poco convenzionale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520217,
					"content": "Ah, beh, è una ricetta di Mondstadt. La gente del posto adora aggiungere latte, panna e zucchero al proprio tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520218,
					"content": "È una novità... Ma positiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520219,
					"content": "Fiuu, Paimon è felice che ti piaccia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520220,
					"content": "Mmh, grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520221,
					"content": "Sembra che il chiaro di luna non sia l'unico mezzo attraverso il quale si possa osservare il passato. Anche qualcosa di semplice come l'aroma di una bevanda può riportare a galla ricordi dimenticati da tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
