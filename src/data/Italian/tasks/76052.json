					}
				]
			},
			"dialogs": [
				{
					"id": 760520401,
					"content": "Mmmh, questo odore... L'ho già sentito in passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520402,
					"content": "Oh, davvero? Dove?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520403,
					"content": "Nella stanza di Sandrone. Aveva una bevanda con questo profumo. L'aroma mi aveva incuriosita, e quando lo ha notato... Ha continuato a tenerla senza finirla per molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520404,
					"content": "Era come se... stesse aspettando che le chiedessi qualcosa a riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520405,
					"content": "Quindi... Le hai chiesto qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520407,
					"content": "Che cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520408,
					"content": "Non dovresti bere dell'olio motore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520409,
					"content": "E come ha reagito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520411,
					"content": "Dicendo qualcosa di sgradevole. Non vale la pena ripeterlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520413,
					"content": "Ha perso il tuo interesse dopo un solo sorso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520414,
					"content": "Scusa, è un po' amara... E tutto sommato, non è molto buona. Non c'è da stupirsi che Sandrone sembrasse così acida quando l'ha bevuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520415,
					"content": "Paimon pensa che ci fossero altri motivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
