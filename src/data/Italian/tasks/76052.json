			"dialogs": [
				{
					"id": 760520501,
					"content": "Glu... Glu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520502,
					"content": "Wow, l'ha bevuta tutta d'un fiato! Sembra che le piaccia molto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520503,
					"content": "Mmmh... Completamente insapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520504,
					"content": "Insapore?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520505,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520506,
					"content": "Forse l'hai bevuta troppo in fretta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "Oh... Grazie, ma non serve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520509,
					"content": "Un tempo non comprendevo perché la gente si sentisse così felice durante il raccolto. Poi, un giorno, ho toccato un frutto maturo appeso a un ramo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520510,
					"content": "Percepivo la vitalità nella consistenza stessa della sua buccia, l'incarnazione organica della luce del sole, dell'acqua, della terra e dell'aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520511,
					"content": "Con ogni morso, avvertivo una dolcezza rinfrescante invadermi, come onde di fresca schiuma bianca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520512,
					"content": "E così ho capito l'irresistibile potenza degli aromi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520513,
					"content": "Oh, interessante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520514,
					"content": "Poi, completiamo il ciclo della natura prendendo per noi quella forza vitale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520515,
					"content": "Uh, che piega cupa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520516,
					"content": "Ecco perché preferisco la frutta fresca. Mi permette di vedere ciò che ho preso da questo mondo, esattamente come era prima che lo prendessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520517,
					"content": "E mi ricorda cosa devo a questo mondo in cambio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760520507,
					"content": "Te ne faccio un'altra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
