				},
				{
					"id": 210049007,
					"content": "Se la mia ipotesi è corretta, quelle quattro parole dovrebbero corrispondere ad altrettante rovine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049008,
					"content": "Magari, trovando tutte le quattro rovine, si potrà capire il significato di questo modo di dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049009,
					"content": "Ma trovarle tutte da sola non è alla mia portata. Anche trovare soltanto quella lì mi ha tolto tutte le energie, e ci ho messo giorni a riprendermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049010,
					"content": "Potresti darci un'occhiata tu, se t'interessa. Chissà, potresti riuscire a trovare il prossimo indizio prima di me!",
					"roleType": "TALK_ROLE_NPC",
