						210040902
					]
				},
				{
					"id": 210040902,
					"content": "Andate via? D'accordo. Se scovate qualcosa di interessante, non dimenticatevi di venirmelo a riferire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100420,
			"completionStepIds": [
				2100420
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100420",
							"2"
						],
						"stepId": 2100420,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "A volte, il destino è inevitabile persino per un dio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042002,
					"content": "Ho trovato quattro indizi in altrettante rovine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "Quattro rovine, quattro indizi... E Quattro comandamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042004,
					"content": "Ogni indizio spiega nel dettaglio il significato di uno dei Quattro comandamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042005,
					"content": "Ma per interpretarli nel modo corretto, è necessario ottenere il testo originale dei Quattro comandamenti di Guizhong. Per quanto questi indizi siano utili, sono marginali rispetto alla nostra ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042006,
					"content": "Questi cinque versi sono tutti legati tra loro... Ma come?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042007,
					"content": "\"La convergenza\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "Mmmh... Forse questa \"convergenza\" implica che... queste quattro cose sono in qualche modo legate tra loro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042009,
					"content": "Aspetta, ricordo che in ognuna delle rovine si può trovare uno dei Quattro comandamenti di Guizhong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042010,
					"content": "Mmmh... È solo un'ipotesi, ma forse le quattro <color=#00E1FFFF>rovine</color> servono a decifrare il vero significato dei Quattro comandamenti di Guizhong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042011,
					"content": "Però non so come, di preciso. Devo ragionarci sopra. Forse puoi pensarci su anche tu, anzi: va' a indagare di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042012,
					"content": "Dopotutto, io non sono altro che una studiosa mingherlina. Bastano pochi secondi di corsa a sfinirmi... Vorrei avere la tua resistenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042013,
					"content": "Comunque, continuerò a pensarci su per un po'. Se ti viene in mente qualcosa o se trovi qualcosa, sai dove trovarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100422,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100422",
							"2"
						],
						"stepId": 2100422,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042201,
					"content": "È solo un'ipotesi, ma credo che le quattro rovine che corrispondono ai Quattro comandamenti di Guizhong servano a decifrarne il significato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042202
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042202,
					"content": "Ma capire che ruolo abbiano esattamente è tutt'altra storia. Poi non credo di avere la forza fisica di testare per bene tutte le mie ipotesi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042203,
					"content": "È anche possibile che la mia mente si sia fissata su quest'idea, e che non mi porterà da nessuna parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
