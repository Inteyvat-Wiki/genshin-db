			"dialogs": [
				{
					"id": 210040201,
					"content": "La cosa m'intriga parecchio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040202
					]
				},
				{
					"id": 210040202,
					"content": "Segno sulla tua mappa le prime rovine che ho trovato. Ti consiglio di cominciare da lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040203,
					"content": "Se trovi qualcosa, non fare l'errore da principiante di scappare subito via per l'entusiasmo. Assicurati di <color=#00E1FFFF>annotare l'indizio</color> prima di andartene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
