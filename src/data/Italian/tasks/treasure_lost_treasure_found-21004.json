				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "Come procede la ricerca? Hai già trovato il tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045003,
					"content": "Sì, alla fine era nel punto dove \"convergono\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "Ah, sì? Quindi era alla \"convergenza di questi princìpi\", citando i Quattro comandamenti di Guizhong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045005,
					"content": "Chiunque abbia ideato questo indovinello doveva adorare davvero Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045006,
					"content": "Tant'è che persino dopo che l'Adunanza di Guili venne spazzata via, questa persona ha preservato i Quattro comandamenti di Guizhong per le generazioni future.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045007,
					"content": "E proprio come Guizhong che ha stabilito i comandamenti, anche lei dev'essere stata amata dal suo popolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045008,
					"content": "È evidente che voleva che il suo popolo fosse saggio, che si attenesse a un codice morale, che fosse forte e sano, e che trovasse solidarietà nell'Adunanza di Guili, difendendo tutti insieme la loro patria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045009,
					"content": "Ma non ci è riuscita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "Non ci è riuscita, dici? Forse hai ragione, perché alla fine è morta... e quando l'Adunanza di Guili venne spazzata via, il suo popolo perse la propria casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045011,
					"content": "Eppure oggi i Quattro comandamenti di Guizhong hanno di nuovo visto la luce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045012,
					"content": "Queste parole scritte da Guizhong in persona sono sia delle massime che delle benedizioni dedicate al suo popolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045013,
					"content": "Un tempo, lei condusse il proprio popolo a conquistare questa terra, guidandolo coi comandamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045014,
					"content": "Non è più tra noi, ma le cose in cui credeva e per cui ha combattuto perdureranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045015,
					"content": "La persona che la venerava era di sicuro molto sveglia. Ha sfruttato il fascino di un tesoro nascosto per assicurarsi che i Quattro comandamenti di Guizhong venissero tramandati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045028,
					"content": "Chissà se il tesoro caro a quella persona fossero i minerali rari e le pietre preziose, o se fossero i Quattro comandamenti di Guizhong stessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045029,
					"content": "Ahah, per me è evidente che il vero tesoro siano i comandamenti stessi. Non c'è paragone con un baule pieno di oro e gemme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045030,
					"content": "...Ma se lasciassi scegliere alla gente, quanti preferirebbero un elenco di comandamenti alla ricchezza materiale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045016,
					"content": "Sembra una divinità dall' indole gentile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "Non so se questa \"indole gentile\" sia un tratto comune tra gli dèi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045018,
					"content": "Ma forse un tempo lo era. Forse tanto, tantissimo tempo fa, tra gli dèi che guidavano i popoli, ce n'erano anche alcuni dall'animo gentile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045019,
					"content": "Dèi che proteggevano il proprio popolo, che camminavano al suo fianco, che lo accompagnarono nell'avanzata nel mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045020,
					"content": "...Ma alla fine furono proprio gli dèi gentili a non avere la forza di proteggere il proprio popolo. Guarda Guizhong: ci è voluta una complicata caccia al tesoro solo per preservare i Quattro comandamenti che un tempo erano la linfa vitale di un'intera civiltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045021,
					"content": "Quando vorrei poterla incontrare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "Vuoi incontrare una divinità? Certo che hai idee bizzarre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045023,
					"content": "Però sono curiosa: se dovessi incontrarla, cosa diresti a Guizhong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045024,
					"content": "\"...Su con la vita, Guizhong! Hai fatto del tuo meglio\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045025,
					"content": "Nel mio caso... Le reciterei a memoria e alla perfezione i suoi Quattro comandamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045026,
					"content": "E le direi che la sua visione e i suoi ideali sono vivi e vegeti, e che gli abitanti di questa terra ricordano ancora ciò che lei insegnò ai loro antenati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045027,
					"content": "Credo sia l'unica cosa che tirerebbe su di morale qualcuno che ha perso tutto come Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
