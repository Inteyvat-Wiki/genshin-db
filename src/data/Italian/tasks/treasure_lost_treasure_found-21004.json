			"dialogs": [
				{
					"id": 210049201,
					"content": "Ricordami i Quattro comandamenti di Guizhong.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049202
					]
				},
				{
					"id": 210049202,
					"content": "Non riesci a memorizzarli? Lo capisco, in pochi ci riuscirebbero. Fortunatamente, ho un'ottima memoria per questo genere di cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049203,
					"content": "I Quattro comandamenti di Guizhong sono i seguenti: \"Insegnate con saggezza, attenetevi alla virtù, fortificate le ossa e unitevi nell'ambizione. La convergenza di questi princìpi sarà conosciuta come 'Adunanza di Guili'\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
