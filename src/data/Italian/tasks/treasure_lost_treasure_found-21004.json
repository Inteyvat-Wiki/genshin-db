			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "I Quattro comandamenti di Guizhong... Chissà cosa ci vorranno dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040102,
					"content": "#Sono pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "Ahah, quanto entusiasmo! Mi piace. Bene, iniziamo la lettura dei Quattro comandamenti di Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040106,
					"content": "\"Insegnate con saggezza, attenetevi alla virtù, fortificate le ossa e unitevi nell'ambizione. La convergenza di questi princìpi sarà conosciuta come 'Adunanza di Guili'\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040107,
					"content": "Apparentemente sembra una serie di comandamenti, una sorta di regole auree per la nostra vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040108,
					"content": "Si suppone che contengano anche degli indizi per un tesoro nascosto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040109,
					"content": "...Ma non sono ancora in grado di decifrarli. Sembra che dovremo usare quelle che gli studiosi definiscono \"le vecchie maniere\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040110,
					"content": "I sette passaggi che abbiamo trovato prima si trovavano in rovine di qualche tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040111,
					"content": "Magari è meglio continuare a perlustrare le rovine, visto che questa volta non sappiamo da dove cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040112,
					"content": "...Dove, di preciso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "Mmm... Per ora perlustriamo solo le Pianure di Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040114,
					"content": "Detto ciò... Essendo solo una studiosa, non riuscirò mai a tenere il passo con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040115,
					"content": "Quindi lascio a te il compito di perlustrare le rovine. Fammi sapere cosa trovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040129,
					"content": "A proposito... Una volta, da queste parti mi sono imbattuta in una strana stele con incise sopra delle scritte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040130,
					"content": "Però l'ho letta singolarmente, senza prendere in considerazione il quadro generale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040131,
					"content": "Ora che ci penso, potrebbe avere a che fare con i Quattro comandamenti di Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040132,
					"content": "Che ne dici se te ne segno l'ubicazione sulla mappa? Dovresti andare a darci un'occhiata, magari è un indizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040116,
					"content": "...TUTTE le rovine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "#Ovviamente no... Noi due da sol{F#e}{M#i} non riusciremmo mai a perlustrare tutte quelle presenti a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040118,
					"content": "Quindi restringeremo l'area di ricerca. Visto che il tesoro ha a che fare con l'Adunanza di Guili delle Pianure di Guili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040119,
					"content": "...Per ora perlustreremo solo le Pianure di Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040120,
					"content": "Oh, devo dirti un'altra cosa: io sono una semplice studiosa, non riuscirò mai a tenere il passo con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040121,
					"content": "Quindi lascio a te il compito di perlustrare le rovine. Fammi sapere cosa trovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040122,
					"content": "Rovine di Liyue, sto arrivando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "Aspetta un attimo! Come pensi di riuscire a perlustrare tutte le rovine di Liyue?! Ci metterai una vita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040124,
					"content": "Non puoi impazzire dall'entusiasmo ogni volta che senti parlare di un tesoro, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040125,
					"content": "Visto che sappiamo che il tesoro deriva dall'Adunanza di Guili delle Pianure di Guili, che ne dici di restringere l'area di ricerca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040126,
					"content": "Va bene... Prima di tutto, per ora perlustreremo solo le Pianure di Guili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040127,
					"content": "Aspetta, non ho finito! Non dimenticarti di perlustrarle a fondo, e fammi sapere se trovi qualcosa di interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040128,
					"content": "Ricorda: limitati alle Pianure di Guili! Non permettere al tuo enorme entusiasmo di portarti altrove.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040104,
					"content": "Andiamo a cercare quel tesoro!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "Wow, basta anche solo nominare un tesoro e impazzisci dall'entusiasmo... Mm, va bene, allora iniziamo la lettura dei Quattro comandamenti di Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				}
			]
		},
