					"id": 210049401,
					"content": "Qualcuno voleva il tesoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049402
					]
				},
				{
					"id": 210049402,
					"content": "È improbabile. Le due grandi divinità non avrebbero mai scatenato una guerra di tale portata solo per un tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049403
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049403,
					"content": "E anche se l'avessero fatto, c'è da chiedersi... che genere di tesoro porterebbe le divinità a farsi la guerra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049404
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049404,
					"content": "...Ahah. Per quanto mi riguarda, non riesco neanche a immaginare un tesoro così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
