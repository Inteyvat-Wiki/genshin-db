			},
			"dialogs": [
				{
					"id": 210049301,
					"content": "Una battaglia tra gli dèi per il possesso del territorio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210049302
					]
				},
				{
					"id": 210049302,
					"content": "Una sfida per il territorio, dici? Mmmh... Tuttavia, si dice che l'Adunanza di Guili sia vissuta a lungo sotto il comando di Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049303,
					"content": "Non che Guizhong fosse una divinità particolarmente potente... O almeno, questa è la mia impressione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049304,
					"content": "Però sembra che nell'Adunanza di Guili ci fosse anche un'altra divinità, oltre a Guizhong. Dubito profondamente che qualcuno sia stato tanto sciocco da cercare di farne fuori due in contemporanea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
