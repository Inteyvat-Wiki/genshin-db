			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756600101,
					"content": "Ahhh... Che bella giornata. Ne è davvero valsa la pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600102,
					"content": "#Mmh? Ho le traveggole? È Tum{RUBY#[D]Speranza}aini {F#quella}{M#quello} che vedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600103,
					"content": "Che coincidenza, Xilonen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "Racconti a Xilonen di Irade e delle prove d'esame...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "Ah, giusto... A volte mi dimentico che l'ho aiutata, in passato. La prova d'esame della nostra tribù si svolge proprio qui vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600107,
					"content": "All'inizio, solo Nkunga, la \"Calamità di Tetlahuitl\", e Amuru, la \"Lama della sabbia di Seit'aad\", avevano acconsentito ad aiutarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600108,
					"content": "Ma non amavano l'idea di doversi \"muovere\", preferendo gli scontri frontali. Quindi il riscontro finale non è stato neutrale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600109,
					"content": "Quando Pacal ha saputo della cosa, è venuto subito a chiedermi dei suggerimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600110,
					"content": "Quindi questa prova è opera tua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "Più o meno. Io, Pacal e Irade ne abbiamo discusso un po', e abbiamo deciso di apportare delle piccole modifiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600112,
					"content": "Ora, le prove si focalizzano più sul raggiungere rapidamente il terreno più vantaggioso e gestire un fulcro in movimento nel vivo della battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600116,
					"content": "Allora permettimi di accettare la tua prova!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "Suvvia, tutti a Natlan sanno quanto sei forte. Dubito che esista una sfida che possa metterti in difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600119,
					"content": "Comunque, la prova d'esame si tiene laggiù. Provala pure, se ti va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600117,
					"content": "Speriamo che tu non l'abbia resa troppo difficile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "...Certo che sai fare un po' di tutto, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "Mah, sono dispositivi semplici, per niente difficili da costruire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600115,
					"content": "Un piccolo sforzo in più da parte mia aiuterà a produrre dei guerrieri più forti per la tribù e, inoltre, potrò sfruttare il tempo che mi avanza per occuparmi di altri incarichi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600104,
					"content": "Ho accettato l'incarico di Irade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}