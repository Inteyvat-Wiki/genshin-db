			"dialogs": [
				{
					"id": 3550701,
					"content": "Ci è mancato poco che Paimon volasse per aria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550702,
					"content": "Per fortuna Paimon è riuscita ad aggrapparsi ai tuoi capelli! Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550703,
						3550704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550703,
					"content": "Per fortuna non me li hai strappati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				},
				{
					"id": 3550705,
					"content": "#Ma cos'è successo? Paimon temeva che saremmo stat{F#e}{M#i} divorat{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550706,
					"content": "Ha di sicuro a che fare con quello stramboide che parlava col drago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550707,
						3550709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550707,
					"content": "Non riesco a credere che i draghi esistano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550708
					]
				},
				{
					"id": 3550708,
					"content": "Sì, Paimon sa bene cosa ti preoccupa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550711,
					"content": "Eh? Cos'è quello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550712,
					"content": "Lì su quella roccia enorme c'è qualcosa di rosso che brilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550713,
					"content": "Andiamo a dare un'occhiata più da vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550709,
					"content": "Parlare con i draghi è una cosa normale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550710
					]
				},
				{
					"id": 3550710,
					"content": "Certo che no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550704,
					"content": "#Per fortuna il drago non ci ha notat{F#e}{M#i}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				}
