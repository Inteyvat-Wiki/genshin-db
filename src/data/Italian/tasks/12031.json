				},
				{
					"id": 120310801,
					"content": "Quei mostri sembrano davvero arrabbiati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310802,
						120310803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310802,
					"content": "Non possiamo permettere che salgano sulla montagna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310804
					]
				},
				{
					"id": 120310803,
					"content": "Sbarazziamoci di loro, per Miko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310804
					]
				},
				{
					"id": 120310804,
					"content": "Sì, sì, facciamo prestissimo! Così potremo tornare in tempo per vedere gli youkai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310805,
					"content": "#Oh, eccoli che arrivano, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
