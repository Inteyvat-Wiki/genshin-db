					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120311901,
					"content": "#Ugh, l'attesa è snervante! Com'è che non è ancora uscito il prossimo capitolo de \"Le strabilianti avventure del{F#la viaggiatrice}{M# viaggiatore}\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311902
					],
					"speakerTitle": "Kyouta"
				},
				{
					"id": 120311902,
					"content": "Alla fine è arrivata la \"notte senza luna\". È stata una bella sorpresa, devo dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311903
					],
					"speakerTitle": "Oosuke"
				},
				{
					"id": 120311903,
					"content": "Sì, c'era un'enorme nuvola nera sul Monte Yougou, quella notte... Sembrava essersi formata dal nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311904
					],
					"speakerTitle": "Tetsuo"
				},
				{
					"id": 120311904,
					"content": "Però, quando ho espresso il desiderio usando il metodo descritto in quel libro, non è successo nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311905
					],
					"speakerTitle": "Oosuke"
				},
				{
					"id": 120311905,
					"content": "*sospira* Allora immagino che le light novel siano del tutto inventate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311906
					],
					"speakerTitle": "Tetsuo"
				},
				{
					"id": 120311906,
					"content": "#Quella notte è stata sicuramente il colpo di grazia per la moda dei \"romanzi con gli incantesimi\". Eppure, qualcosa mi dice che \"Le strabilianti avventure del{F#la viaggiatrice}{M# viaggiatore}\" rimarrà una serie interessante per un sacco di tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311907
					],
					"speakerTitle": "Oosuke"
				},
				{
					"id": 120311907,
					"content": "Eh? Paimon non vede Miko da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120311908,
					"content": "A quanto pare, non è qui fuori. Uhm... Forse è già entrata. Andiamo a controllare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
