				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "Oh, ciao aiutanti, che gentili a unirvi a me... e siete anche in perfetto orario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310102,
					"content": "Umpf, come se avessimo una scelta... Vogliamo solo i nostri compensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310103,
					"content": "Allora, Miko, cosa dobbiamo fare esattamente per questa Hyakkiyakou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310104,
					"content": "Ah, e per essere chiari, in realtà non abbiamo neanche idea di cosa voglia dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310105,
					"content": "Avrà anche un suono minaccioso, ma, per dirla semplicemente, la Hyakkiyakou è solo un raduno di youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310106,
					"content": "Un tempo, ai raduni degli youkai, una volta che tutti avevano bevuto abbastanza, cominciavano a librarsi in cielo uno alla volta con i loro poteri. Erano così tanti che le loro sagome coprivano la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310107,
					"content": "Ma ora, le memorie degli youkai che fuoriescono dalle linee geomantiche sono deboli... e non sono più in grado di volare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310108,
					"content": "Quindi, farò un rituale di evocazione per raccogliere tutte le memorie erranti in un unico luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310109,
					"content": "Quando sarà il momento, si riuniranno nel cielo sopra il Gran Santuario di Narukami e, una volta esaurita la loro energia, saranno soddisfatti e torneranno al loro posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310110,
					"content": "Mmmh... Capisco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "Ho già fatto tutti i preparativi per il rituale con largo anticipo. Ricordate l'incantesimo e la menzione della \"notte senza luna\" che ho aggiunto al nostro romanzo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310112,
					"content": "Oh, sì, qualcosa sul recitare \"Gli incanti segreti di Lady Kitsune\" in una notte senza luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310113,
					"content": "Proprio quello. In realtà, non è affatto un incantesimo per esprimere un desiderio, ma per calmare le memorie delle linee geomantiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310114,
					"content": "Quando arriverà quel momento, dovremo unirci e aiutare a riportarle sulla loro strada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310115,
					"content": "Come possiamo aiutare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "Tra poco inizierò i preparativi per il rituale, e in quel momento dovrete fare due cose:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310117,
					"content": "Per cominciare, dite alle sacerdotesse di lasciare la montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310118,
					"content": "Durante la Hyakkiyakou, un intero sciame di memorie degli youkai aleggerà sopra il Gran Santuario di Narukami. Far uscire le sacerdotesse eviterà che qualcuno venga posseduto dagli spiriti, il che sarebbe un bel fastidio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310119,
					"content": "Dopodiché, inizierò il rituale, e le memorie cominceranno a riunirsi. Richiederà un po' di tempo, quindi avrò bisogno di voi ai piedi del Monte Yougou per tenere d'occhio l'attività dei mostri nelle vicinanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310120,
					"content": "Di solito, le memorie sono disperse e non costituiscono una minaccia, ma, quando la loro energia si concentra, è probabile che disturbi i mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310121,
					"content": "Potrebbero vederla come un'opportunità per cercare di risalire la montagna. Ho bisogno che li respingiate in modo che ciò non accada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310122,
					"content": "Va bene, capito. E poi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310123,
					"content": "Mmmh... Beh, se a quel punto vi andasse di venire al santuario per vedere da vicino gli youkai, non ve lo proibirei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310124,
					"content": "#Va bene, {NICKNAME}, andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1203102,
			"completionStepIds": [
				1203102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
