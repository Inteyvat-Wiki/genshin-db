	"talks": [
		{
			"id": 1203101,
			"completionStepIds": [
				1203101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
