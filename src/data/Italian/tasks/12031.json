							"2"
						],
						"stepId": 1203102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "Scendere dalla montagna? Sono questi gli ordini di Lady Guuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310202,
					"content": "Sì, Miko ha detto che il rituale che sta per svolgere potrebbe essere pericoloso per tutte voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310203,
					"content": "Capisco... evacuerò subito tutti. E voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310204,
					"content": "Ci occuperemo di un paio di altre cose per lei. Poi, quando avremo finito, torneremo a partecipare al rituale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310205,
					"content": "Perché vogliamo assicurarci che anche lei sia al sicuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "Sembra che Lady Guuji abbia molta fiducia in voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310208,
					"content": "Lady Guuji non ha mai permesso a nessun altro di partecipare a rituali come questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310209,
					"content": "Sapere che l'aiuterete con il rituale mi rassicura. Buona fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310210,
					"content": "Non preoccuparti, siamo molto più forti di quanto sembri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310206,
					"content": "Perché vogliamo vedere gli youkai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203106",
							"2"
						],
						"stepId": 1203106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon",
					"Okazaki Rikuto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "#Ah, {M#piccoli amici}{F#piccole amiche}, eccovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310402,
					"content": "Miko, ma... Hai iniziato a mangiare senza di noi?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310403,
					"content": "Sì, proprio così. Pagate voi, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310404,
					"content": "Il pensiero di poter mangiare i piatti più costosi e bere il sakè più pregiato, tutto assolutamente gratis... Oh, non potevo più aspettare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310405,
					"content": "#Ah, capo, vedi le facce di {M#questi}{F#queste} due? Ricordale bene, perché sono loro che pagheranno il conto dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310406,
					"content": "Va bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "Okazaki Rikuto"
				},
				{
					"id": 120310407,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310408,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "Cosa vi prende? Forza, sedetevi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310410,
					"content": "Dovete provare questo pesce, che si trova esclusivamente nelle acque intorno all'Isola di Seirai. L'hanno spedito a Inazuma durante la notte ed era ancora vivo fino a quando l'ho ordinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310411,
					"content": "O forse preferite provare questo? Lo so, lo so, di solito nemmeno io riesco a bere sakè così costoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310412,
					"content": "Se non bevete alcolici, va bene lo stesso. Ci sono succhi di frutta di tutti i tipi e per tutte le tasche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310413,
					"content": "Grrr... Miko! Sei una vergogna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310414,
					"content": "#L'ultima volta che siamo stat{F#e}{M#i} qui a lavorare sul romanzo, tutto quello che hai ordinato per noi è stato un semplicissimo kushikatsu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310415,
					"content": "Oh? Strano, non ricordo nulla del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310416,
					"content": "Beh, io lo ricordo eccome.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "Ah. E con ciò? Siete voi che mi avete offerto il pasto, no? Comunque, come sapete sono una specie di celebrità. Non trovereste imbarazzante trattarmi in modo poco sontuoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310419,
					"content": "Miko, questo pasto sarà super costoso, non hai paura che non potremo permettercelo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310420,
					"content": "Eheh! Oh, non preoccupatevi. Certo che potrete permettervelo... Le ristampe della vostra light novel procedono senza sosta, sapete? Vi aspetta un compenso piuttosto generoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310421,
					"content": "C-Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310422,
					"content": "#Aaah, accidenti!!! Ci ha buggerat{F#e}{M#i}, {NICKNAME}! Miko puntava ai nostri Mora fin dall'inizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310423,
					"content": "Non avremmo dovuto abbassare la guardia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "Ahahah! Oh, le vostre facce in questo momento sono impagabili! Ahahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310426,
					"content": "Oh, a proposito... Dato che in quella notte senza luna nessuno ha avuto esaudito il proprio desiderio, i romanzi con gli incantesimi non sono più molto in voga ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310427,
					"content": "#Perciò dovrete inventarvi qualcosa di nuovo per il prossimo capitolo de \"Le strabilianti avventure del{F#la viaggiatrice}{M# viaggiatore}\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310428,
					"content": "La scadenza incombe... Conto su di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310424,
					"content": "#Ci siamo cascat{F#e}{M#i}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "Kushikatsu e tofu fritto. Tutto qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
		},
