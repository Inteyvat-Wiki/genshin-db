					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310902
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310902,
					"content": "Miko, stai bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310903
					]
				},
				{
					"id": 120310903,
					"content": "Uhm? Io sto benissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310904
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310904,
					"content": "Dalla tua espressione, però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310905,
					"content": "Sto bene, davvero. Dico sul serio! Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310906
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310906,
					"content": "Ah... Voi due, siete proprio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310907
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310907,
					"content": "Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310908,
					"content": "Bene, se ci tenete tanto a fare qualcosa per me, potete offrirmi un pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310909
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310909,
					"content": "Un pasto? Certo, nessun problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310910,
					"content": "Un pasto? Affare fatto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310911
					]
				},
				{
					"id": 120310911,
					"content": "Va bene. Ci vediamo presto, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
