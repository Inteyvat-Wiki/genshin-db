			},
			"dialogs": [
				{
					"id": 120311001,
					"content": "Grazie per il cibo, me lo sono proprio goduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311002
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120311002,
					"content": "Oh, lo sapete? Ei ha visto il nostro rituale di evocazione al Gran Santuario di Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311003
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120311003,
					"content": "So quanto può essere testarda, ma mi ha comunque colta di sorpresa: ha scritto una lettera lunga e severa al riguardo, rimproverandomi di \"aver preso tutta questa faccenda fin troppo sul serio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120311004
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120311004,
					"content": "Ugh, non capisco perché faccia tante storie. Tutti mi sembravano felici come non mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				}
			]
