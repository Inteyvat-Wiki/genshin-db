					],
					"speakerTitle": "Aradashan"
				},
				{
					"id": 731010102,
					"content": "Dobbiamo rimuovere l'Ararakalari che abbiamo applicato sul Pezzo di ferro massiccio, strato per strato, e infine affrontarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010103
					],
					"speakerTitle": "Aradashan"
				},
				{
					"id": 731010103,
					"content": "Questa volta Aradashan non ti aiuterà a sopprimere il potere del Pezzo di ferro massiccio. Niente paura però: Arasata, Arayuta e Arasaha ti aiuteranno comunque. Vuoi provare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aradashan"
				}
			]
		},
