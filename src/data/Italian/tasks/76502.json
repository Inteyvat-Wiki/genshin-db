			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#Ehi! Sei tu, {NICKNAME}! E c'è anche Paimon! Beh? Che c'è? Vi serve il mio genio per un incarico super mega gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020102,
					"content": "Vi farò uno sconto amici del venti per cento per i miei servizi! Basta solo che mi portiate qualche spuntino... Ah, ma non ditelo a Ineffa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020103,
					"content": "Stiamo solo dando un'occhiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "Eheh, allora siete nel posto giusto! Il mio laboratorio è stratomitico al mille e uno per cento! Non troverete di meglio da nessun'altra parte, sono pronta a scommetterci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020106,
					"content": "Fate solo attenzione a dove mettete i piedi, potreste finire faccia a terra inciampando su qualche componente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020107,
					"content": "Questo robot sembra piuttosto... unico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "Eheh! Che ve ne pare? Si chiama Cazzotto Paperotto. L'ho progettato per separare i rifiuti e gli scarti di metallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020110,
					"content": "Beh, però mi è uscito un po' troppo resistente, e le sue giunture sono flessibilissime. Così ho pensato: \"Mah, a questo punto, perché non dargli anche delle capacità difensive megafotoniche?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020111,
					"content": "In questo modo, se qualche criminale infame tenterà di intrufolarsi nel mio laboratorio, verrà ridotto in un mucchio di rifiuti non riciclabili, volente o nolente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020112,
					"content": "Le tue idee sono assurde come al solito, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765020113,
					"content": "Beh, visto che si è presentata l'occasione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "A me? C-Con Cazzotto Paperotto? B-Beh, di solito sono le mie invenzioni a ricevere apprezzamenti. Non mi capita spesso che qualcuno voglia fotografare me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020116,
					"content": "Ma se volete immortalare questa prodigiosa inventrice e la sua migliore, invincibile macchina da combattimento in azione, allora... Sì, potete farlo eccome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020117,
					"content": "Più che altro, non sono abituata a fare foto, quindi non so in che posa mettermi... Non ho idea se ne uscirebbe qualcosa di decente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020118,
					"content": "Basta che tu sia te stessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "Peeerfetto! Allora mi affido a te! E cerca di far trasparire anche tutta la tostaggine di Cazzotto Paperotto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020119,
					"content": "Premerò l'otturatore nel tuo istante migliore!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "Ti spiace se ti scattiamo una foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "È opera tua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "E cercando soggetti da fotografare, già che ci siamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
