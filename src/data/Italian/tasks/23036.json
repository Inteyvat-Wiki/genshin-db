					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230360101,
					"content": "Prova ancora con la nuova esca, Kayvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360102,
					"content": "L'ho provato così tante volte, ma i risultati sono sempre gli stessi di prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360103,
					"content": "Eh? Perché voi due state di nuovo pescando insieme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230360104,
					"content": "#Viaggiat{F#rice}{M#ore}, chi si rivede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360105,
					"content": "Salve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360106,
					"content": "Hai scoperto perché i pesci si rifiutano di abboccare all'esca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "Ahah! Assolutamente nulla. Io e quel ricercatore abbiamo provato diversi metodi per modificare la canna da pesca, regolare l'esca e migliorare le nostre tecniche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360109,
					"content": "Abbiamo provato diversi specchi d'acqua e angolazioni... Ho perfino provato a pescare in uno stagno pieno di pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360110,
					"content": "Ma, nonostante i miei sforzi, ho pescato di tutto tranne che dei pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360111,
					"content": "Non preoccuparti, Kayvan. Quel ricercatore ha promesso che continuerà a cercare un modo. Riuscirà sicuramente a scoprire la ragione di tutto questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360112,
					"content": "Guarda, ha perfino progettato una nuova esca per te, e vuole che io rimanga qui a documentare ogni dettaglio della tua tecnica di pesca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360113,
					"content": "Spero che ci riesca davvero... Ma, fino ad allora, continuerò a pescare a modo mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360114,
					"content": "#Viaggiat{F#rice}{M#ore}, saresti così gentile da portarmi altri materiali per le esche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360107,
					"content": "Hai scoperto qualcosa dai ricercatori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
