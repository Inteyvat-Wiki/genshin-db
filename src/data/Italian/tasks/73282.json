					"Masseira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "Ah, eccoti. Concedimi solo un istante. Credo sarà l'ultima volta che ti chiedo un favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820102,
					"content": "Allora dimmi, come posso aiutarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "È Tadhla. Vuole parlarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820106,
					"content": "Eh? Che ti prende così all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820107,
					"content": "#Le rovine a nord, dove vi siete incontrat{F#e}{M#i} la prima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820108,
					"content": "Cos'hai detto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "#Le rovine a nord, dove vi siete incontrat{F#e}{M#i} la prima volta. Tienilo a mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820110,
					"content": "Ho capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "Sì. Per favore, trattala bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820104,
					"content": "Ho delle cose da fare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "Ti chiedo di ascoltarmi. Tadhla vuole parlare con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				}
			]
		},
		{
			"id": 7328202,
