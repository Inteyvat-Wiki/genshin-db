			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "Eccoci qua. Sono felice di vederti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820402,
					"content": "Ho saputo che volevi parlarmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "Mi è sempre piaciuto il deserto a quest'ora del giorno. È bello. Il mio panorama preferito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820405,
					"content": "È un peccato che non sia mai riuscita ad ammirare il tramonto con i miei amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820406,
					"content": "Già... Il deserto è immerso nei colori del tramonto. Quanta pace e serenità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820407,
					"content": "Ma, Tadhla... Cosa volevi dirci esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820409,
					"content": "#Per i Tanit siete {F#delle}{M#degli} ospiti. Per i Falchi siete una potenziale preda. Ma spero che riuscirete a sopravvivere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820410,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "Perciò, mi dispiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820403,
					"content": "Come vanno le cose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
			"completionStepIds": [
				7328206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328206",
							"2"
						],
						"stepId": 7328206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "Accidenti! Masseira è sparito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820602,
					"content": "Ha lasciato un biglietto. Umpf, quella vecchia volpe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732820603,
					"content": "Quando leggerete questo biglietto avrò già raggiunto un rifugio da qualche parte nella valle.\\nSe vi è rimasto un barlume di ragione, vi prego di non rattristarvi per la scelta di Tadhla.\\nLa caccia non è ancora terminata, la tempesta è appena agli inizi.\\nQuesto è l'avvertimento di Masseira, cacciatore e anziano dei Tanit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 732820604,
					"content": "Eh? Cosa vorrebbe dire? Paimon non riesce a capire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820605,
					"content": "Pare che sia fuggito dalla tribù con una certa urgenza e vi abbia lasciato questo biglietto. Umpf, i Tanit non sembrano tanto pacifici quanto vogliono far credere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "(Tadhla evita il contatto visivo e abbassa la testa nervosamente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822802,
					"content": "Stai bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "Scusa, la caccia è finita. Io sono il \"Falco\" di mio padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822804,
					"content": "Ma mi sento bene, non preoccuparti per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822808,
					"content": "È piuttosto estrema come cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "Estrema, dici? Non lo so, ho sempre vissuto così da quando ero bambina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822814,
					"content": "Ah... Ma le storie tue e di Paimon e le avventure che avete vissuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822815,
					"content": "Se ci fosse una possibilità, vorrei sentirle ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822816,
					"content": "Nessun problema! Abbiamo migliaia di storie da raccontare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732822817,
					"content": "Certo! Te le racconterò tutte quante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "Pfff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822820,
					"content": "#Ahem, chiedo scusa. Sono davvero felice. Molte grazie, padron{F#a}{M#e} della djinn. Ah, volevo dire... Grazie, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822818,
					"content": "Possiamo farlo quando vuoi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "Non hai mai pensato di farti una vita per conto proprio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822812,
					"content": "No, mai. Non ci ho mai pensato e nemmeno sperato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822813,
					"content": "Il deserto è un luogo insensibile e brutale, non ho tempo per pensare a me stessa. La tribù vivrebbe allo stesso modo anche senza di me, ma senza di essa io non avrei modo di sopravvivere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822805,
					"content": "A proposito del tuo rapporto con Masseira...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "Come dicevo, lui è mio padre e io sono il suo Falco. Seguo i suoi ordini, per lui caccio e rischio la vita, lui rappresenta la volontà dei Tanit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822807,
					"content": "Quando arriverà il giorno in cui non riuscirò più a eseguire gli ordini di mio padre, allora la mia vita come Falco giungerà al termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				}
			]
		},
		{
			"id": 7328229,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Masseira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822901,
					"content": "#Guarda un po', {F#la}{M#lo} stimat{F#a}{M#o} padron{F#a}{M#e} della djinn. Come posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822902,
						732822906
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822902,
					"content": "A proposito di Tadhla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822903
					]
				},
				{
					"id": 732822903,
					"content": "Le piaci, è piuttosto chiaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822904
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822904,
					"content": "Non preoccuparti, la lascerò in pace. Ah... i giovani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822905
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822905,
					"content": "La incoraggerò a esprimere i suoi sentimenti. In quanto suo padre e adulto, è un dovere a cui sono tenuto. Non c'è bisogno che vi preoccupiate per lei. Davvero.",
