			"dialogs": [
				{
					"id": 732820201,
					"content": "#Le rovine a nord, dove vi siete incontrat{F#e}{M#i} la prima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820202
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820202,
					"content": "È quello che ha scelto. Mi auguro che rispetterai la sua decisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
