			"dialogs": [
				{
					"id": 751750101,
					"content": "Mentre ti immergi nel Flogisto liquido, delle immagini ti appaiono nella mente come dolci ricordi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750102
					]
				},
				{
					"id": 751750102,
					"content": "Vicino alla pozza incandescente, l'ombra argentata e quella ricoperta di cenere stanno avendo una conversazione...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750103
					]
				},
				{
					"id": 751750103,
					"content": "\"...La seconda fase di verifica è stata completata. Denominerò la cosa che tutto purifica ed evolve 'Huitzilopochtli', o 'Fuoco celeste travolgente'...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750104
					]
				},
				{
					"id": 751750104,
					"content": "\"In ogni caso non importa, dato che presto i nomi non avranno alcun significato, in questo luogo.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750105
					]
				},
				{
					"id": 751750105,
					"content": "\"Al fine di contrastare la corruzione, le Adunanze astrali devono essere attivate e collegate attivamente. Prima che l'Abisso possa deformarle completamente, si autodistruggeranno e ne elimineranno l'influenza...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750106
					],
					"speakerTitle": "Immergiti"
				},
				{
					"id": 751750106,
					"content": "Ma come si fa a identificare con precisione i bersagli che sono stati corrotti? Un esemplare controllabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750107
					],
					"speakerTitle": "Immergiti"
				},
				{
					"id": 751750107,
					"content": "Autosperimentazione? Hai perso il senno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750108
					],
					"speakerTitle": "Immergiti"
				},
				{
					"id": 751750108,
					"content": "\"Ah, va bene così. Perlomeno, anche questo vecchio corpo potrà tornare a essere utile.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750109
					]
				},
				{
					"id": 751750109,
					"content": "Quindi tu saresti quello con minori probabilità di sopravvivenza, se questo sistema venisse attivato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750110
					],
					"speakerTitle": "Immergiti"
				},
				{
					"id": 751750110,
					"content": "L'Abisso ha corrotto la tua mente? Oppure... desideri che tutti i tuoi simili ti accompagnino nella tomba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750111
					],
					"speakerTitle": "Immergiti"
				},
				{
					"id": 751750111,
					"content": "\"Quanta poca fiducia nel tuo popolo! Tutti gli altri signori hanno già acconsentito, tranne te.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750112
					]
				},
				{
					"id": 751750112,
					"content": "Stanno semplicemente seguendo alla cieca il tuo piano, senza comprenderne il vero significato... Quest'azione non ha il mio consenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750113
					],
					"speakerTitle": "Immergiti"
				},
				{
					"id": 751750113,
					"content": "\"...Ma poco importa. Distruzione... significa anche rinascita. Ho già preso la mia decisione.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750114
					]
				},
				{
					"id": 751750114,
					"content": "\"Ah... Temo che questo sia il limite di tempo che posso passare sveglio ogni giorno. A ogni modo, lo attiverò non appena sarà tutto pronto.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750115
					]
				},
				{
					"id": 751750115,
					"content": "Non c'è proprio altro da fare? Io sto ancora cercando un'alternativa... Sei sicuro che non stai per incendiare il mondo solo per un tuo rancore personale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750116
					],
					"speakerTitle": "Immergiti"
				},
				{
					"id": 751750116,
					"content": "\"Forse! Farò tutto il necessario per tenere lontano il nemico oscuro al di là di questo mondo.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750117
					]
				},
				{
					"id": 751750117,
					"content": "\"Hah! E poi, un'alternativa, dici... Troverai davvero ciò che cerchi in quegli 'umani' che tanto apprezzi? Sei fin troppo coinvolto, ormai. È più che evidente...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750118
					]
				},
				{
					"id": 751750118,
					"content": "\"Ho cercato di fartelo capire, una volta... ma proprio come con quelli della nostra stirpe, che cercano la saggezza attraverso le fiamme, conoscere e accettare veramente sono due cose ben diverse.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750119
					]
				},
				{
					"id": 751750119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750120
					],
					"speakerTitle": "Immergiti"
				},
				{
					"id": 751750120,
					"content": "\"Se credi che io desideri soltanto 'distruggere'... Se hai un mondo che vuoi costruire... Allora fermami. Uccidimi. Dimostrami di esserne capace!\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750121
					]
				},
				{
					"id": 751750121,
					"content": "\"Ma sappi questo, Kukulkan, sebbene non sia una profezia, è comunque un consiglio da qualcuno che ha percorso quella via. Verrà il giorno in cui...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750122
					]
				},
				{
					"id": 751750122,
					"content": "\"...Percorrerai la mia stessa strada.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}