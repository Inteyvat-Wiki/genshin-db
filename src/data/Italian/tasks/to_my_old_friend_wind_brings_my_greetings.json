			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040301,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040302,
					"content": "Ehi! Sei tu, vero? L'informatore di Kaeya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040303,
					"content": "Informatore? Non so di cosa parlate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040304,
					"content": "Ma... questo è il luogo concordato... e tu sei l'unica persona qui, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040305,
					"content": "\"Luogo concordato\"? Eh, non so nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040306
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040307,
					"content": "In vino veritas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040308
					]
				},
				{
					"id": 400040310,
					"content": "Qualcosa a che fare col... vino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040311
					]
				},
				{
					"id": 400040306,
					"content": "Uff, smettila di essere così fastidioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040307,
						400040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040308,
					"content": "Ah, allora... sì, sono io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040309
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040309,
					"content": "Era proprio necessaria questa formalità?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040311,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040312
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040312,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040313,
					"content": "Va bene... tecnicamente la parola d'ordine è sbagliata, ma... sì, è qualcosa avente a che fare col vino, e supponendo che quel qualcosa sia la saggezza, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040314
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040314,
					"content": "Sì, sono io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040315
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040315,
					"content": "Era proprio necessaria questa formalità?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040316,
					"content": "Cosa volete sapere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040317
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040317,
					"content": "*sospira* Allora, in sostanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040318,
					"content": "Oh, capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040319
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040319,
					"content": "Quindi? Cosa puoi dirci in quanto informatore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040320,
					"content": "Non credo che sia opera dei Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040321
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040321,
					"content": "La ragione per cui i Cacciatori di tesori sono in grado di sostenere una gigantesca operazione internazionale è perché si attengono a un principio fondamentale:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040322
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040322,
					"content": "La cautela. Il loro motto è: \"Chi va piano va sano e va lontano\". Anzi, ritengono che l'idea di correre enormi rischi per cercare di fare fortuna sia pura follia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040323
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040323,
					"content": "Liyue è protetta dagli Adepti, no? E sono particolarmente attivi durante il Festival delle lanterne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040325
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040324,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040325,
					"content": "Non c'è la minima possibilità che noi... scusate, \"loro\"! Un lapsus... dopo essere stato sotto copertura per tanto tempo, ehm, dov'ero rimasto... Oh, sì... Non c'è la minima possibilità che loro, i Cacciatori di tesori, osino fare una mossa durante il Festival delle lanterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040326
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040326,
					"content": "Inoltre... di recente l'organizzazione dei Cacciatori di tesori di Liyue ha ricevuto una lettera anonima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040327
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040327,
					"content": "Perché qualcuno dovrebbe mandar loro una lettera anonima? Per cercare di incastrarli, forse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040328,
					"content": "Non lo sa nessuno, ma posso dirvi quale gruppo di Cacciatori di tesori ha la lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040329
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040329,
					"content": "Ecco, ho segnato la loro posizione sulla mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040330
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040330,
					"content": "#Grazie. Bene, per Paimon è stata una chiacchierata produttiva! {NICKNAME}, questo è il nostro unico vero indizio, non sprechiamolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040331,
					"content": "Se non c'è altro, dovrei tornare alla mia caccia di tesori... Ehm, intendevo dire che dovrei tornare da quei farabutti in cerca di tesori. Per spiarli, eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
