			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040201,
					"content": "#Chi si vede, {NICKNAME}, da quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040202,
					"content": "#Kaeya, siamo andat{F#e}{M#i} al Festival delle lanterne a Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040203,
					"content": "Ah. Beh, com'è stato? Divertente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040204,
					"content": "Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040205,
					"content": "Allora aspettate solo che inizi il Ludi Harpastum a Mondstadt, sono sicuro che vi piacerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040206,
					"content": "Vai al sodo, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "Giusto, giusto! Kaeya, c'è qualcosa che dobbiamo chiederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040208,
					"content": "Mmmh... Materiali per lanterne... Scorte di legno, carta e olio... Proprio una situazione che potrebbe andare storta in qualsiasi momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040209,
					"content": "Ahahah, molto divertente. Cosa vi fa pensare che possa riconoscere questo simbolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040210,
					"content": "Sei un esperto in tutto e ci fidiamo di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "Oh, proprio così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040212,
					"content": "Ahah. Sono lusingato, ma non pensate di starmi sopravvalutando un po'?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040213,
					"content": "Wow! Finalmente Kaeya mostra la virtù cavalleresca della modestia, perfettamente articolata e magistralmente espressa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040214,
					"content": "Santo cielo, il soggiorno a Liyue sembra avervi aguzzato l'ingegno e ampliato il vocabolario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040220,
					"content": "Comunque, sto divagando. Questo è il simbolo dell'organizzazione criminale internazionale che conoscete come i Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040221,
					"content": "Se volete saperne di più, posso mettervi in contatto con un informatore all'interno dell'organizzazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040222,
					"content": "Eh, non hai appena detto che i Cavalieri di Favonius non hanno nulla a che fare con i loro nemici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040223,
					"content": "Questo è un mio informatore personale. Non ha niente a che vedere con i Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040224,
					"content": "Fatevi trovare a Levanteolo, tra un po'. Farò in modo che l'informatore vi incontri lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040225,
					"content": "Grazie Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040226,
					"content": "Oh, e ricordate: \"In vino veritas!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040227,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040215,
					"content": "Beh, visti i tuoi... contatti discutibili... pensavamo potessi saperlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "Esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040217,
					"content": "#Ehm! Dovresti stare attent{F#a}{M#o} a quello che dici, Cavaliere Onorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040218,
					"content": "Cosa intendi con contatti discutibili? I Cavalieri di Favonius non hanno certo nulla a che fare con i loro nemici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040219,
					"content": "Ha a che fare con una certa virtù cavalleresca chiamata \"integrità\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4000403,
			"completionStepIds": [
				4000403
