			"trigger": {
				"objectNames": [
					"Pervases"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "Lo spirito si libra in cielo sulle montagne, mentre il corpo riposa e il mondo continua ad andare avanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030102,
					"content": "Ehm... Scusa se ti interrompo, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030103,
					"content": "Vorremmo prendere in prestito un incensiere e delle lampade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "Che assurdità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030105,
					"content": "Due persone che entrano in un santuario soltanto per appropriarsi di alcuni oggetti di culto, e non per adorare gli dèi o gli Adepti. Ahahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030106,
					"content": "Siamo consapevoli che è scortese una richiesta del genere, ma ci servono solo per poco tempo, è la verità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030107,
					"content": "Vi servono per il rituale del Catturasogni, suppongo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030108,
					"content": "C-come fai a saperlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030109,
					"content": "Mi trovo in questo santuario da molto più tempo di quanto tu possa immaginare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030110,
					"content": "Forse, come ricompensa per la mia devozione, sono stato dotato di una discreta conoscenza delle arti degli Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030111,
					"content": "Caspita. Paimon non sapeva che potessero accadere cose del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030112,
					"content": "Ah, non importa. Prendi pure ciò che ti occorre. È una fortuna che questi oggetti possano esserti utili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030113,
					"content": "Dal momento che qui sono serviti a ben poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030114,
					"content": "C'è qualcosa che ti turba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "Oh, niente di cui tu debba preoccuparti. Prendi pure ciò che ti occorre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030116,
					"content": "Bene... Grazie, allora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "Non c'è di che. Prendi pure ciò che ti occorre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				}
			]
		},
		{
			"id": 1110302,
			"completionStepIds": [
				1110317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110301",
