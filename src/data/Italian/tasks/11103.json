				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111031101,
					"content": "Ah! Eccoti qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031102,
					"content": "Abbiamo recuperato il Sigillo del consenso. Lo vuoi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031103,
					"content": "Vi ringrazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031104,
					"content": "È pronto per ordinare, signore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031105
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031105,
					"content": "Un pesce acorno alla griglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031106
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031106,
					"content": "Certamente, glielo prepareremo immediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031107
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031107,
					"content": "Eh? Niente tofu di mandorle questa volta? Non è da Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031108,
					"content": "Il pesce acorno alla griglia era il piatto preferito di Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031109,
					"content": "Ero solo curioso di... sapere che gusto avesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031110,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031111,
					"content": "Con le onde e le tempeste catturo i pesci, con il vento e la neve sconfiggo il male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031112
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031113,
					"content": "Avete altro da dirmi? Sono... abituato a mangiare da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031114,
						111031115
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031114,
					"content": "Ti lasciamo in pace, allora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				},
				{
					"id": 111031116,
					"content": "#Eheh! E così, l'investigatrice Paimon e {M#il fedele viaggiatore}{F#la fedele viaggiatrice} hanno risolto il caso e si allontanano silenziosamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031115,
					"content": "Andiamo, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				}
			]
		},
