				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "Hai raccolto gli oggetti per il rituale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030502,
					"content": "Mmh... Questo incensiere, e queste lampade... sono impeccabili, sembrano essere stati creati appositamente per essere usati nelle arti degli Adepti. Dove li hai trovati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030503,
					"content": "Ce le ha date uno Yaksha di nome Pervases...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "Ah! E uhm, ti saluta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030505,
					"content": "Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030506,
					"content": "Sì, sembra proprio qualcosa tipico di Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030507,
					"content": "Come immaginavo, sembra che anche lui non sia riuscito a lasciarsi alle spalle Liyue... Spero che, nonostante la sua sofferenza, possa riposare in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030508,
					"content": "Bene, allora. Prepariamoci per il rituale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030509,
					"content": "Mettete l'incensiere al centro e circondatelo con le Lampade delle Sette Stelle. Adornate l'area con gli oggetti del freddo abissale. Una volta fatto questo, possiamo procedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030510,
					"content": "Sì, andrà bene. Ora, la prossima fase è quella fondamentale per eseguire il rituale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030511,
					"content": "Questo rituale ha quattro fasi: l'offerta dell'incenso, la meditazione, una formula magica e il lancio di una freccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030512,
					"content": "Ah, che tiritera lunga lunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030513,
					"content": "Le arti degli Adepti sono il risultato di millenni di studio. Non osare ridurre la loro funzione mistica a una semplice tiritera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030514,
					"content": "Non dandogli la giusta importanza, il rituale potrebbe portare alla fine del proprio corpo o alla separazione dello spirito da esso in via permanente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030515,
					"content": "Accidenti, smettila di dire queste cose! Paimon non voleva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030516,
					"content": "Per offrire l'incenso, dobbiamo metterlo nell'incensiere in segno di riverenza verso Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030517,
					"content": "La meditazione serve a liberarci dai pensieri futili e a concentrarci sul fine del rituale che stiamo eseguendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030518,
					"content": "Poi, reciteremo la formula magica ad alta voce: Devayaksha, respingi il male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030519,
					"content": "Infine, lanceremo una freccia in direzione di ciascuna statua degli Yaksha per assicurarci il loro consenso riguardo al nostro compito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030520,
					"content": "Se tutto va secondo i piani, l'anima di Ladro di stelle verrà evocata a breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030521,
					"content": "Capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "Se non avete altre domande, possiamo cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030524,
					"content": "Mmh... beh... Come prima cosa offriamo l'incenso, giusto? In segno di riverenza verso Rex Lapis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030522,
					"content": "*deglutisce*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				}
			]
