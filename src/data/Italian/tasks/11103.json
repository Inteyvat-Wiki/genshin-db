					"id": 111030911,
					"content": "Ehm... Io... tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030912
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030912,
					"content": "Sembra che Xiao l'abbia spaventato a morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030913,
					"content": "O grande Adeptus, posso chiedere il tuo nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030914,
						111030915
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030914,
					"content": "Lui è Conquistademoni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030916,
					"content": "Sei davvero tu! Sei proprio tu! Non avrei mai immaginato di incontrare Conquistademoni, il Custode Yaksha in persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030917
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030917,
					"content": "Conosci Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030918,
					"content": "Certamente! Mio nonno era uno studioso di tradizioni popolari, e quand'ero piccolo mi raccontava le storie di Conquistademoni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030919
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030919,
					"content": "Ancora oggi, sono un appassionato collezionista di libri sugli Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030920
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030920,
					"content": "Ma da quando ho trovato un Sigillo del consenso rovistando tra gli effetti personali di mio nonno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030921,
					"content": "Ho iniziato ad imitare gli Adepti solo per divertimento... Ma, gradualmente, ho iniziato ad abbandonare sempre di più la retta via...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030922,
					"content": "Uhm, quindi, in poche parole... sei un ammiratore di Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030923,
					"content": "S-Sì. Grazie ad entrambi per avermi permesso di essere testimone della grandezza di Conquistademoni, è un sogno che si avvera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030924,
					"content": "Uhm, non era proprio questa la nostra intenzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030925,
					"content": "Consentitemi di pronunciare questo giuramento davanti al grande Conquistademoni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030926,
					"content": "Giuro di rinunciare al male, di vivere una vita onesta e di non infangare mai più il nome degli Adepti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030927,
					"content": "Mi ricorderò del tuo giuramento... Ora vai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030928,
					"content": "Grazie... mille grazie per avermi perdonato... e per tutto quello che hai fatto per Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030929,
					"content": "Sembrava molto sincero quando ha fatto quel giuramento. Suppongo che non ingannerà più nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030930,
					"content": "Oh, aspetta! Non abbiamo ancora recuperato il Sigillo del consenso. Domani, per prima cosa, andremo alla Locanda Wangshu a cercarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030915,
					"content": "Lui è il Custode Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "Allora, vuoi continuare con questo teatrino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "N-No, no, non lo farò più! M-mi hai quasi ucciso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Ladro di stelle"
				}
			]
		},
		{
			"id": 1110310,
			"completionStepIds": [
				1110310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
