					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "Questo incensiere... dovrebbe andare bene... giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030202,
					"content": "Perlomeno non è in rovina come questo santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030203,
					"content": "Quindi ora... dobbiamo solo trovare le Lampade delle Sette Stelle, giusto? Prima iniziamo, prima finiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "Eh? Dov'è andato? Era qui un momento fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030302,
					"content": "Pensavo che una volta ottenuto ciò di cui avevi bisogno, avresti ripreso il tuo cammino dimenticandoti di me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030330,
					"content": "Ah! È la voce di quel tizio! Ehilà? D-dove sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030303,
					"content": "Non ho più sembianze fisiche da oltre mille anni. Ciò che hai visto prima era opera di un'arte degli Adepti nota come Illusione mortale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030304,
					"content": "Ora che hai trovato le Lampade delle Sette Stelle e l'incensiere da usare per il rituale, non potrai più vedermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030305,
					"content": "Quindi sei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "Tempo fa, facevo parte dell'ordine degli Yaksha, e Rex Lapis mi conferì il nome di Pervases. Ma la mia forza mi abbandonò e fui ucciso in battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030309,
					"content": "Oggi è l'anniversario della mia morte. Il mio ultimo desiderio era quello di vedere una nuova Liyue, ed è per questo che ho deciso di eseguire qui questo rituale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030310,
					"content": "Detto ciò... Conquistademoni ti ha mandato qui, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030311,
					"content": "Quindi, voi due vi conoscete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030312,
					"content": "Percepisco la sua aura su di te... e anche il pesante fardello del suo karma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030313,
					"content": "*sospira* Anche dopo tutti questi millenni, deve ancora soffrire così tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030314,
					"content": "Mi vergogno così tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030315,
					"content": "Non dire così, Pervases, hai sacrificato tutta la tua vita per Liyue, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030316,
					"content": "La vita è una cosa preziosa, sì... ma quando penso a ciò che Conquistademoni deve sopportare... *sospira* mi rendo conto che la morte è stata la soluzione più semplice. Una soddisfazione egoistica, la potrei definire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030317,
					"content": "Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030318,
					"content": "Ahahah, mi scuso. I compleanni dovrebbero essere occasioni di gioia, ma allo stesso modo, è difficile non essere malinconici durante l'anniversario della propria morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030319,
					"content": "L'Illusione mortale non durerà ancora a lungo. Prendetevi cura di voi e vi prego di portare i miei saluti a Conquistademoni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030320,
					"content": "Lo faremo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "*sospira* Se solo potessi gustare ancora una volta un vero pesce acorno alla griglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030323,
					"content": "Con le onde e le tempeste catturo i pesci, con il vento e la neve sconfiggo il male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030325,
					"content": "Eh? Sembra che se ne sia andato davvero... Paimon spera vivamente che qualcuno si ricorderà di Pervases lo Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030326,
					"content": "Dobbiamo andare. Ma dovremmo tornare qui di tanto in tanto per fargli un'offerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
