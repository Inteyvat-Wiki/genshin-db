						111030703
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030703,
					"content": "Lasciate fare a me il resto. Voi due preparatevi ad accoglierlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030704
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030704,
					"content": "Dove si trova costui... Eh? Mi sembra di conoscervi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030705
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030705,
					"content": "Cosa succede al costui corpo? Costui si sente... leggero. Leggero come una piuma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030706,
						111030709
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030706,
					"content": "Abbiamo evocato il tuo spirito con un'arte degli Adepti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030707
					]
				},
				{
					"id": 111030707,
					"content": "Un'arte degli Adepti? Ahahah! Osate indossare le vesti di un Adeptus in sua presenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030708
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030708,
					"content": "Costui non capisce dove si trova... Costui avrebbe potuto giurare che stava per addormentarsi nella Locanda Wangshu appena un momento fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030712,
					"content": "Aspetta... dev'essere questo il motivo... Certo che è questo! Ahahah, non ci si può aspettare altro da un Adeptus come costui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030713,
					"content": "Costui sta sognando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030714,
					"content": "Uff, questo tizio è senza speranze, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030715,
					"content": "Oh, non stai sognando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "Eh? Che cosa significa questo? Nei suoi sogni non è consentita una tale insolenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030718,
					"content": "Va bene, è ora di rimetterlo al suo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030716,
					"content": "Se sognassi, non sentiresti alcun dolore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "Indovina un po'? Sei già morto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030710
					]
				},
				{
					"id": 111030710,
					"content": "Morto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030711
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111030711,
					"content": "Impossibile! Costui si stava solo riposando in tranquillità alla Locanda Wangshu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Ladro di stelle"
				}
			]
		},
