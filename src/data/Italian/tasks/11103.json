						111030903
					]
				},
				{
					"id": 111030903,
					"content": "Sì! Sì, vi credo! Pensavo che sarei morto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
