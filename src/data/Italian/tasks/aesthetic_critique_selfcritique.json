				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "No, no... Se elimino le luci e le ombre, cosa succederà agli strati di pittura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150402,
					"content": "Il potere espressivo di quei colori è insufficiente... e nemmeno il contrasto è un granché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150403,
					"content": "Uffa! È bastato rimuovere qualche elemento che adesso è tutto un disastro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150404,
					"content": "Cosa combini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "Ah, siete voi. Che bello rivedervi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150407,
					"content": "Chiedo scusa per il fraintendimento, ero preso dai problemi di quest'immagine, e non ho potuto fare a meno di muovermi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150408,
					"content": "Forse non lo capirai, ma quando rifletto sui problemi non riesco proprio a stare fermo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150409,
					"content": "Più sto seduto a esaminare un problema e più divento frustrato. È per questo che di solito penso camminando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150410,
					"content": "Lascio che le mie gambe mi conducano dove desiderano mentre rifletto, fintanto che non mi tengono fermo in un posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150411,
					"content": "...Accade abbastanza spesso. Scusa se ti ho fatto preoccupare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150412,
					"content": "Sei giunto a una conclusione, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "Per niente... Non so nemmeno da dove cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150415,
					"content": "Se rimuovo gli effetti di luce, l'immagine risulterà piatta, ma se riduco i contorni e la forma, gli oggetti non sosterranno la struttura complessiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150416,
					"content": "L'eliminazione di qualsiasi elemento farà crollare il tutto, trasformandolo in un mucchio di spazzatura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150417,
					"content": "Sto parlando da solo, quindi non preoccuparti troppo... Sto solo pensando a come risolvere questo problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150418,
					"content": "Devo tornare indietro a cercare il mio cavalletto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150413,
					"content": "Qualche progresso con la questione che stavi esaminando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "Per un attimo ho pensato che fossi in pericolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401506",
							"2"
						],
						"stepId": 2401506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "*ansima* Grazie... Davvero, grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150602,
					"content": "Sul serio... Stavo solo dipingendo, ma ancor prima che me ne rendessi conto mi avevano circondato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150603,
					"content": "Hanno attaccato il mio dipinto con così tanto vigore che avresti pensato che volessero mangiarselo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150604,
					"content": "Ma ovviamente non potevo permetterglielo, quindi l'ho afferrato e sono scappato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150605,
					"content": "Non avevo fatto molta strada che mi avevano già raggiunto... Grazie agli Archon c'eri tu a salvarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150606,
					"content": "Qualcosa non va con questo dipinto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "Se solo lo sapessi! Ho sempre usato il nettare del Malefiore per realizzare le mie pitture... Sai, la roba che mi hai portato prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150609,
					"content": "Aspetta... E se la pittura li attirasse? No, non può essere... Quel nettare è del tutto inodore dopo che l'ho mescolato nella pittura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150610,
					"content": "E non oso nemmeno cambiare la formula, ora come ora. Mi sa che dovremo trovare un altro modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150611,
					"content": "*tossisce* E pensare che avevo perfino pensato che i Malefiori avessero percepito la bellezza del mio dipinto e volessero ammirarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150607,
					"content": "Che cos'hai fatto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}