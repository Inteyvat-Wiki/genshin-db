			},
			"dialogs": [
				{
					"id": 221050101,
					"content": "Che angoscia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050102,
					"content": "Qualche problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "C'è qualcosa in questa zona che mi inquieta. Non so come spiegarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050104,
					"content": "Il fatto che tutti i nostri ospiti siano persone particolarmente vigili non aiuta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050105,
					"content": "Basta un nonnulla per ritrovarci con finestre e porte rotte. A volte persino le assi del pavimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050106,
					"content": "Per fortuna sono gli stessi ospiti a sistemare, ma sono riparazioni raffazzonate e hanno tutt'altro che un bell'aspetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050107,
					"content": "Potresti dare un'occhiata fuori dalla locanda? Se trovi qualcosa di strano... occupatene tu. Io devo badare agli ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050108,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050109,
					"content": "Che problemi ha, questa gente....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "Oh, non sono così male, in fondo! Sono solo abituati a sopravvivere nella natura selvaggia. Non puoi biasimarli per essere sempre sul chi vive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050112,
					"content": "Per favore, dai un'occhiata nei paraggi. Sono sicura che non troverai nulla di eccessivamente grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
