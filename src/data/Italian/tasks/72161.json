				{
					"id": 721610401,
					"content": "Rieccoti. Fa' attenzione quando sei su quest'isola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610402
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610402,
					"content": "Ti basta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7216105,
			"completionStepIds": [
				7216105
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216105",
							"2"
						],
						"stepId": 7216105,
						"stateName": "QUEST_STATE_UNFINISHED"
