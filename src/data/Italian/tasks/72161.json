			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "Uff, imbarazzante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610102,
					"content": "Ehi! Ti abbiamo salvato la vita! Che vuol dire che siamo \"imbarazzanti\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610103,
					"content": "Paimon, sta parlando di sé stesso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "#E pensare che sono stato salvato da {F#delle}{M#degli} stranier{F#e}{M#i} che mi hanno persino giudicato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610106,
					"content": "Oh... Quindi, signor samurai, stai bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610108,
					"content": "Beh, perlomeno sembra star bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "#Sono in debito con te, stranier{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610111,
					"content": "E poi hai combattuto in modo ammirevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610112,
					"content": "#Sono {NICKNAME}. Piacere di conoscerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "#Non guardarmi dall'alto in basso, stranier{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610114,
					"content": "...Sono Inaba Tousaburou Kyuuzou. Puoi chiamarmi Kyuuzou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610115,
					"content": "Quindi... Chi erano quelle persone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "Sono pirati e hanno molte roccaforti dalle parti della Spiaggia di Nazuchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610118,
					"content": "A volte, delinquenti, minatori e pescatori disoccupati, tizi in fuga dal Decreto di caccia alle Visioni e disertori di una delle due fazioni in guerra fanno gruppo e finiscono per diventare banditi e pirati. Cercano, seppur invano, di sfuggire al controllo di Sua Eccellenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610119,
					"content": "Che li si chiami ronin o Kairagi, non sono altro che fuorilegge. Li stavamo reprimendo da un po', ma poi i ribelli hanno spezzato l'amuleto dell'isola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610120,
					"content": "I profughi di Tatarasuna e della miniera sono fuggiti in rapida successione, e alcuni di quei ratti si sono precipitati qui. Hanno ampliato le file di queste bande di pirati, rendendole più temerarie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610121,
					"content": "Quei pirati di poco fa avevano messo gli occhi sulla merce a bordo e sono venuti dall'accampamento a sud.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610122,
					"content": "Per loro sfortuna, ho rovinato i loro piani... Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610123,
					"content": "Quindi questa nave non è tua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "Questa qui? Non lo so... Prima era dei ribelli di Sangonomiya. In ogni caso, quando sono arrivato qui, era già stata abbandonata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610125,
					"content": "Quindi sono rimasto, e finora ci ho vissuto dentro come un paguro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610126,
					"content": "Ah, era da tantissimo tempo che non parlavo così tanto. Che faticaccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610127,
					"content": "Avrei bisogno di aiuto con una faccenda, se non ti dispiace. Non appena la ferita sarà guarita, di sicuro ricambierò il favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610128,
					"content": "Vorrei che mi aiutassi a sgomberare l'accampamento di pirati qui vicino, quello di cui parlavo prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610129,
					"content": "Solo così posso impedire loro di tornare qui a infastidirmi come un branco di cani randagi. Magari il messaggio arriverà anche agli altri accampamenti di pirati e non si faranno strane idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610130,
					"content": "Mi farebbe anche capire di cosa sei capace. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610131,
					"content": "Un gioco da ragazzi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "Umpf, vedo che ti piace darti delle arie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610134,
					"content": "#In ogni caso, stranier{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610135,
					"content": "#Non diventare troppo presuntuos{F#a}{M#o}, perché basta un passo falso per farsi molto male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610132,
					"content": "Vado e torno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "Come mai ti hanno attaccato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "Beh, di sicuro è stato ferito nell'orgoglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "È una cosa tipica dei samurai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
		{
			"id": 7216102,
