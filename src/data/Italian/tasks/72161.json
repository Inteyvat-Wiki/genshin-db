			},
			"dialogs": [
				{
					"id": 721610701,
					"content": "...E sembra che i ratti nei paraggi stiano di nuovo scappando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610702
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610702,
					"content": "#Fa' attenzione ai pirati mentre vaghi da queste parti, stranier{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610703
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610703,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610704
					]
				},
				{
					"id": 721610704,
					"content": "Non c'è di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610705
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610705,
					"content": "Non sono alla mia altezza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "Ahah, ecco che ti dai di nuovo delle arie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610707,
					"content": "Potrai dirlo quando li avrai eliminati tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610708,
					"content": "Affare fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610709
					]
				},
				{
					"id": 721610709,
					"content": "Sì, siamo d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				}
			]
		},
