				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610601,
					"content": "#Come vanno le cose, stranier{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610602,
					"content": "Chiedo scusa. Non è un luogo adatto a ricevere ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610603,
					"content": "#Eppure sono... felice che tu sia riuscit{F#a}{M#o} a venire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610604,
					"content": "Ti trovo molto meglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "È solo merito tuo. Sono nuovamente in debito con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610606,
					"content": "Ahah, non è un peccato che sia sopravvissuto per l'ennesima volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610607,
					"content": "Perché sarebbe un peccato? Non dovrebbe essere una cosa positiva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610608,
					"content": "E ora cosa farai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "Non ho ancora deciso cosa farò, ma non credo che tornerò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610611,
					"content": "Kujou Masahito non è una cattiva persona, ma suo padre esige che i disertori vengano catturati e puniti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610612,
					"content": "Non posso permettermi di farlo irritare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610613,
					"content": "Forse smetterò di fare il soldato. È stato bello vivere qui da solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610614,
					"content": "Ma finché non torna la pace, non ha senso illudermi. In base ai miei ricordi, sono sempre lo stesso soldato ferito e macchiato di sangue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610615,
					"content": "*sospira* E chissà cosa potrebbe succedere in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610616,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "Beh, come dicevo, non ho mai messo in dubbio le decisioni di Sua Eccellenza. Quindi, anche se morissi, non avrei rimpianti, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610619,
					"content": "Wow, d'un tratto il discorso si è fatto serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610620,
					"content": "Ah, a proposito, è tempo che faccia visita ai miei vecchi compagni d'armi che sono ancora qui con me su quest'isola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610621,
					"content": "Qui a Inazuma è tradizione offrire ai compagni caduti in battaglia un dendrobium, fiore nobile e delicato... Simboleggia il destino di ogni samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610622,
					"content": "Comunque, se viaggiando incontri i miei vecchi compagni, ti prego di fermarti a conoscerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610617,
					"content": "... ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "Hai mai pensato di tornare lì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
		{
			"id": 7216107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
