		{
			"id": 7216113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721611301,
					"content": "#{F#Una}{M#Uno} stranier{F#a}{M#o}, eh? Interessante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611302
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611302,
					"content": "Questo posto non è adatto a una gita turistica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611303
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611303,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611304
					]
				},
				{
					"id": 721611304,
					"content": "Aspetta, ti manda lo Shogunato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611305
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611305,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611306
					]
				},
				{
					"id": 721611306,
					"content": "Allora fatti gli affari tuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611307,
					"content": "Com'è maleducato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611308,
					"content": "#Sì, esatto, mi ha mandat{F#a}{M#o} lo Shogunato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611309
					]
				},
				{
					"id": 721611309,
					"content": "Perché voi stranieri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611310,
					"content": "Di fronte al commissario implorate come cani, ma di fronte a noi samurai di Inazuma fate gli arroganti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611311,
					"content": "#Correte in giro, spiate, create problemi ovunque... E ora voi due siete venut{F#e}{M#i} fino a quest'imbarcazione rotta, e solo gli Archon sanno perché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611312,
					"content": "Beh, mi dispiace per voi. Io non sono altro che un soldato ferito. Non posso aiutarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611313,
					"content": "Quindi fatemi il piacere di andarvene da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611314
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611314,
					"content": "Ma questo tizio non conosce le buone maniere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611315,
					"content": "Pensatela come volete. Fate troppo rumore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611316,
					"content": "Prima che ve ne andiate, lasciate che vi dia un consiglio: non trattenetevi troppo a lungo sull'Isola di Yashiori, è maledetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611317
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611317,
					"content": "Maledetta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611318
					]
				},
				{
					"id": 721611318,
					"content": "Che c'è, non ci senti? Ho detto che quest'isola è maledetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611319
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611319,
					"content": "Quest'infinita situazione di stallo, l'ambizione dei nostri signori, la disperazione della gente comune, l'odio che scaturisce dalle vittime innocenti, il tanfo dei farmaci che riempie le camere degli anziani in punto di morte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611320
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611320,
					"content": "È una maledizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611321
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611321,
					"content": "Andatevene, prima che il suo peso vi schiacci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611322
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611322,
					"content": "Che tipo strambo. Paimon non l'ha capito per niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7216114,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
