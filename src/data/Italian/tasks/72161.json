			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216114",
							"2"
						],
						"stepId": 7216114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610301,
					"content": "#Sei tornat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610302,
						721610303
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610302,
					"content": "Li ho sistemati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				},
				{
					"id": 721610304,
					"content": "Oh, all'improvviso l'aria si è fatta strana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610305,
					"content": "#Mi scuso per aver chiesto a {F#una}{M#uno} stranier{F#a}{M#o} come te di sporcarsi le mani al posto mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610306,
					"content": "Sei molto più gentile rispetto a quando ci siamo incontrati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610309,
					"content": "Ho usato tutte le erbe medicinali che avevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610310,
					"content": "Non ho più erbe con cui medicare la ferita, eppure è ancora piuttosto infiammata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610311,
					"content": "Ma non preoccuparti. Posso resistere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610312,
					"content": "Va' e occupati dei tuoi affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610313,
					"content": "Sei proprio un bambino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610315,
					"content": "Cos'hai detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610316,
					"content": "Parliamo di te. Ti stai comportando come un bambino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610317,
					"content": "Sei chiaramente messo malissimo e sembri sul punto di chiedere aiuto, eppure continui a fare il duro... Non sei per niente sincero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610318,
					"content": "Solo i bambini si comportano così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610319,
					"content": "E non dimenticarti, signor Kyuuzou...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610320,
					"content": "...che sei ancora in debito con noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "Umpf... Cosa devo fare con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610323,
					"content": "In tal caso, trovatemi dell'Erba del pianto: cresce ovunque su quest'isola. La parte migliore sono le foglie intere, perché si possono spremere per estrarre un liquido da applicare sulla ferita e ridurre l'infiammazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610324,
					"content": "Tutto qui. Ora lasciatemi solo, voglio farmi un pisolino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610321,
					"content": "Siamo qui per aiutarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "La ferita va meglio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "Dovresti riuscire a star tranquillo e in pace per un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
		{
