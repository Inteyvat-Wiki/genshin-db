			"dialogs": [
				{
					"id": 200420601,
					"content": "Hai finito di spazzare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420602
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420602,
					"content": "Sì, è tutto pulito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420603
					]
				},
				{
					"id": 200420603,
					"content": "Grazie. La cattedrale ha un aspetto molto migliore, ora! Sono certo che Barbara ne sarà sollevata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420604
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420604,
					"content": "Ma, ti prego, non dire nulla di tutto ciò a Barbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420605
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420605,
					"content": "Voglio solo ridurre il peso sulle sue spalle, e parlargliene non farebbe altro che appesantirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420606
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420606,
					"content": "Come d'accordo, ora me ne vado. Hai visto? Non c'era niente di cui preoccuparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420607
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200420607,
					"content": "Ci rivedremo... forse? Chissà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
