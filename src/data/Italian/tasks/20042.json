						200420102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420102,
					"content": "Cosa stai cercando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420103
					]
				},
				{
					"id": 200420103,
					"content": "Io? Oh... sto cercando una persona molto sfuggente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420104,
					"content": "Si chiama Albert e si aggira sempre nei pressi della cattedrale durante il giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420105,
					"content": "Non sembra avere buone intenzioni. Temo che stia architettando qualcosa di malvagio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420106,
					"content": "Puoi trovarlo per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
