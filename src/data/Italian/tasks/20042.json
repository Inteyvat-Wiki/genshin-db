				"points": []
			},
			"dialogs": [
				{
					"id": 200421001,
					"content": "Io? Sgattaiolare, comportarsi in modo sospetto e tramare piani malvagi? Siete totalmente fuori strada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421002
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421002,
					"content": "*sospira* Conoscete Barbara? È l'angelo di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421003
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421003,
					"content": "Molte persone a Mondstadt la ammirano, me incluso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421004
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421004,
					"content": "Anzi, sono proprio il capo del club degli ammiratori di Barbara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421005
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421005,
					"content": "I Cavalieri di Favonius saranno qui a breve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200421006
					]
				},
				{
					"id": 200421006,
					"content": "L-Lasciatemi finire! Ammiro davvero molto Barbara. Voglio essere come lei, voglio fare qualcosa per Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421007
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421007,
					"content": "Ma sono solo una persona normale con abilità normali. Il massimo che riuscirei a fare è spazzare intorno alla cattedrale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421008
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421008,
					"content": "Ma la signorina Victoria non mi ascolta mai, dice solo che vuole che me ne vada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421009
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421009,
					"content": "Di recente, ho notato che nessuno spazza via le foglie intorno alla cattedrale. Ma se provassi a spiegarlo a Victoria, non capirebbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200421010
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 200421010,
					"content": "Puoi aiutarmi a spazzare via le foglie? Per Mondstadt... e per Barbara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
