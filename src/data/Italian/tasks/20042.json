			"dialogs": [
				{
					"id": 200420701,
					"content": "Ho notizie su Albert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420702
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420702,
					"content": "Se n'è andato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420703
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420703,
					"content": "Sì, è andato via.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420704
					]
				},
				{
					"id": 200420704,
					"content": "Beh, questione risolta... Ma perché stavi spazzando tutte quelle foglie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420705,
					"content": "Non importa, immagino che l'assenza di foglie sia solo una scusa in meno a cui Albert potrebbe ricorrere per avvicinarsi ancora alla cattedrale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420706,
					"content": "Questi regali sono il mio ringraziamento per te. Prendili, e che l'Archon di Anemo sia con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420707
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420707,
					"content": "Se non c'è altro, devo tornare al lavoro. E anche tu dovresti occuparti delle tue cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
