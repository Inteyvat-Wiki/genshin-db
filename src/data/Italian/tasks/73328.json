				"points": []
			},
			"dialogs": [
				{
					"id": 733280101,
					"content": "Ehilà, Jeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280102,
					"content": "#{NICKNAME}? E anche Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280103,
					"content": "Bip bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280104
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280104,
					"content": "#Ahah! Visto? Lo dicevo che ci saremmo incontrat{F#e}{M#i} di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280105,
					"content": "Che ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280106
					]
				},
				{
					"id": 733280106,
					"content": "Beh, ogni fanciulla ha i suoi piccoli segreti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280107
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280107,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280108,
					"content": "#{F#Trovami un izayaka e fammi divertire un po', dopodiché deciderò se confidartene qualcuno... Devo mica devo insegnartelo io, no?!}{M#Non fare domande! Ci sono cose che neanch'io mi sento di confidare...}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280109,
					"content": "#{F#Ahah, sto scherzando! Noi guardie abbiamo delle regole da seguire... Non dobbiamo fare parola con nessuno riguardo a ciò che stiamo scordando. Scusami, davvero.}{M#Pfff, perdonami, ma è la regola: sono una guardia privata, non posso dirti nulla.}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280110,
					"content": "Umpf, non farla tanto misteriosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280111,
					"content": "Allora... Che si dice di bello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280112,
						733280113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280112,
					"content": "Tutto a posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				},
				{
					"id": 733280114,
					"content": "Già... Per me è uguale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280115,
					"content": "D'accordo, allora non ti trattengo oltre. *sospira* Ho anch'io degli affari a cui badare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280116
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280116,
					"content": "Uh... Sei davvero impegnata, Jeht. Quasi non ti riconosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733280117,
					"content": "Pfff... Beh, funziona così quando hai un lavoro \"stabile\". Anche se non sto facendo niente di così diverso rispetto a prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280118
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280118,
					"content": "La nostalgia della libertà ha iniziato a farsi sentire quasi subito, onestamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280119,
					"content": "Non so come vadano le cose a voi, ma ogni volta sono ansiosa di ascoltare le vostre storie. Anch'io ne ho un bel po' da raccontare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280120
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280120,
					"content": "Ma ci sarà tempo per quello. Le buone storie sono come il vino: più invecchiano, più sono gustose. Un tempo, storie simili erano come un nutrimento per i viaggiatori del deserto, eheh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280121,
					"content": "Mmh... Comunque, abbiate cura di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280122
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280122,
					"content": "Anche tu, Jeht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280123
					]
				},
				{
					"id": 733280123,
					"content": "Certo! Lascia che ti dia un mare di abbracci. Non smetterò mai di pregare per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280124
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280124,
					"content": "Bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280125
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733280125,
					"content": "Ahah! Certo, lo stesso vale per Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280113,
					"content": "Me la cavo bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280114
					]
				}
			]
		},
		{
			"id": 7332802,
			"completionStepIds": [],
