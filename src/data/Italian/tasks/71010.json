			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100301,
					"content": "I mostri sono la rovina di tutto ciò che è degno di essere vissuto in questo mondo. Coloro che sono abili con la spada hanno il dovere di porre fine alla loro esistenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
					],
					"speakerTitle": "Tesoro delle rovine"
				},
				{
					"id": 710100302,
					"content": "I mostri sono malvagi! Meritano solo di essere sterminati senza pietà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100303
					],
					"speakerTitle": "Tesoro delle rovine"
				}
