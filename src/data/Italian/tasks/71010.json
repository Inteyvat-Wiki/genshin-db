			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100101,
					"content": "Sin dall'infanzia, sono stato addestrato alle arti marziali insieme a un altro discepolo. La nostra missione era combattere le forze del male e proteggere tutto ciò che di sacro vi è in questo mondo. Un compito non facile per chi è privo di una Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Tesoro delle rovine"
				},
				{
					"id": 710100102,
					"content": "Abbiamo scelto di ritirarci qui per allenarci ulteriormente e trovare le Visioni tanto desiderate. Abbiamo eretto questo monumento come testimonianza dei nostri sforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Tesoro delle rovine"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101006",
							"3"
						],
						"stepId": 7101006,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "Tuttavia, ora che il mio compagno ha ottenuto la sua Visione, anziché continuare a combattere i mostri, mi ha chiesto: \"I mostri sono davvero malvagi per natura?\" Io ho risposto: \"Seminano distruzione in giro per il mondo e gente innocente ne soffre di conseguenza. Tanta malvagità non ti pare abbastanza per sguainare la spada?\" Temo proprio che abbia meditato troppo e gli si sia fritto il cervello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Tesoro delle rovine"
				},
				{
					"id": 710100202,
					"content": "In ogni caso, ho ancora intenzione di affrontare i mostri, anche se dovessi farlo senza di lui e senza l'aiuto di una Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Tesoro delle rovine"
				}
			]
		},
		{
			"id": 7101003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101007",
