			},
			"dialogs": [
				{
					"id": 120120801,
					"content": "Lo Spettacolo pirotecnico Naganohara dovrebbe cominciare presto, giusto? Mia figlia se n'è andata già da un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120802
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120802,
					"content": "Eheh, non vedeva l'ora di uscire di casa. È davvero presa da un ragazzo in città, ce l'ha scritto in faccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120803
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120803,
					"content": "*sospira* Ma almeno è felice, suppongo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Satoru"
				}
			]
		},
		{
			"id": 1201209,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
