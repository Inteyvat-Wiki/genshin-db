				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120901,
					"content": "Mi dispiace che non siamo stati di grande aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120902
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120902,
					"content": "Un giorno, però, quel ragazzo dovrà confrontarsi con le proprie emozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120903
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
