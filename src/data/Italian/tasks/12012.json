	"talks": [
		{
			"id": 1201201,
			"completionStepIds": [
				1201201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201201",
							"2"
						],
						"stepId": 1201201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori",
					"Imatani Saburou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "Bene, bene! Se non è Yoimiya! Entra pure, cara, vieni a sederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120102,
					"content": "#Loro sono amic{F#he}{M#i} tu{F#e}{M#oi}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120103,
					"content": "Sì, vengono da lontano. Di questi tempi, per gli stranieri è molto difficile entrare a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120104,
					"content": "Già, viviamo in tempi senza precedenti. Eppure, considerata tutta la strada che hanno fatto, noi del posto dovremmo dare loro un benvenuto caloroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120105,
					"content": "Sì. Oh, prima che mi dimentichi... ho portato i fuochi d'artificio che avete ordinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120106,
					"content": "Oh, grazie cara. La tua famiglia è così buona con noi, ogni anno. Prima tuo padre, e ora tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120107,
					"content": "Mi chiedo se sarò ancora in vita per vedere chi sarà il nuovo erede della Bottega Naganohara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120108,
					"content": "Certo che sì, siete entrambi in ottima salute! Non dica cose del genere, porta male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120109,
					"content": "*sospira* Però non siamo più giovani come un tempo. Il corpo parla chiaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120110,
					"content": "Un tempo riuscivo a lavorare la terra tutto il giorno, portavo l'acqua avanti e indietro, ma adesso basta un solo attimo di lavoro leggero e sento ogni sorta di dolore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120111,
					"content": "Ieri volevo rimuovere delle erbacce, ma appena mi sono piegata per cominciare ho sentito che se fossi andata oltre, non sarei più riuscita a rialzarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120112,
					"content": "Nessun problema, non dica altro... Ce ne occupiamo noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120113,
					"content": "No, no, no, non possiamo mettervi a lavorare quando siete ospiti in casa nostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120114,
					"content": "Andrò a prendere del tè e qualche spuntino, poi potremo continuare la nostra conversazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120115,
					"content": "Non è un problema, non sarebbe la prima volta che vi aiuto con le faccende. È solo che ultimamente non ho avuto molto tempo, con lo spettacolo pirotecnico che si avvicina... Ma una volta terminato, verrò a farvi visita più spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120116,
					"content": "Non c'è problema, davvero. Non ci dispiace aiutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120117,
					"content": "#*sospira* Che brav{F#e}{M#i} ragazz{F#e}{M#i} che siete... Mio figlio invece è diventato grande ormai, ma non ha ancora trovato una persona speciale, né ci viene a trovare spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120118,
					"content": "Se dite che davvero non è un problema, allora... Ho dei ravanelli sottaceto qui, vi dispiacerebbe consegnarli a Satoru? Si trova nella parte opposta del villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120119,
					"content": "Certamente, ci vorrà un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120120,
					"content": "Gli anziani non si muovono molto, diamogli una mano. Ci <color=#00E1FFFF>sbarazzeremo delle erbacce</color> come prima cosa, poi <color=#00E1FFFF>consegneremo i ravanelli sottaceto</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Satoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "Ehi Satoru, come stai? Te la passi bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120402,
					"content": "Solita vita, non è cambiato molto. Tu sembri piena di vita, come sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120403,
					"content": "Tutto merito del sostegno dei nostri fedeli clienti. L'attività di famiglia va sempre meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120404,
					"content": "Di recente abbiamo venduto dei fuochi d'artificio a Liyue, e a quanto si dice sono stati un successone. Sembra quindi che in futuro riceveremo molti più ordini da lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120405,
					"content": "Però questo significa molto più lavoro per voi, no? Sei sicura che tu e il signor Ryuunosuke sarete in grado di gestirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120406,
					"content": "Se dovesse diventare troppo, non dimenticarti che puoi sempre chiedermi una mano. Ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120407,
					"content": "Dovremmo cavarcela. Credo che riusciremo a gestirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120408,
					"content": "Oh, giusto, ehm, qui ci sono dei ravanelli sottaceto da parte della signora Imatani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120409,
					"content": "Wow, grazie mille! Ci crederesti che un tempo non mi piacevano i ravanelli sottaceto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120410,
					"content": "Poi ne ho provati un po' di quelli fatti in casa dalla signora Imatani e non ne ho potuto più fare a meno. Ormai è un alimento base della famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120411,
					"content": "A proposito di famiglia, come stanno tutti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120412,
					"content": "Bene. Di tanto in tanto abbiamo discussioni accese, ma... come ogni famiglia, suppongo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120413,
					"content": "Essere vicini alla propria famiglia è meglio che non poterla vedere mai, anche se significa dover sopportare qualche conflitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120414,
					"content": "Il signore e la signora Imatani sembrano avere un ottimo rapporto... Eppure devono sentirsi soli, dato che il loro figlio non li va mai a trovare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120415,
					"content": "Ah, a me non sembra. Penso che ci siano abituati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120416,
					"content": "Però hai fatto una buona osservazione. Dovrei passare da loro più spesso, in futuro. Così non si annoieranno troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120417,
					"content": "Sono certo che gli farebbe molto piacere... Così come a tutti noi, qui al Villaggio di Konda. Sei sempre la benvenuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120418,
					"content": "Eheh, grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "Che rapidità! Ah, i giovani sono così pratici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120502,
					"content": "Le persone giovani hanno un mucchio di energia, e quelle anziane hanno un bagaglio di saggezza. Entrambe hanno i propri punti di forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120503,
					"content": "A proposito di gioventù... La sai una cosa? Sono cinquant'anni quest'anno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120504,
					"content": "Oh, è proprio così! Cielo, come vola il tempo... A malapena ti rendi conto dello scorrere del tempo, ma poi, improvvisamente, sono passati cinquant'anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120505,
					"content": "Cinquant'anni da cosa? Un qualche giorno importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120506,
					"content": "Ahah, beh, se proprio vuoi saperlo, è stato cinquant'anni fa, ai tempi in cui questa giovane signorina stava ancora cercando di conquistarmi, che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120507,
					"content": "Oh, smettila di cercare di fare colpo su di loro. Sappiamo entrambi che eri tu quello perdutamente innamorato e che cercava disperatamente di conquistarsi il mio affetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120508,
					"content": "Beh, forse hai ragione. Cinquant'anni fa, ho chiesto la mano a mia moglie allo spettacolo pirotecnico Naganohara. Stiamo insieme da allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120509,
					"content": "Congratulazione a entrambi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "A dire la verità, ero ancora un po' incerto. Non ero sicuro di cosa stessi facendo quando entrai nel negozio dei Naganohara e ordinai i miei fuochi d'artificio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120512,
					"content": "Anche mentre li vedevo salire in alto nel cielo... Neppure in quel momento avevo la minima idea di cosa dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120513,
					"content": "Però poi sono esplosi... il cielo si è illuminato... Mi sono voltato a guardarla e ho visto i suoi occhi che scintillavano alla luce dei fuochi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120514,
					"content": "...A quanto pare, prima ancora di rendermene conto, avevo già pronunciato le parole e, beh, lei ha detto sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120515,
					"content": "Cinquant'anni... Da un lato, è tanto tempo, dall'altro, non lo è affatto. Davvero, non è altro che un numero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120516,
					"content": "Ma cinquant'anni insieme... è certamente qualcosa degno di essere commemorato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120517,
					"content": "Non avevo idea che fosse il vostro 50º anniversario. Se l'avessi saputo, avrei preparato dei fuochi d'artificio davvero speciali, solo per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120518,
					"content": "Oh, no, va bene così. Accendiamo sempre gli stessi fuochi ogni anno. Senza, non sarebbe la stessa cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120519,
					"content": "Vedere quei fuochi d'artificio esplodere ci riporta a quei tempi. Anche a questa età, continuiamo a guardare indietro senza rimpianti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120520,
					"content": "Ah, che legame meraviglioso che hanno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120521,
					"content": "Basta parlare di noi. Yoimiya, non sei indaffarata, ora che lo spettacolo si avvicina? C'era qualcosa di cui volevi parlare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120522,
					"content": "Sì, ehm... È una questione difficile di cui parlare, ma pazienza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120523,
					"content": "Mmmh... Sakujirou... ecco, è tornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120524,
					"content": "Eh? Lo conoscete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120525,
					"content": "Era il miglior amico di nostro figlio, quando erano giovani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120526,
					"content": "*sospira* Erano inseparabili. Sono cresciuti insieme, condividevano qualsiasi cosa e andavano ovunque insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120527,
					"content": "Ma un giorno, hanno avuto un brutto litigio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120528,
					"content": "Sakujirou sembrava pensare che Inazuma fosse troppo tranquilla e voleva vedere come fosse il mondo esterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120529,
					"content": "Ma il nostro Keisuke ha preso da suo padre e da sua madre. Pensava che non ci fosse proprio nulla di male nel rimanere nella tranquillità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120530,
					"content": "Sapete come sono i bambini, se la prendono a morte per questo genere di cose. Alla fine Sakujirou se n'è andato infuriato, ed è finita così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120531,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120532,
					"content": "Keisuke non ha detto nulla a me o mia moglie del litigio. Percepivamo quanto fosse rimasto ferito dalla cosa, ma non voleva parlare con noi di come si sentiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120533,
					"content": "Alla fine, che sia stato per rabbia repressa o per qualche altro motivo, entrò nella Commissione Tenryou. Ormai torna a casa di rado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120534,
					"content": "Se si fosse trattato di qualsiasi altra cosa avrei potuto parlarne con Keisuke, senza dubbio vi avrebbe aiutato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120535,
					"content": "Ma visto che si tratta di Sakujirou... Non credo che ci sia nulla che possiamo fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120536,
					"content": "Che strana coincidenza. Chi l'avrebbe mai pensato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120537,
					"content": "Ora capisco. Quando ho chiesto a Sakujirou perché fosse tornato, ha parlato semplicemente di \"errori del passato\" e non era intenzionato ad approfondire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120538,
					"content": "Ora capisco finalmente perché non riesce a decidersi sul da farsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120539,
					"content": "Due migliori amici d'infanzia... uno finisce nella Commissione Tenryou e l'altro finisce nella lista dei più ricercati della Commissione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120540,
					"content": "Suppongo sia il destino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "Beh, nessun problema, se le cose stanno così, non importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120543,
					"content": "Possiamo trovare un altro modo per aiutare Sakujirou, non c'è bisogno di complicarvi le cose. Mi sembra una faccenda che, Sakujirou e Keisuke, dovrebbero risolvere tra di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120544,
					"content": "Già, sarebbe bello se il loro rapporto tornasse a com'era prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120545,
					"content": "Penso che dopo tutti questi anni, dovrebbero abbandonare i propri rancori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120541,
					"content": "Nemmeno io lo avrei mai immaginato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "Dovreste essere molto fieri di ciò che avete.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
			"completionStepIds": [
				1201206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201206",
							"2"
						],
						"stepId": 1201206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "Yoimiya, è successo qualcosa di brutto! È venuta della gente della Commissione Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120602,
					"content": "Eh? Perché? ...Sanno qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120603,
					"content": "Papà, stai bene? Non ti hanno fatto nulla, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120604,
					"content": "Li ho detto che lo spettacolo sarebbe iniziato a breve e che il posto è pieno di fuochi d'artificio, e che perciò non sarebbero dovuti entrare dato il pericolo d'incendio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120605,
					"content": "Ma non mi hanno ascoltato. Sembrava che sapessero che Sakujirou era lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120606,
					"content": "Per fortuna Sakujirou li ha sentiti arrivare in tempo ed è riuscito a fuggire dalla finestra. La Commissione Tenryou non è riuscita a catturarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120607,
					"content": "Questa è una pessima notizia. Non penso che Sakujirou abbia avuto tempo a sufficienza per decidersi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120608,
					"content": "Papà, hai visto in che direzione è andato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120609,
					"content": "La Commissione Tenryou gli starà di certo alle calcagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120610,
					"content": "Hai sentito qualcuno dei loro nomi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "Ottima osservazione! Nomi, ci servono dei nomi! Farsi vivi così all'improvviso, dev'esserci sicuramente di mezzo Keisuke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120612,
					"content": "Normalmente la Commissione non creerebbe tanto trambusto per un viaggiatore clandestino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120613,
					"content": "Spiacente, le mie orecchie non servono a niente, e non li ho nemmeno visti bene. Se vi state chiedendo in che direzione sono andati, hanno lasciato la città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120614,
					"content": "Vorrei aver sentito i loro nomi... *sospira* Ma non ho sentito nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120615,
					"content": "Si dà il caso che li abbia sentiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120616,
					"content": "Stavo prendendo dei minerali da un amico e mi sono imbattuto in loro per caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120617,
					"content": "Penso che il nome del loro capo fosse Keisuke, proprio come hai detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120618,
					"content": "Proprio come pensavo! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120619,
					"content": "Se Sakujirou non ha ancora preso una decisione e quei due si incontrano, non si risolverà nulla... e peggio ancora, per Sakujirou si tratterà di un punto di non ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120620,
					"content": "#Non possiamo permettere che accada. Vieni con me, {NICKNAME}, rintracciamoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
