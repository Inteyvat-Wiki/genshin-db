			"dialogs": [
				{
					"id": 120120701,
					"content": "#Grazie, car{F#e}{M#i}. *sospira* Mi dispiace farvi fare commissioni per conto nostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120702
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120702,
					"content": "Preparerò del tè e qualcosa da mangiare per quando tornerete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Saburou"
