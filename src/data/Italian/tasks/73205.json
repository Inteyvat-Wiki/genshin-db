			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "Ah, non ho ancora avuto il tempo di cucinare, quindi temo di non avere nulla da offrirvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040702,
					"content": "Non ce n'è bisogno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "Questa piccolina è tua amica, eh? È davvero adorabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040705,
					"content": "Vi andrebbe di venire a vedere i fiori quando sbocciano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040706,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "È probabile che sboccino tra qualche giorno. Tornate più tardi per vedere sbocciare i fiori che avete aiutato a piantare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040708,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "Molto bene, capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040710,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040703,
					"content": "Non preoccuparti, non ho fame.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320501",
							"2"
						],
						"stepId": 7320501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "Forza, venite a vedere questi semi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050102,
					"content": "Sembra che non sia cambiato nulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "Ho piantato colture per diversi anni, ma coltivare fiori è diverso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050104,
					"content": "Perché mai non sono ancora germogliati dopo così tanto tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050105,
					"content": "Mmmh, fai vedere anche a Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050106,
					"content": "Nonno Affan, Paimon pensa che il tuo vivaio sia troppo arido. E forse il terreno del Villaggio di Aaru non contiene abbastanza sostanze nutritive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050107,
					"content": "Abbiamo già aiutato un'altra persona del villaggio a coltivare dei fiori, quindi sappiamo come fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050108,
					"content": "Ah, davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050109,
					"content": "Ha senso: fiori così rari potrebbero essere più delicati di quelli comuni. In effetti, non li innaffio e non li concimo abbastanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050110,
					"content": "Ma questo vivaio è lontano da qualsiasi sorgente d'acqua, quindi non è facile portare l'acqua qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050111,
					"content": "Inoltre, non utilizzo nemmeno una grande quantità d'acqua quotidianamente, quindi per me è piuttosto problematico andare spesso al vivaio per innaffiare i semi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050112,
					"content": "Posso aiutarti io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "D'accordo. In tal caso, potresti prima innaffiare questi tre semi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320503,
			"completionStepIds": [
				7320503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320503",
							"2"
						],
						"stepId": 7320503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "Ottimo, siete davvero molto abili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050302,
					"content": "Ho la sensazione che questa volta cresceranno al meglio, grazie all'aiuto di persone esperte come voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050303,
					"content": "Com'erano lo shawarma e il tahchin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050304,
					"content": "Erano deliziosi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "Deliziosi, eh? Ve li preparerò di nuovo, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050307,
					"content": "Non sono un bravo cuoco come la mia defunta moglie, quindi perdonate se non sono all'altezza. Le porzioni sono più piccole rispetto alla scorsa volta, ma vi prego di accettarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050308,
					"content": "Che bontà! Sei troppo gentile! Verremo a trovarti spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050309,
					"content": "Ahah, non volevate chiedermi che tipo di fiore è questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050310,
					"content": "Beh, immagino di potervelo dire: sto piantando delle rose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050311,
					"content": "Intendi le rose di Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "No, questo tipo di fiore si chiama \"rosa dorata\". È molto più pregiata della rosa di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050313,
					"content": "Vi ricordate quando vi ho detto che una persona a me cara mi aveva dato questi semi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050314,
					"content": "Beh, questi semi e questa vecchia casa in cui vivo appartengono al \"vecchio fantasma\" defunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050315,
					"content": "Oh, dimenticavo... Non siete abitanti del Villaggio di Aaru, quindi è probabile che non sappiate di cosa stia parlando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050316,
					"content": "Non importa. Consideratelo semplicemente un uomo anziano che coltivava fiori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050318,
					"content": "Ehi, nonno Affan, sembra che tu abbia la testa da un'altra parte. Pronto? Prontooo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050319,
					"content": "Oh, ero perso nei miei pensieri. Chiedo scusa, sono diventato vecchio e mi capita sempre più spesso di distrarmi. Che imbarazzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050320,
					"content": "Grazie di nuovo. Se c'è qualcos'altro che vi interessa, potete dare un'occhiata in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050321,
					"content": "Non scaccio più via la gente. Ma fate attenzione a non calpestare il vivaio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050306,
					"content": "Non li ho ancora assaggiati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
		{
			"id": 7320504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
