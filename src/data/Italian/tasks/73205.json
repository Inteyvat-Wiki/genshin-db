			"dialogs": [
				{
					"id": 732050401,
					"content": "Innaffiate prima questi tre semi e poi penserò a cosa fare per quanto riguarda il concime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050402,
					"content": "Dopo aver piantato colture per decenni, so perfettamente come fare del semplice concime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		}
	]
