				"points": []
			},
			"dialogs": [
				{
					"id": 205120101,
					"content": "Questa ricetta sta diventando sempre più strana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120102,
					"content": "Come sta Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "Oh, sei tu. Beh, potrà sembrare strano, ma Anna dice di sentirsi molto meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120104,
					"content": "Forse la ricetta del medico sta funzionando davvero. Io stesso stento a crederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120105,
					"content": "Beh, indipendentemente dal fatto che sia vero o no, è meglio continuare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120106,
					"content": "Questa volta la ricetta dice di... Uhm. Potresti aiutarmi a trovare della \"bava di Melmoso di Hydro\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120107,
					"content": "Questa sembra abbastanza normale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "Mmh, davvero? In realtà, io penso il contrario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120109,
					"content": "Ma almeno sarà facile da trovare. Ho chiesto in giro, e dicono che per ottenere della bava di Melmoso basta sconfiggere i Melmosi giganti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120110,
					"content": "Ho sentito dire da Jack che si possono attirare i Melmosi giganti sconfiggendo ripetutamente quelli più piccoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120111,
					"content": "Io non ho quel tipo di abilità in combattimento, quindi conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120112,
					"content": "Non preoccuparti, questa sembra essere commestibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "E come fai a saperlo? Hai già provato? ...Uhm, perché non dici niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120114,
					"content": "Fa nulla. Dovrebbe essere piuttosto semplice trovare i Melmosi di Hydro. Ho chiesto in giro, e dicono che per ottenere della bava di Melmoso basta sconfiggere i Melmosi giganti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120115,
					"content": "Ho sentito dire da Jack che si possono attirare i Melmosi giganti sconfiggendo ripetutamente quelli più piccoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120116,
					"content": "Io non ho quel tipo di abilità in combattimento, quindi conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120117,
					"content": "So dove trovarne un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "Bene. Sembra che tu sappia il fatto tuo in materia di Melmosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120119,
					"content": "Grazie per aver accettato di aiutarmi. Dovresti poter ottenere della bava di Melmoso sconfiggendo i Melmosi giganti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120120,
					"content": "Ho sentito dire da Jack che si possono attirare i Melmosi giganti sconfiggendo ripetutamente quelli più piccoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120121,
					"content": "Bene, allora. Buona fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
