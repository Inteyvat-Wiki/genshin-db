			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Valerina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "#Gasp! {F#La}{M#Il} Salvagatti e la Sussurratrice dei gatti! Non posso credere che siate {F#venute}{M#venuti} davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470102,
					"content": "Eh? Come ci hai chiamato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470103,
					"content": "Questi soprannomi li ho già sentiti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "#Ehm... Ci siamo già {F#incontrate}{M#incontrati}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470106,
					"content": "Ahah! La Sussurratrice dei gatti si ricorda ancora di me! Sei grande, Valerina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470107,
					"content": "Rimandiamo le chiacchiere a dopo. Per ora, che ne dite di provare il mio nuovo gioco sponsorizzato? Ci sto in fissa da un'intera settimana per quant'è divertente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470108,
					"content": "La Bombarda gagliarda di Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470109,
					"content": "Porca pupazza, quanti Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470110,
					"content": "E sono tutte vecchie conoscenze.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "#Guarda, Salvagatti... Eheh, o forse dovrei dire... raggiante e mirabile {F#Cavaliere Onoraria}{M#Cavaliere Onorario}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470113,
					"content": "Questo pupazzo di Dodoco è stato creato a tua immagine e somiglianza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470114,
					"content": "#È vero! Cavoli, ha perfino le stesse tonalità e le stesse forme geometriche... Hihi, è praticamente identico a te, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470115,
					"content": "In questo gioco, Dodoco Scintilla, Dodoco Sfavillio, Dodoco Cavaliere e Dodoco Stregone devono unire le forze e usare gli esplosivi per far saltare in aria i loro nuovi nemici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470116,
					"content": "Il mio compito è solo gestire il funzionamento e i fondi del gioco, quindi non so granché del processo di sviluppo. Se volete scoprire di più su questi nemici, ne so tanto quanto voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470117,
					"content": "Ma sono sicura che, anche se li incontrassimo nel mondo reale, i fantastici Dodoco li rispedirebbero da dove sono venuti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470118,
					"content": "Ovviamente! Nessun mostro può resistere a Klee e al suo migliore amico Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470119,
					"content": "Beh, allora facciamo una partita di prova!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "Eheh, sono certa che vi divertirete un mondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470120,
					"content": "Un nuovo gioco di Dodoco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "Beh, il prototipo è difficile da non riconoscere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "Mai sentiti nominare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
