				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220101,
					"content": "Oh, Kokomi non è ancora qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220102,
					"content": "Strano, non sembra da lei arrivare in ritardo a un appuntamento... Beh, aspettiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220103,
					"content": "Perché non arriva? Secondo te si è messa nei guai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220104,
					"content": "Andiamo a chiedere a quel soldato laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220701,
					"content": "State cercando Sua Eccellenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Mi spiace, ma al momento non si trova qui. Non so dove si sia recata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Che strano... Allora dovremo ripassare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Non necessariamente. Se ben ricordo, Sua Eccellenza aveva ipotizzato una simile eventualità nelle sue Direttive operative generali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Vediamo... Ah, ecco! La numero 98: <color=#00E1FFFF>\"Se un visitatore da terre lontane mi chiede udienza, qualora la mia posizione sia sconosciuta, indicategli di procedere verso sud fino a un albero con del fogliame violaceo\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "Una nota precisa che ciò si applica unicamente ai casi in cui Sua Eccellenza non comunichi la sua ubicazione prima di andare via e, anche in tali occasioni, a condizione che il visitatore sia una persona estremamente importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Dal mio punto di vista, si applicano entrambe le condizioni. Queste direttive, che porto con me ovunque, sono quindi indubbiamente attinenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi pensa veramente a tutto! D'accordo, andiamo a dare un'occhiata a questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202208",
							"2"
						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220205,
					"content": "Ecco dove sei finita! Oggi dovevamo incontrarci per i preparativi del Banchetto della vittoria, cosa è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220206,
					"content": "Oh... Siete voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220207,
					"content": "Vi-Vi chiedo scusa... Oggi non mi sento in forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220208,
					"content": "*sussulta* Stai male? Corriamo a cercare un dottore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220209,
					"content": "No, nulla del genere... È solo che le mie energie si sono completamente esaurite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220210,
					"content": "Funzioni a base di energia? *sussulta* Come le... Guardie delle rovine??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220211,
					"content": "Era solo un modo di dire. *sospira* Mi vergogno ad ammetterlo ma... voglio mostrarmi sempre incrollabile, eppure talvolta anche io devo arrendermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220212,
					"content": "Tutti hanno preteso troppo da te ieri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "Oh... L'hai notato? Tutto sommato, non sono così abile a nascondere i miei sentimenti. Dovrò migliorare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220215,
					"content": "Sarò sincera, non mi sento portata per il ruolo di leader. Inizialmente, ambivo ad apprendere le strategie militari per diventare consigliera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220216,
					"content": "Comunicare costantemente con la gente mantenendone alto il morale, leggere sempre tra le righe, assicurarmi che tutti ricevano i riconoscimenti che meritano... È un lavoro enorme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220217,
					"content": "Ci si aspetta che la mia sola presenza faccia sentire bene le persone e, allo stesso tempo, incuta un certo timore... Non è qualcosa che mi viene naturale, anzi... Non ho mai desiderato nulla di simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220218,
					"content": "Eppure, il mio lignaggio mi avrebbe comunque costretta a diventare la Sacerdotessa divina, prima o poi. È così e basta. Un destino ineluttabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220219,
					"content": "Quando sento di non farcela più, mi rifugio qui e cerco di rilassarmi leggendo un libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220220,
					"content": "Non temete, ciò non influisce sul mio operato. Ho delegato i preparativi per il Banchetto per la vittoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220221,
					"content": "Terrò un discorso stasera e i soldati non devono minimamente sospettare che qualcosa non vada. Abbiamo lottato per questa pace, e voglio che se la godano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220222
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220222,
					"content": "Possiamo aiutarti in qualche modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220223,
					"content": "Le mie energie dovrebbero tornare a breve, mi basterà riposare ancora un poco. *sospira* Una buona lettura sulle strategie militari sarebbe il massimo per ricaricarmi più velocemente, ne sono certa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220224
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220224,
					"content": "L'ultima volta che sono venuta qui ho portato con me un libro sull'argomento, ma non l'ho letto tutto. Dove sarà finito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220225
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220225,
					"content": "Lo troveremo noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220226,
					"content": "E poi te lo leggeremo, così ti riprenderai rapidamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220227,
					"content": "Lo fareste davvero? Grazie di cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220228
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220228,
					"content": "Eheh... Sono fortunata che abbiate deciso di tornare sull'Isola di Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220213,
					"content": "Sentivo che era ormai troppo per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				}
			]
		},
		{
			"id": 1202203,
			"completionStepIds": [
				1202217
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202217",
							"2"
						],
						"stepId": 1202217,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220301,
					"content": "#Guarda, {NICKNAME}. Forse è questo il libro che voleva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220302,
					"content": "#\"{M#Il capitano}{F#La capitana} della Pesce spada II è tornat{F#a}{M#o} oggi. Energia +4\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220303,
					"content": "Ehm... Non è come... Dunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220304,
						120220305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220304,
					"content": "Non abbiamo visto nulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220306
					]
				},
				{
					"id": 120220306,
					"content": "Date qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220307,
					"content": "Eheheh, mi sa che non era quello che cercavamo... Continuiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
