						120220502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220502,
					"content": "Quindi Kokomi cerca di smistarle perfino mentre si riposa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220503,
					"content": "\"Bilancio introiti degli eventi del clan Sangonomiya\", \"Rapporto annuale comprensivo sulla pesca\", \"Analisi spese di manutenzione mensili sull'Isola di Watatsumi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220504,
					"content": "Una sola persona non può gestire tutto questo, per non parlare di tutte le direttive da scrivere e le riunioni quotidiane. È normale che ogni tanto si sente esausta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220505,
					"content": "Rintracciamo quel libro per regalarle un attimo di serenità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
