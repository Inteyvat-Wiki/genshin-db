			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220401,
					"content": "Kokomi, è questo il libro che cercavi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220402,
					"content": "Mmmh, non ne sono sicura. Potreste leggerne un brano a voce alta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220403,
						120220404
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220403,
					"content": "\"Segui il piano e pianifica la strategia\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				},
				{
					"id": 120220405,
					"content": "*sbadiglia* Sì è questo! Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220406,
					"content": "Kokomi? Kokomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220407,
					"content": "#Oh no, si è addormentata! Che facciamo, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220408,
					"content": "Il Banchetto della vittoria è stasera e le trattative per la pace sono ormai dietro l'angolo! Ha così tante cose da fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220409,
						120220421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220409,
					"content": "Facciamola riposare un poco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220410
					]
				},
				{
					"id": 120220410,
					"content": "Pensi davvero sia una buona idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220411,
					"content": "Uhm, in effetti sembra esausta. Immagino ci sia ancora un po' di tempo... D'accordo, facciamole compagnia mentre riposa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220412,
					"content": "Evita la catastrofe... Proteggi la pace a ogni costo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220413,
					"content": "La guerra è finita... Piano piano si torna alla normalità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220414,
					"content": "Hai visto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220415,
					"content": "Eeeh... Oh no, che ore sono? Mi sono addormentata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220416,
					"content": "Già, hai dormito un sacco! È quasi ora del banchetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220417,
					"content": "È tardissimo! Non posso crederci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220418,
					"content": "*sospira* Non dormivo così bene da molto tempo. Ho recuperato almeno tre punti di energia, dovrebbero bastarmi per tutta la durata delle trattative di pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220419,
					"content": "#Grazie, {NICKNAME}. Beh, immagino sia ora di andare. Tra poco dovremo accendere il falò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220420
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220420,
					"content": "Evvivaaa, Kokomi ha fatto il pieno di energia! Che bello rivederti in forma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220421,
					"content": "Svegliamola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220422
					]
				},
				{
					"id": 120220422,
					"content": "Forse sarebbe meglio. In effetti ha detto di volersi dedicare agli ultimi preparativi prima della festa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220423,
					"content": "Ehilà, Kokomi... Sveglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220424,
					"content": "Mmmh? Mi sono addormentata? Che ore sono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220425
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220425,
					"content": "È ora di andare! Non manca molto al banchetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220426,
					"content": "Davvero? È già così tardi? Non mi sento ancora pienamente ricaricata, purtroppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220427,
					"content": "Ti regalerò un nuovo libro di strategia militare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220428
					]
				},
				{
					"id": 120220428,
					"content": "Sul serio? Che bello! Vorrei l'ultimo volume sull'arte della guerra di Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220429
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220429,
					"content": "La Casa editrice Yae l'ha pubblicato il mese scorso, ma non ho avuto occasione di leggerlo... Ormai non puoi tirarti indietro, eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220430
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220430,
					"content": "Beh, si è decisamente ripresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220431,
					"content": "Coraggio, andiamo alla festa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220404,
					"content": "\"Attacca il nemico quando è debole, colpiscilo dove meno se l'aspetta\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				}
			]
		},
