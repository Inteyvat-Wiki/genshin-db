			"dialogs": [
				{
					"id": 120220701,
					"content": "State cercando Sua Eccellenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Mi spiace, ma al momento non si trova qui. Non so dove si sia recata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Che strano... Allora dovremo ripassare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Non necessariamente. Se ben ricordo, Sua Eccellenza aveva ipotizzato una simile eventualità nelle sue Direttive operative generali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Vediamo... Ah, ecco! La numero 98: <color=#00E1FFFF>\"Se un visitatore da terre lontane mi chiede udienza, qualora la mia posizione sia sconosciuta, indicategli di procedere verso sud fino a un albero con del fogliame violaceo\"</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "Una nota precisa che ciò si applica unicamente ai casi in cui Sua Eccellenza non comunichi la sua ubicazione prima di andare via e, anche in tali occasioni, a condizione che il visitatore sia una persona estremamente importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Dal mio punto di vista, si applicano entrambe le condizioni. Queste direttive, che porto con me ovunque, sono quindi indubbiamente attinenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi pensa veramente a tutto! D'accordo, andiamo a dare un'occhiata a questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
