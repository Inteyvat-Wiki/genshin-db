			"dialogs": [
				{
					"id": 120220601,
					"content": "#Deve essere questo, {NICKNAME}, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220602,
					"content": "C'è perfino un segnalibro, vedi? Nessun altro volume ne ha uno, quindi quelli deve averli già finiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220603,
					"content": "Accidenti, è un mattone... Paimon non ci capisce nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220604
					],
					"speakerTitle": "Paimon"
