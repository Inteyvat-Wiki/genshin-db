			"dialogs": [
				{
					"id": 756710101,
					"content": "Cip cip! Gru gru! Cip cip cip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710102,
					"content": "Ehm... Che stai facendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710103,
					"content": "Stai inviando... una specie di messaggio segreto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "Più o meno! È una tecnica che uso per comunicare con i piccoli e adorabili tordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710106,
					"content": "Oh, a quanto pare mi sono dimenticata di salutarvi. E della formula di presentazione fondamentale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710107,
					"content": "#Gentili {F#viaggiatrici}{M#viaggiatori} di passaggio, io, Basima la Quinta, ricercatrice dell'Amurta, astro nascente del commercio ed esperta di animali adorabili, vi porgo i miei più sentiti saluti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710108,
					"content": "Rilassate il corpo, liberate la mente e ascoltate attentamente, perché ho una questione di estrema importanza da sottoporvi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710109,
					"content": "\"I tordi sono i più carini al mondo\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710110,
					"content": "Esatto! Complimenti, sembra che la dolcezza dei tordi abbia conquistato anche te. Ti sei persino affrettata a rispondere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710111,
					"content": "Che strano. Paimon non sa perché, ma quando ha visto il gioco sul tavolo, le è venuta in mente questa frase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710112,
					"content": "#Anche a te sembra familiare, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710113,
					"content": "Abbiamo già incontrato questa ragazza, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "#Esatto! E non è stato neanche breve, il nostro incontro. Mi scalda il cuore vedervi ancora così {F#piene}{M#pieni} di vita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710117,
					"content": "Comunque, vi piacerebbe provare questo gioco? È la 17ª versione della terza generazione di Tordobiglia Pam Pam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710118,
					"content": "Mentre vi rilassate e vi godete il gioco, potrete ascoltare delle storie meravigliose su come il piccolo tordo e il ben più grande Fringuello piumarossa ancestrale abbiano trionfato sui gabbiani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710119,
					"content": "#Sembra divertente! Siamo sempre {F#state grandissime}{M#stati grandissimi} fan dei giochi rilassanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710120,
					"content": "Giochiamo subito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "Bene! Spero che troviate lo stile di gioco più adatto a voi e che possiate vivere un'esperienza unica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710121,
					"content": "Iniziamo! Dai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "Se vuoi, possiamo iniziare con quel \"i tordi sono i più carini al mondo\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "Perfetto! E anche se ora non riuscite a ricordare il passato, non importa. Ciò che conta è godersi il presente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Basima la Quinta"
				},
				{
					"id": 756710104,
					"content": "O forse stai parlando in una specie di... codice?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
}