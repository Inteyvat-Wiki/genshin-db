			"dialogs": [
				{
					"id": 200011001,
					"content": "#Grazie davvero, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011002
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011002,
					"content": "Il mio piano era di raccogliere un po' di frutta qui e di rivenderla in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011003,
					"content": "Non mi aspettavo di rimanere bloccato... e di essere aggredito da quella banda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011004,
					"content": "Ok, torno a Mondstadt. Passa al negozio se capiti in città!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011005,
					"content": "Prendi queste in segno di riconoscenza. Vedi come sono fresche? Ecco perché Beatrice cerca sempre di comprarle da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
