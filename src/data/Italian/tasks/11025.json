			"dialogs": [
				{
					"id": 110240301,
					"content": "Resterò qui un altro po'. Temo che momenti fitti di ricordi come questo diverranno sempre più rari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240302,
					"content": "Mi sento un po' triste per la Dea del sale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "Al tempo della Guerra degli Archon, non misuravamo il giusto e l'ingiusto allo stesso modo di oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240304,
					"content": "Certo, nel mio stato attuale... Vorrei solo che avesse vissuto in un'epoca più gentile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240305,
					"content": "Queste reliquie non incrementeranno il potere di Osayal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "Sebbene il calice e il regolo del sale posseggano un discreto potere, non sono nulla in confronto a Osayal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240307,
					"content": "Se sorgerà il giorno in cui recupererà le forze e farà ritorno... Ah, credo che verrà sconfitto di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240308,
					"content": "Cosa farai ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "Ottima domanda. In passato, ti avrei dato una risposta più precisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240310,
					"content": "Ma ora... Sì, credo che manterrò il mio ruolo come consulente presso i Servizi Funebri Wangsheng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240311,
					"content": "Ma se questo viaggio è stato di tuo gradimento, perché non vieni con me la prossima volta che cercherò di preservare il passato di Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
}