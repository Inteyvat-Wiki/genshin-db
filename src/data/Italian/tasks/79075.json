			},
			"dialogs": [
				{
					"id": 790750201,
					"content": "Io devo... devo sistemare e trovare un buon posto dove Chauvigne possa prendere il sole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750202,
					"content": "#Lascio a voi il compito di persuadere Chauvigne, {F#care}{M#cari} ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750203,
					"content": "Se mi vedesse, di sicuro penserebbe che sono appiccicoso e si infurierebbe ancora di più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				}
			]
		},
		{
			"id": 7907503,
