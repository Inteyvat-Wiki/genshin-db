			},
			"dialogs": [
				{
					"id": 790750401,
					"content": "Chauvigne! S-Sei qui. Ascoltami, per favore, non sono mai stato arrabbiato con te, e non ho mai voluto abbandonarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750402,
					"content": "Ero solo preoccupato che non volessi più essere mio amico... So che alcuni avventurieri cambiano al ritorno dai loro viaggi, ed ero preoccupato che fosse successo anche a te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750403,
					"content": "Ho pregato la Dea... ma non ho trovato nessun dono da offrirle, quindi ovviamente mi ha ignorato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750404
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750404,
					"content": "No! Panuelle, una cosa del genere non accadrà mai. Io sarò sempre amico tuo. Sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750405,
					"content": "Devo chiederti scusa! Ero così concentrato sui miei pensieri che non ho ascoltato le tue parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750406,
					"content": "Pensavo... che non volessi più vedermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750407,
					"content": "Direi che abbiamo chiarito il malinteso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "Già! Paimon pensava che foste ai ferri corti, così furiosi l'uno con l'altro da non volere nemmeno provare a capirvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750409,
					"content": "È stata decisamente una situazione complicata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "#Grazie a entrambi, {F#care}{M#cari} ospiti. Senza di voi, sarei rimasto intrappolato lì sotto rifiutandomi di uscire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750412,
					"content": "Ora invece posso finalmente condividere con Panuelle ciò che ho nel cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750413,
					"content": "Sarò sempre disposto ad ascoltare tutto quello che hai da dire, Chauvigne. Che tu voglia parlare di avventure o di vasi di fiori... a me va bene tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750414,
					"content": "#Ah, giusto. Ecco, {F#care}{M#cari} ospiti, prendete. Un regalo speciale per voi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750415,
					"content": "Che la Dea vi benedica, che non litighiate mai con i vostri amici e che ci sia sempre qualcuno disposto ad ascoltare i vostri pensieri più intimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750410,
					"content": "Ma per fortuna ora è tutto risolto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				}
			]
		}
	]
