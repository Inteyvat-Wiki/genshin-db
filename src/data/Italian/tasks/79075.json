					}
				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "Fiuuu... Il vento si è fermato, finalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750302,
					"content": "Ascoltaci, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "Va bene, ascolterò quello che avete da dire. Ma prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750305,
					"content": "#Guardate quanto siete {F#scioccate}{M#scioccati}! Di sicuro vi starete chiedendo come fa un fiore a parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750306,
					"content": "O magari come ho fatto a diventare un fiore piantato in un vaso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750307,
					"content": "Di solito la gente ti chiede questo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "Là fuori sì, molte volte. Da quando sono tornato a casa... no, nessuno me l'ha mai chiesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750309,
					"content": "Con \"fuori\", intendi \"nel mondo esterno\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750310,
					"content": "Ho sentito dire che sei diventato così solo dopo essere tornato da un viaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "#Guarda guarda... Siete ben {F#informate}{M#informati}! Immagino che Panuelle vi abbia detto tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750312,
					"content": "È vero. Sono diventato così mentre viaggiavo. Eheh, come direbbe Rozel... Questo è il \"cambiamento\" che ho scelto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750313,
					"content": "Va bene il cambiamento, ma Paimon non capisce... Perché cambiare per diventare un fiore in un vaso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750314,
					"content": "È perché ti piacciono tanto le piante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "No. Volevo solo... trovare il mio \"posto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750317,
					"content": "Ho incontrato molte persone al di fuori di questo mondo. Cuochi, fiorai, insegnanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750318,
					"content": "Quasi tutti erano riusciti a trovare un \"posto\" che li facesse sentire a proprio agio. È così che avevano trovato una stabilità nella propria vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750319,
					"content": "E io, invece? Tutto ciò che avevo potuto fare era stato partire come un venturiere. Non avevo mai pensato di poter trovare un \"posto\" stabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750320,
					"content": "E questo \"vaso\" è il tuo \"posto\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "Esatto. Vedo che sei perspicace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750322,
					"content": "In quanto fiore in vaso, avrò sempre un \"posto\" che mi farà sentire a mio agio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750323,
					"content": "Eppure... *sospira* Se ho già un vaso e un \"posto\" che mi appartiene, perché ho ancora questa voglia di partire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750324,
					"content": "Beh, in fondo, sono un venturiere. Senza viaggiare, che altro posso fare che abbia valore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750325,
					"content": "Non capisco. Più vedo il mondo esterno, meno lo comprendo... Cos'è più importante? \"Avere un posto\" o \"viaggiare verso terre lontane\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750326,
					"content": "Più ci penso, più mi fa male la testa... E quando parlo con Panuelle, evito sempre le sue domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750327,
					"content": "Ho paura di ingannarlo. Se gli piace essere un venturiere, non potrebbe arrivare a odiarlo, dopo avermi visto in questo stato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750328,
					"content": "Lui è mio amico, e lo sarà sempre. Devo essere sincero con lui, e infatti ho risposto a tutte le sue domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750329,
					"content": "Gli ho anche detto... che il motivo per cui sono diventato un fiore è per poter avere un \"posto\" che mi faccia sentire a mio agio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750330,
					"content": "Forse la mia risposta l'ha turbato... O forse non gli piace quello che sono adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750331,
					"content": "Ci stiamo allontanando, ma io, che sono solo una pianta in un vaso, non posso salire da solo lassù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750332,
					"content": "Forse è meglio così. Di sicuro Panuelle non ha voglia di vedermi. Dev'essere arrabbiato con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750333,
					"content": "Ah... Allora è così che stanno le cose! Entrambi pensate che l'altro sia arrabbiato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750334,
					"content": "E che quindi l'uno non voglia vedere l'altro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "Cosa? Vuoi dire che Panuelle non è arrabbiato con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750336,
					"content": "State facendo lo stesso ragionamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "Racconti a Chauvigne tutto quello che pensa Panuelle...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "Santo cielo, come potrei mai pensare una cosa del genere? Non ho mai voluto vederlo arrabbiato, nemmeno per un secondo. Il mio cuore andrebbe in mille pezzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750340,
					"content": "#{F#Care}{M#Cari} ospiti! Devo chiedervi di portarmi di sopra, vi supplico! Devo vederlo subito! Non posso aspettare un minuto di più. No, nemmeno un secondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750341,
					"content": "Sapevo che l'avresti detto, mio amichetto invasato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#Hihi, anche Paimon non vedeva l'ora! Andiamo, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750337,
					"content": "Lui pensa che sia tu a essere arrabbiato con lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750315,
					"content": "È perché sogni di diventare un botanico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750303,
					"content": "Panuelle vorrebbe dirti qualcosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				}
			]
		},
		{
