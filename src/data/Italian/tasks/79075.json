				]
			},
			"dialogs": [
				{
					"id": 790750101,
					"content": "Cosa gli sarà preso, a Chauvigne? *sospira* Non vuole nemmeno parlarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750102
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750102,
					"content": "A proposito di Chauvigne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750103
					]
				},
				{
					"id": 790750103,
					"content": "Ciao. Mi spiace molto, ma... Chauvigne è ancora arrabbiato con me e si rifiuta di uscire e parlarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750104
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750104,
					"content": "*sospira* Ma il vento e la luce del sole non possono raggiungerlo laggiù. E se dovesse appassire? Non saprei che fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750105
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750105,
					"content": "Uhm... Visto che stiamo parlando di un fiore in un vaso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750106,
					"content": "Potremmo raccoglierlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750107
					]
				},
				{
					"id": 790750107,
					"content": "Ci ho provato! Ma finché Chauvigne è arrabbiato, non riesco nemmeno ad avvicinarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750108
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750108,
					"content": "È in preda a una tempesta umorale che è quasi in grado di scaraventarti via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750109
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750109,
					"content": "Un attimo, come può la rabbia scaraventare via qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750110,
						790750111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750110,
					"content": "Era una tempesta umorale bella forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				},
				{
					"id": 790750112,
					"content": "Forse è così arrabbiato con me perché ho rifiutato di partire assieme a lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750113
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750113,
					"content": "#{F#Care}{M#Cari} ospiti, posso chiedervi il favore di controllare come sta Chauvigne? Magari voi riuscirete a farlo ragionare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750114
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750114,
					"content": "Certo, ci proveremo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750115
					]
				},
				{
					"id": 790750115,
					"content": "Esatto! Abbiamo viaggiato in così tanti posti e visto così tante persone che di sicur... ehm, che probabilmente riusciremo a convincerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750116,
					"content": "Fantastico! Lo troverete nella grotta sotto all'isola. Allora precedetemi lì, per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750117
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750117,
					"content": "Io devo... devo sistemare e trovare un buon posto dove Chauvigne possa prendere il sole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750111,
					"content": "Sì, è un bel problema avvicinarsi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				}
			]
		},
