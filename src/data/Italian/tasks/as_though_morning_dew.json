						],
						"stepId": 303201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "#Bentornati, {NICKNAME}, Paimon, Menestrello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320102,
					"content": "Fiuuu! A Paimon sembra di essere tornata da un lungo viaggio... Paimon è davvero esausta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "Non ti piace essere chiamato così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320105,
					"content": "Non mi dispiace, ma stavo pensando che forse dovrei cambiare il mio nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "Non userai più il nome \"Menestrello\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "Dopo aver appreso tutto che il Luminare ha fatto, come posso continuare a usare un nome legato a lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "Non tornerò ai Fatui, e non potrei tornarci nemmeno se lo volessi. Molte persone devono essere state colpite da questo incidente e potrebbero non ricordare chi sia il sesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "Abbandonerai del tutto i Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320110,
					"content": "Chiamiamola una ritirata tattica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "Come dice Sua Eccellenza Minore Kusanali, sembrava tutto inutile, ma non era privo di significato. Almeno ho fatto in modo che molte persone si dimenticassero di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "Ma ciò non significa che il tuo passato è stato cancellato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320114,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "Inoltre, il tuo principale scopo, per cui hai rinunciato a tutto ciò che avevi, non è stato raggiunto. Spero che tu ne sia ben conscio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320116,
					"content": "Cambiare il mondo, cambiare il passato, cambiare il destino delle persone... Non sono certo obiettivi facili da realizzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320117,
					"content": "La risposta che cercavi è la distruzione definitiva... È un'illusione. Anche se il Menestrello non esisterà più, il mondo non ascolterà la tua volontà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320118,
					"content": "...Proprio così. Ahah, ridicolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "Non te ne penti... anche se hai ottenuto così poco in cambio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320120,
					"content": "Anche se non valgo nulla, non c'è nulla al mondo che valga la pena di rimpiangere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "Eccellenza Minore Kusanali, hai lasciato di proposito quelle informazioni nell'Irminsul, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "Sì, e fatto di tutto in modo che tu potessi apprendere quelle informazioni in maniera spontanea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320123,
					"content": "Perché ti sei spinta a tanto? Vuoi che anch'io mi unisca a te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "In tutta onestà, le tue esperienze passate ti hanno reso una risorsa utile per me e Sumeru. Averti dalla mia parte faceva parte del piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320125,
					"content": "Ma prima di questo, volevo dirti la verità sul tuo passato. Se volessi solo usarti, non sarei diversa dal Luminare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320126,
					"content": "...Davvero brillante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "Suppongo che sia una delle mie qualità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320128,
					"content": "Essere utile agli altri è ciò che dà valore. Se accettare i miei peccati mi renderà nuovamente utile, allora che sia così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "Nahida non pensa ciò di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "Giusto, mi ero quasi scordato... voi siete i buoni. Paladini della giustizia e quant'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "Scusa, io vedo le cose da una prospettiva leggermente diversa, ma non la posso certo definire una posizione ferma. Con la tua saggezza, troverai sicuramente degli aiutanti migliori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "Sono contenta che riesci a pensarla in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320133,
					"content": "#{NICKNAME}, in futuro continuerò a ricercare e svelare i segreti nascosti nell'Irminsul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320134,
					"content": "#Compreso l'inizio del viaggio di {F#tuo fratello}{M#tua sorella} registrato nell'Irminsul. Cos'è successo esattamente prima e dopo di quegli eventi? Voglio saperlo anche io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320135,
					"content": "Grazie. Speriamo di trovare delle risposte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "Farò del mio meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320137,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "Sì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "#Perché sei andat{F#a}{M#o} a Inazuma dopo che mi sono tuffato nel torrente di informazioni dell'Irminsul?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "Perché volevo sapere cosa hai cambiato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "...È così che hai saputo che il destino di quelle persone era cambiato, e come.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "A prescindere dalle motivazioni, mi hai fatto un favore e farò di tutto per sdebitarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "...Non l'ho fatto solo per ricevere una ricompensa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "\"Prendere in prestito\" e \"restituire\" sono le uniche vere relazioni tra individui. Prima o poi saremo pari. Non preoccuparti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "Non è vero. I rapporti tra persone non possono essere semplicemente spazzati via o azzerati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320147,
					"content": "Penso che dentro di te ti sia reso conto che le persone comparse nella tua vita non scompaiono come gocce d'acqua che evaporano senza lasciar traccia. Le persone non possono mai essere veramente \"pari\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320148,
					"content": "Ci sono cose che non possono essere salvate o cambiate. È per questo che esistono le emozioni nel mondo umano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320149,
					"content": "Tutto ciò che provi è reale e duraturo, e il vuoto dentro di te non verrà mai colmato del tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320150,
					"content": "Essere umani significa avere dei difetti. Puoi scegliere se vuoi essere umano o no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "Ma gli umani non possono vivere senza un cuore, vero? E comunque, ho rinunciato a diventare umano molto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "Anche senza un cuore puoi capire il dolore, stai solo seppellendo le tue emozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320154,
					"content": "Il passato è ormai immutabile ma puoi lasciartelo alle spalle. Se il tuo futuro sarà lungo abbastanza, un giorno, il tuo passato diverrà solo una piccola parte della tua vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320155,
					"content": "Sembra che tu abbia già pianificato il tuo futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "Spero che tu possa dare una chance a Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "È tutto molto complicato ora, Paimon non sa nemmeno da dove cominciare... In ogni caso, la cosa più importante ora è seguire Nahida, altrimenti tutti i nostri sforzi saranno stati vani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320158,
					"content": "...Suppongo che ti aiuterò da dietro la quinte d'ora in poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "Sono contenta che tu abbia accettato la nostra offerta. Perché non scegli un nuovo nome per festeggiare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320160,
					"content": "Oh, oh, oh! Anche Paimon vuole darti un soprannome bruttissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320161,
					"content": "Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "Perché... a Paimon ancora non piaci tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320163,
					"content": "Umpf. Spero che non ci incontreremo spesso in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "\"Un nome è il primo dono della vita\". Anche se non lo dici ad alta voce, so che questo è ciò che stai pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320165,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#{NICKNAME} e Paimon ti hanno aiutato tanto. Se non riesci a trovare un nome potresti farti dare qualche idea da loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320167,
					"content": "Eh? Vorresti che fossimo noi a decidere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "No, Paimon conia solo soprannomi! Se cerchi un nome serio... devi pensarci tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320144,
					"content": "Non far sembrare che ti stia costringendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
			"completionStepIds": [
				303203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303203",
							"2"
