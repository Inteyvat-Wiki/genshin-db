				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amane",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "Fiuuu. Era ora che facessimo una pausa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320502,
					"content": "Appena ti fermi, la fatica e la fame ti piombano addosso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320503,
					"content": "Riposa, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "Wow! Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320506,
					"content": "Eh? Guarda quel vaso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320507,
					"content": "Cos'ha di speciale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "È possibile che qualcuno l'abbia rotto mentre puliva la stanza? Ma Paimon non ricorda che nessuno sia entrato a rifare la stanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320509,
					"content": "(Quella notte Paimon ha sbattuto contro il tavolo dopo essere stata spaventata da qualcosa che aveva a che fare con il Menestrello e ha rotto il vaso.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "(Ma il Menestrello ha cancellato la propria esistenza. Ha cambiato il mondo... E allora perché questa tazza è ancora rotta...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "#Sembri confus{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320512,
					"content": "Chi va là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "So cosa ti preoccupa. Chiunque reagirebbe così alla vista di una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320514,
					"content": "Eh? Qualcuno ci sta parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320515,
					"content": "Ma purtroppo, il destino di Teyvat non può essere modificato facilmente. C'è una piccola possibilità che una divinità possa farlo, ma per qualcuno che non lo è... difficile a dirsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320516,
					"content": "Quando un animaletto colpisce il tronco di un albero, quest'ultimo può vacillare; ma non subisce uno spostamento. Lo stesso vale per il destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320517,
					"content": "È come per questo vaso che è caduto a terra. Che sia stato un gatto o un uccello a romperlo non cambia il fatto che è ancora rotto, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320518,
					"content": "C-Chi sei!? Come sai tutte queste cose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320519,
					"content": "La storia non può essere cambiata tanto facilmente, il cuore delle persone sì. Ciò che vedi è la realtà, ciò che non vedi è un'illusione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320520,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "La voce è sparita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320522,
					"content": "Chi cavolo era!? Quella voce è comparsa dal nulla è ha cominciato a dire delle cose spaventose! Cosa significa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320523,
					"content": "(Credere ai miei occhi? Significa che... dovrei fidarmi dei miei ricordi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
					]
				},
				{
					"id": 30320524,
					"content": "Ugh. In ogni caso, il vaso rotto è ancora a terra. Meglio chiedere a qualcuno di pulire?",
