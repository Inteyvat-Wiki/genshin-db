			},
			"dialogs": [
				{
					"id": 240070401,
					"content": "Questi sono... dei vestiti laceri? Si sono scoloriti completamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070402,
					"content": "Qualcuno ha già pescato in questa zona? Non c'è neanche l'ombra di un componente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
