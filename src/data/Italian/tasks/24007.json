			"dialogs": [
				{
					"id": 240070501,
					"content": "Fammi vedere... Possiamo usare questo ingranaggio, e se segassimo questo cuscinetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070502,
					"content": "Cosa vuoi fare questa volta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "Sto cercando di realizzare un pupazzo a molla. A dire il vero, ho fatto alcune ricerche sull'argomento in segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070504,
					"content": "Una volta che avrò capito tutto, costruirò un Mekautoma gigante, così papà resterà di stucco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070505,
					"content": "Ho letto un sacco di libri nella sua stanza, e ho preparato dei componenti di base seguendo le istruzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070506,
					"content": "Sono sicura, mi basta continuare a lavorarci e riuscirò a costruire il Mekautoma che voglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070507,
					"content": "Ma queste cose non le riesco a studiare in città, altrimenti lui le scoprirà, e addio sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070508,
					"content": "È così che questo posto è diventato la base di ricerca segreta di Lovi. Quanto a me... Beh, io sono il suo assistente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070509,
					"content": "Bene, assistente, parlare è facile! Cominciamo la nostra ricerca. Oggi dobbiamo realizzare un braccio meccanico mobile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070510,
					"content": "Sissignora! Diamo il via alla nostra ricerca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		}
	]
