			"dialogs": [
				{
					"id": 240070201,
					"content": "Qui c'è solo del cartone marcio... e nessun componente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070202
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070202,
					"content": "Che strano... Proprio ieri ho pescato alcuni ingranaggi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400703,
			"completionStepIds": [
				2400703
