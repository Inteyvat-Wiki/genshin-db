			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 240070301,
					"content": "Ne ho trovato uno! Questo ingranaggio è quasi completo. Da questa parte c'è persino un cuscinetto intero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070302
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070302,
					"content": "Grandioso, possiamo usarli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
