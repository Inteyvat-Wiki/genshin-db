				"points": []
			},
			"dialogs": [
				{
					"id": 240070101,
					"content": "Lovi, hai trovato qualcosa d'interessante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070102,
					"content": "No, in questo posto non c'è proprio niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070103,
					"content": "Cosa state facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "Stiamo cercando un tesoro! Eheh... Ti va di unirti a noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070105,
					"content": "Tesoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "Verut sta esagerando, ignoralo... Stiamo solo cercando dei componenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070107,
					"content": "Beh, i componenti sono un tesoro... Eh? Qui dovrebbero essercene alcuni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070114,
					"content": "Pare che qui non troveremo niente. Vogliamo provare altrove?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070115,
					"content": "Certamente! Esploriamo l'area un po' più avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070116,
					"content": "Verrò con voi due.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "Wow, cominci a sembrare mio fratello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070119,
					"content": "Beh, proseguiamo ancora un po'. Sono piuttosto sicuro che le acque qui attorno siano piene di componenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070117,
					"content": "Non dovreste mettervi a correre in giro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "Dov'è finito Aurèle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "È andato a cercare Monsieur Delerue per fargli delle domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070110,
					"content": "Quanto a noi, dobbiamo fare i bravi... e cercare il tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070111,
					"content": "Eheh, allora... ti va di unirti a noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070112
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070112,
					"content": "Verut sta esagerando, ignoralo... Stiamo solo cercando dei componenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070113,
					"content": "Beh, i componenti sono un tesoro... Eh? Qui dovrebbero essercene alcuni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				}
			]
