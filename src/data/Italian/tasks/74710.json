			"dialogs": [
				{
					"id": 747100101,
					"content": "Eheh... Dei pesciolini ben educati che nuotano avanti e indietro in vasche spaziose e accuratamente disposte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100102,
					"content": "È davvero uno spettacolo meraviglioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100103,
					"content": "Per questo il nostro acquario è così popolare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100104,
					"content": "Se fossero così ben educati anche in mare aperto, le persone potrebbero immergersi e lasciarsi avvolgere più profondamente dalla bellezza del mondo naturale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100105
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100105,
					"content": "Comunque, grazie al vostro aiuto, ho scoperto perché questi pesci erano così agitati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100106,
					"content": "Nel corso degli anni, ci sono stati numerosi naufragi, per non parlare dei numerosi mascalzoni che hanno inquinato il mare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100107,
					"content": "Un'enorme quantità di rifiuti prodotti dall'uomo è finita sul fondo del mare, accumulandosi e distruggendo gli habitat naturali, e portando i pesci a essere sempre più aggressivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100108,
					"content": "A quanto pare, un gruppo di subacquei ha già accettato un incarico per rimuovere i rifiuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100109,
					"content": "Ma sembra che dovrò dare loro una spintarella gentile e chiedere di darsi una mossa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100110,
						747100111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100110,
					"content": "Sembra che ci vorrà del tempo prima di vedere dei risultati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				},
				{
					"id": 747100112,
					"content": "Già. Nel frattempo, continuiamo il nostro lavoro e portiamo qui quanti più pesciolini aggressivi possibili, così potranno rilassarsi e riprendersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100113,
					"content": "Isolare i pazienti dal loro ambiente nocivo è un passo importante sulla strada della guarigione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100114,
					"content": "Capito, lascia fare a noi! Cercheremo con attenzione dei nuovi pazienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100111,
					"content": "Immagino che non sarà un lavoro veloce da completare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				}
			]
		}
	]
