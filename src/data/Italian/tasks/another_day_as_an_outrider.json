				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520101,
					"content": "#Ciao, Paimon e {NICKNAME}! Cosa posso fare per voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520102,
					"content": "Ciao, Amber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520103,
					"content": "Amber, è successa una cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "Amber, conosci un ragazzo del Regno dei Lupi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520105,
					"content": "Chi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520106,
					"content": "Ha detto che avete avuto un incontro acceso come una montagna in fiamme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520107,
					"content": "Di che diamine stai parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520108,
					"content": "Che strano... Ha detto che ti avrebbe aspettato al solito posto. Hai per caso perso la memoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520109,
					"content": "La mia memoria sta benissimo. Tu invece hai mangiato di nuovo dei matsutake magici, vero, Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520110,
					"content": "Non ho idea di cosa tu stia parlando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520111,
					"content": "Matsutake magici... Mi ricordi di che colore sono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520112,
					"content": "Viola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520113,
					"content": "...Paimon potrebbe averne mangiati un paio l'altro giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520114,
					"content": "Ma non è questo il punto! Paimon non è pazza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520115,
					"content": "Davvero non conosci quel ragazzo che vive con i lupi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520116,
					"content": "Non. So. Di. Cosa. Tu. Stia. Parlando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520117,
					"content": "Ma a proposito di lupi, ultimamente sto indagando su un incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520118,
					"content": "In passato, i lupi non osavano mai avventurarsi fuori dal loro regno, ma ora stanno diventando più audaci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520119,
					"content": "Ho sentito dire che hanno attaccato un convoglio di carri vicino alla Valle del Beone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520120,
					"content": "Se hai tempo, potresti venire a controllare la situazione con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520121,
					"content": "D'accordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "Fantastico! Sapevo di poter contare su di te. Andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520122,
					"content": "Diamoci da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "Ehi, Amber, come va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "Ciao... Sembra che abbiate un po' di tempo a disposizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520126,
					"content": "Oh-oh, ecco che arriva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520127,
					"content": "Ultimamente sono stata occupatissima. I doveri di una Vigilante non finiscono mai, quindi... vi va di aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520129,
					"content": "Te l'avevo detto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520130,
					"content": "D'accordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "Ultimamente, i lupi hanno attaccato i carri vicino alla Valle del Beone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520133,
					"content": "Come sapete, i lupi sono pericolosi, ma hanno le loro regole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520134,
					"content": "Normalmente, i lupi di Mondstadt non si avventurano al di fuori delle Montagne di Coronsplendente e del Regno dei Lupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520135,
					"content": "Sì, Paimon ha sentito dire che quelle zone hanno le loro regole speciali, anche se sono selvagge e incontaminate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520136,
					"content": "Esatto. Quindi è molto insolito che i lupi si facciano vedere nella Valle del Beone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520137,
					"content": "A proposito, conosci un ragazzo cresciuto nel Regno dei Lupi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520138,
					"content": "Chi? Non ho mai sentito parlare di una persona del genere a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520139,
					"content": "Ehm... Come?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520140,
					"content": "La \"rossa ragazza che brucia\"... non sei tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520141,
					"content": "\"Ragazza che brucia\"? Di che diamine stai parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520142,
					"content": "In ogni caso, io vado alla Valle del Beone per indagare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520143,
					"content": "Venite con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520131,
					"content": "Qual è il problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
		{
			"id": 45202,
			"completionStepIds": [
				45203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
