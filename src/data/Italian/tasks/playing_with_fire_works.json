				"points": []
			},
			"dialogs": [
				{
					"id": 220490301,
					"content": "#Ah, siete tornat{F#e}{M#i}! Com'erano i fuochi d'artificio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490302,
						220490304
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490302,
					"content": "Meravigliosi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490303
					]
				},
				{
					"id": 220490303,
					"content": "Sono contento che vi siano piaciuti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490306,
					"content": "Beh, ora devo tornare a occuparmi del negozio. Gli affari sono aumentati, di recente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490307
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490307,
					"content": "Chissà perché quella ragazza non è ancora tornata. Mi chiedo dove se ne sia andata a fare i suoi esperimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490304,
					"content": "Avrei voluto che durassero di più...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490305
					]
				},
				{
					"id": 220490305,
					"content": "Oh, ti sono piaciuti davvero tanto, eh? Niente paura. La prossima volta ve ne darò altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490306
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
		}
	]
