			"dialogs": [
				{
					"id": 730750201,
					"content": "#Sembra proprio di rivivere quando Nara Varuna celebrò il Festival di Utsava con gli Aranara... Era da tanto che Aranakula non era così felice, Nara {NICKNAME}. *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750202,
					"content": "I Viparya detestano le lacrime. Il Festival di Utsava è un festival felice. Aranakula suonerà una canzone felice per i Viparya!",
