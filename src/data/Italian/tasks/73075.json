			"dialogs": [
				{
					"id": 730750101,
					"content": "#Nara {NICKNAME} e Paimon, grazie. Ora i Viparya stanno crescendo nei giardini del Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750102,
					"content": "I Viparya qui sono felici. Quindi, anche Arakara è felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750103,
					"content": "#Il Festival di Utsava è finito. Prima che {F#la}{M#il} Nara dorat{F#a}{M#o} lasci il Vanarana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750104,
					"content": "Ottieni un Viparya.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#Ho dato il Viparya felice alla Nara dorat{F#a}{M#o}. Spero che anche Nara {NICKNAME} e Paimon siano felici. Il Viparya non appassisce, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750106,
					"content": "Ricordatevi di parlargli ogni tanto. Meglio suonargli un po' di musica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750107,
					"content": "#La terra e gli Aranara non dimenticheranno. Spero che anche Nara {NICKNAME} e Paimon non dimenticheranno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
