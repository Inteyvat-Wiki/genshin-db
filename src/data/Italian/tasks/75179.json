			"dialogs": [
				{
					"id": 751790701,
					"content": "Ok, quindi è grazie a questi tre che sei riuscita a fuggire, capo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790702,
					"content": "#Ahah, esatto! Avresti dovuto {F#vederla}{M#vederlo}, ha sconfitto quei mostri in un paio di colpi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790703,
					"content": "Hai salvato il nostro capo. Non ho molto per ripagare questo debito, ma prendi questo piccolo regalo come segno di gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790704,
					"content": "Sul serio, Tizlo? Sei sempre stato così tirchio? Questo è tutto quello che hai da dare alle persone che ti hanno salvato la vita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				}
			]
		},
