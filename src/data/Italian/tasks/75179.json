					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7517915",
							"3"
						],
						"stepId": 7517915,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tizlo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751790401,
					"content": "Ehi, tu! Sì, proprio tu! È pericoloso là fuori, entra, veloce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790402,
					"content": "Non hai notato il caos lungo la strada? C'è stata un'eruzione vulcanica e la strada è bloccata dai mostri. Non dovresti proseguire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790403,
					"content": "Ascoltami. Rimani qui e aspetta per un po'. Dopo potrai partire con il resto della carovana. In questo modo, possiamo guardarci le spalle a vicenda. È troppo pericoloso proseguire da soli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790404,
					"content": "Mostri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "Sì, un intero gruppo di Tepetlisauri viola! Sono stati chiaramente corrotti dall'Abisso! Sono devastanti. A dirla tutta, non ho mai visto nessun Tepetlisauro così spaventoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790406,
					"content": "Fidati: hanno mosso la loro coda e hanno distrutto i nostri carretti. Sono più forti dei Tatankasauri. La gente normale non può affrontare avversari di quel tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790407,
					"content": "Dico sul serio, non fare la testa calda attaccandoli. Se li vedi, tieniti alla larga, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790408,
					"content": "Non preoccupatevi, me la caverò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "Tu... *sospira* D'accordo... Comunque, fa' attenzione là fuori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				}
			]
		},
