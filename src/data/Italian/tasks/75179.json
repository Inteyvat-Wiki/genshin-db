						],
						"pointId": 10703
					},
					{
						"sceneId": 3,
						"position": [
							-2892.566,
							257.855,
							9924.833
						],
						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
							257.694,
							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "Ehi, tu, f-fermati! Queste cose sono nostre! Giù le zampe! Ti avverto! T-Ti avviso che potrei partecipare benissimo alle Guerre dei Guardanotte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790102,
					"content": "Se provi a prendere le nostre cose, io... Io te la farò pagare cara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790103,
					"content": "*sospira*... Ma che succede oggi? Prima l'eruzione, poi un Tepetlisauro viola... E ora dei banditi? Che sfortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790104,
					"content": "#Masose, sembra piuttosto forte. Non so se possiamo vincere contro di {F#lei}{M#lui}. E poi, siamo qui solo per guardare la competizione, non per partecipare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790105,
					"content": "#C-Come puoi dire una cosa del genere, Itsaho? Sono le NOSTRE cose! E poi siamo in due contro {F#una}{M#uno}. Magari abbiamo davvero una possibilità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790106,
					"content": "Perché dici \"due\"? Se qualcuno qui viene malmenato, quello sei tu. Non mettermi in mezzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790107,
					"content": "#Ehi, {F#signorina}{M#signore}, non vogliamo più queste cose. Se le vuoi, prendile. Basta che non ci fai del male, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790108,
					"content": "Credo ci sia stato un malinteso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "#Avete capito male! In realtà siamo {F#delle avventuriere}{M#degli avventurieri}, non {F#delle cattive}{M#dei cattivi}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790112,
					"content": "E perché dovrei credervi? Ahia! Perché mi hai colpito, Itsaho?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790113,
					"content": "Se avessero avuto brutte intenzioni, ci avrebbero già malmenato. E perché mai avrebbero dovuto perdere tempo a parlarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790114,
					"content": "A dire la verità, la carovana si è separata non molto tempo fa. Se non è un problema, potreste aiutarci a riferire al nostro capo un messaggio? Ditele che la stiamo aspettando qui. Lo apprezzeremmo davvero molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790115,
					"content": "Potete prendere quello che vi pare dal baule. Consideratelo un segno della nostra gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790116,
					"content": "Ah, niente di difficile. Ci pensiamo noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790109,
					"content": "Mmm, sei proprio intelligente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "#Ehi! Non far sembrare noi {F#le cattive}{M#i cattivi}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
