			"dialogs": [
				{
					"id": 751790201,
					"content": "*ansima*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790202,
					"content": "Va tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "S-Sto bene, sono solo un po' agitato dopo aver corso. Ho bisogno di un momento per riprendere fiato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790204,
					"content": "Meglio riposare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "Sì, grazie per l'interessamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				}
			]
		},
