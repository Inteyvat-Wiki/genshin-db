			"dialogs": [
				{
					"id": 751791101,
					"content": "Che faccio? Che faccio? Al suo ritorno, il capo sicuramente mi picchierà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
						751791106
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791102,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791103
					]
				},
				{
					"id": 751791103,
					"content": "*sospira* È una storia lunga... La carovana stava viaggiando senza problemi quando, all'improvviso, il vulcano ha iniziato a eruttare. Dopodiché dei giganteschi Tepetlisauri viola sono comparsi dal terreno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791104
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791104,
					"content": "Non stavo prestando attenzione e il mio compagno Saurico si è spaventato e mi ha portato lontano dal gruppo. Quando siamo riusciti a tornare indietro, la strada era completamente bloccata e ora non posso riunirmi con gli altri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791105
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791105,
					"content": "Non so neanche come stanno gli altri... E mi sono allontanato senza permesso... Il capo mi ucciderà. È finita. Sono morto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791106,
					"content": "Fossi in te, scapperei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791107
					]
				},
				{
					"id": 751791107,
					"content": "Scappare? No, no, no, è impossibile. Il capo è come il Regno della Notte: è dappertutto in ogni istante. Mi darà la caccia e mi farà tornare indietro a prescindere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791108
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791108,
					"content": "Devo tornare indietro e chiedere scusa, ma... la strada è bloccata. Uff, questa volta sono condannato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				}
			]
		},
