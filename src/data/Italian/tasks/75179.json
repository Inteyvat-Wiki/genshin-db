			"dialogs": [
				{
					"id": 751791301,
					"content": "Ehi, tu! Non è il tuo compito assicurarsi che la carovana sia al sicuro? Perché qualcun altro dovrebbe sistemare al posto tuo? Cos'hai da dire a tua discolpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791302
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751791302,
					"content": "Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791303
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791303,
					"content": "#Smettila di balbettare! Se non ti fossi spaventato e non avessi abbassato la guardia, qualche misero mostro non sarebbe stato un problema per me! Questa volta darai un po' del tuo compenso {F#alla nostra salvatrice}{M#al nostro salvatore} come ringraziamento. Chiaro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
