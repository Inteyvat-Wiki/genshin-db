			"dialogs": [
				{
					"id": 751790901,
					"content": "Oh, no, Itsaho, mancano ancora un sacco di cose dalla lista... A-Aiutami a cercarle, ti prego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790902,
					"content": "*sospira*... Non perdere tempo. Ho già controllato. Si trattava perlopiù di oggetti fragili. Pensi ancora che siano intatti dopo l'eruzione e lo scontro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790903,
					"content": "Risparmia le forze e fai una pausa. Avremo ancora molto da fare, una volta che il capo e gli altri saranno tornati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790904,
					"content": "N-No! B-Beh, se tu non ci vai, ci andrò da solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masose"
				}
			]
		},
