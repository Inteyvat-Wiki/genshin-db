						],
						"pointId": 10984
					}
				]
			},
			"dialogs": [
				{
					"id": 751790301,
					"content": "Certo che per averti salvato la vita, questo piccolo segno di gratitudine sembra un po' misero, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790302,
					"content": "Sì, effettivamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "Ahah, ben detto! Mi piacciono le persone come te, che vanno dritte al punto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790306,
					"content": "Ahem, comunque, ecco un regalo da parte mia. Accettalo e basta! Consideralo un piccolo extra per prendere al tuo piccolo Tepetlisauro qualche stuzzichino. Non c'è bisogno di ringraziarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790307,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "Ok, dobbiamo ancora recuperare tutte le cose che abbiamo perso lungo la strada. Ora andiamo! Alla prossima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790303,
					"content": "No, è più che sufficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "#Tsk, non sei molto {F#diretta}{M#diretto}, eh? Così non è divertente. Prendilo e basta! Altrimenti, se si spargesse la voce, la gente mi etichetterebbe come tirchia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				}
			]
		},
		{
			"id": 7517904,
			"completionStepIds": [
				7517915
			],
			"beginWay": "TALK_BEGIN_MANUAL",
