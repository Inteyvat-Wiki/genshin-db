			"dialogs": [
				{
					"id": 751790601,
					"content": "Fiuu... Che guaio. E pensare che sono stata quasi messa al tappeto da qualche Tepetlisauro... Che rabbia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790602
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790602,
					"content": "Hai frainteso! Sono mostri dell'Abisso! Sono molto più pericolosi dei Tepetlisauri. Pensavi che fossero come i soliti, Paimon non si sorprende che facessi fatica!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790603
					]
				},
				{
					"id": 751790603,
					"content": "Ah, davvero? Ora capisco. Vi devo un favore. Se non fosse stato per voi, sarei stata spacciata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790604
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790604,
					"content": "Datemi un secondo. Devo prima radunare quegli idioti inutili. Quando saranno al sicuro, vi ringrazierò come si deve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790605
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790605,
					"content": "Con il tuo aiuto, le persone della carovana lentamente si riuniscono.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
