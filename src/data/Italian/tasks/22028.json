					"nextDialogs": [
						220280801
					]
				},
				{
					"id": 220280801,
					"content": "Ottimo, facciamolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280802
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280802,
					"content": "Spero che l'Archon mi ascolti anche stavolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280803
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280803,
					"content": "Tornerò domani per vedere se è successo qualcosa di speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280804
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280804,
					"content": "Bene, grazie per avermi fatto compagnia anche stavolta. Ecco a te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280805
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280805,
					"content": "Spero che l'Archon risponda ai miei desideri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
