			"dialogs": [
				{
					"id": 220280901,
					"content": "Beh, il luogo è questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280902
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280902,
					"content": "Tanto tempo fa, qualcuno fece un'offerta a questo santuario con delle pepite di ferro usate per forgiare delle lame, sperando che le sue abilità nelle arti marziali migliorassero velocemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280903
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280903,
					"content": "Tempo dopo, quella persona partecipò a un torneo di arti marziali e sconfisse ogni avversario in tutta facilità! Tutti si complimentarono per le sue eccezionali abilità nelle arti marziali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280904
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280904,
					"content": "Tuttavia, a detta sua, nessuno degli avversari sembrava stare molto bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280905,
						220280906
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280905,
					"content": "Sembra che l'Archon non abbia criteri molto chiari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280907,
					"content": "Comunque sia, tutti pensano che sia stato l'Archon. Per questo credo che otterremo una risposta se esprimiamo un desiderio in questo santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280908
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280908,
					"content": "A parte ciò, cosa dovremmo offrire stavolta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280909
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280909,
					"content": "Proprio come quel tizio, forse potremo ottenere una risposta se offriamo delle pepite di ferro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280910
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280910,
					"content": "Ne ho trovate alcune vicino all'entrata del fabbro. Però, non sembrano molto pregiate, forse è proprio per questo che il fabbro me le ha lasciate senza pensarci due volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280911
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280911,
					"content": "Ho anche raccolto dell'alga fresca qui vicino. Se la cucino e ci aggiungo un po' di zucchero... avrà di certo un sapore delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280912
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280912,
					"content": "È solo che non sono sicuro che l'Archon gradisca questo tipo di piatti piccoli e freddi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280913
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280913,
					"content": "#Tu cosa ne pensi, {F#sorella}{M#fratello}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280906,
					"content": "Stai davvero facendo progressi se sono le altre persone a restare indietro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				}
			]
		},
