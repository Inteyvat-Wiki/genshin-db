						220281201
					]
				},
				{
					"id": 220281201,
					"content": "Ottimo, facciamolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220281202
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220281202,
					"content": "Spero che l'Archon mi ascolti anche stavolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220281203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220281203,
					"content": "Tornerò domani per vedere se è successo qualcosa di speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220281204
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220281204,
					"content": "Bene, grazie per avermi fatto compagnia anche stavolta. Ecco a te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220281205
					],
					"speakerTitle": "Shouta"
				},
				{
