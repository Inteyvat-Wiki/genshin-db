			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "#{F#Sorella}{M#Fratello}! Senti! Senti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280102,
					"content": "Dopo l'offerta che ho fatto al santuario l'ultima volta, il mio desiderio è stato esaudito... almeno in parte! Ma, anche se si trattava solo una piccola parte, dev'essere stata la risposta dell'Archon, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280103,
					"content": "Qual era il tuo desiderio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "Ehm... Il desiderio che ho espresso l'altra volta era che il creatore del manga che sto leggendo diventasse più produttivo. Avere un nuovo capitolo ogni due giorni sarebbe il massimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280105,
					"content": "Alla fine, l'autore ha davvero pubblicato due capitoli in una sola pubblicazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280106,
					"content": "Però... ho sentito dire che si prenderà una pausa ogni tre nuovi numeri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280107,
					"content": "Un equilibrio perfetto, come tutte le cose dovrebbero essere, suppongo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "Mmmh... Comunque, sono certo che l'Archon abbia ascoltato i miei desideri. Ciò significa che il motivo per cui non si sono realizzati è che non ho offerto abbastanza cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280110,
					"content": "Perciò, faremo un'offerta ad altri santuari, oggi! In questo modo, sono certo che i miei desideri verranno realizzati del tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280111,
					"content": "Ho chiesto ai miei genitori e mi hanno detto che ci sono ancora due santuari qui vicino. Uno è nei pressi della Sala da tè Komore, e l'altro è sulla strada per uscire dalla città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280112,
					"content": "#In quale santuario pensi che dovremmo andare prima, {F#sorella}{M#fratello}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280108,
					"content": "Sembra che sarai comunque indietro di un numero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
