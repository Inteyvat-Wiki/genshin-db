					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280501,
					"content": "Ci siamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280502,
					"content": "Ho sentito dire che, tanto, tanto tempo fa, un doushin lasciò qui un'offerta con tante gru di carta, desiderando che tutti gli abitanti di Hanamizaka vivessero in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280503,
					"content": "Poco tempo dopo, scoppiò un incendio e una casa prese fuoco. Tuttavia, quella casa era comunque costruita con materiali scarsi, perciò il fuoco finì per distruggerla velocemente, senza propagarsi oltre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280504,
					"content": "Tutti credono che sia stata la protezione dell'Archon... Eheh, ecco perché ho preparato delle gru di carta e le ho portate con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280505,
					"content": "Ma ora basta chiacchiere! Cosa offriamo stavolta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280506,
					"content": "Magari otterremo una risposta se offrissimo gru di carta, proprio come quel doushin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280507,
					"content": "Ma, dato che questo santuario si trova vicino alla sala da tè, forse sarebbe meglio offrire caramelle Konpeito al matcha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280508,
					"content": "Sì, e le caramelle Konpeito al matcha sono un dolce che mi piace tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280509,
					"content": "#Tu cosa ne pensi, {F#sorella}{M#fratello}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
