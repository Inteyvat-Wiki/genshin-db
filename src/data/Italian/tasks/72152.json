			},
			"dialogs": [
				{
					"id": 721520101,
					"content": "\"...Qui è dove il grande pirata Rinzou conservava il suo tesoro. I ragazzi hanno rimosso gli ultimi bauli...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "Appunti dei Cacciatori di tesori"
				},
				{
					"id": 721520102,
					"content": "\"...Rinzou però era un uomo astuto, e ha lasciato sull'isola simboli speciali di ogni sorta...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "Appunti dei Cacciatori di tesori"
				},
				{
					"id": 721520103,
					"content": "\"...Potrebbe trattarsi di un inganno, o è possibile che ci sia davvero un tesoro. Lo scopriremo solo se andremo a vedere di persona...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "Appunti dei Cacciatori di tesori"
				},
				{
					"id": 721520104,
					"content": "\"...Abbiamo trovato alcuni di quei simboli. Beh, non c'è tempo da perdere. Meglio andare a dissotterrare il bottino di Rinzou!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "Appunti dei Cacciatori di tesori"
				},
				{
					"id": 721520105,
					"content": "Cavoli, è davvero... lungo... Paimon non ha voglia di leggere niente di tutto questo, le interessa solo il passaggio sul tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520106,
					"content": "Aspetta... Un tesoro?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520107,
					"content": "#Forza, viaggiat{F#rice}{M#ore}, c'è un tesoro da scovare! Non possiamo lasciare che i Cacciatori di tesori ci precedano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}