			"dialogs": [
				{
					"id": 230380101,
					"content": "#Oh! Viaggiat{F#rice}{M#ore}! Vieni qui, vorrei chiederti un favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380102,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "Ti ricordi Maruf, il medico del Villaggio di Aaru? L'ultima volta ti aveva mandato da me per ritirare una ricetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380104,
					"content": "Quel povero ragazzo ha preparato una medicina, l'ha assaggiata e poi ha avuto nausea e vomito per giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380105,
					"content": "Ha detto che la ricetta originale non era efficace, quindi ha cercato di \"migliorarla\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380106,
					"content": "Cosa diavolo avrà fatto per ridursi in quel modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380107,
					"content": "*sospira* Deve aver fatto qualcos'altro oltre a cambiare il metodo di cottura e la quantità degli ingredienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380108,
					"content": "Questa non è la prima volta. Maruf non ha ancora imparato la lezione, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380109,
					"content": "Lasciamo stare. Magari si è trovato in difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380110,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti raccogliere per me alcuni ingredienti freschi? Preparerò io stesso una zuppa. Quando sarà pronta, portala pure a Maruf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380111,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "Maruf ha modificato la ricetta per il mal di testa che gli ho dato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380115,
					"content": "Mi servono ancora tre Bacche henné. Puoi portarmele, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380112,
					"content": "Intendi dire che ha già fatto una cosa del genere prima d'ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "No, e non ricordo nemmeno quante volte sia già successo. Per fortuna, non usa spesso ingredienti velenosi, altrimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
