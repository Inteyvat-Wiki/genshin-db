				"objectNames": [
					"Maruf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230381101,
					"content": "Mmmh, non credo che quell'ingrediente avesse niente di strano. Anche il metodo di cottura era corretto. Cosa sarà successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381102
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381102,
					"content": "#V-Viaggiat{F#rice}{M#ore}, cosa ti porta qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381103
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381103,
					"content": "Mi ha mandato Zakariya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381104
					]
				},
				{
					"id": 230381104,
					"content": "Allora avrai senz'altro saputo del pasticcio che ho combinato. Sono così imbarazzato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381105
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381105,
					"content": "Non pensarci, bevi prima la medicina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381106
					]
				},
				{
					"id": 230381106,
					"content": "D-D'accordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381107
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381107,
					"content": "Maruf beve la medicina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230381108
					]
				},
				{
					"id": 230381108,
					"content": "Oooh... Mi sento già molto meglio. Zakariya è davvero un bravissimo medico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381109
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381109,
					"content": "Perché hai modificato la ricetta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381110
					]
				},
				{
					"id": 230381110,
					"content": "Ricordi la medicina che abbiamo preparato insieme la volta scorsa? Non era molto efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381111
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381111,
					"content": "Ho pensato che forse l'avevo cotta nel modo sbagliato o che mi ero dimenticato di aggiungere un ingrediente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381112
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381112,
					"content": "Quindi... ehm... ne ho preparata un'altra porzione basandomi sulla mia esperienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381113
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381113,
					"content": "Per sicurezza, ho preferito prima assaggiarla io stesso e poi... beh, il resto lo sai già.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381114
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381114,
					"content": "Ho appena mandato qualcuno a prendere un po' di medicina dal dottor Zakariya, ma tu l'hai battuto sul tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381115
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381115,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Ora è meglio che mi riposi per un po', poiché dopo dovrò ricominciare a ricevere i pazienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381116
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381116,
					"content": "Sono stato assente per tanto tempo... Ci saranno senz'altro molti abitanti in attesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381117
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381117,
					"content": "*sospira* Sto di nuovo esaurendo le scorte di erbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maruf"
				}
			]
		}
	]
