				"points": []
			},
			"dialogs": [
				{
					"id": 220270301,
					"content": "Cioè, Nanatsuki ha detto che dovrei fare così, no? Ma cosa dovrei offrire, esattamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270302,
					"content": "A proposito di cose che mi piacciono, adoro i dango tricolori. Amo mangiarli così tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270303,
					"content": "Ma sarebbe irrispettoso offrire i dango tricolori? Ho già offerto delle caramelle Konpeito, ma non ho ricevuto risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270304,
					"content": "Ho pure sentito dire che alcune persone mettono dei petali freschi in dei sacchetti e li offrono. Mi sembra più appropriato dei dango...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270305,
					"content": "#Cosa facciamo? Cosa pensi che dovrei offrire, {F#sorella}{M#fratello}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202704,
			"completionStepIds": [
				2202704,
				2202705
