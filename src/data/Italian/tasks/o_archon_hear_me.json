				"points": []
			},
			"dialogs": [
				{
					"id": 220270401,
					"content": "Secondo me, dei dango tricolori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "Davvero? Ok! Ne ho proprio uno qui con me. Me l'ha preparato la mamma, ma non l'ho ancora mangiato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270403,
					"content": "Allora offriamolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270601,
					"content": "Oh, Archon, donami la tua benedizione e avvera i miei desideri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270602,
					"content": "#Grazie per avermi fatto compagnia fino a ora, {F#sorella}{M#fratello}. Prendi, per favore. È per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270603,
					"content": "Domani tornerò a controllare. Spero di ricevere una risposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
