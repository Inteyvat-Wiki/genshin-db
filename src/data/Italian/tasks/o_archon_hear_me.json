			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "Oggetti laccati... Come si fanno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270102,
					"content": "Perché ti servono oggetti laccati?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "#Oh, sei tu, {F#sorella}{M#fratello}. Ora ti spiego. Hai mai sentito parlare di intervento divino in un santuario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270104,
					"content": "Da ciò che ho sentito, se porti offerte preziose al santuario, forse i tuoi desideri si avvereranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270105,
					"content": "Credo che dei bei manufatti laccati siano molto preziosi. Se li portassi come offerte al santuario, di sicuro avrò una risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270106,
					"content": "Tuttavia, non ho i soldi per comprare manufatti laccati. Per questo voglio fabbricarmeli da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270107,
					"content": "Ho sentito che l'Emporio della lacca Yayoi li fa molto bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270108,
					"content": "#Potresti andare a chiedere a Yayoi della lacca, {F#sorella}{M#fratello}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270109,
					"content": "Non c'è problema, andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "#Grazie, {F#sorella}{M#fratello}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270111,
					"content": "Perché non vai tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "Nanatsuki è sempre così seria. Non ho il coraggio di chiederle aiuto personalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270113,
					"content": "#Ma, se ci sarai tu con me, {F#sorella}{M#fratello}, forse le cose andranno meglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202702",
							"2"
						],
						"stepId": 2202702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "Ciao, posso aiutarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270202,
					"content": "Uhm... allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270203,
					"content": "Desiderava della lacca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "Ah, e così vorresti offrire degli oggetti laccati al santuario, e vuoi fabbricartene uno da solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270205,
					"content": "Ti prego, Nanatsuki. Ho un desiderio che vorrei si realizzasse! È per questo che... Non preoccuparti, non dirò a nessuno la tua formula segreta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270206,
					"content": "Il problema non è la formula della vernice. Se vuoi fabbricare dei bellissimi oggetti laccati, la sola vernice non basterà, ti servirà anche un lungo periodo di pratica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270207,
					"content": "E non si tratta solo di tempo, si tratta più di... capitale. Sono la discendente di quarta generazione di una famiglia di artigiani della lacca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270208,
					"content": "Ho persino viaggiato fino a Sumeru per studiare la lacca. Perciò, è impossibile che tu impari tutti i segreti della lacca da un giorno all'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270209,
					"content": "È... è così? Ma non mi viene in mente nient'altro da offrire al santuario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270210,
					"content": "A mio parere, il valore dell'oggetto che offri al tempio non c'entra. L'oggetto che offri dovrebbe rispecchiare i tuoi sentimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270211,
					"content": "Se avrai sentimenti e intenzioni buone, dopo aver offerto i tuoi oggetti preferiti, dovresti poter ottenere una risposta dagli Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270212,
					"content": "Sentimenti e intenzioni buone... Le cose che mi piacciono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270213,
					"content": "Mmmh, credo di aver capito, ma anche di non aver capito. Però grazie comunque, Nanatsuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270214,
					"content": "#Torniamo prima al santuario, {F#sorella}{M#fratello}. Ho ancora bisogno del tuo aiuto per capire che tipo di cose voglio offrire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
