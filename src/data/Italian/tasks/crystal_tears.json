			"dialogs": [
				{
					"id": 3830201,
					"content": "Evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830202,
					"content": "Squadra di protezione di Dvalin, a raccolta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3830203,
					"content": "Mettiamo assieme i nostri cristalli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830204,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830205,
					"content": "Questi cristalli hanno un colore... torbido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830206,
					"content": "Dvalin... Stai soffrendo così tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830207,
					"content": "#Per prima cosa purifichiamo questi cristalli. Dammi una mano, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3830208,
					"content": "È difficile credere che una cosa del genere sia anche solo possibile... finché non la vedi con i tuoi stessi occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3830209,
					"content": "Interessante. È come filtrare del vino: un processo... rinfrescante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3830210,
					"content": "Direi che abbiamo abbastanza lacrime. Ora possiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 38303,
