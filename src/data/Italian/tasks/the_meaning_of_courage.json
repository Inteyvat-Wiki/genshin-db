			"dialogs": [
				{
					"id": 150310101,
					"content": "Il capo Acatl riunisce tutti i membri della tribù per ascoltare il rapporto di Varesa sui funghi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150310102
					]
				},
				{
					"id": 150310102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310103
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310104
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310105,
					"content": "Ok, sul momento sembrava abbastanza normale, ma a risentirlo sembra un po'... ridicolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310106,
					"content": "Questo silenzio la dice lunga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310107
					]
				},
				{
					"id": 150310107,
					"content": "Quindi i funghi nell'orto sono senzienti? Che scoperta incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310108
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310108,
					"content": "Sì, chissà cosa sarebbe successo senza la vostra indagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310109,
					"content": "Grazie per aver indagato e per aver raccolto tutte queste informazioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310110
					],
					"speakerTitle": "Xoctli"
				},
				{
					"id": 150310110,
					"content": "Fiuu, che sollievo... Temevo sembrasse che fossi impazzita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310111
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310111,
					"content": "Ahahah, in effetti sembra inverosimile. Dopotutto, nessuno di noi ha mai parlato con un fungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310112
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310112,
					"content": "Sappiamo che non sei una bugiarda, Varesa. E poi, l'origine dei funghi verdi è sempre stata un mistero per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310113
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310113,
					"content": "Grazie a te, ora sappiamo che dietro potrebbe esserci qualcosa di sinistro. Dovremmo fare la nostra parte per aiutare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310114
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310114,
					"content": "Sì, fatemi sapere se c'è qualcosa che posso fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310115
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310115,
					"content": "Wow, non è stato difficile convincervi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310116,
					"content": "Grazie a tutti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310117
					]
				},
				{
					"id": 150310117,
					"content": "Oh, aspetta, dicevi che i funghi devono essere cucinati ad alte temperature, giusto? Posso farlo subito... Farò in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310118
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310118,
					"content": "Bene, eccomi qui. Ho usato la ghisa, quindi la temperatura dovrebbe andare bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310119
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310119,
					"content": "Wow, che profumo delizioso! All'improvviso Paimon ha di nuovo fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310120,
					"content": "B-Beh, speriamo bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310121,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310122
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310122,
					"content": "Un attimo, è la sua voce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310123,
					"content": "#Ahahah, sembra che vi siate {F#imbattute}{M#imbattuti} nella strada giusta, ma questa temperatura non è minimamente abbastanza a dimostrare la sincerità che esigo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310124
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310124,
					"content": "Pensavate davvero che un comune fornello potesse generare abbastanza calore da ottenere il riconoscimento del Saggio Signore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310125
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310125,
					"content": "Voi umani siete proprio una delusione. Risolvete i miei indovinelli quando vi servo le risposte su un piatto d'argento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310126
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310126,
					"content": "Ma appena finiscono gli indizi... In quella vostra testa non si vede neanche un briciolo di intelligenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310127
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310127,
					"content": "Provate a usare il cervello questa volta, eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310128
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310128,
					"content": "Com'è andata? Avete sentito la voce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310129
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310129,
					"content": "Ugh! Che fungo fastidioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310130,
					"content": "Il Saggio Signore fungino ha detto che la temperatura non è ancora abbastanza alta. Umpf, più che fungino, è il Saggio Signore pignolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310131,
						150310132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310131,
					"content": "Però l'unico modo per capire il suo obiettivo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				},
				{
					"id": 150310133,
					"content": "La temperatura non è abbastanza alta, eh...? Immagino significhi che abbiamo bisogno di una fonte di calore più potente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310134
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310134,
					"content": "Avete sentito? Abbiamo bisogno di oggetti in grado di generare del calore intenso. Andrà bene qualsiasi cosa troviate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310135
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310135,
					"content": "Vedrò cosa posso fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310136
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310136,
					"content": "Ci penso io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310137
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310137,
					"content": "Dovremmo andare a dare un'occhiata anche noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310138
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310138,
					"content": "Assolutamente! Non conosciamo molto bene la zona, però. Hai qualche idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310139,
					"content": "Mmmh... Non particolarmente, ma potremmo controllare vicino al vulcano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310140
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310140,
					"content": "Sputa fuori cose di ogni genere. Forse c'è qualcosa che possiamo usare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310141
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310141,
					"content": "Fantastico, andiamo! Paimon troverà qualcosa di bollente e lo lancerà in faccia a quello stupido di un fungo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310132,
					"content": "È continuare a dargli corda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				}
			]
		},
