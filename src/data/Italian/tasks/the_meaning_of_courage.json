				]
			},
			"dialogs": [
				{
					"id": 150310201,
					"content": "Ehi, lungo questa strada ci dovrebbero essere delle Incarnazioni della lava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310202
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310202,
					"content": "I loro nuclei dovrebbero essere abbastanza caldi. Potrebbero essere proprio quello di cui abbiamo bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310203
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310203,
					"content": "Sapete, a pensare a come tutti si sono precipitati ad aiutarci, sembra proprio che la tribù sospettasse di quei funghi verdi da un po' di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310204,
					"content": "Sì, ma senza di voi non saremmo mai arrivati a tanto. Molte persone hanno mangiato quel fungo senza sentire una voce strana nella testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310205
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310205,
					"content": "Giusto... E anche volendo indagare, non c'era modo di iniziare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310206,
					"content": "Sì, si tratta di un'opportunità più unica che rara! Inoltre, l'arroganza del Saggio Signore fungino ha sicuramente innescato lo spirito competitivo della mia tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310207
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310207,
					"content": "Già, la tua tribù sembra amare le competizioni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310208
					]
				},
				{
					"id": 150310208,
					"content": "Sì, di solito però Varesa non sembra competitiva. Almeno non al di fuori dell'allenamento e del combattimento contro i mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310209,
					"content": "Sì, beh... Non sono una grande fan né delle lotte né delle competizioni. A me importa la semplice felicità quotidiana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310210
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310210,
					"content": "Però ho ancora molto da imparare dall'allenatrice Iansan. Mi ha insegnato che la forza è un mezzo e non un fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310211
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310211,
					"content": "Diventiamo più forti per usare la nostra forza quando serve, come durante l'invasione dell'Abisso. Ho potuto fare qualcosa per fermarla grazie all'addestramento per padroneggiare la mia Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310212
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310212,
					"content": "Quindi, non importa quanto io possa avere paura, so che devo essere coraggiosa, perché c'è chi conta su di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310213,
						150310214
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310213,
					"content": "Sì, si vede.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				},
				{
					"id": 150310215,
					"content": "Grazie. Ci sto lavorando. Posso solo sperare che, un giorno, sarò coraggiosa tanto quanto Fietena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310216
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310216,
					"content": "Andiamo, dovremmo continuare a cercare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310214,
					"content": "C'è un qualche tipo di forza dentro di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				}
			]
		},
