					},
					{
						"sceneId": 3,
						"position": [
							-3047.629,
							233.936,
							9909.162
						],
						"pointId": 10931
					}
				]
			},
			"dialogs": [
				{
					"id": 150310401,
					"content": "Che bel bottino! Un po' di Occhi veggenti e anche questa cosa che la donnola usava per sputare fuoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310402,
					"content": "Credo che fosse la sua armatura posteriore! Può sparare Flogisto, quindi può attaccare praticamente da ogni direzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310403,
					"content": "Mio padre me ne ha parlato, una volta. Sono creature che vivono nel vulcano. Non riesco a credere che ne abbiamo vista una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310404,
					"content": "Il pezzo dell'armatura potrebbe generare una temperatura ancora più alta degli Occhi veggenti. Eheh, questa volta quei funghi diventeranno incandescenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310405,
					"content": "Hai combattuto davvero bene, comunque.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "Oh, beh... Anche se non mi piace combattere, a volte non si ha scelta. Quindi ho cercato di trovare dei modi diversi per entrare in \"modalità di combattimento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310407,
					"content": "Per esempio, ho letto molte storie di eroi. La mia eroina preferita è sempre stata Fietena, quella che ho menzionato prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310408,
					"content": "La caratteristica più nota di Fietena era la sua maschera, così ho deciso di farne una identica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310409,
					"content": "Ora, quando indosso la maschera, è come se avessi un pezzettino di lei con me. Se voglio onorare il suo lascito, non ho altra scelta che essere coraggiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310410,
					"content": "D'altro canto, però... Si potrebbe dire che è come una stampella. Come se mi nascondessi dietro alla sua forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310411,
					"content": "Ah, lo pensi davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310412,
					"content": "Però ti aiuta, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "Davvero? Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310415,
					"content": "Ho l'impressione che... un giorno dovrò togliermela e affrontare le situazioni da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310416,
					"content": "Ma più rimando, più mi sembra impossibile. Io... non so se ne sono in grado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310417,
					"content": "Ma hai deciso tu di indagare sul caso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "Sì, TU hai avuto il coraggio di prendere quella decisione, e andare all'avventura significa questo! Combattere è solo una piccola parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310420,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310421,
					"content": "E poi, Paimon pensa che tu stia facendo un ottimo lavoro! Prenditi tutto il tempo che ti serve, non è una gara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310422,
					"content": "Grazie di credere in me. Ho imparato così tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310423,
					"content": "E non mi arrenderò, non finché non riuscirò ad affrontare le situazioni da sola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310424,
					"content": "Fiuu, dopo tutto questo incoraggiamento, mi è tornata la fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310425,
					"content": "Hai di nuovo fame? Paimon non ha neanche finito di digerire il suo ultimo pasto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310426,
					"content": "Forza, torniamo alla tribù, ora. Questa volta, ci guadagneremo il rispetto del Saggio Signore fungino, ne sono certa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310418,
					"content": "Non la maschera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "Non c'è motivo di vergognarsi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
}