						],
						"pointId": 10929
					}
				]
			},
			"dialogs": [
				{
					"id": 150310301,
					"content": "Ecco fatto! Questo nucleo sembra perfetto. Vedete? Il Flogisto al suo interno è ancora attivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310302,
					"content": "Ooh, fai dare un'occhiata a Paimon! Woah, è bollente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310303,
					"content": "Un altro paio di questi dovrebbero bastare. Forza, continuiamo a salire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
		{
			"id": 1503104,
