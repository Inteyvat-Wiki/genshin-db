			"dialogs": [
				{
					"id": 752500101,
					"content": "I turisti se ne vanno uno dopo l'altro con dei giocattoli in mano, quando alcuni visitatori indesiderati entrano nel Parco degli Alpaca...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "Uh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "I Fatui che ieri mi hanno derubato! Di nuovo voi... Cos'altro volete da me?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500104,
					"content": "Non preoccuparti. Me la vedo io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "No...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "Il capo dei Fatui agita le mani, dopodiché ti consegna un foglietto accartocciato. Lo apri. Al suo interno sono scritte delle frasi sbilenche...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "Allora è questo che stavate facendo ieri... Quando hanno allungato le mani, era per pagare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500113,
					"content": "S-Scusatemi... Ho frainteso completamente le vostre intenzioni... Sono veramente desolato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500114,
					"content": "Questi giocattoli... Prego, prendeteli tutti! Considerateli un segno della mia gratitudine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500115,
					"content": "Il capo dei Fatui scuote la testa e alza tre dita.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "Ho capito... Siete come gli eroi di Natlan. Dei veri esempi di eroismo...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500117,
					"content": "Allora sceglierò tre giocattoli dai colori che più si abbinano a voi. Grazie per la comprensione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
