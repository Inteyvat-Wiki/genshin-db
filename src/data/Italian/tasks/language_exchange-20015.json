				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200150101,
					"content": "#Viaggiat{F#rice}{M#ore}! Qui, da questa parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150102,
					"content": "Non spaventare quegli Hilichurl. Perché corri sempre negli accampamenti degli Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150103,
					"content": "Lascia perdere, non è importante. Da un po' di tempo faccio delle ricerche sull'hilichurliano, ma preferirei iniziare a fare pratica di conversazione, piuttosto che rimanere sempre e solo sui libri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150104,
					"content": "Mi sono finalmente imbattuta in un intero accampamento di Hilichurl... Non posso lasciarmi sfuggire quest'opportunità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150105,
					"content": "#Quindi viaggiat{F#rice}{M#ore}, puoi venire con me al campo e aiutarmi a trovare un Hilichurl con cui far pratica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
			"id": 2001502,
			"completionStepIds": [
				2001503
