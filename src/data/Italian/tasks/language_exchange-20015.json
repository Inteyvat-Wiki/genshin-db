			"dialogs": [
				{
					"id": 200150701,
					"content": "Cosa ne pensi? Il mio hilichurliano non è niente male, eh? Ora che possiamo comunicare, ciò di cui abbiamo bisogno per capirci è il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150702
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150702,
					"content": "Almeno, lo spero. Il mio sogno è diventare amica degli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150703
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150703,
					"content": "Ah, giusto! Prima che mi dimentichi. Tieni. È un regalo dalla parte di quell'Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150704
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150704,
					"content": "Un regalo da un Hilichurl. Scommetto che non avresti mai pensato di vedere una cosa del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150705
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150705,
					"content": "Ok, farei meglio a partire ora, ho così tante nuove scoperte da appuntarmi. Forse avremo la fortuna di incontrarci di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
