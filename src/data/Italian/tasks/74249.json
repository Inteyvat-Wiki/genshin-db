			"dialogs": [
				{
					"id": 742490201,
					"content": "Ahhh! Non mi stancherò mai di questi tè pomeridiani in totale relax.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490202,
					"content": "(Restiamo sedute così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490204,
					"content": "Che disdetta... I momenti lieti passano davvero in un lampo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
