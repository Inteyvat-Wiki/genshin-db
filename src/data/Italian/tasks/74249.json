			"dialogs": [
				{
					"id": 742490101,
					"content": "Mi sento davvero in colpa ad affidarti di nuovo tutto il lavoro, Mademoiselle Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490102,
					"content": "Non c'è problema. È il minimo che possa fare dopo tutto quello che hai fatto durante il Cinefestival di Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490103,
					"content": "Oh, suvvia! Le vere stelle dello spettacolo sono state gli attori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490104,
					"content": "Non conti di tornare a esibirti, Furina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490105
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490105,
					"content": "Beh... Mai dire mai... Ma, ehm, per ora preferisco lavorare dietro le quinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490106,
					"content": "Sai, quando vivevo ancora a Fontaine, persino io sapevo chi fossi tu: Furina, l'amatissima superstar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490107
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490107,
					"content": "Uff, ti prego, no! Non dirmi che \"sei cresciuta guardando le mie esibizioni\" perché mi fai sentire a disagio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490108,
					"content": "Oh, non preoccuparti. Volevo solo dire che, quando ho lasciato Fontaine, ho avuto l'onore di vederti com'eri allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490109
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490109,
					"content": "Ma rivedendoti dopo tutto questo tempo, ammetto di preferire il tuo atteggiamento attuale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490110,
					"content": "Eh...? Il mio atteggiamento attuale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490111,
					"content": "Sì. Prima sul palco sembravi così tesa, ma ultimamente sembri molto più rilassata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490112
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490112,
					"content": "Eheh... Grazie, sei gentile. Confesso che ho iniziato a godermi molto di più la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490113,
					"content": "E tu, Mademoiselle Guillotin? Sei soddisfatta del tuo attuale stile di vita? Rispetto a quando hai lasciato Fontaine, intendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490114,
					"content": "Le cose procedono bene. Grazie soprattutto a un riallineamento del mio stato d'animo, credo. In verità, Fontaine mi è sempre piaciuta e mi sono sempre sentita come a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490115
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490115,
					"content": "Non sto dicendo che sia meglio di altre nazioni, ma ho tantissimi ricordi legati a questo posto. La vita qui può essere calma come acqua cheta, ma anche ricca di novità e cambiamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490116,
					"content": "Di recente ho imparato a vedere il lato più positivo della vita. Suppongo che ognuno veda la propria terra natale più o meno allo stesso modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490117
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742490117,
					"content": "Caspita... Che belle parole, Mademoiselle Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490118
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490118,
					"content": "Questo potrebbe essere una leggera violazione del galateo dei ricevimenti, ma... Propongo un brindisi. A Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490119
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490119,
					"content": "Ahah... Alla nostra patria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
