			},
			"dialogs": [
				{
					"id": 750490401,
					"content": "Cosa? Ah... Non avrei mai pensato che avresti trovato l'entrata! È passato molto tempo dall'ultima volta che qualcuno è venuto qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "Spirito dell'Anima della Notte"
				},
				{
					"id": 750490402,
					"content": "Questo posto... Mmm, sì, qui è dove vagano le Anime della Notte, sebbene io tema che nessuno ne ricordi nomi o gesta là dove il sole splende ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "Spirito dell'Anima della Notte"
				},
				{
					"id": 750490403,
					"content": "Ah, le Anime della Notte... Mentre la nostra padrona dorme, noi siamo i suoi sogni. Quando la nostra dea si risveglierà per sempre, non saremo che un prodotto della sua mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "Spirito dell'Anima della Notte"
				},
				{
					"id": 750490404,
					"content": "#Che un vivente mettesse piede qui... Ahah, coloro che sono sopraffatti dal desiderio di combattere non possono più trattenersi, ma tu, {F#guerriera forestiera}{M#guerriero forestiero}, sei {F#stata benedetta}{M#stato benedetto}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "Spirito dell'Anima della Notte"
				},
				{
					"id": 750490405,
					"content": "#Placa queste anime inquiete con l'ardore della battaglia e del trionfo, e verrai {F#ricompensata}{M#ricompensato}... Cosa ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Spirito dell'Anima della Notte"
				}
			]
		},
