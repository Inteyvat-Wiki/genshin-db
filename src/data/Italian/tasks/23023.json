			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan",
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "Fiuu... La terra è abbastanza umida, per adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230602,
					"content": "#Grazie mille, viaggiat{F#rice}{M#ore}! Se non fosse stato per te, saremmo sfiniti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230603,
					"content": "Strano... Questa volta c'è voluta tanta acqua per permeare a fondo la terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230604,
					"content": "Mi è parso di averne usata il doppio del solito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230605,
					"content": "Non può essere. Forse sei solo troppo stanco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230606,
					"content": "Se avessimo davvero raddoppiato la quantità d'acqua, la terra sarebbe zuppa. Ma i livelli di umidità sembrano normali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230607,
					"content": "Suppongo di sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230608,
					"content": "Beh, spero che le rose crescano bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "Non preoccuparti. Ce ne prenderemo cura, per il bene dei pazienti e dei dottori del Bimarstan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230610,
					"content": "#Viaggiat{F#rice}{M#ore}, accetta questa ricompensa in segno di ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230611,
					"content": "Eppure, mi sembra davvero di aver usato molta più acqua del solito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
