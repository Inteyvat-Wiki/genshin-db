			"dialogs": [
				{
					"id": 230230201,
					"content": "Abbiamo bisogno di molto fertilizzante speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230202
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230202,
					"content": "Abbiamo delle riserve di altri ingredienti per questo tipo di fertilizzante speciale, ma abbiamo terminato il frutto di Harra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230203,
					"content": "#Viaggiat{F#rice}{M#ore}, possiamo disturbarti per chiederti di raccoglierci dei frutti di Harra?",
					"roleType": "TALK_ROLE_NPC",
