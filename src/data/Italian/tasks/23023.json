			"trigger": {
				"objectNames": [
					"Gurgen",
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "Non possiamo andare avanti così, papà. Le rose non stanno crescendo bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230102,
					"content": "Dobbiamo trovare una soluzione rapida, altrimenti quest'anno non riusciremo a consegnare tutte le erbe per tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230103,
					"content": "La terra è buona. Abbiamo eliminato le erbacce e i parassiti. Quindi qual è il problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230104,
					"content": "Cosa ti preoccupa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "Oh? Sei qui per comprare delle erbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230106,
					"content": "Beh, spediamo partite di erbe al Bimarstan a intervalli regolari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230107,
					"content": "L'erba più importante di tutte è la speciale \"rosa di Sumeru\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230108,
					"content": "Le rose si possono usare come medicinali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "È una domanda che dovresti fare ai dottori del Bimarstan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230110,
					"content": "Dicono che la rosa possa essere usata in combinazione con altri farmaci per curare i colpi di calore e lenire il mal di stomaco, e che abbia anche altri benefici... Ma al momento non ne ricordo nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230111,
					"content": "In tal caso, darò una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "Te ne saremmo molto grati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230113,
					"content": "Cos'ha che non va questa rosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "Per qualche motivo, la sua crescita è estremamente lenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230115,
					"content": "Sulla base della nostra esperienza, potrebbe esserci un problema con la terra o con dei parassiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230116,
					"content": "Ma abbiamo piantato altre erbe usando la stessa terra e sono cresciute benissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230117,
					"content": "E ogni giorno verifichiamo l'eventuale presenza di parassiti, quindi non può essere quello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230118,
					"content": "Non è il momento di fissarsi con delle ipotesi. Se continuiamo a temporeggiare, non riusciremo a consegnare le rose al Bimarstan in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230119,
					"content": "Al momento il nostro piano è quello di concimare la terra con un fertilizzante speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230120,
					"content": "Ma dobbiamo anche occuparci di altri campi, quindi non abbiamo il tempo di raccogliere i materiali per il fertilizzante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230121,
					"content": "#Viaggiat{F#rice}{M#ore}, per il bene dei pazienti al Bimarstan, potresti farci questo favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230122,
					"content": "Lo farò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "Te ne saremmo molto grati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230124,
					"content": "Vediamo. La nostra situazione attuale è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
