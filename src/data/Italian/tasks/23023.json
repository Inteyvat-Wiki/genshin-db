			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "#Andranno bene. Grazie davvero, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230302,
					"content": "Con questo concime speciale, la fertilità della terra non sarà un problema e le rose di certo cresceranno bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230303,
					"content": "Speriamo che funzioni davvero, non come l'altra volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230304,
					"content": "Avete già provato a usare del fertilizzante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "Ne abbiamo usato uno normale, ma non ha funzionato bene... Anzi, non ha funzionato affatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230306,
					"content": "Ma negli altri campi è stato perfetto. Sinceramente, mi chiedo cosa stia succedendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230307,
					"content": "Beh, non c'è bisogno di trattenerti oltre. Accetta questa ricompensa in segno di ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
