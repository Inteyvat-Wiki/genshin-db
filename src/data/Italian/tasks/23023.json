				"points": []
			},
			"dialogs": [
				{
					"id": 230230401,
					"content": "A parte la fertilità del suolo, forse anche l'acqua potrebbe essere un problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230402,
					"content": "Forse abbiamo piantato la rosa troppo in profondità e non le è arrivata abbastanza acqua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230403,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti aiutarci a innaffiare le rose, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302306,
			"completionStepIds": [
				2302306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
