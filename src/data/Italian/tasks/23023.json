					"content": "#Viaggiat{F#rice}{M#ore}, per favore, aiutaci a innaffiare le rose nelle vicinanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230702
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230702,
					"content": "Con acqua a sufficienza, le rose ricominceranno di certo a crescere!",
