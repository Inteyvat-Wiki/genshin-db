				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "*singhiozza* I miei preziosi fiori... Sono stati rovinati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490202,
					"content": "Nooo, che peccato... Quindi i tuoi fiori non sono cresciuti per colpa dei danni del Primoplastus della Faglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490203,
					"content": "Io... rimarrò qui a fare la guardia ai fiori, da adesso in poi! Non mi allontanerò più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490204,
					"content": "Aspetta, calmati un secondo, Cosanzeana. Pensiamo insieme a un'altra soluzione. Prima di tutto, perché mai quel Primoplastus della Faglia avrebbe rovinato il tuo giardino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490205,
					"content": "In precedenza, quando avevi portato i fiori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "No, mai! Umpf, quello lì osa fare una cosa del genere solo alle mie spalle. Ooh, ora sono furiosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490208,
					"content": "Wow, uh, Paimon non si aspettava che anche Cosanzeana si arrabbiasse. A quanto pare, ci teneva molto a quei fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490209,
					"content": "Ma a ripensarci un attimo, i Primoplasti non sono fuggiti quando lei si è avvicinata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490210,
					"content": "Forse non sono i fiori ad attrarli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "È possibile. Controlliamo l'area attorno al giardino e vediamo cosa riusciamo a trovare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490206,
					"content": "Un Primoplastus della Faglia ti ha dato la caccia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
			"completionStepIds": [
				7404908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
