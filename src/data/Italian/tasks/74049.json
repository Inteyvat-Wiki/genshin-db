			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#Fantastico, {NICKNAME}! Hai ridotto quella brutta macchinaccia in bellissimi componenti. Ha fatto \"kaboom\", così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490302,
					"content": "Ora non creeranno più scompiglio in questo giardino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "Alcuni fiori sono stati danneggiati, ma il resto sembra ancora a posto. I Primoplasti della Faglia non dovrebbero tornare più a danneggiare il tuo giardino, i tuoi fiori ora possono crescere sani e forti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490304,
					"content": "Fantastico... Ma ho imparato la lezione. Dei fiori così preziosi richiedono un'attenta cura e una protezione scrupolosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME}, Paimon: mi avete portato dei fiori così esotici, e mi avete aiutata a difendere il mio giardino. Come potrò mai ripagarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490306,
					"content": "Non c'è bisogno di essere così gentili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490307,
					"content": "Ah, sì, lo so! Ho scelto io stessa questi fiori... Sono molto preziosi per me! Posso darveli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490308,
					"content": "#Eh? Ehm, se questi fiori sono veramente così preziosi, allora dovresti farti un giardino tutto tuo dove piantarli, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490309,
					"content": "A proposito, queste qui non sono Alghemarea? Contano veramente come fiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490310,
					"content": "Le Alghemarea sono piante bellissime, quindi certo che sono fiori. Questo è ciò che gli umani chiamano \"biologia\". Ho trascorso molto tempo a studiarli per poter diventare una grande fiorista. Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490311,
					"content": "Paimon sente che c'è qualcosa di strano, ma non è che Paimon ne sappia tanto di classificazione delle piante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490312,
					"content": "Continuerò a lavorare sodo per raggiungere il mio obiettivo. Gli umani dicono che i bravi fioristi sono capaci di creare nuove specie di fiori che poi portano alle fiere florovivaistiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490313,
					"content": "Voglio farlo anch'io. E voglio vincere dei premi quando ci andrò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490314,
					"content": "È molto lodevole, ma Paimon ha la sensazione che ci siano ancora dei malintesi difficili da spiegare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490315,
					"content": "Lei vuole prendere parte a una fiera florovivaistica per esibire le sue nuove varietà di piante affinché gli umani possano apprezzarle, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490316,
					"content": "Il fatto è che... il suo senso estetico potrebbe essere un po' troppo diverso da quello degli umani. Pensi che le sue nuove specie possano risultare... strane ai loro occhi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490317,
					"content": "Vedo che la sua carriera florovivaistica ti coinvolge molto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "Ovvio! Paimon è la sua maestra, sai? Se lei vince, anche Paimon ne avrà i meriti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490319,
					"content": "Non c'è bisogno di essere ossessionati con i premi. La cosa più importante è essere soddisfatti del proprio lavoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "È vero. L'unica persona che deve trovare belli i fiori che coltivi sei tu. non ti preoccupare di quello che pensano gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490321,
					"content": "Tu occupati semplicemente del tuo giardino, guarda crescere i tuoi bellissimi fiori e sii felice ogni giorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490322,
					"content": "Sì! Farò in modo che crescano sani e forti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490323,
					"content": "Hai fatto il primo passo verso il successo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "È vero. Le varietà che coltiverai probabilmente saranno uniche, ma ci sarà qualcuno a cui piaceranno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490325,
					"content": "Quando avrai creato una nuova varietà, faccelo sapere, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490326,
					"content": "Ma certo! Mi avete aiutata così tanto, dopotutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
