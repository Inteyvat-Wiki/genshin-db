			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#Ah, {NICKNAME}. Non mi aspettavo di vederti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200402,
					"content": "Ne è passato di tempo, Eula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "Sì, una pattuglia di servizio. Ma per quanto mi riguarda, è un'attività necessaria che mi mantiene in forma per combattere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200405,
					"content": "Mondstadt è stata relativamente pacifica di recente, e non ci sono state particolari minacce degne di mobilitare la compagnia di ricognizione. Di conseguenza, tutti si sono un po' ammorbiditi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200406,
					"content": "L'equilibrio tra vita e lavoro è una buona cosa, sai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "Non hai torto, ma in quanto capo squadra, devo mantenere la mia forza di combattimento sempre al massimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200408,
					"content": "Dopotutto, le spade dei nostri nemici non si smussano con la pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200409,
					"content": "Pertanto, sono abituata a trovare luoghi tranquilli per praticare la scherma tra una pattuglia e l'altra, per assicurarmi di non arrugginirmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200410,
					"content": "In tal caso, l'ora è giunta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "Mmm? Che richiesta interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200413,
					"content": "#Ciononostante, io mi muovo velocemente. Sei {F#sicura}{M#sicuro} che la tua Fotokamera riuscirà a tenere il passo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200414,
					"content": "Non c'è bisogno di cambiare nulla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "Quanta sicurezza... mi piace. In tal caso, darò il massimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200417,
					"content": "Osserva attentamente. Le onde salgono e scendono in un istante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200415,
					"content": "Ti terrò nell'inquadratura, nessun problema!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "Lascia che ti scatti una foto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "Sei in servizio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
