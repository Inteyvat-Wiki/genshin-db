			},
			"dialogs": [
				{
					"id": 4510601,
					"content": "Ahah! Te l'avevo detto che ce l'avremmo fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510602,
					"content": "Io... Grazie, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510603,
					"content": "Lupi prende cinque o sei ogni caccia... *sospira* Stanotte, resta con fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510604,
					"content": "Oh-oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510605,
					"content": "No paura. Voi provato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510606,
					"content": "Almeno fa meglio di altra amica cavaliere... Quella rossa ragazza che brucia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510607,
					"content": "Se lei qui, tutta montagna brucia. Non può prendere nemmeno un cinghiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510608,
					"content": "Ora deve andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510609,
					"content": "Qui no sicuro. Fai attenzione! Guarda sempre intorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510610,
					"content": "Che tipo strambo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510611,
					"content": "\"Ragazza che brucia\"? Dei Cavalieri di Favonius? Ma che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}, chi pensi che sia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
