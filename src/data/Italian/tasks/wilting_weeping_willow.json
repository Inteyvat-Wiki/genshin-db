			"dialogs": [
				{
					"id": 740830201,
					"content": "Sull'altare appare una perla d'acqua luccicante.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740830202
					]
				},
				{
					"id": 740830202,
					"content": "Fantastico! Ora abbiamo anche la terza chiave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830203,
					"content": "Chiave, chiave, chiave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830204
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830204,
					"content": "Scomparsa, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830205
					]
				},
				{
					"id": 740830205,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Chiave, chiave, chiave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830206,
					"content": "Piazza, ovest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830207,
					"content": "Eheh. È quello che stai cercando di dire, vero? Non preoccuparti, ci andiamo subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
