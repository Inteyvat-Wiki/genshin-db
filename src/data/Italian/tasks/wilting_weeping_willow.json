			"dialogs": [
				{
					"id": 740831001,
					"content": "Un'altra chiave nelle nostre tasche. Ora non ci rimane che trovare l'ultima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831002,
					"content": "Chiave, chiave, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831003,
					"content": "Ah, Pahsiv! Da dove salti fuori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831004,
					"content": "Scomparsa, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831005,
					"content": "Ah... Paimon non ha mai incontrato una Melusina come te... Pensavamo che tutte le Melusine vivessero nella Corte di Fontaine o nel Villaggio di Merusea. Come mai sei qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831006,
					"content": "Corte di Fontaine? Villaggio di Merusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831007,
					"content": "Sembri confusa. Non hai mai sentito parlare di questi posti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831008,
					"content": "Corte di Fontaine, Melusina... Villaggio di Merusea, Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831009,
					"content": "Ah... Érinnyes, Pahsiv, casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831010,
					"content": "Érinnyes... Pahsiv, proteggere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831011,
					"content": "Aspetta, vuoi dire che questa è la tua casa? E che la stai proteggendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831013,
					"content": "Ma le Melusine non vivono nel Villaggio di Merusea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831014
					]
				},
				{
					"id": 740831014,
					"content": "Sì, è un po' strano. Ci sono Melusine che nascono in altri posti? Paimon, però, non ne vede altre qui in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831015,
					"content": "Pahsiv, vivi qui da sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831016,
					"content": "Sola? Melusina. Niuvilett! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831017,
					"content": "Visitatore? C'è una persona che ti fa visita? Chi è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831018,
					"content": "#Quel... visitatore! Paimon, Paimon, {NICKNAME}, {NICKNAME}. Niuvilett, Niuvilett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831019,
					"content": "Chi è esattamente questo Niuvilett?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831020
					]
				},
				{
					"id": 740831020,
					"content": "Pahsiv... stai cercando di dirci che si chiama \"Niuvilett\", come Paimon si chiama Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831022,
					"content": "Ah-ah! Paimon aveva ragione. Paimon l'ha sempre detto di essere intelligente, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831023,
						740831024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831023,
					"content": "È un nome molto strano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				},
				{
					"id": 740831025,
					"content": "Niuvilett, Pahsiv, conoscenza, bum, sbam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831026,
					"content": "Ehm... Vuoi dire che questo Niuvilett ti sta insegnando delle cose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831027,
					"content": "Pahsiv! Tante parole. Sapere. Tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831028,
					"content": "Ehm, Paimon non crede che siano proprio \"tante\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831029,
					"content": "Pahsiv, Niuvilett, proteggere, bum, sbam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831030,
					"content": "E ti aiuta a proteggere questo posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831031,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831032,
					"content": "Sei tu che lo aiuti a proteggere questo posto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831033
					]
				},
				{
					"id": 740831033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831034,
					"content": "Quindi è così... Ma chi è questo Niuvilett? E come mai ha bisogno del tuo aiuto per proteggere questo posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831035,
					"content": "Anche qui sono successe delle cose brutte. Abbiamo visto che qualcuno ha cancellato l'iscrizione sulla stele di pietra, e c'è anche un sacco di sporcizia... Ci sono dei nemici qui intorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831036,
					"content": "Paimon curiosa, Pahsiv! Ma tempo non tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831037,
					"content": "Chiave, chiave, chiave, piazza, ovest, bum, sbam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831038,
					"content": "#Saremo velocissim{F#e}{M#i}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831039
					]
				},
				{
					"id": 740831039,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv fa due salti di gioia e se ne va in tutta fretta.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740831041,
					"content": "Pare che ci rimanga davvero poco tempo, ma almeno abbiamo già due chiavi. Andiamo avanti e troviamo la terza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831024,
					"content": "È un nome fantastico.",
					"roleType": "TALK_ROLE_PLAYER",
