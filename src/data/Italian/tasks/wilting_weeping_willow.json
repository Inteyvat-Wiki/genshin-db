			"dialogs": [
				{
					"id": 740820701,
					"content": "Sull'altare appare una perla d'acqua luccicante.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "Ah, quella goccia d'acqua... Non è quello il tesoro, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830103,
					"content": "Non ha l'aspetto di un tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "Proprio quello che pensava Paimon. Non può essere così facile. Ma allora cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830105,
					"content": "Forse è la chiave per tenere prigioniero il Re demone.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "Forse l'ha messa qui qualcuno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "Cosa? Ma sarebbe una catastrofe! Presto, rimettila a posto. Paimon spera che non sia troppo tardi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830107,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830108,
					"content": "Oh, no! È il Re demone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830109,
					"content": "Re demone? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830111,
					"content": "#Cosa? Oh no, allora questo ci rende {F#delle}{M#dei} ladr{F#e}{M#i}. Oh, Paimon è dispiaciuta... Presto, rimettiamola a posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830112,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830113,
					"content": "Oh no! È tornato il padrone di casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830114,
					"content": "Padrone di casa? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830115,
					"content": "Fiuuu... Hai fatto venire a Paimon uno spavento... Una Melusina, eh? Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830116,
					"content": "Chiave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830117,
					"content": "Chiave? Quale chiave? Questa goccia d'acqua è una chiave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830118,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830119,
					"content": "Ehm... Questa goccia d'acqua sarebbe Pahsiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830120,
					"content": "Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830121,
					"content": "Ehm, cosa vuoi dire? Che questa goccia d'acqua sarebbe una Melusina? A Paimon comincia a girare la testa. Cosa cavoletti sta succedendo? Ma non sei tu la Melusina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830122,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830123,
					"content": "Ehm... Sei una Pahsiv...? Oppure, ti chiami Pahsiv? No, no, aspetta... Non rispondere, altrimenti Paimon starà ancora peggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830124,
					"content": "In ogni caso, Paimon ha deciso che ti chiamerà Pahsiv. Va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830125,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME}... Cosa facciamo? Paimon non capisce nulla di ciò che dice. Cosa starà cercando di comunicarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830127,
					"content": "Riesci a capire quello che diciamo, non è vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830129,
					"content": "Questa goccia d'acqua è una chiave, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830131,
					"content": "Non sei un essere umano, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830133,
					"content": "Ehm... Moderiamo le parole, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830134,
					"content": "Non sono un essere umano, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "M-Melusina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830136,
					"content": "Ah! Aspetta! Paimon crede di avere capito. \"Pahsiv\" vuole dire \"sì\" e \"Melusina\" \"no\". Può essere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830137,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830138,
					"content": "Allora non ti chiami Pahsiv. Scusa, ma Paimon prima non ha capito il tuo nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830139,
					"content": "Pahsiv... piace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830140,
					"content": "Ti piace questo nome?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830142,
					"content": "#Meraviglioso! Allora è così che ti chiamerà Paimon, eheh. Quest{F#a}{M#o} è {NICKNAME}. È un piacere conoscerti, Pahsiv. Paimon non aveva mai incontrato una Melusina come te prima d'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830143,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830144,
					"content": "Érinnyes... Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830145,
					"content": "Érinnyes non va bene? Oppure... ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830146,
					"content": "C'è qualcosa che non va con Érinnyes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "Érinnyes... Melusina, ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830148,
					"content": "Pahsiv, Érinnyes, proteggere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830149,
					"content": "Quindi sta accadendo qualcosa di brutto a Érinnyes e vuoi proteggerla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830150,
					"content": "#Paimon, {NICKNAME}, Érinnyes, bum, sbam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830151,
					"content": "#Ehm... Bene, siamo a ben cinque parole. Allora, vuoi che Paimon e {NICKNAME} prendano a pugni Érinnyes? Proprio BUM, SBAM?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830152,
					"content": "Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830153,
					"content": "Vuoi il nostro aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830155,
					"content": "OK, vuole che la aiutiamo. Benissimo. Paimon però non ha alcuna idea di come prendere a pugni Érinnyes... è letteralmente un'isola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830156,
					"content": "Bum, sbam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830157,
					"content": "Riceveremo una ricompensa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "Cosa dobbiamo fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "Ricom... pensa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830159,
					"content": "#Ma che dici, {NICKNAME}! Pahsiv riesce a malapena a parlare! Non riuscirà a trovare nessun altro che la aiuti, quindi dobbiamo farlo noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830160,
					"content": "Cosa dobbiamo fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "Chiave, chiave, chiave, numero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830163,
					"content": "E poi? A quante chiavi siamo in tutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830164,
					"content": "Chiave! Chiave! Chiave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830165,
					"content": "Tre chiavi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "Pahsiv! Chiave, via nebbiosa, sud...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830167,
					"content": "Chiave, sorgente, nord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830168,
					"content": "Chiave, salice, est...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830169,
					"content": "Ah, ecco cosa vuoi dire... Meglio prendere subito appunti. Ci sono in tutto tre chiavi. Una è nella strada nebbiosa verso sud, una nei pressi della sorgente a nord e una vicino ai salici a est... Paimon ha capito bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830170,
					"content": "Chiave, chiave, chiave, piazza, ovest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830171,
					"content": "Ci sono anche tre chiavi nella piazza verso ovest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830172,
					"content": "Dobbiamo trovare le tre chiavi e poi raggiungere la piazza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#Paimon, Melusina! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830174,
					"content": "#Ehi, Pahsiv, ma devi sempre fare in modo che {NICKNAME} sembri più intelligente di Paimon? Siamo chiaramente più o meno alla pari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830175,
					"content": "Comunque sia, abbiamo già una chiave, quindi non ci rimane che prendere le altre due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830176,
					"content": "Érinnyes, Melusina... Pahsiv, proteggere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830177,
					"content": "Rilassati. Paimon non sa cosa sia successo, ma ti aiuteremo sicuramente a proteggere Érinnyes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830178,
					"content": "In più, Pahsiv, se lo permetti, Paimon vorrebbe aggiungere una piccola precisazione: se per caso ti capitasse di trovare oggetti luccicanti e tondi, per te poco interessanti, oppure un baule dall'aspetto costoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830179,
					"content": "Beh, sarebbe fantastico se ce lo facessi sapere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Nel cercare di capire, Pahsiv si gratta un po' la testa, dopodiché fa altri due salti di gioia e se ne va in tutta fretta.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#Ah, è scappata via. Avrà sicuramente qualcosa di molto urgente da fare. {NICKNAME}, andiamo alla ricerca delle altre due chiavi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
