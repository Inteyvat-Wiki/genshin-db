			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "Come va con il sonno, papà? Dormi meglio, ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500502,
					"content": "Oh, sto molto meglio. Non ho nemmeno più gli incubi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500503,
					"content": "(Le voci della famiglia Leroy si fanno meno distinte...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bussa"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
						],
						"stepId": 7415101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415104",
							"3"
						],
						"stepId": 7415104,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "#Ah, siete {F#tornate}{M#tornati}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510102,
					"content": "#Paimon si chiama Paimon e {F#lei}{M#lui} è {NICKNAME}. Chiamaci così d'ora in poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510103,
					"content": "Sei qui per vedere Benoît?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "Esatto, ma non sono riuscita a parlarci... *sospira* Pare che non potrò terminare il mio tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510105,
					"content": "Il tuo tema? Oh, giusto! Stavi compiendo delle buone azioni perché dovevi finire i compiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510106,
					"content": "Ehi, non è vero! Monsieur Benoît mi è davvero simpatico. È davvero... levigato? Sì, esatto, levigato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510107,
					"content": "Pfff, che razza di descrizione sarebbe? Intendi dire pacato, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510108,
					"content": "Comunque sia... Potresti aiutarmi, Mademoiselle Paimon? Se non lo farai, il mio tema sarà un vero disastro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510109,
					"content": "La mia insegnante ha detto che il mio tema su come ho aiutato Monsieur Benoît a dare da mangiare alla sua gatta era \"in stile dustico e di alta qualità\", e vuole che ne scriva un altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510110,
					"content": "Cosa? \"Dustico\"? Forse vuoi dire \"rustico\"? Comunque sia, Paimon ha capito. Allora è per questo che sei dovuta tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510111,
					"content": "Beh, è certamente per il mio tema, ma Monsieur Leroy mi piace davvero. Voleva che salutassi i miei da parte sua e l'ho fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510112,
					"content": "Non erano molto felici di sentire il suo nome, e non volevano che tornassi. Non so bene il perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510113,
					"content": "Beh, se è solo per il tema, dovrebbe essere semplice, no? Puoi parlare di nuovo di come hai dato da mangiare alla gatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510114,
					"content": "Ma scriverei solo una riga! È troppo poco, non funzionerebbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510115,
					"content": "Possiamo accompagnarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "Già, è vero. Tu darai da mangiare alla gatta e noi puliremo l'ingresso e il retro della casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510117,
					"content": "E, quando avremo finito, busseremo alla porta e faremo due chiacchiere con Benoît. Dovrebbe bastare per il tuo tema, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510118,
					"content": "Sì, è un'idea bellissima! Come sei intelligente, Mademoiselle Paimon. Vado immediatamente a dare da mangiare alla gatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
		{
			"id": 7415103,
