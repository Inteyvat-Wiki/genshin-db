			},
			"dialogs": [
				{
					"id": 741510901,
					"content": "C'è qualcosa di strano in quella coppia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510902
					]
				},
				{
					"id": 741510902,
					"content": "Anche Paimon ha avuto quest'impressione. Uno di loro parla troppo, e l'altro non apre quasi bocca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510903,
					"content": "E la loro comparsa sembra troppo comoda per essere una coincidenza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510904
					]
				},
				{
					"id": 741510904,
					"content": "Intendi dire che sono apparsi proprio quando Benoît stava pensando di assumere dei lavoratori a ore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510905,
					"content": "Euphrasie ha detto che stava ancora assumendo sei mesi fa, ma a quel tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510906,
					"content": "Questa coppia è diventata i suoi bambini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510907
					]
				},
				{
					"id": 741510907,
					"content": "Hai ragione. Sembra fin troppo intenzionale... Questi due hanno decisamente qualcosa che non va!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
