			"dialogs": [
				{
					"id": 741511201,
					"content": "Beh, per ora è tutto ciò che mi viene in mente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511202
					]
				},
				{
					"id": 741511202,
					"content": "#Ehm, {NICKNAME}... Pensi che Benoît sia in pericolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511203,
					"content": "Sicuramente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511204
					]
				},
				{
					"id": 741511204,
					"content": "Ohh, Paimon ha una brutta sensazione. Dici che dovremmo dirlo a qualcuno? Magari andare alla Maison de la Garde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511205,
						741511206,
						741511207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511205,
					"content": "Beh, non abbiamo nessuna prova.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511208,
					"content": "Mh, questo è vero. Ma lo aiuteremo comunque, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511209,
					"content": "Molli ci ha chiesto di dirgli che i suoi spuntini erano buonissimi, e noi gliel'abbiamo promesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511210,
					"content": "Ed è quello che faremo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511211
					]
				},
				{
					"id": 741511211,
					"content": "Hihi, Paimon sapeva che eri di parola! Beh, dato che sei anche intelligente, perché non pianifichiamo la nostra prossima mossa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511212,
					"content": "Indaghiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511213
					]
				},
				{
					"id": 741511213,
					"content": "Sì, andiamo a fondo della questione! Uhm... Su cosa dovremmo indagare, precisamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511214,
						741511215,
						741511216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511214,
					"content": "Sull'identità di quei due.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511217,
					"content": "#Perfetto! Fate largo, gente! {F#Le}{M#I} grandi detective Paimon e {NICKNAME} scopriranno la verità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511215,
					"content": "Sulle intenzioni di quei due.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511216,
					"content": "Su cosa Benoît pensa di loro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511206,
					"content": "La situazione non è per niente chiara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511207,
					"content": "Non sappiamo cosa pensi Benoît al riguardo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				}
			]
