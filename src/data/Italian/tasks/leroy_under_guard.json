			"dialogs": [
				{
					"id": 741511101,
					"content": "Il modo in cui questa coppia si comporta con gli estranei non mi convince.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511102
					]
				},
				{
					"id": 741511102,
					"content": "Esattamente. La prima volta erano abbastanza amichevoli, ma hanno assunto rapidamente un atteggiamento sgradevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511103,
					"content": "Erano cortesi solo in presenza del padre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511104
					]
				},
				{
					"id": 741511104,
					"content": "Uhm... Paimon deve pensarci... È vero. La prima volta che abbiamo parlato con loro, Benoît era appena entrato in casa, e suo genero ci ha detto di non farci più vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511105,
					"content": "Stanno fingendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511106
					]
				},
				{
					"id": 741511106,
					"content": "Ma perché dovrebbero far finta di essere amichevoli davanti al padre? Dev'esserci un qualche motivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
