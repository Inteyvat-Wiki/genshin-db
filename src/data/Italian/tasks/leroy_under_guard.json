			},
			"dialogs": [
				{
					"id": 741511001,
					"content": "C'è qualcosa di sospetto nella loro relazione con Benoît.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511002
					]
				},
				{
					"id": 741511002,
					"content": "Quando li abbiamo incontrati, qualche giorno fa, le cose sembravano a posto, ma... oggi c'era qualcosa di strano nel loro modo di parlare, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511003,
						741511005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511003,
					"content": "Suo genero lo sta mettendo sotto pressione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511004
					]
				},
				{
					"id": 741511004,
					"content": "Ti riferisci allo sguardo che gli ha lanciato per farlo entrare in casa dopo che aveva detto quelle due parole in croce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511007,
					"content": "Ora che lo stai dicendo, Paimon crede di capire da dove proveniva quella sensazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511005,
					"content": "Sua figlia lo sta costringendo con la forza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511006
					]
				},
				{
					"id": 741511006,
					"content": "Beh, Paimon non ci aveva pensato, ma il suo tono di voce ha fatto venire a Paimon la pelle d'oca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Paimon"
				}
			]
		},
