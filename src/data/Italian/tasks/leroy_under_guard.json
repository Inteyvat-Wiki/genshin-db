				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Mademoiselle Paimon, {F#Mademoiselle}{M#Monsieur} {NICKNAME}, ho dato la pappa al gatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510302,
					"content": "Bene! In tal caso, andiamo a parlare con Monsieur Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510303,
					"content": "Però sono preoccupata. Uscirà davvero? Sono già venuta di recente, ma non mi ha parlato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510304,
					"content": "Prima che arrivaste ho bussato ma, non appena è uscito, è arrivato quel suo genero spaventoso e l'ha trascinato di nuovo in casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510305,
					"content": "Mi ha dato dei dolcetti e mi ha detto di tornarmene dai miei genitori, poi ha chiuso la porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510306,
					"content": "Porchetta pupazzola... Benoît è un tipo così tranquillo, perché i suoi familiari sono tanto antipatici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510307,
					"content": "Il genero di Monsieur Leroy ha detto che suo suocero era malato e non poteva incontrarmi, ma a me sembrava stare bene... Quindi perché non ha potuto parlarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510308,
					"content": "In realtà sono più preoccupata per Monsieur Leroy che per il mio tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510309,
					"content": "Se sta male, deve soffrire parecchio. La mamma mi ha detto che le persone malate hanno bisogno di cura e attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510310,
					"content": "Quindi potreste venire con me a chiedere a suo genero perché Monsieur Leroy sta male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510311,
					"content": "Forse ha mangiato troppa torta? Oppure ha dormito poco coperto? Posso chiedere ai miei cosa fare, nel caso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510312,
					"content": "In ogni caso, prima bussiamo alla porta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "Lo so, è solo che... ho un po' di paura di quel suo genero spaventoso. Perché è... sì, spaventoso. Potreste aiutarmi a parlare con lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510315,
					"content": "Tranquilla, Molli. Ci siamo noi con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510313,
					"content": "Beh, abbiamo fatto un accordo, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
