			},
			"dialogs": [
				{
					"id": 225000401,
					"content": "Posso dare una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000402
					]
				},
				{
					"id": 225000402,
					"content": "#Non è una cattiva idea. Dopotutto, tu hai una certa esperienza in queste cose. Beh, mi hai certamente colpita l'ultima volta che sei {F#stata}{M#stato} qui. *ridacchia*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000403
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000403,
					"content": "Si dà il caso che abbia alcuni degli ingredienti necessari a portata di mano. Vado a sistemarmi nella cucina dello chef Mao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000404,
					"content": "Vai a raccogliere tre foglie di menta, poi estrai l'olio essenziale usando un Banco della creazione. Sono sicura che non hai perso il tuo tocco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000405,
					"content": "Mi basterà avere l'olio essenziale di menta, al resto ci penso io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
