			"trigger": {
				"objectNames": [
					"Piccola Lulu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000101,
					"content": "Quando sarà pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000102,
					"content": "Niente giochi oggi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "Oh, ciao! No, in questi giorni sembra che non si riesca mai a giocare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000104,
					"content": "Il Piccolo Meng è di cattivo umore e preferisce stare da solo e imbronciato, mentre il Piccolo Fei sparisce di continuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000105,
					"content": "Ho chiesto al Piccolo Meng cosa c'è che non va, ma non me lo dice. Sono tutti e due così strani in questi giorni... Non so cosa gli abbia preso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000106,
					"content": "Beh, piccola, benvenuta nel mondo degli adulti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "Cosa? Quindi quando si cresce si smette di essere felici? Allora perché il Piccolo Meng e il Piccolo Fei vogliono così tanto diventare grandi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000108,
					"content": "Beh, allora io ho deciso che non crescerò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000109,
					"content": "Comunque non era di questo che volevo parlare... Ho bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000112,
					"content": "Potresti andare a prendere una cosa a casa di Ying'er per me? Ne abbiamo già parlato, quindi dovrebbe averla già pronta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000113,
					"content": "È stato un piacere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "Evviva! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000115,
					"content": "A casa di Ying'er, ehm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "Non so a cosa stai pensando, ma non è quello. Ho solo chiesto a Ying'er di prepararmi una cosa e lei ha detto che lo farà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000117,
					"content": "E ora ti sto chiedendo molto gentilmente di portarmela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000110,
					"content": "Sei triste anche tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "Io? No, sto bene, ma... ho bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Piccola Lulu"
				}
			]
		},
		{
			"id": 2250002,
