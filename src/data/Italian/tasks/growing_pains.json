					"nextDialogs": [
						225001003
					]
				},
				{
					"id": 225001003,
					"content": "L'abbiamo già preparato non molto tempo fa, non ricordi? Eh... Dimentichi le cose con la stessa velocità con cui ti ci butti dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001004
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001004,
					"content": "Ti farò un riassunto: raccogli tre foglie di menta ed estrai l'olio essenziale usando un Banco della creazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001005
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001005,
					"content": "Portami l'olio essenziale. Al resto penserò io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001006,
					"content": "Che impieghi ha l'olio essenziale di menta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001007
					]
				},
				{
					"id": 225001007,
					"content": "Come dire... Neutralizza alcuni degli elementi più stimolanti della miscela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001008
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001008,
					"content": "Ma, soprattutto, è una fragranza perfetta per una bambina come Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001009
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001009,
					"content": "Il profumo di una ragazza non è solo una questione di naso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001010
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001010,
					"content": "Deve catturare l'entusiasmo per la vita della Piccola Lulu, tutta l'innocenza nei suoi occhi... *ridacchia*",
