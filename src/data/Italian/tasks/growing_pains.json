			},
			"dialogs": [
				{
					"id": 225000501,
					"content": "Il profumo è pronto, una variante su misura a base di olio essenziale di menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000502
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000502,
					"content": "Ecco qua, è pronto per la Piccola Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000503,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "Perché la menta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "Il suo profumo neutro contrasta alcuni degli elementi più... ehm... stimolanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000506,
					"content": "A essere onesta, sono rimasta molto sorpresa di ricevere un ordine da Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000507,
					"content": "Mi ricorda quando avevo la sua età... Le prime cotte, i batticuori... Se solo fossi stata un po' più esperta a quel tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000508,
					"content": "Ehm... Comunque sia, meglio che ti lasci tornare da Lulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
		{
