			"trigger": {
				"objectNames": [
					"Ying'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000201,
					"content": "#Oh, bentornat{F#a}{M#o}. Sentivi già la mia mancanza, eh? Per cosa sei venut{F#a}{M#o} stavolta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000202,
					"content": "Per ritirare qualcosa per la Piccola Lulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "La Piccola Lulu? Oh sì, giusto. Mi ha chiesto di prepararle un profumo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000204,
					"content": "#Purtroppo non è il momento migliore... Per qualche motivo, dall'ultima volta che {F#sei venuta}{M#sei venuto} qui, i miei servizi di profumeria sono stati richiestissimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000205,
					"content": "Ho ricevuto un'enorme quantità di ordini, troppi per occuparmene da sola, soprattutto visto che devo anche pensare al negozio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000206,
					"content": "E poi, Lulu è solo una bambina. Sarebbe un po' inappropriato darle lo stesso tipo di profumo che usano le donne adulte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000207,
					"content": "Così mi sono interrogata su come rendere il mio profumo più adatto ai bambini. Finalmente ho trovato una formula adatta, ma non sono ancora riuscita a prepararla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000208,
					"content": "Se è così urgente, un modo per accelerare le cose ci sarebbe, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ying'er"
				}
			]
		},
		{
			"id": 2250003,
