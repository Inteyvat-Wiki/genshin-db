				"points": []
			},
			"dialogs": [
				{
					"id": 225000301,
					"content": "Che ne dici di 3.000 Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "Wow, non riesce più ad aspettare... Va bene allora, darò la priorità al profumo di Lulu in nome della nostra amicizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000303,
					"content": "Di giorno devo stare dietro al negozio, però. Gli affari personali dovranno aspettare la notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000304,
					"content": "Ripassa stasera e ti farò trovare tutto pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
		{
