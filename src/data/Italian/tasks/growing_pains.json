			},
			"dialogs": [
				{
					"id": 225000601,
					"content": "Ciao, hai portato il mio profumo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000602
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000602,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000603
					]
				},
				{
					"id": 225000603,
					"content": "Grazie! I profumi di Ying'er sono i migliori in assoluto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000604
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000604,
					"content": "Mi chiedo cosa faranno il Piccolo Meng e il Piccolo Fei quando lo annuseranno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000605
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000605,
					"content": "Penso che qualunque sarà la loro reazione, mi divertirò un mondo a guardarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000606,
						225000608
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000606,
					"content": "Ne andranno pazzi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000607
					]
				},
				{
					"id": 225000607,
					"content": "Lo spero. Sarebbe fantastico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000610,
					"content": "Grazie di avermi aiutata. Tra poco tornerò a casa e proverò il mio nuovo profumo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000611
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000611,
					"content": "Se è buono, allora potrò continuare a usarlo ancora e ancora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 225000608,
					"content": "Con chi preferisci giocare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000609
					]
				},
				{
					"id": 225000609,
					"content": "Mmm? Non preferisco uno dei due... Li preferisco tutti e due! Il Piccolo Meng e il Piccolo Fei sono entrambi i miei migliori amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "Piccola Lulu"
				}
			]
