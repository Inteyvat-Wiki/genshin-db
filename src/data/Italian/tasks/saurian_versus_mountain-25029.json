			"dialogs": [
				{
					"id": 250290301,
					"content": "Incredibile! Sei veloce come Mayta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290302,
						250290304
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290302,
					"content": "Non è andata così bene come speravo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290303
					]
				},
				{
					"id": 250290303,
					"content": "#Davvero? Vuoi dire che avresti potuto andare ancora più veloce? Devi proprio essere {F#un'avventuriera esperta}{M#un avventuriere esperto}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290306
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290306,
					"content": "Se ci diamo questi tempi come obiettivo... Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290307
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290307,
					"content": "Huooo, ruooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290308
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290308,
					"content": "...Sì, lo so, per te sarà un po' dura, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290309
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290309,
					"content": "Andrò a parlarne con Mayta. Forse lui ci proporrà un piano di allenamento più... realistico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290310
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290310,
					"content": "Comunque, grazie mille per l'aiuto. Ecco, prendi questi cacahuatl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290311
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290311,
					"content": "Lo abbiamo raccolto noi, quindi è freschissimo e ci si potrà preparare un cioccolato buonissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290312
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290312,
					"content": "Roar, roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290313
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290313,
					"content": "Adesso ce ne andiamo. Mi chiedo se Mayta sia tornato al villaggio. Oppure se sia andato di nuovo ad arrampicarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290304,
					"content": "Chi è Mayta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290305
					]
				},
				{
					"id": 250290305,
					"content": "È un mio amico abilissimo a scalare le montagne. A parte Roca, quasi nessuno riesce a tenergli testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290306
					],
					"speakerTitle": "Tlatem"
				}
			]
