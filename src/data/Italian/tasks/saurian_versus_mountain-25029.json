			"dialogs": [
				{
					"id": 250290201,
					"content": "Che bravo! Oggi hai mangiato a sazietà? Sei pronto ad allenarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290202
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290202,
					"content": "Roar, roar, roooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290203,
					"content": "Oggi sprizzi energia da tutti i pori, non è vero? Fantastico! Cominciamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290204,
					"content": "Bene, andiamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "Eh? Oh, ciao! Ci stavamo giusto allenando a scalare le montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290207,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290208
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290208,
					"content": "Roar, roooar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290209,
						250290212
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290209,
					"content": "Come va l'allenamento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290210
					]
				},
				{
					"id": 250290210,
					"content": "Beh... Stiamo \"facendo progressi\". Stavolta Qica è arrivato molto più in alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290211
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290211,
					"content": "Il fatto è che Qica non è molto pratico di scalate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290216,
					"content": "A proposito, potresti darci un'altra dimostrazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290217,
						250290221
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290217,
					"content": "Certo, con piacere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "Grazie mille! Stavolta riuscirò sicuramente a seguire i tuoi movimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290219,
					"content": "Qica, tieni gli occhi aperti anche tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290220,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290223,
					"content": "Contiamo su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290224
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290224,
					"content": "Perciò tu ti arrampichi e noi ti cronometriamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290225
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290225,
					"content": "Huooo, ruooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290221,
					"content": "Guarda bene stavolta, d'accordo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290222
					]
				},
				{
					"id": 250290222,
					"content": "Certo! Io e Qica non ci faremo sfuggire nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290212,
					"content": "Sembra che si stia riprendendo bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290213
					]
				},
				{
					"id": 250290213,
					"content": "È vero. Mamma dice che ormai ho imparato a prendermi cura di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290214
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290214,
					"content": "Qica è migliorato moltissimo. Ora si arrampica molto più in alto rispetto all'ultima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290215
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290215,
					"content": "Il fatto è che Qica non è molto pratico di scalate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Tlatem"
				}
			]
