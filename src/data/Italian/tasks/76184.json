			"dialogs": [
				{
					"id": 761840101,
					"content": "Beh, questa sì che è una sorpresa. Non credevo sarebbe arrivato il giorno in cui mi avresti invitato a uno dei tuoi tè pomeridiani, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840102,
					"content": "Se ti fossi impegnato a migliorare un po' le tue buone maniere, magari l'avrei fatto anche prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840103,
					"content": "Concordo. Anche smettere di sfidare la gente a duello a ogni occasione potrebbe aiutarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761840104,
					"content": "Eh. Mi sembra di sentire i miei fratelli e sorelle maggiori. Che posso farci? Durante gli addestramenti della mia maestra, l'etichetta non era esattamente una priorità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840105,
					"content": "Lasciamo perdere. Non capita spesso di ritrovarci tutti insieme così. Rilassiamoci e godiamoci il momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840106,
					"content": "Mmh. Questa è la tua ultima creazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840107,
					"content": "Si chiama Fagio, sta per \"Facilitatrice Automatisée Généraliste Interactive et Omnitâche\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840108,
					"content": "Significa che Pulonia è davvero irrecuperabile? Mi spiace, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840109,
					"content": "Non importa, io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840110,
					"content": "...Mi spiace sapere che non avrò mai la possibilità di affrontarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840111,
					"content": "Certo che anche tu sei irrecuperabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840112,
					"content": "Pulonia sembrava forte, questa Fagio d'altro canto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840113,
					"content": "...Sembra debole? È questo che volevi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840114,
					"content": "Ehm... Ahah, no, no. È solo che non sembra forte quanto Pulonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840115,
					"content": "Umpf, Pulonia fu progettato per le misurazioni e i calcoli. Ho fatto in modo di non compromettere la sua potenza di elaborazione quando gli ho conferito capacità di combattimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840116,
					"content": "Ma Fagio non dovrà elaborare formule complesse: la sua intera potenza di calcolo può essere dedicata al modulo di combattimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840117,
					"content": "Perciò... significa che in realtà è più forte di Pulonia? È davvero possibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840118,
					"content": "Vuoi avere una dimostrazione pratica, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840119,
					"content": "Che sia chiaro: se la rompo, non pagherò alcuna riparazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840120,
					"content": "E io non pagherò le tue spese ospedaliere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761840121,
					"content": "(*sospira* Sapevo che sarebbe successo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761840122,
					"content": "(*gnam gnam*)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
