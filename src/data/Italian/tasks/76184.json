			"dialogs": [
				{
					"id": 761840301,
					"content": "Tutto sommato non sono male, questi ricevimenti. Se avessi saputo che erano così divertenti, mi sarei unito molto prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840302,
					"content": "(Restiamo seduti così ancora per un po'.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "Va bene, ci vediamo la prossima volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 761840303,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				}
			]
		}
	]
