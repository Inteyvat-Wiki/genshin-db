			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 761140301,
					"content": "(Eh? A quanto pare... non sono bruciati completamente...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140302,
					"content": "(Ho sentito dire che il signor Derwent dava rifugio agli avventurieri feriti... Sembra che sia accaduto anche negli ultimi tempi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140303,
					"content": "(Perché avrà provato a bruciare questi...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
