			"dialogs": [
				{
					"id": 761140101,
					"content": "Quindi, stavolta c'è da investigare su... un eremita sospetto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140102,
					"content": "Gli eremiti non sono tipi strani sempre e comunque? Nessuno che decida d'isolarsi per vivere sulle pendici di una montagna sperduta può essere considerato normale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140103,
					"content": "Le persone non cambiano senza motivo, indipendentemente dal fatto che tali cambiamenti siano determinati da fattori interni o esterni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140104,
					"content": "E poi, quel mercante scomparso desta parecchie domande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140105,
					"content": "Eh? Ma quella zona è piena di pericoli, lo sanno tutti. Banditi, mostri... Ci sono un milione di motivi con cui un mercante itinerante può perdere la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140106,
					"content": "Essendo una cosa così risaputa, è pacifico pensare che un mercante che transiti regolarmente da quelle parti lo faccia preparandosi al meglio, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140107,
					"content": "Per quanto conosca bene quel territorio, un mercante esperto è comunque svanito nel nulla. Un evento del genere non può non destare dubbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140108,
					"content": "Jahoda, affido a te il compito di incontrare questo \"eremita sospetto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140109,
					"content": "Sarà un viaggio lungo, fa' attenzione a non deviare dal percorso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140110,
					"content": "Ah... Certo, capo Nef! Lasci fare a me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
		{
