			"dialogs": [
				{
					"id": 710190201,
					"content": "Quel vaso contiene una grossa roccia. Paimon pensa che sia un \"giardino roccioso\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190202,
					"content": "Ma di solito non si trovano nei giardini o nei cortili? Che senso ha averne uno qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190203,
					"content": "Mmmh, c'è qualcosa di strano sulla cima. Sembra un segno di qualche tipo... Paimon lo trova molto interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190204,
					"content": "Beh, già che siamo in viaggio... vediamo se troviamo delle montagne che assomigliano a questo giardino roccioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190205,
					"content": "Chissà, potremmo trovare qualcosa di bello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
