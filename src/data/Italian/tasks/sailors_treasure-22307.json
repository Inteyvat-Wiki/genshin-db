					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070301,
					"content": "Sì, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070302
					]
				},
				{
					"id": 223070302,
					"content": "Va bene... Ecco fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070303,
					"content": "Buona fortuna! E non dimenticarti di riportare qui il tesoro, se lo trovi... Lo divideremo in tre parti, come da accordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
