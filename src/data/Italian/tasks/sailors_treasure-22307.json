			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070201,
					"content": "Salve, che piacere vederti! Come posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070202
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070202,
					"content": "Le mappe del tesoro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070203
					]
				},
				{
					"id": 223070203,
					"content": "Mappe del tesoro? Oh, penso tu intenda quelle di Zhang Shun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070204
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070204,
					"content": "Allora andrai davvero a cercare il tesoro? Devo dire che l'ho sempre visto più come un gioco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070205,
					"content": "#Con te, invece, basta uno sguardo per capire che sei {F#una vera avventuriera}{M#un vero avventuriere}, di quell{F#e}{M#i} a cui si illuminano gli occhi non appena qualcuno dice \"tesoro\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070206
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070206,
					"content": "A dirla tutta, non saprei neanche che farmene di queste mappe del tesoro, quindi puoi prenderle tranquillamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070207
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070207,
					"content": "Detto questo, però, se trovassi un tesoro lo divideremo in parti uguali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070208
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070208,
					"content": "Dopotutto, ho conservato queste mappe per un bel po'... Un contributo per le spese di deposito mi sembra dovuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
		{
			"id": 2230703,
			"completionStepIds": [
				2230703,
