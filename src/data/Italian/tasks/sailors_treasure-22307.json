			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhang Shun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070101,
					"content": "Mmm, che fare, che fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070102
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070103
					]
				},
				{
					"id": 223070103,
					"content": "Ero un marinaio della Crux, finché non mi capitò uno sfortunato incidente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070104
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070104,
					"content": "Dopo aver lasciato la flotta avevo bisogno di soldi, così ho ceduto alcune mappe del tesoro a Bolai, un uomo d'affari del posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070105
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070105,
					"content": "L'accordo era che avrei avuto una parte di qualsiasi tesoro trovato, ma lui non si è più fatto sentire e sospetto che non abbia nemmeno iniziato a cercare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070106
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070106,
					"content": "Non posso continuare ad aspettare così, ti andrebbe di cercare il tesoro per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070109,
						223070116
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070107,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070108
					]
				},
				{
					"id": 223070108,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070120,
					"content": "Inizia facendo visita a <color=#00E1FFFF>Bolai</color> per prendere le <color=#00E1FFFF>mappe del tesoro</color>. Quindi trova il <color=#00E1FFFF>tesoro</color> e <color=#00E1FFFF>portaglielo</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070121
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070121,
					"content": "Ne abbiamo già parlato, tratterrà lui la mia parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070109,
					"content": "Perché hai lasciato la flotta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070110
					]
				},
				{
					"id": 223070110,
					"content": "Mi resi conto che il mio infortunio avrebbe potuto tornare a darmi problemi in qualsiasi momento. Non volevo mettere a rischio il resto dell'equipaggio, quindi decisi di andarmene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070111
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070111,
					"content": "Avevo iniziato a vendere alcune cianfrusaglie raccolte nel corso degli anni per guadagnarmi da vivere, ma gli affari non andavano bene e ben presto la merce si è esaurita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070112
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070112,
					"content": "Un tempo avevo delle mappe del tesoro. Facevano parte del bottino accumulato con il resto dell'equipaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070113
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070113,
					"content": "Nelle mie condizioni, però, è già abbastanza faticoso il semplice camminare per strada... Non posso certo andare in giro per il mondo a caccia di tesori, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070114
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070114,
					"content": "Così ho ceduto le mappe a Bolai per un po' di soldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070115
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070115,
					"content": "Ma sembra che nemmeno lui possa andare a cercare il tesoro di persona, è solo un uomo d'affari dopotutto... Ecco perché ho bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070116
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070116,
					"content": "Di che tesoro stiamo parlando? È molto grande?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070117
					]
				},
				{
					"id": 223070117,
					"content": "Oh, temo che non sia enorme. Erano solo delle mappe del tesoro di basso profilo, divise tra i membri dell'equipaggio insieme al resto del bottino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070118
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070118,
					"content": "I marinai esperti capiscono al volo quando c'è un tesoro vero. Lo rintracciano subito e lo portano a bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070119
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223070119,
					"content": "Qualsiasi tesoro troveremo sarà di minor conto, ma varrà comunque qualcosa. Di sicuro, abbastanza da dividere in tre... Quindi buona fortuna là fuori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "Zhang Shun"
				}
			]
		},
		{
			"id": 2230702,
