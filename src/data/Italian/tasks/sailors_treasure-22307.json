			"dialogs": [
				{
					"id": 223070801,
					"content": "Quasi dimenticavo, sai come leggere queste mappe del tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070802
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070802,
					"content": "Sinceramente, non riuscivo a capirci niente all'inizio, così ho fatto dare un'occhiata a diverse persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070803
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070803,
					"content": "Hanno capito più o meno dove si trova il tesoro, ma hanno detto che, se lo fossi andato a cercare, avrei dovuto pagare loro una commissione extra... Ecco perché alla fine ho abbandonato l'idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070804
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070804,
					"content": "Se ti è d'aiuto, posso segnare il punto in cui si trova. Basta chiedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070805
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070805,
					"content": "Ma, sai com'è, dovrei farti pagare un contributo... Diciamo <color=#00E1FFFF>100 Mora</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070806
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070806,
					"content": "Cosa ne dici? Devo <color=#00E1FFFF>segnarti la posizione</color> sulle mappe del tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
