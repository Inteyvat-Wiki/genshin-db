			"dialogs": [
				{
					"id": 740660201,
					"content": "\"L'arte della negoziazione\"? Umpf... Perfino dal titolo sembra una barba! A Paimon non interessa neanche un po'... Uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660202,
					"content": "Eh? Dentro c'è un avviso? Mmh... \"Vai al banco di accettazione presso la portineria e partecipa al questionario di soddisfazione interno del refettorio dei Coupon: potrai ricevere dei Coupon come ricompensa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660203,
					"content": "Dei Coupon? Woah! Hai visto? Possiamo avere dei Coupon! Sembra comodissimo, Paimon non se l'aspettava proprio! Andiamoci subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7406603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406603",
							"2"
						],
						"stepId": 7406603,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
