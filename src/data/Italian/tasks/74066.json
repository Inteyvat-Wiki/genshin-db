					}
				]
			},
			"dialogs": [
				{
					"id": 740660901,
					"content": "(Paimon c'è! Fai del tuo peggio!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660902,
					"content": "Prima domanda. Reputi accettabile che i prezzi del cibo venduto al refettorio dei Coupon rimangano così bassi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660903,
					"content": "(Uhm... Come possiamo rispondere? Fai pensare Paimon... Ecco! Proviamo con la formula universale.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660904,
					"content": "(Secondo il libro, l'espressione \"Capisco il tuo punto di vista, ma...\" può essere usata in ogni situazione. In questo modo, anche un Mago dell'Abisso sarebbe disposto a dare una risposta positiva. Fenomenale, se è così.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660905,
					"content": "Accettabile. A Paimon piace molto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "Cosa? Paimon non toccherebbe quella robaccia nemmeno se gliela regalassero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660907,
					"content": "E se ci ritrovassimo senza più soldi per il cibo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "Uhm... Beh, in quel caso... N-NO! Piuttosto Paimon morirebbe di fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660918,
					"content": "*tossisce* Chiedo scusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660919,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660920,
					"content": "Secondo la regola, le risposte al questionario devono essere rapide. Passiamo alla prossima domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660921,
					"content": "V-Va bene, se è la regola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660922,
					"content": "Seconda domanda. Trovi che la quantità di cibo disponibile al refettorio dei Coupon durante le ore dei pasti sia adeguata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660923,
					"content": "Di cibo ce n'è in quantità... solo che ha un sapore schifoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660924,
					"content": "Eh, sì. C'è più menta in quel cibo che in tutta Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "Tanto vale mangiare direttamente della menta, a quel punto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660926,
					"content": "Ah, sì? Allora, oggi insalata alla menta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "No! Paimon non vuole manco quella! *singhiozza* Paimon desidera tanto del pollo ai Fiordolci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660928,
					"content": "Potreste gentilmente... tornare al questionario? Lo prenderò come un \"sì\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660935,
					"content": "Uff... Che seccatura. Passiamo alla prossima domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660936,
					"content": "Ma prima di farlo, ci tengo a ricordarti ancora che bisogna rispondere rapidamente. Quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660937,
					"content": "Ecco la terza domanda. Reputi che l'attuale sistema dei pasti casuali sia interessante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660938,
					"content": "Dovete dare più importanza al sapore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660939,
					"content": "Capisco il tuo punto di vista, ma... non pensi che i pasti casuali stimolino la curiosità e contribuiscano a creare un piacevole senso di sorpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660940,
					"content": "In effetti... Messa in questi termini, è decisamente interessante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660941,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "Che c'è? Ha detto una cosa perfettamente sensata. È difficile dissentire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660943,
					"content": "Ahem, rispondi rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660944,
					"content": "È interessante, e lo sono anche i biglietti della fortuna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "Sì! Ogni pasto contiene un messaggio. È come una specie di lotteria, un autentico spasso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660946,
					"content": "\"Il duro lavoro porta a grandi risultati\"! Secondo Paimon, è fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660947,
					"content": "Lavorare duramente alla fine ripaga sempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "Hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660957,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660958,
					"content": "Domanda numero quattro: pensi sia accettabile vendere cibi che provocano dipendenza al refettorio dei Coupon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660959,
					"content": "(Eh? Cosa? Perché parla così veloce, tutto d'un botto?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660960,
					"content": "(Prendere l'iniziativa? Guidare la conversazione? No! No! Sembrano sbagliate tutte. Forse... Forse è meglio tornare alla formula universale...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660961,
					"content": "(C'è qualcosa che non va... Queste domande...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "Ahem! Non stare troppo a rifletterci e a discuterne. Come ho già detto, le risposte devono essere rapide e istintive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660964,
					"content": "È decisamente accettabile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "Bene, grazie per i tuoi commenti. E ora, passiamo alla domanda finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660968,
					"content": "#Sbaglio o ci ha ignorat{F#e}{M#i} del tutto? Le nostre risposte non contano niente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660969,
					"content": "In base alle risposte appena fornite, ritieni che le attuali condizioni del refettorio dei Coupon siano soddisfacenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660970,
					"content": "Aspetta, quali erano le risposte? Paimon non se le ricorda mica tutte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660971,
					"content": "Beh, non fa niente, scriverò semplicemente che sei soddisfatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660972,
					"content": "Va bene, ma... a Paimon non sembra proprio corretto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660973,
					"content": "Credo di doverti informare che, in caso di risposta negativa, non avrai diritto ad alcun Coupon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660974,
					"content": "Non sia mai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660975,
					"content": "#Allora? Cosa rispondi, {F#Mademoiselle}{M#Monsieur}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660976,
					"content": "E non ignorare Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660977,
					"content": "Sì, sono molto soddisfacenti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "Benissimo. Grazie per la collaborazione. Il tuo supporto ci aiuta a migliorare giorno dopo giorno. Firma qui per riscuotere i Coupon. Può farlo anche il Mekautoma volante autocosciente che vola accanto a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660983,
					"content": "Eh? Anche Paimon li riceve?! Ma Paimon non ha nemmeno partecipato! Siamo sicuri che sia corretto? Un attimo, Paimon è Paimon, non un \"Mekautoma volante autocosciente\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660984,
					"content": "Molto bene. In ogni caso, noi rispettiamo le opinioni di tutti. Questo vale sia per le persone che per... ehm, i Meka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660985,
					"content": "Ma allora non ci senti?! Paimon ha detto che Paimon non è un Mekautoma volante! Paimon è Paimon e basta! Non ignorare Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660986,
					"content": "Capisco... A ogni modo, onde evitare sprechi del tuo preziosissimo tempo, posso occuparmi di compilare il sondaggio al posto tuo. Non preoccuparti, il numero di Coupon che riceverai non subirà alcuna variazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660987,
					"content": "Sono certa che intendi rispondere positivamente a tutte quante le domande, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660988,
					"content": "Sì! Coupon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660989,
					"content": "In tal caso, firma qui e lascia che al resto ci pensi io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660990,
					"content": "Ottimo! Così potremo avere i Coupon evitandoci seccature di sorta. Grazie mille, Monglane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660991,
					"content": "Grazie per il supporto. Ecco qua i Coupon, speriamo di vederti partecipare anche al prossimo questionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660992,
					"content": "Dopo aver riscosso i Coupon, tu e Paimon salutate Monglane e andate via.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "Col senno di poi, a Monglane non importava un bel niente delle nostre risposte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660994,
					"content": "Il problema erano le domande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "Sì, infatti. Come questionario era veramente strambo, e Monglane sembrava quasi esaurita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660996,
					"content": "L'arte della negoziazione ha fatto cilecca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "L'arte della negoziazione, puah! Libri simili sono solo carta straccia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660998,
					"content": "Hai ragione, il problema è partito dal libro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "Decisamente! La pensi così anche tu, quindi? Bene, in ogni caso abbiamo avuto i Coupon, quindi Paimon è disposta a lasciar correre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661000,
					"content": "No, il problema era Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "Eh? Ma Paimon ha seguito alla lettera le indicazioni del libro! Vedi? C'era scritto qui che bisognava \"parlare ad alta voce\"... Gira che ti rigira, la colpa è tutta del libro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661002,
					"content": "Capisco il tuo punto di vista, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "Ehi, non ti azzardare a prendere in giro Paimon! Umpf, \"arte della negoziazione\" un piffero... È stata totalmente inutile dall'inizio alla fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660978,
					"content": "No, non sono affatto soddisfacenti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "#Aspetta, frena! No! Scrivi che siamo soddisfatt{F#e}{M#i}! Fallo almeno per i Coupon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660980,
					"content": "#Ti ritieni soddisfatt{F#a}{M#o}, quindi? Tutto chiaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660981,
					"content": "In generale sì, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "Non è accettabile perché...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "Capisco il tuo punto di vista, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "(Che sia questo... \"Guidare la conversazione\"?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "Non è interessante, non mi permette di mangiare quello che voglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "Tutto ha un sapore strano. Sarà anche una sorpresa, ma non è per niente piacevole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660951,
					"content": "Capisco il tuo punto di vista, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "Sarebbe bello avere un pasto gratuito particolarmente buono una volta ogni diciotto pasti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660953,
					"content": "Perché proprio diciotto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "È una cosa che Paimon ha sentito dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660955,
					"content": "Una roba del tipo... ehm... Dato che ci sono tre pasti ogni giorno, e sei giorni prima della domenica, in tutto fanno diciotto pasti nel giro di sei giorni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660956,
					"content": "In questo modo, durante il settimo giorno, potremmo mangiare del cibo squisito che ci metterebbe di buonumore per il resto della settimana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660929,
					"content": "Non abbastanza! Perfino Wolsey non riesce a mangiarlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660930
					]
				},
				{
					"id": 740660930,
					"content": "È proprio che non vuole farlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660931,
					"content": "Ho capito, quindi non ce n'è abbastanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660932,
					"content": "Capisco il tuo punto di vista, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
					"content": "Però ci rifiutiamo di mangiarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660934,
					"content": "Ahhh... L'ho capito che avete letto il libro... Lo prenderò come un \"sì\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660909,
					"content": "Inaccettabile, vorrei che i prezzi fossero più alti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660910
					]
				},
				{
					"id": 740660910,
					"content": "Eh?! Perché?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660911,
					"content": "Che importa se non è il cibo migliore, vogliamo che costi un occhio!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660912
					]
				},
				{
					"id": 740660912,
					"content": "Che assurdità è?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660913,
					"content": "M-Ma ti senti bene...? Non mi sembri tanto per la quale. Hai mangiato qualcosa di strano, per caso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660914,
					"content": "Capisco il tuo punto di vista, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660915
					]
				},
				{
					"id": 740660915,
					"content": "Ma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660916
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660916,
					"content": "#Ma ci sono ampi margini di miglioramento! Il cibo potrebbe quantomeno avere un sapore migliore! Non lo pensi anche tu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660917,
					"content": "Basterebbe... poter ordinare del pollo ai Fiordolci, magari. Ah, sì! Paimon mangerebbe qui tutti i giorni, se così fosse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
