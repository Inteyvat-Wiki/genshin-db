						"rawParams": [
							"0",
							"0",
							"74066"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Monglane"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4468.459,
							121.82,
							4558.232
						],
						"pointId": 4585
					},
					{
						"sceneId": 3,
						"position": [
							4465.67,
							121.811,
							4557.625
						],
						"pointId": 4592
					}
				]
			},
			"dialogs": [
				{
					"id": 740660301,
					"content": "Il banco di accettazione presso la portineria... È questo qui! Bene, vediamo se la fortuna gira dalla nostra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660302,
					"content": "Salve, Mademoiselle Monglane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660304,
					"content": "(Woah! A giudicare dall'aspetto, non sembra un tipo molto alla mano.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660305,
					"content": "(Forse possiamo applicare gli insegnamenti de \"L'arte della negoziazione\"?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(Giusto, abbiamo il libro! Chi pensava che ci sarebbe mai tornato utile?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660307,
					"content": "Vediamo, vediamo... Trovato! \"Se sei in grado di ottenere l'iniziativa sfoggiando i tuoi punti di forza, e di sopraffare l'avversario con un atteggiamento imponente...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660308,
					"content": "Eccolo, ci siamo! \"Sopraffare l'avversario con un atteggiamento imponente\"! Ora Paimon ha capito! Significa che Paimon deve alzare di più la voce, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660309,
					"content": "Ehi! Mademoiselle Monglane! Salve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660310,
					"content": "...Ti ho sentita. Cosa posso fare per voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660311,
					"content": "Eh? Ha funzionato davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660312,
					"content": "#Hihi, siamo qui per il questionario di soddisfazione! Ehm, cioè, Paimon voleva dire che è venuta ad accompagnare {F#lei}{M#lui}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660313,
					"content": "#(Non temere, {NICKNAME}. Abbiamo il libro: Paimon lo leggerà di nascosto e ti dirà di volta in volta cosa fare! Comunque... Sì! Ti basterà ascoltare Paimon!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660314,
					"content": "Anche voi avete trovato gli avvisi nei libri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660315,
					"content": "Eh? Sì, esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660316,
					"content": "Ma si può sapere quante volte...? Anzi... Uff, lasciamo perdere, va bene così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660317,
					"content": "Ahem! Solo un istante... Permettimi di illustrarti le regole. Il questionario consiste di cinque domande. Le risposte devono essere rapide e istintive. E questo ci tengo a sottolinearlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660318,
					"content": "#È chiaro? Se sei pront{F#a}{M#o}, possiamo cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monglane"
				}
			]
		},
