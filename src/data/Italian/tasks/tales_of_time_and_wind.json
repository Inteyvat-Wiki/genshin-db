				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071101,
					"content": "Te l'ho già detto prima, ricordi? Di quando ho incontrato il \"Tempo\" al Tempio dei Mille Venti e ricevuto un po' d'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071102,
					"content": "Beh, è stato grazie all'aiuto del Tempo se quei primi venti della libertà sono riusciti a soffiare così forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000712,
			"completionStepIds": [
				1000703
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071201,
					"content": "Ma venti forti come quelli sono più adatti a spazzare via le cose, piuttosto che ad aiutarle a crescere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071202,
					"content": "Così, dopo aver risolto alcune crisi a Mondstadt, ho fatto in modo che i venti fossero più delicati, seppur abbastanza forti da aiutare le persone nei momenti di bisogno, ma senza farle cadere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071203,
						100071204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071203,
					"content": "Quindi, eccoci qui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				},
				{
					"id": 100071205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071206,
					"content": "Le ombre si radunano in lontananza. Sicuramente l'hai percepito anche tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071207,
					"content": "Ho sentito parlare dello scontro tra l'Archon di Pyro e la Signora della Morte, Ronova, e di ciò che è successo al Messaggero dei Fatui, il Condottiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071208,
					"content": "Senza menzionare l'attività dell'Abisso, che si sta avvicinando sempre più a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071209,
					"content": "Temo che gli umani non saranno in grado di risolvere da soli la crisi imminente... Di conseguenza, devo prepararmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071210,
					"content": "Intervenire nei momenti di bisogno è un dovere dell'Archon di Anemo. Per questo, io, Barbatos, evocherò un vento abbastanza forte da disperdere qualsiasi tempesta ci attenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071211,
					"content": "Ma se scatenassi una tempesta di tale potenza nella città di Mondstadt, metterebbe tutto sottosopra... I vestiti, i cappelli, i fiori sui balconi delle persone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071212,
					"content": "Ecco perché ho scelto di farlo qui, nel luogo dove una volta ho offerto un'ode al Tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071213,
					"content": "Chissà! Forse il Tempo è particolarmente benevolo con quest'isola proprio grazie alla mia dolcissima musica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071214,
					"content": "Aspetta, quindi... Questo posto è davvero così speciale? A Paimon non sembra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071215,
					"content": "C'è una marea che sale e scende, e degli uccelli che vanno e vengono... Sembra tutto... normale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071216,
					"content": "L'impatto del Tempo sulle cose non si limita a ciò che l'occhio può vedere. Consideralo come... un Tramontino maturo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071217,
					"content": "Se la buccia esterna rimane intatta, è quasi impossibile per una persona comune capire se il frutto all'interno sia maturo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071218,
					"content": "Ma anche il più piccolo foro nella buccia farà marcire il frutto, a partire proprio da quel punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071219,
					"content": "Custodita nelle mani del Tempo, nessuna \"imperfezione\" segna la \"buccia\" di quest'isola. Così, l'influenza del Tempo sulla sua vera essenza rimane nascosta a tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071220,
					"content": "Al livello più fondamentale, naturalmente, tutte le cose che non godono della grazia del Tempo saranno, prima o poi, cancellate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071221,
					"content": "Ma con il potere che rimane qui, posso sfruttare il Tempo per tracciare un confine intorno al Vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071222,
					"content": "In questo modo il mondo esterno non si accorgerà di nulla, non importa quanto potente sia la tempesta che scatenerò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071223
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071223,
					"content": "#Naturalmente, essendo io a chiedere aiuto, dovrei offrire qualcosa in cambio. È per questo che ti ho invitato qui, {NICKNAME}... Per eseguire insieme un'ode al Tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071224
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071224,
					"content": "#Fammi sapere quando sei {F#pronta}{M#pronto}, {NICKNAME}. Ah, e posso prestarti uno strumento, se ne hai bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071204,
					"content": "Per fare cosa esattamente...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				}
			]
		},
