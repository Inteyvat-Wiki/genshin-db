				"points": []
			},
			"dialogs": [
				{
					"id": 100071001,
					"content": "Una volta invocai i primi venti di libertà per il popolo di Mondstadt. Con l'aiuto di quei venti, la libertà fu restituita a tutti coloro a cui era dovuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000711,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"1504501",
