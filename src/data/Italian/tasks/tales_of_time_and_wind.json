			"dialogs": [
				{
					"id": 100070101,
					"content": "...Lo prenderò come un sì, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070102,
					"content": "Venti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070103
					]
				},
				{
					"id": 100070103,
					"content": "#Ah, finalmente! Sei qui, {NICKNAME}! Per caso hai un messaggio per me da parte di qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070104,
						100070105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070104,
					"content": "Un messaggio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				},
				{
					"id": 100070106,
					"content": "\"Non c'è nessuna profezia su di te in quel dizionario.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070107,
					"content": "È questo che stavi per dire, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070108,
						100070109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070108,
					"content": "Già.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070110,
					"content": "#Eh? Solo un attimo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070111,
					"content": "Mm... La tua curiosità sembra forte come sempre, Barbeloth. Ahimè, il mio \"futuro\" dovrà rimanere assente nel tuo dizionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070112,
					"content": "Il vento può anche essere felice di concedere ai denti di leone di tracciarne la forma, e ai poeti di cantarlo in versi, ma essere contenuto non è certo nella sua natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070113
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070113,
					"content": "Quindi, cara Barbeloth, ti prego di posare la penna. Le parole portate dal vento non sono destinate a essere trascritte sulla carta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070114,
					"content": "Se t'interessa davvero questa leggenda, permettimi di trasformarla in una poesia. Non mancherò di condividerla con voi signore al nostro prossimo tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070115,
					"content": "Barbeloth? Lei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070116
					]
				},
				{
					"id": 100070116,
					"content": "Ahahah, Barbeloth è sempre stata una persona ragionevole, e credo che abbia ascoltato la mia richiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070117,
					"content": "Pertanto, per ora la nostra conversazione dovrebbe essere libera da interruzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070118
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070118,
					"content": "Aspetta, Barbeloth ci stava ascoltando? P-Paimon non si è accorta di nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070119,
					"content": "Beh, è una maga dell'Hexenzirkel. Hanno tutte qualche asso nella manica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070120,
					"content": "Comunque te ne sei accorto subito, e sei anche riuscito a farla andare via. Questo non ti rende il vero \"maestro\" qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070121,
					"content": "Mmm... Considerando i vari fattori pratici in gioco, mi definirei un maestro... con dei limiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070122,
					"content": "Eccoti di nuovo a fare il misterioso. Comunque, non c'era assolutamente nulla su di te in quel dizionario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070123,
						100070124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070123,
					"content": "Sì, lei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070125,
					"content": "La tua presenza è sufficiente. La \"profezia\" di Barbeloth su di me potrebbe essere \"incompleta\", ma non è \"incorretta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070126,
					"content": "C'è qualcosa che devo fare, e potrei davvero aver bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070127,
						100070128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070127,
					"content": "Di che si tratta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070129,
					"content": "Eheh, affidabile come sempre. In tal caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070130,
					"content": "#Potresti suonare una canzone con me più tardi, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070131,
						100070132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070131,
					"content": "Eh? Cioè, certo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070133,
					"content": "Sì, esatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070134,
					"content": "Ma non preoccuparti. Non è un'esibizione che deciderà il destino di qualche evento importante... È solo un duetto tra amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070135
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070135,
					"content": "L'ultima volta che ho suonato questa melodia, il vento ululante era il mio unico pubblico, e le note si disperdevano in tutte le direzioni, lasciando solo frammenti della melodia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070136,
					"content": "#Ma ora, con {F#un'amica}{M#un amico} come te al mio fianco, perché dovrebbe essere solo il vento a testimoniare questa musica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070137,
					"content": "#Inoltre, penso che le mie mani saranno molto più stabili se suonerò accanto a {F#un'amica fidata}{M#un amico fidato} come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070138
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070138,
					"content": "Darò il meglio di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070139
					]
				},
				{
					"id": 100070139,
					"content": "Non chiedo altro. Ora andiamo al luogo dell'esibizione. Se seguiremo la brezza, ci arriveremo in un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070132,
					"content": "Ma vuoi che faccia solo questo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070128,
					"content": "Puoi contare su di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070124,
					"content": "Mi ha detto di venire qui e aspettare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070109,
					"content": "Le maghe volevano comunque che venissi a trovarti, però.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070105,
					"content": "Veramente, ehm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				}
			]
		},
