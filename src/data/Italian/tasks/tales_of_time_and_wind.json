			},
			"dialogs": [
				{
					"id": 100070501,
					"content": "Ah, sembra che la nostra musica abbia spinto qualcuno del pubblico a salire sul palco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070502,
					"content": "Ma questo è contro le regole del concerto, quindi accompagniamoli fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
