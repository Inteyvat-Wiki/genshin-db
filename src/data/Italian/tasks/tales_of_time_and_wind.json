				]
			},
			"dialogs": [
				{
					"id": 100070301,
					"content": "Paimon pensava che avremmo dovuto volare molto lontano, ma sembra che siamo appena fuori città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
