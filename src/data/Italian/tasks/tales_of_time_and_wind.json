					}
				]
			},
			"dialogs": [
				{
					"id": 100070701,
					"content": "#Bene, questo dovrebbe bastare. È stata un'esibizione squisita, {NICKNAME}. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070702,
					"content": "Quel potere che hai scatenato poco fa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "Ah, non preoccuparti. Quel potere era mio e mio soltanto. Non c'è stato alcun aiuto esterno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070704,
					"content": "Vedilo come... accordare uno strumento musicale affinché possa suonare melodie ancora più belle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070705,
					"content": "Ah, quindi hai qualche asso nella manica! Che altro nascondi, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070706,
					"content": "Oh, Paimon. Quanti trucchi potrei mai avere? Dopotutto, ho solo due maniche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070707,
					"content": "Sai bene che Paimon non intendeva questo, Bardo stonato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070708,
					"content": "Ahahah, ho la sensazione che oggi il vento sarà particolarmente forte. Dovremmo tornare a Mondstadt e dire alla gente di tenersi stretto il cappello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
