					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100070401,
					"content": "Quest'isola...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "È speciale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "Non sempre. Un tempo era un'isola come tutte le altre, un ordinario, modesto accumulo di sabbia e ghiaia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070404,
					"content": "Finché i semi delle storie non furono portati qui dal vento e coltivati dal tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070405,
					"content": "In seguito il vento portò nuove storie, e il tempo le fece crescere fino a farle diventare leggende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070406,
					"content": "#Detto questo... Permettimi di darti il \"vero\" benvenuto su quest'isola prediletta dal Tempo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070407,
					"content": "Questo è il luogo dove il Tempo e il Vento s'incontrarono nel lontano passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070408,
					"content": "Woah, woah, woah... All'improvviso sei diventato così serio, Bardo stonato. Neanche Paimon è sicura di riuscire più a seguire questa conversazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070409,
					"content": "Eheh, non preoccuparti, cara Paimon! Le storie migliori iniziano sempre con un po' di suspense e mistero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
