			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bu'yun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(Secondo Keqing, dovremmo dire così...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "Scusate, vendete la luna qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "Sì. Quante ne volete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210304,
					"content": "Non è molto indicato parlare di numeri in questo luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "#Ah, ben detto. Prego, usate questo per ascendere alla Dimora di giada... Ah, sì. A proposito: siete voi {F#le}{M#i} due ospiti che Lady Ningguang deve ricevere oggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210306,
					"content": "Sì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "(Però il codice che hanno usato non era quello per gli ospiti, bensì quello per la Yuheng. Che sta succedendo qui...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bu'yun"
				}
			]
		},
		{
			"id": 102104,
			"completionStepIds": [
				102104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102104",
							"2"
						],
						"stepId": 102104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "Ti stavo aspettando, tu che sei di ritorno dai Monti di Jueyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210402,
					"content": "Ah, è Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210403,
					"content": "Essendo il nostro primo incontro, ehm, ti abbiamo preparato un dono! Speriamo che ti piaccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210404,
					"content": "#Oh, per me? Vi ringrazio. Mi dispiace se vi ho fatto faticare tanto, considerato che siete {F#mie}{M#miei} ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210405,
					"content": "Eheh... Oh, no: nessun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210406,
					"content": "Davvero bella, questa Dimora di giada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "Ahah, sono lieta che piaccia anche a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210409,
					"content": "Questo palazzo fluttua nel cielo, più in alto di qualsiasi vetta. Da questa posizione di vantaggio è possibile osservare tutta Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210410,
					"content": "Ho iniziato a raccogliere i fondi necessari per edificarlo quando ho cominciato ad apprendere i segreti dei mercanti. E quando sono diventata la Tianquan, non ho badato a spese per ingaggiare i migliori artigiani ed espanderlo sempre più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210411,
					"content": "All'inizio era grande solo quanto una stanza. Ora è in grado di coprire la luna nei cieli di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210412,
					"content": "E sono certa che un giorno la sua ombra si stenderà su tutte le sette nazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210413,
					"content": "(Alla Tianquan l'ambizione non manca di certo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "Non sono molti i forestieri di Liyue che ottengono il diritto di ascendere alla Dimora di giada, ma ho scambiato delle missive con la Gran Maestra Reggente dei Cavalieri di Favonius, che mi ha parlato molto bene di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210415,
					"content": "Pertanto, ho incaricato qualcuno di mettersi sulle vostre tracce non appena avete raggiunto Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210416,
					"content": "Ma cosa c'entra?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210417,
					"content": "E sono venuta a sapere dei vostri spostamenti quando vi stavate dirigendo alla Locanda Wangshu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210418,
					"content": "Un momento... Ma allora Verr Goldet era una dei tuoi?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210419,
					"content": "Solo Verr Goldet? No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210420,
					"content": "Tutti alla Locanda Wangshu sono dei miei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210421,
					"content": "##@&%*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210422,
					"content": "#Di recente, ci siamo anche imbattut{F#e}{M#i} nella Yuheng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "Presso la balista Guizhong, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210424,
					"content": "#Ehm... Non ci avrai spiat{F#e}{M#i} da quassù per tutto il tempo... vero?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210425,
					"content": "Ahah... Temo che sia un po' difficile osservare qualcuno da un'altitudine tanto elevata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210426,
					"content": "I nostri occhi e le nostre orecchie sono più che sufficienti. Siete due persone molto interessanti, dopotutto. Sviluppare un certo interesse è naturale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210427,
					"content": "Keqing ha detto che le Sette Stelle non avrebbero mai voluto il male di Rex Lapis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "#Beh, non mi aspetto che vi fidiate di noi, considerando che avete avuto molte più interazioni con gli Adepti. Vi ho invitat{F#e}{M#i} qui per chiarire alcuni malintesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210408,
					"content": "È la prima volta che raggiungo un posto tanto elevato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
			"completionStepIds": [
				102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102106",
							"2"
						],
						"stepId": 102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210601,
					"content": "Wow! Che sala gigantesca! Paimon non ha mai visto un posto tanto elegante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210602,
					"content": "Rilassatevi pure. Fate come se foste a casa vostra, se lo desiderate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210603,
					"content": "Possiamo davvero?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210604,
					"content": "#Vi ho invitat{F#e}{M#i} qui come amic{F#he}{M#i}. E quando degli amici si ritrovano, è importante che si divertano, naturalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210605,
					"content": "È quello che credo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "Oooh! Ma non è quella bacheca leggendaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210607,
					"content": "Oh, vedo che sei informata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210608,
					"content": "È perché ne parlano perfino i cantastorie... Tutti sognerebbero anche solo un pezzo di carta proveniente da quella bacheca. È famosissima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210609,
					"content": "Lo è perché vi sono affissi i segreti di Liyue. I mercanti sono sempre stati attratti dai segreti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210610,
					"content": "#Ma i segreti del mondo dei mercanti non sono di alcun interesse per te, giusto, viaggiat{F#rice}{M#ore}? Tu sei davvero speciale, e credo che tu ne sia consapevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210611,
					"content": "Se possibile, vorrei avere la tua fiducia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210612,
					"content": "Ma se dovessi scegliere di chi fidarti tra me e Keqing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210613,
					"content": "Beh, tra la tua osservanza delle regole e la sua dissidenza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "Ahah... Sceglieresti Keqing? Un po' me lo sentivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210616,
					"content": "All'inizio la credevo un po' troppo... testarda. Con qualcuno come lei tra le Sette Stelle, ho dovuto rimediare a un po' di problemi aggiuntivi dietro le quinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210617,
					"content": "Ma poi ha detto: \"L'era degli Adepti è tramontata da tempo. Se nemmeno le Sette Stelle di Liyue vogliono affrontare la verità, che futuro può esserci per Liyue?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210618,
					"content": "A quel punto, beh, devo dire che diversi dei miei dubbi si sono dissipati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210619,
					"content": "Non negherò che la scomparsa di Rex Lapis paia utile ai nostri scopi. Ma per il bene di Liyue non possiamo permetterci che c'incatenino alle dicerie sulla nostra brama di potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210620,
					"content": "Immagino che dietro a queste dicerie ci siano anche i Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "Esatto... A quanto pare hai capito cosa intendevo dire sin dall'inizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210622,
					"content": "Ho ordinato io l'obbligo di silenzio e che l'Exuvia venisse nascosta, in modo da stabilizzare temporaneamente la situazione ed evitare che si ripetesse qualcosa di simile all'incidente di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210623,
					"content": "Con la morte di Rex Lapis, i Fatui si sono dedicati a molte attività clandestine al di là dei propri incarichi ufficiali. In quanto Tianquan e responsabile di Liyue, non posso fermarmi solo alle apparenze quando si tratta di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210624,
					"content": "Consentire la celebrazione del Rito dell'ascensione significava anche guadagnare del tempo per consentirci di assumere il controllo amministrativo di Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210625,
					"content": "Uff... Zhongli aveva ragione. Le Sette Stelle hanno messo a disposizione il luogo per celebrare il rito solo per poterci usare per i loro scopi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210626,
					"content": "Aspetta un attimo! A proposito di scopi... Paimon può dire un'altra cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210627,
					"content": "Ma certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210628,
					"content": "#Paimon ha sentito dire che chi ti porta un dono ottiene qualcosina in cambio... Questo vale anche per {NICKNAME} e Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210629,
					"content": "Stai dicendo sul serio, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "Oh, non ti preoccupare. Mi piacciono le persone senza peli sulla lingua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210631,
					"content": "Beh, di recente vi abbiamo causato non pochi problemi. Faremo così... Potrete prendere un qualsiasi oggetto qui presente e portarlo con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210632,
					"content": "#Evviva! Paimon aspettava solo che lo dicessi! Vediamo, cosa potrebbero prendere {NICKNAME} e Paimon...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210633,
					"content": "Uno dei <color=#00E1FFFF>fogli</color> su quella bacheca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210634,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "Non guardare Paimon in quel modo! Uno di quei fogli vale una barcata di soldi, anche uno piccino come l'unghia del mignolino di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210636,
					"content": "Immagina... quanti Mora ci farebbe guadagnare un foglio intero e in buono stato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210614,
					"content": "Sceglierei Keqing e il suo scetticismo verso le divinità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
		{
			"id": 102108,
			"completionStepIds": [
				102108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102108",
							"2"
						],
						"stepId": 102108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Meng Dan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210801,
					"content": "#Fiuuu... Grazie per il vostro aiuto, gentili viaggia{F#trici}{M#tori}. Se non mi aveste aiutato, sarei marcito in questa cella! Quei Cacciatori di tesori... Quando sono di buon umore sono ben felici di cambiare la disposizione di quei Fiordolci, ma quando gli gira storto, preferiscono cambiare i connotati a qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210802
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210802,
					"content": "Ah, nessun problema. Non c'è bisogno di affrettarsi a ringraziarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210803,
					"content": "#Ahah, capisco. Non preoccupatevi: ricompenserò entramb{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210804
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210804,
					"content": "Davvero, non ce n'è bisogno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210805
					]
				},
				{
					"id": 10210805,
					"content": "Non dire così! Sono salvo solo grazie a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210806
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210806,
					"content": "Sono Meng Dan, un fornitore della Gioielleria Mingxing, al Porto di Liyue. Visito spesso queste montagne in cerca di oggetti d'antiquariato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210807
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210807,
					"content": "Non mi sarei mai aspettato che quei Cacciatori di tesori avessero messo gli occhi sulle stesse rovine che volevo esplorare io. Mi hanno catturato e imprigionato in un batter d'occhio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210808
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210808,
					"content": "Avete bisogno di qualche cosa? Antiquariato, gioielli, gingilli di ogni tipo: ditemi pure! Beh, sempre che abbia qualcosa d'interesse per voi, ovvio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210809
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210809,
					"content": "La tua riconoscenza è già una ricompensa sufficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210810
					]
				},
				{
					"id": 10210810,
					"content": "Aspetta un attimo! A dire il vero stiamo cercando qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210811,
					"content": "Oh? Ossia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210812
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210812,
					"content": "Hai una scatola in cui potremmo mettere un regalo? Magari una carina... adatta a dei dolci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210813,
					"content": "Certo che sì: come potrei vendere antiquariato senza scatole regalo? Noi della <color=#00E1FFFF>Gioielleria Mingxing</color> abbiamo il servizio di impacchettamento regali migliore di tutte le sette nazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210814
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210814,
					"content": "Se mi scusate un momento, informerò subito il capo. Quando avrete bisogno della scatola, vi basterà rivolgervi a lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210815
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210815,
					"content": "Fantastico! Ora il Melmoso glassato di Paimon avrà una confezione bellissima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102111,
			"completionStepIds": [
				102111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
