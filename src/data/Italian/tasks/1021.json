					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213002
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10213002,
					"content": "Bene... È tempo di pulire quella pentola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingxi"
