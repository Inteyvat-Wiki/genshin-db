				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10213101,
					"content": "Allora, hai deciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213102,
					"content": "Non c'è bisogno che mi mostri quanto hai scelto. Scegli qualcosa e prendilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213103,
					"content": "Dopo che ne dici di sederti un po' nella Dimora di giada o di fare una breve passeggiata? Anche il riposo è una parte fondamentale di ogni viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213104,
						10213106
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213104,
					"content": "Grazie per la tua ospitalità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213105
					]
				},
				{
					"id": 10213105,
					"content": "Forza, non c'è bisogno di essere così formali. Rilassati un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213106,
					"content": "Dobbiamo andare. Alla prossima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213107
					]
				},
				{
					"id": 10213107,
					"content": "E va bene. Spero che la prossima volta che ci incontreremo avrai già fatto la cosa giusta... o starai per prendere la decisione adeguata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		}
	]
