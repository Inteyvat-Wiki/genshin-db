			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211201,
					"content": "Eh? Beh, è stata una ricerca facile. Il foglio più grande è proprio qui, nel punto più ovvio. Prendiamolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211202,
					"content": "La la-la la-la... Vediamo che c'è scritto sopra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211203,
					"content": "Eh? Qui c'è un posto cerchiato di rosso. Oooh, che sia un tesoro?!? Qualunque cosa sia, meglio che ci faccia vivere nel lusso smodato! Vediamo che c'è scritto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211204,
					"content": "\"Sigillo... del consenso\", eccetera eccetera... \"Fatui...\", \"ricerche...\", \"copia...\". Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211205,
					"content": "Ah, non sembra per niente un tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211206,
					"content": "Questo foglio dice che una spia delle Sette Stelle ha trovato delle tracce di ricerche segrete dei Fatui sul <color=#00E1FFFF>Sigillo del consenso</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211207,
					"content": "Oh, Ningguang diceva che i Fatui stanno commettendo un sacco di malefatte all'ombra di Liyue... Diffondono calunnie, vogliono mettere le mani sul corpo dell'Archon e così via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211208,
					"content": "Ma delle ricerche sul Sigillo del consenso? Paimon si chiede cosa stiano architettando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211209,
					"content": "#A proposito, esiste anche un qualche legame tra te e il Sigillo del consenso, {NICKNAME}. Forse ci saranno comunque delle sorprese per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211210,
						10211211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211210,
					"content": "È tutto un po' troppo perfetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				},
				{
					"id": 10211212,
					"content": "Oh? Lo credi davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211213,
					"content": "Beh... Allora non andiamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211214,
					"content": "No, quello che intendo è...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211215
					]
				},
				{
					"id": 10211215,
					"content": "Oh, quindi stai dicendo che è proprio perché non ci si può fidare del tutto di Ningguang che sarebbe meglio verificare quanto dice di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211216,
					"content": "Mmmh... È una cosa che Paimon non capisce bene. Secondo Paimon lei è stata molto buona con noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211217,
					"content": "Comunque sia, magari hai ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211218,
					"content": "Ehm, prima di andare a cercare Zhongli alla Palude di Dihua, raggiungiamo il posto cerchiato su questo foglio e vediamo se davvero i Fatui stanno combinando qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211211,
					"content": "Chiaramente, Ningguang sta cercando di condurci a queste conclusioni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				}
			]
		},
		{
			"id": 102113,
			"completionStepIds": [
				102113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102113",
							"2"
						],
						"stepId": 102113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211301,
					"content": "Credo che abbiate sentito parlare della Guerra degli Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211302,
						10211303
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211302,
					"content": "Ehm... Mi dice qualcosa, sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				},
				{
					"id": 10211304,
					"content": "Un tempo, molti dèi vivevano in questo mondo, e per duemila anni combatterono molte lunghe guerre. Si versò molto sangue, e innumerevoli vite furono perse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211305
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211305,
					"content": "Alla fine, a Teyvat rimasero solo sette vincitori. Fondarono città e nazioni sui cadaveri dei loro nemici, dando così inizio all'era dei Sette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211306
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211306,
					"content": "Da qui si vede la Foresta di pietra di Guyun, vero? Non è una formazione rocciosa naturale: quelle sono lance di roccia gigantesche scagliate da Rex Lapis durante la guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211307
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211307,
					"content": "Sotto di esse giacciono coloro che Rex Lapis sconfisse a quei tempi: dèi che non riuscirono a guadagnarsi il titolo di Archon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211308
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211308,
					"content": "Non solo gli dèi possono morire, ma anche i membri dei Sette sono cambiati negli ultimi due millenni. La morte di Rex Lapis è un disastro inimmaginabile per Liyue, ma l'ordine dei Sette non crollerà semplicemente per questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211309
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211309,
					"content": "Prima o poi sorgerà un nuovo Signore di Geo, ma come possiamo dimenticare Rex Lapis? Quando sarà il momento, i rapporti tra la gente di Liyue, gli dèi e gli Adepti cambieranno sicuramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211310
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211310,
					"content": "Persino in una nuova era, le Sette Stelle di Liyue rimangono gli ex sudditi di Rex Lapis... Ci credete davvero capaci di aver cospirato per causarne la morte? O credete che non avessimo la capacità di prevederne le ovvie ripercussioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211311
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211311,
					"content": "Ma perché nascondere l'Exuvia, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211312
					]
				},
				{
					"id": 10211312,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211313
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211313,
					"content": "Quel giorno, al Belvedere di Yujing... è successo tutto all'improvviso. Anch'io sono stata colta completamente alla sprovvista. C'eri anche tu, l'avrai visto di sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211314
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211314,
					"content": "Ma il nostro nemico si cela da tempo all'interno del porto. Se non agiamo subito contro di lui, otterrà di certo un vantaggio su di noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211315
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211315,
					"content": "Nascondere l'Exuvia era necessario per riprendere l'iniziativa, per tornare a essere il ragno in paziente attesa delle sue prede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211316
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211316,
					"content": "Chi è questo \"nemico\" di cui parli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211317,
					"content": "#Secondo te, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211318,
						10211319
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211318,
					"content": "È \"lui\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211320,
					"content": "Eh? Di cosa state parlando, voi due?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211321,
					"content": "Ben detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211322
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211322,
					"content": "Eeeh?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211323,
					"content": "Ah... Qui fuori il panorama magnifico, ma il vento è un po' troppo forte. Siamo pronti a ricevervi con tutti gli onori, ora. Prego: da questa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211319,
					"content": "È \"lui\", non è vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "Solo a grandi linee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
		},
