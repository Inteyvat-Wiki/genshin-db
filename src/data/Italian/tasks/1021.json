			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211101,
					"content": "Ehilà! Un tizio di nome Meng Dan ci ha detto che potevamo prendere una bella scatola sfavillante dal tuo negozio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211102,
					"content": "#Zio Meng mi ha già avvisata. Grazie a entramb{F#e}{M#i} per averlo salvato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211103
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211103,
					"content": "Molti degli articoli migliori del nostro negozio li ha trovati zio Meng. Se gli fosse successo qualcosa, avremmo dovuto chiudere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211104
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211104,
					"content": "Ecco qui: questo contenitore è un pezzo molto antico, ha almeno centoquarant'anni. L'abbiamo già pulito... Può andare bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211105
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211105,
					"content": "Sì, sì, sì! È perfetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211106,
					"content": "Aspetta un attimo. Possiamo prendere in prestito un'altra cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211107,
					"content": "Certo, servitevi pure: basta che sia sui nostri scaffali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211108
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211108,
					"content": "#{NICKNAME}, questa pentola di terracotta è stupenda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211109,
					"content": "Se usiamo un oggetto antico per preparare il nostro dolce, verrà buonissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211110,
					"content": "Ecco fatto! L'unico e inimitabile Melmoso glassato! Piano, ora. Lo mettiamo nella scatola e lo spolveriamo con un altro po' di zucchero a velo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211111,
					"content": "Oh, giusto. Perché non usate anche quei fiori appena colti come decorazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211112
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211112,
					"content": "Wow! Che splendore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211113,
					"content": "(Questo regalo non mi convince ancora molto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211114
					]
				},
				{
					"id": 10211114,
					"content": "Fantastico! Ora che abbiamo messo tutto il necessario in questa scatola, andiamo alla Dimora di giada a incontrare Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102112,
			"completionStepIds": [
				102112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
