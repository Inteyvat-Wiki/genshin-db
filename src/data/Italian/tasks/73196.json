			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961601,
					"content": "Nella vita bisogna perseguire la felicità! Salpa da casa ed esplora il mondo! Unisciti subito alla Giunta degli avventurieri! Per soli cinque Mora per il primo mese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961602,
					"content": "L'autentica conoscenza si ottiene solo con il vero esercizio. Spirare in una faticosa traversata è molto più significativo che oziare per tutta la vita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961603,
					"content": "\"Attenzione! Non è stato scritto dalla Gilda degli avventurieri, ma dalla Giunta degli avventurieri!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961604,
					"content": "\"Cosa?!? Ho pagato un intero anno di iscrizione! Posso riavere indietro i soldi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319617,
			"completionStepIds": [
				7319617
