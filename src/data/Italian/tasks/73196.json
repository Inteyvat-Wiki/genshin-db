				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961301,
					"content": "A causa delle lamentele dei consumatori, Le Tinte di Ain è stato chiuso per sospetto furto di abbigliamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961302
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961302,
					"content": "Le Tinte di Ain è stato trovato completamente vuoto. Stiamo lavorando per recuperare gli oggetti rubati dei denuncianti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
