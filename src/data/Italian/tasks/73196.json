			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961401,
					"content": "A proposito della proprietà del Bar Puspa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961402
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961402,
					"content": "È stato accertato che il proprietario originario è scomparso durante una spedizione nel deserto tre anni fa. In base alla normativa, è previsto che la gestione del bar passi alla Vahumana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961403
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961403,
					"content": "Decisione: a causa del ritiro del reclamo da parte del ricorrente, il caso è stato sospeso a tempo indeterminato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319615,
			"completionStepIds": [
				7319615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
