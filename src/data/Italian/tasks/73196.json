			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961501,
					"content": "\"Se vi trovate al Gran Bazaar, non potete proprio perdervi il Teatro Zubayr.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961502,
					"content": "\"Uno spettacolo a cui bisogna assolutamente assistere è la danza di Nilou!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961503,
					"content": "\"Perdersi la Danza del Sabzeruz di Nilou durante un viaggio a Sumeru è come averlo sprecato completamente!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319616,
			"completionStepIds": [
				7319616
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
