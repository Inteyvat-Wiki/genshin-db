			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960101,
					"content": "Questa è la bacheca della Borsa di Kalimi, dove i commercianti nazionali ed esteri possono pubblicare informazioni commerciali. Sono vietati i messaggi non pertinenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319602,
			"completionStepIds": [
				7319602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319602",
							"2"
						],
						"stepId": 7319602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960201,
					"content": "Questa Borsa compie ogni sforzo possibile per garantire l'accuratezza e l'affidabilità di tutte le informazioni fornite, ma non ne garantisce in alcun modo l'accuratezza e l'integrità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960202,
					"content": "I clienti non possono effettuare reclami per perdite derivanti dall'utilizzo, parziale o totale, di informazioni di mercato pubblicate su questa bacheca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "Avete mai sentito parlare di levitazione? Avete mai visto qualcuno volare? Volete scoprire i segreti della bestia da soma volante? Allora non perdetevi la prima esibizione a Sumeru dei Levitanti di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960302,
					"content": "\"Benvenuti, lo spettacolo ha inizio! Non perdetevi questa esibizione unica nel suo genere. Solo cinque Mora a biglietto!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960303,
					"content": "A seguito di segnalazioni da parte del pubblico, abbiamo scoperto che questo spettacolo non è stato approvato dall'Akademiya, il loro permesso è stato revocato e l'annuncio verrà immediatamente rimosso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319604",
							"2"
						],
						"stepId": 7319604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "La nostra banca sta per aprire un ufficio a Sumeru! Invitiamo i nostri stimati futuri clienti a farci presto visita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960402,
					"content": "Se avete qualche affare da sbrigare, siete pregati di contattare Viktor presso la nostra filiale di Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960403,
					"content": "\"Se state pensando di chiedere un prestito, il nostro agente è disponibile per un consulto oggi stesso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319605",
							"2"
						],
						"stepId": 7319605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960501,
					"content": "\"Tappeti lavorati a mano, un capolavoro dell'arte di Sumeru!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960502
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960502,
					"content": "\"Tappeti irrinunciabili per ogni cittadino di Sumeru!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960503,
					"content": "\"I tappeti hanno un prezzo, ma l'arte no!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319606,
			"completionStepIds": [
				7319606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319606",
							"2"
						],
						"stepId": 7319606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960601,
					"content": "Qualità eccellente a prezzi accessibili. Le Spezie di Jut è quello che fa per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960602
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960602,
					"content": "Acquistate ora e riceverete un omaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319607,
			"completionStepIds": [
				7319607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319607",
							"2"
						],
						"stepId": 7319607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "Vendiamo un vasto assortimento di beni di prima necessità. Tutti i nostri articoli sono stati ispezionati personalmente dal proprietario. La qualità è garantita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960702,
					"content": "\"Papà, puoi prestarmi un altro po' di Mora? Ho sentito che il prezzo delle noci di Ajilenakh salirà presto alle stelle. Questa volta farò sicuramente un bel gruzzolo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319608,
			"completionStepIds": [
				7319608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319608",
							"2"
						],
						"stepId": 7319608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960801,
					"content": "Vorremmo acquistare le \"Statue d'oro perdute di Kazeni\". Il prezzo è trattabile. Si prega di contattare il proprietario del negozio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960802,
					"content": "Se avete informazioni al riguardo, venite da Menakeri e contattate Khalid. Vi aspetta una ricompensa per il disturbo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319609,
			"completionStepIds": [
				7319609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319609",
							"2"
						],
						"stepId": 7319609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960901,
					"content": "Autentico barbecue del deserto! Con salsa segreta di Re Deshret e spezie locali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731960902,
					"content": "Ottimo cibo e fantastiche bevande per tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319610,
			"completionStepIds": [
				7319610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319610",
							"2"
						],
						"stepId": 7319610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "\"Un tempo possedevo ricchezze infinite, ma l'ostentazione non riusciva a placare il mio cuore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961002,
					"content": "\"Dopo questo viaggio, non mi è rimasto nemmeno un Mora in tasca, eppure mi sento in pace.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961003,
					"content": "\"Se volete ascoltare la mia storia, venite al mio negozio di ortofrutta. Naturalmente, già che ci siete, fareste bene a comprare delle verdure.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319611,
			"completionStepIds": [
				7319611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
