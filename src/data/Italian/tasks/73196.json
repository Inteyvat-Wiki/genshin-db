					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961101,
					"content": "Le Tinte di Ain forniscono un modo per aggiungere raffinati e nuovi colori ai vostri vestiti nella maniera più professionale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961102,
					"content": "\"Quando potrò ritirare i vestiti che ho portato qui il mese scorso?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961103,
					"content": "\"Le nostre scuse più sentite! Mia moglie ha partorito ieri, quindi non ho avuto tempo di lavorare. La prego di tornare domani. Le garantisco che saranno pronti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961104,
					"content": "\"Sono passati tre mesi. Restituiscimi i vestiti e basta. Non li voglio più tingere.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961105,
					"content": "\"Mi dispiace! Un ladro ha rubato i vestiti mentre si stavano asciugando dopo il processo di tintura. Bisognerà dare la caccia al ladro per recuperarli.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319612,
			"completionStepIds": [
				7319612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
