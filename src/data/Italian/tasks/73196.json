			},
			"dialogs": [
				{
					"id": 731961701,
					"content": "\"Tutti hanno sentito parlare di Lord Sangemah Bay, quindi non c'è bisogno di presentazioni.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961702
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961702,
					"content": "\"Comunque, è arrivato un nuovo lotto di tappeti. Non volano, ma sono migliori di quelli di Sulaykha! Affrettatevi se ne volete uno! Sapete già come funziona. Eheh!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961703
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961703,
					"content": "\"Dori, sei una vergogna!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		}
