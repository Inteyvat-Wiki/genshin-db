			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961201,
					"content": "Siamo specializzati in servizi commerciali all'estero e contiamo su una collaborazione a lungo termine con flotte potenti come la Crux per scortare la merce in modo sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961202,
					"content": "Quest'estate abbiamo aperto quattro nuove rotte per prodotti come seta, spezie e minerali, e le nostre nuove navi hanno grandi capacità di carico. Vi invitiamo caldamente a lavorare con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731961203,
					"content": "Se volete prenotare l'intera rotta, siete pregati di rivolgervi a Farzaneh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319613,
			"completionStepIds": [
				7319613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
