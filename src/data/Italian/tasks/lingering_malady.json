				{
					"id": 708120501,
					"content": "Hai preso tutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120502
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120502,
					"content": "Sì!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708120503
					]
				},
				{
					"id": 708120503,
					"content": "Ti ringrazio infinitamente. Dammi pure i manifesti. Mi assicurerò che vengano consegnati ai relativi mercanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120504
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120504,
					"content": "Per quanto riguarda l'insegna, ho già chiesto a Charles di mandare qualcuno per riportarla al Dono dell'Angelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120505
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120505,
					"content": "Ecco a te un piccolo compenso per il tuo inestimabile aiuto. Ti prego, prendilo. Per quanto riguarda me, ho altri compiti di cui devo occuparmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708120506
					],
					"speakerTitle": "Aramis"
				},
				{
					"id": 708120506,
					"content": "Nonostante la tempesta sia cessata, i suoi effetti si avvertiranno ancora per un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aramis"
				}
