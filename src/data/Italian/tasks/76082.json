	"talks": [
		{
			"id": 7601414,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7608201",
							"2"
						],
						"stepId": 7608201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "#Che c'è, {F#sorella}{M#fratello}? C'è qualcos'altro che vuoi chiedermi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141402,
					"content": "A proposito di quel granchio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "*sospira* Sembra spaventoso, ma è sempre stato gentile. Probabilmente tornerà alla normalità, ora che la pietra è sparita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141404,
					"content": "Ma per ora lasciamolo solo nascondersi e riflettere sulle sue azioni. Manipolato o meno, ciò che è fatto è fatto, e ha fatto male a quei piccoli granchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141405,
					"content": "Proprio come quel governatore cattivo sotto l'incantesimo dello specchio contro cui Reed Miller si è scontrato... le scuse non cambiano il fatto che hai dei torti da rimediare, e lo si fa con le azioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141406,
					"content": "A proposito di quella strana pietra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "Eheh, quella è la pietra dei{RUBY#[D]Pietra di Twardowska} desideri, un oggetto che può manipolare i cuori degli umani... Mmmh, o almeno credo sia questo il nome che diceva Hidimbi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141408,
					"content": "Ahem, comunque, è qualcosa che è caduto dal cielo, come quella roccia gigante là dove vivono gli Eredi della Luna gelata. Dato che è volata via, dovremmo essere al sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141409,
					"content": "A proposito della Banda della Conchiglia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "#Mmmh? Vuoi sapere qualcosa su di noi, {F#sorella}{M#fratello}? Certo. Dato che sei {F#un'amica}{M#un amico}, chiedi pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141411,
					"content": "Siamo tipo... mmmh, un'organizzazione di mutuo soccorso e coordinazione per le persone della stessa età con interessi simili. È un peccato che tu sia troppo grande per unirti, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141412,
					"content": "Se avessi mai bisogno di qualcosa a Nasha e io fossi nei paraggi, chiamami pure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141413,
					"content": "A proposito di quella strana persona di prima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "Oh, intendi quella sacerdotessa dai capelli viola. Non si è ancora mossa contro di noi, quindi per ora almeno non è nostra nemica. Ma dovremmo cercare di stare il più possibile alla larga da lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141415,
					"content": "La curiosità può essere letale. Anche Katya ci ha avvertito di non entrare in contatto con quei pazzoidi della Luna gelata, e per una buona ragione... Pensate che una volta sono quasi riusciti a catturare e a sacrificare alla loro Dea della Luna una Maestra ladra come me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141416,
					"content": "Sacrificata?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "Sì, quella gente fa davvero paura. Ho sentito che prendevano il sangue da diverse persone e... Ugh, mi vengono i brividi solo a pensarci. Meglio non parlarne più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141418,
					"content": "Per fortuna, quella che mi ha catturato era solo una ragazzina ingenua. Ha accettato di lasciarmi andare dopo che le ho raccontato qualche storia. Altrimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141419,
					"content": "N-Non ho avuto paura, davvero. Un Maestro ladro non ha mai paura! Ma lascia che ti dia un consiglio: stai alla larga da loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141420,
					"content": "Ah, giusto, quasi dimenticavo la fonte delle informazioni che ti avevo promesso prima. Ho scoperto tutto sugli Eredi della Luna gelata da Hidimbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141421,
					"content": "Se vuoi trovarla... Beh, credo che si trovi ancora a Nasha. Chiedi in giro e dovresti riuscire a scoprire qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141422,
					"content": "Credo che si prenderà una lunga pausa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "Mmh? Quindi l'hai già incontrata? Non mi ha accennato nessuna pausa... Ah, beh, non importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141424,
					"content": "Non mi sembra molto affidabile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "Oh, non preoccuparti. È super affidabile. Fidati di Maite e non preoccuparti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141426,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "#Certo. Abbi cura di te, {F#amica mia}{M#amico mio}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7608202",
							"2"
						],
						"stepId": 7608202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "Woah! Questo tipo è diventato ancora più grande di prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141702,
					"content": "Eheh, naturalmente. Dopo aver mangiato tutte quelle Baccalakka che ho trovato dopo tanti sforzi, Sua Maestà lo Tsar è diventato ancora più paffuto e cicciottello di te, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141703,
					"content": "Ehi! Piantala con questi strani paragoni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141704,
					"content": "#Woah! Sembra che sia improvvisamente pieno di energie... O, dovrei dire, che si è emozionato quando ti ha visto, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141705,
					"content": "Sembra che voglia sfidarti... Ahah, forse gli brucia ancora il fatto che tu l'abbia stracciato l'altra volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141706,
					"content": "Fatti sotto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "#Stai {F#attenta}{M#attento}. È molto più forte dell'ultima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141708,
					"content": "Eh? Adesso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "Non c'è davvero bisogno di assecondare i suoi capricci. Puoi accettare la sua sfida quando più ti aggrada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141710,
					"content": "Ora è sotto la mia protezione, quindi ascolterà quello che dico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141711,
					"content": "Dai, fai il bravo. Siediti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141712,
					"content": "Gli parli come se fosse il tuo cagnolino... Aspetta, i granchi non stanno già sempre seduti di loro natura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
