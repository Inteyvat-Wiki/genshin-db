				{
					"id": 760820405,
					"content": "Sì, quella gente fa davvero paura. Ho sentito che prendevano il sangue da diverse persone e... Ugh, mi vengono i brividi solo a pensarci. Meglio non parlarne più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820406
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820406,
					"content": "Per fortuna, quella che mi ha catturato era solo una ragazzina ingenua. Ha accettato di lasciarmi andare dopo che le ho raccontato qualche storia. Altrimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820407
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820407,
					"content": "N-Non ho avuto paura, davvero. Un Maestro ladro non ha mai paura! Ma lascia che ti dia un consiglio: stai alla larga da loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820408
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820408,
					"content": "Ah, giusto, quasi dimenticavo la fonte delle informazioni che ti avevo promesso prima. Ho scoperto tutto sugli Eredi della Luna gelata da Hidimbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760820409
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760820409,
					"content": "Se vuoi trovarla... Beh, credo che si trovi ancora a Nasha. Chiedi in giro e dovresti riuscire a scoprire qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				}
			]
		},
