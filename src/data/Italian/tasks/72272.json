			},
			"dialogs": [
				{
					"id": 722720102,
					"content": "Vorrei vendere dei tesori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "Eh? Beh, a dire il vero, siamo riusciti a ristabilire un regolare approvvigionamento di beni, e collezionare cianfrusaglie non è nostra abitudine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720104,
					"content": "Ma solo guardandoti, posso capire che devi avere qualcosa di veramente interessante tra le mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720105,
					"content": "Bene... Fammi dare un'occhiata allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720106,
					"content": "Racconti a Mikoshi Genichirou della Sfera d'osso di drago.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720108,
					"content": "Sarò onesto con te. È una storia davvero difficile da credere, nonostante sia molto interessante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720109,
					"content": "Quest'oggetto non rientra proprio nel mio campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720110,
					"content": "Ti prego, non prendermi in giro. Sono solo un semplice artigiano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720120,
					"content": "Cosa ne pensi di 80.000 e 5 piatti di sashimi? Attenzione, questi piatti sono molto costosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720111,
					"content": "Se accetti questo prezzo, comprerò il tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720112,
					"content": "...Cosa ci farai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "Non lo so ancora. Devo pensarci su.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720114,
					"content": "Nelle condizioni giuste, potrei trasformarlo in un netsuke speciale e venderlo a un prezzo decente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720115,
					"content": "D'accordo, è un prezzo ragionevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "Allora prendi questi Mora. Io mi metto a esaminare quest'oggetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720117,
					"content": "Fammici pensare ancora un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "Mi sembra giusto. Anch'io devo rifletterci un pochino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "Mikoshi Genichirou"
				},
				{
					"id": 722720119,
					"content": "Potrai tornare da me quando ci avrai pensato su.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikoshi Genichirou"
				}
			]
		},
