			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941201,
					"content": "\"Se state pianificando un viaggio nella Foresta pluviale, vi consiglio di fare attenzione. L'altro giorno, il mio mentore mi ha mandato proprio lì a raccogliere delle erbe e stavo quasi per lasciarci le penne a causa di una Tigre Chiomalunga.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731941202,
					"content": "\"Ho avuto molta fortuna nel ricevere l'aiuto di un'apprendista guardaboschi che si trovava nei paraggi. Si considerava solo un'apprendista, ma sembrava essere molto esperta, e soprattutto, mi ha dato del cibo delizioso per alleviare lo sgomento.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731941203,
					"content": "\"Ho sentito dire che è un'allieva di Tighnari. Come si suol dire: tale maestro, tale allievo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
