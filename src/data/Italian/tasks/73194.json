	"talks": [
		{
			"id": 7319401,
			"completionStepIds": [
				7319401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319401",
							"2"
						],
						"stepId": 7319401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "\"Questa bacheca è stata allestita dal Mahamata per pubblicizzare le questioni importanti della Città di Sumeru. Su di essa è anche possibile lasciare dubbi o domande riguardanti gli avvisi esposti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "\"Avete sentito? I Guardiani della foresta hanno trovato un palazzo magnifico a nord della foresta che sembra essere sorto dal nulla.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940202,
					"content": "\"Ma sembra che tutti quelli che ci sono andati siano stati derubati fino a rimanere in mutande. O almeno così è come li hanno trovati i Guardiani della foresta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940203,
					"content": "\"Piangevano tutti, rifiutandosi di raccontare l'accaduto. Roba da far accapponare la pelle.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940204,
					"content": "\"Meglio non andarsene a zonzo per la foresta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "\"Gli annunci in tutta Sumeru vengono visualizzati ora tramite l'Akasha. Preghiamo tutti d'indossare sempre il proprio Terminale dell'Akasha per non perdere nessun avviso importante.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940302,
					"content": "\"Questa bacheca sarà mantenuta in via temporanea per la comodità di commercianti stranieri, anziani e bambini. In futuro, potrebbe essere rimossa in qualsiasi momento, pertanto invitiamo gli interessati a non farci troppo affidamento.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "\"La distribuzione della Benedizione di Anahita di quest'anno è iniziata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940402,
					"content": "\"In linea di massima, la distribuzione avverrà secondo le politiche e i requisiti dello scorso anno. I dettagli sulle informazioni utili sono disponibili sull'Akasha.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940403,
					"content": "\"In caso di cambiamenti, invitiamo a contattare il Mahamata più vicino per inviare una richiesta di modifica.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "I casi di Eleazar in città sono aumentati. Se si riscontrano sintomi quali intorpidimento della pelle, debolezza degli arti o formazione di squame grigie e nere sul torso, si consiglia di recarsi immediatamente al Bimarstan per ricevere le cure necessarie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940502,
					"content": "Se non si inizia tempestivamente una terapia e si lascia che la patologia peggiori, si rischiano gravi conseguenze, tra cui l'invalidità. Pertanto, preghiamo tutti di prestare attenzione a questo avviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319406",
							"2"
						],
						"stepId": 7319406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "Promemoria speciale: gli Eremiti sono l'unica organizzazione di mercenari autorizzata a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940602,
					"content": "Non fidatevi facilmente degli estranei per evitare truffe da parte di malintenzionati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940603,
					"content": "Chiunque desideri ingaggiare guardie del corpo, addetti alla sicurezza, o abbia altre richieste, è invitato a contattare il parchamdar Rukh Shah del Gruppo dei Trenta o a pubblicare l'incarico tramite Effendi, l'intermediario dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319407",
							"2"
						],
						"stepId": 7319407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "Il Bimarstan è una struttura medica della scuola di Amurta che fornisce assistenza medica gratuita a tutti i residenti di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940702,
					"content": "I medici del Bimarstan sono autorizzati a praticare la propria attività dalla scuola di Amu{RUBY#[S]Biologia}rta, mentre le diagnosi e i piani di trattamento sono sottoposti a molteplici controlli da parte dell'Akasha. Forniamo servizi medici della massima professionalità e sicurezza per tutti i residenti di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940703,
					"content": "Al fine di evitare la perdita di denaro e danni irreversibili alla salute, invitiamo tutti a non fidarsi di medici non identificati o non abilitati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319408,
			"completionStepIds": [
				7319408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319408",
							"2"
						],
						"stepId": 7319408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940801,
					"content": "Per evitare furti, si prega di non trasportare ingenti quantità di Mora nelle aree affollate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940802,
					"content": "In caso di furto di oggetti personali, invitiamo tutti a non rivolgersi agli Eremiti presenti nelle vicinanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940803,
					"content": "È molto probabile che siano loro i responsabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319409,
			"completionStepIds": [
				7319409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
