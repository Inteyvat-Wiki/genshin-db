			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Dal momento che il Mahamata non userà più questa bacheca, sarà perfetta per pubblicare gli annunci della nostra taverna. Sentitevi liberi di lasciare un messaggio qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731941102,
					"content": "\"Sono arrivate le dieci casse di vino che ho ordinato? Ieri mi è stato detto di no.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731941103,
					"content": "\"Non è possibile! Poco fa, una persona dai capelli biondi è entrata qui sostenendo di condividere la stanza con te e ha preso tutto. Ricordo anche che l'altro giorno eravate insieme. Devi aver fatto un po' di confusione\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731941104,
					"content": "\"...Va bene. Ho capito.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319412,
			"completionStepIds": [
				7319412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
