				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941001,
					"content": "Manifesto di taglia: Mustah",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941002
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731941002,
					"content": "Quest'uomo si traveste da Mahamata per compiere estorsioni e rapine nel porto del Bazaar. La Cittadella di Regzar sta conducendo delle indagini su di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731941003,
					"content": "Secondo le ultime segnalazioni si nasconde nella giungla. Invitiamo tutti a segnalare eventuali avvistamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
