			},
			"dialogs": [
				{
					"id": 731940901,
					"content": "Manifesto di taglia: Kasim",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940902,
					"content": "Quest'uomo sostiene di essere il famoso bandito che viaggia da una nazione all'altra, ma in realtà è un impostore che non rientra nemmeno nei ranghi degli Eremiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731940903,
					"content": "Ultimamente sono stati segnalati molti casi di frode legati a questo individuo. Invitiamo tutti a rimanere vigili e a evitare di cadere vittima delle sue truffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319410,
			"completionStepIds": [
				7319410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319410",
