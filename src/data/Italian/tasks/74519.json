				"objectNames": [
					"Noelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "#Oh, salve, {F#Cavaliere Onoraria}{M#Cavaliere Onorario}! Sei qui per vedere Jean... Oppure c'è qualcosa in cui posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190402,
					"content": "Sto solo facendo una passeggiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "Al momento sto eseguendo una pulizia di routine dell'area intorno agli uffici dei Cavalieri di Favonius. La maggior parte della polvere è già stata rimossa. Poi, riorganizzerò i nostri vecchi fascicoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190405,
					"content": "Quei documenti si sono accumulati da un po' di tempo. Penso che sarà più facile per tutti consultarli se li ordino in diverse categorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190406,
					"content": "Inoltre, posso imparare molto da coloro che mi hanno preceduto in questo processo. Anche questo è una forma di addestramento, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190407,
					"content": "Sei seria come sempre riguardo al tuo lavoro, Noelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "Faccio solo il mio dovere. Tu e gli altri Cavalieri fate sempre progressi, quindi cerco di raggiungervi il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190409,
					"content": "La tua determinazione merita di essere ricordata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "Eh? Io? Oh, ma certo, prego! È solo che... ho appena finito di pulire, quindi sarò coperta di polvere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190412,
					"content": "Ah, ma è proprio questo il punto! Intendo immortalarti proprio quando ti sei impegnata al massimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "Ehm... N-Non è un po' troppo presto per chiamarmi così? Ma se desideri scattare una foto... Ne sarei onorata, anche se sono coperta di polvere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190415,
					"content": "Sono certa che scatterai al momento perfetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190413,
					"content": "Intendo immortalare su pellicola il \"momento decisivo\" della domestica cavaliere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "...Quindi, permettimi di farti una foto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "Cosa stai facendo, Noelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
