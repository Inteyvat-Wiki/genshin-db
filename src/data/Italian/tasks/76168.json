			"dialogs": [
				{
					"id": 761680101,
					"content": "Ugh... Niente mi dà la carica per andare in pattuglia come una pagnotta di pane calda e deliziosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680102
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680102,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680103
					]
				},
				{
					"id": 761680103,
					"content": "Sto facendo rifornimento per la pattuglia, ma a quanto pare il mio preferito, il Fungo fantasma, è esaurito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680104
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680104,
					"content": "È un nuovo tipo di pane ideato dalla signorina Beryna. Piace così tanto che va a ruba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680105
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680105,
					"content": "*sospira* Solo il pensiero di non riuscire a gustarmi neanche un Fungo fantasma basta a farmi passare tutta la motivazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680106
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680106,
					"content": "Credo di sapere come prepararlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761680107
					]
				},
				{
					"id": 761680107,
					"content": "#Davvero? Ma è grandioso, {F#amica mia}{M#amico mio}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761680108
					],
					"speakerTitle": "Lantainen"
				},
				{
					"id": 761680108,
					"content": "In tal caso, potresti preparare alcuni Funghi fantasma per me? Non preoccuparti, ti ricompenserò a dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lantainen"
				}
			]
		},
