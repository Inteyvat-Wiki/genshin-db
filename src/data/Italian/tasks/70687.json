				]
			},
			"dialogs": [
				{
					"id": 706870101,
					"content": "#Salve, {F#care}{M#cari} ospiti, da questa parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870102
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870102,
					"content": "Una certa amica astrologicamente dotata di Madame Maga ha preparato un regalo per voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870103
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870103,
					"content": "Cavoli, è una sfera di cristallo tutta sbrilluccicosa! E sembra parecchio costosa... Quanto pensi che ce la pagherebbe Margaret? Dieci milioni di Mora? No, forse venti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870104,
					"content": "Ehm... Scusa, Paimon stava solo scherzando! Comunque, a che cosa serve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870105,
					"content": "#Per parafrasare Madame Maga: \"Dove c'è un mago, dev'esserci una degna sfera di cristallo\". Grazie a essa, potrete mettere piede su di un nuovo e splendido palco, {F#care}{M#cari} ospiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870106
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870106,
					"content": "Non sono del tutto sicuro di cosa volesse dire, dato che io sono solo il concierge! Quando guardo nella sfera di cristallo vedo solo il mio riflesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870107
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870107,
					"content": "Ah, giusto! C'è anche questa scatola, un altro regalo di Madame Maga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870108
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870108,
					"content": "\"Se ti esibirai in uno spettacolo memorabile su questo palco segreto, imprevedibile come le maree del fato, scoprirai i sorprendenti tesori contenuti in questa scatolina\"... Almeno, questo è quello che mi ha detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870109
					],
					"speakerTitle": "Wolfy"
				},
				{
					"id": 706870109,
					"content": "T-Tesori?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870110,
					"content": "Beh, questo è tutto da parte mia! Non sarebbe corretto se il concierge rovinasse il divertimento. Prego, dunque, salite sul palco con la vostra emblematica grandiosità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wolfy"
				}
			]
		}
	]
}