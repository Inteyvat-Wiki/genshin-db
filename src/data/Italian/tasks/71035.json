			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "Questo tempio è davvero in pessimo stato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350402,
					"content": "Di' un po', come ti è venuta l'idea di restaurarlo, così all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350403,
					"content": "Eheh... Beh, è una lunga storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350404,
					"content": "Quando fingevo di essere un Adeptus, avevo raccolto un sacco di risorse per tenere in piedi la farsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350405,
					"content": "Ma ho promesso di comportarmi bene, dopo che quell'Adeptus mi ha dato una lezione, ricordate? Beh, una volta tornato, avevo in mente di sbarazzarmi di tutto quel materiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350406,
					"content": "Ma poi ho avuto un'idea... Anziché distruggere tutte quelle informazioni, perché non scrivere una guida alle truffe e condividerla con gli altri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350407,
					"content": "Così facendo, avrei potuto aiutare gli altri a riconoscere le truffe e i disonesti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350408,
					"content": "Con mia sorpresa, la guida ha aiutato un sacco di persone. Perfino il Ministero degli Affari Civili l'ha trovata molto utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350409,
					"content": "Mi hanno suggerito altre contromisure da aggiungere a quelle che avevo già scritto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350410,
					"content": "E mi hanno anche pagato una bella somma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350411,
					"content": "Oltre alla guida, attualmente sto progettando di scrivere un libro sul Custode Yaksha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350412,
					"content": "Lo scopo, naturalmente, è condividere le storie che lo riguardano con il maggior numero di persone possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350413,
					"content": "In questo modo, potrò mettere a frutto tutte le mie conoscenze folkloristiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350414,
					"content": "E per quanto riguarda il tempio di Pervases, l'ho scoperto mentre raccoglievo materiale per il secondo libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350415,
					"content": "Secondo certe fonti, questo tempio è stato costruito dai nostri antenati per ricordare lo Yaksha Pervases.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350416,
					"content": "Ma non mi sarei mai aspettato di trovarlo in un tale stato di abbandono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350417,
					"content": "Così, dopo averci ragionato un po' sopra, ho deciso di pagare il restauro del tempio di tasca mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350418,
					"content": "Dopotutto, anch'io sono stato riportato sulla retta via da un Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350419,
					"content": "Penso che riportare alla gloria questo tempio possa essere un buon modo per rimediare ai miei errori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350420,
					"content": "Uhm... Pare che stia dicendo il vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350421,
					"content": "#Tu che ne pensi, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350422,
					"content": "Sì, sembra più o meno sincero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "\"Più o meno\"? Che vuol dire? Io SONO sincero! Al cento per cento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350426,
					"content": "*sospira* Ah, beh, pensatela pure come volete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350427,
					"content": "Se non vi fidate di me, tornate quando i lavori saranno iniziati e lo vedrete con i vostri occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350424,
					"content": "Beh, hai già provato a imbrogliarci in passato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "Ma il passato è passato! Ora sono un cittadino onesto! Non l'ho forse giurato davanti a quell'Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
