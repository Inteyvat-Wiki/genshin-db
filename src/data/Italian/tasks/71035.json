			},
			"dialogs": [
				{
					"id": 710350101,
					"content": "Cosa desiderate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350102,
					"content": "Tre porzioni di pesce corno alla griglia da asporto, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "Certamente. Solo un attimo, ve le preparo subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350104,
					"content": "Tre porzioni? Una per te, una per Paimon... e l'ultima per chi è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350105,
					"content": "Pensavo di andare a trovare Pervases.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "Intendi il Pervases che ci ha dato le Lampade delle Sette Stelle e l'Incensiere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350108,
					"content": "È vero, aveva detto che gli mancava il sapore del pesce corno alla griglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350109,
					"content": "Ma non se n'è andato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350110,
					"content": "Questo non significa che non possiamo rendergli omaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "Sì, ha senso, in effetti. Andiamo a trovarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350112,
					"content": "L'ultima volta che abbiamo incontrato Pervases, il tempio era in uno stato pietoso, e c'erano anche dei Cacciatori di tesori in zona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350113,
					"content": "Speriamo che la statua non sia stata deturpata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350114,
					"content": "Ecco le vostre tre porzioni di pesce corno alla griglia. Buon appetito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 710350115,
					"content": "#Mmmh, che profumino! Forza, {NICKNAME}, alla prossima tappa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350106,
					"content": "Pervases adora il pesce corno alla griglia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
