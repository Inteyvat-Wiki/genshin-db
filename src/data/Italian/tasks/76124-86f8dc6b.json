				]
			},
			"dialogs": [
				{
					"id": 761240401,
					"content": "Ehi, qui sembra esserci un altro dipinto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240402,
					"content": "Ah-ha, che occhio attento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240403,
					"content": "Era stato commissionato a Castiglione da un gruppo di giovani che si definiscono eredi del clan Guhua. Sostengono che sia il loro prezioso \"campo d'addestramento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240404,
					"content": "Ma sono un gruppo tremendamente sprezzante, si credono già maestri ineguagliabili, ben al di sopra di esercizi così basilari. Così hanno affidato il dipinto a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240405,
					"content": "Aspetta... Tu non fai parte del clan Guhua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240406,
					"content": "Beh, mi piacerebbe poterlo affermare. Purtroppo, quel giovane Guhua probabilmente non oserebbe accogliermi tra le sue file.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240407,
					"content": "Ai tempi in cui stavamo sgominando i banditi nelle Pianure di Guili, quel ragazzo rischiò di farsi ammazzare poiché non aveva un adeguato addestramento. Non ebbi altra scelta che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240408,
					"content": "Ah, lasciamo stare. Sono storie vecchie e poco interessanti. Questo dipinto, invece... è tutt'altra faccenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240409,
					"content": "#Se sei {F#curiosa}{M#curioso}, vai pure a srotolarlo. Se lo strappi non è una gran perdita, Castiglione se ne sta con le mani in mano quasi tutti i giorni. Gliene farò semplicemente realizzare un altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		}
	]
}