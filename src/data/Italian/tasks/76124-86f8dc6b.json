				{
					"id": 761240203,
					"content": "Bene, voi due! Dato che il dipinto è stato srotolato, parlerò a nome dei piccoli discepoli del clan Guhua e vi esporrò le regole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240204
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240204,
					"content": "Tra questi manichini di bambù, alcuni sono <color=#00E1FFFF>vestiti di blu</color> mentre altri sono <color=#FF5E41FF>vestiti di rosso</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240205,
						761240206
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240205,
					"content": "Oh, come quelli della Sala Wangshan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				},
				{
					"id": 761240207,
					"content": "Oh, anche Paimon se le ricorda! Bisogna attaccare i manichini <color=#00E1FFFF>vestiti di blu</color> senza colpire quelli <color=#FF5E41FF>vestiti di rosso</color>, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240208,
					"content": "Esatto. In tal caso, non sprecherò altro fiato. Mostrami cosa sa fare la tua spada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240206,
					"content": "Conosco le regole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				}
			]
		},
		{
