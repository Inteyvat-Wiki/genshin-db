					}
				]
			},
			"dialogs": [
				{
					"id": 761240301,
					"content": "Eccellente! Con questo, abbiamo finito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240302,
					"content": "#Grazie a {F#entrambe}{M#entrambi}, è stato un vero piacere. E tu, giovane {F#biondina}{M#biondino}, le tue abilità sono davvero impressionanti. Oserei dire che sei molto più forte di quel giovane Guhua che conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240303,
					"content": "#{F#Brava}{M#Bravo} me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "Grazie a voi due, ho avuto un raro momento di illuminazione. La pasta di pesce ha davvero bisogno di un po' di carne macinata fresca che ne esalti il sapore. Se la si lascia troppo a lungo, diventa impossibile mascherare l'odore di pesce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240307,
					"content": "Ah, questo è vero... Mh? Aspetta... Ma questo cosa c'entra?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240308,
					"content": "#Ahah, non badiamo alle inezie! La prossima volta che farò dipingere a Castiglione qualche altro pesce, offrirò a {F#entrambe}{M#entrambi} della vera pasta di pesce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240304,
					"content": "Non è stato difficile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "Non c'è bisogno di essere modesti. La tua tecnica con la spada è forte, questo è più che evidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "Jinggui"
				}
			]
		},
