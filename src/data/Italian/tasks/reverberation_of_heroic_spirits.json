						761420406
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420406,
					"content": "L'onore è tutto nostro, capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420407
					],
					"speakerTitle": "Filaev"
				},
				{
