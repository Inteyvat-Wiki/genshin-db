			"dialogs": [
				{
					"id": 761420301,
					"content": "Ehi, Chernov. Come stai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420302,
					"content": "Riesco ancora a sollevare la lama... Capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "Chernov"
				},
				{
					"id": 761420303,
					"content": "Shonokovych, Filaev... Tutto bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420304,
					"content": "Ugh... credo che la mia gamba sia rotta, ma ehi, respiro ancora. Stai tenendo il conto? Quanti ne ho sconfitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "Shonokovych"
				},
				{
					"id": 761420305,
					"content": "Q-Quanti mostri ci sono? Noi... moriremo qui, Capitano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420306,
					"content": "Che assurdità stai dicendo, ragazzino? Ne usciremo sicuramente sani e salvi! Non preoccuparti, il ricognitore deve essere già tornato in città per informare il vecchio, i rinforzi sono in arrivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420307,
					"content": "...Eccoli di nuovo, la Caccia selvaggia non ci dà tregua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420308,
					"content": "Forza! Impugnate armi e lanterne. Arriva un'altra ondata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
