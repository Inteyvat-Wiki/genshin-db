			"dialogs": [
				{
					"id": 761420401,
					"content": "Non avere paura. Io e Patoli ti porteremo via da qui. Testa alta e impugna quella lama come un vero Guardaluce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420402
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420402,
					"content": "Io... Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420403
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420403,
					"content": "Quale piano? Quale piano potrebbe mai esserci, Patoli? Se questa è la fine, combatterò qui fino all'ultimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420404
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420404,
					"content": "Siete la squadra migliore che abbia mai avuto. Qualsiasi cosa accada... è stato un onore combattere al vostro fianco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420405
					],
					"speakerTitle": "???"
				},
				{
