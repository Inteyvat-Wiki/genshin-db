					"Kuki Shinobu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115101,
					"content": "Wow, l'incontro tra la donna volpe e la donna pesce mi ha davvero fatto ribollire così tanto il sangue che il sudore mi sta praticamente evaporando dalla fronte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115102,
					"content": "Sì, sì. Sicuramente tutta Ritou sa quanto tu sia eccitato, ma il resto del gruppo ci sta aspettando. Dovremmo tornare indietro adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115103,
					"content": "Eh, possono aspettare ancora un po'... Almeno lascia che io e il mio compadre ci facciamo un'ultima partita! Non puoi dirci di no... Per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115104,
					"content": "Va bene, facciamoci una partita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "È così che si comporta un compadre! Lo sapevo che avresti accettato! Un giocatore incallito di GCC lo capisci solo tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115106,
					"content": "Seriamente, come devo fare con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115107,
					"content": "Magari la prossima volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "...D'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115109,
					"content": "Va bene, non ti incolpo... Ma dovresti andartene. Non t'interessa vedere un oni adulto che piange...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
