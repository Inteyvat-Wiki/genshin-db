				]
			},
			"dialogs": [
				{
					"id": 401113101,
					"content": "A proposito, la capitana Beidou gioca per caso a Invokazione del genio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113102,
					"content": "Sì. In effetti, è una delle migliori dell'intera flotta della Crux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 401113103,
					"content": "Ti dispiacerebbe mettere una buona parola per me, Kazuha? Sono un fan di lunga data della capitana Beidou. Ho sempre sperato di poter fare amicizia con lei un giorno, ma finora non ne ho mai avuto l'occasione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113104,
					"content": "Certo, ma ti prego, sii gentile quando inevitabilmente la sconfiggerai a Invokazione del genio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4011132,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
