			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "Ehilà. Qualcos'altro di cui vuoi parlare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111302,
					"content": "A proposito di Invokazione del genio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "Il gioco ha davvero preso piede negli ultimi tempi. Ormai fa parte della vita quotidiana: ovunque vai, c'è qualcuno che ci gioca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111304,
					"content": "In realtà, alcuni hanno persino rinunciato a bere per mantenere la lucidità durante la partita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111305,
					"content": "Eheh, sicuramente farà molto piacere a Diona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111306,
					"content": "Come se la passano i Cavalieri di Favonius?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "Non preoccuparti, stanno tutti bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111308,
					"content": "Sono riuscito a convincere Jean a unirsi a me per una partita, ma si è dovuta allontanare quando non eravamo nemmeno a metà. Alla fine ho dovuto finire la partita per tutt'e due. *sospira* C'era altra scelta? Ognuno deve mettere il proprio lavoro al primo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111309,
					"content": "Ma visto il successo del torneo e il divertimento di tutti, spero che almeno lei abbia una preoccupazione in meno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111310,
					"content": "Ci aggiorniamo un'altra volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "Certo. Dovremmo fare una partita a Invokazione del genio alla prima occasione utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
