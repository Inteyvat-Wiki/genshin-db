			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charlotte",
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113301,
					"content": "Ciao, mi chiamo Charlotte! Sono una giornalista che lavora per l'Uccello a vapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113302,
					"content": "Posso chiederti un momento del tuo tempo per una breve intervista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113303,
					"content": "*sospira* Certo, chiedi pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113304,
					"content": "Hai avuto un inizio promettente in questa competizione, lasciando molti contendenti nella polvere, prima di mancare per poco la vittoria del campionato contro Hu Tao, la direttrice dei Servizi Funebri Wangsheng. Deve essere difficile per te, sapendo quanto poco mancasse alla vittoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113305,
					"content": "Tenendo questo in mente, vorresti condividere i tuoi pensieri sull'esito della finale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113306,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113307,
					"content": "Scusami, vuoi una risposta per i media, o ne vuoi una sincera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113308,
					"content": "Vorrei le tue idee sincere, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113309,
					"content": "*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113310,
					"content": "Beh, ho sempre detto che giocare a carte è per il settanta per cento abilità e per il trenta per cento fortuna... Ma quando il tuo avversario tira sei dadi dello stesso elemento in una volta sola, non c'è modo di tornare indietro, nemmeno con abilità di livello Adeptus... non c'era proprio speranza per un semplice avventuriere come me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
