			},
			"dialogs": [
				{
					"id": 401115201,
					"content": "Generale Kujou, posso parlarti un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115202,
					"content": "Sì. Congratulazioni per la vittoria, Sangonomiya Kokomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115203,
					"content": "Volevo esprimere la mia gratitudine per gli utili consigli che mi hai dato prima della partita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115204,
					"content": "Non è successo niente. Chiunque abbia la testa sulle spalle sa che sono l'abilità e la strategia a determinare il vincitore. In ogni caso, è stata una partita emozionante da vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115205,
					"content": "È stata una sfortuna che tu non abbia voluto iscriverti al torneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115206,
					"content": "Temo che non riuscirei a batterti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115207,
					"content": "Non dire così. Non sei così diversa da me... Cerchi occasioni per affinare le tue abilità nel gioco, consideri le contromisure e competi con gli altri come se fossero amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115208,
					"content": "...Forse hai ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115209,
					"content": "In tal caso, facciamoci una partita a Invokazione del genio prima che tu parta per l'Isola di Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115210,
					"content": "Sarebbe un vero piacere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
