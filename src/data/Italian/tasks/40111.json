			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "Ho sentito dire che perfino il torneo non ufficiale di Invokazione del genio sta riscuotendo un'enorme affluenza. Molti giocatori seri si sono iscritti sia al torneo ufficiale che a quello non ufficiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113202,
					"content": "Per quanto mi riguarda... Non mi dispiace cimentarmi di tanto in tanto con i giochi di tendenza, anche se continuo a preferire gli scacchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113203,
					"content": "Ma a conti fatti, a prescindere dalle differenze che possono esserci tra i vari giochi in circolazione, hanno tutti una cosa importante in comune: uniscono gli amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4011133,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
