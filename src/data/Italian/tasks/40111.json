			"dialogs": [
				{
					"id": 401115301,
					"content": "Ho sentito che prima ti sei riferita a lei con le parole \"youkai kitsune\", potresti dirmi qualcosa di più a riguardo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115302,
					"content": "Non tralasciare alcun dettaglio. Chissà, forse c'è qualcosa che potrò usare nel mio articolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115303,
					"content": "Oh! Meglio di no, temo di dire qualcosa di sbagliato. Inoltre, non sono la youkai più qualificata per rispondere a queste domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115304,
					"content": "Ok, allora forse potresti aiutarci a spiegare perché una kitsune dovrebbe avere alcun interesse per il tofu fritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115305,
					"content": "Ah, ora le tue domande mi mettono fame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115306,
					"content": "Perché non ti porto a provare i ramen della kitsune qui a Inazuma? Posso spiegarti tutto mentre mangiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kirara"
				}
			]
		}
