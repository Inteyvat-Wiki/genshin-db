			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charlotte"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "\"Città sul Lago brulica di talenti nel torneo GCC: un giovane prodigio batte il Capitano di cavalleria favoniano\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111502,
					"content": "Mmm, questo titolo salva la faccia ai Cavalieri, ma gli manca quel qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111503,
					"content": "\"La migliore mente strategica dei Cavalieri di Favonius superata dal ragazzo del ponte in una sconfitta lunga cinque turni\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111504,
					"content": "\"Le speranze del capitano stroncate da una sconfitta clamorosa\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111505,
					"content": "Mmm... Forse dovrei tenere la prima bozza...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charlotte"
				}
			]
		},
		{
