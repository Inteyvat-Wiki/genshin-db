			"dialogs": [
				{
					"id": 401111401,
					"content": "Che torneo favoloso. Quel Timmie, wow... è proprio bravo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111402
					],
					"speakerTitle": "Eichendorff"
				},
				{
					"id": 401111402,
					"content": "Già, chi se lo aspettava... Ma almeno ora posso sentirmi un po' meglio per aver perso contro di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lennard"
				}
			]
		},
		{
			"id": 4011115,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
