				{
					"id": 718140301,
					"content": "Hai già rimosso tutti i resti galleggianti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140302
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140302,
					"content": "Ho trovato questi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140303
					]
				},
				{
					"id": 718140303,
					"content": "Mmmh... Direi che puoi tenere i Mora. Non sono molti, ma puoi considerarli il compenso per il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140304
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140304,
					"content": "Per quanto riguarda la scatola, invece, non ho idea di cosa sia. Magari puoi consegnarla a Baiwen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140305
					],
					"speakerTitle": "Kun"
				},
				{
					"id": 718140305,
					"content": "Si sta occupando di alcune faccende al Padiglione Yuehai. Forse saprà dirti di cosa si tratta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kun"
				}
			]
