					"nextDialogs": [
						718140405
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140405,
					"content": "Puoi dirmi di cosa si tratta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140406
					]
				},
				{
					"id": 718140406,
					"content": "Beh, è un contenitore che custodisce diversi documenti e un annuncio che deve ancora essere approvato. È davvero sorprendente che siano ancora tutti integri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140407
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140407,
					"content": "In ogni caso, la tua scoperta ci risparmierà un po' di lavoro. Ripulire tutto si è rivelato una fonte infinita di lavoro inutile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140408
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140408,
					"content": "Ti ringrazio per averceli portati. Ecco, prendi, in segno di riconoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
