			"dialogs": [
				{
					"id": 718140401,
					"content": "Ciao, come posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140402
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140402,
					"content": "Ho trovato questo in mare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718140403
					]
				},
				{
					"id": 718140403,
					"content": "Eh? Fammi dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140404
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140404,
					"content": "Sì, proviene proprio dalla Dimora di giada.",
