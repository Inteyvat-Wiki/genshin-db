					"speakerTitle": "Swan"
				},
				{
					"id": 207020102,
					"content": "Come l'ultima volta, ti farò delle domande riguardanti i temi affrontati nel testo. Alcune saranno più teoriche, altre più generiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207020103
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 207020103,
					"content": "A seconda di quante risposte corrette mi fornirai, ti farò un piccolo regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Swan"
