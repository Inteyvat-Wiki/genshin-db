					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170401,
					"content": "Radici di grande albero. Eccellente. Si sente respiro affannoso, melodia sonnolenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170402,
					"content": "Uhm... Paimon non riesce ancora a capire cosa dice Arakunti, ma non importa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170403,
					"content": "A questo proposito, Paimon non pensava fosse così spazioso all'interno. È proprio vero, mai giudicare un libro dalla copertina. Paimon continua ad avere la sensazione che l'atmosfera qui sia molto diversa da quella di altri posti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170404,
					"content": "Dovremo cercare le \"foglie\" che forniscono energia alla Macchina di Varuna in un posto del genere...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170405,
					"content": "È qui, ma non è qui. Arakunti riesce a sentire la sua voce, il suo respiro, vedere le sue vene... Ma Paimon non riesce a trovarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170406,
					"content": "Eh? Che cosa significa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170407,
					"content": "Se Paimon non può trovarlo, posso farlo io?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "#{F#La}{M#Il} Nara dorat{F#a}{M#o} può vedere melodia, come fresca brezza della notte, improvvisa goccia di pioggia, i mille frammenti di sogno di superficie di lago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170409,
					"content": "Wow, davvero incredibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#Come ci si aspetterebbe da {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170411,
					"content": "Eheh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Eheh... Ehi! {NICKNAME} sta rubando la battuta di Paimon?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170413,
					"content": "#Nara {NICKNAME} che diventa Paimon... Ancora più spaventoso di ballare con funghi in Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170414,
					"content": "Non oso immaginare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "E infatti non accadrà nulla del genere! Meglio che non succeda mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170416,
					"content": "Arakunti, potresti essere più chiaro? Dove caspita possiamo trovare le \"foglie\" della Macchina di Varuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170417,
					"content": "Nei sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170418,
					"content": "Aspetta... Allora perché non ce l'hai detto subito?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170419,
					"content": "Perché non hai chiesto \"dove\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170420,
					"content": "Uhm... Paimon crede di aver improvvisamente capito come comunicano gli Aranara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170421,
					"content": "Arakunti, potresti dirci dove si trova ciascuna delle tre \"foglie\" che stiamo cercando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170422,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170423,
					"content": "Wow, Arakunti risponde solo alle domande che vengono poste in modo diretto... Ok, allora dove sono questi tre luoghi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170424,
					"content": "Di qua, di là e dall'altra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170425,
					"content": "Ah-ah... Aspetta, non ci stai aiutando così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170426,
					"content": "Eeee Paimon è stata sconfitta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "#Questo significa che anche {NICKNAME} è stat{F#a}{M#o} sconfitt{F#a}{M#o}! Non possiamo fare affidamento sulle parole di Arakunti... Quindi come facciamo a trovare i tre luoghi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170428,
					"content": "Macchina di Varuna è stata creata da Aranara più abile di tutti, legame tra \"rami\" e \"foglie\" è invisibile e al tempo stesso visibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170429,
					"content": "#Nara {NICKNAME} può vedere Aranara, e se si vedono tracce di Aranara, si può trovare direzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170430,
					"content": "P-Paimon non riesce a credere di averlo capito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170431,
					"content": "Li troveremo se seguiremo le tracce degli Aranara, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "Ehi, almeno dai a Paimon la possibilità di rispondere, questa volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
