			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171001,
					"content": "Sogni acquosi, sogni asciutti... Ding dong, tic tac, frush frush... È la melodia di Vana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171002
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171002,
					"content": "#Nara {NICKNAME}? \"Foglie\" sono nel sogno, e \"ramo\" è qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				}
			]
		},
		{
			"id": 7301712,
			"completionStepIds": [
				7301712
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301712",
							"2"
						],
						"stepId": 7301712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "#Siamo tornat{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171202,
					"content": "Arakunti vi ha sentito. I lamenti si sono trasformati in dolce melodia, ma per unirla a grande flusso di suono, abbiamo ancora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171203,
					"content": "Abbiamo ancora bisogno del tuo aiuto, Arakunti! Eheh, Paimon conta su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171204,
					"content": "Arakunti lo sa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171205,
					"content": "Ah! Allora non dovrebbe esserci nessun problema, vero? Paimon spera che riusciremo a risanare la Macchina di Varuna in fretta, altrimenti i Boschi di Apam saranno pieni di spore... Solo a pensarci, a Paimon inizia a prudere... Etciùùù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171206,
					"content": "Paimon non riesce a credere che gli Aranara non abbiano alcuna reazione alle spore... Com'è possibile che gli Aranara non ne risentano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171207,
					"content": "Per gli Aranara non è problema. Aranara possono cucinare funghi. Le spore sono troppo piccole e numerose per essere catturate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171208,
					"content": "Quando Macchina di Varuna non era rotta, non c'erano così tanti funghi a Vana, quindi risanare Macchina di Varuna può rendere cose migliori. Tranne che per Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171209,
					"content": "Le cose andranno meglio, senz'ombra di dubbio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "Vi aiuteremo anche noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171211,
					"content": "Troveremo un modo per sbarazzarci anche del Marana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#Nara {NICKNAME} è Nara Varuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171213,
					"content": "Perché questa domanda improvvisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171214,
					"content": "#Arapandu ha detto che Nara Varuna era {F#un}{M#una} Nara dorat{F#o}{M#a} e coraggios{F#o}{M#a}. Insieme agli Aranara, ha guarito Macchina di Varuna, scacciato pioggia e fango nero, e ha restituito sole e luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171215,
					"content": "#Anche Nara {NICKNAME} ha aiutato Aranara a risanare Macchina di Varuna, e anche tu sei Nara dorat{F#a}{M#o} e coraggios{F#a}{M#o}, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171216,
					"content": "Ma Nara Varuna non appartiene al passato...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171217,
					"content": "#Quindi Nara Varuna non è più tornat{F#o}{M#a} a Vana? Nara {NICKNAME} è {F#un'altra}{M#un altro} Nara, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171218,
					"content": "Nara differenti hanno melodie simili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171219,
					"content": "Forse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "#Arakunti non ha mai conosciuto Nara Varuna, ma Arapandu ha parlato molto di {F#lui}{M#lei}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171222,
					"content": "#La sua melodia deve essere uguale a quella di Nara {NICKNAME}, e ascoltarla dona sicuramente felicità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171223,
					"content": "#Già, Paimon è sempre felice quando è con {NICKNAME}! Se un giorno {NICKNAME} abbandonerà Paimon, come Nara Varuna ha abbandonato la foresta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171225,
					"content": "#Arapandu ci starà aspettando all'\"area di relax\". Nara {NICKNAME}, vieni con Arakunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171226,
					"content": "Andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171227
					]
				},
				{
					"id": 730171227,
					"content": "Sì, torniamo da Arapandu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171228,
					"content": "Mi dispiace, ho altro da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171229
					]
				},
				{
					"id": 730171229,
					"content": "Non c'è problema, Arakunti può tornare da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171220,
					"content": "Non lo so...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				}
			]
		}
	]
}