			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "Oh! Eccoti, finalmente! Tu sei Arakunti, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170202,
					"content": "O forse no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170203,
					"content": "Eh? Cosa intendi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170204,
					"content": "Perché Arakunti potrebbe essere albero, o pioggia, o sogno di Vana, o corde di strumento musicale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170205,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170206,
					"content": "#Paimon non ha capito nemmeno una parola di quello che ha detto! Tu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170207,
					"content": "Neanche io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "Paimon ha l'impressione di conoscere il significato delle singole parole, ma non riesce a comprenderle all'interno di una frase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170213,
					"content": "#Perché {F#la}{M#il} Nara dorat{F#a}{M#o} e una cosetta che vola dovrebbero aver bisogno di Arakunti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170214,
					"content": "Paimon non è una cosetta che vola! Aspetta, in effetti Paimon può volare ed è piccolina... Argh! Comunque, Paimon è... Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170215,
					"content": "#E anche {F#la}{M#il} Nara dorat{F#a}{M#o} ha un nome: {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170216,
					"content": "Arapandu ci ha detto che ti trovavi al Frutteto dei Sogni e ci ha chiesto di venire a vedere come stavi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170217,
					"content": "Potete dire ad Arapandu che Arakunti sta bene, Frutteto dei Sogni sta bene e lo stesso vale per i sogni acquosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170218,
					"content": "#Va bene... {NICKNAME}, torniamo indietro e riferiamolo ad Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170219,
					"content": "...No! Siamo qui per risanare la Macchina di Varuna! C'è mancato poco. Paimon si stava quasi facendo imbrogliare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170220,
					"content": "Puoi dire ad Arapandu che Arakunti non vuole imbrogliare Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170221,
					"content": "Non credo che Arapandu voglia saperlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "E neanche Paimon! Che diavolo di problemi ha quest'Aranara?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170223,
					"content": "Ricordo che Arapandu ha detto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "Ha detto: \"Arakunti non conosce Nara\". Forse Arakunti non sa comunicare con le persone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170225,
					"content": "In realtà, siamo noi che non sappiamo comunicare con gli Aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "Oh! È vero... Siamo noi che dovremmo cercare di attenerci alle usanze locali e imparare a comunicare con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170227,
					"content": "Ora che mi ci fai pensare, come comunicano gli Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170228,
					"content": "Secondo te, cosetta che vola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "#Se {F#la}{M#il} Nara dorat{F#a}{M#o} non lo sa, come potrebbe saperlo una cosetta che vola? Perché non chiediamo direttamente ad Arakunti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170233,
					"content": "Potresti spiegarci con precisione come comunicano gli Aranara tra loro? Vogliamo davvero saperne di più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170234,
					"content": "Perché volete sapere? Nara è Nara, Paimon è Paimon e Aranara sono Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170235,
					"content": "Ah, ora Arakunti capisce. Anche Paimon vuole diventare seme ed essere sepolta nella terra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170236,
					"content": "No! Niente affatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170237,
					"content": "#{F#La}{M#Il} Nara dorat{F#a}{M#o} vuole diventare seme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170238,
					"content": "No, grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "Peccato. Ad Arakunti piacciono i semi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170242,
					"content": "Stiamo dimenticando il vero motivo per cui siamo qui: il Festival di Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170243,
					"content": "Dobbiamo risanare la Macchina di Varuna per il Festival di Utsava in modo che il tempo torni alla normalità e che non ci siano più quelle spore cattive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170244,
					"content": "Paimon ha ragione. Dobbiamo farlo per il Festival di Utsava e per il centro della Terra blu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170245,
					"content": "Frutteto dei Sogni umido è buono, ma spore sono cattive. Anche funghi che corrono sono cattivi. E poi troppa pioggia, quindi funghi sono diventati difficili da cucinare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170246,
					"content": "Ehi, hai visto? Non sei male dopo tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170247,
					"content": "#Dobbiamo guarire la Macchina di Varuna. Nara {NICKNAME} e Paimon andranno con Arakunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170240,
					"content": "Certo, perché no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "Non dire sciocchezze, penserà che stai dicendo sul serio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170230,
					"content": "Beh, che ne dici di iniziare usando qualche metafora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "#Sì, ora Paimon ci prova! {F#La}{M#Il} Nara dorat{F#a}{M#o} è proprio come... come... uhm... come l'uovo fritto di Teyvat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170232,
					"content": "...Sarà meglio chiedere direttamente ad Arakunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170209,
					"content": "Posso provare a indovinare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "Fantastico! Quindi cosa significa quello che ha detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170211,
					"content": "Ha detto che può trasformarsi in tante altre cose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#Davvero? Non stai prendendo in giro Paimon, vero, {NICKNAME}...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301704,
