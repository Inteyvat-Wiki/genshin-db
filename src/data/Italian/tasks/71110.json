			"dialogs": [
				{
					"id": 711101101,
					"content": "Questo pellicano è tuo, piccolina? Possiamo fargli una fotografia con il Villaggio di Qiaoying sullo sfondo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101102,
					"content": "Hree hree! Craa craa annh annh hree hree!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101103
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101103,
					"content": "Eh? Ma che stai dicendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101104,
					"content": "È pellicanese, significa: \"Grandioso, grandioso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101105,
					"content": "Tu parli il pellicanese?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "Solo un pochino... Ho solo notato che, quando mangiano, non fanno che ripetere: \"Hree hree! Craa craa annh annh hree hree!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101107,
					"content": "Sono sicura che è il loro modo per esultare di felicità e dire: \"Grandioso, grandioso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101108,
					"content": "Così ho imparato anch'io a chiamarli in questo modo. Si avvicinano appena mi sentono, probabilmente perché pensano che ci sia del cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101109,
					"content": "#Se volete fotografarne uno, potete provare a chiamarne uno voi {F#stesse}{M#stessi}! Purtroppo io ora devo scappare a casa, altrimenti vi avrei insegnato qualche altra frase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101110,
					"content": "Non c'è problema, piccoletta, ce la caveremo! Grazie mille e attenta lungo la strada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101111,
					"content": "#{NICKNAME}, facciamo un tentativo! Se riusciamo ad attirare un pellicano, aumenteremo le probabilità di successo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
