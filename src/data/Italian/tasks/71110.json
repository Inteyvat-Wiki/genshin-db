			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fangju"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100701,
					"content": "A giudicare dal tuo sguardo rilassato, immagino che tu sia qui per presentare le tue foto. Lasciale pure a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100702
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100702,
					"content": "Uhm, niente male, davvero niente male. Ci devi aver messo molto impegno per catturare degli scenari così belli. Ben fatto.",
					"roleType": "TALK_ROLE_NPC",
