			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100201,
					"content": "#{F#Amica mia}{M#Amico mio}, anche tu sei qui per partecipare alla gara di fotografia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100202,
					"content": "In quanto fotografo di Fontaine, il luogo dov'è nata la Fotokamera, lascia che ti dia qualche piccolo consiglio: la più pura essenza della fotografia è racchiusa nella Fotokamera stessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100203,
					"content": "Pertanto, mi piacerebbe presentarti una persona del mio paese. Le Fotokamere che produce sono le più apprezzate in assoluto. Anche il costo è del tutto onesto, e posso già dirti come fare a procurartene una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100204,
					"content": "Ehi... Non fare quella faccia indifferente! Guarda che posso farti avere un bello sconto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100205,
					"content": "Ehi, no... Non andartene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
				}
			]
		},
