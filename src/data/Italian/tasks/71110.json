			},
			"dialogs": [
				{
					"id": 711101301,
					"content": "Fermatevi! Non fate un altro passo! Voi... siete brave persone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101302
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101302,
					"content": "Ehi, guarda che ti abbiamo appena salvato la vita! Hai battuto la testa o...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101303,
					"content": "Ah! Avete ragione... Vi prego di perdonarmi. La mia \"gita alla Vallata Chenyu\" finora è stata una scalogna dietro l'altra... Vi... ringrazio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101304
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101304,
					"content": "Quindi anche tu partecipi alla gara di fotografia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101305
					]
				},
				{
					"id": 711101305,
					"content": "Perché, anche voi? Che coincidenza! Ma sono solo un comunissimo turista... Non avevo speranze contro quegli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101306
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101306,
					"content": "Li ho incontrati lungo la strada, mi hanno rapito e portato qui senza lasciarmi dire nemmeno una parola. Non ditemi che anche gli Hilichurl chiedono il pedaggio... Da non credersi. Per fortuna mi sono imbattuto in voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101307
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101307,
					"content": "Ah... Sembra che te la sia vista proprio brutta, oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101308,
					"content": "Non solo oggi! Anche ieri è stato un disastro. Avevo comprato una Fotokamera piuttosto costosa presso un mercante di Fontaine, ma si è rotta dopo averla a malapena utilizzata. Ero tornato da lui per farmela cambiare, ma era sparito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101309
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101309,
					"content": "Che persona losca... Mi raccomando, fate sempre attenzione al portafogli mentre andate in giro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101310
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101310,
					"content": "Ah, scusate, sto divagando. Giacché partecipate anche voi alla gara, immagino siate qui per fotografare il Monte Xuanlian, sì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101311
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101311,
					"content": "Per ringraziarvi, vi indicherò il luogo perfetto dove scattare la foto, che ne dite? Ecco, l'ho segnato sulla vostra mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101312
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101312,
					"content": "Potete già vederlo. In effetti, è esattamente laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101313
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101313,
					"content": "Eh? E tu che farai, allora? Non sei anche tu uno dei concorrenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101314,
					"content": "Quest'area è decisamente pericolosa, quindi preferisco cambiare programma. Nella guida erano indicati anche altri posti... Sto pensando di andare a vedere l'Adeptus assaggia-tè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101315
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101315,
					"content": "Sì! Ho deciso. Arrivederci, voi due! Spero che le cose inizino a girare nel verso giusto anche per me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akai"
				}
			]
		},
