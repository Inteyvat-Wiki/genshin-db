			"dialogs": [
				{
					"id": 711101001,
					"content": "Ah, siete qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101002,
					"content": "Avete visto i lavori esposti? Per questa edizione di \"La nostra gita alla Vallata Chenyu\" ne abbiamo scelti otto in totale, e la metà sono opera vostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101003,
					"content": "I miei complimenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101004,
					"content": "Porca pupazza, è stratomitico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101005,
					"content": "#Hai visto, {NICKNAME}? Paimon lo sapeva che ne avremmo azzeccate quattro su quattro! Paimon se la cava proprio bene con le probabilità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101006,
					"content": "Sono quattro su otto, a dirla tutta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "Eheh, anche i giudici hanno apprezzato molto le vostre opere, proprio come dicevo ieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101009,
					"content": "Perciò, vi prego di accettare questo album fotografico commemorativo de \"La nostra gita alla Vallata Chenyu\". Al suo interno sono contenute tutte le opere vincitrici della gara. Ve lo siete meritato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101010,
					"content": "Era questa la sorpresa? Ooh, ma è stupendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101011,
					"content": "Se siete d'accordo, vorrei darvi anche un premio in Mora. Vi prego di accettarlo. E vi ringrazio ancora una volta per aver partecipato, stavolta a titolo personale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101012,
					"content": "#Questo è il luogo dove sono cresciuta, e voi siete {F#riuscite}{M#riusciti} a immortalarne la bellezza come mai prima d'ora. Di certo, le vostre opere riusciranno a far innamorare di questi posti tanta altra gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101013,
					"content": "Grazie infinite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101007,
					"content": "Cavoli! Sei un genio della matematica!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
		},
