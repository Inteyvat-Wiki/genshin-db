			},
			"dialogs": [
				{
					"id": 711100301,
					"content": "Ehilà! Hai girato parecchio. Immagino che tu abbia avuto occasione di ammirare dei bei paesaggi in tutto questo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100302
					],
					"speakerTitle": "Zhuchun"
				},
				{
					"id": 711100302,
					"content": "Mi chiedo se i luoghi della Vallata Chenyu che partecipano alla gara siano paragonabili ai panorami che hai già potuto ammirare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhuchun"
				}
			]
		},
		{
			"id": 7111007,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
