			},
			"dialogs": [
				{
					"id": 711100101,
					"content": "Siete qui per partecipare alla nostra gara di fotografia scenografica, \"La nostra gita alla Vallata Chenyu\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100102
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100102,
					"content": "Gara di fotografia scenografica? Di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100103,
					"content": "È esattamente ciò che sembra: una competizione atta a promuovere gli splendidi panorami della Vallata Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100104
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100104,
					"content": "Abbiamo raccolto le opinioni degli abitanti per scoprire quali sono i luoghi panoramici più belli della zona. Lo scopo dei partecipanti consiste nel fotografarli usando ognuno la propria Fotokamera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100105
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100105,
					"content": "Alla fine della gara, sceglieremo gli scatti migliori da usare come materiale promozionale, e li esporremo sulla strada all'esterno della Stazione di Hezhe. Allora? Vi interessa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100106,
						711100108
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100106,
					"content": "Sono una persona pragmatica. Ci sono dei premi in palio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100107
					]
				},
				{
					"id": 711100107,
					"content": "Ovviamente. Se i vostri lavori vengono selezionati, ci sarà una sorpresa speciale apposta per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100110,
					"content": "Cavoli, una sorpresa?!? Allora dovremo davvero mettercela tutta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100111,
					"content": "#Eheh! In ogni caso, per ricambiare del vostro tempo, abbiamo preparato anche delle ricompense minori nel caso non risultaste {F#vincitrici}{M#vincitori}. Speriamo che saranno di vostro gradimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100112
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100112,
					"content": "Da dove comincio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100113
					]
				},
				{
					"id": 711100113,
					"content": "Innanzitutto, dai un'occhiata a questa guida: al suo interno sono indicati i luoghi panoramici consigliati dagli abitanti della Vallata Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100115
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100115,
					"content": "Eh? Perché alcuni sono stati barrati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100116,
					"content": "Beh, perché i posti previsti per quei luoghi sono già esauriti. La nostra intenzione è offrire una rassegna il più completa possibile delle bellezze della Vallata Chenyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100117
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100117,
					"content": "Le quattro zone restanti hanno ancora dei posti disponibili. Potete sceglierne una o anche di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100118
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100118,
					"content": "#Ah, Paimon ora ha capito... {NICKNAME}, che ne dici di prenotarci per tutti quanti i luoghi che rimangono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100119,
					"content": "Se abbiamo una possibilità su quattro di vincere il premio, allora se scattiamo quattro foto ci garantiremo la vittoria! E potremo accaparrarci la sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100120,
						711100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100120,
					"content": "Non è così che funzionano le probabilità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100121
					]
				},
				{
					"id": 711100121,
					"content": "Davvero? Ma scusa, un quarto moltiplicato per quattro non fa uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100122,
					"content": "Sì, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100124,
					"content": "Hihi! Che aspettiamo, allora? Muoviamoci! Quella sorpresa sarà nostra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100123,
					"content": "Sei brava in matematica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100108,
					"content": "#Perfetto. Modestamente, sono {F#la miglior fotografa}{M#il miglior fotografo} sulla piazza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100109
					]
				},
				{
					"id": 711100109,
					"content": "Direi che non vedi l'ora di iniziare, allora. Ci tengo a precisare che, nel caso i vostri lavori venissero selezionati, ci sarà una sorpresa speciale apposta per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				}
			]
		},
