			"dialogs": [
				{
					"id": 711100801,
					"content": "Uhm... Queste foto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100802,
					"content": "Che succede? Non sono abbastanza belle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100803,
					"content": "No, tutt'altro... Ho visto molti ottimi scatti, negli ultimi giorni, ma i vostri sono come una boccata d'aria fresca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100805,
					"content": "Porteremo questo al Villaggio di Qiaoying. Il pellicano aggiunge un tocco di vita alla tranquillità del villaggio, creando un contrasto tra la quiete e il movimento... Un approccio davvero singolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100806,
					"content": "Se dipendesse solo da me, sceglierei di sicuro di usare i vostri lavori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100807,
					"content": "Porca pupazza, che bel complimento! Paimon si sente un po' arrossire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100808,
					"content": "Arrossire? Guarda che non c'eri mica tu dietro la Fotokamera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "Paimon si stava solo sentendo lusingata al posto tuo! Paimon conosce bene la tua proverbiale modestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100811,
					"content": "Beh, a ogni modo, il processo di selezione sarà ultimato prima di domani mattina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100812,
					"content": "Dalle otto del mattino alle sei di sera, esporremo i lavori scelti sulla strada all'esterno della Stazione di Hezhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100813,
					"content": "Grazie per aver partecipato alla gara di fotografia scenografica \"La nostra gita alla Vallata Chenyu\". Non dimenticate di passare di nuovo domani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100814,
					"content": "Ci puoi contare! Non ci perderemmo la sorpresa finale per niente al mondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100810,
					"content": "Inizio a sentirmi un po' in imbarazzo anch'io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
