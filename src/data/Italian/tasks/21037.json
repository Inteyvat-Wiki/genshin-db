			},
			"dialogs": [
				{
					"id": 210370201,
					"content": "#Viaggiat{F#rice}{M#ore}, hai trovato il terriccio per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370202,
					"content": "Eccolo qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 2103703,
