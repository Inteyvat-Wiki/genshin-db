				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "Grazie! Così dovrebbe bastare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370302,
					"content": "Non sembri molto entusiasta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "Ahahah... Non voglio disturbarti, sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370304,
					"content": "Ma è solo che mi sento ancora riluttante ad abbandonare Liyue all'improvviso... Ci ho vissuto per così tanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370305,
					"content": "Quando parti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "Quando saranno pronti i rifornimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370307,
					"content": "Ah, sì... Ci sarà anche l'avventuriera che mi ha portato nella Voragine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370308,
					"content": "Quando ha saputo che sarei andato a Fontaine, è rimasta intrigata e ha deciso di venire con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370309,
					"content": "Il mercante è contento di avere un altro avventuriere a proteggerlo. Ma, in tutta onestà, non sono per niente bravo a comunicare con le persone entusiaste... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370310,
					"content": "Non avrei mai pensato di fare un viaggio del genere un giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
