			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccola Que'er",
					"Zhiruo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "Deve averlo fatto di proposito, Zhiruo! È perché... non vuole stare con me! *piagnucola*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 210370402,
					"content": "Que'er, voi due avete trascorso molto tempo insieme, deve sapere cosa stai pensando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370403,
					"content": "Stavolta è determinato a lasciare Liyue per viaggiare all'estero. Avrà le sue ragioni. Quindi che male c'è se parti con lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370404,
					"content": "Non voglio lasciare questo posto! Perché non possiamo stare qui per sempre? Il clan Guhua... Non potrebbe importarmene di meno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 210370405,
					"content": "Allora perché non glielo dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370406,
					"content": "Io... *sospira* La sua massima ambizione è riportare in vita il clan. Se sapesse quello che penso, mi odierebbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 210370407,
					"content": "*sospira* Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
