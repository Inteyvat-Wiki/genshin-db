			"dialogs": [
				{
					"id": 102030201,
					"content": "*piagnucola* Farò più attenzione la prossima volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030202
					],
					"speakerTitle": "Cella d'isolamento"
				},
				{
					"id": 102030202,
					"content": "La prossima volta, porterò a termine una grande avventura eroica tutta da sola, e lo farò in sicurezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030203
					],
					"speakerTitle": "Cella d'isolamento"
				},
				{
					"id": 102030203,
					"content": "Ho sentito che la Gilda degli avventurieri ha le sue regole. Mi chiedo se sia possibile convincerla a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030204
					],
					"speakerTitle": "Cella d'isolamento"
				},
				{
					"id": 102030204,
					"content": "Uuuh... Se Cyrus sentisse questa storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030205
					],
					"speakerTitle": "Paimon"
				},
				{
