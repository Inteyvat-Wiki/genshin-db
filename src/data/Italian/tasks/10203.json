			"dialogs": [
				{
					"id": 102030101,
					"content": "*sospira* Klee non è una bambina qualunque. Infatti, detiene il titolo di Cavalier Scintilla tra i nostri ranghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030102,
					"content": "Non ci credo! Perfino Klee può far parte dei Cavalieri di Favonius?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030103,
					"content": "Paimon sembra invidiosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "Già! Paimon pensa che sia un'ingiustizia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030106,
					"content": "Anche se... il nome può avere un senso, se si pensa al tesoro di Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030107,
					"content": "Sì. Crea non pochi problemi ai Cavalieri di Favonius, ma ci teniamo molto a lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030108,
					"content": "Per quanto riguarda la sua storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030109,
					"content": "Per farla breve, con il passare del tempo la conoscerai meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030110,
					"content": "#Tienila d'occhio in futuro, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030104,
					"content": "#Beh, fa più effetto rispetto a Cavaliere Onorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				}
			]
		},
