			"dialogs": [
				{
					"id": 200690201,
					"content": "In che stato sono i fiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690202,
					"content": "Sottoterra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690203
					]
				},
				{
					"id": 200690203,
					"content": "Grazie. Li lasceremo lì sulla montagna per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690204,
					"content": "Eheh, grazie mille per avermi aiutata. Ti prego di accettare questo per il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690205
					],
					"speakerTitle": "Flora"
				}
			]
		},
