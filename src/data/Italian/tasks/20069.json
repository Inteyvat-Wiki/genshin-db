				{
					"id": 200690324,
					"content": "Per favore, aiutami a disporre questi fiori <color=#00E1FFFF>vicino alla Statua dei Sette</color> e <color=#00E1FFFF>all'ingresso di una caverna sulla montagna</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690325
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690325,
					"content": "Poi, vorrei che trovassi una zona <color=#00E1FFFF>con dell'acqua sulla montagna</color>. Un lago o uno stagno andranno bene... Basta seppellire i fiori ai margini dello specchio d'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690326
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690326,
					"content": "Ti prego di fare particolare attenzione a non danneggiarli questa volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690321,
					"content": "Dove dovrei seppellirli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690322
					]
				},
				{
					"id": 200690311,
					"content": "Meglio venderli tutti il giorno stesso, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690312
					]
				},
				{
					"id": 200690312,
					"content": "Sarebbe la cosa migliore, ma rimangono sempre un paio di fiori invenduti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690313
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690313,
					"content": "So che si tratta solo di uno o due fiori, ma non voglio lasciarli appassire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690314
