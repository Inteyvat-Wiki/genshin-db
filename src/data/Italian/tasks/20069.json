			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "Anche questi fiori non hanno un bell'aspetto. Che peccato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690102,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Beh, molte persone tendono a comprare dei fiori singoli come regalo, quindi, di solito, ne taglio alcuni proprio per questo motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690104,
					"content": "Ma i fiori che taglio non rimangono freschi a lungo. Se non vengono venduti, appassiscono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690105,
					"content": "In passato ho provato diversi metodi, ma i fiori appassiscono comunque a fine giornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690106,
					"content": "Chissà se c'è un modo per conservare quei fiori più a lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690107,
					"content": "Conservazione, mmh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "Ho sentito dire a Sara del Buon Cacciatore che di solito loro mettono gli ingredienti che non utilizzano in un luogo fresco, o li conservano usando dei blocchi di ghiaccio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690109,
					"content": "Ho provato anch'io questi metodi, ma i fiori conservati usando i blocchi di ghiaccio finiscono sempre per avere un aspetto strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690110,
					"content": "Non appassiscono, ma non li definirei neanche freschi... E in ogni caso, non sarebbero più presentabili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690114,
					"content": "Ho chiesto a diverse persone, incluso il signor Sayid... Sai chi è, vero? Il ricercatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690115,
					"content": "Un giorno, quando è venuto a comprare dei fiori, mi ha detto che una volta aveva letto in un libro come refrigerare i fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690116,
					"content": "Nello specifico... Si tratta di usare un contenitore per conservare i fiori per poi posizionarlo vicino a dei blocchi di ghiaccio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690117,
					"content": "Ha detto anche che se volessi fare degli esperimenti, il posto più adatto sarebbe l'ambiente a basse temperature del Picco del Drago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690118,
					"content": "Ma ho sentito dire che il Picco del Drago è un posto molto pericoloso, e non ho trovato nessun avventuriere disposto ad aiutarmi con così poco preavviso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690119,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti aiutarmi a seppellire questi tre contenitori di fiori nella neve del Picco del Drago?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690120,
					"content": "Consideralo fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "Grazie per l'aiuto. Fammi pensare... Ho sentito che il Picco del Drago è enorme, e ha un sacco di zone differenti, il che potrebbe portare a risultati piuttosto diversi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690123,
					"content": "Forse potrebbe essere utile fare un confronto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690124,
					"content": "Per favore, aiutami a disporre questi fiori <color=#00E1FFFF>vicino alla Statua dei Sette</color>, <color=#00E1FFFF>vicino a uno specchio d'acqua</color> e... <color=#00E1FFFF>all'ingresso di una caverna</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690121,
					"content": "Dove dovrei seppellirli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "Meglio venderli tutti il giorno stesso, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "Sarebbe la cosa migliore, ma rimangono sempre un paio di fiori invenduti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690113,
					"content": "So che si tratta solo di uno o due fiori, ma non voglio lasciarli appassire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				}
			]
		},
