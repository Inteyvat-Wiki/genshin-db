					"id": 3740701,
					"content": "Quindi questa... \"Lira sacra celeste\" è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740702,
					"content": "Uno dei tesori più apprezzati di Mondstadt. È la lira che suonava Barbatos stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740703,
					"content": "Suonandola, forse potrei aiutare Dvalin a ritrovare la sua natura gentile e a dimenticare l'incubo che sta vivendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740704,
					"content": "Credi davvero che possa impedire a Terrore alato di causare altri danni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740705,
					"content": "Certo. Sono il miglior bardo al mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740706,
					"content": "Non esiste canzone che io non conosca, che sia del passato, del presente o del futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740707,
					"content": "Guardami negli occhi. Non mi trovi affidabile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740708,
						3740709,
						3740710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740708,
					"content": "Cos'hai... negli occhi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740711,
					"content": "Ahahah, con i bardi non attacca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740712,
					"content": "Come possiamo trovare la Lira sacra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740713,
					"content": "Gira voce che sia nascosta in un luogo sicuro all'interno della cattedrale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740714,
					"content": "Vado a dare un'occhiata. Se volete, potete venire anche voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740709,
					"content": "Guardami negli occhi. Cosa stai nascondendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740710,
					"content": "I tuoi occhi hanno lo stesso colore del cielo della mia città natale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				}
			]
		},
