			"dialogs": [
				{
					"id": 3740401,
					"content": "Barbatos ti benedica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740402,
					"content": "Ciao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "Ah, sei tu! L'ultima recluta dei Cavalieri di Favonius, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740406,
					"content": "Cosa ti porta qui? La Gran Maestra Reggente ti ha affidato un incarico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740411,
					"content": "Proprio così. I Cavalieri di Favonius vorrebbero in prestito la Lira sacra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "Ah, sì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740413,
					"content": "Non che non mi fidi di te, ma anche un bardo dall'aria sospetta ha chiesto in prestito la Lira sacra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740414,
					"content": "Non ha fatto altro che blaterare, si è perfino definito Barbatos. Starà sicuramente tramando qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740415,
					"content": "L'utilizzo della Lira sacra è regolato da alcune norme. Al momento, viene utilizzata solamente nel corso del Ludi Harpastum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740416,
					"content": "Occorrono dei documenti firmati dal Gran Maestro, dal Siniscalco e dal rappresentante della comunità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740417,
					"content": "Posso vedere il documento dei Cavalieri di Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740418,
					"content": "Il Gran Maestro non ne ha parlato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "È necessario un documento firmato. Senza non posso fare molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740423,
					"content": "Ora, se volete scusarmi... Ultimamente non ho un attimo di pausa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740419,
					"content": "Mi dispiace, ho dimenticato di portarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "Paimon l'ha mangiato lungo la strada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740404,
					"content": "#Sono {NICKNAME}, Cavaliere Onorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "Ti conosco. Quel giorno, tu e Amber avete salvato Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gotelinde"
				}
			]
		},
