			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080201,
					"content": "Hai trovato la bava di Melmoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
		{
			"id": 2300803,
			"completionStepIds": [
				2300803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300803",
							"2"
						],
						"stepId": 2300803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "Fantastico! Ci siamo. Dammi solo un attimo, ci metterò davvero poco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080302,
					"content": "Poco più tardi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "Ahah, la mia ipotesi era giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080304,
					"content": "Nonostante aderisca bene, la terra umida si sgretola facilmente dopo essersi indurita. Ma se la mescoliamo con quella dei Malefiori, la terra solidificata diventa più elastica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080305,
					"content": "Tuttavia, la miscela non può essere modellata prima che inizi a solidificarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080306,
					"content": "Ma aggiungendo la terra proveniente dall'habitat dei Melmosi, la miscela può essere modellata più facilmente prima che si solidifichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080307,
					"content": "Non so bene cosa sia successo, ma se dovessi spiegarlo, direi che la terra è diventata qualcosa di simile ai Melmosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080308,
					"content": "Allora potremmo chiamarla \"Melmoterra\", eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "Sembra che alcune proprietà dei Melmosi alterino la miscela. Ecco perché mi chiedevo se aggiungendo altra bava di Melmoso il risultato sarebbe stato più efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080312,
					"content": "E, come si è visto, la plasticità e la solidità della miscela cambiano a seconda della quantità di bava di Melmoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080313,
					"content": "Ciò significa che la miscela può essere utilizzata non solo per creare materiali da costruzione, ma anche per realizzare ceramiche e molte altre cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080314,
					"content": "Buon per te!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "Grazie. Suppongo che questo sia ciò che i saggi intendono per \"i grandi cambiamenti nascono dalle piccole cose\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080317,
					"content": "Non dovremmo sottovalutare questa umile terra. Un giorno potrei costruirci una torre così alta da toccare il cielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080318,
					"content": "Ho deciso di chiamare questa miscela \"Cementerra\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080319,
					"content": "Ora bisogna capire cosa è in grado di realizzare questa Cementerra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080320,
					"content": "Ah, inizio a vedere una possibile soluzione ai problemi che di recente stanno affliggendo le case delle persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080321,
					"content": "#Grazie ancora, viaggiat{F#rice}{M#ore}. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080315,
					"content": "I tuoi sforzi sono stati finalmente ripagati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "Sembra qualcosa che piacerebbe anche a Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "Ehi! Paimon non mangia la terra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}