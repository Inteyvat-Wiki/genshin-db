			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "Ancora una volta, signor Garcia, le consiglio vivamente di vendere qualche libro per racimolare un po' di Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131102,
					"content": "No! Per niente al mondo! Lutong, mio caro, mi stai chiedendo di mettere in vendita la mia anima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131103,
					"content": "Ma signore... Nessuno fa offerte per le anime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131104,
					"content": "Perché siete ancora qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "#Oh, viaggiat{F#rice}{M#ore}! Cosa ti porta qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131107,
					"content": "Uhm... Il mio ultimo esperimento non ha funzionato. Qualcosa non va con la diluizione della bava di Melmoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131108,
					"content": "Al posto di lubrificare i cuscinetti della macchina numeratrice, il lubrificante ha aumentato le probabilità che si incastrino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131109,
					"content": "Quindi ho bisogno di altra bava di Melmoso per altri esperimenti. Potresti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131110,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "#Viaggiat{F#rice}{M#ore}, aiutaci a raccogliere della bava di Melmoso. Preparerò la ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131111,
					"content": "Non avete modo di guadagnare un po' di Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "Non che non ne abbiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131113,
					"content": "È una questione di abilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131114,
					"content": "Grazie mille per la spiegazione tempestiva, mio caro Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131115,
					"content": "Beh, è sicuramente un peccato... Anche se ho finito di costruire la macchina numeratrice, le sue funzioni sono incalcolabilmente insoddisfacenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131116,
					"content": "Non è nemmeno in grado di operare decentemente come calcolatrice automatica: richiede un aiuto manuale per facilitarne il funzionamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131117,
					"content": "Ma la migliorerò! Sono fermamente convinto che la mia macchina numeratrice sarà una grande invenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131118,
					"content": "Una... Un'invenzione che annuncia una nuova era! E poi sono sicuro che troverò un modo per guadagnare Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131119,
					"content": "C-Comunque sia, prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131105,
					"content": "Avete bisogno di altra bava di Melmoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
