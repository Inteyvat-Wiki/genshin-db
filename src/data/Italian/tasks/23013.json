					"nextDialogs": [
						230135205
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135205,
					"content": "#Ecco il tuo compenso, viaggiat{F#rice}{M#ore}. Grazie per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135206
					],
					"speakerTitle": "Lutong"
				},
				{
