			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "Lutong, mio caro Lutong, sei sicuro che questo sia il posto giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130102,
					"content": "Sì, signor Garcia, questo è il luogo dove i Melmosi si radunano spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130103,
					"content": "Ne sono più che certo. Tuttavia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130104,
					"content": "Concordi sul fatto che la quantità di Melmosi sia leggermente eccessiva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130105,
					"content": "Signor Garcia, questo è quello che succede quando rimaniamo a corto di fondi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130106,
					"content": "Tu sei... Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "#Viaggiat{F#rice}{M#ore}! Che coincidenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130109,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "Ahah. Beh, sono qui per...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130111,
					"content": "Un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130112,
					"content": "Una valorosa avventura! Lutong, potresti non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130113,
					"content": "Come desideri, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130114,
					"content": "A dire il vero, sono qui per cercare della bava di Melmoso da usare come lubrificante per la mia macchina numeratrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130115,
					"content": "Purtroppo, la maggior parte della bava di Melmoso in vendita è di bassa qualità perché è stata conservata troppo a lungo. E poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130116,
					"content": "Il signor Garcia ha acquistato troppi libri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130117,
					"content": "Oh, andiamo, quelle erano... spese necessarie... che ci hanno fatto rimanere a corto di Mora, è vero, ma comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130118,
					"content": "Ecco perché siamo venuti qui: per raccogliere della bava di Melmoso fresca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130119,
					"content": "Ma come si può notare, anche se il nostro buon Lutong è di Liyue, non conosce né le arti marziali né ha doti culinarie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130120,
					"content": "Fortunatamente, io ho un gran talento in materia di contabilità... e questo grazie alle complesse norme fiscali del Ministero degli Affari Civili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130121,
					"content": "...Per quanto mi riguarda, non posso di certo colpire i Melmosi con i componenti della mia macchina numeratrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130122,
					"content": "Avete bisogno del mio aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "Beh, in un certo senso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130124,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130125,
					"content": "Lutong, ci è... ehm... rimasto qualche Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130126,
					"content": "#Beh, immagino che troveremo un modo per tirare avanti dopo aver ricompensato {F#la}{M#il} viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130127,
					"content": "#Fantastico. Viaggiat{F#rice}{M#ore}, ti sarei grato se potessi gentilmente portarmi un po' di bava di Melmoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130107,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
		{
