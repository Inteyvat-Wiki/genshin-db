			"dialogs": [
				{
					"id": 230135001,
					"content": "Signore, questo dev'essere il luogo che stiamo cercando. Ora non dobbiamo far altro che ingaggiare qualcuno con cui tornare qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135002,
					"content": "Signore? Signor Garcia, mi sta ascoltando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135003,
					"content": "Cosa? Oh... Certo che ti sto ascoltando. Torniamo indietro e ingaggiamo qualcuno. Non ci vorrà molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135004,
					"content": "Va... Va tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135005
					]
				},
				{
					"id": 230135005,
					"content": "#Ah, viaggiat{F#rice}{M#ore}... Va tutto bene, sto bene. Sembro star male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135006,
					"content": "Ora mi sto dedicando totalmente alla macchina numeratrice, e sento di essere a un passo dal successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135007
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135007,
					"content": "Se vuoi darmi una mano, potresti portarmi un po' di bava di Melmoso, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135008,
					"content": "Giacché sei qui, non devo tornare in città per ingaggiare qualcuno. Ho anche guadagnato un po' di soldi, quindi posso offrirti un compenso migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135009,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				},
				{
					"id": 230135011,
					"content": "#Allora lascio fare a te, viaggiat{F#rice}{M#ore}. Io devo pensare a come cambiare la struttura del meccanismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135010,
					"content": "Affare fatto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				}
			]
		},
