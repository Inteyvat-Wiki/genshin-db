					"speakerTitle": "Lutong"
				},
				{
					"id": 230135102,
					"content": "A proposito di Garcia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135104
					]
				},
				{
					"id": 230135104,
					"content": "Sì, è per la signorina Kaia. Anche se il signor Garcia non ne parla, a lavoro è sempre più distratto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135105,
					"content": "E non è mai più tornato in quel bar. Ora manda me a prendergli il caffè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135106
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135106,
					"content": "Persino il signor Ahangar è venuto a dirmi che, qualora fosse necessario, può parlare lui col signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135107,
					"content": "È la prima volta che mi capita una situazione del genere, quindi non so come rimettere in riga il signor Garcia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135108,
					"content": "*sospira* Sembra che io e il signor Garcia dovremo affrontare l'ennesimo ostacolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135103,
					"content": "È ancora...",
