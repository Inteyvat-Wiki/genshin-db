			"dialogs": [
				{
					"id": 230135201,
					"content": "#Viaggiat{F#rice}{M#ore}, hai trovato la bava di Melmoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135202,
