					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135203
					]
				},
				{
					"id": 230135203,
					"content": "#Bene, è sufficiente. Lutong, ti spiace pagare {F#la}{M#il} viaggiat{F#rice}{M#ore}?",
