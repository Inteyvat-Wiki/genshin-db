				"points": []
			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "Lutong, i nostri Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130202,
					"content": "Ce la caveremo, signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130203,
					"content": "A Liyue c'è un vecchio detto: \"La migliore via d'uscita è sempre attraverso\". Credo che descriva alla perfezione la situazione in cui ci troviamo in questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130204,
					"content": "Significa che il modo migliore per superare un ostacolo è affrontarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130205,
					"content": "Ah! Che metafora geniale. Allora suppongo che la nostra situazione non sia così disastrosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130206,
					"content": "Tuttavia... Signor Garcia, crede davvero che la persona che ha scritto queste parole abbia trovato un modo per superare l'ostacolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130207,
					"content": "Eh? Dai, Lutong, non portare sfortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301303,
			"completionStepIds": [
				2301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301303",
							"2"
						],
						"stepId": 2301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "#Viaggiat{F#rice}{M#ore}, hai trovato la bava di Melmoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130302,
					"content": "Ce l'ho proprio qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "Fantastico! Dovrebbe bastare. Riprenderò i miei esperimenti al mio ritorno. Con questo lubrificante, la mia macchina numeratrice potrà sicuramente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130304,
					"content": "Ora devo occuparmi della mia ricerca. Lutong, per favore, pensa tu alle altre faccende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130305,
					"content": "Sì, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130306,
					"content": "#Ecco la tua ricompensa, viaggiat{F#rice}{M#ore}. Ti ringrazio davvero tanto per il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130307,
					"content": "E, uhm... A mio modesto parere, potremmo avere bisogno del tuo aiuto anche in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130308,
					"content": "#Non temere: finché continuerò a occuparmi della contabilità, verrai ricompensat{F#a}{M#o} in modo adeguato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130309,
					"content": "*sospira*...In realtà, ho deciso di viaggiare con il signor Garcia perché non volevo passare tutta la mia vita a occuparmi della contabilità in un dipartimento del Ministero degli Affari Civili come i miei genitori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130310,
					"content": "Ma ora... oltre a lavorare con il signor Garcia alla sua macchina, devo anche aiutarlo a gestire la contabilità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130311,
					"content": "Suppongo che questo sia ciò che chiamano destino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301311,
