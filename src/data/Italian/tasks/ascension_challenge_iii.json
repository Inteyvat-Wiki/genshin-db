				"points": []
			},
			"dialogs": [
				{
					"id": 706680201,
					"content": "Miao! (Favoloso! Congratulazioni per il completamento della sfida d'ascensione. Adesso sei un giocatore maestro!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680202,
					"content": "Miao. (Essere giocatore maestro significa... che la tua tecnica ha superato quella di molte persone che hanno studiato il gioco. Quelli che non si impegnano abbastanza non saranno mai in grado di raggiungere livelli tali.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680203,
					"content": "(Ovviamente, non riescono a capire perché mai trascorriamo così tanto tempo su un gioco che di solito è legato al divertimento...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680205,
					"content": "Miao! (Qualora i giocatori da te invitati venissero a sapere che hai ottenuto il titolo di esperto, sicuramente prenderebbero con più serietà la partita contro di te.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680206,
					"content": "(Forse alcuni giocatori vogliono farti partecipare ai giochi preparati da loro solo dopo aver saputo che sei un giocatore maestro... Tipi così strani si trovano anche in taverna.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680207,
					"content": "#Miao... ({NICKNAME}...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680208
					],
					"speakerTitle": "Prince"
				},
				{
					"id": 706680208,
					"content": "(Che il divertimento sia con te nel mondo di Invokazione del genio!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Prince"
				}
			]
		},
