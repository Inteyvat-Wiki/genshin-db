			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "*tossisce* Aspetta! Fermati! Chi sei? Perché sei qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580102,
					"content": "E perché mi stai attaccando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580103,
					"content": "Parli proprio tu! Ti abbiamo visto aggirarti furtivamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580104,
					"content": "Visto che sei tu la cattiva, in questa situazione, perché non parli per prima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "Katarina. Mi chiamo Katarina Snezhevna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580106,
					"content": "Posso dirvi solo il mio nome. Scusatemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580107,
					"content": "Mmmh... Vogliamo solamente capire cosa sta succedendo. Non è un interrogatorio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580108,
					"content": "M-Mi spiace. Non posso dire altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580109,
					"content": "Che ci fanno qui i Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "È un'informazione riservata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580111,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "Suvvia, i cattivi adorano muoversi in segreto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580113,
					"content": "Eheh, hai ragione. Siamo i cattivi, siamo fatti così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580114,
					"content": "Ok, fine del botta e risposta. Abbiamo visite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105804",
							"2"
						],
						"stepId": 7105804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "Grazie... per non avermi accoltellata alla schiena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580202,
					"content": "Altrettanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "Bah... Non so come ti sia venuto in mente, ma questo non è un posticino romantico dove provarci con me... Se vuoi parlare possiamo andare al mio nascondiglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580207,
					"content": "Katarina se ne va.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "#Eh? Ma è una dei Fatui! Siamo sicur{F#e}{M#i} che sia il caso di lasciarla andare? Non sarebbe meglio consegnarla ai Milleliti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580206,
					"content": "Umpf... Va bene, Paimon capisce. Lasciamo perdere. Non ci ha fatto del male, dopotutto. Lasciamola andare stavolta, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580203,
					"content": "Allora, i Fatui hanno problemi a fidarsi, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "#Come previsto, sei venut{F#a}{M#o}. Siediti pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580502,
					"content": "Vediamo cosa mi è rimasto... Il tè nero è finito, lo zucchero pure... Bene, c'è un po' di latte... Bleah, è andato a male. Dopo dovrò buttarlo via. Ehm, accetta le mie scuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580503,
					"content": "Ma c'è Acquafuoco in abbondanza, oltre a qualche galletta e poi... marmellata agrodolce. Bastano per un ricevimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580504,
					"content": "Wow! Voi Fatui pensate davvero che l'Acquafuoco sia una bevanda adatta per un ricevimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580505,
					"content": "Sì, che problema c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580506,
					"content": "Ehm... no, grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "Perché? Eheh, nessuno ti sgriderà per aver bevuto alcolici. Fai come preferisci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580510,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "\"Condividere cibo e informazioni al momento giusto è una mossa utile a far tacere una bocca curiosa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580513,
					"content": "Così dice il nostro manuale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580514,
					"content": "Beh? Dove sono le informazioni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "Le ho appena condivise con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580516,
					"content": "Eh? Ci hai detto qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580517,
					"content": "Manuale della squadra di esplorazione dei Fatui, appendice 4-4, articolo 32: \"Condividere cibo e informazioni al momento giusto è una mossa utile a far tacere una bocca curiosa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580518,
					"content": "Mi hai salvato la vita e in cambio ho divulgato contenuti riservati dal nostro manuale. Eheh, non ti basta questa dose di sincerità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580519,
					"content": "E cosa ce ne facciamo?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580520,
					"content": "Eheh, scherzi a parte... Sono molto grata per l'aiuto, ma il mio bel gesto non ha altri significati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580521,
					"content": "Mmmh... visto tutto ciò che voi Fatui avete combinato, Paimon non si fida molto del tuo \"bel gesto\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580522,
					"content": "Sul serio, che intenzioni hai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "Non mi sorprende che gli altri non riescano a capire la causa dei Fatui. Ma quando non parliamo di ciò a cui ambiamo e dichiariamo da che parte stiamo, alla fine siamo persone comuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580524,
					"content": "Oltretutto, tutti i nostri piani e le nostre azioni sono solo attività preparatorie alla battaglia finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580525,
					"content": "La battaglia finale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "Sì, prima o poi noi tutti dovremo affrontare un nemico comune e l'ineluttabile oscurità eterna... Tutti gli abitanti di Snezhnaya sono stati preventivamente informati di ciò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580527,
					"content": "Quindi ogni lacrima e goccia di sangue versate per il bene di questo mondo crudele... non saranno versate invano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580528,
					"content": "Brindiamo! No? Tsk, allora faccio da sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580529,
					"content": "È così che giustifichi il male che causi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "#Forse hai ragione... Però non lo so e non mi interessa saperlo. Volevi una spiegazione e te ne ho data una. Sei liber{F#a}{M#o} di non trovarla di tuo gradimento. Tutto qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580534,
					"content": "Mah... Da dove arriva tutta questa profondità all'improvviso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580535,
					"content": "A proposito, mi sono presentata ma non conosco ancora il tuo nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "E Paimon... è Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580539,
					"content": "Ah! I vostri nomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580540
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580540,
					"content": "#Eheheh! Siamo piuttosto famos{F#e}{M#i} in tutta Teyvat, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580541,
					"content": "#Mi dispiace, non ho mai sentito parlare di te... di nessun{F#a}{M#o} dei due, a dire il vero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580542
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580542,
					"content": "Cosa?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580543,
					"content": "Non fraintendetemi... mi hanno mandata qui tanto tempo fa. So a malapena cosa sta succedendo in superficie, tranne per le notizie che riceviamo tramite le nostre linee di rifornimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580544
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580544,
					"content": "Eh... Questo significa che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580545,
					"content": "Che la tua linea di rifornimento è stata interrotta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580546
					]
				},
				{
					"id": 710580546,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580547
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580547,
					"content": "Il ricevimento finisce qui! Devo riposarmi. Scusate!",
