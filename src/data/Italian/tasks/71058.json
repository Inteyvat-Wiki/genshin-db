					"nextDialogs": [
						710580555
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580555,
					"content": "Ehm, no niente. Stavo pensando che... se fossi in te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580556
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580556,
					"content": "Torna un altro giorno... se non ti crea troppi problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580552,
					"content": "Ognuno ha i propri gusti, sai?",
