			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "#Viaggiat{F#rice}{M#ore}... Mi hai davvero preparato una tazza di caffè? Mm... Scusa per il disturbo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130402,
					"content": "Non preoccuparti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "Questo caffè... è molto più buono della robaccia che servono alla Maison Gestion! È quasi un'altra dimensione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130405,
					"content": "Se questo fosse il caffè che bevo ogni giorno, non passerei tutto il tempo a barcollare per il sonno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130406,
					"content": "Grazie per il caffè. Tornerò al lavoro una volta finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130407,
					"content": "Dai il massimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "Va bene. Voglio diventare bravissimo nel mio lavoro il prima possibile, e camminare con le mie gambe proprio come Roialte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130410,
					"content": "*sospira* Mi chiedo solo quanti incubi dovrò sopportare prima di allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130408,
					"content": "Su col morale!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "Bevi e basta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
		{
			"id": 2401331,
			"completionStepIds": [
				2401306
			],
