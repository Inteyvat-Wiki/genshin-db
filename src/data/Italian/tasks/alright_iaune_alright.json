			},
			"dialogs": [
				{
					"id": 240133101,
					"content": "Sembra fantastico! È ora di preparare il caffè!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240133102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240133102,
					"content": "Inizi a preparare il caffè...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "Oh, che profumo! Diamolo a Iaune. Paimon spera che lo tiri un po' su!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
