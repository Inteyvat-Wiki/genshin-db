			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "Grazie infinite, credevo di essere spacciata... Quella banda di Cacciatori di tesori mi ha seguita fin dall'inizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551002,
					"content": "Proprio quando avevo fatto qualche passo avanti con la ricerca e iniziavo a pensare che sarebbe stato bello trovare il tesoro e portarlo via con me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551003,
					"content": "I Cacciatori di tesori hanno invaso il mio accampamento, poi mi hanno rapita e portata qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551004,
					"content": "Non hanno fatto che riempirmi di domande sull'ubicazione del tesoro, e mi hanno minacciata di uccidermi se non l'avessi rivelata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551005,
					"content": "Ma non potevo rivelarla, perché a quel punto la mia vita sarebbe finita davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551006,
					"content": "*sospira* Avrei dovuto dare retta a Soraya. Dice sempre che noi archeologi dobbiamo concentrarci sui risultati accademici, non sui tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551007,
					"content": "Ma non mi danno molti fondi, e la scrittura di qualche saggio non basta neanche a risarcire le spese di viaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551008,
					"content": "Non riesco assolutamente a capire come abbia fatto Soraya a rimanere a Liyue da sola per tutto questo tempo. Mi sento esausta solo a guardare la pila dei manoscritti che non le hanno approvato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551009,
					"content": "Cos'hai intenzione di fare ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "Che altro potrei fare? Ho finito di raccogliere i materiali di ricerca che mi servivano. E il tesoro... puoi prenderlo tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551011,
					"content": "Non ripeterò il contorto ragionamento che mi ha portata qui. Ti basti sapere che il tesoro è sepolto <color=#00E1FFFF>sotto il grande albero dorato</color> nel mezzo del Passo di Lingju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551012,
					"content": "Prendilo, se vuoi. Ti scrivo com'è fatto, così non te lo dimentichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551013,
					"content": "Mi riposerò un po', poi tornerò all'accampamento per racimolare le mie cose. Devo andarmene da qui il prima possibile, o almeno prima che arrivino altri Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551014,
					"content": "Non so quanto mi ci vorrà per raggiungere la Locanda Wangshu. Spero solo che Soraya sia ancora lì quando arriverò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551015
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551015,
					"content": "*sospira* Se solo Soraya potesse farmi da insegnante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
