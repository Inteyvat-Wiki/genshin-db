						730650204
					],
					"speakerTitle": "Arapratap"
				},
				{
					"id": 730650204,
					"content": "#Sei pront{F#a}{M#o}, Nara buon{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730650205
