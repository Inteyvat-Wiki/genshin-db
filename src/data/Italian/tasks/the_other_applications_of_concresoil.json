					"nextDialogs": [
						230091809
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091809,
					"content": "N-Non l'ho ancora deciso... ma sarai la prima persona a saperlo quando l'avrò scelto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091810
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091810,
					"content": "Dopo Adri, creerò Ivar, il suo aiutante, e poi Lasson, il suo discepolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091811
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091811,
					"content": "Loro tre... anzi, i tre guerrieri in vaso... intraprenderanno un lungo, lunghissimo viaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nima"
				}
