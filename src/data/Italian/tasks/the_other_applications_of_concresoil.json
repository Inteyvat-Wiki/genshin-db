			"dialogs": [
				{
					"id": 230091701,
					"content": "Grazie. Ora ho tutti i materiali che mi servono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091702
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091702,
					"content": "Ora mescolerò la Cementerra, dammi solo un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091703
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091703,
					"content": "Akim inizia a mescolare la terra...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "Ecco fatto. Potresti portare la terra a Nima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091705
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091705,
					"content": "È da un po' che la sta aspettando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091706
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091706,
					"content": "Quel ragazzino è... ehm... insolitamente fantasioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091707
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091707,
					"content": "Nima mi ha detto che vuole creare dei \"guerrieri in vaso\" parlanti, in grado di travolgere i nemici e dotati di ogni genere di poteri magici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091708
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091708,
					"content": "La potenza di questi guerrieri varia a seconda dei materiali utilizzati per realizzare i loro corpi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091709
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091709,
					"content": "Ha perfino dato un nome a questi guerrieri in vaso, li ha chiamati Ad... Beh, lasciamo perdere, non me lo ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091710
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091710,
					"content": "Purtroppo non posso realmente creare dei guerrieri in vaso dotati di poteri magici. Nonostante ciò, è un'idea interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091711
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091711,
					"content": "Così ho pensato: perché non regalargli della terra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091712
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091712,
					"content": "In questo modo, potrà creare i suoi guerrieri in vaso e dar loro ordini come se fosse un generale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091713
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091713,
					"content": "Ehm, a ogni modo, aiutami a consegnare questo vaso di terra a Nima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091714
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091714,
					"content": "Quando i suoi guerrieri in vaso saranno pronti, forse nominerà anche noi due \"generali in vaso\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
