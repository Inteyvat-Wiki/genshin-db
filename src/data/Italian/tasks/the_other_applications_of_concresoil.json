			"dialogs": [
				{
					"id": 230090201,
					"content": "Ho ancora bisogno di altri materiali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090202,
					"content": "Come sta andando con la tua Cementerra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "Alla grande! A quanto pare, questa terra può essere utilizzata per svariati scopi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090204,
					"content": "Ad esempio, può essere usata per realizzare ceramiche o per riparare le crepe nelle case.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090205,
					"content": "Facendo una piccola modifica al rapporto di miscelazione, potrei persino costruire case con questa terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090206,
					"content": "Tuttavia... a causa dell'aumento degli ordini, sono a corto di materiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090207,
					"content": "#In particolare, ho finito la bava di Melmoso. Viaggiat{F#rice}{M#ore}, potresti portarmi altre tre porzioni di bava di Melmoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090208,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "#Pertanto, viaggiat{F#rice}{M#ore}, potresti andare a prendermi altre tre porzioni di bava di Melmoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090209,
					"content": "E gli altri materiali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "Li ho acquistati da altri canali e ho chiesto aiuto ad altre persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090211,
					"content": "Solo che non mi aspettavo che la bava di Melmoso terminasse così velocemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "Akim"
				}
			]
		},
