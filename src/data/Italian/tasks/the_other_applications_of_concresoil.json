					"nextDialogs": [
						230091805
					]
				},
				{
					"id": 230091805,
					"content": "#Akim non te l'ha detto, {F#signorina}{M#signore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091806
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091806,
					"content": "Creerò dei guerrieri in vaso. Adri sarà il primo e il migliore di tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091807
					],
					"speakerTitle": "Nima"
				},
				{
					"id": 230091807,
					"content": "È un guerriero gentile, dal carattere mite. Quando si risveglierà come guerriero in vaso, la prima cosa che farà sarà chiedere scusa all'erba sotto di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091808
					],
					"speakerTitle": "Nima"
				},
