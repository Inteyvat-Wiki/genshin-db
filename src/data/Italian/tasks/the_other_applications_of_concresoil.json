			"dialogs": [
				{
					"id": 230091401,
					"content": "Uff, ho combinato un pasticcio. Dove ho sbagliato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091402
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091402,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091403
					]
				},
				{
					"id": 230091403,
					"content": "#Oh, sei... sei tu, viaggiat{F#rice}{M#ore}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091404,
					"content": "*sospira* C'è qualcosa che non va nella mia Cementerra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091405,
					"content": "Forse il problema è il rapporto di miscelazione? Oppure la mancanza di prove sperimentali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091406,
					"content": "Molti clienti che hanno costruito le loro cucine utilizzando la Cementerra hanno segnalato la presenza di crepe dopo pochi giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091407,
					"content": "Forse la temperatura ha raggiunto livelli così elevati che alcuni elementi della terra non hanno funzionato a dovere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091408,
					"content": "*sospira* A ogni modo, devo andare a riparare quelle crepe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091409,
					"content": "Non sono riuscito a portare via la Cementerra raschiata perché c'erano troppe persone che mi hanno chiesto di riparare le loro case, così ho chiesto loro di conservarla nei vasi. E sì, c'erano molti vasi, in effetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091410,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti aiutarmi a raccogliere la Cementerra usata in questa casa, mentre io vado in un'altra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091411,
					"content": "*sospira* Dove diavolo ho sbagliato?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
