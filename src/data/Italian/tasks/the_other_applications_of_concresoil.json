						230090812
					]
				},
				{
					"id": 230090812,
					"content": "Grazie. E ricordati che ciò che stiamo cercando è la terra su cui crescono i Malefiori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230090809,
					"content": "E gli altri materiali?",
					"roleType": "TALK_ROLE_PLAYER",
