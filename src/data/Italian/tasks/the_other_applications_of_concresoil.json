					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230091101,
					"content": "#Viaggiat{F#rice}{M#ore}! Per fortuna sei qui. Avevo proprio bisogno d'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091102,
					"content": "Allora, hai fatto progressi nelle tue ricerche sulla terra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091103
					]
				},
				{
					"id": 230091103,
					"content": "Beh... Non credo di poterli definire \"progressi\", ma un mio cliente mi ha dato un consiglio molto utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091104,
					"content": "Mi ha detto che gli piace coltivare i fiori e che la cosa che gli crea più problemi è trovare la terra giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091114,
					"content": "La terra deve avere la giusta permeabilità e un adeguato apporto di sostanze nutritive. Inoltre, dovrebbe essere in grado di trattenere l'acqua, ma non deve essere molliccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091105,
					"content": "Poiché sa che ho apportato dei miglioramenti alla Cementerra, mi ha chiesto di ideare qualcosa di simile per i fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091106,
					"content": "Ho pensato di fare delle ricerche, quindi sto cercando altri materiali per migliorare ulteriormente la mia Cementerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091107,
					"content": "Potresti aiutarmi a cercare della terra fertile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091108,
					"content": "Ecco, ti segno la posizione della terra sulla mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091109,
						230091110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091109,
					"content": "Perché si trova così lontano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230091111
					]
				},
				{
					"id": 230091111,
					"content": "Ho chiesto informazioni in giro, naturalmente. È un po' fuori mano, ma dicono che lì il terreno sia molto fertile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091112,
					"content": "Ma sembra che ci siano anche tantissimi mostri laggiù, quindi non ho il coraggio di andarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091113
					],
					"speakerTitle": "Akim"
				},
