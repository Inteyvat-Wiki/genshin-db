			"dialogs": [
				{
					"id": 761830101,
					"content": "Grazie per l'invito, Sandrone. Questo cibo ha lo stesso sapore che ricordavo, mi riporta alla mente tanti ricordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830102
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830102,
					"content": "Di niente. Se ti va, quando tornerò a Snezhnaya potremo vederci più spesso, proprio come ai vecchi tempi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830103,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830104
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830104,
					"content": "A proposito di Snezhnaya, come stanno andando le cose da parte tua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830105
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830105,
					"content": "I piani di Sua Maestà la Tsaritsa hanno fatto qualche progresso iniziale, ma attuare il Progetto Stuzha si sta rivelando più difficile di quanto il Sindaco avesse previsto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830106
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830106,
					"content": "Allora pare che saremo entrambe molto indaffarate, d'ora in poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830107
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830107,
					"content": "Ma dovremmo sempre trovare un attimo per prendere una tazza di tè, ogni tanto, o magari per assistere a un'esibizione della Compagnia Korolevskiy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830124,
					"content": "Infatti. Ma dovremmo sempre trovare un attimo per prendere una tazza di tè, ogni tanto, o magari per assistere a un'esibizione della Compagnia Korolevskiy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830108
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830108,
					"content": "Odette si esibisce ancora nel balletto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830109
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830109,
					"content": "Sì. Ogni volta che la vedo, sembra migliorare sempre di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830110
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830110,
					"content": "Incredibile. Mi piacerebbe vederla esibirsi di nuovo, quando tornerò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830111
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830111,
					"content": "Lo trovo davvero affascinante: nonostante sia stata Rosalyne a insegnarle la sua arte, il loro stile e il loro temperamento sono letteralmente agli antipodi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830112
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830112,
					"content": "Non è necessariamente un male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830113
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830113,
					"content": "Vero... Rosalyne danzava con una passione ardente, mentre Odette è come ghiaccio solido: gelida e impenetrabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830114
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830114,
					"content": "Sembra portare un pesante fardello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830115
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830115,
					"content": "Tuttavia, quando si esibisce sul palco, i suoi movimenti sono immacolati, come se il suo cuore si liberasse da ogni minima imperfezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830116,
					"content": "O forse ha sigillato cose del genere lì dove nessuno può vederle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830117
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830117,
					"content": "Forse. In fondo, è proprio questo che fa il ghiaccio: congela le fratture. Ma lei non è fragile, è risoluta. Direi piuttosto che è pericolosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830118
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830118,
					"content": "Almeno sotto questo aspetto, somiglia a Rosalyne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830119
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830119,
					"content": "Perché è pericolosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830120
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830120,
					"content": "Perché è risoluta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830121
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830121,
					"content": "Suppongo di sì. Dopotutto, si vocifera che sia la favorita per ereditare il titolo di \"Signora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830122
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830122,
					"content": "Ah... Dopo che l'avremo conosciuta meglio, potremmo invitarla a prendere un tè. Sperando che non rifiuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830123
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830123,
					"content": "Lo spero anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "La Fantesca"
				}
			]
		},
