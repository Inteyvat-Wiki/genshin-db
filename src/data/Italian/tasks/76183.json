				"points": []
			},
			"dialogs": [
				{
					"id": 761830201,
					"content": "Trovare il tempo di rilassarsi ogni tanto è importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830202,
					"content": "(Restiamo sedute così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761830204,
					"content": "Va bene. Ci vedremo a Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 761830203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
