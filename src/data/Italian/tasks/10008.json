			"dialogs": [
				{
					"id": 100080601,
					"content": "Ce l'abbiamo fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080602,
					"content": "Grazie... per aiuto. Pensavo dover proteggere Lupical solo io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080603,
					"content": "Ma anche Lupical...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080604,
					"content": "Siamo qui perché ci teniamo a te, proprio come tu tieni a noi! È questo che ci rende Lupical, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080605,
					"content": "Giusto... Siamo Lupical per sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080606,
					"content": "Ohh... E adesso non ci saranno più intrusi nel Regno dei Lupi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080607,
					"content": "No... Branco di lupi oscuri, squarcia cielo. Loro... potrebbero tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080608,
					"content": "Ma io e Lupical li cacceremo... a qualunque costo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080609,
					"content": "...Non dimenticarti di noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080610
					]
				},
				{
					"id": 100080610,
					"content": "Sì, se avessi mai bisogno di aiuto, non esitare a dircelo! Siamo qui per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080611,
					"content": "Io... apprezzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080612
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080612,
					"content": "Auuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080613
					],
					"speakerTitle": "Ululato distante"
				},
				{
					"id": 100080613,
					"content": "Mi... stanno chiamando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080614
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080614,
					"content": "Sembra che vogliano assicurarsi che tu stia bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080615,
					"content": "Allora... devo andare. Grazie... per aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080616
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080616,
					"content": "Non dirlo neanche! È per questo che esiste il Lupical!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080617
					]
				},
				{
					"id": 100080617,
					"content": "Ora che il Regno dei Lupi è al sicuro, Razor vi saluta e si dirige verso la foresta.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						100080618
					]
				},
				{
					"id": 100080618,
					"content": "Tra la fitta vegetazione, noti diversi occhi che lo osservano con affetto, in attesa di accoglierlo a casa.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
