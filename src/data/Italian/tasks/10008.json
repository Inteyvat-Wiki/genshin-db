					}
				]
			},
			"dialogs": [
				{
					"id": 100080301,
					"content": "C'è mancato poco! Meno male che c'erano i lupi ad aiutarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080302,
					"content": "Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080303,
					"content": "Hanno intercettato quei Segugi della Faglia per noi, e li hanno persino scacciati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080304,
					"content": "Ma questo non è... problema di lupi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080305,
					"content": "Lo stai facendo per aiutare il tuo Lupical, vero? Beh, anche loro vogliono che tu sia al sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080306,
					"content": "Paimon scommette che sono andati dal Re Lupo e hanno detto: \"Ascolta bene! Questo non è solo un problema del nostro Lupical. È un problema di tutto il mondo!\" E poi si sono precipitati ad aiutare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080307,
					"content": "Mm, \"Lupical\" è... \"Lupical\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080308,
					"content": "Sono umano, ma non ho bisogno di essere lupo per essere \"Lupical\". Io... voglio solo aiutare loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080309,
					"content": "Ben detto, Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080310,
					"content": "Forse Lupus Boreas ha accettato di far aiutare il branco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
					"content": "Perché conosce il tuo cuore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080312
					]
				},
				{
					"id": 100080312,
					"content": "Tu... pensi davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080313
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080313,
					"content": "Sì, assolutamente! Forza, andiamo! Diamo una bella lezione ai Segugi della Faglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1000806,
			"completionStepIds": [
				1000806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
