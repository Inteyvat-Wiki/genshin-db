			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "#Ad astra abyssosque! Benvenut{M#o}{F#a} nella Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610102,
					"content": "Abbiamo da poco ricevuto un incarico dall'Associazione di pesca, che segnala un'attività inusuale dei pesci nella zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610103,
					"content": "Purtroppo, il loro rapporto non ha molti dettagli. Potreste aiutarci a controllare la situazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610104,
					"content": "Sono sicura che, qualunque sia il problema, ve la caverete benissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610105,
					"content": "Associazione di pesca? Intendi proprio quel tipo di pesca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "Eh? \"Quel tipo di pesca\"? Non sono sicura di capire... Ne esiste più di un tipo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610107,
					"content": "Oooh, l'Associazione di pesca... L'Associazione di pesca... Sembra proprio il nome adatto per gente che pesca deliziosi pranzetti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610108,
					"content": "Beh, non c'è tempo da perdere! Andiamo a controllare! Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066102",
							"2"
						],
						"stepId": 7066102,
						"stateName": "QUEST_STATE_UNFINISHED"
