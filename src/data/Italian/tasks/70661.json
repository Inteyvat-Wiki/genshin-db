		{
			"id": 7066104,
			"completionStepIds": [
				7066103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066103",
							"2"
						],
						"stepId": 7066103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "Qui è perfetto! Vedete quei piccoli pesci nell'acqua? Sono così belli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610402,
					"content": "Ecco, prendete qualche attrezzo: abbiamo canne da pesca, esche e persino formule per prepararle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610403,
					"content": "Per prima cosa mettete l'esca, puntate dove si radunano i pesci e... gettate l'amo! Poi, dovete solo aspettare pazienti che un pesce abbocchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610404,
					"content": "Ho sentito dire che i nuovi arrivati hanno una cosa chiamata \"fortuna del principiante\". La mia prima volta ho pescato un branzino lungo almeno mezzo metro! Beh, forza, fate un tentativo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610405,
					"content": "Vediamo se pesco un'altra Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "Ehi! Di Paimon ce n'è una, come lei non c'è nessuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610407,
					"content": "Paimon? Che nome strano, è una specie di pesce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610408,
					"content": "È una sorta di \"succulento frutto di mare\" che ho pescato un po' di tempo fa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "Ehi! Quand'è che Paimon è passata da \"cibo d'emergenza\" a \"succulento frutto di mare\"?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610410,
					"content": "#Ah, capisco! Non mi ero reso conto che fossi già {M#un pescatore esperto}{F#una pescatrice esperta}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610411,
					"content": "Beh, ora sono ancora più impaziente di vedere cosa pescherai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
		{
			"id": 7066106,
