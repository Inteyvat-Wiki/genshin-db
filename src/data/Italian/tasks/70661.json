							"7066110",
							"3"
						],
						"stepId": 7066110,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "Com'è andata? Dalla vostra espressione direi benissimo! Fatemi dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610602,
					"content": "Oh? Ma è una nuova specie di pesce! Stupendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610603,
					"content": "Avete quasi raggiunto il livello che avevo nel mio periodo d'oro, ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610604,
					"content": "Sai anche pescare a mani nude?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "Ehm... Sembra che questi pescetti ordinari siano una passeggiata per voi. Dovrei farvi provare qualcosa di più impegnativo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610606
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610606,
					"content": "Potreste non saperlo, ma anche i pesci della stessa specie possono essere molto differenti tra di loro per via dell'habitat in cui vivono e del cibo che consumano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610607
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610607,
					"content": "Nonostante sembrino tutti uguali, alcuni tra loro sono particolarmente attivi ed energici. Di tanto in tanto guizzano fuori dall'acqua e sono molto appariscenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610608
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610608,
					"content": "Questi in particolare hanno un valore commerciale ed estetico molto elevato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610609
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610609,
					"content": "Molti appassionati li acquistano per tenerli in acquari nelle proprie case. È per questo che vengono chiamati \"pesci ornamentali\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610610
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610610,
					"content": "Ciò significa che oltre a una \"Paimon d'emergenza\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610611
					]
				},
				{
					"id": 706610611,
					"content": "Esiste anche una \"Paimon ornamentale\"!",
