					"nextDialogs": [
						706610612
					]
				},
				{
					"id": 706610612,
					"content": "Assolutamente no! Come potrebbero mai esistere così tanti tipi di Paimon?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610613,
					"content": "Sì, esattamente. Sembra che tu abbia già capito come funziona!",
