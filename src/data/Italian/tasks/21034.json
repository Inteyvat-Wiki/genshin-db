					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340605,
					"content": "Com'è andata? Hai trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340606
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340606,
					"content": "Ho trovato questo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340607
					]
				},
				{
					"id": 210340607,
					"content": "Ah... Sembra il frammento di una spada... Grazie. Lo porterò con me e lo esaminerò accuratamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340608
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340608,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Ecco, prendi la tua ricompensa.",
