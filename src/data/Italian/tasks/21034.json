						210340604
					]
				},
				{
					"id": 210340604,
					"content": "Erano solo dei mostri comuni. Non ci ho messo molto. Purtroppo non ho trovato nulla di valore, soltanto ferraglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
