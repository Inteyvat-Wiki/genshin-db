			"dialogs": [
				{
					"id": 210340501,
					"content": "#Viaggiat{F#rice}{M#ore}, hai già eliminato i mostri in quell'accampamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340502,
						210340503
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340502,
					"content": "Tutto fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "Erano solo dei mostri comuni. Non ci ho messo molto. Sono anche stata fortunata e ho trovato un prezioso frammento di una spada lunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340505,
					"content": "Io non ho trovato niente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "Non preoccuparti. Mi hai aiutata a escludere un posto sbagliato, quindi grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340507,
					"content": "Ecco, questa te la sei guadagnata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340508,
					"content": "Se troveremo tutti i frammenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "Il mio desiderio è semplice: voglio riforgiare la Lama nascosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340511,
					"content": "Sebbene il progetto con i materiali usati per forgiare la Lama nascosta sia andato perduto... Troverò un modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340512,
					"content": "Se riuscirò a riforgiare la Lama nascosta, anche mio fratello... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340509,
					"content": "Cosa ne farai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340503,
					"content": "A te come va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				}
			]
		},
