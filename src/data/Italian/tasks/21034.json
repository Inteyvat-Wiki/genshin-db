			"dialogs": [
				{
					"id": 210340801,
					"content": "Umpf, dovrebbe trovarsi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340802,
						210340803
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340802,
					"content": "Lan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340804
					]
				},
				{
					"id": 210340804,
					"content": "#Viaggiat{F#rice}{M#ore}! Che coincidenza incontrarci di nuovo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340805
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340805,
					"content": "Già, sono riuscita a mettere le mani su altri frammenti grazie ad alcuni... incarichi appositi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340806
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340806,
					"content": "La situazione non è cambiata granché. Mi piacerebbe invitarti per una caccia ai mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340807
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340807,
					"content": "L'accampamento a sinistra è abitato da un gruppo di Hilichurl. Presi singolarmente, non dovrebbero costituire un grave pericolo per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340808
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340808,
					"content": "Il problema è che ce ne sono parecchi... Se li affrontassi direttamente e tutti in una volta, potresti avere delle serie difficoltà a sconfiggerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340809
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340809,
					"content": "A destra, invece, c'è un Lawachurl Mantodipietra. Affrontarne anche uno solo... Beh, penso che le parole qui non servano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340810
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340810,
					"content": "Visto che sono stata io a chiedere il tuo aiuto, ti lascerò scegliere quale accampamento ripulire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340803,
					"content": "Stai ancora cercando frammenti di spada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340804
					]
				}
			]
		}
