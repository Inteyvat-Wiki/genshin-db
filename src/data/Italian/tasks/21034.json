			"dialogs": [
				{
					"id": 210340401,
					"content": "Com'è andata? Hai eliminato i mostri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340402,
					"content": "Hai già... sconfitto tutti i mostri qui intorno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "Mmh? Ma certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340404,
					"content": "Voglio dire... Sono la Presidentessa della Gilda degli avventurieri di Liyue. Avere a che fare con dei mostri non è una novità per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
