			"dialogs": [
				{
					"id": 210340101,
					"content": "Umpf, dovrebbe essere qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340102,
					"content": "Lan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "#Viaggiat{F#rice}{M#ore}, non mi aspettavo d'incontrarti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340105,
					"content": "Ricordi l'elsa della spada che hai trovato la volta scorsa? Beh, ho scoperto che apparteneva alla Lama nascosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340106,
					"content": "La cosa buffa è che l'ho riconosciuta solo perché da bambina ci avevo inciso sopra un segno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340107,
					"content": "Ricordo di aver detto a mio fratello che, se mai avesse deciso di brandire un'altra spada, avrebbe dovuto dare la Lama nascosta a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340108,
					"content": "Eh. Suppongo che nessuno di noi abbia potuto prevedere cosa sarebbe successo... Non riesco a credere di aver trovato la Lama nascosta in questo modo. Pare che la spada... sia andata effettivamente in frantumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340109,
					"content": "#Ok, immagino che sia meglio andare dritti al punto, viaggiat{F#rice}{M#ore}. Mi servirà di nuovo il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340110,
					"content": "Più avanti ci sono due gruppi di mostri vaganti. Sembra che abbiano accumulato una discreta quantità di armi danneggiate nei loro accampamenti, sebbene non sappia bene il perché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340111,
					"content": "La Gilda degli avventurieri è preoccupata che questi mostri possano portare scompiglio nei dintorni, e avrebbe voluto elaborare un piano per risolvere la questione. Ma, dopo aver esaminato la situazione, ho pensato che forse... avrei potuto trovare qui i frammenti della Lama nascosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340112,
					"content": "#Viaggiat{F#rice}{M#ore}, ripuliamo un accampamento a testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340113,
					"content": "L'accampamento a sinistra è abitato da un gruppo di Hilichurl. Presi singolarmente, non dovrebbero costituire un grave pericolo per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340114,
					"content": "Il problema è che ce ne sono parecchi... Se li affrontassi direttamente e tutti in una volta, potresti avere delle serie difficoltà a sconfiggerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340115,
					"content": "A destra, invece, c'è un Lawachurl Mantodipietra. Affrontarne anche uno solo... Beh, penso che le parole qui non servano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340116,
					"content": "Visto che sono stata io a chiedere il tuo aiuto, ti lascerò scegliere quale accampamento ripulire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 210340103,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
