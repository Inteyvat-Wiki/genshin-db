					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "Grazie, dovrebbero bastare. Aspetta un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411004,
					"content": "...Supremo Barbatos, ti prego di ascoltarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411005,
					"content": "Wow, com'è devota. Così tante... parole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411006,
					"content": "Chissà se quel bardo stonato starà ascoltando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207411007,
					"content": "Bene. Prendi questi semi di dente di leone. Aiutami a salire sulla statua e a spargerli nel vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411008,
					"content": "Dovrei farlo io, ma con le mie abilità fisiche.... anche se riuscissi a salire lassù, probabilmente non sarei più in grado di scendere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 207411009,
					"content": "Allora conto su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
