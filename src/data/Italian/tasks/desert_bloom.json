			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "Fiuuu... Ora che il terreno è sciolto, dovrei essere a posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410102,
					"content": "Ti stai ancora occupando di quel fiore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "Sì. Nonna Kulsoom mi ha dato molti consigli su come prendermi cura dei fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410104,
					"content": "Cose come dissodare il suolo, spuntare regolarmente le foglie e anche vari metodi per sbarazzarmi degli insetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410105,
					"content": "Ah, è anche importante non annaffiare troppo spesso, altrimenti le radici finiscono per marcire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410106,
					"content": "*sospira* E io che pensavo che dare loro dell'acqua ogni giorno, mantenendo così il suolo umido e compatto, fosse la cosa giusta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410107,
					"content": "In realtà, però, va bene così, perché non devo più andare a prendere l'acqua ogni giorno. Il pozzo a gradini è davvero lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410108,
					"content": "Dovrei continuare a spuntare le foglie. Nel frattempo, ti andrebbe di andare a prendere un po' d'acqua per le piante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410109,
					"content": "Ho parlato con Kazan. Ha detto che oggi posso annaffiarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410110,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "L'annaffiatoio è laggiù. Fai attenzione a non far entrare troppo fango quando lo immergi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410111,
					"content": "Nonna Kulsoom ti ha insegnato tutte queste cose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "Mmmh... Eh sì. Nonna Kulsoom sa tutto. Quando ho delle domande, vado sempre da lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410113,
					"content": "Conto su di te! Una piccola quantità sarà sufficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 2304102,
			"completionStepIds": [
				2304101,
