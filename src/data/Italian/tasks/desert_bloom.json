			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "#Viaggiat{F#rice}{M#ore}, arrivi al momento giusto! Vieni ad assaggiare la zuppa di fagioli alla menta che ho cucinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410303,
					"content": "Dove hai trovato gli ingredienti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "Ho chiesto a una persona di comprarmene una buona parte, ma la menta... l'ho coltivata io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410305,
					"content": "Raef mi ha dato alcuni attrezzi da giardino e del fertilizzante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410306,
					"content": "Ho pensato che fosse uno spreco usarli per un singolo vaso di fiori, quindi... ho chiesto ad Azalai di comprarmi dei semi di menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410307,
					"content": "Dopo averli piantati, mi sono presa cura di loro come avrei fatto con i miei fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410308,
					"content": "Con il passare del tempo, la menta è cresciuta fino a diventare matura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410309,
					"content": "Quindi ne ho presa un po' e ho preparato questa zuppa di fagioli alla menta. Che ne pensi? È davvero buona, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410310,
					"content": "Ehm... Visto che hai mangiato la mia zuppa, dovresti farmi un favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410311,
					"content": "Ehm, non ho ancora finito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "Ehi, stavo solo scherzando! Ti darò una bella ricompensa per il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410314,
					"content": "Dovresti solo raccogliere per me 3 pesche di Zaytun. È il frutto preferito di Raef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410315,
					"content": "Voglio aggiungerle alla zuppa di fagioli alla menta e portargliela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410316,
					"content": "Ora che so come prepararla, ho solo bisogno che tu mi porti 3 pesche di Zaytun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410317,
					"content": "Capito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "Grazie! Al tuo ritorno ti attenderà un'altra scodella piena di zuppa di fagioli alla menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410321,
					"content": "#Conto su di te, viaggiat{F#rice}{M#ore}. Trova un po' di pesche di Zaytun e portale qui da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410319,
					"content": "Può mangiare la zuppa mentre è al lavoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "Non gli porterà via molto tempo. Inoltre, non ha troppo da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410312,
					"content": "Riprendi pure la scodella!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				}
			]
		},
