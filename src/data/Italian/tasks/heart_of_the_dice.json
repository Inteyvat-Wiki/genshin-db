			"dialogs": [
				{
					"id": 705340101,
					"content": "Che senso ha avere così tante varianti dello stesso gioco da tavolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340102,
					"content": "#Ah, viaggiat{F#rice}{M#ore}! Magari avvisa la prossima volta, va bene? Anche tu qui per il Gran Premio Re delle Invokazioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340103,
					"content": "Che ci fai da queste parti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "Oh, questo è un gioco progettato da un avventuriere della Gilda. Dicono sia un... innovativo gioco da tavolo che combina Invokazione del genio e i combattimenti. Si chiama Cuore dei dadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340106,
					"content": "Dato che stiamo organizzando il Gran Premio Re delle Invokazioni, la Gilda ha deciso di realizzare un mini gioco ispirato al progetto dell'avventuriere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340107,
					"content": "Come si possono combinare giochi di carte e combattimento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "Ahahah, onestamente, non lo capisco nemmeno io. Però questo è il regolamento... guarda quanto è spesso..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340110,
					"content": "Se non mi sbaglio, il meccanismo di base di Cuore dei dadi dovrebbe essere... usare i dadi strategicamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340111,
					"content": "Comunque, se ti interessa, provaci pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340108,
					"content": "Una combinazione davvero inaspettata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "Quale gioco da tavolo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				}
			]
		}
	]
