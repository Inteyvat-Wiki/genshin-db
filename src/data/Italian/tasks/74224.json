			"dialogs": [
				{
					"id": 742240801,
					"content": "Qui c'è un paesaggio davvero favoloso. Ogni anno ci facciamo arrivare da qui diversi strumenti, ma questa è la mia prima visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240802,
					"content": "Parlami dello spartito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "Non ho domande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "Conto su di voi. Vi aspetto in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				}
			]
		},
		{
			"id": 7422409,
			"completionStepIds": [
				7422409
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
