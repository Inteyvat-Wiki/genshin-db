	"talks": [
		{
			"id": 7422402,
			"completionStepIds": [
				7422402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422402",
							"2"
						],
						"stepId": 7422402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "Oh, ma guarda chi si vede, Tailleferre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240202,
					"content": "#Ah, siete voi due! L' {F#avventuriera}{M#avventuriere} e la sua piccola aiutante. Scusatemi, ho dimenticato i vostri nomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240203,
					"content": "#Paimon è Paimon, e {F#lei}{M#lui} è {NICKNAME}. Grazie del tuo aiuto, a proposito: grazie a te siamo riusciti a riprodurre della musica antica con l'arpa conchiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240204,
					"content": "Come mai sei a Petrichor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240205,
					"content": "#Volevo chiedervelo io... Sto inseguendo un pettegolezzo, ma immagino che due {F#avventuriere}{M#avventurieri} come voi sapranno già tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240206,
					"content": "Di che pettegolezzo parli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240207,
					"content": "Eh? Non ne avete sentito parlare? Ne parlano tutti a Petrichor ultimamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240208,
					"content": "Parli di come abbiamo salvato il mondo per puro caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "Eh? Ma no, si tratta della riscoperta del leggendario Castello Sbiadito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240211,
					"content": "Le testimonianze più recenti di questo luogo risalgono a secoli fa. Pensavo foste qui per questo motivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240212,
					"content": "Ah... Potrebbe esserci il nostro zampino, sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240213,
					"content": "In tal caso, sicuramente saprete che il castello apparteneva a Boethius, vero? Il musicista fontainiano più importante di sempre, avete presente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240214,
					"content": "Le opere che ha composto e gli antichi spartiti remuriani che ha scritto hanno un posto d'onore nella storia della musica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240215,
					"content": "Sicuramente il castello in cui viveva conserva una grande ricchezza di risorse, e ognuna di esse è una preziosa reliquia per noi dell'Associazione dei Musicisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240216,
					"content": "E quindi mi sono precipitata qui appena ho sentito la notizia, cercando di accaparrarmi queste reliquie prima dell'arrivo degli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240217,
					"content": "Ma a quanto pare sono stata battuta sul tempo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240218,
					"content": "(Eh, che dobbiamo dirle? Che Boethius era un cattivone che si servì della musica per compiere una serie di azioni deplorevoli...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240219,
					"content": "(La verità la intristirebbe...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240220,
					"content": "La \"Sinfonia\" non può più essere utilizzata per scopi malvagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "Mmm? Di che parlate? Non avrete mica già trovato degli antichi spartiti, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240223,
					"content": "Beh, ehm, se... e solo \"se\", Boethius fosse un cattivone di prima categoria, vorresti ancora metter mano sui suoi spartiti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240224,
					"content": "Mmm... A dir la verità, non ho capito cosa intendiate dire con \"cattivone di prima categoria\", ma so che i libri di storia, tralasciando la sua musica, non ne parlano in termini lusinghieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240225,
					"content": "Dalla sua opera romantica \"Il Forestiero Volante\" si capisce che non abbandonò mai il sogno di riportare in vita Remuria; di conseguenza, la neonata Fontaine era per lui il nemico da sconfiggere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240226,
					"content": "Secondo gli storici, era anche coinvolto nelle guerre combattute prima della fondazione di Fontaine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240227,
					"content": "Il suo contributo alla musica invece è tutta un'altra storia. Potrebbero esserci falsi storici nelle sue opere, ma il loro valore artistico non si discute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240228,
					"content": "E secondo me, fa tutto parte della storia. Perfino l'arte più pura può essere uno strumento per fare del male, e tutti i musicisti farebbero bene a ricordarselo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240229,
					"content": "Beh, tu sicuramente non te ne serviresti a scopi malvagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "Ahah, sono solo una ricercatrice, io. È già un privilegio ascoltare queste antiche melodie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240233,
					"content": "A proposito, dato che il destino ci ha fatto incontrare qui, posso chiedervi un piccolo aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240234,
					"content": "Un modo per sdebitarmi per l'altra volta, se volete vederla così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240235,
					"content": "Ma avevi detto di non voler esser pagata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "Eheh, beh, e allora si tratta di puro e semplice \"aiuto\", no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240240,
					"content": "E comunque, come detto prima, sono qui per cercare la famosa opera perduta, \"Il Forestiero Volante\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240241,
					"content": "Secondo ciò che un tale Ruggiero scrisse alcuni secoli fa, dovrebbe trovarsi all'interno del Castello Sbiadito. Potreste aiutarmi a cercarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240242,
					"content": "#Immagino che siate molto più {F#esperte}{M#esperti} di me su faccende del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240243,
					"content": "#Beh, dato che ce l'ha chiesto per favore, {NICKNAME}, e che quegli spartiti non hanno più \"quel potere\"... perché no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240244,
					"content": "Va bene, allora facciamo che avete accettato. Eheh, favoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240245,
					"content": "Conto su di voi. Vi aspetto in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240237,
					"content": "Però io gratis non lavoro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "Non preoccuparti, non sarà gratis. L'Associazione dei Musicisti non è mica un covo di pezzenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240239,
					"content": "Immaginavo fosse così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "Notevole rigore morale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "Eheh, beh, è solo la mia opinione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240221,
					"content": "È una storia un po' lunga...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "Parli della Grande Ipnosi di Petrichor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
