			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "Mmh, ma è... Sì! È l'opera perduta! È \"Il Forestiero Volante\"! L'avete trovata davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240902,
					"content": "#Non dev'essere stato facile, ma la mia fiducia in voi è stata ripagata, prodi {F#avventuriere}{M#avventurieri}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240903,
					"content": "Eheh, grazie! E adesso cosa te ne farai? La farai eseguire all'Opéra Épiclèse, magari per una montagna di Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240904,
					"content": "Mmm... Guadagnare è importante, ma non ho intenzione di tenermi questa reliquia tutta per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240905,
					"content": "Questa antica arte fa parte del patrimonio dell'umanità. Pertanto, \"Il Forestiero Volante\" diventerà di dominio pubblico quando avrò finito con la mia ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240906,
					"content": "Dopotutto, la riscoperta dello spartito e il contributo alla storia non sono azioni onorevoli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "Faccio il tifo per te!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "Beh, immagino di dover andare ora. Ricerca e studio mi attendono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240911,
					"content": "Ah, a proposito, ecco la paga. Se il destino lo vorrà ci incontreremo di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240908,
					"content": "Non dimenticarti del mio aiuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
					"content": "Ovviamente! In prima pagina ci saranno i vostri nomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240910
					],
					"speakerTitle": "Tailleferre"
				}
			]
