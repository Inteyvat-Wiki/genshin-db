			"dialogs": [
				{
					"id": 221020201,
					"content": "Come sta andando? Hai risolto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020202,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020203
					]
				},
				{
					"id": 221020203,
					"content": "Capisco. Per favore, fai più in fretta che puoi. Lo chef ha già finito le scorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020204,
					"content": "Potrei cercare di risolvere il problema io stesso, ma solo se le cose dovessero volgere al peggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
