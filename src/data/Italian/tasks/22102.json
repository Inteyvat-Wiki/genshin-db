				"points": []
			},
			"dialogs": [
				{
					"id": 221020101,
					"content": "Sta diventando un vero incubo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020102,
					"content": "Qualche problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "Ormai sono giorni che non dormo... Vedi le occhiaie che ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020104,
					"content": "Hai già incontrato gli ospiti? Sono un bel problema, per non dire di peggio. Una vera gatta da pelare. Uno di loro si è persino lanciato dal tetto dell'edificio. Hai visto quanto siamo in alto? Come gli è saltato in mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020105,
					"content": "Ma non importa. Adesso sto aspettando una consegna dalla città, dovrebbe essere qui a momenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020106,
					"content": "La strada però è piena di mostri che potrebbero creare non pochi problemi. Posso chiederti di sbarazzartene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020107,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020108,
					"content": "Questo posto sembra quasi maledetto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "Beh... Quando apri le porte ai viaggiatori di tutto il mondo, gli imprevisti sono sempre dietro l'angolo... È quello che dico sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020111,
					"content": "Ma niente che non possiamo gestire. In fondo, siamo solo una locanda un po' più isolata e un po' più affollata delle altre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020112,
					"content": "Apprezzo il tuo aiuto. Grazie e buona fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
