			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "#Signor minatore, siamo tornat{F#e}{M#i} e siamo pront{F#e}{M#i} a fare rapporto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080102,
					"content": "Ah! Sono felice di rivedervi! Mi stavo agitando... All'inizio mi ripetevo che stavo pagando per un servizio, ma poi ho pensato: \"Santo cielo, non vorrei coinvolgere qualcuno in un incarico strano... Potrebbe succedere qualcosa di brutto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080103,
					"content": "#Non sarei mai riuscito a perdonarmi se vi foste fatt{F#e}{M#i} male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080104,
					"content": "#Non preoccuparti, signor minatore, non era nulla che non potessimo gestire! Comunque, siamo tornat{F#e}{M#i}, no? E la buona notizia è che abbiamo scoperto tutto quello che sta succedendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080105,
					"content": "Eccellente, eccellente! Allora, qual è la situazione laggiù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080106,
					"content": "Uhm... Eh, beh... Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080107,
					"content": "È una specie di ospizio per Hilichurl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "Eh? Ospizio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080111,
					"content": "Ehm, in pratica... gli Hilichurl che sono entrati nella Voragine non vogliono più combattere. Lasciateli in pace e non vi causeranno problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080112,
					"content": "È come ha detto Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "Beh, di certo non faremo nulla per provocarli, ci mancherebbe altro. L'ultima cosa che noi minatori cerchiamo è creare problemi... Noi cerchiamo solo, beh, tutto ciò che luccica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080115,
					"content": "Ecco una filosofia che Paimon può appoggiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080116,
					"content": "Se devo essere sincero... non ho ben capito la situazione che avete descritto, ma sentirvi dire che è tutto a posto mi basta. Significa che possiamo tornare subito al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080117,
					"content": "#Sono molto grato a entramb{F#e}{M#i}! Avete fatto molta strada per aiutarmi, ecco un compenso per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080113,
					"content": "Non hai nulla di cui preoccuparti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "Sì, per loro è un luogo idilliaco... O meglio, Hili-dilliaco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "Hili-dilliaco? Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				}
			]
		}
	]
}