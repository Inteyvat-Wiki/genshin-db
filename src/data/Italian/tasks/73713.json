			"dialogs": [
				{
					"id": 737130101,
					"content": "Ta-dà! Eccoci qua! Entriamo da questa parte poco profonda. Sembrerà che stiamo entrando in un dipinto; si svelerà man mano proprio davanti ai nostri occhi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130102,
					"content": "Ah... Sei tu. E hai portato dei nuovi compagni? Sono... Miconoidi? Ho solo letto di loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130103,
					"content": "Ma che piacevole sorpresa! C'è una Melusina che gironzola da queste parti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130104,
					"content": "È un piacere rivederti, Marine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "Non sto \"gironzolando\", sto raccogliendo l'Algamarea per la conserva di quest'anno. Tante altre sono tornate al villaggio per dare anche loro una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130107,
					"content": "Pure Enghiene e la piccola Roxane hanno preso un permesso per tornare ad aiutare. Stanno già lavorando sodo, e tra poco mi tufferò in acqua anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130108,
					"content": "Sai... Enghiene non aveva tutti i torti. I Miconoidi blu assomigliano davvero un po' all'Algamarea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130109,
					"content": "Non nel senso di cibo! Volevo solo dire che sono carini. Nient'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Tamburino"
				},
				{
					"id": 737130111,
					"content": "Eheh... Hai buon occhio per le cose carine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130112,
					"content": "I nostri Micoamici sono davvero adorabili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "In ogni caso, è stato un vero piacere incontrarvi. Ora devo andare... buona continuazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130115,
					"content": "OK, andiamo anche noi? A Fontaine faremo delle incredibili foto subacquee con i nostri Micoamici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130113,
					"content": "Anche le Melusine sono altrettanto adorabili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "Ciao, nuova amica Melusina!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
