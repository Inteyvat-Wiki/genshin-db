					"nextDialogs": [
						207010532
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010532,
					"content": "La prossima volta che ci incontreremo, riuscirò sicuramente a preparare dei ravioli di giada perfetti.",
