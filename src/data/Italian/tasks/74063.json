					}
				]
			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "Eh? Cosa ci fa qui una Fotokamera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630202,
					"content": "\"Se ci sono notizie, ci sono Fotokamere\". Mai sentita questa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630203,
					"content": "Credo di sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "Ma l'ho inventata sul momento, dove l'hai sentita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630205,
					"content": "Beh, a ogni modo non c'è davvero nulla di nuovo sotto il sole. Qualsiasi cosa dica o scriva, si riduce sempre a una parodia di quello che è detto dagli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630208,
					"content": "La Fotokamera è qui, e le notizie dove sono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "Le notizie... È come andare a pesca. Sono necessarie un po' di pazienza e la decisione giusta al momento giusto. È così che fai abboccare i pesci grossi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630210,
					"content": "Oh! Voglio dire... È così che peschi delle notizie sensazionali. Mmm? Aspetta, non mi sembrano le parole giuste! Uff, lasciamo perdere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630211,
					"content": "Sembra un po' una cosa amatoriale. Non sei una giornalista, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "E allora mi hai giudicato male, eheh! Sono proprio una giornalista amatoriale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630222,
					"content": "E comunque, che ci fa qui una giornalista amatoriale come te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630223,
					"content": "Sono qui per completare l'incarico assegnatomi: immortalare i momenti più salienti del lavoro delle guardie di Forte Méropide, con la mia Fotokamera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630224,
					"content": "Ma ho trascorso troppo tempo a compilare i documenti di adempimento delle norme... Dateci uno sguardo e capirete anche voi perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630225,
					"content": "Nelly tira fuori un mucchio di documenti, tutti contenenti varie clausole contrattuali e diverse firme. Il solo guadarli ti fa girare la testa.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "Quando ho finalmente completato tutta la parte burocratica, mi sono accorta di essermi persa il turno lavorativo delle guardie! In altre parole, continuando con i termini della pesca, non ci sono più pesci da prendere ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630227,
					"content": "Eh? Ma ci sono delle guardie in servizio proprio adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630228,
					"content": "Ma voglio che abbocchi un Collettore platinato. Non penso che un Configuratore iniziale, o un Pulitore d'acqua abbia abbastanza impatto visivo... Senza un Collettore, anche portando a termine il mio incarico, altri fotografi potrebbero pensare che non valga la pena elogiare il mio lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630229,
					"content": "Smetti di essere così esigente, o tornerai a mani vuote.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "Hai ragione. Devo fare i conti con le mie abilità limitate, e smettere di inseguire dei pesci che per me sono imprendibili... *singhiozza* Sono una pescatrice, voglio dire, una giornalista amatoriale, davvero inutile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630234,
					"content": "Ora basta crogiolarsi nelle proprie lacrime, è il momento di alzare la testa! Potreste, se vi va... farmi un piccolo favore? Vi prego! Vi pagherò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630235,
					"content": "Woah! Che velocità... Beh, dipende dal favore. Perché non ci dici prima di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630236,
					"content": "Della guardia che si trova lì, Grainville. Sulla base della mia valutazione, il suo valore fra le guardie equivale a quello di un Regolatore di situazioni fra Meka manutentori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630237,
					"content": "Basandomi su di lui, dovrei essere in grado di scrivere una buona relazione... o almeno non mi pioveranno addosso le critiche di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630238,
					"content": "Ma si rifiuta di venire qui! Vi chiedo semplicemente di condurlo in un posto in cui sia facile fotografarlo, potete aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630239,
					"content": "Perché non gli spieghi direttamente come stanno le cose e lo fai avvicinare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "Perché sicuramente una volta che saprà di avere la Fotokamera puntata addosso si irrigidirà, e si metterà in una posa non spontanea, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630243,
					"content": "Fammici pensare. La cosa migliore è spegnere l'altoparlante, dire a Grainville che non funziona, e chiedergli di venire a dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630244,
					"content": "E allora sarò sicuramente in grado di catturare un momento vivido di una guardia di Forte Méropide al lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630245,
					"content": "Ne va del completamento del mio progetto! Conto su di voi! Vi prego, aiutatemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630246,
					"content": "#Non sembra una cosa difficile, {NICKNAME}. Forse dovremmo darle una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630241,
					"content": "Perché non avvicini la Fotokamera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "Beh... Ho una visuale migliore da qui. Se vede la Fotokamera, sicuramente mi ritroverò con nient'altro che pose rigide e affettate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630230,
					"content": "Allora continua ad aspettare, ciao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "Ve ne andate? Davvero? Non mi aiutate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630232,
					"content": "Beh... Non siamo mica in grado di invocare magicamente il Collettore platinato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630213,
					"content": "Lasciamo stare le notizie, anche a me piace pescare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "Davvero? Ma che bello! In realtà, sono solo una pescatrice alle prime armi, ho un sacco di domande, ma non saprei a chi rivolgermi. Per esempio, se ti abbocca all'amo un Meka manutentore e morde... che si fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630215,
					"content": "Liberalo e basta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "Capisco, capisco, allora è così che agiresti tu. Mmm, un riferimento davvero prezioso, me ne ricorderò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630220,
					"content": "Eh?! Ma perché all'improvviso stiamo parlando di pesca? Sapete proprio come portare avanti una conversazione, eh?! Sembra che, in quanto giornalista amatoriale, abbia ancora un sacco di cose da imparare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630221,
					"content": "Ma sei stata tu a parlare di pesca per prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630216,
					"content": "Picchialo e fagli capire chi comanda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "Cucinalo per Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#Woah! Paimon confida nelle tue abilità ai fornelli, {NICKNAME}. È solo che... non sono commestibili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630206,
					"content": "Non direi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "Oh! Beh, ora l'hai sentita! Non dimenticare, se mai te la rivenderai, di citare la fonte! E la fonte sono io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				}
			]
		},
		{
			"id": 7406303,
