			"dialogs": [
				{
					"id": 740630501,
					"content": "Finalmente ho completato il mio progetto! Sono una giornalista a tutti gli effetti ora, grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630502
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630502,
					"content": "Devi aver scattato una foto davvero bella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630503,
					"content": "Eccome! Guardate qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630504,
						740630506
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630504,
					"content": "Artistica è artistica, anche se non sembra particolarmente vivida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630505
					]
				},
				{
					"id": 740630505,
					"content": "Paimon non ci capisce niente di arte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630508,
					"content": "Ma davvero questa si potrà usare senza problemi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630509,
					"content": "Cosa c'è che non va? Penso sia una gran bella foto! Sicuramente nessuno si sarebbe aspettato qualcosa di simile da me! Saranno così sorpresi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630510
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630510,
					"content": "Paimon non capisce proprio i tuoi standard estetici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630511,
					"content": "Si chiama \"potere del significato simbolico\". Sicuramente tutti i fotografi esperti ne comprenderanno il vero significato quando la presenterò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630512
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630512,
					"content": "E comunque, grazie, questo è per voi. Eheh, sarebbe favoloso farsi due chiacchiere davanti a una lenza la prossima volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630506,
					"content": "Così vivida che sembra quasi sul punto di muoversi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630507
					]
				},
				{
					"id": 740630507,
					"content": "Mmm, a Paimon potrebbe girare la testa se continua a guardarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "Paimon"
				}
			]
