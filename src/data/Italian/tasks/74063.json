					"Nelly"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630301,
					"content": "Devo scattare una foto così bella da guadagnarmi il rispetto di tutti gli altri fotografi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630302
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630302,
					"content": "Però il Collettore platinato lo voglio ancora... Aaah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nelly"
				}
			]
		},
		{
			"id": 7406304,
			"completionStepIds": [
				7406304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406304",
							"2"
						],
						"stepId": 7406304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grainville"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740630401,
					"content": "Salve, abbiamo trovato un altoparlante che non funziona... Da quella parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630402,
					"content": "Di nuovo? Che strano... Clynes me l'ha appena riparato. Sembra che sia addirittura peggio di me con le riparazioni. Voglio dire, non devi fare altro che dare un paio di colpi alle macchine per farle riprendere, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630403
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630403,
					"content": "E comunque grazie, andrò a dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630404
					],
					"speakerTitle": "Grainville"
				},
				{
					"id": 740630404,
					"content": "Grazie dell'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7406305,
			"completionStepIds": [
