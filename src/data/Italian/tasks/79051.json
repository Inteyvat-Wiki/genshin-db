			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "C'è un diario qui... e sembra davvero ben conservato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790510102,
					"content": "Fiuu... Che sollievo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790510103,
					"content": "Ha sciolto il nodo nel suo cuore ed è migliorato come pittore! Paimon pensa che avrà sicuramente successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790510104,
					"content": "Però ha lasciato i suoi amici Gocciolotti, quindi Paimon è un po' triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790510105,
					"content": "Non tutti gli artisti accettano le imitazioni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Uhm, Paimon lo capisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790510108,
					"content": "C'è ancora qualcosa che confonde Paimon: nel diario c'è scritto che il murale può perdere la sua forma e spostarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790510109,
					"content": "Ma anche dopo un incidente così grave... il murale sembra a posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790510110,
					"content": "Sono questi Gocciolotti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "Oooh, è vero! Non c'è da stupirsi che i Gocciolotti abbiano così tanta familiarità con il Lumioproiettore e con il restauro del murale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790510113,
					"content": "È così commovente... I Gocciolotti forse non sembrano molto brillanti, ma sono amici premurosi e fedeli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790510111,
					"content": "Hanno protetto il murale del loro amico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Insistere sulla propria unicità ha senso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
