				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950101,
					"content": "\"Questa bacheca è stata allestita dal visir per pubblicizzare le questioni importanti della Città di Sumeru. Su di essa è anche possibile lasciare dubbi o domande riguardanti gli avvisi esposti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "\"Avviso: cerchiamo degli esperti che si occupino delle Tigri Chiomalunga\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950202,
					"content": "Il messaggio dell'avviso è cancellato con un pennello. Inoltre, la frase presente sopra è scritta in obliquo e con una calligrafia infantile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950203,
					"content": "\"Il Raja Chiomalunga voleva solamente giocare con la gente!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "\"Se dopo aver mangiato dei funghi vedete dei folletti danzanti, non allarmatevi: è una reazione comune.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950302,
					"content": "\"Ma se le piante intorno a voi iniziano a parlare, chiedete subito aiuto al guardaboschi più vicino.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "\"Per ragioni sconosciute, l'Avvizzimento ha mostrato segni di espansione, sia in quantità che in dimensioni, in tutta la foresta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950402,
					"content": "\"L'Avvizzimento non solo fa appassire la vegetazione dell'area, ma può anche essere letale per la fauna selvatica e gli esseri umani. I Guardiani della foresta hanno predisposto delle zone contaminate per segnalare le aree sotto l'effetto dell'Avvizzimento. Siete pregati di non avvicinarvi a tali luoghi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950403,
					"content": "\"Chiunque trovi nuove tracce dell'Avvizzimento nella foresta è pregato di rivolgersi al più vicino membro dei guardaboschi affinché possa occuparsene personalmente.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "Durante le recenti ispezioni nei bazaar locali, i Matra hanno scoperto diversi casi di commercio illegale di Conoscenze in scatola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950502,
					"content": "Il commercio di Conoscenze in scatola è proibito dall'Akademiya e i colpevoli di tali attività saranno puniti severamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950503,
					"content": "L'Akademiya non sarà ritenuta responsabile per eventuali conseguenze dell'uso illegale delle Conoscenze in scatola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "\"L'annuale Festival del Sabzeruz è alle porte. Proprio come l'anno scorso, si terrà un maestoso festival nel Gran Bazaar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950602,
					"content": "\"Per ravvivare l'atmosfera del festival, la nostra signora ha preparato una sovvenzione speciale per i tutti i mercanti che parteciperanno.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950603,
					"content": "\"Festeggiamo il compleanno di Sua Eccellenza Minore Kusanali insieme!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "\"La nostra signora è uscita di casa e non è ancora tornata. Se vedete una giovane ragazza dai capelli castani con indosso un vestito blu e viola, vi invitiamo a contattare la famiglia Homayani. Sarete debitamente ringraziati per il vostro aiuto!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950702,
					"content": "\"Se la nostra signora vede questo manifesto, la preghiamo di contattarci immediatamente. I suoi genitori sono molto preoccupati per lei.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "\"È tornato! Il mio signore, Al-Ahmar, è tornato!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950802,
					"content": "\"Il giorno del suo ritorno sarà il giorno del castigo per tutti voi che avete foglie sul capo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950803,
					"content": "Si tratta di una notizia falsa e stiamo indagando sulla sua fonte. Tutte le questioni relative a Sumeru sono pubblicate regolarmente sull'Akasha. Invitiamo tutti a diffidare dai pettegolezzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "\"Povera anima, quale problema ti affligge? Guardati attorno! L'onnipotente Lord Sangemah Bay è qui per darti le risposte che cerchi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950902,
					"content": "\"Per un'esigua quantità di Mora, risolverò ogni tuo problema in tempo zero.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950903,
					"content": "\"È meglio agire prima che sia troppo tardi! Puoi contattarmi a...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731950904,
					"content": "Questa bacheca è stata allestita dal visir per regolare le transazioni di mercato. Si prega di non usarla per affiggere annunci pubblicitari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319510,
			"completionStepIds": [
				7319510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319510",
							"2"
						],
						"stepId": 7319510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951001,
					"content": "\"Qualcuno sa dov'è possibile trovare un eccellente cantastorie? Dev'essere qualcuno in grado di raccontare i fatti esattamente come sono.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951002,
					"content": "\"Un terrificante djinn continua a perseguitarmi. Minaccia in continuazione di uccidermi se non gli racconto ogni giorno la stessa identica storia. È un mese che va avanti così, ho il cervello quasi in poltiglia a causa di questo supplizio...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951003,
					"content": "\"Che strana esperienza. Ho sentito dire che al Bar Puspa c'è un cantastorie di nome Maddah. Lui potrebbe essere in grado di aiutarti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319511,
			"completionStepIds": [
				7319511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319511",
							"2"
						],
						"stepId": 7319511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "\"Ho viaggiato per molte nazioni e ho visto innumerevoli esibizioni. Nilou è senza ombra di dubbio la migliore danzatrice di tutta Teyvat. Non solo quei pignoli dell'Akademiya non sono riusciti ad apprezzare la sua esibizione, ma se ne sono perfino lamentati! Che insulto all'arte!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951102,
					"content": "\"In base alla mia esperienza accumulata a Mondstadt, sarebbe meglio organizzare un fan club di Nilou. In questo modo, tutte quelle persone che non se ne intendono d'arte non oseranno insultarla di nuovo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951103,
					"content": "\"Un fan club... È un'usanza di Mondstadt? Comunque, un'esibizione perfetta è il frutto degli sforzi congiunti di tutti i membri di una compagnia. Concentrare tutta l'attenzione su un singolo individuo non è corretto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951104,
					"content": "\"Inoltre, ritengo che l'arte stessa riesca a far legare tutti in modo speciale. Sono molto felice che ti sia piaciuta tanto l'esibizione di Nilou.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951105,
					"content": "\"Vedendo questa elegante calligrafia, mi viene da supporre che sia di una giovane donna, dico bene? È fantastico sapere che c'è qualcun altro a cui piace assistere agli spettacoli di danza. Posso chiederti se ti va di prendere un caffè insieme qualche volta?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951106,
					"content": "\"Mi dispiace, ho molti impegni. Ti suggerisco di parlare con il mio responsabile se hai bisogno d'aiuto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951107,
					"content": "\"Sembra che il tizio sia stato rifiutato. L'ultimo messaggio è stato scritto chiaramente da un uomo tosto... Probabilmente la guardia del corpo di una ricca signora o qualcuno del genere.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319512",
							"2"
						],
						"stepId": 7319512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "\"Bottiglie magiche in vendita. Bottiglie magiche che possono imbrigliare il potere degli spiriti. Lasciate qui il vostro pagamento. Un solo Mora e qualsiasi sogno diverrà realtà.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951202,
					"content": "\"Bottiglie magiche in vendita. Bottiglie magiche in grado di esaudire ogni desiderio. Alla modica cifra di un solo Mora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951203,
					"content": "\"Io sono un djinn. Datemi solo un Mora ed esaudirò ogni vostro desiderio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951204,
					"content": "\"La Cittadella di Regzar sta indagando sulla recente serie di truffe. Vi invitiamo a non farvi prendere dal panico.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951205,
					"content": "\"Tutte le vittime che hanno ulteriori domande possono chiedere una consulenza al prezzo di un solo Mora.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
				7319513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319513",
							"2"
						],
						"stepId": 7319513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "\"Da quando faccio parte dei Guardiani della foresta, ho passato così tanto tempo nel bosco che se continua così arriverò al punto di parlare con gli Uccelli del crepuscolo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951302,
					"content": "\"Se solo riuscissi a capirli... adesso non mi annoierei così tanto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319514",
							"2"
						],
						"stepId": 7319514,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "\"Ho assoldato una mercenaria abbastanza brava qualche tempo fa. Credo facesse di nome Chiomardente, o qualcosa del genere...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951402,
					"content": "\"La portavo con me ogni volta che uscivo in mare per lavoro. Non importa se si trattava di Cacciatori di tesori o di Milleliti, con lei al mio fianco, non c'era nulla da temere. Ho fatto una fortuna grazie a lei\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951403,
					"content": "\"Ma non mi sembra di averla vista accettare alcun incarico ultimamente, e ho sentito dire che il numero di mostri sulla strada per Liyue è aumentato... Se la situazione continua così, potrei dover investire i miei soldi alla Borsa di Kalimi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951404,
					"content": "\"Non sembri una persona che si occupa di affari alla luce del sole... Ma se parli di Chiomardente, ho sentito che è stata assunta dalla famiglia Homayani. Dovrai aspettare un bel po' prima che sia di nuovo disponibile\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951405,
					"content": "\"E un piccolo consiglio: ti conviene comprare cento tappeti piuttosto che investire i tuoi soldi alla Borsa di Kalimi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951406,
					"content": "\"Hai completamente ragione! Venite a visitare il nostro negozio per comprare dei tappeti! Posso anche spiegarvi nel dettaglio come usare ognuno di essi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319515,
			"completionStepIds": [
				7319515
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319515",
							"2"
						],
						"stepId": 7319515,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951501,
					"content": "\"Se nella foresta incontrate qualcuno con lo sguardo assente o che mormora tra sé e sé, significa che è uno dei ricercatori della Vita di Satyavada. Vi preghiamo gentilmente di non disturbarli.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951502
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951502,
					"content": "\"Se ci fosse qualche problema, vi invitiamo a farlo presente al Mahamata, così che il problema possa essere gestito in modo appropriato.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319516,
			"completionStepIds": [
				7319516
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319516",
							"2"
						],
						"stepId": 7319516,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951601,
					"content": "\"Ho sentito dire che un tempo Diwan faceva da portavoce per i cittadini comuni, ma adesso obbedisce solamente a qualsiasi cosa gli ordini il Mahamata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951602,
					"content": "\"Come il visir. Quell'uomo non mantiene mai la propria parola, e appare solo quando il Mahamata cerca di scaricare le responsabilità.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951603,
					"content": "\"La guida dell'Akademiya a tutti gli organi amministrativi si basa sulla guida di Sua Eccellenza Maggiore Rukkhadevata. Si prega di astenersi dalle calunnie.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7319517,
			"completionStepIds": [
				7319517
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319517",
							"2"
						],
						"stepId": 7319517,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951701,
					"content": "\"La Città della Saggezza è nostra, così come la foresta dell'ignoranza. In cima all'albero si trovano i resti del regno dei sogni perduti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
