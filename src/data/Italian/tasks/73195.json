				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951801,
					"content": "\"Ho sentito dire che un tempo Diwan faceva da portavoce ai cittadini comuni, ma adesso obbedisce solamente a qualsiasi ordine del Mahamata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951802
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951802,
					"content": "\"Come il visir. Quell'uomo non mantiene mai la propria parola, e appare solo quando il Mahamata cerca di scaricare le responsabilità.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951803
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 731951803,
					"content": "Il ruolo dell'Akademiya è quello di fare da guida agli organi amministrativi. Asteneresi dal calunniare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		}
	]
