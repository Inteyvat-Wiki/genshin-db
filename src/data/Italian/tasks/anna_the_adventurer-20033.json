	"talks": [
		{
			"id": 2003301,
			"completionStepIds": [
				2003301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003301",
							"2"
						],
						"stepId": 2003301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "#Viaggiat{F#rice}{M#ore}, vieni a vedere! Cosa ne pensi? Mi sta bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330102,
					"content": "Oh, quest'uniforme...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "Esatto! Ho superato l'esame della Gilda degli avventurieri. Ciò fa ufficialmente di me un'avventuriera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330104,
					"content": "Hai un aspetto fantastico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "Eheh, grazie. Ho cercato di convincere anche mio fratello a provare l'esame, ma si è rifiutato a prescindere da cosa gli dicessi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330107,
					"content": "Non mi interessano le avventure... E poi, chi si prenderà cura dei nostri genitori se diventiamo entrambi avventurieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330108,
					"content": "Potremmo portarli con noi! Potremmo viaggiare insieme per tutto il mondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330109,
					"content": "Ma non... Va bene, sei un'avventuriera ora, perciò pensa a fare del tuo meglio. Lascia a me le questioni di casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330110,
					"content": "Ma ricorda, non farti male e non esagerare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330111,
					"content": "E va bene, ho capito! Ora vado, ho un incarico da portare a termine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330112,
					"content": "#Viaggiat{F#rice}{M#ore}, vuoi venire con me? Ho così tante cose da chiederti sull'essere un avventuriere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330113,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "Vediamo, questo incarico è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330116,
					"content": "Scorta un pallone aerotrasportatore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330114,
					"content": "Ok, andiamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "Complimenti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
		{
			"id": 2003302,
			"completionStepIds": [
				2003304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003303",
							"3"
						],
						"stepId": 2003303,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003304",
							"2"
						],
						"stepId": 2003304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330201,
					"content": "#Abbiamo finito! Grazie, viaggiat{F#rice}{M#ore}. È andata molto bene, credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330202,
					"content": "Ma questa è la tariffa normale per gli avventurieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330203,
						200330205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330203,
					"content": "Ce ne saranno altre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330204
					]
				},
				{
					"id": 200330204,
					"content": "Perché quel tono sconsolato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200330207,
					"content": "Ah, è così... Bene! Allora continuerò a lavorarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330208,
					"content": "Quando avrò risparmiato abbastanza Mora, porterò mio fratello e i miei genitori in viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330209,
					"content": "Mio fratello avrebbe sempre voluto viaggiare... Ma mi sono ammalata, ed è dovuto restare per prendersi cura di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330210,
					"content": "Ma ora sto bene, sono persino diventata un'avventuriera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330211,
					"content": "Eheh, quando arriverà il momento, aiuterò anche mio fratello a realizzare qualche suo sogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330205,
					"content": "Lo capirai col tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330206
					]
				},
				{
					"id": 200330206,
					"content": "Ehi, non fare quella faccia così stanca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003301",
							"3"
						],
						"stepId": 2003301,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330301,
					"content": "#Per favore, abbi cura di Anna, viaggiat{F#rice}{M#ore}. Il suo entusiasmo potrebbe averle dato alla testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330302,
					"content": "Non vuoi che diventi un'avventuriera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330303
					]
				},
				{
					"id": 200330303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330304,
					"content": "Rispetto il volere di mia sorella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330305,
					"content": "Ora che sta di nuovo bene dopo aver combattuto tanto contro la sua malattia, si merita una possibilità di inseguire i suoi sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330306,
					"content": "In quanto suo fratello, la supporterò... in ogni modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330307,
					"content": "È tutto quello che ho da dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
}