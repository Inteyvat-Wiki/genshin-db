			"dialogs": [
				{
					"id": 220430301,
					"content": "Mmmh, sì... Questi andranno bene, credo. Scusa se ti ho chiesto di aiutarmi dopo aver fatto tanta strada per raggiungere il Santuario... Ti prego, accetta questi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430302,
					"content": "Una volta che avrò perfezionato la mia tecnica, ti manderò anche la mia opera migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430303,
					"content": "Mmmh, che posa dovrei dare alla Gran Sacerdotessa provvisoria, stavolta...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
