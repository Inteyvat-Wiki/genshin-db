			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shogun Raiden",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "Ci sono ancora molte sfide che aspettano Inazuma, ma sono preparata ad affrontarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320102,
					"content": "Riguardo alle \"sfide\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "L'abolizione del Decreto Sakoku ha una miriade di implicazioni. Sarebbe folle affermare che non ci saranno ripercussioni negative di sorta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320104,
					"content": "Ad esempio, prevedo che il mondo esterno rappresenterà una minaccia per gli affari di Inazuma. Sono questi i problemi che devo impegnarmi a risolvere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320105,
					"content": "Ei, sei davvero coscienziosa a pensarla in questo modo. Il massimo a cui sono arrivata io è chiedermi se in futuro riuscirò a vendere dei biglietti d'ingresso per il Gran Santuario di Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320106,
					"content": "Miko... Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320107,
					"content": "A proposito dello sguardo degli dèi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "Lo sguardo di Makoto era sempre fisso sulla gente di Inazuma. Ho sempre pensato che fosse perché... era il suo dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320109,
					"content": "Ma ora capisco che il suo era uno sguardo pieno di felicità e speranza. Non era un semplice dovere, ma anche una gioia. Amava profondamente gli esseri umani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320110,
					"content": "Se le persone del passato meritavano l'attenzione degli dèi, lo stesso vale per quelle del futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320111,
					"content": "Infatti. Non ignorerò più le loro passioni e i loro sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320112,
					"content": "A proposito dei secoli trascorsi duellando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "A dirla tutta, era una tortura costante e senza una fine all'orizzonte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320114,
					"content": "Davanti a una battaglia infinita, dovevo restare concentrata ogni singolo istante. Se mi fossi distratta anche solo per un attimo, la lama della Shogun mi avrebbe tolto la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320115,
					"content": "Non fosse stato per le mie pregresse esperienze di combattimento, è pacifico che le mie abilità non sarebbero state all'altezza della sfida, e sarei di certo stata sconfitta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320116,
					"content": "E in tutto questo, anche voi avete svolto la vostra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320117,
					"content": "A proposito dei danni al Sakura sacro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "Non preoccupatevi, non l'ho dimenticato. Mi assicurerò di ricordare alle Commissioni Tenryou e Yashiro i loro doveri al riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320119,
					"content": "Non sono solo i mostri che mi preoccupano, ma anche ciò che potrebbe fuoriuscire dal Sakura sacro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320120,
					"content": "Già, questo è un bel problema... Nelle linee geomantiche si nascondono molte altre cose oltre ai ricordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320121,
					"content": "Visto che capisci chiaramente la situazione, forse potresti cercare di fare qualcosa anche tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320122,
					"content": "Yae Miko ha detto che metteva la sua dea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "#Ahem! Yae Miko non ha detto niente del genere, e {F#la viaggiatrice}{M#il viaggiatore} ha una bella faccia tosta ad affermare il falso in sua presenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320124,
					"content": "Alcune parole non vanno ripetute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320125,
					"content": "Credimi, non vuoi sapere quanto ti costerebbe tradirmi. Considera quanto ti ho detto come il nostro piccolo segreto, intesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320126,
					"content": "Di cosa state parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Shogun Raiden"
				},
				{
					"id": 120320127,
					"content": "Nulla. All'improvviso ho voglia di tofu fritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320128,
					"content": "Non ho altre domande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}