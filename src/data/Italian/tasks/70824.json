			},
			"dialogs": [
				{
					"id": 708240201,
					"content": "Posso aiutarti io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "Sai spazzare come si deve? Ah, ignora la mia domanda, tanto siamo talmente a corto di personale che qualsiasi aiuto andrà bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240203,
					"content": "Seguimi all'interno, anche lì c'è tanto da pulire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082403,
			"completionStepIds": [
