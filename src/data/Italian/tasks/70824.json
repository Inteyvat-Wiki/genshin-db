			},
			"dialogs": [
				{
					"id": 708240101,
					"content": "Pulite di nuovo tutto, questa volta non voglio vedere neanche una macchia! La prima impressione è tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240102,
					"content": "Mi dispiace, signora Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240103,
					"content": "Questa volta faremo più attenzione, signora Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240104,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "#Oh, ciao viaggiat{F#rice}{M#ore}. Benvenut{F#a}{M#o} al Vigneto Prima Luce. La tempesta sarà anche passata, ma stiamo ancora pulendo tutto il caos che ha lasciato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240106,
					"content": "Sto cercando di organizzare le pulizie, ma queste ragazze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240107,
					"content": "Mi dispiace, signora Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240108,
					"content": "Questa volta faremo più attenzione, signora Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240109,
					"content": "Sì, grazie, me lo avete già detto! Perché ora non vi impegnate a pulire invece di rimanere qui a scusarvi? Su, su!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240110,
					"content": "Queste ragazze... Uff, sono così disattente. Di questo passo, non so proprio come faremo a pulire tutto. E in tutto questo, dobbiamo ancora occuparci degli interni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082402,
			"completionStepIds": [
				7082401
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
