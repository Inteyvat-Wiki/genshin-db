			"dialogs": [
				{
					"id": 708240301,
					"content": "#Io sono u{F#na}{M#no} spazzat{F#rice}{M#ore} provett{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240302
					]
				},
				{
					"id": 708240302,
					"content": "#Davvero? Splendido. Allora visto che ti offri volontari{F#a}{M#o}, accetto volentieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240303
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240303,
