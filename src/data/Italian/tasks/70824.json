			"dialogs": [
				{
					"id": 708240401,
					"content": "Hai fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240402
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240402,
					"content": "Tutto finito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240403
					]
				},
				{
					"id": 708240403,
					"content": "#Splendido, mi sei stat{F#a}{M#o} di grande aiuto. Non ho idea di quanto ci avrei messo a fare tutto da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240404
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240404,
					"content": "Se poi avessi chiesto alle ragazze... chissà quanti altri oggetti avrebbero mandato in frantumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240405
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240405,
					"content": "#Grazie tante, ecco qui un piccolo compenso. Accetta le mie scuse per avere affidato a te le mansioni di una domestica del Vigneto. Sei pur sempre u{F#n'}{M#n }ospite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240406
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240406,
					"content": "La prossima volta che passerai di qui, il Vigneto sarà splendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
