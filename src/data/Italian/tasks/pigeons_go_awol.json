			"dialogs": [
				{
					"id": 200610401,
					"content": "Riguardo ai piccioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610402
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610402,
					"content": "Forse d'ora in poi consegneranno i messaggi senza fare troppe storie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610403,
					"content": "Anche se non posso seguirli e controllarli... A ogni modo, per ora va bene così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610404,
					"content": "Tieni questo per il disturbo. Qualora avessi bisogno di inviare un messaggio, vieni a cercarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2006105,
			"completionStepIds": [
