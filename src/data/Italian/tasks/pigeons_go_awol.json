						200611003
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200611003,
					"content": "Questa lettera è tua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200611004
					]
				},
				{
					"id": 200611004,
					"content": "Una lettera? Ah sì, l'ho spedita io! Era indirizzata a sorella Grace, in città.",
