			},
			"dialogs": [
				{
					"id": 200610501,
					"content": "Riguardo ai piccioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610502
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610502,
					"content": "CHE COSA? Come hai potuto? Erano i miei piccioni viaggiatori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610503
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610503,
					"content": "#Stupid{F#a}{M#o} imbecille... Sei peggio degli Hilichurl! E ora cosa faccio con tutte queste lettere?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610504,
						200610506
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610504,
					"content": "Scusa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610505
					]
				},
				{
					"id": 200610505,
					"content": "#Non sai fare di meglio? Sei {F#una}{M#un} Cavaliere di Favonius e il massimo che sai fare è porgere delle stupide scuse?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610508,
					"content": "Hai combinato un disastro, e ora dovrai rimediare. Visto che comunque hai il cervello di una gallina, immagino che non avrai problemi a farmi da nuovo piccione viaggiatore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610506,
					"content": "A volte non mi rendo conto della mia forza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610507
					]
				},
				{
					"id": 200610507,
					"content": "La prossima volta sarebbe meglio non scacciarli con una mannaia infuocata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				}
			]
		},
		{
