			"dialogs": [
				{
					"id": 701060401,
					"content": "A proposito della carne del Grande re dei cinghiali delle nevi che volevi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060402
					]
				},
				{
					"id": 701060402,
					"content": "#Ah, sei riuscit{F#a}{M#o} a procurarti la carne del Grande re dei cinghiali delle nevi, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
