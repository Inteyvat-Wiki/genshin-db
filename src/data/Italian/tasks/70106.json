				{
					"id": 701060302,
					"content": "Wow, questa carne congelata ha un ottimo aspetto... Ora manca solo un ingrediente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060303
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060303,
					"content": "Hai sentito parlare del Grande re dei cinghiali delle nevi? Si dice sia una bestia feroce che dimora nelle profondità delle montagne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060304
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060304,
					"content": "Secondo la ricetta, la sua carne squisita si adatta bene a qualsiasi metodo di cottura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060305
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060305,
					"content": "Eh? Intendi questa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060306
					]
				},
				{
					"id": 701060306,
					"content": "Che cosa? Aspetta... sì! Come... Dove? Si tratta di una coincidenza oppure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060307
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060307,
					"content": "Beh, comunque... Questo significa che ora ho tutti gli ingredienti di cui avevo bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060308
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060308,
					"content": "Mentre aspettavo che tornassi con gli ingredienti, ho finalizzato il piatto. Una cosa è certa, si discosta parecchio dall'antica ricetta da cui sono partito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060309
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060309,
					"content": "Il punto cruciale però è il sapore, non importa come ci sono arrivato. Penso che battezzerò questo piatto \"gulasch\". Suona esotico ma è molto facile da realizzare... Perché non lo provi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060310
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060310,
					"content": "Non preoccuparti, ho messo in conto la difficoltà di provare a cucinare in un ambiente poco ospitale come questo. Ho quindi ridotto al minimo i tempi di preparazione e ho fatto in modo che il metodo di cottura fosse semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060311
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060311,
					"content": "Forza, provalo. Dopo averlo preparato una volta è facile ricordare la ricetta, casomai volessi cucinarlo di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
