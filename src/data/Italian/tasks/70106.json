			"dialogs": [
				{
					"id": 701060201,
					"content": "Ecco la carne congelata che volevi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "Wow, questa carne congelata ha un ottimo aspetto... Ora manca solo un ingrediente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060203,
					"content": "Hai sentito parlare del Grande re dei cinghiali delle nevi? Si dice sia una bestia feroce che dimora nelle profondità delle montagne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060204,
					"content": "Secondo la ricetta, la sua carne squisita si adatta bene a qualsiasi metodo di cottura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060205,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti fare questa commissione per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060206,
					"content": "Posso chiedere sfacciatamente cosa ci guadagno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "Non preoccuparti, ho messo qualcosa da parte per quando tornerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
