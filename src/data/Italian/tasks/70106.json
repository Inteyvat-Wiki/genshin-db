			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "Mancano ancora alcuni ingredienti e ci siamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060102,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "#Mmmh? Ah, viaggiat{F#rice}{M#ore}, sto aggiungendo i tocchi finali a un'antica ricetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060104,
					"content": "Non molto tempo fa, una squadra di esploratori è partita per una spedizione nelle montagne. Uno di loro è un mio amico, un avventuriere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060105,
					"content": "Non si sono avventurati troppo lontani a causa delle cattive condizioni meteorologiche, ma il mio amico ha detto che si sono imbattuti in alcune rovine antiche mentre cercavano riparo dalla tempesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060106,
					"content": "Erano piene di libri e altre annotazioni. Persino... persino una ricetta. Non so come ha fatto a sopravvivere intatta per tutto questo tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060107,
					"content": "Il mio amico avventuriere mi ha passato la ricetta. Spera che possa rievocare i sapori del passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060108,
					"content": "Pensa che non ho mai sentito neppure nominare alcuni degli ingredienti della ricetta. C'è anche qualche tecnica culinaria che mi è del tutto nuova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060109,
					"content": "Quindi sto preparando una versione modificata che necessiti solamente degli ingredienti essenziali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060118,
					"content": "Te la sentiresti di aiutarmi a raccogliere gli ingredienti insoliti per la ricetta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060110,
					"content": "Ci penso io!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "Mi fa piacere vedere il tuo entusiasmo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060113,
					"content": "Ho sentito dire che alcuni cinghiali persi nelle montagne sono rimasti conservati nel ghiaccio... Sono curioso di scoprire se un evento del genere può influenzare il sapore della carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060114,
					"content": "Quindi magari potresti raccogliere 10 porzioni di carne congelata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060115,
					"content": "Per chiarire, intendi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "Sì, intendo la carne di quei cinghiali congelati. Il fatto che siano rimasti conservati nel ghiaccio deve aver mantenuto la carne piuttosto fresca, non pensi? Mi spiace per loro, ma è un'occasione ghiotta per fare il pieno di carne congelata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060117,
					"content": "Grazie per l'aiuto. Torna a trovarmi quando avrai gli ingredienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060112,
					"content": "Quali ingredienti ti servono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
