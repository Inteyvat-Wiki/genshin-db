				]
			},
			"dialogs": [
				{
					"id": 752460101,
					"content": "Guarda! Ci sono delle persone, laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460102,
					"content": "Uhm, hanno un che di familiare. Credo si tratti di...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "Ororon e Ifa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460104,
					"content": "#Oh, {F#Altra Nonna}{M#Nonno} e Paimon! Avevo capito dalla voce che eravate voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460105,
					"content": "#{F#Amiche! Amiche!}{M#Amici! Amici!}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460106,
					"content": "Ah! Anche voi qui! Accidenti, sembra passato un secolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460107,
					"content": "Sì! Chasca ci ha detto che avete iniziato a lavorare qui. Sapevamo che prima o poi ci saremmo beccati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460108,
					"content": "Sì, per forza. Ehi, l'atmosfera di questo posto è da favola, non trovate? Da quel che mi hanno detto, la gente si sta divertendo un mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460109,
					"content": "Hihi, assolutamente sì! Se tutto va bene, le cose non potranno che migliorare, e il numero di visitatori aumenterà sempre di più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460110,
					"content": "E voi due che ci dite? Come procede il lavoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460111,
					"content": "Non male! Il personale saurico e gli Afidi sono in perfetta salute, quindi ci hanno dato un po' di tempo libero. Abbiamo pensato di fare un giro qui nei dintorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460112,
					"content": "...PERSONALE afide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460113,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460114,
					"content": "Anche gli Afidi sono parte integrante del personale. Non l'hai specificato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460115,
					"content": "Proprio così, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460116,
					"content": "Giusto... Scusa. Ovviamente, sono grato a ogni singolo membro del personale. E al nostro caro Ororon, per il suo contributo così... proattivo nei loro confronti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460117,
					"content": "Siamo arrivati qui in largo anticipo per lottare per una causa importante. Già questa è di per sé una ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460118,
					"content": "È la prima volta che il nostro amico qui riceve un invito formale del genere. Come potete notare, la cosa lo rende molto... ehm, devoto alla causa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460119,
					"content": "L'entusiasmo è una cosa positiva.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#Visto? {F#Altra Nonna}{M#Nonno} sa di cosa parla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460121,
					"content": "Ogni giorno ci viene data l'opportunità di lottare per ciò che conta davvero. È stato Cacucu a insegnarmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460122,
					"content": "Ahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460123,
					"content": "Ma non state semplicemente... pescando? Da quando pescare è diventato sinonimo di \"lottare per ciò che conta davvero\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460124,
					"content": "Ma ti ascolti quando parli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460125,
					"content": "Certo, me l'ha suggerito un amico, un famoso avventuriere di Mondstadt noto per la sua straordinaria fortuna. Se lui dice che funziona, non abbiamo motivo di non crederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460126,
					"content": "(Un momento... Parla di Bennett?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "Eh, già! Quel tipo ha fatto girare un bastoncino che si è fermato indicando questo laghetto. Come dice Ororon, meglio seguire la fortuna più che tentare di esserne artefici. Per questo siamo venuti qui a pescare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460128,
					"content": "D'accordo, in teoria non fa una piega... Ma questo laghetto è circondato da capibara! Siete sicuri di riuscire a pescare qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460129,
					"content": "Ma certo! I capibara sono creature gentili, quindi non ci saranno problemi. E poi, quando la vita ti offre acqua, usala per pescare. È ciò che mi ha insegnato Nonna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460130,
					"content": "Ah, un'altra perla di saggezza di Nonna. Insieme a \"quando la vita ti offre cibo, mangialo\", oppure \"quando la vita di offre limoni, fai una limonata\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460131,
					"content": "#Ahah, esatto. Anche se stavolta siamo noi a dover offrire limoni a voi, {F#Altra Nonna}{M#Nonno} e Paimon. Visto che siete qui, perché non vi unite a noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460132,
					"content": "E, per rendere le cose un po' più stimolanti... Chi acchiappa il pesce più grosso vincerà una pinta dell'idromele d'Afidi di Ororon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460133,
					"content": "Un'offerta che Paimon trova piuttosto allettante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460134,
					"content": "#Hihihi, hai dimenticato con chi hai a che fare? Non siamo tipi da lasciarci intimidire, e {NICKNAME} è un{F#'avversaria decisamente tosta}{M# avversario decisamente tosto}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460135,
					"content": "Sfida accettata, amico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "#Bello vederti così {F#agguerrita}{M#agguerrito}! Bene, allora diamoci dentro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460137,
					"content": "Accetto la sfida, nipote.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "D'accordo, chi vince piglia tutto: non solo il pesce, ma anche l'idromele del personale afide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
