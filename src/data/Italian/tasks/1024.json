			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bu'yun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "(Secondo Keqing, dovremmo dire così...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "Scusate, vendete la luna qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "Sì. Quante ne volete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210304,
					"content": "Non è molto indicato parlare di numeri in questo luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "#Ah, ben detto. Prego, usate questo per ascendere alla Dimora di giada... Ah, sì. A proposito: siete voi {F#le}{M#i} due ospiti che Lady Ningguang deve ricevere oggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210306,
					"content": "Sì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "(Però il codice che hanno usato non era quello per gli ospiti, bensì quello per la Yuheng. Che sta succedendo qui...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bu'yun"
				}
			]
		}
	]
}