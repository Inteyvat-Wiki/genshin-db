	"talks": [
		{
			"id": 102402,
			"completionStepIds": [
				102402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102402",
							"2"
						],
						"stepId": 102402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "*ansima* Paimon è esausta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240202,
					"content": "#Se non avessimo visto per caso la Dimora di giada passare sopra di noi appena uscit{F#e}{M#i} dal Palazzo dorato, non avremmo mai saputo dove andare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240203,
					"content": "Fiuuu, siamo in tempo? Il Sovrano del vortice è ancora sott'acqua? Non ha ancora distrutto Liyue, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240204,
					"content": "Che ci fate qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240205,
					"content": "Uh... Un momento! Sono gli Adepti! Cosa ci fate nella Dimora di giada? Paimon credeva steste litigando con le Sette Stelle... Avete finito di bisticciare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240206,
					"content": "Di fronte a una calamità di tali dimensioni, abbiamo deciso di mettere momentaneamente da parte le nostre differenze e unirci contro questo nemico comune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240207,
					"content": "Tsk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "Scultore della luna"
				},
				{
					"id": 10240208,
					"content": "Oh, Paimon ha capito... Allora, come pensate di difendere Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240209,
					"content": "Uhm... al solo vedere questo Sovrano del vortice, a Paimon si stringe lo stomaco, anche da tanto lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240210,
					"content": "Non succede solo a te. Alcune nuove reclute dei Milleliti non riescono nemmeno a stare sull'attenti senza tremare. A quanto pare, l'effetto della presenza di un dio antico è un po' troppo per le persone comuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240211,
					"content": "Ed è per questo che dobbiamo fermare quel mostro prima che si avvicini al Porto di Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240212,
					"content": "Allora la Guerra degli Archon di duemila anni fa è stata combattuta contro nemici come quello? Terrificante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240214,
					"content": "Il potere delle Sette Stelle, dei Milleliti e degli Adepti qui presenti sarà abbastanza per fermarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240215,
					"content": "Ne abbiamo già discusso insieme, e la nostra conclusione è... non necessariamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240216,
					"content": "Cosa?! Ma tutti voi dovreste essere i guardiani di Liyue. Non potete pensare a una soluzione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240217,
					"content": "Costei di certo potrebbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10240218,
					"content": "Eeeh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240219,
					"content": "Un tempo le Sette Stelle decisero di studiare la balista Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10240220,
					"content": "Per volere del destino, colei che realizzò di persona la balista Guizhong è qui tra voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10240221,
					"content": "Cosa potreste mai comprendere voi mortali dei meccanismi degli Adepti? A costei, tuttavia, basterebbe ben poco per convertire la balista in uno strumento di guerra ben oltre la vostra concezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10240222,
					"content": "Eh, immagino che questo sia un miracolo degli Adepti di cui essere grati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240223,
					"content": "Bene. Useremo la balista Guizhong modificata per contrastare quel dio. Tutti gli Adepti qui presenti forniranno il loro aiuto per utilizzarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240224,
					"content": "Non c'è tempo da perdere. La nostra battaglia ha inizio ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 102408,
			"completionStepIds": [
				102408
