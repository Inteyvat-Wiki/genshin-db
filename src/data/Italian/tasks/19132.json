			},
			"dialogs": [
				{
					"id": 191320401,
					"content": "Ciao, come posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320402,
					"content": "Sono qui per ritirare un cambio di vestiti per Ningguang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "Ah, sì, certamente. Aspetta un momento, vado a prenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320404,
					"content": "Dopo una lunga attesa, finalmente Lanyang fa ritorno.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "Ecco a te. Prego, portalo a Lady Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320406,
					"content": "Ci hai messo un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "Sì, questa intera stanza è colma di oggetti personali di Lady Ningguang. Non ci sono solo vestiti, ma anche gioielli e ornamenti di ogni tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320408,
					"content": "Lady Ningguang ci ha da poco chiesto di riorganizzare questa stanza. Ce ne stiamo occupando proprio ora ed è tutto sottosopra. Ecco perché c'ho messo un po' a portarti quel completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320409,
					"content": "(Sembra che Ningguang abbia una collezione personale immensa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "#Comunque, ora puoi prenderlo. Grazie per essere passat{F#a}{M#o} a ritirarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320410,
					"content": "(Immagino che sia un tipico problema da persone ricche.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
