				"points": []
			},
			"dialogs": [
				{
					"id": 735140101,
					"content": "C'è mancato poco... Persino gli Unut vogliono rovinare i nostri piani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140102
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140102,
					"content": "Ehi! Se non avessimo annullato l'attivazione, avremmo potuto ucciderlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140103,
					"content": "Ora che quell'Unut è fuggito, ci metterà almeno un giorno prima di abbassare nuovamente la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140104
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140104,
					"content": "Ora non avrai mica intenzione di discutere sui dettagli insignificanti, per poi non parlarne più domani, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140105,
					"content": "Um, e i parametri...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140106
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140106,
					"content": "Li ho testati tutti, e nonostante la velocità di caricamento sia leggermente inferiore a quanto calcolato, non ha conseguenze sull'uso, e non ci sono rischi per la sicurezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140107,
					"content": "Shriya, lo so che vuoi considerare tutte le possibilità e analizzare tutte le variabili prima di agire; ma sai, le cose non vanno sempre secondo i piani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140108,
					"content": "Se continui a fissarti sui piccoli dettagli, ti perderai l'opportunità migliore per agire! Ricordi quella volta in cui la discussione di quella tesina di metà semestre fu rimandata? L'esitazione non ci porterà a nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140109
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140109,
					"content": "*sospira* Va bene. Tieni il tuo modulo d'attivazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140110
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140110,
					"content": "Perfetto! Domani, saremo finalmente in grado di mettere in azione il cannone Ammazzaunut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140111
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140111,
					"content": "Vorrei portarli al Villaggio di Aaru e armeggiarci ancora un po'. Dobbiamo accertarci di essere preparati per la prima apparizione ufficiale del cannone Ammazzaunut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140112,
					"content": "...Ma a cosa è dovuta questa variazione dei parametri ambientali? Che cosa ha scatenato una reazione così improvvisa degli Unut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140113
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140113,
					"content": "#Non possiamo ignorare la cosa... Avventurier{F#a}{M#e}, potresti tornare qui domani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140114
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140114,
					"content": "Per allora dovremo affrontare gli Unut direttamente, e possibilmente avremo qualche indizio in più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				}
			]
		}
	]
}