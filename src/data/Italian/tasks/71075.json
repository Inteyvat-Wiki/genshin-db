			"dialogs": [
				{
					"id": 710750101,
					"content": "Ehi, voi. Sì, proprio voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750102,
					"content": "Scommetto che qualcuno che conosce benissimo questo luogo come voi troverà ciò che non è riuscito a trovare quell'idiota di Erge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750103,
					"content": "Ah, no? Ok, aspetterò che qualcuno lo trovi, e poi glielo sottrarrò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750104,
					"content": "Mi chiamano \"il ragazzo di Qingce\", e nessuna misera banda di minatori della Voragine riuscirà a fermarmi, o non potrò mai più farmi vedere in giro. Bene, allora! Datemi quell'affare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750105,
					"content": "Prenderemo il tesoro del Millelite, grazie tante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750106,
					"content": "Non so cosa tu stia cercando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "E ciò che dici tu è legge, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750109,
					"content": "#...Uff. Sai, considerato quanto scorrazzi in giro, credevo che saresti sembrat{F#a}{M#o} più forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750110,
					"content": "#Bene, scegli: puoi darmi l'Elmo protettivo subito, oppure lasciare che me lo prenda da solo quando ti avrò mandat{F#a}{M#o} al tappeto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750111,
					"content": "...Dubito tu voglia davvero combattere contro di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "Oh, ti dai delle arie adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750113,
					"content": "Mi sa che lo imparerai a tue spese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 710750107,
					"content": "...ma non lo troverai qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				}
			]
		}
	]
