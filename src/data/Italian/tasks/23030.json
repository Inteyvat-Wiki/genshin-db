			},
			"dialogs": [
				{
					"id": 230300201,
					"content": "Guarda quella scatola. Credo ci siano le pozioni al suo interno. Yasmin dev'essere già stata qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300202,
					"content": "Eh? Le pozioni sono ancora chiuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300203,
					"content": "Non aprirle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300204,
					"content": "Aahh! Stanno comparendo dei Miconoidi dietro di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230300205,
					"content": "Cosa? Non ce n'era neanche uno prima. Cosa sta succedendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300206,
					"content": "#Direi che è ora di smettere di ascoltare le loro lamentele, {NICKNAME}. Muoviamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2303004,
			"completionStepIds": [
				2303004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303004",
							"2"
						],
						"stepId": 2303004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "Wow, che fortuna, eh? È un bene che il barattolo non si sia rotto, altrimenti adesso staremmo vomitando a profusione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300402,
					"content": "Aspetta. Non sei abituato all'odore? Non sei stato tu a realizzarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300403,
					"content": "Quante volte devo spiegarti che ho aggiunto degli emetici fisiologici, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300404,
					"content": "Non ha niente a che fare con chi è abituato o meno: basta l'odore per far rimettere chiunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300405,
					"content": "Seriamente, perché continuo a ripeterlo? Tanto non lo capisci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300406,
					"content": "Inoltre, dove diavolo è andata Yasmin? Non ha nemmeno spruzzato le pozioni, oggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300407,
					"content": "Sarà andata a raccogliere esemplari di qualche pianta rara che ha trovato, tipici comportamenti dell'Amurta... Voglio dire, come fai a non capire ancora come sono fatti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300408,
					"content": "#Va bene, adesso ci occuperemo noi di questo barattolo. Grazie per l'aiuto, viaggiat{F#rice}{M#ore}. Ti prego di accettare questo compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300409,
					"content": "Uff, questi dell'Amurta... Sono proprio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pharez"
				}
			]
		},
		{
			"id": 2303005,
			"completionStepIds": [
				2303005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
