			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "Più informazioni... È proprio ciò di cui avevamo bisogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300102,
					"content": "Come fanno a funzionare i tuoi dispositivi se non hanno il supporto dei dati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300103,
					"content": "Quindi dici di non fare niente finché non avrai ottenuto ogni singolo dato, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300104,
					"content": "Analizzerai ogni onda in arrivo cercando di prendere un pesce? No! Devi concentrarti soltanto su quelle che arrivano con il pesce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300105,
					"content": "Ora capisco perché non prendi mai pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300106,
					"content": "Andiamo! Non hai mai studiato all'Hara{RUBY#[S]Semiotica}vatat! Falla finita con i giochi di parole, ok? Dovremmo davvero metterci al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300107,
					"content": "Non possiamo permetterci altri ritardi. La mia tesi e quella di Yasmin potrebbero diventare obsolete se ci mettessimo troppo tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300108,
					"content": "Di cosa state discutendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "Tu sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300110,
					"content": "#Tu sei {F#la}{M#il} viaggiat{F#rice}{M#ore} che ha menzionato Yasmin. Il tuo aiuto ci è stato molto prezioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300111,
					"content": "#È un onore incontrarti, viaggiat{F#rice}{M#ore}! Un onore, davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300112,
					"content": "Il mio nome è Pharez, e studio alla Kshahrewar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300113,
					"content": "Io sono Ladep, e sono uno studente della Spantamad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300114,
					"content": "#Ci servirebbe un favore, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300115,
					"content": "Sai che Yasmin ha cosparso la zona intorno alle radici dell'Albero divino con le sue pozioni, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300116,
					"content": "Beh... Ehm... Quelle pozioni sembrano aver causato un problemino, di recente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300117,
					"content": "Mostri di tutti i tipi appaiono spesso nei luoghi in cui sono state spruzzate le pozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300118,
					"content": "Non ho mai cambiato nulla nella ricetta o nei dosaggi, lo giuro. Pertanto, questo dev'essere stato causato da... ehm, da alcune circostanze inaspettate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300119,
					"content": "#Se lo dici tu... Comunque sia, viaggiat{F#rice}{M#ore}, accompagnaci a controllare i posti in cui Yasmin ha spruzzato le pozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300120,
					"content": "Probabilmente ci saranno molti mostri, il che ci impedisce di andarci da soli... Avremo bisogno di qualcuno che ci aiuti e sia forte in combattimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300121,
					"content": "Più che altro, sebbene i Miconoidi non siano così pericolosi, se il problema creato dalle nostre pozioni arrivasse all'orecchio del nostro relatore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300122,
					"content": "Le nostre proposte di tesi sarebbero sicuramente spacciate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300123,
					"content": "Soprattutto qui alla Spantamad, dove un singolo errore nei dati inviati comporterebbe gravi critiche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300124,
					"content": "D'accordo, ci penserò io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "Come avete risolto problemi del genere in passato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "Beh, la soluzione abituale è quella di ingaggiare un avventuriere. In passato ci siamo anche rivolti al nostro relatore, chiedendogli di aiutarci a trovare alcuni membri fidati degli Eremiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300127,
					"content": "Ma sai, la pazienza di un relatore non è sempre infinita. Date le circostanze attuali, siamo un po' titubanti nel disturbarlo di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300128,
					"content": "#Quindi ti prego di aiutarci, viaggiat{F#rice}{M#ore}! Sei la nostra unica speranza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladep"
				}
			]
		},
		{
			"id": 2303002,
