				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladep",
					"Pharez",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "*tossisce* *tossisce* *tossisce*... Dovremmo essere a posto qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300502,
					"content": "Uff... Bleah... Tu... Questa è opera tua! Com'è possibile che stia vomitando anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300503,
					"content": "Uff... *tossisce* *tossisce* *tossisce*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "Te l'ho detto svariate volte che ho aggiunto degli emetici fisiologici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300505,
					"content": "Non ha niente a che fare con chi è abituato o meno: basta l'odore per far rimettere chiunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300506,
					"content": "Seriamente, perché continuo a ripeterlo? Tanto non lo capisci... Bleah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300507,
					"content": "#Eh? Ladep, Pharez e anche {F#la}{M#il} viaggiat{F#rice}{M#ore}? Cosa ci fate tutti qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300508,
					"content": "E il barattolo della pozione è rotto... Siete stati attaccati da un mostro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300509,
					"content": "A giudicare da quello che vedo... Forse è proprio così. Avete visto dei mostri mentre venivate qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300510,
					"content": "No. In realtà, ho anche avuto del tempo per prendere diversi esemplari delle piante qui intorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300511
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300511,
					"content": "Che cosa strana... Molto strana, in effetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300512
					],
					"speakerTitle": "Ladep"
				},
