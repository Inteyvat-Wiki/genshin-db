			"completionStepIds": [
				2102209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102208",
							"3"
						],
						"stepId": 2102208,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102209",
							"2"
						],
						"stepId": 2102209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220301,
					"content": "Hai trovato qualcosa nelle rovine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229501
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229501,
					"content": "Ho trovato cinque stele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "Ottimo! Vediamo un po'... Uff, sono tutte in disordine. Vediamo se riesco a riordinarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220302,
					"content": "...Mmmh, mancano un bel po' di pezzi, quindi il testo non è coerente. Inoltre, non sono ancora sicura dell'ordine di lettura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220303,
					"content": "Comunque, questa è la mia ipotesi migliore. Allineandole così, c'è scritto:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220304,
					"content": "\"...In principio, la gente si riunì per coltivare la terra... Un dio di nome Guizhong scese sulla terra. Egli era in grado di controllare la polvere, e il suo potere offuscava i cieli per decine di migliaia di chilometri...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220305,
					"content": "\"...Il dio stabilì quattro comandamenti per la gente... Poi un altro dio scese sulla terra. Egli era in grado di controllare Geo, e condusse gli abitanti di Liyue in questo luogo offrendo loro protezione...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220306,
					"content": "\"...E fu così che nacque il nome di Guili, ispirato alle due divinità...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220307,
					"content": "Sembra parlare della storia dell'Adunanza di Guili e del dio in grado di controllare la polvere che proteggeva l'area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220308,
					"content": "Ma dice anche che, a un certo punto, arrivò un altro dio, che portò con sé il proprio popolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220309,
					"content": "Inoltre, sembra che il termine \"Guili\", presente anche nel nome \"Adunanza di Guili\", derivi dall'unione di due sillabe prese dai nomi delle due divinità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220310,
					"content": "Affascinante. Nessuno dei documenti che ho letto menzionava due dèi che convivevano pacificamente... né tantomeno due dèi che collaboravano attivamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220311,
					"content": "A quanto pare, erano più che semplici alleati: erano migliori amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220312,
					"content": "Ma cos'è successo? Non possono essere semplicemente... spariti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220313,
					"content": "E cosa può aver mai distrutto completamente l'Adunanza di Guili? Era protetta da ben due dèi, quindi nessun disastro, naturale o meno, può aver avuto conseguenze tanto devastanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220314,
					"content": "Il che significa che ciò che è accaduto qui era più forte persino degli dèi stessi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220315,
					"content": "#Viaggiat{F#rice}{M#ore}, cercheresti altri indizi? Se non erro, da queste parti dovrebbero esserci altre stele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220316,
					"content": "Forse ci diranno cos'è successo dopo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220317,
					"content": "Alcune delle cose scritte su queste stele sono diverse da ciò che è stato documentato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220318,
					"content": "*sospira* Ci sono così tante leggende, così tanti racconti... Chissà qual è la verità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
