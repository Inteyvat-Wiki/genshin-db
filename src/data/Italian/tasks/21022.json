			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220501,
					"content": "Ah, rieccoti. Iniziavo a chiedermi quanto ancora ci fosse da aspettare. Hai trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229601
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229601,
					"content": "Altre due stele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "Oooh, fammi vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229603,
					"content": "\"...E combatterono nelle Pianure di Guili, dove la polvere oscura soffocava il cielo e migliaia di pietre si frantumavano...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229604,
					"content": "Oh, cielo... Sembra star parlando di una battaglia avvenuta nelle Pianure di Guili... Ed è stata anche colossale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229605,
					"content": "Dev'essere questa la battaglia che portò alla caduta dell'Adunanza di Guili. Ma quest'altro verso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229606,
					"content": "...Sembra essere stato scritto da qualcuno che non ebbe il coraggio di lasciare la propria casa, rimanendo qui. Inoltre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229607,
					"content": "...C'è un tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "...Hai un debole per i tesori, eh? Però hai ragione: se prendiamo questo verso alla lettera, di sicuro c'è un tesoro nelle Pianure di Guili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220503,
					"content": "Ma poi abbiamo... \"I Quattro comandamenti di Guizhong guideranno le generazioni a trovarlo\", seguito da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220504,
					"content": "\"Insegnate con saggezza, attenetevi alla virtù, fortificate le ossa e unitevi nell'ambizione. La convergenza di questi princìpi sarà conosciuta come 'Adunanza di Guili'\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220505,
					"content": "Ma come fare a decifrarlo? Non saprei neanche da dove iniziare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220506,
					"content": "Torniamo alla Locanda Wangshu. Penso che dovremmo riposare un po' prima di affrontare l'indovinello dei Quattro comandamenti di Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
