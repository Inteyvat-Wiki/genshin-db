					"nextDialogs": [
						760830406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830406,
					"content": "Temo che questo indovinello fosse un po' troppo semplice per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830407,
					"content": "Un'unagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830408
					]
				},
				{
					"id": 760830408,
					"content": "Ehi, che c'è che non va con la vita di questa anguilla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830409,
					"content": "Voi due possedete una conoscenza davvero impressionante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830410
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830410,
					"content": "La risposta corretta è \"la luna\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830411
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830411,
					"content": "Venite qui. Avete fatto un ottimo lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830412,
					"content": "Un arco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830413
					]
				},
				{
					"id": 760830413,
					"content": "Chiunque dotato di occhi può vedere che è un arco! Com'è possibile che la risposta sia così semplice?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830414,
					"content": "Anche se tecnicamente non hai torto, temo che non sia esattamente ciò che le Kuuhenki intendevano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830415
