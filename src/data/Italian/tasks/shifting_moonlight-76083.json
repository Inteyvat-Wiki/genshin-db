						760830506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830506,
					"content": "Quindi è così che si chiama. Prende forse la sua creatrice e la porta in giro nella sua mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830507
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830507,
					"content": "Paimon pensa che tu stia confondendo Aino con una tua ex collega...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830508,
					"content": "Una Donnoladra che ha mangiato troppo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830509
					]
				},
				{
					"id": 760830509,
					"content": "Come può una Donnoladra così piena rubare cose?",
