					"nextDialogs": [
						760830510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830510,
					"content": "Forse non ha più bisogno di farlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830511
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830511,
					"content": "La risposta corretta è \"la grande papera meccanica accanto al laboratorio di Aino.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830512
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830512,
					"content": "Tornate qui. Grazie, so che non è stato facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760830513,
					"content": "Una fialetta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830514
					]
				},
				{
					"id": 760830514,
					"content": "Woah, le Kuuhenki hanno imparato cosa sono le attrezzature di laboratorio specializzate per questo gioco? Ce la stanno mettendo proprio tutta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830515
					],
					"speakerTitle": "Paimon"
				},
				{
