				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3840401,
					"content": "Barbat... Venti, fai attenzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840402
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840402,
					"content": "Eheh... È da un po' che hai capito la mia vera identità, non è così, Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840403,
					"content": "Ti ringrazio comunque per aver continuato a chiamarmi Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840404,
					"content": "In che stato è la Lira sacra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840405,
					"content": "Può ancora essere suonata o va riparata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840406,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840407,
					"content": "Purtroppo non credo si possa riparare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840408,
						3840410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840408,
					"content": "Non possiamo lasciar fuggire questo Mago dell'Abisso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840409
					]
				},
				{
					"id": 3840409,
					"content": "Hai ragione. Se non estirpiamo il male alla radice, non riusciremo mai a salvare Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840413,
					"content": "In questo caso, chiederò ad Amber la Vigilante di inseguirlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840414,
					"content": "Non ce n'è bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840415
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840415,
					"content": "Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840416,
					"content": "Ne ho eliminato uno qualche tempo fa, in uno dei Templi dei Quattro Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840417,
					"content": "Cosa?! Quando?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840418,
					"content": "Se vuoi inseguire questi mostri, cercherò informazioni tra i miei contatti. I mezzi non mi mancano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840419,
					"content": "Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840420,
					"content": "Pur odiando i Cavalieri di Favonius, anche lui protegge Mondstadt, seppur a modo suo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840421,
					"content": "Ooh? Perché la piccola Paimon all'improvviso sembra così affettuosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840422,
					"content": "Bah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840423
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840423,
					"content": "Aspetta mie notizie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840424,
					"content": "Farò in modo che l'Ordine dell'Abisso sappia che il suo palese disprezzo per Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840425,
					"content": "...non rimarrà impunito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840410,
					"content": "Dvalin è in serio pericolo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840411
					]
				},
				{
					"id": 3840411,
					"content": "No, dobbiamo prima farla pagare a quel Mago dell'Abisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840412
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840412,
					"content": "Se non estirpiamo il male alla radice, non riusciremo mai a salvare Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "Diluc"
				}
			]
		}
	]
