			"dialogs": [
				{
					"id": 3840201,
					"content": "Finalmente siamo tutti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840202,
					"content": "Che bel panorama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840203,
					"content": "Perfetto per una riunione tanto attesa, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840204,
					"content": "Bene, teniamoci pronti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840205,
					"content": "Vada come vada, sembra che finalmente le cose stiano volgendo al meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840206,
					"content": "Mondstadt di recente ne ha viste di cotte e di crude...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840207,
					"content": "Ah! Alla fine, per risolvere il problema è bastato il vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840208,
					"content": "Immagino che anche i Cavalieri di Favonius abbiano avuto un certo peso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840209,
					"content": "Oh, lo sappiamo, patron Diluc... Ora, fatevi da parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840210,
					"content": "Io, miglior bardo itinerante del mondo dei mortali, darò inizio alla mia esibizione con la Lira sacra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 38404,
			"completionStepIds": [
				38405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
