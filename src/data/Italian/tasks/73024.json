			"dialogs": [
				{
					"id": 730240101,
					"content": "#Oh, siete stat{F#e}{M#i} di grande aiuto! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240102,
					"content": "Come potete vedere, sono una Guardiana della foresta. Il mio nome è Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240103,
					"content": "#Io sono {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "Paimon è Paimon! Veniamo da un'altra nazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240107,
					"content": "#Capisco. Mmh... Non siete vestit{F#e}{M#i} come gli abitanti della foresta, né sembrate provenire dal deserto, ma i vostri abiti sono traspiranti e sono adatti per viaggiare a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240108,
					"content": "Eh? Visto che Rana è una Guardiana della foresta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240109,
					"content": "Dovrebbe conoscere Tighnari, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#Oooh! {NICKNAME}, conosci Tighnari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240111,
					"content": "Tighnari può sembrare inavvicinabile, ma in realtà è una persona molto gentile. Si è preso molta cura di me quando ero apprendista. E poi, ha delle orecchie bellissime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240112,
					"content": "Sì! Paimon vorrebbe toccarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240113,
					"content": "Anch'io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "Mm... Paimon si chiede se potrebbe riuscire a toccarle avvicinandosi di soppiatto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240115,
					"content": "Ahahah! Tighnari si arrabbierà se prima non chiedi il permesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240118,
					"content": "Probabilmente sì! Ma le sue orecchie sono lucide, e mi chiedo proprio che effetto faccia. Anche la ragazza con lui sembrava molto interessata a quelle orecchie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240119,
					"content": "Eh? Rana, stai parlando di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240120,
					"content": "Ti riferisci a Collei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#Eh? {NICKNAME}, conosci anche Collei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240122,
					"content": "Collei non è stata molto bene. Ciononostante, lavora duramente per proteggere la foresta ed eliminare l'Avvizzimento. Sono tutti preoccupati per lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240141,
					"content": "Ehm! Comunque, il compito di un Guardiano della foresta è quello di proteggere la foresta, aiutare i viaggiatori e fornire indicazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240142,
					"content": "Come avete avuto modo di notare, ultimamente la foresta non è... proprio in forma. I Miconoidi e gli animali sono sempre più aggressivi, e poi c'è l'Avvizzimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240143,
					"content": "Che ne dite se vi accompagno? Il mio percorso di pattugliamento prevede che passi per il Villaggio di Vimara. Da lì è facile raggiungere Porto Ormos o la Città di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240144,
					"content": "Certo, andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "Ok, vi proteggerò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240146,
					"content": "Va bene, ma prima devo occuparmi di alcune cose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "Capisco, vi aspetto qui. Fate attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240116,
					"content": "Paimon può farlo in modo davvero furtivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "Ehi! Questo farà arrabbiare Tighnari, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240123,
					"content": "Dovrebbe conoscere Collei, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#Ehi, {NICKNAME}, hai conosciuto quella bambina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240125,
					"content": "Collei non è stata molto bene. Ciononostante, lavora duramente per proteggere la foresta ed eliminare l'Avvizzimento. Sono tutti preoccupati per lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240126,
					"content": "Ma è con un senior affidabile, tizio dalle orecchie pelosette, quindi dovrebbe stare bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240127,
					"content": "Eh? Le orecchie... Stai parlando di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240128,
						730240138
					],
