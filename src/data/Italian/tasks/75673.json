			"dialogs": [
				{
					"id": 756730101,
					"content": "Sembra che adesso i nostri Asha coloristi siano molto soddisfatti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730102,
					"content": "Un'altra sfida completata per i nostri prodigiosi Asha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730103,
					"content": "Alla grande! Ce l'abbiamo fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730104,
					"content": "Questo Asha ha già in mente la sua prossima opera d'arte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730105,
					"content": "Beh, l'ispirazione può andare e venire in un batter d'occhio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#Ah, guarda quanti tesori si è lasciato dietro... {NICKNAME}, Paimon, prendeteli voi! Come ringraziamento per tutto l'impegno che ci avete messo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730108,
					"content": "Magari la prossima volta che passeremo di qui potremo ammirare il capolavoro dell'Asha colorista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730109,
					"content": "Chissà di cosa si tratterà! Specie considerando che anche gli Asha normali sono già capaci di creare colori stupendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730110,
					"content": "Paimon non vede l'ora di scoprire cosa creeranno gli Asha coloristi! Magari tireranno fuori qualcosa... d'indescrivibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730111,
					"content": "Cose come i colori del Flogisto, della luna, o delle profondità del cielo stellato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730112,
					"content": "Già, è proprio così che dovrebbe essere! Se durante le nostre avventure c'imbattiamo in una creatura in difficoltà, dobbiamo fare il possibile per aiutarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730113,
					"content": "Mh-mh! Chissà, forse un giorno tutto questo ci porterà delle ricompense inaspettate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730114,
					"content": "Concordo con Bennett.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "Ah, però... Non dovremmo farlo solo per avere una ricompensa, non avrebbe alcun senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730117,
					"content": "Anche se non ci guadagniamo nulla, aiutare gli amici nel bisogno e vederli sorridere di nuovo quando le cose migliorano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730118,
					"content": "È una sensazione fantastica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730115,
					"content": "E dà anche molta soddisfazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "Bisogna battere il ferro finché è caldo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
