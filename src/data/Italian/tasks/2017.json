			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "Ah! Quel tanuki giocattolo è diventato un essere umano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170202,
					"content": "Che sta succedendo? Paimon non ha mai visto una cosa del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170203,
					"content": "Ti sbagli... Sono una mujina... *russa*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170204,
					"content": "Che stanchezza... Se non dormo abbastanza... non crescerò mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170205,
					"content": "Ehm, è questa la \"professionista\" di cui parlavi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170206,
					"content": "Non sembra proprio... una professionista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170207,
					"content": "Eheh... È un membro della Shuumatsuban, una vera e propria ninja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170208,
					"content": "Wow, accidenti! Quindi quella era una delle leggendarie tecniche di trasformazione ninja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170209,
					"content": "A proposito, cos'è la Shuumatsuban?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170210,
					"content": "Fa parte della Commissione Yashiro, è un'unità segreta agli ordini di Kamisato Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170211,
					"content": "Al momento, Kamisato Ayato e la Commissione Yashiro sono parti neutrali, quindi non posso impartire ordini alla Shuumatsuban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170212,
					"content": "Tuttavia, posso almeno convincere il loro membro più pigro prestarci il suo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170213,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170214,
					"content": "Ecco cosa dovrete fare: andate in città e cercate le prove del tradimento della Commissione Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170215,
					"content": "Non sarebbe appropriato mostrarmi di persona da quelle parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170216,
					"content": "Facile a dirsi, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170217,
					"content": "Non so cosa cercare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "Eh? Oh, pensavo l'avessi già capito. Va bene allora, ti concederò qualche altra informazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170220,
					"content": "Per gli stranieri, indagare sugli affari interni della Commissione Tenryou è quasi impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170221,
					"content": "Ma visto che le tre Commissioni lavorano insieme per servire la Shogun, hanno un rapporto stretto. Alcuni membri delle altre Commissioni potrebbero riuscire a scoprire più facilmente cosa stanno combinando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170222,
					"content": "La Commissione Yashiro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "Eheh... Adesso hai capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170224,
					"content": "L'esercito della Shogun non ha ancora smesso di cercarti ma, con l'aiuto di questa ninja della Shuumatsuban, sono sicura che ti sarà facile riunirti ai tuoi amichetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170225,
					"content": "Non dimenticare che abbiamo i minuti contati. Devi trovare le prove il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170218,
					"content": "In cosa consistono, queste prove?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
			"id": 201704,
			"completionStepIds": [
				201704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
