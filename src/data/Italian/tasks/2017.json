				{
					"id": 20171000,
					"content": "Yoimiya, ci servono dei fuochi d'artificio grandissimi! E intendo proprio super mega giganti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171001
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171001,
					"content": "\"Fuochi d'artificio grandissimi\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171002
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171002,
					"content": "Eheh, siete venuti dalla persona giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171003
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171003,
					"content": "Si dà il caso che io ne abbia modificati un po' giusto qualche giorno fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171004
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171004,
					"content": "Ma sono così potenti che non ho ancora avuto modo di testarli. Potrei darli a voi... Fatemi sapere come va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171005
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171005,
					"content": "Non dimenticate di allontanarvi dopo averli accesi, e cercate di non bruciarvi i vestiti! Ah, e sarà meglio che vi copriate le orecchie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171006
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171006,
					"content": "Ehm, all'improvviso Paimon ha una certa paura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171007,
					"content": "Ahah! Dai, niente paura, sono solo fuochi d'artificio. Cosa mai potrebbe andare storto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171008
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171008,
					"content": "Faremo un tentativo... Grazie, Yoimiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
