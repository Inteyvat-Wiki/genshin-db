			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170901,
					"content": "#Allora, {NICKNAME}? Com'è andata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170902,
					"content": "#Non ne sono cert{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "Ben fatto. Aspettiamo notizie di Sayu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170905,
					"content": "Poco dopo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170906,
					"content": "*ansima*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170907,
					"content": "So che l'esercizio fisico aiuta a crescere, ma stavolta è stato un po' troppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170908,
					"content": "Ho le vertigini.... Mi gira tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170909,
					"content": "No, non posso ancora dormire. Devo prima fare una cosa importante... Oh, giusto, sì. Ci sono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170910,
					"content": "Non sapevo dove fosse il documento di cui parlavate, quindi ho preso tutto ciò che mi è sembrato sospetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170911,
					"content": "Ecco qua... Adesso me ne vado a dormire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170912,
					"content": "Milady, cosa abbiamo qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170913,
					"content": "Questa busta sigillata dev'essere un rapporto ufficiale che la Commissione Tenryou sta preparando per la Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170914,
					"content": "In più, abbiamo anche... della corrispondenza con i Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170915,
					"content": "Sembra che la Guuji Yae avesse ragione. Fomentano odio di nascosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170916,
					"content": "#{NICKNAME}, queste prove dovrebbero bastare. Portatele alla <color=#00E1FFFF>Guuji Yae</color>. Sono sicura che ha già un'idea di come procedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170917,
					"content": "Io proverò a riunire un po' di persone per tentare di scacciare il resto dei Fatui da Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170918,
					"content": "Tuttavia, fate attenzione quando affrontate la Shogun. Mi viene ancora la pelle d'oca quando ripenso a lei che estrae la sua arma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170919,
					"content": "Possiamo solo fidarci della Guuji Yae, a questo punto. Lei conosce bene la Shogun, quindi forse sa come fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170920,
					"content": "Se Paimon ricorda bene, tra un po' dovremo tornare da Yae Miko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170921,
					"content": "Prendiamo le nostre cose e prepariamoci a raggiungerla al <color=#00E1FFFF>Gran Santuario di Narukami</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170903,
					"content": "Abbiamo acceso i fuochi d'artificio e ce la siamo data a gambe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
		},
