				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}, come mai sei qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170404,
					"content": "Avete incontrato la Resistenza? Come sta andando la battaglia? Posso uscire senza correre rischi adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170405,
					"content": "Non ancora... Abbiamo incontrato delle pattuglie mentre venivamo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170406,
					"content": "#Dunque non è ancora finita... Immagino che siate venut{F#e}{M#i} per discutere di qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170407,
					"content": "Dirò a qualcuno di chiamare la signorina Kamisato, un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170408,
					"content": "Informi Ayaka e Thoma in merito alla situazione attuale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170409,
					"content": "Capisco. Ne avete passate parecchie dal nostro ultimo incontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170410,
					"content": "Comprendo, vi servono le prove del tradimento della Commissione Tenryou. Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170411,
					"content": "Ora che ci penso, c'è una cosa che mi ha sempre preoccupata. È ormai da tanto che l'esercito della Shogun è in guerra con la Resistenza, ma la Shogun non ha mai posto domande in merito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170412,
					"content": "Pensavo che non le importasse ma, a ripensarci, forse il problema sono i <color=#00E1FFFF>rapporti inviati dalla Commissione Tenryou</color> alla Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170413,
					"content": "Che vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170414,
					"content": "La Commissione Tenryou presiede gli affari militari interni. Se decidesse di omettere delle informazioni dai rapporti, noi non avremmo modo di saperlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170415,
					"content": "La Shogun penserebbe impropriamente che il Decreto di caccia alle Visioni non rappresenti una minaccia, e si atterrebbe alla sua decisione. Se avessimo accesso ai loro rapporti, potremmo confermare questa teoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170416,
					"content": "Ma se ricordo bene, l'unica persona autorizzata ad accedere a quel tipo di documenti ufficiali è Kujou Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170417,
					"content": "E per giunta sono documenti ben sorvegliati. Anche con l'aiuto di Sayu, non sarebbe facile sottrargli un documento proprio da sotto il naso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170418,
					"content": "Se solo ci fosse un modo per distrarre le guardie, giusto il tempo necessario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170419,
					"content": "Mmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170420,
					"content": "Ci serve una distrazione, quindi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "I fuochi d'artificio di Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170423,
					"content": "Un suggerimento tipico di te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170424,
					"content": "Ma in effetti è una proposta sensata. La Statua della divinità onnipresente si trova proprio accanto alla Commissione Tenryou. Di certo sarebbe difficile ignorare dei fuochi d'artificio accesi vicino alla statua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170425,
					"content": "Così Sayu potrebbe infiltrarsi nella Commissione Tenryou e prendere il rapporto, oltre a qualsiasi altra prova riesca a trovare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170426,
					"content": "Ottimo! Sento che la mia libertà è sempre più vicina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170427,
					"content": "Ah... Sembra passata un'eternità dall'ultima volta che ci siamo seduti a chiacchierare così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170428,
					"content": "Non è trascorso così tanto tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "Beh, a me è sembra di sì... Da quando sono arrivato qui, ogni giorno ho sperato di rivederti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170430,
					"content": "Questa sala da tè era il mio nascondiglio preferito, ma adesso... Onestamente non ricordo neanche più quand'è stata l'ultima volta che ho messo piede fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170431,
					"content": "Cavolo! Ho una voglia di andare alle sorgenti termali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170432,
					"content": "Povero Thoma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170433,
					"content": "Pensiamo alla questione più pressante, per ora. Prima il Decreto di caccia alle Visioni verrà abolito, prima Thoma sarà libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170434,
					"content": "Ci siamo rincontrati, ma non abbiamo il tempo di chiacchierare. Quando questa storia sarà finita potremo festeggiare per bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170435,
					"content": "Oh, e facciamo di nuovo il gioco dell'hot pot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170436,
					"content": "Ci stai ancora pensando?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170437,
					"content": "La Commissione Tenryou è sotto stretta sorveglianza. Fate attenzione quando vi avvicinate. Incontriamoci qui, quando avrete finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170438,
					"content": "#Allora, {NICKNAME}. Prima andiamo a <color=#00E1FFFF>Hanamizaka</color> per incontrare <color=#00E1FFFF>Yoimiya</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170421,
					"content": "Abbiamo già esperienza in questo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
		{
			"id": 201707,
			"completionStepIds": [
				201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
