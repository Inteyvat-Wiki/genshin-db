			"dialogs": [
				{
					"id": 221090301,
					"content": "Hai già sconfitto gli Hilichurl arcieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090302,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "Ben fatto! Hai avuto delle difficoltà? Non che lo creda, chiedo solo per gentilezza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090304,
					"content": "Ancora nessuna novità sulla spada? *sospira* Indovina un po', un'altra ricerca a vuoto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090305,
					"content": "Beh, grazie lo stesso. Ecco la ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090306,
					"content": "Perché tieni tanto a quella spada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "Immagino di potertene parlare. La chiamano Lama nascosta e apparteneva a mio fratello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090308,
					"content": "Quando morì, però, inspiegabilmente non fu rinvenuta accanto a lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090309,
					"content": "Portava sempre la spada con sé, sempre. Il pensiero che sia successo qualcosa che li abbia separati mi affligge fin da allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090310,
					"content": "Purtroppo non ho mai trovato indizi affidabili su dove si trovi ora la spada, né su cosa abbia causato la morte di mio fratello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090311,
					"content": "Tutto qua. Non ho altro da dire. Buona giornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
	]
