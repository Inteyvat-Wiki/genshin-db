				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221090101,
					"content": "*sospira* Ancora niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "#Ah, di nuovo voi due... Evidentemente, le missioni della Gilda non bastano a tenervi occupat{M#i}{F#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090104,
					"content": "#Se siete interessat{M#i}{F#e}, avrei un altro incarico per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090105,
					"content": "Un gruppo di Hilichurl arcieri si è radunato al centro delle Pianure di Guili e minaccia i viandanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090106,
					"content": "Parliamo di banali Hilichurl, è vero, ma hanno una posizione strategicamente vantaggiosa e sono in tanti, quindi un avventuriere sprovveduto si troverebbe nei guai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090107,
					"content": "Ho bisogno che li disperdiate rapidamente e con efficienza. A lavoro terminato, vi aspetta una bella ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090108,
					"content": "Inoltre... nel caso trovaste una qualsiasi qualcosa di attinente a una spada, fate rapporto a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090109,
					"content": "Ci sto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "Non capisco se l'entusiasmo con cui hai accettato derivi dall'incoscienza giovanile o da un coraggio smisurato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090112,
					"content": "#Di una cosa però sono certa: possiedi davvero lo spirito di un{M# }{F#'}avventurier{M#e}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090115,
					"content": "Non ho altro da dire. Faresti meglio a prepararti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090110,
					"content": "Cosa significa la spada per questi Hilichurl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "Nulla, sono due cose scollegate. Voglio solo che teniate gli occhi aperti e... nel caso trovaste qualcosa, che me la portiate, altrimenti nessun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221090114,
					"content": "L'obiettivo di questo incarico è sconfiggere gli Hilichurl. Annientali e otterrai una ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
