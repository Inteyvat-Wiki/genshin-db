			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Helbet",
					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040901,
					"content": "Ottimo lavoro! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040902
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040902,
					"content": "Quando avremo recuperato tutte le reliquie, chiederò un ulteriore compenso per ricompensarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040903
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040903,
					"content": "Non credi proprio che io riesca a prendere un pesce all'amo, vero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040904
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040904,
					"content": "Aspetta, ha abboccato qualcosa di grosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040905
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040905,
					"content": "Kayvan solleva con forza la canna da pesca...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040906
					]
				},
				{
					"id": 731040906,
					"content": "Che cos'è...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040907
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040907,
					"content": "Ah, questo è un altro pacchetto di reliquie! Grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040908
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040908,
					"content": "Non mi aspettavo che filasse tutto liscio. Abbiamo recuperato due reliquie! Niente male, signor Kayvan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040909
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040909,
					"content": "Non avrei dovuto accettare di aiutarti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040910
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040910,
					"content": "Nel fiume ci sono tonnellate di pesci. Ma lo stesso si può dire delle reliquie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040911
					]
				},
				{
					"id": 731040911,
					"content": "Ma non ho preso nemmeno un pesce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040912
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040912,
					"content": "Guarda il lato positivo: abbiamo recuperato le reliquie. È un'ottima cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040913,
					"content": "L'ultimo punto di pesca è vicino al Villaggio di Vimara. Un luogo molto più sicuro per pescare. Andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040914
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040914,
					"content": "Certo, certo. In marcia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040915
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040915,
					"content": "Che strano. Non è che c'è qualcosa che non va nella mia esca o nel mio modo di pescare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040916
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040916,
					"content": "#Non importa. Viaggiat{F#rice}{M#ore}, per favore, trovami delle pesche di Zaytun fresche questa volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040917
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040917,
					"content": "Dato che è l'ultimo posto, dovrò usare la mia esca speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040918
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040918,
					"content": "#Conto su di te, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
		},
