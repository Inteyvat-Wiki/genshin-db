			},
			"dialogs": [
				{
					"id": 731041201,
					"content": "Sembra tutto pronto. È ora di un ultimo lancio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041202
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041202,
					"content": "Uff... Questa è la volta buona, me lo sento. Ti prego, fammi prendere qualche pesce! Anche uno piccolissimo andrà bene lo stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041203,
					"content": "Kayvan prepara l'esca e inizia a pescare...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041204
					]
				},
				{
					"id": 731041204,
					"content": "Passato qualche istante, la lenza tira fuori dall'acqua un terzo pacchetto inzuppato.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041205
					]
				},
				{
					"id": 731041205,
					"content": "Guarda tu... Io non ne ho il coraggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041206
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041206,
					"content": "Va bene, fammi dare un'occhiata... Perfetto, non ci sono danni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041207
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041207,
					"content": "Perfetto, signor Kayvan! L'Arpione supremo, ha colpito ancora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041208
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041208,
					"content": "Sì, ahah... Se è quello che volevi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041209
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041209,
					"content": "Tre pacchetti in tre tentativi... Ma non ha abboccato nemmeno un pesce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041210,
						731041211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041210,
					"content": "È questo che rende il signor Kayvan così incredibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				},
				{
					"id": 731041212,
					"content": "Ehi! Io volevo seriamente prendere un pesce grosso, non carabattole antiche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041213
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041213,
					"content": "Datemi pure del pescatore incapace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041214
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041214,
					"content": "Ma è successo così tante volte! Anche il pescatore più sfortunato al mondo sarebbe già riuscito a prendere un pesciolino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041215
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041215,
					"content": "Io invece ho fatto solo buchi nell'acqua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041216
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041216,
					"content": "Mmmh... In effetti è strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041217,
					"content": "Beh, signor Kayvan, se ti interessa, posso presentarti un ricercatore specializzato nella pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041218
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041218,
					"content": "Ha lavorato alla progettazione di molte canne da pesca ed esche di successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041219
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041219,
					"content": "Non so bene perché tu non sia riuscito a prendere nemmeno un pesce all'amo. Ma... chiederlo a un professionista non farà male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041220
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041220,
					"content": "Magari troverà interessante il tuo caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041221
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041221,
					"content": "Il fatto che riesco a pescare di tutto tranne che pesci, intendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041222
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041222,
					"content": "Hai ragione, però. Almeno potrò capire che c'è che non va con le mie abilità da pescatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041223
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041223,
					"content": "Certo. Ci penso io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041224
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041224,
					"content": "Ho però dei dubbi che dei topi di biblioteca conoscano davvero la pesca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041225
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041225,
					"content": "#Oh... quasi dimenticavo! Grazie per l'aiuto, viaggiat{F#rice}{M#ore}. Ecco il tuo compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041211,
					"content": "È certamente unico nel suo genere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				}
			]
		},
