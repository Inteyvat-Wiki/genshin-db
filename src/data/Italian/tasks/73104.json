			},
			"dialogs": [
				{
					"id": 731040701,
					"content": "Ok. Ricominciamo a pescare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040702
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040702,
					"content": "Mi devo concentrare. Non fate rumore, per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040703
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040703,
					"content": "Kayvan inizia a concentrarsi sulla pesca...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040704
					]
				},
				{
					"id": 731040704,
					"content": "Argh! Guardate laggiù! Quanti Melmosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040705
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040705,
					"content": "Eh? Non ho mai visto niente del genere prima d'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040706,
						731040707
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040706,
					"content": "Lasciateli a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040708
					]
				},
				{
					"id": 731040708,
					"content": "Perché ci sono tutti questi problemi quando pesca il signor Kayvan...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040707,
					"content": "Tu pensa a pescare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040708
					]
				}
			]
		},
		{
			"id": 7310409,
			"completionStepIds": [
				7310409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
