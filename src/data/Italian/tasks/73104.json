				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310404",
							"2"
						],
						"stepId": 7310404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040401,
					"content": "Che velocità! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040402
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040402,
					"content": "Iniziate a pescare, o le reliquie potrebbero... Voglio dire i pesci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040403,
					"content": "Non c'è fretta. Mi serve la massima tranquillità per percepire lo scorrere dell'acqua e lanciare l'amo nel punto giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040404
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040404,
					"content": "Vediamo quali pesci grossi mi aspettano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040405
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040405,
					"content": "Kayvan prepara l'esca e inizia a pescare.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040406
					]
				},
				{
					"id": 731040406,
					"content": "Dopo un bel po' di tempo, Kayvan pesca un pacchetto inzuppato.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040407
					]
				},
				{
					"id": 731040407,
					"content": "Cos'è...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040408
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040408,
					"content": "Questo è... fammi controllare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040409
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040409,
					"content": "Ci siamo! Uno dei pezzi d'antiquariato perduti! Non ha subito danni. Non è entrato nessun animaletto acquatico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040410
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040410,
					"content": "Hai pescato una reliquia! Sei davvero l'Arpione supremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040411
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040411,
					"content": "È un complimento? Non mi rende molto felice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040412
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040412,
					"content": "Beh, abbiamo recuperato la reliquia nel primo punto. Il prossimo punto di pesca... si trova a ovest di qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040413
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040413,
					"content": "Diamoci da fare. Prima potrò tornare a prendere dei pesci veri in santa pace, meglio sarà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040414,
					"content": "Nessun problema. Per di qua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040415,
					"content": "#Viaggiat{F#rice}{M#ore}, questa volta useremo il frutto di Harra come esca. Il mio istinto mi dice che è il materiale più adatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040416
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040416,
					"content": "Conosco un posto dove si trovano i frutti di Harra migliori. Vi mostro la posizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040417
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040417,
					"content": "Noi ci incamminiamo. Incontriamoci al prossimo punto di pesca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
		},
