				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "Ti prego, dammi una mano! Avrei davvero bisogno del tuo aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040102,
					"content": "Niente da fare. Su, vattene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040103,
					"content": "Ehi, cos'è questo bisticciare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040104,
					"content": "#Ehi, forestier{F#a}{M#o}, ti va di aiutarmi a convincere questa signorina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040105,
					"content": "È venuta a chiedermi di recuperare alcuni pezzi d'antiquariato. È tutto il giorno che mi infastidisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040106,
					"content": "Non solo ha spaventato i miei pesci, ma vuole anche continuare a farmi perdere un sacco di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040107,
					"content": "Signorina, perché tanta fretta? Stai provando a ricavare soldi da oggetti d'antiquariato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040108,
					"content": "No, signor Kayvan. Sono Helbet dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040109,
					"content": "L'Akademiya ha trovato questi oggetti di antiquariato e io sono responsabile della loro custodia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040110,
					"content": "C'è stato un incidente sulla nave che trasportava le reliquie. Alcune sono cadute in acqua, e sono scese galleggiando lungo il fiume fino ai punti più profondi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040111,
					"content": "Allora rivolgiti a una squadra di recupero professionale! Perché disturbare un pescatore come me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040112,
					"content": "Ci vorrebbe troppo tempo per trovare una squadra di recupero adatta. Ho sentito dire che la gente ti chiama \"Arpione supremo\" e che quasi ogni giorno ripeschi dal fiume degli oggetti smarriti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040113,
					"content": "Vedo che passi molto tempo a pescare, così ho pensato di chiederti se potessi gettare l'amo per recuperare le reliquie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040114,
					"content": "Sembra una cosa urgente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "Ehm, signorina Helbet, mi spiace per quello che le è successo. Ma io sono solo un pescatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040118,
					"content": "L'amo lo getto solo per prendere pesci, e nient'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040119,
					"content": "Ma se non hai preso nemmeno un pesce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040120,
					"content": "Ehm! Mi sto allenando a farlo con il pensiero. Non ho mai pensato di prendere all'amo altre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040121,
					"content": "Faresti meglio a trovarti qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040122,
					"content": "Eh... Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040123,
					"content": "Allora... Non ti chiederò di recuperarmi le reliquie, ma solo che tu vada a pescare in un altro posto. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040124,
					"content": "Ti pagherò per prendere qualche bel pesce! Ti prego, conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040125,
					"content": "Ugh... Sono un pescatore! Un pescatore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040126,
					"content": "È bello pescare in un posto nuovo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "Su, per favore, aiutami. Ho già qui il tuo compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040129,
					"content": "Siete proprio insistenti... E va bene, lo farò giusto per cambiare un po' aria. Dove vuoi che peschi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040130,
					"content": "Grazie mille! Da questa parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040131,
					"content": "#Stessa cosa di prima, viaggiat{F#rice}{M#ore}. Aiutatemi a trovare dei materiali per le esche, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040132,
					"content": "Fammi pensare... Questa volta userò della menta. Ma deve essere raccolta dal mio solito posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040133,
					"content": "Ho segnato l'area generale. Conto su di voi. Dopo aver portato i materiali, parleremo del compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040134,
					"content": "Io e la signorina Helbet andremo subito al punto di pesca. Ci incontriamo lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040127,
					"content": "Beh, un pescatore pesca sempre un po' di tutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "Beh, a gettare l'amo ci penserà Kayvan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "Io l'amo lo getto solo per prendere dei pesci, mi sono spiegato?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "Kayvan"
				}
			]
		},
