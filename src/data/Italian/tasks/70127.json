			},
			"dialogs": [
				{
					"id": 701270101,
					"content": "\"Se stai leggendo questo messaggio, spero che tu sia la persona che penso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701270102,
					"content": "\"Ho perso il conto delle lettere, non so più che numero sia questa, né che acque la trasporteranno su quali spiagge...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701270103,
					"content": "\"Se mai dovessimo incontrarci di nuovo, parlami ancora una volta della città montana di pietra e delle tormente di neve del nord. Oppure potresti parlarmi di denti di leone e vino, che ne dici?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701270104,
					"content": "\"Aspetterò la tua risposta, come ho sempre fatto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Messaggio in bottiglia"
				}
			]
		},
		{
			"id": 7012702,
			"completionStepIds": [
				7012702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270201,
					"content": "\"Se stai leggendo questo messaggio, spero che tu sia la persona che penso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701270202,
					"content": "\"Un tempo credevamo che la guerra esistesse solo nelle favole e nelle leggende, ma ora tremiamo tutti dinnanzi alla fragorosa ira di Sua Eccellenza.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701270203,
					"content": "\"La spiaggia in cui andavamo è stata chiusa, ma ho trovato il modo di far partire comunque questa lettera.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701270204,
					"content": "\"Non preoccuparti e non rimproverarti per questo. Non è nulla per una persona come me, che un tempo ha vissuto avventure al tuo fianco.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "Messaggio in bottiglia"
				},
				{
					"id": 701270205,
					"content": "\"Aspetterò la tua risposta, anche se non fosse altro che una sola parola.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Messaggio in bottiglia"
				}
			]
		}
	]
}