			"dialogs": [
				{
					"id": 760500101,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500102
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500102,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500103,
					"content": "Wow, che movimento che c'è qui oggi! Le Kuuhenki stanno tutte ballando attorno a Colombina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500104,
					"content": "Uh, aspetta un attimo... Non stanno ballando. Sembrano... Volerla seppellire viva sotto un mucchio di pucciosità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500105,
					"content": "A-Aiuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500106,
					"content": "Dammi la mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "Fiuu... Grazie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500108,
					"content": "Ma perché si stavano comportando in quel modo? Di solito non sono così piene di energie, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500109,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500110,
					"content": "Beh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500111,
					"content": "Ho deciso di giocare con le piccoline, e sembra che siano rimaste un po' troppo coinvolte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500112,
					"content": "Starti così vicino dopo aver giocato... Come dei cuccioli, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500113,
					"content": "Forse è il loro modo di esprimere gratitudine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "Mmmh... Solo che questa volta la loro gratitudine è sembrata più simile a rimanere intrappolati in un cumulo di neve inaspettato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500115,
					"content": "Dici così, ma Paimon è certa che non ti perderesti mai l'occasione di viziarle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500116,
					"content": "A ogni modo, vi piacerebbe fare un tentativo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500117,
					"content": "#Un tentativo... di rimanere {F#circondate}{M#circondati} così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "Mmmh... Sì, si può fare. Devi solo dare la risposta giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500121,
					"content": "Ah, certo. Sarà bello vedere che tipo di gioco le ha coinvolte così tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500122,
					"content": "Prego, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500123,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500119,
					"content": "Intendi... giocare con le Kuuhenki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500120
					]
				},
				{
					"id": 760500120,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "La Damigella"
				}
			]
