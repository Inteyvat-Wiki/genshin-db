						760500903
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500903,
					"content": "#Hihi, significa che siamo {F#state brave}{M#stati bravi}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500904,
					"content": "Sono davvero soffici e morbide.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500905
					]
				},
				{
					"id": 760500905,
					"content": "Aspetta, riceviamo una ricompensa anche se abbiamo sbagliato? Oh, beh... A Paimon non dispiace un premio di consolazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500906,
					"content": "Chi sono delle brave Kuuhenki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500907
					]
				},
				{
					"id": 760500907,
					"content": "Sembri piacere alle Kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500908
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500908,
					"content": "Lo sento... Sono a loro agio quando ci sei tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500909
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500909,
					"content": "Proprio come i cerbiatti dei Cervi Cornabrina sono predisposti a godersi il chiaro di luna, le Kuuhenki sembrano essere attirate da ciò che emana il tuo cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500910
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500910,
					"content": "Eh? E cosa sarebbe esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500911,
					"content": "Suppongo una certa gentilezza.",
					"roleType": "TALK_ROLE_NPC",
