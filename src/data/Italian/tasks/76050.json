			"dialogs": [
				{
					"id": 760500301,
					"content": "L'unica cosa che devi fare è indovinare l'immagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500302
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500302,
					"content": "Eh? M-Ma è troppo astratta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500303,
					"content": "Sei davvero riuscita a rispondere correttamente quando hai giocato, Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500304,
					"content": "No, ho sbagliato molto spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500305
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500305,
					"content": "#Beh, Paimon si arrende... Perché non provi a indovinare, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500306,
						760500310,
						760500315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500306,
					"content": "È... un Cervo Cornabrina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500307
					]
				},
				{
					"id": 760500307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500308
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500308,
					"content": "Wow, questa reazione vuol dire che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500309,
					"content": "Congratulazioni. Hai indovinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500310,
					"content": "È un... Rinoceronte dal collo lungo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500311
					]
				},
				{
					"id": 760500311,
					"content": "Accidenti! Se è un rinoceronte dal collo lungo, è uno con una ferita piuttosto grave al collo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500312,
					"content": "Non ho mai visto una creatura del genere prima d'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500313
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500313,
					"content": "La risposta corretta è \"Cervo Cornabrina\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500314
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500314,
					"content": "Ora tornate qui, piccoline.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760500315,
					"content": "È un arpione con un rebbio piegato all'indietro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500316
					]
				},
				{
					"id": 760500316,
					"content": "Certo che hai davvero una fervida immaginazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500317,
					"content": "Eheh... Una risposta davvero interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500318
					],
					"speakerTitle": "La Damigella"
				},
				{
