			"dialogs": [
				{
					"id": 738020101,
					"content": "#Ad astra abyssosque! Benvenut{F#a}{M#o} alla Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020102,
					"content": "Salve, Katheryne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738020103,
					"content": "Ciao, Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020104
					]
				},
				{
					"id": 738020104,
					"content": "#Salve. Avete entramb{F#e}{M#i} un aspetto fantastico oggi. Siete qui per prendere un incarico o per altri motivi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020105,
					"content": "Perché mi state fissando? Avete qualcosa di importante da chiedermi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020106,
						738020107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020106,
					"content": "No!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				},
				{
					"id": 738020108,
					"content": "#Capisco. Hai già l'aria di {F#un'}{M#un }avventurier{F#a}{M#e} espert{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020109,
					"content": "Puoi dirlo forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020110
					]
				},
				{
					"id": 738020110,
					"content": "Quindi dovresti avere familiarità con il modo di operare della Gilda degli avventurieri. Pertanto, non ti farò perdere troppo tempo scendendo nei dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020111,
					"content": "Se hai delle domande da fare alla Gilda, puoi rivolgerti a me in qualsiasi momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020112,
					"content": "Ti chiedo di dare una mano soprattutto con gli incarichi della Città di Sumeru. Gli avventurieri eccezionali come te saranno sicuramente di grande aiuto per la gente del posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738020113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020113,
					"content": "#Buon viaggio, viaggiat{F#rice}{M#ore}. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 738020107,
					"content": "V-Vogliamo solo svolgere qualche incarico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738020108
					]
				}
			]
		}
	]
