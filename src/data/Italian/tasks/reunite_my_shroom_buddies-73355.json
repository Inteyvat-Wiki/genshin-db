			"dialogs": [
				{
					"id": 733550201,
					"content": "Mmh? Sembra che non dovrò lasciare un messaggio alla Gilda degli avventurieri. Il fato ci farà sempre ricongiungere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550202,
					"content": "Finalmente ci rincontriamo, Cometa d'oro, Partner d'argento. Ne è passato di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550203,
					"content": "#Siete {F#entrambe}{M#entrambi} così {F#radiose e piene}{M#radiosi e pieni} di vita. È come se il tempo si fosse fermato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550204,
						733550208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550204,
					"content": "Da quanto tempo, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550205
					]
				},
				{
					"id": 733550205,
					"content": "Siete proprio voi, Haniyyah e Tamburino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550206,
					"content": "Ecco perché quel messaggio sembrava così familiare... Vuol dire che il legame tra Paimon e Tamburino è ancora molto forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Tamburino"
				},
				{
					"id": 733550212,
					"content": "Ho immaginato tanti modi diversi in cui avremmo potuto ritrovarci. Un grande banchetto, o una festa di bentornato creativa e ben organizzata, qualcosa che vi avrebbe davvero sorpreso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550213,
					"content": "Ma alla fine mi sono sembrati tutti un po' troppo formali. So che avete avuto molto da fare e temevo che rubarvi troppo tempo potesse crearvi dei problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550214,
					"content": "Inoltre, i nostri Micoamici preferiscono un ambiente calmo e pacifico. Quindi, riuniamoci in modo più rilassato e naturale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550215,
					"content": "Esatto! La prosa che Haniyyah ha letto ha finalmente dato i suoi frutti. Dopotutto, una mente calma è fondamentale per vivere felici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550216,
					"content": "In fin dei conti, una chiacchierata spensierata come questa è la gioia più grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550218
					],
					"speakerTitle": "Fuocallegro"
				},
				{
					"id": 733550218,
					"content": "C'è anche Souka! E Fuocallegro e... E questa chi è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550219,
					"content": "Lei è la mia Micoamica, Ventolina! Tu e Tamburino ci avete eliminate nel round trentadue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550220,
					"content": "Eheh, te lo ricordi bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550221,
						733550222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550221,
					"content": "Ora comincio a ricordare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550223,
					"content": "#Ad ogni modo, come potete vedere, {F#care}{M#cari} partecipanti, non dovremo più preoccuparci di organizzare il tempo o il luogo per il nostro prossimo incontro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550224,
					"content": "Io e Haniyyah abbiamo acquistato questo spazio commerciale e l'abbiamo trasformato nel Parco giochi dei Mini Miconoidi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550225,
					"content": "Aspetta, quindi stai dicendo che queste strutture non sono state affittate per il nuovo gioco da tavolo, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550226,
					"content": "Esatto. D'ora in poi, vivremo a Porto Bayda per promuovere il gioco da tavolo a tema Miconoidi e condividere le nostre teorie sulla comunicazione con gli animali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550227,
					"content": "#Sentitevi {F#libere}{M#liberi} di passare a giocare con i Micoamici ogni volta che avete tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550229,
						733550230
					],
					"speakerTitle": "Tamburino"
				},
				{
					"id": 733550229,
					"content": "Evviva! Micoamici!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550231,
					"content": "Oh, cielo! Questa è davvero una delle notizie più belle che Paimon abbia sentito oggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550232,
					"content": "Dopo il primo Torneo dei Miconoidi, Paimon ha avuto un sacco di idee per giocare insieme a Tamburino. Finalmente possiamo metterle in pratica tutte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550233,
					"content": "Peccato non aver preparato qualche dolcetto per i Micoamici... Sarebbe fantastico poterli coccolare davanti a una tavola piena di cibo delizioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550234,
					"content": "Non c'è bisogno di preoccuparsi. Nel processo di miglioramento delle comunità dei Miconoidi, ho condotto delle ricerche fondamentali sul cibo che piace ai Miconoidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550235
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550235,
					"content": "Il mio obiettivo è identificare ingredienti che possano essere mangiati sia dai Miconoidi che dagli umani, così che i nostri amici non debbano passare tutta la vita a nutrirsi di Gelatina meravigliosa di ogni gusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550236,
					"content": "Un giorno troverò gli ingredienti che soddisfino sia i gusti degli umani che quelli dei Miconoidi, e creerò dei piatti deliziosi che potremo gustarci tutti insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550237,
					"content": "E quando sarà il momento di passare dalla teoria alla pratica, io stessa sarò la cuoca! Sia mai che Haniyyah finisca per rovinare la nostra undicesima pentola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550238
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550238,
					"content": "Pare che il giorno in cui ci siederemo tutti in cerchio a condividere un pasto con i nostri Micoamici non sia così lontano, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550239,
						733550240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550239,
					"content": "Aspetteremo di avere notizie da te, Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550241,
					"content": "In tal caso, tornate a trovarci al Parco giochi dei Mini Miconoidi quando ne avrete l'occasione. Noi e tutti i nostri Micoamici saremo sempre qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550242,
					"content": "Chissà... La sorpresa potrebbe arrivare anche prima di quanto vi aspettiate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550243
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550243,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tamburino"
				},
				{
					"id": 733550240,
					"content": "Attendiamo con trepidazione il banchetto di Souka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550230,
					"content": "Ora potremo vederci in qualsiasi momento!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550222,
					"content": "L'atmosfera calda e accogliente mi sta aiutando a rilassarmi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550208,
					"content": "Anche se non ricordo bene... Salve a entrambi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550209
					]
				},
				{
					"id": 733550209,
					"content": "Ma sono proprio Haniyyah e Tamburino! Ci siamo conosciuti al Torneo Coppa Nilotpala dei Domatori di bestie. Siamo amici di lunga data!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550210,
					"content": "Paimon ricorda che ci siamo rivisti vicino a Porto Ormos e alla Corte di Fontaine. È passato così tanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Tamburino"
				}
			]
		}
	]
}