			"dialogs": [
				{
					"id": 733550101,
					"content": "Ehi, è appena passato un Miconoide. È normale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550102,
					"content": "Normalmente, avere dei Miconoidi che vagano per la città è piuttosto pericoloso, vero? A meno che non si tratti di quelli speciali che sono stati addestrati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550103,
					"content": "Ora che Paimon ci pensa... Perché sembra familiare? Non abbiamo già vissuto una cosa simile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550104,
						733550107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550104,
					"content": "Aspetta, ma quello è Tamburino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550105
					]
				},
				{
					"id": 733550105,
					"content": "Esatto! Tamburino! Il nostro Micoamico che abbiamo conosciuto a Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550106,
					"content": "Woooaah! È passato così tanto tempo dall'ultima volta che l'abbiamo visto! Dai, andiamo a salutarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550107,
					"content": "Cosa intendi con \"quelli speciali\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550108
					]
				},
				{
					"id": 733550108,
					"content": "Paimon pensa che sia... Tamburino? Il Micoamico che abbiamo conosciuto a Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550109,
					"content": "Woooaah! È passato così tanto tempo dall'ultima volta che l'abbiamo visto! Dai, andiamo a salutarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
