			"dialogs": [
				{
					"id": 401540101,
					"content": "Le attività nel negozio di pozioni continuano. Grazie al vostro duro lavoro, i guadagni superano di gran lunga le aspettative di vendita...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "#Perbacco, tesorini. Devo proprio ammetterlo: mai mi sarei aspettata che sareste {F#riuscite}{M#riusciti} a guadagnare così tanti Mora in un periodo tanto breve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540103,
					"content": "Avete il commercio nel sangue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540104,
					"content": "Dobbiamo ringraziare il tuo aiuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "#Eheh, {F#modesta}{M#modesto} come sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540106,
					"content": "Sinceramente, con un risultato così eccezionale, un po' di riconoscimento mi sembra più che dovuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540109,
					"content": "Se potessi restare qui ad aiutarmi per sempre, potrei quasi prendermi il doppio delle vacanze senza dovermi preoccupare di niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540110,
					"content": "Grazie ai vostri sforzi, abbiamo già raccolto dati di vendita più che sufficienti per la nostra ricerca. Vi sono profondamente grata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540111,
					"content": "Ovviamente, se voleste continuare a occuparvi del negozio, ne sarei contentissima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540112,
					"content": "A ogni modo, dovrei avere abbastanza elementi per fornire a Jean un rapporto esaustivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540113,
					"content": "#{NICKNAME}, Paimon, da quanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540114,
					"content": "Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401540115,
					"content": "Oh, sei qui! Avevo appena finito di parlare coi miei tesorini, stavo giustappunto venendo da te al quartier generale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540116,
					"content": "Non sarà necessario. Ho già parlato con alcuni cavalieri, credo di aver compreso a grandi linee la situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540117,
					"content": "#Hai di nuovo costretto {NICKNAME} ad aiutarti, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540118,
					"content": "Eheh, e come potevo non farlo? Quando ci sono compiti importanti in ballo, è sempre meglio affidarli a un partner sveglio e in gamba... Specie se si cercano buoni risultati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540119,
					"content": "Guarda, il negozio è un successone! Io non sarei mai riuscita a raggiungere un risultato del genere tutta da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540120,
					"content": "Beh, è innegabile che abbiate avuto un successo straordinario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540121,
					"content": "Era da un bel po' che volevo venire a trovarvi, ma ero oberata di lavoro e non sono riuscita a liberarmi prima... Ma ci tenevo davvero tanto a venire di persona a ringraziarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540122,
					"content": "Anche noi dobbiamo ringraziare voi per il supporto che ci avete dato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "È bello sapere di avere membri così straordinari tra i nostri ranghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540125,
					"content": "Eheh. Quando tutto questo sarà finito, credo di meritarmi una bella vacanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540126,
					"content": "Credo di aver perduto qualche capello di troppo a causa di tutto questo stress.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540127,
					"content": "Ma certo. Il tuo grande impegno è sempre apprezzato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540128,
					"content": "Sapendoti reclusa tutto il tempo in biblioteca, temevo che avresti finito per annoiarti. Così, avevo pensato di darti l'opportunità per sfruttare appieno i tuoi talenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540129,
					"content": "Col senno di poi, credo di aver calcato un po' troppo la mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540130,
					"content": "#Non è stato poi così male. Dopotutto, non ho dovuto farlo da sola: i Cavalieri e {NICKNAME} hanno contribuito a rendere il carico di lavoro molto più gestibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540131,
					"content": "In più, potermi dedicare di nuovo alla ricerca è stato divertente. È piacevole poter rivivere quel periodo della mia vita, di tanto in tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540132,
					"content": "Questo mi fa piacere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540133,
					"content": "#Grazie ancora per l'aiuto, {NICKNAME}. Tieni, per ricompensare il tuo impegno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540134,
					"content": "Oh, a proposito di compensazioni... Anch'io ti ho preparato una cosuccia. Ecco, spero ti piaccia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540123,
					"content": "È stato un lavoro di squadra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "Abbiamo fatto pratica un po' alla volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "Mh, una dimostrazione esemplare delle tue capacità di apprendimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				}
			]
		}
	]
}