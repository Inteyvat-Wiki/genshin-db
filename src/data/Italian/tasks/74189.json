					"nextDialogs": [
						741890425
					]
				},
				{
					"id": 741890425,
					"content": "Mi dispiace dovervelo dire, ma questa risposta è sbagliata. Volete provare di nuovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890426,
