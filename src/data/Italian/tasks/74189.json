			},
			"dialogs": [
				{
					"id": 741890501,
					"content": "Un momento, prego. Vuoi sapere un segreto che riguarda il tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890502,
					"content": "Che segreto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "Ha a che fare col tesoro e con la chiave necessaria ad aprire la porta. Che ve ne pare? Può interessarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890504,
					"content": "Non state per chiedermi di nuovo di sconfiggere mostri, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "Certo che no! Non ci sogneremmo di chiedere ai clienti della taverna di svolgere commissioni per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890507,
					"content": "Vedi l'artiglieria navale al mio fianco e i detriti contro verso cui è puntata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890508,
					"content": "Attivate il cannone e fate esplodere quelle rocce. Ogni tesoro che troverete sarà vostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890509,
					"content": "Chi corbezzoli è stato a dare il nome a quel canone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "È stato il timoniere. Non so nemmeno dove e come l'abbia ottenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890511,
					"content": "Dimmi, quali parti mancano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "Penso che ti abbiano dato delle informazioni inesatte. Il cannone è completamente intatto e a piena potenza. Me ne occupo ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890514,
					"content": "Ma prima che attiviate il cannone, vorrei che rispondeste ad alcune domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890515,
					"content": "È stato richiesto dal timoniere. L'ha chiamata una bella fonte di divertimento per gli ospiti della taverna, Qualcosa per rallentare le loro bevute e trattenerli qui più a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890516,
					"content": "Non saprei, ma chiedi pure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "Domanda 1: Quanti tavoli ci sono nel Timone arrugginito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890518,
					"content": "Domanda 2: Quanti dipendenti lavorano al Timone arrugginito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890519,
					"content": "Domanda 3: Cosa non viene servito al Timone arrugginito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890520,
					"content": "Tutto qui. Devi solo rispondere correttamente a queste tre domande per attivare il cannone, far esplodere i detriti e ottenere il tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890521,
					"content": "Cosa succederà dopo che avrò trovato il tesoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "Dopodiché troverò il momento perfetto per posizionare un altro premio nella grotta, e lo ricoprirò di sassi e detriti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890523,
					"content": "Il tesoro sta aspettando di essere trovato dalla prossima persona che attiverà l'artiglieria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890524,
					"content": "È un sacco di lavoro per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "Tutto qui. Ora puoi cercare le risposte. Nel frattempo resterò qui ad aspettarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890525,
					"content": "Un capo terribile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
					"content": "Difficile non concordare con ciò che hai detto, ma non ho ancora trovato un modo per puntare il cannone contro il timoniere senza che lui se ne accorga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890527
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890527,
					"content": "E poi se sparassi nella direzione sbagliata potrei fare del male agli altri ospiti della taverna, che è in conflitto con i miei principi morali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890528
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890512,
					"content": "Dimmi, come viene alimentato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890505,
					"content": "Non state per chiedermi di nuovo di trovare qualcuno o qualcosa, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				}
			]
		}
	]
}