					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890426,
					"content": "Riproviamo",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890409
					]
				},
				{
					"id": 741890427,
					"content": "Dobbiamo pensarci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890428
					]
				},
				{
					"id": 741890428,
					"content": "#Allora aspetterò le vostr risposte alle mie domande! Mi troverete qui quando sarete pront{F#e}{M#i}.",
