				"points": []
			},
			"dialogs": [
				{
					"id": 220400101,
					"content": "Se va avanti così, non resterà che chiudere l'attività...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400102,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "Ah, scusami. Ero assorta nei miei pensieri. Sei qui per acquistare dei capi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400104,
					"content": "Le sete più raffinate di Liyue non sono ancora disponibili, ma abbiamo comunque i kimono più recenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400105,
					"content": "Una volta importavate dei materiali da Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "Sì. Prima riuscivamo spesso ad assicurarci sete raffinate da Liyue, come quelle che la Gilda dei commercianti di Feiyun produce usando i Fiordiseta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400107,
					"content": "Ma vista la situazione attuale, è da un po' che non riusciamo a importare quel genere di seta. Abbiamo dovuto affidarci alle nostre scorte attuali per proseguire con l'attività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400108,
					"content": "Ogni rotolo di seta che usiamo è andato per sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400109,
					"content": "Io stessa volevo disegnare delle fantasie originali per i kimono, o usare delle nuove tinte per realizzare dei capi che attirassero i clienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400110,
					"content": "Ma non riesce a venirmi in mente nulla che si possa considerare come una fantasia \"nuova\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400111,
					"content": "#Viaggiat{F#rice}{M#ore}, sono certa che tu abbia visto molte cose, nel corso delle tue avventure. Ti sei mai imbattut{F#a}{M#o} in qualche fantasia che riterresti \"nuova\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400112,
					"content": "Non direi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "Ah, capisco. Uhm, potrebbe suonare un po' presuntuoso, da parte mia, ma... potresti aiutarmi a chiedere ad altri stranieri se conoscono delle fantasie che potremmo usare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400114,
					"content": "Al momento sono solo io a gestire Tessuti e kimono Ogura, quindi non posso lasciare il negozio. Se voglio raccogliere delle informazioni, posso solo chiedere ad altri di farlo al posto mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400115,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "Ottimo! Vediamo un po'... Potresti chiedere alla signora Tang Wen e al signor Ramsay. Magari loro hanno qualche idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
