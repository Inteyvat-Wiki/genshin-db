			},
			"dialogs": [
				{
					"id": 240091001,
					"content": "Grazie per l'aiuto! Dovrebbe essere abbastanza per riempirmi la pancia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091002,
					"content": "Ecco qui, te lo meriti. Meglio che mi sbrighi a mangiare qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091003,
					"content": "La prossima volta sarà meglio portarmi dei biscotti che possano essere conservati nella mia borsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
