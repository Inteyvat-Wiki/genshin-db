			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "#Viaggiat{F#rice}{M#ore}! Arrivi proprio al momento giusto! Ho appena trovato un posto fantastico per scattare foto. Tutto quello che mi serve è un po' di aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090102,
					"content": "Ancora alla ricerca d'ispirazione, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "Certo, mi serve ancora molto materiale. Una singola fotografia non mi basterà a creare un'immagine completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090104,
					"content": "Di solito mi servono dozzine di foto, a volte persino centinaia, da usare come materiale di riferimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090105,
					"content": "Così tante, uh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "Come ti ho già detto, il senso della pittura è la \"creazione\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090108,
					"content": "Se ci si limita a riportare sulla tela le cose che si vedono così come sono, non si tratta di \"pittura\", ma di \"fotografia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090109,
					"content": "Ciò che deve fare un pittore è usare la propria sensibilità e la propria capacità estetica per osservare il mondo che lo circonda, modellarlo, trasformarlo, rifinirlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090110,
					"content": "Fino a quando l'aspetto più bello di ogni singolo oggetto potrà essere reso astratto e poi impresso sulla tela per completare un dipinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090111,
					"content": "Non ho capito nulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "Ehm... Va bene, in parole povere, uso come riferimento solo le parti più belle di queste fotografie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090114,
					"content": "Ad esempio, il bilanciamento luce e ombre qui è eccellente, ma lo scenario è carente di contrasto. Come tale, farò uso solo del primo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090115,
					"content": "L'altra foto mostra un viaggiatore nella sua posa più affascinante, e quella successiva mostra un bellissimo edificio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090116,
					"content": "È quasi come giocare con un puzzle nella propria mente, con la bellezza o la bruttezza del prodotto finale che dipende solo dalla propria estetica e comprensione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090117,
					"content": "Questo non è un modo rigoroso di porre le cose, poiché possiamo anche modificare o astrarre ciò che vediamo all'interno del materiale di riferimento stesso... Ma questo è tutto ciò che serve per capire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090118,
					"content": "Quindi hai ancora bisogno del mio aiuto, chiedi e ringrazia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "Uh... Giusto, sì, proprio così! le tue abilità fotografiche sono incredibili. Pensa che i miei amici, dopo aver visto i tuoi capolavori, non vedevano l'ora di vederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090121,
					"content": "Sono sicuro che con il tuo aiuto sarò in grado di realizzare qualcosa di veramente incredibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090122,
					"content": "Quindi, ti prego, per il bene dell'estetica... e per i Mora che ho preparato per te, aiutami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090119,
					"content": "Quindi devo continuare a raccogliere materiale per te o qualcosa del genere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "Parla più chiaramente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "Ogni foto ha un utilizzo diverso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
			"completionStepIds": [
				2400902
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
