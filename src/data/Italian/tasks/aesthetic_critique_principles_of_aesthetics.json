				"points": []
			},
			"dialogs": [
				{
					"id": 240090601,
					"content": "Vediamo... I miei amici mi hanno dato alcuni suggerimenti, li ho annotati sul mio diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090602,
					"content": "Cosa ho scritto qui? Vediamo... Uh, sott'acqua... Rocce frastagliate... Piante sulle rocce... Bordi delle rocce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090603,
					"content": "Uh, sì, giusto. Effettivamente, stavo studiando le rocce in maniera ossessiva. Ritengo che abbiano un'incredibile abilità di esprimere la bellezza della natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090604,
					"content": "Comunque, vorrei che mi aiutassi a scattare una foto alle rocce sottomarine. Mi chiedo come possano essere i loro bordi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
