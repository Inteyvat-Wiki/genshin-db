				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "Manca di incisività... Che succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091102,
					"content": "Sento che manca qualcosa di... importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091103,
					"content": "Stai scattando delle foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "Esattamente, questa Fotokamera è la fonte d'ispirazione per i miei dipinti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091107,
					"content": "Mi chiamo Depierris, e sono un pittore, piacere di conoscerti, davvero un piacere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091108,
					"content": "Uh... Uh... Piacere mio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "Di solito offrirei un caffè a un nuovo amico, ma ahimè non ci sono caffetterie nelle vicinanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091110,
					"content": "#Mmm, beh... Perché non prendi questa Fonta? Facciamo un brindisi alla nostra amicizia! Sei già stat{F#a}{M#o} a Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091111,
					"content": "È la prima volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Ah, allora ti divertirai alla grande! Visita la città e goditi le sue particolarità, come le idrovie che passano in alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091113,
					"content": "Dopo puoi andare per le strade ad ammirare i macchinari, anche se non tutti rispettano un certo canone estetico, almeno secondo l'opinione di questo umile pittore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091114,
					"content": "E infine, potresti riposarti in una caffetteria e goderti una buona tazza di caffè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091115,
					"content": "E chi lo sa, qualcuno potrebbe pure venire a scambiare due chiacchiere con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091116,
					"content": "Tuttavia, se la persona che viene a parlarti dice di fare parte di un certo Club della Fotokamera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091117,
					"content": "Allora fa attenzione alle loro folli parole... D'altronde, alcuni di loro hanno qualche rotella fuori posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091118,
					"content": "Perché dici così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "E me lo chiedi pure? Stanno letteralmente portando alla rovina la vita culturale di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091122,
					"content": "Non si tratta di una semplice paura. Riesci a indovinare di cosa si parla in questo club?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091123,
					"content": "\"Se parliamo solo di immagini, quelle 'catturate' dalla Fotokamera sono nettamente superiori ai dipinti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091124,
					"content": "Cioè... Possono anche gridare a squarciagola che sia la verità, ma affermazioni del tipo \"se parliamo solo di immagini\" non sono altro che fandonie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091125,
					"content": "Se presentassimo le immagini così come sono, dove sarebbe poi lo spazio per l'estetica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091126,
					"content": "Beh, è vero che alcuni di noi stanno effettivamente scoprendo come creare dipinti di paesaggi naturalistici persino migliori... Ma anche questo è radicato nel proprio senso estetico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091127,
					"content": "L'estetica, l'estetica è la chiave! Capisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091128,
					"content": "N-Non proprio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "L'osservazione del mondo attraverso gli occhi di un artista è solo il primo passo. Per realizzare un'opera che viene dal cuore si devono esplorare la sensibilità e la bellezza attraverso il pennello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091131,
					"content": "Naturalmente, non tutti gli appassionati di Fotokamera sono degli idioti rozzi privi di senso estetico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091132,
					"content": "Ho molti amici appassionati di Fotokamere e adoro chiacchierare con loro. A volte, le loro fotografie mi portano ispirazione e i miei dipinti a loro volta ispirano loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091133,
					"content": "Ma quelli che non sanno nulla d'arte e sanno solo parlare a vanvera... Oh, quanto mi fanno innervosire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091134,
					"content": "Disonorano coloro che amano la fotografia e la pittura! Sono davvero... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091135,
					"content": "Calmati e bevi un sorso d'acqua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Ah, grazie... Non riesco a contenere la mia rabbia ogni volta che parlo di questa cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091137,
					"content": "Per questo motivo, io e alcuni amici abbiamo deciso di utilizzare questa Fotokamera per scattare delle foto che possano essere impiegate come materiale per creare una serie di dipinti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091138,
					"content": "In seguito esporremo le foto che abbiamo usato per realizzare i dipinti assieme a quest'ultimi, così tutti riconosceranno la differenza tra dipinti e fotografie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091139,
					"content": "Eppure, *sospira* non vedo alcun significato nelle varie foto che ho scattato. I miei amici mi dicono che i paesaggi migliori si possono trovare nelle terre più desolate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091140,
					"content": "Sott'acqua, ad esempio, o su di una rupe, o forse nei meandri di una fitta foresta in cui poche persone mettono piede... Ma non ho il coraggio di andare in posti del genere da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091141,
					"content": "E reclutare degli avventurieri richiederebbe troppo tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091142,
					"content": "#Mmm... Gentile {F#mademoiselle}{M#monsieur}, ti andrebbe di lavorare per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091143,
					"content": "Fintanto che non mi chiedi di dipingere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "Non preoccuparti! Entrambi ci occuperemo solo di quello che ci riesce meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091146,
					"content": "Non devi preoccuparti nemmeno del pagamento. Assumo spesso avventurieri come guardie nei miei viaggi di ricerca dell'ispirazione, quindi conosco le regole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091147,
					"content": "È solo che questa faccenda era piuttosto urgente, e non sono riuscito a trovare nessuno per tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091148,
					"content": "Bene, allora è deciso. Con il tuo aiuto, avrò sempre più fiducia nelle mie capacità di realizzare opere di qualità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091144,
					"content": "Me la cavo solo nelle faccende degli avventurieri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "Più o meno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "E questa gente... mi farà qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "Proprio come hanno fatto con Fontaine, distruggeranno la vita culturale che avresti dovuto condividere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091105,
					"content": "Sei appassionato di Fotokamere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "Se la Fotokamera è un hobby? No, no, non è altro che un oggetto di riferimento. Sono di gran lunga più affezionato al mio pennello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				}
			]
		},
