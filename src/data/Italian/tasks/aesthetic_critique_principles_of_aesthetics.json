			"dialogs": [
				{
					"id": 240090401,
					"content": "Vediamo... I miei amici mi hanno dato alcuni suggerimenti, li ho annotati sul mio diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090402,
					"content": "\"Le grandiose rovine sottomarine!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090403,
					"content": "Davvero? Ho scritto quelle parole con tanta veemenza che ho quasi bucato il foglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090404,
					"content": "Ma credo che un posto del genere possa mostrare una bellezza particolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090405,
					"content": "Beh, in tal caso, aiutami a scattare una foto di queste rovine. Più grandi sono e più sono in rovina e meglio è!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
