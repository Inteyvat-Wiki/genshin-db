			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "Vediamo... I miei amici mi hanno dato alcuni suggerimenti, li ho annotati sul mio diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090202,
					"content": "Piante acquatiche... che ondeggiano... Luci e ombre... che cambiano... Cosa stavo scrivendo? Forse avevo bevuto troppo? Sì, probabilmente è così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090203,
					"content": "Ehm, per favore, aiutami a scattare una foto alle piante acquatiche sott'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090204,
					"content": "Sembra che fossi piuttosto interessato alle luci e alle ombre sulle piante acquatiche quando ho scritto quegli appunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
