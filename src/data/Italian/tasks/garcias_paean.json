					"nextDialogs": [
						710980711
					]
				},
				{
					"id": 710980711,
					"content": "Mmh, andiamo a chiederglielo. Forse stanno studiando un nuovo tipo di piatto... Magari uno che possiamo assaggiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
