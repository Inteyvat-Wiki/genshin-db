					"nextDialogs": [
						710980919
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980919,
					"content": "*tossisce* Va bene... Passaggio due: feedback.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980920
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980920,
					"content": "Io dico che alla formula manca un parametro o un altro, oppure i nostri calcoli sono ancora imprecisi... Devo modificare l'algoritmo della macchina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980921
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980921,
					"content": "Lutong, hai registrato i dati di questa sessione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980922
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980922,
					"content": "Tutti registrati, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980923
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980923,
					"content": "Eccellente, allora siamo un passo più vicini al successo. In questo caso, avanti con il passaggio numero tre: chiedere a un cuoco di fare un'altra dimostrazione della procedura di preparazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980924,
						710980926
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980924,
					"content": "Scusate, perché mi state guardando tutti quanti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980925
					]
				},
				{
					"id": 710980925,
					"content": "#Temo che tu sia l'unica persona su cui possiamo contare per preparare la zuppa vegetariana di ravanelli, viaggiat{F#rice}{M#ore}. Il signor Yanxiao ha... diciamo che è da un po' che ci ignora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980926,
					"content": "Sai che Yanxiao è proprio laggiù, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980927
					]
				},
				{
					"id": 710980927,
					"content": "Credo che lasciarci usare la sua cucina sia stato il massimo che potesse concederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980928
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980928,
					"content": "#Temo che tu sia l'unica persona su cui possiamo contare per preparare la zuppa vegetariana di ravanelli, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980916,
