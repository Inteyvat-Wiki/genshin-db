			},
			"dialogs": [
				{
					"id": 710980901,
					"content": "Lutong, stavolta iniziamo col 10% in meno di ciascun ingrediente... Bene. Passaggio uno: iniziare a cucinare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980902
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980902,
					"content": "Sì, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980903
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980903,
					"content": "Prima l'acqua... Ah! Attenzione alla velocità con cui la si versa. È molto importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980904,
					"content": "Poi aggiungiamo gli ingredienti. Prima i ravanelli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980905
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980905,
					"content": "Uh... Sembra più un esperimento che l'esecuzione di una ricetta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980906,
					"content": "Dite che i piatti preparati così saranno comunque buoni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980907,
					"content": "Ed ecco qui, la zuppa vegetariana di ravanelli è pronta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980908
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980908,
					"content": "La preparazione si è svolta senza problemi, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980909,
					"content": "#Già, assaggiamo ora, viaggiat{F#rice}{M#ore}. Potete anche fare il bis, se volete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980910
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980910,
					"content": "Evviva, rimpinziamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980911,
					"content": "Grazie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980912
					]
				},
				{
					"id": 710980912,
					"content": "Oh... Sa di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980913,
					"content": "Signore, ho il sospetto che questi ravanelli andassero cucinati un po' più a lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980914
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980914,
					"content": "*tossisce* Argh... Com'è possibile che la menta sia diventata così? Sono certo di aver calcolato il suo tempo di cottura ottimale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980915,
						710980916
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980915,
					"content": "Immagino che non dovrò berla, allora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980917
					]
				},
				{
					"id": 710980917,
					"content": "*tossisce* Il sapore di questa zuppa è... peggiore rispetto a quello dei tentativi precedenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980918
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980918,
					"content": "Io... *tossisce* concordo in pieno, signore.",
