			},
			"dialogs": [
				{
					"id": 710981501,
					"content": "Questo sapore è davvero molto buono, ma devo dire che è completamente diverso da quello della zuppa vegetariana di ravanelli preparata dal signor Yanxiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981502,
					"content": "Scusa la mia curiosità, ma come... come hai preparato questo piatto? Quali erano le quantità esatte degli ingredienti? Che condimenti hai usato e come?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981503,
					"content": "E-Ehi! Allontanati, dai!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "Ah, sì... le mie scuse. Tuttavia, mi piacerebbe sapere come hai preparato quel piatto. Nel dettaglio, per favore, non si sa mai come potrebbe venire l'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981506,
					"content": "Spieghi nel dettaglio come hai preparato la zuppa vegetariana di ravanelli.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981508,
					"content": "*sospira* Ah, ci sono davvero troppe variabili per decidere il sapore di ogni singolo piatto. Servono molti conteggi per perfezionare i nostri calcoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981509,
					"content": "Ma dovrò migliorare la mia macchina numeratrice per consentire un maggior numero di calcoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981510,
					"content": "Posso solo sperare di trovare un po' di ispirazione nella biblioteca dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981511,
					"content": "Comunque, perché vuoi creare una macchina del genere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "Mmh... Ottima domanda. Ma prima di rispondere, permettimi di porne una a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981513,
					"content": "Credi che la macchina numeratrice possieda il dono della ragione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981514,
					"content": "Cosa intendi dire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "Esatto. Rifletti prima su questa domanda, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981517,
					"content": "Possiamo discuterne la prossima volta che ci incontreremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981518,
					"content": "Ora devo organizzare dei dati... Vieni, Lutong, iniziamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981519
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981519,
					"content": "Sì, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981520
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981520,
					"content": "#Ah sì. Ecco, prendi, viaggiat{F#rice}{M#ore}. Non arrabbiarti col signor Garcia, è fatto così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981521
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981521,
					"content": "Andate a Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981522
					]
				},
				{
					"id": 710981522,
					"content": "Già. Il signor Garcia desidera documentarsi su delle risorse all'Akademiya e io sono stato assunto per andare con lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981523
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981523,
					"content": "#Ci vediamo, viaggiat{F#rice}{M#ore}. Sarebbe magnifico se potessimo ricontrarci a Sumeru... e penso che farebbe piacere anche al signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981515,
					"content": "Se la tua macchina abbia la... ragione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981504,
					"content": "Uhm, mi farebbe piacere se ti allontanassi dalla mia faccia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				}
			]
		}
	]
}