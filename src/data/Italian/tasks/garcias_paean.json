	"talks": [
		{
			"id": 7109801,
			"completionStepIds": [
				7109803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109803",
							"2"
						],
						"stepId": 7109803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "Signore, credo valga la pena di ricordare che, se consideriamo anche la giornata di oggi, abbiamo mangiato zuppa vegetariana di ravanelli per sei giorni interi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980102,
					"content": "Nonostante le nostre gravi difficoltà finanziarie, credo che la nostra situazione gastrointestinale non possa essere ignorata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980103,
					"content": "E hai ragione, mio caro Lutong. Acuto come sempre, se devo dirla tutta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980104,
					"content": "Forse è a causa di questi problemi gastrointestinali che non siamo riusciti ad accertare il sapore di questo piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980105,
					"content": "Abbiamo bisogno di un testimone, Lutong! Dobbiamo trovare un'altra persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980106,
					"content": "Mi lusinghi, signore, ma credo che quello che volevo dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980107,
					"content": "Scusate, cosa state facendo voi due?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "Ah! Ed ecco il nostro testimone... anzi, più di uno! Meraviglioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980110,
					"content": "E-Eh? Quali testimoni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980111,
					"content": "Parli di noi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "Ma certo! Di grazia, avete mai assaggiato la zuppa vegetariana di ravanelli? Conoscete il suo sapore e la sua preparazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980113,
					"content": "Signore, credo che dovremmo almeno informarli del perché e del percome di questa situazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980114,
					"content": "#Oh, ma certo che lo sappiamo, molto bene! {NICKNAME} sa anche come si prepara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980115,
					"content": "Paimon, dovremmo prima capire di cosa si tratta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "Bene, sì, permettetemi di spiegare questo incarico. Spero che sarete d'accordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980117,
					"content": "Io sono Lutong, e lui è Garcia, il mio capo, che viene da Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980118,
					"content": "Al momento il signor Garcia sta sviluppando una... mi pare la chiami macchina numeratrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980119,
					"content": "Nello specifico, è uno strumento che consente di realizzare diversi calcoli. Giusto, signore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980120,
					"content": "Più precisi di così si muore, mio caro Lutong. Le funzioni della macchina numeratrice sono proprio queste. Una risposta davvero chiara e concisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980121,
					"content": "Già, chiarezza... Dobbiamo essere chiari. Quel modificatore è davvero troppo complesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980122,
					"content": "Aspettate. Ma cosa c'entra questo con la zuppa vegetariana di ravanelli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980123,
					"content": "Ah. Penso sia meglio che rispondiate voi a questa domanda, signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980124,
					"content": "Ma come posso renderlo più semplice... Oh! Già, sì. Lasciate che vi spieghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980125,
					"content": "Mmh... Cominciamo dalle cose più elementari. Conoscete le formule?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980126,
					"content": "Mh... Non proprio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980127,
					"content": "Nemmeno io so precisamente a cosa ti riferisci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "Bene, va bene. Le formule possono essere considerate... Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980129,
					"content": "Un'equazione usata per esprimere la relazione fra varie quantità, e che possiede una certa applicabilità generale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980130,
					"content": "Eh? Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980131,
					"content": "Sembra notevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "In poche parole, vogliamo usare la macchina numeratrice per provare a scrivere una formula per la ricetta della zuppa vegetariana di ravanelli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980133,
					"content": "Il signor Garcia crede che, se ottenessimo la formula giusta, potremmo convertire il metodo di preparazione della zuppa vegetariana di ravanelli in...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980134,
					"content": "...Una specie di procedura generale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980135,
					"content": "Una procedura a prova di stupido, se volete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980136,
					"content": "Se si segue la procedura, chiunque può preparare una deliziosa zuppa vegetariana di ravanelli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980137,
					"content": "Sembra una buona idea... Ma non potevi chiedere direttamente a qualcuno di insegnarti a preparare il piatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980138,
					"content": "Sfortunatamente, un tale metodo si basa troppo sul talento naturale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980139,
					"content": "Per persone come me e il signor Garcia, prive di qualsiasi predisposizione culinaria, è improbabile che si riesca a cogliere l'essenza di qualsiasi lezione che uno chef, per quanto paziente, possa impartirci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980140,
					"content": "In effetti, credo che il signor Yanxiao di questa locanda lo abbia sperimentato in prima persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980141,
					"content": "Quindi vi serve il nostro aiuto per calcolare questa formula?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "No, certo che no. Non vi disturberei mai eccessivamente in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980145,
					"content": "Per la precisione, vorremmo che faceste da terza parte neutrale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980146,
					"content": "In poche parole, dovrete assaggiare la zuppa vegetariana di ravanelli preparata dal signor Garcia secondo la formula e commentarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980147,
					"content": "Quiiindi, siamo qui per fare da assaggiatori di un buon piatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980148,
					"content": "Detto così sembra un po' riduttivo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "Oh, andrà bene! Comunque, Paimon non ha mai mangiato una zuppa vegetariana di ravanelli preparata secondo una formula! Proviamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980150,
					"content": "Allora è deciso. In tal caso, spostiamoci in cucina. Il signor Yanxiao ci ha gentilmente concesso di usarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980151,
					"content": "Signor Garcia, allora, per questo esperimento procediamo come prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980152,
					"content": "Mmh? Oh! Certo, chiedo scusa. Mi ero distratto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980153,
					"content": "Ci sono troppi parametri che mi frullano in testa, sapete... Ma sì, continuiamo con la nostra procedura in tre fasi adottata precedentemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980143,
					"content": "Quindi volete che vi insegniamo a cucinare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "Mmh, non direi nemmeno quello, no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980108,
					"content": "Se cercate una formula per la zuppa vegetariana di ravanelli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				}
			]
		},
		{
			"id": 7109803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109804",
							"3"
						],
						"stepId": 7109804,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980301,
					"content": "Non capisco. Come fa la gente a non riuscire a preparare una zuppa vegetariana di ravanelli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980302
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 710980302,
					"content": "Inoltre, come faccio a sapere la quantità esatta di... beh, di qualsiasi cosa io metta nei piatti quando li preparo, eh?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980303
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 710980303,
					"content": "Non basta metterne quanto si vuole e vedere come va? Sul serio, nessun cuoco si preoccupa di queste cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980304
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 710980304,
					"content": "Se non fosse stato per i Mora che hanno sborsato, avrei portato le mie lamentele al capo molto tempo fa...",
