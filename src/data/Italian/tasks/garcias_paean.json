					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980706
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980706,
					"content": "Sì, la zuppa vegetariana di ravanelli è stata ordinata, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980707
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980707,
					"content": "Magnifico. Che premura, caro Lutong. Sono sicuro che questa volta avremo la nostra formula di preparazione.",
