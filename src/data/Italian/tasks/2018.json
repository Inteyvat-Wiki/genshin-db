			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara",
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "Lady Guuji. Eccomi, come promesso. Sono venuta da sola e non ho parlato a nessuno di questo incontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180202,
					"content": "Sapevo che avresti mantenuto la promessa... Immagino che tu non abbia mai smesso di pensarci, negli ultimi giorni. Sei riuscita a dormire almeno un po'?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180203,
					"content": "I-Io... Ti sbagli. Non dubiterei mai dei leader del mio clan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180204,
					"content": "Dunque. Dove sono le prove?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180205,
					"content": "Eccole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "Ah, fantastico. Oggi è la giornata delle promesse mantenute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180207,
					"content": "Non crederesti mai a cosa abbiamo dovuto passare per procurarci questa roba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180208,
					"content": "Date tutto a Sara, così potrà vedere lei stessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180209,
					"content": "Di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180210,
					"content": "Questo documento... ha il timbro ufficiale del capo del clan Kujou. E non sembra un falso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180211,
					"content": "Non capisco... Neanche una parola sulla resistenza, su Sangonomiya o sulla situazione al fronte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180212,
					"content": "Nemmeno sui soldati che hanno perso la vita al fronte o sulle difficoltà affrontate dai cittadini... Non meritano forse di essere menzionati?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180213,
					"content": "Un totale disprezzo per la vita umana. Perché nascondere la verità in questo modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180214,
					"content": "Per supportare il Decreto di caccia alle Visioni, ovviamente. Non pensi che la Shogun metterebbe in discussione la sua politica, se fosse a conoscenza dei problemi che hai appena menzionato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180215,
					"content": "Quindi la Commissione Tenryou... sta deliberatamente ingannando la Shogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180216,
					"content": "Sì. E... chi altro potrebbe trarre beneficio dal Decreto di caccia alle Visioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180217,
					"content": "C'è anche una lettera confidenziale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "Una lettera da parte della Commissione Tenryou, è indirizzata ai Fatui. Il leader del clan Kujou ha tenuto nascosto anche questo alla Shogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180220,
					"content": "Ebbene? Ti trovi davanti alle risposte che cercavi, ma che speravi di non trovare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180221,
					"content": "Di certo... non farai finta di niente, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180222,
					"content": "Quindi, tutto ciò in cui credevo è... è tutto... Come hanno potuto... Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180223,
					"content": "Non posso perdonare il loro tradimento... Takayuki, mi devi delle spiegazioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180224,
					"content": "Kujou Sara sembra fuori di sé, eh? Sembra che la ribellione nella Commissione Tenryou sia iniziata, come speravamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180225,
					"content": "L'esercito della Shogun non ha un leader, al momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "Già, già. Raggiungiamola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180228,
					"content": "#Un attimo, viaggiat{F#rice}{M#ore}. Dobbiamo discutere di un'altra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180229,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180230,
					"content": "#L'ultima volta che sei entrat{F#a}{M#o} nel Piano dell'eutimia, eri di fronte alla Statua della divinità onnipresente, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180231,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "Bisogna ricreare le stesse circostanze di quel giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180233,
					"content": "Se fai in modo che la Shogun Raiden ti \"apra il suo cuore\" di nuovo davanti alla Statua della divinità onnipresente, forse si ripresenterà l'opportunità necessaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180234,
					"content": "Farò del mio meglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "Tieni, ho un dono d'addio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180236,
					"content": "Cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180237,
					"content": "Gli omamori del Gran Santuario di Narukami sono molto potenti. Ne ho messo uno da parte per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180238,
					"content": "Grazie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "Eheh, se dovessi trovarti alle strette, prendilo e vedi cosa succede. Forse le tue preghiere troveranno risposta e i tuoi problemi si risolveranno in un batter d'occhio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180241,
					"content": "E se ti capita di pensare a me durante il tuo viaggio, estrailo. Chissà, potrei addirittura comparire di fronte a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180242,
					"content": "#Dacci un taglio, volpina. Non è né il momento né il luogo adatto per prendere il giro {F#la}{M#il} viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180243,
					"content": "Eheheh... Chiedo scusa. Bene allora... Andate ad affrontare la mia sciocca amica. Conto su di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180239,
					"content": "Ne farò tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "Se la seguiamo, forse riusciremo a incontrare la Shogun Raiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
			"id": 201803,
			"completionStepIds": [
				201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201805",
							"2"
						],
						"stepId": 201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "Mi avete seguita fin qui? Avete fegato, devo ammetterlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180302,
					"content": "Visto che siete testimoni, potrei impedire il vostro arresto, almeno finché Takayuki non mi avrà dato delle spiegazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180303,
					"content": "#Ma... se scopro che mi avete raggirata, non solo sarete arrestat{F#e}{M#i}, ma anche accusat{F#e}{M#i} di un altro crimine. Sono stata chiara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180304,
					"content": "Chiara come il sole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "Umpf. Bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180305,
					"content": "Facci strada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Takayuki",
					"Kujou Sara",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "Basta così! Sara, sei uscita di senno?! Come osi disobbedire ai miei ordini?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180404,
					"content": "M-Maestro, io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180405,
					"content": "Forza, chiediglielo! Non farti intimidire da lui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180406,
					"content": "Maestro Takayuki... Ho letto il rapporto per il trono e la lettera ai Fatui... Ho bisogno di una spiegazione, per favore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180407,
					"content": "Dunque è per questo che i miei documenti sono scomparsi dal quartier generale? Li hai rubati tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180408,
					"content": "Quindi mi sta dicendo che... quei documenti non erano falsi? È stato davvero lei a scriverli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180409,
					"content": "Per favore, maestro, devo sapere... La Commissione Tenryou ha davvero... tradito lo Shogunato?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180410,
					"content": "Umpf... Sì, ho fatto un patto con i Fatui. E sì, il rapporto che hai letto è stato scritto da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180411,
					"content": "Ah, l'ha ammesso senza problemi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180412,
					"content": "I diplomatici di Snezhnaya hanno promesso una ricompensa molto generosa... In cambio, vogliono solo che io appoggi il Decreto di caccia alle Visioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180413,
					"content": "Da tempo, il clan Kujou è in una posizione molto ambita. Sono tanti i clan che sarebbero disposti a distruggerci alla prima occasione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180414,
					"content": "Così, quando mi è stata data l'opportunità di ricevere la protezione di una potente nazione e di reprimere i nostri nemici al tempo stesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180415,
					"content": "Mi è parsa un'offerta da cogliere al volo. E non ho sentito il bisogno d'informarti, Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180416,
					"content": "Ma lei... venera la Shogun. Come ha potuto tradirla dopo tutto questo tempo e comportarsi come se niente fosse?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180417,
					"content": "Tradirla? Per te questo sarebbe un tradimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180418,
					"content": "I Fatui pensano di avermi alla loro mercé, ma è l'esatto contrario. Cosa sperano di ottenere da tutto questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180419,
					"content": "Quando il fulmine colpirà Inazuma, si inginocchieranno tremando, paralizzati dalla paura e dal timore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180420,
					"content": "Dopotutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180421,
					"content": "Nessuno può competere con il potere supremo dell'onnipotente Shogun Raiden e della Musou no Hitotachi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180422,
					"content": "Non voleva tradire la Shogun Raiden...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "Già... Lui non venera la Shogun Raiden, ma il suo potere di guerriera, soprattutto la Musou no Hitotachi. E in maniera quasi eccessiva, direi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180425,
					"content": "Ma maestro... Che n'è della sua fedeltà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180426,
					"content": "Fin da quando sono stata adottata dal clan Kujou, lei mi ha insegnato l'importanza della fedeltà nei confronti di un superiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180427,
					"content": "Ma adesso capisco che voleva solo che fossi fedele al clan Kujou. Temeva solo che un giorno l'avrei tradita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180428,
					"content": "Lei è solo un ipocrita! Parla di virtù solo per mascherare il suo squallido egoismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180429,
					"content": "Il mio egoismo? Sto soltanto salvaguardando l'eternità del clan Kujou. Sono sicuro che la Grande Shogun capirebbe, e anche il nostro ex leader.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180430,
					"content": "Odio doverlo dire, ma il problema è il suo ego. Secondo Paimon, riceverà una grande delusione se crede che il clan Kujou possa competere con i Fatui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180431,
					"content": "Discutere con lui non serve a nulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "In passato, ho dubitato del Decreto di caccia alle Visioni. Mi chiedevo se fosse davvero giusto. Anche se, nel mio cuore, sapevo che non lo era.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180434,
					"content": "Ma ho deciso di seguire la Shogun. Fino a quando sarà lei a guidarci, come possiamo essere noi a decidere ciò che è giusto o sbagliato, se non abbiamo ancora neanche raggiunto la fine del percorso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180435,
					"content": "Ma adesso capisco che la strada verso l'eternità non ha una fine, mentre questa strada... da ormai troppo tempo è stata contaminata dal suo egoismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180436,
					"content": "Quindi ora andrò dalla Shogun a raccontarle tutta la verità. Almeno avrò la coscienza pulita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180437,
					"content": "Sei testarda e superficiale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180438,
					"content": "Riferisci tutto alla Shogun, se proprio vuoi. Ormai la posizione del clan Kujou è ben salda, e nulla di ciò che farai potrà cambiare le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180439,
					"content": "La Shogun è al <color=#00E1FFFF>Tenshukaku</color> a ricevere una diplomatica di Snezhnaya, la Messaggera di nome Signora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180440,
					"content": "Signora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "C'è Signora dietro a tutta questa storia? Ugh, non di nuovo lei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180442,
					"content": "A Ritou, la signorina Hiiragi aveva detto qualcosa su alcuni incontri avvenuti tra il commissario Kanjou e una donna che parlava in maniera arrogante... Dovevamo aspettarcelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180443,
					"content": "Una diplomatica di Snezhnaya? Va bene! Se pensa che potrà andarsene da Inazuma tutta intera, si sbaglia di grosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180444,
					"content": "Sara se n'è andata via infuriata... Pensi che voglia irrompere al Tenshukaku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180445,
					"content": "Comunque, noi abbiamo un conto in sospeso con Signora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "Puoi dirlo forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180447,
					"content": "Forza, allora! Muoviamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180448,
					"content": "Andiamo al <color=#00E1FFFF>Tenshukaku</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180432,
					"content": "Vediamo cosa pensa Kujou Sara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "È solo troppo sicuro del potere che lei possiede.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
