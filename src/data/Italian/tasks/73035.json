			"dialogs": [
				{
					"id": 730350401,
					"content": "Il cuore dell'albero di Ashvattha sta splendendo... Che sia il Bija?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350402,
					"content": "Non è stato semplice, ma Rana potrà finalmente guarire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350403,
