				"points": []
			},
			"dialogs": [
				{
					"id": 730350901,
					"content": "Ci siamo, finalmente! Mmh. Paimon ricorda di aver visto quest'albero misterioso in altri sogni degli alberi di Vasara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350902,
					"content": "#Nara {NICKNAME} e Paimon, perdonatemi. Non mi ero reso conto che Marana avesse corrotto anche il sogno dell'albero di Ashvattha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350903
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350903,
					"content": "Innumerevoli parassiti neri stanno corrodendo le radici dell'Albero dei sogni del Sarva. Credo sia opera di Marana, che sta scuotendo le fondamenta del sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350904
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350904,
					"content": "Perdonatemi... Avrei dovuto immaginarlo quando abbiamo visto Marana nell'Antro di Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350905
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350905,
					"content": "#Non c'è problema! Prima, {NICKNAME} ha risolto la faccenda senza problemi, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350906,
						730350907,
						730350909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350906,
					"content": "Allora, il Bija...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350912
					]
				},
				{
					"id": 730350912,
					"content": "#Come minimo, i frutti di Vasoma dovrebbero restituirgli un po' del suo potere. Conto su di te, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350913
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350914
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350914,
					"content": "Sì, capisco. Non pensavo che sarebbe accaduto così presto, ma quando arriverà il momento saprò cosa fare. Me lo sento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350915
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350915,
					"content": "Come nuvole sanno di dover rilasciare pioggia, pioggia sa di dover cadere su terreno e semi sanno di dover crescere e diventare grandi alberi che producono tanti frutti polposi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350916
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350916,
					"content": "Arama ha qualcosa di strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350917,
					"content": "Oh, stavo parlando con l'Albero dei sogni. Non riuscite a sentirlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350918
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350918,
					"content": "Paimon ha visto Aranakin parlare con dei funghi, prima... Ma, di solito, le persone non riescono a parlare con le piante, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350919,
					"content": "Capisco! Non lo sapevo. Grazie, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350920
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350920,
					"content": "#Nara {NICKNAME}, Paimon, non preoccupatevi del Bija. Andiamo via da questo sogno per adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350907,
					"content": "Un gioco da ragazzi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350908
					]
				},
				{
					"id": 730350908,
					"content": "Ma... Ciò che accade qui ha degli effetti sul Bija, per caso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350909,
					"content": "Beh, non è stato poi tanto facile quanto Paimon voleva farlo sembrare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350910
					]
				},
				{
					"id": 730350910,
					"content": "Ma ce l'hai fatta lo stesso, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350911,
