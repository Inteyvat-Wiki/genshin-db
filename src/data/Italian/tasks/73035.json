			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350201,
					"content": "#Ottimo, questo luogo non è stato corroso da Marana come Arayama e gli altri! Nara {NICKNAME}, Paimon, questo è l'albero di Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350202
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350202,
					"content": "Accidenti, com'è bizzarro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350203,
					"content": "Paimon, non essere maleducata, o farai arrabbiare l'albero di Ashvattha! È un albero potentissimo, ed è il più antico albero di Vasara esistente. È persino più antico degli Aranara e dei loro racconti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350204
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350604,
					"content": "Migliaia di lune fa, se non di più, qui cantò la Signora della flora. All'epoca aveva lasciato Valuka, e la foresta non era rigogliosa come adesso, quindi il terreno era ancora molto sabbioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350605
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350205,
					"content": "Poiché la sua canzone era quella più simile al Cantosorgente, la sua Ararakalari era la più potente di tutti. Quindi Ashvattha rispose alla chiamata e spuntò dal Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350206
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350606,
					"content": "Lei disse ad Ashvattha che nella foresta c'erano tantissimi Nara intelligenti e bellissimi, ma che erano ancora soli. Dunque dovevano nascere più Figli della foresta per fare amicizia coi Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350607
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350207,
					"content": "Fu così che Ashvattha creò un melograno meraviglioso e ricco di semi, da cui Aramuhukunda germogliò per primo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350208
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350208,
					"content": "Aramuhukunda fu il primissimo Aranara. Col passare del tempo, tutti i semi germogliarono e gli Aranara si diffusero come foglie di un albero. Insieme ai Nara, facciamo parte del popolo della foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350209
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350609,
					"content": "È per questo motivo che l'albero di Ashvattha è il più potente e importante di tutti! Come le donne Nara portano i figli in grembo, ogni Aranara discende da Ashvattha e dall'Archon di Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350610
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350210,
					"content": "Allora è così che stanno le cose... Scusa, Arama. L'albero di Ashvattha è davvero straordinario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350211,
						730350213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350211,
					"content": "Che maleducata, Paimon! Come puoi chiamare la madre di qualcuno \"bizzarra\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350212
					]
				},
				{
					"id": 730350213,
					"content": "A proposito del Bija...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350214
					]
				},
				{
					"id": 730350212,
					"content": "Non era quella l'intenzione di Paimon! Comunque sia, cosa dobbiamo fare ora per ottenere il Bija?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350214,
					"content": "Giusto. Come gli alberi e la terra hanno bisogno dell'acqua per prosperare, così un albero di Vasara ha bisogno di sogni e ricordi per vivere. Come dicevo poco fa, l'albero di Ashvattha è il più antico degli alberi di Vasara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350215
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350215,
					"content": "Per questo abbiamo portato tre frutti di Vasoma da parte di Araji, Arayama, e Aramaha come offerte per l'albero di Ashvattha, affinché esso fruttifichi in abbondanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350216
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350216,
					"content": "I frutti di Vasoma di Araji, Arayama e Aramaha? Parli dei frutti dell'albero di Vasara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350217,
					"content": "Sì, è esattamente ciò che sono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350218
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350218,
					"content": "#Avvicinati all'albero di Ashvattha, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350219
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350219,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350220,
						730350221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350220,
					"content": "È incredibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350221,
					"content": "Fa un po' paura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350222,
					"content": "Sì, tutti gli Aranara discendono da questo albero. Ora hai una connessione con tutti gli Aranara, che ti hanno donato la loro benedizione. Dunque, anche l'albero di Ashvattha ti benedirà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350223
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350223,
					"content": "#Finché indosserai questa ghirlanda, l'albero di Ashvattha ti riconoscerà come Figli{F#a}{M#o} della foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350224
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350224,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350225
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350225,
					"content": "C'è qualcosa che non va nell'albero di Ashvattha. Sembra debole... Dev'essere colpa del Marana, ultimamente compare ovunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350226
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350226,
					"content": "A ogni modo, entreremo nel sogno dell'albero di Ashvattha, e offriremo i frutti di Vasoma all'Albero dei sogni per rinvigorirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350227
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350227,
					"content": "#Quindi dobbiamo fare la stessa cosa che abbiamo fatto negli Antri di Ashvattha, vero? {NICKNAME} allunga la mano e \"wuush\", entriamo nel sogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350228,
					"content": "#Sì. Sei molto intelligente, Paimon. Nara {NICKNAME}, non appena sei pront{F#a}{M#o}, allunga la mano ed entreremo nel sogno dell'albero di Ashvattha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350229,
						730350234
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350229,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350230
					]
				},
				{
					"id": 730350234,
					"content": "Datemi un momento per prepararmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350235
					]
				},
				{
					"id": 730350230,
					"content": "#Arama ha appena nominato Marana... Paimon si chiede cosa vedremo in questo sogno! Oh, beh, andrà tutto bene! Dopotutto, ci sei tu con noi, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350231,
						730350232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350231,
					"content": "(Allunga la mano verso l'albero di Ashvattha...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 730350232,
					"content": "Concedetemi un attimo per prepararmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350233
					]
				},
				{
					"id": 730350233,
					"content": "#Certo! Fammi sapere quando sarai pront{F#a}{M#o}. Verrò con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350235,
					"content": "#Certo! Fammi sapere quando sarai pront{F#a}{M#o}. Verrò con te!",
					"roleType": "TALK_ROLE_NPC",
