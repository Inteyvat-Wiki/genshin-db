				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910501,
					"content": "Guarda un po', l'ha fatto di nuovo! E sono persino meglio di prima... Anche se gliel'abbiamo visto fare già due volte, sembra sempre una magia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910502,
					"content": "#Eheh, {F#forestiere}{M#forestieri} diffidenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910503,
					"content": "Ora che l'avete visto con i vostri occhi, non potete più negare la magnificenza della Pietra del tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910504,
					"content": "Aaah, e grazie alle pietre che avete portato, il potere della Pietra del tesoro è diventato ancora più grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910505,
					"content": "Chissà fin dove potrebbe spingersi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910506,
					"content": "Ora che lo dici, perfino Paimon inizia a essere curiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910507,
					"content": "Non devi far altro che darle da mangiare delle pietre, e lei ne creerà di migliori per te... Ma in che modo ci riesce? Perché non l'apriamo e diamo un'occhiata all'interno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910508,
					"content": "C-Come puoi anche solo suggerire una cosa del genere? No, non lo permetterò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910509,
					"content": "Se intendete procedere, dovrete prima passare sul mio corpo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910510,
					"content": "Ehm, era solo un'idea buttata lì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910511,
					"content": "Umpf, considerando che mi hai procurato tutte quelle pietre, lascerò correre la tua impudenza... Ma solo per questa volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910512,
					"content": "O—Ok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910513,
					"content": "Me lo sento, eheh! Se riuscissi a dare alla Pietra del tesoro delle pietre di qualità ancora maggiore, sono sicuro che produrrebbe qualcosa di incredibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910514,
					"content": "#{F#Viaggiatrice}{M#Viaggiatore} proveniente da terre lontane, una volta un mercante mi parlò di una pietra speciale del deserto dal potere straordinario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910515,
					"content": "Il suo nome... Sì, il suo nome è Trishiraite. Se riuscissi a portarmela, la darei da mangiare alla Pietra del tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910516,
					"content": "Sono sicuro, senza alcun dubbio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910517,
					"content": "#Mmmh... Che ne pensi, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910518,
					"content": "Proviamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "Anche Paimon è curiosa di vedere cosa succederà, questo è certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910520,
					"content": "Se riuscissi davvero a procurarti la Trishiraite... Un pezzo dovrebbe bastare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
