			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "Una, due... Mm, tre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910102,
					"content": "Mmm, mm... Una, due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910103,
					"content": "Paimon, suona lo stramballarme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910104,
					"content": "#Ah, se vuoi saperlo, {F#le uniche strambe}{M#gli unici strambi} qui intorno siete voi... Oh... Ohoh... Questo non è di certo il tipo di posto in cui si vedono dei forestieri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910105,
					"content": "È una specie di... luogo proibito? Oppure sacro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910106,
					"content": "No, è solo un posto che ho scoperto per puro caso... Un luogo di tesori sepolti. Mmm, andiamo, voi due, venite qui. Riuscite a sentire? Questa pietra molto speciale davanti a voi... è... la \"Pietra del tesoro\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910107,
					"content": "Il suono sordo che emette si leva e riscende, quasi come se... respirasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910108,
					"content": "\"Dura\" la vita della pietra, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "Sta solo respirando... Non direi che sia un lavoro troppo duro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910112,
					"content": "Una pietra... può respirare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910113,
					"content": "Sì, e non solo... Se avvicini l'orecchio, sotto la sua superficie grezza puoi sentire anche un battito... E persino il suono di pietre che si frantumano l'una contro l'altra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910114,
					"content": "Eheh... Ohoh... Che suoni meravigliosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910115,
					"content": "E, inoltre... Se la nutri con delle pietre più piccole, te ne restituirà di migliori e più lucenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910116,
					"content": "Aaaah, è semplicemente incredibile, vero? Guarda queste gemme... Guarda! Una, due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910117,
					"content": "Ah, quindi è questo che stavi facendo prima... Contavi le gemme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910118,
					"content": "Sì, dopo aver divorato tutte queste pietre, la Pietra del tesoro è diventata ancora più forte e potente di prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910119,
					"content": "Dev'essere... un miracolo! Ah, la mia Pietra del \"tesssoro\"...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910120,
					"content": "Suona... alquanto sospetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "#Eheh... Non mi sarei mai aspettato che {F#delle forestiere}{M#dei forestieri} come voi ci avrebbero creduto. Nessuno l'avrebbe fatto... prima di averlo provato di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910123,
					"content": "Io stesso l'ho scoperto per puro caso, dopo aver posizionato dei minerali che avevo raccolto sul bordo della Pietra del tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910124,
					"content": "A proposito... Perché non ci provate anche voi? Provare per credere, dopotutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910125,
					"content": "Si dà il caso che abbia già mangiato tutte le pietre qui intorno. Devo trovarne altre... Ma non posso andarci io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910126,
					"content": "Ehm... Perché no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910127,
					"content": "Beh, qualcuno deve rimanere qui a prendersi cura della Pietra del tesoro, no? R-Riesci a immaginare cosa succederebbe se andasse a nascondersi sottoterra mentre sono via...? Cosa farei, a quel punto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910128,
					"content": "Sono qui di guardia da così tanto tempo... Le ho già dato da mangiare tutte le pietre che avevo con me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910129,
					"content": "A-Andate a prenderne altre e ve lo dimostrerò. L-Le mangerà davanti ai vostri occhi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910130,
					"content": "Mmm, sa di fregatura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910131,
					"content": "#Che ne pensi, {NICKNAME}? Vuoi fare un tentativo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910132,
					"content": "Beh, se sono solo pietre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "Eheh, allora affare fatto! Procurami delle pietre, così le darò da mangiare alla Pietra del tesoro... E ti garantisco che ne restituirà di migliori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910121,
					"content": "Davvero? Perché suona come una specie di truffa...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "Anch'io so respirare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "Sì, che c'è di tanto straordinario nel saper respirare...? Aspetta, perché stiamo parlando di questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509102,
