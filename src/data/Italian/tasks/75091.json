			},
			"dialogs": [
				{
					"id": 750910401,
					"content": "Mmm... Pazienza, questo è il segreto. Quando le acque si saranno calmate, le darò da mangiare alla Pietra del tesoro... Eheh, grazie per avermi portato queste pietre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910402
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910402,
					"content": "Forza, Pietra del tesoro, è ora di produrre delle pietre ancora migliori, eheh... Una, due...",
					"roleType": "TALK_ROLE_NPC",
