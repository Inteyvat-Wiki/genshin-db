			},
			"dialogs": [
				{
					"id": 750910201,
					"content": "Mmm... Pazienza, questo è il segreto. Quando le acque si saranno calmate, le darò da mangiare alla Pietra del tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910202,
					"content": "Datele solo un po' di tempo, eheh, e ne produrrà di migliori... Eheh... Una, due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
		{
			"id": 7509103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
