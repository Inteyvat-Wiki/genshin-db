			"dialogs": [
				{
					"id": 220420301,
					"content": "Eccovi di ritorno. Avete dato da mangiare a quei birbanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420302,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "Bene, bene. Mille grazie. Senza il vostro aiuto, quei piccolini avrebbero passato la giornata a giocare là fuori senza mangiare niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420304,
					"content": "*sospira* Che gattini disubbidienti. Come potranno mai essere in grado di ricevere i visitatori del Santuario se continuano così...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
