			"dialogs": [
				{
					"id": 220420401,
					"content": "Eccovi di ritorno. Che strano, i piccolini sono tornati all'improvviso e sembravano a dir poco terrorizzati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420402,
					"content": "Che si siano imbattuti in qualche Hilichurl peloso là fuori? Quelli con i bastoni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420403,
					"content": "A ogni modo, sono di nuovo a casa... Un momento, perché quella faccia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420404,
					"content": "Ecco, io, ehm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "#...Tu... Selvaggi{F#a}{M#o} di u{F#n'}{M#n }uman{F#a}{M#o}! Come ti è venuto in mente di fare una cosa simile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420406,
					"content": "Avresti potuto semplicemente giocare con loro in modo normale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420407,
					"content": "Miao! Ora capisco perché avevano tanta paura... Su, vai a consolarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420408,
					"content": "Da non credere... Ma immagino sia sciocco aspettarsi che tutti gli umani siano come Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		}
