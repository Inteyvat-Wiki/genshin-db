			"dialogs": [
				{
					"id": 220420101,
					"content": "Che pesti impossibili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420102,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "Ah, sei tu. Quei piccoletti sono scappati un'altra volta. Stanno diventando davvero dei ribelli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420104,
					"content": "Ti serve aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "Ora che hai appeso quelle sfere di metallo intorno al Santuario, credo riusciranno a ritrovare la via di casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420107,
					"content": "Forse non è una cosa negativa che si sfoghino un po' là fuori. Basta che non si mettano in ridicolo di fronte agli umani e non disonorino il Santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420108,
					"content": "D'altra parte, se esagerassero e gli venisse fame da quando il sole è alto a quando sorge la luna... non sarebbe una buona cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420109,
					"content": "Vi prego, portate questo pesce a quei birbanti, così che possano saziarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420110,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "Diamo la mappa a Neko, così può indicarci dove si trovano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220420112,
					"content": "Uhm, pare che l'arguzia non ti manchi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420115,
					"content": "E va bene. Andate ora, presto. Io ho ancora alcune faccende di cui occuparmi qui al Santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420113,
					"content": "Ecco la nostra mappa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "Uhm, pare che l'arguzia non ti manchi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420105,
					"content": "Vuoi che andiamo a cercarli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				}
			]
		},
