				{
					"id": 730580401,
					"content": "Andiamo all'accampamento del Nara cattivo e scopriamo cosa sta combinando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "Come fai a capire se qualcuno è cattivo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Beh, non so proprio spiegarlo, ma Nara {NICKNAME} e Bianchina volante non lo sono di certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
