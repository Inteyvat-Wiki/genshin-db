			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aragaru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "#Nara dorat{F#a}{M#o} e Bianchina volante, siete di nuovo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580102,
					"content": "Wow! La prossima volta salutaci prima di saltarci addosso! Hai spaventato di nuovo Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580103,
					"content": "#Non siamo cattiv{F#e}{M#i}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "#Umpf... Hai ragione... Quindi, Nara dorat{F#a}{M#o} e Bianchina volante, dato che non siete cattiv{F#e}{M#i}, potreste farmi un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580106,
					"content": "#Certamente. Sono {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "E Paimon si chiama Paimon, non dimenticarlo di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580108,
					"content": "Di nuovo...? Oh... Ehm, sono Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580109,
					"content": "#Eravamo qui con te, ma tu hai dimenticato tutto... Uff, è troppo lungo da spiegare! {NICKNAME}, perché non lo facciamo insieme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580110,
					"content": "Descrivi ad Aragaru le vostre avventure nel dettaglio.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "È così...? Non ricordo, ma voglio crederti... E avete il fiore, riesco a percepirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580112,
					"content": "Ah, giusto! Il Nara cattivo ha costruito un accampamento. Vediamo se ha lasciato qualcosa lì. Forse potremo sventare i suoi piani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580104,
					"content": "Abbiamo fatto fuori i cattivi per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
			"completionStepIds": [
				7305804
