					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "Com'è andata? Avete trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580202,
					"content": "Mmh... Nulla se non ordini vaghi, e questo! Un fiore essiccato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580203,
					"content": "Eh...? Questo fiore, posso averlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580204,
					"content": "È dei cattivi, non hai paura di essere avvelenato o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580205,
					"content": "Non preoccuparti, ho già visto questo fiore... La persona, dovrei sapere... Per favore, dammelo, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580206,
					"content": "Certo, tieni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#Grazie, Nara {NICKNAME} e Bianchina volante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580208,
					"content": "Aragaru ha portato il fiorellino essiccato nella Foresta di Mawtiyima...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
