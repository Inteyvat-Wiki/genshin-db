			"dialogs": [
				{
					"id": 220480101,
					"content": "Il santuario si sta sporcando di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480102,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "#Miao, sei di nuovo tu. Ben trovat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480104,
					"content": "Ah, il santuario è di nuovo invaso dalle foglie... Che cosa sgradevole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480105,
					"content": "Non è il modo di accogliere gli umani che vengono a rendere omaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480106,
					"content": "Potresti aiutarmi a ripulire il santuario, come hai fatto in precedenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480107,
					"content": "Non ci sono Taisuke ed Eiko?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "Io... non intendo rivolgere la parola a quei due umani in verde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480109,
					"content": "L'umano più alto mi osserva sempre con uno strano sguardo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480110,
					"content": "E l'altra umana in verde non mi sembra mai particolarmente... motivata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480111,
					"content": "Miao, miao, a prescindere da questo, non sono umani affidabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480115,
					"content": "In ogni caso, questo è un incarico che posso affidare soltanto a te. Pulisci tutto usando il bastone lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480116,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "Sia come sia, lascio il compito a te. Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480119,
					"content": "Ti aspetterò qui, miao, miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480117,
					"content": "Ci penserò io, più o meno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "Beh, potresti chiedere al signor Ooshima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "L'uomo della pietra è sempre occupato con le sue sculture. Chissà che cosa sta facendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480114,
					"content": "La pietra è stata già scolpita, dopotutto. Mi chiedo cos'abbia da scalpellare tanto, ancora... Che seccatura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Neko"
				}
			]
		},
