				},
				{
					"id": 761220402,
					"content": "È davvero molto bello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220403
					]
				},
				{
					"id": 761220403,
					"content": "Paimon può svolazzarsene in giro per dare un'occhiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220404,
					"content": "Ma certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220405
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220405,
					"content": "Se vi fa piacere, un giorno vi ci riporterò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220406
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220406,
					"content": "Allora, è questa la \"piacevole sorpresa\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220407,
					"content": "Oh? Quindi questo vale già come \"piacevole sorpresa\", ai tuoi occhi? No, la vera sorpresa deve ancora arrivare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220408
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220408,
					"content": "C'è dell'altro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220409
					]
				},
				{
					"id": 761220409,
					"content": "Venite. Dipingiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220410
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220410,
					"content": "Aspetta. Qui? Ma Paimon non vede né tele né pennelli o colori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220411,
					"content": "Oh. È semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220412
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220412,
					"content": "La superficie dell'acqua sarà la nostra tela, il chiaro di luna i nostri pennelli e i passi che percorreremo le nostre pennellate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220413
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220413,
					"content": "Con il riflesso della luna a guidarci, il pensiero puro scorrerà al di sotto dei nostri piedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		}
	]
