			"dialogs": [
				{
					"id": 761220401,
					"content": "Wow! È questo il posto di cui parlavi, vero? Paimon l'altra volta non c'era, quindi non ha potuto vederlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
