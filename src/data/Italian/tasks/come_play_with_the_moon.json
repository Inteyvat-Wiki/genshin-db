			"dialogs": [
				{
					"id": 761220201,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220202,
					"content": "Luonnotar! Sei proprio tu! Sei tornata, e più argentata che mai! Paimon pensava che non ti avrebbe più rivista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220203,
					"content": "Il dipinto che abbiamo realizzato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "Abbiamo usato il chiaro di luna per tracciare la sua forma, dopodiché vi ho infuso nuovo potere e nuove benedizioni per donarle nuova vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220205,
					"content": "Non ha più bisogno di portare il mio spirito. Il suo destino appartiene a lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220206,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220207,
					"content": "Ah, viene verso di noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220208,
					"content": "Sì. Ho risvegliato tutti i ricordi del tempo che avete trascorso insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220210,
					"content": "...! ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220211,
					"content": "*tira su col naso* Paimon è così felice che tu sia tornata, Luonnotar. Paimon promette che d'ora in poi sarà più buona con te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220212,
					"content": "Questa sì che è una bella sorpresa inaspettata... Paimon è al settimo cielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220213,
					"content": "Grazie, Colombina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "Niente di che. Anch'io sono felice di rivederla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220216,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220217,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220218,
					"content": "(È ancora molto legata a Luonnotar, ma la sua espressione è diversa da prima.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "(Guarda Luonnotar non come un semplice famiglio, ma come un'amica intima.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "#Vai. Ti saranno {F#mancate}{M#mancati} di certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220221,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220222,
					"content": "Tornate pure quando volete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
