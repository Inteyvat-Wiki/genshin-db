			"dialogs": [
				{
					"id": 761220101,
					"content": "Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220102,
					"content": "Eh? Che strano. Paimon giurerebbe di aver sentito la sua voce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220103,
					"content": "...Yah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220104,
					"content": "Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220105,
					"content": "Salve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220106,
					"content": "Ti diverti così tanto a farci morire di paura?! Se eri qui, bastava dirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220107,
					"content": "Siccome avete già tanta familiarità con questo gioco, per questa volta ho pensato di aumentare la difficoltà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220108,
					"content": "Umpf! La prossima volta Paimon te la farà pagare, aspetta e vedrai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220109,
					"content": "Ottimo! Non vedo l'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220110,
					"content": "Che fine ha fatto la tua maschera, Colombina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "Ah. Immagino che le Kuuhenki me l'abbiano soffiata mentre giocavamo prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220112,
					"content": "Di solito non ho bisogno di usare gli occhi, quindi non avere la maschera fa poca differenza. Possono anche giocarci, se gli va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220113,
					"content": "Ah! A proposito, non vorresti uscire più spesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220114,
					"content": "Ora non hai più bisogno di nasconderti, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Sì... Ora ho molto tempo a disposizione. Posso andare dove voglio, quando voglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220116,
					"content": "Però, temevo di farvi preoccupare se, venendomi a cercare, aveste scoperto che me n'ero andata senza salutarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220117,
					"content": "In questo tipo di situazioni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "Già! Dopotutto, a noi basta sapere che stai bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220120,
					"content": "Capisco. Lo prenderò in considerazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220121,
					"content": "Lo \"prenderai in considerazione\" soltanto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220122,
					"content": "O forse è proprio in questo posto che preferisci stare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Tutto ciò che è successo qui... lo considero un bel ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220124,
					"content": "Detto questo, c'è un altro motivo per cui vi stavo aspettando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220125,
					"content": "Di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220126,
					"content": "Volevo farvi una piacevole sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761220118,
					"content": "Puoi semplicemente lasciare un messaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
