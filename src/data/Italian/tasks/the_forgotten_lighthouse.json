			"dialogs": [
				{
					"id": 762050201,
					"content": "Woah, la distanza è enorme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050202,
					"content": "Ogni cosa può fungere da guida... Colme son le scritture... di nomi divini! Le parole e i capitoli... s'intrecciano... E gli angeli agiscono in armonia! In questo sacro luogo, possano le parole forgiare il cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050203,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050204
					],
					"speakerTitle": "Esamina la porta"
				},
				{
					"id": 762050204,
					"content": "Visto? Tutto sistemato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050205,
					"content": "Tutto può fungere da guida... Colme son le scritture... di nomi divini!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050206
					]
				},
				{
					"id": 762050206,
					"content": "Le parole e i capitoli... s'intrecciano... E gli angeli agiscono in armonia!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050207
					]
				},
				{
					"id": 762050207,
					"content": "In questo sacro luogo, possano le parole forgiare il cammino.",
