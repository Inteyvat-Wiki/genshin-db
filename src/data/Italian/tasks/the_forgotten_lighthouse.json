				]
			},
			"dialogs": [
				{
					"id": 762050301,
					"content": "Un tesoro! Yuhuu, che spasso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050302,
					"content": "Ma... a Paimon sta davvero scoppiando la testa. Sul serio, Nicole doveva proprio urlare così forte per far apparire quelle scale...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050303,
					"content": "Embè? Ora ci lamentiamo pure? Non hai paura che una potente maga come me possa schioccare le dita e trasformare in rape quei vostri nuovi gingilli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050304,
					"content": "P-Paimon non voleva essere scortese...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "Eheh, sto scherzando. Dovreste sapere che non sono il tipo di angelo musone che si lega al dito ogni cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050307,
					"content": "#...E così, quando giunse finalmente il giorno della resa dei conti, {NICKNAME} e Paimon salirono i sette gradini per trovare una figura familiare ad attenderli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050308,
					"content": "#Fiamme splendenti si raccolsero sulla sua schiena, formando delle ali. La sua figura era nobile e bellissima come il giorno in cui si erano {F#incontrate}{M#incontrati} per la prima volta, eppure ora i suoi occhi brillavano d'una luce crudele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050309,
					"content": "#\"Ma perché?\", chiesero {NICKNAME} e Paimon all'unisono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050310,
					"content": "\"Tutto è iniziato il giorno in cui Paimon si lamentò perché gridavo troppo forte!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050311,
					"content": "Ehi! Qui le parole sono magia, non lo sai? Non dire cose così spaventose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050305,
					"content": "Dai, non prendertela...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				}
			]
		},
		{
			"id": 7620505,
			"completionStepIds": [
				7620505
			],
