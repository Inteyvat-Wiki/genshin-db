						],
						"pointId": 46
					}
				]
			},
			"dialogs": [
				{
					"id": 762050101,
					"content": "Guarda che ora è! Che faccio adesso? Saranno qui da un momento all'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050102,
					"content": "#Ciao, Nicole, siamo {F#arrivateee}{M#arrivatiii}! Ehi, perché ci stai spingendo fuori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050103,
					"content": "Oh, cielo... Oh, cielo... Sono desolata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050104,
					"content": "Non sei ancora pronta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "Come posso spiegarvelo... Oh, accidenti, temo di non riuscire a farlo chiaramente. Dovrò raccontarvi la storia da principio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050106,
					"content": "Tutto ebbe inizio la prima volta che le maghe sfidarono l'Archon di Anemo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050107,
					"content": "Nicole, questo... è successo eoni fa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050108,
					"content": "Uff, non è giusto! È così imbarazzante che dobbiate sentirlo dalla mia bocca... No! Le chiacchiere stanno a zero, il dado è tratto... Basta che Alice non venga a saperlo e non ci sarà motivo di ridere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050109,
					"content": "Cavoli, il suo monologo interiore sta trapelando di nuovo... E poi, non sta uscendo nulla dalla sua \"bocca\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050110,
					"content": "Shhh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "Avevo deciso di nascondere le piume in cima allo studio. Ho pensato che, rendendo le cose più difficili, la sensazione di soddisfazione sarebbe stata maggiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050112,
					"content": "Ma non sono molto brava a controllare questi vortici così scanzonati: riesco a svolazzare solo fino a una certa altezza, dopodiché mi sembra di sbattere contro un soffitto invisibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050113,
					"content": "Non puoi usare la magia per riportare giù le piume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050114,
					"content": "E che divertimento ci sarebbe?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050115,
					"content": "Oh, Paimon capisce cosa intendi... Uhm, è davvero una bella gatta da pelare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050116,
					"content": "Nicole, potresti provare a dire qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "Cosa vuoi che dica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050118,
					"content": "A Simulanka, le parole sono magia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "Ah! Ho capito che vuoi dire! Va bene, ci provo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050121,
					"content": "Uff, non è giusto! È così imbarazzante che dobbiate sentirlo dalla mia bocca...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "No! Le chiacchiere stanno a zero, il dado è tratto...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "Basta che Alice non venga a saperlo e nessuno ne riderà...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "Potresti dire qualcosa che si trasformi in una scala...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
