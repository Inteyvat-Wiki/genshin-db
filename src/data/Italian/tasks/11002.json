			"dialogs": [
				{
					"id": 110020201,
					"content": "Dovremmo quasi esserci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020202
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020202,
					"content": "Hai già capito cosa stai cercando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020203,
					"content": "Certo che no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020204,
					"content": "Allora come fai ad essere così sicura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020205,
					"content": "Semplicemente, è il mio stile. Se decidessi prima cosa cucinare, non ci sarebbe alcun elemento di sorpresa nel piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020206,
					"content": "Allo stesso modo, se sapessi cosa starei cercando prima di trovarlo, non sarebbe una sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020207,
					"content": "Ma è così rischioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020208,
					"content": "Rilassati, è così che ho inventato tutti i piatti celebri del Wanmin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020209,
					"content": "Diamo un'occhiata qui intorno, vi farò sapere quando trovo qualcosa che mi piace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
		{
			"id": 1100207,
			"completionStepIds": [
