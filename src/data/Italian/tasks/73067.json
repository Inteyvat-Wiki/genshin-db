			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670301,
					"content": "Uh, quindi, \"Arashakun\" è l'Aranara che ha scritto tutto questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670302,
					"content": "La grafia in questo diario a volte è grande, altre volte è molto piccola. Le lettere grandi sono ok, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670303,
					"content": "Devo ammetterlo, quelle piccole hanno fatto un po' male agli occhi di Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670304,
					"content": "La nostra piccola Paimon sta avendo qualche problema a leggere queste piccole lettere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "Ehi, Paimon legge bene le lettere che hanno una dimensione normale! Paimon non è abituata a leggere le lettere piccole, questo è quanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670306,
					"content": "Mmh, questo Arashakun non è tornato dopo aver scritto queste pagine più recenti...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670307,
					"content": "Diamo un'occhiata a quella grotta a est. Il diario dice che il suo coraggio è scomparso... Può il \"coraggio\" davvero scomparire? Paimon è curiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306704,
			"completionStepIds": [
				7306713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
