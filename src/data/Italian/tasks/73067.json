				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arashakun",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670601,
					"content": "Sì, eccolo, eccolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670602,
					"content": "Questo è il \"Talismano del coraggio\"! Il fiore è appassito dopo aver passato qualche giorno lontano da Arashakun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670603,
					"content": "Ma va bene così! Arashakun se ne prenderà cura d'ora in avanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670604,
					"content": "\"Arashakun è un bravo Aranara coraggioso, non un Aranara timoroso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670605,
					"content": "#Grazie davvero, Nara {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670606,
					"content": "Arashakun ha riavuto il suo \"coraggio\". Niente può fermarmi! Ho affrontato il Re demone peloso mascherato già una volta, e lo farò di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670607,
					"content": "(Wow, l'atteggiamento e il tono di Arashakun sono completamente diversi ora.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670608,
					"content": "#Il Re demone peloso mascherato ha fatto molte cose malvagie. Venite con me, Nara {NICKNAME} e Paimon. Con il vostro aiuto potremo sconfiggerlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670609,
					"content": "Arashakun se lo sente. Oggi... sarà il giorno in cui la faremo finita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670610,
					"content": "#Va bene, allora, {NICKNAME}, andiamo a vedere che diamine è questo Re demone peloso mascherato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306707,
			"completionStepIds": [
				7306711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306711",
							"2"
						],
						"stepId": 7306711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arashakun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670701,
					"content": "Paimon aveva le sue teorie al riguardo... Ma, a quanto pare, il Re demone peloso mascherato in realtà non è altri che un Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670702,
					"content": "Un Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670703,
					"content": "Sì, il \"Re demone peloso mascherato\" è in realtà un Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670704,
					"content": "Tutti gli Hillychuchu sono \"Re demoni pelosi mascherati\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670705,
					"content": "Ehm, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670706,
					"content": "Ma è tutto quello che ti serve sapere, Arashakun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "Bene! Arashakun ha capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670708,
					"content": "#Sì, con l'aiuto di Nara {NICKNAME} e Paimon, Arashakun guiderà la carica e sarà invincibile! Persino il subdolo Re demone peloso mascherato non sarà all'altezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670709,
					"content": "Arashakun oggi lascerà il segno con una grande nota!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670710
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670710,
					"content": "Una grande nota...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670711
					]
				},
				{
					"id": 730670711,
					"content": "Sì, una grande nota con una grande scrittura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670712
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670712,
					"content": "Sembra che la versione coraggiosa e quella fifona di Arashakun siano due Aranara completamente diversi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670713,
					"content": "Arashakun senza \"coraggio\" aveva braccia e gambe deboli, ma Arashakun con \"coraggio\" è capace di qualunque impresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670714
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670714,
					"content": "\"Coraggio\" non è solo il dono migliore dell'amico Nara, ma anche la cosa più importante per Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670715
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670715,
					"content": "Beh, cerca di tenerlo al sicuro e di non fartelo rubare ancora dagli Hilichurl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670716,
					"content": "Arashakun capisce. Arashakun non permetterà al \"coraggio\" di abbandonarlo ancora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				}
			]
		}
	]
}