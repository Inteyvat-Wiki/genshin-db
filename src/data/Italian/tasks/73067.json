			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arashakun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "Sei tu Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670402,
					"content": "*singhiozza*... Arashakun è il mio nome, sì... Ehi, non avvicinatevi così velocemente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670403,
					"content": "Arashakun è molto grato a voi due per avermi salvato, ma devo comunque chiedervi di mantenere una certa distanza... *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670404,
					"content": "Questo farebbe sentire Arashakun più a suo agio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670405,
					"content": "Cosa? Ti abbiamo appena salvato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670406,
					"content": "Mi dispiace! Scusate per la mia richiesta scortese. Mi dispiace se vi sto facendo arrabbiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670407,
					"content": "Ma sono rimasto intrappolato qui e sono ancora... N-Non mi sono ancora calmato. *singhiozza* Vi prego, perdonatemi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670408,
					"content": "Non c'è problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670409,
					"content": "Ok, grazie. Arashakun può sapere i vostri nomi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670410,
					"content": "Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670411,
					"content": "#Io sono {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#Nara {NICKNAME} dorat{F#a}{M#o} e Paimon... Allora, come sapete il nome di Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670413,
					"content": "Abbiamo letto il diario nella casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#Nara {NICKNAME} dai capelli dorati ha letto il diario ed è venut{F#a}{M#o} a cercare Arashakun? Poi ha salvato Arashakun che era intrappolato? Nara è così gentile e potente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670415,
					"content": "*singhiozza* Se Arashakun non avesse perso il \"coraggio\", Arashakun non sarebbe stato così inerme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670416,
					"content": "L'abbiamo letto nel diario. Cosa intendevi dicendo di aver perso il \"coraggio\", Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670417,
					"content": "Questa è una storia di tanto tempo fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670418,
					"content": "Molte lune fa, Arashakun era proprio come l'Arashakun adesso, senza \"coraggio\". Al tempo, anche solo il rumore di un ramo che si spezza teneva Arashakun sveglio la notte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670419,
					"content": "Ma persino il timoroso Arashakun aveva un amico Nara come compagno. Quell'amico Nara non era potente come Nara Varuna, ma era comunque un buonissimo Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670420,
					"content": "Non derideva mai Arashakun. Quando Arashakun aveva paura, lui prendeva la sua mano. È stato un amico che Arashakun non dimenticherà mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670421,
					"content": "Ma un giorno quel Nara fu preso dal Re demone dalla maschera pelosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670422,
					"content": "Aspetta, cos'è questo Re demone dalla maschera pelosa di cui parli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670423,
					"content": "Il Re demone peloso mascherato è un re demone dalla faccia pelosa che indossa una maschera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670424,
					"content": "Ah, sì, chiaro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670425,
					"content": "Sai cos'è, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "È impossibile che Paimon lo sappia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670429,
					"content": "Ma il Re demone dalla maschera pelosa ha catturato l'amico di Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670430,
					"content": "Il Re demone peloso mascherato fu molto scaltro. Il solo pensiero fa tremare Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670431,
					"content": "*singhiozza*... Quando l'amico Nara fu preso, Arashakun aveva paura di essere picchiato dal Re demone peloso mascherato, ma aveva ancora più paura di non vedere più l'amico Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670432,
					"content": "Quindi Arashakun ci provò con tutte le sue forze! Occhi chiusi! Denti stretti! Usò le mani e colpì, colpì, colpì! E salvò l'amico Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670433,
					"content": "Dopodiché, l'amico Nara utilizzò i fiori per fare un \"Talismano del coraggio\" e disse ad Arashakun: \"Arashakun è un bravo Aranara coraggioso, non un Aranara timoroso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670434,
					"content": "E così da quel momento Arashakun ha avuto \"coraggio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670435,
					"content": "A me sembrava che \"occhi chiusi! Denti stretti! Usò le mani e colpì, colpì, colpì!\" fosse già sintomo di coraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670436,
					"content": "No. Arashakun ha avuto \"coraggio\" solo dopo averlo ottenuto dall'amico Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670437,
					"content": "Ma quello che hai fatto per salvare il tuo amico è stato già coraggioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670438,
					"content": "No, no, no. Arashakun era così spaventato quando stava salvando l'amico Nara. Le braccia e le gambe tremavano tutte. Ma dopo aver preso \"coraggio\", le braccia e le gambe di Arashakun non erano più deboli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670439,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670440,
					"content": "Il talismano era solo un simbolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#*singhiozza*... Nara {NICKNAME} la sta facendo troppo complicata. Arashakun sa solo che ha \"coraggio\" quando ha il \"Talismano del coraggio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670443,
					"content": "Dopo che il \"coraggio\" era stato rubato, Arashakun venne a cercarlo nella grotta del Re demone peloso mascherato, sperando di trovare indizi per ritrovare il \"coraggio\" di Arashakun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670444,
					"content": "Ma Arashakun finì per essere circondato dai Melmosi nella grotta... Fortunatamente, il Re demone peloso mascherato non se ne accorse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670445,
					"content": "#A tal proposito... Ricordi quella cosa che abbiamo raccolto dagli Hilichurl, {NICKNAME}? Pensi che sia il talismano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670446,
					"content": "Arashakun, potremmo aver trovato il coraggio che hai perso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670447,
					"content": "#Davvero? Avete trovato il \"coraggio\" di Arashakun, Nara {NICKNAME} e Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670441,
					"content": "Il coraggio è sempre stato in te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "Questa è proprio una risposta da Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "Paimon non ha idea di chi possa essere questo Re demone dalla maschera pelosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				}
			]
		},
