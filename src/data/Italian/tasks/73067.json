			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(Le prime pagine contengono una scrittura minuta e scarabocchiata...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670202,
					"content": "\"... Non posso credere che ci sia un Nara disposto a fare amicizia con Arashakun. Che bravo Nara! Al buon Nara non dispiaceva il timoroso Arashakun, e gli ha persino insegnato a scrivere le parole Nara...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670203,
					"content": "\"...Il buon Nara ha confortato Arashakun quando Arashakun era spaventato da una foglia caduta sulla sua testa. Il buon Nara è amico di Arashakun per sempre!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670204,
					"content": "(La grafia si fa più piccola e più confusa nelle pagine seguenti...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670205,
					"content": "\"Oh, no... L'amico Nara è stato preso dal Re demone dalla maschera pelosa! Ha delle braccia così lunghe. È così spaventoso...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670206,
					"content": "\"Ma... Devo salvare Nara... Ohh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670207,
					"content": "(Le pagine seguenti sono scritte con una grafia grande ed energica...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670208,
					"content": "\"Il Re demone dalla maschera pelosa è stato sconfitto! Salvato l'amico Nara, e l'amico Nara ha dato ad Arashakun 'coraggio'! La timidezza di un tempo non fa più parte di Arashakun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670209,
					"content": "\"Arashakun ha 'coraggio' ora, e ha affrontato con audacia i mostri dalla maschera pelosa. Nessun Nara vicino dovrà mai più preoccuparsi delle intimidazioni dei mostri dalla maschera pelosa!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670210,
					"content": "(La grafia si riduce ulteriormente nelle ultime pagine...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670211,
					"content": "\"Oh, no... Com'è potuto succedere? Il 'coraggio' di Arashakun non c'è... Il 'coraggio' che Nara ha dato ad Arashakun... Dev'essere stato rubato dal Re demone dalla maschera pelosa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "Annotazioni incoerenti"
				},
				{
					"id": 730670212,
					"content": "\"Il Re demone dalla maschera pelosa ha lunghe braccia ed è scaltro, ma Arashakun non può fare nulla dopo aver perso il suo 'coraggio'... Arashakun andrà a cercarlo nella <color=#00E1FFFF>grotta a est</color>...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Annotazioni incoerenti"
				}
			]
		},
		{
			"id": 7306703,
