			"dialogs": [
				{
					"id": 721402301,
					"content": "#Ehi, {NICKNAME}, non mi aspettavo di incontrarti di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402302
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402302,
					"content": "Da quanto tempo! Com'è il mondo fuori dall'Isola di Yashiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402303,
					"content": "C'è molta più ricchezza rispetto alla mia città. C'è tanto buon cibo e cose divertenti da fare. Ma... non posso dire che mi piaccia davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402304,
					"content": "Oh, come mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402305,
					"content": "Alla gente di questo posto sembra mancare qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402306,
					"content": "Quando vivevamo sull'Isola di Yashiori, Sua Eccellenza era una presenza distante ma rasserenante... Non ci importava dove fosse: sapevamo che era sempre lì a guardarci, a proteggerci, a decidere come avremmo dovuto vivere la nostra vita e che tipo di persone saremmo dovuti diventare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402307,
					"content": "Ma qui, Sua Eccellenza è opprimente e sempre presente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402308,
					"content": "*sospira* Non so bene come spiegarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402310,
					"content": "Ci stiamo ancora provando.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "Comunque, avete trovato qualcosa riguardo a mia madre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402310
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402311,
					"content": "Non importa, fatemi sapere se avete novità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
