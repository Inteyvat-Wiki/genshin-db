					"speakerTitle": "Chouji"
				},
				{
					"id": 721402003,
					"content": "\"Per piacere, trovatemi altro Midollo cristallino...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402004
					]
				},
				{
					"id": 721402002,
					"content": "Un momento, fai indovinare a Paimon cosa stai per dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402005,
					"content": "È proprio quello che stai per dire, sì!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402006
					]
				},
				{
					"id": 721402004,
					"content": "\"A Paimon serve urgentemente, buhuhuuuh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402007,
					"content": "Come procede il tuo viaggio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402008
					]
				},
				{
					"id": 721402006,
					"content": "Ahahah, certo che no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402007
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402008,
					"content": "Bene, ma non ho ancora trovato tracce della mamma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402009
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402010,
					"content": "Faremo del nostro meglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402011
					]
				},
				{
					"id": 721402009,
					"content": "#Non importa. Ti aiuteremo anche noi. Vero, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402011,
					"content": "#Sì! Sapevo di poter contare su di te, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
