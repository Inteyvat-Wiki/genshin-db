					"Chouji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401701,
					"content": "#Ciao, {NICKNAME}! Come va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401703,
					"content": "Mi hai rubato la risposta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "Paimon sta benone, e tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401705,
					"content": "Paimon, sei pronta per il prossimo pasto, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "#Ahah, perché sei troppo lent{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401707,
					"content": "Non hai capito, intendevo che il pranzo sarai tu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "Certo, Paimon è sempre pronta quando si tratta di mangiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401708,
					"content": "Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401709,
					"content": "Pfff... Ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401710,
					"content": "Va bene, dai, smettetela di litigare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401712,
					"content": "Certo, spara. Cosa ti serve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "Vedrò cosa posso fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "Io sto bene, ma avrei un altro favore da chiedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401714,
					"content": "#Non è niente di speciale. Ho solo bisogno che mi aiuti a trovare altri cristalli, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401716,
					"content": "Mi fido, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "Credimi, ti ricompenserò per il tuo aiuto... sempre se ti fidi di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401718,
					"content": "Perché?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "Mi avevi promesso una spiegazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "Ma...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401720,
					"content": "Sì, non ci hai ancora detto perché ti serve tutto quel Midollo cristallino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401722,
					"content": "Ma lo Shogunato ha monopolizzato l'intero mercato del cristallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "Sai che questi cristalli non sono facili da vendere, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "Ecco... mi servono soldi per poter viaggiare e ritrovare la mamma, quindi ho bisogno di scambiare i cristalli con del denaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401725,
					"content": "Stai giocando a un gioco pericoloso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "Mi preoccupo per la tua incolumità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "Lo so, ma troverò il modo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401727,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401728,
					"content": "Siamo amici, non è così, Chouji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401729,
					"content": "Magari possiamo aiutarti di nuovo, come l'ultima volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401731,
					"content": "Che filosofia mercenaria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "E poi, hai promesso che ci avresti ricompensato. Abbiamo il diritto di sapere cosa potrebbe metterti in pericolo e... compromettere il nostro compenso, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401732,
					"content": "Pfff... Paimon ha ragione, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401733,
					"content": "Non raccolgo i cristalli esclusivamente per soldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401734,
					"content": "Stavo pensando... E se la mamma e il papà avessero contratto la malattia causata dal Tatarigami, come tutti gli altri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401735,
					"content": "Forse quei cristalli si potrebbero usare per preparare una medicina. Crescono dalle ossa del serpente gigante, dopotutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401736,
					"content": "Inoltre, anche il signor Yasumoto ha detto che quei cristalli potrebbero essere utili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401737,
					"content": "Ma non puoi sapere per certo se è vero, o sbaglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401738,
					"content": "Forse mi sbaglio, ma non ho nient'altro per le mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401739,
					"content": "Quando troverò la mamma... o magari anche il papà, li porterò a Sumeru. Dicono che lì abbiano una cura per questa strana malattia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401740,
					"content": "Quindi non posso abbandonare la speranza di trovare una cura. Non prima di averci tentato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401742,
					"content": "C'è bisogno di chiedere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "Spero tu riesca a fare buon uso dei cristalli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "#Bene, ho detto abbastanza. Sei ancora dispost{F#a}{M#o} ad aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401744,
					"content": "Grazie infinite! Non lo dimenticherò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
