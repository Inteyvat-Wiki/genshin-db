				{
					"id": 721650305,
					"content": "Un Seelie di Electro molto gentile vi guiderà vicino alla sorgente profonda al centro dell'Isola di Watatsumi, sotto il Santuario dei Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650306
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650306,
					"content": "Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650307,
					"content": "Ciò dovrebbe avverarsi. Queste divinazioni sono sempre state piuttosto accurate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650308
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650308,
					"content": "Mmmh... Più lo dici, più Paimon si insospettisce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650309,
					"content": "Non badare a Paimon, Nonna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650310
					]
				},
				{
					"id": 721650310,
					"content": "Eheh, va tutto bene, figurati. Siete ancora così giovani...",
