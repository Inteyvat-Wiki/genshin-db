			"dialogs": [
				{
					"id": 230420801,
					"content": "#Viaggiat{F#rice}{M#ore}, cosa stai facendo di bello questa volta? Sempre in giro senza sosta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420802
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420802,
					"content": "Oh sì, hai aiutato Nermin ultimamente? O... forse hai sentito qualche voce su di lei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420803
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420803,
					"content": "Ho sentito dire che è stata molto impegnata, ma non ho idea di cosa stia succedendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420804,
						230420806
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420804,
					"content": "Nermin... Uhm... È occupata a prendersi cura dei suoi fiori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420805
					]
				},
				{
					"id": 230420805,
					"content": "Dici davvero? Ma non ho visto nessun nuovo vaso di fiori a casa sua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420806,
					"content": "È... Uhm... È occupata a cucinare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420807
					]
				},
				{
					"id": 230420807,
					"content": "Uhm? Hilmi e gli altri le hanno chiesto di nuovo la zuppa di fagioli alla menta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420808
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420808,
					"content": "Quei ragazzi... Devo farci due chiacchiere quando ho tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
