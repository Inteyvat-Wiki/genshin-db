			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "Sarà davvero una bella sorpresa per Raef... Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420102,
					"content": "Di che sorpresa parli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "#Ehi! Che spavento mi hai fatto prendere, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420104,
					"content": "#Beh, non mi sono mica avvicinat{F#a}{M#o} di soppiatto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "#Non ti avevo vist{F#a}{M#o}. Ero persa nei miei pensieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420106,
					"content": "#Viaggiat{F#rice}{M#ore}, hai mai sentito parlare di una cosa chiamata \"profumo\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420107,
					"content": "Nonna Jawahir mi ha detto che era solita fare dei profumi quando era giovane...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420108,
					"content": "A quanto pare, non solo servono a coprire l'odore del sudore, ma ce ne sono alcuni che hanno anche proprietà tonificanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420109,
					"content": "Raef deve sempre fare la guardia al villaggio. Suda sempre tanto per via del caldo e spesso si lamenta del fatto che la luce del sole lo stordisce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420110,
					"content": "Quindi vorrei preparare una boccetta di profumo alla menta per lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420111,
					"content": "Nonna Jawahir mi ha scritto la ricetta per realizzarlo e mi ha aiutato a comprare gli ingredienti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420112,
					"content": "Peccato che preparare un profumo sia molto più complicato del previsto... Ho passato davvero un sacco di tempo a preparare gli ingredienti e ho fatto anche diversi errori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420113,
					"content": "Se continua così, Raef scoprirà che sto preparando un profumo per lui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420114,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti aiutarmi a preparare alcuni ingredienti? Mi raccomando: non far sapere niente a Raef, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420115,
					"content": "Perché?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "Sto preparando questa sorpresa da molto tempo. Non voglio che scopra qualcosa e che il mio piano vada in fumo proprio adesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420119,
					"content": "Non è una cosa molto impegnativa. Dovresti andare dal signor Azalai a ritirare la merce che ho ordinato e poi prendere un piccolo secchio d'acqua. Tutto qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420120,
					"content": "Ricorda di agire con discrezione. Raef non deve scoprire nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420117,
					"content": "Lascia fare a me, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "Devo ringraziarti di nuovo. Non preoccuparti: riceverai una ricompensa adeguata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 2304203,
			"completionStepIds": [
				2304202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304202",
							"2"
						],
						"stepId": 2304202,
						"stateName": "QUEST_STATE_UNFINISHED"
