				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Azalai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420301,
					"content": "#Benvenut{F#a}{M#o}! Cosa ti serve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420302,
					"content": "Sono qui per l'ordine di Nermin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "Ah, bene... Ho già preparato ogni cosa. Sono tutti ingredienti di alta qualità e anche a buon prezzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420304,
					"content": "Immagino che Nermin li abbia ordinati per creare un profumo, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420305,
					"content": "*sospira* È bello essere entusiasti, ma Nermin dovrebbe prendersi più cura di sé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304205",
							"2"
						],
						"stepId": 2304205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420501,
					"content": "Ottimo, mi sono rimasti alcuni ingredienti dall'ultima volta. Grazie a quelli nuovi che mi hai portato, potrò fare qualche altra prova prima di creare il prodotto finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420502
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420502,
					"content": "Fiuuu... Diamo un'altra ripassata agli appunti. Questa volta ci riuscirò, ne sono sicura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420503,
					"content": "Oh, mi servono anche dei petali di fiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420504
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420504,
					"content": "Nermin inizia a preparare il profumo con un certo nervosismo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230420505
					]
				},
				{
					"id": 230420505,
					"content": "Ecco fatto! La fragranza è ottima e... non è diventato nemmeno appiccicoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420506,
					"content": "Che questa sia davvero la volta buona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420507,
						230420508
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420507,
					"content": "Sembra proprio di sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				},
				{
					"id": 230420509,
					"content": "Evviva! Guarda, ho anche portato la boccetta in cui metterlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420510,
					"content": "#Viaggiat{F#rice}{M#ore}, andiamo insieme a dare il profumo a Raef. Spero tanto che gli piaccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420508,
					"content": "Almeno non è un fallimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				}
			]
		},
		{
			"id": 2304206,
			"completionStepIds": [
				2304206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304206",
							"2"
						],
						"stepId": 2304206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef",
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "#Nermin e... {F#la viaggiatrice}{M#il viaggiatore}. Cosa vi porta qui? C'è forse qualche problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420602,
					"content": "Non ditemi che qualcosa è andato storto con i fiori... Sono ancora in servizio... Una volta finito, posso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420603,
					"content": "Nermin ha qualcosa per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "Ecco, questa boccetta è per te! È un profumo alla menta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420605,
					"content": "All'inizio volevo che avesse un profumo simile a quello delle pesche di Zaytun... Ma per qualche motivo, una volta che le ho aggiunte alla miscela, la fragranza è diventata quasi appiccicosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420606,
					"content": "G-Grazie. Ma a cosa dovrebbe servire questo... profumo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420607,
					"content": "Ti aiuta a rimanere vigile! Inoltre copre l'odore del sudore. Non ti fa girare la testa essere madido di sudore tutto il giorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420608,
					"content": "Uhm, credo di averci fatto l'abitudine. Potrebbe essere un po' strano se l'odore sparisse all'improvviso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420609,
					"content": "Allora non usarlo. Me lo riprendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420610,
					"content": "Ehi, aspetta! Stavo scherzando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420611,
					"content": "Dammi subito quel profumo! Sta iniziando a girarmi la testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420612,
					"content": "Ecco a te. Devi solo spruzzartelo sulle braccia. È ciò che dice sempre nonna Jawahir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420613,
					"content": "L'odore non è male, ed effettivamente è piuttosto rinfrescante. Lascia una sensazione piacevole e fresca sulle braccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420614,
					"content": "Umpf! Dopotutto è la ricetta segreta di nonna Jawahir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420615,
					"content": "#Sono riuscita a realizzare questo fantastico profumo grazie all'aiuto de{F#lla}{M#l} viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420616,
					"content": "Ho solo aiutato un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
					"content": "Perdonami per averti chiesto così tanti favori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420618
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420618,
					"content": "Questi sono per te. Considerali come il tuo compenso... Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420619
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420619,
					"content": "Questo profumo è davvero molto utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420620
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420620,
					"content": "Ma... Uhm... Nermin, perché si formano delle macchie rosse nei punti in cui l'ho spruzzato...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
		{
			"id": 2304207,
