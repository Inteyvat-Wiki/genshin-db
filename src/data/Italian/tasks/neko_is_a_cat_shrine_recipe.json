				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110201,
					"content": "#Ciao, benvenut{F#e}{M#i} al Ristorante Kiminami. Posso offrirvi qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110203
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110203,
					"content": "Beh, devo preparare un pasto per Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110204
					]
				},
				{
					"id": 722110204,
					"content": "\"Neko\"? È per caso il nome di una gatta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110205
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110205,
					"content": "Oh, conosci Neko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110206,
					"content": "No. Ho solo pensato che fosse un nome adatto per una gatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110207
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110207,
					"content": "Con quell'intuito avresti dovuto fare l'investigatrice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110208
					]
				},
				{
					"id": 722110208,
					"content": "Non divaghiamo troppo! Ecco com'è andata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110209,
					"content": "C'è... un Santuario di Asase sull'Isola di Seirai, e ci vive una gatta parlante?!? E quella gatta vi ha chiesto di prepararle da mangiare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110210
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110210,
					"content": "È... è davvero così? Non ho mai sentito una cosa del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110211,
						722110212
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110211,
					"content": "Proprio così, è la pura verità...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				},
				{
					"id": 722110213,
					"content": "L'Isola di Seirai, giusto? Ci andrò di sicuro, se ne avrò l'occasione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110214
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110214,
					"content": "Ehm, allora, riguardo al pasto per Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110215
					]
				},
				{
					"id": 722110215,
					"content": "Ah, giusto... mi ero quasi dimenticata. Fatemi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110216
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110216,
					"content": "Mmmh, un piatto che piacerebbe ai gatti, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110217
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110217,
					"content": "Sarà difficile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110219
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110219,
					"content": "Sarà difficile, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110220
					]
				},
				{
					"id": 722110220,
					"content": "Questa è una sfida al nome della famiglia Kiminami! La supererò, costi quel che costi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110221
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110221,
					"content": "#Allora, credo che con pesce, carne cruda, alghe e riso faremo un piatto di cui i gatti andranno pazzi. Ci penso io, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110222
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110222,
					"content": "A-Anche Paimon ne vuole un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110223,
						722110224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110223,
					"content": "A dire la verità, anch'io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110225,
					"content": "Nessun problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110226
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110226,
					"content": "Lasciatemi riflettere su come strutturare la ricetta. Nel frattempo, aiutatemi a raccogliere 3 porzioni di alghe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110227,
						722110229
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110227,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110228
					]
				},
				{
					"id": 722110228,
					"content": "Bene, pensateci voi allora, bastano 3 porzioni. Quando le avrete trovate, portatemele qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110229,
					"content": "Hai già capito come fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110230
					]
				},
				{
					"id": 722110230,
					"content": "Ho alcune idee, ma non hanno ancora preso completamente forma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110231
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110231,
					"content": "Per ora, aiutatemi a trovare quelle 3 porzioni di alghe. Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110224,
					"content": "Lasciamo tutto nelle tue mani allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110212,
					"content": "Puoi andare a vedere con i tuoi occhi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				}
			]
		},
