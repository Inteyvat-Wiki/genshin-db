			},
			"dialogs": [
				{
					"id": 722110801,
					"content": "Ah, siete qui. Perfetto tempismo, ho bisogno di aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110802
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110802,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110803
					]
				},
				{
					"id": 722110803,
					"content": "Grazie a voi, il santuario è migliorato molto e ora possiamo sperare che gli umani tornino presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110804
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110804,
					"content": "Ho insegnato ai piccoli a comportarsi dignitosamente e a non fare figuracce davanti alla gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110805
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110805,
					"content": "Purtroppo, sono troppo abituati a correre all'impazzata e non ascoltano le istruzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110806
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110806,
					"content": "Però, ho un piano astuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110807
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110807,
					"content": "Un piano astuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110808
					]
				},
				{
					"id": 722110808,
					"content": "Quando ero ancora molto, molto giovane, anch'io mi divertivo a giocare ovunque. Nel tentativo di mettermi in riga con gli altri gatti, Hibiki preparava un piatto delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110809
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110809,
					"content": "D-Delizioso hai detto?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110810,
					"content": "Ogni volta che quel pasto veniva servito, i gatti arrivavano di corsa dagli alberi e dai tetti. Non importava quanto fosse caldo, o quanto scottasse la lingua, non potevamo resistere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110811
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110811,
					"content": "Hibiki ne preparava ogni volta una pentola enorme, e gli umani e i gatti mangiavano insieme. Anche le persone in visita al santuario ne prendevano un piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110812
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110812,
					"content": "Ah, ma Domeki... Tsk, quel golosone. Mangiava sempre così tanto. Non ho mai visto uno spettacolo più indecoroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110813,
						722110814
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110813,
					"content": "Dunque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				},
				{
					"id": 722110815,
					"content": "Molto bene, la vostra comprensione è migliorata. Sì, vi sto chiedendo di preparare un piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110816
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110816,
					"content": "Non per dubitare della tua saggezza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110817
					]
				},
				{
					"id": 722110817,
					"content": "Ma sai davvero come dovrebbe essere preparato questo piatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110818,
					"content": "Miao, miao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110819
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110819,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110820
					]
				},
				{
					"id": 722110820,
					"content": "Il senso stesso dell'esercizio non è forse quello di lasciare a voi tali questioni? O devo fare tutto da sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110821
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110821,
					"content": "Ah, ma quel piatto era veramente una meraviglia! Anche dopo aver vagato lontano, o aver passato anni senza assaggiarlo, ne ricordo ancora il sapore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110822
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110822,
					"content": "#Beh, {NICKNAME}, sembra che questo sia un lavoro per noi, no? È per il bene del santuario, dopotutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110823,
						722110824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110823,
					"content": "Che ingredienti ci sono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110826
					]
				},
				{
					"id": 722110826,
					"content": "Certo che mi ricordo. Carne, pesce, erba acquatica e riso bianco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110827
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110827,
					"content": "Oooh, quindi pesce, carne cruda, alghe e riso, eh... E come si preparava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110828,
					"content": "Non mi ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110829,
						722110831
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110829,
					"content": "Sembra che dovremo chiedere a uno chef.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110830
					]
				},
				{
					"id": 722110830,
					"content": "Certo, ma... Dove troviamo uno chef che sappia fare cibo per gatti? Mmmh... Chiediamo a Taisuke ed Etsuko, forse loro sapranno cosa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110831,
					"content": "Andiamo a chiedere a quei due avventurieri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110832
					]
				},
				{
					"id": 722110832,
					"content": "Oh sì, è vero! Taisuke ed Etsuko sono avventurieri, quindi potrebbero sapere qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110824,
					"content": "Paimon, mai con un secondo fine, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110825
					]
				},
				{
					"id": 722110825,
					"content": "Andiamo, Paimon è amica dei gatti! Neko, ti ricordi ancora gli ingredienti da usare per quel piatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110814,
					"content": "Vuoi che cuciniamo del cibo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				}
			]
		},
