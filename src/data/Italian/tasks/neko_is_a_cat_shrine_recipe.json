			"trigger": {
				"objectNames": [
					"Taisuke",
					"Etsuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "Signorina Etsuko, dove dovremmo andare ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110102,
					"content": "Fiuuu... Penso che ci riposeremo un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110103,
					"content": "Mmmh? Oh, siete voi. Possiamo aiutarvi in qualche modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110104,
					"content": "Dobbiamo trovare un bravo chef...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "Cercate uno chef? Sull'Isola di Seirai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110106,
					"content": "Beh, il fatto è questo: Neko vorrebbe che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110107,
					"content": "Oh, quindi Neko vuole che prepariate del cibo, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110108,
					"content": "Ah, accidenti, se solo avessi la minima idea di cosa fare in cucina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110109,
					"content": "In altre parole, cercate uno chef che vi aiuti a capire \"come preparare qualcosa che piaccia a un gatto con questi ingredienti\", giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110110,
					"content": "Fatemi pensare... Uno chef... uno chef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110111,
					"content": "Beh, perché non provate ad andare alla Città d'Inazuma e cercare Kiminami Anna al Ristorante Kiminami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110112,
					"content": "È una persona molto gentile ed è anche brava a cucinare, dovrebbe potervi aiutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110113,
					"content": "Grazie, andiamo subito a cercarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "Non c'è bisogno di ringraziarci. Andate pure, io e Taisuke dobbiamo pianificare le prossime esplorazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110115,
					"content": "Eheheh, beh, spero davvero che questo santuario riesca a prosperare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110116,
					"content": "Altrimenti il duro lavoro che avete fatto insieme a Neko per ripararlo andrebbe sprecato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				}
			]
		},
		{
			"id": 7221102,
			"completionStepIds": [
				7221103
			],
