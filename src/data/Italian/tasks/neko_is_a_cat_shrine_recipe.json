				"points": []
			},
			"dialogs": [
				{
					"id": 722110501,
					"content": "Avete portato il pasto ai gattini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110502,
					"content": "L'hanno adorato!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "Ah sì? Meraviglioso, meraviglioso. Miao, miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110504,
					"content": "Era troppo tempo che non mangiavo qualcosa di così delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110505,
					"content": "Miao miao, miao... Anche se ora non ho bisogno né di cibo né di acqua, il gusto del riso è sempre una fortissima tentazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110506,
					"content": "Ho chiamato quel piccolo Meshi, proprio perché il riso al vapore è in assoluto la cosa più buona che mi venisse in mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110507,
					"content": "Allora, come si chiamava il piatto che preparava Hibiki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "Un nome? I piatti hanno bisogno di nomi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110509,
					"content": "Beh, questo si chiama \"Piatto micioso rinvigorente\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "Che nome complicato, eppure non mi dispiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110511,
					"content": "E avete ragione. I pasti sono cose buone, e tutte le cose buone dovrebbero avere un nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110512,
					"content": "Miao, miao, chiederò a Hibiki quando tornerà. Magari potrete preparare il vostro piatto anche per lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110513,
					"content": "E lei preparerà il suo per voi. Così potrete mangiare due piatti diversi, ma deliziosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110514,
					"content": "È una ragione in più per me per restaurare questo santuario. Quando Hibiki sarà di nuovo qui, mangeremo tutti insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110515,
					"content": "Grazie. Era davvero delizioso. Miao miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
