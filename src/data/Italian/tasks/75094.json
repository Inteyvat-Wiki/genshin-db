					}
				]
			},
			"dialogs": [
				{
					"id": 751260601,
					"content": "E pensare che sono successe tutte queste cose... Milchi, e la persona che ha lasciato queste note... Sono stati tutti così coraggiosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260602,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260603,
					"content": "Questo è... l'uovo del Saurico in letargo menzionato in quegli appunti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260604,
					"content": "#Stai dicendo che dovremmo usare l'incubatrice per farlo schiudere, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260605,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260606,
					"content": "Mmm, l'uovo sembra in buone condizioni, e c'è anche un manuale per l'incubatrice. Facciamo un tentativo, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260607,
						751260608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260607,
					"content": "Non so se funzionerà, ma possiamo provarci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				},
				{
					"id": 751260609,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260608,
					"content": "Ottimo, presto il nostro compagno avrà un nuovo amico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				}
			]
		}
	]
}