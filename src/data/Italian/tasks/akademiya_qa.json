			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ziryab"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260301,
					"content": "Forse, durante i vostri viaggi potreste esservi imbattuti in ricercatori che si definiscono studiosi driyosh itineranti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260302,
					"content": "In effetti, c'è un gran numero di driyosh in uno dei darsana dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260303,
					"content": "Questo darsana pone gli elementi come nucleo della sua teoria, e studia un'ampia quantità di cose strettamente correlate ai poteri elementali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260304,
					"content": "La mia domanda è: qual è il nome di questo darsana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260305,
					"content": "Spantamad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "Esatto. Spantamad, la casa dei ricercatori dell'Elementalismo che ritengono i sette grandi elementi l'essenza di tutte le cose e di ogni forma di vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260307,
					"content": "Haravatat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "Ahah, risposta sbagliata. I ricercatori dell'Haravatat studiano il linguaggio, la semiotica e la logica... Fidati, è davvero complicato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260309,
					"content": "Rtawahist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "Beh, sfortunatamente ti sbagli. La Rtawahist è il campo base dei ricercatori, e il fulcro della loro ricerca è lo studio dell'universo sopra di noi... Eheh, sembra interessante, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
