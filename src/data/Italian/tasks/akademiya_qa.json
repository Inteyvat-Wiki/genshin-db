			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ziryab",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "Mi chiedo se queste domande siano troppo difficili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260102,
					"content": "#Ehi! Viaggiat{F#rice}{M#ore}! Aspetta un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260103,
					"content": "Parli con me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "Sì! Eheh, vorrei chiederti un piccolo favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260105,
					"content": "Hai perso qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "Cosa...? Perché tutto questo mi suona familiare? Ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260109,
					"content": "Ma no, no. Non ho perso nulla né mi mancano dei materiali. Per quanto riguarda l'ispirazione... Beh, ne ho a sufficienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260110,
					"content": "Ehm, in realtà sto preparando un opuscolo di \"domande e risposte\" per aiutare le matricole a comprendere rapidamente i vari termini che circolano a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260111,
					"content": "In poche parole, serve per spiegare nomi complicati sotto forma di domande e risposte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260112,
					"content": "Così gli studenti apprenderanno in modo più efficiente e interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260113,
					"content": "Tuttavia, non sono sicuro della difficoltà di queste domande... Quindi ho pensato di chiedere il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260114,
					"content": "Non so un granché sull'Akademiya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "Ahah, va bene. Almeno ne saprai qualcosa di più dopo aver risposto alle mie domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260119,
					"content": "Non preoccuparti. Non sono domande difficili... Anzi, direi che sono piuttosto semplici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260120,
					"content": "Cominciamo, allora. Ecco la domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260116,
					"content": "Ho la sensazione di aver già fatto qualcosa del genere in passato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "Intendi la volta in cui Swan ti fece queste domande a Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260118,
					"content": "Ma ci fornì le risposte in anticipo! Paimon non pensa che questa persona farebbe lo stesso per noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260106,
					"content": "Hai finito i materiali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "Sei in cerca d'ispirazione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
		{
			"id": 2302602,
