			"dialogs": [
				{
					"id": 230260401,
					"content": "Se alzi lo sguardo, riesci a vedere l'albero che sorregge l'Akademiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260402
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260402,
					"content": "La prossima domanda è una semplice che molte persone ignorano tranquillamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260403
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260403,
					"content": "Ora ascolta, qual è il nome dell'albero che sorregge l'Akademiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260404,
						230260406,
						230260408
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260404,
					"content": "Il Grande Albero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260405
					]
				},
				{
					"id": 230260405,
					"content": "Ahah, piuttosto sintetico, ma purtroppo è errato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260406,
					"content": "Albero divino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260407
					]
				},
				{
					"id": 230260407,
					"content": "Ahaha, bene! È giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260408,
					"content": "Albero enorme!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260409
					]
				},
				{
					"id": 230260409,
					"content": "Beh, per quanto sembri un nome potente, è sbagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
