					"Ziryab"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260201,
					"content": "Ahem... Come saprai, ogni darsana nell'Akademiya è specifico di un determinato campo di ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260202,
					"content": "Quindi, qual è il nome del darsana con il numero più alto di ricercatori? Ti do un indizio: è la scuola specializzata in Biologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260203,
					"content": "Amurta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "Esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260205,
					"content": "Armuta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "Beh, tutto il contrario della risposta corretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260207,
					"content": "Atamur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "Ahah, purtroppo non è la risposta esatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
		{
			"id": 2302603,
