				"points": []
			},
			"dialogs": [
				{
					"id": 230240101,
					"content": "Ah! Sei qui, finalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240102,
					"content": "Tempismo perfetto. Siamo pronti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240103,
					"content": "Come mai sei così emozionato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "Forse perché stanno per sbocciare le rose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240105,
					"content": "#Sì, ahahah! Non ce l'avremmo mai fatta senza di te, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240106,
					"content": "La rosa non ha ancora raggiunto la piena fioritura, ma già dall'aspetto si può notare la sua straordinaria vitalità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240107,
					"content": "#Se ti interessa, viaggiat{F#rice}{M#ore}, puoi osservare più da vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240108,
					"content": "Potrebbe sbocciarti proprio davanti agli occhi, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240109,
					"content": "Beh, non vorrei perdermelo per nulla al mondo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "D-Davvero? Proprio adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240111,
					"content": "Eheh, anche Paimon si sta emozionando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2302402,
			"completionStepIds": [
				2302402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
