			"dialogs": [
				{
					"id": 230240401,
					"content": "#Viaggiat{F#rice}{M#ore}, non avresti potuto scegliere un momento migliore. La rosa sta finalmente sbocciando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240402,
					"content": "Grazie a te, è la rosa migliore che abbia mai visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240403
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240403,
					"content": "Grazie infinite! Accetta questo mio segno di gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240404
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240404,
					"content": "Buon per te!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240405
					]
				},
				{
					"id": 230240405,
					"content": "Eheh, anche noi facciamo i salti di gioia per la rosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240406,
					"content": "Fiuu... Finalmente possiamo consegnare in tempo le rose al Bimarstan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240407
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240407,
					"content": "Spero che le rose saranno d'aiuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
