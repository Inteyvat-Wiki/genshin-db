					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200070401,
					"content": "Mi hai salvato la vita! Sono così insistenti, non credi? Quei cacciatori dovevano volere qualcosa di veramente irresistibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070402,
					"content": "Ammiro tantissimo Draff, che è riuscito a cacciare degli esemplari eccellenti. *sospira* Se solo potessi imparare a cacciare come lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070403,
					"content": "Comunque, per prima cosa devo riuscire a portare questo vecchio carretto fino in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070404,
					"content": "Ah, non ci crederai, ma avevo quasi finito di riparare il carretto, quando hanno attaccato di nuovo e hanno fatto altri danni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070405,
					"content": "Più resto qui e più la situazione peggiorerà. Devo aggiustarlo il prima possibile. C'era qualche corda nel retro, ma gli Hilichurl l'hanno sicuramente rubata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070406,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti fare un giro qui intorno e vedere se trovi qualche <color=#00E1FFFF>corda</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
