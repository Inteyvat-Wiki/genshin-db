			"dialogs": [
				{
					"id": 200070201,
					"content": "Ha solo bisogno di un ritocchino qua e là, quanto basta per arrivare fino a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070202
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070202,
					"content": "Dev'esserci per forza della legna utile nei boschi qui vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
