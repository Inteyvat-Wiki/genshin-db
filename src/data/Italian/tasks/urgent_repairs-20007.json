			"dialogs": [
				{
					"id": 200070601,
					"content": "Dovrebbe andare bene. Sembra possa andare in pezzi da un momento all'altro, ma basta che mi riporti fino a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070602,
					"content": "Grazie di tutto! Ora posso andare. Contattami la prossima volta che sei al Villaggio Acquachiara e andiamo a farci una bevuta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070603,
					"content": "...Sempre se non bevi come Draff, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
