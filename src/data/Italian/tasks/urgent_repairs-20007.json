			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200070101,
					"content": "#G-Grazie, {NICKNAME}, non credo alla mia fortuna... Ero sicuro di essere spacciato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070102,
					"content": "Il carico di questo carretto è tutto ciò che i cacciatori sono riusciti a prendere. Draff mi ha chiesto di trasportarlo fino in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070103,
					"content": "Non sono il miglior cacciatore del mondo, ma dovrei riuscire a portare a termine una semplice spedizione. O così pensavo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070104,
					"content": "#Stavo per fare un macello. L'attacco è arrivato davvero all'improvviso. Penso volessero le merci. Per fortuna che sei arrivat{M#o}{F#a} al momento giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070105,
					"content": "Ehm, non è facile per me chiedertelo, ma... Il mio carretto è stato danneggiato durante l'attacco e non ho altro modo di andarmene da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070106,
					"content": "Sono sicuro che i boschi qui vicino hanno i materiali necessari per le riparazioni, ma non posso proprio lasciare le merci incustodite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070107,
					"content": "Se non è un problema, potresti dare un'occhiata qui intorno e aiutarmi a trovare un'<color=#00E1FFFF>asse robusta</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 2000702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
