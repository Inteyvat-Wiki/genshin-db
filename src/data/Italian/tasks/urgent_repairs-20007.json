			},
			"dialogs": [
				{
					"id": 200070301,
					"content": "Ne hai trovata un sacco, giusto due secondi per...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070302
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070302,
					"content": "#Ah! Eccoli di nuovo, viaggiat{F#rice}{M#ore}, eccoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
