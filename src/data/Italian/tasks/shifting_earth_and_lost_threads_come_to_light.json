			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111229901,
					"content": "Ehi, qui ci sono delle tracce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229902,
					"content": "Devono averle lasciate i minatori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229903,
					"content": "Raggiungiamo la fine del Passo di Lingju. Se lì non ci sono impronte, significa che i minatori sono ancora all'interno del Passo. Tuttavia, se troviamo nuove tracce, potremo seguirle ovunque ci condurranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112202",
							"2"
						],
						"stepId": 1112202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "Ehi! Delle impronte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220202,
					"content": "Sembra che siano passati dal Passo di Lingju e abbiano proseguito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220203,
					"content": "Se seguiamo le loro impronte, dovremmo riuscire a scoprire dove sono andati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112204",
							"2"
						],
						"stepId": 1112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "Ehilà, hai visto dei minatori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220402,
					"content": "...Quattro o cinque giorni fa sono passati di qui alcuni uomini portando con sé ceste e picconi... Che fossero loro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220403,
					"content": "Sì! Devono essere loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220404,
					"content": "Quattro o cinque giorni fa? A quanto pare sono andati più lenti del previsto. La conformazione del territorio del Passo di Lingju deve averli rallentati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220405,
					"content": "È stato così strano! Quattro uomini grandi e grossi con delle espressioni spente... Era come se fossero in una specie di trance! E davanti a loro c'era un bambino che barcollava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220406,
					"content": "Mmh, questo bambino... Hai per caso visto che aspetto aveva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220407,
					"content": "Di sfuggita... Capelli blu, corti. Credo... Credo che fosse una ragazzina! Non sorrideva, anzi, aveva un'espressione molto seria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220408,
					"content": "E sono andati da questa parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220409,
					"content": "Sì, sono passati proprio da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220410,
					"content": "Inseguiamoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "Quei mostri erano così aggressivi... Si saranno accorti che stavo passando! Prima che me ne rendessi conto, mi sono già saltati addosso... Grazie per avermi salvata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220702,
					"content": "Mi chiamo Wanyu e faccio parte dell'Unione di Shenglu di Liyue. Sono la responsabile degli studi sulla cultura e sulla civiltà umana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220703,
					"content": "Eh? Sei sicura di non essere... una minatrice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220704,
					"content": "Una minatrice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220705,
					"content": "Sì. Stiamo cercando un gruppo di minatori con dell'attrezzatura da miniera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220706,
					"content": "C-Credo di averli visti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220707,
					"content": "Sul serio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220708,
					"content": "Sì. L'altro ieri sono partita da Nantianmen alla volta del Passo di Lingju. Circa a metà strada, mi sono imbattuta in alcune persone... degli uomini con una bambina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220709,
					"content": "Puoi essere un po' più specifica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "Ero di fretta e non ho visto bene. Temo di non essere nemmeno sicura del loro aspetto... scusate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220711,
					"content": "Direi che può bastare. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220712,
					"content": "Spero che vi sia d'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220713,
					"content": "Sarà meglio che vada, c'è una conferenza a cui devo partecipare. Grazie ancora per il vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220714,
					"content": "Stando a questa studiosa, i minatori erano diretti a Nantianmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220715,
					"content": "Siamo sicuri che si tratti degli stessi uomini che stiamo cercando noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220716,
					"content": "Una bambina con un gruppo di adulti! A Paimon sembrano proprio loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220717,
					"content": "Potrebbe benissimo trattarsi di un altro gruppo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "Mmh... ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220719,
					"content": "Ehi, forse quella roccia laggiù può dirci qualcosa in più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220720,
					"content": "Ah! Paimon aveva quasi dimenticato la nostra arma segreta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220721,
					"content": "Sembra promettente, farò del mio meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220722,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220724,
					"content": "È lo stesso gruppo. Sono andati da questa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220725,
					"content": "Ahah, signor Kun Jun, la tua abilità di leggere le pietre è qualcosa che non dimenticherò tanto facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220726,
					"content": "Suppongo che sia un vantaggio, anche se raramente serve a qualcosa. Tuttavia, ricevere i complimenti del signor Zhongli è un onore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220727,
					"content": "È una vera fortuna aver con noi la \"bussola Kun Jun\"! Senza, avremmo sicuramente già sbagliato strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220728,
					"content": "Ahahah, lo pensi davvero? Allora, questo viaggio è sicuramente servito a qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220729,
					"content": "È come se... stessimo indagando su un crimine. È un vero spasso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220730,
					"content": "A ogni modo, faremmo bene a non abbassare la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220731,
					"content": "Quattro uomini adulti in stato di trance... che camminano giorno e notte senza mai fermarsi... attraverso colline e montagne... guidati da una bambina... Non si tratta di un avvenimento qualsiasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220732,
					"content": "Oh! Hai ragione, signor Zhongli. Dovremmo rimanere concentrati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220733,
					"content": "E non è tutto. La studiosa è stata attaccata da dei Cuccioli di Geosauro, ma il loro livello di aggressività era... insolito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220734,
					"content": "Abbiamo trovato diversi indizi lungo il cammino. Finora ci hanno spinto nella giusta direzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220735,
					"content": "Mmh, l'altro ieri i minatori procedevano in direzione Nantianmen. Da qui avrebbero dovuto attraversare un pericoloso sentiero di montagna. Se la loro destinazione è davvero Nantianmen, dovremmo riuscire a raggiungerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220736,
					"content": "Ottimo! Non c'è tempo da perdere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220737,
					"content": "Poco fa ho lasciato un segnale nei paraggi. Se zio Dai passa di qui, dovrebbe riuscire a raggiungerci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220738,
					"content": "Buona idea! Tipico di Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112208,
			"completionStepIds": [
				1112208
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112208",
							"2"
						],
						"stepId": 1112208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Minatore"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220802,
					"content": "Qui c'è anche una cesta... Deve trattarsi di uno dei minatori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220803,
					"content": "Ehi! Ci sei? Riesci a sentirci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220804,
					"content": "A giudicare dal suo aspetto, dev'essere crollato per la stanchezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220805,
					"content": "Dovremmo svegliarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220806,
					"content": "Posso... Posso ancora scavare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220807
					],
					"speakerTitle": "Minatore"
				},
				{
					"id": 111220807,
					"content": "Ah... Sembra che stia sussurrando qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220808,
						111220809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220808,
					"content": "Sembra in difficoltà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				},
				{
					"id": 111220810,
					"content": "Sembra convinto di dover ancora lavorare. C'è qualcosa che non va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220811
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220811,
					"content": "Qui vicino c'è un accampamento. Dovremmo portarlo lì e monitorare le sue condizioni prima di decidere la nostra prossima mossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220809,
					"content": "Sembra che stia cercando di alzarsi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220810
					]
				}
			]
		},
		{
			"id": 1112209,
			"completionStepIds": [
				1112209
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112209",
							"2"
						],
						"stepId": 1112209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220902,
					"content": "Come sta? N-Non morirà, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220903,
					"content": "Ha lavorato fino all'esaurimento. Per fortuna, le sue condizioni non sono gravi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220904,
					"content": "Come ha fatto a stancarsi così tanto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "Paimon lo ha sentito parlare di scavare per trovare qualcosa. Ha scavato fino a raggiungere questo stato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220906,
					"content": "È sicuramente possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220907,
					"content": "Strano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "Mmh? Sembra che abbia qualcosa in tasca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220910,
					"content": "Sono... frammenti di minerale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220911,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220912,
					"content": "Ho appena visto i ricordi all'interno di questi frammenti di minerale. Questa persona ha portato con sé i frammenti dalla miniera. È uno dei quattro che stiamo cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220913,
					"content": "Quello che dobbiamo capire è come sia arrivato fin qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220914,
					"content": "Quindi è stato rapito e poi... abbandonato qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220915,
					"content": "Ma se non avevano bisogno di lui, perché portarlo fin qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220916,
					"content": "A meno che non sia successo qualcosa... che l'ha costretto a rimanere indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220917,
					"content": "Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220918,
					"content": "Paimon ne ha abbastanza! Troppi misteri per i miei gusti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220919,
					"content": "Oh! Aspetta un momento! Vedere questi frammenti mi ha rinfrescato la memoria... Ho qualcosa per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220920,
					"content": "Di che si tratta? Oooh! È un regalo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220921,
					"content": "Qualcosa... per noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220922,
					"content": "Come vi ho detto, prima di incontrare zio Dai ero in uno stato confusionale. Dopo essermi unito a voi, sembra che la nebbia si stia diradando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220923,
					"content": "Ero così felice quando zio Dai ha deciso di ingaggiarvi. Non sarei mai riuscito a trovare tutti questi indizi da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220924,
					"content": "Questi sono alcuni cristalli che ho comprato al mercato. Non dei vecchi cristalli qualsiasi... La loro purezza è particolarmente rara! Ce n'è uno per ognuno di voi. Un ricordo, diciamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220925,
					"content": "È bellissimo... Oh, e i colori cambiano se lo muovi! Sembrano tanti cristalli diversi a seconda dell'angolazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220926,
					"content": "Sembra costoso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "Ma certo, prendilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220929,
					"content": "E questo è per il signor Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220930,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220931,
					"content": "Eh? C-C'è qualcosa che non va? Non ti piace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220932,
					"content": "Al contrario... È solo che non avrei mai pensato di ricevere un dono in queste circostanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220933,
					"content": "Ma grazie. Me ne prenderò cura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220934,
					"content": "Sono contento che vi piacciano. È bello fare un regalo che gli altri possano apprezzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220935,
					"content": "Oh! Vedo altre rocce laggiù. Dovreste riposarvi un po', io farò una passeggiata... magari ci sono altri ricordi da scoprire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220936,
					"content": "Ti piacciono proprio le rocce, eh, Kun Jun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220937,
					"content": "I minerali sono i cristalli della terra, depositari del tempo. Mi sento in pace tra di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220938,
					"content": "Riposatevi un po' e chiamatemi quando siete pronti per ripartire. Non mi allontanerò troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220939,
					"content": "Se la caverà, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "Niente paura, ho ispezionato la zona. Non c'è pericolo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220941,
					"content": "Oh, tuttavia, c'è qualcosa di cui vorrei parlarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220942,
					"content": "Eh? Che cos'è questa serietà così all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220943,
					"content": "#Viaggiat{F#rice}{M#ore}... la Drafine significa niente per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220944,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "Intendi il minerale che sta cercando Kun Jun? Che ha di così speciale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220946,
					"content": "La Drafine è un minerale incredibilmente raro usato nella forgiatura. La maggior parte dei cristalli normali si forma in ambienti ad alta temperatura. L'origine della Drafine, invece, è frutto di reazioni elementali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220947,
					"content": "Le reazioni elementali possono produrre materiali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220948,
					"content": "Eccome. Tuttavia, solo un numero ristretto riesce a resistere per un lungo periodo di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220949,
					"content": "La Drafine è comparsa per la prima volta nel mezzo di una grande battaglia, diverse migliaia di anni fa. Potenti scontri di energia elementale hanno dato vita ai cristalli elementali. Una volta terminata la battaglia, questi residui geologici si sono miracolosamente conservati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220950,
					"content": "Interessante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220951,
					"content": "Tuttavia, si tratta di cristalli molto rari e relativamente sconosciuti. Centinaia di anni fa, sono stati praticamente estratti tutti fino a essere dimenticati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220952,
					"content": "Come mai, allora, un cittadino di Liyue è alla ricerca di un minerale che è scomparso da tempo dalla faccia della terra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220953,
					"content": "Esatto! Se sa della loro esistenza, saprà sicuramente che sono già stati tutti estratti, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220954,
					"content": "Strano... Paimon non capisce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220955,
					"content": "Nel commercio minerario c'è ancora chi conserva un vivo interesse per la Drafine. Ma l'interessamento di gente come il signor Kun Jun... le cui motivazioni non sono chiare neanche a lui stesso... è davvero insolito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220956,
					"content": "Forse è spinto da secondi fini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "Secondi fini... *sussulta* Che sia una persona malvagia?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220958,
					"content": "Una conclusione a cui attualmente è impossibile arrivare. Dobbiamo osservare... e attendere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220959,
					"content": "Non dimenticate che salvare quei minatori rimane la nostra missione principale. Per quanto riguarda il resto... Prima o poi la verità verrà a galla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220960,
					"content": "Ci stiamo avvicinando al nostro obiettivo. Credo che dovremmo continuare per questa strada. Ora che abbiamo trovato il primo, gli altri non dovrebbero essere lontani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220961,
					"content": "Una volta recuperate le energie, fate venire il signor Kun Jun. Ci aspettano altre ricerche da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220962,
					"content": "Dovremmo assicurarci che il minatore rimanga al sicuro qui all'accampamento. Una volta risolta la faccenda, potremo tornare e occuparci di lui. Suggerisco di lasciare una nota per zio Dai. Se trova l'accampamento saprà cosa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220927,
					"content": "Posso davvero tenerlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "Non è stato portato qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
