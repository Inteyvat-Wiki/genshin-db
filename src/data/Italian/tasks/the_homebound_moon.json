				{
					"id": 761180401,
					"content": "#Ah, siete {F#tornate}{M#tornati}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180402,
					"content": "Indovina un po', Colombina? Avevi ragione, Lauma non ci ha detto niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180403,
					"content": "Sembrava piuttosto impegnata, però.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "Quindi ti faremo compagnia per i prossimi giorni. Tu mettiti comoda e mantieni alte le aspettative!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180405,
					"content": "Aspettative per... cosa, di preciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180406,
					"content": "Gulp...! Ah! Ehm, n-niente! Non sappiamo nulla, davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180407,
					"content": "Eheh... Molto bene, allora. Non vedo l'ora di trascorrere i prossimi giorni con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180408,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 761180409,
					"content": "Oh, arriva la pappa... Ehi, un momento. Dov'è il cibo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180410,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 761180411,
					"content": "Ha detto: \"Il momento è giunto\". Voi sapete cosa significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180412,
					"content": "Ahhhh, ora Paimon ha capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180413,
					"content": "Colombina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "Sì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180415,
					"content": "Di solito porti una benda sugli occhi, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "Sì. E allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180417,
					"content": "Riesci comunque a utilizzare il Kuuvahki per osservare il mondo esterno, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180418,
					"content": "Esatto. Anzi, in questo modo percepisco le cose in modo anche più chiaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180419,
					"content": "Allora, ehm, possiamo chiederti di non percepire eventuali cambiamenti all'esterno, per ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180420,
					"content": "Volete che sia una \"piacevole sorpresa\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180421,
					"content": "A quanto pare, hai già capito di cosa si tratta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180422,
					"content": "Va bene. D'accordo. In tal caso, vi spiace prendermi la mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
