			"dialogs": [
				{
					"id": 761180501,
					"content": "Eccoci qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180502,
					"content": "Ora puoi aprire gli occhi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180503
					]
				},
				{
					"id": 761180503,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180504
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180504,
					"content": "(Li ha aperti per davvero!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180505,
					"content": "(L'ho detto senza pensarci...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180506
					]
				},
				{
					"id": 761180506,
					"content": "È bellissima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180507
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180507,
					"content": "Questo paio di ali la rende ancora più completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180508
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180508,
					"content": "È un dono che noi Eredi della Luna gelata volevamo farti, Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180509
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180509,
					"content": "Per celebrare la nostra dea che ora è libera di volare, e le cui dita possono finalmente toccare il luogo che chiama \"casa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180510
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180510,
					"content": "...Nel guardare questa statua, la vecchia me si sarebbe ricordata solo della confusione che provava dopo la sua nascita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180511
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180511,
					"content": "Ma ora, ciò che sento è il calore di una \"casa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180512
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180512,
					"content": "Forse, come questa statua, ho scelto di restare qui anche se ora ho le ali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180513
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180513,
					"content": "...Grazie a tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180514
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180514,
					"content": "Abbiamo un altro regalo pronto per te, ma dovrai camminare ancora un po' insieme a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180515
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180515,
					"content": "Eh? C'è un'altra sorpresa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180516,
					"content": "Io e gli altri Eredi abbiamo organizzato un frugale banchetto di benvenuto nella foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180517
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180517,
					"content": "D'ora in poi, questa sarà anche casa tua, Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180518
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180518,
					"content": "Quando sentirai nostalgia di casa, ti prego, sentiti libera di restare qui e di godere della nostra ospitalità, per quanto modesta possa essere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180519
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180519,
					"content": "Certo. Lo farò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180520
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180520,
					"content": "Ma tu guarda. È sorta la luna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180521
					]
				},
				{
					"id": 761180521,
					"content": "Andiamo, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180522
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180522,
					"content": "Spero che ogni notte possa essere meravigliosa come quella Notte di Preghiera lunare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180523
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180523,
					"content": "Benvenuta a casa, Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		}
	]
