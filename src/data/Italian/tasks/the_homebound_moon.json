			"dialogs": [
				{
					"id": 761180101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180102,
					"content": "È un'impressione di Paimon o c'è un odorino delizioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180104,
					"content": "Colombina si sta godendo un bel pranzetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180106,
					"content": "Sembra che ce la stiamo spassando, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180107,
					"content": "Ne vuoi un assaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180108,
					"content": "No, no, prego.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "Non ti vediamo spesso mangiare qui! Sei uscita apposta per comprarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180110,
					"content": "Me l'ha dato Lauma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180111,
					"content": "Wow, si prende proprio cura di te, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180112,
					"content": "A patto che non me ne vada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180113,
					"content": "Come?! Cosa sei, agli arresti domiciliari? Ti hanno comprata con questo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180114,
					"content": "Mi ha anche portato dei libri interessanti e dei giocattoli di ottima fattura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180115,
					"content": "Mmh, adesso sembra più una madre che parte per un viaggio di lavoro lasciando la figlia a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180116,
					"content": "Lauma ti ha spiegato le sue ragioni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "Mi ha solo detto di non uscire di casa, per il momento. E soprattutto di evitare gli Eredi della Luna gelata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180118,
					"content": "Ho provato a chiedere agli animali che sono venuti a portarmi i pasti, ma Lauma ha ordinato loro di non dirmi nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180119,
					"content": "Ah, questo è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180120,
					"content": "Se dovessi tirare a indovinare, direi che sta preparando qualcosa che mi riguarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180121,
					"content": "Ma non preoccupatevi. Tanto non ho mai pensato che stare qui fosse noioso. Il cibo è buono ed è di mio gradimento. Posso anche accettare di non uscire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180122,
					"content": "E se gli Eredi stanno davvero preparando qualcosa... Beh, è una ragione in più per non interromperli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180123,
					"content": "Vuoi che chiediamo in giro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "Sì. Anche Paimon ammette di essere curiosa, adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180125,
					"content": "#Potete farlo... ma vi conviene essere {F#preparate}{M#preparati}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761180126,
					"content": "Probabilmente sa che verrete da me, quindi potrebbe non dire nulla neanche a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
