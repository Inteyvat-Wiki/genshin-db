				]
			},
			"dialogs": [
				{
					"id": 740410101,
					"content": "Ciao, Broglie. Abbiamo i dati delle due stazioni di monitoraggio che hai detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410102,
					"content": "Davvero? Fantastico! Fatemi dare un'occhiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410103,
					"content": "Tieni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "Consegni a Broglie i nastri di carta che avete raccolto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "Aaah! Sì, eccoli, sono proprio loro! Siete due angeli mandati dal cielo per salvarmi dalla mia miseria e restituirmi la mia vita felice e agiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410109,
					"content": "C'era proprio bisogno di dirlo così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410110,
					"content": "#Non c'è tempo da perdere, car{F#a}{M#o} signor{F#a}{M#e}! Vado a cercare il mio supervisore e gli chiederò la chiave per la stazione di elaborazione centrale! Aspettatemi qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410111,
					"content": "*sospira* Va bene... Ma sbrigati, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410112,
					"content": "Dopo un po', torna un Broglie emozionato.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "#Signor{F#a}{M#e}, ho la chiave! Ora dobbiamo solo andare alla stazione di elaborazione centrale per organizzare i dati e poi potremo far ripartire il monitoraggio idrologico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410114,
					"content": "Ah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "Considerando la situazione delle Stazioni di Gommosa alla frutta e di Crêpe Suzette, è possibile che anche quei tizi di Snezhnaya siano alla stazione di elaborazione centrale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410117,
					"content": "Perciò, venite con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410118,
					"content": "Non dimenticare il nostro compenso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410115,
					"content": "E dobbiamo venire con te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "E il nostro compenso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "#Riguardo al vostro compenso... non vi preoccupate. Se il mio supervisore approva il nuovo inizio della nostra ricerca idrologica originale, verrete decisamente ricompensat{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410106,
					"content": "Eheh, che bello sapere queste cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
