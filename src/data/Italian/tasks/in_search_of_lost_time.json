					"speakerTitle": "Broglie"
				},
				{
					"id": 740410602,
					"content": "Se riusciremo a mettere insieme i dati raccolti, otterremo dei risultati significativi, e il monitoraggio idrologico dovrebbe ripartire molto presto! Non vedo l'ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410603,
					"content": "Sembra fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410604,
					"content": "Perché ho la sensazione che ci stia sfuggendo una parte dei dati? Sono solo paranoico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410605,
					"content": "Perché hai così tanti dubbi? Non sei tu il responsabile dei dati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410608,
					"content": "...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "...Mm, chiedo scusa. Ho sbagliato stanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410610,
					"content": "Il Comandante dei Fatui esce di scena a una velocità sproporzionata al suo fisico.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "Un momento... Non è appena passato qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410612,
					"content": "Andava più veloce di un Elementosauro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "Aspetta, non è quello il punto! È un Fatuus! Cosa ci fa qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}, dobbiamo seguirlo e arrivare in fondo alla questione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410613,
					"content": "Così agile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
			]
		},
		{
