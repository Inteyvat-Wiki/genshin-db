				{
					"id": 740411401,
					"content": "#Eccoci qua, {F#Mademoiselle}{M#Monsieur}! Questa è la stazione di elaborazione centrale, dove vengono analizzati i nostri dati per le ricerche idrologiche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411402,
						740411403
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411402,
					"content": "Sembra che non ci sia nessuno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411404
					]
				},
				{
					"id": 740411404,
					"content": "Senza Fatui intorno, non c'è più bisogno di noi, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411405,
					"content": "Non possiamo ancora esserne certi. E se all'interno ci fossero dei soldati di Snezhnaya? Potrei non riuscire più a vedere una madeleine a conchiglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411406
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411406,
					"content": "Ehm, cioè... Non potrei più neanche condurre una ricerca idrologica! Vi prego, entrate assieme a me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411407
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411407,
					"content": "Va bene. Apri la porta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411403,
					"content": "Ora possiamo andare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411404
					]
				}
			]
		},
