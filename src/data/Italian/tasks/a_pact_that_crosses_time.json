			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixin",
					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "Signorina Ganyu, ti ringrazio per aver accettato il mio invito. E apprezzo tanto che anche voi due siate qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320202,
					"content": "Perfetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320203,
					"content": "È davvero gentile da parte tua, Huixin. Ti sei data tanto da fare per organizzare tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320204,
					"content": "Ah, a dire la verità... Oltre a ringraziarti per l'aiuto, c'è una cosa che vorrei dirti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320205,
					"content": "Cosa? Non esitare a dirmi se ti posso aiutare in qualcosa. Non c'è alcun bisogno di esitare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320206,
					"content": "No, no... Non mi serve aiuto. Ehm... Potresti ascoltarmi, giusto per un minuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320207,
					"content": "Con piacere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320208,
					"content": "Quando ero piccola, mio padre mi raccontava tante storie su di te, signorina Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320209,
					"content": "Anche se nutro il più profondo rispetto verso mio padre... Ho sempre ammirato la tua gentilezza e disponibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320210,
					"content": "Ho deciso di unirmi al personale del Padiglione Yuehai perché ti ho sempre ammirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320211,
					"content": "Non sapevo che avessi così tanta stima di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320212,
					"content": "Tuttavia, la realtà dei fatti è che lavorare al Padiglione Yuehai si è rivelato un compito difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320213,
					"content": "Non posso paragonarmi a una segretaria eccezionale come te, motivo per cui spesso dubito di me stessa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320214,
					"content": "Non sono d'accordo. Sei un'ottima segretaria già di tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320215,
					"content": "Ahah, grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320216,
					"content": "Negli anni, sono anche diventata madre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320217,
					"content": "Oh! Quindi, zio Tian è diventato nonno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320218,
					"content": "Trasportata dai miei ideali giovanili, mia figlia ha seguito i miei passi ed è diventata a sua volta una segretaria del Padiglione Yuehai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320219,
					"content": "All'inizio, ero preoccupata per lei. Non è un lavoro facile, dopotutto. A dirla tutta, non sono ancora certa che ne abbia la stoffa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320220,
					"content": "Ma, dopo tutto ciò che è successo stavolta, io... mi sono decisa a supportare la sua scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320221,
					"content": "Cosa ti ha spinto a cambiare idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320222,
					"content": "Il fatto che avrà te, signorina Ganyu, come collega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320223,
					"content": "Sono sicura che l'aiuterai, gentile come sempre, e le dirai: \"Tua madre faceva così\". Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320224,
					"content": "Sarà un momento speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320225,
					"content": "Se non ti chiedo troppo, mia figlia potrebbe avere bisogno del tuo aiuto anche tra più di vent'anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320226,
					"content": "Huixin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320227,
					"content": "Non... Non avrei mai pensato di essere così importante per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320228,
					"content": "È come quando mi hai mostrato la strategia di mio padre. Averti come \"testimone\" mette a proprio agio le persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320229,
					"content": "\"Testimone\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320230,
					"content": "È vero, ho visto con i miei occhi migliaia di anni di storia del Porto di Liyue. Tutti i cambiamenti che ha attraversato, le storie della sua gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320231,
					"content": "Ma l'ho sempre considerata come nient'altro che la fonte della mia solitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320232,
					"content": "Huixin, non sai quanto queste parole siano importanti per me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320233,
					"content": "Mi hai fatto capire che ho un altro tipo di legame con gli abitanti del Porto di Liyue che va oltre il mio contratto con Rex Lapis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320234,
					"content": "Loro contano su di me, mi accettano e desiderano che io sia testimone delle loro storie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320235,
					"content": "Ma certo! Per noi, sei insostituibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320236,
					"content": "Eheh... Giusto. Per questo non posso deluderti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320237,
					"content": "Urrà! Finalmente Ganyu è su di morale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320238,
					"content": "Anche se mi avessero davvero soppiantata, desidero battermi per il mio posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320239,
					"content": "Non ti deluderò. Adempierò al mio contratto e continuerò a lavorare come segretaria delle Sette Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320240,
					"content": "Ehm... Te l'ho detto, non sei stata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "Non importa, tornerò e lo constaterò di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320243,
					"content": "Temo che, durante la mia assenza, sia scoppiato il caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320244,
					"content": "Non c'è tempo da perdere, si torna al lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320245,
					"content": "Buona fortuna, signorina Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320246,
					"content": "Eeeh?! Andiamo via di già? Paimon ha ancora fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320241,
					"content": "Non sei stata licenziata, è un malinteso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
			"completionStepIds": [
				1103204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103204",
							"2"
						],
						"stepId": 1103204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Baixiao",
					"Baishi",
					"Baiwen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "Ahhhh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320302,
					"content": "Baishi, stai bene? Stavi dormendo in piedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320303,
					"content": "Ma... Guardate chi è tornata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320304,
					"content": "Avete persino tempo per rilassarvi? A quanto pare, voi tre siete davvero i miei sostituti perfetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320305,
					"content": "Nient'affatto! È solo che... Abbiamo lavorato troppo. Se non ci fossimo presi una pausa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320306,
					"content": "Non saremmo sopravvissuti abbastanza a lungo da rivederti, signorina Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320307,
					"content": "Signorina Ganyu, ci sei mancata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320308,
					"content": "Eheh. È molto gentile da parte vostra, considerando che ci siamo incontrati una volta sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320309,
					"content": "Abbiamo pregato giorno e notte affinché tu tornassi e riprendessi i tuoi incarichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320310,
					"content": "Per noi, sei un'Adepta disceso nel mondo umano per salvarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320311,
					"content": "Dimentica tutte le nostre lamentele d'invidia e sollevaci da questo lavoro estenuante, ti prego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320312,
					"content": "Va bene, capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320313,
					"content": "Vi prego di dividere le questioni urgenti tra governative, economiche e civili. Evidenziate i compiti non ancora iniziati e quelli in corso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320314,
					"content": "Io mi occuperò del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320315
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320315,
					"content": "Certo, lo facciamo subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320316
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320316,
					"content": "Finalmente... Siamo salvi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320317
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320317,
					"content": "Ah, sì, c'è un'altra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320318
					],
