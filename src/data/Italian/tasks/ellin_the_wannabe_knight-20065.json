			"dialogs": [
				{
					"id": 200650101,
					"content": "Ah, che mal di testa... Cosa dovrei fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650102,
					"content": "Cosa combini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "Mi esercito per le prove dei Cavalieri di Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650104,
					"content": "*sospira* Ma non sono neanche lontanamente forte come Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650105,
					"content": "Credo che sia meglio concentrarmi sulla tecnica, piuttosto che sulla potenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650106,
					"content": "Per esempio, stavo pensando a come spaccare tutti questi manichini di legno con un unico fendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200650107,
					"content": "Sono molto più resistenti di quanto sembra, non è un compito facile... Non so dove mio padre sia riuscito a procurarseli, ma dev'essersi dato molto da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
