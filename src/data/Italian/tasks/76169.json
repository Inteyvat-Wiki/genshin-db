			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}, Paimon. Ci siete anche voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690102,
					"content": "Siamo venuti a trovarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "Se avesse saputo della vostra presenza... Beh, ne sarebbe stato felice, anche se non l'avrebbe mai ammesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690104,
					"content": "Rimanete insieme a Illuga davanti alla tomba per un po'...\\nIlluga parla al vostro compagno caduto, raccontando i piccoli e grandi eventi accaduti ultimamente a Piramida...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "Sapendo che stanno tutti bene, può finalmente riposare in pace, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761690106,
					"content": "Sì. Lui ha completato la sua missione. Noi continueremo con la nostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690107,
					"content": "E dopo di noi, ce ne saranno altri che continueranno a vegliare su questa terra. Sopporteranno tempeste e freddo, ma cresceranno forti come l'Erba invernale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
