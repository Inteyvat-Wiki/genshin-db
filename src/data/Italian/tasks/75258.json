			"dialogs": [
				{
					"id": 752580101,
					"content": "Eh? Che ci fa qui una persona svenuta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580102,
					"content": "Ehiiii! Riesci a sentire Paimon? Stai bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580103,
					"content": "Aiutate l'uomo ad alzarsi, e lentamente riprende conoscenza...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "Ahi, ahi, ahi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "Impiegato svenuto"
				},
				{
					"id": 752580105,
					"content": "Ehi, per caso hai bevuto troppo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "Che mal di testa... Come ho... Aspettate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "Impiegato svenuto"
				},
				{
					"id": 752580108,
					"content": "#Ah, è vero! Credo che qualcuno mi abbia messo al tappeto... ma non ho visto chi. Un momento, non siete {F#state}{M#stati} voi, vero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "Impiegato svenuto"
				},
				{
					"id": 752580109,
					"content": "Ehi! Guarda che noi ti abbiamo aiutato! Dovresti ringraziarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580110,
					"content": "Oh, scusate... Ehm, lavoro alla taverna Una rugiada per due. Ero andato a consegnare della merce al porto a nord. Mmh... Un'associazione di mercanti ha comprato dell'idromele d'Afidi da noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "Impiegato svenuto"
				},
				{
					"id": 752580111,
					"content": "#Oh, no! L'idromele d'Afidi! È sparito! Qualcuno l'ha rubato? Un momento, non siete {F#state}{M#stati} voi, vero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "Impiegato svenuto"
				},
				{
					"id": 752580112,
					"content": "Vuoi smetterla di accusarci?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580113,
					"content": "Ah, già. Scusatemi davvero... Sono ancora un po' stordito, credo. Vi ringrazio. Devo tornare subito alla taverna e avvisarli dell'accaduto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "Impiegato svenuto"
				},
				{
					"id": 752580114,
					"content": "Se ci sono davvero dei banditi in giro, meglio evitare il porto settentrionale. Potrebbe essere pericoloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Impiegato svenuto"
				},
				{
					"id": 752580106,
					"content": "Vuoi che ti porti a casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
