			},
			"dialogs": [
				{
					"id": 401891401,
					"content": "Ho perfezionato la salsa per queste costolette al barbecue. Ha un sapore più intenso della versione classica, ma è molto meno grassa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891402
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891402,
					"content": "L'estratto di menta nel condimento lascia un retrogusto rinfrescante, perfetto alla fine di una giornata all'insegna del divertimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891403,
					"content": "Ma, se vuoi il mio parere, direi che gli operai ne hanno più bisogno dei visitatori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891404
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891404,
					"content": "Gli operai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891405,
					"content": "Come avrai sicuramente notato, questo parco non è ancora completo. Una porzione di costolette al barbecue dovrebbe aiutare gli operai a recuperare le forze molto più rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891406,
					"content": "In quanto loro superiori, avete l'obbligo di provvedere ai loro pasti. Perché non li invitate a cenare qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891407,
					"content": "Chissà, sollevargli il morale potrebbe persino migliorare la loro produttività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891408
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891408,
					"content": "Eh? Se ricordo bene, una volta hai servito del fish and chips speciale ai facchini al Fleuve Cendre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891409
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891409,
					"content": "Nei giorni successivi, l'efficienza dei lavoratori era aumentata incredibilmente. Completavano in cinque ore il lavoro di otto e, visto che staccavano prima del previsto, il giorno dopo attaccavano completamente rinfrescati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891410,
					"content": "Allora non c'è tempo da perdere. Andate dagli operai e invitateli a gustare delle costolette ancora calde. Preparerò anche dei contorni e dei dolci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891411
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891411,
					"content": "Ottima idea! Sei davvero all'altezza della tua reputazione, Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891412,
					"content": "Sembra che questi piatti a tema faranno una grande differenza, dopotutto! Dovremo venire a trovarti regolarmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891413,
					"content": "Tu e Navia invitate gli operai a un banchetto delizioso a base di costolette al barbecue...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
