			},
			"dialogs": [
				{
					"id": 401891101,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891102
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891102,
					"content": "Il ristorante è una vera meraviglia, e la sua posizione permette di offrire un'esperienza culinaria unica nel suo genere. I magnifici riflessi dell'acqua su cui si affaccia creano una cornice mozzafiato, che solleva il morale dei clienti e consente loro di gustare appieno i propri pasti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891103,
					"content": "Ingredienti, li abbiamo... Utensili da cucina, ci sono... Pare che sia tutto a posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891104
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891104,
					"content": "Ehilà, Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891105,
					"content": "#Ah! Ecco {F#le mie datrici}{M#i miei datori} di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891106
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891106,
					"content": "#La presidentessa della Spina di Rosula e {F#le}{M#i} celebri {NICKNAME} e Paimon... Devo dire che sembrate un tantino troppo {F#qualificate}{M#qualificati} per gestire un parco divertimenti a tema cinematografico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891107
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891107,
					"content": "Direi che se qui c'è una persona veramente qualificata, è proprio l'ex chef de cuisine dell'Hotel Débord... Ovunque ci sia tu, l'aria è pervasa da un profumino di pietanze prelibate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891108
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891108,
					"content": "Ahem... Torniamo a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891109,
					"content": "#Se ho ben capito, vuoi che {NICKNAME} mi aiuti a scegliere il piatto a tema per ogni ciclo lavorativo. Giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891110
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891110,
					"content": "\"Piatto a tema\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891111
					]
				},
				{
					"id": 401891111,
					"content": "È la strategia commerciale di cui parlavo prima: useremo i piatti di prim'ordine di Escoffier per attirare più visitatori nel parco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891112,
					"content": "Ma non si tratta solo di attirare i visitatori: i suoi capolavori gastronomici produrranno degli effetti sorprendenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891113
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891113,
					"content": "Immagina, Paimon: poter visitare tutte le attrazioni del parco e assaggiare tutti i cibi di Fontaine pagando un biglietto solo... Non lo troveresti allettante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891114
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891114,
					"content": "A-A-Allora... Paimon verrebbe ogni giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891115,
						401891116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891115,
					"content": "C'è un abbonamento annuale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				},
				{
					"id": 401891117,
					"content": "Ma qui viene il bello: per ottenere il massimo da questa strategia, non possiamo rendere pubblico il menù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891118
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891118,
					"content": "Secondo alcune ricerche di un certo consulente di brand alimentari, molti ristoranti hanno iniziato a proporre un piatto speciale, chiamato \"Sorpresa dello chef\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891119
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891119,
					"content": "Perciò, ogni tot di cicli lavorativi, dovrai fornirmi un po' d'ispirazione, e io deciderò quale sarà il nostro prossimo piatto a tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891120
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891120,
					"content": "Ora dammi la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891121,
						401891122
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891121,
					"content": "La mia... mano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891123,
					"content": "Mmh, percepisco una grande energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891124
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891124,
					"content": "Le tue mani sono abituate all'uso della spada, ma sono comunque delicate. Quando impugni la sua elsa, è come se reggessi l'arco di un violino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891125
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891125,
					"content": "Una spada... Allora, il tema questa volta sarà la \"Forza\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891126
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891126,
					"content": "Bene! Scopriamo qual è la forma culinaria della \"Forza\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891122,
					"content": "Non sapevo che si potesse trasferire l'ispirazione fisicamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891116,
					"content": "Ci vivrei in pianta stabile!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				}
			]
		},
