						],
						"stepId": 4018901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Navia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "Cominciamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "#È giunto il momento, {F#mia cara partner}{M#mio caro partner} e Paimon, di parlare di Cinefantasilandia Chevalmarine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890402,
					"content": "Come vi ho già accennato, il parco tematico è nato dall'idea di un gruppo di appassionati, che hanno coinvolto la Spina di Rosula per occuparsi della progettazione, della costruzione e della gestione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890403,
					"content": "Come potrete intuire, generalmente gli appassionati non sono dei professionisti, e di solito si limitano all'ideazione degli stand per gli eventi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890404,
					"content": "Noi saremo responsabili della gestione a lungo termine e dello sviluppo di guide strategiche standard per le varie attività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890405,
					"content": "Gestione a lungo termine? Guide strategiche? Sembra complicato...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890406,
					"content": "Noi siamo sempre in giro all'avventura! Non abbiamo mai gestito nemmeno uno stand tutto nostro... Pensi davvero che saremo all'altezza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890407,
					"content": "Non tutti i grandi imprenditori hanno una laurea in Scienze economiche e finanziarie, sai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "Così va meglio! Non è niente di nuovo per te, vero, partner? Oserei persino dire che hai aiutato a dare forma ad alcune delle iniziative imprenditoriali più importanti di Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890410,
					"content": "Comunque sia, cominciamo con una panoramica di come sarà gestito il tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890411,
					"content": "#Ah, ora Paimon crede di aver capito. Tu che ne pensi, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890412,
					"content": "Ahah, sembra pane per i miei denti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "Sì! Forza, possiamo farcela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890415,
					"content": "Uhm, hai menzionato delle \"guide strategiche standard\"... Significa che ci saranno anche delle attività \"non standard\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890416,
					"content": "Ma certo! Ognuno ha i propri gusti in fatto di film e intrattenimento, e ci saranno un sacco di attività divertenti a cui partecipare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890417,
					"content": "Se non facciamo attenzione, alcuni visitatori potrebbero allontanarsi e finire nei pasticci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890418,
					"content": "E altri potrebbero raccogliere degli oggetti pericolosi per sbaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890419,
					"content": "Per evitare confusioni di qualunque tipo, dovremo creare una \"guida strategica standard\" per ogni attività... Una sorta di guida di gioco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890420,
					"content": "#Capito... In pratica vuoi che faccia da {F#collaudatrice}{M#collaudatore}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "#Wow, se saremo {F#le prime}{M#i primi} a testare le varie attività, chissà quali sorprese ci attenderanno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890423,
					"content": "Se ci troveremo in difficoltà, dovremo fare affidamento solo sulle nostre abilità per superarle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890424,
					"content": "#Beh, non mi sognerei mai di mettere {F#la mia}{M#il mio} partner in pericolo. Ho verificato attentamente ogni singola attività prima del vostro arrivo, e posso assicurare che sono tutte assolutamente sicure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890425,
					"content": "Ci tenevo affinché fossi tu a provare le attività prima di chiunque altro. Sarà divertente! Vorremmo conoscere la tua opinione e ricevere eventuali suggerimenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890426,
					"content": "Hihi, tipico di Navia: vuole sempre accertarsi che ci si diverta in sicurezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890427,
					"content": "Ottimo. Beh, la vostra opinione è davvero importante per me. Non vedo l'ora di sapere cosa ne pensate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890428,
					"content": "Bene, allora iniziamo con \"Avventure eclettiche\" e prepariamo la nostra prima guida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890421,
					"content": "Ho capito, vuoi che stabilisca lo \"standard\" di riferimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "Wow... Beh, impareremo sul campo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "Anche noi abbiamo concluso un sacco di affari!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
		{
