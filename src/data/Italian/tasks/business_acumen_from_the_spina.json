				]
			},
			"dialogs": [
				{
					"id": 401891001,
					"content": "Beh, i numeri non saranno impressionanti, ma, considerando che abbiamo appena aperto le danze, direi che non è stato un brutto inizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891002
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891002,
					"content": "Sfruttando questa partenza, dovremmo considerare strategie commerciali ancor più peculiari per il prossimo ciclo lavorativo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891003
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891003,
					"content": "Per attirare i clienti, ho invitato una famosa chef di Fontaine, la mia cara amica Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891004
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891004,
					"content": "Si \"esibirà\" qui al ristorante del parco. A tal proposito, andiamo a cercarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891005
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891005,
					"content": "Anche il ristorante fa parte della nostra strategia commerciale? Questo progetto è molto più complesso di quanto Paimon pensasse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4018911,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
