			"dialogs": [
				{
					"id": 401891601,
					"content": "Fiuu... Ecco fatto. Sembra che abbiate imparato piuttosto bene come gestire questo parco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891602
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891602,
					"content": "Eh? Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891603,
					"content": "Ora che Paimon ci pensa, abbiamo appreso un bel po' di cose, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891604,
						401891605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891604,
					"content": "È la dimostrazione che Navia è un'ottima insegnante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				},
				{
					"id": 401891606,
					"content": "Nient'affatto. Non è che vi abbia insegnato granché. Avete principalmente seguito il vostro intuito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891607,
					"content": "#Immagino che quando ho parlato di \"gestione a lungo termine\" vi siate un tantino {F#spaventate}{M#spaventati}, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891608,
					"content": "Ma non dovete scoraggiarvi! Basterà dividere il lavoro in obiettivi più piccoli e affrontarli uno alla volta. Anche chi non è un genio o non ha un talento naturale può riuscirci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891609
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891609,
					"content": "Woah, dopo aver visto i suoi progressi, Paimon è super motivata! Anzi, Paimon si annoterà le tue parole d'incoraggiamento da qualche parte, hihi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891610,
					"content": "Da qui in avanti, gestiremo Cinefantasilandia Chevalmarine assieme! Sarà un grande successo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891605,
					"content": "Non ce l'avremmo mai fatta senza la guida di Navia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				}
			]
		}
	]
