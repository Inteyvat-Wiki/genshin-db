			"dialogs": [
				{
					"id": 401890601,
					"content": "#Sembrate più {F#entusiaste}{M#entusiasti} che mai. A quanto pare il vostro primo giro di prova è stato un successo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890602,
						401890603
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890602,
					"content": "La struttura della sfida è davvero semplice da capire!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				},
				{
					"id": 401890604,
					"content": "A dire il vero, Paimon non ha visto molti film in vita sua, ma adesso... Paimon si è appassionata! Dovremmo guardare il film da cui prende ispirazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890605,
					"content": "Ben fatto, Paimon! È proprio quello che i nostri amici cinefili speravano di sentirti dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890606
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890606,
					"content": "Sarebbero entusiasti di sapere che i visitatori si incuriosiscono dei film a cui queste attrazioni si ispirano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890607,
					"content": "Se il budget lo permette, alcuni sono persino disposti a tirar fuori qualche Mora in più dalle tasche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890608,
					"content": "Dalle tasche...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890609,
					"content": "Esatto! La Spina di Rosula si occupa dei costi di base per gli stand e l'affitto degli spazi, ma molti fan pagano di tasca propria per le spese dei materiali e della merce promozionale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890610
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890610,
					"content": "Il costo dello stand non è la loro spesa principale. Alcuni hanno già iniziato a progettare dei prodotti ispirati ai personaggi del film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890611
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890611,
					"content": "Prendi la nostra mascotte ufficiale, la Surintendante Chevalmarine, per esempio: ha raggiunto il secondo posto come \"Personaggio più popolare\" nella categoria dei film d'animazione, ed è stata anche definita l'\"apice della dolcezza tonda e rimbalzante\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890612
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890612,
					"content": "In molti hanno espresso interesse nell'ideare dei cuscini basati sulla sua immagine, utilizzando tessuti di alta qualità e impiegando artigiani esperti per la produzione in serie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890613
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890613,
					"content": "Questi cuscini saranno ufficialmente in vendita durante la prossima convention, oltre a un sacco di altri prodotti simili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890614,
						401890616
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890614,
					"content": "Ora che lo dici, ne vorrei uno anch'io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890615
					]
				},
				{
					"id": 401890615,
					"content": "Irresistibile, vero? Inoltre, in quanto guardiana e agente ufficiale dei diritti sull'immagine della Surintendante Chevalmarine, Furina riceverà il sessanta per cento sul fatturato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890618,
					"content": "Dopotutto, i fan stanno facendo tutto questo volontariamente: non per i soldi, ma per promuovere l'adorabile immagine della Surintendante Chevalmarine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890619
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890619,
					"content": "Più Mora finiranno nel portafogli di Furina, migliori saranno i pasti della Surintendante Chevalmarine. Chi non ne sarebbe felice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890620
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890620,
					"content": "Hihi, Paimon lo sarebbe di certo! Tutti che lavorano duramente per qualcosa che amano, senza preoccuparsi del guadagno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890621,
					"content": "D'altronde, non possiamo nemmeno ignorare completamente i Mora. Che si tratti di creazioni dei fan o di progetti commerciali ufficiali, un certo livello di equilibrio finanziario è pur sempre necessario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890622
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890622,
					"content": "E la stessa logica vale per Cinefantasilandia Chevalmarine nel suo complesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890623
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890623,
					"content": "Una volta redatte le guide strategiche standard, le nostre attrazioni potranno essere ufficialmente aperte al pubblico. Ma non possiamo occuparci personalmente della vendita dei biglietti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890624
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890624,
					"content": "Ci sono molte mansioni da svolgere nei vari stand, e il parco in sé è un'opera in costante divenire. Dovremo assegnare a ogni singola attrazione dei dipendenti che si occupino della sua manutenzione e della sua gestione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890625
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890625,
					"content": "Presso la bacheca del parco c'è una sezione dedicata agli annunci di lavoro. Abbiamo ricevuto molte candidature, e ogni candidato ha i suoi punti di forza. Il nostro lavoro sarà quello di abbinare i candidati migliori a ogni attrazione in base alle loro prestazioni complessive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890626
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890626,
					"content": "Una volta abbinati si occuperanno di gestire le attrazioni, garantendo un flusso di ricavi costante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890627
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890627,
					"content": "#Un momento, siamo {F#passate}{M#passati} dal ruolo di {F#collaudatrici}{M#collaudatori} a quello di... responsabili delle risorse umane? Non ci era mai successo prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890628,
						401890629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890628,
					"content": "Ho degli standard molto elevati quando si tratta di analizzare dei curriculum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890630,
					"content": "Tieni a mente che non tutti possono raggiungere i tuoi standard, ok? Non pretendere che gli altri abbiano le tue stesse capacità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890631,
					"content": "Bene, è ora di passare in rassegna qualche curriculum! Speriamo di trovare dei candidati eccezionali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890629,
					"content": "Sarei un capo eccezionale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890616,
					"content": "Furina non dovrebbe ottenere una percentuale consistente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890617
					]
				},
				{
					"id": 401890617,
					"content": "Non temere! In quanto guardiana e agente ufficiale dei diritti sull'immagine della Surintendante Chevalmarine, Furina riceverà il sessanta per cento sul fatturato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890603,
					"content": "Ed è perfettamente in linea con il tema del film.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				}
			]
		},
		{
			"id": 4018907,
