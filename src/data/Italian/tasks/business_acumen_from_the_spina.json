			"dialogs": [
				{
					"id": 401890801,
					"content": "Sembra che questa particolare candidata stia già prendendo molto sul serio il lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890802,
						401890803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890802,
					"content": "Speriamo che vada bene!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "Ahahah, state andando alla grande. Sembrate più capi voi di me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890805,
					"content": "In ogni caso, con questo, Cinefantasilandia Chevalmarine apre ufficialmente i battenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890806,
					"content": "Gestire un parco a tema è un progetto a lungo termine. La fretta è l'ultima cosa di cui avrete bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890807,
					"content": "Abbiamo quasi finito con la configurazione del lavoro. Prendiamoci una breve pausa e aspettiamo il resoconto sul fatturato per questo ciclo lavorativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890803,
					"content": "Terrò sotto controllo le sue prestazioni!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
		},
		{
			"id": 4018909,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
