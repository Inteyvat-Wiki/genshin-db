			"dialogs": [
				{
					"id": 3982101,
					"content": "#Ti rendo omaggio, Cavaliere Onorari{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982102
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982102,
					"content": "La Gran Maestra Reggente ha tenuto un discorso pubblico sull'incidente causato da Terrore alato. È stato davvero emozionante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982103,
					"content": "Scoprire la verità è stato... sorprendente. E pensare che i Cavalieri stavano per approvare un piano per uccidere il Drago... Siamo saltati a delle conclusioni troppo affrettate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982104
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982104,
					"content": "Tuttavia, coloro che hanno sofferto tanto potrebbero avere bisogno di molto tempo per perdonare Dvalin. E chissà se riusciranno mai a perdonarlo del tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3982105
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 3982105,
					"content": "Come sempre, dobbiamo lasciarci guidare dal vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
