						],
						"stepId": 39804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980401,
					"content": "Ci siamo! È il momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980402,
					"content": "Crisi! Pericoli! L'ebbrezza dell'avventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980403,
					"content": "La Gilda degli avventurieri! I giorni in cui salvavamo gattini e cercavamo cagnolini smarriti sono giunti al termine! È arrivato il momento di lanciarsi all'avventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980404,
					"content": "Non perdete altro tempo e unitevi subito alla Gilda degli avventurieri! In un momento così difficile, dobbiamo unire le forze per sconfiggere il Drago e salvare la nostra grande città di Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980405,
					"content": "Non per frenare il tuo entusiasmo, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "...Eh? COSA?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980407,
					"content": "Vuoi forse dirmi che la minaccia di Terrore alato è stata scongiurata? E che mi sono perso perfino il discorso della Gran Maestra Reggente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980409,
					"content": "...Bah! Terrore alato si sarebbe dovuto impegnare un po' di più! Non abbiamo potuto nemmeno partecipare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 39807,
			"completionStepIds": [
				39807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39807",
							"2"
						],
						"stepId": 39807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "Salve, cosa volete ordinare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 3980702,
					"content": "Perché tanta freddezza? Pensavo fossimo diventati grandi amici, ormai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980703,
					"content": "Oh, ehi, non ti avevo visto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "#Ahahah... Sembra che la grande battaglia che hai affrontato non abbia solo migliorato le tue capacità di combattimento ma anche il tuo intelletto. Sei veramente u{F#na}{M#n} cavaliere eccezionale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980707,
					"content": "#Trovarsi davanti {F#la nuova grande eroina}{M#il nuovo grande eroe} di Mondstadt mi dà veramente la carica. Ed è un cavaliere a dirtelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980708,
					"content": "Quante belle parole, peccato che non sembri molto sincero, capitano Kaeya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980709,
					"content": "Ahah, ma cosa dici! Ti parlo con il cuore in mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980710,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "Cercavo un posto tranquillo dove poter riflettere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980712,
					"content": "Nel frattempo, tutti gli altri cavalieri stanno lavorando sodo per ripulire la città dopo la battaglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980713,
					"content": "Riflettere è un compito molto difficile, sai? Credimi, preferirei di gran lunga ripulire la città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980717,
					"content": "E quindi su cosa stai riflettendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980718,
					"content": "Sull'Ordine dell'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980719,
					"content": "Un drago semina il caos a Mondstadt e la Gran Maestra Reggente abbandona la città per affrontare la minaccia. Se ci pensate, quale momento migliore ci sarebbe, per l'Ordine dell'Abisso, di lanciare un attacco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980720,
					"content": "Se voi faceste parte dell'Ordine dell'Abisso, sfruttereste questa enorme opportunità mandando soltanto qualche Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980721,
					"content": "Hai ragione, c'è qualcosa che non quadra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "Volendo andare in fondo alla questione, avevo deciso di aspettare. Così ho atteso la loro prossima mossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980724,
					"content": "Poi è arrivato il giorno in cui avete seminato il caos nel Covo di Terrore alato, proprio mentre le urla degli Hilichurl riecheggiavano dai cancelli della città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980725,
					"content": "Quello stesso giorno ho visto delle persone poco raccomandabili aggirarsi in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980726,
					"content": "Sono entrati in città?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980727,
					"content": "Beh, tutti gli altri cavalieri erano fuori a combattere e, come potete immaginare, non c'era nessuno a proteggere la città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980728,
					"content": "A parte me, ovviamente. E così mi sono avvicinato agli infiltrati dell'Ordine dell'Abisso per fare... due chiacchiere, diciamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980729,
					"content": "Dopo aver adottato varie misure, sono riuscito a estorcere loro delle informazioni molto interessanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980730,
					"content": "La situazione è questa: l'Ordine dell'Abisso... ha ora un singolo capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980731,
					"content": "L'Ordine dell'Abisso ha un capo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980732,
					"content": "Sì. Ed è stato il loro capo a escogitare il piano per trasformare Dvalin in un'arma da guerra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980733,
					"content": "Come hai fatto a ottenere queste informazioni?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980734,
					"content": "Eheheh... Diciamo che sono molto abile con le parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980735,
					"content": "#E non solo... I membri dell'Ordine dell'Abisso hanno un nome in codice per {F#colui}{M#colei} che li governa... {F#Lo}{M#La} chiamano \"Sua Altezza reale\", {F#lo}{M#la} considerano come {F#il}{M#la} loro {F#principe}{M#principessa}\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980736,
					"content": "#{F#Un principe}{M#Una principessa}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "Beh, mi dispiace dover interrompere questa discussione, ma credo che Amber stia venendo da questa parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980738,
					"content": "Penso che sia ancora arrabbiata con me per essere sparito durante l'attacco nemico... Meglio che me la dia a gambe prima che mi veda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980739,
					"content": "Non appena vedo Kaeya, ecco che mi sparisce da sotto il naso! Mi sembra chiaro che si sente in colpa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980740,
					"content": "Lui agisce lontano da occhi indiscreti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "Lo pensi davvero? Perché questo è esattamente quello che direbbe lui per tirarsi fuori dai guai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980744,
					"content": "Basta parlare di lui. Oggi ho lavorato senza sosta e la mia pancia sta cominciando a brontolare. Forza, andiamo a mangiare qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980745,
					"content": "Ciao, Sara! Un piatto di arrosto al miele, per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980742,
					"content": "È veramente un cialtrone!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "Esatto. Nonostante sia il capitano della cavalleria, dà veramente un pessimo esempio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980722,
					"content": "C'è sicuramente qualcosa che non sappiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "Cosa stai tramando questa volta...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "Io? Assolutamente nulla. Al contrario, sto cercando di capire cosa stanno tramando gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980716,
					"content": "Ed è per questo che sono qui, in un posto tranquillo in cui dove posso riflettere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980705,
					"content": "Ma guarda chi c'è, l'affascinante signor Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "Ah, quindi provi qualcosa per me. Pensa che gli altri dicono che non sono tutto questo granché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 39809,
			"completionStepIds": [
				39809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39809",
							"2"
						],
						"stepId": 39809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980901,
					"content": "Quindi, ora che la minaccia di Terrore alato è stata scongiurata, cosa avete intenzione di fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980902,
					"content": "#Paimon crede che sia arrivato il momento di andare via da Mondstadt e continuare a perlustrare le sette nazioni finché non troviamo degli indizi su {F#suo fratello}{M#sua sorella}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980903,
					"content": "Uh, davvero? Oh... Beh, allora immagino che questo sia un addio, almeno per ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980904,
					"content": "Mi mancherà Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "#Ehi, non ti buttare giù! Sarai per sempre {F#un'amica}{M#un amico} dei Cavalieri di Favonius, nonché nostr{F#a}{M#o} Cavaliere Onorari{F#a}{M#o}, dovunque tu sia e ovunque soffierà il vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980907,
					"content": "Che il vento sia la tua guida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "Così ti voglio! Ricorda, Mondstadt ti accoglierà sempre a braccia aperte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980910,
					"content": "Dai, adesso mangiamo prima che si raffreddi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980911,
					"content": "Gnam, è stato delizioso! Promemoria per Paimon: vale la pena aspettare di mangiare in un posto consigliato da Amber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980912,
					"content": "Ma certo! Anche se ai fornelli non penso di essere brava, vi porterò sempre in un posto in cui si mangia bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980913
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980913,
					"content": "Oh, quasi dimenticavo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980914
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980914,
					"content": "Jean vi sta aspettando alla <color=#00E1FFFF>cattedrale</color>. Vuole parlarvi di qualcosa che riguarda la Lira sacra celeste... Vi consiglio di andarci adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980908,
					"content": "Tornerò a trovarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980905,
					"content": "Mi mancherà l'Ordine di Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				}
			]
		},
		{
			"id": 39810,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
