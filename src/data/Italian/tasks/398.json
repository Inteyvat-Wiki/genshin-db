				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "#Siete tornati! {F#La}{M#Il} Cavaliere Onorari{F#a}{M#o} fa il suo ritorno trionfale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980102,
					"content": "#Sì, {NICKNAME} è tornat{F#a}{M#o} dopo aver combattuto con Dvalin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980103,
					"content": "#Siete tornat{F#e}{M#i} ieri, vero? Jean è arrivata prima di voi e ci ha raccontato tutte le vostre gesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980104,
					"content": "*sospira* Chissà se avrò mai un'opportunità del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980105,
					"content": "È tutto merito tuo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "Ma non è assolutamente vero. È giusto che vi prendiate tutto il merito per aver risolto questa emergenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980107,
					"content": "#Quando vi ho portat{F#e}{M#i} in città quel giorno, stavo solamente facendo il mio dovere di Vigilante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980111,
					"content": "#Prego! Ma... ci hai aspettat{F#e}{M#i} qui per tutto questo tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980112,
					"content": "Certo che no! Anche se non combatto in prima linea, non significa che io non abbia niente da fare... Infatti, al momento, mi sto occupando delle conseguenze dovute all'emergenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980113,
					"content": "Conseguenze? Qui? Cos'è successo a Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980114,
					"content": "Mentre la maestra Jean si trovava fuori città, i mostri appostati nelle vicinanze hanno lanciato un attacco coordinato contro Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980115,
					"content": "Fortunatamente, non ci hanno colto del tutto impreparati. Avevo già percepito che degli Hilichurl si stessero avvicinando alla città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980116,
					"content": "#Oh, sì! Paimon si ricorda. La prima volta che ci siamo incontrat{F#e}{M#i}, ti stavi sbarazzando di uno dei loro accampamenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980117,
					"content": "Esatto. E se non ci fossimo preparati in anticipo, a quest'ora Mondstadt si sarebbe trovata in grande pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980118,
					"content": "#Sono content{F#a}{M#o} che tu li abbia sconfitti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "Anch'io lo sono. Ma ho come la sensazione che non siamo ancora del tutto fuori pericolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980120,
					"content": "Di solito gli Hilichurl non attaccano mai in modo coordinato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980123,
					"content": "C'è probabilmente l'Ordine dell'Abisso dietro a tutto questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980124,
					"content": "Pensi che abbiano preso il controllo degli Hilichurl? Mmh... Menomale che abbiamo salvato Dvalin, altrimenti anche lui sarebbe potuto finire dalla loro parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980125,
					"content": "Esatto. E in quanto Vigilante, è compito mio tenere d'occhio l'Ordine dell'Abisso d'ora in poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980126,
					"content": "Argh, scusate. Dovreste festeggiare la vostra vittoria, non starvene qui ad ascoltare questi discorsi seri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980127,
					"content": "Mmh... Prima che tutti venissero coinvolti nell'emergenza causata da Terrore alato, vi avevo promesso che vi avrei offerto dell'arrosto al miele, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980128,
					"content": "Questo è il momento perfetto! Avete fame?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980129,
					"content": "Assolutamente sì! Tu potresti anche essertene scordata, ma Paimon no di sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980130,
					"content": "Perfetto, andiamo! È da tantissimo tempo che non mangio dell'arrosto al miele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980131,
					"content": "Ci vediamo al <color=#00E1FFFF>Buon Cacciatore</color>. Vi raggiungo subito, il tempo di dare una pulita veloce qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980121,
					"content": "Cosa li ha spinti a fare una cosa del genere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "Strano, vero? Di solito gli Hilichurl non attaccano mai in modo coordinato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980108,
					"content": "Credimi, non è un'opportunità che vorresti avere spesso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "Non hai tutti i torti. La pace è un qualcosa che si ottiene con molta fatica e non dovremmo mai darla per scontata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980110,
					"content": "E stavolta è te che noi tutti dobbiamo ringraziare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				}
			]
		},
