			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "Quindi la vera identità di Terrore alato è Dvalin, uno dei Quattro Venti! Non ci saremmo mai dovuti dimenticare del suo sacrificio per Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980202,
					"content": "Gli eventi negativi hanno sempre un risvolto positivo. Siamo felici che i nostri rapporti con il Drago d'Oriente non si siano inaspriti così tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980203,
					"content": "Ed è tutto merito tuo. Ovviamente dobbiamo anche ringraziare Jean per la sua encomiabile devozione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980204,
					"content": "Finché i Cavalieri di Favonius ci proteggeranno, la pace e la libertà regneranno sovrane su Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
