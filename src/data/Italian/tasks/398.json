			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "Lunga vita a voi! Il peggio è finalmente passato, vi ringrazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980302,
					"content": "Molte rotte commerciali sono state interrotte a causa dell'incidente causato da Terrore alato. Possiamo andare avanti senza frutta e verdure fresche, per ora... ma saremmo spacciati qualora il vino dovesse finire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980303,
					"content": "Non riesco proprio a immaginare un mondo senza vino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980304,
					"content": "Spero che ripristinino presto le rotte commerciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
