	"talks": [
		{
			"id": 39801,
			"completionStepIds": [
				39801
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39801",
							"2"
						],
						"stepId": 39801,
						"stateName": "QUEST_STATE_UNFINISHED"
