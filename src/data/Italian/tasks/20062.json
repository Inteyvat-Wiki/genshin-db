			"dialogs": [
				{
					"id": 200620301,
					"content": "Hai trovato dei manichini d'addestramento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620302,
					"content": "Sì, però...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "Mmh... Sembra che ci abbia messo un po' troppa forza. Non so come hai fatto a rompere un oggetto di legno così robusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620304,
					"content": "Suppongo che nessuno si trattenga di fronte a qualche bastone di legno nel bel mezzo di una battaglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620305,
					"content": "Non posso darlo a Ellin in queste condizioni. Ma è un legno di qualità, con un po' di lavoro dovrebbe andar bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620306,
					"content": "L'ho sistemato, anche se con qualche difficoltà... Non è male, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620307,
					"content": "Tutto grazie a te, in fin dei conti. Ecco il tuo compenso. Come promesso, non accetto favori gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620308,
					"content": "Si può smettere di fare gli avventurieri, ma non si smette mai di rispettarne il codice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
