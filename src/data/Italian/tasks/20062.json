				{
					"id": 200620401,
					"content": "Hai trovato dei manichini di legno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620402
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620402,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620403
					]
				},
				{
					"id": 200620403,
					"content": "Ellin si sta addestrando lontano da qui, e questa è l'unica cosa che posso fare per lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620404
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620404,
					"content": "Se fossi ancora un avventuriere, lo farei io stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620405
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620405,
					"content": "Visto lo stato attuale della Gilda degli avventurieri di Mondstadt, anche la maggior parte dei miei ex compagni di avventura ha abbandonato questo mestiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620406
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620406,
					"content": "Non c'è molto da fare. Attualmente sono i Cavalieri di Favonius ad andare per la maggiore, tutti i giovani vogliono entrare nel loro ordine. D'altro canto, l'idea di affrontare la natura selvaggia da soli nei panni di avventuriere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620407
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620407,
					"content": "Non piace più a nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
