			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "Cosa posso fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620102,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "Niente, è che... Mia figlia Ellin vuole entrare nell'ordine dei Cavalieri di Favonius. Adesso si sta allenando per le selezioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620104,
					"content": "*sospira* Speravo davvero di poterle fare da mentore, ma non mi crede quando le dico che sono stato un avventuriere. Vuole allenarsi da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620105,
					"content": "Non posso neanche fare nulla per dimostrarle che non sto mentendo... Una volta che ti sposi e hai dei figli, sarebbe da egoisti e sconsiderati continuare a prendere parte a pericolose avventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620106,
					"content": "Le mie responsabilità nei confronti della mia famiglia hanno la priorità sull'avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620107,
					"content": "In fondo, però, sono pur sempre un avventuriere, e credo di saperci ancora fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620108,
					"content": "Una volta, durante un'avventura, ho notato questi manichini di legno che gli Hilichurl usano per addestrarsi nel combattimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620109,
					"content": "Sembrano piuttosto robusti... Sono sicuro che sarebbero perfetti anche per l'addestramento di Ellin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620110,
					"content": "Potresti andare a recuperare qualche manichino d'addestramento degli Hilichurl per me? Naturalmente, non violerò il codice degli avventurieri e ti ricompenserò. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620111,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "Questo è lo spirito giusto! Ah, ero proprio come te quando sono entrato nella Gilda, pronto a tutto! E quando dico tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620114,
					"content": "Ehm. Sto scherzando, ovviamente! Ora vai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620112,
					"content": "Sono solo degli Hilichurl, ce la puoi fare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "Non posso. Anche gli avventurieri hanno dei limiti... C'è un limite alle avventure che si possono affrontare in contemporanea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620116,
					"content": "La vita matrimoniale è un'avventura più che sufficiente per essere affrontata da sola, non importa chi tu sia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620117,
					"content": "Quindi, se per te non è un problema... Lascio a te gli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
			"id": 2006202,
			"completionStepIds": [
				2006204
