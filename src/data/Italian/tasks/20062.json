				"objectNames": [
					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620501,
					"content": "Mmh, qual è il modo migliore per allenarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620502,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "Mi sto allenando per le selezioni dei Cavalieri di Favonius. Ma non riesco a fare progressi e non ho nessuno che mi insegni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620504,
					"content": "Mio padre continua a proporsi come mentore, dice che era un avventuriere... Ma chi ci crede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620505,
					"content": "È impossibile che uno come mio padre mi aiuti a superare le selezioni dei Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620506,
					"content": "Poi ha detto che mi avrebbe procurato una specie di attrezzatura per l'addestramento. Non ho idea di cosa possa avere in mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2006206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
