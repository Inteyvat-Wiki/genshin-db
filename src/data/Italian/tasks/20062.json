			},
			"dialogs": [
				{
					"id": 200620601,
					"content": "Wow, questo manichino di legno è davvero buono. In questo modo, l'addestramento sarà più semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620602
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620602,
					"content": "Chissà mio padre dov'è riuscito a recuperare un manichino d'addestramento così robusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620603
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620603,
					"content": "È impossibile che l'abbia comprato... Sarebbe costato troppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
