				"points": []
			},
			"dialogs": [
				{
					"id": 200620201,
					"content": "Hai trovato dei manichini d'addestramento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620202,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "Oooh, bene... Sì, questi sono belli robusti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620204,
					"content": "Se riescono a resistere agli attacchi di un Hilichurl, dovrebbero essere in grado di sopportare qualsiasi cosa Ellin possa sferrargli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620205,
					"content": "Grazie! Come stabilito dal codice degli avventurieri, ecco a te la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
			"id": 2006203,
			"completionStepIds": [
				2006207
