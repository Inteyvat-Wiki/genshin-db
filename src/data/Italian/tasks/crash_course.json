			},
			"dialogs": [
				{
					"id": 3071501,
					"content": "Straordinario! Ottima prestazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071502,
					"content": "#Mi sorprendi: sei {F#una}{M#un} cavaliere ben addestrat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071503,
					"content": "È stato un autentico spettacolo vederti in battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071504,
					"content": "Grazie, mi fa piacere sentirtelo dire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "Ahah, vedo che hai già fatto tua la virtù della modestia, tipica dei cavalieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071507,
					"content": "Per tutta Mondstadt, per anni e anni a venire, si narreranno le gesta eroiche da te compiute per salvare la Città della Libertà dalla distruzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071508,
					"content": "Vieni a trovarmi al quartier generale quando avrai tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071509,
					"content": "Conosco anche una bella taverna, se preferisci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071505,
					"content": "Nulla di cui complimentarsi...",
