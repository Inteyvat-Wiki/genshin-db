					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 710201004,
					"content": "A dire il vero... avevo iniziato a tenerne traccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201005
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 710201005,
					"content": "...Ma poi si è aggiunto anche il rapporto sulle merci importate, il rapporto sugli equipaggi, il rapporto sulla dogana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201006
					],
					"speakerTitle": "An il Nervoso"
				},
				{
					"id": 710201006,
					"content": "Ci sono così tante cose a cui stare dietro... Riferisci questo, segnala quest'altro... Non ce la faccio a fare tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "An il Nervoso"
				}
			]
		},
