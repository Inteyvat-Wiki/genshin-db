			"dialogs": [
				{
					"id": 711149940,
					"content": "Dopo avere scacciato i Cacciatori di tesori, conduci il gruppo di persone in un padiglione lì vicino per fargli riprendere fiato.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 711140801,
					"content": "Grazie, non so proprio come esprimervi la mia gratitudine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140802
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140802,
					"content": "Tu sei... la signora Qiu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140803
					]
				},
				{
					"id": 711140803,
					"content": "#Ah... Sei tu, {NICKNAME}! Che strano incontrarci di nuovo! Da non credere... È la seconda volta che mi fai un enorme favore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140804
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140804,
					"content": "Non eravate andati a Fontaine per imparare a girare i film? Come mai siete già di ritorno a Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140805,
					"content": "Avete già capito come diventare registi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140806
					]
				},
				{
					"id": 711140806,
					"content": "Beh, in realtà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140807
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140807,
					"content": "Diciamo che è più realistico affermare che siamo stati costretti a fare un po' di Mora facili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140808
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140808,
					"content": "Voi due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140809
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140809,
					"content": "Il signor Geisert è senza dubbio un regista eccezionale e ci ha dato un sacco di consigli molto utili. Tuttavia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140810
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140810,
					"content": "I film che ci ha aiutato a realizzare erano tutti incentrati su grandi idee e temi importanti. Mentre la trama, o comunque il mondo e gli aspetti che dovevano venire rappresentati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140811
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140811,
					"content": "Beh... Come direbbe il signor Geisert, sono rimasti \"dietro le quinte\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140812
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140812,
					"content": "Fin dal principio, noi ci eravamo interessati alla regia perché volevamo creare un film per promuovere gli eccezionali tè della Vallata Chenyu. Se fossimo rimasti con il signor Geisert, non saremmo andati da nessuna parte. Quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140813
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140813,
					"content": "Quindi... Ho deciso che ci saremmo presi una pausa dai nostri studi e che saremmo tornati per filmare un documentario. Sfrutteremo quest'opportunità per mettere alla prova ciò che abbiamo imparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140814
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140814,
					"content": "Senza contare che abbiamo dato fondo al budget...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140815
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140815,
					"content": "E-Ehi! Dovresti avere capito il mio piano! Se questo documentario avrà successo, recupereremo il nostro investimento in men che non si dica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140816
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140816,
					"content": "#Comunque, ci siamo ritrovati circondati da un gruppo di Cacciatori di tesori su un ponte sospeso. Per fortuna, {M#il}{F#la} grande {NICKNAME} è {F#venuta}{M#venuto} in nostro soccorso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140817,
						711140818
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140817,
					"content": "Non siamo un po' lontani dal Villaggio di Qiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140818,
					"content": "Perché siete qui se volete fotografare il Villaggio di Qiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140819,
					"content": "*sospira* Beh, volevo inserire delle panoramiche maestose, così il film sarebbe sembrato un po' più imponente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140820
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140820,
					"content": "Ma durante le riprese ci siamo distratti troppo e abbiamo attirato l'attenzione di quei Cacciatori di tesori. Siamo fuggiti fino a qui, ma ci hanno comunque circondati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140821
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140821,
					"content": "Un attimo... Quindi i \"fotografi professionisti\" di cui parlava Woliu prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140822,
					"content": "Esatto, erano la signora Qiu e i suoi assistenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140823
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140823,
					"content": "D-Da dove è uscita fuori, signorina Woliu? G-Giuro che non l'avevo vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140824
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140824,
					"content": "Mi so nascondere molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140825
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140825,
					"content": "Quindi vi conoscete già...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140826
					]
				},
				{
					"id": 711140826,
					"content": "Beh, la signorina Woliu è un'esperta idrologa. Nessuno conosce queste terre meglio di lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140827
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140827,
					"content": "L'abbiamo già consultata diverse volte per trovare i punti migliori per le riprese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140828
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140828,
					"content": "Abbiamo anche cercato di convincerla a unirsi a noi, ma lei ha risposto che ci avrebbe pensato una volta finito quello che stava facendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140829
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140829,
					"content": "Capo, ehm... Prima, quando siamo scappati... Credo che, ehm, abbiamo lasciato per terra il contenitore con tutto il girato e le attrezzature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140830
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140830,
					"content": "Credo... che tutto il lavoro che abbiamo fatto sia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140831
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140832
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140832,
					"content": "#Signorina Woliu! {NICKNAME}! Paimon! Grazie di tutto! Q-Quando avrete tempo, venite a trovarmi al Villaggio di Qiaoying!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140833
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140833,
					"content": "Dopotutto... ci avete salvato la vita, quindi vi meritate una ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140834
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140834,
					"content": "Adesso però dobbiamo proprio andare. Forza! Dove abbiamo lasciato quella cassa?! Dobbiamo tornare a prenderla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140835
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140835,
					"content": "La signora Qiu e i suoi assistenti si allontanano di fretta...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711140836
					]
				},
				{
					"id": 711140836,
					"content": "Quell'attrezzatura deve averne viste di tutti i colori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140837,
					"content": "Dicono che spesso il lieto fine arrivi dopo grandi fatiche. Di certo il film della signora Qiu sarà un successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140838
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140838,
					"content": "A ogni modo, prendete questo come ricompensa. Collocherò io l'ultimo strumento, poi credo che andrò a vedere come se la cava la signora Qiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140839
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140839,
					"content": "Devo trovarla in fretta, oppure sparirà di nuovo per andare a girare il suo film.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140840
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140840,
					"content": "Mmmh... Aveva detto che sarebbe stata al Villaggio di Qiaoying. La cercherò lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
