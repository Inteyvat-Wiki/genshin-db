						],
						"pointId": 7469
					}
				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "...Questi cambi dovrebbero fare al caso nostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140402,
					"content": "Ah, avete già fatto? Grazie mille davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140403,
					"content": "Una volta posizionato anche questo, ti darò la ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140404,
					"content": "Avresti potuto darmeli tutti insieme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "Sei molto gentile. Purtroppo questo strumento è piuttosto speciale: richiede regolazioni e calibrazioni aggiuntive, ed era un disturbo che non volevo darti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140406,
					"content": "Andiamo fino a quella collina e piazziamolo. Poi ti darò la ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140407,
					"content": "Sembra molto difficile... Lavori sempre in queste condizioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140408,
					"content": "Ahah! Se non altro, questa volta si tratta solo di posizionare i dispositivi nel terreno. In una spedizione precedente, ho dovuto capire come posizionare un dispositivo al centro di un fiume impetuoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140409,
					"content": "Non potevi raggiungere il punto con una barca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "Beh, se avessi dovuto solo gettare lo strumento in acqua, sì: sarebbe bastato prendere una barca, mollare il dispositivo al centro del fiume e tornare indietro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140411,
					"content": "Ma stavo cercando di misurare l'intensità del flusso del fiume, quindi dovevo mantenere lo strumento fermo al centro del corso d'acqua evitando sia che galleggiasse verso il pelo dell'acqua sia che affondasse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140412,
					"content": "Per fortuna, il fiume era attraversato da un ponte sospeso. Se non ci fosse stato, avrei dovuto chiedere aiuto per tendere una corda tra le due montagne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140413,
					"content": "Poi avrei dovuto appendere il dispositivo e usare un'altra corda per spostarlo al centro del fiume e calarlo in acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140414,
					"content": "Comunque non è importante... È un problema che non ci riguarda... Detto ciò, anche questa volta passeremo su un ponte sospeso durante il tragitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140415,
					"content": "Per di qua. Il ponte sospeso non è distante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
