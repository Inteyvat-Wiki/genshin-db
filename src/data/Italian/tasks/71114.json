			"dialogs": [
				{
					"id": 711140901,
					"content": "*sospira* Forse avremmo davvero fatto meglio a portare con noi le riprese del Villaggio di Qiaoying...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140902,
					"content": "Va tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#Ah, {NICKNAME}, Paimon! Grazie a voi, siamo riusciti a salvare tutte le nostre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140905,
					"content": "Credo però che, qualora in futuro tornassimo in quell'area, dovremo farci scortare da qualche avventuriere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140906,
					"content": "Allora, ehm, come stanno andando le riprese del documentario sul tè?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140907,
					"content": "Beh... Al momento abbiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140908,
					"content": "Una buona sequenza di apertura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140909,
					"content": "E una buona visione artistica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140910,
					"content": "Quindi... Non avete girato un granché...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "In realtà... Ultimamente siamo un po' a corto di denaro. Il signor Geisert è un regista rinomato, e la sua consulenza non è proprio economica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140912,
					"content": "Anche se abbiamo già girato dei corti che ci hanno fruttato un po' di Mora, un film così lungo si risucchia tutto il nostro budget all'istante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140913,
					"content": "Soprattutto considerato che il capo ha rifiutato alcuni sponsor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140914,
					"content": "Nonché molte proposte di collaborazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140915,
					"content": "Ehi, cosa ne sapete voi due?! Ho fatto queste scelte solo per creare un film di alta qualità che rispecchi i nostri standard e la nostra visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140916,
					"content": "Ma, capo... Non avevamo creato questa casa di produzione per fare soldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140917,
					"content": "Io... Smettila di preoccuparti per i soldi adesso! Vai a preparare le attrezzature!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}, ecco la ricompensa. Grazie per il tuo costante aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140919,
					"content": "Quando avrò realizzato il film dei miei sogni, ti inviterò alla prima e poi ti porterò fuori a bere del tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140920,
					"content": "Yifeng, Xingye, cercate l'angolazione migliore per la luce! Faremo un'unica ripresa, capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140921,
					"content": "Ma, capo, non abbiamo neppure degli attori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140922,
					"content": "Riuscire a filmare un paesaggio in un'unica ripresa non è un po' troppo azzardato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140923,
					"content": "M-Muovetevi e preparate l'attrezzatura! Poi aspettate qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 711140903,
					"content": "Almeno sembra che non abbiate perso l'attrezzatura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
		},
