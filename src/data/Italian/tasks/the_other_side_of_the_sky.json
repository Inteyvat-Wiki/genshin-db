						],
						"pointId": 8612
					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "Siamo... vivi! Che bello sentire di nuovo il terreno sotto i piedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360102,
					"content": "Ma tu stai fluttuando in aria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "Ehi, ma c'è un'enorme differenza tra il fluttuare a un metro da terra e il volare nel cielo aperto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360104,
					"content": "Comunque sia, il \"terreno\" non sembra molto solido.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#Non spaventare Paimon! Se cadremo, Paimon non riuscirà a tirare su te e {REALNAME[ID(2)|SHOWHOST(true)]} insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360106,
					"content": "Groar... Glu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751360107,
					"content": "È la Tonatiuh? Ce l'abbiamo fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360108,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "Sembra più un gigantesco gomitolo di lana che una nave! Oppure dei serpenti, a vedere tutte quelle linee ingarbugliate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360110,
					"content": "Proviamo a volare fin laggiù, sembra più sicuro. Uhm, dov'è finita Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360111,
					"content": "Ha detto di avere molta esperienza di volo, ma Paimon è comunque preoccupata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360112,
					"content": "Fintanto che la direzione del vento era corretta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "Hai ragione, se ha seguito il vento, probabilmente sarà atterrata qui vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360114,
					"content": "Se resteremo qui non lo sapremo mai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "Giusto, rimettiamoci in marcia. Forse ci sta già aspettando sulla nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360116,
					"content": "Andiamo, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
