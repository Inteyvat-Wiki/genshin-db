			"dialogs": [
				{
					"id": 751360301,
					"content": "#{NICKNAME}, Paimon e {REALNAME[ID(2)|SHOWHOST(true)]}, eccovi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360302
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360302,
					"content": "Hihi, Bona, Paimon è felice di vedere che stai bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360303,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360304
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360304,
					"content": "Eh? Paimon che si preoccupa per me? Tranquilla! Sono la migliore avventuriera del Clan Piumafiore, e ci vuole ben altro per abbattere qualcuno come me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360305
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360305,
					"content": "In ogni caso, sono felice che tu stia bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360306
					]
				},
				{
					"id": 751360306,
					"content": "Eheh, forse è anche merito tuo. Da quando ti conosco, la fortuna continua a sorridermi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360307,
					"content": "Dopo che ci siamo separati in mezzo alle nuvole, sono stata scagliata su una roccia fluttuante e ho perso i sensi. Non so per quanto tempo sia rimasta svenuta, ma quando ho riaperto gli occhi ero qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360308
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360308,
					"content": "Come sei finita qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360309
					]
				},
				{
					"id": 751360309,
					"content": "Beh, dopo che ci siamo separati in mezzo alle nuvole, sono stata scagliata su una roccia fluttuante e ho perso i sensi. Non so per quanto tempo sia rimasta svenuta, ma quando ho riaperto gli occhi ero qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360310
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360310,
					"content": "Quando mi sono svegliata vi ho cercato ovunque, ma non riuscivo a trovarvi, così ho pensato che... Bando alle ciance, pare che siate più forti di quanto sembrate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360311
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360311,
					"content": "Woah, Paimon stava giusto per chiederti come fossi arrivata quassù. Queste sono tutte isole fluttuanti isolate. Hai volato fin qui o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360312,
					"content": "Eheh, ne parleremo più tardi. Comunque, questa è la Tonatiuh che stavamo cercando. La nostra avventura è stata un grande successo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360313
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360313,
					"content": "Mm, ma a giudicare dall'aspetto di questo posto, non sembra che ci siano dei tesori sparsi dappertutto come dicono le leggende. Che sia già venuto qualcun altro a prenderli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360314,
					"content": "Scommetto che i cosiddetti tesori della Tonatiuh non sono che storielle inventate dai cantastorie della tribù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360315
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360315,
					"content": "Eh? Ma come?! Stai dicendo a Paimon che siamo venuti qui per niente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360316,
					"content": "La storia dei tesori potrebbe essere un'invenzione, ma non significa che la Giada del ritorno che cerchiamo non sia qui. Teniamo viva la speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360317
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360317,
					"content": "E poi, guardate quella cosa lassù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360318
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360318,
					"content": "Sembra che ci sia qualcosa all'interno, vero? Avete appena trovato una Pyrofosforite nel Cuore del Chu'ulel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360319,
					"content": "Sulla base della mia esperienza di avventuriera, seguendo quella logica, è ragionevole pensare che la Giada del ritorno che stiamo cercando sia lì dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360320
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360320,
					"content": "In tal caso, dobbiamo trovare un modo per salire lassù e aprirla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360321,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360322
					]
				},
				{
					"id": 751360322,
					"content": "Aspetta un attimo, non è così semplice come credi! Ci ho già provato. Non è qualcosa che puoi distruggere con la mera forza bruta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360323
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360323,
					"content": "Qualcosa mi dice che non sarà così semplice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360324
					]
				},
				{
					"id": 751360324,
					"content": "Già, non sembra qualcosa che possiamo rompere usando solamente la forza bruta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360325
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360325,
					"content": "La mia esperienza di avventuriera mi suggerisce che qui intorno dovrebbe esserci un qualche tipo di meccanismo, proprio come quando abbiamo trovato la Pyrofosforite prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360326
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360326,
					"content": "A proposito di meccanismi, questo dev'essere quello che cerchiamo! È identico a quello dell'Altare della Fiamma primordiale che abbiamo visto prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360327
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360327,
					"content": "Che coincidenza... Anzi, non può trattarsi di una coincidenza, dev'essere un indizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360328
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360328,
					"content": "Se è un indizio, forse dovremmo provare a usare la Pyrofosforite... Uh, ma non ne abbiamo più, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360329,
					"content": "#Quella che ha {REALNAME[ID(2)|SHOWHOST(true)]} non è una Pyrofosforite...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360330
					]
				},
				{
					"id": 751360330,
					"content": "Ah, giusto... L'abbiamo trovata mentre venivamo qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360331,
					"content": "Grandioso! Conoscete il principio della \"chiave dell'avventuriere\"? Afferma che l'oggetto necessario per completare ogni avventura si ottiene sempre al suo inizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360332
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360332,
					"content": "Paimon non ci capisce niente! E poi, il tempismo è fin troppo perfetto! Eppure, questa sembra davvero una Pyrofosforite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360333,
					"content": "Beh, a parte il crepitio e le fiamme, Paimon pensa che siano esattamente identiche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360334,
					"content": "Wow, hai ragione, Paimon! Non l'avrei mai notato, se non fosse stato per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360335
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360335,
					"content": "È proprio questo il tuo problema! Quindi, in pratica, basterà raccogliere delle pietre come questa, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360336,
					"content": "Beh, se sono queste Fiammoliti che stiamo cercando, su questa nave ce ne sono quattro in totale. Una dovrebbe essere sull'isola fluttuante di fronte a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360337
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360337,
					"content": "Ooh... Aspetta, Bona, come fai a sapere tutte queste cose? È come se fossi già stata qui. Anche con la tua esperienza di avventuriera, Paimon sente che c'è molto più di questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360338,
					"content": "Uh, come posso dire...? Credo sia una specie di premonizione. Non so perché ma, appena ho visto questo Altare, ho capito subito come funzionava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360339
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360339,
					"content": "Stavo già investigando qui ancora prima di incontrarvi. In quanto brava avventuriera, condurre un'indagine preliminare accurata è d'obbligo, non credete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360340
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360340,
					"content": "Capisco. S'impara qualcosa di nuovo ogni giorno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360341
					]
				},
				{
					"id": 751360341,
					"content": "#Aspetta, quindi hai usato la forza bruta fino a questo momento, {NICKNAME}...? Saper combattere dev'essere bello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360342
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360342,
					"content": "Per fortuna, faccio sempre affidamento sulla forza bruta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360343
					]
				},
				{
					"id": 751360343,
					"content": "Beh, sei davvero speciale, lo sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360344
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360344,
					"content": "A proposito, come faremo ad arrivare lì? Sembra un po' complicato, persino per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360345,
					"content": "Eheh, non mi avevi chiesto come fossi arrivata fin quassù? Ti mostrerò cosa ho scoperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360346
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360346,
					"content": "Beh, che te ne pare? Utilizzando questo meccanismo, possiamo spostarci liberamente da un'isola fluttuante all'altra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360347
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360347,
					"content": "Conto su di voi per trovarle. Se arrivate su un'altra isola fluttuante e non riuscite a tornare qui, fatemi un fischio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360348
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360348,
					"content": "#Bene, e lasceremo a te il compito di custodire le Fiammoliti, {REALNAME[ID(2)|SHOWHOST(true)]}. Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360349,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
		{
