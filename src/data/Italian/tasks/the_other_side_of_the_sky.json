				]
			},
			"dialogs": [
				{
					"id": 751360201,
					"content": "Cos'è questa pietra? Sembra Pyrofosforite, ma è tutta luminosa e fiammeggiante. Sembra molto più potente di quella di Bona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360202,
					"content": "Che questa sia la forma originale della Pyrofosforite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360203,
					"content": "Ahia! Scotta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "#Non toccare tutto quello che trovi, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360205,
					"content": "#Non me n'ero {F#resa}{M#reso} conto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "Ecco il bue che dice cornuto all'asino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#Cosa c'è, {REALNAME[ID(2)|SHOWHOST(true)]}? Sai qualcosa al riguardo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360209,
					"content": "#Santa pupazza, {REALNAME[ID(2)|SHOWHOST(true)]}! Qui potrai finalmente dare sfoggio delle tue abilità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360210,
					"content": "D'ora in poi, lasceremo che sia tu a occuparti di tutti i tesori che \"scottano\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360211,
					"content": "Iee! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360212,
					"content": "Ehi! Da questa parte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360213
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360213,
					"content": "Guarda, è Bona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360214,
					"content": "Come ci sarà arrivata? Che sia atterrata...? A ogni modo, prima andiamo laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
