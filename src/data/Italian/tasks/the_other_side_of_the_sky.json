			},
			"dialogs": [
				{
					"id": 751360401,
					"content": "Uff, chi l'avrebbe mai detto che avremmo dovuto cercare delle pietre una volta arrivati sulla Tonatiuh? Pensavo che sarebbe stata un'avventura più elettrizzante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360402,
					"content": "Comunque sia, conto su di voi per trovare quelle Fiammoliti. Se avete bisogno di qualcosa, sapete dove trovarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				}
			]
		},
		{
			"id": 7513605,
