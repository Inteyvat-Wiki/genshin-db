					{
						"sceneId": 3,
						"position": [
							-146.814,
							1328.608,
							10072.64
						],
						"pointId": 10136
					},
					{
						"sceneId": 3,
						"position": [
							-145.482,
							1329.4,
							10072.37
						],
						"pointId": 10137
					}
				]
			},
			"dialogs": [
				{
					"id": 751360501,
					"content": "Evviva, ce l'abbiamo fatta! Mm, questa è comunque un'Incisione iridescente piuttosto familiare. È la famosa Giada del ritorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360502,
					"content": "Un attimo, ma questa non è la Prece dorata? È la stessa che abbiamo trovato in precedenza sulla stele di pietra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360503,
					"content": "Rooo... Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360504,
					"content": "Wow, non credo ai miei occhi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360505
					]
				},
				{
					"id": 751360505,
					"content": "Un tesoro che può reprimere la contaminazione dell'Abisso e un amuleto in grado di rimuovere le maledizioni e i disastri... A Paimon sembrano familiari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360506,
					"content": "L'hai capito soltanto adesso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360507
					]
				},
				{
					"id": 751360507,
					"content": "Davvero?! E perché non l'hai detto subito a Paimon, se lo sapevi già? Aspetta un attimo, come facevi a saperlo? Non sarà mica un'altra delle tue \"esperienze di avventuriera\", vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360508,
					"content": "Un tesoro che può reprimere la contaminazione dell'Abisso e un amuleto in grado di rimuovere le maledizioni e i disastri... A Paimon sembrano familiari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360509,
					"content": "Ma questa cosa può davvero reprimere l'Abisso a Ochkanatlan? Paimon non ne ha mai sentito parlare da nessuno dell'Associazione delle Reliquie Sauriche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360510,
					"content": "Ora che Paimon ci pensa, dato che la Giada del ritorno è in realtà una Prece dorata, potrebbe essere che il drago malvagio ci abbia preso di mira fin dall'inizio per questo motivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360511,
					"content": "Fiuu, quindi non è stato per via dello stufato di carne abbrustolita che Paimon ha mangiato stamattina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360512,
					"content": "Pare che i pezzi del puzzle stiano tornando al loro posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360513
					]
				},
				{
					"id": 751360513,
					"content": "Sembra proprio una premonizione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360514
					]
				},
				{
					"id": 751360514,
