				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80060501,
					"content": "Come ha fatto quel fiore ad arrivare così in profondità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060502,
					"content": "L'ha portato qualcuno in memoria degli Hilichurl defunti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060503,
						80060504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060503,
					"content": "Conosco questo fiore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				},
				{
					"id": 80060505,
					"content": "Ehi, ora che mi ci fai pensare, anche per Paimon ha un'aria familiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060506,
					"content": "È un Inteyvat, il fiore nazionale di Khaenri'ah. Un tempo sbocciava in tutta la nazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060507,
					"content": "Fiorisce solo due settimane prima di iniziare ad appassire; ma se ne cogli uno e lo porti fuori da Khaenri'ah, i petali smettono di crescere e diventano duri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060508
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060508,
					"content": "Solo quando viene finalmente riportato nella sua terra natia i petali tornano morbidi, per poi diventare polvere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060509
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060509,
					"content": "Per questo motivo, l'Inteyvat è il simbolo del viaggiatore lontano da casa, che ricorda con tenerezza la patria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060510,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_Twins2Male|INFO_FEMALE_PRONOUN_Twins2Female]}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060511
					]
				},
				{
					"id": 80060511,
					"content": "*sussulta* Quindi, per arrivare qui, questo fiore dev'essere stato portato da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060512,
					"content": "Maestà... Dunque la proposta ha finalmente la sua benedizione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060513
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80060513,
					"content": "Ci siamo concentrati esclusivamente sul confronto con i Princìpi celesti, trascurando la nostra missione originale: la rinascita della patria.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060514
					]
				},
				{
					"id": 80060514,
					"content": "Non avrei dovuto indugiare così.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060515
					]
				},
				{
					"id": 80060515,
					"content": "Il dispositivo è quasi pronto, siamo in attesa di ordini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060516
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80060516,
					"content": "Quali sono le probabilità di successo?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060517
					]
				},
				{
					"id": 80060517,
					"content": "Teoricamente parlando... approssimativamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060518
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80060518,
					"content": "Lascia stare, mi basta anche solo una probabilità su cento...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060519
					]
				},
				{
					"id": 80060519,
					"content": "Siamo stati relegati nell'Abisso troppo a lungo.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060520
					]
				},
				{
					"id": 80060520,
					"content": "#Sono cert{F#o}{M#a} che loro preferirebbero tornare al più presto al naturale ciclo di vita e morte, anziché continuare a esistere in questo stato, senza un briciolo di dignità.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060521
					]
				},
				{
					"id": 80060521,
					"content": "Non possiamo lasciare che continuino a pagare il pegno... per quei cosiddetti peccati.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060522
					]
				},
				{
					"id": 80060522,
					"content": "L'Ordine è molto fortunato a poter contare sulla sua decisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060523
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80060523,
					"content": "#{F#Aether}{M#Lumine}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060524
					]
				},
				{
					"id": 80060524,
					"content": "Hai visto qualcosa, vero? Puoi dirmi cos'era?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060525
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060525,
					"content": "#Già, ti eri come incantat{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060526,
					"content": "Racconti la scena che hai appena visto a Dainsleif...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80060527
					]
				},
				{
					"id": 80060527,
					"content": "Mmmh... Beh, si dice che i gemelli abbiano un legame speciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060528
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060528,
					"content": "Sembra che stiano cercando di usare qualche aggeggio per purificare la maledizione. Potrebbe essere il dispositivo che abbiamo visto prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060529
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060529,
					"content": "E... dici che ha parlato di \"rinascita della patria\", giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060530,
						80060531
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060530,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060532,
					"content": "#Non mi stupisce, è testard{F#o}{M#a} come sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060533
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060533,
					"content": "Sembra che l'Ordine dell'Abisso voglia sfruttare questo luogo per purificare gli Hilichurl dalla maledizione e farli tornare com'erano un tempo... Così diventeranno la base per la rinascita di Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060534
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060534,
					"content": "Dopotutto, non può esistere una nazione senza un popolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060535,
						80060536
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060535,
					"content": "Cosa ne pensi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060537,
					"content": "Umpf, è pura follia... Non hanno alcuna possibilità di successo, nemmeno una su cento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060538
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060538,
					"content": "Vi ho già detto che nessuno conosce questa maledizione meglio di me, ci ho convissuto per cinquecento anni... Non c'è redenzione né modo di annullarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060539
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060539,
					"content": "Cercare di rimuoverla con la forza non porterà a nulla, se non a infliggere ulteriori sofferenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060540
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060540,
					"content": "Quindi assicuratevi di avere le idee chiare. Ricordatevelo: loro non sono più umani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060541
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060541,
					"content": "Se vi aggrappate a false speranze e vi lasciate coinvolgere troppo, l'unica via è la discesa nel baratro... Finirete proprio come loro, in balia dell'ipocrisia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060542
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060542,
					"content": "Risparmiate le forze per qualcosa che vale davvero la pena salvare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060543
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060543,
					"content": "Perché dovrei crederti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060544
					]
				},
				{
					"id": 80060544,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060545
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060545,
					"content": "#Ahah... Ma certo. Io sono solo una persona a cui hai affidato un compito, mentre {F#lui}{M#lei} è {F#tuo fratello}{M#tua sorella}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060546
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060546,
					"content": "È naturale che tu prenda le sue parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060547
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060547,
					"content": "Ma non c'è nulla che possa distogliermi dalla mia decisione. Ho scelto di fermare l'Abisso. Se abbiamo raggiunto un'impasse, allora forse è il momento di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060548
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060548,
					"content": "No... ti credo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060549,
						80060550
					]
				},
				{
					"id": 80060549,
					"content": "Ma non significa che mi fidi completamente di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060551,
					"content": "Capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060552,
						80060553
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060552,
					"content": "Una probabilità di riscatto dell'uno per cento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060554,
					"content": "Nessuno ha il diritto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060556,
					"content": "Soprattutto non quando questi Hilichurl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060558,
					"content": "Sembra che le tre domande che ti ho fatto durante il nostro primo incontro siano state utili. Hai sviluppato una visione personale di questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060559
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060559,
					"content": "Molto bene. Dal momento che hai espresso volontariamente i tuoi veri pensieri, non nasconderò i miei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060560
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060560,
					"content": "In questo momento, ho un fine più immediato che fermare l'Abisso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060561
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060561,
					"content": "In altre parole, quello che l'Abisso sta facendo qui disonora le ultime volontà di Halfdan e degli altri miei compatrioti. Non posso lasciare che accada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060562,
						80060563
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060562,
					"content": "Ti capisco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060564,
					"content": "Potremmo incappare nell'Abisso in qualsiasi momento. Restate sempre in guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060563,
					"content": "Allora restiamo uniti per questa volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060557,
					"content": "...hanno già scelto la fine che desiderano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060555,
					"content": "...di fare quella scelta per conto di un altro essere vivente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060553,
					"content": "Contro una probabilità di sofferenza e morte del novantanove per cento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060550,
					"content": "#Ma vuol dire solo che non approvo i metodi di {F#mio fratello}{M#mia sorella}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060536,
					"content": "Possono farcela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060531,
					"content": "Ha detto che era la sua missione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060504,
					"content": "Ho già visto questo tipo di fiore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				}
			]
		},
		{
			"id": 800606,
