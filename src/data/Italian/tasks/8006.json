			"dialogs": [
				{
					"id": 80060601,
					"content": "Anche da qui si vede la città capovolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060602,
					"content": "Aspettate... Attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060603,
					"content": "Aaah!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060604,
					"content": "C-Che succede? Quella luce arriva dalla stanza al centro? Ahi, è troppo intensa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060605,
					"content": "La mutazione continua... L'Abisso ha già fatto la sua mossa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060606,
					"content": "#Dainsleif... Vedo che continui imperterrito a impicciarti dei nostri affari, e che ancora una volta sei al fianco {F#della sorella}{M#del fratello} di Sua Maestà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060607
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80060607,
					"content": "Purtroppo non ho fatto in tempo a controllare la tua uscita dalla rete... e sei finito qui, tra tutti i posti. È stato un errore catastrofico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060608
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80060608,
					"content": "Tsk! Sono sorpreso che tu abbia il coraggio di affrontarmi. L'ultima volta sei scappato come un codardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060609
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060609,
					"content": "La volontà di Sua Maestà deve essere eseguita, tutte le interferenze vanno rimosse... qualunque sia il prezzo da pagare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060610
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80060610,
					"content": "Questa volta... la maledizione che tormenta il nostro popolo dovrà essere annullata, una volta per tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060611
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80060611,
					"content": "Siete voi gli unici a tormentarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060612
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060612,
					"content": "Non è rimasto nient'altro di quegli Hilichurl, a parte la maledizione stessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060613
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060613,
					"content": "Come vuoi tu... ma io non vado da nessuna parte, Dainsleif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060614
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80060614,
					"content": "Allora darai la vita solo per ritardare l'inevitabile? Che assurdità. Ma visto che insisti, così sia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
