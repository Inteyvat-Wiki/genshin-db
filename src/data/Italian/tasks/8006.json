					"nextDialogs": [
						80062102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062102,
					"content": "Ma... sembrano praticamente vuote. È perché sono così vicini alla fine che non hanno più bisogno di mangiare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062103,
					"content": "Mmh... Anche se non sentono più il bisogno di nutrirsi, Paimon scommette che comunque hanno nostalgia dei sapori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
