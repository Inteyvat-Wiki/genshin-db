			"dialogs": [
				{
					"id": 80062001,
					"content": "Qui c'è anche un falò, come quelli che gli Hilichurl costruiscono in natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062002,
					"content": "Aspetta, ma Dain non aveva detto che gli Hilichurl hanno paura della luce, quando il loro tempo sta per scadere...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062003,
					"content": "Uhm... Forse, alla fin fine, vogliono comunque vedere un po' di luce e sentire un po' di calore... Sto solo pensando ad alta voce, potrebbe anche esserci un'altra la ragione!",
					"roleType": "TALK_ROLE_NPC",
