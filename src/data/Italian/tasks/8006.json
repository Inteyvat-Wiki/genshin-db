			},
			"dialogs": [
				{
					"id": 80060401,
					"content": "È un umile accampamento di Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060402,
					"content": "Oh, anche questi Hilichurl sembrano in pessime condizioni. Alcuni sembrano aver già... esalato l'ultimo respiro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060403,
					"content": "È questo che Halfdan voleva mostrarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060404,
					"content": "Che lo sia o meno, vale la pena approfondire. Ispezionate la zona e non lasciatevi sfuggire il minimo dettaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800605,
			"completionStepIds": [
				800605,
				800609,
				800610,
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800605",
							"2"
						],
						"stepId": 800605,
