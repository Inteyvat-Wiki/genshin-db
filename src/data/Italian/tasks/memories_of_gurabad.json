				{
					"id": 733052201,
					"content": "Collegami a quel pezzo degli scacchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052202
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052202,
					"content": "C-Collegarti...? Che vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052203,
					"content": "Trova la sporgenza sulla sua superficie e inseriscila nella scanalatura della mia bottiglia. Tutto qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052204
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052204,
					"content": "Uh... C'è una scanalatura sulla tua bottiglia? A me sembra piuttosto liscia... Non ci si può inserire niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052205,
					"content": "C'è, è che tu non riesci a vederla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052206
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052206,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052207,
					"content": "Perché me la sono appena inventata...",
