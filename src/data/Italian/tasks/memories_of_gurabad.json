			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050402,
					"content": "Mmmh... Liloupar, stai bene? Perché sei così silenziosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050403,
					"content": "Shhh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "Un momento... Guarda, sta brillando. Beh, in modo diverso dal solito, almeno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050406,
					"content": "La bottiglia della djinn emette un bagliore che sembra in sintonia con le vibrazioni del pezzo degli scacchi.\\nRiesci a sentire il tempo scorrere come stille d'acqua che cadono in una prigione... Potrebbe esser passato tanto un attimo, quanto un'eternità.\\nLiloupar non proferisce parola.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "Dopodiché, una volta fuori dalla nebbia, vedi una città grande, densa e fredda.\\nDalla terra si apre una spaccatura che inghiotte l'intera Gurabad...\\nLì, incastonate tra le mura sulla collina, ci sono le sue porte. Appaiono così nauseanti che sembrano racchiudere tutto il marciume del vecchio mondo, sfuggito allo sguardo della gente...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "Quella laggiù è Gurabad. Ora ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050409,
					"content": "La testa mi fa un gran male...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "Woah, si può sapere che vi è preso? La prossima volta potreste avvertire Paimon? Il cuore di Paimon non apprezza sorprese del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050411,
					"content": "Scusa, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "Umpf! Ecco cosa succede quando Paimon si arrabbia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050415,
					"content": "#Eheh... Come sei infantile. Va tutto bene, te {F#la}{M#lo} ridarò subito, piccina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050416,
					"content": "E quando sarà il momento, ti ricompenserà dandoti tutto il cibo che vuoi e... dei \"Mura\", la vostra valuta. È così che la chiamate, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050417,
					"content": "Si chiama \"Mora\"... Aspetta, ma perché perdo tempo a correggerti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "Eheh, così si ragiona! Paimon se lo ricorderà! Cibo squisito a volontà e Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050420,
					"content": "#Bene, ora basta giocare. Andiamo a Gurabad, mi{F#a}{M#o} padron{F#a}{M#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050421,
					"content": "Perché dobbiamo andarci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "Perché? In realtà, non saprei... Forse la ragione non ha nemmeno importanza, ma devo raggiungere quel posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050423,
					"content": "#Se proprio vuoi un motivo, mi{F#a}{M#o} padron{F#a}{M#e}, è perché vorrei che assistessi al mio passato e alle lezioni che ho imparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050429,
					"content": "Quello che dici è ridicolo e Paimon non c'ha capito niente... ma da come lo dici sembra quasi che tu ci stia dicendo addio. È successo qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050430,
					"content": "Ah, nient'affatto. Vorrei solo mostrarvi delle cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050431,
					"content": "E questo cosa vorrebbe dire?! Parli in maniera criptica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050432,
					"content": "Seguitemi e basta. Vi condurrò fino a Gurabad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050424,
					"content": "Gurabad... Cosa c'è laggiù?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "Non c'è nulla. Non ne resta niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050426,
					"content": "Tutto ciò che ne rimane sono ricordi di fantasmi, sogni infranti irrecuperabili e il dolce retrogusto della vendetta... Per così dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050427,
					"content": "Mi rendo conto che è una richiesta non da poco... ma vorrei che assistessi al mio passato e alle lezioni che ho imparato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050418,
					"content": "Non mettermi in bocca parole che non ho detto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "Sto bene, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "È quello che dici sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050404,
					"content": "Liloupar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
