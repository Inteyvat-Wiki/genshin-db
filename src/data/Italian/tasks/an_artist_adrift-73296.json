			"dialogs": [
				{
					"id": 732960601,
					"content": "Ma prepariamoci prima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960602
					]
				},
				{
					"id": 732960602,
					"content": "E va bene. Prepariamoci e poi andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329608,
			"completionStepIds": [
				7329608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329608",
							"2"
						],
						"stepId": 7329608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "Che te ne pare? Bello, vero? Anche Pepe mi è parso molto felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960802,
					"content": "Dopo aver visto questo, credo che le parole sembrino superflue. Caterpillar aveva ragione. C'è un mondo così vasto al di fuori della mia scatola di metallo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960803,
					"content": "Una scatola di metallo... Hai detto che vivevi in un luogo piccolissimo a Fontaine, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960804,
					"content": "Ahem. A Sumeru c'è molto da vedere, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "Ah, certo, verissimo! Ha già deciso di diventare un vero artista, per cui magari cambiamo un po' il paesaggio per... come si dice... ampliare gli orizzonti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960806,
					"content": "Potrebbe aver detto di voler mollare, ma Paimon crede che sia ancora troppo presto! C'è ancora del tempo per pensarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960807,
					"content": "Pensaci, Julien! Potrebbero esserci paesaggi maestosi come questo, se non ancora di più! Cose che non hai mai visto! Potrebbero donarti l'ispirazione di cui hai bisogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960808,
					"content": "Per il riconoscimento dei colori, l'hai detto tu stesso! Semplicemente \"vediamo qualcosa di diverso\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960809,
					"content": "Tutti siamo capaci di apprezzare la bellezza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "Esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960811,
					"content": "Sì... Le tue parole hanno senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960812,
					"content": "Erano le tue parole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960813,
					"content": "Io... Ahah, lo sapevo. Ne ero a conoscenza, eppure ho continuato a percorrere il sentiero sbagliato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960814,
					"content": "Se ci siamo incontrati è perché Pepe ti ha portato qui, no? Quindi non è detto che si sia trattato davvero del \"sentiero sbagliato\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960815,
					"content": "#Beh, è un peccato non esser riuscit{F#e}{M#i} a farti trovare il sentiero del pellegrinaggio delle Oceanidi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960816,
					"content": "Ammesso che esista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "Ci ho sempre creduto, ma... penso anche che la mia capacità o incapacità a trovarlo non conti granché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960818,
					"content": "Dopotutto, ho già trovato la risposta che desidero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960819,
					"content": "#Grazie, amic{F#he mie}{M#i miei}. *sospira* Come potrò mai dimostrarvi la mia gratitudine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960820,
					"content": "#Se solo avessi comprato quel misterioso uovo d'uccello... Un oggetto mistico di quel tipo, in grado di scacciare la sfortuna, sarebbe di certo più utile ad avventurier{F#e}{M#i} come voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960821,
					"content": "Sembra un po' un peccato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#Un attimo, credi davvero a qualcosa di così conveniente, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960825,
					"content": "Continuerò a star qui per un po'. Questo luogo mi calma davvero l'anima. È ottimo per riflettere su sé stessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960826,
					"content": "Sento di poter disegnare qualcosa di un po' diverso questa volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960827,
					"content": "#Grazie a entramb{F#e}{M#i}, car{F#e}{M#i} amic{F#he}{M#i}. Vi auguro un viaggio senza intoppi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960823,
					"content": "Va bene, ma non penso sia necessario.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "Perché no? Anche se non sono davvero in grado di respingere la sfortuna, forse... forse avrebbe un gusto cento volte più prelibato di un uovo normale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				}
			]
		},
