			"dialogs": [
				{
					"id": 732961401,
					"content": "Una delle cose belle del lasciare la città è non dover preparare il cibo per cani. Pepe è molto bravo, comunque, e riesce a procurarsi da mangiare da sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961402
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961402,
					"content": "La cosa brutta, invece, è che mi manca qualsiasi talento con le spade e con i fornelli. Immagino che \"rifiuto urbano\" sia un nome adatto per uno come me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961403
					],
					"speakerTitle": "Julien"
				},
				{
