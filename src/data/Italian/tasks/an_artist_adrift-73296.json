				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#Paimon, {NICKNAME}, siete qui! Ah, gli amici sono essenziali quando si è in viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960202,
					"content": "Beh, eravamo d'accordo nel mostrarti la via, no? Guidare le persone è come fare un giro al parco, per noi! Anche se in questo caso si tratta di un giro nel deserto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960203,
					"content": "Ma vuoi davvero tornare a Fontaine così presto? Hai fatto tutta quella strada per venire a Sumeru... Ci sono ancora tante di quelle cose da vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960204,
					"content": "La foresta pluviale offre degli splendidi scorci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "Ci sono alberi e fiumi a non finire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960208,
					"content": "Sembra tutto molto bello, ma sento... di non essermi preparato a dovere per un viaggio simile. Questa escursione sarà anche stata un fiasco totale, ma credo di averne tratto qualche insegnamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960209,
					"content": "Oh, mmh... Se è così, ci sono anche dei bei paesaggi nelle vicinanze! Sarebbe un peccato perderseli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960210,
					"content": "I consigli di Paimon non sbagliano un colpo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "Se insistete tanto... sarebbe scortese rifiutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960212,
					"content": "Hihi. Paimon è la guida numero uno di Teyvat, quindi affidati pure a Paimon! Tu pensa solo a stare al passo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960206,
					"content": "I panorami del deserto sono davvero affascinanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "Sabbia e rovine a perdita d'occhio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329612",
							"2"
						],
						"stepId": 7329612,
						"stateName": "QUEST_STATE_UNFINISHED"
