				},
				{
					"id": 732961602,
					"content": "Sembra che sia ancora un po' troppo per Julien...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732961603,
					"content": "Beh, io mi sono appena... ripreso dalle mie ferite... *ansima*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961604
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961604,
					"content": "Ma questi paesaggi sono davvero speciali. In realtà penso sia strano che non me ne sia accorto prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961605
					],
					"speakerTitle": "Julien"
				},
				{
