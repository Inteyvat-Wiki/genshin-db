					"nextDialogs": [
						732961404
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961404,
					"content": "Dovrei concentrarmi solo sul riprendermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
