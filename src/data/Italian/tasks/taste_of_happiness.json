				},
				{
					"id": 730391002,
					"content": "Mmh... Forse potrebbe piacergli la zuppa vegetariana di ravanelli! Facciamogli vedere come cucinano i Nara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
