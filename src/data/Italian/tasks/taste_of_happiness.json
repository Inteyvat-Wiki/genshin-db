			"dialogs": [
				{
					"id": 730391101,
					"content": "Evviva! Ecco una ciotola fumante di zuppa vegetariana di ravanelli! Anche gli Aranara dovrebbero aver quasi finito di cucinare.",
					"roleType": "TALK_ROLE_NPC",
