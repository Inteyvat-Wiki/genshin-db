			},
			"dialogs": [
				{
					"id": 730390101,
					"content": "Tutti i miei fratelli hanno riflettuto su se stessi. Il Festival di Utsava è un evento felice, quindi Arapacati non dovrebbe arrabbiarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390102,
					"content": "Esatto, Arapacati. Non arrabbiarti. Bisogna celebrare gli eventi felici gustandosi il \"sapore della felicità\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730390103,
					"content": "È ora di vantarsi dei risultati della nostra pratica culinaria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390104,
					"content": "Sono nato pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730390105,
					"content": "Evviva, è il banchetto del Festival di Utsava! Paimon non vedeva l'ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730390106,
					"content": "Giusto! Il banchetto del Festival di Utsava!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "#L'acqua del Vanarana è la migliore di tutte, e grazie a essa può essere preparata la zuppa migliore al mondo. A{F#lle}{M#i} Nara piacerà di sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730390109,
					"content": "#Devo dare a Nara {NICKNAME} e a Paimon il \"sapore della felicità\", voglio che \"insegnino\" ai miei fratelli come prepararlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390110,
					"content": "#È l'unico modo per cucinare qualcosa che piaccia a{F#lle}{M#i} Nara. Gli ospiti vanno trattati bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390111,
					"content": "#Ti dispiacerebbe insegnargli a cucinare, Nara {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390107,
					"content": "Teniamo basse le aspettative...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
			]
		},
