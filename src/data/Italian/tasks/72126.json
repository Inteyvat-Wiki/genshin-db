					"content": "#Sei riuscit{F#a}{M#o} a scacciare i mostri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260302
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260302,
					"content": "Li ho messi in fuga.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260303
					]
				},
				{
					"id": 721260303,
					"content": "Grazie mille, ora posso continuare a coltivare i fiori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260304,
					"content": "Oh, quasi dimenticavo! Ecco qualcosa per te. Non è molto, ma spero che basti... Beh, grazie ancora per l'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
