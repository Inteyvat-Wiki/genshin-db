			"dialogs": [
				{
					"id": 752420401,
					"content": "Vi do il benvenuto al Resort Dolcebrezza! Vi accompagnerò ai vostri alloggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420402
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420402,
					"content": "Prendete pure questa mappa e il nostro speciale album commemorativo per gli ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420403
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420403,
					"content": "Il resort è composto da quattro aree principali: Rupi di Acquatinta, Crinale Guiztli, Baia Ondosa e Isola di Tete. Potete esplorarle a vostro piacimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752420404
					],
					"speakerTitle": "Ukucha"
				},
				{
					"id": 752420404,
					"content": "Bene, i vostri alloggi sono da quella parte. Potete andarci subito se avete bisogno di riposarvi. Se invece avete voglia di fare compere, il Mercato Dolcebrezza, la nostra attrazione più popolare, è da quella parte.",
