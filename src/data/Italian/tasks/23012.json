			"dialogs": [
				{
					"id": 230120301,
					"content": "Oh, hai recuperato il gattino. Grazie infinite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120302,
					"content": "Beh, sembra che te la stia cavando piuttosto bene con il linguaggio dei gatti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120303,
					"content": "Ecco, prendi il tuo compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120304,
					"content": "Non sono molte le persone che riescono ad apprendere il linguaggio dei gatti così velocemente. Potresti essermi d'aiuto in futuro, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120305,
					"content": "Miao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "Ehi, ora puoi tornare a parlare la nostra lingua. La signorina Sareh non è un gatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120307,
					"content": "Dalla tua espressione si capisce che volevi dire \"con piacere\", ma la tua pronuncia può ancora essere migliorata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120308,
					"content": "Ma va bene così. Continuerò a insegnarti il linguaggio dei gatti e impareremo insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				}
			]
		},
