			"dialogs": [
				{
					"id": 230121501,
					"content": "Il gattino che è scappato oggi ha il pelo nero e bianco e si chiama Lale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121502
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121502,
					"content": "Se vuoi chiamarlo nella lingua felina, devi dire: \"Miao, miao miao miao, miaaaaao!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121503
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121503,
					"content": "Ricorda di usare un tono prima discendente e poi ascendente, e assicurati di pronunciare l'ultimo \"miao\" in una tonalità più alta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121504
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121504,
