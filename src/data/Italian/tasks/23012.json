			"dialogs": [
				{
					"id": 230121101,
					"content": "Beh, ho già parlato con dei gatti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "Ti riferisci a Neko? Ma lei non conta, sa parlare la nostra lingua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121103,
					"content": "Esattamente. Tuttavia, in cambio, dovrai aiutarmi a trovare un gatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121104,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "Allora siete d'accordo anche voi? Lo apprezzo molto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121109,
					"content": "Ehm... Adesso ascoltate attentamente. Questo è un abbozzo di uno schema del linguaggio dei gatti al quale sto lavorando da molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121105,
					"content": "Sembra che ogni città abbia un suo proprio modo di cercare i gatti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Eheh, è vero! Basta pensare che ormai abbiamo aiutato varie persone a cercare i loro gatti in un bel po' di città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121107,
					"content": "Quindi possiamo dire che tutti amano i gatti, no? O comunque, che tutti coloro che possiedono un gatto hanno lo stesso problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
					],
					"speakerTitle": "Paimon"
				}
			]
