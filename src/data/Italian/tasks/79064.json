			"dialogs": [
				{
					"id": 790640601,
					"content": "Individuate persone sospette! Non so quale legge abbiate infranto, ma il livello d'allerta è massimo. Venite con noi, non opponete resistenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "Guardia gigante"
				},
				{
					"id": 790640602,
					"content": "Tutti si sparpagliano. Senti la voce di Cappet che urla: \"Si salvi chi può!\"\\nDopo che le guardie se ne sono andate, vi ritrovate tutti nello stesso posto. Sembra che nessuno sia stato catturato...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "Proviamoci ancora, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Detective"
				}
			]
		},
