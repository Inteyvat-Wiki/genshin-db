			"dialogs": [
				{
					"id": 790640301,
					"content": "#Sono tornato, e con me ci sono anche {F#la Marchesa}{M#il Marchese} e il suo entourage. Ci aiuteranno a ritrovare le origini perdute del nostro clan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640302
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisore blu"
				},
				{
					"id": 790640302,
					"content": "Stamattina nessuno ci ha detto niente al riguardo. Via di qui, non disturbateci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640303
					],
					"speakerTitle": "Guardia gigante"
				},
				{
					"id": 790640303,
					"content": "Le guardie giganti vi sollevano e vi buttano fuori.\\nNessuno è in grado di resistere.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
