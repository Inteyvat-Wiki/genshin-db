				]
			},
			"dialogs": [
				{
					"id": 790640801,
					"content": "Questo è il quartier generale delle guardie. Se riusciremo a spiegare la situazione, sono sicuro che la guardia gigante si mostrerà meno ostile nei nostri confronti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640802
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisore blu"
				},
				{
					"id": 790640802,
					"content": "Salve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790640803
					]
				},
				{
					"id": 790640803,
					"content": "Cosa stai facendo? Sono impegnato a ricordare i vecchi tempi con una foto del mio amico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640804
					],
					"speakerTitle": "Bussa alla porta"
				},
				{
					"id": 790640804,
					"content": "Riconosco quella voce... Sei tu, Winston?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640805
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisore blu"
				},
				{
					"id": 790640805,
					"content": "Ahahah, rieccoti qua... Te l'ho detto, sono il tuo unico amico in questo mondo. Cosa ti è saltato in mente d'imbarcarti in una missione con due perfetti sconosciuti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640806
					],
					"speakerTitle": "Bussa alla porta"
				},
				{
					"id": 790640806,
					"content": "Sei stato così ingenuo. \"Oh, farò amicizia con loro, lo so!\" Ma, alla fine, io sono l'unico che resta sempre ad aspettarti. Sono il solo amico che hai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640807
					],
					"speakerTitle": "Bussa alla porta"
				},
				{
					"id": 790640807,
					"content": "#Non è vero... Non ci sono solo quei due, ma anche {F#la marchesa}{M#il marchese} {NICKNAME} e la sua compagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640808
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisore blu"
				},
				{
					"id": 790640808,
					"content": "...Hai stretto nuove amicizie alle mie spalle?! Beh, Albizzi, guarda un po' come sei cresciuto... È il colmo. Vattene! Non voglio più vederti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640809
					],
					"speakerTitle": "Bussa alla porta"
				},
				{
					"id": 790640809,
					"content": "Non ci penso neanche. Perché non sospendi le misure d'emergenza per un secondo e mi lasci entrare? Con me c'è qualcuno di molto speciale, e siamo molto vicini a risolvere il mistero del nostro luogo sacro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640810
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Supervisore blu"
				},
				{
					"id": 790640810,
					"content": "Ti ho detto di andartene!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640811
					],
					"speakerTitle": "Bussa alla porta"
				},
				{
					"id": 790640811,
					"content": "Winston suona l'allarme. Le guardie giganti arrivano, vi sollevano e vi portano fuori.\\n\"Tu e Winston dovete restare separati per un po'. La vostra amicizia ha bisogno di un periodo di pausa.\"\\nLe guardie offrono gentilmente dei consigli.\\nL'intero processo si svolge in maniera insolitamente civile.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}