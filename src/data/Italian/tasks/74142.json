				]
			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#{M#Monsieur}{F#Mademoiselle} {NICKNAME}! Un attimo, perché Paimon non c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420702,
					"content": "Quella faglia... Cosa stai guardando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "Quale faglia? Non è uno specchio, questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420704,
					"content": "Beh, a proposito, c'è una cosa che sto cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420705,
					"content": "Ho bisogno di indizi sullo Specchio della verità. Ha l'aspetto di un dipinto e permette alle persone di meditare in maniera simile al Libro della rivelazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420706,
					"content": "A proposito dei quattro ottanti e del dipinto nella Torre della Gestalt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#...Davvero? Quindi è in un posto del genere? Capito! Grazie, {M#Monsieur}{F#Mademoiselle} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
