				]
			},
			"dialogs": [
				{
					"id": 741421301,
					"content": "#Grazie, {M#Monsieur}{F#Mademoiselle} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421302,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421303
					]
				},
				{
					"id": 741421303,
					"content": "Non lo so, io volevo soltanto vedere i girasoli in fiore e il grazioso cagnolino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421304,
					"content": "Ma c'era un mostro dietro di me e il cielo si è fatto più scuro. Ho sentito varie voci che parlavano di cose che non capivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421305
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421305,
					"content": "Avevo tantissima paura, così ho seguito la luce dorata e sono corsa avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421306,
					"content": "Quando il mostro si avvicinava, tutto intorno a me diventava più buio. Ogni cosa spariva: il giardino, il palazzo, i grandi alberi, i fiori... Era tutto tetro e non vedevo altro che rovine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421307,
					"content": "Poi il mostro mi ha raggiunta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421308,
					"content": "Non pensarci, adesso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421309
					]
				},
				{
					"id": 741421309,
					"content": "Cagnolino, rimandala indietro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421310
					]
				},
				{
					"id": 741421310,
					"content": "Non venire più qui, piccoletta. Qui non c'è nulla, là fuori c'è un intero mondo ad aspettarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421311
					]
				},
				{
					"id": 741421311,
					"content": "Eh? Tu sei il cagnolino? Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421312,
					"content": "...Ti rivedrò ancora? Questo mondo tornerà a essere un giardino bellissimo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421313
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421313,
					"content": "No. Addio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421314
					]
				},
				{
					"id": 741421314,
					"content": "Quanto a te, rispondimi di nuovo: come mi vedono i tuoi occhi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421315
					]
				},
				{
					"id": 741421315,
					"content": "Come un cane.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421316
					]
				},
				{
					"id": 741421316,
					"content": "Bene. Hai mandato via qualcuno che non avrebbe dovuto essere qui, e grazie a te il tracollo di questo mondo si è fermato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421317
					]
				},
				{
					"id": 741421317,
					"content": "Ma non è saggio che rimaniate qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421318,
						741421320
					]
				},
				{
					"id": 741421318,
					"content": "L'avevo capito. Rimandami indietro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421319
					]
				},
				{
					"id": 741421319,
					"content": "Saggia decisione. Addio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741421320,
					"content": "Cosa sta succedendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421321
					]
				},
				{
					"id": 741421321,
					"content": "Questo mondo stava per disintegrarsi, perché qualcuno che non avrebbe dovuto essere qui aveva scosso le fondamenta di questo luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421322
					]
				},
				{
					"id": 741421322,
					"content": "È per questo che ho visto ciò che ho visto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421323
					]
				},
				{
					"id": 741421323,
					"content": "Non so cosa hai vissuto. Dopotutto, io non sono te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421324
					]
				},
				{
					"id": 741421324,
					"content": "E allora chi sei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421325
					]
				},
				{
					"id": 741421325,
					"content": "Questo non conta... Ciò che importa davvero è chi governa questo mondo immaginario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421326
					]
				},
				{
					"id": 741421326,
					"content": "Pensavano di poter salvare il mondo, ma non sapevano se questo mondo andasse salvato. Forse il mondo che ricordavano era soltanto un pomeriggio eternamente privo di girasoli in fiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421327
					]
				},
				{
					"id": 741421327,
					"content": "Ma quelle storie appartengono a loro, non a me. Io non sono che il ricordo di un loro amico. Pensavano di potermi salvare, ma alla fin fine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421328
					]
				},
				{
					"id": 741421328,
					"content": "La farfalla divenne un bozzolo da cui emerse una larva. Poi la larva tornò nel baratro mai nato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421329
					]
				},
				{
					"id": 741421329,
					"content": "Ma nulla di tutto ciò ha importanza. Non ho più niente. Non sono altro che un'ombra nei loro ricordi, lasciata dalla loro ossessione di salvarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421330
					]
				},
				{
					"id": 741421330,
					"content": "Ma non provo rancore nei loro confronti. Anche se cambiassero dopo la mia perdita, il fatto che io esista in questo mondo fatto di ricordi e illusioni dimostra la loro tenacia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421331
					]
				},
				{
					"id": 741421331,
					"content": "Un tempo eravamo amici, e tanto mi basta e avanza. Non importa cosa diventerò: proverò sempre gratitudine per quell'amicizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421332
					]
				},
				{
					"id": 741421332,
					"content": "A ogni modo, finiamola qui. Riesci a sentire l'influenza che questo mondo ha su di te, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421333
					]
				},
				{
					"id": 741421333,
					"content": "Addio. Non ci rivedremo mai più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				}
			]
		},
		{
