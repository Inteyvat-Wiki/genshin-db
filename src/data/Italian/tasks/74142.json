					"content": "Mi serve ancora un attimo, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421505
					]
				},
				{
					"id": 741421505,
					"content": "Oh... Va bene, allora! Tanto è giusto un battito di ciglia, Paimon non è preoccupata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421506,
					"content": "#Ma ricordati di fare attenzione, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
