			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "#Cosa ci fate voi qui? Scommetto che siete venut{F#e}{M#i} a prendere in giro questo vecchio che \"coltiva rocce\", non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040102,
					"content": "Sto bene! Non serve che gli altri abitanti del villaggio si preoccupino per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040103,
					"content": "Accidenti, non ci conosci nemmeno! Tanta ostilità è immotivata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040104,
					"content": "Ti sbagli: noi non siamo abitanti del Villaggio di Aaru, e non siamo qui per prenderti in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040105,
					"content": "Siamo solo di passaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "Di passaggio, eh? Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040110,
					"content": "Di solito, solo alcuni miei vecchi amici vengono qui, per dirmi di lasciar perdere il vivaio e tornare al villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040111,
					"content": "E anche dei ragazzini cattivi che vogliono creare scompiglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040112,
					"content": "Non ho mai visto qualcuno che indossa abiti del genere. Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040113,
					"content": "#Sono {F#una viaggiatrice}{M#un viaggiatore} alla ricerca della mia famiglia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "Sì, abbiamo fatto un lungo viaggio e abbiamo vissuto molte avventure per arrivare fin qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040115,
					"content": "#{NICKNAME} è una persona onesta come poche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040119,
					"content": "Non maltrattiamo dei poveri vecchietti solitari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040120,
					"content": "Quindi non hai nulla di cui preoccuparti: siamo brave persone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040121,
					"content": "Ehm... Mi vergogno a chiedervi scusa, ma ve lo devo. Mi dispiace davvero, non avrei dovuto presumere quelle cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040122,
					"content": "Vi prego di accettare le mie più sincere scuse. È Affan a chiedervelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040123,
					"content": "#Siete così giovani, eppure siete già in grado di mantenervi da sol{F#e}{M#i}. Notevole. Non esattamente come me alla vostra età.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040124,
					"content": "Quindi, se ho capito bene, posso chiedere il vostro aiuto in caso abbia un problema che non riesco a risolvere da solo, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040125,
					"content": "Oh? Quindi hai un incarico per noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040126,
					"content": "Hai un problema da risolvere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "Inizialmente avevo due vivai. Uno si trova qui e l'altro nella zona ovest del villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040128,
					"content": "Sono diventato vecchio, così mi è sempre più difficile occuparmi di entrambi. Per qualche giorno non sono andato a controllare l'altro vivaio, ed è stato distrutto da una strana roba nera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040129,
					"content": "Sembra estremamente pericolosa. Una volta entrato, temevo di non riuscire più a uscirne. Ho imparato la lezione, e non oso tornarci più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040130,
					"content": "Ora spero solo che il vivaio possa tornare come prima, per poter coltivare di nuovo i fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040131,
					"content": "#Non dovrebbe essere troppo complicato. Che ne pensi, {NICKNAME}? Te la senti di accettare l'incarico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040132,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "Il vivaio si trova nella zona ovest del villaggio. Non perdetevi, mi raccomando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040134,
					"content": "Non preoccuparti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040116,
					"content": "#Sono {F#un'avventuriera}{M#un avventuriere} alla scoperta del mondo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "Sì! Abbiamo scalato molte, molte montagne, attraversato laghi e mari per raggiungere Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040118,
					"content": "#Si potrebbe dire che siamo... uhm... avventurier{F#e}{M#i} dal cuore d'oro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040107,
					"content": "Ho sentito dire che qualcuno sta coltivando dei fiori qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "Già, sto coltivando dei fiori, non delle stupide rocce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040109,
					"content": "Pensavo che... Uff. Non importa, non so nemmeno cosa dire ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320404",
							"2"
						],
						"stepId": 7320404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "Rieccovi! Com'è andata? Credete che il vivaio possa tornare come prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040402,
					"content": "#Ce ne siamo occupat{F#e}{M#i} noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "Spieghi ad Affan cos'è l'Avvizzimento.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "Ora è tutto più chiaro. Sentivo che c'era qualcosa di strano dal momento in cui è spuntata quella roba nera dal terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040405,
					"content": "Ottimo. Ora posso finalmente piantare i semi senza dovermi preoccupare di nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040406,
					"content": "Quando questi tre semi germoglieranno, fioriranno e produrranno nuovamente semi, li pianterò in quel terreno. E allora la terra sarà ricoperta di questi fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040407,
					"content": "Eh? Queste rocce dalla forma strana...? Possono davvero dare vita a dei fiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040408,
					"content": "Dove le hai comprate, nonno Affan? Sei stato truffato o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040409,
					"content": "Si vede che avete un cuore d'oro. No, questi semi non possono essere comprati con i Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040410,
					"content": "Questi non sono comuni semi, me li ha dati il vecchio... Ehm, una mia vecchia conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040411,
					"content": "A Paimon sembra tutto così strano... Nonno Affan, cosa stai coltivando di preciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040412,
					"content": "Eheh, sto seminando il desiderio di una persona a me cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040413,
					"content": "Una risposta piuttosto insolita... Si può davvero seminare un desiderio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040414,
					"content": "Anche se provassi a spiegarvelo, non capireste. Tornate a trovarmi, se ne avrete l'occasione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040415,
					"content": "Anche se al momento non sembra esserci nulla in questo campo, questi tre semi un giorno cresceranno e fioriranno nel vivaio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040416,
					"content": "E daranno vita a tanti, tanti altri fiori in futuro! Ahah, sarà splendido...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040417,
					"content": "D'accordo. Dato che mi avete aiutato, vi ricompenserò a dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040418,
					"content": "Ecco a voi. Questo è tutto ciò che posso darvi, non ho altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040419,
					"content": "Fiuuu, incarico completato! Paimon ha un po' di fame dopo tutto quel correre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040420,
					"content": "Ero io a correre però...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "Beh, Paimon ha fatto la telecronaca. Anche questo richiede energia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040422,
					"content": "Non soffermarti sulle sciocchezze! Che ne dici se usiamo la ricompensa per comprarci qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040423,
					"content": "Su, vediamo quanto abbiamo e quante delizie possiamo permetterci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "Paimon"
				},
