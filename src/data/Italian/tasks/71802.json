			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020401,
					"content": "Non avete ancora preso possesso dei progetti? Ma sono proprio lì, nella Dimora celeste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020402
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020402,
					"content": "Uff, come fa a sapere che non li abbiamo ancora presi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718020403,
					"content": "Quei progetti sono frutto dell'ingegno di costei. Non dovrebbe percepirli, se fossero già al suo cospetto? Recuperateli immantinente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				}
			]
		},
		{
			"id": 7180205,
			"completionStepIds": [
				7180204
			],
