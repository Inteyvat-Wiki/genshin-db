			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718021001,
					"content": "Trovare gli Adepti a Jueyun non è un'impresa facile. Eppure, hai deciso di presentarti comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021002
					],
					"speakerTitle": "Visita la dimora dell'Adeptus",
					"speakerSubtitle": "Voce leggermente distorta?"
				},
				{
					"id": 718021002,
					"content": "#P-Porca pupazza! È già andata al Porto di Liyue? È tornata qui di soppiatto mentre eravamo {F#distratte}{M#distratti}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021003,
					"content": "La sua voce... ha qualcosa di strano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021004
					]
				},
				{
					"id": 718021004,
					"content": "Ah, beh... Temevamo che qualcuno avrebbe rubato qualcosa a casa tua. Non era nostra intenzione disturbarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021005,
					"content": "...Costei avrebbe un compito da affidarvi. Se lo porterete a termine, avrete libero accesso alla sua dimora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021006,
						718021007
					],
					"speakerTitle": "Visita la dimora dell'Adeptus",
					"speakerSubtitle": "Voce leggermente distorta?"
				},
				{
					"id": 718021006,
					"content": "Sembra stia parlando da sola, ormai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				},
				{
					"id": 718021008,
					"content": "Ehm, stai dicendo che non è davvero lei che parla, ma una specie di macchinario che si è lasciata dietro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021009,
					"content": "Ere addietro, in seguito a una modesta illuminazione durante i suoi studi di meccanica, costei edificò per sé una Dimora celeste sospesa nell'aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021010
					],
					"speakerTitle": "Visita la dimora dell'Adeptus",
					"speakerSubtitle": "Voce leggermente distorta?"
				},
				{
					"id": 718021010,
					"content": "Quando la Dimora fu completata, costei rifletté su quanto fosse raro poter incontrare un Adeptus, e ivi lasciò un progetto affinché qualcuno lo trovasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021011
					],
					"speakerTitle": "Visita la dimora dell'Adeptus",
					"speakerSubtitle": "Voce leggermente distorta?"
				},
				{
					"id": 718021011,
					"content": "Prima di poter entrare nella dimora di costei, recuperate il progetto. Quando lo avrete fatto, potremo parlare ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021012
					],
					"speakerTitle": "Visita la dimora dell'Adeptus",
					"speakerSubtitle": "Voce leggermente distorta?"
				},
				{
					"id": 718021012,
					"content": "Ehm, nobile Adepta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021013
					]
				},
				{
					"id": 718021013,
					"content": "Vestale delle nuvole? Xian... ehm... Nobile Xianyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021014,
					"content": "Recuperate il progetto e completate il compito che vi è stato assegnato. Quando lo avrete fatto, potremo parlare ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021015
					],
					"speakerTitle": "Visita la dimora dell'Adeptus",
					"speakerSubtitle": "Voce leggermente distorta?"
				},
				{
					"id": 718021015,
					"content": "Continua a parlare da sola e non ci considera minimamente, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021016,
						718021017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021016,
					"content": "È sicuramente una macchina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021018,
					"content": "Ma di solito le guardie meccaniche non sono più... aggressive?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021019,
						718021020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021019,
					"content": "Immagino che voglia andarci piano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021021,
					"content": "Beh, perché non andiamo a prenderlo, allora? Poi torniamo qui e diamo un'occhiata all'interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021022,
					"content": "Hihi, Paimon vuole proprio sapere che tipo di macchina ha lasciato là dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021020,
					"content": "#Sono un po' {F#preoccupata}{M#preoccupato} per quel progetto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021017,
					"content": "Ha iniziato a ripetere sempre la stessa cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021007,
					"content": "Mi chiedo se la voce non provenga da un qualche dispositivo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				}
			]
		},
