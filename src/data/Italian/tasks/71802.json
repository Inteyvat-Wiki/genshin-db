			"dialogs": [
				{
					"id": 718021101,
					"content": "Ere addietro, in seguito a una modesta illuminazione durante i suoi studi di meccanica, costei edificò per sé una Dimora celeste sospesa nell'aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021102
					],
					"speakerTitle": "Visita la dimora dell'Adeptus",
					"speakerSubtitle": "Voce leggermente distorta?"
				},
				{
					"id": 718021102,
					"content": "Quando la Dimora fu completata, costei rifletté su quanto fosse raro poter incontrare un Adeptus, e ivi lasciò un progetto affinché qualcuno lo trovasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021103
					],
					"speakerTitle": "Visita la dimora dell'Adeptus",
					"speakerSubtitle": "Voce leggermente distorta?"
				},
				{
					"id": 718021103,
					"content": "Prima di poter entrare nella dimora di costei, recuperate il progetto. Quando lo avrete fatto, potremo parlare ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visita la dimora dell'Adeptus",
					"speakerSubtitle": "Voce leggermente distorta?"
