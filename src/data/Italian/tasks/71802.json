			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vestale delle nuvole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020201,
					"content": "Questi sono invero i progetti della Dimora celeste di costei. Bene, molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020202
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 718020202,
					"content": "Non hai ancora detto che cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020203
					]
				},
				{
					"id": 718020203,
					"content": "Davvero hai altre domande da porre a costei? *sospira* E sia, considerando che è stata compiuta un'offerta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020204
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 718020204,
					"content": "A costei sono giunte voci di una certa Dimora di giada, sospesa nel cielo sopra Liyue ed eretta dai mortali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020205
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 718020205,
					"content": "Sembra che i mortali badino alle dimensioni più d'ogni altra cosa, e che su tal base abbiano dichiarato che tale dimora non ha eguali nel mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020206
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 718020206,
					"content": "Umpf! Tali sono i limiti della comprensione degli umani, che li rendono incapaci di concepire l'ingegno degli Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020207
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 718020207,
					"content": "Altro che Dimora di giada! Una minima occhiata al più banale dei capolavori meccanici di costei la rivelerebbe per quel che è veramente: un'opera del tutto futile e noiosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020208
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 718020208,
					"content": "Non sai proprio perdere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020209
					]
				},
				{
					"id": 718020209,
					"content": "Fandonie! Costei non è una perdente né difetta di conoscenze... Costei non prova che pena per quegli sciocchi mortali! Ciechi all'ingegno degli Adepti, abbagliati dagli artifici più primitivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020210
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 718020210,
					"content": "Costei teme che i progressi della meccanica degli umani prenderanno una piega infelice. Spetta a costei indicare loro il cammino glorioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020211
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 718020211,
					"content": "La questione è conclusa. Ora lascia tosto questo luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vestale delle nuvole"
				}
			]
		},
		{
			"id": 7180203,
			"completionStepIds": [
				7180207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180207",
							"2"
						],
						"stepId": 7180207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020301,
					"content": "Dichiara senza indugio le tue intenzioni! Bada a non sprecare il prezioso tempo di costei, ché ha una miriade d'incombenze ad attenderla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020302
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020302,
					"content": "Volevo solo sapere come stai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020303
					]
				},
				{
					"id": 718020303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020304
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020304,
					"content": "Una cosa mai sentita, invero... Sei qui perché ti curi del benessere di costei e non per soddisfare un tuo desiderio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020305
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020305,
					"content": "E sia! La mente dei mortali opera in modi misteriosi... che non sempre vale la pena di esplorare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020306
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020306,
					"content": "Data la tua palese inattività del momento... avresti tempo per un piccolo favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020307
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020307,
					"content": "Tempo addietro, in seguito a una modesta illuminazione durante i miei studi di meccanica, costei ha edificato per sé una Dimora celeste sospesa nell'aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020308
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020308,
					"content": "Tale Dimora celeste era costituita principalmente da Plaustrite e poggiava su una moltitudine di ulteriori invenzioni brillanti... In verità, l'invenzione più sbalorditiva era... Non importa, non potresti capirlo nemmeno qualora lo spiegassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020309
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020309,
					"content": "Una volta ultimata la Dimora celeste, i progetti rimasero in loco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020310
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020310,
					"content": "Costei vi appose un sigillo, figurandosi che una persona dall'indubbia affinità con l'architettura sarebbe riuscita a ottenerli. Tuttavia, ad oggi, il sigillo permane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020311
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020311,
					"content": "Oramai, avere i progetti custoditi lassù non è altro che un inutile fastidio. Pertanto costei ti chiede se potresti recuperarli dalla Dimora celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020312,
						718020314
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020312,
					"content": "Certo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020313
					]
				},
				{
					"id": 718020313,
					"content": "Quanto entusiasmo. Non indugiare, dunque: recapitali presso la residenza di costei quando li avrai trovati. È lì che costei ti aspetterà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020314,
					"content": "Che cosa ne farai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020315
					]
				},
				{
					"id": 718020315,
					"content": "Ovviamente, costei ha le sue ragioni. Ma non avere la presunzione di poter comprendere un'idea concepita dalla mente di un'Adepta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020316
					],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				},
				{
					"id": 718020316,
					"content": "Non indugiare oltre: recapitali presso la residenza di costei quando li avrai trovati. È lì che costei ti aspetterà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Visita la dimora dell'Adeptus"
				}
			]
		},
		{
			"id": 7180204,
