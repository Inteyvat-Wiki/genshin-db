			"dialogs": [
				{
					"id": 718021301,
					"content": "Ehm, ma che...? È un tavolo... con sopra una semplice scatola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021302,
						718021303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021302,
					"content": "È un tavolo adeptico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				},
				{
					"id": 718021304,
					"content": "#Siete {F#giunte}{M#giunti} in questo loco, e costei sa già cosa cercate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021305
					],
					"speakerTitle": "Vestale delle nuvole...?"
				},
				{
					"id": 718021305,
					"content": "Oh, ha ripreso a parlare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021306,
					"content": "Componete il vostro desiderio e riponetelo nel baule. Sarà costei a prendere la decisione finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021307
					],
					"speakerTitle": "Vestale delle nuvole...?"
				},
				{
					"id": 718021307,
					"content": "Avete affrontato mille perigli con cuore intrepido, il vostro è un dono assai raro. Pertanto, questi tesori vi spettano di diritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021308
					],
					"speakerTitle": "Vestale delle nuvole...?"
				},
				{
					"id": 718021308,
					"content": "#Evvai!! Hihi, Paimon sapeva che non ci avresti {F#fatto andare}{M#fatti andare} via a mani vuote!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021309,
					"content": "La voce ha detto: \"Componete il vostro desiderio e riponetelo nel baule\". Significa che dobbiamo scrivere il desiderio su un foglio e metterlo nella scatola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021310,
						718021311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021310,
					"content": "Meglio pensare a qualcosa che sia degno di un Adeptus...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021312,
					"content": "Sì, è vero. Tanto vale... andare direttamente da Xianyun, se ci viene in mente qualcosa, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021313,
					"content": "Quindi lasciamo qui i progetti e ce ne andiamo, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021314,
					"content": "Certo che non c'è veramente niente, in questo posto. Probabilmente si è portata dietro tutto quanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021315,
					"content": "Mi chiedo cosa avesse in mente, quando ha predisposto questi dispositivi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021316
					]
				},
				{
					"id": 718021316,
					"content": "Paimon non ne ha idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021317,
					"content": "Ma potremmo chiederglielo la prossima volta che la vediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021311,
					"content": "Formulare un desiderio a qualcuno che conosciamo fa un po' strano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021303,
					"content": "Con una scatola adeptica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				}
			]
		}
