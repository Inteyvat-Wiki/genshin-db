					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400701,
					"content": "#Viaggiat{F#rice}{M#ore}, hai recuperato tutta la merce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400702,
					"content": "Sì, ho preso tutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "Ottimo! Lascia pure tutto qui. Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400704,
					"content": "Habachi sta facendo l'inventario di altre cose nel magazzino. Mi occuperò io del cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400705
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400705,
					"content": "*sospira* Speriamo di non averne perso troppo. Incrociamo le dita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
		{
			"id": 2304008,
			"completionStepIds": [
				2304008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
