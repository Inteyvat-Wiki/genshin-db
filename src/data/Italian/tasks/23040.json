	"talks": [
		{
			"id": 2304002,
			"completionStepIds": [
				2304002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304002",
							"2"
						],
						"stepId": 2304002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "Ah, dannati avvoltoi rossi! Non vogliono proprio andarsene, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400202,
					"content": "Scusa, cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "#Sei forse... {F#la viaggiatrice}{M#il viaggiatore}? Ebeid mi ha parlato di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400204,
					"content": "Eheh, non mi aspettavo di incontrarti. Non si vedono molti turisti da queste parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400205,
					"content": "Ah, avete già incontrato Habachi? È un tipo sempre così severo, tanto da sembrare poco amichevole, a volte. Tuttavia, ti prego di non offenderti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400206,
					"content": "Vedi, qui dentro abbiamo un sacco di cose. Non ci sono solo scorte di cibo, ma anche vestiti, armi e addirittura Mora e altre merci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400207,
					"content": "Da queste parti non ci sono molti giovani, e quelli presenti devono svolgere compiti di ogni tipo: dal proteggere il villaggio, all'assistere gli abitanti nelle faccende quotidiane. Così Habachi ha sempre dovuto fare la guardia al magazzino da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400208,
					"content": "Purtroppo, a parte contabilità e inventario della merce, non posso fare molto altro per lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400209,
					"content": "Che problema c'è con gli avvoltoi rossi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "*sospira* Non farmi cominciare... Poco fa è arrivato in magazzino un carico di carne essiccata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400211,
					"content": "Probabilmente l'odore o qualche altra cosa ha attirato l'attenzione di quei pennuti. Comunque sia, hanno cominciato ad aggirarsi di tanto in tanto sulla collina vicino al magazzino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400212,
					"content": "Non hanno modo di arrivare alle scorte custodite all'interno, ma se qualcuno si azzarda a mangiare all'aperto, gli piombano subito addosso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400213,
					"content": "Le nostre guardie sono troppo occupate per venire qui a sbarazzarsi di loro, e anche Habachi ha troppo da fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400214,
					"content": "#Viaggiat{F#rice}{M#ore}, non è che potresti occupartene tu, se hai il tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400215,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Grazie mille. Sono degli avvoltoi molto aggressivi, quindi è meglio mantenere una certa distanza. Ti consiglio di sbarazzartene usando arco e frecce. È più sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400217,
					"content": "Si sono mai avventati su qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Sì, su varie cose, a dire il vero: la merce che trasportiamo, la carne che facciamo essiccare e anche il portavivande di Habachi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400219,
					"content": "Ogni volta che Habachi fa una pausa pranzo durante il suo turno di guardia, gli avvoltoi non mancano mai di rubagli un po' di carne, quando è distratto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400220,
					"content": "Quel povero ragazzo non può nemmeno lasciare il posto per andare a inseguirli, quindi deve accontentarsi di quanto gli rimane...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400221,
					"content": "Perciò, scaccia quegli avvoltoi, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
		{
