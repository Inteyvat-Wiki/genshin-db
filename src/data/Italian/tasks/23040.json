			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Najat"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230400801,
					"content": "#Ah, viaggiat{F#rice}{M#ore}, grazie al cielo sei qui! Per favore, vai ad aiutare Habachi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400802,
						230400803
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400802,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				},
				{
					"id": 230400804,
					"content": "*sospira* Un gruppo di Cacciatori di tesori è arrivato all'improvviso alle porte del villaggio e ha bloccato una delle nostre squadre di consegna. Abbiamo chiamato tutte le guardie in grado di aiutarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400805
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400805,
					"content": "Habachi però ha detto che le guardie da sole non bastavano, e quindi ha preso un'arma ed è andato a raggiungerle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400806
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400806,
					"content": "Ho sentito che i Cacciatori di tesori questa volta sono davvero troppi. Habachi non può sconfiggerli tutti da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400807
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400807,
					"content": "#Viaggiat{F#rice}{M#ore}, ti ho segnato il luogo sulla mappa. Ti prego, vai ad aiutarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400808,
						230400810
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400808,
					"content": "Vado immediatamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400809
					]
				},
				{
					"id": 230400809,
					"content": "Conto su di te. Spero che non succeda niente a Habachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400810,
					"content": "Sa combattere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400811
					]
				},
				{
					"id": 230400811,
					"content": "Non ha problemi a gestire un paio di delinquenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400812
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400812,
					"content": "In questo caso, però, si tratta di un intero gruppo di Cacciatori di tesori che ha teso un'imboscata. Se uno degli addetti alle consegne non fosse riuscito a correre così velocemente fin qui, nessuno avrebbe saputo niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400813
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400813,
					"content": "*sospira* Quanto vorrei che la signorina Candace fosse qui... Nessun Cacciatore di tesori oserebbe alzare un dito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400814
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400814,
					"content": "Hanno volutamente aspettato che partisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400815
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400815,
					"content": "#Viaggiat{F#rice}{M#ore}, aiuta Habachi per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400803,
					"content": "Sembri molto in ansia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400804
					]
				}
			]
		},
