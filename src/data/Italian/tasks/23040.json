					"Habachi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230401002,
					"content": "#Uff... Grazie mille, viaggiat{F#rice}{M#ore}. Senza di te, non saremmo mai riusciti a difendere la nostra merce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401003,
						230401005
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401003,
					"content": "Hai combattuto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401004
					]
				},
				{
					"id": 230401004,
					"content": "Ahah, grazie del complimento, ma non sarei stato in grado di batterli tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401007,
					"content": "*sospira* Vorrei tanto essere più forte. Se Candace fosse qui, tutti quei Cacciatori di tesori adesso sarebbero stesi a terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401008
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401008,
					"content": "Mi dispiace, ma ora non c'è tempo. Devo rimandare le merci al villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401009
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401009,
					"content": "#Viaggiat{F#rice}{M#ore}, questo posto è pericoloso. Faresti meglio a tornare indietro il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401010
					],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401010,
					"content": "Ora che ci penso, però, questi Cacciatori di tesori erano decisamente ben informati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Habachi"
				},
				{
					"id": 230401005,
					"content": "Sei da solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230401006
					]
				},
				{
					"id": 230401006,
					"content": "Prima c'erano delle guardie con me, ma sono andate a cercare la merce altrove.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230401007
					],
					"speakerTitle": "Habachi"
				}
			]
		}
	]
