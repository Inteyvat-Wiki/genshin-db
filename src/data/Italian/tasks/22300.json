			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "Non chiedo altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000102,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "Venero il Signore di Geo. Immagino tu non sia di queste parti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000104,
					"content": "Ti trovi al Tempio di Yiyan. Gli abitanti del Porto di Liyue vengono spesso qui per offrire incenso al Signore di Geo, sperando di ottenerne il favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000105,
					"content": "Vivo lontano da qui, quindi non ho molte occasioni per venire a offrire l'incenso. Di conseguenza, quando riesco mi trattengo un po' più a lungo per compensare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000106,
					"content": "Ho letto numerosi testi sul Signore di Geo, e più m'informo più resto colpito dalla sua grandezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000107,
					"content": "Quando penso a tutto ciò che ha fatto per il bene del Porto di Liyue, prolungare di poco il mio viaggio per venire a offrirgli dell'incenso mi sembra un'autentica inezia, e non mi pesa affatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000108,
					"content": "Non sai molto del Signore di Geo, vero? Se lo desideri, posso raccontarti tutto sul suo conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000109,
					"content": "Le mie parole, tuttavia, potrebbero non rimanerti impresse a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000110,
					"content": "Ho un'idea... Visita il <color=#00E1FFFF>vicino Porto di Liyue</color> e raccogli alcuni oggetti, cosicché io possa rappresentare per te i fatti, non limitandomi a una banale narrazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000111,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "Fantastico. Non metterci troppo, però. Ti aspetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000113,
					"content": "Quali oggetti ti servono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "Qualunque cosa che ti sembri correlata al <color=#00E1FFFF>Porto di Liyue</color> o al <color=#00E1FFFF>Signore di Geo</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000115,
					"content": "Anche se, a pensarci bene, non conosco poi così tante storie... Alcune non vale nemmeno la pena raccontarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000116,
					"content": "Ma ne riparleremo a tempo debito. Per adesso, vai pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
