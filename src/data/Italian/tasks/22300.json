			]
		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "Oh, dei minerali! Allora il significato del termine \"Geo\" non ti è del tutto oscuro, in fin dei conti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001002,
					"content": "I primi abitanti di Liyue impararono a fondere i minerali per estrarre il metallo all'interno. In precedenza, tuttavia, quei minerali erano usati per ben altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001003,
					"content": "Agli albori della civiltà, i contadini insediatisi qui accumulavano le pietre per creare delle primitive stufe, e strofinavano tra loro le rocce per generare il fuoco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001004,
					"content": "Il fuoco serviva a cucinare, e il cibo cotto dava loro la forza necessaria per lavorare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001005,
					"content": "Alla base di tutto, quindi, c'erano proprio le rocce provenienti dal terreno, che erano un dono del Signore di Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001006,
					"content": "Infatti, il Signore di Geo venne presto definito il Dio dei fornelli in svariati testi dell'epoca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001007,
					"content": "Quando inaugurano la loro attività, ristoranti e taverne bruciano incenso in onore del Signore di Geo e pregano affinché il fuoco nelle cucine non smetta mai di ardere. È di buon auspicio per i loro affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001008,
					"content": "La prossima volta che visiti un locale del Porto di Liyue, ricorda di rivolgere una preghiera al Signore di Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "Ah, proviene dalle campagne intorno alla città, vero? Immagino non sia stato facile, ottimo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001102,
					"content": "Come noterai, il Porto di Liyue è immenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001103,
					"content": "Anche le metropoli, tuttavia, sono costruite mattone dopo mattone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001104,
					"content": "Quando le prime persone si insediarono qui, questo luogo era ben diverso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001105,
					"content": "Col sudore della fronte e un impegno incessante, i fondatori iniziarono coltivando la terra, poi via via crearono tutto ciò che puoi vedere adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001106,
					"content": "Come forse sai già, il terreno intorno al Porto di Liyue è roccioso e montagnoso. Questo rende estremamente difficile la coltivazione. Ciononostante, piante e fiori come questi crescono inarrestabili anche sulle montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001107,
					"content": "Le loro proprietà benefiche furono di immenso aiuto ai primi abitanti di questo insediamento, che consideravano tutto questo un segno benevolo della presenza del Signore di Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001108,
					"content": "Nel Porto di Liyue non mancano le leggende sui successi dei fondatori. Perfino oggi, tanti avventurieri di Liyue si ispirano alle imprese di chi li ha preceduti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001109,
					"content": "Anzi, si considerano gli eredi della leggendaria tenacia e dello spirito pioniere che possedevano i loro antenati. Non a caso, il Signore di Geo viene anche definito \"Dio dei pionieri\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001110,
					"content": "Ogni avventuriere di Liyue si impone di essere saldo come le montagne, per affrontare a muso duro qualunque sfida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230012",
							"2"
						],
						"stepId": 2230012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "Interessante... Dove l'hai trovato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001202,
					"content": "Oggigiorno, si dice che cresca solo sul Belvedere di Yujing...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001203,
					"content": "Questo fiore mi permetterà di parlare diffusamente del Signore di Geo. Ottima scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001204,
					"content": "In realtà, il Porto di Liyue deve moltissimo allo Splendigiglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001205,
					"content": "#Confus{M#o}{F#a}, vero? Pensaci bene, cosa rende speciale lo Splendigiglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001206,
					"content": "È prezioso, esatto. Si tratta di un fiore molto prezioso. Puoi venderlo a caro prezzo e ottenere una discreta quantità di Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001207,
					"content": "I Mora devono il loro nome a Morax, uno dei nomi attribuiti al Signore di Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001208,
					"content": "Molti, infatti, definiscono il Signore di Geo \"Dio della ricchezza\". Quasi tutti i mercanti di Liyue, da quelli di maggior successo ai meno abbienti, si ritagliano il tempo necessario per offrire incenso al Signore di Geo, prima di fare affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001209,
					"content": "Ciò avviene perché il Signore di Geo è il più ricco del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001210,
					"content": "Anche tra i Sette... indubbiamente è l'Archon più benestante di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230013,
			"completionStepIds": [
				2230013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230013",
							"2"
						],
						"stepId": 2230013,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001301,
					"content": "#Ah, {M#un altro}{F#un'altra} amante del buon cibo! Il Porto di Liyue si distingue anche per la sua cucina. Le prelibatezze locali sono imperdibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001302
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001302,
					"content": "Qual è il legame con il Signore di Geo? Oh, sono due elementi legatissimi! Hai mai notato le insegne di svariati ristoranti del Porto di Liyue? Rappresentano le antiche tradizioni di quei locali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001303
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001303,
					"content": "Se domandi ai proprietari una prova di quanto tempo sia trascorso dall'apertura della loro attività, menzioneranno la data precisa in cui il Signore di Geo ha fatto per la prima volta visita al loro ristorante, cos'ha ordinato e quale giudizio ha espresso a fine pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001304
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001304,
					"content": "Quelle storie sono vere? Oppure è mero folklore? Chi può dirlo. L'unica certezza è che il Signore di Geo vive nel Porto di Liyue da moltissimo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001305
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001305,
					"content": "Alcuni storici di Liyue affermano che il Signore di Geo sia la figura più longeva di sempre, tanto da meritare il titolo di \"Dio della storia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001306
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001306,
					"content": "Tuttavia, non penso che qualcuno sappia quantificare con esattezza per quanto tempo abbia vissuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230080,
			"completionStepIds": [
				2230080,
				2230081
			],
			"beginWay": "TALK_BEGIN_MANUAL",
