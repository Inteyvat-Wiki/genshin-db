			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223008001,
					"content": "Cielo, per quanto tempo abbiamo chiacchierato? Il tempo è volato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008002,
					"content": "Spero di aver condiviso informazioni per te interessanti sul Signore di Geo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008003,
					"content": "In effetti, ora ho anch'io molto su cui riflettere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223008004
					]
				},
				{
					"id": 223008004,
					"content": "Naturalmente, ho menzionato solo pochi stralci dell'immensa storia dell'Archon di Geo. Torna a farmi visita e parleremo ancora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008005,
					"content": "Come? Hai addirittura preso appunti? Sono felice che le mie storie ti piacciano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008006,
					"content": "Se vuoi, puoi lasciarmi quelle annotazioni, così nel tempo libero potrò arricchirle di ulteriori particolari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008007,
					"content": "Così tanti appunti daranno vita a una collezione di ottimo livello. Una volta completata, sarei ben felice di fartene dono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008008,
					"content": "Naturalmente, i racconti su Rex Lapis sono numerosissimi, quindi ci vorrà del tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008009
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008009,
					"content": "Ecco, per te. Tu sì che sai ascoltare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		}
	]
