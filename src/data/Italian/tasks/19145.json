				"points": []
			},
			"dialogs": [
				{
					"id": 191451601,
					"content": "Prego che il volere dell'Archon di Electro benedica quella donna e sua nipote...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451602,
					"content": "Volevo chiederti: ha problemi di vista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "Oh, lo hai notato? Sì, non ci vede molto bene. Ci preoccupiamo sempre per la sua sicurezza ogni volta che viene in montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451604,
					"content": "Ma rifiuta sempre il nostro aiuto. Insiste a dire che conosce la strada come il palmo della sua mano dopo averla percorsa così tante volte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451605,
					"content": "Per fortuna ci sono delle sacerdotesse lungo il cammino che possono tenerla d'occhio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451606,
					"content": "Possa l'Archon di Electro vegliare sul cammino suo e di sua nipote...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		},
