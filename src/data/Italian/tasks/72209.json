				"points": []
			},
			"dialogs": [
				{
					"id": 722090501,
					"content": "Hai fatto un ottimo lavoro con questo supporto per preghiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090502,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "Le Tavolette dei desideri, però... Le scritte su di loro sono ormai illeggibili. Da quanto tempo si trovano qui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090505,
					"content": "Signorina Etsuko! Ho trovato delle assi di legno qui vicino e... ehm... ho ricavato delle Tavolette dei desideri appositamente per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090506,
					"content": "Dal momento che il Supporto per preghiere è stato riparato, sarebbe di buon auspicio adornarlo con nuove Tavolette dei desideri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090507,
					"content": "Hai desideri da esprimere, signorina Etsuko? Posso intagliarli nel legno per te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090508,
					"content": "Appendere una Tavoletta dei desideri in questo santuario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090509,
					"content": "Eheh, che idea interessante! Passamene una, penserò io stessa a intagliarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090510,
					"content": "Beh, a quanto pare si preparano ad appendere delle Tavolette dei desideri, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090511,
					"content": "Andiamo a dirlo a Neko. Le farà di sicuro piacere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090503,
					"content": "So il fatto mio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				}
			]
		},
