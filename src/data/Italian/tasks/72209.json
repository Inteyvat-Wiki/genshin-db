			"dialogs": [
				{
					"id": 722090601,
					"content": "Ho intravisto quei due umani verdi che si preparavano ad appendere alcune Tavolette dei desideri. Siete una coppia affidabile, niente da dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090602,
					"content": "Dopo che le avranno fissate, avviseranno sicuramente altri umani, che si dirigeranno il prima possibile qui al santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090603,
					"content": "Miao, miao, miao... Quindi anche quel supporto è un elemento importante... Intendo, oltre alla cassetta e al rimettere tutto in ordine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090604,
					"content": "Bene, molto bene. Miao miao miao! Di questo passo, il santuario tornerà alla vivacità di un tempo in men che non si dica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090605,
					"content": "Perché tieni tanto a rimetterlo in sesto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090606
					]
				},
				{
					"id": 722090606,
					"content": "Miao, miao... Perché, eh...? Sono la Gran Sacerdotessa provvisoria, in fondo. Prendermi cura del santuario fa parte dei miei compiti, oltre ad attirare sempre più visitatori e renderlo un luogo pieno di vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090607,
					"content": "E poi, al suo ritorno Hibiki ci rimarrebbe molto male, se trovasse tutto in rovina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090608,
					"content": "Miao, miao. Col vostro aiuto, invece, il santuario tornerà prestissimo alla gloria di un tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090609
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090609,
					"content": "Potrei ancora avere bisogno del vostro aiuto di tanto in tanto, miao. Non rifiutatemi quando sarà il momento, eh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
