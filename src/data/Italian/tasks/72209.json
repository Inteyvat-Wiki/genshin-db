			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090201,
					"content": "Quel supporto per preghiere sembra in quello stato da tantissimo tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090202,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "#Oh, salve {F#viaggiatrice}{M#viaggiatore}. La signorina Etsuko e io stiamo indagando nell'area intorno al santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090204,
					"content": "Anche se varie strutture del santuario da tempo risultano in rovina, sono ancora tutte qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090205,
					"content": "Gli abitanti dei villaggi vicini devono aver fatto visita a questo luogo per rendervi omaggio. Immagino che il suo stato di abbandono abbia a che fare con il Villaggio di Koseki, ormai inabitato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220904",
							"2"
						],
						"stepId": 7220904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "Miao, miao miao... Quello scaffale di legno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090302,
					"content": "L'ho riparato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "Oh, davvero? Ah, il santuario sta migliorando! Miao, miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090304,
					"content": "Allora andate a dire a quei due umani verdi che lo scaffale è stato riparato e che ora possono appenderci i loro blocchetti di legno. Già che ci sono, potrebbero anche portare qui altre persone a rendere omaggio... e riempire di Mora la cassetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090305,
					"content": "Non hai intenzione di diglielo tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "No! Q-Quell'umano alto mi fa paura. S-Sa leggere nell'animo dei gatti... I suoi occhi scrutano tutto, io non... Miao, miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090307,
					"content": "Senza menzionare il fatto che ogni volta che mi parla dà di matto... Miao, miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7220904,
			"completionStepIds": [
				7220905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220905",
							"2"
						],
						"stepId": 7220905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke",
					"Etsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "#Ehi, {F#viaggiatrice}{M#viaggiatore}. Cosa posso fare per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090402,
					"content": "Il Supporto per preghiere è stato riparato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "#Davvero? Sei stat{F#a}{M#o} tu? Che animo gentile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090404,
					"content": "Ho ricevuto l'incarico dalla Gran Sacerdotessa provvisoria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "Neko ti ha chiesto di ripararlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090406,
					"content": "Allora ha... scoperto cosa stiamo facendo, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090407,
					"content": "Non proprio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "Signorina Etsuko! Raggiungiamo subito il supporto per preghiere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090410,
					"content": "Prima la cassetta delle offerte, ora il supporto per preghiere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090411,
					"content": "La Gran Sacerdotessa provvisoria tiene moltissimo a rimettere in sesto il santuario, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090412,
					"content": "Tutti qui intorno però sono emigrati tanto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090413,
					"content": "In sostanza, nessun altro abitante dell'isola viene a porgere i propri omaggi in questo santuario... Solo noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090414,
					"content": "Cosa vuoi dire, signorina Etsuko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090415,
					"content": "La Gran Sacerdotessa provvisoria l'ha capito, o no? Per quale motivo vuole ripristinare questo santuario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090416,
					"content": "Non importa, forse non dovrei essere tanto sospettosa... Andiamo a vedere il supporto per preghiere, coraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090417
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090417,
					"content": "Tuttavia, suggerirei di restare ben in guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090418
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722090418,
					"content": "Signorina Etsuko, Neko è solo una gatta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090408,
					"content": "Puoi dirlo forte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				}
			]
		},
		{
