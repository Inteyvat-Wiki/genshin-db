				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "Anche oggi è una giornata tranquilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090102,
					"content": "Ah, siete qui, eh? Da quando avete ripulito il santuario, dormo benissimo... miao, miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090103,
					"content": "Quelle due persone vestite di verde sono state qui per una passeggiata anche ieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090104,
					"content": "Detto ciò, sono gli unici umani a essere venuti qui al santuario. Che strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090105,
					"content": "Quando quei due umani verdi sono passati, sembravano piuttosto interessati al supporto in legno, laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090106,
					"content": "Rammento che Hibiki era solita definirlo un \"supporto per preghiere\". Quei blocchetti di legno invece li chiamava \"tavolette dei desideri\". In realtà, molti frequentavano il santuario proprio per via di quello scaffale di legno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090107,
					"content": "Mmmh... Significa che gli umani amano il legno? In effetti, tanti visitatori si avvicinavano allo scaffale di legno per appendere blocchetti di legno, dopo aver offerto alcuni Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090108,
					"content": "N-Non penso fosse per amore verso il legno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "Ah no? Allora... lo facevano perché odiavano il legno? Per punire il legno, magari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090110,
					"content": "Davvero non mi soffermerei troppo sul legno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "A ogni modo, il supporto ormai è rovinato. Il suo desiderio di ricevere nuovi blocchetti di legno per ora resta inesaudito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090113,
					"content": "Ammetto di non comprendere appieno la relazione tra gli umani e il legno, ma un santuario che si rispetti deve tenere conto di entrambi gli elementi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090114,
					"content": "L'attuale stato del supporto e la mancanza di legno a disposizione del santuario devono essere le cause per cui pochissimi ormai vengono qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090115,
					"content": "Di conseguenza, devo chiedervi un altro favore. Aggiustate il supporto in legno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090116,
					"content": "Bene, lascia fare a noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "Ora che ci penso, dovremmo avere un po' di materiali rimasti da quando abbiamo riparato la cassetta delle offerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090118,
					"content": "Di questo non sono sicura... Ma perché gli umani sono tanto fissati con il legno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090119,
					"content": "Senti, ehm... Vabbè non importa. Paimon si ricorda che qualcosa è rimasto di sicuro. Diamo un'occhiata in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090120,
					"content": "Comunque sia, lascio a voi l'onere della riparazione dello scaffale. Il santuario non può rimettersi in sesto da solo, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090129,
					"content": "Riparati lo scaffale e la cassetta, il numero di visitatori del santuario dovrebbe crescere a dismisura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090121,
					"content": "Da quanto tempo è ridotto così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "Parecchio. Si è rovinato anche prima della cassetta, che era in quello stato da secoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090123,
					"content": "In pratica non ne hai idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090124,
					"content": "Beh, non mi curo granché di tener conto delle volte di cui il sole sorge e tramonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090125,
					"content": "Dunque, dovrebbero esserci dei rimasugli del materiale usato per riparare la cassetta delle offerte, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090126,
					"content": "Di questo non sono sicura... Ma perché gli umani sono tanto fissati con il legno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090127,
					"content": "Senti, ehm... Vabbè non importa. Paimon si ricorda che qualcosa è rimasto di sicuro. Diamo un'occhiata in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090128,
					"content": "Comunque sia, lascio a voi l'onere della riparazione dello scaffale. Il santuario non può rimettersi in sesto da solo, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090111,
					"content": "Il materiale non è il punto principale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
		{
			"id": 7220902,
