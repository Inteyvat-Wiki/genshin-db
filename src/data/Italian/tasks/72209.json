	"talks": [
		{
			"id": 7220901,
			"completionStepIds": [
				7220901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220901",
							"2"
						],
						"stepId": 7220901,
