			"dialogs": [
				{
					"id": 731580101,
					"content": "\"...Età del paziente: 65 anni. Sesso: maschile...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580102
					],
					"speakerTitle": "Cartella medica di Khayyam"
				},
				{
					"id": 731580102,
					"content": "\"Sintomi: dismnesia a breve termine. Peggiora nel tempo. Emozionalmente instabile, continuava a parlare dei propri ricordi di adolescenza e infanzia...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580103
					],
					"speakerTitle": "Cartella medica di Khayyam"
				},
				{
					"id": 731580103,
					"content": "\"...Patologia celebrale dall'eziologia sconosciuta. Gli esami indicano che i neuroni del paziente soffrono di inattivazione a partire dai 60 anni, cosa che ha portato al graduale degrado delle funzioni mnemoniche...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580104
					],
					"speakerTitle": "Cartella medica di Khayyam"
				},
				{
					"id": 731580104,
					"content": "\"...Fatta richiesta per pensionamento dalla scuola di Amu{RUBY#[S]Biologia}rta dell'Akademiya, nella speranza che una vita stabile e confortevole riesca a rallentare il deterioramento della patologia...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580105
					],
					"speakerTitle": "Cartella medica di Khayyam"
				},
				{
					"id": 731580105,
					"content": "\"La scuola di Amurta ha annunciato che la saggia Siman Farrokhzad si assicurerà che il paziente sia correttamente sottoposto alla terapia...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cartella medica di Khayyam"
				}
			]
		}
	]
