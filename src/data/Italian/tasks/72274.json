			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Schermagliatore dei Fatui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Argh, non pensavo che i nostri piani operativi potessero essere trapelati. Che sfortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Schermagliatore dei Fatui"
				},
				{
					"id": 722740202,
					"content": "Esattamente! Ho anche sentito dire che il Maestro è stato richiamato a Snezhnaya, ma che l'operazione Isola di Watatsumi è ancora in atto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Schermagliatore dei Fatui"
				},
				{
					"id": 722740203,
					"content": "Non pensi che il Maestro stia agendo in maniera un po' troppo autonoma? Non ha riferito quest'operazione a Lady Arlecchino, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Schermagliatore dei Fatui"
				},
				{
					"id": 722740204,
					"content": "Giusto. È stata una sua idea. Sai che c'è? Ho un brutto presentimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Schermagliatore dei Fatui"
				},
				{
					"id": 722740205,
					"content": "Stai dicendo che, se dovessimo fallire, il Maestro ci darà tutta la colpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schermagliatore dei Fatui"
				}
			]
		}
	]
}