			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Schermagliatore dei Fatui",
					"Ronin Anbu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "Sembra che i segreti non manchino in questo posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740111,
					"content": "Shh! Ascolta. Delle persone stanno parlando laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740101,
					"content": "Argh. Non mi sarei mai aspettato che le labbra di quella donna fossero sigillate. Nemmeno una parola da parte sua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "Schermagliatore dei Fatui"
				},
				{
					"id": 722740102,
					"content": "Non preoccupatevi, signori. Gli interrogatori sono la nostra specialità. Rilassatevi pure. Ce ne occuperemo in un secondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "Ronin Anbu"
				},
				{
					"id": 722740103,
					"content": "Non ci resta molto tempo. Il Maestro vuole sapere quanto ne sappia lei dei nostri piani, e vuole saperlo ora... O finiremo anche noi nei guai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "Schermagliatore dei Fatui"
				},
				{
					"id": 722740104,
					"content": "Argh. Ha davvero un caratteraccio. Che cosa ha potuto fargli quella donna per farlo arrabbiare in questo modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "Ronin Anbu"
				},
				{
					"id": 722740105,
					"content": "La persona che si chiama Lyudochka è fondamentale nei piani del Maestro. Ma questa donna della Shuumatsuban l'ha fatta fuori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "Schermagliatore dei Fatui"
				},
				{
					"id": 722740106,
					"content": "Per fortuna, il fuoco non si era ancora spento quando siamo entrati di corsa. Il Maestro, con la sua vista acuta, ha immediatamente identificato i vestiti di Lyudochka e ha compreso che i nostri piani sarebbero potuti andate in fumo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "Schermagliatore dei Fatui"
				},
				{
					"id": 722740107,
					"content": "Per quanto possa essere stato terribile, ha davvero risolto la situazione, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "Ronin Anbu"
				},
				{
					"id": 722740108,
					"content": "Comunque, non sappiamo quanto questa donna sappia dei nostri piani, o se ha già informato qualche membro della Shuumatsuban.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "Schermagliatore dei Fatui"
				},
				{
					"id": 722740109,
					"content": "Sembra che Momoyo sia stata rinchiusa in una cella sotterranea. Tiriamola fuori di lì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7227402,
			"completionStepIds": [
				7227402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
