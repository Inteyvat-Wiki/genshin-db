			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "Ah, gentili passanti, abbiate pietà di me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "Oh, grazie per non aver ignorato i lamenti di queste vecchie ossa... *sospira* Venite qui, avvicinatevi, lasciate che vi spieghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010105,
					"content": "Ho vissuto una vita piena di disgrazie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010106,
					"content": "Quando ero solo un neonato, il sacerdote che presiedeva fece accidentalmente cadere una lampada, dando fuoco ai lunghi capelli di mia zia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010107,
					"content": "Oh, cavolo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "Dopodiché contrassi una strana malattia, e da allora soffro di una goffaggine cronica. In seguito, caddi dalla culla, e mi ruppi sei costole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010109,
					"content": "Poi, quando fui più grande, mio padre mi colpì accidentalmente in testa con una vanga mentre stava cercando di salvare mio cugino, che stava per morire soffocato dai funghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010110,
					"content": "E poi il mio amato fringuello venne mangiato dal Wen Kamuy della nostra famiglia, prima che un cinghiale lo buttasse giù da una scogliera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010111,
					"content": "Dopodiché, la ragazza che mi piaceva sacrificò per sbaglio il sacerdote al grande Uccello del tuono, e fu esiliata dall'isola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010112,
					"content": "Quando raggiunsi la maturità, mia nonna morì dal dolore di fronte alla mia bruttezza e al mio malumore, e mio nonno la seguì poco dopo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010113,
					"content": "E poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010114,
					"content": "Puoi trovare conforto nella tua famiglia, perlomeno, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "Ah, a proposito della mia famiglia... Quando raggiunsi la maggiore età, il nostro stregone mi disse che non avrei potuto avere figli, perché mi sarebbe cresciuto un... Aspettate, ora vi faccio vedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010116,
					"content": "Ehm, no grazie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "*sospira* Va bene. Posso dirvi un'altra cosa? Se non vi dispiace, vorrei che faceste quest'ultima cosa per me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010119,
					"content": "Va bene, sentiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "Tempo fa, ho fatto cadere accidentalmente il mio anello d'oro nella tomba di mia moglie mentre la stavo seppellendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010122,
					"content": "È l'ultima cosa rimasta in mio possesso ma ho paura che, se proverò a recuperarlo, il suo spirito possa adirarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010123,
					"content": "Mmm, quindi abbiamo il compito di profanare una tomba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "#Beh, ehm... Voglio dire, sei {F#una}{M#uno} stranier{F#a}{M#o}... non sarà la prima cosa insolita che fai, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010125,
					"content": "#Ehm... no, aspetta... Intendevo dire che {F#una}{M#uno} stranier{F#a}{M#o} non farebbe mai adirare uno spirito, ecco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010126,
					"content": "Vai al Santuario di Chirai. La sua tomba dovrebbe essere proprio lì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010120,
					"content": "Basta che non sia qualche altra stranezza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "Non volevamo sapere tutti questi dettagli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "Hai bisogno d'aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
