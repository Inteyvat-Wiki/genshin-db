			},
			"dialogs": [
				{
					"id": 240040501,
					"content": "Perché mi guardate in quel modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040502,
					"content": "Ti sei nascosto di nuovo da qualche parte a leggere, vero? Non stavi giocando sul serio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040503,
					"content": "Proprio così. Forza, di' la verità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040504,
					"content": "Beh, voi due avevate preso i posti migliori, e io non sono molto bravo a questo gioco.. Quindi mi sono messo a leggere per passare il tempo, che male c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040505,
					"content": "Buuu! Sei un bugiardo patentato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040506,
					"content": "Umpf! Secchione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040507,
					"content": "Dite sul serio? Lasciatemi in pace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040508,
					"content": "Ora basta, finitela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "Eheh... Lovi è bravissima a nascondino. Conosce i nascondigli più curiosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040517,
					"content": "Eheheh, questo posto è fantastico quando c'è Lovi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040511,
					"content": "Verut sa arrampicarsi sui muri molto velocemente ed è fortissimo. Mi ha aiutata diverse volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040512,
					"content": "Finché andremo d'accordo, nessuno sarà in grado di trovarci eccetto te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040513
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040513,
					"content": "Bene, credo che per oggi abbiamo finito. Ti accompagniamo a casa, Lovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040514
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040514,
					"content": "Così... farai a mio padre altre domande, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
