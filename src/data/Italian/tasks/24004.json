				"objectNames": [
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040401,
					"content": "Uff, dunque mi hai trovata... eh? Aspetta... Ma tu chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040402,
					"content": "#{F#Un'amica}{M#Un amico} di Aurèle e Verut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "#Oh! Mi hanno parlato di te... Verut ha detto che sei molto brav{F#a}{M#o} a nascondino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040404,
					"content": "Beh, me ne sono accorta. Sei davvero in gamba, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040405,
					"content": "Mi hai trovata! Mi sa che dovrò raggiungere il luogo di ritrovo, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
