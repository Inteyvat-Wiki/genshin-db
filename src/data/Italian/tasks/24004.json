			"dialogs": [
				{
					"id": 240040301,
					"content": "Ah, mi hai trovato subito! Stavo giusto pensando di cambiare posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040302
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040302,
					"content": "Ora dovrò tornare al luogo di ritrovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
