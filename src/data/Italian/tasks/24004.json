			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "Aurèle, nascondiamoci laggiù. Scommetto che è meglio del posto che ha scelto lei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040102,
					"content": "Ehi, Verut, stammi vicino! Se ti perdi non riuscirò a trovarti subito, dovresti saperlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040103,
					"content": "Cosa state facendo qui voi due?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "Ehi, sei tu! Hai del tempo libero? Forza, gioca a nascondino con noi! Probabilmente Lovi si è già nascosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040106,
					"content": "Parlami di Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "Non c'è tempo, dai! Lei conosce molto bene questo posto... Dobbiamo trovare un nascondiglio migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040108,
					"content": "Verut si allontana di corsa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "*sospira* Verut... Quand'è che ascolterai...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040110,
					"content": "Scusatemi, dovrò chiedervi di giocare con noi per un altro turno. Verut è davvero molto entusiasta... chissà per quale motivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040111,
					"content": "Forse è perché ha trovato una nuova amica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "Proprio come pensavo. Tuttavia, se è felice, va bene così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040113,
					"content": "Speriamo che non diventi troppo entusiasta al punto da seguire Lovi in qualche strano punto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040118,
					"content": "Chiedo scusa ma... per piacere, gioca ancora a nascondino con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040119,
					"content": "Immagino che dovrei cercare un nascondiglio anch'io, o Verut ci rimarrà male... E se comincerà a piangere in mezzo alla strada, non saprò più cosa fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040120,
					"content": "Aurèle se ne va...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "Parlami di Lovi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "Una ragazza che abbiamo appena conosciuto. Ci ha visti giocare a nascondino e ha insistito per partecipare anche lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040116,
					"content": "La sua personalità è simile a quella di Verut, perciò vanno d'amore e d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040117,
					"content": "In ogni caso, anche suo padre non ha molto tempo per giocare con lei, quindi siamo tutti un po' sulla stessa barca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040104,
					"content": "State ancora giocando a nascondino, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
			"id": 2400402,
