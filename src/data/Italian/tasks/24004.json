				"points": []
			},
			"dialogs": [
				{
					"id": 240040201,
					"content": "...Mi sembra di aver già letto questa pagina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040202,
					"content": "Stai leggendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "Ah, hai fatto presto! Ho appena iniziato a leggere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040205,
					"content": "Il padre di Lovi le ha dato questo libro per me. Ha persino detto che posso chiedergli tutto quello che non capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040206,
					"content": "Ma, in verità... Eh. Di questo libro non capisco quasi niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040207,
					"content": "Detto questo... Andrò al nostro luogo di ritrovo. Dopotutto mi hai trovato, e le regole vanno rispettate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240040203,
					"content": "Ti piace molto imparare cose nuove, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
		{
