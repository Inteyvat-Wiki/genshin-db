	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "*sbuffa* Scusa se ti ho fermato, vai di fretta? Sono il serzhant Anton Melnikov... comandante ad interim della 9ª Compagnia. Puoi chiamarmi Anton.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620102,
					"content": "Loro sono Danila, Temur, Radomir e... ehm, Romanski non c'è, si trova... nell'ospedale da campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620103,
					"content": "Antoha, Romanski e l'ospedale da campo non ci sono più. Romanski non ha visto la luce del giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620104,
					"content": "Danila, quante volte te lo devo dire? Ora ci sono io al comando della compagnia. Chiamami serzhant Anton!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620105,
					"content": "Ah! Al comando della compagnia come serzhant! Chi credi di essere? Da quando il Kapitan non c'è più, ti dai le arie da comandante. Mah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620106,
					"content": "Ora basta, Temur... Il tuo stomaco brontolante deve aver compromesso la tua capacità di giudizio. Calmati e conserva le forze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620107,
					"content": "\"Comandante ad interim\" Antoha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620149,
					"content": "Comandante ad interim dei miei stivali! Per quanto tempo ancora dovremo prendere ordini da questo finto comandante che non sa nemmeno cosa sta facendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620150,
					"content": "Ehi Temur, devi esserti rimbambito per la fame. Ti suggerisco di farti dare qualche pugno per riprenderti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620151,
					"content": "Mi sta bene! Avanti! Fatti sotto, anch'io ti aiuterò a riprenderti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620152,
					"content": "Ottimo! Dopo aver finito le razioni, ora stiamo dicendo addio anche alla nostra sanità e pazienza. Fantastico! Spendiamo le ultime energie che abbiamo, che mossa incredibilmente furba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620108,
					"content": "Ehm... taci! Se proprio hai voglia di combattere, allora vai di sotto a combattere contro i mostri venuti dal fango nero! E non dimenticare di farlo anche a stomaco vuoto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620109,
					"content": "Dobbiamo restare uniti se vogliamo sopravvivere e andarcene da qui! Non farmelo ripetere, chiaro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620110,
					"content": "Bene, al tre ripetiamo \"Se non noi, allora chi?\" Uno, due, tre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620111,
					"content": "Se non noi, allora chi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620112,
					"content": "Se non noi, allora chi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620114,
					"content": "#Ehm, {F#amica mia}{M#amico mio} devi aver notato che... *tossisce* non siamo proprio in grado di combattere al momento. Abbiamo avuto... un piccolo problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620115,
					"content": "Tsk, \"un piccolo problema\"! Parli proprio come il Kapitan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620116,
					"content": "Visto che non è qui, sono io il comandante ad interim! Ora perché non ti tappi quella simpatica boccuccia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620117,
					"content": "#Scusami, {F#amica mia}{M#amico mio}. Abbiamo un disperato bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
