			},
			"dialogs": [
				{
					"id": 710620202,
					"content": "Ti prego di considerare la nostra richiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620201
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620201,
					"content": "Ecco il cibo richiesto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106203",
							"2"
						],
						"stepId": 7106203,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7106202"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Anton",
					"Danila",
					"Temur",
					"Radomir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "Sono molto deboli. Basterebbero solo un paio di calci e finirebbero a terra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620702,
					"content": "Basta! Ti prego, basta! Dacci del cibo e faremo ciò che vuoi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620703,
					"content": "Umpf... Hanno davvero una fame disperata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620704,
					"content": "Dimmi qual è il vostro obiettivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "Mettiamola così: nonostante i tuoi dubbi, il nostro unico obiettivo è quello di investigare la fonte della calamità nella Voragine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620707,
					"content": "Che calamità? Paimon non ne ha visto tracce nella Voragine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620708,
					"content": "La calamità di cinquecento anni fa è stata solo l'inizio: la guerra contro l'oscurità non si è mai fermata, e ora siamo su uno dei suoi numerosi campi di battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620709,
					"content": "*sospira* Il nostro sarzhent e comandante ha iniziato a sparare stupidaggini per la fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620710,
					"content": "Gli piace esagerare, ma è la prima volta che parla totalmente a vanvera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620711,
					"content": "Lasciamo perdere... Antoha non ha tutti i torti: voi di Liyue non siete nostri nemici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620712,
					"content": "O meglio, non siete nemici dei qui presenti... Non so cosa potrebbero pensare di voi i nostri compagni scomparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620713,
					"content": "Va bene... Vi aiuterò, ma solo questa volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "Come posso fidarmi di te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Danila",
					"Temur",
					"Radomir",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "*sospira* Mi dispiace, ma c'è un... problemino... con la nostra linea di comando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620902,
					"content": "\"Un problemino\"?! Siamo rimasti qui a guardare mentre qualcuno scacciava via i nostri uomini! Li abbiamo traditi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620903,
					"content": "E secondo te che avremmo dovuto fare? Farci picchiare e lasciare che ci soffiassero il cibo da sotto il naso? Cuciti la bocca e pensa a mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620904,
					"content": "Antoha, smettila di sottovalutare la faccenda. La nostra linea di comando è stata disintegrata. Non c'è più! I nostri capitani e gli altri comandanti d'alto rango o sono spariti o sono stati uccisi... Non abbiamo altra scelta: dobbiamo ritirarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620905,
					"content": "Tuttavia, molti dei nostri uomini si rifiutano di farlo... Preferiscono tenersi stretto ciò che ci è rimasto e morire combattendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620906,
					"content": "Più che altro, direi che preferiscono morire \"di fame\"... Secondo l'accordo di cooperazione, da lassù ci dovrebbero riferire gli ordini e rifornire di cibo, ma è da parecchio che nessuno si fa vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620907,
					"content": "Com'è giusto che sia: noi siamo fedeli ai Fatui e ai Messaggeri, ma non siamo sciocchi. Vista la situazione, chiunque sano di mente avrebbe già consigliato da un pezzo di ritirarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620908,
					"content": "Allora, qual è il tuo piano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "Mmmh... So che non sono affari tuoi e non ti costringerò a rimanere, ma tutto questo va oltre le nostre capacità e ci servirebbe il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620910,
					"content": "Devo pensarci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "Va bene, però fa' attenzione: i nostri compagni sparpagliati qui intorno potrebbero non essere amichevoli come noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620913,
					"content": "Non dovrei dirtelo, ma... vicino alla superficie c'è una stazione di rifornimento. Da lì passano tutti i nostri rifornimenti e, ogni tanto, anche degli ordini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620914,
					"content": "Abbiamo mandato alcuni di noi lì per prendere del cibo, ma non hanno fatto ritorno... Non posso correre il rischio di mandare qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620915,
					"content": "Inoltre, è da un pezzo che nessuno scende da quella stazione di rifornimento. Vorrei che andassi a controllare la situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620916,
					"content": "Fammici pensare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "Mi dispiace disturbarti, ma abbiamo davvero bisogno di sapere che sta succedendo lì sopra, o rischiamo di prendere decisioni troppo affrettate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620919,
					"content": "D'accordo, va bene, parli in modo troppo complicato e Paimon inizia a confondersi! Ci butteremo un occhio quando saremo da quelle parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620917,
					"content": "Darò una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "Quindi, come posso aiutare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
			"id": 7106210,
