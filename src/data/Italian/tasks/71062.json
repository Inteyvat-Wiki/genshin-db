			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620128,
					"content": "E poi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620131
					]
				},
				{
					"id": 710620131,
					"content": "Ce ne andremo e non torneremo più. Lo giuro... sull'onore della 9ª Compagnia, sui nostri antenati che hanno difeso la terra di Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620132
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620132,
					"content": "*sospira* Oh, poverino, come sei affamato e patetico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620133
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620133,
					"content": "Basta. Non mi sembri tanto più in forma, tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620134
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620134,
					"content": "Ad ogni modo, quando siamo arrivati eravamo 64... 64 in totale! Ora siamo solo quattro anime affamate. Quali altri scopi potremmo mai avere, secondo te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620135
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620135,
					"content": "Wow! Come siete finiti in queste condizioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620136,
					"content": "Per ora non è importante... Senza cibo, gli ultimi quattro rimasti della 9ª Compagnia potrebbero perire da un momento all'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
