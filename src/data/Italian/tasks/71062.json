			"dialogs": [
				{
					"id": 710620119,
					"content": "Perché dovrei aiutarvi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "Che cosa vuoi? Abbiamo rifornimenti, armi, informazioni o Mora... in abbondanza. Prendi tutto quello che ti pare, basta che ci aiuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620122,
					"content": "Ma guarda, il nostro comandante ha deciso di umiliarsi ancora mendicando aiuto... facendoci perdere l'ultimo grammo di dignità che ci era rimasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "La vuoi piantare? Pensi forse di poterti riempire la pancia col sarcasmo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620124,
					"content": "\"Unisciti ai nostri ranghi! Lascia che la nostra marcia scuota la terra come un tuono! Tu che marcerai con noi verso la stella polare della Biancanotte, vieni! Non ti abbandoneremo mai...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "Insomma, qualcuno lo faccia tacere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620126,
					"content": "Anche se sono i cattivi, Paimon prova sicuramente pena nel vederli così affamati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "Mi vergogno ad ammetterlo... Ma come puoi vedere, non siamo minimamente in grado di combattere. Vogliamo solo del cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106218,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
