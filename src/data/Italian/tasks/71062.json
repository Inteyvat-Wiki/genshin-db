				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620137,
					"content": "Prima dimmi qual è il tuo scopo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "Mettiamola così: nonostante i tuoi dubbi, il nostro unico obiettivo è quello di investigare la fonte della calamità nella Voragine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620141,
					"content": "Che calamità? Paimon non ne ha visto tracce nella Voragine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620142,
					"content": "La calamità che colpì cinquecento anni fa fu solo l'inizio. La guerra contro l'oscurità non si è mai fermata, e ora ci troviamo su uno dei suoi campi di battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620143,
					"content": "*sospira* Il nostro sarzhent e comandante ha iniziato a sparare stupidaggini per la fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620144,
					"content": "Gli piace esagerare, ma è la prima volta che parla totalmente a vanvera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620145,
					"content": "Lasciamo perdere. Antoha vuole solo dire che, beh, la gente di Liyue non è nostra nemica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620146,
					"content": "O meglio, non per questa operazione e non della qui presente 9ª Compagnia... Ma non so come la vedrebbero i nostri compagni scomparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620147,
					"content": "Vi aiuterò in considerazione del fatto che siete esseri umani, ma solo per questa volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "G-Grazie! Te ne saremo per sempre grati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
