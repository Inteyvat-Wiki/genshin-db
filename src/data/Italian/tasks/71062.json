			"dialogs": [
				{
					"id": 710621001,
					"content": "In ogni caso, grazie per averci dato del cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621002,
					"content": "Troveremo un modo per uscire da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106211,
			"completionStepIds": [
				7106207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106207",
							"2"
						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Radomir",
					"Danila",
					"Temur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "Siete di ritorno. Com'è andata? Ci sono novità riguardo alla stazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621102,
					"content": "È stata abbandonata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "Ah... Hai scoperto qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621104,
					"content": "Temo che non siate più i benvenuti al Porto di Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621106,
					"content": "C'è dell'altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621107,
					"content": "Ehm... Abbiamo trovato una lettera che sembra indirizzata a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710621108,
					"content": "Ecco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "I soldati dei Fatui leggono la lettera...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "Ah, è da parte di Yanbo. Ho capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621111,
					"content": "Cos'è successo? Anche i Milleliti sono andati via? Fammi leggere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621112,
					"content": "*sospira* Perché? Combattiamo per loro! Non siamo alleati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621113,
					"content": "Non c'è più nessuna alleanza né cooperazione... A essere più precisi, i Fatui non collaborano più con Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621131,
					"content": "Questo è un tradimento! La gente di Liyue ci ha traditi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621132,
					"content": "Forse loro pensano il contrario. Magari credono che siamo noi Fatui ad averli traditi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621114,
					"content": "Non può essere vero! Siamo venuti qui per proteggere la gente di Liyue! Non ti ricordi cosa ci ha detto il Kapitan prima che partissimo? \"Non c'è nessuna cospirazione né complotto dietro a questa spedizione!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621115,
					"content": "Ciò non significa che non ci sia stata nessuna cospirazione o complotto, no? Non è qualcosa che possiamo controllare, Danila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621116,
					"content": "D'accordo, ho capito. *fa un respiro profondo* Ho deciso: dobbiamo ritirarci quanto prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621117,
					"content": "Non importa, me ne assumerò io la responsabilità. Se tra di noi c'è un disertore... Se ci dev'essere un disertore che ha disonorato la 9ª Compagnia, quello sarò io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621118,
					"content": "...Danila ha ragione: siamo venuti qui per proteggere la gente di Liyue dalla Calamità delle tenebre. Non possiamo andarcene in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621119,
					"content": "Mirka, non è il momento di preoccuparsi dell'onore. Non lo capisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621120,
					"content": "Non capisci che la gente di Liyue non solo non ha bisogno della nostra protezione, ma non ci vuole qui? Ha persino sconfitto i nostri compagni, che invece si credevano degli eroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621121,
					"content": "Sì, avete tradito la fiducia della gente di Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "Dovremmo ritirarci, e preferibilmente senza far rumore. Non dobbiamo mettere in allerta i Milleliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621124,
					"content": "Il Kapitan ci ha detto di essere pronti a morire qui, di essere pronti a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621125,
					"content": "Ha anche detto di fare in modo che nessuno muoia invano! Che non voleva che ogni singolo membro della compagnia venisse sotterrato qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621126,
					"content": "Perlomeno noi siamo ancora vivi: c'è ancora qualcuno della 9ª Compagnia. Lo capisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621127,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621128,
					"content": "Sissignore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621129,
					"content": "Bene, ci sono altre domande? Non voglio sentire nessuna obiezione. Siete congedati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621130,
					"content": "#In ogni caso, {NICKNAME}, grazie dell'aiuto. Prendi questi Mora e queste provviste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621122,
					"content": "Dovreste pensare bene a cosa fare ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
