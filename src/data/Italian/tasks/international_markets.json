			"dialogs": [
				{
					"id": 401460801,
					"content": "Col passare del tempo, la vostra attività si è ampliata sempre di più. Con un successo così eclatante, potrebbe esserci all'orizzonte una nuova opportunità...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401460802
					]
				},
				{
					"id": 401460802,
					"content": "Oh, c'è un mercante. Uh, a Paimon non sembra di Mondstadt, però. Andiamo a scoprirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
