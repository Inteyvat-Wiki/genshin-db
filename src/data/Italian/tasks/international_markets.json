				]
			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "Salve! Mi chiamo Atefeh. Sono una mercantessa itinerante di Sumeru. Molto piacere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460102,
					"content": "Wow, ti sei fatta proprio un bel viaggio! Immagino che il nostro umile negozio sia ormai sulla bocca di tutti a Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460103,
					"content": "È tutto merito tuo, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "Paimon è una venditrice nata. Riuscirebbe a vendere dell'acqua a un pesce, hihi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460106,
					"content": "Ahah, sono d'accordo! Questa vostra attività sta diventando piuttosto famosa. In effetti, molti mercanti ben informati hanno sentito parlare del vostro negozio di pozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460107,
					"content": "Ma la maggior parte delle persone non è ancora disposta a rischiare per una merce così rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460108,
					"content": "Se volete la mia opinione, però, quando si presenta l'occasione bisogna essere pronti a coglierla. È così che si fanno i Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460109,
					"content": "Sebbene il grande pubblico non sappia ancora molto sulle pozioni alchemiche, con un po' d'impegno e una campagna di marketing potrete ricavarvi una bella fetta di mercato e, quando accadrà, i Mora scorreranno a fiumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460110,
					"content": "Una volta generata una domanda sufficiente, potreste addirittura decuplicare i prezzi... Eheh, con quel tipo di profitto riuscireste persino a prendervi il resto dell'anno libero, volendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460111,
					"content": "Decuplicare! Dici sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460112,
					"content": "Eheh, finché c'è domanda, la gente paga qualsiasi prezzo. Si potrebbe dire che sia una specie di accordo reciproco tra il consumatore e il fornitore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460113,
					"content": "Il modo in cui parli fa ricordare a Paimon di un'altra mercantessa fissata con i Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460114,
					"content": "Aspetta, hai detto di essere di Sumeru. Forse la conosci. Hai mai incontrato Dori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460115,
					"content": "Un momento, intendi Lord Sangemah Bay? Una dei mercanti più famosi di tutta Sumeru? Quella Dori? La conoscete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460116,
					"content": "È una mia amica.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "Wow! Lord Sangemah Bay è una dei miei idoli. Il suo senso degli affari e la sua dedizione nel guadagnare Mora sono sempre stati tra le mie maggiori ispirazioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460119,
					"content": "Una volta ho persino avuto la fortuna di visitare il Palazzo di Alcazarzaray. È davvero una vista magnifica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460120,
					"content": "Spero di essere come lei un giorno, con più Mora di quanti ne possa contare, eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460121,
					"content": "Ehm... A Paimon sembra che ce la siamo persa... Forse Paimon dovrebbe farla tornare con i piedi per terra, oppure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460122,
					"content": "Ti auguriamo il meglio!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "Grazie mille, lo apprezzo tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460126,
					"content": "Bene... Come ti stavo dicendo, penso che lavorando insieme potremmo guadagnare un bel po' di Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460127,
					"content": "Si tratta di un'idea piuttosto semplice: tu mi assicuri una produzione e una fornitura costante di pozioni, e io ti aiuterò a venderle in tutta Teyvat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460128,
					"content": "Se la cosa stimola il tuo interesse, allora possiamo iniziare a parlare di che genere di pozioni potremmo vendere a questo giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460129,
					"content": "Controlliamo i requisiti delle pozioni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "Stando al mio acuto senso del mercato, questi sono le tipologie di pozioni di cui c'è maggior domanda al momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460131,
					"content": "Magari un'altra volta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "Mmh, d'accordo. Ma non aspettare troppo. Quando ci sono dei Mora in ballo, bisogna battere il ferro finché è caldo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460124,
					"content": "Direi di tornare a noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "Ahem! Hai ragione, sono uscita un po' troppo dal seminato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460117,
					"content": "#Ci siamo {F#incontrate}{M#incontrati} un paio di volte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "Tutti i nostri sforzi stanno dando i loro frutti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
