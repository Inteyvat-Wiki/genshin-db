			"dialogs": [
				{
					"id": 102020401,
					"content": "Toc toc... Indovina chi è!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020402,
					"content": "Questa è la voce di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Cella d'isolamento"
				},
				{
					"id": 102020403,
					"content": "Hai bisogno di una mano per uscire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "Oooh, sì, per favore! No, aspettate... Non posso. Klee deve fare la brava e riflettere su quello che ha fatto... Basta cercare di tentarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Cella d'isolamento"
				},
				{
					"id": 102020406,
					"content": "Comunque, mentre sono in punizione, sto preparando un nuovo tesoro super speciale... in versione Ludi Harpastum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Cella d'isolamento"
				},
				{
					"id": 102020407,
					"content": "Quando dici \"tesoro\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020408,
					"content": "Eheheh... è a forma di Harpastum e così via! Quanto è carino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Cella d'isolamento"
				},
				{
					"id": 102020409,
					"content": "Hai mascherato una Bomba di Harpastum?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "Aspettate solo che inizi il Ludi Harpastum... Oh sì, ne andranno pazzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Cella d'isolamento"
				},
				{
					"id": 102020412,
					"content": "Uuuh... Se Jean sentisse questa storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020413,
					"content": "Klee potrebbe finire in punizione mooolto più a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020410,
					"content": "Ah... Un'altra bomba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "Ti portiamo da mangiare? O qualcos'altro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
}