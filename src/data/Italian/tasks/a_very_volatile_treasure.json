			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020101,
					"content": "Klee? Sei qui anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020102,
					"content": "Io... *piagnucola* mi sono costituita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020103,
					"content": "Eeeh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020104,
					"content": "*piagnucola* L-La mia bomba... I-Io... ho fatto del male a qualcuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020105,
					"content": "*piagnucola* Ho infranto le regole... Non vedrò mai più la luce del sole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020106
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020107,
					"content": "Un attimo! C'è stato un malinteso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020108
					]
				},
				{
					"id": 102020106,
					"content": "Klee, devi rispondermi. Hai detto che qualcuno è rimasto ferito. Dov'è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020109,
					"content": "La persona che Klee ha fatto saltare in aria era un Mago dell'Abisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020110
					]
				},
				{
					"id": 102020108,
					"content": "In che senso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020110,
					"content": "Ma... ma il signor Palladipelo era solo un ladruncolo... Non meritava di saltare in aria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020111,
					"content": "Dai, non fare così... Paimon ti ha già detto che i Maghi dell'Abisso sono i cattivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020112,
					"content": "Anzi, sono il peggior tipo di cattivi che si possa immaginare! Non odiano solo i buoni, ma tutte le persone... Il loro nemico è... l'umanità stessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020113,
					"content": "Il signor Palladipelo... aveva scelto di essere cattivo? Il signor Palladipelo è nemico dell'umanità?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020114,
					"content": "C-Come? Non capisco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020115,
					"content": "È tutta colpa mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020116,
					"content": "Non te ne avevo parlato perché sei ancora giovane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020118,
					"content": "Forse proprio per via del tesoro più potente di Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020119
					]
				},
				{
					"id": 102020117,
					"content": "L'Ordine dell'Abisso è un nemico di Mondstadt, e ultimamente è stato più operoso del solito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020119,
					"content": "Ah-ha, ecco! Ora Paimon capisce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020120,
					"content": "Erano sulle tracce della povera Klee perché avevano sentito del suo tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020121,
					"content": "E, proprio come per Paimon, la prima reazione è stata cercare di mettere le mani su... Ehm, no, no... Cercare di scoprire i segreti del tesoro. Già!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020122,
					"content": "Quindi... significa che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020123,
					"content": "Visto il tuo importante contributo, ti permetterò di partecipare al prossimo Ludi Harpastum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020125,
					"content": "Ti è andata davvero bene!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020126,
					"content": "Sono così felice per te!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020124,
					"content": "Ludi Harpastum! Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020127,
					"content": "#Prode Cavaliere Onorari{M#o}{F#a}, devi venire anche tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020128,
					"content": "Urrà! È un lieto fine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020129,
					"content": "Sì, se non fosse che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020130,
					"content": "Se non fosse... cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020131,
					"content": "Klee, dove avevi nascosto il tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020132
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020132,
					"content": "Io... Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020133,
					"content": "Stavi di nuovo cercando di far saltare in aria i pesci del Lago Stellare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020134,
					"content": "No! Giuro che non è così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020135
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020136,
					"content": "(Oh-oh, se n'è accorta anche Jean...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020137
					]
				},
				{
					"id": 102020135,
					"content": "(Il modo in cui ci sta guardando... Vuole che le reggiamo il gioco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020137,
					"content": "Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020138
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102020138,
					"content": "Ho capito, mi chiuderò in <color=#00E1FFFF>isolamento</color>... *piagnucola*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020139
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102020139,
					"content": "Paimon scommette che Klee si annoierà a morte lì dentro, tutta da sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
