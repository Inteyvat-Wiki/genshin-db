				"points": []
			},
			"dialogs": [
				{
					"id": 220500501,
					"content": "Fermiamoci qui, devo riposare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500502,
					"content": "In pratica, è la stessa cosa che ha detto Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500503
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500503,
					"content": "È proprio vero che le isole sono completamente diverse. Per di più, è possibile costruire un santuario su una montagna così alta. Gli umani non hanno paura delle altezze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500504,
					"content": "Il mio Santuario di Asase è comunque più bello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500505,
					"content": "Mi chiedo dove sia finita Hibiki, esattamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500506,
					"content": "Vuoi continuare a cercarla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500507
					]
				},
				{
					"id": 220500507,
					"content": "Ora ho bisogno di riposare, ne parleremo dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500508
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500508,
					"content": "C'è ancora un \"dopo\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500509,
					"content": "Mi sembra ovvio. Hibiki mi ha raccontato tante storie: sulla spiaggia, sul posto con tanti alberi, su \"Lady Kitsune\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500510
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500510,
					"content": "Le ricordo tutte molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500511,
					"content": "Ma adesso la cosa più importante è tornare a casa. Dopotutto, il Santuario di Asase ha bisogno della sua Guuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500512,
					"content": "In parole povere, adesso tornerete insieme a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 2205006,
			"completionStepIds": [
				2205007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
