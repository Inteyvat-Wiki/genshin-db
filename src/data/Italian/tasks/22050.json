			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500601,
					"content": "Fiuu... Siamo tornati, finalmente. Ho passato troppo tempo nei pressi di quel santuario, mi si è arricciato tutto il pelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500602,
					"content": "Grazie mille per l'aiuto. Sei un essere umano raro e affidabile, miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500603,
					"content": "Continuerò a occuparmi del santuario. Quando Hibiki tornerà, te la presenterò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500604,
					"content": "Miao, miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500605,
					"content": "Ah, chissà quando tornerà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
