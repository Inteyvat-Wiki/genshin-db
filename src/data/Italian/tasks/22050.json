			"dialogs": [
				{
					"id": 220500701,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500702,
						220500705,
						220500710
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500702,
					"content": "A proposito di Mikoshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500703
					]
				},
				{
					"id": 220500703,
					"content": "Secondo la leggenda, Mikoshi Nagamasa ha lavorato per lo Shogunato. Si dice che fosse un individuo giusto e retto... al punto tale da essere eccessivamente testardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500704
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500704,
					"content": "La sua stirpe vive ancora oggi. Gran parte delle persone in città che portano il cognome Mikoshi sono suoi discendenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500705,
					"content": "A proposito di Kamuna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500706
					]
				},
				{
					"id": 220500706,
					"content": "I documenti che lo riguardano non sono molti. Dopo aver attraversato il mare fino a Liyue per apprendere l'arte degli Adepti, fece ritorno a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500707
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500707,
					"content": "Dopodiché, creò Shiki Taishou e la sua magia onmyoudou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500708
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500708,
					"content": "Secondo gli annali, per riportare la pace a Inazuma, una volta usò quella tecnica per sigillare Ioroi, il bake-danuki che stava portando scompiglio ovunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500709
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500709,
					"content": "In seguito, le notizie su di lui iniziarono a scarseggiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500710,
					"content": "Arrivederci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500711
					]
				},
				{
					"id": 220500711,
					"content": "Abbiate cura di voi. Se avete bisogno di me, non esitate a chiedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		}
