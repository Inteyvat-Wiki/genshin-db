						],
						"pointId": 910002012
					}
				]
			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "#Ah, ci sono {F#altre due valorose guerriere}{M#altri due valorosi guerrieri}! Siete qui per giocare a Turbine boreale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740102,
					"content": "Forza, da questa parte! Non vedo l'ora di ammirare le vostre incomparabili abilità di volo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740103,
					"content": "Ehi, ehi, rilassati!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "Non c'è bisogno di rilassarsi per volare, gentile ospite, anzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740106,
					"content": "Essere troppo rilassati può solo offuscare la tua percezione del vento: solo chi affronta il vento selvaggio senza essere del tutto preparato può scoprire il proprio vero potenziale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740107,
					"content": "Al giorno d'oggi, gli scoiattoli volanti sono fin troppo timorosi! Hanno completamente dimenticato le lezioni del \"Coraggioso Vento del Nord\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740108,
					"content": "Se ne stanno in luoghi sicuri, declamando il coraggio delle foglie che danzano al vento, terrorizzati all'idea di lanciarsi nel vuoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740109,
					"content": "Come faremo a proteggere il regno insieme a Sua Altezza, se le cose non cambieranno? Che assurdità! Ridicolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740110,
					"content": "Accicacchio, questo scoiattolo volante ha energia da vendere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790740111,
					"content": "Sembra che gli piaccia davvero volare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "Ed è per questo che ho trovato un percorso con delle correnti d'aria particolarmente intense, e ho piazzato al suo interno dispositivi di ogni sorta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740113,
					"content": "È una sfida che solo i più coraggiosi, audaci e battaglieri nel volo possono superare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740114,
					"content": "Possedete il coraggio necessario, gentili ospiti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740115,
					"content": "Mi piacerebbe provare!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "Eccellente! Seguimi, allora! Il percorso non dista molto da qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740117,
					"content": "Beh... Ho altro da fare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "Mmh? Ti serve ancora un po' di tempo per prepararti, quindi? Non preoccuparti, aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740119,
					"content": "#Torna pure quando ti sentirai {F#pronta}{M#pronto} ad affrontare questo percorso ventoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740104,
					"content": "Non ho ancora detto nulla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}