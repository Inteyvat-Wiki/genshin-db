			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "La <color=#00E1FFFF>Gilda degli avventurieri</color> ti dà il benvenuto. A dire il vero, ti ho tenuto sott'occhio per molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300102,
					"content": "#Hai tenuto sott'occhio {NICKNAME}, eh? Ha combinato qualche guaio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300103,
					"content": "Oh, non intendevo questo, affatto. Essere alla ricerca di nuovi avventurieri fa parte del mio lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300104,
					"content": "Quando ti guardo, vedo una persona con un potenziale tale da poter rivaleggiare con i grandi avventurieri delle leggende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300105,
					"content": "Anche Paimon lo vede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300106,
					"content": "#Paimon si sente sempre al sicuro quando si avventura con {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300107,
					"content": "Comunque, per un avventuriere, l'esperienza è molto più preziosa del potenziale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300108,
					"content": "Devi accumulare <color=#00E1FFFF>ESP avventura</color> per aumentare il tuo <color=#00E1FFFF>grado avventura</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300109,
					"content": "Il tempo è fondamentale. Lascia che ti spieghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300110,
					"content": "#Aspetta! Stai dicendo che siamo, tipo, avventurier{F#e}{M#i} ufficiali ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300111,
					"content": "Non preoccuparti, la Gilda degli avventurieri non fa pagare nessuna quota associativa, né impone alcun obbligo ai suoi membri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300112,
					"content": "In poche parole, ci sono molti vantaggi ma nessun inconveniente a diventare un membro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300113,
					"content": "Va bene allora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "Di base, la Gilda degli avventurieri ti ricompensa ogni volta che il tuo grado avventura aumenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300117,
					"content": "Ecco un regalo per te, in quanto nuovo membro. In futuro, dovrai tornare qui per ricevere le ricompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300118,
					"content": "Ricompense del grado avventura",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "Dammi i vantaggi, ora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "Ahahah... Al giorno d'oggi le nuove reclute vanno proprio dritto al sodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003003",
							"2"
						],
						"stepId": 2003003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "#Torniamo a noi, per piacere lascia che ti dia il benvenuto nella Gilda, intrepid{F#a}{M#o} avventurier{F#a}{M#e}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300202,
					"content": "Ecco il tuo <color=#00E1FFFF>Manuale dell'avventuriere</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300203,
					"content": "Fanno anche dei manuali ora?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "L'aggiunta di un nuovo membro è un'occasione importantissima! È più che giusto fare una piccola cerimonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300207,
					"content": "Ha un registro degli incarichi e delle ricompense disponibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300208,
					"content": "Ed è anche una prova della tua adesione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300209,
					"content": "Ah, un'altra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300210,
					"content": "#A volte, ti ritroverai bloccat{F#a}{M#o} a un certo Grado avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300211,
					"content": "In quel caso, dovrai compiere delle prodezze impressionanti per guadagnare ancora più stima nella Gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300212,
					"content": "Prodezze impressionanti? A Paimon sembra un po' esagerato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300213,
					"content": "Semplicemente, ci sono delle avventure specifiche che, una volta terminate, ti permetteranno di salire al grado avventura superiore. Delle avventure d'ascensione, se preferisci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300214,
					"content": "Ma di questo se ne parlerà più tardi. Le opportunità di ottenere riconoscimento arriveranno in base all'esperienza che accumulerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300215,
					"content": "Può bastare per oggi. In futuro avremo molte altre occasioni di incontrarci di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300216,
					"content": "#Ad astra abyssosque, avventurier{F#a}{M#e}! Con impegno, raggiungerai le stelle e conquisterai l'abisso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300205,
					"content": "Questo assomiglia più a una brochure pubblicitaria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "Lo è, in qualche modo. Ma ha anche delle funzioni pratiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}