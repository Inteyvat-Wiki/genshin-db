			"dialogs": [
				{
					"id": 409110301,
					"content": "Eccovi qui. Bene, vi presento... la <color=#00E1FFFF>Fornace elementale</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110302,
					"content": "Accendiamola e vediamo se funziona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
		{
			"id": 4091104,
			"completionStepIds": [
				4091104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4091104",
							"2"
						],
						"stepId": 4091104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110401,
					"content": "Bisogna solo attivarlo un altro paio di volte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110402,
					"content": "#Viaggiat{F#rice}{M#ore}! Proprio chi volevo vedere. Vi ricordate la Fornace elementale che ho costruito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110403,
					"content": "Da quando l'avete attivata, ho raccolto un bel po' di dati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110404,
					"content": "Soprattutto, sono stato in grado di determinarne l'affidabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110405,
					"content": "Con un apparecchio così affidabile, potremo fare ancora più esperimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110406,
					"content": "#Se siete dispost{F#e}{M#i} ad aiutare, potreste attivare la Fornace elementale ancora una volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110407,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110409,
					"content": "Quanti esperimenti vorresti fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "Il più possibile, naturalmente. Per un alchimista senza Visione come me, non ho altri metodi per fare ricerca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110411,
					"content": "Quindi, per favore, aiutatemi ad attivare di nuovo la Fornace elementale, ve ne sarò molto grato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		}
	]
}