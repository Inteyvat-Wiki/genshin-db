			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "#Viaggiat{F#rice}{M#ore}! Ciao! Aspettate un attimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110103,
					"content": "Beh, allora... mi dispiace chiedervelo, ma... ho davvero bisogno del vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110104,
					"content": "Come sapete, non ho mai fatto molti progressi nei miei studi alchemici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110105,
					"content": "Beh, ho capito che non posso continuare a provare sempre le stesse cose. È chiaro che così non vado da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110107,
					"content": "Stai passando alla bioalchimia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "Vuoi ritornare all'alchimia antica?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "Quindi ho deciso di cambiare obiettivo... adottare un approccio nuovo e tentare qualcosa che non è mai stato fatto prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110108,
					"content": "La bioalchimia non è nulla di nuovo, ci sono già diverse persone che la studiano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110110,
					"content": "Ti riferisci allo studio delle arti alchemiche degli antichi? No, non è il mio genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110111,
					"content": "Sapete qual è il fattore più importante nell'alchimia? Gli elementi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110112,
					"content": "Per una serie di motivi, l'alchimia impiega principalmente oggetti infusi di energia elementale, anziché l'energia stessa in forma pura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110113,
					"content": "Naturalmente, questo porta a delle impurità nel processo di trasmutazione, rendendo le reazioni elementali meno efficaci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110114,
					"content": "Per compensare, usiamo quantità maggiori di materiali elementali, ma dobbiamo comunque fare attenzione durante il processo di trasmutazione, perché le impurità possono facilmente rovinare il risultato finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110115,
					"content": "Purtroppo, tutto questo comporta costi extra per gli alchimisti che non usano le Visioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110116,
					"content": "Il problema principale è che gli oggetti infusi di energia elementale non sono economici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110117,
					"content": "Il costo medio di una trasmutazione finisce col rendere il risultato del nostro lavoro secondario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110119,
					"content": "E anche volendo, non ho una Visione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "Quindi, come posso aiutarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "*sospira* Forse è per questo che non ho mai fatto grandi progressi... Gli standard sono troppo elevati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110120,
					"content": "È vero... ma ho sentito dire che puoi comunque manipolare l'energia elementale, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110122,
					"content": "Ho sentito dire che puoi manipolare l'energia elementale anche se non hai una Visione, è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110123,
					"content": "Ecco, in sostanza, ho ideato un nuovo apparecchio che chiamo <color=#00E1FFFF>Fornace elementale</color>. L'idea di base è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110124,
					"content": "Beh, fondamentalmente, è un recipiente che può contenere energia elementale pura e generare reazioni elementali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110125,
					"content": "Con un po' di fortuna, la Fornace elementale sarà l'invenzione che porterà le mie abilità alchemiche al livello successivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110126,
					"content": "È tutto sistemato e siamo pronti per partire, ora mi manca solo qualcuno in grado di manipolare l'energia elementale pura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110127,
					"content": "#Se siete dispost{F#e}{M#i} ad aiutare, incontriamoci al <color=#00E1FFFF>Tempio dei Mille Venti</color>. È lì che ho fatto preparare il tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110128,
					"content": "Spero davvero che questo sia il momento buono per i miei progressi alchemici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
