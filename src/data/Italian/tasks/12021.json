			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210201,
					"content": "Devo ammetterlo, non mi aspettavo di trovare dei Fatui all'interno di un accampamento di Hilichurl. Devono aver tramato a lungo nell'ombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210202,
					"content": "Qual è il loro obiettivo? I soldati hanno ragione? Davvero sono in combutta con la Commissione Tenryou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210203
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210203,
					"content": "Ispezioniamo l'accampamento in cerca di prove. Se il commerciante ha detto la verità, la sua merce dovrebbe trovarsi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210204,
					"content": "Bene, è il momento di dare un'occhiata in giro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202103,
			"completionStepIds": [
				1202108,
				1202118
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202108",
							"2"
						],
						"stepId": 1202108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210301,
					"content": "Kokomi...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210302,
					"content": "Kokomi, abbiamo trovato la merce del commerciante. Guarda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210303,
					"content": "Uhm... Capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210304,
						120210305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210304,
					"content": "Qualcosa non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				},
				{
					"id": 120210306,
					"content": "Oh, non è nulla. Mi sono distratta per un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210307,
					"content": "Vediamo un po'... Sì, sono decisamente le merci sottratte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210308
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210308,
					"content": "Cibo, medicine, attrezzi da lavoro... Tutti elementi essenziali dopo una guerra. Evidentemente li teneva da parte nell'attesa di ricavarne un buon profitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210309
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210309,
					"content": "D'altra parte, dubito che la Commissione Tenryou abbia bisogno di oggetti simili, quindi l'idea che stesse rifornendo loro non ha molto senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210310
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210310,
					"content": "È probabile che si tratti solamente di un mercante opportunista. Matsuda e Uchimura temevano il peggio, ma non sembra questo il caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210311
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210311,
					"content": "Beh, non è neppure un santo però... Accumulava cose di cui le persone hanno un disperato bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210312,
					"content": "Non possiamo ridargli tutto indietro e farlo andare via, no? Non sarebbe giusto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210313,
					"content": "Non preoccuparti, avevo già previsto un'eventualità simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210314
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210314,
					"content": "Il mio recente Decreto temporaneo postbellico include restrizioni sul costo dei beni essenziali. La popolazione avrà accesso a queste merci a prezzi ragionevoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210315
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210315,
					"content": "Se avesse letto con attenzione il decreto, avrebbe evitato di mettersi in questa situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210316
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210316,
					"content": "Kokomi, pensi davvero a tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210317,
					"content": "Se solo fosse così... Non comprendo il perché di questo presunto accordo segreto tra la Commissione Tenryou e i Fatui, ad esempio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210318
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210318,
					"content": "L'indebolimento dell'energia, poi, non aiuta di certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210319
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210319,
					"content": "Eh...? Cosa intendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210320,
					"content": "Nulla. Coraggio, riportiamo le merci al villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210321
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210321,
					"content": "Manca ormai poco al Banchetto della vittoria. Risolvere il tutto prima che inizi si rivelerà una vera e propria corsa contro il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210322
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210322,
					"content": "Capito! Prima facciamo tornare la pace, poi ci abbuffiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210305,
					"content": "A cosa pensi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				}
			]
		},
		{
			"id": 1202104,
			"completionStepIds": [
				1202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202109",
							"2"
						],
						"stepId": 1202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naruse",
					"Matsuda",
					"Sangonomiya Kokomi",
					"Uchimura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210401,
					"content": "Le mie merci! Le avete ritrovate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210402
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210402,
					"content": "Grazie, Sua Eccellenza! E grazie anche a te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210403
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210403,
					"content": "Visto? Vi avevo detto che sono innocente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210404
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210404,
					"content": "Bah... non ci giurerei. Potresti aver pianificato tutto questo in anticipo con i tuoi amici Fatui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210405
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210405,
					"content": "In base alle informazioni ottenute nell'accampamento dei Fatui, nulla lascia intuire che costui avesse un qualche accordo con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210406,
					"content": "Conoscendo il modo in cui operano i Fatui, in caso contrario avremmo sicuramente trovato degli indizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210407
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210407,
					"content": "Ma... e se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210408
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210408,
					"content": "Basta così. Abbiamo recuperato la merce e, come pattuito, ciò è sufficiente a dichiarare la sua innocenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210409,
					"content": "Mi dispiace di quanto accaduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210410
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210410,
					"content": "Ci siamo fatti prendere la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210411
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210411,
					"content": "Che vi avevo detto? Voi soldati avete la zucca vuota: tutto muscoli, niente cervello! Darmi del cospiratore, ma figuriamoci... La prossima volta lasciatemi in pace, chiaro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210412
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210412,
					"content": "Un attimo. Sei risultato innocente alle accuse mosse in origine nei tuoi confronti, ma l'accumulo di beni di prima necessità è un crimine sancito nel Decreto temporaneo. Ci saranno conseguenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210413,
					"content": "Hai già ammesso di essere il proprietario della merce, quindi sei tenuto a rispondere direttamente di tale accusa. Il prezzo di vendita di questi beni sarà imposto, inoltre dovrai pagare una multa di importo pari a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210414,
					"content": "Aspettate, cosa? Sua Eccellenza... Da che parte sta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210415
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210415,
					"content": "Non ho alcun interesse a schierarmi. Sono la Divina sacerdotessa dell'Isola di Watatsumi, mi attengo unicamente ai principi di ricompense e punizioni ben definite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210416,
					"content": "Occorre tanto riconoscere i meriti quanto penalizzare gli errori. Sei risultato innocente alle pesanti accuse mosse nei vostri confronti, ma ciò non vi esenta dal dover affrontare le conseguenze del vostro operato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210417
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210417,
					"content": "No, no un attimo! Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210418
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210418,
					"content": "Beh, muovetevi! Portatelo via. Stavolta non la passa liscia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210419
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210419,
					"content": "Sua Eccellenza, il mercante afferma che tutti i beni gli appartengono, ma qualcosa non torna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210420
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210420,
					"content": "Quelli con lo stemma della Commissione Tenryou forse sì, ma gli altri sono chiaramente diretti ai santuari. Questi in particolare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210421
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210421,
					"content": "Uhm... A quanto pare i Fatui hanno accumulato tutto il bottino in un solo luogo. Lasciate a me l'attrezzatura sacra. Occupatevi voi di rintracciare i proprietari di tutto il resto, invece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210422
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210422,
					"content": "So che vi sto chiedendo molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210423,
					"content": "Niente affatto, Sua Eccellenza. Ci pensiamo noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210424
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210424,
					"content": "Se posso, però, Sua Eccellenza... Forse in questo caso specifico non sono state riscontrate correlazioni tra la Commissione Tenryou e i Fatui, ma i nostri soldati sono certi di ciò che hanno visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210425
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210425,
					"content": "Le trattative per la pace stanno per iniziare, lo so, tuttavia... Non escluda quella possibilità, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210426
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210426,
					"content": "Comprendo la tua preoccupazione e la terrò sicuramente in considerazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210427,
					"content": "#Riporterò questi oggetti al Santuario dei Sangonomiya, {NICKNAME}. Ti andrebbe di accompagnarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 1202108,
			"completionStepIds": [
				1202114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202114",
							"2"
						],
						"stepId": 1202114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210804,
					"content": "Sai, il santuario più antico dell'Isola di Watatsumi non si trovava a Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210805
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210805,
					"content": "Era nei pressi della Statua dei Sette. All'epoca, gli abitanti di quest'isola credevano nell'esistenza della Shogun, ma non la veneravano come è solito fare lo Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210806
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210806,
					"content": "Quando abbatté la nostra divinità protettrice, però, il santuario venne abbandonato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210807
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210807,
					"content": "Da allora, le relazioni tra l'Isola di Watatsumi e lo Shogunato si sono inasprite, e nel tempo tale diffidenza ha messo radici profonde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210808
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210808,
					"content": "Spero di potere discutere di questo problema durante le trattative di pace. È tempo di dimenticare i torti subiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210809
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210809,
					"content": "Sua Eccellenza, cosa la porta da queste parti nonostante i numerosi impegni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210810
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210810,
					"content": "Oh... Non sembra certo in forma... Deve prendersi più cura di sé stessa, d'accordo? Il destino di tutti noi poggia sulle sue spalle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210811
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210811,
					"content": "Ehm... Grazie per il pensiero, ma sto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210812
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210812,
					"content": "Sua Eccellenza, la prego, accettate il mio consiglio. Dopo una guerra tanto lunga con l'esercito della Shogun, non basta semplicemente dichiarare la pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210813
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210813,
					"content": "Se accettassimo la riconciliazione, la divinità che un tempo ci proteggeva sarebbe morta invano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210814
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210814,
					"content": "Lascia stare, è passato così tanto tempo! E poi gli scontri sono terminati da pochissimo, dovremmo accogliere la pace di buon grado.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210815
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210815,
					"content": "Lo so, lo so, è solo che... *sospira* Durante i negoziati dovremmo mantenere una posizione decisa, senza cedere a troppi compromessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210816
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210816,
					"content": "Comprendo le vostre preoccupazioni. Valuterò attentamente tutte le opzioni prima di procedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210817
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210817,
					"content": "Grazie, Sua Eccellenza... Contiamo su di lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210818
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210818,
					"content": "Sua Eccellenza? Che sorpresa incontrarla in un luogo simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210819
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210819,
					"content": "Sa, mia figlia quest'anno parteciperà alle selezioni per la nomina a sacerdotessa. Sarei così orgogliosa se entrasse a far parte del clan Sangonomiya! È una leader gentile e illuminata, sarebbe in ottime mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210820
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210820,
					"content": "*sospira* Dico sempre a mia figlia che, se mai avrà l'onore di apprendere qualcosa da Sua Eccellenza, dovrà trarne il massimo beneficio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210821
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210821,
					"content": "Voglio dire, basta poggiare lo sguardo su Sua Eccellenza... Tanto giovane, eppure così saggia e intelligente. È da sempre un modello per mia figlia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210822
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210822,
					"content": "Beh, se entrerà nel clan Sangonomiya mi prenderò cura di lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210823
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210823,
					"content": "Ah, Sua Eccellenza! Che gioia vederla qui. Come ben sa, il raccolto quest'anno ha subito un duro colpo. Lasciate che la metta al corrente degli ultimi sviluppi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210824
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 120210824,
					"content": "#Oh, Sua Eccellenza, {M#il capitano}{F#la capitana} della Pesce spada II la accompagna? Si è trasferit{F#a}{M#o} sull'Isola di Watatsumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210825
					],
					"speakerTitle": "Ryouko"
				},
				{
					"id": 120210825,
					"content": "Sua Eccellenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210826
					],
					"speakerTitle": "Yukiya"
				},
				{
					"id": 120210826,
					"content": "Ehm... Calma, per favore. Risponderò a tutte le vostre domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210827
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210827,
					"content": "Per quanto concerne quelle più articolate, però, preferirei inoltraste una richiesta al santuario. Così potrò analizzarle non appena ne avrò modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210828
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210828,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210829
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210829,
					"content": "#Come va, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210830,
						120210832
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210830,
					"content": "Sto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210831
					]
				},
				{
					"id": 120210831,
					"content": "Eh... Queste cose ti scivolano addosso, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210834,
					"content": "Sua Eccellenza, eccola qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210835
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210835,
					"content": "C'è un problema. Stiamo ancora aspettando la consegna di vari articoli cerimoniali. Inizio a temere che qualcuno possa averli rubati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210836
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210836,
					"content": "Oh, non serve preoccuparsi. Li abbiamo già recuperati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210837
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210837,
					"content": "Davvero? Ma è fantastico! Non smette mai di stupirci, Sua Eccellenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210838
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210838,
					"content": "Ho fatto ordine tra tutte le richieste ricevute di recente. Le troverà sulla sua scrivania.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210839
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210839,
					"content": "Inoltre, secondo il programma, è appena in tempo per la riunione odierna sullo sviluppo dell'industria tessile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210840
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210840,
					"content": "È oggi...? Proprio adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210841
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210841,
					"content": "Sì. Le due giovani sono arrivate sane e salve. Manca soltanto lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210842
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210842,
					"content": "#Capisco... *sospira* Speravo davvero di poter fare il giro dell'isola con te, {NICKNAME}, ma sembra proprio che dovremo rimandare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210843
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210843,
					"content": "Diamoci appuntamento domani, all'entrata del Santuario dei Sangonomiya. Avvieremo così i preparativi per il Banchetto della vittoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210844
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210844,
					"content": "Evviva, il Banchetto della vittoria! Chiedo per sicurezza: ci sarà tanto cibo delizioso, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210845
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210845,
					"content": "Ahah... Sarà alla base di tutto, certo. Sono sicura che apprezzerai le specialità dell'Isola di Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210846
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210846,
					"content": "Perfetto! A domani, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210847,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210832,
					"content": "La mia pazienza è messa a dura prova.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210833
					]
				},
				{
					"id": 120210833,
					"content": "*sospira* Anche la mia. A volte è vessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
