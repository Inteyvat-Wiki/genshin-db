			"dialogs": [
				{
					"id": 120211101,
					"content": "Beh, non è andata esattamente come avevo previsto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211102,
					"content": "Può succedere. Le battaglie sono avvenimenti complessi, in continua evoluzione. Non sempre è possibile aderire al piano originale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211103,
					"content": "Eheh... In effetti il piano è fallito già all'inizio dello scontro e abbiamo dovuto improvvisare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211104,
					"content": "Però il risultato è piuttosto soddisfacente ed evidenzia la vostra innata capacità di adattamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
