			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210101,
					"content": "Deve trattarsi dell'accampamento dei Fatui a cui si riferiva il commerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210102,
					"content": "Direi che un tempo era un accampamento di Hilichurl. Chissà perché i Fatui l'hanno occupato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210103,
					"content": "Sembra pieno di guardie. Come faremo a entrare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210104,
					"content": "#Sicuramente non con la forza bruta. Non c'è problema però, perché la conformazione del terreno ci favorisce. E poi, non ci hanno ancora avvistat{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210105,
					"content": "Il nemico si muove alla luce del sole, noi nell'ombra. Abbiamo un vantaggio strategico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210106,
					"content": "Cos'ha in mente la grande stratega?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210107
					]
				},
				{
					"id": 120210107,
					"content": "Uhm... Abbiamo tre opzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210108,
					"content": "Opzione uno: prendiamo il loro re e scacco matto. Al momento, l'influenza dei Fatui a Inazuma è debole. Rimangono solo poche unità isolate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210109,
					"content": "Se colpiamo dall'alto, eliminando per prima cosa il loro leader, gli altri difficilmente riusciranno a reagire con vigore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210110,
					"content": "#Opzione due: colpiamoli dove fa più male. Per esempio, laggiù. {NICKNAME}... vedi quei barili di polvere da sparo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210111
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210111,
					"content": "Se riuscissimo a incendiarli senza farci scoprire, infliggeremmo loro un colpo devastante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210112,
					"content": "Li coglieremmo completamente di sorpresa, annientandone morale e spirito combattivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210113,
					"content": "Opzione tre: usiamo gli elementi contro di loro. Il mare è vicino, quindi c'è molta umidità nell'aria. Potrei accumulare il vapore acqueo, a te basterebbe aggiungere qualche fulmine e potremmo dare loro una bella scossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210114,
					"content": "Wow, questa sì che è strategia! Bisogna rifletterci per bene... Che opzione scegliamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210115,
					"content": "Decidiamo in base ai nostri punti di forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210116
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210116,
					"content": "Un attacco aereo a sorpresa è la soluzione più rapida, ma richiederà grande abilità in combattimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210117
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210117,
					"content": "Con un'esplosione ridurremmo di molto sia il loro numero che la durata dello scontro. Dovremo però mantenere la furtività per l'intera operazione, nessuno dovrà avvistarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210118
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210118,
					"content": "#Se decideremo di sfruttare gli elementi, invece, si profilerà un lungo assedio all'orizzonte. A te la scelta, {NICKNAME}. Quale opzione preferisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210119,
						120210123,
						120210127
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210119,
					"content": "Attacco aereo a sorpresa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210120
					]
				},
				{
					"id": 120210120,
					"content": "#Ahah... Proprio come mi aspettavo, Capitan{F#a}{M#o} della Pesce spada II. Confido nelle tue abilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210121
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210121,
					"content": "#È deciso, allora, combatteremo insieme. Non sono una guerriera, ma sarò di supporto in battaglia. Non affronterai i nemici da sol{F#a}{M#o}, questo è certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210122
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210122,
					"content": "Eliminiamoli il prima possibile e recuperiamo la merce del commerciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210123,
					"content": "Usiamo la polvere da sparo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210124
					]
				},
				{
					"id": 120210124,
					"content": "Ahah, sembra che condividiamo le stesse preferenze sulle strategie militari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210125
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210125,
					"content": "È il piano che reputo più efficace, quello che ci metterà meno in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210126
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210126,
					"content": "Collaboriamo per regalare loro una sorpresa indimenticabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210127,
					"content": "Una tattica scioccante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210128
					]
				},
				{
					"id": 120210128,
					"content": "D'accordo. Prima però dovremo attirarli lontano, per limitare i danni all'accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210129
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210129,
					"content": "Non ho avuto molte occasioni per combattere al tuo fianco, in passato, quindi non so se riuscirò a reggere il tuo ritmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210130
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210130,
					"content": "Non temere, però. Non sono una guerriera, è innegabile, ma conosco i campi di battaglia. Uno scontro del genere è ampiamente nelle mie possibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210131
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210131,
					"content": "Bene, liberiamo l'accampamento e scopriamo cosa stanno tramando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 1202102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
