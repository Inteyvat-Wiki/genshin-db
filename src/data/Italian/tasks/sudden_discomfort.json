			},
			"dialogs": [
				{
					"id": 1903102101,
					"content": "È pericoloso camminare da soli qui, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102102,
					"content": "Non hai idea di chi... o di cosa incontrerai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102103,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "#Mmm, sembri piuttosto calm{F#a}{M#o}. Come si suol dire: \"non puoi tenere le scarpe asciutte camminando in riva al fiume\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102106,
					"content": "In un luogo così strano e inquietante si finisce con l'andare incontro a qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102107,
					"content": "E quel qualcosa potrebbe diventare un incubo che ti perseguiterà per il resto della tua vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102108,
					"content": "Oh, davvero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "Eh? Come fai a mantenere la calma? In genere gli altri scappano terrorizzati prima che finisca una frase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102111,
					"content": "A me sembri una persona qualsiasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "Sì, ma un modo più sofisticato d'interpretare un fantasma è creare un'atmosfera inquietante che spaventi psicologicamente le persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102113,
					"content": "In tal caso, il mio aspetto è irrilevante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102117,
					"content": "*sospira* Oltretutto, non riuscirei mai a spaventare qualcuno come te, che nei fantasmi non ci crede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102118,
					"content": "A me sembra che tu stia solo battendo la fiacca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "Ehi, non è vero! Oh, è meglio che vada a trovare dei fifoni da spaventare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102120,
					"content": "Dovresti tornare indietro dal tuo partner: sarà terrorizzato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102114,
					"content": "Non hai un costume o una cosa del genere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "Sì, ce l'ho, ma fa troppo caldo... Inoltre, un modo più sofisticato d'interpretare un fantasma è creare un'atmosfera inquietante che spaventi psicologicamente le persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102116,
					"content": "In tal caso, il mio aspetto è irrilevante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102109,
					"content": "Scusa, non capisco... Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "Ciao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
