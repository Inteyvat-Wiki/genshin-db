			"dialogs": [
				{
					"id": 50202001,
					"content": "Atea... è un'anziana che rispetto profondamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202002,
					"content": "Dopo la morte di mio nonno, gli anziani mi hanno nominata capo della nostra tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202003,
					"content": "Dato che ho sempre un sacco di idee nuove e assurde, tutti pensavano che avrei potuto guidare la nostra tribù verso un futuro diverso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202004,
					"content": "Tuttavia, per molto tempo non ho avuto idea di cosa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202005,
					"content": "Ma Atea è sempre stata lì a incoraggiarmi. Anche quando commettevo degli errori, lei non me ne ha mai fatto una colpa. Mi ha aiutata ad analizzare cosa fosse andato storto per fare meglio la volta successiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "Amina"
				},
				{
					"id": 50202006,
					"content": "È una persona che rispetto moltissimo... Ricorderò ciò che mi ha insegnato e farò del mio meglio per essere il capo che la tribù merita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amina"
				}
			]
		}
	]
