				]
			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "\"Guaaa!\"\\nCome se sapesse di non poter competere, il Qucusauro vola via...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "Argh, è veloce! È sparito in un batter d'occhio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180303,
					"content": "Forza, Paimon, seguilo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "C-Cosa?! Davvero vuoi che Paimon lo insegua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180307,
					"content": "...Mmm, se non altro sembra che si sia ripreso del tutto. Ora dovremmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180308,
					"content": "A proposito, perché il Qucusauro era così arrabbiato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180309,
					"content": "...Mmmh, Paimon lo sa! Scommette che gli hai rubato la merenda! Non c'è nulla di più esasperante del vedersi privati del cibo, Paimon lo sa fin troppo bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180310,
					"content": "La merenda? Beh, sì, ne ho assaggiata un po', ma Kururuk non è il tipo che si indispone per cose del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180311,
					"content": "\"Kururuk\"? Quindi ha un nome... Ma come Saurico sembra parecchio irascibile! Prima ti ha quasi colpita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180312,
					"content": "Beh, non lo biasimo, visto che il trattamento è quello che è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180313,
					"content": "Quindi anche essere picchiati è una forma di guarigione? Non si finisce mai di imparare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "Roar! Roooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#Cosa? Ma come ti viene in mente una cosa del genere? Piantala subito, o {REALNAME[ID(2)|SHOWHOST(true)]} si farà un'idea sbagliata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180316,
					"content": "Roar? Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "Ahah, se fosse una terapia efficace, mi piacerebbe provarla! Sfortunatamente, i Saurici sono diversi da noi. Anche se gli dicessi che qualcosa può aiutarli a guarire velocemente, non è detto che riuscirebbero a capirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180318,
					"content": "Ah, giusto, lasciate che mi presenti. Sono Mazkal. Mi occupo solitamente dei Saurici malati o feriti nelle vicinanze. Non per vantarmi, ma le mie medicine hanno ricevuto un sacco di apprezzamenti dai clienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180319,
					"content": "Mmm. Il tuo piccolo compagno sembra in ottima salute. Non credo abbia bisogno del mio aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180320,
					"content": "Roar! Roooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "Ah, quindi sei una veterinaria dei Saurici! Mmmh, a giudicare dal comportamento di Kururuk, sembra un lavoro duro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180322,
					"content": "Oh, non lo definirei così duro. È solo Kururuk che è un caso... abbastanza particolare. Al momento nutre una forte sfiducia nei confronti degli umani, quindi è ricalcitrante alle cure e alle medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180323,
					"content": "*sospira* Se solo fossi anch'io un Saurico. L'ho osservato, e va d'accordo coi suoi simili. Forse sarebbe disposto a prendere la medicina, se gliela raccomandasse un altro Saurico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180324,
					"content": "Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "Uhm. In tal caso, forse possiamo esserti d'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180326,
					"content": "Eh? Un attimo, stai dicendo che siete dei Saurici, nonostante il vostro aspetto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180327,
					"content": "Hai una fervida immaginazione! Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180328,
					"content": "#C-Comunque, se possiamo farlo è perché {REALNAME[ID(2)|SHOWHOST(true)]} è un Saurico super intelligente! Può aiutarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180329,
					"content": "Uh? È davvero così in gamba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180330,
					"content": "#Hai davvero buon occhio per aver scelto me come {F#compagna}{M#compagno}, se non altro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "Ehm... Vabbè, non è questo il punto, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180333,
					"content": "#Già! A ogni modo, lascia fare a {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180334,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180335,
					"content": "#Allora, a nome di Kururuk, permettimi di ringraziarti in anticipo, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180336
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180336,
					"content": "Il mio timore è che, continuando a comportarsi così, le sue vecchie ferite potrebbero non guarire, e che potrebbero addirittura apparirne di nuove... Sono molto sollevata che possiate aiutarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180337
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180337,
					"content": "Gli ho preparato due formule diverse. Ho fatto del mio meglio per trovare un equilibrio tra gli effetti terapeutici e il gusto, ma non sono comunque soddisfatta del risultato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180338
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180338,
					"content": "Il risultato finale è che, dei due medicinali, quello con le proprietà curative migliori non ha un sapore molto gradevole, mentre quello preferito dai Saurici non è così efficace...",
