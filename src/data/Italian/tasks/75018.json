			"dialogs": [
				{
					"id": 750180101,
					"content": "Groar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "Kururuk"
				},
				{
					"id": 750180102,
					"content": "Dai, dai, insomma, non fare i capricci. Se non prendi le medicine, non guarirai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180103,
					"content": "#Oh, no, è in pericolo! Dobbiamo aiutarla, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
