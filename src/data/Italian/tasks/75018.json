				{
					"id": 750181008,
					"content": "#Ahah, è bello sentire qualcuno che elogia {REALNAME[ID(2)|SHOWHOST(true)]} in questo modo. È persino più bello di quando fanno i complimenti a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181009,
					"content": "Mi stupisce vedere quanto andiate d'accordo con questo piccolo. Potrei imparare qualcosa da voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181010,
						750181011
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181010,
					"content": "Sono o non sono incredibile?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				},
				{
					"id": 750181012,
					"content": "Mi piacerebbe tanto poter dire che c'è qualcosa che posso fare per voi, o per aiutarvi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181013
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181013,
					"content": "Ma penso che mi limiterò ad augurarvi un'ottima salute. Vi auguro di non aver mai bisogno del mio aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181014
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181014,
					"content": "Ah, certo, ma se volete fare due chiacchiere, venite pure a trovarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181015
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181015,
					"content": "Certo! Paimon spera che Kururuk si riprenda presto... e che sia meno propenso a colpire la gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750181016,
					"content": "Non preoccuparti... Mi inventerò qualcosa. E poi, chissà, magari la sua rabbia si placherà un po' quando miglioreranno anche le sue ferite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750181011,
					"content": "#No, assolutamente, il merito è tutto di {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				}
			]
		},
