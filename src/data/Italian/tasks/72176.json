	"talks": [
		{
			"id": 7217601,
			"completionStepIds": [
				7217601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217601",
							"2"
						],
						"stepId": 7217601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Piccolo Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#Ciao, {F#sorella}{M#fratello}! Ho qualcosa che potrebbe interessarti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760102,
					"content": "Grazie, ma passo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "Che tristezza essere costretti a fare affari loschi in così giovane età.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760104,
					"content": "Non è come pensi! Volevo chiedervi se volevate giocare insieme a me alle temari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760105,
					"content": "Temari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760106,
					"content": "#È semplice: io nasconderò la temari da qualche parte qui vicino. Se {F#la sorella}{M#il fratello} riuscirà a trovarla entro la fine della canzone delle temari, avrà vinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760107,
					"content": "È così che si gioca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "Eh? Me l'ha insegnato una fantastica avventuriera. E ha detto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760109,
					"content": "\"Kujirai, ricorda. Devi dire: 'Se vinci, avrai una bella ricompensa'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760110,
					"content": "#Quindi, {F#sorella}{M#fratello}, se vinci, avrai una bella ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760111,
					"content": "#Una ricompensa! {NICKNAME}, Paimon pensa che sia giusto giocare con i bambini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760112,
					"content": "Continuo a pensare che il gioco delle temari non sia così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "Magari sono delle regole conosciute solo dalla gente del posto, non preoccupiamoci dei dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760114,
					"content": "Tu sei il Piccolo Kujirai, giusto? Giocheremo con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760116,
					"content": "Evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760115,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
