							"2"
						],
						"stepId": 7217602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccolo Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "Eh, è troppo difficile per voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760203,
					"content": "Ecco perché Paimon si stava riscaldando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760204,
					"content": "#{F#Sorella}{M#Fratello}, vuoi riprovare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760205,
					"content": "#Ma certo! {NICKNAME}, dobbiamo mostrare al Piccolo Kujirai di che pasta siamo {F#fatte}{M#fatti}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760206,
					"content": "Voglio riprovare!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "Evviva! L'obiettivo è trovare la temari entro il tempo limite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Kujirai"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccolo Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "#{F#Sorella}{M#Fratello}, è incredibile, l'hai trovata subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760703,
					"content": "#Ohoh, {NICKNAME} è {F#una viaggiatrice esperta}{M#un viaggiatore esperto} che ha visitato diverse nazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760704,
					"content": "#Wow! Sei stat{F#a}{M#o} anche a Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760705,
					"content": "Certamente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "Wooow! Ho sentito da quella avventuriera che Mondstadt è piena di luoghi straordinari, come le rovine di Terrore alato con delle torri altissime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760707,
					"content": "È il Covo di Terrore alato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Sì! Mi chiedo se quella torre sia più alta del Tenshukaku dell'onnipotente Shogun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760710,
					"content": "Piccolo Kujirai, perché sei qui fuori tutto solo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760711,
					"content": "Perché quando mia sorella stava pescando ha pensato che avrei spaventato i pesci, quindi mi ha lasciato uscire a giocare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760712,
					"content": "Una volta ho incontrato quell'avventuriera. Ha visto che mi annoiavo, così mi ha dato un sacco di temari dicendomi di \"trovare dei viaggiatori avidi con cui giocare\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760713,
					"content": "Viaggiatori avidi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "#Noi non siamo avid{F#e}{M#i}! Siamo preoccupat{F#e}{M#i}! Paimon è preoccupata che tu possa annoiarti a giocare da solo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760715,
					"content": "#È vero, penso che {F#la sorella}{M#il fratello} sia davvero gentile, sono così felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760716,
					"content": "Da solo nella natura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "Sei un ragazzino tutto solo nella natura, non hai paura dei pericoli? Per non parlare delle \"ricompense\" che ti porti appresso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760718,
					"content": "#Sei davvero gentile, {F#sorella}{M#fratello}. Non preoccuparti, l'avventuriera mi ha insegnato come fare. Posso trasformare la temari in una bomba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760719,
					"content": "Oh, no! È pericoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760720,
					"content": "Niente affatto! Ho fatto fuori un sacco di cattivi, come gli Hilichurl e i Melmosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760721,
					"content": "Sei tu quello pericoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760722,
					"content": "#Certo, {F#sorella}{M#fratello}, se volessi giocare alle temari con qualcun altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760723,
					"content": "Ne lascerò una qui! Ecco le regole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760724,
					"content": "La persona che nasconderà la temari e quella che dovrà cercarla dovranno farlo prima che finisca la canzone. In questo modo, il gioco sarà più equo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760725,
					"content": "Ho capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "È spaventoso pensare che stiamo giocando con delle bombe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760727,
					"content": "#Niente paura, {F#sorella}{M#fratello}. L'avventuriera mi ha detto: \"Le bombe colpiranno solo i cattivi. Probabilmente\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760728,
					"content": "\"Probabilmente?!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760729,
					"content": "#Vado a giocare da un'altra parte! Ciao ciao, {F#sorella}{M#fratello}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Kujirai"
				},
				{
					"id": 721760708,
					"content": "Ah, sì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}