			"dialogs": [
				{
					"id": 765040701,
					"content": "#{F#Bentrovate}{M#Bentrovati}, {NICKNAME} e Paimon. Avete già mangiato? C'è nulla che avete in programma per oggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040702,
					"content": "Stiamo solo dando un'occhiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Ricevuto. Fare due passi e immortalare ciò che si vede con una foto è un modo ideale per rilassarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040705,
					"content": "Tuttavia, non rilevo alcuna Fotokamera su di voi. Non l'avete lasciata a casa nella fretta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040703,
					"content": "E cercando soggetti da fotografare, già che ci siamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				}
			]
