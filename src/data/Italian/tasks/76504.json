			"trigger": {
				"objectNames": [
					"Ineffa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#{F#Bentrovate}{M#Bentrovati}, {NICKNAME} e Paimon. Avete già mangiato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040102,
					"content": "Ineffa? Che ci fai qua sul tetto? Stai... osservando le nuvole per calcolare la probabilità di pioggia o roba simile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040103,
					"content": "Sto svolgendo un compito che ha subito una... deviazione inaspettata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040104,
					"content": "Il piano originale consisteva nell'acquistare un \"ingranaggio ad alta precisione\" e una \"vite esagonale speciale\", come indicato nella lista di Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040105,
					"content": "Tuttavia, nel tragitto di ritorno, si è verificato... un incidente inaspettato. Un falco, volando a gran velocità, mi ha sottratto l'ingranaggio speciale dalle mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040106,
					"content": "Quindi sei salita quassù per cercare quel falco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "Affermativo. Le abitudini di questa specie suggeriscono una propensione a utilizzare tetti come luoghi di sosta temporanei. Risposta: scansione visiva e sonora in corso. Obiettivo: individuare il bersaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040108,
					"content": "Tuttavia, finora non ho trovato alcuna traccia del suddetto bersaglio. Deduzione iniziale: l'obiettivo è sfuggito al raggio di rilevamento, o ha portato il suo \"bottino\" in un nido più isolato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040109,
					"content": "Avvio piano di riserva: ritornare dal fornitore e acquistare un'altra vite dello stesso tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040110,
					"content": "A ogni modo, state per caso cercando anche voi delle piccole creature?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040111,
					"content": "Oh, no. Niente affatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "Sì. All'inizio volevamo trovare un posto con una bella visuale per scattare delle foto panoramiche di Nasha e della sua vivacità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040114,
					"content": "Non ci aspettavamo d'incontrarti mentre eri a caccia di un \"ladro\". Queste \"deviazioni inaspettate\" non devono capitare molto spesso, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040115,
					"content": "Ma visto che si è presentata l'occasione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "Va bene. Si prega di indicare la posa, la direzione e l'espressione facciale preferite. Farò del mio meglio per soddisfare tutti i requisiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040118,
					"content": "Stima: le possibilità che io salissi sul tetto, incontrassi voi e mi richiedeste una foto erano inferiori rispetto alle possibilità attuali che il falco mi restituisca l'ingranaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040119,
					"content": "Assicuratevi pertanto di immortalare con cura questa \"rara e piacevole sorpresa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040116,
					"content": "Ti spiace se ti scattiamo una foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "Stiamo solo cercando dei soggetti da fotografare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
