			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "Ehi! Non vedi che sono qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060102,
					"content": "Questi giovani d'oggi... Non sanno proprio cosa sia l'educazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060103,
					"content": "M-Mi dispiace!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "Tsk! Così va meglio. Per quanto riguarda quei funghi, consideralo un mio regalo... Ma non osare toccare gli altri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060105,
					"content": "Questi funghi sono tuoi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "Non sono affari tuoi! Smettila di raccoglierli e vattene da qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		},
		{
			"id": 7220602,
			"completionStepIds": [
				7220603
			],
