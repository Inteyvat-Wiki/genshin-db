				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "Oooh! Ahahah... Wow, che forme strane! Hanno anche un'anima? Contengono i ricordi delle persone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060502,
					"content": "E queste cose morbide, che sembrano delle ali... Possono volare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060503,
					"content": "Ah, io e la mia inesauribile curiosità! Penso che il battelliere si sia stancato di aspettarmi. Mi dispiace, ma ora devo andare. Sì, devo proprio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		}
	]
