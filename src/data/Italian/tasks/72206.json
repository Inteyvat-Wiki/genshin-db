				{
					"id": 722060401,
					"content": "Come sta andando? Sono pronto ad ampliare i miei orizzonti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060402
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060402,
					"content": "Vanno bene questi funghi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7220605,
			"completionStepIds": [
				7220607
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220607",
							"2"
						],
						"stepId": 7220607,
						"stateName": "QUEST_STATE_UNFINISHED"
