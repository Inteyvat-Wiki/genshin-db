			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 210200001,
					"content": "\"...Immagino sia qui che conduce la troppa avidità, quando vuoi tutto e non capisci quand'è ora di fermarti. Se avessi smesso quando ho trovato il tesoro nascosto e non avessi voluto raggiungere quel fiacco falò a tutti i costi, non avrei mai attivato il meccanismo e quel terribile mostro non mi avrebbe intrappolato. Ora non posso più uscire.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210200002
					],
					"speakerTitle": "Lettera rovinata"
				},
				{
					"id": 210200002,
					"content": "\"A chiunque abbia la stoffa per eliminarlo: va' a quel falò ed esprimi un desiderio. Va bene uno qualsiasi. Io ti darò una mano, ehm... facendo il tifo per te!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lettera rovinata"
				}
			]
		},
		{
			"id": 2102020,
