			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 210202001,
					"content": "\"...Questa storia del falò che esaudisce i desideri non ha alcun senso! Però i tesori nascosti sotto sono veri... Il capo dice che dovrei lasciare il pezzo di carta dove l'ho trovato e rimanere in attesa nei paraggi... Senz'altro qualcuno ci cascherà, e non appena il fuoco si accenderà... Eheh. Questo sì che è un colpo di genio...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210202002
					],
					"speakerTitle": "Appunti scarabocchiati"
				},
				{
					"id": 210202002,
					"content": "\"...Detto ciò, questo tesoro è così ricco che non riuscirò mai a trasportarlo tutto in una volta sola. Il capo ha detto che prima di tutto dovrei sotterrarlo <color=#00E1FFFF>nel punto più alto del Pendio di Cuijue</color>. Lì sopra c'è un enorme albero vecchio e appassito, non può sbagliarsi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Appunti scarabocchiati"
				}
			]
		}
