			"dialogs": [
				{
					"id": 760810101,
					"content": "Ho sentito dire che il leggendario Starsina, Sigurd, brandiva una spada lunga, e la sua abilità nel cacciare mostri era senza eguali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810102,
					"content": "Scomparve dopo una grande battaglia, e questa tomba vuota fu eretta in suo onore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810103,
					"content": "Una lama viola e capelli dorati... Dev'essere il guerriero errante che combatte contro la Caccia selvaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810104,
					"content": "Sembra che il suo spirito non abbia trovato pace nella sua tomba, proprio come i tanti spiriti nel Cimitero dell'Ultima Notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810105,
					"content": "Puntando la sua spada contro la Caccia, lo spirito dell'eroe rimane incrollabile, anche dopo la morte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810106,
					"content": "...Sigurd, sei un uomo degno del mio rispetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810107,
					"content": "Tuttavia, combattere da solo per odio e per senso del dovere è un destino troppo crudele per un guerriero del tuo calibro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810108,
					"content": "Ti mancano i giorni in cui condividevi bevande e canzoni con i tuoi compagni Guardaluce, Sigurd? Hai ancora un motivo per impugnare la tua lama, oltre all'appetito di massacrare i tuoi nemici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810109,
					"content": "Se è così, mostrati. Proprio come ai vecchi tempi, come nei tuoi giorni da Guardaluce, affrontiamoci a duello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
