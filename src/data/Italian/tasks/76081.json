					}
				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "È stata una battaglia eccellente, Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "Peccato che sia arrivata la tua fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "Vagare da soli nella terra per cui hai sacrificato la tua vita... Avevi previsto l'arrivo di questo giorno quando hai prestato il giuramento dei Guardaluce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "Ma anche se fosse, non hai esitato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "Ti farò di nuovo visita in futuro. Arrivederci, Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7608103,
			"completionStepIds": [
				7608102
			],
