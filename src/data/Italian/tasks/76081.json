					}
				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "Ha combattuto bene, signor Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810402,
					"content": "Stia tranquillo. Dopo che lei e i suoi compagni siete stati sconfitti, mio padre Nikita ha assunto il ruolo di Starsina e ha guidato le persone che avete salvato per ripristinare l'ordine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810403,
					"content": "Oggi siamo abbastanza forti da proteggere questa terra, anche sotto l'ombra della Caccia selvaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810404,
					"content": "Il suo sacrificio non è stato vano. Le sue gesta e la sua volontà vivranno per sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810405,
					"content": "Addio, signor Sigurd. Verrò a trovarla di tanto in tanto. Che possa finalmente trovare la pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
