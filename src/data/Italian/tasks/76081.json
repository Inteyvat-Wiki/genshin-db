			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "Il modo in cui annienta i mostri... No, quella figura leggendaria si è sacrificata tempo fa nell'adempiere al proprio dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819902,
					"content": "Che si sia risvegliato di nuovo, in qualche modo? Mmh... Sarebbe da andare alla spiaggia a nord-est della Landa di Ossomuschio. È lì che si trova la sua tomba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819903,
					"content": "Un tempo, il vecchio mi raccontava le storie del leggendario Starsina Sigurd, con il quale aveva combattuto anni prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819904,
					"content": "La lama viola, i capelli dorati... Esattamente come descritto nelle leggende. La persona che ho incontrato nei giorni scorsi... potrebbe davvero essere lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819905,
					"content": "Il suo luogo di riposo si trova sulla spiaggia a nord-est della Landa di Ossomuschio. Se avrò tempo, andrò a dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}