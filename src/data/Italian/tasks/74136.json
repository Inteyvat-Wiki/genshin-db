			"dialogs": [
				{
					"id": 741361001,
					"content": "Edwin... Lo sapevo! Li hai attirati tu... Sei sempre stato geloso di me! Spaventato all'idea che la mia ricerca superasse la tua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361002,
					"content": "Hai ragione. Sono davvero geloso della tua totale inconsapevolezza e ignoranza. Non mi meraviglia che tu abbia condotto una vita così beata all'Istituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361003,
					"content": "Se soltanto Choiseul fosse qui per vederlo... Sverrebbe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361004,
					"content": "Farebbe meglio a non svegliarsi mai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "Tu torna all'Istituto con loro e pentiti... Io devo tornare alla mia ricerca... Non hai rotto niente, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361007,
					"content": "Chi ha detto che puoi tornare alla tua ricerca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "Che cosa avete intenzione di fare? Riportarmi all'Istituto? Come posso continuare la mia ricerca in questo modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361010,
					"content": "Quello sciocco di Raimondo ha gettato l'intero Istituto nel caos. E quell'idiota di Choiseul... Argh! Il solo pensiero mi fa venire mal di testa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361011,
					"content": "Sei tu che hai gettato l'Istituto nel caos! Smettila di scaricare la colpa sugli altri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361012,
					"content": "Io? Bene. Quindi volete dare a me la colpa dell'esplosione al Laboratorio centrale? Ma sapete una cosa? Io nemmeno ero lì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361013,
					"content": "L'Istituto è pieno di idioti! È sufficiente che qualcuno rovesci una tazza di caffè per causare un malfunzionamento dell'equipaggiamento, quindi non mi sorprende che siano riusciti a scatenare un'esplosione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361014,
					"content": "Allora perché non hai provato a spiegarglielo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "Spiegarglielo? Non ho intenzione di diventare il loro capro espiatorio. Ho un gran da fare con la mia ricerca e non posso perdere il mio tempo con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361016,
					"content": "E quindi hai deciso di immischiarti con gente come Concini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361017,
					"content": "Oh, lui non è meglio... Non è neanche riuscito a mettere le mani su un equipaggiamento di precisione. Ho dovuto fare tutto io. Almeno lui si è offerto di sovvenzionare la ricerca, affinché tutto andasse liscio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361018,
					"content": "Ma non mi aspettavo che il nostro caro Nacker venisse qui con quel prototipo di nucleo incompleto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361019,
					"content": "L'ho modificato! Con una tecnologia che tu non saresti mai in grado di sviluppare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361020,
					"content": "Ahah! Signor Nacker, Concini non è qui per farsi adulare da te, quindi perché non la smetti di mentire a te stesso? Non hai un briciolo di dignità come ricercatore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361021,
					"content": "Tu...! È incompleto soltanto perché non sai come completarlo! Ma io lo so, e posso farlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361022,
					"content": "Bene. Ora riporta questo ciarpame all'Istituto e continua a sfruttarlo. Io ho qualcosa di più importante che richiede la mia attenzione. Tu... Fusi-cosa, lo lascio a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361023,
					"content": "Quei due smetteranno mai di litigare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361024,
					"content": "Basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361025,
					"content": "Cosa c'è? Puoi smetterla di farmi perdere tempo? Devo tornare al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361026,
					"content": "Ho detto... basta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361027,
					"content": "Edwin Eastinghouse! Tu sei quello che ha fatto saltare in aria l'Istituto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361028,
					"content": "E tu, Nacker, tu hai rubato le risorse dell'Istituto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361029,
					"content": "E hai fatto saltare in aria l'Istituto una seconda volta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "Entrambi avete danneggiato gli interessi dell'Istituto... L'Istituto di ricerca di Fontaine mi ha affidato questa indagine speciale, quindi vi riporterò entrambi all'Istituto dove si occuperanno di voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361031,
					"content": "Mannaggia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361032,
					"content": "Oh, ma per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361033,
					"content": "Io e Lemarcq scorteremo questi due a destinazione. Siamo stati a lungo dei galoppini, ora l'Istituto ci ricompenserà di sicuro, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361034,
					"content": "Ricordate, tenete la bocca chiusa durante il tragitto, o potreste andare incontro a una fine prematura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361008,
					"content": "Non fare un altro passo! Ti avverto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "Sto per svenire anche io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
