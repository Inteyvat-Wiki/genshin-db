			"dialogs": [
				{
					"id": 741360601,
					"content": "Un enorme spazio vuoto con... niente dentro... Dobbiamo tornare a mani vuote?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360602,
					"content": "Le piante sono state intenzionalmente ripulite... E la potatura sembra relativamente recente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360603
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360603,
					"content": "Dopo tutto ciò che ho fatto per lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360604
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360604,
					"content": "Comunque, io scenderò a dare un'occhiata. Tu resta con la signora dell'Istituto. Se le cose sfuggono di mano... portala via da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360605
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360605,
					"content": "Ma qui non c'è niente. Come è possibile che le cose sfuggano di mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360606
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360606,
					"content": "Squit! Bip bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360607
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360607,
					"content": "Woah! Attenzione! Sta arrivando qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
