			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edwin Eastinghouse",
					"Lemarcq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "Cosa... Cosa ci fai ancora qui? Te l'avevo detto. Puoi provarci cinque volte e non lo troverai comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363402,
					"content": "È chiaro che le cose non ti vanno per il verso giusto, quindi perché non ti siedi e prendi un po' di tè? Ho appena comprato cinque tazze... e qualche ciotola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363403,
					"content": "Ti piace molto il numero \"cinque\", vero, Monsieur Edwin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741363404,
					"content": "Sì! È un numero magico! Se usato bene apre le porte a un'ispirazione inesauribile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363405,
					"content": "Le cose stanno così: per arrivare a un'ispirazione inesauribile ci sono cinque porte e ogni maniglia va girata cinque volte... Cinque! Capito? Cinque volte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363406,
					"content": "Scusa, ma sto davvero cercando di trattenermi dal darti cinque ceffoni. Potresti gentilmente chiudere il becco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lemarcq"
				}
			]
		}
	]
}