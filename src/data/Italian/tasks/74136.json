			"dialogs": [
				{
					"id": 741360401,
					"content": "Ecco perché continuava a ripetere il numero \"cinque\": ci stava dando dei suggerimenti su come risolvere l'indovinello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360402,
					"content": "Perché non ce l'ha detto chiaro e tondo? Perché menare il can per l'aia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360403,
					"content": "Umpf... Chissà cosa gli passa per la testa... Sembrava volerci condurre da Nacker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360404,
					"content": "Qualcuno ha lasciato le tute da immersione proprio accanto alla casa... Quasi come se fossero state preparate per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360405,
					"content": "Pare ci abbia trovati prima lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "Nessun valore di ricerca... Ma io... ho passato così tanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360408,
					"content": "Fusilier... Ha mormorato tra sé e sé per tutto il tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360409,
					"content": "#Ma... {NICKNAME}, non hai la sensazione qualcuno ci stia osservando? Paimon sente dei brividi lungo la schiena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360410,
					"content": "Vado avanti e do un'occhiata all'interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360406,
					"content": "Comunque, iniziamo occupandoci di Nacker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
