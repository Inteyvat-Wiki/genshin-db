			},
			"dialogs": [
				{
					"id": 741361101,
					"content": "#Madame Fusilier! {NICKNAME}! Siete qui! Allora avete risolto la situazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361102,
					"content": "Oh, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "Woah! Monsieur Choiseul sta davvero per svenire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361104,
					"content": "Non credevo che saresti tornato all'Istituto, Choiseul. Pensavo che le scartoffie ti avrebbero tenuto occupato per sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361105,
					"content": "Questo... Questo è impossibile! Bontà divina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361106,
					"content": "Raimondo, come ci si sente ad aver preso il mio posto? Hai qualcosa di importante da riferire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361107,
					"content": "Che meravigliosa rimpatriata, Monsieur Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361108,
					"content": "Ah! Guardati intorno. Sembri davvero perfetto per fare il custode.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361109,
					"content": "Umpf! Non ha nemmeno dato una ripulita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361110,
					"content": "Soprattutto perché non ha spazzato via gente come te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Grazie per aver riportato indietro questi due, Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o} {NICKNAME}, Madame Fusilier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361112,
					"content": "Come è auspicabile, questo segna la fine della serie di sfortunati eventi e disordini dell'Istituto di ricerca di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361113,
					"content": "Ahahah! Ottimo. L'Istituto di ricerca di Fontaine ora cadrà in un'immobilità mortale, in cui tutte le ispirazioni avvizziranno e moriranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361114,
					"content": "Tu di certo sei già stato fonte di grande ispirazione nell'Istituto. È il momento di calmare un po' le acque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361115,
					"content": "Raimondo Havenport, tu non sai niente di ricerca. Non sei adatto a guidare l'Istituto di ricerca per l'ingegneria dell'Energia cinetica di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361116,
					"content": "Ma io so come mantenerlo attivo e funzionante, Edwin Eastinghouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361117,
					"content": "Quello che tu devi fare adesso è stare lontano dalla ricerca e dall'Arkhium. È la cosa migliore per tutti noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361118,
					"content": "Poco dopo, il personale della Maison de la Garde arriva e preleva Nacker ed Edwin. Finalmente lasciano l'Istituto per sempre...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Grazie al cielo, il mio incubo si è definitivamente concluso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361120,
					"content": "Monsieur Chaussivert? Monsieur Lemarcq? Ho sentito che siete stati di grande aiuto per il nostro istituto. Fermatevi a riposare qui da noi, mentre ci occupiamo di preparare il vostro compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361121,
					"content": "Ahahah! Non avrei mai pensato che uno come me potesse essere associato all'Istituto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361122,
					"content": "Non parli in questo modo di sé, caro signore! Lei è buono e sincero, quindi è senza dubbio una brava persona. Magari ci avvarremo della sua collaborazione in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361123,
					"content": "#Venendo a te... Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}, ci hai reso nuovamente un grande favore. Come potremo mai ripagarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361124,
					"content": "Facendo in modo di non saltare in aria di nuovo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "A proposito... Dov'è Madame Fusilier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361129,
					"content": "Le abbiamo dovuto lasciare un po' di tempo per calmarsi. A quanto pare, l'immagine di Edwin Eastinghouse che si era creata nella sua testa è stata completamente distrutta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361130,
					"content": "Anche Edwin e Nacker devono calmarsi... Spero che possano riflettere sui propri errori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361131,
					"content": "Resteranno a Forte Méropide per tutta la vita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "A giudicare da quanto sono pericolosi, spero che non lascino quel posto mai più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361133,
					"content": "Tuttavia, visto come stanno le cose qui all'Istituto di ricerca di Fontaine... Posso solo sperare di non imbattermi in situazioni che richiedano la loro competenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361134,
					"content": "#Ti ringrazio ancora per conto dell'Istituto di ricerca di Fontaine, Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o}. Se hai altre domande, sono a tua disposizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361125,
					"content": "Che ne dici di una promozione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Ecco... In teoria, il tuo attuale titolo è già il massimo... Ma fammi vedere cosa posso fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361127,
					"content": "#Qualcosa tipo... Ricercat{F#rice}{M#ore} senior onorari{F#a}{M#o} capo? Ahahah...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
					],
					"speakerTitle": "Choiseul"
				}
			]
		},
		{
