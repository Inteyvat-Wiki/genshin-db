			"dialogs": [
				{
					"id": 741360901,
					"content": "Cani dell'Istituto! Cosa vi hanno offerto Choiseul e Raimondo?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360902,
					"content": "Solo un titolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "Tu... Tu... Senti, lasciami andare. Il mio \"generatore di campo\" è quasi pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360905,
					"content": "Quando riuscirò a sincronizzarlo con il Nucleo cinetico dell'Arkhium diventerò il più grande ingegnere cinetico di sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360906,
					"content": "Prendersi il merito del lavoro di qualcun altro e pretendere di essere il più grande ingegnere... Vergognati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360907,
					"content": "Ora finalmente so perché Monsieur Ed... Edwin non ha mai voluto che tu partecipassi al progetto di ricerca del nucleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360908,
					"content": "Edwin non ha idea del suo potenziale! Anche tu arrivi dall'Istituto... Sai qual è il vero valore di questa cosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360909,
					"content": "Aiutami! Possiamo... svilupparlo insieme! Diventeremo famosi, leggendari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360910,
					"content": "Edwin, Raimondo, Choiseul... Nessuno potrà superare la nostra fama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360911,
					"content": "Sembra che Raimondo dicesse la verità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "Edwin... Le scoperte di Monsieur Edwin... appartengono all'Istituto. Io sono qui solo per rivendicarle, niente di più, niente di meno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360914,
					"content": "Madame Fusilier... ha cambiato improvvisamente il modo in cui parla di Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360915,
					"content": "Non essere sciocca, ragazza! Non sai cosa può darci Concini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360916,
					"content": "Non otterremmo mai altrettanto lavorando per Edwin, neanche in un milione di anni! Edwin e l'Istituto volevano solo usarci... Dobbiamo pensare con la nostra testa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360918,
					"content": "Ora basta! Ne ho avuto abbastanza di queste sciocchezze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360919,
					"content": "E tu chi diavolo sei?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360920,
					"content": "La persona che vigila sul Porto Lumidouce. Un'altra parola e assaggerai i miei pugni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}, aiutami a legarlo e a prendere quel nucleo o quello che è. È ora di tornare indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360912,
					"content": "Deve essere stata dura per te, Nacker, tenerti tutto questo dentro per così tanto tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "#Neanche un Mora. Mi sono offert{F#a volontaria}{M#o volontario}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
		{
