			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "*sospira* Chissà come sta il ragazzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "Mmh? Oh, che tempismo, ti ricordi la lettera dell'ultima volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020104,
					"content": "Se hai un po' di tempo, ti prego di consegnare questa lettera a Grace da parte mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020105,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020107,
					"content": "Perché io?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "Beh, non mi fido molto di quei piccioni, dopo ciò che è successo l'ultima volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020109,
					"content": "E poi, se portassi io stesso la lettera a Mondstadt, dovrei incontrare quel ragazzino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020110,
					"content": "*sospira* Non fare domande... Ti prego... Fammi questo favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "Pensavo dovessi consegnare la mia lettera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020202,
					"content": "Riguardo alla lettera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "...Parla di una cosa successa tanto tempo fa. Immagino che tu non l'abbia letta la volta scorsa, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020204,
					"content": "Non disturbarti a leggerla, è lunga e arzigogolata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020205,
					"content": "Chi è il ragazzo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "Se proprio vuoi saperlo, è quel ragazzino che dà sempre da mangiare ai piccioni sul ponte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020207,
					"content": "Sì, Timmie. Per via di alcune ragioni... al momento è meglio che io lo eviti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020208,
					"content": "#Content{F#a}{M#o}, adesso? Sbrigati, porta la lettera a Grace prima che inizi ad agitarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "Che strano, dovrebbe essere già qui... Che sia successo qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020302,
					"content": "Una lettera per te, da Draff.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "Eh? Che ci fai tu qui? Non sei un piccione viaggiatore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020304,
					"content": "È... successo qualcosa ai piccioni? Oh, cielo. Non ci si annoia mai al Villaggio Acquachiara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020305,
					"content": "Beh, grazie per avermi portato la lettera. Un secondo, ho qualcosa da darti in cambio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020306,
					"content": "Riguardo alla lettera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "Oh, l'hai letta? Non che abbia importanza, non è niente di confidenziale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020308,
					"content": "Per dirla con le parole di Draff, è solo una cosa successa tanto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020309,
					"content": "Ma anche se è passato tanto tempo, non lo dimenticheremo mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020310,
					"content": "Prego, continua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "Lo vuoi davvero sapere? Beh, mi sembri una persona affidabile... ma promettimi che manterrai il segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020312,
					"content": "Lo prometto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "Il padre di Timmie è un buon amico di Draff. Fanno tutto insieme: cacciano, bevono, combinano guai d'ogni tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020317,
					"content": "Non so quante volte sono stati ammoniti dai Cavalieri o redarguiti da sorella Victoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020318,
					"content": "Poi, quando è nato Timmie, suo padre si è dato una calmata, è diventato astemio e tutto il resto. Ha iniziato a lavorare sodo per provvedere alla sua famiglia e dare il buon esempio al figlio, come dice lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020319,
					"content": "Era diventato così ossessionato dal non rappresentare un cattivo esempio per Timmie che era persino riuscito a far smettere Draff di bere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020320,
					"content": "Certo... a volte facevano un'eccezione: quando non riuscivano proprio a farne a meno, si incontravano e bevevano sidro di mele in quantità. Una o due volte, anch'io mi sono unita a loro per bere un bicchiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020321,
					"content": "Purtroppo, un giorno il padre di Timmie rimase gravemente ferito in un incidente di caccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020322,
					"content": "Draff lo portò qui il più in fretta possibile, e le provammo tutte per salvarlo... ma, ahimè, non ce la fece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020323,
					"content": "Così, Draff mi chiese di prendermi cura di Timmie, mentre lui sarebbe tornato al Villaggio Acquachiara per diventare un cacciatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020324,
					"content": "Ogni mese, gli manda una lettera e dei soldi, ma non riesce a sopportare di vedere Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020325,
					"content": "Di recente, ha iniziato a dire che vuole raccontare a Timmie la verità su quel giorno fatale... *sospira* Tremo al pensiero di ciò che deve aver passato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020326,
					"content": "Non vuoi che Timmie sappia la verità?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "Esatto, è ancora solo un bambino... Non credo sia saggio raccontargli tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020328,
					"content": "Anche se ora dice di essere grande, e mi aiuta persino a prendermi cura di Nora e Glory...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020329,
					"content": "...Non so se riuscirebbe a sopportare tutti quei dettagli così crudi. Sarebbe troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020330,
					"content": "Forse quando sarà più grande, ma ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020331,
					"content": "Preferirei avesse l'opportunità di vivere un'infanzia felice, anche se questo significa non essere del tutto onesti con lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020341,
					"content": "Non nego che Timmie stia crescendo, però. Ogni giorno è più curioso e fa sempre più domande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020342,
					"content": "Sta diventando sempre più difficile stargli dietro, per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020343,
					"content": "Nora dice che Timmie la trascinava sempre in mezzo alla natura, dicendole che voleva trovare un regalo per suo padre o mandargli una lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020344,
					"content": "Ma, ultimamente, è sempre imbronciato e svogliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020345,
					"content": "Se hai tempo, potresti dare uno sguardo a Timmie per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020346,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "Splendido, grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020348,
					"content": "Non puoi farlo tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "È imbarazzante, ma... anche se continuo a ripetermi che non voglio dirgli la verità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020350,
					"content": "...Ogni volta che mi ripete di voler scrivere una lettera a suo padre, sento il cuore sprofondare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020351,
					"content": "Temo che un giorno non riuscirò a trattenermi e finirò per raccontargli tutta la storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020352,
					"content": "Non posso permettere che succeda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020353,
					"content": "Perciò, ti prego, vai da lui al posto mio per sapere come sta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020332,
					"content": "Non puoi nasconderglielo per sempre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "Lo so, davvero... ma è ancora così giovane...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020334,
					"content": "Spero solo che... No, voglio che abbia la possibilità di trascorrere un'infanzia felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020335,
					"content": "In questo modo, se durante la sua vita dovesse succedergli qualcosa di orribile, almeno avrebbe dei bei ricordi in cui rifugiarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020336,
					"content": "Cosa c'è di tanto male nel sapere la verità?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "Mmmh... Beh, è normale che una persona come te la pensi così. Ne hai già passate tante, e ne hai tratto coraggio e resilienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020338,
					"content": "#Non ho dubbi che qualsiasi cosa ti abbia portat{F#a}{M#o} a diventare chi sei oggi ti abbia espost{F#a}{M#o} a esperienze molto dolorose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020339,
					"content": "Ma Timmie è ancora troppo piccolo. Forse è solo frutto del mio egoismo, ma non voglio che si trovi a sopportare più di quanto possa reggere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020340,
					"content": "Per lo meno... voglio che trascorra un'infanzia felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020313,
					"content": "Non posso promettere niente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "Uff, sei insopportabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020315
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020315,
					"content": "Ma... andiamo avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020316
					],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 2010204,
			"completionStepIds": [
				2010203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
