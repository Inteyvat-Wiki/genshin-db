			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020601,
					"content": "Hai preso i denti di leone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020602
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020602,
					"content": "Ce li ho.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "Sì! Sono tantissimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020604,
					"content": "Ora metto dentro i semi di dente di leone... chiudo la busta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020605,
					"content": "...Ed ecco qua, tutto pronto! Evviva! Papà sarà felicissimo di ricevere la mia lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020606,
					"content": "Ma... ho sentito che serve un piccione viaggiatore addestrato, per mandare una lettera. E io non conosco l'indirizzo di papà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020607,
					"content": "Oh, un momento... Mi sono ricordato una cosa: la mamma dice che il signor Draff del Villaggio Acquachiara alleva piccioni viaggiatori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020608,
					"content": "E dice anche che il signor Draff conosce papà. Lui dovrebbe riuscire a mandare la lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020609,
					"content": "Allora... puoi aiutarmi ancora una volta? Porta questa lettera al signor Draff, così la manderà a papà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020610,
					"content": "E un'altra cosa... Non sbirciare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
			"id": 2010207,
			"completionStepIds": [
				2010206
