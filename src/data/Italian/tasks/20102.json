			},
			"dialogs": [
				{
					"id": 201020501,
					"content": "Comunque, portami dei <color=#00E1FFFF>denti di leone</color>! Me l'hai promesso. Io ho quasi finito di scrivere la lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
			"id": 2010206,
