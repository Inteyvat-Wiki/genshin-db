			},
			"dialogs": [
				{
					"id": 201020901,
					"content": "Ricorda, la devi portare al signor Draff del Villaggio Acquachiara, non darla alla persona sbagliata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020902
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020902,
					"content": "Mamma dice che lui e papà sono migliori amici. Di sicuro saprà come consegnargli questa lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020903
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020903,
					"content": "Ma... mamma dice anche che il signor Draff e papà sono molto impegnati con il loro lavoro... Chissà se anch'io sarò impegnato come loro, quando crescerò...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020904
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020904,
					"content": "Ah, non fa niente, finché posso dare una mano a papà, non importa se sarò impegnato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
