			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020401,
					"content": "Ancora nessuna novità... Neanche una parola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020402,
						201020405
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020402,
					"content": "Stai dando da mangiare ai piccioni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020403
					]
				},
				{
					"id": 201020403,
					"content": "L'ho già fatto, per oggi. E li ho anche fatti volare via, prima, per metterli al sicuro... da te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020404
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020404,
					"content": "Ora sto scrivendo una lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020407,
					"content": "Mamma dice che papà mi manderà una lettera con un piccione, non appena avrà tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020408
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020408,
					"content": "Ma io non faccio altro che aspettare e non ho ancora ricevuto niente... Forse papà è troppo impegnato al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020409,
					"content": "Se è davvero così, voglio mandargli una lettera io per primo con dentro un bel regalo. Ma quale potrebbe essere un bel regalo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020410,
					"content": "Ci sono! <color=#00E1FFFF>Denti di leone</color>. Mamma dice che tutti a Mondstadt amano i denti di leone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020411,
					"content": "Avresti tempo di raccogliere dei <color=#00E1FFFF>denti di leone</color> per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020412,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "Evviva! Grazie! Allora sai essere anche gentile, A VOLTE...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020414,
					"content": "Solo denti di leone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "Mi piacerebbe mandargli qualcosa di meglio, ma se il pacchetto è troppo pesante, il piccione non riuscirà a trasportarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020416,
					"content": "E papà lavora mooooolto lontano... Il piccione deve già fare molta strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020405,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020406
					]
				},
				{
					"id": 201020406,
					"content": "Scrivo una lettera a papà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "Timmie"
				}
			]
		},
		{
