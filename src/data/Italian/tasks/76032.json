			"dialogs": [
				{
					"id": 760320201,
					"content": "Ehi tu, sai cosa succede a quelli che ficcano il naso dove non dovrebbero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320202
					],
					"speakerTitle": "Oprichniki dei Fatui"
				},
				{
					"id": 760320202,
					"content": "...Immagino che lo sto per scoprire! Senti, per me è tutto nuovo, sto ancora imparando il mestiere... Che ne dici di darmi un'altra possibilità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320203
					],
					"speakerTitle": "Persona sospetta"
				},
				{
					"id": 760320203,
					"content": "Dammi solo un'altra possibilità. Ti prometto che la prossima volta non mi prenderai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320204
					],
					"speakerTitle": "Persona sospetta"
				},
				{
					"id": 760320204,
					"content": "Ti sei preso una botta in testa? Non lasceremo scappare nemmeno uno di voi <color=#00E1FFFF>maledetti ladruncoli</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320205
					],
					"speakerTitle": "Oprichniki dei Fatui"
				},
				{
					"id": 760320205,
					"content": "Ascolta, quella ragazza probabilmente è già scappata con in mano tutto. Hai davvero il tempo di stare qui a discutere con uno come me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760320206
					],
					"speakerTitle": "Persona sospetta"
				},
				{
					"id": 760320206,
					"content": "Non hai bisogno di preoccuparti per lei. Adesso verrai con noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oprichniki dei Fatui"
				}
			]
		}
