					"speakerTitle": "Shouji"
				},
				{
					"id": 220470402,
					"content": "Spero che tu abbia fatto molta attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "Certo! Ho osservato tutto attentamente, dalla presa alla trazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470404,
					"content": "...Mmh, come posso dirlo? Più ti guardo, più mi sembra di percepire l'abisso che mi separa da te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470405,
					"content": "B-Beh, meglio non pensarci ora. Prendi questo, è un segno di riconoscenza per la dimostrazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470406,
					"content": "Tra un po' inizierò a esercitarmi. Come obiettivo mi darò... sette bersagli colpiti su dieci, che te ne pare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
