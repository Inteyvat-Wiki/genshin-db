			"dialogs": [
				{
					"id": 220470101,
					"content": "Uff, l'ho mancato di nuovo... Che cosa sto sbagliando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470102
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470102,
					"content": "Ti eserciti ancora nel tiro con l'arco?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "Oh, tu sei... Grazie mille per la dimostrazione dell'altra volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470104,
					"content": "Per merito tuo, sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470105,
					"content": "Diventato un arciere provetto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "Uhm, non ancora, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470108,
					"content": "Ma adesso riesco a colpire almeno cinque bersagli su dieci... E lo devo solo a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470109,
					"content": "Gli istruttori si aspettano di più, così ho deciso di continuare ad allenarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470110,
					"content": "Ehm... Giacché sei qui, ti dispiacerebbe darmi un'altra dimostrazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470111,
					"content": "Sono convinto che col tuo aiuto farò progressi ancora più rapidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470112,
					"content": "Certamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "Grazie mille! Prometto che presterò particolare attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470120,
					"content": "Lascio a te la dimostrazione. Prometto che guarderò molto attentamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470114,
					"content": "Hai già superato tutte le difficoltà che avevi prima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "Oh, intendi la postura, la potenza di trazione e la presa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470116,
					"content": "Devo essere sincero... Ci sto ancora lavorando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470117,
					"content": "Ma a parte questo, ciò che mi preoccupa è il non riuscire a sfruttare in una vera battaglia le tecniche che ho appreso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470118,
					"content": "*tossisce* Comunque, credo che prima di pensare a questo dovrei cercare di consolidare le basi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470119,
					"content": "Lascio a te la dimostrazione. Prometto che guarderò molto attentamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470106,
					"content": "Diventato un tiratore esperto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				}
			]
		},
