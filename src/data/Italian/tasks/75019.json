			"dialogs": [
				{
					"id": 750190301,
					"content": "...C'è un qualche margine di negoziazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190302
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190302,
					"content": "Manqu, guardami. Non hai sentito cos'ha detto Titu? Nessuno ci ha mai provato in quasi cinquecento anni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190303
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190303,
					"content": "Anche se dici di aver trovato una possibile entrata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190304
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190304,
					"content": "Beh, e allora? Ascolta attentamente: nessun umano o compagno Saurico che abbia intrapreso quella strada è mai tornato indietro. Neanche uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190305
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190305,
					"content": "Mm, con il dovuto rispetto, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190306
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190306,
					"content": "Beh, là c'è il tizio dell'Associazione delle Reliquie, e quello laggiù... Non è il capotribù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190307,
					"content": "Ehi! Tizio delle reliquie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190308,
					"content": "#Ah, siete voi, {NICKNAME}... Paimon e {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190309
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190309,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190310,
					"content": "Ah, un Tepetlisauro con una sciarpa rossa intorno alla coda! Molto energico, e di primo acchito ha un aspetto completamente diverso! Bene, piccolino, fallo di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190311
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190311,
					"content": "Roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190312,
					"content": "#Niente male! Quindi sei {REALNAME[ID(2)|SHOWHOST(true)]}? Immagino che questo significhi che ha scelto voi due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190313
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190313,
					"content": "#{NICKNAME} e Paimon, giusto? Ultimamente in città non si fa che parlare di voi. Manqu non fa che nominarvi, e Titu vi ha {F#menzionate}{M#menzionati} dopo il suo ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190314
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190314,
					"content": "#Definire le vostre gesta \"leggendarie\" non sarebbe un'esagerazione, e finora siete {F#state amiche}{M#stati amici} di noi Figli degli Echi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190315,
						750190316
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190315,
					"content": "Non c'è bisogno di tutti questi ringraziamenti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				},
				{
					"id": 750190317,
					"content": "Ahah, che giovane fenomenale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190318
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190318,
					"content": "Ed è proprio in tale veste che ti dico, Manqu: non è nostra usanza gettare i nostri ospiti in una fossa infuocata solo per dimostrare un'ipotesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190319
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190319,
					"content": "In ogni caso, non è così che \"tratterei\" i miei ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190320
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190320,
					"content": "*sospira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190321
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190321,
					"content": "Cos'è questa storia, comunque? Riguarda un pericolo e una fossa infuocata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190322,
					"content": "Chiedo scusa, permettetemi di spiegare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190323
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190323,
					"content": "Ricordate cos'abbiamo detto prima? Per rimuovere il marchio della Benedizione del Signore delle Fiamme, bisogna portare i due amuleti al vulcano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190324
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190324,
					"content": "Uno degli amuleti è nelle rovine oltre la terra dei Figli degli Echi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190325
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190325,
					"content": "Ci sono delle condizioni per entrarci, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190326
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190326,
					"content": "Secondo le usanze antiche... di cui ho appena letto su un rotolo intessuto, visto che sono passati secoli dall'ultima volta che qualcuno ha voluto provarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190327
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190327,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190328
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190328,
					"content": "Se si desidera portare il proprio Saurico al vulcano per celebrare un battesimo che purifichi la Benedizione del Signore delle Fiamme, bisogna ottenere il riconoscimento del capotribù del suddetto Saurico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190329
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190329,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190330
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190330,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190331
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190331,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190332,
					"content": "#Visto che {REALNAME[ID(2)|SHOWHOST(true)]} è un Tepetlisauro, allora dovrà essere il capo dei Figli degli Echi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190333
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190333,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190334,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190335,
					"content": "Non sei tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190336,
					"content": "#Beh, sì... Anche se, in verità, non so se questa regola si applichi ai forestieri. Tuttavia, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190337
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190337,
					"content": "Per secoli, molti hanno cercato di liberare i propri compagni Saurici da ciò che scorre nelle loro vene... Più che di una benedizione, si può parlare di una maledizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190338
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190338,
					"content": "Ma non ci è mai riuscito nessuno... Per cui le tribù hanno abbandonato gradualmente questa usanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190339
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190339,
					"content": "Un tasso di successo del zero per cento, seriamente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190340,
					"content": "Già, è un viaggio molto pericoloso. Si dice anche che la prova da superare per ottenere l'amuleto non metta alla prova soltanto il guerriero, ma anche il suo Saurico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190341
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190341,
					"content": "Non siete della tribù, ma non vi permetterò di morire invano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190342
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190342,
					"content": "#Quindi, {NICKNAME}, suggerisco che lasciate {REALNAME[ID(2)|SHOWHOST(true)]} qui con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190343
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190343,
					"content": "Se non altro, posso assicurarti che l'accudiremo fino al giorno in cui entrerà nel Regno della Notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190344
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190344,
					"content": "Ma... Facendo così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190345,
					"content": "#Come ho già detto, {REALNAME[ID(2)|SHOWHOST(true)]} non sarà mai in grado di crescere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190346
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190346,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190347,
					"content": "E non credo sia quello che vuole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190348
					]
				},
				{
					"id": 750190348,
					"content": "Ci proverò lo stesso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190349
					]
				},
				{
					"id": 750190349,
					"content": "Nonostante l'immenso pericolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190350
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190350,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190351
					]
				},
				{
					"id": 750190351,
					"content": "Tu cosa dici, piccoletto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190352
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190352,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190353
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190353,
					"content": "Ahahah! Irremovibile, determinato e tuttavia appassionato. I vostri cuori ardono come il Flogisto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190354
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190354,
					"content": "Va bene. Allora vi concederò il diritto d'intraprendere il pellegrinaggio vulcanico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190355
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190355,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190356
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190356,
					"content": "Bene! Andiamo a prendere il primo amuleto, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190357,
					"content": "No, non ancora. Ora che avete ottenuto il diritto d'intraprendere il pellegrinaggio, dovrete prima sottoporvi a una prova di testimonianza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190358
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190358,
					"content": "Secondo le antiche usanze, il guerriero e il Saurico devono ottenere assieme la piuma del trogone color smeraldo nella foresta, e offrire una stola di pelli d'animale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190359
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190359,
					"content": "Quindi, sempre assieme, devono vincere cinquanta battaglie per la nostra tribù, e offrire novantasei gemme di alta qualità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190360,
						750190361
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190360,
					"content": "Uh, allora non ho i requisiti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190362,
					"content": "Ma dai, Manqu, lascia perdere. Di che epoca sono queste usanze? Della preistoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190363
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190363,
					"content": "L'obiettivo di queste formalità era quello di favorire il legame tra gli umani e i Saurici, e di affinare le loro abilità... E io ne ho avuto abbastanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190364
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190364,
					"content": "#E per come la vedo io, né {NICKNAME} né {REALNAME[ID(2)|SHOWHOST(true)]} hanno bisogno di prove del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190365
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190365,
					"content": "#Per dirla in parole povere, a Natlan abbiamo un modo davvero semplice per gestire situazioni del genere, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190366
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190366,
					"content": "Combatti contro di me e dimostra la tua forza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190367
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190367,
					"content": "Benissimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190368
					]
				},
				{
					"id": 750190368,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190369
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190369,
					"content": "Un momento! Qui? Ah, vuoi dire che combatteremo sul palco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190370
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190370,
					"content": "Certo che no, ahah, il palco non è un luogo adatto... Le nostre arene di combattimento si trovano sulla montagna alle nostre spalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190371
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190371,
					"content": "Forza, andiamoci subito! Sarà un bel duello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190361,
					"content": "Mi potresti fare uno sconto in Mora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190316,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				}
			]
		},
		{
			"id": 7501906,
