				"points": []
			},
			"dialogs": [
				{
					"id": 750190601,
					"content": "Chiedo ancora scusa per la mia schiettezza... ma, sebbene sia consapevole della tua forza, sii comunque prudente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190602,
					"content": "Anche se non ha mai ottenuto un Nome antico, Pacal non va sottovalutato... Sempre che abbia continuato ad allenarsi negli ultimi anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190603,
					"content": "#Se siete {F#pronte}{M#pronti}, possiamo iniziare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				}
			]
		},
