				]
			},
			"dialogs": [
				{
					"id": 750190701,
					"content": "Hihi, fantastico! Abbiamo vinto! Ottimo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190702,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "Ah... Nemmeno il guerriero più forte della nostra tribù sarebbe riuscito a sconfiggerti... È stata una sconfitta clamorosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190704,
					"content": "Che ne pensi, amico? Sembra che abbiamo bisogno di addestrarci di più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190705,
					"content": "Mmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190706,
					"content": "È stata davvero una battaglia fantastica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190707,
					"content": "Belle parole, Manqu, ma non sai far altro che parlare? Perché non provi a combattere anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190708,
					"content": "No, grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190709,
					"content": "#Uff, che noia. Ah, è stato un grande duello! {NICKNAME}... Sei una vera forza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190710,
					"content": "Mi stavo solo riscaldando, sai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "Ahahah! Sei anche arrogante! Mi piace... Se si è forti, che senso ha nasconderlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190714,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#Ahah, direi che ti trattano piuttosto bene, {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190716,
					"content": "#Certamente! {REALNAME[ID(2)|SHOWHOST(true)]} è il nostro compagno fidato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190717,
					"content": "E questo è un bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190718,
					"content": "Come promesso, eccovi la prova che un capotribù ha riconosciuto il vostro successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190719,
					"content": "Quanto al suo nome ufficiale... Beh, Manqu, ora puoi parlare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190720,
					"content": "Il Talismano di Waxaklahun Ubah Kan... Il Saggio della Fiamma rubata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190721,
					"content": "Sì, dimentico sempre quel nome, ma ricordo che dopo la morte del Drago Sovrano di Pyro, e dopo che il primo Archon di Pyro rinacque dalle fiamme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190722,
					"content": "Il Saggio e l'Archon portarono con sé dal vulcano un amuleto ciascuno, e chiunque li otterrà entrambi potrà entrare nella fiamma purificatrice all'interno del vulcano e rimuovere ogni maledizione e calamità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190723,
					"content": "Vuoi ricordarmi per quanto tempo visse questo Saggio, Manqu? Ho l'impressione che esistano delle storie su di lui dall'epoca tribale a quella di Ochkanatlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190724,
					"content": "...E persino nel periodo del Chiodo dell'ombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190725,
					"content": "Beh, fu il primo umano a usare i Flogisti... E chissà quale sorte sia toccata a un personaggio tanto leggendario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190726,
					"content": "Alcuni dicono che il suo corpo e il suo spirito si siano trasformati in Flogisto, diventando così vento, terra e fiori, e che abbia acquisito la facoltà di ascoltare tutte le preghiere d'aiuto delle tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190727,
					"content": "Altri dicono che abbia avuto un successore per ogni epoca successiva, fino ai giorni nostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190728,
					"content": "Ma, chiedo scusa per la schiettezza, si tratta più che altro di ipotesi di vari cantastorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190729,
					"content": "Ahah, fai attenzione con quelle parole. Farai arrabbiare di nuovo Titu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190730,
					"content": "Bene. Ho assolto i miei doveri. Oh, un momento, l'usanza richiede ancora una cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190731,
					"content": "Ovvero concedere la mia benedizione all'anima coraggiosa che intraprenderà il viaggio e a chi l'accompagnerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190732,
					"content": "Uhm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "Oooh, quindi anche questo è un vostro rituale, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190734,
					"content": "Eh, è più che altro un supporto morale. Non illudetevi troppo, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190735,
					"content": "#Bene, allora. {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190736,
					"content": "Eccomi, capo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "Che possiate librarvi tra le montagne come l'uccello più robusto;\\nche possiate infrangere le onde più violente come se foste la pietra più dura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190739,
					"content": "Che non temiate le avversità, in quanto il mondo ne è pieno.\\nChe non vi dimentichiate mai gli uni degli altri, poiché il destino vi condurrà a un addio inevitabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190740,
					"content": "Che possiate raggiungere la vostra destinazione e ottenere ciò che desiderate... E, più di tutto, che riusciate a tornare sani e salvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190741,
					"content": "Così sarà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "Eh? Aspetta un attimo, nessuno benedice Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190744,
					"content": "Ahah! Quanto a te, piccola Paimon... Che tu possa mangiare e bere a sazietà, dormire della grossa e crescere in abbondanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190745,
					"content": "Mica male!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "Comunque sia, se proprio insisti Paimon accetta questa benedizione, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190749,
					"content": "Per me va bene. In tal caso, il rito della testimonianza è terminato. Ma, prima che ve ne andiate, lasciate che ve lo ripeta ancora una volta: fate attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190750,
					"content": "Lo sappiamo, Pacal. Ci vediamo! ...E ciao anche a te, Uchu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190751,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190753,
					"content": "Buona fortuna, a presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190746,
					"content": "Puoi davvero crescere, in abbondanza o meno, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "Certo che sì! Aspetta e vedrai, Paimon diventerà alta come tre montagne messe assieme in men che non si dica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190712,
					"content": "Non sei andato male neanche tu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "Ahahah, risparmia i convenevoli. Se fossi stato più giovane, forse sarebbe andata diversamente. Ah, come avrei voluto affrontarti allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				}
			]
