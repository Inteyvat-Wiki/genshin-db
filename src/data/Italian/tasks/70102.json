				"points": []
			},
			"dialogs": [
				{
					"id": 701020301,
					"content": "Ho trovato altri pezzi di dente di drago...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020302
					]
				},
				{
					"id": 701020302,
					"content": "Ah, speravo che passassi di qui. Ascolta, prima che tu vada a raccogliere tutti quei frammenti di dente di drago... Ah, ma vedo che hai già fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020303
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020303,
					"content": "Ti chiedo umilmente scusa... ma ho un piccolo problema. Per quanto stia provando a scalfire questo affare, sembra che non riesca nemmeno a scheggiarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020304
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020304,
					"content": "È come se fosse davvero un dente di drago... In tal caso, in base a ciò che sto leggendo, ci sono diversi metodi specifici per lavorare questo materiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020305
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020305,
					"content": "Uno di essi è fare in modo che il dente di drago assorba una specie di... \"vitalità\" legata al drago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020306
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020306,
					"content": "A quel punto si deve usare il dente, infuso della vitalità del drago, per lavorare gli altri pezzi di dente di drago e dare loro forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020307
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020307,
					"content": "Ma come si può assorbire qualcosa che abbia la vitalità di un drago... non ne ho la più pallida idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020308
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020308,
					"content": "#Tu che ne pensi, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020309
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020309,
					"content": "Io, ehm... vedrò cosa posso fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020310
					]
				},
				{
					"id": 701020310,
					"content": "Ottimo! Tieni, prendi anche questo dente di drago, così ti occuperai tu di tutta la procedura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020311
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020311,
					"content": "Ehm, se solo un dente sta causando così tanti problemi, un drago intero dev'essere una creatura complicata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
