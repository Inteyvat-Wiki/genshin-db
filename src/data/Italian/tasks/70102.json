			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020102,
					"content": "Qualche idea su questo dente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "Un dente? Fammi vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020104,
					"content": "Mmmh... Sì, un po' insolito nella forma e nelle dimensioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020105,
					"content": "Non sono un'esperta di materiali misteriosi... Orban potrebbe saperne di più. Lui forgia armi, quindi gli capitano materiali di qualsiasi tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020106,
					"content": "Perché non chiedi a lui? Si trova laggiù, non potrai non notarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010207",
							"2"
						],
						"stepId": 7010207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010206",
							"3"
						],
						"stepId": 7010206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020201,
					"content": "Che mi dici di questo dente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020202
					]
				},
				{
					"id": 701020202,
					"content": "#Un dente? Uff, non dirmi che ti sei mess{F#a}{M#o} alla ricerca di spazzatura nei pressi delle montagne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020203
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020203,
					"content": "Ehm, anche se come dente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020204
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020204,
					"content": "Cosa? Che cos'è?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020205
					]
				},
				{
					"id": 701020205,
					"content": "Si tratta di un esemplare piuttosto pregevole. Ed è anche duro come la pietra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020206
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020206,
					"content": "E questi margini... Somiglia molto a un dente di drago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020207
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020207,
					"content": "In che senso dente di drago?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020208
					]
				},
				{
					"id": 701020208,
					"content": "Nel senso che è il dente di un drago. Le armi forgiate con denti di drago sono incredibilmente resistenti e affilate... e possiedono anche strani poteri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020209
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020209,
					"content": "Non sono cose che si vedono tutti i giorni, però... In tutte le storie che circolano, di solito solo gli eroi più valorosi riescono ad acquisire un dente di drago e a farsi forgiare un'arma con esso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020210
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020210,
					"content": "Come si suol dire, se hai intenzione di uccidere un drago per strappargli i denti... sarà meglio che tu abbia a portata di mano un'arma capace di ucciderlo, o potrebbe morderti a sua volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020211
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020211,
					"content": "Allora... ma è davvero un dente di drago oppure no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020212
					]
				},
				{
					"id": 701020212,
					"content": "Onestamente non sono mai incappato personalmente in un dente di drago, quindi non posso darti una risposta definitiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020213
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020213,
					"content": "Però penso che sia il dente di una bestia enorme di qualche tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020214
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020214,
					"content": "Comunque, dal momento che hai fatto tutti questi sforzi... trattiamolo come se fosse davvero un prezioso dente di drago, che ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020215
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020215,
					"content": "Mmmh, ma detto questo... non è sufficiente per farci un'arma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020216
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020216,
					"content": "Che ne diresti di andare a raccogliere altri tre pezzi di dente di drago e nel frattempo io studio come lavorarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020217
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020217,
					"content": "Ah... e a parte il <color=#00E1FFFF>dente di drago</color>, saranno necessari anche altri minerali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020218
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020218,
					"content": "Quindi, visto che sarai su in montagna, prendi 50 pezzi di <color=#00E1FFFF>Argento astrale</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020220
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020220,
					"content": "E sì, oltre a tutto questo avrò anche bisogno di una <color=#00E1FFFF>Billetta della Lancia del Nord</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
