			},
			"dialogs": [
				{
					"id": 721290201,
					"content": "Osservi l'amuleto, quando all'improvviso ti avvolge una strana energia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290202
					],
					"speakerTitle": "Tocca l'amuleto"
				},
				{
					"id": 721290202,
					"content": "Ti rendi conto che non fa resistenza, anzi ti sta chiedendo qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Tocca l'amuleto"
				},
				{
					"id": 721290203,
					"content": "Sembra che a questo amuleto manchi qualcosa. Meglio cercare le parti mancanti nei paraggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290204,
					"content": "Usa la tua Vista elementale per analizzare le tracce degli elementi qui intorno. Potresti scoprire qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
