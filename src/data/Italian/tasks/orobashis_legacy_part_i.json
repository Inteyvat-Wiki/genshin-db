			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "La lanterna di pietra dalla forma particolare sembra emettere un'energia sinistra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721290102,
					"content": "Questa lanterna di pietra è stranissima... Mette i brividi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290103,
					"content": "Oh, cosa c'è scritto sul lampione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290104,
					"content": "\"Ai viaggiatori di passaggio: per qualunque domanda su questo amuleto, contattate il signor Kaji nella Valle di Musoujin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721290105,
					"content": "Il messaggio sembra molto recente, e più in basso, in piccolo, ci sono altre scritte rovinate dalla pioggia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721290106,
					"content": "\"Dite al signor Kaji che abbiamo provato, ma purtroppo... Potrebbe trovarsi nelle vicinanze...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721290107,
					"content": "\"Dite al signor Kaji di raggiungere il rifugio il prima possibile. La sua famiglia è in pensiero.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721290108,
					"content": "Questo signor Kaji sembra molto preoccupato per via delle lanterne di pietra. Perché non lo raggiungiamo nella Valle di Musoujin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7212902,
			"completionStepIds": [
				7212905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
