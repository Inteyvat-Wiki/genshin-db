			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721290401,
					"content": "#Non male, stranier{F#a}{M#o}! Le nuvole sono quasi sparite. Allora ho proprio indovinato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290402,
					"content": "Ora bisogna riparare i due amuleti della Testa del Serpente e della Miniera di Jakotsu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290403,
					"content": "Lascerei anche questo compito a te, se non ti spiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290404,
					"content": "Puoi contare su di me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "#Grazie mille per l'aiuto. Sicuramente non possiedo grandi ricchezze, ma ti prometto che verrai ricompensat{F#a}{M#o} in modo adeguato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290406,
					"content": "Non so ancora quando accadrà, di preciso, ma ho l'impressione che si stia avvicinando il momento in cui potrò riabbracciare amici e familiari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290407,
					"content": "A ogni modo, una volta finito mi troverai sul lato occidentale dell'isola. In precedenza, i Ribelli hanno attaccato Forte Mumei, e sospetto che ciò sia avvenuto per via di questi cambiamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
