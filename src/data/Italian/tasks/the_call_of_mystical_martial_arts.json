							1874.555,
							201.412,
							-142.334
						],
						"pointId": 9404
					}
				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "Chiedo scusa, potete aspettarmi qui un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810402,
					"content": "Che cosa c'è?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "Hai dimenticato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810404,
					"content": "No, no, ma guardando la mappa, se proseguiamo, usciremo da Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810405,
					"content": "E non ho idea di quando tornerò... Quando il mio maestro vedrà il mio messaggio, andrà su tutte le furie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810406,
					"content": "Hai già citato il tuo maestro prima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "Sì... Poco dopo esserlo diventato, incontrò dei Mitachurl selvatici. Nel corpo a corpo, abbassò la guardia e fu messo al tappeto da un'ascia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810409,
					"content": "Per sua fortuna un cavaliere che passava di lì lo salvò e lo riportò indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810410,
					"content": "Si vergognava così tanto che decise di potenziare le sue abilità di combattimento al massimo prima di rimettersi in gioco. Ormai sono passati dieci anni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810411,
					"content": "Dice sempre che le basi sono l'aspetto più importante, ma non ce la faccio più a dovermi scontrare ogni giorno con dei manichini di legno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810412,
					"content": "Quindi sono partita da sola, senza dirgli nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810413,
					"content": "Torna quando sarai più forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "Sì, la penso esattamente così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810416,
					"content": "Ah, ho capito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810417,
					"content": "Gesine tira fuori alcuni semi di dente di leone dal suo zaino e li posiziona sul palmo della mano. Parla sottovoce ai semi e poi li abbandona al vento...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "Secondo le nostre credenze, i denti di leone possono trasportare i desideri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810419,
					"content": "Ho appena chiesto che il mio viaggio proceda senza intoppi, di riuscire a raggiungere i miei obiettivi e che il mio maestro comprenda la mia scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810420,
					"content": "Di sicuro l'Archon di Anemo ti ha sentita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "Sì! E ora andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810414,
					"content": "Fa' qualcosa che lo renda fiero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "Anche lui è un avventuriere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
		},
		{
			"id": 7068105,
			"completionStepIds": [
				7068105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
