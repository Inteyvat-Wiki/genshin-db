					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811213,
					"content": "Spero che ci incontreremo ancora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811214,
						706811215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811214,
					"content": "Alla prossima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811215,
					"content": "Spero che troverai ciò che stai cercando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811216,
					"content": "Anche voi! Fate buon viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811217
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706811217,
					"content": "Gesine vi saluta.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811218
					]
				},
				{
					"id": 706811218,
					"content": "Beh, dato che siamo qui perché non diamo un'occhiata in giro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706811219,
					"content": "Forse faremo altri incontri interessanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7068131,
			"completionStepIds": [
				7068103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7068103",
