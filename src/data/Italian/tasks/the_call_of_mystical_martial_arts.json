					{
						"sceneId": 3,
						"position": [
							924.103,
							258.97,
							353.309
						],
						"pointId": 9409
					}
				]
			},
			"dialogs": [
				{
					"id": 706819905,
					"content": "Gesine chiede all'oste informazioni su alcuni piatti e ordina diverse portate, tanto costose quanto popolari...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "Ho sentito che la cucina di Liyue è molto olistica, concentrata allo stesso tempo sull'impiattamento, sugli aromi e sui sapori. Sembra veramente particolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810802,
					"content": "E Paimon ha già l'acquolina in bocca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810803,
					"content": "Assieme, assaporate le prelibatezze della Locanda Wangshu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "Triplo accicacchio! Anche questo è delizioso. E questo, e quello... Ahhh, Paimon è così piena che non le ci sta più niente nella pancia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810805,
					"content": "Era tutto squisito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "Ho riacquistato tutte le energie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "Grazie infinite per tutto quello che avete fatto! Senza di voi, avrei fatto molta più fatica ad arrivare fino a qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810808,
					"content": "Un cameriere mi ha detto che se proseguo per questa strada arriverò al <color=#00E1FFFF>Porto di Liyue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810809,
					"content": "Penso che mi fermerò qui a riposarmi per qualche giorno e per chiedere dove posso trovare un maestro. Poi deciderò il da farsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810810,
					"content": "Anche se è stato un bel viaggio, non posso continuare ad approfittare della vostra disponibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810811,
					"content": "D'ora in poi dovrò arrangiarmi, diventare più forte e trasformarmi in un'avventuriera affidabile, proprio come voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810812,
					"content": "Eheh, anche se non abbiamo passato molto tempo assieme, è stato molto divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810813,
					"content": "Spero che ci incontreremo ancora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810814,
					"content": "Alla prossima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "Spero che troverai ciò che stai cercando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "Anche voi! Fate buon viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810817,
					"content": "Gesine vi saluta.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "Beh, dato che siamo qui perché non diamo un'occhiata in giro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810819,
					"content": "Forse faremo altri incontri interessanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810820,
					"content": "Gesine ha detto che il <color=#00E1FFFF>Porto di Liyue</color> è poco più avanti. Dovremmo farci un giro quando avremo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
