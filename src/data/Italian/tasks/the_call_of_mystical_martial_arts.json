		},
		{
			"id": 7068107,
			"completionStepIds": [
				7068107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7068107",
							"2"
						],
						"stepId": 7068107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gesine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706810701,
					"content": "Custodirò gelosamente questa foto di noi insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810702
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810702,
					"content": "Ah! Ora che mi sono rilassata, mi sono resa conto di avere una gran fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810703,
					"content": "Ora che lo dici, anche la pancia di Paimon inizia a borbottare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810704,
					"content": "Troviamo un posto in cui riposarci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "Cerchiamo un posto dove comprare del cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810709,
					"content": "Sembra che nei paraggi non ci siano ristoranti che facciano al caso nostro... Considerato tutto l'aiuto che mi hai dato e il rispetto che nutro per te, mi sentirei a disagio a farti mangiare in un locale qualsiasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810710,
					"content": "A proposito di cibo, l'edificio in cima a quella roccia gigante laggiù potrebbe essere la famosa <color=#00E1FFFF>Locanda Wangshu</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810711,
					"content": "Un mercante di Liyue che fa affari a Mondstadt mi ha detto che servono del cibo semplicemente sopraffino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810712,
					"content": "Lasciate che offra io per ringraziarvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810713,
					"content": "Evviva! Andiamo a mangiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810705,
					"content": "Paimon, accendi un fuoco e inizia a cucinare!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "Ehi! Non puoi dare ordini a Paimon a quel modo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810707,
					"content": "E poi sai benissimo come cucina Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7068108,
			"completionStepIds": [
				7068108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
