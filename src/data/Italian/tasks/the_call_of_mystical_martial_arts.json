			},
			"dialogs": [
				{
					"id": 706810301,
					"content": "Fiuuu... Salvataggio riuscito... Grazie infinite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810302
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810302,
					"content": "Mi chiamo Gesine. Come potete vedere, sono un'avventuriera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810303
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810303,
					"content": "#Una persona con le tue qualità dev'essere per forza straordinaria! Sei {F#una cavaliere benevola}{M#un cavaliere benevolo}? O forse {F#un'eroina}{M#un eroe} errante che vaga per queste terre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810304,
						706810305
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810304,
					"content": "#Sono {F#una semplice viaggiatrice}{M#un semplice viaggiatore} di passaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810309
					]
				},
				{
					"id": 706810309,
					"content": "#Paimon si chiama Paimon e {M#lui}{F#lei} è {NICKNAME}, che è anche membro della Gilda degli avventurieri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810310,
					"content": "#Quindi alla fin fine sei {M#un avventuriere}{F#un'avventuriera} e devi anche avere parecchia esperienza! Hai eliminato quel mostro possente in men che non si dica... Ha decisamente trovato pane per i suoi denti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810311
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810311,
					"content": "Io invece... durante l'addestramento ricordo senza problemi quello che devo fare, ma quando mi ritrovo in situazioni reali, il mio corpo non risponde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810312
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810312,
					"content": "Devo veramente allenarmi per altri tre, quattro o cinque anni come ha detto il mio maestro? Sarebbe decisamente umiliante tornare a mani vuote... *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810313
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810313,
					"content": "#Oh, dà retta a Paimon: è solo una questione di esperienza. Noi siamo {M#diventati}{F#diventate} così forti solo dopo parecchio tempo e molte battaglie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810314,
						706810318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810314,
					"content": "Innanzitutto, devi riuscire a tenere i nervi saldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810315
					]
				},
				{
					"id": 706810315,
					"content": "Già! Spesso i principianti vanno nel pallone quando si ritrovano in veri combattimenti e tendono a ottenere risultati molto peggiori di quanto non farebbero in altre situazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810316,
					"content": "Indipendentemente dalla potenza del nemico, devi osservarlo con mente fredda e individuare il suo punto debole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810317,
					"content": "Così riuscirai a eliminarlo in un batter d'occhio con un bel uno-due-sbam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810320,
					"content": "Capisco... Si vede che avete esperienza! A quanto pare dovrò continuare ad affinare le mie abilità durante i miei viaggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810321
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810321,
					"content": "Stai per partire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810322
					]
				},
				{
					"id": 706810322,
					"content": "Sì... Sto pensando di andare a <color=#00E1FFFF>Liyue</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810323
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810323,
					"content": "Avete sentito parlare delle arti marziali di Liyue? Ho sentito storie di persone che volano di tetto in tetto e che corrono su per le pareti, di individui che rafforzano la propria pelle così da non venire trafitti e che riescono a spaccare il ferro come se fosse burro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810324
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810324,
					"content": "Se riuscissi a trovare un maestro che mi insegni un paio di mosse, scommetto che tutto questo marasma avventuroso sarebbe molto più facile per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810325
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810325,
					"content": "A essere onesti, però, anche se faccio parte della Gilda degli avventurieri da tempo, è la prima volta che intraprendo un lungo viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810326
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810326,
					"content": "*sospira* Senza contare che, non appena ho lasciato la città, c'erano già dei mostri ad aspettarmi. Riuscirò mai a raggiungere Liyue sulle mie gambe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810327,
						706810328
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810327,
					"content": "Anche noi stiamo andando a Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810329,
					"content": "#Davvero? Anche {F#delle esperte}{M#degli esperti} come voi sono alla ricerca di un maestro di grande bravura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810330
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810330,
					"content": "Non proprio. Stiamo solo attraversando le nazioni di Teyvat per... vari motivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810331,
					"content": "Sebbene non conosciamo Liyue così bene, stavamo comunque pensando di andare a visitarla prima o poi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810332,
					"content": "Dato che andiamo nella stessa direzione, possiamo guardarci le spalle a vicenda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810333,
					"content": "#Wow! Non avrei mai immaginato che avrei collaborato con {M#un avventuriere esperto}{F#un'avventuriera esperta} come te... Allora ho ancora delle speranze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810334
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810334,
					"content": "Posso farvi da guida. Ho studiato la mappa attentamente prima di partire: è impossibile che mi perda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810328,
					"content": "Vuoi unirti a noi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810318,
					"content": "Anche valutare la situazione è importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810319
					]
				},
				{
					"id": 706810319,
					"content": "Esatto! Se capisci che il nemico è ben al di sopra delle tue possibilità, è meglio darsela a gambe finché sei in tempo. Non bisogna essere eroi per forza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810305,
					"content": "Preferirei non svelare la mia identità...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810306
					]
				},
				{
					"id": 706810306,
					"content": "Capisco! È chiaro che ti stai occupando di una missione segreta e devi mantenere un profilo basso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810307
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810307,
					"content": "Già, diciamo di sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810308
					]
				},
				{
					"id": 706810308,
					"content": "#Ok, ora basta fare {F#la misteriosa}{M#il misterioso}, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
