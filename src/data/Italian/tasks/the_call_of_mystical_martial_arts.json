							207.178
						],
						"pointId": 300201051
					},
					{
						"sceneId": 3,
						"position": [
							1575.554,
							227.66,
							205.588
						],
						"pointId": 9405
					},
					{
						"sceneId": 3,
						"position": [
							1576.451,
							227.659,
							206.559
						],
						"pointId": 9406
					}
				]
			},
			"dialogs": [
				{
					"id": 706810501,
					"content": "Quella laggiù è la <color=#00E1FFFF>Palude di Dihua</color>, giusto? È meravigliosa! Non c'è nulla di simile a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810502
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810502,
					"content": "Sapevo che partire per un viaggio sarebbe stata la decisione giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810503
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810503,
					"content": "Non succede tutti i giorni... Facciamoci una foto ricordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				}
			]
		},
		{
			"id": 7068106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
