			"dialogs": [
				{
					"id": 711290101,
					"content": "\"Infedeli sono i cieli, e rari sono coloro che cercano le loro benedizioni e vengono ascoltati. Il fato è imprevedibile, e pochi sono quelli la cui prosperità perdura... Spesso, la via viene preclusa ai favoriti, e tutti gli altri subiscono una sorte peggiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711290102
					],
					"speakerTitle": "Iscrizione scolpita"
				},
				{
					"id": 711290102,
					"content": "...Questo monumento è stato lasciato qui per porre questa domanda alle generazioni future: quando vi ritroverete a un punto morto, cosa farete?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711290103
					],
					"speakerTitle": "Iscrizione scolpita"
				},
