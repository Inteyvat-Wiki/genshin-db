			"dialogs": [
				{
					"id": 761010101,
					"content": "#{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010102,
					"content": "Hihi, pare che abbiamo azzeccato il momento giusto! Questo posto è così pieno di vita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010103,
					"content": "Tutti hanno lavorato sodo, in questi ultimi giorni. Ora che le acque si sono finalmente calmate, siamo riusciti a trovare un attimo per riunire tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010104,
					"content": "Non deve essere stato facile neanche per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "#Ho solo fatto il mio dovere. Ma... se voi non foste {F#intervenute}{M#intervenuti} in quel momento, immagino che le cose sarebbero andate molto diversamente. Forse avremmo vinto lo stesso... ma non senza pagare un prezzo più alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010106,
					"content": "Dai, siamo sulla stessa barca, no? Non c'è bisogno di essere così seri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010107,
					"content": "Sì, hai ragione. Oh, sembra che il vecchio stia per parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010108,
					"content": "A tutti i nostri compagni e fratelli: questa non è solo una celebrazione, bensì un momento per onorare la lotta che ci ha permesso di trionfare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010109,
					"content": "Nel brindare a questa vittoria, non dimentichiamo coloro che hanno dato tutto per renderla possibile. Col loro sangue, hanno adempiuto al voto che tutti noi abbiamo fatto un tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010110,
					"content": "Durante questa battaglia, la squadra investigativa \"Orioli dell'incubo\", guidata da Illuga, ha affrontato quello che è stato forse l'incarico più pericoloso di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010111,
					"content": "#In particolare, {NICKNAME} e la sua compagna si sono {F#fatte}{M#fatti} avanti senza esitare in un momento di crisi, svolgendo un ruolo che si è rivelato cruciale per il successo dell'operazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010112,
					"content": "#Hanno affrontato ogni pericolo, si sono {F#fatte}{M#fatti} strada nella tempesta e hanno tracciato un sentiero verso la vittoria pur immersi nella disperazione più profonda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010113,
					"content": "Il lascito delle loro imprese, e di tutti coloro che hanno combattuto per i vivi e per chi deve ancora venire, sarà scolpito nella storia per non svanire mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010114,
					"content": "Sì, abbiamo vinto! Sì, il prezzo da pagare è stato caro, e possiamo fermarci a piangere e ricordare i nostri caduti... ma non dobbiamo permettere che il dolore ci spezzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010115,
					"content": "Il futuro per cui abbiamo combattuto è a portata di mano, e noi portiamo la fiamma di coloro che hanno illuminato il cammino prima di noi. La loro luce deve continuare a splendere, e per questo non ci fermeremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010116,
					"content": "Ma oggi alziamo i calici: brindiamo alla vittoria, alle anime prodi che non dimenticheremo e al futuro che abbiamo giurato di proteggere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				}
			]
		},
