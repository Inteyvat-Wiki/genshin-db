					{
						"sceneId": 3,
						"position": [
							5610.782,
							375.311,
							9961.593
						],
						"pointId": 361100061
					}
				]
			},
			"dialogs": [
				{
					"id": 761011301,
					"content": "I cancelli del cielo funesto sono spalancati, eppure continuate ad aggrapparvi a quell'insignificante Kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011302
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011302,
					"content": "Dunque... perché sono ancora confinato qui? Ah, capisco... Il Mulino Sampo mi si è di nuovo rivoltato contro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011303
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011303,
					"content": "Molto bene, guarda un po' chi si è fatto vivo. Che onore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011304
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011304,
					"content": "...Chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011305
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011305,
					"content": "Quella sagoma... Relya? Ah, eccoti. Sapevo che eri ancora in vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011306
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011306,
					"content": "Ora piega il potere del Mulino Sampo al mio volere! Ci riuscirai, con il sangue dell'erede sacra che arde in te... Gli altri tre sono stati dei risibili fallimenti, ma tu no. La mia scelta è sempre ricaduta su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011307
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011307,
					"content": "Hah... Crede davvero che io sia Relya. Così il monaco folle, sempre padrone in ogni situazione, non è più capace neanche di discernere le cose chiaramente. Che ironia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011308
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011308,
					"content": "Relya, non vacillare. Non hai dimenticato il nostro sogno, vero? Non vuoi rivendicare il nome e il posto che ti sono sempre spettati di diritto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011309
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011309,
					"content": "Immaginalo... Un Elisio per gli umiliati e i derelitti, un luogo dove le sprezzanti e nobili Fate si prostrano in ginocchio dinanzi a te. E in questa corte reale della Candida Stella, soltanto io, un altro essere umano, posso rendere tua quella visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011310
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011310,
					"content": "E ora, sono a un solo passo dall'ascendere alle stelle... Quando l'Elisio oltre i cieli si svelerà su questo mondo, tutti gli altri verranno spazzati via, lasciando solo noi, i pochi eletti, a ereditare ciò che resta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011311
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011311,
					"content": "Quando quell'alba giungerà, della marcescenza di quest'epoca non resterà più niente. Dimmi, non è forse questo il mondo che hai sempre desiderato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011312
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011312,
					"content": "No. Quel futuro non è mai stata la sua volontà... E come puoi continuare a ricorrere alla stessa bugia in un momento come questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011313
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011313,
					"content": "Lo hai usato fin dall'inizio. Ogni promessa, ogni bugia... Hai ordito tutto per spingerlo a impadronirsi del Mulino Sampo per te. E questo \"Elisio\" che continui a predicare, è sempre stato destinato solo a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011314
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011314,
					"content": "Persino la sua degradazione, il percorso che lo ha trasformato in un ladro, era una trappola che hai escogitato insieme al granduca Alvis. Tutto quanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011315
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011316
					],
					"speakerTitle": "\"Il Professore\""
				},
				{
					"id": 761011316,
					"content": "Mi hai chiamato Relya per errore, ma ammetto che quel nome mi si addice. Porterò avanti il suo ruolo e la sua eredità, e accetterò il nome di Reed Miller senza esitare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011317
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011317,
					"content": "Rauthvangi. Monaco folle. \"Professore\". Serpente immortale... La tua storia finisce qui. Metterò io la parola fine, nel nome di Reed Miller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011318
					],
					"speakerTitle": "Alia"
				},
				{
					"id": 761011318,
					"content": "Ce l'abbiamo fatta davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011319
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011319,
					"content": "Quel demone immortale ora è morto e sepolto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761011320
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761011320,
					"content": "\"Il serpente immortale due volte risorgerà, ma tre volte verrà abbattuto... E infine, riceverà la sepoltura dagli eroi del globo sublunare...\"\\nGrazie a te e ai coraggiosi Ratniki, il \"Professore\" è finalmente sconfitto...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761011321
					]
				},
				{
					"id": 761011321,
					"content": "Per diversi altri giorni, rimani a Piramida...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}