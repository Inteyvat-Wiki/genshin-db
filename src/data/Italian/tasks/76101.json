			"dialogs": [
				{
					"id": 761010201,
					"content": "Illuga, finalmente! Lo Starsina Nikita ti ha cercato dappertutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "Olav"
				},
				{
					"id": 761010202,
					"content": "Eh? Starsina... Nikita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010203,
					"content": "#Aspetta, {NICKNAME}, Nikita... Non è lo stesso tizio che ci ha chiesto di cercare lo Stoppino d'argento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010204,
					"content": "Non aveva detto di essere un semplice Ratnik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010205,
					"content": "Già...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "Ah, il mio vecchio... Probabilmente voleva solo scherzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010208,
					"content": "Ne parleremo più tardi. Per ora, andiamo ad aggiornarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
