			},
			"dialogs": [
				{
					"id": 761010301,
					"content": "Vecchio, siamo tornati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010302,
					"content": "E siete sani e salvi, vedo. Come procede alla Rupe Kipumaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010303,
					"content": "Fate un breve resoconto dell'accaduto...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "Proprio come pensavo... È palese anche da qui. Il Pilastro di Embla è stato conquistato dall'Abisso... e da quel demone immortale che chiamano \"Professore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010305,
					"content": "Detto questo, per ora è tutto tranquillo. Posso solo supporre che la signorina Alia stia ancora combattendo per tenerlo a bada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010306,
					"content": "Sta mantenendo la posizione per noi, dobbiamo sfruttare al massimo questa opportunità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010307,
					"content": "Grazie a Flins e agli altri, i preparativi sono quasi completi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010308,
					"content": "E ora che hai riportato la Spiralama, la Freccia di Terpikeraunas è finalmente pronta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010309,
					"content": "Ehm... Cos'è la \"Freccia di Terpikeraunas\"? È un'altra reliquia super potente, come lo Stoppino d'argento e la Spiralama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010310,
					"content": "Ahah, li supera entrambi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010311,
					"content": "Cinque secoli fa, il Forgialuce non aveva la forza per sconfiggere il demone immortale, e riuscì solo a sigillarlo sotto la Rupe Kipumaki. Ciononostante, egli non vacillò: insieme alla prima Cantaluna, perseverò nella speranza di una vittoria futura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010312,
					"content": "Quest'arco è stato forgiato con un'arte antica, in modo che fosse pronto per il giorno in cui il demone immortale sarebbe stato annientato. Da allora, è stato tramandato tra i Guardaluce di generazioni in generazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010313,
					"content": "Ora, finalmente, è giunto il momento che compia il suo destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010314,
					"content": "Cavoli... Sembra incredibile! Che aspetto ha? Possiamo vederlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010315,
					"content": "#L'avete già visto, {F#sciocchine}{M#sciocchini}. Anzi, ci siamo proprio dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010316,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "N-Non vorrai mica usarlo per scagliarci via, vero? Vero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010320,
					"content": "Questa grande sala dell'idromele è stata costruita per ospitare la Freccia di Terpikeraunas, e la Spiralama che avete recuperato è la punta di cui era stata privata molto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010321,
					"content": "Una volta riposizionata la Spiralama, la Freccia di Terpikeraunas sarà pronta per essere scagliata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010322,
					"content": "Ma questo è un caminetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010323,
					"content": "Sì, è un caminetto, ma anche il meccanismo che trasformerà la Spiralama nella punta della Freccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010324,
					"content": "Dobbiamo agire prima che l'Uovo del cataclisma si schiuda. Quest'arco e questa freccia sono stati tramandati per porre fine a questa precisa minaccia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010325,
					"content": "Mentre prepari il tiro, è probabile che quel demone immortale sferri un ultimo attacco. Qualunque cosa ci lancerà contro, la fermeremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010326,
					"content": "Tu concentrati sullo scoccare la Freccia di Terpikeraunas. Contiamo su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010318,
					"content": "Volete lanciarmi insieme alla freccia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#Quindi {NICKNAME} è davvero la nostra ultima risorsa... No, un momento, dev'essere uno scherzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
