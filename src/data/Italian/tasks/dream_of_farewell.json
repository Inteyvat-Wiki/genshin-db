			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pedrush",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "Oh, menomale. Ti sei svegliato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150102,
					"content": "Hanno iniziato a risvegliarsi, e abbiamo sentito storie simili anche in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150103,
					"content": "Ma pare che siete stati in grado di risolvere con successo il problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150104,
					"content": "Sì, sebbene ci sia costato molti sforzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150105,
					"content": "A breve ci saranno molte persone qui, per cui fai del tuo meglio per mantenere l'ordine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150106,
					"content": "Devo andare all'Akademiya con loro adesso, ma torneremo a breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sitt",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "Oh, è la grande Archon di Dendro. Come posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150202,
					"content": "Vorrei dare uno sguardo ai registri di uno studioso della Kshahrewar. In questo momento dovrebbe essere in uno stato di incoscienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150203,
					"content": "Va bene, un attimo solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150204,
					"content": "Dopo un po'...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "Mi dispiace di averti fatta aspettare, Archon di Dendro. Abbiamo confermato l'esistenza di uno studioso di nome Beynuni, in stato di incoscienza da tempo, a causa di un utilizzo improprio dell'Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150206,
					"content": "Non ha ancora ripreso conoscenza, ed è in cura nel Bimarstan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150207,
					"content": "Eh? Ma il nome non è Moseis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150208,
					"content": "Immagino non volesse esser riconosciuto o importunato da nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150209,
					"content": "Dà la conoscenza conservata in questo ai matra, e chiedi loro di importarla nel cervello di Beynuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150210,
					"content": "Capito, ma per ragioni di sicurezza, devo sapere il motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150211,
					"content": "Semplice: contiene la sua coscienza, da molto tempo intrappolata in un sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150212,
					"content": "Ha commesso un atto che ha compromesso la sicurezza di Sumeru. Dopo che si sveglierà, informerò il generale Mahamatra con tutti i dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150213,
					"content": "Capisco. Allora me ne occupo subito. Grazie, grandissima Archon di Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150214,
					"content": "Mh-m. Non c'è di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150215,
					"content": "Va bene, dovrebbero essere tutti a \"Un momento da sogno\" ora. Torniamo indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "Stiamo in silenzio e ascoltiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150302,
					"content": "Mi chiedo cosa stia per dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150303,
					"content": "Salve a tutti voi che vi siete appena svegliati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150304,
					"content": "Mi dispiace aver interrotto i vostri favolosi sogni. Potrei aver agito con freddezza, e vi porgo le mie più sincere scuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150305,
					"content": "I sogni hanno un potere fantastico. Ci ispirano a non perdere la risolutezza davanti alle avversità, e aiutano coloro con aspirazioni a raggiungere ciò che desiderano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150306,
					"content": "Tuttavia, i sogni possono anche sfruttare le persone, confonderne i sensi e distorcere la verità. Sfortunatamente, eravate caduti preda di uno schema elaborato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150307,
					"content": "Come ho già detto, sto ancora imparando, e non riesco ancora a provare del tutto empatia con il dolore dei vostri lutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150308,
					"content": "Ma vi basta darvi un'occhiata attorno e vedrete molte altre persone con esperienze simili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150309,
					"content": "Dovreste essere orgogliosi di essere qui e guardare insieme al futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150310,
					"content": "La vita è lunga, ed è difficile per noi vedere la destinazione. Questo ci porta a farci un sacco di domande difficili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150311,
					"content": "Qual è il senso della vita? Qual è il senso della mia esistenza? Perché continuo a vivere nel dolore e nel lutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150312,
					"content": "*sospira* Ovviamente, la scelta più comoda sarebbe quella di smettere di progredire, smettere di pensare e continuare a fare quello che siamo abituati a fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150313,
					"content": "Quando pensieri di questo tipo si manifestano, guardate alle persone e alle cose attorno a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150314,
					"content": "Alcuni lavorano sodo per tutto il giorno affinché le loro famiglie possano avere un pasto caldo sul tavolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150315,
					"content": "Alcuni vanno in giro per il mondo per creare dell'arte che entri in risonanza con tutta Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150316,
					"content": "Alcuni partono alla ricerca dei segreti del mondo per prevenire delle catastrofi in avvicinamento, benché ancora ignote ai più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150317,
					"content": "Nella vita non contiamo solo noi stessi. Ciascuna delle vostre azioni forma voi e il mondo attorno a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150318,
					"content": "*sospira* Guardate, gli amici e la famiglia ricorderanno ciò che avete fatto, e perfino alcune persone che non avete mai incontrato potrebbero trarre beneficio dalle vostre azioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150319,
					"content": "Per cui, molte persone continueranno a sforzarsi di forgiare nuovi sentieri, anche se questo significa essere in preda a grandi dolori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150320,
					"content": "Quando inizierete il vostro viaggio sullo stesso sentiero, difficile ma comunque appagante, avrete le risposte a quelle grandi domande esistenziali, che tuttavia non sembreranno più così imponenti come prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150321,
					"content": "Ma se credete che la vita non sia altro che un sogno vuoto ed effimero, allora sarà questo che diventerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150322,
					"content": "Siete liberi di scegliere come vivere le vostre vite, ma come vostra Archon, è mio compito disseminare queste informazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150323,
					"content": "Alla fine, sta a voi decidere se abbracciare o no un sogno fantastico a discapito della vostra vita vera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "Sei formidabile, Nahida! Perfino Paimon era stata quasi conquistata dallo studioso nel sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150402,
					"content": "Beh, è molto bravo a manipolare le debolezze della natura umana, Ma forse anche lui è caduto prigioniero tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150403,
					"content": "Quel sogno è stato incredibilmente bello e accattivante. La gente normale non riusciva a capirlo, e si è persa con facilità al suo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150404,
					"content": "Ma finché riuscite ancora a svegliarvi, potete andare avanti nella vostra vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150405,
					"content": "Anche tu hai imparato un sacco di cose, Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "Eh? Cosa te lo fa dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150407,
					"content": "Adesso sei in grado di provare empatia per gli altri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "Esatto! Hai detto di non capire i sentimenti, ma adesso abbiamo visto quanta considerazione hai per tutti loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150409,
					"content": "Il tuo discorso ha fatto breccia nel cuore di tutti. Hai fatto un ottimo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150410,
					"content": "Grazie. Ho sentito un sacco di storie tristi in questi giorni, e molte di queste mi hanno toccato il cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150411,
					"content": "Non si può dire che le vittime del sogno abbiano fatto qualcosa di male, e nemmeno i loro desideri erano irragionevoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150412,
					"content": "Per questo potevo capirli quando hanno provato a resisterci e proteggere il sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150413,
					"content": "Ma probabilmente tutta la mia comprensione e tutti i miei sentimenti non equivalgono nemmeno a un centesimo del dolore che hanno vissuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150414,
					"content": "Non penso che questo \"un centesimo\" possa esser considerato un esempio di quello che chiamate empatia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150415,
					"content": "Ti butti troppo a terra, questo è appurato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150416,
					"content": "Nessuno è in grado di provare empatia assoluta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "Eheh, va bene. Immagino che uscire nel mondo sarà d'aiuto alla mia confidenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150419,
					"content": "Ho imparato che le emozioni sono molto diverse dalla conoscenza, e per questo è difficile per me esprimerle a parole, a volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150420,
					"content": "Beynuni, o \"Moseis\", ha detto che non ho mai provato sulla mia pelle il dolore della perdita, ma ho una vaga idea che questo non sia vero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150421,
					"content": "Il momento in cui entrai nel sogno, mi sentii subito al centro di una coltre di sentimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150422,
					"content": "Era così accogliente che mi sembrava di tornare all'inizio della mia vita, e non volevo svegliarmi più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150423,
					"content": "(Eh... Avrà visto anche lei qualcosa nel sogno?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "Ma quando ho aperto i miei occhi, quella sensazione è sparita senza lasciar traccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150425,
					"content": "Se dovessi fare un'analogia, direi che non vedo più le parole sul foglio dopo che sono state cancellate, ma vedo ancora il segno dove erano state scritte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150426,
					"content": "Ma adesso che ho fatto questo sogno... Penso di poter dire con sicurezza che non penserò troppo al significato di quel calore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150427,
					"content": "Per adesso mi basta poter dire di aver sentito il supporto di quel calore, e la sua esistenza mi ha permesso di essere dove sono oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150428,
					"content": "Se mi soffermassi troppo a pensare alla sua natura, metterei il carro davanti ai buoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150429,
					"content": "Ho fatto un discorso per ispirare la mia gente, per cui se non dovessi mantenere le mie promesse, che imbarazzo che sarebbe, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150430,
					"content": "(Sua Eccellenza Maggiore Rukkhadevata ha già formato Nahida tramite le sue azioni.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(Anche se è stata dimenticata, la mente e la potenza della mente di Nahida sono la prova che una volta esisteva.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(Invece di dire la verità, dovrei rispettarne le decisioni.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "Ehi, perché quell'espressione seria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150434,
					"content": "Sembra che tu voglia dirmi qualcosa, è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150435,
					"content": "Eh, ho dimenticato cosa volevo dire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "Eheh, va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150438,
					"content": "#Dato che ci siamo appena svegliat{F#e}{M#i}, facciamo un po' di stretching.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150439,
					"content": "Un nuovo giorno sta per iniziare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150436,
					"content": "No, niente di importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "Dovresti credere un po' più in te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
