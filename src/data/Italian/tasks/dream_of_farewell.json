					"nextDialogs": [
						130150602
					],
					"speakerTitle": "Kathya"
				},
				{
					"id": 130150602,
					"content": "Non dovrei semplicemente sedere qui ad aspettare che torni. La professoressa Aisha era molto determinata a esplorare i segreti, per cui penso che anche io dovrei andare a darci un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150603
					],
					"speakerTitle": "Kathya"
				},
				{
