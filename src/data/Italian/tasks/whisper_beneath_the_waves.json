					}
				]
			},
			"dialogs": [
				{
					"id": 760200301,
					"content": "Wow... Ci sono un sacco di quelle cose luccicanti che abbiamo visto prima! Aspetta, ma dove siamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200302,
					"content": "Forse abbiamo girato in tondo sotto quell'albero strano? E quegli affari verdi... Che cosa sono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7602004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
