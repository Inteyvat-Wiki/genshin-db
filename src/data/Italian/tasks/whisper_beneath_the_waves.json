			"trigger": {
				"objectNames": [
					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "Un altro giorno, un altro secchio vuoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200102,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "Sto pescando. Anche se finora ho pescato tutto tranne che i pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200104,
					"content": "Se fossero cianfrusaglie dai relitti, andrebbe bene, perché i mercanti viaggiatori le comprerebbero. Una volta ho tirato su uno stivale con mezza... *sospira* Lasciamo perdere. Parlare di queste cose farà scappare i pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200105,
					"content": "C'è niente d'interessante da queste parti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "Parli di tesori? Quel \"Gran tesoro\" che dicono sia a est della luna e a ovest del sole... Non ci vuole molto per capire che non si trova qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200107,
					"content": "Ah, a proposito, ci sono diversi relitti qui in queste acque. Forse ci sono dei tesori là sotto, ma non saranno facili da prendere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200108,
					"content": "L'ho sentito anche alla taverna da dei marinai che sono riusciti ad abbandonare la loro nave prima che affondasse. Hanno detto che quella notte non c'era la luna, ma qualcosa brillava là fuori tra le onde altissime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200109,
					"content": "Dicevano che doveva essere Kratti, un mostro con un occhio solo e in grado di divorare la luna. Stava combattendo un serpente marino enorme per il territorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200110,
					"content": "Per molto tempo, l'intero tratto è rimasto buio come l'inchiostro. Nessuna nave osava attraversarlo. Tutti temevano che le anime perdute sotto le onde li avrebbero trascinati a fondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200111,
					"content": "C'è chi dice che le anime smarrite vagano ancora da queste parti, ma per me sono tutte storie per spaventare i bambini. Io non credo a questo tipo di assurdità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200112,
					"content": "A proposito dell'albero...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "È davvero inquietante. Una volta c'era un vortice qui, e i marinai lo chiamavano l'Occhio di Kratti. Poi un giorno, quest'albero ha semplicemente iniziato a crescere proprio da lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200114,
					"content": "Ma non è stata l'unica cosa strana che è avvenuta in quel periodo. A pensarci bene, tutto è iniziato quando quelle rocce sono cadute dal cielo... Chissà? Forse quest'albero proviene dallo stesso posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200115,
					"content": "E poi ci sono quei piccoli cosi luccicanti che vedi di tanto in tanto. Sono davvero rari. Ho anche pensato che potessero esserci dei nuovi tipi di pesci. Ecco perché sono venuto qui: per tentare la fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200116,
					"content": "Avevo un compagno di pesca che veniva fin qui, ma continuava a dire di sentire delle canzoni strane. Era così spaventato che non è più tornato. Ah, è un Erede della Luna gelata solo per metà, ma ne ha ereditato le brutte abitudini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200117,
					"content": "Scusa il disturbo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "Nessun problema. Tanto non c'è nemmeno un pesce in vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		},
