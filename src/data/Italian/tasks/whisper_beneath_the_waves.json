						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "Che strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200702,
					"content": "Avete visto? Quell'albero si è illuminato all'improvviso, e questi piccolini... peccato che non siano pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200703,
					"content": "Quindi quella cosa al centro è la sua radice, eh? Paimon non ha idea di come funzioni, ma ora è tutta luminosa. È molto più bella di quando era spenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200704,
					"content": "Spieghi quello che è successo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "Non è facile crederci... Però non avete motivo di mentirmi. Sembra che quel mio compagno di pesca, quel mezzo Erede della Luna gelata, stesse dicendo la verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200706,
					"content": "E allora? Sono solo resti del passato. Qualunque cosa cantino o dicano, non impediranno a noi vivi di pescare pesci vivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200707,
					"content": "#Comunque, anche voi siete {F#cacciatrici}{M#cacciatori} di tesori, vero? Quella cosa che avete preso prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200708,
					"content": "Quindi è questa la <color=#00E1FFFF>Prova degli esperti</color>? Sembra una piuma qualunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200709,
					"content": "Un mercante che conosco una volta ha detto che se raccogli cinque <color=#00E1FFFF>Prove degli esperti</color>, potrai trovare il \"Gran tesoro\" a est della luna e a ovest del sole. Chissà se è vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200710,
					"content": "Però sembra che molti cacciatori di tesori ci credano. Lo cercano come dei pazzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200711,
					"content": "Beh, dopotutto è un tesoro! Anche Paimon è un po' curiosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200712,
					"content": "Se avessi vent'anni di meno... No, anche se fosse, sarei qui a pescare. Detto questo, un altro giorno, un altro secchio vuoto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}