			},
			"dialogs": [
				{
					"id": 790610501,
					"content": "Mi dispiace, Rozel, ma... non posso comunque venire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610502
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610502,
					"content": "Preferisco rimanere qui. Così, quando tornerai dalle tue avventure, ci sarà qualcuno ad aspettarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610503,
					"content": "Ma Esnoir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610504
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610504,
					"content": "Rozel, non sono né abbastanza scaltro, né abbastanza coraggioso. Ma credo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610505
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610505,
					"content": "La brezza scorre tra la boscaglia, i fiumi scorrono attraverso i laghi, e il ciclo ricomincia da capo. Alla fine, tutto torna come era all'inizio. È questo ciò in cui credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610506
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610506,
					"content": "Forse, dopo tutti quei cambiamenti, il loro ultimo desiderio è... tornare a essere sé stessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610507
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610508
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610508,
					"content": "Amico mio, ti aspetterò qui a casa. Come ho sempre fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				}
			]
		},
