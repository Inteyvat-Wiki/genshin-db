			"dialogs": [
				{
					"id": 790610601,
					"content": "\"Questa lettera è per il mio vicino, il mio amico, il mio faro e il mio fiorellino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610602
					],
					"speakerTitle": "Lettera dal tratto impreciso"
				},
				{
					"id": 790610602,
					"content": "Sto per partire all'avventura con Rozel. Sentiti libero di usare la mia altalena, il mio tavolo e il mio sgabello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610603
					],
					"speakerTitle": "Lettera dal tratto impreciso"
				},
				{
					"id": 790610603,
					"content": "Ti auguro ogni bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610604
					],
					"speakerTitle": "Lettera dal tratto impreciso"
				},
				{
					"id": 790610604,
					"content": "Il tuo vicino, Esnoir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
