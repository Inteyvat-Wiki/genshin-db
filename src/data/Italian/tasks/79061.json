				]
			},
			"dialogs": [
				{
					"id": 790610101,
					"content": "Rozel, non importa quante volte me lo chiedi, non partirò insieme a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610102,
					"content": "Sei mio amico, è vero, e questo non cambierà mai. Non è che non mi piace la tua compagnia... È che non amo viaggiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610103,
					"content": "Esnoir, non è così spaventoso come immagini. È solo un viaggio, niente di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610104,
					"content": "Nel mondo esterno esistono tantissimi fiori che non si trovano nel nostro villaggio e moltissime persone che non abbiamo mai incontrato. Persino le nuvole hanno forme diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610105,
					"content": "Ricordi il seme che ti ho portato? Ti garantisco che non hai mai visto un fiore con quella forma o colore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610106,
					"content": "Adesso è ancora un seme. Lo pianterò e poi vedremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610107,
					"content": "Se vieni con me, forse potremo vederlo con i nostri occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610108,
					"content": "Rozel... Scusa, ma non mi interessa viaggiare, e non voglio diventare come i venturieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610109,
					"content": "Si preoccupano sempre e solo del valore dei tappeti e non prestano attenzione alla bellezza dei cappelli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610110,
					"content": "Hanno iniziato a comportarsi così dopo essere tornati dai loro viaggi, e a me questo spaventa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610111,
					"content": "È vero. Ma hai visto che le mappe, le piante e i diari di viaggio che riempiono i loro bagagli fino a scoppiare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610112,
					"content": "Passiamo attraverso arbusti e cespugli come una folata di vento, come fiumi che attraversano un lago... Facciamo esperienze diverse, e noi stessi diventiamo persone diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610113,
					"content": "È così che i viaggi ti cambiano, e anche a me fa paura... ma sono anche grato per questi cambiamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610114,
					"content": "È un'esperienza che paragonerei a una fetta di pane ricoperta di panna su entrambi i lati: non importa in che modo tu possa tenerla, in un modo o nell'altro finirai per fare un pasticcio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610115,
					"content": "Beh, io eviterei di spalmare panna su entrambi i lati. Userei due fette. E ti dirò di più: ci spalmerei anche due cose diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610116,
					"content": "Un'idea niente male. Di sicuro riempirebbe la pancia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "Ah, finalmente sei qui! Rozel mi parla sempre di quanto incredibile sia il mondo esterno e mi invita a partecipare alle sue avventure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610119,
					"content": "Sai molto di quel mondo? È... come dicono che sia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610117,
					"content": "Non è una cattiva idea. Così non ci si sporca le mani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
