					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "Rozel, magari... potrei venire con te. È solo che... non so da dove iniziare a prepararmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610402,
					"content": "È facile. Preparati un buon piatto di pane, marmellata e curiosità, indossa dei vestiti comodi e portane un paio di ricambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610403,
					"content": "Infine... devi essere pronto anche a doverti disfare di alcuni di quegli oggetti lungo il cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610404,
					"content": "Oh. Sembra tutto così complicato. E non voglio buttare via niente: sono le mie cose, sono preziose e mi piacciono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610405,
					"content": "E, quando partirai, scoprirai molte nuove cose preziose, mio caro Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610406
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610406,
					"content": "Credimi, sarà un viaggio incantevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				}
			]
		},
		{
			"id": 7906105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
