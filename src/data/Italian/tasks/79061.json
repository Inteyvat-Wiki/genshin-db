			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 100,
						"position": [
							998.028,
							216.884,
							711.501
						],
						"pointId": 294
					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Sì, è davvero così. Nel <color=#FFCC33FF>mondo esterno</color> non mancano mai cose da scoprire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Esatto! Un sacco di cibo stratomitico e cose divertenti da fare, e si incontrano sempre esseri e persone interessanti. Per esempio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610203,
					"content": "Persone che volgono la propria attenzione alla splendida essenza di tutto ciò che esiste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "Davvero? Oh, cielo. Ho sempre creduto che il mondo esterno fosse pieno solo di \"valore\" e di persone che volessero indossare cappelli, ma che non osavano farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610207,
					"content": "Uhm, vedila come... una torta ricoperta di vari tipi di cioccolato! Ogni morso è una nuova esperienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610208,
					"content": "Molto meglio di un solo tipo di cioccolato, no? Diventerebbe una torta qualsiasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610209,
					"content": "Proprio così, Paimon, proprio così.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "Mi sembra normale, dopo averlo sentito così a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610212,
					"content": "Ah, sì? Non so... Ci devo pensare ancora un pochino. Ma forse andare all'avventura non sarebbe poi così male. Credo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610213,
					"content": "Non c'è fretta, Esnoir. Manca ancora un po' di tempo al mio prossimo viaggio. Fino a quel giorno, pensiamoci insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610210,
					"content": "Hai imparato il linguaggio del posto, vedo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "Ideali raggianti e immutevoli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "Persone che danno il massimo per realizzare i propri sogni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
			"id": 7906103,
			"completionStepIds": [
				7906101
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
