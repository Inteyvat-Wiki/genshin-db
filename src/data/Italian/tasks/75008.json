			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manqu",
					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "#Manqu, siamo {F#tornate}{M#tornati}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080102,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "Fiuuu, è stata una lunga attesa. Non vi mentirò, più aspettavo, più diventavo ansioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080104,
					"content": "#È stata una mia idea, è vero, ma se foste {F#andate}{M#andati} nelle rovine senza più fare ritorno, non me lo sarei mai perdonato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080105,
					"content": "Però, se mi permettete di andare al punto... Avete trovato l'amuleto che il Saggio della Fiamma rubata ha lasciato nelle rovine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080106,
					"content": "Sì, anche se è stato piuttosto complicato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "Sapevo che ce l'avreste fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080109,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "Pare essere questa cosa simile a un disco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080111,
					"content": "No, non è possibile... Una Prece dorata?! E-Esiste davvero? Incredibile! Devo assolutamente includerla nella mia ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080112,
					"content": "Quindi questa cosa si chiama \"Prece dorata\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080113,
					"content": "E-Esatto. Scusatemi, sono solo molto emozionato. Si dice che un tempo sia stata maneggiata dal Saggio della Fiamma rubata in persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080114,
					"content": "Per un attimo ho pensato a come sarebbe stato tenermela come una specie di cimelio di famiglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080115,
					"content": "#Assolutamente no! Ci serve per salvare {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080116,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "Lo so, però... Per quanto riguarda gli indizi sulla posizione degli amuleti, beh, non ho altre informazioni. Non ho la più pallida idea di dove potrebbe essere l'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080118,
					"content": "Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#Eh? Scusami, {NICKNAME}, hai detto: \"Ochkanatlan\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080120,
					"content": "(Spiega ciò che hai visto quando hai toccato la stele di pietra...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "Wow, quindi è a Ochkanatlan... Le rovine di un'antica città che si trova in una stretta distesa d'acqua, a nord del Clan Piumafiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080122,
					"content": "Se è davvero lì, allora mi dispiace, ma non posso aiutarvi. Andarci non solo è vietato dalla mia tribù, ma anche dall'Associazione delle Reliquie Sauriche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080123,
					"content": "Pare che, qualche anno fa, alcuni membri dell'Associazione avessero ricevuto l'incarico di perlustrare quel luogo, ma dopo essere partiti sono spariti senza lasciare traccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080124,
					"content": "Da allora, l'Associazione si è tenuta a debita distanza da tutto ciò che aveva a che fare con Ochkanatlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080125,
					"content": "Non preoccuparti. Ci hai già detto un sacco di cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080126,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "Vi devo ringraziare ancora una volta. Non so dirvi quanto sia importante per me aver visto una Prece dorata. A proposito, devo affrettarmi ad annotare tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080128,
					"content": "#Grazie ancora, {NICKNAME} e Paimon. Vi auguro buon viaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080129,
					"content": "#E {REALNAME[ID(2)|SHOWHOST(true)]}, ti auguro di riuscire a rimuovere il marchio della Benedizione del Signore delle Fiamme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080130,
					"content": "A presto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "Sì... Alla fine del viaggio, nel luogo dove tutte le anime si recano per riposare, ci incontreremo ancora una volta. Ne sono certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080107,
					"content": "È stato un gioco da ragazzi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
