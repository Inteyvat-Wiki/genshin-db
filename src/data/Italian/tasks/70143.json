			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701430201,
					"content": "#Ciao, viaggiat{F#rice}{M#ore}, spero che le tue avventure stiano andando bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430202,
					"content": "Non posso lamentarmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "#Bene. In effetti, ho seguito le tue recenti imprese e non ho dubbi che, se continuerai su questa strada, un giorno diventerai {F#un'avventuriera}{M#un avventuriere} eccezionale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430204,
					"content": "Per quanto riguarda le altre attività della Gilda, ho alcune informazioni su un'avventura che vorrei condividere con te, se ti interessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430205,
					"content": "Un altro incarico? Sentiamo un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "Ahah, dal tono di voce suppongo tu conosca bene il modo in cui la Gilda gestisce i propri affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430207,
					"content": "Però, questa volta non ho un incarico per te, ma delle informazioni su un'avventura che voglio condividere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430208,
					"content": "Si tratta del Picco del Drago, quella montagna innevata vicino a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430209,
					"content": "La Gilda ha allestito un accampamento a cui ha assegnato alcuni avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430210,
					"content": "Ho segnato il luogo sulla tua mappa. Quando arrivi, cerca un'avventuriera chiamata Iris, che ti informerà sulla situazione della zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430211,
					"content": "Bene, è tutto da parte mia. Buona avventura e ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
