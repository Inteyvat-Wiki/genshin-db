			"dialogs": [
				{
					"id": 701430101,
					"content": "A proposito dell'esplorazione del Picco del Drago...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430102
					]
				},
				{
					"id": 701430102,
					"content": "#Se volete davvero salire al Picco del Drago, dovete assicurarvi di essere completamente preparat{F#e}{M#i}. Non sottovalutate i pericoli della montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701430103,
					"content": "Il Picco del Drago non perdona gli incauti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7014302,
			"completionStepIds": [
				7014302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
