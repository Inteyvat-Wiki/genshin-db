			"dialogs": [
				{
					"id": 200480401,
					"content": "#Sei riuscit{F#a}{M#o} a trovare il frumento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480402
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480402,
					"content": "Sto ancora cercando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480403
					]
				},
				{
					"id": 200480403,
					"content": "Va bene, ma fai in modo di trovarlo prima che tornino le papere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480404
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480404,
					"content": "I piccioni? Non ci sono ancora. Non preoccuparti per loro, arriveranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
