			"dialogs": [
				{
					"id": 200480301,
					"content": "Sono certo che andranno tutti d'accordo dopo un buon pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480302
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480302,
					"content": "La prossima volta che passi di qui, per favore, non spaventare i piccioni. È difficile poi farli tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480303
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480303,
					"content": "Farò più attenzione, in futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480304
					]
				},
				{
					"id": 200480304,
					"content": "E va bene, ti perdono. Tieni, una frittella di patate di Mondstadt... Sono le mie preferite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480305
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480305,
					"content": "Mamma dice che bisogna essere sempre gentili con gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
