						200480202
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480202,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480203
					]
				},
				{
					"id": 200480203,
					"content": "Sembra abbastanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480204
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480204,
					"content": "Portalo al lago e dallo in pasto alle papere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
