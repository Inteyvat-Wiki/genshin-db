			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanfei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "Intrappolati in un luogo del genere, chi poteva prevederlo? Che situazione complicata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280602,
					"content": "Ho studiato per tutta la vita come rinchiudere le persone in prigione, ma non ho idea di come si faccia a liberarle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280603,
					"content": "Ho anche stipulato un contratto con mio padre per \"vivere serenamente\"... Non voglio risultare inadempiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280604,
					"content": "#Devo pensare positivo... Se non altro ho esplorato un posto nuovo, ampliato le mie conoscenze del mondo e perfino ritrovato {F#delle}{M#dei} vecch{F#ie}{M#i} amic{F#he}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280605,
					"content": "E già... Immagino che qualcosa di buono ci sia stato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanfei"
				}
			]
		},
		{
