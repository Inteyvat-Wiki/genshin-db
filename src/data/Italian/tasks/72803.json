	"talks": [
		{
			"id": 7280302,
			"completionStepIds": [
				7280304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
