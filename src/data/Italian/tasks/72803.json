				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kouichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030401,
					"content": "Ciao, come posso aiutarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030402
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030402,
					"content": "Riguardo alle offerte al santuario...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030403
					]
				},
				{
					"id": 728030403,
					"content": "Ah... I santuari... Anch'io ci sono stato qualche volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030404
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030404,
					"content": "Eheh, voglio le benedizioni divine, così, quando cresco, posso andare nel mondo là fuori e vedere com'è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030405
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030405,
					"content": "Comunque alla fine le offerte sono solo un altro tipo di preghiera. Devo comunque lavorare sodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030406
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030406,
					"content": "I miei genitori mi hanno detto che, se voglio viaggiare, prima devo guadagnare abbastanza soldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030407
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030407,
					"content": "Sì, finché hai le benedizioni divine, i tuoi sogni si avvereranno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030408
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030408,
					"content": "Non ne sono sicuro. Dopotutto, se davvero andassi a esplorare il mondo là fuori, non penso che le divinità di Inazuma potrebbero proteggermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030409
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030409,
					"content": "I miei genitori dicevano che fare offerte alle divinità significa solo ottenere un po' di tranquillità in più. Se vuoi che i tuoi desideri si avverino, devi comunque lavorare sodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030410
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030410,
					"content": "Questo è quello che so, comunque. Se volete saperne di più, parlate con Nanatsuki. Lei è un'esperta di queste cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030411
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030411,
					"content": "Mmh... Forza, andiamo a cercare Nanatsuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280305,
			"completionStepIds": [
				7280307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280307",
							"2"
						],
						"stepId": 7280307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030501,
					"content": "Shouta? Perché così triste? Qualcuno si è comportato male con te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030502
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030502,
					"content": "Nanatsuki, sai che tutti in città fanno delle offerte al santuario per chiedere delle benedizioni divine, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030503,
					"content": "Finché mettiamo il cuore nelle nostre offerte e facciamo in modo che le divinità abbiano un motivo per rispondere, allora qualsiasi desiderio può essere esaudito... Giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030504,
					"content": "Eh? Perché all'improvviso dici queste cose... È successo qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030505
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030505,
					"content": "Così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030507
					]
				},
				{
					"id": 728030507,
					"content": "Shouta... Andavi con tanto entusiasmo al santuario per una cosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030508
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030508,
					"content": "Sì! Ho fatto le offerte alla divinità con tutto il mio cuore. Ma continuavano a rubarle... Pensavo che la divinità mi avrebbe incolpato e non avrebbe più vegliato su di me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030509,
					"content": "Sciocco ragazzino... Non preoccuparti, la divinità non si arrabbierà con te per una cavolata del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030510
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030510,
					"content": "D-Davvero? Meno male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030511
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030511,
					"content": "In ogni caso, la divinità probabilmente non aiuterà qualcuno solo per delle offerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030512
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030512,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030513
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030513,
					"content": "Le persone fanno offerte e chiedono benedizioni non perché vogliono che il loro desiderio venga esaudito, ma al fine di poter costruire una base solida per la fiducia in sé stessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030514
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030514,
					"content": "Fiducia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030515
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030515,
					"content": "\"Visto che abbiamo già detto i nostri desideri alla divinità, noi dobbiamo fare del nostro meglio per realizzarli\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030516
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030516,
					"content": "\"Con la divinità che veglia su di noi, se ci diamo da fare, avremo successo di sicuro\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030517
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030517,
					"content": "Con questo tipo di fiducia in sé stesse, le persone sono disposte a dare il massimo per realizzare i propri desideri. Questo è il motivo per cui tutti fanno offerte ai santuari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030518
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030518,
					"content": "Alla fine... Sono le persone a muovere il mondo. Se preghiamo le divinità e non facciamo niente, anche se una divinità volesse davvero aiutarci, non saprebbe comunque da dove cominciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030519
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030519,
					"content": "M-Ma quando ho fatto le offerte al santuario, la divinità mi ha sempre aiutato direttamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030520
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030520,
					"content": "Quella volta col fuoco, quel signore che voleva diventare più forte, i miei fumetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030521,
						728030522
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030521,
					"content": "(Sta ancora parlando di divinità)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				},
				{
					"id": 728030523,
					"content": "Mmh... Hai ragione. Sembra che la divinità abbia un modo diretto di esaudire i desideri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030524
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030524,
					"content": "Ma, ma... Non solo le verifiche non sono scomparse, ma quella bulla è sempre là. Mi assilla tutti i giorni dicendomi di fare i compiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030525
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030525,
					"content": "Mmh, aspetta un attimo. Come si chiama la bulla? Quand'è arrivata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030526
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030526,
					"content": "Lei... Lei... si chiama... Eh? Il suo nome è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030527
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030527,
					"content": "Credo che abbiamo iniziato la scuola allo stesso momento... No, no, credo lei abbia iniziato un po' prima... O dopo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030528
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030528,
					"content": "Che strano... Perché non riesco a ricordare nulla? L'unica cosa che ricordo è di una ragazza che mi diceva di studiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030529
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030529,
					"content": "Mmh, sembra che la divinità abbia risposto di nuovo ai tuoi desideri, e che ora ti stia aiutando a vincere la tua antipatia per le verifiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030530
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030530,
					"content": "Vuoi dire quella ragazzina? Quella bulla che non mi lascia mai in pace? La divinità l'ha inviata per spingermi a studiare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030531
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030531,
					"content": "Noooo! Non voglio studiare, non voglio fare le verifiche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030532
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030532,
					"content": "Aaaah! Eccola di nuovo. Proprio là. Sta venendo dall'altro lato della strada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030533,
						728030534
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030533,
					"content": "Dove?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030535,
					"content": "Non riesci a vederla?! Sta venendo qui con una pila gigantesca di verifiche! Aaah! Non voglio fare le verifiche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030536
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030536,
					"content": "Sembra che la divinità si stia dando davvero da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030537,
						728030538
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030537,
					"content": "Una divinità proprio imprevedibile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030539,
					"content": "Comunque, sotto la personale supervisione della divinità, quel ragazzino dovrebbe riuscire a passare le verifiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030540
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030540,
					"content": "Dopotutto, immagino che nemmeno le divinità sopportino le lagne continue di quel ragazzino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030541
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030541,
					"content": "Eh? Aspetta. Perché ci sono delle foglie sulla strada? Prima non c'erano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030538,
					"content": "Non sembra qualcosa che farebbe una divinità...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030534,
					"content": "Non vedo niente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030522,
					"content": "(Sono proprio su due diverse lunghezze d'onda)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				}
			]
		}
	]
}