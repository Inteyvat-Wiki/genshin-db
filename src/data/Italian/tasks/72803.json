				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cacciatore di tesori sarcastico"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030201,
					"content": "Ladri! La divinità non mi risponde più perché avete rubato tutte le mie offerte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030202
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030202,
					"content": "Offerte? Stai parlando delle cose che erano dentro al santuario? Ma ti pare, non vorremmo quella roba nemmeno come regalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030203
					],
					"speakerTitle": "Cacciatore di tesori sarcastico"
				},
				{
					"id": 728030203,
					"content": "E poi, se offri quella spazzatura al santuario, dubito che riceveresti anche una sola risposta dalla divinità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030204
					],
					"speakerTitle": "Cacciatore di tesori sarcastico"
				},
				{
					"id": 728030204,
					"content": "C-Cosa hai detto?!? Le mie offerte non sono spazzatura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030205
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030205,
					"content": "Lascia stare, non abbiamo il tempo per giocare con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030207
					],
					"speakerTitle": "Cacciatore di tesori sarcastico"
				},
				{
					"id": 728030207,
					"content": "L-Le mie offerte non sono spazzatura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030208
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030208,
					"content": "Puoi dirci i tuoi desideri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030209
					]
				},
				{
					"id": 728030209,
					"content": "Ok... Vista la situazione, credo che il mio desiderio non sarà realizzato comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030210,
					"content": "I miei due desideri sono semplici. Il primo è che non voglio più fare esami! Senza esami, non sarò più rimproverato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030211
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030211,
					"content": "L'altro è... Vorrei che quella bulla a scuola smettesse di darmi fastidio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030212,
						728030214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030212,
					"content": "Neanche a me piacciono gli esami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030213
					]
				},
				{
					"id": 728030213,
					"content": "Ecco! Gli esami sono orribili... Ma quella bulla mi dà ancora più fastidio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030216,
					"content": "Mi ha visto molte volte esprimere un desiderio al santuario. Quando mi ha sentito dire che non volevo più fare le verifiche, è andata dai miei insegnanti a chiedere i miei risultati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030217
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030217,
					"content": "Da quel momento in poi, mi dice sempre che è meglio passare il tempo a fare attenzione in classe, piuttosto che a pregare in un santuario. Ha anche detto che se continuo a essere così assillante, perfino le divinità si spazientiranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030218
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030218,
					"content": "Ha anche detto che sono... davvero patetico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030219
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030219,
					"content": "Beh, non va bene dipendere troppo dalle divinità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030220
					]
				},
				{
					"id": 728030220,
					"content": "Ma quando gli adulti hanno dei problemi, fanno sempre delle offerte al santuario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030221,
						728030222
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030221,
					"content": "Esprimono solamente un desiderio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030223,
					"content": "Mmh... Non capisco... Pensavo che ognuno facesse delle offerte ai santuari per chiedere l'aiuto divino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030224
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030224,
					"content": "Andiamo a chiedere a qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030225
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030225,
					"content": "Mmh... Ok. In ogni caso, i miei desideri non saranno esauditi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030222,
					"content": "Alla fine, devono comunque risolversi i problemi da soli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030214,
					"content": "Bulla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030215
					]
				},
				{
					"id": 728030215,
					"content": "Una della mia classe. È d-davvero insopportabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280304,
			"completionStepIds": [
				7280306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280306",
							"2"
						],
						"stepId": 7280306,
						"stateName": "QUEST_STATE_UNFINISHED"
