			},
			"dialogs": [
				{
					"id": 711215101,
					"content": "#G-Grande {M#eroe valoroso}{F#eroina valorosa}! Ti prego, risparmiami la vita! Non sono uno di loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215102
					],
					"speakerTitle": "Mercante strano"
				},
				{
					"id": 711215102,
					"content": "E allora chi saresti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215103
					]
				},
				{
					"id": 711215103,
					"content": "Io?! Sono... Oh... È una storia lunga...? Hanno rubato delle cose, e il mio padrone mi ha chiesto di segnarle in un documento e restituirle, tutto qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215104
					],
					"speakerTitle": "Mercante strano"
				},
				{
					"id": 711215104,
					"content": "Beh, dato che hai scacciato tutti i ladri, e il mio lavoro qui è finito, io me ne vado, se non ti dispiace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215105
					],
					"speakerTitle": "Mercante strano"
				},
				{
					"id": 711215105,
					"content": "Un momento...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215106
					]
				},
				{
					"id": 711215106,
					"content": "Non c'è bisogno, ci rivedremo sicuramente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mercante strano"
				}
			]
		}
