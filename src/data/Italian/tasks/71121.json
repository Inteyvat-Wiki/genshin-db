					"Mercante strano"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711210201,
					"content": "Grazie mille, non so come ringraziarvi! Aaaah, tutta la merce sarebbe andata persa senza di voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "Mercante strano"
				},
				{
					"id": 711210202,
					"content": "Non ho molti soldi con me, ma vi prego di accettare questa ricompensa. Non fate complimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210203
					],
					"speakerTitle": "Mercante strano"
				},
				{
					"id": 711210203,
					"content": "Wow, sei troppo gentile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711210204,
					"content": "È ora dei saluti, allora. Spero che ci rivedremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mercante strano"
				}
			]
		},
		{
			"id": 7112103,
			"completionStepIds": [
				7112103
