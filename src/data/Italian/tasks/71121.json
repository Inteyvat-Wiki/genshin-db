			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mercante strano"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711210301,
					"content": "#P-Per favore, risparmiatemi, o {F#magnanime eroine}{M#magnanimi eroi}... Aspettate, siete voi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "Mercante strano"
				},
				{
					"id": 711210302,
					"content": "...Uh? Sei tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "Ehi, ehi, che coincidenza, eh...? Eheheh, perché non tornate a fare quello che stavate facendo? Ora, se volete scusarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Mercante strano"
				},
				{
					"id": 711210304,
					"content": "Ti suggerisco di dare un'occhiata a quali oggetti di valore hanno lasciato. Ah, non badare a me, mi sono già segnato tutto... Restituirò tutto quello che devo restituire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Mercante strano"
				},
				{
					"id": 711210305,
					"content": "Aspetta...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "Non c'è bisogno, ci rivedremo sicuramente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mercante strano"
				}
			]
		},
