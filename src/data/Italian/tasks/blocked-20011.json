			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200110201,
					"content": "#Uff. Grazie, viaggiat{F#rice}{M#ore}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110202,
					"content": "Ma guarda questi ostacoli. Non posso passare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110203,
					"content": "Ahah... Avrei potuto cavarmela da solo, se gli Hilichurl non mi avessero messo al tappeto. Mi fa male tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110204,
					"content": "Ma almeno le erbe medicinali che ho raccolto per Anna sono ancora in buone condizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110205,
					"content": "Scusami... Lo so che è un favore enorme quello che sto per chiederti, soprattutto dopo quello che hai già fatto per me, ma potresti distruggere questi ostacoli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110206,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "Grazie! Nel frattempo mi riposerò un po', ne ho bisogno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110207,
					"content": "Scusa, ma sto andando di fretta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "Ma Anna mi sta aspettando a casa... Ti prego, ho davvero bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2001103,
			"completionStepIds": [
				2001104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2001104",
							"2"
						],
						"stepId": 2001104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200110301,
					"content": "#Ora la via è libera. Grazie, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110302,
					"content": "Anna non guarisce mai definitivamente. Ma siccome non abbiamo molti soldi, spesso vengo qui e raccolgo tutte le erbe medicinali che riesco a trovare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110303,
					"content": "Ero riuscito a prendere le erbe che cercavo, ma poi quel gruppo ha iniziato ad attaccarmi dal nulla. Fortunatamente hai agito in tempo per salvarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110304,
					"content": "Tieni. Ci faccio sempre il tè per Anna, la aiuta contro la tosse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110305,
					"content": "Sembri qualcuno a cui piace stare all'aria aperta. Mi raccomando, fa' attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
