				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5481.038,
							194.726,
							9711.116
						],
						"pointId": 15006
					},
					{
						"sceneId": 3,
						"position": [
							5480.359,
							194.706,
							9710.449
						],
						"pointId": 15007
					},
					{
						"sceneId": 3,
						"position": [
							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "Ora abbiamo solo bisogno che Nicole aggiunga i tocchi finali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731133,
					"content": "#Vi siete {F#liberate}{M#liberati} di tutta la pietra superflua, vero? Fatemi dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731134,
					"content": "Eheh, fatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731101,
					"content": "Woah! È la loggia della maga! Ma quando è apparsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731102,
					"content": "È questo il potere di una maga?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "#\"È questo il potere di una maga?\", la voce {F#della giovane visitatrice}{M#del giovane visitatore} era colma di meraviglia. \"Sono davvero {F#sbalordita}{M#sbalordito}.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731104,
					"content": "#Aha! Finalmente la storia continua! Allora, cos'è successo alla maga e {F#alla sua giovane visitatrice}{M#al suo giovane visitatore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731105,
					"content": "E vissero per sempre felici e contenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731106,
					"content": "...Fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731107,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731108,
					"content": "E come ci siamo arrivati?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "*sospira* Che clienti esigenti. Beh, se ci tenete così tanto a sentirla, immagino che dovrò cominciare dall'inizio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731111,
					"content": "#\"Tutto ciò che il mio cuore desidera è fare miei i tuoi desideri\", disse {F#la ragazza}{M#il ragazzo}. Con quelle parole conquistò la piena attenzione della grande maga, Nicola Coco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731112,
					"content": "Ma proprio mentre avevano iniziato a entrare in sintonia, un gruppo di visitatori inattesi fece irruzione, catturò la maga e fuggì portandola via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731113,
					"content": "#{F#La ragazza}{M#Il ragazzo} rimase lì, {F#impalata}{M#impalato} e {F#sconvolta}{M#sconvolto}, quando apparve una nuova maga di nome Alynas. Ella siglò un contratto con {F#la}{M#il} giovane, {F#conferendole}{M#conferendogli} il potere della magia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731114,
					"content": "Ma dopo aver superato un estenuante programma di addestramento, scoprì un'altra cospirazione in corso nell'ombra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731115,
					"content": "A quanto pare, la grande maga Nicola Coco era un'entità aliena. La sua vera identità era quella di primogenita di Re Miaotrè III del Pianeta Miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731116,
					"content": "Arrivò camuffata da maga come parte di un complotto segreto il cui obiettivo era portare il mondo intero ad adorare il Pianeta Miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731117,
					"content": "#\"O grande maga... Mi hai mentito per tutto questo tempo?\", la voce {F#della ragazza}{M#del ragazzo} tremava, mentre il suo cuore iniziava a spezzarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731118,
					"content": "#\"Vai via. È destino che scoppi una guerra tra il mio pianeta e il tuo. Siamo sempre {F#state nemiche}{M#stati nemici}, io e te.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731119,
					"content": "La maga si voltò, rifiutandosi di lasciare che qualcuno vedesse le lacrime che le stavano riempiendo gli occhi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731120,
					"content": "#Ma {F#la ragazza}{M#il ragazzo}, coraggiosamente, la prese per il braccio, giurando di non lasciarla mai andare. Commossa da tale passione, la maga decise di ribellarsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731121,
					"content": "#Ma in quel momento, Alynas, che un tempo aveva aiutato {F#la ragazza}{M#il ragazzo}, si schierò dalla parte del re.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731122,
					"content": "#Alynas era la seconda figlia di Miaotrè III. Aveva aiutato {F#la}{M#il} giovane nella speranza di istigare sua sorella al tradimento, dandole così la possibilità di prendere il posto di Nicole nella linea di successione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731123,
					"content": "Nicole continua con il suo lungo e sconclusionato racconto. Si susseguono molti bizzarri colpi di scena, come la scoperta che il protagonista non è più un essere umano...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "#Comunque, questo è il succo della storia. Alla fine, {F#la ragazza}{M#il ragazzo}, che a quel punto si era {F#trasformata}{M#trasformato} in un gatto, collaborò con la maga per sventare il complotto del re. Poi tornarono insieme alla loggia della maga e vissero per sempre felici e contenti, in pace e tranquillità. Fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731125,
					"content": "*tira su col naso* Che storia incredibile... Ha davvero di tutto! Il vero amore... la ribellione contro le ingiustizie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731126,
					"content": "A giudicare dall'inizio e dalla fine, sembrano quasi due storie diverse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "È inevitabile. Prima o poi, tutte le creazioni sfuggono al controllo del loro creatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731128,
					"content": "Noi angeli ne siamo un esempio lampante. Un tempo avevamo il compito di guidare gli esseri umani, ma poiché alcuni di noi hanno scelto un percorso diverso, la nostra intera specie è stata punita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731129,
					"content": "Se persino i Princìpi celesti non sono in grado di controllare del tutto le proprie creazioni... che possibilità ho io di riuscirci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731130,
					"content": "Il destino è sempre ineffabile, eppure... spero ancora di poter guidare coloro che incontro verso un lieto fine per la loro storia. E questo vale anche per i personaggi dei miei racconti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731131,
					"content": "Comunque, la storia è finita, e sono un po' a corto di energie. La prossima volta che avrò una bella storia da raccontare, la condividerò con voi, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731135,
					"content": "Alynas era la seconda figlia di Miaotrè III.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731136,
					"content": "#Aveva aiutato {F#la}{M#il} giovane nella speranza di istigare sua sorella al tradimento,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731137,
					"content": "dandole così la possibilità di prendere il posto di Nicole nella linea di successione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731109,
					"content": "Hai saltato tutta la parte centrale della storia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
