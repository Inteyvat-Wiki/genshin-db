			},
			"dialogs": [
				{
					"id": 766730801,
					"content": "#Tanto, tanto tempo fa, {F#una ragazza}{M#un ragazzo} scappò via di casa. Dopo aver speso i suoi ultimi Mora, si avventurò nel freddo dell'inverno, tremando nei suoi abiti logori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730802,
					"content": "#Improvvisamente, {F#la ragazza}{M#il ragazzo} si ritrovò {F#sospesa}{M#sospeso} nel vuoto e cadde in uno strano luogo. Ma prima che potesse reagire, una voce risuonò in lontananza:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730803
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730803,
					"content": "\"Questa è la dimora segreta di Nicola Coco, la Grande Maga eterna. Oh, anima indigente, svelami il più grande desiderio del tuo cuore e, grazie alla mia guida, lo realizzerai.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730804
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730804,
					"content": "Woah... Che voce strana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730805,
					"content": "\"Nicola Coco\"... E chi sarebbe? La conosciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
