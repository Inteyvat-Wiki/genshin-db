			"dialogs": [
				{
					"id": 766730501,
					"content": "Proprio le persone che volevo vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730502
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730502,
					"content": "Sono molto contenta delle foto che avete scattato, sono un ottimo materiale di riferimento. Ho tutti gli utensili da intaglio pronti. Vi andrebbe di provare insieme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730503
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730503,
					"content": "Utensili da intaglio...? Intendi questi blocchi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730504,
					"content": "Esatto. Le statue sono all'interno delle pietre. Dobbiamo solo rimuovere il materiale in eccesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730505
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730505,
					"content": "Per rendervi le cose un po' più facili, ho preparato una guida su come funziona il processo di intaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730506
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730506,
					"content": "Lasciate che vi dia una dimostrazione. Per prima cosa, facciamo dei tagli grandi e decisi per definire la forma generale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730507
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730507,
					"content": "I numeri sulle pietre rappresentano la quantità di materiale da conservare in una data colonna. Quindi, prima facciamo così... e poi così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730508
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730508,
					"content": "Uuh, sta iniziando a prendere forma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730509,
					"content": "Capito? Se scolpisci i blocchi in questo modo, dovresti riuscire a vederne la forma di base.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730510
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730510,
					"content": "Poi, devi solo aggiungere qualche ritocco finale... et voilà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730511
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730511,
					"content": "Aspetta, cosa?! È cambiata in un batter d'occhio! Come hai fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730512,
					"content": "Ah, una grande maga non svela i suoi segreti così facilmente. Rifatevi gli occhi dinanzi alla mia opera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730513
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730513,
					"content": "Avete appreso le basi del processo di intaglio, vero? Concentratevi su quello e lasciate a me i tocchi finali. Ve ne sono molto grata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730514
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730514,
					"content": "Va bene. Proviamoci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730515,
					"content": "Ma che...?! Questo è molto più difficile di quello che ci hai mostrato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730516,
					"content": "Mmm? Oh, scusa, scusa. Ho sbagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730517
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730517,
					"content": "Di questo dovevo occuparmene io. Il vostro è da questa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730518
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730518,
					"content": "Fiuu... Che sollievo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
