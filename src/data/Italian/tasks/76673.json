	"talks": [
		{
			"id": 7667301,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5461.151,
							198.892,
							9742.186
						],
						"pointId": 14953
					}
				]
			},
			"dialogs": [
				{
					"id": 766730101,
					"content": "#Mentre {F#la giovane}{M#il giovane} proseguiva, notò molte statue squisite che costellavano il territorio della maga. \"Cosa sono?\", chiese {F#perplessa}{M#perplesso}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730102
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730102,
					"content": "\"Questi sono tutti coloro che si sono opposti a me. Hanno sottovalutato il mio potere di maga, e perciò sono stati tramutati in pietra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730103
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730103,
					"content": "Mmm, non mi dispiace affatto. È stata un'aggiunta del momento, ma oserei dire che è stata una buona idea. Una maga dovrebbe essere una figura potente e pericolosa... Il pericolo conferisce un certo misticismo e, senza misticismo, il mondo sarebbe un posto davvero desolante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730104
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730104,
					"content": "(Ma pietrificare la gente così su due piedi... non è un po' esagerato? Nessuno vorrebbe avere a che fare con una persona così capricciosa... Ok, credo che mi darò una calmata e lo trasformerò in un vago avvertimento.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730105
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730105,
					"content": "#A queste parole, {F#la}{M#il} giovane iniziò a sudare freddo. Ma poi, la risata della maga ruppe il silenzio: \"Ahah... Ci sei {F#cascata}{M#cascato}? Stavo solo scherzando. Queste statue sono solo il mio modo di catturare un certo momento nel tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730106
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730106,
					"content": "Comunque, le statue. È per questo che mi serve il tuo aiuto. La loggia della maga sembra un po' vuota, e vorrei riempire lo spazio con altri adorabili compagni.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esamina"
				}
			]
		},
		{
			"id": 7667302,
			"completionStepIds": [
				7667302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667302",
							"2"
						],
						"stepId": 7667302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5482.98,
							194.651,
							9710.385
						],
						"pointId": 14939
					},
					{
						"sceneId": 3,
						"position": [
							5480.907,
							194.819,
							9712.115
						],
						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "#{F#La giovane}{M#Il giovane} rimase {F#incantata}{M#incantato} di fronte alla magnificenza e alla bellezza della maga. Dopo un lungo silenzio, dichiarò con fare solenne:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730202,
					"content": "\"O grande maga venuta da lontano, grandi sono la tua bellezza e la tua saggezza! Nel momento in cui ti ho visto, il mio cuore ha iniziato a palpitare. E tutto ciò che desidera ora è fare suoi i tuoi desideri.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730203,
					"content": "Un sorriso quasi impercettibile comparve sul volto della maga, che rispose: \"Molto bene. Allora ti affiderò il compito di compiere a nome mio determinate gesta che saranno alla tua portata. La tua guida è qui, e riceverai la tua ricompensa nei giorni a venire.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730204,
					"content": "Guida...? Intendi questa sfera luminosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "#\"Dimora segreta...\", disse {F#la}{M#il} giovane, con un'espressione confusa. \"Dov'è questa 'dimora segreta' di cui parli?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730302,
					"content": "La voce della maga si fece un po' agitata dopo aver sentito la sua domanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730303,
					"content": "(Aspetta, è sensato che come personaggio sia così modesto...? Ma sì, non importa... per ora lo lascio così. Il signor Nove potrà sempre perfezionarlo in seguito.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730304,
					"content": "#\"Ehm, è piuttosto scortese porre certe domande a una maga, {F#ragazza}{M#ragazzo}. La loggia della maga è in ristrutturazione. Presto, la sua grandiosità ti lascerà di stucco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730305,
					"content": "Questa sarà la tua prova. Offri la tua forza e aiuta questa grande maga a costruire il suo territorio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esamina"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "Ebbene, giovane. Adesso conosci i problemi che affliggono questa maga... Nicola Coco ha bisogno del tuo aiuto per realizzare il suo territorio sacro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730402,
					"content": "#La maga versò una tazza di tè per {F#la sua ospite}{M#il suo ospite}. \"Che cosa farai?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730403,
					"content": "Sarà un onore servirti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "Aspetta un attimo! Non dovremmo pensarci due volte prima di buttarci a capofitto? Non sappiamo nulla di questa persona. E poi sembra un po' strana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730406,
					"content": "Mmmh... Anche se, a dire il vero, questa tazza da tè sembra familiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730407,
					"content": "Ci sei arrivata, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "Nicola Coco... Ah! È... la maga \"N\"? Nicole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730410,
					"content": "Esatto. Che ve ne pare della mia storia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730411,
					"content": "Uhm... Difficile a dirsi. Non è ancora finita, vero? Cosa succederà ai personaggi alla fine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730412,
					"content": "Non ho ancora deciso. Prima devo ristrutturare casa. Magari dopo mi verrà l'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730413,
					"content": "Comunque, se sentite la mia voce, suppongo che siate a Nod-Krai. In tal caso, potrei chiedervi di raccogliere alcune cose per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730414,
					"content": "Che cosa, esattamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "Beh, vorrei realizzare qualche altra statua per decorare casa mia, ma al momento mi manca l'ispirazione. Pensavo che potreste scattare delle foto per darmi qualche idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730418,
					"content": "Dici sul serio...? Va bene. Lascia fare a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730419,
					"content": "Aspetta qui. Andremo a vedere cosa riusciamo a trovare. Ma ricordati di finire la storia una volta completate le statue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730416,
					"content": "C'entra qualcosa con le statue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "Esatto. Sto pensando di realizzare qualche altra statua per decorare casa mia, ma al momento mi manca l'ispirazione. Quindi, pensavo che potresti scattare delle foto per darmi qualche idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730408,
					"content": "È qualcuno che conosciamo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730404,
					"content": "Ai tuoi ordini, grande maga Nicola Coco!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				}
			]
		},
