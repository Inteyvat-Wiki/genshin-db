			"dialogs": [
				{
					"id": 766730601,
					"content": "Mmm, la storia della maga sta iniziando a prendere forma. Credo che delegherò la prossima sezione al signor Nove.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730602
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730602,
					"content": "Una grande maga si definisce soprattutto per la sua bellezza e la sua potente presenza. Forse una risata esagerata potrebbe aiutarla a distinguersi di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730603
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730603,
					"content": "\"Ohohohoh! Sembra che qualcuno sia rimasto ammaliato dal potere della Grande Maga eterna!\" È troppo fastidiosa questa risata? No, non importa. Tanto è solo per iscritto. Nessuno la sentirà ad alta voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730604
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730604,
					"content": "Il mio piano di ristrutturazione è completo... Ma da dove inizio? Tutti sanno che non si può evocare una casa dal nulla. Mmh... O forse sì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730605
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730605,
					"content": "L'alchimia potrebbe funzionare. Le uniche materie prime di cui ho bisogno sono blocchi e legno... Sì, farò così. Molto più facile che costruire tutto a mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730606
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730606,
					"content": "La casa di una maga deve avere un aspetto molto diverso da una casa comune. Solo che non so bene cosa significhi in pratica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730607
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730607,
					"content": "Una cosa è certa, però: deve essere un luogo antico, misterioso e ultraterreno, in grado di resistere per centinaia, anzi, migliaia di anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730608
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730608,
					"content": "Sì, perfetto. È proprio ciò che la gente si aspetta da una maga. Anche se, a dire il vero, non sono tanto io a catturare gli attimi nel tempo, quanto gli attimi nel tempo ad aver catturato me... Ahahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730609
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730609,
					"content": "#Beh, non restate lì {F#impalate}{M#impalati}! Andate e completate l'incarico assegnatovi dalla grande maga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730610
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730610,
					"content": "E ricordate, non voglio vedere niente di noioso e monotono. Ho bisogno di foto piene di vita, così da poter catturare l'anima e il carattere del soggetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730611
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730611,
					"content": "Non pensate che scolpire una statua sia solo una questione di forme e proporzioni. La cosa più importante è catturare lo spirito del soggetto nel momento in cui viene scattata la foto... Bene. Tutto chiaro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730612
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730612,
					"content": "",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						766730613
					]
				},
				{
					"id": 766730613,
					"content": "\"Ohohohoh! Sembra che qualcuno sia rimasto ammaliato dal potere della Grande Maga eterna!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730614
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730614,
					"content": "È troppo fastidiosa questa risata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730615
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730615,
					"content": "No, non importa. Tanto è solo per iscritto. Nessuno la sentirà ad alta voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730616
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730616,
					"content": "Sì, perfetto. È proprio ciò che la gente si aspetta da una maga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730617
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730617,
					"content": "Anche se, a dire il vero, non sono tanto io a catturare gli attimi nel tempo, quanto gli attimi nel tempo ad aver catturato me... Ahahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
