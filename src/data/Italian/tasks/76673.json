						766730903
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730903,
					"content": "Ah, sei troppo gentile! Comunque, come facciamo a darti le foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730904,
					"content": "Potete tenerle per ora. Sarò lì tra un paio di giorni, potremo parlare di più delle statue allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 766730905,
					"content": "Certo. Ci vediamo tra un paio di giorni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
