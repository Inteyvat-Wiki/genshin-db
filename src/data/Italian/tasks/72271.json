			"dialogs": [
				{
					"id": 722710201,
					"content": "Riguardo alla Sfera d'osso di drago...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710202
					]
				},
				{
					"id": 722710202,
					"content": "Oh, ci hai pensato su?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710203,
					"content": "Lo prenderò per 80.000 Mora e 5 Anni dell'abbondanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710204,
						722710207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710204,
					"content": "È tutta tua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710205
					]
				},
				{
					"id": 722710205,
					"content": "Grazie per averci scelto. Ecco i tuoi Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710206,
					"content": "Se trovi altri tesori del genere, noi siamo sempre pronti ad aiutarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710207,
					"content": "Ci devo pensare ancora un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710208
					]
				},
				{
					"id": 722710208,
					"content": "Nessun problema. Dopotutto, bisognerebbe sempre controllare i prezzi sul mercato, quando si pensa di vendere delle reliquie preziose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710209,
					"content": "Potrai tornare da me dopo che ci avrai riflettuto su.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		}
	]
