			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "Vorrei vendere dei tesori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "Oh, quali oggetti rari hai trovato questa volta? Fammi dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710104,
					"content": "Racconti a Linlang della Sfera d'osso di drago.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "Se quello che dici è vero, questa è una reliquia davvero straordinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710106,
					"content": "Ma, dopo averle dato una rapida occhiata, non riesco a trovarci nulla di particolarmente speciale. Forse occorre usarla per un lungo periodo affinché i suoi poteri si rivelino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710107,
					"content": "A mio parere, sembra che le proprietà meravigliose che le hai attribuito siano un po'... eccessive. Forse, è semplicemente qualcosa che ti è stato affidato da chi ha fallito il suo compito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710108,
					"content": "Non prendertela, però. Sto solo dicendo quello che penso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710122,
					"content": "Capita spesso nel nostro lavoro, comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710109,
					"content": "Inoltre, credo che tu non l'abbia conservata in un contenitore sigillato: la superficie sembra già un po' consumata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710110,
					"content": "Temo che dovrò abbassare il prezzo per questo motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710123,
					"content": "Che ne dici di 80.000 Mora? Posso aggiungere 5 Anni dell'abbondanza come piatti speciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710111,
					"content": "Credo che questo sia un prezzo ragionevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710112,
					"content": "...Cosa ci farai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "A dire la verità, credo che la storia che c'è dietro sia più interessante delle sue abilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710114,
					"content": "Credo che un oggetto del genere possa essere d'interesse per i nostri cantastorie e per le compagnie d'opera, o forse per i grandi uomini e donne del Belvedere di Yujing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710115,
					"content": "Rimane comunque un pezzo da esposizione molto antico, anche se dovessi semplicemente metterla sul bancone del nostro negozio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710116,
					"content": "D'accordo, è un prezzo ragionevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "Caspita, la schiettezza deve essere il tuo forte. Bene allora, ecco i tuoi Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710118,
					"content": "Se trovi altri tesori del genere, noi siamo sempre pronti ad aiutarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710119,
					"content": "Fammici pensare ancora un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "Nessun problema. Dopotutto, bisognerebbe sempre controllare la merce... volevo dire, i prezzi sul mercato, quando si pensa di vendere delle reliquie preziose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710121,
					"content": "Potrai tornare da me dopo che ci avrai riflettuto su.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
		{
