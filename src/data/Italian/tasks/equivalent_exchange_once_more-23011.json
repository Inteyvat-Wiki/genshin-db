				},
				{
					"id": 230110502,
					"content": "A proposito della legna di Viktor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110503
					]
				},
				{
					"id": 230110503,
					"content": "Questa legna... Hai scacciato via tutti i mostri? Sei più forte di quanto sembri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110504
