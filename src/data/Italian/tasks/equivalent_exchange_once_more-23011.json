			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "Mmh... Non ricordo come dovrebbe essere questa scultura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110102,
					"content": "Ciao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "Uff, chi va là? Non mi seccare, io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110105,
					"content": "#Eh?! Viaggiat{F#rice}{M#ore}?! Cosa ci fai a Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110106,
					"content": "Andiamo, Rudolf non può averti mandato a picchiarmi, vero? Ho solo inviato un regalino a Lily tempo fa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110107,
					"content": "Sono solo di passaggio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "Oh, quindi sei ancora in viaggio. Non ti fermi mai, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110112,
					"content": "Davvero, però... Non mi aspettavo di vederti qui a Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110113,
					"content": "Inizialmente avevo ricevuto l'ordine di trasferirmi da Mondstadt a Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110114,
					"content": "Ma poi è arrivato un altro ordine e sono stato mandato alla Città di Sumeru per assistere il signor Vsevolod. Inoltre, mi avevano detto che sarei stato trasferito sotto il comando del signor Pulcinella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110115,
					"content": "Pulcinella?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "Sì... Anzi, no. Meglio che mi fermi qui, altrimenti il signor Vsevolod potrebbe criticare la mia insensibilità nei confronti di questioni riservate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110118,
					"content": "*sospira* I nomi dei nostri Messaggeri non sono un segreto. Non capisco perché sia così ansioso al riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110119,
					"content": "Allora, di cosa ti occupi qui a Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "Io e il signor Vsevolod ci occupiamo principalmente del supporto logistico e del coordinamento. In poche parole, andiamo spesso a fare acquisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110121,
					"content": "Sembra una cosa da poco, ma è sicuramente meglio che oziare nella Cattedrale di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110122,
					"content": "Eheh, il mio attuale lavoro implica anche parecchio tempo libero, e nessuno mi tiene d'occhio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110123,
					"content": "Così ho ripreso il mio hobby d'infanzia di realizzare sculture di legno. E si dà il caso che a Sumeru ci sia molto legno. L'ideale per fare pratica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110124,
					"content": "E poi, le mie sculture di legno sono molto amate dai bambini. Mi hanno tartassato per averle, così ho promesso loro di farne una per ciascuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110125,
					"content": "Non sei un Fatuus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "E allora? Voglio dire... Chi dice che un Fatuus non possa realizzare giocattoli per bambini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110127,
					"content": "E poi, io sono solo l'addetto ai rifornimenti. Per quanto riguarda tutti gli affari importanti, li lascio ai Messaggeri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110130,
					"content": "Alla fine, la realtà è questa: non sono potuto tornare a Snezhnaya, ma Sumeru mi piace. Qui c'è cibo, divertimento e un bell'ambiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110131,
					"content": "Quando finisco di lavorare, prendo qualcosa da mangiare e cerco un bel posto al sole per fare qualche scultura di legno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110132,
					"content": "Tuttavia... Ahah, tutti mi guardano in modo scettico, proprio come te quando abbiamo parlato la prima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110133,
					"content": "Ma non posso farci niente. Sono un Fatuus, d'altronde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110134,
					"content": "Non mi fido ancora di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "Ok... Fondamentalmente, sono piuttosto soddisfatto della mia vita ora, e sono anche riuscito a risparmiare qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110137,
					"content": "Se la situazione continuerà così, potrei stabilirmi qui a Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110138,
					"content": "#Ehm, beh, basta così. Ora che sei qui anche tu, viaggiat{F#rice}{M#ore}, continuiamo con il nostro \"scambio equo\", se sei d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110139,
					"content": "Ma ho finito le storie, quindi questa volta ti darò soldi veri come ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110140,
					"content": "Beh, è anche meglio per me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "Va bene, lascia che ti spieghi l'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110144,
					"content": "Di recente ho ordinato del legno da Hamawi, ma non è ancora stato consegnato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110145,
					"content": "Non posso andare a parlargli durante l'orario di lavoro, altrimenti il signor Vsevolod mi rimprovererà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110146,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti farmi un favore e chiedere a Hamawi riguardo alla consegna del legno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110147,
					"content": "Prepara la mia ricompensa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "Non temere: non ti deluderò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110151,
					"content": "#Ti lascio al tuo incarico, allora, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110149,
					"content": "Sei sicuro di non star tramando nulla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "Dai, quando mai ho giocato sporco nei nostri scambi? Non preoccuparti, a ogni modo non ne ho voglia... Cosa c'è di male nel volere una normale vita tranquilla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110141,
					"content": "Dovrei accettare un incarico dei Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "Certo che no: svolgerai semplicemente un incarico per Viktor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110135,
					"content": "Chi ha detto che mi fido di te? Smettila di fare il ruffiano!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "Non starai mica cercando di estorcere informazioni ai bambini... vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "Cosa? Non lo farei mai! Perché avete tutti questo orribile stereotipo su noi Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110116,
					"content": "Un altro Messaggero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "Già, torna a Mondstadt con me!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "Ahahah, certo. Vorresti anche delle manette con cui portarmi via, già che ci sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110111,
					"content": "Ok, basta scherzare. Ho delle faccende da sbrigare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110103,
					"content": "V-Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
