			"dialogs": [
				{
					"id": 230110601,
					"content": "Com'è andata? La mia legna è arrivata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110602,
					"content": "Racconti a Viktor cos'è successo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "Ancora mostri? È una mia impressione, o davvero ogni carro al mondo viene attaccato da mostri...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110604,
					"content": "Non fa niente, finché la mia legna arriva qui, va tutto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110605,
					"content": "Oh, giusto: ecco il compenso che ti avevo promesso. Se vuoi, controlla che sia corretto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110606,
					"content": "Ehm, comunque sia... Lily sta bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110607,
					"content": "Non l'ho salutata prima di andarmene. Spero non sia arrabbiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110608,
					"content": "Sta molto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "D'accordo. *tossisce*... Dai, non guardarmi in quel modo. Ero solo un po' preoccupato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110614,
					"content": "#A ogni modo, ecco il tuo compenso. Controlla che sia tutto. Ho preparato la cifra esatta, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110610,
					"content": "Vai lì a farle visita tu stesso, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "Il signor Vsevolod mi prenderà a calci nel sedere se lo faccio, quindi puoi scordartelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110612,
					"content": "Non oso nemmeno inviarle direttamente una lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110613,
					"content": "D'altronde, ricevere una lettera da un Fatuus sembra proprio una brutta cosa. Ahahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				}
			]
