			"dialogs": [
				{
					"id": 230110301,
					"content": "Che terribile sfortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110302,
					"content": "A proposito della consegna di legno di Viktor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "Parli della legna che ha ordinato il Fatuus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110304,
					"content": "*sospira* Sapevo che a fare affari con i Fatui non sarebbe andata a finire bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110305,
					"content": "Mentre trasportavamo la legna, siamo stati attaccati dai mostri. Siamo tornati tutti vivi, ma il carro è andato perso. Siamo stati costretti a lasciare la legna lungo la strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110306,
					"content": "Non ho il coraggio di andarci, e non riesco neanche a trovare qualcuno che si sbarazzi così in fretta di tutti quei mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110308,
					"content": "Noi non siamo Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "#Quindi non sei {F#una}{M#un} Fatuus? Allora perché lo stai aiutando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110310,
					"content": "Comunque, non posso far altro che lasciare lì il mio carro e cercare di ingaggiare qualcuno che si occupi della faccenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110311,
					"content": "Se hai fretta di prendere il legno, ti indicherò sulla mappa la posizione approssimativa del carro, così potrai andare a dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110312,
					"content": "*sospira* Se sono coinvolti i Fatui, non succede mai nulla di buono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hamawi"
				}
			]
