						746560103
					],
					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560103,
					"content": "La statue sono poesie senza parole, nessuno dovrebbe apprezzarle a stomaco vuoto. Me l'ha detto un duellante durante l'ultimo duello della sua vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560106,
						746560104
					],
					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560106,
					"content": "I Bulle sono pronti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746560104,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560105
					]
				},
				{
					"id": 746560105,
					"content": "Ho anche fatto come consigliato e ho messo da parte dei Mora per ringraziarti per il Bulle. Immagino di dover aspettare a darteli finché non avrai trovato la frutta...",
