					"nextDialogs": [
						746560102
					]
				},
				{
					"id": 746560102,
					"content": "#Ah, {F#mia giovane amica}{M#mio giovane amico}, hai portato dei Bulle? Condividili con me e mangiamoli mentre parliamo.",
