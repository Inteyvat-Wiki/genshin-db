						"pointId": 7018
					},
					{
						"sceneId": 3,
						"position": [
							2406.821,
							313.167,
							3522.008
						],
						"pointId": 7019
					},
					{
						"sceneId": 3,
						"position": [
							2409.902,
							313.167,
							3521.11
						],
						"pointId": 7020
					}
				]
			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "Ho una vaga idea riguardo alla \"goccia primordiale\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760402,
					"content": "Sembra si riferisca alla prima goccia d'acqua piovana caduta a seguito della creazione del mondo. Credo sia l'idea a cui aderivano sia l'antica Fontaine che l'Ordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760403,
					"content": "Ma dove dovremmo trovare una cosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760404,
					"content": "Beh, quella prima goccia ormai è parte dell'acqua di Teyvat. In un certo senso, ogni goccia d'acqua può essere considerata la \"goccia primordiale\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760405,
					"content": "È come se il dio originario avesse esteso un potenziale di grandezza. Un elemento divino che si trova nel corpo di ogni singola persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760406,
					"content": "Ma, se fosse così semplice, quello che ci ha preceduti non avrebbe avuto alcun problema a offrire la risposta giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760407,
					"content": "Giusta osservazione. Probabilmente mi sbaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760408,
					"content": "Beh, anche se è la risposta errata, è una bella risposta. Posso solo dedurre che la persona che ha concepito questi enigmi avesse una concezione piuttosto carente del romanticismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760409,
					"content": "E ora starà ridendo di te perché non capisci come funziona la sicurezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760410,
					"content": "Risposta impossibile. La mia ricerca per \"goccia primordiale\" ha fornito milleduecento risultati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760411,
					"content": "\"Secondo la leggenda, la prima goccia di vino al mondo apparve quando il Dio di Anemo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760412,
					"content": "Va bene, puoi anche non proseguire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "Ricevuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760416,
					"content": "A tal proposito... credo di avere qualcosa da dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760417,
					"content": "C'è una leggenda secondo cui le Oceanidi siano nate dalla prima lacrima versata dalla precedente Archon di Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760418,
					"content": "E che la prima lacrima versata sulla terra fosse della prima Oceanide dopo aver scoperto l'umanità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760419,
					"content": "Non sarebbe più sensato se la prima lacrima fosse stata del primo neonato umano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760420,
					"content": "Le lacrime degli animali sono in realtà secrezioni saline; e, in tempo di pace, gli umani venivano alla luce ridendo di gioia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760421,
					"content": "O almeno, questo è ciò che affermano le leggende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760422,
					"content": "Io sono dell'opinione che tanto il pianto dei neonati quanto le secrezioni saline animali siano considerabili comportamenti ugualmente privi di emozione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760423,
					"content": "I neonati piangono a causa di stimoli esterni al fine di riempire i polmoni d'aria nel modo più rapido possibile, stando a quanto affermano i testi dell'Amurta di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760424,
					"content": "Allora la risposta è \"Oceanide\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760425,
					"content": "Potrebbe essere la risposta che la persona che ci ha preceduti non ha fornito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760426,
					"content": "Onestamente, credo che ormai sia una perdita di tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "In realtà, Paimon pensa che sia la pista giusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760430,
					"content": "In base a ciò che so sull'Ordo Narzissenkreuz, è una conclusione logica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760431,
					"content": "L'Imperatrice Vermiglia che sogna in un luogo ignoto, il sognatore che non dice mai ciò che pensa davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760432,
					"content": "Questo è ancora più sconclusionato degli enigmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760433,
					"content": "Beh, ha importanza? Siamo già alla congiuntura finale. La risposta verrà alla luce, qualunque essa sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760434,
					"content": "Bene. Fa' pure ciò che devi, Ann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "Certo, farò un tentativo. Se però non va a buon fine, spero per voi che abbiate già pronta qualche altra risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760436,
					"content": "Si è aperta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760437,
					"content": "Dobbiamo recuperare l'ultimo frammento, o la Spada sacra cadrà nelle mani dell'Ordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760428,
					"content": "Credo che siamo sulla pista giusta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "Di sicuro, meglio che mettersi a cercare il vino del Dio di Anemo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760414,
					"content": "Vale la pena fare un tentativo. Andiamo a Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "Sarà anche una causa persa, ma cerchiamo almeno di seguire una pista giusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
