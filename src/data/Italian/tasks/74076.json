			"dialogs": [
				{
					"id": 740760301,
					"content": "Questo è l'ultimo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760302
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760302,
					"content": "La nostra ricerca è stata un buco nell'acqua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760303,
					"content": "Vero. Ma quest'entrata è chiusa, il che vuol dire che abbiamo ancora una possibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760304
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760304,
					"content": "A quanto pare, il nostro avversario non ha risolto questo enigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760305
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760305,
					"content": "A parte questo... chi sarebbe il nostro avversario, di grazia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760306,
					"content": "Ammesso che l'Ordo Narzissenkreuz sia rimasto immobile per secoli, e che ciò che sapevo sul suo conto sia valido ancora oggi, mettendo insieme gli eventi che sono accaduti finora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760307
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760307,
					"content": "Temo che si tratti di Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760308
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760308,
					"content": "Quel babbeo che voleva litigare con Seymour? Cos'ha a che fare con tutta questa storia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760309
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760309,
					"content": "Ho paura che il suo intento sia identico al nostro: vuole trovare i materiali necessari per forgiare la Spada sacra di Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760310
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760310,
					"content": "L'Ordo è riuscito a riprodurre le quattro ipotetiche sostanze necessarie qui nel mondo materiale, sulla base delle filosofie esoteriche del regno sotterraneo e dell'antica Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760311
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760311,
					"content": "Non capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760312,
					"content": "Si tratta di sostanze misteriose basate sull'esperienza. Si potrebbe dire che, a paragone con il potere elementale, vanno ancora più al di là del senso comune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760313
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760313,
					"content": "Decenni fa, ho immesso nei miei banchi di memoria tutti i libri di testo della Spantamad dell'Akademiya, dal livello introduttivo a quello intermedio. Non c'è niente di misterioso circa il potere elementale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760314,
					"content": "Ma davvero? Comunque, ricapitolando, è il prodotto di una confluenza tra le tradizioni di Fontaine e la tecnologia del regno sotterraneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760315
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760315,
					"content": "Secondo queste ultime, il creato è composto da quattro tipi di sostanze: memoria, speranza, spirito e carattere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760316
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760316,
					"content": "Per evitare ambiguità, li chiameremo blocco della memoria, blocco della speranza, blocco dello spirito e blocco del carattere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760317
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760317,
					"content": "Perché si usano queste cose per creare la Spada sacra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760318,
					"content": "Nella versione della filosofia mistica propria dell'Ordo Narzissenkreuz, il tempio è un microcosmo dell'universo, i suoi membri sono sostituti degli dèi, e l'olio sacro è la forza di volontà temprata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760319
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760319,
					"content": "La Spada sacra, invece, è la \"ragione\", colei che apre ogni cosa con la forza. Può nascere solo dalla consumata volontà umana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760320
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760320,
					"content": "Un concetto decisamente astruso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760321
					]
				},
				{
					"id": 740760321,
					"content": "L'esoterismo è questo, alla fine. Ci si attacca a qualunque cosa risulti sufficientemente simile; e, quando questo genere di cose assume connotati magici, ciò che è fittizio diventa reale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760322
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760322,
					"content": "A ogni modo, il nostro avversario non ha ancora risolto l'enigma. O, se l'ha fatto, non è riuscito a fornire la risposta giusta. E se si tratta di Jakob, penso che si tratti del secondo caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760323
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760323,
					"content": "Questa iscrizione recita così: \"In unione perpetua\"... \"Nato in un istante, in frequente contraddizione, ti accompagno nell'eterno riposo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760324
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760324,
					"content": "E l'ultimo verso è \"la goccia primordiale\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760325,
					"content": "Le zone in cui siamo già stati avevano tutte enigmi simili. Vi ricordate ancora quali erano le risposte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760326
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760326,
					"content": "\"Ombra\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760327
					]
				},
				{
					"id": 740760327,
					"content": "\"Vita\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760328
					]
				},
				{
					"id": 740760328,
					"content": "\"Amore\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760329
					]
				},
				{
					"id": 740760329,
					"content": "Uff, le risposte continuano a diventare sempre più astratte, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760330,
					"content": "Caterpillar, Seymour, voi conoscete la risposta a questo enigma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7407604,
			"completionStepIds": [
				7407602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7407602",
							"2"
						],
						"stepId": 7407602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Caterpillar",
					"Seymour",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2407.463,
							313.167,
							3522.037
						],
						"pointId": 7016
					},
					{
						"sceneId": 3,
						"position": [
							2405.367,
							313.317,
							3521.646
						],
						"pointId": 7017
					},
					{
						"sceneId": 3,
						"position": [
							2408.104,
							313.167,
							3520.139
