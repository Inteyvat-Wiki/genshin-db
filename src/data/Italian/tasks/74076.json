			"dialogs": [
				{
					"id": 740760201,
					"content": "Questo è l'ultimo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760202
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760202,
					"content": "La nostra ricerca è stata un buco nell'acqua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760203,
					"content": "Purtroppo no, ma quest'entrata è chiusa, il che vuol dire che abbiamo ancora una possibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760204
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760204,
					"content": "A quanto pare, il nostro avversario non ha risolto questo indovinello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760205
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760205,
					"content": "Questa iscrizione recita così: \"In unione perpetua\"... \"Nato in un istante, in frequente contraddizione, ti accompagno nell'eterno riposo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760206
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760206,
					"content": "E l'ultimo verso è \"la goccia primordiale\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760207,
					"content": "Le zone in cui siamo già stati avevano tutte enigmi simili. Vi ricordate ancora quali erano le risposte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760208
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760208,
					"content": "\"Ombra\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760209
					]
				},
				{
					"id": 740760209,
					"content": "\"Vita\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760210
					]
				},
				{
					"id": 740760210,
					"content": "\"Amore\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760211
					]
				},
				{
					"id": 740760211,
					"content": "Uff, non credete che le risposte diventino sempre più astratte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760212,
					"content": "Caterpillar, Seymour, voi conoscete la risposta a questo enigma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
