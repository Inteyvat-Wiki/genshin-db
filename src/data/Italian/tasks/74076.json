						],
						"pointId": 7025
					}
				]
			},
			"dialogs": [
				{
					"id": 740760501,
					"content": "Quello là è il frammento di \"Personalità\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760502,
					"content": "Impossibile analizzare la densità della sostanza di fronte a noi. Sembra avere una massa pari a... zero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760503,
					"content": "A quanto pare abbiamo trovato l'ultimo frammento. Se non altro, ora avremo modo di contrattare con i nostri avversari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760504,
					"content": "La cosa positiva è che adesso siamo in grado di impedire all'Ordo Narzissenkreuz di forgiare la Spada sacra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760505,
					"content": "Non direi, Paimon. Il nostro intento è di forgiare la Spada sacra prima di loro, e usarla per sventare il loro piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760506,
					"content": "Ovviamente non ho dimenticato cosa significa questa spada per te, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760507,
					"content": "Una Spada sacra in grado di fendere la volontà è anche la chiave per dipanare il mistero. Per me, in realtà, è ugualmente importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760508,
					"content": "Il fatto è che abbiamo faccende più pressanti di cui occuparci. Vi dispiacerebbe se rimandassimo a dopo la ricerca delle risposte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760509
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760509,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760510
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760510,
					"content": "#In tal caso, {NICKNAME}, prendi pure questa \"Personalità\" con te, se vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		}
	]
