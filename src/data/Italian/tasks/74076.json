			"dialogs": [
				{
					"id": 740760101,
					"content": "Questo è l'ultimo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760102,
					"content": "Almeno c'è ancora il sigillo all'entrata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760103,
					"content": "A quanto pare, Jakob non ha risposto a questo enigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760104,
					"content": "Forse ha dato una risposta, ma non era quella giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760105,
					"content": "Uhm... Le risposte precedenti erano \"ombra\", \"vita\" e \"amore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760106,
					"content": "Seguendo il medesimo schema, il mio modulo logico ha ipotizzato che l'iscrizione sulla tavoletta sia il seguente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760107,
					"content": "\"In unione perpetua\"... \"Nato in un istante, in frequente contraddizione, ti accompagno nell'eterno riposo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760108,
					"content": "L'ultimo verso è \"la goccia primordiale\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760109,
					"content": "Caterpillar, Seymour, voi conoscete la risposta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
