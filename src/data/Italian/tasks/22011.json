	"talks": [
		{
			"id": 2201101,
			"completionStepIds": [
				2201101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201101",
							"2"
						],
						"stepId": 2201101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "Uff... chi diamine sta diffondendo queste voci...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110102,
					"content": "Quali voci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "Le voci sugli omikuji del Santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110104,
					"content": "Sai cosa sono gli omikuji, vero? In parole povere, vengono utilizzati per predire il futuro tramite estrazioni a sorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110105,
					"content": "La scritta sul foglietto predice delle cose sul tuo futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110106,
					"content": "Se è un foglietto fortunato, buon per te. Se è un foglietto sfortunato, però, la gente tende a lasciarlo al Santuario per sbarazzarsi della sfortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110107,
					"content": "Ma... si è in qualche modo diffusa la voce che se si lanciano i foglietti sfortunati in cima all'albero, l'Archon allontanerà la sfortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110108,
					"content": "La cosa più divertente è che alcuni pensano che più in alto lo si lancia, più velocemente arriverà la fortuna e più velocemente scomparirà la sfortuna. Che assurdità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110109,
					"content": "Man mano che si sono diffuse voci sempre più assurde, le persone hanno iniziato a lanciare sull'albero anche i Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110110,
					"content": "Si dice che se i Mora che hai lanciato si incastrano nei rami, allora la tua preghiera è stata ascoltata. Non solo il tuo desiderio si avvererà, ma ti porterà fortuna per un anno intero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110111,
					"content": "È così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "Certo che no! Tralasciando il fatto che le preghiere individuali possano essere ascoltate o meno... lanciare i Mora è decisamente inappropriato. E poi, i Mora sembrano tutti uguali, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110113,
					"content": "Pensano che l'Archon raccolga i Mora uno per uno per capire di chi sono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110116,
					"content": "Capisco che vogliano pregare per ricevere benedizioni, ma... lanciare cose lassù non è la soluzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110117,
					"content": "E poi, quando il vento si alza, cade tutto a terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110118,
					"content": "Ho provato a ripulire l'albero da sola, ma non sono una persona molto atletica. Non solo non sono riuscita nell'impresa, ma sono anche rimasta bloccata lassù per un bel po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110119,
					"content": "#Ma non posso lasciarlo in quelle condizioni... Viaggiat{F#rice}{M#ore}, potresti aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110120,
					"content": "Nessun problema, ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "#Bene, allora conto su di te, viaggiat{F#rice}{M#ore}. Vai sul tetto e dagli una ripulita, e se trovi degli omikuji, portameli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110122,
					"content": "Cosa ne farai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "Beh... La signorina Hotomi dice che gli omikuji rappresentano il desiderio della gente di conoscere il proprio futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110124,
					"content": "Sarebbe scorretto gettarli via. Quindi, una volta raccolti, li rimetterò al loro posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110125,
					"content": "*sospira* Se tutti avessero rispettato le regole fin dall'inizio, non avremmo tutti questi problemi ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110126,
					"content": "#Bene, allora conto su di te, viaggiat{F#rice}{M#ore}. Vai sul tetto e dagli una ripulita, e se trovi degli omikuji, portameli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110114,
					"content": "Non possiamo semplicemente fare un po' di chiarezza sulla questione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "Non penso di riuscire a convincere tutte quelle persone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				}
			]
		},
