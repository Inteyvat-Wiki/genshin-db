			"dialogs": [
				{
					"id": 230070201,
					"content": "Mi sono venute in mente alcune soluzioni e ho intenzione di trovare della terra intrisa di bava di Melmoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070202,
					"content": "Ho scoperto un posto dove si radunano i Melmosi. Puoi andare lì e procurarmi della terra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070203,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070204
					]
				},
				{
					"id": 230070204,
					"content": "Conto su di te, allora. Non importa se fai fuori quei Melmosi, basta che mi procuri un po' di quella terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070205
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070205,
					"content": "Ecco, ti segno la posizione sulla mappa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070206,
					"content": "Non vieni anche tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070207
					]
				},
				{
					"id": 230070207,
					"content": "Mi piacerebbe, ma ho ancora dei lavori da sbrigare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070208
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070208,
					"content": "Non preoccuparti: sarò ben disposto a ricompensarti. Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070209
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070209,
					"content": "Ti segno la posizione sulla mappa, basta che tu vada lì e cerchi la terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070210
					],
					"speakerTitle": "Akim"
