				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230070101,
					"content": "Chissà se c'è un materiale migliore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070102,
					"content": "Quale materiale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "Scusa, stavo parlando di nuovo fra me e me. Il tempo instabile sta danneggiando le case. Non sono mai stato così impegnato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070104,
					"content": "Non sei un vasaio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "Sì, ma sono anche un muratore. In entrambi i casi tutto ruota intorno alla terra, non c'è molta differenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070106,
					"content": "Conosci questo detto? \"Imparare è come costruire una casa. Se vuoi costruirne una alta, devi gettare solide fondamenta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070107,
					"content": "\"E se vuoi ampliare le tue conoscenze, devi assicurarti che le tue fondamenta siano solide. Se le fondamenta sono instabili, tutto crollerà...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070108,
					"content": "Quei superiori intelligenti dicono sempre così. Non mi è molto chiaro, ma sembra che per loro costruire case sia importante tanto quanto imparare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070109,
					"content": "È solo una metafora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "In ogni caso, quando si pensa alle fondamenta di una casa, si pensa ai materiali da costruzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070112,
					"content": "La terra è il materiale legante e di supporto, quindi se si riesce a migliorarne la stabilità e la duttilità, le case saranno più resistenti. E io non dovrò più essere così impegnato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070110,
					"content": "Non credo che tu l'abbia interpretato nel modo giusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
