			"dialogs": [
				{
					"id": 230070301,
					"content": "Mi sono venute in mente alcune soluzioni e ho intenzione di trovare della terra che sia costantemente esposta alle creature elementali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070302,
					"content": "I Malefiori sarebbero un'ottima opzione: è molto probabile che la terra su cui crescono queste creature abbia delle caratteristiche peculiari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070303
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070303,
					"content": "Ma io sono solo un muratore, e non credo che colpire dei Malefiori con un mattone mi aiuterà a procurarmi quella terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070304,
					"content": "#Pertanto, viaggiat{F#rice}{M#ore}, potresti darmi una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070305,
						230070308
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070305,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070306
					]
				},
				{
					"id": 230070306,
					"content": "Grazie. E ricordati che ciò che stiamo cercando è la terra su cui crescono i Malefiori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070307,
					"content": "Conosco un posto in cui compaiono i Malefiori, o perlomeno così si dice in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070308,
					"content": "Non vieni anche tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070309
					]
				},
				{
					"id": 230070309,
