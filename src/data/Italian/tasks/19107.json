				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "Ottimo lavoro, continua così. Potremo sicuramente assumere Diona come barista fissa qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079802,
					"content": "Spero che funzioni. Ho aspettato quest'occasione per settimane... Non dobbiamo lasciare che quest'opportunità vada sprecata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079803,
					"content": "Questa volta ti sei davvero superato, Connor. Fintanto che riusciremo a convincere Diona a lavorare qui, tutto il nostro duro lavoro sarà ripagato. Questo è solo il primo passo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079804,
					"content": "Ricorda: Diona deve sentire la nostra sincerità e la nostra passione! Oh... e cerca di non esagerare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079805,
					"content": "Nessun problema. Ne abbiamo già parlato molte volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079806,
					"content": "Di che cosa state parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "Eh?! Oh, eheh... di niente. Stiamo solo, ehm... Stiamo solo discutendo di questioni d'affari di un'azienda vinicola, sì... Ahahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079808,
					"content": "S-Sì, stiamo parlando di affari. Riesaminiamo i recenti costi di mantenimento dell'azienda vinicola... Va bene, Elzer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
		},
