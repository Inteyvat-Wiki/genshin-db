				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "Una pioggia di fuoco biologica... Aspetta, e se fosse veramente come narrano le leggende? I vulcani si evolvono e si riproducono come creature viventi, trasformando tutto ciò che li circonda in altri vulcani? Oh, no, no, no! Sarebbe una catastrofe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310102,
					"content": "I vulcani non funzionano così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "Giusto, giusto. Niente magma, niente vulcano. Non possono spuntare così dal nulla. Se così fosse, quest'area sarebbe stata dichiarata zona pericolosa secoli fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310105,
					"content": "Ma... e se la leggenda fosse vera? Oh, se solo quella Fotokamera funzionasse davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310106,
					"content": "Aspetta! E se la Fotokamera s'inceppasse e non scattasse foto? Sarebbe un disastro! No, devo controllare tutto personalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310103,
					"content": "Ops, chiedo scusa per l'interruzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "Va bene, ciao... Un secondo, c'è qualcos'altro che non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513105",
							"3"
						],
						"stepId": 7513105,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "Quindi la pioggia di fuoco biologico sono in realtà i pinguini Solcafiamme che cadono giù dal cielo? Ah, non c'è da stupirsi che colpiscano un territorio ben più vasto di una normale eruzione vulcanica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310202,
					"content": "Oh, no! E se mi cadesse uno di quei pinguini sulla casa? Devo escogitare un piano per metterla in sicurezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310203,
					"content": "Ma è un'eventualità rara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "Sì, sì, quei pinguini Solcafiamme arrivano così in alto solo a causa delle eruzioni vulcaniche. La mia casa non è neanche lontanamente vicina a un vulcano, quindi direi di essere al sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310205,
					"content": "Ma... E se... E se un giorno ci fosse un'enorme eruzione? Come ci si mette al riparo? Uff, no, devo proprio escogitare un piano d'emergenza... Non si sa mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310206,
					"content": "Ops, chiedo scusa per l'interruzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "#{F#Tranquilla}{M#Tranquillo}, non interrompi niente... Comunque, iniziamo dal rinforzare il tetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513103,
			"completionStepIds": [
				7513106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513106",
