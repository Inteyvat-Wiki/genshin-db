			},
			"dialogs": [
				{
					"id": 751310601,
					"content": "Dopo aver esaminato la Fotokamera, notate non solo una serie di foto dei paesaggi circostanti, ma anche un meccanismo speciale al suo interno. Sembra che questo meccanismo permetta alla Fotokamera di scattare foto in automatico ogni volta che rileva vibrazioni nel terreno.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
