			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310301,
					"content": "Pioggia... di fuoco... biologica?! Stai dicendo che ci cascherà del fuoco sopra la testa come se fosse vivo? Perché i vulcani di Natlan devono fare così paura?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310302,
					"content": "Paimon è davvero curiosa però... Perché non andiamo a esplorare l'area lassù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7513104,
			"completionStepIds": [
				7513102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513102",
							"2"
						],
						"stepId": 7513102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
