						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "Uhm, del fuoco che si muove come se fosse vivo, sinistre immagini residue e Fotokamere che scattano foto da sole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310402,
					"content": "Paimon ha il sospetto che ci sia un qualche sconvolgente mistero dietro! Chissà, magari c'è anche un tesoro nascosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310403,
					"content": "Questa tua intuizione è dovuta a qualcosa in particolare, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "A essere sincera... no! Ma il proprietario della Fotokamera deve averla piazzata qua per vedere cosa succede quando ci sono movimenti del terreno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310405,
					"content": "Perciò tutto quello che dobbiamo fare è rimettere a posto la Fotokamera e aspettare che il terreno tremi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310406,
					"content": "Hihi, e quando arriverà il momento giusto... di sicuro spunteranno fuori indizi sul luogo in cui è sepolto il tesoro, proprio come quell'immagine residua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7513106,
