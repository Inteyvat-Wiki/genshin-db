			},
			"dialogs": [
				{
					"id": 762040201,
					"content": "Nicole...! Strano, non è nemmeno qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040202,
					"content": "Siete già nel mio studio? Avete notato la mia collezione floreale? Ho coltivato esemplari raccolti da tutto il mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040203,
					"content": "*sospira* Purtroppo non posso allontanarmi in questo momento. Ho aperto una bancarella a Fontaine per vendere sculture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040204,
					"content": "Ehm... Vuoi che ti diamo una mano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "No, grazie. Questa è la mia unica occasione per mettere qualcosa nero su bianco, anche se per lo più si tratta solo di scrivere numeri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040206,
					"content": "Ma so che non avete spesso il tempo di farmi visita, quindi iniziate pure senza di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040207,
					"content": "A proposito... Vi ho lasciato una pergamena. Credo di averla messa vicino alla statua di un fringuello, nei pressi della parete ovest. Perché non provate a cercarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040208,
					"content": "Trovata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040209,
					"content": "Allora lasciate che la mia guida silenziosa vi accompagni nel cammino... Buona fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
