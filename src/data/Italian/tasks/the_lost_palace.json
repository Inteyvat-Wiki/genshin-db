			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "Complimenti! Ora, fatemi dare un'occhiata... Mh-mh, ottimo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040302,
					"content": "Anziché nell'attuale Giardino della Strega, quand'ero ancora un angelo vivevo in questo santuario. Questa è stata la mia casa per parecchio tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040303,
					"content": "Quanti angeli! Sembra che tu fossi davvero popolare, Nicole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040304,
					"content": "Non per vantarmi, ma un tempo tutti adoravano ascoltare le mie storie... Specialmente quelle sulla vita tra gli umani, sull'invio dei presagi e su come li guidavo nel costruire grandi civiltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040305,
					"content": "Ogni volta che arrivavo a un punto saliente, gli altri angeli trattenevano il respiro, pendendo dalle mie labbra. Non si sentiva nemmeno il vibrare di una corda d'arpa o il fruscio di un pennello su una tela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040306,
					"content": "Dopodiché, i colori e le sfumature intrecciati sbocciavano. C'erano musiche e luci, che illuminavano ogni cosa nel loro splendore dorato... Un delirio di esultanza e gioia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040307,
					"content": "Uuuh, sembra stupendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040308,
					"content": "Oh, lo era, Paimon... Lo era eccome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040309,
					"content": "Anche se quei giorni meravigliosi sono passati, la vita rimane piena di felici sorprese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040310,
					"content": "Un momento... Qualcuno ha davvero avuto la sfacciataggine di provare a rubare le mie sculture mentre leggevo il giornale? Oh, per te è finita, mio sciocco amichetto! Ti accompagnerò personalmente fino a Forte Méropide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040311,
					"content": "Un momento... Qualcuno ha davvero avuto la sfacciataggine di provare a rubare le mie sculture mentre leggevo il giornale?",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "Oh, per te è finita, mio sciocco amichetto!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "Ti accompagnerò personalmente fino a Forte Méropide!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		}
