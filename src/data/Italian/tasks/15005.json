			"dialogs": [
				{
					"id": 150050101,
					"content": "I Koholasauri sconfitti si disperdono e fuggono via.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150050102
					]
				},
				{
					"id": 150050102,
					"content": "A giudicare dai vostri vestiti, dovete essere degli studiosi di Sumeru, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050103,
					"content": "Sì, io sono Karya, e lui è il mio supervisore Viramdra. Grazie mille per averci salvati. Ci è mancato poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050104,
					"content": "#Non c'è di che! Siamo {F#abituate}{M#abituati} a gestire situazioni di questo tipo. Paimon è Paimon, e {F#lei}{M#lui} è {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050105,
					"content": "*sospira* Tuttavia, sembra che tutti i Koholasauri siano scappati... Dobbiamo catturarne almeno uno vivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050106,
					"content": "Eh? Catturarne uno vivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050107,
					"content": "Esatto. Mi sembrate piuttosto in gamba. Pensate che potreste usarmi come esca viva per aiutarci a catturarne uno? Vi pagherò per il disturbo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050108,
					"content": "Mmm... Beh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050109,
					"content": "#Chiedo scusa. Viramdra è stato molto preso dalle sue ricerche, quindi vi prego di non essere troppo {F#dure}{M#duri} con lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050110
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050110,
					"content": "Oh, nessun problema! Ma perché avete avvicinato un intero branco di Koholasauri selvaggi? E perché volete \"catturarli\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050111,
					"content": "Non dirmi che anche voi volete farvi una foto assieme a loro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050112
					]
				},
				{
					"id": 150050112,
					"content": "Paimon non pensa che si tratti di questo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050113,
					"content": "Dobbiamo sembrare alquanto ridicoli... Ma il fatto è che stiamo cercando l'isola misteriosa di una certa leggenda. Si dice che i Koholasauri custodiscano un indizio molto importante, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050114
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050114,
					"content": "Avvicinarli senza l'aiuto di una guida del Popolo delle Sorgenti è stata sicuramente una scelta avventata da parte nostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050115
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050115,
					"content": "Un'isola misteriosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050116,
					"content": "Sì. C'è una leggenda del Popolo delle Sorgenti che parla di un'isola misteriosa, e Viramdra crede che la soluzione per le sue ricerche si possa trovare lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050117
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050117,
					"content": "#Ehm... Siete {F#sicure}{M#sicuri} di non voler prendere in considerazione la mia proposta di catturarne uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050118
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050118,
					"content": "La tua proposta... Non ci pensiamo nemmeno a usare una persona come esca viva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050119,
					"content": "Quindi immagino che continuare a discuterne sia solo una perdita di tempo. Dovrò trovare un'altra soluzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050120
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050120,
					"content": "Ahem... Viramdra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050121
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050121,
					"content": "Ah, giusto... Avete appena salvato me e Karya, e immagino di dovervi esprimere la mia gratitudine. Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050122
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050122,
					"content": "Un tantino impacciato, ma non c'è di che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050123,
					"content": "Dovremmo andare, Karya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050124
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050124,
					"content": "Sì, grazie ancora. Le mie scuse... Viramdra non è molto bravo a relazionarsi con le persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050125
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050125,
					"content": "Non c'è problema, ci vediamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050126,
					"content": "Non si vedono avventurieri come quelli tutti i giorni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050127,
					"content": "A ogni modo, Paimon ora vuole proprio saperne di più su quell'isola misteriosa di cui parlava quella signora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050128,
					"content": "Anche tu vuoi trovare l'isola, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050129
					]
				},
				{
					"id": 150050129,
					"content": "Sì! Chissà, magari troveremo un tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050130,
					"content": "Dopo tutti i posti incredibili che abbiamo esplorato durante le nostre avventure, trovare un'isola misteriosa dovrebbe essere una passeggiata per noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050131,
					"content": "Ma non abbiamo nessuna informazione su quell'isola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050132
					]
				},
				{
					"id": 150050132,
					"content": "Ah, hai ragione... La signora ha detto che l'isola misteriosa è collegata a una leggenda sul Popolo delle Sorgenti... Forse potremmo iniziare chiedendo in giro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050133,
					"content": "Non c'è tempo da perdere. Cominciamo la nostra prossima avventura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050134,
					"content": "Va bene chiedere in giro... Ma a chi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050135,
					"content": "Non potremmo parlare direttamente con il capo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050136
					]
				},
				{
					"id": 150050136,
					"content": "Mmmh... Ottima idea. Il capo della tribù dovrebbe saperne di più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
