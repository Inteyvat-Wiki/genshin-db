				]
			},
			"dialogs": [
				{
					"id": 150050201,
					"content": "Wow, che vista mozzafiato! E ci sono anche dei Koholasauri! Ehi, perché non proviamo a scattare una foto con loro in mezzo alla natura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050202,
					"content": "E se provassero a morderci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "Beh... Sono così carini, probabilmente non lo faranno, giusto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050204,
					"content": "Eh? Cosa sta succedendo laggiù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050205,
					"content": "Aiuto! Qualcuno ci aiuti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050206,
					"content": "Ah! I Koholasauri selvaggi stanno mordendo qualcuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050207,
					"content": "Ci tocca intervenire!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#Sì, quei due sono nei pasticci! {F#La leggendaria}{M#Il leggendario} {NICKNAME} e la sua fidata assistente Paimon non rimarranno a guardare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050209,
					"content": "Sembra che le foto dovranno aspettare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "Già, ci penseremo dopo! Non possiamo starcene con le mani in mano, se qualcuno ha bisogno d'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}