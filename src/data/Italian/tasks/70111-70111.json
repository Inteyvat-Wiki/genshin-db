				]
			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "#{F#Stimata viaggiatrice}{M#Stimato viaggiatore}, mi permetti un istante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "Ti risparmierò i dettagli superflui. C'è una questione per la quale necessito di assistenza. Alcuni giorni or sono, l'eminente Yu Huangyi di Liyue mi ha inviato un tesoro di straordinaria rarità. Eppure, a tutt'oggi, non è ancora giunto nelle mie mani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "Ho ragione di credere che il custode di questa regione lo abbia intercettato. Se dovessi trovare il \"tesoro\" in questione, ti chiedo cortesemente di recuperarlo per mio conto. Posso garantirti un adeguato compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "#Siamo {F#tornate}{M#tornati}! Dai un'occhiata. È questo il \"tesoro\" di cui parlavi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "Ah! Vi ringrazio di cuore, davvero! Non potrò mai ricambiarvi abbastanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "Molto bene. Non c'è motivo d'indugiare oltre. Lo apro seduta stante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "Q-Questo è...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "Woah! Sta per esplodere?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "No, l'illustre Yu Huangyi non cercherebbe mai di farmi del male... Presumo che il custode se ne sia impossessato e l'abbia trasformato in una bomba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "Mi rammarica dirlo, ma non ho alcuna conoscenza su come disattivare simili dispositivi... Non c'è altro da fare, lanciamolo lontano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "Niente panico! Ora ricordo. Un nobile di Iperborea una volta menzionò il metodo corretto per lanciare una bomba sacra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "\"Si conti fino a tre. Non di più, non di meno. Sia il tre il numero contato. Il quattro è proibito. Non ci si soffermi sul due. Il cinque è fuori da ogni questione. Una volta raggiunto il numero tre...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "Smettila di spiegare e lanciala! Sta per esplodere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7011103,
			"completionStepIds": [
				7011103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
