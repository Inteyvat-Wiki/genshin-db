			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							361.8,
							202.397,
							620.8
						],
						"pointId": 230
					}
				]
			},
			"dialogs": [
				{
					"id": 701110301,
					"content": "Eh? Aspetta. Tutto qui? Ci siamo agitati tanto per dei fuochi d'artificio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110302,
					"content": "Q-Quale fulgore... Persino nei miei anni di servizio sotto Sua Eccellenza, la potente Narukami Ogosho, non ho mai assistito a un 'sì splendente sbocciare di fiamme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110303,
					"content": "Capisco. Dunque è questo lo spettacolo che l'illustre Yu desiderava mostrarmi... È più di quanto avrei mai potuto sperare. Ne sono profondamente onorato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110304,
					"content": "\"Nella notte oscura come giada corvina, i fiori sbocciano splendenti tra le nuvole. Il corpo, come schiuma sull'acqua, deve tornare al silenzio in un istante. Mentre le stelle s'allontanano e la pioggia si disperde nel vuoto...\" Che raffinata eleganza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110305,
					"content": "Beh, Paimon non capisce molto questa faccenda dell'\"eleganza\", ma almeno non era pericoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}