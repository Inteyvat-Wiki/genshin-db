			"dialogs": [
				{
					"id": 747040101,
					"content": "Ehi, Colombina! Stai ammirando i pesci nel nostro acquario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040102,
					"content": "Mh-mh. Avete fatto un lavoro fantastico con questo posto. Ci sono tanti pesci che non avevo mai visto prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040103
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747040103,
					"content": "Sei già stata a un acquario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040104,
					"content": "No, anche se a Snezhnaya ho visto delle vasche per pesci. Ma all'epoca non avevo ancora aperto gli occhi per davvero, quindi non ho potuto apprezzarli come si deve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040105
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747040105,
					"content": "Quindi, cosa ne pensi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747040106
					]
				},
				{
					"id": 747040106,
					"content": "È bellissimo. Non credevo che il mondo sottomarino fosse così vivace e colorato. È come... vivere in un'eterna primavera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040107
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747040107,
					"content": "Oh, guarda quel pesce. Non trovi che sia identico a Sandrone? E quei due laggiù, l'uno che segue l'altro... Sono proprio come voi due!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747040108,
					"content": "Ehi, hai ragione! Ora che lo dici, ci assomigliano davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040109,
					"content": "Quello lì dall'aria indaffarata mi ricorda Lauma. E quello in mezzo ai coralli sembra osservare tutto in silenzio, proprio come Lady Nefer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040110
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747040110,
					"content": "Uhm... Sembra che ti piaccia abbinare i tuoi amici ai pesci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040111,
					"content": "Non esattamente. Mi piacciono i miei amici, quindi mi viene naturale pensare a loro anche mentre guardo i pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747040112,
					"content": "Cavoli, Paimon è davvero felice di sentirtelo dire! Allora, ci sono altri pesci che ti ricordano qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040113,
					"content": "Uhm... Ultimamente ho stretto molte nuove amicizie, temo di non riuscire a trovare un pesce per ognuna di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040114
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747040114,
					"content": "È normale. Comunque, continueremo ad aggiungere altri pesciolini! Prova a tornare, di tanto in tanto: la prossima volta che verrai, potresti trovare ancora più amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040115,
					"content": "...Volete mettere i miei amici nell'acquario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040116
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 747040116,
					"content": "Certo che no! Paimon sta parlando di pesci che somigliano agli amici, sciocchina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}