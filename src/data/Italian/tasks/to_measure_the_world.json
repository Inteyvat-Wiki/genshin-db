			},
			"dialogs": [
				{
					"id": 230250401,
					"content": "Mmh... Quindi questo è quanto. Introduci questa variabile, e si spiegano le discrepanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250402,
					"content": "Ma cambia anche le mie altre deduzioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250403,
					"content": "Qualche progresso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "Scusa, mi ero dimenticato che fossi ancora qui... Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250405,
					"content": "E per quanto riguarda i progressi... Ho sistemato alcune problematiche, ma ne sono emerse di nuove. Immagino sia il bello della ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250406,
					"content": "#Potrei doverti disturbare ancora, viaggiat{F#rice}{M#ore}, finché non arrivo alla conclusione finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
