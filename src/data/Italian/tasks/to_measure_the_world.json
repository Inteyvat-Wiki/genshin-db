				{
					"id": 230250519,
					"content": "È davvero così urgente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250520
					]
				},
				{
					"id": 230250520,
					"content": "Se non riuscirò a ottenere dei risultati, temo che avrò dei problemi a ottenere i finanziamenti per la ricerca... E questo sarebbe molto più devastante del cielo che crolla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250521,
						230250522
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250521,
					"content": "#Non pretenderei di essere coaut{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250522,
					"content": "Preferisco un pagamento adeguato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250510,
					"content": "Tecnicamente non può...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250512
					]
				},
				{
					"id": 230250503,
					"content": "#Sono molto occupat{F#a}{M#o} in questo momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250504
					]
				},
				{
					"id": 230250504,
					"content": "Oh, per favore. Cosa ci potrebbe essere di più serio del crollo imminente della propria casa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250505
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250505,
					"content": "Casa tua sta... crollando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250506
					]
				},
				{
					"id": 230250506,
					"content": "Ehm... Ovvio che no. Ma mettiamo che tu viva in una casa e non l'abbia mai vista nella sua interezza, e che nessuno ne abbia mai garantito la resistenza strutturale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250507
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250507,
					"content": "Viverci ogni giorno non ti preoccuperebbe? È così anche per la vita in questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250508
					],
					"speakerTitle": "Farghani"
				}
			]
		},
