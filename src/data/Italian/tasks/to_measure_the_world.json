			},
			"dialogs": [
				{
					"id": 230251001,
					"content": "Cosa? Dei mostri, là fuori? Non ha senso. I parametri ambientali mostrano che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251002
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251002,
					"content": "Potrebbe essere che gli stessi segnalatori siano diventati delle variabili? Forse il suono e le vibrazioni hanno attirato i mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251003
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251003,
					"content": "Oh, no! Queste cose influenzeranno i dati? Ah, scusa... Stavo di nuovo parlando da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251004
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251004,
					"content": "Non pensavo di disturbarti ancora. Ti prego, accetta le mie scuse e questa ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251005,
					"content": "La prossima volta dovrò essere più scrupoloso nelle misurazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
