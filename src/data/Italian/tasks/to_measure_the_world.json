					"Farghani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250801,
					"content": "#Ah, viaggiat{F#rice}{M#ore}, sei qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250802,
					"content": "Come va la tua ricerca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Grazie a te, negli ultimi giorni ho fatto molti passi avanti. I segnalatori dovrebbero raccogliere i dati proprio in questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250804,
					"content": "Ora devo solo recuperare i dati e verificare le mie congetture!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250805,
					"content": "Tutto ciò che hai fatto in questi giorni non è stato altro che congetture?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "Beh, ho ottimizzato alcune equazioni e calibrato gli strumenti. Dopotutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250808,
					"content": "Non potrò arrampicarmi fin dove hai piazzato i segnalatori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250809,
					"content": "Temo che dovrò disturbarti per recuperarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250810,
					"content": "Va bene, allora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "#Per favore, viaggiat{F#rice}{M#ore}! Avrai la tua ricompensa, non preoccuparti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250812,
					"content": "Perché non tieni conto del recupero, la prossima volta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "Avevo valutato alcune opzioni: aggiungere un dispositivo di recupero, ampliare la nostra gamma di applicazioni... Cose del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250814,
					"content": "Ma la spesa sarebbe stata maggiore, e non so come questo possa influire sulla precisione dei dati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250815,
					"content": "Comunque... Conto su di te anche questa volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250806,
					"content": "Non hai fatto alcun progresso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
			]
		},
