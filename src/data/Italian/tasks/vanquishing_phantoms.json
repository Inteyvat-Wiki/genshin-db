			"dialogs": [
				{
					"id": 140340101,
					"content": "Arrivate finalmente alla chi{RUBY#[D]sotterranei}esa che vi ha descritto Florian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 140340102,
					"content": "Mentre vi avvicinate, un'aura sinistra comincia a circondarvi: il nemico è vicino, ve lo sentite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 140340103,
					"content": "(Che strano... Questo senso di irrequietezza sembra così vero. Come riusciranno a farlo?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340104,
					"content": "...È il momento della battaglia finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 140340105,
					"content": "Andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "Lyney",
					"speakerSubtitle": "Cacciatore della Maréchaussée"
				},
				{
					"id": 140340106,
					"content": "Florian! Aspetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340107,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340108,
					"content": "Penso che dovresti aspettare fuori. Sei già stato corrotto dallo Psicovoro una volta. Potrebbe riappropriarsi di nuovo della tua mente e prendere il controllo sul tuo corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340109,
					"content": "Secondo me non è una buona idea che ti avvicini. Se s'impossessa di nuovo di te, potresti addirittura assumere un'altra forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340110,
					"content": "È proprio per questo che devo andare... Per questo devo essere in prima linea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340111,
					"content": "...! Stai dicendo che...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340112,
					"content": "Esatto, voglio attirarlo nel mio corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340113,
					"content": "È troppo rischioso. Se la situazione ci sfuggisse di mano, potrei doverti uccidere. Lo capisci il pericolo che corri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340114,
					"content": "Lo capisco. Ma, così facendo, voi avreste un bersaglio a tiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340115,
					"content": "Lo Psicovoro non si lascerà mai sfuggire l'occasione di entrare in un corpo che sa di poter controllare. Non dovrai preoccuparti che prenda il sopravvento su uno dei tuoi amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340117,
					"content": "Tu non sei come me, Mademoiselle Clorinde. Tu sei una Cacciatrice della Maréchaussée forte e onesta. Questo mostro si è liberato per un mio errore. È mio dovere assumermi la responsabilità della sua distruzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340118,
					"content": "Io... Devo farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340119,
					"content": "Consideralo un duello per riconquistare il mio onore. Ti chiedo solo di mettercela tutta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340120,
					"content": "...Ho capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340121,
					"content": "In tal caso, in qualità di campionessa duellante, sono qui ad accettare la tua richiesta di duello e a porti i miei più sinceri saluti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340122,
					"content": "...Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340123,
					"content": "La battaglia è ormai imminente. Che lo Psicovoro tremi nuovamente alla vista delle lame dei Cacciatori della Maréchaussée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		},
