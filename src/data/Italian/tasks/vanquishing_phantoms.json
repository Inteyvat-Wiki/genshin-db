				]
			},
			"dialogs": [
				{
					"id": 140340201,
					"content": "E così, i mostri vennero eliminati e lo stregone fu sconfitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340202
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 140340202,
					"content": "La pace tornò presto nella capitale. Anche i cortigiani sedotti dallo stregone riconobbero i propri errori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340203
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 140340203,
					"content": "Alcuni ricordarono i nomi degli eroi che avevano salvato il regno, mentre altri continuarono le proprie vite come se nulla fosse successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340204
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 140340204,
					"content": "Questa è la storia dei Cacciatori della Maréchaussée. Essi perseguono gli spettri nell'oscurità e sterminano tutto ciò che comporti una minaccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340205
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 140340205,
					"content": "Essi proteggeranno sempre la città e i suoi abitanti, anche quando il ricordo delle loro vittorie dovesse venir dimenticato proprio dalle persone a cui prestano i loro servigi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340206
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Interpretazione di Clorinde"
				},
				{
					"id": 140340206,
					"content": "Fiuuu... Direi che siamo finalmente arrivati alla fine del gioco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340207
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340207,
					"content": "Sì. Avete raggiunto uno dei finali migliori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340208
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340208,
					"content": "In generale è una buona storia. All'inizio pensavo che sarebbe stata solo un'avventuretta come le altre. E invece... Più ci addentravamo nella storia, più la realizzazione e la trama mi intrigavano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340209
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340209,
					"content": "Soprattutto la battaglia finale! Gli effetti erano davvero realistici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340210
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340210,
					"content": "Sì, è vero, ehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340211
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340211,
					"content": "Ah, giusto, ottima osservazione. Non avrei mai pensato che le armi che abbiamo trovato nella camera del tesoro avrebbero avuto un tale effetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340212
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340212,
					"content": "È vero. La mia mi ha quasi fatto venire un colpo, quando ha iniziato a brillare! Dopo che siamo usciti, l'ho guardata per bene, ma direi che non si è più riaccesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340213
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340213,
					"content": "Oh, dobbiamo restituire questi oggetti di scena, immagino. La mia la lascio qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340214
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340214,
					"content": "Si è divertita, Madame Furina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340215,
					"content": "Ma certo. Dimmelo se trovi un'altra trama così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340216
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340216,
					"content": "Certo, nessun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340217,
					"content": "Allora io vado. Ho bisogno di un po' di tempo per digerire tutto quello che è successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340218
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340218,
					"content": "Quando Monsieur Florian si sveglia, salutamelo, per favore. Dev'essere proprio esausto. Guardatelo, sembra svenuto per la stanchezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340219
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340219,
					"content": "Ha ragione. Ne ha passate tante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340220,
					"content": "Bene, alla prossima, allora! Ciao ciaooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340221
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340221,
					"content": "...Ok, ora posso chiederlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340222
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340222,
					"content": "Sì, direi di sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340223
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340223,
					"content": "Cosa diamine è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340224
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340224,
					"content": "...Ah, quindi avete capito tutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340225,
					"content": "Ahahah... Quando prima nella grotta ci hai chiesto di chiudere gli occhi... Sarebbe stato strano se non ci fossimo accorti di niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340226
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340226,
					"content": "Stavo morendo dalla curiosità! Hai fatto davvero un lavoro coi fiocchi fingendo che non ci fosse niente che non andava. E a dire il vero, Furina aveva l'aria di chi pensa che sia tutto pianificato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340227
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340227,
					"content": "Probabilmente nessuno di noi voleva rovinare la magia agli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340228
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340228,
					"content": "Eh? Di che state parlando voialtri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340229,
						140340231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340229,
					"content": "Sì, che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340230
					]
				},
				{
					"id": 140340230,
					"content": "Aspetta, non dirmi che non hai... Ah, è tutta colpa mia. Beh puoi ancora coprirti le orecchie! Ecco, guarda, lo faccio io per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340233,
					"content": "Ehm... Non credi che sia un po' tardi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340234
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340234,
					"content": "Eh? Stai dicendo che... tutto quello che è successo in realtà non faceva parte di nessun gioco di ruolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340235,
					"content": "Sarebbe più accurato dire che questo non è mai stato un vero e proprio gioco di ruolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340236,
					"content": "Cooosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340237,
					"content": "...Cos'è questo baccano...? La mia testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340238
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340238,
					"content": "Ehi, tu! Alzati subito e dai a Paimon una spiegazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340239,
					"content": "Aaaaaah! Non scuotermi, ti prego! La testa...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340240
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340240,
					"content": "Florian spiega tutto ai presenti...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140340241
					]
				},
				{
					"id": 140340241,
					"content": "P-Paimon ha sentito bene? Avete improvvisato tutta l'ultima parte così, sul momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340242,
					"content": "Non è carino mentire... Però Paimon deve ammettere che è stata una gran bella storia, Florian. Oh, e complimenti, Clorinde: hai delle ottime doti di improvvisazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340243,
					"content": "È vero! È stato come guardare un prestigiatore che improvvisa un trucco di magia dopo essersi reso conto di aver scordato un oggetto di scena importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340244
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340244,
					"content": "Se Paimon avesse saputo che qualcosa non quadrava in quella camera del tesoro, se ne sarebbe volata via nella direzione opposta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340245,
					"content": "Era tutto sotto controllo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340246
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340246,
					"content": "Non è che tu abbia mai definito una situazione \"fuori controllo\". Scommetto che qualunque situazione \"facile da gestire\" per te farebbe spaventare a morte una persona normale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340247
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340247,
					"content": "Suppongo sia una questione di abitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340248
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340248,
					"content": "Oh... Devi esserti imbattuta in un sacco di situazioni inaspettate... Questo spiega la tua bravura nell'improvvisare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340249,
					"content": "In quanto a te, Florian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340250,
					"content": "...Lo so, non ci sono scuse per quello che ho fatto. Mi consegnerò alla Garde, confesserò i miei crimini e accetterò qualunque punizione a cui mi si condanni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340251
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340251,
					"content": "Direi che hai già sofferto abbastanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340252,
					"content": "...Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340253
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340253,
					"content": "Magari all'inizio sei stato accecato dalla brama di gloria e ricchezze ma, con le tue azioni nella battaglia finale, hai dimostrato di essere un vero Cacciatore della Maréchaussée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340254,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340255
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340255,
					"content": "Saresti molto più utile alla città in superficie, anziché sottoterra. Il tuo lavoro come Cacciatore è più importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340256,
					"content": "Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340257
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340257,
					"content": "Fermo restando che dovrai comunque prendere le chiavi e riportarle ai due Cacciatori a cui le hai rubate. Preparati ad accettare qualunque condizione t'impongano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340258,
					"content": "...Sì, certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340259
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340259,
					"content": "Per quanto mi riguarda... Hai già dimostrato il tuo onore nel duello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340260,
					"content": "...! Allora farò tutto ciò che hai detto. Vado subito a riconsegnare le chiavi ai loro legittimi proprietari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340261
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340261,
					"content": "Grazie a tutti. Farò del mio meglio per dimostrarvi che sono degno della seconda opportunità che mi avete dato. Lo giuro sul mio nome e sul mio onore di Cacciatore della Maréchaussée.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340262
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340262,
					"content": "Alla prossima, amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340231,
					"content": "#Anch'io sono {F#statа}{M#stato} al gioco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340232
					]
				},
				{
					"id": 140340232,
					"content": "Aspetta, non dirmi che Paimon non ha... Ah, è tutta colpa mia. Beh, puoi ancora coprirti le orecchie, Paimon! Ecco, guarda, lo faccio io per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				}
			]
		},
		{
			"id": 1403403,
			"completionStepIds": [
				1403403,
				1403404,
				1403405,
				1403406,
				1403407,
				1403408,
				1403409,
				1403410,
				1403411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1403403",
							"2"
						],
						"stepId": 1403403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clorinde"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2525.035,
							469.746,
							4803.685
						],
						"pointId": 340300464
					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "A proposito dei Cacciatori della Maréchaussée... Cosa ne facciamo del loro tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340302,
					"content": "Lasciamolo lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340303,
					"content": "Sei sicura? Potremmo mostrarlo alla gente, affinché tutti ricordino i Cacciatori... No?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340304,
					"content": "No. Ognuno dei Cacciatori nominati su quella stele ha fatto una scelta sapendo ciò che avrebbe comportato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340305,
					"content": "Io non faccio eccezione... Non ho bisogno che la gente ricordi che sono una Cacciatrice della Maréchaussée. Mi interessa solo essere ricordata come una campionessa duellante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340306,
					"content": "È sicuramente molto diverso dal percorso di un mago. Ma ammiro comunque la tua decisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340307,
					"content": "Oh, a Paimon è appena tornata in mente una domanda: visto che non c'era nessun tipo di effetti speciali, come hanno fatto le armi a illuminarsi durante la battaglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340308,
					"content": "Perché i Cacciatori della Maréchaussée del passato infondevano degli incantesimi speciali nelle proprie armi, così da riuscire a eliminare i mostri. Quando una di quelle creature era nei paraggi, le armi s'illuminavano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340309,
					"content": "Ooh! Ecco perché hanno avuto effetto su quel mostro verso la fine. Pensavo fosse tutta opera delle evocazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340310,
					"content": "Sono sicura che le evocazioni facessero parte del piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340311,
					"content": "Eh? E come?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340312,
					"content": "Probabilmente questo Psicovoro era antico tanto quanto i Cacciatori citati sulla stele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340313,
					"content": "I nomi che avete letto appartenevano ai Cacciatori più valorosi. Innumerevoli furono i mostri che soccombettero alle loro lame. Probabilmente è per questo che lo Psicovoro ha reagito in quel modo quando ha udito quei nomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340314,
					"content": "Quindi sono stati i loro nomi ad avere potere su di lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340316,
					"content": "Navia, tutto ciò che hai detto durante la tua \"Evocazione\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340317,
					"content": "Eh? Ah... Ahahah! Dicevo sul serio. Nel senso, ero totalmente nel personaggio! Per cui mi fa piacere che tu l'abbia sentito, solo non farmelo ripetere, per favore. È imbarazzante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340318,
					"content": "Ho apprezzato molto le tue parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340319,
					"content": "Ok, ok. Basta con i sentimentalismi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340320,
					"content": "Ehm... Non parliamone più! Io vado avanti. Mi raccomando, non rimanete troppo indietro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340321
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340321,
					"content": "Ah... È scappata via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340322,
					"content": "Dovrei tornare indietro anch'io. È stata una storia incredibile. Potrei raccontarla a Lynette e Freminet per tutta la notte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340323
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340323,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340324
					]
				},
				{
					"id": 140340324,
					"content": "Mm, alla prossima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340325
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340326
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340326,
					"content": "#{NICKNAME}... Se il tuo nome e le tue gesta cadessero nell'oblio, quale pensi sarebbe il significato del tuo viaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340327
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340327,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340328
					]
				},
				{
					"id": 140340328,
					"content": "Immagino che il significato sarebbe il viaggio stesso e il mondo che abbiamo aiutato a plasmare. Il tempo trascorso qui con gli altri, i traguardi raggiunti... Tutto ha comunque un suo valore, anche se nessuno se ne ricorda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340329
					]
				},
				{
					"id": 140340329,
					"content": "Bella risposta. Me la ricorderò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340330
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340330,
					"content": "E per te, Clorinde? Quale sarebbe la tua risposta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340331
					]
				},
				{
					"id": 140340331,
					"content": "La mia? Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340332
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340332,
					"content": "\"La Cacciatrice della Maréchaussée rimane in silenzio, senza rispondere alla domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340333
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340333,
					"content": "Forse la sua risposta è proprio il suo silenzio, un giuramento non detto lasciato echeggiare attraverso la notte. Il cammino che percorre non ha bisogno di spiegazioni.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		}
	]
}