				101801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Il Principe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "Siete di ritorno, finalmente. Com'è andato il viaggio sui Monti di Jueyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031802,
					"content": "Capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031806,
					"content": "Ah, non avete incontrato di persona tutti gli Adepti? Beh, come si suol dire, è tutto nelle mani del destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031807,
					"content": "Non preoccupatevi! Se avrete del tempo libero, potrete sempre riprovarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031808,
					"content": "Inoltre, quanto detto da Conquistademoni è già piuttosto prezioso. Per festeggiare il vostro ritorno, vorrei omaggiarvi con alcuni dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031809,
					"content": "Rispetto alla morte dell'Archon... La risposta delle Sette Stelle di Liyue mi ha dato molto da pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031810,
					"content": "Non avendo ancora catturato l'assassino, non consentiranno a nessuno di avvicinarsi per rendere omaggio all'Exuvia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031811,
					"content": "Hanno anche cercato di non far trapelare informazioni... Ma con il Rito della discensione in vista, neanche le Sette Stelle riescono a tenere sotto controllo tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031812,
					"content": "L'Exuvia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031813,
					"content": "Lo sanno tutti a Liyue che Rex Lapis è anche un Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031814,
					"content": "L'Archon di Geo o Dio dei contratti è anche noto come l'Exuvia, il Primo degli Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031815,
					"content": "I potenti e illuminati Adepti di oggi, in tempi remoti, hanno sottoscritto un contratto per la protezione di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031816,
					"content": "Ecco perché hanno tutti a cuore il benessere di Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031817,
					"content": "Naturalmente! Hanno le qualità richieste per questo compito e si sentono responsabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031818,
					"content": "Se le Sette Stelle regnanti non potessero svolgere adeguatamente il loro dovere, gli Adepti applicherebbero delle azioni correttive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031820,
					"content": "Questo complica le cose anche per me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "Sono d'accordo, qualcosa non quadra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "Lo spirito dell'Archon di Geo è asceso, perché le Sette Stelle dovrebbero nasconderne i resti? È davvero poco chiaro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031822,
					"content": "Oh! Giusto! È per lui che siamo venuti fin qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031823,
					"content": "Ma se le Sette Stelle di Liyue non permettono a nessuno di avvicinarsi all'Exuvia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031824,
					"content": "#Allora la missione di {NICKNAME} di trovare i Sette è inutile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031826,
					"content": "La cosa non ti riguarda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "Preferisco non commentare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "Eh? Stai provando a trovare i Sette? E come mai, se posso chiedere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031828,
					"content": "Eheh... Bella risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031829,
					"content": "#{M#Un}{F#Una} cavaliere che si lasciasse ingannare dai Fatui non sarebbe degn{M#o}{F#a} di essere definit{M#o}{F#a} tale. Dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031830,
					"content": "Ma anche io posso esserti d'aiuto, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031831,
					"content": "Eh? Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031832,
					"content": "Concedimi del tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031833,
					"content": "Il tempo di... trovare qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031834,
					"content": "Qualcuno che vi aiuti a uscire da questa situazione di stallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031835,
					"content": "Incredibile, davvero. Quanto più tentano di reprimere la cosa e più viene fuori il caos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10031836,
					"content": "Se volete vedere come crollerà tutto a un certo punto, vi consiglio di mantenervi in vita fino alla prossima, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				}
			]
		},
