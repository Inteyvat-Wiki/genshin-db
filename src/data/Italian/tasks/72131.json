			"dialogs": [
				{
					"id": 721310101,
					"content": "La strana lanterna di pietra sembra emettere un'energia sinistra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721310102,
					"content": "Una... lanterna di pietra? Cosa ci fa qui una lanterna di pietra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310103,
					"content": "Beh, qualcuno ha scritto un messaggio sul lampione. Diamo un'occhiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310104,
					"content": "\"Ai lavoratori: per qualunque domanda su questo amuleto, contattate il signor Kaji nella Valle di Musoujin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721310105,
					"content": "Il messaggio sembra recente. Sotto, qualcuno ha scarabocchiato qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721310106,
					"content": "\"Mi spiace, ma neanche noi possiamo aiutarti. Proprio ieri il commissario ha ordinato l'evacuazione.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721310107,
					"content": "\"Spero di poterti rivedere, un giorno, per discutere di come risolvere il problema del Tatarigami.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721310108,
					"content": "Questo signor Kaji sembra molto preoccupato per via delle lanterne di pietra. Perché non lo raggiungiamo nella Valle di Musoujin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
