			"dialogs": [
				{
					"id": 220340203,
					"content": "Quei tizi sono veloci a fuggire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340204,
					"content": "Saranno andati a riferire la nostra presenza. In tal caso, la nostra missione è compiuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340205,
					"content": "#Grazie per averci aiutati, viaggiat{F#rice}{M#ore}. Ecco, prendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340206,
					"content": "Io tornerò da Sango a fare rapporto sull'accaduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340207,
					"content": "Chissà se ha già capito qualcosa di più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
