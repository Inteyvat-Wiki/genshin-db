	"talks": [
		{
			"id": 2203401,
			"completionStepIds": [
				2203401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203401",
							"2"
						],
						"stepId": 2203401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "#Viaggiat{F#rice}{M#ore}, aspetta. Sango ha bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340102,
					"content": "Sta facendo progressi con il caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "Questo non me l'ha detto. So soltanto che aveva ancora qualche preparativo da ultimare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340104,
					"content": "Mi ha anche chiesto di aspettarti e domandarti se ti andrebbe di effettuare una ricerca fuori città insieme a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340105,
					"content": "Cosa vuole ottenere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "Beh... a essere sincero, non ne ho idea nemmeno io. Ma quando seguiamo le direttive di Sango, di solito riusciamo a risolvere i casi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340112,
					"content": "Beh, a tal proposito, parliamo di affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340113,
					"content": "Stando a Sango, la pattuglia in città è stata potenziata da quando Amano e Andou hanno riferito di quell'incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340114,
					"content": "Ma stranamente i mercanti della città sono ancora vittime di furti. E le intenzioni del ladro sono ben chiare: gli interessano solo oggetti specifici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340115,
					"content": "Il problema è questo: Sango crede che la probabilità che dei Cacciatori di tesori si intrufolino in città per compiere questi crimini sia molto bassa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340116,
					"content": "Il sospettato... o meglio, i sospettati, hanno un obiettivo molto chiaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340117,
					"content": "È molto probabile che per tutto questo tempo ci sia stata una talpa in città, pronta a passare informazioni a chi era fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340118,
					"content": "Questo non significa che le azioni del doushin sono inutili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "Per niente. È proprio quello che vogliamo. Visto che il nostro colpevole sembra credere ancora di non essere il bersaglio del doushin, continuerà a commettere reati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340120,
					"content": "Più ne commetterà, più sarà facile che si tradisca e che Sango scopra chi è davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340121,
					"content": "Pertanto, dobbiamo continuare a recitare in modo che il nostro ladro abbassi la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340122,
					"content": "#Viaggiat{F#rice}{M#ore}, è per questo che ti sto chiedendo di venire con me e cercare rogne con quei Cacciatori di tesori là fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340123,
					"content": "#Sarai ovviamente ricompensat{F#a}{M#o}. Inoltre... quando il caso sarà chiuso, ti spetterà un ulteriore regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340124,
					"content": "Sango ti ha chiesto di dire anche questo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "Mmmh... Come l'hai capito? Hai davvero un ottimo intuito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340126,
					"content": "È stata proprio Sango a chiedermi di persuaderti con queste parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340127,
					"content": "Ma credimi quando ti dico che non sto mentendo. Ho portato con me il tuo compenso, se non altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340128,
					"content": "#Quindi, per favore: aiutaci, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340129,
					"content": "Cosa volete che faccia, di preciso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "È facile. Dobbiamo solo... infastidire quei Cacciatori di tesori là fuori. Più trambusto creeremo e meglio sarà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340131,
					"content": "Sango mi ha già detto dove si trovano alcuni dei loro accampamenti. Li ho segnati sulla mappa per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340132,
					"content": "Bene, ci rivedremo qui più tardi. Diamoci una mossa, ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340107,
					"content": "Perché non è venuta anche lei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "Fa sempre così. Ha detto: \"Io sono brava a pensare, non ad agire\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340109,
					"content": "Tempo fa, un romanziere venne a intervistarla, dato che voleva trasformare la sua storia in un romanzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340110,
					"content": "La definì come \"investigatrice da poltrona\". Sango apprezzò talmente tanto questo soprannome che da allora ha in mente di acquistare una poltrona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340111,
					"content": "Ma per problemi di fondi, non possiamo ancora procurarcene una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
