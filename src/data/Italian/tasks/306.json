			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3061101,
					"content": "Ci siamo. Questo è uno dei <color=#00E1FFFF>Templi dei Quattro Venti</color> abbandonati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061102,
					"content": "Questi templi sono in rovina ormai da anni. Gli abitanti di Mondstadt non li frequentano quasi mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061103,
					"content": "È possibile che all'interno troveremo il nido di un mostro o un accampamento di Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061104,
					"content": "Persino Terrore alato ha rinunciato al suo stesso tempio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061105,
					"content": "\"Terrore alato...\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "Sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061108,
					"content": "È difficile da accettare anche per me, ma... un tempo, Terrore alato era uno dei Quattro Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061109,
					"content": "Cooooosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3061110,
					"content": "Aspetta... Hai sentito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061111,
					"content": "Il vento qui... ha qualcosa che non va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061112,
					"content": "#Entriamo a dare un'occhiata, {NICKNAME}. Fai attenzione, si sente il potere del drago in questa zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061106,
					"content": "Aspetta, hai per caso detto \"il suo stesso tempio\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
			]
		},
