				]
			},
			"dialogs": [
				{
					"id": 752130601,
					"content": "Ciao, ecco la tua bevanda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "#Oh! Ah! Allora siete {F#quelle}{M#quelli} della consegna... Mi stavo chiedendo perché ci steste mettendo così tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130608,
					"content": "La colpa è tutta tua! Hai chiesto tu di effettuare la consegna a un \"ospite coi pantaloni blu sulla spiaggia\", che ne sapevamo che ti saresti sotterrato nella sabbia? Abbiamo trascorso un sacco di tempo a cercare te e i tuoi cavolo di pantaloni blu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130609,
					"content": "Dovresti pagarci il doppio delle spese di consegna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130610,
					"content": "Ah, se è così, mi dispiace tanto. Mi ero completamente scordato di quella nota... Avrei dovuto lasciare i pantaloni fuori, sarebbe stato più facile trovarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130611,
					"content": "Ma poi... per quale motivo ti sei sotterrato nella sabbia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "Perché è divertente! Ho sentito dire che è una cosa che fa la gente in vacanza, volevo provarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130613,
					"content": "Mmh, non stai sbagliando qualcosa? Sembri più una carota conficcata nel terreno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130614,
					"content": "Eh? È un... problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130615,
					"content": "Qualcuno potrebbe inciampare e finireste per farvi male entrambi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "Uhm, capisco... Ci penserò. Ed ecco il vostro compenso, raddoppiato! Grazie ancora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aqo"
				}
			]
		},
