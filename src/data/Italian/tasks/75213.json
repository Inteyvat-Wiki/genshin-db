				"points": []
			},
			"dialogs": [
				{
					"id": 752130201,
					"content": "Posso essere utile in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "Mh? Davvero? Beh, se proprio insisti... Abbiamo già inviato tutti i nostri dipendenti, ma c'è ancora un ordine urgente da consegnare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130203,
					"content": "La nota presente sull'ordine dice che va recapitato a un <color=#00E1FFFF>ospite coi pantaloni blu sulla spiaggia</color>. La cosa fondamentale è che arrivi in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130204,
					"content": "Ma grazie davvero per l'aiuto. Oltre al compenso per la consegna, vi darò anche la ricetta della nostra bevanda come ricompensa per averci aiutato. Conto su di voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hayaq"
				}
			]
		},
