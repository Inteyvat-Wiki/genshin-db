						752130503
					]
				},
				{
					"id": 752130503,
					"content": "Una bevanda gratis? Wow! Sembra che gli dèi abbiano ascoltato le mie suppliche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
