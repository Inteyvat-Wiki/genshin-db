			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#Oh oh! {F#Care}{M#Cari} {NICKNAME} e Paimon, siete proprio voi? Non credevo d'incrociarvi in un luogo tanto sperduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030102,
					"content": "Siete forse sulle tracce di qualcosa? Mi auguro non abbiate smarrito la strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030103,
					"content": "Stiamo solo dando un'occhiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "Ah, comprendo. In effetti, la mastodontica sagoma dell'Istituto di Progettazione sperimentale del Kuuvahki sprigiona una... maestosità insolita, quando la si ammira dal ponte di questo relitto... Ha quasi l'aura di un colosso addormentato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030106,
					"content": "Già. È super minaccioso anche visto da qui. Chissà quanti segreti si nascondono lì dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030107,
					"content": "Immagino possa essere una notevole fonte d'ispirazione per voi, considerato il vostro impegno attuale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030108,
					"content": "Dopotutto, le storie più affascinanti nascono sovente dall'interstizio tra la luce e il buio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030109,
					"content": "Hihihi, vedendoti qui in piedi con la tua fida lanterna blu in mano, questo posto sembra uscito direttamente dalla scena di un racconto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030110,
					"content": "A proposito, non dovresti essere di guardia a... ehm... quel posto? Sei in congedo, per caso? O magari di pattuglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030111,
					"content": "Entrambe le cose, direi. Lo scopo della vita di noi Ratniki è quello d'individuare ogni calamità che potrebbe emergere dalle ombre. Pertanto, siamo tenuti a restare vigili in ogni momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030112,
					"content": "Detto ciò, la situazione qui sembra stabile, non serve che vi preoccupiate. Potete dedicarvi liberamente ai vostri sforzi creativi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030113,
					"content": "Beh, visto che si è presentata l'occasione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "Una foto a me? Una richiesta inaspettata, devo dire. Confesso che non sono abituato a stare davanti a una Fotokamera... A essere l'osservato anziché l'osservatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030116,
					"content": "Probabilmente è perché mi sono abituato allo stare in compagnia di tombe silenziose e sussurri dei morti. Sicuramente capite cosa intendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030117,
					"content": "#D'altronde, sarebbe scortese rifiutare la richiesta di {F#amiche}{M#amici} come voi, un affronto all'ospitalità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030118,
					"content": "#Ergo, sentitevi {F#libere}{M#liberi} di immortalare tutto ciò che ritenete degno di ricordo. Esservi d'ispirazione, anche solo in minima parte, sarebbe per me un onore nonché un piacere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030114,
					"content": "Ti spiace se ti scattiamo una foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "E cercando soggetti da fotografare, già che ci siamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
