					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030702,
					"content": "Stiamo solo dando un'occhiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030704
					]
				},
				{
					"id": 765030704,
					"content": "Comprendo. Allora, mi auguro che questo quieto colosso possa esservi d'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030705
					],
