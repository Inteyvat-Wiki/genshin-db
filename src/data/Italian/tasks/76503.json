			"dialogs": [
				{
					"id": 765030801,
					"content": "A giudicare dalle vostre espressioni, state ancora cercando dei soggetti per le vostre foto, dico bene? Non preoccupatevi, avete ancora tutto il tempo... La scintilla dell'ispirazione a volte nasce tra gli anfratti più inaspettati, e questo vale per gran parte dei capolavori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030803,
						765030802
					],
					"speakerTitle": "Flins"
				},
				{
