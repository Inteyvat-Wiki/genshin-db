			"dialogs": [
				{
					"id": 765030701,
					"content": "#Guarda chi si vede, {NICKNAME} e Paimon! Siete forse sulle tracce di qualcosa? Mi auguro non abbiate smarrito la strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030702,
