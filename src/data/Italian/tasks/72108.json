			"dialogs": [
				{
					"id": 721080931,
					"content": "Cosa? Non avevo capito che fosse così importante. Avreste dovuto dirlo prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080932
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080932,
					"content": "Ufff, sono stato sigillato per questa storia per...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080933,
					"content": "Cento anni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "Umpf, non sminuire le mie disgrazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080937,
					"content": "Ma non importa, ormai è acqua passata. In effetti, ho anche qualche sospetto sulla barriera vicino alla foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080938,
					"content": "Una volta, all'epoca in cui combattevo quella subdola kitsune, l'ho vista sulla spiaggia orientale. Sembra un Sakura del tuono con un torii, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080939,
					"content": "Quando c'era quel tipo a combattere contro i demoni o non so cosa, preoccupandomi che uno di loro potesse venire a farci del male, ho usato la magia per sigillare il luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080940,
					"content": "#Vediamo... Il sigillo dovrebbe trovarsi sotto la scogliera rivolta a est... Kichiboushi, accompagnal{F#e}{M#i} a rimuovere il sigillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080941,
					"content": "Grazie, Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "Certo, certo. Basta con le chiacchiere, ora andate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080943,
					"content": "E se incontrate quella subdola kitsune, portatele i miei saluti. Ditele soltanto... fatemi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080944,
					"content": "\"Mi hai fatto arrabbiare sul serio stavolta, rompiscatole che non sei altro. Vieni ad affrontarmi, la gara non è ancora chiusa! E aiutami a rompere il sigillo, già che ci sei, no? Non che non possa farlo io, ma mi devi ancora un favore! Ah, Gyoubu Koban dice che gli manchi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080945,
					"content": "Wow, ma è lungo da ricordare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
