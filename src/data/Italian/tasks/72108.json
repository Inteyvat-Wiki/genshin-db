					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080801,
					"content": "Oooh... Vorrei tanto grattarmi la pancia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080802
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080802,
					"content": "#Mmmh? Siete già tornat{F#e}{M#i}? Aiutatemi a trovare Shousei, Gyoubu Koban e Kichiboushi, e andate a <color=#00E1FFFF>giocare con loro</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080803
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080803,
					"content": "Va bene allora, andate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				}
			]
		},
		{
			"id": 7210809,
			"completionStepIds": [
				7210807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210807",
							"2"
						],
						"stepId": 7210807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080901,
					"content": "Eheh, ben fatto! Sembrano molto felici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080902,
					"content": "Eh? Oh, non c'è problema. Lasciate che glielo chieda io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080903,
					"content": "Gyoubu Koban chiedeva: \"Se siete umani, perché avete l'odore dei tanuki?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080904,
					"content": "In effetti, è vero! Esigo una spiegazione! Perché avete l'odore dei tanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080905,
					"content": "Eh? Lo chiedi solo ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080906,
					"content": "È stata la sacerdotessa mascherata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "Giusto! È andata così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080909,
					"content": "La signorina sacerdotessa mascherata ci ha cucinato un pasto molto abbondante prima, e ha detto di aver usato la magia che ha imparato segretamente dai bake-danuki per prepararlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080910,
					"content": "Cosa? Ha imparato la nostra magia in segreto? Come osa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080911,
					"content": "Mmmh... Potrebbe essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080912,
					"content": "Oh, ma dai. Quella subdola kitsune! Se è ancora viva, avrebbe potuto almeno venire a salutarci, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080913,
					"content": "È una sacerdotessa con una maschera, e ti ha definito un \"vecchio amico\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080914,
					"content": "Maschera? Non conosco nessuno con la maschera. Non conosco nemmeno una sacerdotessa, ma di sicuro conosco una kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080915,
					"content": "Detto questo, quella subdola kitsune è già apparsa sotto forma di sacerdotessa. Che aspetto ha la sacerdotessa di cui parlate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080916,
					"content": "Indossa una maschera di volpe bianca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080917,
					"content": "Qualche altro particolare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080918,
					"content": "Ha i capelli neri e corti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "E indossa un abito da sacerdotessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080922,
					"content": "Mmmh... Non la conosco, ma non ho mai visto nessuno così in vita mia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080923,
					"content": "Davvero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080924,
					"content": "Mmmh? Sì, certo, me ne occupo io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080925,
					"content": "Shousei ha detto: \"È stato molto divertente giocare con voi. Grazie mille!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080926,
					"content": "Anche Paimon si è divertita un sacco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080927,
					"content": "Allora per quel pettine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "Insomma... Io sono il famoso bake-danuki Ioroi, e sicuramente manterrò la mia parola. Potete avere il pettine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080929,
					"content": "Ma cosa avete intenzione di farci? Probabilmente ha ancora l'odore di kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080930,
					"content": "Beh, questo è ciò che è successo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080920,
					"content": "È vestita come una sacerdotessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080921
					]
				},
				{
					"id": 721080921,
					"content": "E ha i capelli neri e corti!",
