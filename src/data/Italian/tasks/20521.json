				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "Come può partire all'avventura senza un po' di carburante...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210102,
					"content": "\"Carburante\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "Sì, del cibo caldo. Stavo parlando di Iris, l'esploratrice... Dovrebbe davvero mangiare un po' di cibo caldo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210104,
					"content": "Vuole organizzare una spedizione sulle montagne con una squadra di esploratori. Ma pensa di andarci prima da sola per esaminare le condizioni e poi elaborare un piano preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210105,
					"content": "L'accampamento non è poi così lontano, ed è abbastanza facile inviare delle scorte lassù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210106,
					"content": "Comunque, accamparsi sulla montagna, nella neve... Penso proprio che un piatto caldo le avrebbe dato l'energia di cui ha bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210107,
					"content": "In ogni caso, io non avrei il coraggio di fare un viaggio del genere... E tu? Potresti portare a Iris questo stufato di carne e verdure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210108,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210113,
					"content": "Il piatto è ancora bollente. Meglio se glielo porti in fretta. In queste condizioni, si raffredderà presto, e non varrà più la pena mangiarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210114,
					"content": "Comunque, nel peggiore dei casi, se lungo la strada ti trovi nei guai e il cibo diventa un danno collaterale, vieni qui e ne preparo dell'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210110,
					"content": "Dove posso trovarla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "Ha detto che l'accampamento è poco più in alto sulla montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210112,
					"content": "È un'avventuriera con molta esperienza, e fa sempre attenzione. Non sarà molto lontana dall'accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				}
			]
		},
		{
			"id": 2052102,
