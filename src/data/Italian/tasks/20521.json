			},
			"dialogs": [
				{
					"id": 205210201,
					"content": "#Mm? Che ci fai qui? Sei {F#un'esploratrice}{M#un esploratore} anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
