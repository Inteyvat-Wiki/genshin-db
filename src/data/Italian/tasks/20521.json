			]
		},
		{
			"id": 2052103,
			"completionStepIds": [
				2052103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2052103",
							"2"
						],
						"stepId": 2052103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "Questo stufato di carne e verdure è per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "Ah, dev'essere stato Harris a mandarti. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210303,
					"content": "Meglio se non mi abitui troppo ai suoi piatti deliziosi, o non riuscirò più a mangiare dei pasti sostitutivi disidratati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210304,
					"content": "Ahah, scherzo. In quanto avventuriera, so stringere i denti quando si tratta di cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210305,
					"content": "Salirai ancora più in alto sulla montagna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "Certo, quest'accampamento è solo una sosta. Aspetto il momento giusto per vedere se riesco ad allestirne uno più in alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210307,
					"content": "Sono abbastanza sicura che oltre quel punto non ci saranno più pasti caldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210308,
					"content": "Comunque, non avanzerò prima di essermi accertata che non ci siano pericoli. Dopo che avrò perlustrato la zona ancora un po', tornerò all'accampamento, redigerò un piano d'azione e poi prenderò una decisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210309,
					"content": "Ti ringrazio per aver fatto tutta questa strada solo per portarmi del cibo. Ecco, prendi questi in cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
