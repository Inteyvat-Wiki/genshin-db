				"points": []
			},
			"dialogs": [
				{
					"id": 220310401,
					"content": "*ansima* Le tua abilità sono ben oltre le mie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310402,
					"content": "La prossima volta mi tratterrò...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "No! Te ne prego, usa tutta la forza che hai. Senza allenamento, non migliorerò mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310404,
					"content": "#Forte come sei, devi esserti allenat{F#a}{M#o} a fondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310405,
					"content": "Perdonami se sono diretto, ma sono davvero curioso di sapere che tipo di addestramento hai seguito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310406,
					"content": "Un drago gigante mi ha aiutato ad allenarmi nel volo, una volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "Tu... hai volato insieme a un drago gigante? È inimmaginabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310410,
					"content": "Non è... niente di speciale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "Ahahah, sul serio? Allora il tuo dev'essere un autentico dono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310412,
					"content": "#Grazie per esserti allenat{F#a}{M#o} con me. Ricorderò ciò che mi hai insegnato. Per favore, prendi questo come compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310408,
					"content": "Un grande lupo mi aiuta a esercitarmi nelle arti marziali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "Devi avere molto coraggio. Mi piacerebbe tanto vedere te e il grande lupo combattere insieme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				}
			]
		},
