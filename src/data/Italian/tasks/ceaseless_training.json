			"dialogs": [
				{
					"id": 220310201,
					"content": "*sospira* Bene, ora basta con le chiacchiere. Non voglio farti sprecare altro tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2203103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "#Non sembravi concentrat{F#a}{M#o}: ti muovevi alla rinfusa e i tuoi attacchi erano incoerenti, a volte forti e a volte deboli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310302,
					"content": "Così non va. Per favore, prima preparati e poi riproviamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2203104,
			"completionStepIds": [
				2203104
			],
