			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310101,
					"content": "Fendente in avanti... Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310102,
					"content": "Sono qui per allenarmi di nuovo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "Oh! Sei tu. Hai di nuovo accettato il mio incarico? Ti sono grato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310104,
					"content": "Sono entusiasta di potermi allenare con una persona formidabile come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310105,
					"content": "Le tue abilità con la lancia sono migliorate molto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "Ahah... Ti piace scherzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310107,
					"content": "Da ciò che ho sentito, uno dei motivi per cui la lancia è stata inventata è che permette di combattere agevolmente a chi non sa come si tiene un'arma in mano, come il sottoscritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310108,
					"content": "Dopotutto, è un'arma lunga e affilata. Anche se chi la impugna non sa come usarla, sembrerà forte anche solo agitandola e infilzandoci qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310109,
					"content": "Tuttavia, stando a questo criterio... credo che l'umile forca da giardino, coi suoi tre rebbi, sia molto più potente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310110,
					"content": "Non hai già recuperato la tua arma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "L'ho recuperata, sì, ma ciò non significa che il mio addestramento sia finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310112,
					"content": "Ho già avuto degli screzi coi Kairagi. Sarebbe presuntuoso da parte mia pensare che non mi imbatterò in nemici ancora più forti, in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310113,
					"content": "Non lascerò mai che la mia arma cada di nuovo nelle mani del nemico e al mio onore di guerriero di essere infangato. È questa la via del samurai che voglio seguire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2203102,
