				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rikoru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "Cosa? Non mi disturbare. Sto pensando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450102,
					"content": "Sì, sto pensando a qualcosa di molto importante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450103,
					"content": "Di cosa si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450104,
					"content": "Hai visto il famoso Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450105,
					"content": "È l'edificio più alto dell'intero paese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450106,
					"content": "Per cui stavo pensando che potrei costruirne uno ancora più alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450107,
					"content": "Ma è così alto per illuminare tutta Byakuyakoku, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450108,
					"content": "Perché tu dovresti costruire un edificio tanto alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450109,
					"content": "Per mostrare a tutti la mia gloria, naturalmente! La gloria di Rikoru il Grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450110,
					"content": "E per far capire ad Aberaku chi comanda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450111,
					"content": "Sai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "Esatto. Lui è il creatore del Dainichi Mikoshi, nonché colui che ha salvato Byakuyakoku. Lo ammiravo molto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450114,
					"content": "Ma a quanto pare, mirava a conquistare il trono. Se non fosse stato per quegli adulti, ora sarei morto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450115,
					"content": "Ecco perché costruirò un edificio più alto del Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450116,
					"content": "Q-Quanto tempo ci vorrà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450117,
					"content": "Perché dovrebbe importarmi?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450118,
					"content": "Il popolo di Byakuyakoku dovrebbe solo essere felice che io chieda loro di costruire una tale meraviglia storica per me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450119,
					"content": "Basta così! Non voglio essere disturbato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450120,
					"content": "Lasciatemi pensare. Se le travi sono così lunghe... Se lo costruiamo in questo modo, la struttura portante e la giuntura del legno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450112,
					"content": "Aberaku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
			"id": 7224502,
			"completionStepIds": [
				7224502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224502",
							"2"
						],
						"stepId": 7224502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isumenasu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "Mmm? Non ho mai visto una persona vestita in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450202,
					"content": "Per caso vieni... ehm, dall'altra parte dei cieli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450203,
					"content": "Oh, quindi c'è dell'altro oltre la nostra gloriosa nazione! Bene. Consegnami la tua mappa e lascia che la esamini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450204,
					"content": "(Gli consegni la tua mappa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "Ah, molto interessante. Non solo le formazioni del terreno sono accuratamente disegnate, ma si possono vedere persino i percorsi delle montagne e dei fiumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450206,
					"content": "Bene, allora. Quanto è grande questa nazione che chiamate Teyvat, rispetto a Byakuyakoku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450207,
					"content": "Teyvat è un vero e proprio continente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450208,
					"content": "Inoltre, Enkanomiya... Cioè, Byakuyakoku, è questa piccola zona nell'estremità in basso sulla mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450209,
					"content": "Che assurdità! Le nostre terre sono immense! Com'è possibile che occupino uno spazio così minuscolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450210,
					"content": "Questa mappa sarà anche splendidamente disegnata, ma è una frode vera e propria. Portatela via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450211,
					"content": "E pensare che per un momento ho perfino provato dell'ammirazione per questa buffonata da quattro soldi... Poveri i miei occhi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450212,
					"content": "Beh, fa' come ti pare, ragazzino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224503,
			"completionStepIds": [
				7224503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
