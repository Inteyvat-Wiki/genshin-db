				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Risutaiosu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "Non ti muovere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450402,
					"content": "Oh, smettila! Ti ho detto di non muoverti, mi hai sentito?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450403,
					"content": "Ehm, Paimon non può smettere di muoversi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450404,
					"content": "Non credo che qualcuno abbia mai chiesto a Paimon di non muoversi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				},
				{
					"id": 722450406,
					"content": "Non se ne parla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450407,
					"content": "Uff, va bene, allora girati. Non ho mai visto degli abiti del genere in tutta la mia vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450408
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450408,
					"content": "Non sono propriamente gradevoli esteticamente, ma in un certo senso sono affascinanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450409
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450409,
					"content": "Se non ti piacciono, perché li stai guardando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450410,
					"content": "Scherzi, vero? È stato più facile chiedere a quelle serve di farmi da modelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450411
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450411,
					"content": "E poi, mi sono stufato di guardare quello che indossano le persone di qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450412
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450412,
					"content": "Perlomeno vedo qualcosa di diverso, finalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450413
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450413,
					"content": "Mmm, capisco. Quindi è così che vengono realizzati questi vestiti... Wow, non sapevo che gli stranieri fossero così sfacciati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450414
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450414,
					"content": "Capisco, capisco... Quindi, se i vestiti vengono fatti così, allora la forma del corpo dovrebbe essere... questa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450415
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450415,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450416,
					"content": "Una statua. Mescolo l'argilla con l'acqua, poi modello il tutto con entrambe le mani. È una delle poche cose che riesce a calmarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450417
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450417,
					"content": "Sai invece cosa non mi calma per niente? Starmene seduto durante le riunioni a leggere ad alta voce basata su roba scritta dagli adulti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450418
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450418,
					"content": "Beh, pazienza. Ho finito di prenderti le misure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450419
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450419,
					"content": "Ora puoi andare. Avrai delle faccende da sbrigare, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450405,
					"content": "E se cadessi, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				}
			]
		},
		{
			"id": 7224505,
			"completionStepIds": [
				7224505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224505",
							"2"
						],
						"stepId": 7224505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ion",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450501,
					"content": "#Oh-oh, hai proprio l'aspetto di una persona interessante, viaggiat{F#rice}{M#ore}. Potrei provare a predire il tuo futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450502
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450502,
					"content": "Dopotutto, sono Ion: non sbaglio mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450503
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450503,
					"content": "Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450504,
					"content": "Sembri un imbroglione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450505,
					"content": "(Paimon ricorda cosa c'è scritto sulla sua lapide...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450506,
					"content": "Oh, andiamo, perché hai quello sguardo? Io leggo sempre il futuro della gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450507
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450507,
					"content": "Detto ciò... Poche persone di Byakuyakoku hanno un destino felice che le attende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450508
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450508,
					"content": "Per cui spesso le inganno, dicendo loro che presto la fortuna girerà dalla loro parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450509
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450509,
					"content": "In questo modo, posso regalare loro un po' di felicità, perlomeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450510
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450510,
					"content": "Ed è per questo che si è sparsa la voce che non sono in grado di predire il futuro. Ah, che tristezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450511
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450511,
					"content": "È così che stanno le cose, quindi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450512,
					"content": "Esatto, e posso dimostrartelo proprio ora, piccoletta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450513
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450513,
					"content": "Oh, certamente! Paimon vuole provare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450514,
					"content": "Mmm, va bene... Facciamo un tentativo... Ehm... Perché ci sono così tante interferenze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450515
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450515,
					"content": "Eh?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450516
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450516,
					"content": "C-Che succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450517,
					"content": "Io... non riesco a leggere il tuo futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450518
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450518,
					"content": "Com'è possibile? Posso commettere degli errori ogni tanto, ma non mi è mai capitato di non riuscire a leggere il futuro di una persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450519
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450519,
					"content": "Beh, suppongo che tu non sia poi così bravo, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450520,
					"content": "Forse no. Immagino che dovrò continuare i miei studi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ion"
				}
			]
		},
		{
			"id": 7224506,
