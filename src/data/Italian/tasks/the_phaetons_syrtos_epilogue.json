			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piramumon",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "#Oh-oh! A giudicare dal tuo aspetto, devi essere {F#una}{M#un} viaggiat{F#rice}{M#ore} di un'altra nazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450602,
					"content": "Di dove siete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450603,
					"content": "Veniamo da Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450604,
					"content": "Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450605,
					"content": "Descrivi a Piramumon il paesaggio di Mondstadt in modo molto semplice...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "Non ho mai sentito parlare di questa città. Non immaginavo che esistesse un luogo del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450607,
					"content": "Ahahah, lo sapevo! Il mondo non poteva essere solo Byakuyakoku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450608,
					"content": "Voglio dire, se Byakuyakoku fosse tutto quello che c'è al mondo, sarebbe un mondo davvero molto solitario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450609,
					"content": "Inoltre, i testi antichi parlano di tempi precedenti alla fondazione della nostra nazione. È stato allora che ho cominciato a capire che c'erano altre terre oltre alla nostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450610,
					"content": "Tuttavia, avevo ancora paura, sapete? Paura che là fuori non ci fosse davvero nient'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450611,
					"content": "#Non immagini, viaggiat{F#rice}{M#ore}, quanto il tuo arrivo abbia riempito il mio cuore di gioia. Ahah, ciò significa che esistono tanti altri posti incantevoli da visitare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450612,
					"content": "È un peccato che debba partecipare al Rito del ritorno al sole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450613,
					"content": "#Perché non mi racconti come sei arrivat{F#a}{M#o} qui, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450614,
					"content": "Quando il rituale sarà terminato, troverò un modo per sgattaiolare fuori dal Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450615,
					"content": "E potremmo berci del succo di frutta insieme, piuttosto! Ahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piramumon"
				}
			]
		},
		{
			"id": 7224507,
			"completionStepIds": [
				7224507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
