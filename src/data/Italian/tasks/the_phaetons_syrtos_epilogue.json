			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orupeusu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450701,
					"content": "#*sospira* E così tu sei {F#la}{M#il} viaggiat{F#rice}{M#ore} che viene da molto lontano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450702,
					"content": "Cosa stai cercando? Vederti camminare verso di me è stato molto doloroso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450703,
					"content": "Doloroso? Perché mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450704,
					"content": "Per un cantante, tutto in questo mondo è motivo di dolore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450705,
					"content": "Laddove c'è un incontro, ci sarà una separazione e, un giorno, coloro che sono nati torneranno alla terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450706,
					"content": "#Gli incontri sono troppo brevi per alleviare il dolore delle lunghe separazioni... E per quanto ti riguarda, viaggiat{F#rice}{M#ore}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450707,
					"content": "Solo chi è alla ricerca di qualcosa viaggia in un altro regno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450708,
					"content": "La gente del posto, che vive qui da molto tempo, considererebbe romantico un tale viaggio, ma per la persona che viaggia potrebbe significare un dolore indescrivibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450709,
					"content": "#Se tu fossi venut{F#a}{M#o} in altri tempi, avrei potuto cantarti una canzone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450710,
					"content": "Ma ho prestato giuramento a una persona che non canterò più finché non sentirò la sua voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450711,
					"content": "Posso solo augurarti buona fortuna, anche se sembri molto più grande di me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450712,
					"content": "Spero che il tuo desiderio possa realizzarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orupeusu"
				}
			]
		}
	]
}