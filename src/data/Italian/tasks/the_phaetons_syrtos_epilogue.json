			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Surepio",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "#Viaggiat{F#rici}{M#ori} di terre lontane... *tossisce* Sembrate piuttosto stanch{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450302,
					"content": "È un brutto segno. Molte malattie iniziano con la spossatezza, lo sapevate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450303,
					"content": "Occorre dormire a sufficienza, in modo che... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450304,
					"content": "*tossisce* *tossisce*... possiate crescere in salute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450305,
					"content": "Neanche tu hai un bell'aspetto, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450306,
					"content": "Ahah, è una mia vecchia malattia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450307,
					"content": "#Un'anima sana ha bisogno di un corpo sano, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450308,
					"content": "*sospira* Se solo avessi avuto più tempo... Sarei diventato il miglior medico del mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450309,
					"content": "E così, sarei stato in grado di uscire dalla mia stanza e giocare a mio piacimento, anche in questo corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Surepio"
				}
			]
		},
		{
			"id": 7224504,
			"completionStepIds": [
				7224504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224504",
