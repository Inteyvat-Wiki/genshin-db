			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME} e Paimon. Eccovi qua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270402,
					"content": "Eh? Lingyuan? Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270403,
					"content": "Non riesco a entrare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270404,
					"content": "Non riesci a entrare? Ahem, e dove?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270405,
					"content": "Al Riposo della Carpa, dove sta riposando Fujin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270406,
					"content": "Il Riposo della Carpa... Oh! Intendi il luogo dove Fujin ci ha portato prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270407,
					"content": "È una dimora sigillata dalla sua energia adeptica. Io non la possiedo, quindi non posso raggiungerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270408,
					"content": "Eh? Ma non hai detto nulla prima che andasse a riposare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270409,
					"content": "Mi è sfuggito di mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270410,
					"content": "Serve una mano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "L'energia adeptica che possiedi è sufficiente ad aprire la porta del Riposo della Carpa. Quindi sì, mi servirebbe una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270416,
					"content": "Eh? Un momento... Quindi sei stata qui ad aspettarci per tutto questo tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270417,
					"content": "Non stavo aspettando voi. Cercavo un modo per entrare nel Riposo della Carpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270418,
					"content": "Paimon non ci vede molta differenza... Ah, a proposito, anche noi siamo un pochino in pensiero per le condizioni di Fujin. Perché non le facciamo visita assieme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270419,
					"content": "Va bene, grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270420,
					"content": "Seguitemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270412,
					"content": "Un pochino tardi, \"Azzurrina\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "Già, come hai potuto dimenticare qualcosa di tanto importante?! Pazzesco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270414,
					"content": "È perché sono una bestia dura di comprendonio. Guardandola mi vengono in mente molte cose, ma ne dimentico altrettante. È colpa mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270415,
					"content": "L'energia adeptica che possiedi è sufficiente ad aprire la porta del Riposo della Carpa. Quindi sì, mi servirebbe una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
		{
			"id": 7112705,
			"completionStepIds": [
				7112704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
