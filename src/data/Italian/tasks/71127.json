					],
					"speakerTitle": "Piccolo Mao"
				},
				{
					"id": 711271302,
					"content": "Azzurrina mi ha già raccontato tutto! Dato che ti piace il tè, ho chiesto a Nonno Lu di prepararti dei deliziosi dolcetti da tè!",
					"roleType": "TALK_ROLE_NPC",
