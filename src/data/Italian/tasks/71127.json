	"talks": [
		{
			"id": 7112703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112708",
							"2"
						],
						"stepId": 7112708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fujin",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270301,
					"content": "A proposito, Fujin... Questa dovrebbe essere la tua dimora, giusto? Sembra diversa dalle dimore degli altri Adepti... Come potrebbe dire Paimon...? Ha un aspetto più... pragmatico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270302,
					"content": "Non ci sono strani meccanismi né ponti sospesi invisibili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270303,
					"content": "Sono molto dispiaciuta... Prima ero troppo imbarazzata per spiegarlo chiaramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270304
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270304,
					"content": "Non posso creare nuovi regni adeptici come gli Adepti del Sud. Il \"Riposo della Carpa\" non è una \"dimora\", al massimo si può considerare una \"grotta\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270305
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270305,
					"content": "Grotta, regno... Chiamala come vuoi! Sono tutte \"dimore\" in cui abitano gli Adepti, no? Comunque, ancora non sappiamo quando potrai assumere nuovamente la tua forma umana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270306,
					"content": "Tutto il potere che ha accumulato si è disperso in queste terre. Non sarà in grado di tornare alla sua forma umana per qualche tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270307,
					"content": "È capitato anche a me quando ho esaurito il mio potere. Quando la Maestra morì cominciò a cadere la neve, e cadde ancora una volta dopo essersi sciolta. Successe innumerevoli volte, prima che potessi riacquisire la mia forma umana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270308
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270308,
					"content": "Oh, quindi è così... eh? Aspetta un momento, Lingyuan, puoi trasformarti anche tu in una persona?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270309,
					"content": "Beh, ovvio! Ci sono molte cose che non sapete! Un tempo l'aspetto di Lingyuan sul Monte Yaojun era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270310
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270310,
					"content": "Fujin, non c'è bisogno di parlare di certe cose. Ora non hanno nulla a che vedere con l'argomento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270311,
					"content": "Eh? Quindi tutta quella storia di aver mangiato troppi dolcetti da tè alla fiera del tempio in forma umana, e di aver implorato la Signora delle erbe di preparare del tè dimagrante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270312
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270312,
					"content": "O l'aver bevuto per sbaglio le libagioni cerimoniali e aver chiesto ai cinghiali della foresta: \"Chi è più bella? Io o la Signora delle erbe?\"... Ah! Ma non dovevo parlare di certe cose, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270313
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270313,
					"content": "...Fujin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270314
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270314,
					"content": "Wow! Ora che ha sentito tutte queste cose, Paimon è curiosa: com'è la tua forma umana, Lingyuan? Resti blu come adesso? Oppure... Uh, più tendente al celeste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270315,
						711270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270315,
					"content": "#Ora sono {F#curiosa}{M#curioso} anch'io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270316
					]
				},
				{
					"id": 711270316,
					"content": "#Non comprendo la vostra curiosità, visto che siete delle persone anche voi. Se v'interessano le forme umane, basta che guardiate voi {F#stesse}{M#stessi}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270321,
					"content": "#Eheh... Comunque sia, grazie, {NICKNAME} e Paimon. Non avrei mai immaginato che sarebbe arrivato il giorno in cui avrei potuto parlare così con gli altri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270322
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270322,
					"content": "*tossisce* Se costei si è ritrovata in un tale stato d'animo, costei è disposta a proteggervi durante il vostro viaggio, e garantirvi successo e fortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270323
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270323,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270324,
					"content": "...Chiedo scusa, mi sono lasciata trasportare. Volevo cercare di sembrare come una certa Adepta, così ho pensato di provare un paio di frasi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270325
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270325,
					"content": "A ogni modo! Starò qui e pregherò affinché il vostro viaggio vada bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270317,
					"content": "Lingyuan... Potresti diventare umana, giusto per un secondo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270318
					]
				},
				{
					"id": 711270318,
					"content": "Assolutamente no. I corpi umani sono deboli. Non hanno zanne per dilaniare le prede, né artigli per cacciare i nemici. Non lo farò a meno che non me lo ordini Fujin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270319,
					"content": "...Eh? Davvero? I-In tal caso, penso che dovremmo rispettare i desideri di Lingyuan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270320
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270320,
					"content": "Io non ho nessun desiderio. Se tu ne hai, dimmelo apertamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270321
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
