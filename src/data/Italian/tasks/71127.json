			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccolo Mao",
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711270901,
					"content": "Azzurrina, Azzurrina, non mi hai detto come finisce la storia che stavi raccontando l'ultima volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270902
					],
					"speakerTitle": "Piccolo Mao"
				},
				{
					"id": 711270902,
					"content": "Sì, ricordo. Ma ho cambiato idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270903
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270903,
					"content": "\"Cambiato idea\"? In che senso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270904
					],
					"speakerTitle": "Piccolo Mao"
				},
				{
					"id": 711270904,
					"content": "Lascerò che sia tu a deciderne il finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270905
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270905,
					"content": "Ehhh? Dai, Azzurrina, questo è barare! Avevi promesso che se ti avessi raccontato una storia tu avresti fatto altrettanto! Perché alla fine devo raccontarle entrambe io?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270906
					],
					"speakerTitle": "Piccolo Mao"
				},
				{
					"id": 711270906,
					"content": "Non sono che una bestia sempliciotta. Non riesco a trovare un lieto fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270907
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270907,
					"content": "Il finale a cui avevo pensato era brutto. Anche la storia è brutta, e non rallegrerebbe nessuno... Quindi lascio il finale a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270908
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270908,
					"content": "Ma è comunque barare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270909
					],
					"speakerTitle": "Piccolo Mao"
				},
				{
					"id": 711270909,
					"content": "Non lo nego. Per compensare, posso portarti ad ammirare i panorami nascosti del Monte Lingmeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270910
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270911
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270911,
					"content": "Non fare quella faccia. Avrai il permesso speciale di... sederti sul mio dorso per cinque minuti circa. Anche dieci, se vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270912
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270912,
					"content": "In... In tal caso, affare fatto! Penserò a un finale per la storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Mao"
				}
			]
		},
		{
			"id": 7112710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112710",
							"2"
						],
						"stepId": 7112710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lingyuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711271001,
					"content": "Uh? Lingyuan, sei tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271002,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271003
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271003,
					"content": "Oh, scusa! Stai cacciando? Ti abbiamo disturbata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271004,
					"content": "Non sto cacciando e non mi avete disturbata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271005
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271005,
					"content": "Uh... Allora ti stai solo... distraendo un po'? Stai pensando a qualche bel manicaretto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271006,
					"content": "Non stavo pensando a te. Stavo riflettendo e basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271007
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271007,
					"content": "Non stavi pensando a... Ehi! Cosa vorresti dire esattamente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271008,
					"content": "#Sto pensando alla domanda di {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271009
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271009,
					"content": "\"Se le attività umane fanno parte delle leggi della natura, come considereresti l'umanità?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271010
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271010,
					"content": "Da quando Fujin e il serpentello se ne sono andati, non ho più avuto contatti con gli umani dell'insediamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271011
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271011,
					"content": "Ehi, da come lo dici sembra che il Piccolo Mao non sia umano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271012,
					"content": "#Il Piccolo Mao è un umano che appartiene agli umani dell'insediamento, ma non è un umano dell'insediamento. Tu e {NICKNAME} siete {F#compagne}{M#compagni} di viaggio, ma tu non appartieni a {NICKNAME}. La differenza è questa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271013,
						711271015
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271013,
					"content": "Secondo te il Piccolo Mao non fa parte dell'ordine sociale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271014
					]
				},
				{
					"id": 711271014,
					"content": "Non ancora del tutto. Molti giovani umani sono così finché non vengono completamente assorbiti dall'ordine, proprio come succede con la natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271017
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271017,
					"content": "Non ho contatti con gli umani dell'insediamento da troppo tempo. Sarà per via dell'odio o della paura, o forse per entrambi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271018,
						711271019
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271018,
					"content": "Perché hanno invaso le terre che appartengono alla natura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271020,
					"content": "Non lo so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271021
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271021,
					"content": "O forse non esistono differenze evidenti che separino \"noi\" da \"loro\", ma non posso essere certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271022
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271022,
					"content": "I giovani umani camminano al mio fianco. Similmente, un giovane della mia specie cammina incuriosito al fianco degli umani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271023
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271023,
					"content": "Eh? Un giovane della tua specie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711271024,
					"content": "Il bambino ha incontrato un mortale sulle montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271025
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271025,
					"content": "Di conseguenza, non so ancora rispondere alla tua domanda. Dovrò continuare a osservare l'umanità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271026
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271026,
					"content": "Ci sono molte cose che non comprendo, ma ci proverò fino a quando non avrò risposto alla tua domanda, come promesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711271019,
					"content": "Perché Fujin ha scelto di sacrificarsi per loro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271020
					]
				},
				{
					"id": 711271015,
					"content": "Non ci metterei la mano sul fuoco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711271016
					]
				},
				{
					"id": 711271016,
					"content": "Ehi! Non dire cose strane!",
