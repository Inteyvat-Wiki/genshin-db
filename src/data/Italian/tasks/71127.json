			},
			"dialogs": [
				{
					"id": 711270501,
					"content": "#Eh? {NICKNAME}, Paimon e Lingyuan? Cosa ci fate qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270502
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270502,
					"content": "Woah, è la voce di Fujin! E proviene dal... sottosuolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270503,
						711270505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270503,
					"content": "#Sono un po' {F#preoccupata}{M#preoccupato} per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270504
					]
				},
				{
					"id": 711270504,
					"content": "#Proprio così! Siamo {F#tutte preoccupate}{M#tutti preoccupati} per la tua salute, così siamo {F#venute}{M#venuti} qui senza preavviso... Ma tu hai fatto lo stesso con noi, quindi Paimon pensa che siamo pari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270509,
					"content": "#Eh? Ah! Scusate! Quando sono tornata qui per riposare ho dimenticato di lasciare aperta la porta... Mi dispiace moltissimo, siete {F#venute}{M#venuti} a trovarmi e io invece vi ho reso il tutto più difficile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270510,
					"content": "Ah, nessun problema! Ma perché ti stai... ahem, nascondendo in una pozza d'acqua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270511,
					"content": "Mmm, come potrei spiegarlo...? Perché non posso ancora tornare alla mia forma preferita, e farmi sempre vedere da voi nella mia forma di carpa mi... imbarazza non poco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270512,
						711270513
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270512,
					"content": "Sei consapevole del fatto che l'abbiamo già vista un sacco di volte, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270514,
					"content": "Ahahah... Ma prima potevo assumere forma umana quando volevo, così credevo che spostarmi sotto forma di carpa potesse venirmi comodo. Ma adesso non ho altro che questo aspetto viscido, quindi mi viene un pochino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270515
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270515,
					"content": "Woah, sei parecchio testarda... Comunque sia, ciò che conta è che tu stia bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270516,
					"content": "Ma Lingyuan ha detto che la tua energia adeptica non si era esaurita, ma che si era solo dispersa tra le montagne, le foreste e i fiumi della Vallata Chenyu, ed è per questo che ti sei indebolita così tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270517,
					"content": "Quindi se riuscissimo a raccogliere l'energia adeptica dispersa, proprio come quando dovevamo cercare la Carpa dorata nella Valle Yaodie, ti sentiresti meglio, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270518,
					"content": "Sì... In teoria è corretto, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270519,
					"content": "Giusto, giusto? Quindi se vedessimo delle carpe di quel tipo, dovremmo semplicemente riportarle qui! In quel modo, ti riprenderesti più rapidamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270520,
					"content": "S-Sarebbe troppo disturbo per voi! Il mio potere non è ancora così debole, basterà che mi riposi qui per qualche tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270521
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270521,
					"content": "Non è un disturbo per noi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270522
					]
				},
				{
					"id": 711270522,
					"content": "...Terremo gli occhi aperti, magari riusciamo a trovarne qualcuna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270523
					]
				},
				{
					"id": 711270523,
					"content": "Allora grazie. Tuttavia, non voglio davvero disturbarvi ulteriormente. Avete già fatto tanto per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270524,
					"content": "Se doveste trovare altra energia adeptica durante i vostri viaggi, vi prego di trasferirla semplicemente in questa giada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270525
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270525,
					"content": "Sebbene l'equilibrio tra acqua e suolo sia stato ripristinato, se riusciremo ad aggiungere più potere alla Giada pluviale ci assicureremo un clima favorevole e anni prosperi a venire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270526,
					"content": "...Quanto a te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270527
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270527,
					"content": "Ancora?! Te l'ho già detto, devo solo riposarmi qui per un po'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270528,
					"content": "#{NICKNAME}, Paimon, vi sono molto grata per avermi fatto visita. Ne sono davvero felice. Da quando la Signora delle erbe se n'è andata, questa è la prima volta che qualcuno viene qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270529
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270529,
					"content": "E grazie anche a te, Lingyuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270530,
					"content": "Non ho fatto nulla di speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270531
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270531,
					"content": "#Bene, basta così! Consideralo un ringraziamento per aver portato qui {NICKNAME} e Paimon, davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270532,
					"content": "#E infine... Grazie ancora, {NICKNAME} e Paimon, per tutto quello che avete fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270513,
					"content": "Non c'è motivo di nasconderti qui, non trovi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270505,
					"content": "Lingyuan è un po' in pensiero per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270506
					]
				},
				{
					"id": 711270506,
					"content": "Non è vero, è solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270507
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270508
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270508,
					"content": "#Sì! Lingyuan è così preoccupata per la tua salute che non riesce quasi a parlare, così siamo {F#venute}{M#venuti} qui senza preavviso... Ma tu hai fatto lo stesso con noi, quindi Paimon pensa che siamo pari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7112709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
