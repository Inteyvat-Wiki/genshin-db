			"dialogs": [
				{
					"id": 711271101,
					"content": "Ad ascoltare Montagna, sembra che le opere di Fontaine siano piuttosto simili alle nostre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271102
					],
					"speakerTitle": "Piccolo Mao"
				},
				{
					"id": 711271102,
					"content": "Cavalieri, maghi, guerrieri coraggiosi e draghi malvagi, voi uccidete me e io uccido voi. Alla fine, saremo tutti morti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271103
					],
					"speakerTitle": "Piccolo Mao"
				},
				{
					"id": 711271103,
					"content": "Non è il finale che conta! È il processo, il modo in cui ci si arriva! Non tutte le tragedie possono ridursi a una mera sequenza di scene di combattimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271104
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711271104,
					"content": "Oh oh! E anche i Golem di Remuria di cui parlava Montagna sembrano davvero una forza della natura! Mi chiedo se siano più grandi di Azzurrina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271105
					],
					"speakerTitle": "Piccolo Mao"
				},
				{
					"id": 711271105,
					"content": "Eh? Azzurrina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711271106
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711271106,
					"content": "Ah, giusto! Non ti ho mai parlato di Azzurrina, vero? Cosa ne dici di parlarmi un po' dei Golem di Remuria e io, in cambio, ti racconto di Azzurrina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Mao"
				}
			]
