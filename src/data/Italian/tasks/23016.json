				{
					"id": 230165001,
					"content": "Signore, suggerisco umilmente che forse dovremmo... cambiare il nostro approccio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165002,
					"content": "Cambiare il nostro approccio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165003,
					"content": "Forse dovremmo creare qualcosa di meno complicato, ma comunque intricato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165004,
					"content": "Credo che con il suo talento, creare macchine del genere dovrebbe essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165005,
					"content": "Mio caro Lutong, ne abbiamo già parlato. Conosci la mia risposta... ma rispetterò sempre le tue scelte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165006,
					"content": "Forse invece dovremmo discutere dove cenare con la signorina Kaia la prossima volta, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165007,
					"content": "Ah, ti ringrazio, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165008,
					"content": "È un piacere, signore. Il nostro contratto non è ancora finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
