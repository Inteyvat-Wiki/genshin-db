			"dialogs": [
				{
					"id": 230160301,
					"content": "Lutong! Questo ingranaggio è pronto per essere sformato! Vieni ad aiutarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160302,
					"content": "#Viaggiat{F#rice}{M#ore}, sei qui. Allora, il signor Ahangar ti ha insegnato ciò che sa, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Garcia"
				},
				{
