					"nextDialogs": [
						230165103
					]
				},
				{
					"id": 230165103,
					"content": "Da un po', direi. È persino più appassionato di alcuni dei miei apprendisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165104
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165104,
					"content": "Ma non sembra qualcuno che vuole diventare un fabbro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165105,
					"content": "Qualcun altro ha fatto loro visita oltre a me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165106
					]
				},
				{
					"id": 230165106,
					"content": "Mmh... C'è una donna che va spesso da loro, e porta molte cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165107,
					"content": "Mi ha detto che si chiama Kaia... O qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165108,
					"content": "Non capisco. Queste persone non sono fabbri, quindi perché dovrebbero aggirarsi per la mia fucina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				}
