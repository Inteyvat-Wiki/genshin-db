					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230163902
					]
				},
				{
					"id": 230163902,
					"content": "Ah! Vittoria! Questo ingranaggio sembra perfetto, se posso dirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163903,
					"content": "Lo spazio fra i denti... lo spessore... la misura... Ah, devo prendere un righello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163904,
					"content": "#Sarà meglio lasciare il signor Garcia alle sue misurazioni. Viaggiat{F#rice}{M#ore}, ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163905,
					"content": "Sei ancora... cautamente pessimista?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "Sì, lo sono sempre stato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163907,
					"content": "È da tempo che io e il signor Garcia abbiamo di fronte una grande sfida, e finalmente abbiamo rimosso il primo ostacolo per superarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163908,
					"content": "Anche se non sappiamo ancora come arrivare al traguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163909,
					"content": "Spero che il talento del signor Garcia ci porti sulla strada giusta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163910,
					"content": "O dovrò ripetermi che \"la migliore via d'uscita è sempre attraverso\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
