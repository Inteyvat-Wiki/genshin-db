			"dialogs": [
				{
					"id": 766770101,
					"content": "#{F#Cavaliere Onoraria}{M#Cavaliere Onorario}! Grazie a te, questo avamposto comincia a essere più presentabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766770102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766770102,
					"content": "...Adesso, anche se veniamo attaccati mentre tutto l'accampamento è ubriaco fradicio, riusciremo a resistere finché non mi sarà passata la sbornia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766770103
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766770103,
					"content": "Stai scherzando di nuovo. Vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766770104
					]
				},
				{
					"id": 766770104,
					"content": "#Mi hai letto nei pensieri? Riesci a leggermi come un libro aperto, {F#Cavaliere Onoraria}{M#Cavaliere Onorario}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766770105
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766770105,
					"content": "#Ci siamo {F#abituate}{M#abituati} alle tue fesserie, piuttosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766770106
					],
					"speakerTitle": "Paimon"
				},
				{
