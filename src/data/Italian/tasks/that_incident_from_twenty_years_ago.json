			"dialogs": [
				{
					"id": 735200301,
					"content": "C'è un buco nell'albero. Sembra completamente vuoto e non c'è niente dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200302,
					"content": "Eh? Guarda! C'è un biglietto lì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200303,
					"content": "\"Il Nara buono ha insegnato a leggere ad Arakasyapa. Arakasyapa deve proteggere il Nara buono...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200304,
					"content": "Che significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7352022,
