			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kashmer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "\"Quell'incidente di vent'anni fa\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "...Non avrei dovuto dirlo a nessuno. L'ultima volta ho bevuto troppo e hanno cominciato a uscirmi troppe parole di bocca, e ora la gente mi cerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200205,
					"content": "Vista la vostra curiosità, ve lo dirò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200206,
					"content": "Vent'anni fa, ero un ragazzino di sei anni e non ricordo bene cosa accadde allora. Recentemente, invece, ho letto il diario di quando ero bambino e mi ricordai a malapena della situazione del tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200207,
					"content": "Il Campionato interdarsana si tenne anche quell'anno. Ci furono tre incontri, l'ultimo dei quali si tenne fuori città. Pregai mia mamma perché mi ci portasse, e quando lei si rifiutò, io scappai di nascosto a vederlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200208,
					"content": "E poi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200209,
					"content": "Finii col perdermi fuori dalla città. Ero in mezzo al nulla, non c'era nessuno. Mi spaventai sempre di più e iniziai a piangere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200210,
					"content": "Fu allora che vidi delle strane creature... Non ricordo il loro aspetto... ma solo che, da bambino, alla loro vista smisi subito di piangere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200211,
					"content": "Delle strane creature... Devono essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200212,
					"content": "(Gli Aranara.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "Mi portarono all'incontro. Sfortunatamente, quando arrivammo, era troppo tardi. L'incontro era già finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200214,
					"content": "Proprio quando venni preso dallo sconforto, all'improvviso vidi una di quelle strane creature che trascinava una corona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200215,
					"content": "Era una bellissima corona che luccicava al chiaro di luna, e non potei fare a meno di seguirla. Vidi il piccoletto nascondere la corona in un albero cavo e poi sparire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200216,
					"content": "Volevo toccare la corona. Ma in quel momento sentii le grida lontane di mia madre. Aveva scoperto che ero scappato e aveva chiesto ai vicini di aiutarla a cercarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200217,
					"content": "Non toccai la corona fin quando non fui più grande e vidi il \"Diadema dello Scibile\" al Campionato interdarsana. Mi resi conto che era la stessa cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200218,
					"content": "Ok... Ricordi dov'è finito il diadema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200219,
					"content": "Probabilmente è nella Selva di Avidya, ma sono tornato un paio di volte e non ho mai trovato niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200220,
					"content": "Nessuno mi crederebbe, se glielo raccontassi. Ahimè, neanche la mia memoria è proprio perfetta. Forse è stato un sogno che ho fatto da bambino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200221,
					"content": "#Bene... Andiamo a controllare, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
