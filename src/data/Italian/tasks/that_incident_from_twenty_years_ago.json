			"dialogs": [
				{
					"id": 735200101,
					"content": "Hai deciso di comprare informazioni da me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200102,
					"content": "Mmh... Paimon è curiosa di sapere le tue informazioni esclusive, ma vogliamo prima sentire il prezzo! Se sono troppo costose, non ci pensare neanche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200103,
					"content": "Te le venderò al prezzo fisso di un milione di Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200104,
					"content": "Ma è troppo! Sai quanto cibo delizioso puoi comprare con un milione di Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200105,
					"content": "Un attimo... Fammi vedere... Eh? Paimon è la cliente numero 1.001 di oggi. Il costo originale delle informazioni era un milione di Mora, ma per te ora sono gratis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200106,
					"content": "Eh!? Paimon non sapeva che esistesse una fortuna del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200107,
					"content": "Un attimo, non ci stai attirando per poi farci spendere, vero? Magari la prima frase è gratis, ma non quella successiva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200108,
					"content": "Se non volete le informazioni, va bene! Avanti il prossimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200109,
					"content": "Ehi, aspetta! Dimentica quello che ha detto Paimon. Ti ascolteremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200110,
					"content": "Informazione esclusiva numero uno di Dori! Ricordate il Diadema dello Scibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200111,
					"content": "Paimon ricorda che solo il campione aveva diritto a indossare il diadema. Sembrava di grande valore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200112,
					"content": "Esattamente. Il diadema che Sachin ha donato all'Akademiya era un oggetto d'antiquariato parecchio costoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200113,
					"content": "Ma, dopo essere stato donato all'Akademiya, questo diadema è andato perduto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200114,
					"content": "Eh? Perché non ne sapevamo niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200115,
					"content": "Eheh... Se tutti lo sapessero, la mia informazione non sarebbe più esclusiva, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200116,
					"content": "Ovviamente, questa informazione non viene dal nulla. Ho perfino dei testimoni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200117,
					"content": "C'è un mio amico di nome Kashmer, dei sobborghi. Se volete saperne di più, potete chiedere a lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200118,
					"content": "La parola d'ordine è \"quell'incidente di vent'anni fa\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
