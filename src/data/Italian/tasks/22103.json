					"Verr Goldet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221030101,
					"content": "Che seccatura colossale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030102,
					"content": "Qualche problema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "#Oh, sei un{F#a}{M#o} dei nostri ospiti? Le mie scuse, ultimamente accadono cose terribilmente insolite da queste parti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030104,
					"content": "Gli ospiti continuano a essere attaccati dai mostri nelle vicinanze, e sempre meno persone sono propense a voler rimanere qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030105,
					"content": "Di questo passo, la situazione ci sfuggirà di mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030106,
					"content": "#A giudicare dal tuo abbigliamento, sei u{F#na}{M#n} viaggiat{F#rice}{M#ore}, giusto? Ti dispiacerebbe occuparti della questione per conto della locanda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030107,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "Grazie. Sei molto gentile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030113,
					"content": "Quindi è meglio se te ne occupi tu. Mi assicurerò di ricompensarti adeguatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030108,
					"content": "Quanto sono pericolosi i mostri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "Non molto. A essere sinceri, loro non mi preoccupano più di tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030111,
					"content": "Il problema è un altro... Se qualcuno di loro dovesse imbattersi in un certo giovanotto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030112,
					"content": "Il modo in cui quel ragazzo tende a trattare i mostri non coincide esattamente con gli interessi della zona o della gente del posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
		{
			"id": 2210302,
