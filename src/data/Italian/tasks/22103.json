			"dialogs": [
				{
					"id": 221030301,
					"content": "Fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030302,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "Meraviglioso! Bene, mi hai tolto una bella preoccupazione. Adesso posso tornare a pensare agli affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030304,
					"content": "Ecco il tuo compenso, come concordato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030305
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030305,
					"content": "Mmh? Oh, vuoi sapere di quel giovanotto? Pensavo che l'avessi visto in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030306
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030306,
					"content": "Potresti averlo notato mentre riposava sul tetto della locanda. A volte lo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030307
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030307,
					"content": "Se lo vedi, però, cerca di non disturbarlo. Preferisce essere lasciato in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		}
	]
