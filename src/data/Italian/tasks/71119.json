			"dialogs": [
				{
					"id": 711190101,
					"content": "\"...Offri giada all'alba, e gloriose sale al tramonto. Gli spiriti compiaciuti discenderanno, portando fortuna e benedizioni eterne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711190102
					],
					"speakerTitle": "Iscrizione sull'incensiere"
				},
				{
					"id": 711190102,
					"content": "...Il profumo delle orchidee, la fragranza dei fiori, il calderone di giada e il calice dorato, il profumo vola verso <color=#00E1FFFF>est</color>, l'incenso ardente verso <color=#00E1FFFF>ovest</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711190103
					],
					"speakerTitle": "Iscrizione sull'incensiere"
				},
				{
					"id": 711190103,
					"content": "<color=#00E1FFFF>Costruisci un altare</color> per il sacrificio, per la libagione e l'imbibizione del vino dolce; brillante per migliaia di anni, illumina tutte le direzioni...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iscrizione sull'incensiere"
				}
			]
		},
