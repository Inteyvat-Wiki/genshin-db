			"dialogs": [
				{
					"id": 730570401,
					"content": "Questo è lo strumento del Nara, lo tiene Aranakin. Ma non penso riesca a suonare ora... Le corde non sono sistemate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570402
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570402,
					"content": "(Un oud antiquato, segnato da molteplici segni di rottura, ma che sembra essere stato accuratamente riparato e ben mantenuto.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305705,
			"completionStepIds": [
				7305713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305713",
