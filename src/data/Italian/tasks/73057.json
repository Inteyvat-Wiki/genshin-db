				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570501,
					"content": "Nara... Mh, come si chiama? Aranakin non ci dorme su, quindi meglio dimenticare la parola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570502,
					"content": "È un \"letto\". Sembra nuovo... Ci ha mai dormito qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570503,
					"content": "Eheh, perché Aranakin lo sistema sempre... Se volete dormire qui, va bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305706,
			"completionStepIds": [
				7305714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
