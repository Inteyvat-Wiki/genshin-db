				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "Quali ricordi contiene? Cos'hai visto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570702,
					"content": "Sembra che il proprietario del taccuino ti conosca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "È così...? Non ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570704,
					"content": "Dice... che non poteva più vederti. Perché è cresciuto, forse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570705,
					"content": "Mmh... Crescere crea davvero problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570706,
					"content": "Ah, giusto! Ha anche scritto nel taccuino che... Questo fiore è per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570707,
					"content": "Tieni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "Eh...? Ah! Questo fiore è molto importante! Perché hai... Come ha fatto a ottenerlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570709,
					"content": "In realtà, una volta tu stesso ci hai dato questo fiore... Solo che hai dimenticato tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570710,
					"content": "Davvero...? Possiamo ancora diventare amici, allora. Ma... per quanto riguarda lui, non ricordo nemmeno il suo volto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570711,
					"content": "V-Va bene... Non essere triste, abbiamo ancora questo fiore. Ti farà ricordare altre cose, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570712,
					"content": "Sì, Bianchina volante ha ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570713,
					"content": "Allora riprendo il fiore, Mawtiyima dovrebbe sapere come risvegliarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570714,
					"content": "#Mm... Nara {NICKNAME} e Bianchina volante, io torno da Aranaga per piantarlo e ascoltare le sue canzoni. Se non avete niente da fare, sapete dove trovarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570715,
					"content": "Sì, a presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
