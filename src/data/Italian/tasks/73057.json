			},
			"dialogs": [
				{
					"id": 730570601,
					"content": "Ci sono foglie che Nara ha lasciato di sopra, ma... Aranakin non sa leggerle, Aranakin non capisce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570602
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570602,
					"content": "Sono le foglie che Nara usano per conservare i propri ricordi. Nara scrivono sulle foglie e le mettono insieme. Ma le parole dei Nara, Aranakin non le capisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570606,
					"content": "Intendi... \"taccuino\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570603,
					"content": "\"Taccuino\"...? È così che i Nara conservano i propri ricordi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730570604,
					"content": "Sì, esatto... È un problema per Aranakin se andiamo di sopra assieme e vediamo cosa c'è scritto sulle foglie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570605,
					"content": "Io? Nient'affatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakin"
				}
			]
		},
		{
			"id": 7305707,
			"completionStepIds": [
				7305706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
