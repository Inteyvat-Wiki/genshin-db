				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "\"...Ho riparato l'oud che zio Bakr aveva fatto cadere, quindi smettila di piangerti addosso, va bene? Puoi parlare con me e Khayyam se ti senti infelice...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "Taccuino malandato"
				},
				{
					"id": 730570902,
					"content": "il Grande Saggio\"...Sono stata presa all'Akademiya! Ahah, tanti auguri a me! Non voglio essere la moglie di qualche guerriero, sarò Siman, la Grande Saggia!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "Taccuino malandato"
				},
				{
					"id": 730570903,
					"content": "\"Eheh... Irfan il 'Grande Musicista' e Khayyam 'il Saggio', eh? Non dimenticatevi di me! Soprattutto tu, Khayyam, non osare dimenticarti di me!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "Taccuino malandato"
				},
				{
					"id": 730570904,
					"content": "\"...Addio, taccuino! Addio, Irfan e Siman, miei migliori amici! Spero che la foresta non dimentichi mai la nostra storia, e spero che ci ricorderemo a vicenda...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "Taccuino malandato"
				},
				{
					"id": 730570905,
					"content": "(...Il resto è disordinato e pieno di ricordi felici e dolorosi di bambini...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "Taccuino malandato"
				},
				{
					"id": 730570906,
					"content": "\"...Aranakin è scomparso. Svanito nel nulla senza lasciare traccia, né del come né di quando. Anche per me è arrivato il momento di dire addio all'oud. Diventerò un artigiano, proprio come sperava mio padre...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "Taccuino malandato"
				},
				{
					"id": 730570907,
					"content": "(Sembra che ci sia dell'altro, ma è stato cancellato con dell'inchiostro nero.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "Taccuino malandato"
				},
				{
					"id": 730570908,
					"content": "\"...A chi leggerà questo taccuino: se per miracolo, tra qualche anno, mi sarà permesso di incontrare di nuovo Aranakin e gli altri, dagli per favore questo fiore...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "Taccuino malandato"
				},
				{
					"id": 730570909,
					"content": "Ehi, è caduto qualcosa dal libro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570910,
					"content": "Sembra... un fiore? È identico a quelli che abbiamo ottenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
