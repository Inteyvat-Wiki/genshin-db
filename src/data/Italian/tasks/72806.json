			"dialogs": [
				{
					"id": 728060501,
					"content": "Eccoti qua di nuovo! Com'è andata? Hai trovato i due autori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060502
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060502,
					"content": "Sì. Le lettere sono state consegnate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "#Ottimo! Che hanno detto, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060504,
					"content": "Entrambi hanno detto che leggeranno le lettere con attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "Bene, bene. *sospira* Ma che peccato che sono entrambi così lontani a Liyue. Non potremmo andare a trovarli, nemmeno in circostanze più normali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060506,
					"content": "Soprattutto il signor Zhenyu. Il suo libro, \"Leggenda di una spada\", non è nemmeno stato spedito da lui, ma da un mercante itinerante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060507,
					"content": "Poi, uno dei nostri editori ha letto il libro e, riconoscendo il suo valore, si è preparato ad andare personalmente a Liyue per organizzare la scrittura di altri manoscritti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060508,
					"content": "Chi avrebbe mai pensato che, con questi cambiamenti di situazione, nessuna delle lettere che cercavamo di far portare a Liyue sarebbe mai tornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060509,
					"content": "Potevamo solo pubblicare prima i libri, tenendo un registro dei diritti d'autore dovuti al signor Zhenyu. Una volta stabiliti i contatti, li avremmo inviati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060510,
					"content": "Ma è passato così tanto tempo, e \"Leggenda di una spada\" resta un bestseller. I diritti d'autore cominciano ad accumularsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060511,
					"content": "*sospira* Se solo il signor Zhenyu potesse assistere alla competizione. Non possiamo permettere che questi diritti si accumulino ancora a lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aratani"
				}
			]
		},
