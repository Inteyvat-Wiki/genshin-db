			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "Mmh, questa parte è veramente scritta bene, e ha uno stile davvero originale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060402,
					"content": "Xingqiu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "Ah, ecco cosa succede. Interessante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060404,
					"content": "Xingqiu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#Mmh? Ah, sei tu, {NICKNAME}. Ne è passato di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060406,
					"content": "Dal modo in cui mi avete salutato, mi sembrate in forma. Mi fa piacere. Cosa vi porta qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060407,
					"content": "In realtà volevamo chiederti di trovare qualcuno per noi. Hai letto un sacco di libri, quindi probabilmente lo conosci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060408,
					"content": "Una persona? State cercando uno scrittore allora? Mmh... Va bene, chiedete pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060409,
					"content": "Stiamo cercando un certo \"Zhenyu\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "Zhenyu? D-Dove avete sentito questo nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060411,
					"content": "C'è scritto qui, su questa copia di \"Leggenda di una spada\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "Stiamo cercando questo Zhenyu perché qualcuno della Casa editrice Yae di Inazuma ci ha chiesto di dargli una lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060413,
					"content": "Sai chi sia questo Zhenyu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060414,
					"content": "Beh, questo Zhenyu di cui parlate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060415,
					"content": "Che imbarazzo. È il mio... pseudonimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060416,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060417,
					"content": "Beh, questa è nuova...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "Beh, di sicuro non è una cosa che vale la pena menzionare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060419,
					"content": "All'inizio, l'editore responsabile del libro qui a Liyue mi ha detto che \"l'ambientazione è troppo stravagante, e la trama è stranamente piena di cliché. A nessuno piacerà\", e ha rifiutato il manoscritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060420,
					"content": "Non volevo restare senza far niente, quindi ne ho stampate alcune copie e le ho messe di nascosto nella Libreria Wanwen, per vedere se sarebbero piaciute a qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060421,
					"content": "Alla fine, i lettori erano pochi e rari, quindi non ci ho più pensato. Non avrei mai immaginato che sarebbe diventato così popolare a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060422,
					"content": "Mi fa molto piacere sapere che le persone vogliono leggere qualcosa di mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060423,
					"content": "#Leggerò questa lettera con attenzione, viaggiat{F#rice}{M#ore}. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				}
			]
		},
