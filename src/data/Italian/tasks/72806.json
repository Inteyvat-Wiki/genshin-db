			"trigger": {
				"objectNames": [
					"Chang il Nono"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "#Mmh? Viaggiat{F#rice}{M#ore}? Cosa ti porta qui da me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 728060202,
					"content": "Ecco una lettera e un regalo della Casa editrice Yae.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "Una lettera dalla Casa editrice Yae? Spero che non mi chiedano di cambiare di nuovo il mio pseudonimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 728060204,
					"content": "Gliel'ho detto mille volte che voglio scrivere usando il mio vero nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 728060205,
					"content": "*sospira* Oh, lasciamo perdere. Fammi vedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 728060206,
					"content": "Vogliono che giudichi una gara di scrittura di romanzi... Mmh, non credo di averne il tempo, ma penso di doverli ringraziare comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 728060207,
					"content": "Eh? Ma cosa? Questi sono \"consigli creativi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Chang il Nono"
				},
				{
					"id": 728060208,
					"content": "#Ehm, d-dovrò leggerli con più attenzione. Grazie, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang il Nono"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
