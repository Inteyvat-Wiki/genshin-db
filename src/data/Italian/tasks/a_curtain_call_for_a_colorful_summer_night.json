			},
			"dialogs": [
				{
					"id": 150450401,
					"content": "#'Giorno, {NICKNAME} e Paimon! Io e i miei Gonfiotti abbiamo pensato di fare un salto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450402,
					"content": "Buongiorno, Mualani! Come fai a essere così piena di energie? Ieri sera ti sei data alla pazza gioia più di tutti noi messi insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450403,
					"content": "Appunto, era ieri sera! Una buona notte di sonno mi basta e avanza per tornare come nuova!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450404,
					"content": "Ecco, prendi. È il premio per il completamento dell'album! Già che ero lì, ne ho approfittato per prendere anche il tuo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450405,
					"content": "Wow! Grazie, Mualani! Sei stata gentilissima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450406,
					"content": "Quando c'è da aiutare il prossimo, una guida che si rispetti dev'essere sempre un passo davanti a tutti, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450407,
					"content": "Oh, parlando di lavoro, credo che le nostre vacanze siano quasi al capolinea... Ma forse è meglio così: se non mi sbrigo a tornare a casa, il mio cagnolino potrebbe dimenticarsi la mia faccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450408,
					"content": "Ne ho parlato anche con gli altri, e sembra che siano tutti pronti a tornare a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450409,
					"content": "Ad alcuni manca la propria famiglia, altri dicono di essere in astinenza da vino di denti di leone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450410,
					"content": "Perfino Chasca sembra nella stessa situazione. Lei non lo ammetterà mai, ma qualche sera fa l'ho vista mentre guardava in direzione del Clan Piumafiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450411,
					"content": "Capisco perfettamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "Ma l'estate non è ancora finita! Perciò... sfruttiamo al massimo il tempo che rimane per creare gli ultimi ricordi indimenticabili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450413,
					"content": "Potremmo fare un'altra foto di gruppo, ad esempio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450414,
					"content": "Ehi, che ne dici di scattarla qui? Paimon si è un po' affezionata a questo posto, dopo tutto il tempo che ci abbiamo trascorso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450415,
					"content": "Ottima idea! Allora, che ne dite di decorare un po' questa parete? Io vado a chiamare gli altri, ci vediamo in piazza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
