			},
			"dialogs": [
				{
					"id": 150450601,
					"content": "Wow, è incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450602,
					"content": "Ragazzi, venite! Scattiamoci una foto tutti insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450603,
					"content": "Niente male! Stamattina sembrate tutti pieni d'energie: capelli in ordine e nemmeno l'ombra di occhiaie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450604,
					"content": "Cavoli, noti anche questo genere di cose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450605,
					"content": "Beh, che razza di guida sarei se non mi accorgessi di dettagli simili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450606,
					"content": "Già, e che bardo sarei io se non fossi capace di apprezzare una buona bevanda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450607,
					"content": "...Si può sapere che accicacchio c'entra col discorso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450608,
					"content": "Ahahah! Credo di aver capito perfettamente cosa intende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450609,
					"content": "Quando degli amici parlano a vanvera tra loro, sono destinati a stare insieme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "Lo pensi davvero, oppure lo stai solo assecondando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450611,
					"content": "Non c'è niente di male nel parlare a vanvera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450612,
					"content": "Tieni, mettiti questo cerchietto Asha. Un piccolo souvenir da parte nostra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450613,
					"content": "Oh, grazie mille!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "Ti dona molto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450615,
					"content": "Bene, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450616,
					"content": "Tre, due, uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450617,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450618,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450619,
					"content": "Scusate, tutto questo parlare a vanvera ha fatto perdere qualche neurone a Paimon. Non le viene in mente niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450620,
					"content": "Ti dispiace che stia finendo, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450621,
					"content": "Hai paura che, una volta pronunciate quelle parole, la vacanza sarà ufficialmente conclusa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450622,
					"content": "Ma come... Avevi detto che i Pacificatori non hanno la telepatia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450623,
					"content": "Ahah, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450624,
					"content": "Non preoccuparti, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450625,
					"content": "L'estate tornerà di sicuro, proprio come hai detto nel tuo desiderio all'Archon di Pyro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450626,
					"content": "Anche se prenderemo strade diverse, se faremo tesoro della nostra amicizia, le nostre strade s'incroceranno di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450627,
					"content": "Bennett è diventato un vero chiacchierone, eh, professor Venti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450628,
					"content": "Ah, beh, non oserei mai prendermi il merito di ciò...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450629,
					"content": "Dal tuo tono di voce, si direbbe il contrario... Uffa, a Paimon stava quasi venendo in mente qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450630,
					"content": "Vogliamo riprovarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450631,
					"content": "Sì, e stavolta lo gridiamo tutti insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450632,
					"content": "Oh. Cosa dobbiamo gridare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450633,
					"content": "Buona stella?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "Bello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450635,
					"content": "Tre, due, uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450636,
					"content": "Buona stella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450641,
					"content": "Trascorri dei momenti meravigliosi con i tuoi amici...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "...Allora, Bennett, hai piani per il futuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450643,
					"content": "Se non riesci a decidere, puoi fare un salto dal Popolo delle Sorgenti. Anzi, puoi restare tutto il tempo che vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450644,
					"content": "Grazie dell'offerta, Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450645,
					"content": "Sono stato dall'Archon di Pyro per ringraziarla di tutto quello che ha fatto per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450646,
					"content": "Mi ha detto che il dominio in cui siamo entrati era una simulazione del Mare Jivari creata dall'Abisso. Era estremamente instabile, e ora è sparita completamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450647,
					"content": "Quando abbiamo parlato del mio futuro, mi ha detto che sarebbe lieta di accogliermi qui a Natlan... ma ha aggiunto che, qualunque fosse stata la mia decisione, l'avrebbe rispettata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450648,
					"content": "Ci ho pensato molto a lungo, e alla fine... ho deciso di tornare a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450649,
					"content": "Senti la mancanza dei tuoi papà, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450650,
					"content": "È uno dei motivi, sì. Ho promesso che avrei raccontato loro tutto quello che è successo in quest'avventura, e non posso rimangiarmi la parola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450651,
					"content": "Ma non è solo questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450652,
					"content": "Quando ho salutato mamma e papà, ho detto loro che un giorno sarei diventato l'avventuriere più leggendario di tutta Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450653,
					"content": "E nessun avventuriere rimane fermo troppo a lungo in un solo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450654,
					"content": "Bennett...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450655,
					"content": "Però, che farai se la fortuna ti abbandonerà di nuovo, una volta lasciata Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450656,
					"content": "Ahah, non sarà un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450657,
					"content": "Il calore e la gentilezza che ho ricevuto in questi giorni mi basteranno per affrontare tutti gli ostacoli che incontrerò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450658,
					"content": "Ho intenzione di forgiare il mio destino, trasmettendo agli altri lo stesso calore e la stessa gentilezza. È qualcosa in cui crederò sempre fermamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450659,
					"content": "Ma sentitelo! Un brindisi al nostro leader!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450660,
					"content": "Al nostro leader Bennett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450661,
					"content": "Alla salute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450662,
					"content": "Ahh... Si preannuncia un'altra notte in bianco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450663,
					"content": "Eheh, questa sì che è vita! Chi vuole esibirsi, ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450664,
					"content": "Bennett ormai è sul punto di cascare dal sonno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450665,
					"content": "No, no... Posso resistere... ancora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450666,
					"content": "Andate a riposarvi, ragazzi. E, Mualani: visto che sei ancora così pimpante, affido a te le pulizie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450667,
					"content": "Eh? Perché proprio a me...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450668,
					"content": "#{NICKNAME}, ti va una passeggiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450669,
					"content": "Conosco un posto perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1504507,
			"completionStepIds": [
				1504507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1504507",
							"2"
						],
						"stepId": 1504507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							984.35,
							298.017,
							14628.56
						],
						"pointId": 11712
					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "Sarai pure stonato, ma sai sempre dove trovare dei bei panorami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450702,
					"content": "Ahah, grazie dell'apprezzamento. Alcune storie non sono fatte per volare con gli uccelli, ma solo per raggiungere gli astri del cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450703,
					"content": "Vuoi raccontarci una storia della buonanotte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "Ahah... È più una storia che inizia con \"Tempo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450705,
					"content": "In un'epoca remota, \"Tem{RUBY#[S]Istaroth}po\" cominciò a scrivere la storia di questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450706,
					"content": "Ella trattava in modo equo ogni singolo essere vivente, sia nel valore che nell'insignificanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450707,
					"content": "Come un'antica pergamena, scolpì nella sua memoria tutte le persone, gli eventi, gli incontri e gli addii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450708,
					"content": "All'epoca, quando ero ancora uno spirito di Anemo, incontrai per caso \"Tempo\" al Tempio dei Mille Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450709,
					"content": "Ascoltò i miei desideri e mi conferì alcuni frammenti del suo potere e della sua autorità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450710,
					"content": "Semi portati dal vento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "Sembra che tu conosca la storia de \"Il Tempo e il Vento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450713,
					"content": "Affascinante, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450714,
					"content": "Grazie ai ricordi scolpiti in riti, poesie, rovine e testi antichi, i medesimi esseri che lei considerava privi di valore poterono incontrarla... E ben più d'una volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450715,
					"content": "Quindi era questa la storia che volevi raccontarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450716,
					"content": "Mmh... Direi che era più l'antefatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450717,
					"content": "La contaminazione del Mare Jivari è legata al tempo stesso. Per dirla in altri termini, è una calamità che si manifesta in ogni istante della sua esistenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450718,
					"content": "A differenza di \"Tempo\", il mio cuore ha sempre custodito un gran numero di desideri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450719,
					"content": "Cinquecento anni fa, per evitare che la contaminazione del Mare Jivari si diffondesse al di là di Tenochtzitoc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450720,
					"content": "...Io lo scaraventai fuori dalla linea del tempo, trasformandolo nella \"Terra senza vento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450721,
					"content": "Quindi è così che il Mare Jivari è scomparso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "Ops, temo di averti confuso le idee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450723,
					"content": "Se ti interessa sapere perché il Mare Jivari è sparito da Tenochtzitoc circa trent'anni fa, potrebbe esserci qualcuno di più adatto di me a dirtelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450724,
					"content": "Il Mare Jivari ha accolto fin troppe storie che non avrebbero mai dovuto appartenergli... Io ho solo giocato un ruolo in uno dei suoi capitoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450725,
					"content": "E la scelta che ho fatto cinquecento anni fa ha avuto un prezzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450726,
					"content": "Alcune anime non poterono far ritorno a Mondstadt... mentre altre scelsero di rimanere per sempre in questo luogo, unendosi ai Monetoo e diventando gli Asha che conosciamo oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450727,
					"content": "Quindi, il motivo per cui sei qui a Tenochtzitoc è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450728,
					"content": "Esatto. Sono qui per collaborare con l'attuale Archon di Pyro, Mavuika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450729,
					"content": "Ti riferisci a quando abbiamo acceso quella candela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "Esatto di nuovo. La fiamma era il nostro segnale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450731,
					"content": "Avevo bisogno che Mavuika aprisse una breccia tra quello spazio e il vero Mare Jivari per potervi accedere, così da portare indietro tutte le anime che desideravano tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450732,
					"content": "In quanto al trucchetto che ho usato per riportare indietro anche i ricordi... Beh, mi è già capitato di utilizzarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450733,
					"content": "Mavuika ha anche detto che volevate presentarci... Ma sembra che io vi abbia battuto sul tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450734,
					"content": "È stato bello scoprire che anche lei condivide il mio medesimo amore per il buon vino e la libertà. Siamo andati davvero a braccetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450735,
					"content": "Questa volta ti sei davvero superato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "Beh, mi ci sono voluti giorni per ritrovare le forze... In realtà, mi sento ancora stremato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450738
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450738,
					"content": "Oh, davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450739,
					"content": "Ma il pensiero di poter bere tutto quel vino di denti di leone e di idromele d'Afidi è bastato a farmi resistere un po' più a lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450740
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450740,
					"content": "A Paimon non sembri affatto così stanco: se stai cercando di usarla come scusa per farti pagare il conto alla taverna, sappi che non attacca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450741,
					"content": "Tu mi ferisci, cara Paimon.",
					"roleType": "TALK_ROLE_NPC",
