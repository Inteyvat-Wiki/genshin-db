					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751340405
					]
				},
				{
					"id": 751340405,
					"content": "Eh?! Avete trovato un'altra Pyrofosforite? Wow, pensavo di possederne l'unico campione esistente al mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
