					"content": "Cos'avete trovato laggiù? Raccontatemi tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340403
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340403,
					"content": "A dire il vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340404
					],
					"speakerTitle": "Paimon"
				},
				{
