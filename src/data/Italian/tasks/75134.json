			"dialogs": [
				{
					"id": 751340301,
					"content": "Fiuu... Ce l'abbiamo fatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340302,
					"content": "Anche l'Automa della Fonte segreta si è calmato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340303,
					"content": "Vediamo cosa c'è all'interno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340304,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340305,
					"content": "Paimon spera di non restare delusa... Eh, un'altra Pyrofosforite? Ne esistono diverse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340306,
					"content": "Aspetta, i rotoli di tessuto che l'avvolgono hanno un aspetto familiare, come gli appunti che abbiamo trovato nella torre fuori dalle rovine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340307,
					"content": "Roar... Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340308,
					"content": "#È alquanto strano. Non lo pensi anche tu, {REALNAME[ID(2)|SHOWHOST(true)]}? {NICKNAME}, cosa c'è scritto sopra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340309,
					"content": "Wow, sono proprio gli appunti lasciati da quell'avventuriere. Questo è il Cuore di Chu'ulel, quindi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340310,
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340310,
					"content": "Potrebbero esserci altre possibilità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340311
					]
				},
				{
					"id": 751340311,
					"content": "Vero, e abbiamo trovato una seconda Pyrofosforite. Forse ce ne sono altre sparse in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340312,
					"content": "Ci sono troppe cose qui che hanno poco senso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340313
					]
				},
				{
					"id": 751340313,
					"content": "È vero, ed è stato Coco a indicarci la strada. Che sapesse che qui c'era una Pyrofosforite e volesse che la trovassimo? Paimon non riesce a capire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340314,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340315,
					"content": "Prima dovremmo tornare indietro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340316
					]
				},
				{
					"id": 751340316,
					"content": "#Hai ragione, Coco probabilmente sa cosa sta succedendo, e abbiamo promesso a Bona che saremmo {F#tornate}{M#tornati} indietro a prescindere da cos'avremmo trovato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340317,
					"content": "Torniamo da Bona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340318
					]
				},
				{
					"id": 751340318,
					"content": "#Hai ragione, forse Bona sa cos'è successo, e le abbiamo promesso che saremmo {F#tornate}{M#tornati} indietro a prescindere da cos'avremmo trovato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340319,
					"content": "Andiamocene da qui, e in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
