					"speakerTitle": "Kanei"
				},
				{
					"id": 752390102,
					"content": "Quali bambole?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752390103
					]
				},
				{
					"id": 752390103,
					"content": "Delle bambole a forma di Koholasauro. Le sto dipingendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390104
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390104,
					"content": "Ma Zhaka, il mio apprendista, non si fa vivo da un po'. Aveva ancora tre bambole da finire e non ho idea di dove le abbia messe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390105
					],
					"speakerTitle": "Kanei"
				},
				{
					"id": 752390105,
					"content": "Ti dispiacerebbe aiutarmi a cercarle? Dovrebbero trovarsi qui da qualche parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kanei"
				}
