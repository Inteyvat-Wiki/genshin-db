			"dialogs": [
				{
					"id": 752390101,
					"content": "Uff... Quel Zhaka... Ha abbandonato il lavoro prima di finirlo! E chissà dove ha nascosto le bambole! Ne ho abbastanza, sporgerò reclamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752390102
