			"dialogs": [
				{
					"id": 722040401,
					"content": "Non adesso. Andate a giocare, ora. La nonna vi aspetterà qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040402,
					"content": "Fiori, ehi, fiori, ohi, dov'è la terra nella quale crescete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				}
			]
		},
		{
			"id": 7220405,
			"completionStepIds": [
				7220403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
