			"dialogs": [
				{
					"id": 722040901,
					"content": "#Ah, siete qui. Kito! Kina! Venite a salutare {F#la}{M#il} {F#nostra}{M#nostro} ospite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040902
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040902,
					"content": "Oh, dove se ne sono andati ora... Mi devi scusare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040903
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040903,
					"content": "Mmm, potresti ripetermi il tuo nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040904,
						722040905
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040904,
					"content": "#{NICKNAME}. Piacere di conoscerti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				},
				{
					"id": 722040906,
					"content": "*sospira* È... È arrivato il mio momento, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040907
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040907,
					"content": "Di cosa stai parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040908
					]
				},
				{
					"id": 722040908,
					"content": "Il battelliere è venuto a trovarmi molto spesso, ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040909,
					"content": "Arriva di soppiatto, con i suoi abiti coperti di pelliccia dorata, i suoi lunghi pantaloni dorati e la sua corona di seta dorata in testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040910,
					"content": "Proprio come mi disse mia madre, e come ho detto a Kito e Kina... Viene a prenderci a bordo della sua barca d'argento, e a bordo della sua barca ci porterà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040911,
					"content": "La barca navigherà e attraverserà un fiume scintillante, per arrivare nella terra dei sogni. Lì non ci sarà nebbia... ma una grande sala dorata, con settanta culle, e altre settanta ancora... che dondolano avanti e indietro, avanti e indietro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040912,
					"content": "Nelle culle ci addormenteremo, trasformandoci in granelli di luce... E diventeremo i sogni dei bambini di questo mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040913,
					"content": "Wow...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "Il battelliere ha detto di avermeli portati da Kito e Kina. Ah, quei ragazzini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040916,
					"content": "Non è il momento, ah oh, ah ehi... non è ancora arrivato il momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040914,
					"content": "Quindi vuoi dire che...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040905,
					"content": "#Sono {NICKNAME}, ovviamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				}
			]
		},
