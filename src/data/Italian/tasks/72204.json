			"dialogs": [
				{
					"id": 722040201,
					"content": "Va bene, allora. Ora la nonna ha bisogno di un pisolino... *russa*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040202
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040202,
					"content": "Fate attenzione, mi raccomando... Non allontanatevi troppo... *russa*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				}
			]
		},
		{
