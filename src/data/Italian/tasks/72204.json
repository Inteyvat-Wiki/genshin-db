			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "Ah, sei Abe? Come se la passano i funghi a casa tua? Ahah... Non andare a disturbare di nuovo il prete. Non accetterò, non importa quante volte me lo chiederà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040502,
					"content": "Ahahah! Cioè, mi dispiace, ma sono impegnata a prendermi cura della casa. Mi dispiace molto, eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040503,
					"content": "Mi dispiace... *sospira* Mi dispiace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040504,
					"content": "Ciao, nonna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "Ah, sei tu! Dai, vieni qui, non metterci in imbarazzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040507,
					"content": "Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "Com'è andata a pesca? Male, hai detto? Oh, non importa, non importa. I prodotti del nostro giardino dovrebbero bastare. Beh, forse non per l'offerta del grande Uccello del tuono, ma... Eh? Cosa c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040510,
					"content": "Che diavolo stai dicendo?!? La cerimonia di quest'anno è andata bene! L'anno prossimo non farà eccezione. Il prete ha anche detto che avremo un figlio in buona salute...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040511,
					"content": "Perché dici queste cose, adesso?!? Hai dimenticato cosa è successo al clan Kama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040512,
						722040513
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040512,
					"content": "Ehi, ehi, aspetta un attimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040514,
					"content": "Se vuoi abbandonare il grande Uccello del tuono e lasciarti inghiottire dalle onde impetuose, fa' pure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040515
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040515,
					"content": "Il mio bambino... Oh, il mio povero bambino... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040513,
					"content": "Kama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040508,
					"content": "Cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040505,
					"content": "Tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				}
			]
