					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "Oh. Oh, ciao, ciao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040702,
					"content": "Mi dispiace molto, la mia mente sta diventando sempre meno lucida con l'avanzare dell'età. Potresti ripetermi il tuo nome? Ci conosciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040703,
					"content": "#Sono {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "#Strano, non ho mai sentito un nome del genere. Sei {F#una}{M#uno} stranier{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040706,
					"content": "Strano, non so come tu abbia fatto ad arrivare qui senza il permesso del grande Uccello del tuono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040707,
					"content": "L'Uccello del tuono non c'è più...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "*sospira* Quando ti guardo mi viene in mente il mio povero marito. Non ricordo più nemmeno il suo viso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040710,
					"content": "Eravamo ancora giovani a quei tempi, con tante fantasie sfrenate in mente... Ma alcune persone non crescono mai. Nemmeno dopo che hai trascorso tanto tempo con loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040711,
					"content": "Mi ha abbandonata, e ha costruito una zattera di legno per raggiungere il luogo dove vivono gli stranieri. Diceva che lì voleva andare a caccia e raccogliere fiori che non aveva mai visto prima... Fiori bellissimi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040712,
					"content": "Lo diceva da quando eravamo ragazzini... Ma non è mai cresciuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040713,
					"content": "Il figlio del prete lo trovò sulla spiaggia, silenzioso come le conchiglie, più bianco delle sabbie... e stringeva questi fiori in mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040714,
					"content": "Piangendo, il prete disse che la barca dei nostri antenati lo aveva respinto, e che la sua anima avrebbe vagato soltanto nelle terre degli stranieri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040715,
					"content": "A quel tempo, avevo appena dato alla luce nostro figlio... Come avrei potuto dirglielo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "In seguito, anche mio figlio ha avuto dei figli, e ho mandato mio figlio a bordo della barca d'argento, mentre io sono rimasta in questa terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040718,
					"content": "Riguardo agli affetti e alle preoccupazioni... Credo che mi siano rimasti solo Kito e Kina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040708,
					"content": "Forse è il caso che ti spieghi un po' di cose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#Chiamami pure {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
