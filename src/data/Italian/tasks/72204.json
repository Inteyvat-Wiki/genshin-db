			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "Kito, Kina, siete tornati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040102,
					"content": "Ora basta, dico davvero. State sempre in giro, io e le mie vecchie gambe non riusciamo a starvi dietro! E come posso aiutarvi se poi finite nei guai, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040103,
					"content": "Salve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "Cosa? Suvvia, come potete dire una cosa del genere a un'anziana signora? Così mi spezzate il cuore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040106,
					"content": "Beh, dato che ora siete qui, non andatevene in giro, per favore. Tenete compagnia alla nonna per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040107,
					"content": "Mi dispiace, ma io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "Ora... Dov'ero rimasta con la storia che vi stavo raccontando? Ah, sì, sì... Questo accadeva quando il nonno di vostro nonno era ancora giovane...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040110,
					"content": "Al di là del Mare di nebbia, su un'isola degli stranieri, viveva il clan Sumari. Si dice che la Matriarca di questo clan fosse una donna con le sembianze di una volpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040111,
					"content": "Dicono che su questa terra crescevano fiori dal colore del tuono, e che il clan Sumari costruiva case e viveva in armonia, in mezzo alle montagne e alle pianure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040112,
					"content": "E poi... I loro fiori... *russa*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040113,
					"content": "*russa* Al di là del Mare di nebbia, sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040114,
					"content": "Ehm, nonna? Stai bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "Eh? Kito, Kina? Oh. Ve ne state andando? *sospira* Oh, mi dispiace, devo essermi addormentata di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040117,
					"content": "Non dimenticate questi... La nonna ve li ha conservati per tutto questo tempo: questi fiori arrivano dall'altra parte del Mare di nebbia. Non perdeteli, mi raccomando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040115,
					"content": "(Meglio non disturbarla...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "Va bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "Forse avete sbagliato persona...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
