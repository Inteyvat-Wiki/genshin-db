			"dialogs": [
				{
					"id": 722040301,
					"content": "*sospira* È tutto così confuso... La nebbia sta diventando sempre più fitta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040302,
					"content": "Ehm, salve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "*sospira* La mia memoria peggiora di giorno in giorno. Suppongo che ti ci stia abituando anche tu, ormai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040305,
					"content": "Ma cosa posso fare? Non so se Kito e Kina abbiano fame o se siano al sicuro, mentre stanno fuori a giocare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040306,
					"content": "Non preoccuparti, stanno sicuramente bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "Oh, Kito, Kina! Siete qui! Spero che non siate caduti o inciampati in qualcosa per strada... Non sarete andati di nuovo ad arrampicarvi sugli alberi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040309,
					"content": "Ah, non sapete quanto la vostra nonnina sia in pensiero per voi! *sospira* Non so cos'è successo ultimamente, ma sembra che ci sia sempre meno gente su quest'isola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040310,
					"content": "E faccio sempre più difficoltà a ricordare le persone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040311,
					"content": "*sospira* Non so cosa farei se dovessi mai dimenticarmi di voi due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040312,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "*sospira* Ecco, prendete questi petali. Se la nonna dovesse mai dimenticarvi, datemi questi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040314,
					"content": "Ah, ho ancora tante storie da raccontarvi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040307,
					"content": "Possiamo aiutarti in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "È successo qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
