			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020301,
					"content": "Tu... non benvenuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020302,
					"content": "Ahahah... E così, al miserabile spirito del lupo piace allevare cuccioli selvatici ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80020303,
					"content": "Dici di essere un guardiano, eppure i tuoi artigli non sono più affilati come un tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80020304,
					"content": "Se ci servirai, potremo restituirti i poteri divini che vantavi un tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80020305,
					"content": "Bugie... Solo bugie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020306,
					"content": "Che diamine è questa cerimonia? Sembra provare tanto dolore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020307,
					"content": "Oh, no... È la stessa cosa che hanno fatto per corrompere la mente di Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020308,
					"content": "I lupi non si arrendono mai, ma... questa storia non può continuare in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020309,
					"content": "Li fermerò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "Non importa quante volte ti opponi a noi, i tuoi sforzi sono vani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80020310,
					"content": "È ora di un altro round contro l'Apostolo dell'Abisso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
		{
			"id": 800204,
			"completionStepIds": [
				800209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800209",
							"2"
						],
						"stepId": 800209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "Un'enorme statua, una grandiosa cattedrale... Il popolo di Mondstadt ha davvero impiegato un mucchio di risorse ed energie per costruire tutto ciò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020402,
					"content": "Ma quanto era consapevole l'Archon di Anemo del dono che ha ricevuto, e quanto ha dato in cambio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020403,
					"content": "La fede non chiede nulla in cambio, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020404,
					"content": "Tsk, finché gli dèi avranno la coscienza a posto riguardo alla questione, non c'è niente che io possa dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020405,
					"content": "Shh! Stiamo per entrare nella cattedrale. Nessuno dica niente di brutto sull'Archon di Anemo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020406,
					"content": "E poi, in realtà, l'Archon di Anemo è... Nah, non importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020407,
					"content": "Eheh, non ho mai detto specificatamente che sarei entrato nella cattedrale. Lascerò a voi due il compito di parlare con le sorelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020408,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020409,
					"content": "Ma abbiamo fatto tutto insieme fin qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "#Tu sei {M#il Cavaliere Onorario}{F#la Cavaliere Onoraria} di Mondstadt. Di sicuro ti daranno piena fiducia, che ti permetterà di immischiarti nei loro affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020412,
					"content": "Se io venissi con voi, non farei altro che alimentare dubbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020413,
					"content": "È perché non ti conoscono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "Giusto, e come ha detto la nostra piccola amica... Potrei dire qualcosa di brutto sulla Chiesa in qualsiasi momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020416,
					"content": "Quando un non credente calpesta il suolo sacro, le conseguenze non sono mai piacevoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020417,
					"content": "Non ho mai ricevuto il favore degli dèi in passato. Non vedo il motivo per averne bisogno tanto ora come in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020418,
					"content": "Chiudiamola qui. Mentre ci perdiamo in chiacchiere, l'Ordine dell'Abisso continua ad agire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020419,
					"content": "#Ok allora, {NICKNAME}, entriamo e chiediamo in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020420,
					"content": "Dovrei avvertirvi di una cosa: non parlate della Statua dissacrata dentro la cattedrale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020421,
					"content": "La Chiesa di Favonius non ignorerebbe la questione relativa alla statua, ma se tentassero un'azione azzardata contro l'Ordine dell'Abisso, servirebbe solo a rovinare il nostro eventuale elemento sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020422,
					"content": "E poi... Immischiarsi negli affari dell'Abisso non porta mai a nulla di buono per nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020414,
					"content": "Non pensi che saresti popolare tra le sorelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "Non sei curioso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
		{
			"id": 800205,
			"completionStepIds": [
				800210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800210",
							"2"
						],
						"stepId": 800210,
						"stateName": "QUEST_STATE_UNFINISHED"
