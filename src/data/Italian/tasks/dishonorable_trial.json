			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "Capisco... L'Ordine dell'Abisso ha già avviato una nuova operazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020502,
					"content": "Potrebbe benissimo avere a che fare con la Statua dissacrata. Dovremmo andare anche noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020503,
					"content": "Ma perché l'Ordine dell'Abisso sta andando nel Regno dei Lupi? Vogliono fare la stessa cosa che hanno fatto a Dvalin? Aaah... Non di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020504,
					"content": "No, è improbabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020505,
					"content": "A differenza di Osayal, che è stato appena eliminato, Andrius è morto tanto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020506,
					"content": "Oggi, rimane solo il suo spirito a sorvegliare il Regno dei Lupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020507,
					"content": "L'Apostolo dell'Abisso potrebbe aver preso di mira lo spirito di Andrius nel tentativo di carpire qualche informazione su uno dei vecchi compagni dell'Archon di Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800202",
							"2"
						],
						"stepId": 800202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020601,
					"content": "Entra nella cattedrale e chiedi in giro. Io ti aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800207,
			"completionStepIds": [
				800208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800208",
							"2"
						],
						"stepId": 800208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Boreas"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "Tsk... La cerimonia è stata interrotta. Che fortuna, la tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80020702,
					"content": "Come può un vecchio spirito avere una volontà così forte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80020703,
					"content": "Non importa. Questa non è altro che una piccola variabile anomala. Il nostro piano principale non ne risentirà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "Apostolo dell'Abisso"
				},
				{
					"id": 80020704,
					"content": "È sparito di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020705,
					"content": "Almeno stavolta l'abbiamo fermato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "Grazie, mi avete salvato... appena in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020708,
					"content": "Lupical umano... È una vergogna per me che mi vediate nel mio stato attuale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020709,
					"content": "Tuttavia, l'Apostolo dell'Abisso ha sottovalutato la mia forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020710,
					"content": "Lupus Boreas non rifiuta una prova. Ma, spaventoso straniero... non rispetta regole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020711,
					"content": "Nemmeno io avevo capito... che era una trappola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020712,
					"content": "Aspetta... Intendi dire che l'Ordine dell'Abisso aveva preparato tutto per corrompere la mente di Lupus Boreas, e l'ha poi attirato fingendo di sfidarlo in una prova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020713,
					"content": "Non è colpa tua, Razor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#Grazie, {NICKNAME}. In futuro, i miei artigli... dovranno essere più affilati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020716,
					"content": "#Avete... fiutato il pericolo e siete venut{M#i}{F#e} qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020717,
					"content": "No, ci è giunta voce del pericolo. Il naso di Paimon non sa nemmeno che odore ha il pericolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020718,
					"content": "Prima di aiutare, in realtà, abbiamo una cosa da chiederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020719,
					"content": "Ehm... Scusa, signor Dio lupo, sai qualcosa del primo Zappaterra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020720,
					"content": "Non presto attenzione ai congegni degli umani. Non so cosa sia questo \"Zappaterra\", ma c'è una macchina costruita dagli umani che non potrei mai dimenticare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020721,
					"content": "Entrò nel mio campo di prova per errore, e io la scambiai per uno sfidante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020722,
					"content": "Ma non era in grado di pensare, sapeva solo combattere. È stata progettata puramente per uccidere, in tutto e per tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020723,
					"content": "Alla fine, riuscì a danneggiarla con uno dei miei attacchi. Prima di cadere, si allontanò dal mio campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020724,
					"content": "Mmmh... A giudicare dal racconto, è possibile che fosse il primo Zappaterra, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020725,
					"content": "Sapeva roteare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "Sì. Roteava, saltava molto in alto e sparava sfere di fuoco. Anche se non era all'altezza di un dio, era più forte persino di chi possiede una Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020730,
					"content": "Sfere infuocate? Ehi, non abbiamo già sentito una cosa simile, giusto poco fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020731,
					"content": "In ogni caso, questo dimostra che il primo Zappaterra è arrivato a Mondstadt, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020732,
					"content": "Sembra che il primo fosse molto più forte delle Guardie delle rovine prodotti in serie che l'hanno succeduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020733,
					"content": "Ma, in questa storia, è stato danneggiato nel campo di prova mentre combatteva il Lupo del Nord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020734,
					"content": "Non so... Ma, abbiamo aiutato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020735,
					"content": "#Sì, siete stat{M#i}{F#e} di grande aiuto! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020736,
					"content": "Dobbiamo continuare a indagare su una cosa molto importante. L'Apostolo dell'Abisso sarà pure andato via, ma l'attacco delle forze dell'Abisso è ancora in corso. Fate attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020737,
					"content": "Sì. Sto fiutando... altro pericolo. Pericolo più grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020738,
					"content": "Anche voi due fate attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020727,
					"content": "Sparava missili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "\"Missili\"? Non conosco questa strana parola... Come ho già detto, non presto attenzione ai congegni degli umani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020729,
					"content": "Roteava, saltava molto in alto e sparava sfere di fuoco. Anche se non era all'altezza di un dio, era più forte persino di chi possiede una Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 80020714,
					"content": "Dai, su di morale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020706,
					"content": "Certo che è fuggito in fretta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				}
			]
		}
	]
}