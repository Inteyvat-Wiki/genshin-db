				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721170101,
					"content": "#Ah, che tempismo perfetto, viaggiat{F#rice}{M#ore}! La raccolta dei dati è quasi terminata. È tempo di recuperare i sensori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170102,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "Volentieri, volentieri. Meglio agire furtivamente e in fretta, però. Non farti vedere dai Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170104,
					"content": "Come lo sai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "Quei sensori vengono sempre venduti con dei manuali di istruzioni molto dettagliati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170106,
					"content": "Questi includono informazioni sulle varie circostanze e sul tempo necessario per la raccolta dei dati in ciascun caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170107,
					"content": "Nel caso di una forma di energia sconosciuta come il Tatarigami, ritengo che il processo richiederà la durata maggiore tra quelle indicate. Comunque sia, il compito di recuperare i sensori spetta a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7211702,
