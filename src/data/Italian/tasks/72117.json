				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721170301,
					"content": "Com'è andata? Hai recuperato tutti i sensori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170302,
					"content": "Sì, li ho presi tutti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170303
					]
				},
				{
					"id": 721170303,
					"content": "#Brav{F#a}{M#o}! Dammi solo un attimo per modificare il dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170304,
					"content": "Devo dire che ultimamente i Fatui hanno cominciato a comportarsi in modo sempre più strano. Sembra che si stiano radunando intorno al nucleo della Fornace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170305
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170305,
					"content": "Speriamo che non stiano ordendo un altro dei loro loschi piani, o meglio, che non stiano cercando di fare qualcosa che non saremo in grado di contrastare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7211704,
