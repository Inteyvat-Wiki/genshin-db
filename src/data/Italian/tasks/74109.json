			"dialogs": [
				{
					"id": 741090101,
					"content": "#Vedendovi avvicinare, la Blobbofoca non fugge. Invece, nuota felicemente verso di voi e si tuffa in un istante nel tuo abbraccio. Emette delle dolci note d'affetto mentre si strofina contro la tua guancia...\\nÈ davvero Goffobaccona, la piccola Blobbofoca a cui tu e Paimon avete dato da mangiare e di cui vi siete pres{F#e}{M#i} cura finché non è cresciuta...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741090102
					]
				},
				{
					"id": 741090102,
					"content": "Blof... Blof!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741090103
					],
					"speakerTitle": "Goffobaccona"
				},
				{
					"id": 741090103,
					"content": "Eheh, da quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741090104,
					"content": "Paimon temeva che non ti saresti mai abituata al mare, ma a quanto pare si è preoccupata inutilmente!",
