					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320902,
					"content": "Ci stiamo già svegliando? Ma Paimon vuole guardare ancora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320903,
					"content": "Le meteore che abbiamo evocato sono volate da terra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320904
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320904,
					"content": "Erano proprio come dei fuochi d'artificio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320905
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320905,
					"content": "Ah, sarei rimasta lì a guardarli per sempre. È stato il sogno più reale, fantastico e magico che abbia mai fatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320906
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320906,
					"content": "Anche per Paimon! Paimon però non si aspettava che ci avresti fatto saltare sopra quella stella cadente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320907,
					"content": "Eheh... Onestamente non ci ho riflettuto molto. Ho solo pensato che sarebbe stato un peccato se non avessimo provato qualcosa di folle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320908,
						130320909
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320908,
					"content": "Yoimiya, tu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320909,
					"content": "Sapevi già che era un sogno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320910,
					"content": "Mi conosci. Non m'importa se fosse la realtà o un sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320911
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320911,
					"content": "Devo proprio ringraziarvi, voi due. Avete organizzato tutto questo come piano di riserva perché sapevate che le piogge di meteore sono difficili da vedere, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320912
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320912,
					"content": "Non vi preoccupate, mi è piaciuto tanto, tanto, tanto! Penso che questo si meriti assolutamente la posizione di miglior regalo che abbia ricevuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320913
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320913,
					"content": "Oh, che bello. Paimon aveva paura che ti saresti arrabbiata, dopo aver saputo la verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320914,
					"content": "E perché mai? Ho sognato un Aranara gentile, amichevole e carino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320915
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320915,
					"content": "Ho sognato di aver corso e saltato con voi su dei grandi funghi, e di aver scoperto la Pietra di Ur in un modo davvero inaspettato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320916
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320916,
					"content": "#E quando pensavo che ci fossimo svegliat{F#e}{M#i}, la seconda parte è stata ancora più emozionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320917
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320917,
					"content": "#Avin ha tirato fuori dal suo cuore una lente di Pietra di Ur. Abbiamo trovato le meteore che volavano partendo dal terreno, e siamo anche diventat{F#e}{M#i} un tutt'uno con una stella cadente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320918,
						130320919
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320918,
					"content": "#Siamo stat{F#e}{M#i} in un sogno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320919,
					"content": "#Chi ha detto che ci siamo svegliat{F#e}{M#i}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320920,
					"content": "È vero. I sogni stessi possono essere immaginari, ma sono anche esperienze impossibili da rivivere o replicare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320921
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320921,
					"content": "#Se fossimo stat{F#e}{M#i} più pignol{F#e}{M#i} riguardo a verità e finzione, ci saremmo pers{F#e}{M#i} così tante bellezze ed emozioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320922
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320922,
					"content": "Eheh, tu sì che ci sai fare con le parole. Paimon aggiungerà un nome in più alla lista \"I migliori amici di Paimon\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320923,
					"content": "Allora c'è una classifica...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320924
					]
				},
				{
					"id": 130320924,
					"content": "Um, a proposito, riguardo agli Aranara... A loro di solito non piacciono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320925,
					"content": "Oh, sì, sono così carini! Dobbiamo proprio ringraziare quelle bellissime sculture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320926
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320926,
					"content": "Le sculture di legno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320927,
					"content": "Esatto. Se non avessimo visto quelle sculture di legno, non avremmo sognato un Aranara così carino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320928
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320928,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320929,
						130320930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320929,
					"content": "Yoimiya ha capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320930,
					"content": "Penso che siano anche più carini delle sculture.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320931,
					"content": "Eheh, non preoccuparti, lo so. Penso che siano carinissime e sono felice di prendermene cura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320932
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320932,
					"content": "Bene, è quasi ora. Mandiamola a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321101,
					"content": "Dopo aver mandato a casa Avin, tu e Yoimiya trascorrete qualche altro giorno a Sumeru.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130321102
					]
				}
			]
		},
		{
			"id": 1303211,
			"completionStepIds": [
				1303211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303211",
							"2"
						],
						"stepId": 1303211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yoimiya",
					"Niousha",
					"Avin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130321105,
					"content": "Sumeru è un posto così bello! Tornerò di sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321106,
					"content": "Sarai sempre la benvenuta qui. Avin sarà felice di rivederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "Niousha"
				},
				{
					"id": 130321107,
					"content": "È una promessa! Ti aspetterò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321108,
					"content": "Ahahah, d'accordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321109,
					"content": "Yoimiya, prima che tu vada, voglio parlarti del mio nuovo sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321110,
					"content": "Voglio viaggiare fino a Inazuma da sola e vedere lo spettacolo di fuochi d'artificio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321111,
					"content": "Wow, impressionante! Eheh, non mi aspettavo di conoscere dei nuovi clienti mentre ero in vacanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321112,
					"content": "Tranquilla, ti farò dei fuochi d'artificio che non dimenticherai mai più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321113,
					"content": "#E anche voi due. Non importa quanto sarete impegnat{F#e}{M#i} con le vostre avventure, ricordatevi di tornare a Inazuma. Vi accoglieremo sempre a braccia aperte, in qualunque momento decidiate di venire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321114,
					"content": "Dovete venire a vedere i fuochi d'artificio che mi sono stati ispirati da questa pioggia di meteore che salivano alte nel cielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321115,
					"content": "D'accordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130321116,
					"content": "Prenditi cura di te, Yoimiya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "Lo farò, lo farò! Ahah, siete ferventi come sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321122,
					"content": "Oh, già, a proposito, guarda qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321123,
					"content": "Una scultura degli Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "Esatto. Questa è quella che mi hai aiutato a scegliere e che hai detto che mi assomiglia. Sono andata a comprarne un'altra: è per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321125,
					"content": "Quando ti senti giù, guardala. Chi lo sa, magari ti tirerà su di morale. Se non altro, saprai che ti supporto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321126,
					"content": "Ovviamente incontrarsi di persona è sempre meglio, eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321127,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "Ok, torno a casa adesso. Sono certa che ci rincontreremo presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321130,
					"content": "Mi è piaciuto proprio tanto il viaggio che avete preparato per me: sono rimasta davvero colpita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321131
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321131,
					"content": "Ovunque voi due andrete, so per certo che la nostra amicizia e il suo calore vi supporteranno sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321132,
					"content": "Per cui continuate ad andare avanti fino alla fine del vostro viaggio e ai confini del mondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321133,
					"content": "Ci vediamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321128,
					"content": "La custodirò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "Possano tutti i tuoi giorni essere colmi di felicità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321119
					]
				},
				{
					"id": 130321119,
					"content": "Ogni giorno e per sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321120,
					"content": "I fuochi d'artificio durano un istante, mentre l'amicizia è eterna!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321121
					]
				},
				{
					"id": 130321121,
					"content": "Perché lo gridi? È imbarazzante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}