			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapurva",
					"Avin",
					"Yoimiya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "Mm, Paimon voleva chiederti cosa intendi per \"pronta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320102,
					"content": "Nara Avin non ricorda ancora completamente. Ricordi e sogni sono entrambi necessari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320103,
					"content": "Sogni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320104,
					"content": "Ma non potrò mai più camminare. E se anche guarissi, non so quanto ci vorrebbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320105,
					"content": "Non serve che ti preoccupi di queste cose. Nara Avin, devi ricordare. I sogni sono connessi al tuo cuore, non al tuo corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320106,
					"content": "Al mio cuore...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320107,
					"content": "Ti ho portato fin quaggiù, ma ora Nara Avin deve trovare le cose preziose per conto proprio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320108,
					"content": "Eh? È sparito così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320109,
					"content": "Sembra che il cielo sia in qualche modo cambiato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320110,
					"content": "Il mio cuore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320111,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320112,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320113,
					"content": "Mi... Mi sono alzata in piedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320114,
					"content": "Non è stato per nulla difficile, e non mi sono sentita strana. È stato come... come erano le cose prima che mi ammalassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320115,
					"content": "Aspetta, questo significa che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320116,
					"content": "Siamo all'interno di un sogno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "Non è la prima volta per noi. Ah, non c'è da stupirsi che Arapurva abbia detto di non preoccuparsi... Avin può muoversi liberamente nei suoi sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320118,
					"content": "Wow, è incredibile, è questo... il potere del mio cuore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320119,
					"content": "È fantastico! Ora possiamo andare a cercare Arashani tutti assieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320120,
					"content": "Dai, facciamo una gara! Fammi vedere quanto sei veloce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320121,
					"content": "Potrei non essere ancora guarita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320122,
					"content": "Fa lo stesso, andiamo! Non perderò, nemmeno contro un'adulta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320123,
					"content": "Ah, e via che va!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320124,
					"content": "Bene, è stato facile. Paimon pensava che avrebbe avuto bisogno di più tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320125,
					"content": "Immagino che sia quella che chiamano predisposizione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "Eheh, è vero. Dai, andiamo da loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320126,
					"content": "Questo è il potere di un desiderio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
		{
