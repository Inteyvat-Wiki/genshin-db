					}
				]
			},
			"dialogs": [
				{
					"id": 130320201,
					"content": "*ansima* Sei... brava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320202,
					"content": "Eheh, se avessimo corso ancora, mi avresti presa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320203,
					"content": "Avin ha raggiunto Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320204,
					"content": "Ho seminato un sacco di adulti. Le gambe lunghe non sono necessariamente sinonimo di correre più veloce. Anche l'allenamento è importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320205,
					"content": "Ahah, non sarei in grado di competere con te neanche tra un milione di anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320206,
					"content": "Mm, vediamo... Dove andiamo adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320207,
					"content": "Ah, guarda! C'è qualcosa che fluttua laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320208,
					"content": "Sembra... una stella?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "Vorrà che la seguiamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320210,
					"content": "Mmm, forse. Dai, seguiamola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1303205,
			"completionStepIds": [
				1303205,
				1303214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1303205",
							"2"
						],
						"stepId": 1303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Avin",
					"Yoimiya",
					"Arashani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320501,
					"content": "Quindi è questa la nostra destinazione? Ma Paimon non vede nessun Aranara. Solo questa grande pietra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320502,
					"content": "Sono così felice... Avevo quasi dimenticato come ci si sentisse a essere così felici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320503,
					"content": "Sai, all'inizio era come se il mondo si fosse ridotto a uno spazio piccolissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320504,
					"content": "Ma, fintanto che posso continuare a correre, di fronte a me appariranno sempre nuovi paesaggi, e il mio mondo continuerà a espandersi davanti ai miei occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320505,
					"content": "Anche se non so come abbia fatto. So solo che devo ringraziare voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320506,
					"content": "Oh, non importa. Ciò che conta è che ti sia ricordata della gioia di attraversare il mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320507,
					"content": "I nostri ricordi non rappresentano solo il passato. Possono anche far splendere una luce sul nostro futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320508,
					"content": "Una volta che ritroverai la speranza nel cuore, quella felicità tornerà da te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320509,
					"content": "#Sì! Grazie, Yoimiya! Grazie a tutt{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320510,
					"content": "Continuiamo a cercare Arashani. Sembra che non sia qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320511,
					"content": "#Già... Ma allora perché la stella ci ha condott{F#e}{M#i} qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320512,
					"content": "Questa pietra spicca tantissimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "Non so come spiegarlo... Non ho idea di cosa sia, ma ha un'aria familiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320514,
					"content": "Come se fosse una parte di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320515,
					"content": "Ah, sì! Lo so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320516,
					"content": "Potrebbe essere la tua Pietra di Ur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320517,
					"content": "P-Pietra di Ur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320518,
					"content": "(Yoimiya è brava a improvvisare.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "(L'avevo quasi scordato.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "È un minerale molto raro che simboleggia le aspirazioni e i sogni di una persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320521,
					"content": "Se riesci a vederla, significa che hai trovato ciò che avevi perso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320522,
					"content": "Oh, è così allora...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320523,
					"content": "È come nelle favole... Pensavo di aver smesso di credere in quelle cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320524,
					"content": "Ma sono lieta di aver ritrovato la speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320525,
					"content": "Eh? È passata attraverso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320526,
					"content": "Seguiamola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320527,
					"content": "Ehi, Yoimiya! EHI! ...Beh, non abbiamo molta scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320528,
					"content": "#Siamo passat{F#e}{M#i} attraverso, ma non sembra essere cambiato nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320529,
					"content": "Ne è passato di tempo, Nara Avin. Davvero parecchio, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320530,
					"content": "Arashani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320531,
					"content": "Perché sembri triste? Ah, Arashani lo sa. Tu sei felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320532,
					"content": "Arashani! *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320533,
					"content": "Ooh, l'Aranara ha talento per i viaggi magici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320534,
					"content": "Non solo ha aiutato Avin a trovare il suo migliore amico, ma ci ha anche mostrato cos'è una Pietra di Ur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320535,
					"content": "Ah, dobbiamo trovarne una anche noi dopo, per creare le lenti più pure possibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320536,
					"content": "Esatto! È divertente, ma Paimon pensa che possiamo davvero farcela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320537,
					"content": "È il significato della parola avventura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "È stato parecchio divertente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "Ma prima dobbiamo riportarla alla Città di Sumeru. Sua madre sarà preoccupata da morire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320540,
					"content": "#La scena che vi si presenta davanti è come un sogno. Prima di rendervene conto, siete tornat{F#e}{M#i} dov'eravate prima.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
