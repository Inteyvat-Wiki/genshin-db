				"points": []
			},
			"dialogs": [
				{
					"id": 130320601,
					"content": "Il... Il sogno è finito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320602,
					"content": "Abbiamo fatto proprio un bel sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320603,
					"content": "Non sentirti sola! Lui è proprio vicino a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320604,
					"content": "Arashani! Tu... Tu sei ancora qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320605,
					"content": "Arashani vuole dirti che gli dispiace. Non è che Arashani non volesse trovare Nara. Arashani non riusciva solo a ricordare quando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320606,
					"content": "Arashani non osa entrare in città. Arashani non ha visto Nara Avin, e così Arashani ha pensato che Nara avesse trovato dei nuovi amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320607,
					"content": "Questo è normale e inevitabile. Non è una cosa per cui addolorarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320608,
					"content": "Va tutto bene, capisco. È successo perché non sono riuscita a riprendermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320609,
					"content": "Ma penso di capire, adesso. Yoimiya ha ragione. Tutti possiamo avere sfortuna, ma dobbiamo sostenerci a vicenda nei periodi difficili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320610,
					"content": "Grazie per avermi aiutata a riscoprire i miei ricordi e i miei sogni. Farò tesoro del tempo che avete passato con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320611,
					"content": "#Eheh, anche tu ci hai aiutat{F#e}{M#i} molto, per cui non serve che ci ringrazi! A essere sinceri, non sapevamo da che parte girarci con quella Pietra di Ur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320612,
					"content": "Ma ora che siamo sulla pista giusta, sono convinta che la troveremo, sarà una passeggiata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320613,
					"content": "Yoimiya, hai bisogno di questa Pietra di Ur perché vuoi vedere una pioggia di meteore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320614,
					"content": "Sì. Ah! Quando la troveremo, dovresti venire con noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320615,
					"content": "Se le cose stanno così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320616,
					"content": "Sarò felice di prestarvi la mia Pietra di Ur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320617,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320618,
					"content": "Cos'è successo? Si è appena tirata fuori... una lente dal petto!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320619,
					"content": "Neanch'io so cosa stia succedendo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320621,
					"content": "Ahahah, come sapevi che ci serviva questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320622,
					"content": "Non lo sapevo. Ho solo pensato che, visto che voi mi avete aiutata a ritrovare il mio prezioso amico, io avrei aiutato voi usando qualcosa di prezioso per me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320623,
					"content": "E così la luce si è trasformata in questo. È ciò di cui avevate bisogno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320624,
					"content": "Grazie. Non mi aspettavo che avremmo risolto il nostro problema in questo modo. D'accordo, è ora di provarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320625,
					"content": "Non che io sappia come si usa, ma vediamo cosa mi suggerisce l'istinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320626,
					"content": "Dove sei...? Dove sei...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320627,
					"content": "Aah! Forse ho capito! In effetti... era abbastanza ovvio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320628,
					"content": "Vieni, faccio strada. Quando avremo finito di vedere la pioggia di meteore, ti porterò a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320629,
					"content": "E grazie per averci aiutato. Anzi, lasciamo perdere i convenevoli e lascia che vi faccia un complimento sincero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320630,
					"content": "#Siete davvero brav{F#e}{M#i} a raccontare le storie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320631,
					"content": "Oh, che coincidenza. Penso la stessa cosa di te, Nara rossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapurva"
				}
			]
		},
