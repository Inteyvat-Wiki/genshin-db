			"dialogs": [
				{
					"id": 752680101,
					"content": "*singhiozza* Perché nessuno vuole giocare a Pallascontro? Perché preferiscono partecipare alla sfida di schivate all'Arena circolare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752680102
					],
					"speakerTitle": "Makani"
				},
				{
					"id": 752680102,
					"content": "Siamo l'uno di fianco all'altra... e usiamo perfino gli stessi attrezzi! Non capisco cosa stiamo sbagliando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752680103
					],
					"speakerTitle": "Makani"
				},
				{
					"id": 752680103,
					"content": "Forse la nostra insegna non è abbastanza appariscente... O magari i visitatori non ci hanno notato...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752680104
					],
					"speakerTitle": "Makani"
				},
				{
					"id": 752680104,
					"content": "E se le aggiungessimo un tocco di colore? Potremmo darle un restyling, magari...",
					"roleType": "TALK_ROLE_NPC",
