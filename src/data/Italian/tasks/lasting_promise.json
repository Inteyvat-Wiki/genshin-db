			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "Allora è qui che vive l'essere soprannaturale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070102,
					"content": "Brrr... Se là dentro ci vive qualcuno, come mai fa così freddo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070103,
					"content": "Mmmh, mi stavo ponendo la stessa domanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070104,
					"content": "Che strano. Sono sicura che questo sia il luogo descritto da mia madre, ma... in effetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070105,
					"content": "Forse siamo nel posto sbagliato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "Mmmh... Non so se è stata una buona idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070108,
					"content": "Tuttavia, visto che siamo qui, credo che dovremmo entrare ed esplorare a fondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070109,
					"content": "Sì, hai ragione. Chissà, magari c'è una bella sorpresa che ci attende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070110,
					"content": "Allora, ehm... Che cosa c'era scritto sul taccuino, esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070111,
					"content": "Fatemi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070112,
					"content": "\"Una gru portò nel becco <color=#00E1FFFF>1</color> fiore appena colto per adornare i miei capelli, un coniglio bianco cucì <color=#00E1FFFF>4</color> raggi di luna sulla mia gonna. Così vestita, chiamai <color=#00E1FFFF>7</color> volte il nome di Tsubaki, rivolta verso <color=#00E1FFFF>est</color>. In un baleno, si aprì il varco che portava alla sua dimora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070113,
					"content": "Sembra una favola... Quindi tua madre officiava un breve rituale e Tsubaki veniva per incontrarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070114,
					"content": "Mi fa pensare proprio a un Adeptus, a dire il vero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "Ho la sensazione che si tratti di una sorta di codice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070116,
					"content": "Entriamo ed esploriamo un po' prima di trarre conclusioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070117,
					"content": "Buona idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070106,
					"content": "Forse Tsubaki è davvero una volpe messaggera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
		{
			"id": 1200702,
			"completionStepIds": [
				1200705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200705",
							"2"
						],
						"stepId": 1200705,
						"stateName": "QUEST_STATE_UNFINISHED"
