			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070201,
					"content": "Si è aperto? Si è aperto? Il nostro \"Adeptus inazumico\" ci ha lasciato un tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070202,
					"content": "Cos'è questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070203
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070203,
					"content": "Oh, sembra un libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070204,
					"content": "Parrebbe un altro taccuino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070205
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070205,
					"content": "Che sia il taccuino di Tsubaki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070206
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070206,
					"content": "Torniamo un attimo fuori. Qui dentro c'è un'atmosfera diversa da quella che mi aspettavo. Non so perché, ma... mi fa passare la voglia di sfogliare il taccuino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070207
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070207,
					"content": "Paimon capisce cosa vuoi dire. Leggere al buio non fa bene agli occhi. Su, andiamo fuori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200703,
			"completionStepIds": [
				1200707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200707",
							"2"
						],
						"stepId": 1200707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070301,
					"content": "*sospira* Possiamo fermarci qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070302,
					"content": "Molto bene. Vediamo cosa c'è nel taccuino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070303,
					"content": "Oooh, Paimon scommette che sapremo tutto del tesoro! Ah, che emozione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070304,
					"content": "Psss, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "Cosa c'è? Perché ti metti a sussurrare all'improvviso? Stai facendo agitare Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070306,
					"content": "Vieni con me. Andiamo laggiù.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070308,
					"content": "Aaaah, vuoi lasciare Ayaka da sola mentre legge il taccuino, senza distrazioni. Sembra che ci siano scritte delle cose importanti, in effetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070309,
					"content": "Ma, ehm, guardando la sua espressione, non si tratta di una mappa del tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070310,
					"content": "Mmmh, di cosa si tratterà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070311,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070312,
					"content": "*espira profondamente*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070313,
					"content": "#Viaggiat{F#rice}{M#ore}, Paimon... mi spiace avervi fatto aspettare così tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070314,
					"content": "Non preoccuparti, non è stata una grande attesa. Leggi molto in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070315,
					"content": "Hai finito di leggere il taccuino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070317,
					"content": "Sento il dovere di condividere la verità contenuta nelle sue pagine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070318,
					"content": "Nonostante il contenuto sia totalmente diverso da quanto mi aspettassi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070319,
					"content": "Diverso in che senso? Vuoi dire che non è il taccuino della volpe messaggera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070320,
					"content": "No, non lo è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070321,
					"content": "Alla fine, Tsubaki è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070322,
					"content": "...mia madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070323,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070324,
					"content": "#Siete sorpres{F#i}{M#e}, vero? Anch'io... Però è proprio quello che c'è scritto all'inizio del taccuino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070325,
					"content": "Ehm... \"Tsubaki e io siamo la stessa persona. Eppure, siamo differenti. Quando divento Tsubaki, non sono più Kamisato Kayo e divento la donna più semplice di questo mondo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070326,
					"content": "\"Ciò che segue in queste pagine è la vita di tutti i giorni di una persona come le altre. Niente di più, niente di meno\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070327,
					"content": "Questo taccuino è in gran parte una raccolta dei pensieri di mia madre, sia quelli più intimi che i meno importanti. Tutto ciò che pensavamo riguardasse Tsubaki riguardava invece mia madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070328,
					"content": "Quindi... questo vuol dire che il modello del kimono, le specialità esotiche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070329,
					"content": "Sono cose che mia madre desiderava provare, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070330,
					"content": "Sono sicura che potrà sembrarvi tutto molto strano, ma per me, almeno, il comportamento di mia madre è totalmente comprensibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070331,
					"content": "In altre parole, a dire il vero... anch'io sento di avere un altro lato in me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070332,
					"content": "Quando ho cominciato a leggere quei pensieri sul taccuino, sono rimasta senza parole. Era come se qualcuno avesse scrutato la mia mente, esaminato i miei pensieri e poi scritto ogni cosa su carta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070333,
					"content": "Ayaka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070334,
					"content": "Dal giorno in cui mia madre sposò mio padre, divenne la madre della famiglia Kamisato, con tutti i doveri che questo comporta. Allo stesso tempo, il prestigio della Commissione Yashiro comportò ulteriori responsabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070335,
					"content": "Come se non bastasse, ogni sua singola azione rappresentava il clan Kamisato. Aveva addosso gli occhi di tutti. In tali circostanze, non ebbe molto tempo per fare ciò che veramente desiderava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070336,
					"content": "Dopo la morte dei miei genitori, Ayato e io abbiamo assunto la gestione degli affari del clan. In quel periodo, ci siamo imbattuti in difficoltà di ogni tipo... Nessuno al di fuori del clan potrebbe mai immaginare quanto sia stato difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070337,
					"content": "Ogni volta che mi trovavo in difficoltà, mi chiedevo: \"Sarà accaduto anche a mia madre? Cosa avrebbe fatto lei in una situazione del genere?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070338,
					"content": "Forse è stato il fatto di non esserci viste per tanto tempo, ma... per qualche ragione, l'unica parte di lei che mi era rimasta in mente era quella che incuteva timore ed esigeva rispetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070339,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "Tuttavia... era un'immagine errata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070341,
					"content": "Nel leggere il taccuino, ho capito che... lei era esattamente come me. Oltre al ruolo che ricopriva, era una persona come le altre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070342,
					"content": "Le piacevano i kimono pregiati, desiderava assaggiare specialità provenienti da lontano e visitare luoghi che non aveva mai visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070343,
					"content": "Potrà sembrarvi immaturo, ma... anch'io mi sento così. Non voglio vivere la mia vita come Kamisato Ayaka, ma come una donna comune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070344,
					"content": "Mia madre ha scritto che le sarebbe piaciuto andare a uno dei festival locali di Inazuma. Diceva che, a volte, nelle notti di bel tempo, scrutando la vista dalla nostra casa, si poteva scorgerne le luci lontane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070345,
					"content": "Anch'io ho visto quelle luci! C'è tanta vitalità, tanta gente e tanta luce da far risplendere tutto il cielo... Ovviamente, qualche volta, mi mette anche un po' d'ansia in termini di ordine pubblico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070346,
					"content": "Per una persona del mio rango, però, presentarsi a un festival senza preavviso potrebbe essere considerato inappropriato. Specialmente ai tempi dei miei genitori, quando la Commissione Yashiro aveva pochi contatti con la popolazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070347,
					"content": "Anche se non ci avessero fermati, l'idea che qualcuno della Commissione Yashiro si mescolasse alla folla... non era certamente ben vista. La gente avrebbe cominciato a pensare che ci fosse qualche problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070348,
					"content": "Mia madre diceva che non voleva mettere in ansia le persone. Voleva che tutti si divertissero liberamente durante il festival. Non voleva disturbare nessuno, e comunque non aveva molto tempo libero, quindi non andò mai. Neanche una volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070349,
					"content": "Oh... Quindi quel modello di kimono era ciò che avrebbe voluto indossare se mai fosse andata a un festival, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070350,
					"content": "Esatto. E a volte, nei festival, vendono anche piatti internazionali. Avrebbe voluto assaggiarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070351,
					"content": "Non vorrei mancarle di rispetto, ma... non pensavo mia madre fosse rimasta così connessa con la bambina che era in lei, eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070352,
					"content": "Non le manchi affatto di rispetto! Paimon pensa che tua madre era la migliore su tutti i fronti: tenera in privato e ligia al dovere negli affari pubblici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070353,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070354,
					"content": "Senza saperlo, mi sono ritrovata ad avere già esaudito diversi desideri di mia madre. *sospira* Presentarmi a un festival, però, è una cosa che non posso fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070355,
					"content": "Forse è destino che non accada mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070356,
					"content": "Hai già fatto tante cose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "Capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070359,
					"content": "Vi ringrazio. Credo di avere appena compreso qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070360,
					"content": "Mia madre e io abbiamo davvero molto in comune. Le cose che ha affrontato sono le stesse che dovrò affrontare anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070361,
					"content": "Ha scelto di affidare i suoi desideri mai esauditi all'identità di Tsubaki. Quanto a me, ho già deciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070362,
					"content": "Oh! Quindi avrai anche tu un alter ego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070363,
					"content": "No, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070364,
					"content": "Non intendo fare nulla del genere. Penso... Penso che mi darò un nuovo obiettivo: vivere ogni singolo giorno senza rimpianti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070365,
					"content": "#Perciò, ehm... Viaggiat{F#rice}{M#ore}... Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070366,
					"content": "Su, respira profondo, Ayaka. Respira profondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070367,
					"content": "*sospira* Avresti voglia di andare a un festival di Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070368,
					"content": "Paimon sta morendo dalla voglia di andarci da quando ha visto il manifesto! Paimon vuole andare con Ayaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070369,
					"content": "Quindi non sei proprio mai andata a un festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "Ehi, dai, non prendermi in giro! Mi facevo solo gli stessi scrupoli che si faceva mia madre, ma ora penso di non dovermene più preoccupare così tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070371,
					"content": "Ho intenzione di essere me stessa e di esaudire i desideri comuni a me e a mia madre. So bene che tu mi capisci più di chiunque altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070372,
					"content": "Quindi... andiamo insieme, adesso! Andiamo a un festival insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070373,
					"content": "Mi farebbe molto piacere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "Anche Paimon vuole venire! Nei festival da queste parti ci sono tante cose buone da mangiare, vero? E poi si gioca e ci si diverte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070375,
					"content": "Meraviglioso! Grazie davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070376,
					"content": "Se ci avviamo subito, dovremmo arrivare in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070377,
					"content": "Oh, hai ragione. Oggi è l'ultimo giorno, vero? Cosa stiamo aspettando allora? Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070357,
					"content": "Non è colpa tua, è così che vanno le cose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}