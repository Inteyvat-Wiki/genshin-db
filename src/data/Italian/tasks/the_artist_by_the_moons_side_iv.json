			"dialogs": [
				{
					"id": 761200301,
					"content": "Mmh. Buona scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200302
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200302,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200303,
					"content": "Anche lei sembra piuttosto entusiasta... Woah, è filata subito verso la tela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200304,
					"content": "Sai, Colombina? A ben pensarci, i dipinti di Maalaus praticamente ripercorrono la tua storia da quando sei nata fino a oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200305,
					"content": "E quella storia non è ancora finita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200306
					]
				},
				{
					"id": 761200306,
					"content": "Infatti! Paimon è ansiosa di vedere altre opere della nostra grande pittrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200308
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200308,
					"content": "Oh, già finito? Velocissima come sempre, eh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200309,
					"content": "Fai vedere a Paimon... Oooh! Ma che meraviglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200310,
					"content": "Paimon non aveva idea che Teyvat vista dalla luna fosse così bella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200311,
					"content": "Ah... Ora capisco perché Maalaus dice che sono cambiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200312
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200312,
					"content": "Mmh? Che intendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200313,
					"content": "Guardando questo dipinto, me ne sono ricordata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200314
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200314,
					"content": "Mentre sedevo sulla luna, osservando Teyvat, ho pensato a come avessi sempre voluto una \"casa\" tutta mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200315
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200315,
					"content": "Ma ora, tutt'a un tratto, mi ritrovo con ben due case, ed entrambe sono luoghi di rara bellezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200316
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200316,
					"content": "È stato allora che ho capito che forse \"casa\" è ovunque si trovino le cose e le persone a cui tieni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200317
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200317,
					"content": "È un pensiero adorabile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200318
					]
				},
				{
					"id": 761200318,
					"content": "Grazie. Credo che dopo questa esperienza, mi piacerebbe portare le Kuuhenki sulla luna più spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200319
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200319,
					"content": "Se vi va, potete venire a visitare anche la mia \"altra casa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
