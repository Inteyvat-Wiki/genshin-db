			"dialogs": [
				{
					"id": 761200101,
					"content": "...Ecco. È per te. Te lo dovevo, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200102,
					"content": "Ehi, è una tela da disegno. Aspetta, questo significa che...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200103,
					"content": "Ah. Arrivate giusto in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200104,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200105,
					"content": "Beh, ma guarda chi si vede! Maalaus, la nostra pittrice d'eccezione! Da quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200106,
					"content": "#Allora, per cosa saremmo {F#arrivate}{M#arrivati} \"giusto in tempo\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "Ho portato Maalaus sulla luna per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200108,
					"content": "Non sai quanto ti invidia Paimon... Da come lo dici, per te è quasi come fare una passeggiata nel giardino accanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200109,
					"content": "Comunque, perché ci siete andate? In cerca di ispirazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200110,
					"content": "Non solo. Abbiamo anche scelto un luogo per quella \"mostra\". Ricordate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200111,
					"content": "Paimon se lo ricorda: la mostra della Dea della Luna di Maalaus! Non dimenticarti d'invitarci quando sarà il momento, intesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200112,
					"content": "Sì, certo. Inoltre, sembra che Maalaus riesca a percepire i vaghi cambiamenti che avvengono intorno a lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200113,
					"content": "Mi ha detto che sono cambiata molto da quando sono tornata dalla luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200114,
					"content": "Ecco perché ha voluto che ce la portassi, per vedere se c'era qualcosa di speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200115,
					"content": "Ah! Un atteggiamento da vera artista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200116,
					"content": "Quindi, questa cosa speciale sarebbe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "Neanch'io ne sono sicura. Ho portato Maalaus in tanti posti, ma nessuno l'ha soddisfatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200118,
					"content": "Cioè, almeno finché non l'ho portata nei pressi della tua nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200119,
					"content": "Intendi l'astronave?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "Ma dopo esserci avvicinate, ho capito che non era interessata alla nave in sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200122,
					"content": "Eh? Che vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200123,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200124,
					"content": "Ooh, ti sta volando intorno, Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200125,
					"content": "Ahah. L'ha fatto anche lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200126,
					"content": "Credo che il suo vero interesse riguardi la mia espressione dopo aver visto l'astronave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200127,
					"content": "La tua... espressione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200128,
					"content": "#Sì. Mi ha ricordato di quando ci siamo {F#andate}{M#andati} io e {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200129,
					"content": "#Eravamo {F#sedute}{M#seduti} in cima alla nave a guardare Teyvat. {F#Lei}{M#Lui} ha scoperto la verità sul passato e io ho trovato la mia \"casa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200130,
					"content": "Il solo pensarci mi ha dato una sensazione di pace... o forse, di felicità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200131,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200132,
					"content": "Sì, hai ragione. Sono sensazioni che non avevo mai provato prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200133,
					"content": "Così, ho raccontato a Maalaus la nostra storia, compreso quello che è successo dopo aver raggiunto la luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200134,
					"content": "Mi è sembrata molto entusiasta, come se avesse trovato l'ispirazione che tanto agognava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200135,
					"content": "Ah. Questo significa che la grande artista sta per compiere la sua magia, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200136,
					"content": "Hihi, quella volta non hai portato Paimon lassù, quindi anche Paimon è curiosissima di sapere cosa dipingerà Maalaus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200137,
					"content": "E stavolta che vernice useremo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "Stavolta sarà qualcosa di speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200139,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200140,
					"content": "Maalaus dice che vuole dei colori che appartengano solo a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200141,
					"content": "E... che significa, di preciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200142,
					"content": "Credo si riferisca ai ricordi legati a questo viaggio, a ciò che hai ottenuto e alla gioia che ti ha donato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200143,
					"content": "Non preoccuparti. Maalaus vuole solo vedere e toccare oggetti del genere. Non utilizzerebbe mai come vernice qualcosa di così prezioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200144,
					"content": "Cosa le hai dato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "Terra della luna e il biglietto per la Notte di Preghiera lunare che mi avete dato voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761200146,
					"content": "#Oh, in pratica dev'essere qualcosa che rappresenti quest'avventura, giusto? Benissimo. {NICKNAME}, a te la scelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200120,
					"content": "Beh, di certo è una cosa molto particolare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
