			"dialogs": [
				{
					"id": 766550101,
					"content": "Flins! Ce l'hai fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550102,
					"content": "Naturalmente. Devo ringraziarvi. Il faro è molto più bello ora che gli è stata fatta manutenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550103,
					"content": "Eheh, non c'è di che! Ma sembra che anche con un faro in funzione, questo posto rimanga ancora molto buio. Ci sono luoghi che la luce non può raggiungere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550104,
					"content": "Sì. Sembrava che il tempo nel cimitero si fosse fermato per sempre al termine della battaglia avvenuta quella notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550105,
					"content": "Non avevo alcuna intenzione di cambiare la cosa, ma pare che, accendendo il faro, il tempo abbia ripreso a scorrere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550106,
					"content": "Questo avrà degli effetti sulla tua vita?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "Se vuoi sapere se sarò in difficoltà per qualche motivo, la risposta è no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550110,
					"content": "La vita è un ciclo. Anche se non ci fossimo noi, i fantasmi che indugiano qui svanirebbero lentamente e tornerebbero alle linee geomantiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550111,
					"content": "Non preoccuparti, questo faro non può illuminare ogni singolo angolo dell'isola. Man mano che i fantasmi svaniranno, anche la nebbia che avvolge quest'area scomparirà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550112,
					"content": "Il sole deve sorgere prima o poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550108,
					"content": "Scusaci, non era nostra intenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "Ah, non scusarti, non sono contrario a questo cambiamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				}
			]
		}
	]
