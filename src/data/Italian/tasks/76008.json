					}
				]
			},
			"dialogs": [
				{
					"id": 760080101,
					"content": "#Ah, che il chiaro di luna illumini il vostro cammino! Siete {F#venute}{M#venuti} anche voi a pregare Lady Kuu{RUBY#[S]Fanciulla lunare}tar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080102
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080102,
					"content": "Pregare... intendi pregare davanti a questa statua? Wow, è davvero enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760080103,
					"content": "Eheh, bella, vero? Si dice che questo \"Idolo della Luna nuova\" sia stato scolpito da una Cantaluna cinquecento anni fa, raffigura la forma originale di Lady Kuu{RUBY#[S]Fanciulla lunare}tar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080104
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080104,
					"content": "Per quanto riguarda la nascita di Lady Kuu{RUBY#[S]Fanciulla lunare}tar e i miracoli che ha compiuto in questo globo sublunare... sono solo un'umile accolita, quindi mi asterrò dal fornirvi troppi dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080105
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080105,
					"content": "#A ogni modo, questa è la destinazione finale del pellegrinaggio per offrire i propri desideri a Lady Kuu{RUBY#[S]Fanciulla lunare}tar. Anche se non siete {F#venute}{M#venuti} a pregare, spero possiate percepire la sua benedizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080106
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080106,
					"content": "Ah, ora Paimon ha capito... Eh? Aspetta, questa è la fine? E allora che cos'è quel pilastro enorme là davanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760080107,
					"content": "Ahahah... in realtà non è un pilastro. Al di sotto si trova la \"Corte del Primo Editto\", un antico santuario che fu sigillato cinquecento anni fa per decreto della Cantaluna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080108
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080108,
					"content": "In un certo senso... si potrebbe dire che è un terreno proibito per noi Eredi della Luna gelata. E a causa del sigillo della Cantaluna, nessuno può più entrarvi, quindi è meglio non avvicinarsi troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080109
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080109,
					"content": "Ah, quell'enorme edificio là... è caduto dal cielo. Per grazia di Lady Kuu{RUBY#[S]Fanciulla lunare}tar, le macerie non hanno fatto male a nessuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080110
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080110,
					"content": "Ehm, macerie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760080111,
					"content": "Sì, quando è caduta, diversi frammenti si sono staccati. Uno di essi è caduto nell'<color=#00E1FFFF>accampamento sottostante</color>... Voi due l'avete visto mentre venivate qui, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080112
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080112,
					"content": "Per quanto riguarda gli altri frammenti leggermente più grandi, ricordo che sono caduti principalmente a <color=#00E1FFFF>ovest</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760080113
					],
					"speakerTitle": "Eveliina"
				},
				{
					"id": 760080113,
					"content": "#Ad ogni modo, se siete {F#riuscite}{M#riusciti} ad arrivare {F#entrambe}{M#entrambi} fin qui deve essere stato grazie alla guida di Lady Kuutar. Anche se non siete qui per pregare, possa il chiaro di luna benedire il vostro cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eveliina"
				}
			]
		}
	]
}