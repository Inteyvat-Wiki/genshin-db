			"dialogs": [
				{
					"id": 737140101,
					"content": "Hihi, il prossimo è un percorso speciale che Paimon ha scelto dopo un'attenta pianificazione! Ci sarà da camminare un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140102,
					"content": "Prima tappa, l'oasi nel deserto! Poi attraverseremo la Foresta di Mawtiyima e infine torneremo a Porto Bayda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140103,
					"content": "Paimon ci stava pensando... Il deserto, la foresta e le valli di Sumeru sono così diversi tra loro! Ma non li abbiamo mai visti tutti in un solo viaggio, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140104,
					"content": "Meno male che questa volta non siamo di corsa! Paimon dice di prendercela con calma e godercela appieno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140105,
						737140106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140105,
					"content": "Certo! Niente fretta, solo relax!",
