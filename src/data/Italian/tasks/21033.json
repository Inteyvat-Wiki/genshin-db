			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "Ho un'idea che potrebbe dare i suoi frutti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330102,
					"content": "Stai ancora cercando quella spada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "#Ah, sei tu, viaggiat{F#rice}{M#ore}. Certamente, sto ancora cercando la Lama nascosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330104,
					"content": "Ma tuttora non ho nessuna pista valida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330105,
					"content": "Trovare una spada a Liyue è un po' come trovare un ago in un pagliaio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330106,
					"content": "Qualcuno mi ha detto che la spada potrebbe essere stata distrutta da un mostro molto tempo fa. Ma, anche se così fosse, potrei trovarne ogni singolo frammento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330107,
					"content": "#Chiedo scusa, sto divagando. Il luogo che vorrei controllassi stavolta è segnato sulla tua mappa. Grazie per il tuo aiuto, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330108,
					"content": "Spero solo che la spada non sia davvero rotta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
