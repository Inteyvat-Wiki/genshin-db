			},
			"dialogs": [
				{
					"id": 210330403,
					"content": "Quest'elsa... sembra ancora intatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330404,
					"content": "Pensi abbia a che fare con la Lama nascosta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "Dovrò esaminarla nel dettaglio per scoprirlo... Ah, dimenticavo: è da diverso tempo che perlustro queste terre alla ricerca di questi frammenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330406,
					"content": "Ne ho raccolti un bel po' al mercato, in mezzo alla natura... Alcuni li ho persino comprati dagli avventurieri... Speravo mi avrebbero condotta alla Lama nascosta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330407,
					"content": "Ma non ho ancora trovato neanche un indizio che mi potesse aiutare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330408,
					"content": "Ah, non importa. A Liyue c'è un detto: \"Volere è potere\". Continuerò a cercare... Finché non troverò la Lama nascosta, punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 210330409,
					"content": "#Tieni, viaggiat{F#rice}{M#ore}. Una ricompensa per il tuo impegno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		}
