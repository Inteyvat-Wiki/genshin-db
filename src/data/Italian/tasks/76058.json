			"dialogs": [
				{
					"id": 760580101,
					"content": "Non ho mai visto una Donnoladra così bianca prima. E se fosse malata...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580102,
					"content": "Era piena di energia fino a poco fa, e ha persino cercato di rubare il cibo a Jurva. Non mi sembra affatto malata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580103,
					"content": "Forse è una specie rara? Linnea potrebbe saperlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580104,
					"content": "Ehi! È il ladro di Mora che si è preso i risparmi di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580105,
					"content": "La Donnoladra cerca di scappare, ma i tre bambini sono incredibilmente veloci. Riescono a immobilizzarla e, dopo una breve lotta, si arrende. Ne approfitti per spiegare cosa è successo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "Quindi non è la prima volta che lo fa? Allora dobbiamo darle una lezione! Se fai qualcosa di sbagliato, vieni punito. È giusto, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580107,
					"content": "Ma... È solo un animale. Non capisce cos'è giusto e cos'è sbagliato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580108,
					"content": "Finché a Paimon vengono restituiti i suoi Mora, siamo a posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "Comunque, prima restituiamo i Mora a Paimon. Non è che la donnola possa spenderli, quindi dovrebbero essere ancora tutti lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580111,
					"content": "Evviva! Ehehe, il tesoro segreto di Paimon è sano e salvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580112,
					"content": "Vorrei che potessimo tenerla. Così, al suo ritorno, potremmo mostrare a Helka una rara Donnoladra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580113,
					"content": "Eh? Ma non ci sarà mai utile... Rubare non conta! Perché dovrebbe ricevere cibo gratis senza fare nulla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580114,
					"content": "Va bene, va bene, ma cosa dovremmo farne...? Comunque, ne parliamo dopo con Katya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580109,
					"content": "Anche gli animali devono capire che il mondo può essere crudele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
}