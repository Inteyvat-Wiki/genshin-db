					"nextDialogs": [
						401720203
					]
				},
				{
					"id": 401720203,
					"content": "Bene, cominciamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720204,
					"content": "Ho bisogno di un altro po' di tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720205
					]
				},
				{
