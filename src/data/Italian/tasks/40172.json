			},
			"dialogs": [
				{
					"id": 401720401,
					"content": "È apparsa un'altra immagine! È... È una mappa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720402,
					"content": "Una mappa? Una mappa per dove?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720403
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720403,
					"content": "Sarà... il Mare Jivari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720404
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720404,
					"content": "Il Mare Jivari?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720405,
					"content": "Il Mare Jivari divenne una landa desolata in seguito alla grande battaglia. O meglio, prese il nome proprio a causa degli eventi accaduti lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720406,
					"content": "Il campo di battaglia si coprì delle ceneri dei mostri e dei guerrieri caduti. A volte, si udivano urla agghiaccianti provenire dalle profondità. Altre, invece, il posto si copriva completamente di fuoco e fiamme, soffocando le urla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720407
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720407,
					"content": "È un posto pericoloso e pieno di mistero. Nei secoli, i più abili avventurieri provarono a dimostrare il proprio valore raggiungendo il Mare Jivari, ma purtroppo lì finì spesso la loro avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720408,
					"content": "Tutto ciò continuò fino a circa venti o trent'anni fa, quando iniziarono a verificarsi strani avvenimenti. Alcuni dissero di aver visto un'enorme, oscura creatura alta quanto una montagna vagare per il Mare Jivari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720409
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720409,
					"content": "Poco dopo, tutta la regione sparì completamente. Nessuno sa cosa sia successo, ma quel posto minaccioso scomparve dalla faccia di Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720410,
					"content": "Cosa?! Ma com'è possibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720411,
					"content": "Infatti! Comunque, se ricordo bene, il posto indicato qui è dove si trovava un tempo il Mare Jivari prima che scomparisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720412,
					"content": "E dove si trova?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720413
					]
				},
				{
					"id": 401720413,
					"content": "Nella parte più occidentale di Natlan, in una regione lontana da tutte le nostre tribù. Non vi è mai stato alcun tipo di insediamento lì, ma dalla scomparsa del Mare Jivari, hanno cominciato a vedersi più e più persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720414,
					"content": "Comunque non ci sono mai stata di persona. Tutto quello che so è per sentito dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720415
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720415,
					"content": "È l'età: più si invecchia e meno si è disposti a lanciarsi all'avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720416
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720416,
					"content": "È solo una scusa. In realtà Nonna è pigra e non le va di viaggiare lontano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720417
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720417,
					"content": "Fermi tutti! Uno spirito si sta avvicinando al frammento e al rotolo di tessuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720418
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720418,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720419
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720419,
					"content": "Ooh! Il corpo di Leyla sta reagendo di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720420,
					"content": "Stavolta la reazione è stata parecchio intensa. Significa che stava davvero cercando l'ubicazione del Mare Jivari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720421
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720421,
					"content": "C'è un'anima molto vicina a noi... La sento anch'io. Ha l'aria di essere completa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720422,
					"content": "Aaah! A Paimon dà decisamente i brividi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720423,
					"content": "A quanto pare il piano sta funzionando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720424
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720424,
					"content": "Perciò, ehm... Ora possiamo svegliarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720425,
					"content": "Non oggi. Riportare uno spirito nel suo corpo non è esattamente come riempirlo con dell'acqua, è molto più complesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720426
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720426,
					"content": "Devo prendere in prestito una spada cerimoniale e ultimare altri preparativi. Mi ci vorrà circa un altro paio di giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720427
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720427,
					"content": "Tranquilli. Ora che il suo spirito è tornato, ci rimane solo una cosa da fare. Rivediamoci dopodomani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		}
	]
}