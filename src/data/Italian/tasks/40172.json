			"dialogs": [
				{
					"id": 401720101,
					"content": "Ehilà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720102,
					"content": "Ah, Nonna. Sei tornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720103
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720103,
					"content": "Non hai buone notizie, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720104,
					"content": "#Mi leggi nel pensiero. {NICKNAME} ha riunito molti spiriti e io li ho controllati uno per uno. Ma nessuno di loro combacia con la descrizione di Leyla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720105,
					"content": "Immaginavo. Te lo si leggeva in faccia. Va bene così, in ogni caso non facevo troppo affidamento sull'approccio ago nel pagliaio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720106,
					"content": "Le condizioni di Leyla sono ancora stabili, ma non abbiamo fatto progressi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720107
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720107,
					"content": "Beh, io per fortuna ho fatto progressi. I genitori di Leyla mi hanno detto che di recente si era fatto un amico e trascorreva giorni interi fuori casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720108,
					"content": "Una volta hanno pure seguito Leyla di nascosto e l'hanno visto armeggiare assieme all'amico con qualcosa in un accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720109,
					"content": "Hanno visto il suo amico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720110
					]
				},
				{
					"id": 401720110,
					"content": "Sì, un ragazzo che si chiama Kokuchuu. Indossava degli indumenti di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720111,
					"content": "È davvero tutto ciò che mi serve, signor Kokuchuu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720112
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720112,
					"content": "Secondo quanto ho imparato dai testi antichi, l'ipersensibilità viene spesso trattata con una terapia di desensibilizzazione. Ne ho dedotto che non c'è motivo per cui non dovrebbe funzionare anche al contrario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720113
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720113,
					"content": "Essendo una persona che non possiede alcuna sensibilità verso gli spiriti, per ottenere l'effetto sperato, dovrai immergerti completamente in sostanze ricche di energia spirituale. Vorrei chiamare questo approccio \"terapia di ipersensibilizzazione\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720114
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720114,
					"content": "...Ed è pericoloso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720115
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720115,
					"content": "In quanto inetto spirituale, sai meglio di me quali sono le potenziali conseguenze della chiaroveggenza forzata. La decisione è solo tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720116
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720116,
					"content": "Ok... Ma ho un'ultima domanda... Perché mi vuoi aiutare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720117
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720117,
					"content": "Dopotutto, la gente come me non ha molta influenza nella tribù, quindi non posso nemmeno ripagarti in qualche modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720118
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720118,
					"content": "Pensi che sia qui perché voglio essere ripagato? Oh, cielo! Guardami bene in faccia. Non vedi la risposta scritta lì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720119
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720119,
					"content": "Ehm... Che c'è scritto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720120
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720120,
					"content": "\"Una persona gentile felice di aiutare il prossimo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720121
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720121,
					"content": "Che? Quindi un tizio di Inazuma vuole semplicemente aiutare Leyla a guarire da... dalla sua inettitudine spirituale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720122,
					"content": "Terapia della ipersensibilizzazione, eh? Che idea innovativa. Ma potrà davvero funzionare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720123
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720123,
					"content": "A giudicare da come sta Leyla, su di lui non ha funzionato così bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720124,
					"content": "Umpf, puoi dire tutto, tranne che sia un'idea innovativa. La nostra tribù la offriva come trattamento molti anni fa, ma dato il basso tasso di successo e l'elevato rischio, ne venne presto vietata la pratica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720125
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720125,
					"content": "Per quanto riguarda questo Kokuchuu... credo fermamente che abbia un suo piano. Casualmente è scomparso proprio dopo che Leyla è finito in questa situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720126
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720126,
					"content": "I genitori di Leyla mi hanno dato l'indirizzo dell'accampamento e sono andata a controllarlo. C'erano ancora delle tracce fresche di energia spirituale e... Guardate cosa ho trovato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720127
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720127,
					"content": "Cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720128
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720128,
					"content": "Un frammento... Sembra che appartenesse a un'arma o a un qualche strumento cerimoniale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720129
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720129,
					"content": "Lo senti anche tu? Può sembrare antico, ma ha delle tracce di energia spirituale molto potenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720130
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720130,
					"content": "Leyla deve averlo usato come tramite. Questo spiega come abbia fatto un inetto spirituale come lui a iniziare una seduta di chiaroveggenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720131
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720131,
					"content": "Un momento... Anch'io percepisco qualcosa... Qualcosa di familiare... Credo che abbia a che fare con il mio Nome antico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720132,
					"content": "E come? Dici... Dici che questo potrebbe essere un frammento di un Nome antico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720133,
					"content": "No... Credo piuttosto che l'oggetto possa essere appartenuto a un detentore precedente del mio Nome antico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720134
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720134,
					"content": "Che appartenesse a Sanhaj?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720135
					]
				},
				{
					"id": 401720135,
					"content": "Ok, basta così, Nonna ha finito la pazienza, è ora di fare una seduta di chiaroveggenza. Userò questo frammento come tramite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720136
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720136,
					"content": "#Ok, facciamo come la volta scorsa? {NICKNAME} può usare il telaio spirituale per annotare tutto su un rotolo di tessuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720137,
					"content": "No, stavolta lo farà Ororon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720138
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720138,
					"content": "Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720139
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720139,
					"content": "È una misura preventiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720140
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720140,
					"content": "#Conosci il regno degli spiriti meglio di {NICKNAME}. Se davvero si tratta di una reliquia di Sanhaj, confido che sapresti cosa fare se le cose si mettessero male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720141
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720141,
					"content": "#Ah... Vedi, Paimon? Te l'ho detto che Nonna ha occhi solo per {NICKNAME}. Non vuole per nessun motivo che si metta in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720142
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720142,
					"content": "Un banale nipote come me è ben più sacrificabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720143
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720143,
					"content": "Ehi! Che hai da blaterare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720144
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720144,
					"content": "Scusa, Nonna. Sono pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720145
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720145,
					"content": "Allora iniziamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720149
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720146,
					"content": "Citlali inizia la sua seconda seduta di chiaroveggenza usando il misterioso frammento come tramite.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401720147
					]
				},
				{
					"id": 401720149,
					"content": "Ok, fatto! Vediamo cosa c'è questa volta sul rotolo... sembra un arco rotto che brucia tra le fiamme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720150,
					"content": "Guardate, uno dei pezzi non vi sembra uguale al frammento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720151
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720151,
					"content": "È vero! A quanto pare proviene dalla struttura dell'arco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720152,
					"content": "Ho visto un arco come questo in uno dei rotoli a casa di Nonna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720153
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720153,
					"content": "...Sì, è l'arma usata da Sanhaj nella Battaglia del Mare Jivari. Direi proprio che questa è la prova che il frammento sia un'autentica reliquia appartenuta all'eroe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720154
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720154,
					"content": "#Il solito Sanhaj... Nonostante la fluttuazione spirituale della reliquia fosse incredibilmente intensa, non sono stato in pericolo neanche per un secondo. Nemmeno {NICKNAME} avrebbe avuto problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720155
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720155,
					"content": "Un vero e proprio eroe! Anche dopo generazioni, gli oggetti che gli appartenevano aiutano a curare gli inetti spirituali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720156,
					"content": "Però io non riesco a credere che l'unico intento di Kokuchuu fosse curare la condizione di Leyla. Secondo me ha altri piani in mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720157
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720157,
					"content": "Beh... Abbiamo visto l'arco per intero, no? Forse voleva vederlo anche lui per trovare le altre parti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720158,
					"content": "Non vedo cosa potrebbe ricavarne... Sì, sono delle reliquie di un oggetto appartenuto a Sanhaj, ma dubito che possa farsene qualcosa di un arco rotto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720159
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720159,
					"content": "E poi, perché mai chiedere aiuto a un inetto spirituale? Significa fallire ancora prima di cominciare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720160
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720160,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720161
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720161,
					"content": "Eh? Il corpo di Leyla sta reagendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720162,
					"content": "Fatemi vedere. Percepisco uno spirito attirato dalla reliquia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720163
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720163,
					"content": "Sembra che il piano di Nonna stia funzionando. Lo spirito di Leyla è attirato dall'esca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720164
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720164,
					"content": "In tal caso, fatemi riprovare. Stavolta userò sia il corpo di Leyla che il frammento come tramiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720165
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720165,
					"content": "Puoi farcela, Nonna. Anche io farò del mio meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720166
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720166,
					"content": "Stavolta posso controllare io il telaio spirituale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720167
					]
				},
				{
					"id": 401720167,
					"content": "Senti il desiderio di partecipare, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720168
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720168,
					"content": "Beh, Ororon l'ha già fatto, è più che giusto fare a cambio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720169,
					"content": "Per me va bene. E poi abbiamo visto che è uno strumento sicuro, per cui non dovrebbero esserci problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720170
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720170,
					"content": "Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720171
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720171,
					"content": "D'accordo, se vuoi provare, fai pure. Dimmi quando posso iniziare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
