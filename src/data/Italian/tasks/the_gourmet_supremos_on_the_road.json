			"trigger": {
				"objectNames": [
					"???",
					"Julie",
					"Parvaneh",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "Cosa posso fare per voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000202,
					"content": "Perdonami, tu saresti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "Sono Kamei Munehisa, sono solo di passaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000204,
					"content": "Wow... Questo tipo si veste come un samurai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000205,
					"content": "S... samurai? È lui il samurai dello Shogunato...? Ho sentito che l'atteggiamento dello Shogunato nei confronti degli stranieri è piuttosto... subdolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000207,
					"content": "Non preoccupatevi. Ho lasciato lo Shogunato. Non sono più un samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000208,
					"content": "Vengo spesso qui in cerca di cibo. Oggi, però, ho notato che c'erano dei mostri che vagavano in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000209,
					"content": "Hanno preso tutto il cibo qui intorno. Quindi ho dovuto sconfiggerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000210,
					"content": "Vieni spesso qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "Di solito non ci sono molti mostri qui intorno. Vengo di frequente qui per raccogliere frutta o cacciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000217,
					"content": "Beh, questo è tutto quello che ho da dire. Dopo aver ucciso questi mostri, gli altri nei paraggi non oseranno venire qui per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000218,
					"content": "Se anche voi state cercando del cibo, date un'occhiata in giro. Io prendo giusto il necessario. Dovrebbe essere rimasto qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000219,
					"content": "Beh, alla prossima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000220,
					"content": "Davvero se n'è andato così? Il suo comportamento è esattamente come quello dei samurai di cui ho sentito parlare prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000221,
					"content": "Ma cosa significa che ha lasciato lo Shogunato? I samurai che lasciano lo Shogunato sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000222,
					"content": "Sono come i nemici che abbiamo incontrato prima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "Sì, ho sentito dire anche che alcuni samurai che hanno lasciato lo Shogunato se ne vanno in giro a derubare la gente in strada per sopravvivere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000225,
					"content": "Anche se non sembra una cattiva persona, meglio tenere gli occhi aperti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000226,
					"content": "Va bene, va bene. Non eravamo qui per cercare degli ingredienti? A giudicare dalla situazione attuale, però, è meglio non proseguire oltre. Potrebbe essere pericoloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000227,
					"content": "#Quest{F#a}{M#o} viaggiat{F#rice}{M#ore} ci ha accompagnato per così tanto tempo. Fermiamoci qui a cucinare qualcosa, facciamo una piccola pausa e poi torniamo in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000228,
					"content": "Il tizio ha detto che sono rimasti ancora degli ingredienti in zona, giusto? Diamo un'occhiata in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000223,
					"content": "Come i Kairagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "Hai ucciso tu tutti questi mostri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "Sì. Sono solo mostri comuni. Sono facili da affrontare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000214,
					"content": "Perché stai cercando del cibo nella natura selvaggia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000216,
					"content": "Ho i miei motivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7280003,
			"completionStepIds": [
				7280011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280010",
							"2"
						],
						"stepId": 7280010,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280011",
							"2"
						],
						"stepId": 7280011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Julie",
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "Stavo giusto cercando degli ingredienti freschi... A ogni modo, questi andranno bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000302,
					"content": "Mi dispiace. Volevo cucinarti qualcosa di buono, ma per ora immagino che dovremo accontentarci di questi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000303,
					"content": "Non importa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "Hai faticato molto per accompagnarci. \"Non importa\" non è una risposta accettabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000305,
					"content": "Non me ne dimenticherò. La prossima volta ti preparerò un pasto delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000308,
					"content": "Julie, la zuppa è pronta? Ricordati di non lasciare che Parvaneh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000309,
					"content": "No, no, lascia cuocere a fuoco lento la zuppa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000310,
					"content": "Va bene. Sto condendo questa zuppa seguendo la mia ricetta perfezionata. Aggiungo solo un po' di condimento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000311,
					"content": "Non capisco proprio la tua ricetta perfezionata. Fermati! Xudong, Xudong, vieni qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000312,
					"content": "Parvaneh! Ehi! Che condimento strano stai aggiungendo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000313,
					"content": "Condimento strano? Questa è la mia salsa speciale! È il risultato della ricerca per la mia tesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000314,
					"content": "Non è necessaria! Mangiamo qualcosa di normale oggi! Julie, fermala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000315,
					"content": "Tsk, ma che ne sai tu... Va bene, lascia che aggiusti tutto. Preparerò il condimento supremo che renderà ogni piatto delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000316,
					"content": "Il condimento supremo... È davvero possibile una cosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000317,
					"content": "Nessuno ci è mai riuscito, per questo lo preparerò io! Gliela farò vedere a quei miscredenti presuntuosi dell'Akademiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000318,
					"content": "Ahah... Beh, non vedo l'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000319,
					"content": "#Comunque, viaggiat{F#rice}{M#ore}, grazie mille per aver passato tutto questo tempo a farci da scorta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000320,
					"content": "Ti preparerò del cibo d'asporto. Devi avere abbastanza cibo quando ti avventuri là fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000321,
					"content": "La prossima volta che ci incontreremo, ti preparerò un pasto come si deve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000306,
					"content": "La prossima volta verrò a cercarti e ti chiederò di prepararmi un banchetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
					"id": 728000307,
					"content": "Ahahah, va bene. Ne prenderò nota. Mi assicurerò di prepararti qualcosa di delizioso la prossima volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
}