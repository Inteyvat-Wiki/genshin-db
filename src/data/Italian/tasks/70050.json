			},
			"dialogs": [
				{
					"id": 700501001,
					"content": "Eh? Dov'è andata Guijarro? Non era qui un attimo fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501002,
					"content": "Immagino sia stata rapita da una Bestia Xuanwen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "Ehi, non dire così! Probabilmente è corsa da qualche parte pensando alla trama. Perlustriamo la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501005,
					"content": "Quel campo di tè sembra un buon punto di osservazione, partiamo da lì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "Buona idea! Iniziamo la ricerca dall'alto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501003,
					"content": "Magari il suo romanzo si è trasformato in una storia vera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				}
			]
		},
		{
			"id": 7005012,
			"completionStepIds": [
