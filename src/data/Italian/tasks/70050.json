					}
				]
			},
			"dialogs": [
				{
					"id": 700500501,
					"content": "Visto? Paimon l'aveva detto che era un gattino qualunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500502,
					"content": "Oh... E pensare che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500503,
					"content": "Miao? Miao... miao, miao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Gattino confuso"
				},
				{
					"id": 700500504,
					"content": "Hai mai sentito parlare delle Bestie Xuanwen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "Miao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Gattino confuso"
				},
				{
					"id": 700500508,
					"content": "Il gatto si gira e se ne va con la frustrazione negli occhi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "Eppure... Pensi che questo gattino possa essere la forma giovanile della mitica bestia, che si nasconde qui nel Villaggio di Qiaoying finché non sarà completamente cresciuta e potrà distruggere tutte le piante di tè in un colpo solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500510,
					"content": "Signorina Guijarro, non ricominciamo... Comunque, non le ho già detto che le Bestie Xuanwen non sono così delicate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500511,
					"content": "Ah, signorina Hung Fan! Che coincidenza. Cosa la porta qui oggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500512,
					"content": "*sospira* Per favore, smetta di menzionare cose come \"casi criminali\" qui... E se i bambini cominciassero a prenderla sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500513,
					"content": "Vi conoscete?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Sì. Quando sono arrivata qui, l'ho assunta per aiutarmi a trasportare i bagagli e l'ho consultata su ogni tipo di folklore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500515,
					"content": "Le ho detto innumerevoli volte che le Bestie Xuanwen non appariranno qui, ma non mi crede. Cos'è che aveva risposto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500516,
					"content": "Anche se non appariranno, avrò comunque molti modi per raccogliere informazioni su di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500517,
					"content": "Ci risiamo... Sapevo che le mie speranze di dissuaderla erano scarse, ma devo comunque chiederle di non uscire dal villaggio con leggerezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500518,
					"content": "Le bestie sono piuttosto pericolose, quindi se dovesse davvero incontrarne una... *sospira* Comunque, non lasci il villaggio da sola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500519,
					"content": "Hung Fan se ne va con un'aria ancora più esausta e rassegnata del gatto di prima...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Beh, visto che la signorina Hung Fan ha detto così, dovremo andare altrove a prendere il nostro materiale. Forza, seguitemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500506,
					"content": "Scusa, abbiamo sbagliato gatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Gattino confuso"
				}
			]
		},
		{
			"id": 7005006,
			"completionStepIds": [
				7005006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7005006",
