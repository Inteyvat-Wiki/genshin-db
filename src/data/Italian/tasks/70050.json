						],
						"stepId": 7005006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guijarro"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2276.275,
							287.313,
							1542.857
						],
						"pointId": 311400058
					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "Che ne pensate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500602,
					"content": "Un calderone da tè.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "Esatto, e... rende il tè alquanto speciale, anche se non so bene come... In ogni caso, è stato piazzato esattamente al centro di questo posto! Immagino ci sia un senso in tutto questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500604,
					"content": "Uhm... Vediamo, magari... quella Bestia Xuanwen si è rifugiata in questo posto per tutto il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500605,
					"content": "Di questo passo scriverai una storia fantasy, sai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "Ci manca solo che tu aggiunga qualche Adeptus alla storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "Non so se sia il tipo di trama ideale per un giallo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "Mmmh, che espressioni interessanti. State forse pensando che un giallo incentrato su una Bestia Xuanwen potrebbe sembrare troppo \"assurdo\" per essere preso sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500610,
					"content": "Beh, uhm, sì, più o meno? Si può davvero usare una cosa del genere per sviluppare la trama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "Aspetta, non dirmi che...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Ahah, ottimo intuito, {NICKNAME}! Di sicuro sei all'altezza della tua fama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500613,
					"content": "Proprio così! Ho intenzione di scrivere di un \"crimine troppo assurdo per essere possibile\". Le vostre reazioni e quelle della signorina Hung Fan, sono molto interessanti. Le includerò sicuramente nel mio romanzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500614,
					"content": "Per quanto riguarda la Bestia Xuanwen... sarà il mio \"carnefice\": una creatura che non è mai stata vista, ma che si dice divori i malfattori del villaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500615,
					"content": "Durante una certa festa, si scopre che un abitante del villaggio è stato ucciso da una bestia selvaggia fuori dall'insediamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500616,
					"content": "Ma, durante il secondo giorno di festa, il protagonista incontra la vittima, che dovrebbe essere morta... Solo che subito dopo emerge un'altra vittima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500617,
					"content": "Aspetta... e poi? Poi cosa succede?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "Beh, non ci ho ancora pensato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500619,
					"content": "Me ne vado.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "Oh, dai! Quando avrò finito, vi manderò due copie autografate. In realtà, c'è ancora un grosso favore per il quale ho bisogno del vostro aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500621,
					"content": "La signorina Hung Fan ha detto che non dovrei lasciare il villaggio da sola, giusto? Beh, ho preso il suo consiglio alla lettera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500622,
					"content": "Ma... ora che siete qui, non sono più sola! Questo significa che posso uscire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500623,
					"content": "#Non ci allontaneremo troppo, ovviamente! Allora, siete {M#disposti}{F#disposte} ad aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500624,
					"content": "Beh, certo... Lo faremo, così potrai raccontarci la fine della tua storia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Bene! Allora andiamo? C'è un posto dove mi piacerebbe andare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500625,
					"content": "Il pagamento va effettuato secondo il modello standardizzato, grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Certo, ci mancherebbe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500606,
					"content": "Non credo che questo sia più un giallo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
		{
			"id": 7005008,
			"completionStepIds": [
				7005008
