						],
						"pointId": 311400064
					}
				]
			},
			"dialogs": [
				{
					"id": 700501201,
					"content": "Guijarro! Come sei finita qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501202,
					"content": "No, no... Non posso permettere che trovino l'indizio chiave così facilmente. E poi, esiste davvero qualcuno in grado di pensare lucidamente dopo essere rimasto legato qui tutta la notte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501203,
					"content": "Wow, è completamente assorta. Ha finalmente trovato la svolta che cercava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501204,
					"content": "Più che altro è un vero e proprio intoppo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#{NICKNAME}, Paimon, siete {M#arrivati}{F#arrivate} giusto in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501206,
					"content": "Potreste legarmi a un palo di legno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501207,
					"content": "P-Paimon ha sentito bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501208,
					"content": "Sì, è esattamente quello che ho detto. Per favore, legatemi le mani e appendetemi a un... albero. Beh, sono comunque tutti fatti di legno, quindi non dovrebbe fare differenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501209,
					"content": "#Non intendo diventare {M#il sospettato}{F#la sospettata} del tuo romanzo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "Oh, non c'è di che preoccuparsi, ho già redatto una dichiarazione che mi attribuisce la responsabilità di tutti gli incidenti che potrebbero accadere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501211,
					"content": "No, no, non è questo il problema. Perché vuoi che ti leghiamo? Non hai fatto nulla di male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501212,
					"content": "Il fatto è che il protagonista del mio romanzo sarà appeso per le mani dagli abitanti del villaggio e lasciato all'aperto per una notte intera, in attesa del giudizio della Bestia Xuanwen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501213,
					"content": "Successivamente, dopo varie vicissitudini, il protagonista riuscirà a sopravvivere e, dopo aver superato la notte, rivelerà la verità che si cela dietro ogni cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501214,
					"content": "Però, non ho idea di come si sentirebbe una persona che è stata legata per una notte intera, né di come parlerebbe, penserebbe o si muoverebbe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501215,
					"content": "Ecco perché ho bisogno che voi due mi leghiate e mi lasciate qui per tutta la notte. Così potrò provare io stessa quelle sensazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501216,
					"content": "No. È troppo pericoloso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "Mmmh. Beh, c'è, ma probabilmente non sarebbe altrettanto efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501219,
					"content": "Potrei... alzare le mani e rimanere qui per tutta la notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501220,
					"content": "Ehm... Oppure potresti semplicemente non scrivere quel romanzo. Le nostre azioni qui potrebbero essere facilmente fraintese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501221,
					"content": "Stai davvero mettendo a dura prova il tuo personaggio principale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "Per favore! Questo è il passo più importante! Una volta superato questo ostacolo, il mio romanzo sarà completo! Se usiamo questo metodo, non dovrete commettere alcun crimine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501223,
					"content": "Non l'avremmo fatto comunque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501224,
					"content": "Ma nemmeno prima dovevamo commettere crimini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "Ah... Beh, in realtà non dovete fare molto, solo stare di guardia al mio fianco per evitare che qualcuno... o qualche animale... mi trascini via mentre raccolgo le informazioni di cui ho bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501226,
					"content": "Vediamo... Considerando l'atmosfera che stiamo cercando di creare nel romanzo, dobbiamo ancora andare più in alto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501227,
					"content": "Eh? Ehi! Aspettaci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501228,
					"content": "Voi e Guijarro salite fino al punto più alto dei campi di tè...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "Fiuuu. Fa... un po' f-freddo, ma... ti fa entrare nell'atmosfera giusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501230,
					"content": "Hai davvero intenzione di stare qui tutta la notte con le mani alzate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501231,
					"content": "Proprio così, ho deciso. Bisogna fare qualche sacrificio per il bene della letteratura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501232,
					"content": "Per favore, fate la guardia qui nel frattempo. Solo una notte... Solo una notte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501217,
					"content": "Non c'è un modo più sicuro per farlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
		},
