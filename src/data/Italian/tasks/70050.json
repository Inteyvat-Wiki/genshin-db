			"dialogs": [
				{
					"id": 700501501,
					"content": "Non credo che il personaggio sarebbe in grado di tornare al villaggio da solo in queste condizioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501502
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501502,
					"content": "Guijarro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501503,
					"content": "Prima aiutiamola ad alzarsi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501504
					]
				},
				{
					"id": 700501504,
					"content": "Aiutate Guijarro ad alzarsi e sedersi per terra.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501505
					]
				},
				{
					"id": 700501505,
					"content": "Allora è così che ci si sente... È davvero terribile. Non sono solo esausta fisicamente... Anche il mio cervello sembra assopito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501506
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501506,
					"content": "Quindi, missione compiuta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501507
					]
				},
				{
					"id": 700501507,
					"content": "Certo, finalmente so cosa si prova a essere legati, appesi e lasciati alle intemperie per una notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501508
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501508,
					"content": "Il tuo protagonista è decisamente tosto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501509,
					"content": "Esattamente. Ho anche pensato a come il protagonista scaccerà la Bestia Xuanwen. Se concludiamo la storia in questo modo, sicuramente... Sicuramente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501510,
					"content": "OoEh? Finirà alla grande con un trucco fantastico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501511,
					"content": "Sarà sicuramente... fantastico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501512,
					"content": "Guijarro sviene ancora una volta...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501513
					]
				},
				{
					"id": 700501513,
					"content": "Ehi! Ehi! Guijarro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501514,
					"content": "Non potevi dire come andava a finire PRIMA di svenire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501515
					]
				},
