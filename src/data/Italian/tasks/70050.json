			"dialogs": [
				{
					"id": 700500801,
					"content": "Queste sono \"lanterne\"? Sembrano pesci... Davvero affascinanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500802,
					"content": "Quindi queste maniglie possono essere usate per sollevare le lanterne? Mmmh... Con questa struttura smontabile, qualcuno che ci sappia fare con la progettazione ingegneristica potrebbe facilmente aggiungere una o due sezioni in segreto senza farsi scoprire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500803,
					"content": "Lo spazio all'interno è piuttosto ampio. Dovrebbe essere possibile inserire qualche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500804,
					"content": "Basta! Tieni quei pensieri per te!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "Eh? Oh... Giusto! Ahahah, mi dispiace. Non riesco a trattenermi dal pensare ad alta voce quando vedo queste cose affascinanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500806,
					"content": "Mmmh. Sì, ne sono certa: usare le \"lanterne\" aggiungerà molto al mio romanzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500807,
					"content": "Vi dispiacerebbe andare lì accanto e scattare una foto di questa \"lanterna per pesci\" per me? Vorrei avere un'immagine di riferimento per il futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500808,
					"content": "Beh, immagino che sia il momento di affinare ancora un po' la mia abilità con la Fotokamera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "Allora lascio che ci pensiate voi... Ah, sì. Assicuratevi di scattare una foto dell'intera lanterna: per me è importantissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500811,
					"content": "Studiare un piano legato alle \"dimensioni\" sarà molto interessante... La domanda ora è come risolveranno il problema del peso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500809,
					"content": "Faccio io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
