			"dialogs": [
				{
					"id": 740730501,
					"content": "Sembra che ci fosse qualcuno poco fa. Hanno già capito in anticipo come funziona il piccolo meccanismo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730502,
					"content": "C'è un falò che brucia ancora lì per terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730503,
					"content": "E allora perché c'è un falò in un posto come questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730504,
					"content": "Fammi vedere cosa c'è scritto sulla tavoletta di pietra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730505,
					"content": "Questo posto è l'or... l'ort...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730506,
					"content": "Ottante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730507
					]
				},
				{
					"id": 740730507,
					"content": "\"...Ottante della Memoria, la Sala della Memoria, la Stanza della Memoria...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730508,
					"content": "\"Nato in un istante\"... \"In frequente contraddizione, ti accompagno nell'eterno riposo, in unione perpetua\"... \"Il fuoco non può bruciarlo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730509,
					"content": "Un indovinello, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730510,
					"content": "La risposta dev'essere il fuoco! C'è anche un falò qui vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730511,
					"content": "Ma quale indovinello contiene la soluzione al suo interno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730512
					]
				},
				{
					"id": 740730512,
					"content": "Oh, certo! Allora cosa pensi che sia, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
