			"dialogs": [
				{
					"id": 740730601,
					"content": "Litiasi. Sai, calcoli renali e cose simili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730602
					]
				},
				{
					"id": 740730602,
					"content": "È vero, il fuoco non li distrugge, e rimangono nei nostri organi e tessuti... Ma non nasce in un istante, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730603,
					"content": "Oh, certo! Allora cosa pensi che sia, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
