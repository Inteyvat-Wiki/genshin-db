					"nextDialogs": [
						740732302
					]
				},
				{
					"id": 740732302,
					"content": "Qualcuno ha preso... quello che c'era qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732303,
					"content": "Pare proprio di sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732304
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732304,
					"content": "Ma chi è...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732305
					]
				},
				{
					"id": 740732305,
					"content": "È Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732306
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732306,
					"content": "In passato abbiamo avuto uno scontro a Elynas. Cioè, in realtà di recente, non \"in passato\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740732307,
					"content": "Appena ho visto quella sfortunata vittima ai cancelli, ho capito che era opera sua. A quanto pare, è ancora attivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732308
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732308,
					"content": "E allora cosa vuole farne della roba che si è preso da qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732309,
					"content": "Semplice, anche lui vorrebbe riforgiare la Spada sacra di Narzissenkreuz. Il sogno dell'Ordo rimane irrealizzato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732310
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732310,
					"content": "Tuttavia, ora dovremmo dirigerci verso l'area finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
