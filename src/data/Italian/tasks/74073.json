			"dialogs": [
				{
					"id": 740730701,
					"content": "Le ombre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730702
					]
				},
				{
					"id": 740730702,
					"content": "Oh, la risposta esatta sembra proprio essere \"le ombre\"! Sono con noi per tutta la vita, e il fuoco non le brucia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730703,
					"content": "Ma qual è la finalità del trovare la soluzione di un indovinello che è già stato risolto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
