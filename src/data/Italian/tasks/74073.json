						740730403
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730403,
					"content": "Il momento in cui un fascio di luce brilla, nasce un'ombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730404
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730404,
					"content": "Sappiamo la risposta, ma qualcuno ha già aperto la porta. Cosa facciamo adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730405,
					"content": "Adesso possiamo entrare, ovviamente. È una corsa contro il tempo, dobbiamo trovare ciò che cerchiamo prima che lo faccia chiunque abbia risolto l'indovinello prima di noi.",
