			"dialogs": [
				{
					"id": 740730101,
					"content": "Il falò brucia ancora. Aspetta, perché c'è un falò qui? Questa è solo una rovina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730102,
					"content": "Fammi vedere cosa c'è scritto sulla tavoletta di pietra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730103,
					"content": "\"Osservate, questo posto è l'Ottante della Memoria, la Sala della Memoria, la Stanza della Memoria\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730104,
					"content": "\"Nato in un istante\"... \"In frequente contraddizione, ti accompagna nell'eterno riposo, in unione perpetua\"... \"Il fuoco non può bruciarlo\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730105,
					"content": "Indovinelli, eh? L'antica civiltà di Fontaine li adorava, così come l'Ordo Narzissenkreuz. Non so dirvi se gli piacessero solo in quanto roba vecchia, o se ne fossero genuinamente interessati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730106,
					"content": "Ho già provato con ricerche di parole chiave su tutti loro, ma non ho avuto risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730107,
					"content": "Ma questo indovinello è già stato risolto. Forse la risposta ha a che fare con il falò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730108,
					"content": "Qual è la finalità dello scervellarsi su degli indovinelli che sono stati già risolti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730109,
					"content": "C'è una finalità. Proprio come io e te che siamo entrambi così adesso, ma dobbiamo comunque andare alla ricerca di quello che è successo in passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740730110,
					"content": "Hai ragione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730111,
					"content": "#Quale pensi sia la risposta, Cavalier {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
