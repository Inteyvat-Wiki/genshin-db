			"dialogs": [
				{
					"id": 740732101,
					"content": "Ispezioni con cura lo spazio sulla parte alta del meccanismo, ma non trovi niente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732102
					]
				},
				{
					"id": 740732102,
					"content": "Non c'è niente qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732103,
					"content": "Sembra che ci fosse qualcosa, ma che qualcuno l'abbia portata via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732104,
					"content": "Aspetta, ma non significa che il nostro piano è già fallito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732105,
					"content": "La nascita della \"Ragione\" richiede la fusione dei quattro ottanti. Se riusciamo a ottenere gli altri, avremo ancora un'occasione per metterlo in pratica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740732106,
					"content": "In tal caso, meglio sbrigarci e procedere verso la prossima area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
		{
