				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awhina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "Ho visto che avete portato indietro Chuychu... Che tragedia! Era la dottoressa più promettente che avessi mai avuto il piacere d'incontrare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300202,
					"content": "Lavoravamo spesso assieme. Aveva degli standard molto alti quanto ai rifornimenti medici, e spesso pagava di tasca sua pur di curare i suoi pazienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300203,
					"content": "Mi diceva sempre che le importava più dell'esperienza che dei soldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300204,
					"content": "Diceva di dover perfezionare le sue abilità per salvare più persone possibili, e una di queste in particolare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300205,
					"content": "Purtroppo, alla fine, l'unica persona che non è riuscita a salvare è stata sé stessa. E ora Natlan ha perso uno dei migliori talenti di una generazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Awhina"
				}
			]
		},
