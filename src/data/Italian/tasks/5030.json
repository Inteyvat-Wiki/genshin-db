				"points": []
			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "Siete voi due! Fantastico! Grazie mille per l'incoraggiamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300802,
					"content": "Molte persone a Natlan considerano un onore combattere contro l'Abisso, ma poi si lasciano trasportare dall'entusiasmo e finiscono per mettersi in grave pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300803,
					"content": "Avevate ragione: combattere è importante, ma lo è anche sopravvivere. Lottiamo per le persone che amiamo, e anche per la possibilità di rivederle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300804,
					"content": "Ho condiviso i tuoi pensieri con i miei compagni d'armi, e anche loro si sono sentiti motivati. Ora tutti combattono con più determinazione, e stiamo cambiando le sorti della battaglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300805,
					"content": "Quindi, ancora una volta... Grazie dal profondo del mio cuore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
		{
			"id": 503009,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
