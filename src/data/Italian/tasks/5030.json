						50300504
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300504,
					"content": "Va bene, beh... Dammi almeno quello che mi spetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300505
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50301601,
					"content": "Ah, siete voi. Sono felice di vedere che state bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300506,
					"content": "Come sta tuo figlio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "Non ne ho idea. Le comunicazioni si sono interrotte e ci sono troppi feriti da curare. Per ora, il mio obiettivo è occuparmi di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300508,
					"content": "Ma mi fido di lui. So che farà la scelta giusta anche quando le cose si metteranno male. È mio figlio, e ne sarò sempre fiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				}
			]
		},
		{
