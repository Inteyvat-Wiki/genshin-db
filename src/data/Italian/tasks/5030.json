					"nextDialogs": [
						50301106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301106,
					"content": "Sì, esatto, i Fatui! Sono stati fantastici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301107
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301107,
					"content": "Sì. In passato, la mia opinione dei Fatui non era esattamente positiva, ma ho cambiato idea. Ci sono persone buone in tutte le organizzazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iyoba"
				}
			]
