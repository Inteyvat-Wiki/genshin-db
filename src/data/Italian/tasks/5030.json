					"nextDialogs": [
						50301505
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301505,
					"content": "Mi sento molto fortunato a essere vivo. Dobbiamo continuare a sopravvivere, così potremo iniziare a riprenderci ciò che abbiamo perso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301506
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301506,
					"content": "Fareste meglio a sopravvivere anche voi.",
					"roleType": "TALK_ROLE_NPC",
