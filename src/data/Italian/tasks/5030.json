			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qhispe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "Oh, per tutti gli Archon, non so che fare... Non abbiamo abbastanza uomini e risorse, e non riesco nemmeno a curare la metà delle ferite che vedo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300102,
					"content": "Vorrei solo avere qualcuno di più esperto a cui rivolgermi... Uh, no, non devo farmi venire questi pensieri. Devo essere forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qhispe"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"503002",
							"2"
						],
						"stepId": 503002,
						"stateName": "QUEST_STATE_UNFINISHED"
