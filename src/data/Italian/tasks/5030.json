			"dialogs": [
				{
					"id": 50300301,
					"content": "Com'è la situazione? Abbiamo abbastanza rifornimenti medici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300302
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300302,
					"content": "Li abbiamo quasi finiti. Ci sono ancora le scorte di emergenza, ma sono riservate ai medici e ai soldati. Non possiamo toccarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300303
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300303,
					"content": "Lo so, lo so...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300304
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300304,
					"content": "Va bene, beh... Dammi almeno quello che mi spetta.",
					"roleType": "TALK_ROLE_NPC",
