			"dialogs": [
				{
					"id": 50300601,
					"content": "Sono davvero grata a Mayahuel per essere qui. Con la sua esperienza, siamo riuscite a curare molte più persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300602
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300602,
					"content": "Ma temo che stia esagerando. Non si è fermata un attimo. Devo chiedere a qualcun altro di intervenire, in modo da persuaderla a fare una pausa.",
					"roleType": "TALK_ROLE_NPC",
