			},
			"dialogs": [
				{
					"id": 50300901,
					"content": "...Ah, siete voi due. Pensavo che non ci saremmo più visti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300902
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300902,
					"content": "Ho combattuto bene e abbiamo vinto, anche se ci è costato molto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300903
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300903,
					"content": "Continuerai a combattere? In tal caso, ti prego di fare attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300904
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300904,
					"content": "Combattere contro l'Abisso è un grande onore, ma la strada verso la vittoria non è nell'onore e nella gloria, ma nel sopravvivere fino al giorno successivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
