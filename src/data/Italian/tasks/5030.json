					"nextDialogs": [
						50301402
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301402,
					"content": "Abbiamo solo mantenuto la parola! Avevamo detto che ti avremmo incontrato all'Arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301403,
					"content": "Eheh... Sai, questa è stata la prima volta che ho sconfitto un mostro dell'Abisso in tutta la mia vita, e in quel momento ho capito che... non sono poi così forti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301404
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301404,
					"content": "Ho lasciato che la paura avesse la meglio su di me per fin troppo tempo... Mi chiedo quante persone avrei potuto salvare, se solo ne avessi avuto il coraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301405
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301405,
					"content": "Non essere così duro con te stesso. Al momento, sopravvivere è la cosa più importante che puoi fare. Dobbiamo vivere per raccontare le loro storie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301406
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301406,
					"content": "Vivranno per sempre nei nostri cuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Libiac"
				}
			]
