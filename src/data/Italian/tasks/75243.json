			},
			"dialogs": [
				{
					"id": 752430101,
					"content": "#Ah, {F#mia cara}{M#mio caro} cliente, mi hai salvato. Grazie per aver scacciato quei Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430102,
					"content": "Non so da dove siano sbucati quegli stolti, ma hanno messo direttamente le mani nella mia borsa, senza manco provare a minacciarmi! Sono dei ladri, dei ladri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430103,
					"content": "#Grazie al cielo sei {F#intervenuta}{M#intervenuto} tu! Se non fosse stato per te avrei perso tantissimo... Ti prego, accetta i miei ringraziamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430104,
					"content": "Ah, giusto, quasi dimenticavo di presentare il posto. Questo è il Parco degli Alpaca Splendisole, dove potrai ammirare dolci esemplari d'alpaca, nonché comprare le loro riproduzioni giocattolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430105,
					"content": "Ma quei teppisti hanno spaventato sia il personale che gli ospiti... Adesso mi tocca occuparmi del problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430106,
					"content": "Se vuoi visitare il Parco degli Alpaca, torna domani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
