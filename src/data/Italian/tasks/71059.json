					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590401,
					"content": "Rieccoti. Hai trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590402,
					"content": "Non importa se non hai trovato niente. Vai a riposarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590403,
					"content": "Non preoccuparti per me... Non sono una persona ansiosa. Dopotutto, non mi dispiacerebbe passare qui la mia pensione. Magari ti chiederò di aiutarmi a presentare la domanda di pensionamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590404,
					"content": "Wow, di certo ti stai riposando bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590405,
					"content": "Bah, se continui a tornare qui senza portarmi informazioni... Chissà, magari mi troverai a riposare... per sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105906,
			"completionStepIds": [
				7105907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105907",
							"2"
						],
						"stepId": 7105907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "Eh... Questi sono gli emblemi lasciati dal tipo dei Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590601,
					"content": "Mmmh... Non ci sono tracce lasciate da umani. Cosa dovremmo dire a Katya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590602,
					"content": "Beh, Paimon pensa che non ci sia molto da fare. Torniamo indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "Questi sono... emblemi, registri delle attività e... una lettera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591306,
					"content": "Ti prego, dimmi dov'è Kolya. È ancora vivo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591307,
					"content": "Non l'abbiamo trovato, ma probabilmente è ancora vivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "Kolya non diserterebbe e non mi abbandonerebbe mai. Ne sono certa, me lo sento. Non fuggirebbe di fronte a uno scontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591310,
					"content": "Dove hai trovato queste cose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591311,
					"content": "In una caverna a sudest. Te la segno sulla mappa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "È un posto inquietante con tanti mostri al suo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591313,
					"content": "G-Grazie... Mi dispiace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591314,
					"content": "Io... Spero che Kolya abbia venduto cara la pelle. Preferisco pensare che sia andata così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591315,
					"content": "Kolya, ti prego, non disonorare la Tsaritsa. Non disonorare me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591316,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "Ehm... sto bene. Mi sono solo commossa un po'. Ah, mi rendo conto solo ora di non avervi ringraziato a dovere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591318,
					"content": "Dunque, ecco dell'Acquafuoco... *sospira* Ma tu non bevi, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591319,
					"content": "Ho un po' di Mora... e alcuni materiali che ho raccolto. Ora non mi servono, quindi prendili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591320,
					"content": "Quale sarà la tua prossima mossa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "La mia prossima mossa? Grazie per l'offerta, ma non mi serve più il tuo aiuto per i miei \"piani malvagi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591323,
					"content": "Beh, magari andrò a cercare Kolya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591324,
					"content": "Mi ha scritto una lettera prima della mia riassegnazione, che ho qui con me. È l'unica prova che mi è rimasta della sua esistenza e la porterò con me per sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591325,
					"content": "Se è ancora vivo... In quanto membro dei Fatui e fedele alla Tsaritsa, darò la caccia a questo traditore e lo ucciderò, ovunque si nasconda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591326,
					"content": "Se non è più in vita... Come sua sorella maggiore, accetterò l'inevitabile destino di ogni Fatuus e sarò orgogliosa di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591327,
					"content": "Quando diciamo \"Se non noi, allora chi\"... Beh, è questo il significato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591328,
					"content": "E se tu avessi piani malvagi e io dovessi fermarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "Arriva sempre un momento in cui non hai più scelta. E tutti abbiamo i nostri doveri, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591333,
					"content": "#Sei troppo seri{F#a}{M#o}. Cioè, lo capisco. I giovani che non sono abbastanza cresciuti per reggere l'alcol tendono ad annegare nelle preoccupazioni più disparate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591334,
					"content": "Insomma, vedremo, no? Vedremo cosa farò quando dovrò affrontare l'ultima e inevitabile scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591335,
					"content": "Per ora, ho bisogno di un pisolino... Vuoi riposare anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591336,
					"content": "Qui c'è solo un materasso di paglia. Non è molto comodo! Stai solo cercando di liberarti di noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591337,
					"content": "Bah, non vedo come sia un mio problema! Ah, che peccato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591338,
					"content": "#Viaggiat{F#rice}{M#ore}, grazie dell'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591330,
					"content": "Devi per forza portarli a termine alla maniera dei Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "Sì. È così strano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591332,
					"content": "Comunque... Idee, prospettive... Sono approfondimenti tremendamente noiosi! Bah... Non pensare che sotto la mia maschera ci siano solo concetti astratti. Qui sotto non sono certamente immune alle ferite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591321,
					"content": "Hai bisogno del mio aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "Potrebbe essere scappato attraverso un tunnel segreto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "\"Sono arrivato in questa camera segreta. Il mostro meccanico è ancora lì fuori in agguato, come un feroce predatore, non aspetta altro che io esca fuori...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "Diario del kapral Nikolay"
				},
				{
					"id": 710591402,
					"content": "\"La mia gamba sinistra ha una brutta ferita e fa un male cane. L'ho fasciata alla meglio, ma si sta gonfiando... potrebbe trattarsi di un'infezione...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "Diario del kapral Nikolay"
				},
				{
					"id": 710591403,
					"content": "\"La grotta ha un'altra uscita, ma non so dove porti. La sua conformazione sembra fragile. Senza un qualche supporto potrebbe crollare, se colpita violentemente...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "Diario del kapral Nikolay"
				},
				{
					"id": 710591404,
					"content": "\"Mi hanno visto! Sta arrivando qualcuno. È... uno spadaccino... vestito di nero?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "Diario del kapral Nikolay"
				},
				{
					"id": 710591405,
					"content": "\"Eh, no... Sembra che nemmeno le sbarre di metallo possano fermarlo. Mi basta guardarlo per capirlo nel mio profondo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "Diario del kapral Nikolay"
				},
				{
					"id": 710591406,
					"content": "\"Katya, mi dispiace\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diario del kapral Nikolay"
				}
			]
		}
	]
}