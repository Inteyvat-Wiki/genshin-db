			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "\"Oh, no! Si è rotta la balalaika di Katya. Devo averla danneggiata durante gli scontri. Devo farla riparare prima che mi mangi vivo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "Frammento del diario del kapral Nikolay"
				},
				{
					"id": 710590202,
					"content": "\"È stato così che i nostri antenati hanno combattuto la calamità cinquecento anni fa? Una volta il Kapitan-Poruchik disse che non conoscevamo un centesimo delle battaglie estenuanti che i nostri antenati avevano affrontato...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "Frammento del diario del kapral Nikolay"
				},
				{
					"id": 710590203,
					"content": "(Molte pagine centrali sono sporche di una sostanza nera. Quando le ripulisci, la scritta a inchiostro diventa completamente illeggibile.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "Frammento del diario del kapral Nikolay"
				},
				{
					"id": 710590204,
					"content": "\"Non posso continuare a stare qui. Potrebbero facilmente rintracciare le mie orme nel fango nero...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "Frammento del diario del kapral Nikolay"
				},
				{
					"id": 710590205,
					"content": "\"Adesso mi dirigerò nella direzione opposta, per allontanarli dal resto dello squadrone...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "Frammento del diario del kapral Nikolay"
				},
				{
					"id": 710590206,
					"content": "\"C'è un'apertura vicino alle rovine della roccaforte, nel lato a sudest. Forse potrei prendere quella strada...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "Frammento del diario del kapral Nikolay"
				},
				{
					"id": 710590207,
					"content": "\"Augurami buona fortuna. Se non noi, allora chi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frammento del diario del kapral Nikolay"
				}
			]
		},
		{
			"id": 7105903,
