			"dialogs": [
				{
					"id": 711630201,
					"content": "#Zibai non sembra essere qui... E dire che ci aveva {F#invitate}{M#invitati} lei! Dove si sarà cacciata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630202,
					"content": "Mmh! Questo parasole sembra familiare... L'abbiamo già visto da qualche parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630203,
					"content": "Forse è di Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630204
					]
				},
				{
					"id": 711630204,
					"content": "Probabilmente hai ragione... Ma perché mai lo lascerebbe qui vicino alla porta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630205,
					"content": "In effetti, ha una pessima memoria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630206
					]
				},
				{
					"id": 711630206,
					"content": "Che facciamo? Di questo passo, Paimon ha paura che si dimenticherà come usare le bacchette mentre mangia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630207,
					"content": "*sospira* Meglio andare a cercarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630208,
					"content": "#Aspetta un momento... Non sono {F#sicura}{M#sicuro} che questo sia davvero un parasole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630209
					]
				},
				{
					"id": 711630209,
					"content": "Oh? Allora cos'è? Mmh... Paimon darà un'occhiata più da vicino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630210,
					"content": "Woah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7116303,
