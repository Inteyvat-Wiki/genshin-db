			},
			"dialogs": [
				{
					"id": 751501301,
					"content": "Hai qualche domanda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501302
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501302,
					"content": "Come possiamo accedere al Cuore della Montagna Sacra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "L'accesso al Cuore della Montagna Sacra è possibile tramite l'entrata recentemente scoperta... Addentratevi nella faglia più profonda del vulcano, custodita da un Idolo del Drago della Fonte segreta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501304
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501304,
					"content": "Tenete presente che chiunque desideri accedere al Cuore necessita di ottenere un \"permesso\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501305,
					"content": "Trattasi dell'unico modo per ottenere il riconoscimento dell'Idolo del Drago della Fonte segreta che custodisce... il Cuore della Montagna Sacra, altresì noto come Huitzilopochtli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501306,
					"content": "Dove possiamo trovare questo \"permesso\"...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "Secondo il contratto e l'editto emessi da Lord Xiuhcoatl, l'accesso... al Cuore della Montagna Sacra, altresì noto come Huitzilopochtli... è consentito ai discendenti di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501308,
					"content": "Procedere alla Camera delle Delibere e presentare la domanda, poi attendere il rilascio del permesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501309,
					"content": "Cosa puoi dirmi sulla fonte di energia necessaria agli Idoli del Drago della Fonte segreta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "Ricerca in corso... La ricerca non ha prodotto risultati... I dati relativi alla richiesta, così come molti dati di altra natura, potrebbero essere andati persi a causa della contaminazione dell'Abisso che ha colpito la città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501311,
					"content": "Se riuscirai a eliminare l'influenza dell'Abisso e a recuperare i dati, forse potrai trovare le informazioni richieste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501312,
					"content": "Ho individuato una possibile ubicazione per i dati. Eliminare la contaminazione dell'Abisso presente per ripristinare l'area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501313,
					"content": "Hai qualche domanda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501314,
					"content": "Non ho altre domande...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501315
					]
				},
				{
					"id": 751501315,
					"content": "Ricevuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Servitore della Fonte segreta"
				}
			]
		},
