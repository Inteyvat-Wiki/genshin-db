						751501102
					]
				},
				{
					"id": 751501102,
					"content": "Secondo il contratto e l'editto emessi da Lord Xiuhcoatl, l'accesso... al Cuore della Montagna Sacra, altresì noto come Huitzilopochtli... è consentito ai discendenti di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501103
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501103,
					"content": "Procedere alla Camera delle Delibere e presentare la domanda, poi attendere il rilascio del permesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501104
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501104,
					"content": "Se desiderate andarci, posso indicarvi la posizione.",
