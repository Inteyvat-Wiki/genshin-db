			"dialogs": [
				{
					"id": 751500401,
					"content": "Come possiamo accedere al Cuore della Montagna Sacra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "L'entrata al Cuore si trova qui vicino. Quando ricreò il centro della città di Tollan, Lord Xiuhcoatl scavò nel sottosuolo al fine di creare un ambiente sperimentale stabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500403,
					"content": "E lì, egli costruì l'arma finale capace di contrastare l'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500404,
					"content": "Tuttavia, il sigillo ha permesso all'Abisso di corrodere il dispositivo e, di conseguenza, invadere la città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500405,
					"content": "L'entrata al Cuore della Montagna Sacra si trova sotto le fenditure della Città sacra... È lì che la corruzione del nostro oscuro nemico si è più profondamente insediata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Servitore della Fonte segreta"
				}
			]
		},
