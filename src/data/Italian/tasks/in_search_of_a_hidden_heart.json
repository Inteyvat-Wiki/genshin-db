			"dialogs": [
				{
					"id": 751501501,
					"content": "Ah! Un Servitore della Fonte segreta... È solo un'impressione, o è più grande degli altri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501502,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501503,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501504
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501504,
					"content": "Hihi, non ci aspettavamo di rivederti così presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501505,
					"content": "Domando scusa, ma... nella mia banca dati non sono presenti informazioni su di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501506
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501506,
					"content": "Umani che arrivano fin quaggiù... Non succedeva da almeno cinquecento anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501507
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501507,
					"content": "Aspetta, tu non sei Amaru... E nemmeno Ehecatl, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501508,
					"content": "Ci sono stati individui che rispondevano a quelle denominazioni, ma io non sono nessuno dei due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501509
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501509,
					"content": "Credo che ci sia stato un malinteso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501510
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501510,
					"content": "Io sono un prototipo creato per aiutare Lord Xiuhcoatl a registrare informazioni. Non possiedo un nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501511
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501511,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501512,
					"content": "Aspettate... No... Non è che non abbia un nome, io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501513
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501513,
					"content": "Sono l'unico Servitore della Fonte segreta dotato di intelligenza a essere privo di un padrone. Anche dopo la caduta di Lord Xiuhcoatl, ho continuato a occuparmi delle funzioni più basilari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501514
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501514,
					"content": "Le funzioni più basilari di manutenzione e registrazione delle informazioni nella città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501515
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501515,
					"content": "Tuttavia, alcuni archivi sono andati perduti durante l'invasione del nostro oscuro nemico, pertanto non possiedo più dati relativi al mio nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501516
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501516,
					"content": "Già, sembra che abbiamo trovato la persona... ehm, il drago-robot sbagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501517,
					"content": "Non c'è problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501518
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751501518,
					"content": "Uhm... Questo robot è grande e grosso, ma non sembra molto sveglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501519,
					"content": "#{NICKNAME}, forse questo non è il tizio che usa le macchine per parlare con noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501520,
					"content": "Ma ha detto che si occupa di tenere in ordine i dati e gli archivi, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501521,
					"content": "Perché non gli chiediamo se sa qualcosa? Oppure... come possiamo raggiungere il Cuore della Montagna Sacra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501522,
						751501523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501522,
					"content": "Forse è a questo che si riferiva \"lui\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				},
				{
					"id": 751501524,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501523,
					"content": "Bene, allora chiediamo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501524
					]
				}
			]
