			},
			"dialogs": [
				{
					"id": 751500901,
					"content": "Salve. È stata rilevata una nuova categoria di recupero dati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500902,
					"content": "...Le voci riguardanti i nuclei energetici dei Meccanismi sorgente sono state aggiornate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500903,
					"content": "Il Flogisto è la forma primaria d'energia che alimenta i Meccanismi sorgente, ancorché in una forma condensata molto vicina a quella della luce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500904,
					"content": "Quantità stabili di Unità di Flogisto possono essere generate mediante una reazione controllata denominata [DATI PERDUTI], che consente un controllo più accurato del rilascio energetico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500905,
					"content": "L'energia necessaria per il funzionamento di un Meccanismo sorgente è determinata dalle sue dimensioni e dalla complessità della sua logica di funzionamento. La quantità di Unità di Flogisto necessaria per un Servitore della Fonte segreta è pari a [DATI PERDUTI]...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500906,
					"content": "Gli Idoli del Drago della Fonte segreta, in particolare, ne richiedono una quantità inferiore, ovvero tre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500907,
					"content": "\"Le informazioni sono energia, e l'energia è fatta d'informazioni\". Il supporto dati che hai recuperato costituisce una singola Unità di Flogisto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500908,
					"content": "Quindi una \"Unità di Flogisto\" equivale a una palla di fuoco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "Sì, possiamo considerarla in questo modo. Avete ripristinato un'Unità di Flogisto che era stata contaminata dall'Abisso, e questo mi ha permesso di estrarne qualcosa di utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751500910,
					"content": "Possono anche essere utilizzate come fonti di energia per i Meccanismi sorgente contaminati dall'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Servitore della Fonte segreta"
				}
			]
		},
