				"points": []
			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "#Eccoti, avventurier{F#a}{M#e}. Stavamo proprio per fare le dovute installazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150102,
					"content": "Se tutto andrà bene, daremo a quel mostro una bella lezione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150103,
					"content": "Durante il processo formale di caricamento, potrebbero arrivare dei mostri che cercheranno d'interromperlo. Quando arriverà il momento, tieni d'occhio il progresso del caricamento e la tenuta del dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150104,
					"content": "Lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "#Grazie mille, avventurier{F#a}{M#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150107,
					"content": "#Ah, ho un'idea! Ti sei impegnat{F#a}{M#o} molto per aiutarci con il cannone Ammazzaunut. L'onore di provarlo per la prima volta... dovrebbe essere tuo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150108,
					"content": "Non vuoi farlo tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "Sarò felice anche solo di vedere i colpi che abbattono il bersaglio! E poi, lasciare che qualcun altro faccia fuoco ci permetterà di ammirare lo sparo in tutta la sua gloria... Ah! Un evento che parla da solo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150112,
					"content": "Tutto ciò che devi fare è proteggere il dispositivo di ricarica dai mostri e aspettare che l'energia si riempia. Attendi che l'Unut scopra un punto vulnerabile e sparagli con tutta l'energia che hai a disposizione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150113,
					"content": "L'attivazione e i meccanismi di autocorrezione faranno il resto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150114,
					"content": "#Notevole. {NICKNAME}, anche Paimon vuole guardare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735150115,
					"content": "Ok, me ne occupo io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "Fantastico, affare fatto allora! Lascia che ti mostri come funziona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150110,
					"content": "Non ho idea di come funzioni questo coso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "Non ti preoccupare! L'ho progettato in modo che fosse semplice e intuitivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150105,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
}