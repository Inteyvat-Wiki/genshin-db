			},
			"dialogs": [
				{
					"id": 3790201,
					"content": "Bentornati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790202,
					"content": "Ah, dunque questa è la Lira sacra. Siete riusciti a recuperarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790203,
					"content": "Il motivo del vento in movimento intagliato nel legno... e le corde sono ancora piacevoli al tatto. Ah, quanti ricordi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790204,
					"content": "Che ne pensi, Venti? Pensi di poter evocare Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790205,
					"content": "Anche se questa è la vera Lira, non so se funzionerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790206,
					"content": "Come puoi vedere, questo strumento ha più di mille anni di storia. Ha quasi esaurito il suo potere di Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790207,
					"content": "È impossibile utilizzarlo in queste condizioni, nemmeno per suonare una musica al livello della taverna di Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790208,
					"content": "Guarda che i bardi arrivano a lottare tra di loro pur di poter suonare nella mia taverna... Attento a quello che dici...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3790209,
					"content": "Patron Diluc, è davvero importante in questo momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790210,
					"content": "E tu... Hai preso in prestito la Lira sacra solo per far sentire la sua melodia a qualche ubriacone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790211,
					"content": "Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790212,
					"content": "Ma che ti ridi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790213,
					"content": "In ogni caso, non possiamo usarla per evocare Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790214,
					"content": "La Lira in sé funziona, ma le corde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790215,
					"content": "#Tocca a te, stranier{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790216,
						3790217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790216,
					"content": "Parli di me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				},
				{
					"id": 3790218,
					"content": "Rilassati, non serve ripararla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790219,
					"content": "È solo che l'intensità del potere di Anemo al suo interno si è notevolmente ridotta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790220,
					"content": "#{NICKNAME}, hai ancora con te la Lacrima di cristallo di Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790221,
					"content": "*annuisce*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3790217,
					"content": "Non so come si ripara uno strumento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				}
			]
		},
