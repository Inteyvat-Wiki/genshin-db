			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "Finalmente! Dopo tanti sforzi, ci siamo! Per fortuna, mi ricordo tutte le specifiche tecniche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180102,
					"content": "Quindi ora purificheremo l'energia del Tatarigami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "Beh, per quanto vorrei anch'io andare là dentro e sistemare tutto, quando si ha a che fare con il Tatarigami è doveroso agire con prudenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180104,
					"content": "Inoltre, non sono riuscito a recuperare alcuni dei materiali necessari, quindi ho dovuto arrangiarmi con qualche rimpiazzo dell'ultimo minuto. Questo significa che l'affidabilità del dispositivo è un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180105,
					"content": "Mmmh, diciamo che \"in alcune circostanze, l'efficacia del dispositivo potrebbe non soddisfare le aspettative\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180106,
					"content": "È perfettamente funzionante, certo, ma dubito possa resistere qualora capitasse un incidente. Anche un solo colpetto potrebbe mettere alcuni dei suoi componenti fuori posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180107,
					"content": "Pertanto, dobbiamo preparare ancora un paio di cose prima di mettere al lavoro il nostro gingillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180108,
					"content": "Vorrei che tu andassi vicino alla Fornace Mikage a rilevare dei dati per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180109,
					"content": "Consideralo fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "Ti ringrazio molto. Io aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180111,
					"content": "È davvero necessario essere tanto cauti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "Certo che sì. A dire la verità, ho già preso qualche scorciatoia rispetto al protocollo formale. Se il signor Flois fosse qui, per finire l'intero processo di montaggio ci vorrebbe un'altra settimana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180113,
					"content": "In ogni caso, a mali estremi, estremi rimedi. In qualità di rappresentante del comitato di valutazione del progetto, tecnicamente sono io a decidere, quindi... Io sottoscritto conferisco a noi stessi l'autorizzazione ad adottare un approccio adatto alla situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
