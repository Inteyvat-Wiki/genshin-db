			"dialogs": [
				{
					"id": 721180301,
					"content": "Allora, hai esaminato la situazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180302,
					"content": "Sì, fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211804,
			"completionStepIds": [
				7211809
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211809",
