				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "Fantastico! Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180402,
					"content": "Direi che siamo proprio fortunati! La Fornace Mikage è abbastanza stabile e l'energia al suo interno non ha superato i livelli di saturazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180403,
					"content": "A questi livelli di concentrazione energetica, il mio dispositivo dovrebbe resistere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180404,
					"content": "Dobbiamo purificare tutta l'energia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "Se questo dispositivo arrivasse a tanto, l'avrei già brevettato molto tempo fa. Il nostro gingillo, però, può solo ridurre i livelli energetici di una determinata area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180406,
					"content": "Tuttavia, a causare la disattivazione della Fornace Mikage e il mancato funzionamento del programma di riavvio automatico è stata l'elevata saturazione di energia del Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180407,
					"content": "Se riusciremo a individuare l'area con la più alta concentrazione energetica, e a purificarla, saremo in grado di riavviare il nucleo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180408,
					"content": "A quel punto, la Fornace Mikage dovrebbe ripartire e ogni eventuale problema successivo non sarà più affare nostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180409,
					"content": "Questo è il piano. Prima di metterlo in pratica, però, ho ancora alcune cose da preparare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
