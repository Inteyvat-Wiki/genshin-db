			"dialogs": [
				{
					"id": 721180501,
					"content": "I Fatui hanno cominciato a comportarsi in modo sempre più strano. Sembra che si stiano radunando intorno al nucleo della Fornace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180502
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180502,
					"content": "Speriamo che non stiano ordendo un altro dei loro loschi piani, o meglio, che non stiano cercando di fare qualcosa che non saremo in grado di contrastare...",
					"roleType": "TALK_ROLE_NPC",
