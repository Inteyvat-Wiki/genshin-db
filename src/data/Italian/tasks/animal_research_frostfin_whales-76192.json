			},
			"dialogs": [
				{
					"id": 761920101,
					"content": "Sembra che oggi non sia il nostro giorno fortunato... Abbiamo aspettato così a lungo e non abbiamo nemmeno avvistato una semplice Balena pinnagelata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920102
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920102,
					"content": "Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920103
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920103,
					"content": "Mmm... Forse per oggi dovremmo lasciar perdere e tornare indietro. Ci saranno altre occasioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920104
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920104,
					"content": "Ma... resterai solo per poco prima di ripartire per altri posti, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920105
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920105,
					"content": "Allora aspettiamo ancora un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920106
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920106,
					"content": "Un momento... Helka, sei tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920107
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920107,
					"content": "Linnea! Sì, sono tornata. Ma il mio diario naturalistico non è ancora del tutto completo, quindi stavolta la nostra sfida dovrà aspettare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920108
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920108,
					"content": "Eh? Quindi questa gita è stata fruttuosa. Nemmeno io sono stata con le mani in mano, e ho aggiunto parecchie cose al mio diario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920109,
					"content": "Anche tu sei qui per vedere la Balena pinnagelata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920110
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920110,
					"content": "Sì. Ho sentito che è stata scoperta solo di recente. Considerando le sue dimensioni, sospetto che i cambiamenti ambientali abbiano causato la variazione del colore della sua pelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920111,
					"content": "Come la concentrazione di Kuuvahki nella zona, per esempio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920112,
					"content": "Peccato che probabilmente oggi non la vedremo. Abbiamo aspettato così a lungo, eppure non abbiamo ricavato nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920113
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920113,
					"content": "Linnea... Aiutami! Finiamola qui e torniamo indietro, Maisie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920114
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920114,
					"content": "Sto bene. Da quando mi sono svegliata stamattina, mi sento meglio del solito. Aspettiamo ancora un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920115
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920115,
					"content": "Ho sentito dire che chiunque veda la Balena pinnagelata può realizzare il proprio desiderio. Quindi... dovrebbe portare fortuna, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920116
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920116,
					"content": "Spero che tu possa portare con te quella fortuna nel tuo prossimo viaggio, Helka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920117
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920117,
					"content": "Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920118
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920118,
					"content": "Allora aspettiamo insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920119
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920119,
					"content": "...Linnea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920120
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920120,
					"content": "Non preoccuparti. Ho la sensazione che oggi vedremo la Balena pinnagelata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920121,
					"content": "Lo sai anche tu, Helka. Il mio istinto non sbaglia mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920122
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920122,
					"content": "Va bene... Allora aspetteremo ancora un po'. Ma solo un pochino, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920123
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920123,
					"content": "Poco più tardi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761920124
					]
				},
				{
					"id": 761920124,
					"content": "Guarda, guarda! Wow, ha saltato altissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920125,
					"content": "Vorrei tanto saper nuotare così veloce anch'io... Dev'essere super divertente nuotare insieme a loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920126
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920126,
					"content": "Dai, tuffiamoci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920127,
					"content": "Ehi! È troppo pericoloso! Cavolo, non è cambiato niente mentre ero via, sei ancora spericolata come sempre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920128
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920128,
					"content": "C-Cosa? Non vuoi giocare anche tu con loro? Si stanno divertendo così tanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920129
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920129,
					"content": "Ma se i tuoi vestiti si bagnano potresti prendere freddo. Perché non resti sulla riva e usi la Fotokamera per immortalarle mentre si divertono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920130
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920130,
					"content": "Mmm... Ci sta. Allora prenderò in prestito la Fotokamera di Helka per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
