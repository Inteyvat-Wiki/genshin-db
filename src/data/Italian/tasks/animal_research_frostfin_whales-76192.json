			"dialogs": [
				{
					"id": 761920201,
					"content": "Che scatto fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920202
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920202,
					"content": "Ora ti senti soddisfatta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920203
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920203,
					"content": "Mhm! Che la leggenda sia vera o meno, spero che ovunque tu vada la fortuna ti protegga da ogni pericolo e ti riporti allo Speranza sana e salva, cara Helka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920204
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920204,
					"content": "...Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920205
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920205,
					"content": "Eheh, allora rientriamo? Linnea, grazie mille! Ci vediamo allo Speranza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920206
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920206,
					"content": "Sì! Ci vediamo là!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
