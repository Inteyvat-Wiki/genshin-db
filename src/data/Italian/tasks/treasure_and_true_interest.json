			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "Ehilà! Posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780402,
					"content": "Conosci un tizio che si chiama Alkami?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "Oh, Alkami? Intendi quel tizio ricco che si è fatto una reputazione? Sì, tempo fa mi commissionò un set di arredi e mi pagò molti Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780405,
					"content": "Ho saputo che ha guadagnato una fortuna come architetto. Ora ha aperto un centro di formazione per aiutare altre persone a seguire le sue orme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780406,
					"content": "Se la retta non fosse tanto alta, iscriverei mio figlio all'istante. L'architettura sembra una professione redditizia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780403,
					"content": "Mi chiedevo se sapessi qualcosa su Alkami.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
			"completionStepIds": [
				1907808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
