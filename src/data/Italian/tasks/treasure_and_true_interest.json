				"objectNames": [
					"Uzayr",
					"Waiz",
					"Tanisha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190785001,
					"content": "Il signor Kaveh sembrava molto arrabbiato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "Uzayr"
				},
				{
					"id": 190785002,
					"content": "E chi se ne importa? Forse è solo preoccupato che gli ruberemo tutti gli incarichi, una volta terminato il corso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "Waiz"
				},
				{
					"id": 190785003,
					"content": "M-Ma non dovrebbe andare così, giusto? Kaveh è super famoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "Tanisha"
				},
				{
					"id": 190785004,
					"content": "Chi lo sa? Mio padre mi ha detto che più uno è famoso e più diventa arrogante e testardo. Le persone disponibili come il signor Alkami sono rare da incontrare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Waiz"
				}
			]
		},
