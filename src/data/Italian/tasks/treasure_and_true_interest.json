				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aabid",
					"Adil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "Hai saputo? Alkami ha assunto Kaveh come istruttore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780802,
					"content": "Eh, scommetto che le iscrizioni al suo corso aumenteranno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780803,
					"content": "Che invidia, eh? Se ci pensi, Alkami non è mai stato un architetto di talento. Considerando solo le sue capacità professionali, nessuno pagherebbe per una sua lezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780804,
					"content": "Questo è vero, ma devi ammetterlo: la sua pubblicità è estremamente efficace... Dopotutto, l'Akademiya ammette solo chi supera l'esame di ammissione, quindi le persone che possono sperare di studiare architettura tra le mura della Kshahrewar si possono contare con le dita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780805,
					"content": "Per chi non supera l'esame o vuole entrare subito nel settore, il centro di formazione è la soluzione più adatta per i Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780806,
					"content": "Mah, bel modo di fare soldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aabid"
				}
			]
		},
		{
			"id": 1907850,
