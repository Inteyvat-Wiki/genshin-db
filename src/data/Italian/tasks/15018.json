							10093.35
						],
						"pointId": 10947
					}
				]
			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "#Ah, casa dolce casa! Ci siamo. {F#Benvenute}{M#Benvenuti} alla tribù della Comunità dell'Abbondanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180814,
					"content": "Wow, che bello! La piattaforma a forma di testa di toro è fantastica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180802,
					"content": "Eheh, quello è lo Stadio della Risonanza! È lì che si tengono tutte le nostre competizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180803,
					"content": "Grazie per averci portato qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "Figurati, nessun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180815,
					"content": "Vorrei portarvi a fare un giro, ma devo andare a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180816,
					"content": "Ah, ti sei ricordata qualcosa d'importante? Prima, quando abbiamo incontrato quegli Hilichurl, ti ci sei lanciata contro in fretta e furia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180817,
					"content": "Spero che non ti abbiamo fatto perdere tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "#No, no, figuratevi! Siamo {F#arrivate}{M#arrivati} in orario! C'è solo una cosa importante che devo fare... La cosa più importante dopo essersi allenati: il pasto post-allenamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180805,
					"content": "Se non facessi neanche questo, finirei per diventare solo una pasticciona letargica, stordita e affamata. I pericoli di uno stomaco vuoto... Non voglio neanche pensarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180806,
					"content": "Mi dispiace, ma dovrei proprio andare a mangiare... Anzi, devo andare subito! Anche voi dovreste mangiare qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180807,
					"content": "Possiamo incontrarci allo Stadio della Risonanza! A presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180808,
					"content": "Ed eccola che se ne va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180809,
					"content": "Wow, che cambiamento... In un secondo è passata dall'essere calma e rilassata al lanciarsi a capofitto in situazioni pericolose... letteralmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180810,
					"content": "Che spirito giovane.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "#\"Spirito giovane\"? Come dici tu, {F#vecchia mia}{M#vecchio mio}... Per Paimon siamo ancora giovani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180812,
					"content": "Comunque, perché non diamo un'occhiata nei paraggi? Possiamo andare allo Stadio della Risonanza tra un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180813,
					"content": "La vista dev'essere fantastica da lassù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
