			"dialogs": [
				{
					"id": 150180101,
					"content": "Eh? Che ci fa qui questa rampa di legno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180107,
					"content": "Ah, fa parte dell'attrezzatura da allenamento! La uso sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180108,
					"content": "Attrezzatura da allenamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180109,
					"content": "Sì! È un po' difficile da spiegare... Ve lo mostrerò direttamente. O la va o la spacca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180103,
					"content": "Atterraggio perfetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180104,
					"content": "Wow, lo hai saltato come se nulla fosse... Incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180105,
					"content": "Oh, no, no! Chiunque può riuscirci con un po' di pratica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180110,
					"content": "Tu ci sei riuscita senza alcun allenamento. È molto più incredibile di qualsiasi cosa io possa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180112,
					"content": "Oh, beh, Paimon può volare, ma... non hai tutti i torti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1501802,
			"completionStepIds": [
				1501801
