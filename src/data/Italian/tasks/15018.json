			"dialogs": [
				{
					"id": 150180401,
					"content": "Ehi, ciao! Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180403,
					"content": "Mh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180404,
					"content": "#Un attimo, voi siete... {NICKNAME} e Paimon! Vi stavo aspettando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180405,
					"content": "#Wow! Ci conosci? Ah, certo che siamo {F#diventate famose}{M#diventati famosi}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180406,
					"content": "Un attimo, ma... Avevamo detto a qualcuno del nostro arrivo alla Comunità dell'Abbondanza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180407,
					"content": "Ah, non lo sapete? L'allenatrice Iansan ha detto che vi ha invitato a farci visita, quindi sono venuta qui ad aspettarvi mentre mi allenavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180408,
					"content": "E ora siete qui... Eheh, non ci credo! È fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180409,
					"content": "N-Non siamo così tanto importanti, dai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180410,
					"content": "#Siete {F#le eroine}{M#gli eroi} che hanno sconfitto l'Abisso! Siete {F#importantissime}{M#importantissimi} per tutti noi qui a Natlan! Ho sentito così tante volte la storia di \"Tum{RUBY#[S]Speranza}aini\" che potrei ripeterla a memoria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180411,
					"content": "#Non vedevo l'ora di incontrarvi da quando l'allenatrice Iansan mi ha detto che forse sareste {F#venute}{M#venuti}. Ah, io sono Varesa. Non so se Iansan vi ha già parlato di me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180412
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180412,
					"content": "Ah, sì, è un nome familiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180413,
					"content": "Durante l'invasione dell'Abisso, abbiamo chiesto a Iansan se la Comunità dell'Abbondanza avesse bisogno di aiuto. Ci rispose che Varesa aveva tutto sotto controllo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180414,
						150180415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180414,
					"content": "Il che vuol dire che anche tu devi essere una guerriera notevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				},
				{
					"id": 150180416,
					"content": "No, no, il merito è di Acatl! Io ho eliminato giusto qualche mostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180417
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180417,
					"content": "Il solo pensiero dell'invasione mi fa venire i brividi, anche ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180418,
					"content": "Ma ormai è acqua passata! La Comunità dell'Abbondanza se l'è cavata abbastanza bene, tutto sommato. Abbiamo finito le riparazioni, quindi ora si tratta solo di aiutare le altre tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180419
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180419,
					"content": "Eheh, andiamo! Vi porto alla tribù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180420
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180420,
					"content": "Perfetto, andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180415,
					"content": "E un'eroina già di tuo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				}
			]
		},
