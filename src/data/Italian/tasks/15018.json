					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150180201,
					"content": "Ah, è un nome familiare! Quindi sei tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180202,
					"content": "#Beh, {F#lei}{M#lui} è {NICKNAME} e Paimon è la sua miglior compagna di viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180203,
					"content": "#{NICKNAME} e Paimon... Suona proprio bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180204,
					"content": "Va bene! Muoviamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
