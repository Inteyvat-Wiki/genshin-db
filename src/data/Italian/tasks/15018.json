			"dialogs": [
				{
					"id": 150180301,
					"content": "Ehi, ciao! Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180303,
					"content": "Mh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180304,
					"content": "#Ah, vi siete {F#perse}{M#persi}? Serve aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180305,
					"content": "No, non esattamente. Vogliamo fare visita alla Comunità dell'Abbondanza. La direzione è giusta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180306,
					"content": "Sì! È la mia tribù. Se volete vi posso accompagnare per il resto della strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180307,
					"content": "Fantastico! Un'altra guida del posto! Che colpo di fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180308,
					"content": "E io che pensavo che fosse il tuo lavoro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "Una guida, eh... Sì, perché no! Eheh, da ora in avanti, sarò la vostra guida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180310,
					"content": "Ci sono molti paesaggi interessanti qui nei dintorni. Posso indicarveli lungo la strada. La gente rimane sempre sbalordita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180311,
					"content": "Ah, grazie mille! Ma, ecco... Non ti siamo distraendo, vero? Non devi disturbarti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180312,
					"content": "Ah, no, nessun problema! Mi stavo allenando, ma per oggi ho finito. Stavo andando anch'io in quella direzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180313,
					"content": "E poi, così vi posso insegnare tutto sulla mia tribù. Dopotutto, imparare cose nuove è sempre divertente, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180314,
					"content": "Finché siete felici, lo sono anche io. Acatl ci ha insegnato a trattare gli ospiti in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180315,
					"content": "V-Va bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180316,
					"content": "Sembra super amichevole e calorosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180317,
					"content": "Sì, abbiamo avuto fortuna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "Già! A Paimon piace molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180319,
					"content": "Tutto bene? Allora forza, in marcia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180320,
					"content": "Ah, un attimo! Non sappiamo ancora il tuo nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180321,
					"content": "Giusto! Mi chiamo Varesa. Molto piacere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
