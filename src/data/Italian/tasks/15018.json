			},
			"dialogs": [
				{
					"id": 150180501,
					"content": "#{F#Lei}{M#Lui} è {NICKNAME}, e Paimon è la sua miglior compagna di viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180502,
					"content": "#{NICKNAME} e Paimon... Suona proprio bene! Non me lo dimenticherò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180503
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180503,
					"content": "Va bene! Muoviamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
