					}
				]
			},
			"dialogs": [
				{
					"id": 705360101,
					"content": "Eheh, Dodoco ha sconfitto un sacco di Pesci guerriero superappuntiti! Persino il Pesce re superappuntito non ha avuto scampo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360102,
					"content": "Dodoco, Coniglio Bumbum e Schizzi e scintille di Klee sono i migliori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360103,
					"content": "Inarrestabili!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "Questo gioco ricorda a Paimon l'incidente che è successo al Lago Sicerae... Lisa ha forse preso ispirazione da quello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360106,
					"content": "Ma a pensarci bene, perché prendersi la briga di trovare le specie invasive quando si potrebbe semplicemente chiedere a Klee di far saltare in aria ogni pesce sospetto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360107,
					"content": "Potrebbero persino darci delle bombe e lasciare che ce ne occupassimo noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360108,
					"content": "Tu e Klee siete uguali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "Bene, a giudicare dalle vostre facce, direi che vi state divertendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360111,
					"content": "Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360112,
					"content": "Finalmente sei tornata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360113,
					"content": "Ci è piaciuto un sacco giocare a Le scoppiettanti avventure di Dodoco! Hai inventato un gioco divertentissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360114,
					"content": "Grazie per averci giocato, sono contenta che vi sia piaciuto. Uhm, forse dovrei aggiornarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360115,
					"content": "Oooh, sì! Klee vuole vedere Dodoco avventurarsi in qualsiasi posto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360116,
					"content": "No, aspetta... Devi aver passato molto tempo a lavorare sul gioco, dev'essere stancante! Non dovremmo far lavorare Lisa così tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360117,
					"content": "Oh, grazie per la tua considerazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360118,
					"content": "Ma se serve a renderti felice mentre rimani in città, sarò più che lieta di dedicarci il mio tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360119,
					"content": "Naturalmente, capisco che tu preferisca vivere le tue avventure ogni volta che vuoi. Il gioco vuole essere solo un modo nuovo per passare il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360120,
					"content": "A ogni modo, ho delle grandi notizie e ho anche portato un regalo per voi, tesorini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360121,
					"content": "Un regalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360122,
					"content": "#In realtà anch'io ho un regalo per {F#la}{M#il} prode Cavaliere Onorari{F#a}{M#o} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360123,
					"content": "Tra poco arriveremo ai regali, lasciate che vi dica prima la notizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360124,
					"content": "Il problema nel Lago Sicerae è stato risolto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "Esatto. Due Cavalieri della squadra investigativa hanno trovato il nido della specie invasiva e se ne sono sbarazzati velocemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360127,
					"content": "I Cavalieri hanno anche determinato la causa dell'invasione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360128,
					"content": "La specie è stata introdotta accidentalmente da una mercante, non aveva cattive intenzioni, quindi i Cavalieri dopo averle fatto una bella ramanzina e una multa l'hanno lasciata andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360129,
					"content": "Fiuuu... Per fortuna non hanno causato troppi problemi. Ma anche Paimon pensa che quella mercante fosse fin troppo imprudente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360130,
					"content": "Il Lago Sicerae è salvo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "Possiamo passare ai regali ora? Può cominciare Klee per prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360133,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360134,
					"content": "Klee sta tornando a casa in orario senza che nessuno glielo ricordi. Quindi mi chiedevo cosa stessi facendo ultimamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360135,
					"content": "Eheh~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360136,
					"content": "La sera, mentre ero a casa, ho guardato un po' il libro delle creazioni di Albedo e ho imparato a fare questo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360137,
					"content": "Ta-daaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360138,
					"content": "Woah, è Dodoco che lancia un Coniglio Bumbum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360139,
					"content": "Sì! Ho realizzato una statuetta che assomiglia a Dodoco di Le scoppiettanti avventure di Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360140,
					"content": "Anche se non posso fargli lanciare delle vere bombe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360141,
					"content": "Spero che vedendola vi possa ricordare di quanto vi siate divertiti in questi giorni giocando assieme e che possa scacciare i vostri problemi e la noia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360142,
					"content": "Un grosso Dodoco giocattolo! Paimon adora sorprese del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360143,
					"content": "Con questo sarà come partire all'avventura con Klee e Dodoco ovunque andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360144,
					"content": "Grazie per questo regalo originale e ragionato, Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "Eheh, sono contenta che vi piaccia il mio regalo! Ci ho messo molto impegno per realizzarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360147,
					"content": "Qual è il tuo regalo, Lisa? Sono curiosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360148,
					"content": "Beh, temo che il mio regalo sia molto meno creativo del tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360149,
					"content": "È un libro di storie su Le scoppiettanti avventure di Dodoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360150,
					"content": "Un libro di avventura! Sììì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360151,
					"content": "Wow, un intero libro di storie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360152,
					"content": "I tesorini sono tornati a Mondstadt e sono partiti all'avventura con Klee e Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360153,
					"content": "Assieme hanno sconfitto i cattivi Pesci guerriero superappuntiti e poi nel pomeriggio si sono goduti un buon tè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360154,
					"content": "Un modo più appropriato per finire Le scoppiettanti avventure di Dodoco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360155,
					"content": "Hai pensato a tutta la storia mentre progettavi il gioco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360156,
					"content": "No. In quanto protagonisti della storia, tu, il tesorino e Klee, avete giocato un ruolo fondamentale nella sua realizzazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360157,
					"content": "Ho lasciato di proposito uno spazio vuoto nel libro per le illustrazioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360158,
					"content": "Ma mi è appena venuta in mente un'idea migliore... Dal momento che siamo tutti qui per questa occasione speciale, perché non facciamo una foto assieme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360159,
					"content": "Certo! Abbiamo potuto vedere i nostri amici e giocato assieme, vale decisamente la pena festeggiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360160,
					"content": "Facciamo una foto assieme!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360162,
					"content": "#Venite, prode Cavaliere Onorari{F#a}{M#o} e Paimon! Sei pronta, Lisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360163
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360163,
					"content": "Klee si è divertita un sacco oggi! Tre, due, uno... Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360161,
					"content": "Bisogna apprezzare le piccole gioie della vita!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360145,
					"content": "D'ora in poi, Dodoco ci accompagnerà in tutte le nostre avventure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360131,
					"content": "L'industria del vino di Mondstadt è salva!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360125,
					"content": "Klee può di nuovo giocare fuori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360109,
					"content": "No, niente bombe a Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360104,
					"content": "Prendete questo, brutti pesciacci!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				}
			]
		}
	]
}