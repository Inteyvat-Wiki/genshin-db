			"dialogs": [
				{
					"id": 710410401,
					"content": "Ci siamo. *tossisce* Uh, il cancello è chiuso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410402,
					"content": "Sembra che per aprire il cancello sia necessario usare due chiavi. Accidenti, come mai voi di Liyue siete così scrupolosi anche per le cose più banali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410403,
					"content": "Ehi, basta con le chiacchiere... Vedi quell'avviso accanto al cancello? Almeno ci dice che dall'altra parte troveremo le palle da cannone che ci servono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410404,
					"content": "Beh, è già qualcosa, ma come facciamo a sapere se le micce sono ben conservate? È ancora presto per cantare vittoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410405
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410405,
					"content": "Oh, fantastico: abbiamo un ottimista tra noi. Puoi finire di fare il guastafeste, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410406,
					"content": "Ma cosa sto facendo? Sto davvero a sentire un Cacciatore di tesori che dubita di noi per qualsiasi cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410407,
						710410408
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410407,
					"content": "In questo caso, però, Clitopho ha ragione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				},
				{
					"id": 710410409,
					"content": "Esatto! Smettete di litigare, voi due, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410410,
					"content": "Umpf, va bene. Procediamo. Forse Jinwu sa come aprire il cancello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410411
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410411,
					"content": "Dopo che lo avremo aperto, ci sarà ancora molto da fare. Dovremo attivare il dispositivo di segnalazione per aprire la culatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410412
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410412,
					"content": "Jinwu mi aveva detto che ci dovrebbe essere un punto di osservazione, designato per la squadra di demolizione, che dà sul cannone. Da quella posizione, saremo in grado di regolare il segnale e sbloccare il cannone a distanza di sicurezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410408,
					"content": "Comunque sia, per prima cosa dobbiamo aprire il cancello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				}
			]
		}
	]
}