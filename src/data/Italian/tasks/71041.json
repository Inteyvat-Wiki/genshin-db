					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410101,
					"content": "Fiuuu! Grazie di avermi salvato la vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410102
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410102,
					"content": "Un momento... Mi ricordo di te! Sei Toclipho, il tipo di prima, fuori dalle miniere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410103
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410103,
					"content": "Eh, cosa? No! Non ero io... N-Non vendo certo medicinali falsi! Sono Clitopho, sì, ma non quello che si occupa di farmaci. Niente affatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410104
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410104,
					"content": "Eh? Allora le medicine che vendevi erano false?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410105
					]
				},
				{
					"id": 710410105,
					"content": "Cosa? No! Non è possibile! Le medicine che vendo sono autentiche al cento per cento! Li avete visti i minatori, no? Non appena le hanno bevute, sono tornati tutti in forma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410106
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410106,
					"content": "Ma non hai appena detto che non sei il Clitopho che si occupa di farmaci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410107,
					"content": "Oh, ehm... Sì, è vero, è così da quando ho cessato la mia attività. È tutto finito quando... quel Toclipho ha cominciato a vendere i suoi intrugli sotto falso nome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410108
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410108,
					"content": "Ha venduto medicine false spacciandosi per me e rovinato la mia reputazione! È così che è andata. Ecco perché ho giurato di non vendere mai più medicinali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410109
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410109,
					"content": "Peccato che, non appena ho cambiato vita, sia stato catturato da una banda di Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410110
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410110,
					"content": "Sì, quel ciarlatano è davvero spregevole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410111
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410111,
					"content": "Sì, è davvero una brutta persona. Come si può pensare di fare concorrenza in quel modo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410112,
					"content": "Ma quindi con quale falso nome si faceva chiamare quel Toclipho?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410113
					]
				},
				{
					"id": 710410113,
					"content": "Clitopho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410114
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410114,
					"content": "Eh? No, aspettate. Clitopho non è un nome finto. È vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410115
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410115,
					"content": "Quindi vuol dire che Toclipho è un nome falso, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410116,
					"content": "No... Anzi, sì. Sì. Voleva assumere la mia identità, ma ha capito male il mio nome, quindi adesso Clitopho è un nome finto. Ora è tutto chiaro, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410117
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410117,
					"content": "Oooh... Adesso Toclipho è diventato un nome vero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410118,
					"content": "Che peccato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410119
					]
				},
				{
					"id": 710410119,
					"content": "Peccato cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410120
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410120,
					"content": "Hai praticamente confessato senza farci penare più di tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410121
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410121,
					"content": "Portiamolo via con noi. Credo proprio che i Milleliti abbiano molte domande da fargli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410122
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410122,
					"content": "Potremmo anche occuparci di lui direttamente qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410123
					]
				},
				{
					"id": 710410123,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410124
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410124,
					"content": "Ehi! Questo non è il momento di scherzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410125
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410125,
					"content": "Eheh, eheheh. Paimon lo trova molto divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410126,
					"content": "M-Ma non stai ridendo. E no, non è affatto divertente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410127,
						710410130
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410127,
					"content": "A dire il vero, hai ragione, perché... stiamo per cominciare a fare sul serio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410128
					]
				},
				{
					"id": 710410128,
					"content": "A-Aspettate un attimo! Non è il momento giusto per un interrogatorio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410129
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410129,
					"content": "Non so voi, ma portarmi dietro un Cacciatore di tesori che avete quasi terrorizzato a morte non mi attira per niente. In ogni caso, per prima cosa lo porteremo su all'accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410131
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410131,
					"content": "Ehi, ehi, ehi! Perché non mi prendete con voi? Vi sarò molto utile! Voglio dire, come avete visto... sono stato espulso dai Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410132
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410132,
					"content": "Quindi ora sono di nuovo un cittadino onesto, sapete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410133
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410133,
					"content": "Ah, quindi questo basterebbe a renderti un cittadino onesto, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410134,
					"content": "E cosa sapresti fare, esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410135
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410135,
					"content": "So... preparare gli esplosivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410136
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410136,
					"content": "Non medicinali falsi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410137,
					"content": "No, no, ha detto esplosivi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410138
					]
				},
				{
					"id": 710410138,
					"content": "Ma non è che anche i tuoi esplosivi sono farlocchi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410139
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410139,
					"content": "No, quelli li so preparare sul serio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410140
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410140,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410141
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410141,
					"content": "Non ho l'autorità per includerti nella squadra. Credo che Jinwu sia la persona più adatta a decidere cosa ne sarà di te. Secondo me, alla fine ti consegnerà ai Milleliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410142
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410142,
					"content": "In ogni caso, ti terremo d'occhio. Non ci si può fidare dei Cacciatori di tesori, per non parlare di chi vende medicine false...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410143
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410143,
					"content": "Ehi, suvvia, non faccio più quelle cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410144
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410144,
					"content": "Oh, ma certo, certo! Che ne dite, andiamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410130,
					"content": "È vero, hai ragione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410131
					]
				}
			]
		},
		{
			"id": 7104103,
			"completionStepIds": [
				7104109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
