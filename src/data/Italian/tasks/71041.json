			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho",
					"Paimon",
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "Il meccanismo di chiusura non si è ancora arrugginito. Anzi, pare che sia stato lubrificato. Si direbbe che qualcuno abbia pensato alla manutenzione anche dopo la chiusura della miniera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410302,
					"content": "Anche la culatta sembra tutta intera. L'unico problema è che la sicura è ancora inserita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410303,
					"content": "Ma di cosa sta parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410304,
					"content": "Quando i minatori vennero evacuati, le gallerie qui davanti furono chiuse usando delle enormi rocce. È lì che utilizzeremo questo cannone per aprire un varco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410305,
					"content": "Peccato, però, che un cannone serva a poco senza munizioni, quindi dobbiamo trovarne un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410306,
					"content": "Umpf, non parlare come se non lo sapessi, signor saputello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410307,
					"content": "Nelle vicinanze dovrebbe esserci il magazzino in cui erano custodite le palle da cannone. Se siamo fortunati, ne è rimasta ancora qualcuna dopo l'evacuazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410308,
					"content": "Allora andiamoci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
					"content": "Andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		},
		{
