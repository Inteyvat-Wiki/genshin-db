				]
			},
			"dialogs": [
				{
					"id": 735220101,
					"content": "È ora di una nuova vendita di informazioni da parte di Lord Sangemah Bay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220102,
					"content": "Vi va di acquistare le ultime notizie? Vediamo un po', queste info non sono molto importanti, mi accontento di mezzo milione di Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220103
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220103,
					"content": "È la metà del solito prezzo, un vero affare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220104,
					"content": "Che ne dici di non farmi pagare, invece?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735220105
					]
				},
				{
					"id": 735220105,
					"content": "Wow, vuoi abbassare il prezzo a zero Mora. Non mi stupisce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220106,
					"content": "Ma io sono la grande Lord Sangemah Bay. Uhm, se ti interessa così tanto, te lo dirò gratuitamente, ma non parlarne con nessuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220107,
					"content": "Ho sentito dire che vent'anni fa ci fu un concorrente che cambiò totalmente personalità dopo aver partecipato alla gara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220108,
					"content": "Sembra che qualcuno l'abbia visto al Villaggio di Aaru. Mi chiedo dove sia finito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220109,
					"content": "Non posso dirvi altro, senza un compenso. Se volete saperne di più, dovrete pagare due milioni di Mora. Grazie per essere clienti fedeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220110,
					"content": "Che fregatura! Possiamo andare al Villaggio di Aaru e chiedere di persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7352202,
			"completionStepIds": [
				7352202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352202",
							"2"
						],
						"stepId": 7352202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rishti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735220201,
					"content": "Vent'anni fa... comparve un giovanotto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220202
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220202,
					"content": "A quei tempi la vita era molto più difficile. Eravamo afflitti costantemente da povertà, malattie e ignoranza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220203
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220203,
					"content": "Quel giovane uomo, chiaramente appartenente all'Akademiya e dal futuro radioso, venne ad aiutarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220204
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220204,
					"content": "Ci insegnò come affrontare i mostri e gli Unut. Ci comprò dei medicinali pagando di tasca propria, e si occupò personalmente dei malati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220205
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220205,
					"content": "Che brava persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735220206,
					"content": "Già... Peccato che le brave persone muoiano giovani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220207
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220207,
					"content": "Aveva sempre un'espressione crucciata, e nessuno sapeva perché. Ci chiedevamo tutti se sarebbe andato via. Questo luogo non aveva i mezzi per accoglierlo a dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220208
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220208,
					"content": "Eppure, molti dicevano che fosse un tipo un po' matto. Per esempio, a volte raccontava ai bambini che da giovane insegnò a scrivere a una strana creatura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220209
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220209,
					"content": "In seguito, cominciò a lasciare spesso il villaggio per esplorare il deserto. Una volta gli chiesi cosa stesse cercando, e lui rispose che voleva parlare con qualcuno del gruppo Nagarqualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220210
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220210,
					"content": "In seguito, sentii che morì nelle sabbie mobili. Si dice che durante i suoi viaggi incontrò una carovana intrappolata nelle sabbie mobili. Riuscì a salvare molte persone, ma non a tirarsi fuori in tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220211
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220211,
					"content": "Al tempo, c'era ancora una lettera incompleta rivolta a suo figlio a casa. Dopo la sua morte, mio figlio prese con sé la lettera, con l'idea di consegnarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220212
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220212,
					"content": "Quella lettera incompleta... è ancora qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735220213,
					"content": "No. Non si trova qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220214
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220214,
					"content": "Mio figlio diventò un mercenario per avere una vita migliore. Venne ucciso in un tafferuglio qualche anno fa, e i suoi averi vennero rubati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220215
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220215,
					"content": "Sono passati molti anni in un batter d'occhio. Mi chiedo come sia diventato suo figlio... Gli porterà rancore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220216
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220216,
					"content": "Solo in pochi ormai conoscono queste storie. Sto invecchiando, chissà se presto le dimenticherò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rishti"
				}
			]
		},
