			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#Ci incontriamo di nuovo, {NICKNAME}, e la tua, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751802,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751803,
					"content": "Posso chiederti a quanto venderesti questa signorina alata? La trovo piuttosto interessante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751804,
					"content": "Come?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751805,
					"content": "Tutto bene...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "Non che non sta bene! Sta avendo di nuovo i suoi problemi d'amnesia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751809,
					"content": "Di che diamine state parlando... *versi di sforzo*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751810,
					"content": "*versi di sforzo*... Ahahahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751811,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751812,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "Ahahah! *tossisce* Dovreste vedervi in faccia! Ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751814,
					"content": "Basta... Mi manca il fiato... S-Scusate... Questo... Ahahah... Questo è uno dei miei scherzi preferiti, sapete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751815,
					"content": "Non è per niente divertente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751816,
					"content": "Temo di non capire il tuo senso dell'umorismo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "*tossisce* Va bene, va bene, basta con gli scherzi. Mi dispiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751819,
					"content": "Davvero! Paimon pensava che un celebre avventuriere come te fosse una persona più seria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751820,
					"content": "Ahahah. Forse è meglio non avere un'opinione troppo rigida sugli avventurieri. La Gilda è nota come un circolo di stranezze. Mi definirei perfino \"normale\" in confronto agli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751821,
					"content": "... Non di molto, secondo Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751822,
					"content": "Comunque, grazie per i funghi. Il loro effetto non si è ancora visto. Forse hanno bisogno di un uso prolungato per avere davvero effetto, o forse non hanno nessuna proprietà medicinale... Ma in ogni caso, hanno un buon sapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751823,
					"content": "Devo stare attento a non finirli tutti. Devo lasciarne un po' per il mio amico a Sumeru. Mi aiuterà a ricercare le loro eventuali proprietà medicinali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751824,
					"content": "Ho il presentimento che ti scorderai tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751825,
					"content": "*tossisce* Ehm, beh, torniamo al punto. Avete già visitato le pitture rupestri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751826,
					"content": "Ecco le foto che volevi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "Ooh, grazie mille per il vostro prezioso aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751828,
					"content": "Vediamo. Interessante, molto interessante. Mmh... Avete trovato altre pitture rupestri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751829,
					"content": "Sono tutte qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "Mmh, allora è tutto ancora più interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751832,
					"content": "Cosa vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751833,
					"content": "Gli abitanti dell'Isola di Tsurumi adoravano un uccello mostruoso che aveva il potere di Electro, e la loro civiltà era incentrata su rituali e cerimonie legati a questo culto. La maggior parte degli storici concorda su questo punto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751834,
					"content": "Ma le pitture rupestri che hai trovato non mostrano alcun segno della presenza dell'Uccello del tuono. Sembra che la gente adorasse qualcosa di completamente diverso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751835,
					"content": "Il sole, la luna e le stelle... e qualunque cosa rappresentino questi strani simboli. Forse i nativi dell'Isola di Tsurumi erano già una civiltà avanzata, ben prima dell'avvento dell'Uccello del tuono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751836,
					"content": "E poi, la nebbia e la luce lunare, le stelle e l'oscurità... Non sono in grado di spiegarli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751837,
					"content": "Meglio non sforzarsi troppo, Roald. Chissà cosa potrebbe causare alla tua memoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751838,
					"content": "...Ah, giusto. Scusatemi. Ero perso nei miei pensieri. A dire il vero, quasi non vi avevo nemmeno notato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751839,
					"content": "Grazie ancora per il vostro duro lavoro. Penso che questo mi basterà per scrivere il mio prossimo diario... Se mai verrà ripreso da alcuni storici, non dimenticherò di aggiungere voi due ai ringraziamenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751840,
					"content": "Bene allora. Penso sia ora di tornare alla Gilda. Perdonatemi per avervi fatto perdere tempo. Spero che ci incontreremo di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751841,
					"content": "Che tipo indaffarato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751842,
					"content": "Ah, giusto. Un'altra cosa. Niente di grave, eh, ma spero possiate aiutarmi a cercare qualcuno. È quel bambino di cui vi ho parlato prima. Si chiama... Ehm... Un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751843,
					"content": "Giusto, \"Ruu\". Ecco come si chiama. Questa volta gli ho portato delle cose da mangiare... Spero non siano andate a male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751844,
					"content": "Dall'ultima volta che sono venuto qui, non ho smesso di pensare a quel ragazzo. La sua vita dev'essere stata molto difficile su un'isola così pericolosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751845
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751845,
					"content": "#Va bene, è tutto. Incontriamoci di nuovo alla prossima tappa dei nostri rispettivi viaggi, {NICKNAME}! Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751830,
					"content": "Abbiamo trovato solo queste.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751817,
					"content": "Immagino che questo sia il modo di sopravvivere delle persone che soffrono di amnesia, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751807,
					"content": "Il Fungo fluorescente di prima ha funzionato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751808
					]
				},
				{
					"id": 721751808,
					"content": "Giusto! E perché sembra che sia peggiorato invece?!?",
					"roleType": "TALK_ROLE_NPC",
