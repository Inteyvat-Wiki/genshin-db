			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "Ah, quindi anche voi siete ancora su quest'isola. Ottimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750102,
					"content": "Come va ultimamente? Qualche scoperta scioccante? Vi va di raccontarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750103,
					"content": "Niente di sconvolgente, devo dire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "Ah, ma è normale. Non preoccupatevi. Isole come questa non mancano mai di misteri e sono sicuro che prima o poi vi imbatterete in qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750107,
					"content": "In realtà, Paimon ha una domanda. Cosa ci fai qui, Roald?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750108,
					"content": "Io? Stavo giusto preparando le mie cose per andarmene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750109,
					"content": "La nebbia qui è davvero bizzarra. Provi ad addentrartici, e perdi la strada... E prima che te ne accorga, sei di nuovo al punto di partenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750110,
					"content": "Avevo dimenticato il percorso indicatomi da Kama, quindi ho provato a cercare gente del posto che mi mostrasse la strada, ma non c'è stato verso di trovare un percorso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750111,
					"content": "La mia bussola, le ombre a terra... Tutto inutile in questo luogo... Ho anche provato a usare le mie scarpe, ma niente! Non riuscivo a fare un solo passo in avanti nella nebbia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750112,
					"content": "Le tue... scarpe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750113,
					"content": "Vuol dire che le ha usate come indicatori di direzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "Cosa?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750115,
					"content": "#Ahahah! Sapevo che non mi avresti delus{F#a}{M#o}, {NICKNAME}! Il mondo dell'avventura non ha segreti per te! Hai molto da imparare, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750116,
					"content": "Sì, hai ancora molto da imparare, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "Oh, dai, si chiama solo tentare la fortuna! Paimon non ha bisogno d'impararlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750118,
					"content": "In ogni caso, i miei progressi sono completamente fermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750119,
					"content": "*sospira* Se avessi legato una corda a un albero vicino e avessi provato ad avanzare tenendomi saldamente all'altra estremità, probabilmente avrei potuto fare qualche altro tentativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750120,
					"content": "E allora perché non ci provi di nuovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750121,
					"content": "Ho usato le scarpe di ricambio che avevo portato con me per capire da che parte stessi andando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750122,
					"content": "Delle scarpe usa e getta, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "Beh, non avrebbero dovuto esserlo, ma, ehm... ne ho lanciate troppe e continuavo a dimenticarmi di riprenderle, quindi... Alla fine sono rimasto senza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750126,
					"content": "Aspettate. Giusto! Finalmente mi sono ricordato! Ho qualcosa da chiedervi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750127,
					"content": "Bene, bene, che sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750128,
					"content": "Ahahah, ehm, scusate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750129,
					"content": "Come sapete, ho l'abitudine, di cui un po' mi vergogno, di dimenticare costantemente le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750130,
					"content": "La mia scarsa memoria mi ha causato diversi problemi, soprattutto da quando sono un avventuriere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750131,
					"content": "E uno dei motivi che mi ha portato sull'Isola di Tsurumi era quello di raccogliere qualcosa noto come Fungo fluorescente. Secondo Sango, questi funghi possono aiutare a migliorare la memoria e ad alleviare la fatica mentale. Si dice che possano persino migliorare la vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750132,
					"content": "L'ultima volta che sono venuto qui con Kama ero così preoccupato di \"incontrare la gente del posto\" che mi sono dimenticato di raccoglierli... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750133,
					"content": "E poi non mi aspettavo d'incontrare così tanti guai venendo sull'isola da solo. Un vero peccato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750134,
					"content": "Quindi, se avete ancora voglia di avventura in quest'area, potreste aiutarmi a raccogliere qualcuno di questi funghi fluorescenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750135,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "Non so come ringraziarvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750137,
					"content": "Basta che al mio ritorno non ti sarai già dimenticato di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "Ahahah! Non succederà, non preoccuparti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750124,
					"content": "Che peccato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "*sospira* Nevvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750105,
					"content": "Stiamo ancora esplorando questo posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "Davvero? Ahahah. Non voglio rallentarvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "Mmh, questi dovrebbero bastare. Bene! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750302,
					"content": "A proposito, se trovi qualcosa d'interessante vicino al sito cerimoniale dell'isola, fammi un fischio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750303,
					"content": "Mmh. Ah sì. Credo tu abbia con te una Fotokamera costruita a Fontaine, giusto? È un dispositivo piuttosto costoso... Dovrei davvero procurarmene una, se solo potessi permettermela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750304,
					"content": "Ho sentito degli storici del posto dire che gli antichi nativi dell'Isola di Tsurumi usavano le pitture per raffigurare storie antiche, ora dimenticate, sulle pareti rocciose delle caverne, e che la maggior parte di queste pitture rupestri è lì da più di mille anni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750305,
					"content": "Durante il mio precedente viaggio qui, ho potuto intravedere queste immagini alla luce del fuoco cerimoniale... Hanno occupato i miei pensieri per diverse notti inquiete ed erano davvero difficili da dimenticare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750306,
					"content": "Non credo che qualcuno abbia mai visto per intero queste pitture rupestri, ma se riuscissi a portarmi la prova della loro esistenza, costituirebbe sicuramente un importante passo avanti nel mondo delle ricerche storiche della Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750307,
					"content": "Se trovi queste leggendarie pitture rupestri, scatta tante foto nitide. Ti comprerò le foto a un buon prezzo per utilizzarle nei miei diari, e ti ricompenserò per il favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750308,
					"content": "Che ne dici? Ti sembra accettabile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750309,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "Ti ringrazio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750311,
					"content": "Basta che non perdi di nuovo il tuo diario.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "Ci... Ci proverò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217504,
