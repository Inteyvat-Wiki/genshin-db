					"Boucicaut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "Salve! Cosa vorresti acquistare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100202,
					"content": "Sono qui per le pitture di Depierris...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "#Ah, sei venut{F#a}{M#o} a ritirare le pitture per lui? Ce le ho proprio qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100204,
					"content": "Ho notato che tende a esaurirle in fretta. Mi chiedo se non le versi tutte in acqua subito dopo averle comprate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100205,
					"content": "Beh, comunque eccole qua. Consegnagliele al più presto, mi raccomando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boucicaut"
				}
			]
		},
