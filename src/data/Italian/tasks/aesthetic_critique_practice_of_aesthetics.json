				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "È una buona idea... ma è davvero fattibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100102,
					"content": "Come procede il disegno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "Ah, sei tu! Grazie per l'aiuto di prima con le foto! I panorami che ritraevano mi sono stati di grande ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100104,
					"content": "Ho già un'idea approssimativa e ho preparato alcuni schizzi, ma... Beh, non sono all'altezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100105,
					"content": "Non fraintendermi... Non voglio dire che ho disegnato delle porcherie senza il benché minimo valore estetico, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100106,
					"content": "Sento che manca quel qualcosa di speciale che potrebbe fare la distinzione da un'opera qualsiasi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100107,
					"content": "C'è qualcosa di troppo... tangibile nelle cose che ho in mente. Se le traducessi direttamente in un dipinto, la bellezza che voglio trasmettere ne risentirebbe sicuramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100108,
					"content": "*sospira* Temo che questo sia un problema comune ad ogni artista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100109,
					"content": "Perché non provi a disegnare qualcos'altro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "Grazie per il suggerimento, ma ho l'impressione che questo problema non si risolverà con un mero cambio di soggetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100111,
					"content": "Che si tratti di montagne e fiumi, uccelli e bestie oppure il mondo degli umani... Nessun artista può sfuggire al problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100112,
					"content": "È proprio cercando una soluzione che alcuni dei miei colleghi hanno scomposto e trasmutato ciò che hanno visto tramite i loro sentimenti più profondi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100113,
					"content": "Un'arte di questo tipo enfatizza principalmente le emozioni interiori, e il risultato sulla tela è... Come posso spiegarlo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100114,
					"content": "Beh, che si voglia ritrarre un personaggio, un paesaggio o persino la luce, tutto racchiude un aspetto grottesco che nessun senso estetico tradizionale è in grado di catturare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100115,
					"content": "Uno sguardo semplicistico indurrebbe i più a credere che questi dipinti siano il frutto di una mente fanciullesca priva di conoscenze artistiche o delirante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100116,
					"content": "Ma se riuscirai a placare il tuo spirito e a entrare in armonia con l'opera d'arte che ti sta dinanzi, la sentirai ruggire nel nome dell'artista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100117,
					"content": "Quel ruggito si leva dal cuore e dall'anima dell'artista stesso, urlando le sue emozioni... che sono, nella maggior parte dei casi, piuttosto intense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100118,
					"content": "Eppure la sua voce non è percepibile dall'orecchio, ma dal cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100124,
					"content": "Per quanto mi riguarda... Non voglio ancora rinunciare a ritrarre oggetti tangibili, quindi ho trovato un'altra soluzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100125,
					"content": "Ho deciso di concentrarmi sul colore, dunque devo trovare delle tonalità più intense e dei tratti semplici ma al contempo più potenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100126,
					"content": "Devo anche alleggerire l'illuminazione e le composizioni sceniche tradizionali... Questi elementi influiranno sulla mia espressività, perciò dovrò escluderli temporaneamente dalla scena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100127,
					"content": "Ma il problema è che i colori forti impongono l'uso di molta pittura, che va spremuta direttamente sulla tela per ottenere l'effetto desiderato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100128,
					"content": "Perciò ho... mm, finito la pittura. Tuttavia, al momento non posso semplicemente spostare il mio cavalletto. Influirebbe sul mio lavoro creativo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100129,
					"content": "#Viaggiat{F#rice}{M#ore}, potrei chiederti di far visita a Boucicaut? Gli ho ordinato delle pitture, e a quest'ora dovrebbero essere pronte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100130,
					"content": "O magari... Potresti aiutarmi a trovare del nettare di Malefiore? In questo modo, potrei farmi della pittura da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100131,
					"content": "Puoi usare del nettare per fare della pittura?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "Ahahah, certo che puoi. Alcuni dei miei colleghi usano persino le uova!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100133,
					"content": "So che le pitture di questo tipo hanno dei colori delicati ma una consistenza ricca, perfetta per ritrarre scene splendenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100136,
					"content": "Sei un'anima buona, non è vero? Rifiuteresti la richiesta accorata di un artista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100137,
					"content": "Va bene, va bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "Bene, grazie mille! Aspetterò qui. Portamele non appena le avrai recuperate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100138,
					"content": "Sei senza speranza... Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "Ti fai le pitture da solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "Ahahah, certamente! È la prima cosa che un pittore dovrebbe imparare – è così che mantieni il controllo dell'immagine che crei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100119,
					"content": "Perché non provi uno stile pittorico diverso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "È un'idea. Alcuni dei miei colleghi l'hanno fatto, e stanno sperimentando dei metodi pittorici \"figurativi\" per produrre qualcosa di più astratto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100121,
					"content": "I più radicali tra loro vogliono addirittura rinunciare a ritrarre degli oggetti tangibili, e utilizzare semplicemente delle chiazze di pittura per esprimersi... Si autodefiniscono \"Neodescrizionisti\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100122,
					"content": "Ma ammetto che nemmeno io sono in grado di comprendere il loro lavoro. Al massimo riesco a percepire la bellezza ritmica contenuta all'interno di quelle chiazze e di quelle linee di colori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100123,
					"content": "Quanto al vero significato di un dipinto... Posso soltanto chiedere al pittore di spiegarmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
