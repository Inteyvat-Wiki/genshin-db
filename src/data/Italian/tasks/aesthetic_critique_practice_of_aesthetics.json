			},
			"dialogs": [
				{
					"id": 240100301,
					"content": "Non possiamo farci limitare dalle forme tangibili... Dobbiamo disegnare la bellezza e usare anche dei metodi simbolici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100302,
					"content": "No, no... Ancora no. Questa composizione è troppo ponderata...",
					"roleType": "TALK_ROLE_NPC",
