					"nextDialogs": [
						240100505
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100505,
					"content": "Grazie per l'aiuto. Con queste pitture dovrei essere in grado di continuare. Vieni pure a dare un'occhiata quando hai tempo, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100506
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100506,
					"content": "È solo grazie al tuo aiuto se il mio lavoro è iniziato col piede giusto, dopotutto.",
