			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "Consegni il taccuino e le pagine che hai trovato...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "Fammi vedere... Sì! Sono proprio questi. Grazie mille! Qui ci sono molte prove dei crimini dei Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910205,
					"content": "...Crimini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910206,
					"content": "Guarda tutte quelle strutture che hanno costruito sull'Isola di Paha, e i dispositivi meccanici che hanno portato... Quel posto una volta era la casa di tanti animali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910207,
					"content": "Sono appena tornato dal Bacino Granata. Dev'essere a causa delle macchine dei Fatui che tutte le meduse lì riescono a malapena a sopravvivere... Devo farlo sapere a tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910208,
					"content": "Eh? Intendi Gelatina di Baccaduta e le altre? Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910209,
					"content": "Gli racconti cos'è successo al Bacino Granata...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "Quindi è già troppo tardi... ma comunque, dobbiamo documentare questa storia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910211,
					"content": "Ti lascio questi appunti per il momento. Devo tornare di corsa a rivedere quello che ho imparato, così avrò modo di scriverci un articolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910213,
					"content": "Ah, e se lo dici a qualcun altro, assicurati di menzionare che sono stato io, Semyon, a dirtelo. Dopotutto, ci vorrà ancora un po' di tempo prima che possa completarlo e pubblicarlo sul giornale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910214,
					"content": "Comunque, grazie mille! Ci vediamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
