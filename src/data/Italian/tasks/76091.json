			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "Una Fata volante! I miei appunti... I Fatui hanno rubato i miei appunti preziosi! Puoi aiutarmi a recuperarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910102,
					"content": "Beh, Paimon non è esattamente una Fata... ma una cosa del genere dovrebbe essere un gioco da ragazzi! Comunque, che ci fanno i Fatui con gli appunti di un bambino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910103,
					"content": "Forse hanno paura che io li mostri a tutti quanti... Se mi aiuti a recuperarli, ti svelerò il segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910105,
					"content": "Ne parleremo dopo. Ora, per favore, aiutami a recuperare i miei <color=#00E1FFFF>appunti</color>. <color=#00E1FFFF>Alcune pagine del mio taccuino potrebbero essere cadute</color>... Ma dovrebbero essere là, dove ci sono i Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7609102,
			"completionStepIds": [
				7609107
			],
