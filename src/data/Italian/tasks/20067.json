			"dialogs": [
				{
					"id": 200670101,
					"content": "Dove ho sbagliato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670103
					]
				},
				{
					"id": 200670103,
					"content": "#Viaggiat{F#rice}{M#ore}... Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670104,
					"content": "Ho studiato molto dopo la tua lezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670105,
					"content": "Poi, ho chiesto a Jack di aiutarmi a fare una prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670106,
					"content": "Ma... Ho fallito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670107,
					"content": "#Non sono sicura di sapere cos'è andato storto. Viaggiat{F#rice}{M#ore}, potresti darmi un'altra lezione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670108,
						200670109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670108,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				},
				{
					"id": 200670110,
					"content": "#Grazie per l'aiuto, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670111,
					"content": "Allora... Prima: quante persone può trasportare un solo aliante in fase di volo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670109,
					"content": "(Mmh, l'ultima volta le ho dato le risposte sbagliate...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				}
			]
		},
