			"dialogs": [
				{
					"id": 6070201,
					"content": "Non abbiate timore. Il vuoto ha già divorato le empie creature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070202,
					"content": "Ciò che mein Fräulein intende dire è: \"Meglio rimanere qui per il momento, ci penseremo noi a proteggere quest'area\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070203,
					"content": "Grazie! Grazie infinite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070204,
					"content": "Ma, ehm... Non ho mai visto un uccello che, beh... parla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070205,
					"content": "Oh, non c'è da preoccuparsi. Sono solo l'umile servitore di mein Fräulein. Non preoccupatevi, non sono una minaccia per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070206,
					"content": "Potete fidarvi di loro, ve lo garantisco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "Oh, no. Certamente! Non volevo insinuare il contrario. Ho solo, ehm... parlato a sproposito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070208,
					"content": "Umpf, ci passerò su.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070209,
					"content": "#{F#Le mie vassalle}{M#I miei vassalli} hanno degli incarichi da svolgere. Orsù, avanzate e sgominate quelle belve. Possa la benedizione della Prinzessin illuminare il vostro cammino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fischl"
				}
			]
		},
