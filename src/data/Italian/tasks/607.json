			"dialogs": [
				{
					"id": 6070101,
					"content": "Tenete duro! Portate qui un altro armadio! Urgh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070102
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070102,
					"content": "Belve immonde! L'Immernachtreich non tollera simili trasgressioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070103
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070103,
					"content": "Ehi, Fischl!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070104
					]
				},
				{
					"id": 6070104,
					"content": "#Ah, è la voce di {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070105
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070105,
					"content": "#Sei {F#giunta}{M#giunto} nel momento più propizio, {F#mia fedele vassalla}{M#mio fedele vassallo}. Sguaina immantinente il tuo ferro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fischl"
				}
			]
