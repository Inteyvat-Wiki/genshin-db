			"dialogs": [
				{
					"id": 220300301,
					"content": "Mi occuperò dell'accampamento a destra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300302
					]
				},
				{
					"id": 220300302,
					"content": "Allora lo lascio a te. Io vado nell'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300303
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300303,
					"content": "Riuscirai ad affrontarli da solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300304
					]
				},
				{
					"id": 220300304,
					"content": "Sono solo mostri. Non devi preoccuparti per me. Se non fosse per gli ingredienti, li avrei sbaragliati da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300305
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300305,
					"content": "Bene, quando avrai eliminato i mostri e recuperato gli ingredienti, mi troverai nell'altro accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300306
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300306,
					"content": "Diamoci una mossa. Se gli ingredienti si rovinano, temo che il piatto non avrà il sapore promesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
