					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300601,
					"content": "Grazie! Questi sono ancora utilizzabili, ma non possiamo perdere altro tempo... Devo iniziare subito a cucinare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300602,
					"content": "È fatta. Fiuu... il piatto è riuscito solamente grazie a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300603,
					"content": "Sei un vero perfezionista...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "Certo. Nella composizione floreale, nella preparazione del tè, in cucina e con la spada, se non persegui la perfezione niente avrà significato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300605,
					"content": "Il percorso verso l'estremo è la mia filosofia di vita. Tuttavia... Xudong sembra avere un'opinione diversa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300606,
					"content": "Una volta mi ha detto che a Liyue esiste una cosa chiamata moderazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300607,
					"content": "Implica che bisognerebbe sempre evitare l'estremo, nel vivere la propria vita tanto quanto nel fare determinate cose. Secondo lui la moderazione, cioè il non propendere per l'una o l'altra parte, è il modo migliore di vivere.",
