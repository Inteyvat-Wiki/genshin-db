			},
			"dialogs": [
				{
					"id": 220300201,
					"content": "Ecco, questo è il posto. I due gruppi di mostri si sono accampati da entrambi i lati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300202
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300202,
					"content": "Ho già fatto una ricognizione. Anche se i mostri dell'accampamento a sinistra sembrano più deboli, sono più numerosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300203
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300203,
					"content": "Nell'accampamento di destra ci sono meno mostri, ma sono molto più forti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300204,
					"content": "Ti prego di eliminare i mostri di uno degli accampamenti. Io mi occuperò dell'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
