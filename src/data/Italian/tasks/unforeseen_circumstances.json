					"nextDialogs": [
						191211402
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211402,
					"content": "Ha già abbastanza da fare, non credi? Lo vedo raramente in Commissione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211403
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211403,
					"content": "E quando lo vedo, la maggior parte delle volte è alle prese con le faccende domestiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211404
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211404,
					"content": "Penso che debba continuare a fare ciò che vuole. Ognuno ha il proprio stile di vita, e Thoma non fa eccezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				}
			]
		},
