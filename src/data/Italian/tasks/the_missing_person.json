				"objectNames": [
					"Shibata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361701,
					"content": "#Oh, ma tu...! Tu sei {F#la capitana}{M#il capitano} della Pesce spada II! Mi chiamo Shibata, e sono responsabile della guardia qui. Posso sapere di cosa ha bisogno {F#la capitana}{M#il capitano}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361702,
					"content": "Sto cercando informazioni su una persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361703
					]
				},
				{
					"id": 190361703,
					"content": "Racconti a Shibata dell'incarico di trovare Heizou.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "Il suo nome è Shikanoin Heizou, eh? Sì, conosco l'investigatore, era solito passeggiare in questa zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361705,
					"content": "Sua Eccellenza mi aveva incaricato di tenerlo d'occhio, temendo che facesse qualcosa di spiacevole, ma alla fine mi sono reso conto che si comportava più come se fosse un turista o qualcosa di simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361706,
					"content": "A pensarci bene, credo che di recente sia stato avvistato nell'area a est del Santuario dei Sangonomiya. Perché non andate a dare un'occhiata di persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shibata"
				}
			]
		},
