			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361601,
					"content": "#Non siete ancora partit{F#e}{M#i}? Forse avete cambiato idea sul cercare Heizou, eh? Sarebbe meglio. Credetemi, farsi coinvolgere da quel tizio non è mai una buona idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361602,
					"content": "#Sono curios{F#a}{M#o}, che problema hai con lui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "Mettiamola così: non mi darebbe alcun fastidio se sparisse per sempre... Questo è il mio problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361604,
					"content": "(Sorridi e annuisci)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361605
					]
				},
				{
					"id": 190361605,
					"content": "Non guardatemi così. A tutti è permesso avere qualche persona che non si sopporta, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361606,
					"content": "*sospira* In ogni caso, meglio che vi diate una mossa... Prima che Shikanoin crei troppi problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361607,
					"content": "A proposito, se vi capitasse di imbattervi in qualche segno di una... sfortunata scomparsa... assicuratevi di avvisarmi. Mi farebbe molto piacere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 1903617,
