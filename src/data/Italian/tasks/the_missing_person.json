			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji",
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "#E se neanche {F#la}{M#il} viaggiat{F#rice}{M#ore} è disponibile... Cosa posso fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361402,
					"content": "Beh, è un tuo problema. Hai scelto tu di immischiarti in questo casino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361403,
					"content": "#Oh, ma per tua fortuna, {F#le tue}{M#i tuoi} salvat{F#rici}{M#ori} sono appena arrivat{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361404,
					"content": "#Mmmh? Ah, viaggiat{F#rice}{M#ore}! Evviva, ce l'avete fatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361405,
					"content": "Non preoccuparti, sono disponibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "Non è che aveste poi granché da fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361407,
					"content": "Ehi, Sango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361408,
					"content": "#Rispetto al{F#la viaggiatrice}{M# viaggiatore}, sei tu quella che si gira un po' troppo i pollici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361409,
					"content": "Oh no, io sono impegnata... Molto impegnata a starmene qui in piedi tutto il giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361410,
					"content": "Sarà anche un incarico che non vuoi accettare, ma la tua è una scusa davvero patetica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361411,
					"content": "Un incarico che non vuoi accettare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "Già, è per questo che vi ho chiesto di venire. Lasciate che vi spieghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361413,
					"content": "Un importante membro della Commissione Tenryou è scomparso di recente. Nessuno l'ha visto e non sappiamo dove si trovi attualmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361414,
					"content": "La Commissione Tenryou ci ha chiesto discrezione nel trovare questa persona, perché per loro sarebbe una seccatura cercarla apertamente, per una serie di ragioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361415,
					"content": "Si chiama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361416,
					"content": "Kujou Sara. Esatto, la generale è scomparsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361417,
					"content": "*sospira* Se la generale fosse davvero scomparsa, la Commissione Tenryou avrebbe già rivoltato Inazuma come un calzino. Credi davvero che incaricherebbero solo noi per un caso del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361418,
					"content": "#Viaggiat{F#rice}{M#ore}, non fate caso a Sango. La persona scomparsa si chiama Shikanoin Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361419,
					"content": "Lavora come investigatore speciale alla stazione di polizia. Nonostante il suo semplice grado di doushin, è molto competente e stimato alla stazione di polizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361420,
					"content": "Ah! Lo trovano più competente di me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361421,
					"content": "*sospira* Abbiamo capito che non vuoi aiutarci, Sango, ma almeno potresti evitare di complicarci la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361422,
					"content": "#Chiedo scusa, viaggiat{F#rice}{M#ore}. Anche se ho accettato l'incarico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361423,
					"content": "Come vedete, Sango è tutt'altro che entusiasta di essere coinvolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361424,
					"content": "La paga è troppo bassa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "Macché! Nient'affatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361427,
					"content": "Se volete davvero saperlo, mi rifiuto categoricamente di immischiarmi nelle sciocchezze di quel moccioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361428,
					"content": "L'unica notizia che potrebbe rendermi più felice rispetto a \"Shikanoin è scomparso\" è \"Shikanoin è scomparso da 100 anni\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361429,
					"content": "Ehm... Non serve precisare che Sango e Heizou hanno dei trascorsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361430,
					"content": "Capisco... sono concorrenti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "Uhm... Beh, la cosa è un po' più seria di così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361432,
					"content": "Secondo Sango, Heizou si è messo fra lei e il \"Tempio della verità\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361433,
					"content": "Come un cagnaccio che non vuole togliersi di mezzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361434,
					"content": "*sospira* È vero, Heizou ha un carattere \"particolare\", ma è un tipo a posto. Ho davvero imparato molto da lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361435,
					"content": "#Quindi non posso ignorare questo caso, anche se Sango non è d'accordo. Come minimo, dovrei affidare l'incarico a qualcuno capace e affidabile... come voi, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361436,
					"content": "Capisco, quindi lo stai affidando a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "Eh? No no, non è così! Ascoltate, pagherò l'intera somma originariamente promessa dalla Commissione Tenryou, e aggiungerò anche qualcosa di tasca mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361439,
					"content": "#Spero davvero che tu possa accettare questo incarico, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361440,
					"content": "Se Heizou è davvero in pericolo, so che sarà più al sicuro con voi al suo fianco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361441,
					"content": "Siete molto amici?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "In realtà andiamo molto d'accordo, ma Sango mi ha sempre chiesto di mantenere le distanze e di non comportarmi come se lo conoscessi, quando siamo in pubblico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361443,
					"content": "Così, quando la gente me lo chiede, mi limito a dire che ho incontrato Shikanoin qualche volta. Se non fosse stato per l'incidente di oggi, avrei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361444,
					"content": "Ehm... Meglio non approfondire. Comunque, potreste aiutarmi a cercarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361449,
					"content": "Capito, ci andrò subito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "Beh, è tutto quello che posso dirvi. Oh, per favore, prendete questa lettera d'incarico della stazione di polizia. Se trovate Heizou, tornate lì e fate rapporto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361445,
					"content": "Non c'è problema, ma ho bisogno di altre informazioni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "Fantastico! Abbiamo saputo che Heizou aveva parlato con interesse dell'Isola di Watatsumi prima di scomparire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361447,
					"content": "Durante la guerra, sembra che abbia svolto qualche missione sull'Isola di Watatsumi e, una volta finiti i combattimenti, l'ha frequentata spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361448,
					"content": "Ho sentito che avete una buona reputazione con i Sangonomiya. Potrebbe essere una buona idea usarla come punto di partenza per le indagini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361437,
					"content": "Capisco, quindi in pratica sei l'intermediario.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "Troppi pochi indizi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "#Non c'è tempo da perdere, viaggiat{F#rice}{M#ore}. Oh, spero proprio che Heizou non sia in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361502,
					"content": "Dimmi di più su Shikanoin Heizou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "Oh, Heizou è un tipo vivace, molto loquace, attivo ed energico, sempre in movimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361504,
					"content": "Sango lo paragona sempre a una mosca ronzante... Credo sia perché riesce a fiutare con precisione ogni mela marcia nel mucchio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361505,
					"content": "E in questo caso, Heizou non è una mosca qualunque, ma l'asso delle mosche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361506,
					"content": "Anche con il naso tappato, gli occhi bendati e le orecchie coperte, Heizou riuscirebbe comunque trovare le mele marce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361507,
					"content": "Le sue capacità sono incredibili, sembra quasi che si affidi a qualcosa di diverso dai normali cinque sensi... È come se avesse un sesto senso! O forse è pura intuizione? O è il favore divino? Dev'essere qualcosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361508,
					"content": "Capisco dove vuoi arrivare, ma credo che per ora la metafora della mosca sia sufficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "*sospira* Sango dice sempre che mi rendo ridicolo quando parlo, e credo che abbia ragione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361510,
					"content": "La metafora della mosca non è il massimo, ma vorrei comunque saperne di più.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "Ehm... Beh, forse dovremmo parlarne in un altro momento. Sango comincia a fissarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 1903616,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
