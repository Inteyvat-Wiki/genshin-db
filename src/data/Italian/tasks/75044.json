				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443601,
					"content": "(Un romanzo d'amore scritto da Dorothy Leeckson. Sulla copertina sbiadita è raffigurata una donna che giace su un letto circondata da fiori.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "\"Fior di lavanda\""
				},
				{
					"id": 750443602,
					"content": "(Dopo aver sfogliato il libro, senti un senso di calore e soddisfazione, ma non hai acquisito alcuna conoscenza utile.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "\"Fior di lavanda\""
				},
				{
					"id": 750443603,
					"content": "Quindi... Era il giardiniere della sua famiglia o il cognato del cugino del suo migliore amico? Uff, a Paimon comincia a far male la testa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504437,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443701,
					"content": "(La biografia di Frank Drebin, ex ispettore dello Spettro Maréchaussée, la speciale forza di polizia di Fontaine. Sì, l'ispettore è un vigoroso gatto bianco.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443702
					],
					"speakerTitle": "\"Detective Orme di neve\""
				},
				{
					"id": 750443702,
					"content": "(Sul frontespizio di questo libro è impressa un'enorme impronta felina, forse un ricordo speciale lasciato dall'ispettore agli assistenti.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "\"Detective Orme di neve\""
				},
				{
					"id": 750443703,
					"content": "Seriamente... Potrebbero anche scrivere un libro su Paimon, intitolato \"La detective Chiomabianca\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
