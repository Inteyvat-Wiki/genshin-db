		{
			"id": 7504407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "Il Saurico volante è aperto tutto il giorno! Se vuoi partecipare all'addestramento speciale di Matahga, vieni al Saurico volante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "Motto accattivante"
				},
				{
					"id": 750440702,
					"content": "Nota: viva l'allenamento serio e rigoroso, abbasso la pigrizia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "Motto accattivante"
				},
				{
					"id": 750440703,
					"content": "Ozia oggi e farai pena domani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "Motto accattivante"
				},
				{
					"id": 750440704,
					"content": "Solo coloro che hanno il coraggio di dare sempre il massimo conosceranno la vera grandezza come Cavalcatori di Saurici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Motto accattivante"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "Il codice è: suona prima il corno sinistro, poi quello destro, poi di nuovo il sinistro, e infine quello destro... ma fallo a tuo rischio e pericolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "Matahga! Ricordatelo!!!"
				},
				{
					"id": 750440802,
					"content": "Dare da mangiare del pollame a un Saurico è il modo migliore per farlo contento e non farsi beccare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "Matahga! Ricordatelo!!!"
				},
				{
					"id": 750440803,
					"content": "(Sembra un promemoria lasciato da qualcuno chiamato Matahga. Si riesce quasi a sentire l'intensità delle sue emozioni.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "Matahga! Ricordatelo!!!"
				},
				{
					"id": 750440804,
					"content": "(Ma mettere un punto esclamativo alla fine di ogni promemoria è un po' come non metterne neanche uno... No?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga! Ricordatelo!!!"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441701,
					"content": "\"...Per ordine del Guardiano della{RUBY#[D]Yajaw K'ahk'} Fiamma sacra, e per merito della benevolenza e gloria del Sacro S{RUBY#[D]Ti'sakhuun}ovrano, Sua M{RUBY#[D]Kalomte}aestà Och-Kan, stiamo reclutando manodopera in tutte le tribù per la costruzione di infrastrutture per la conservazione dell'acqua...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441702
					]
				},
				{
					"id": 750441702,
					"content": "\"...Non ci sono quote fisse, è tutto basato sulla partecipazione volontaria... costruire l'alleanza... Confidiamo che tutte le tribù risponderanno attivamente...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504418,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441801,
					"content": "\"Per ordine del Guardiano della{RUBY#[D]Yajaw K'ahk'} Fiamma sacra e per il glorioso e del munifico Sacro S{RUBY#[D]Ti'sakhuun}ovrano, Sua M{RUBY#[D]Kalomte}aestà Och-Kan, la terra maledetta verrà sigillata con decorso immediato. A tutti i membri dell'alleanza è espressamente vietato l'ingresso.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441802
					]
				},
				{
					"id": 750441802,
					"content": "Chiunque entrerà senza autorizzazione sarà ufficialmente considerato un nemico dell'alleanza. Questa è la dichiarazione congiunta di [...] Nanatzcayan, Meztli, Huitztlan e Teteocan.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504419,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441901,
					"content": "\"Gloria all'eterno Guardiano della{RUBY#[D]Yajaw K'ahk'} Fiamma sacra, il Grande Pa{RUBY#[D]Q'atal Tzij}cificatore, il munifico Sacro S{RUBY#[D]Ti'sakhuun}ovrano Och-Kan.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441902
					]
				},
				{
					"id": 750441902,
					"content": "Poiché i lavori di drenaggio in questa zona stanno andando a rilento, stiamo apportando piccole modifiche al sistema di rotazione per garantire l'inesorabile vittoria dell'alleanza.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441903
					]
				},
				{
					"id": 750441903,
					"content": "I lavoratori saranno divisi in tre squadre, ognuna delle quali lavorerà per sedici ore, ruotando ogni due giorni. Le squadre con prestazioni eccellenti riceveranno provviste di cereali extra.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441904
					]
				},
				{
					"id": 750441904,
					"content": "La trionfante vittoria nel <color=#00E1FFFF>drenaggio dell'acqua accumulata</color> è a portata di mano. Una volta completati i canali, la <color=#00E1FFFF>pompa dell'acqua</color> potrà funzionare normalmente. Coraggio, un ultimo sforzo!\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504420,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "\"...Compatrioti, famiglie, fratelli e sorelle, che vi siete dedicati al trionfo inesorabile dell'alleanza...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "...Il più munifico... ha predisposto un lotto di nuovi meccanismi da [...] per il trasporto, [...] e per il <color=#00E1FFFF>recupero di oggetti sott'acqua</color>...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "\"...Avanti! Avanti! Procedete a qualunque costo... Per il glorioso futuro dell'alleanza, per la gloria e la libertà, per una terra natia libera dalla tirannia dei draghi...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "\"...Vietato... azionare la <color=#00E1FFFF>leva di controllo</color> senza permesso... cadute accidentali... hanno già causato la morte di tre lavoratori...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "\"...C'è un piccolo sentiero dietro una parete di pietra a nord che conduce alla cima della cascata. Può essere usato come <color=#00E1FFFF>magazzino</color>...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "\"...Ho lasciato delle indicazioni lungo la strada, nel caso in cui mi dimenticassi le direzioni...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "...Le ferite di Sayani hanno preso una brutta piega. La colpa è dell'umidità... Le ho consigliato di riposare, ma si è rifiutata... Ha detto che avrebbe rallentato la squadra, sprecando razioni inutilmente...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "...Quando calerà la notte, mi avvicinerò a lei con una torcia per cauterizzare le sue ferite, mentre gli altri non stanno guardando, o rischierà la cancrena...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
