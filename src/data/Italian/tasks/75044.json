		{
			"id": 7504424,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442401,
					"content": "...Che la gloria eterna sia... Pacificatore... munifico... Och-Kan...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "\"...Gli artigiani Mahutzintl, Tlanalco e... che sono responsabili della costruzione della pompa d'acqua... volutamente rallentato, causando ritardi... Il munifico... non ha imposto alcuna punizione... solo sospeso le razioni per tre settimane...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "\"...La <color=#00E1FFFF>chiave di pietra</color> che attiva il <color=#00E1FFFF>meccanismo della pompa d'acqua</color>... custodita... a nessuno è concesso di usarla senza permesso finché... incaricati altri artigiani...\"",
					"roleType": "TALK_ROLE_NONE",
