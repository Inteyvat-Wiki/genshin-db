						750444602
					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444602,
					"content": "Ah, quindi è questo che stava cercando, qualcosa di rosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444603,
					"content": "Aspetta... Eh? La roba che abbiamo infilato è sparita... Ci abbiamo messo delle cose dentro, vero? C'è qualcosa che non va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444604,
					"content": "C'è qualcos'altro nel barattolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444605,
					"content": "(Picchietta sul vaso)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
