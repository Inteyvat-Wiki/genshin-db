				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750444701,
					"content": "(Si distinguono parole scritte con grafia infantile...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "Appunti di un bambino"
				},
				{
					"id": 750444702,
					"content": "Questo gioco si chiama \"Bing Bong Ding Dong\", e le regole sono le seguenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "Appunti di un bambino"
				},
				{
					"id": 750444703,
					"content": "1. Quando il Monetoo Bing Bong non sta facendo ding dong, sali sulla statua di Saurico per spingerla in avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "Appunti di un bambino"
				},
				{
					"id": 750444704,
					"content": "2. Scendi dalla statua di Saurico quando il Monetoo Bing Bong fa \"ding\" o perderai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "Appunti di un bambino"
				},
				{
					"id": 750444705,
					"content": "3. Il primo a raggiungere la destinazione sarà il vincitore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "Appunti di un bambino"
				},
				{
					"id": 750444706,
					"content": "E non cominciare con questa storia del \"non è una specie di 'Un, due, tre, stella'?\" o stupidaggini simili. Le regole sono importanti, ed è proprio perché non rispetti le regole che non riesci a vincere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Appunti di un bambino"
				}
			]
		}
	]
