			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443801,
					"content": "(Uno spettacolo scritto da Jean Brooklyn, drammaturgo di Fontaine. Un libro così grosso può essere usato dalle persone più piccole per sembrare più alte.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Storia di Teyvat: Parte I"
				}
			]
		},
