						750444402
					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444402,
					"content": "Guardando meglio, è davvero strano che l'unico barattolo vuoto sia quello davanti a questo Monetoo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444403,
					"content": "L'altro Monetoo ha trovato quello che cercava. Questo qua, invece?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444404,
					"content": "#Poverino... Su, {NICKNAME}, aiutiamolo a ritrovare gli oggetti che dovevano essere in questo barattolo... Uhm, cos'è che doveva esserci dentro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444405,
					"content": "(Colloca)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
