			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}! Che sorpresa incontrarti a Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970102,
					"content": "Non ero mai stata in un posto con un clima simile. Fa così freddo! Ma, wow, che esperienza incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970103,
					"content": "Ho fatto la mia prima battaglia a palle di neve, costruito il mio primo pupazzo di neve... Oh, e i fumetti sono una bella sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970104,
					"content": "La Saga delle Anime ardenti è popolarissima a Inazuma, ma non mi aspettavo assolutamente di trovare così tante persone che la leggessero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970105,
					"content": "Poco fa ho fatto una bella chiacchierata con dei fan di Natlan. La cosa mi ha davvero ispirata, e così... ho finito per realizzare una sagoma del personaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970106,
					"content": "...Ah, scusa, partiamo dall'inizio. Hai mai sentito parlare della Saga delle Anime ardenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970107,
					"content": "Parli con Yoimiya delle Anime ardenti...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "Ma dai! Piace anche ai tuoi amici? Che coincidenza curiosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970109,
					"content": "In tal caso, lascia che ti dia questa sagoma di Fietena. Eheh, è perfetta per la Legione delle Anime ardenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}