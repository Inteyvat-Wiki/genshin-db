			"dialogs": [
				{
					"id": 732790201,
					"content": "L'hai trovata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790202,
					"content": "Capisco, ti serve altro tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790203
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790203,
					"content": "Ti prego, trovala al più presto possibile. Il tempo non è dalla parte nostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				}
			]
		},
		{
			"id": 7327904,
			"completionStepIds": [
				7327904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327904",
							"2"
						],
						"stepId": 7327904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar",
					"Schermagliatore dei Fatui 1",
					"Schermagliatore dei Fatui 2",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "Shh... Vedi? Laggiù c'è qualcuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790402,
					"content": "#Mh... Padron{F#a}{M#e}, questi non sono mica quelli di cui parlavi prima? I \"Fai tu\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790403,
					"content": "Si chiamano \"Fatui\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "Non è la stessa cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790405,
					"content": "Shh! Abbassa la voce! Se ci vedono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790406,
					"content": "Non fa niente, tanto non mi sentono. Ecco, guardate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790407,
					"content": "Ehi! Ciccioso! Di qua! È ora di mangiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790408,
					"content": "Mmh? Sentito niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "Schermagliatore dei Fatui 1"
				},
				{
					"id": 732790409,
					"content": "No, perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "Schermagliatore dei Fatui 2"
				},
				{
					"id": 732790410,
					"content": "Uhm... Credevo di aver sentito qualcuno dire che era ora di mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "Schermagliatore dei Fatui 1"
				},
				{
					"id": 732790411,
					"content": "Eheh, visto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790412,
					"content": "Paimon non sapeva che Liloupar avesse un lato così infantile! Eheh, è adorabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790413,
					"content": "Guardate laggiù! Quella è Tadhla? L'hanno presa prigioniera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790414,
					"content": "Mmh... Alta, abbronzata, dai capelli lunghi di colore chiaro... Dovrebbe essere lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790415,
					"content": "#Ben fatto, piccoletta. Adesso tocca a noi, padron{F#a}{M#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790416,
					"content": "#Bene, {NICKNAME}, andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7327906,
			"completionStepIds": [
				7327906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327906",
							"2"
						],
						"stepId": 7327906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790602,
					"content": "Ehm... Sei Tadhla? Siamo qui per liberarti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790603,
					"content": "Davvero...? Oh, davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790604,
					"content": "Li hai lasciati andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790605,
					"content": "Non sono più una minaccia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "Scapperanno via, e allerteranno i loro compagni... Lo sapranno tutti che siamo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790608,
					"content": "Le grandi menti la pensano uguale. Mi piace questa ragazza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790609,
					"content": "Non importa. Se torneranno a darci fastidio, gliele daremo di santa ragione ancora una volta! Ma... tu sei ferita. Ti serve aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790610,
					"content": "Sto bene. Posso camminare, devo solo trovarmi un angolo decente per morire in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790611,
					"content": "Oh, che sollievo: può camminare e deve solo trovarsi un angolo decente per mor... Ehi! Non era quello che voleva sentire Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790612,
					"content": "Sto scherzando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790613,
					"content": "Ahahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790614,
					"content": "Mi piace l'umorismo di questa ragazza... Molto stravagante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790615,
					"content": "Grazie. Torniamo alla tribù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790616,
					"content": "Hai difficoltà a camminare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "Un po', ma non ho bisogno di aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790618,
					"content": "Non vuoi riposarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "Riposarmi? No. Ci conosciamo appena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790620,
					"content": "E allora potremmo conoscerci meglio. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790621,
					"content": "Grazie, magari più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790606,
					"content": "Non c'è bisogno di ucciderli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
		{
			"id": 7327907,
			"completionStepIds": [
				7327907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327907",
							"2"
						],
						"stepId": 7327907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "Ah, ecco il mio Falchetto! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790702,
					"content": "Scusami, mi hanno teso un'imboscata. È solo grazie a loro se sono di nuovo qui per rivederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790703,
					"content": "#\"Loro\"? Vuoi forse dire {F#la}{M#lo} stimat{F#a}{M#o} padron{F#a}{M#e} della djinn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790704,
					"content": "Chiedo scusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790705,
					"content": "Oh, non è niente! Tadhla è ferita, trattala bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790706,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790707,
					"content": "Sei ferita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790708,
					"content": "Mi dispiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790709,
					"content": "Chi è stato? Un animale o un umano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790710,
					"content": "Sono stati i nordici. Mi hanno teso un'imboscata dopo essersi accorti che li stavo seguendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790711,
					"content": "Avresti dovuto esser tu a tendere loro l'imboscata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790712,
					"content": "Essere attaccata dalla propria preda... Sei una vergogna come Falco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790713,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790714,
					"content": "Vai a riposare. Mi occupo più tardi delle tue ferite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790715,
					"content": "Tadhla annuisce in silenzio e lentamente si allontana dolorante.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "Masseira è un po' troppo severo con Tadhla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790717,
					"content": "Non andate d'accordo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "Mmh? No, che sciocchezza. È il mio Falco prediletto. Le voglio un bene dell'anima, ma tendo a non viziarla. Come fai a nutrire un falco se torna ad artigli vuoti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790719,
					"content": "Ah, allora si tratta di questo... Una brutta fine la aspetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790723,
					"content": "#Accetta questo. Hai la mia gratitudine, stimat{F#a}{M#o} padron{F#a}{M#e} della djinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790724,
					"content": "#Ahem. Non stai dimenticando qualcosa? Ci siamo anche noi insieme all{F#a}{M#o} \"stimat{F#a}{M#o} padron{F#a}{M#e} della djinn\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790725,
					"content": "Eheh, Paimon dubita che noi due abbiamo le qualifiche per accettare il premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790726,
					"content": "Ah... Ma certo. Il fatto che questa fata fluttuante tecnicamente non sia una persona mi era sfuggito, finora, ma direi che tutti vanno ringraziati a dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790727,
					"content": "Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790728,
					"content": "Ahah, scusami davvero. Questo è un pagamento extra per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790729,
					"content": "Ooh, un pagamento extra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790730,
					"content": "#...Mi aspettavo qualcosina di più, ma penso di poterlo accettare. Se non hai niente in contrario, mi{F#a}{M#o} padron{F#a}{M#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790731,
					"content": "Molto bene. Se in futuro sarai disponibile, torna da noi un'altra volta. Penso che il mio Falco avrà bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790720,
					"content": "Non essere troppo severo con lei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "Severo? Macché, sono stato anche troppo indulgente. E per questo che è diventata così... negligente. La sto solo istruendo. È un Falco incredibile, potrei mai farle del male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790722,
					"content": "Quindi è questo il fato più comune per un Falco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				}
			]
		}
	]
}