			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "#Ah, {NICKNAME}, stimat{F#a}{M#o} padron{F#a}{M#e} della djinn. A cosa devo il piacere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790102,
					"content": "#Splendido. Un altro figlio del deserto. Padron{F#a}{M#e} io... *sospira* Lasciamo stare. Mi fido del tuo giudizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790103,
					"content": "Hai un minuto da dedicarmi? Ero ansioso d'incontrarti, così come sono ansioso di vedere la luna e la pioggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790104,
					"content": "Non farci dubitare delle tue intenzioni. Arriva al punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790105,
					"content": "#Molto bene, padron{F#a}{M#e} della djinn, avrei una richiesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790106,
					"content": "Ahah, niente di serio. Si tratta solo del mio Falco, Tadhla. Credo che sia in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790107,
					"content": "*sospira* Se non fosse per le mie gambe deboli, non ti disturberei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790108,
					"content": "Forse Paimon si sbaglia, ma vuoi che andiamo in suo soccorso per poi ringraziarci profusamente, pagarci una grossa somma di Mora e invitarci a un sontuoso banchetto trionfale, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790109,
					"content": "Oh... Sì, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790110,
					"content": "Beh, in tal caso, lo faremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790111,
					"content": "Paimon ha sempre le idee chiarissime in situazioni come queste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "*sospira* E va bene, in nome della pancia di Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790113,
					"content": "Grazie tante. Conto su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790114,
					"content": "Aspetta, ti segno l'ultima area in cui è stata vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790115,
					"content": "La persona che devi cercare, Tadhla, è alta, abbronzata, con capelli lunghi dal colore chiaro e un lungo arco. Dovresti essere in grado di riconoscerla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790116,
					"content": "Hai afferrato tutto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790117,
					"content": "Mmh... Una ragazza alta e abbronzata dai capelli di colore chiaro e con un lungo arco! Eheh, Paimon se l'è stampato in testa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790118,
					"content": "Che il vento ti guidi tra le tempeste di sabbia e lontano dal pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790119,
					"content": "Grazie. Ci vediamo presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7327902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
