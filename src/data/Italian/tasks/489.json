			"dialogs": [
				{
					"id": 4890201,
					"content": "Rieccovi! Avete portato tutti gli ingredienti? Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890202
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890202,
					"content": "Sì, c'è tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890203,
					"content": "Allora, l'ordine numero sette è per un <color=#00E1FFFF>pollo ai Fiordolci</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890204,
					"content": "E così comincia la nostra carriera nel mondo della ristorazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890205,
					"content": "Siete voi che avete detto di voler dare una mano al Buon Cacciatore. Assicuratevi di servire il piatto finché è caldo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
