			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4890101,
					"content": "Molto bene. Partirò immediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890102,
					"content": "Amber! Sei qui per dare una mano per l'incarico di Jean?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890103,
					"content": "Oh, ciao. Sì, mi stavo giusto preparando. D'altronde... Chi meglio di una Vigilante sa come sbarazzarsi di un gruppo di Hilichurl che blocca la strada per le consegne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890104,
					"content": "*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890105,
					"content": "Sara... Perché continui ad agitarti? Sono una Vigilante, non ti deluderò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890106,
					"content": "Mi hai fraintesa. Non ho dubbi sulle tue abilità, sono solo agitata per via della quantità di ordini che vedo accumularsi uno sopra l'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890107,
					"content": "È appena arrivato un altro ordine molto strano. Sembra che stiano organizzando un banchetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890108
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890108,
					"content": "*si schiarisce la voce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890109,
					"content": "Possiamo aiutarti in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890110
					]
				},
				{
					"id": 4890110,
					"content": "Io posso aiutare in cucina!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890111
					]
				},
				{
					"id": 4890111,
					"content": "Veramente? Davvero non ti dispiace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890112
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890112,
					"content": "Sarebbe fantastico! Sei davvero l'angelo custode del Buon Cacciatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890113,
					"content": "Sì, beh... Anch'io dovrò fare molta fatica per sconfiggere quegli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890114,
					"content": "Bene, perché non vi occupate di quest'ordine, allora? Per cominciare, procuratevi gli ingredienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890115
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890115,
					"content": "#Sei sicura che possiamo fidarci di {NICKNAME}? Il risultato potrebbe avere un gusto... singolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890116,
					"content": "Adesso non dobbiamo puntare alla perfezione. Questa è una battaglia da vincere a tutti i costi, dobbiamo salvare l'onore del Buon Cacciatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890117
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890117,
					"content": "Una battaglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890118,
					"content": "Per questo piatto, abbiamo bisogno di... <color=#00E1FFFF>3 Fiori Dolci e 3 pezzi di Pollame</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890119
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890119,
					"content": "D'accordo, andate a prepararvi. Anche tu, Amber. Vi aspetto qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890120
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890120,
					"content": "V-Va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
