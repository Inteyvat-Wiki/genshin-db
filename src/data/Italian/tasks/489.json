			"dialogs": [
				{
					"id": 4890301,
					"content": "Un pollo ai Fiordolci, ricevuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890302,
					"content": "Mmm, che profumino! Hai veramente un gran talento, sei la persona giusta al momento giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890303,
					"content": "Uhm, visto che te la cavi così bene in cucina... potresti anche preparare questo <color=#00E1FFFF>arrosto al miele</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890304,
					"content": "<color=#00E1FFFF>Arrosto al miele</color>! L'abbiamo già assaggiato, con Amber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890305,
					"content": "Esatto, è un piatto fisso nel menù del Buon Cacciatore, ne vado molto fiera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890306,
					"content": "I Cavalieri lo ordinano praticamente ogni volta che si riuniscono qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890307,
					"content": "Lasciate che vi spieghi la ricetta dell'<color=#00E1FFFF>arrosto al miele</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890308,
					"content": "Un attimo... Non dicevi che ne vai molto fiera? Sei davvero disposta a insegnarci come si fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890309,
					"content": "Considerando la vostra abilità in cucina, non credo che rovinerete la reputazione del Buon Cacciatore! Eheheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890310,
					"content": "Quando l'<color=#00E1FFFF>arrosto al miele</color> sarà pronto, portalo subito qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
