				{
					"id": 706510101,
					"content": "Accidenti, siamo a corto di minerali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510102
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510102,
					"content": "Posso farti qualche domanda sull'estrazione dei minerali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706510103
					]
				},
				{
					"id": 706510103,
					"content": "Minerali? Cosa volete forgiare? Armi o armature?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510104
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510104,
					"content": "Se siete alla ricerca di minerali, conosco un paio di ottimi posti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510105
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510105,
					"content": "Ci sono minerali di tutti i tipi, però. I pezzi di ferro sono i più comuni, seguiti dai pezzi di ferro bianco e poi da quelli di cristallo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706510106
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 706510106,
					"content": "E ci sono anche i pezzi di cristallo magico, che sono di altissima qualità e vengono usati per forgiare oggetti eccellenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
			]
		},
