			"dialogs": [
				{
					"id": 30111113,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111101,
					"content": "Non siamo in un loop temporale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "Oooh! Allora il bip che sentiamo ogni sera potrebbe indicare la cancellazione dei ricordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111104,
					"content": "Ecco perché, quando ci svegliamo, tutti pensano che il Festival del Sabzeruz non sia ancora iniziato: è già il giorno dopo, ma tutti pensano ancora che sia il giorno prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111105,
					"content": "Ma la memoria muscolare non si cancella tanto facilmente, ed è per questo che Dehya sta migliorando nell'uso dello spadone! Ora tutto ha senso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111106,
					"content": "Mmmh, una deduzione brillante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111107,
					"content": "Nahida, dicci se abbiamo ragione o no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111108,
					"content": "#In parole povere, è come se aveste scambiato un Cristallottero di Pyro per una lucciola nella notte, perdendo di vista la sua vera natura perché vi siete concentrat{F#e}{M#i} troppo sul fatto che si illumina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111109,
					"content": "Non è affatto semplice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111110,
					"content": "Ancora una conclusione sbagliata, eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "Perché non tornate a parlare con la signorina Dehya? Potreste scoprire qualcosa di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111112,
					"content": "#Va bene... Dopotutto ci ha aiutat{F#e}{M#i} a trovare il nostro ultimo indizio. Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111102,
					"content": "Al contrario, i nostri ricordi vengono cancellati alla fine di ogni giornata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
