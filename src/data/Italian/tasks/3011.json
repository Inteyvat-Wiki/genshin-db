			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "#Nahida, siamo tornat{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110402,
					"content": "Siete in anticipo oggi. Avete trovato qualcosa di nuovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110403,
					"content": "#Più o meno. Ora siamo quasi cert{F#e}{M#i} di non essere in un loop temporale e di non essere neanche nel mondo reale, ma abbiamo anche una nuova domanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110404,
					"content": "Cosa succederebbe se cercassimo di lasciare la città?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "Lasciare la città... Per quanto mi ricordo, avete già accennato a un piano per farlo due volte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110407,
					"content": "?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "#Davvero? Ma non ricordiamo nulla! Cos'è successo dopo aver parlato di quei piani? Cosa ci siamo dett{F#e}{M#i} una volta tornat{F#e}{M#i}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110409,
					"content": "#Fatemi pensare... non credo che mi abbiate mai detto quale sia stato il risultato. Oh, forse è più corretto dire che entrambe le volte siete stat{F#e}{M#i} via per tutta la notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110410,
					"content": "Ma voi due a volte rimanete in giro tutta la notte, quindi in quel momento non ci ho pensato troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110411,
					"content": "#È vero che a volte perdiamo la cognizione del tempo durante le nostre indagini. Quando ce ne accorgiamo, è già il giorno dopo. Ma comunque... nessun{F#a}{M#o} di noi si ricorda di aver lasciato la città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110412,
					"content": "Davvero? È un po' strano. In teoria, dovrei aver già risvegliato tutti i vostri ricordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110413,
					"content": "Riproviamoci domani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "Sì! C'è qualcosa di decisamente sospetto. Andiamo a fondo della questione, domani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110416,
					"content": "*bip*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110414,
					"content": "Magari questa è la chiave.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "Abbiamo mai provato a lasciare la città?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
