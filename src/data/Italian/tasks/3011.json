	"talks": [
		{
			"id": 301101,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301101",
							"2"
						],
						"stepId": 301101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "È sempre lo stesso giorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110102,
					"content": "Come volevasi dimostrare, non è così semplice come pensavamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "#Nahida, ieri sera sapevi già che non eravamo uscit{F#e}{M#i} dal samsara! Perché non ce l'hai detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110104,
					"content": "Avrebbe avuto senso? Avreste passato la notte con nuove preoccupazioni, con il domani ancora lontano dall'orizzonte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110105,
					"content": "In questo modo... Almeno avete potuto riposare con un piccolo barlume di speranza. Un'opportunità del genere non capita spesso e ho pensato che potesse aiutarvi a schiarirvi le idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110106,
					"content": "#Paimon pensava fosse perché eravamo andat{F#e}{M#i} in bagno! A ogni modo, non importa, dopotutto avevi solo a cuore i nostri interessi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110107,
					"content": "#Certo, nel tempo in cui siamo stat{F#e}{M#i} insieme, voi due siete stat{F#e}{M#i} tutto per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110108,
					"content": "Paimon è lusingata e tutto il resto, ma forse stai correndo un po' troppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110109,
					"content": "#Eheheh... Quello che voglio dire è che, anche se vi ho chiesto di risolvere questo enigma, voi due siete ancora {F#le uniche}{M#gli unici} che possono vedermi e percepire la mia presenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110110,
					"content": "#In altre parole, se non ci foste voi, io potrei anche non esistere. Ecco perché siete stat{F#e}{M#i} tutto per me. Capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110111,
					"content": "Oh, ecco che Nahida torna a parlare di cose senza senso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110112,
					"content": "#Comunque, basta con le chiacchiere. Allora, viaggiat{F#rice}{M#ore}, i nuovi indizi di ieri ti hanno aiutato a capire meglio la situazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110113,
					"content": "La teoria del loop temporale è sbagliata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "Eh? Perché stai scartando la tua precedente teoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110115,
					"content": "Le capacità di combattimento di Dehya sono migliorate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "Oh, sì, hai ragione. Assurdo, come abbiamo fatto a non accorgercene? In un semplice loop temporale, anche le condizioni fisiche delle persone dovrebbero resettarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110118,
					"content": "Allora, qual è la tua nuova ipotesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110116,
					"content": "Anche la malattia di Dunyarzad si è aggravata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301102",
							"2"
						],
						"stepId": 301102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "Eccovi, finalmente. Mi ci è voluto un po' per trovarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110202,
					"content": "Come previsto, anche oggi Dehya non si è fatta male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110203,
					"content": "Farmi male? Perché mai? Non sottovalutatemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110204,
					"content": "Beh, ti stai ancora abituando al tuo nuovo spadone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110205,
					"content": "A dire il vero, anche a me sembra piuttosto strano. All'improvviso mi è sembrato così familiare... Aspettate un attimo, come facevate a sapere che avevo un nuovo spadone? Non l'ho detto a nessuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110206,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti spiegarle tu la situazione, oggi? Paimon si è un po' stufata di farlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110207,
					"content": "Non c'è bisogno di spiegare tutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "Certo, per me va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110210,
					"content": "Sei diventata improvvisamente abile con il nuovo spadone perché...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "Abbiamo vissuto questo stesso giorno già molte volte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "Cosa vi è successo mentre ero via? Qualche setta vi ha fatto il lavaggio del cervello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110214,
					"content": "Uhm, non pensarci troppo, prendi per buono quello che diciamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110215,
					"content": "Va bene, vediamo se ho capito: mi stai dicendo che il mio corpo si è già abituato a questo spadone, ma il mio cervello non lo ricorda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110216,
					"content": "Esatto, la tua memoria viene cancellata ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110217,
					"content": "Allora, non sono d'accordo, è impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110218,
					"content": "Eh? Perché dici così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110219,
					"content": "Se abbiamo davvero rivissuto il Festival del Sabzeruz giorno dopo giorno, che fine hanno fatto gli oggetti che abbiamo usato, i soldi che abbiamo speso, il cibo che abbiamo mangiato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110220,
					"content": "Il buon senso dice che il mio portafoglio si sarebbe svuotato molto tempo fa. Ed escludo che non me ne sarei accorta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110221,
					"content": "Ci ho pensato anch'io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "Ma se dietro a tutto questo ci sono i saggi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "Giusto... Potrebbero usare l'Akasha per registrare ciò che ognuno ha fatto quel giorno, e poi usare le risorse della città per rifornire tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110225,
					"content": "Non è molto probabile, ma non è nemmeno impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110226,
					"content": "No, è impossibile. Ho le prove.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110227,
					"content": "Hai le prove? Dove?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110228,
					"content": "#*sospira* Voi due siete sorprendentemente seri{F#e}{M#} in questa discussione senza senso. Bene, starò al gioco ancora per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110229,
					"content": "Venite con me. Signorina Dunyarzad, per favore, venga anche lei. Non posso ancora garantire che questa zona sia sicura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110223,
					"content": "Se utilizzassero le risorse dell'intera città e le informazioni fornite dall'Akasha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "E i nostri ricordi vengono cancellati ogni notte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "Andiamo dritti al punto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
		{
			"id": 301103,
			"completionStepIds": [
				301103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301103",
							"2"
						],
						"stepId": 301103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110301,
					"content": "Eccoci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110302,
					"content": "Eh? Questo è un manichino d'addestramento in legno. Cos'ha di speciale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110303,
					"content": "Vedete quei segni sul manichino? Sono il risultato di diversi giorni di pratica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110304,
					"content": "Supponiamo che i saggi non lo abbiano sostituito ogni giorno. Non dovrebbe essere già stato fatto a pezzi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110305,
					"content": "È vero, ma se l'avessero fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110306,
					"content": "Allora i saggi avrebbero dovuto riprodurre ogni segno che avevo lasciato durante le precedenti sessioni di allenamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110307,
					"content": "Sono una combattente professionista. La mia scuola marziale ha sempre sottolineato l'importanza di un controllo assoluto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110308,
					"content": "La forza, l'angolazione e il punto di entrata di ogni colpo sono calcolati e precisi, per questo ricordo ogni segno sul manichino e il mio stato d'animo mentre infliggevo ogni colpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110309,
					"content": "È proprio come si suol dire: ogni spadaccino ha il suo stile unico e nemmeno lo stesso spadaccino può fare due volte lo stesso taglio. Sarebbe impossibile copiare questi segni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110310,
					"content": "È davvero impossibile? E se avessero usato una macchina speciale per incidere ogni singolo segno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110311,
					"content": "Spesso si dice che lo scatto di una Fotokamera non potrà mai sostituire il dipinto di un artista, perché la prima non ha un'anima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110312,
					"content": "Anche in questo caso vale la stessa cosa. Mi basta uno sguardo per distinguere i segni incisi in seguito al mio addestramento al combattimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110313,
					"content": "Ha senso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "Fiuuu... Spero che questo vi abbia chiarito le idee. Ehi, non sarà mica il PraticaMente? Quel nuovo gioco che ultimamente è molto popolare tra gli studiosi? È sorprendentemente divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110316,
					"content": "Comunque, si sta facendo tardi. Devo accompagnare la signorina Dunyarzad al palco di Nilou. Ci vediamo dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110317,
					"content": "Eccoci di nuovo al punto di partenza. Anche la nostra teoria sulla cancellazione della memoria è sbagliata? *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110318,
					"content": "Ma almeno, nel frattempo, abbiamo raggiunto qualche altra conclusione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110319,
					"content": "Non siamo in un loop temporale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "Sì, è vero. Quindi... abbiamo qualche nuova idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110322,
					"content": "Fammi pensare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "Strano? Paimon ha la sensazione che tutto sia strano, ultimamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110325,
					"content": "Come mai... non abbiamo mai pensato di lasciare la città?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "Eh? Lasciare la città... Hai ragione! È davvero strano che non abbiamo mai pensato a una soluzione così semplice. Se potessimo verificare il flusso del tempo dall'esterno dovrebbero diventare chiare molte cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110327,
					"content": "#Paimon non riesce a crederci... Ci è sfuggito perché eravamo troppo concentrat{F#e}{M#i} sulle altre teorie o perché eravamo semplicemente troppo stanch{F#e}{M#i}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110328,
					"content": "È davvero strano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "Che ne dici di chiedere a Nahida? Forse stiamo tralasciando qualcosa riguardo al lasciare la città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110329,
					"content": "Avremmo dovuto pensarci molto tempo fa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "#All'improvviso mi sono res{F#a}{M#o} conto che c'è qualcosa di strano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "Non siamo nel mondo reale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "Sembra che dovremo abbandonare questa teoria...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
