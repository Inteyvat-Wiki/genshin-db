			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huaqing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200401,
					"content": "Altolà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200402,
					"content": "Chi osa violare questi luoghi sacri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200403,
					"content": "Siamo solo di passaggio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "Esatto. Di cosa stai parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200406,
					"content": "#Hanno invitato {NICKNAME} e Paimon! Con quale coraggio {F#le}{M#li} tratti così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200407,
					"content": "No... Aspetta... Forse era questo il vero piano di Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200408,
					"content": "#Ha finto d'invitare {NICKNAME} e Paimon nella Dimora di giada solo per preparare un'imboscata dei Milleliti e arrestar{F#le}{M#li}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200409,
					"content": "#Sono abbastanza cert{F#a}{M#o} che non sia così.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "Grrr... Ora Paimon è arrabbiata! Voi! Laggiù! È tutto uno scherzo, vero? Svergognati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200412,
					"content": "Cosa? Siamo semplicemente di guardia qui. Che intendi per \"svergognati\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200413,
					"content": "#Che sciocchezze! Arrestate subito quest{F#e}{M#i} intrus{F#e}{M#i} sospett{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 10200414,
					"content": "Beh, ve la siete voluta: fatevi sotto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200410,
					"content": "#Non gli abbiamo ancora spiegato che siamo stat{F#e}{M#i} invitat{F#e}{M#i}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "Sacri? Ma queste sono le distese selvagge intorno al Monte Tianheng...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
		{
			"id": 102006,
			"completionStepIds": [
				102006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102006",
							"2"
						],
						"stepId": 102006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200601,
					"content": "Fermatevi! Ma che succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200602,
					"content": "#Lady Keqing, quest{F#e}{M#i} due {F#tipe strane}{M#tipi strani} sono appars{F#e}{M#i} all'improvviso. Sembrano avere dei piani sulla balista Guizhong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200603,
					"content": "#A chi hai dato {F#delle tipe strane}{M#dei tipi strani}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200604,
					"content": "Stavamo solo cercando un modo per raggiungere la Dimora di giada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "Mmm? Volete raggiungere la Dimora di giada? Chi siete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200606,
					"content": "#Siamo {F#state invitate}{M#stati invitati}, stiamo cercando le Sette Stelle di Liyue! E tu chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200608,
					"content": "Beh, si dà il caso che io sia una delle Sette Stelle di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200609,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200610,
					"content": "Sono Keqing, la Yuheng delle Sette Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200611,
					"content": "#So chi sei, viaggiat{F#rice}{M#ore}. Siete ospiti di Ningguang, giusto? Non mi aspettavo di incontrarvi tra queste montagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200612,
					"content": "Wow... Nemmeno Paimon credeva che avremmo incontrato un pezzo grosso, nel bel mezzo del nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200613,
					"content": "La balista Guizhong del Passo di Tianheng era inutilizzabile da tempo, ma è stata riparata in una sola notte. Sono venuta per indagare sulla faccenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200614,
					"content": "Questi Milleliti sono qui solo di guardia, non per arrestare qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200615,
					"content": "Allora è stato tutto un malinteso? Paimon non avrebbe mai pensato che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200616,
					"content": "Pensare non è poi così difficile, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "#Comunque sia, il fatto che {F#una}{M#un} mortale sia riuscit{F#a}{M#o} a riparare un meccanismo degli Adepti è un bel mistero anche per le Sette Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200618,
					"content": "Eheh, è perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200619,
					"content": "(Shhh, Paimon, non complicare le cose!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "#Eh? Oh, giusto. Dunque, Lady Yuheng... non è che per caso sai perché la Tianquan ci abbia invitat{F#e}{M#i} nella Dimora di giada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200622,
					"content": "Chiamatemi pure Keqing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200623,
					"content": "#Credo che Ningguang voglia che {F#la salvatrice}{M#il salvatore} di Mondstadt adotti una posizione più neutrale... O perlomeno che non si schieri del tutto con gli Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200624,
					"content": "Non vogliamo schierarci con nessuno. Abbiamo parlato con gli Adepti. Anche loro vogliono proteggere Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200625,
					"content": "Quando dici \"proteggere\", ti riferisci alla loro ipocrita arroganza, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200626,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200627,
					"content": "Voi siete mortali, e pertanto siete sotto la loro protezione. Non ritengono certo che siate in grado di uccidere una divinità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200628,
					"content": "Naturalmente, credono anche sia inutile che Ningguang blocchi l'area, interroghi gli abitanti e si metta in cerca dell'assassino. Magari sperano persino di trovare un modo per insabbiare il tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200629,
					"content": "Sarò sincera: ci stanno sottovalutando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200630,
					"content": "Beh, su questo hai ragione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200631,
					"content": "Comunque, questa è la prima volta che Paimon incontra qualcuno di Liyue che non rispetta né gli dèi né gli Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200632,
					"content": "Ahah! E dovrei rispettare il poco senso del tempo e l'accondiscendenza verso i mortali che li ha portati a tergiversare prima di mettersi contro le Sette Stelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200633,
					"content": "Scordatevelo. Non dovrei parlare di loro in questi termini. Questo scetticismo è solo mio, e Ningguang non lo condivide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200634,
					"content": "Tuttavia, ammetto che questa volta le azioni degli Adepti sono state piuttosto misurate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200635,
					"content": "La morte di Rex Lapis è davvero una circostanza straordinaria. Ma pensare che preferiscano radunare un consiglio di Adepti anziché venire qui direttamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200636,
					"content": "È sorprendentemente civile da parte loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200637,
					"content": "Non è che magari potreste discuterne insieme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "Beh, Ningguang... Discuterebbe di ogni singolo filo d'erba, se solo potesse. Ma dubito che noi potremo fare altrettanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200640,
					"content": "L'era degli Adepti è tramontata da tempo. Se nemmeno le Sette Stelle di Liyue vogliono affrontare la verità, che futuro può esserci per Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200641,
					"content": "Uff... Un'altra affermazione super spavalda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200642,
					"content": "#*sospira* Mi fermerò qui. Onestamente, non volevo parlare tanto. Ma tu sei {F#una buona ascoltatrice}{M#un buon ascoltatore}, {F#viaggiatrice}{M#viaggiatore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200643,
					"content": "Sarà meglio che raggiungiate la Dimora di giada. Non attardatevi. L'agenda di Ningguang è pienissima fino all'anno prossimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200644,
					"content": "I mercanti più ricchi di Liyue ritengono che ascendere alla Dimora di giada sia l'onore più grande. Quando vi si recano, portano grandi doni nella speranza di ottenere qualche favore da Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200645,
					"content": "Qualche favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200646,
					"content": "Paimon, non è questo il punto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "Ma... Ma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200649,
					"content": "Aspetta, ha ragione! Portare con sé dei doni è una delle tradizioni fondamentali di Liyue. Dobbiamo trovarne uno. Non per chiedere dei favori, ma... per rispettare la cultura di Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200650,
					"content": "Ah, certo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "#Va bene, va bene. Potrete decidere voi stess{F#e}{M#i} quale dono portarle. Ma lasciate che prima vi spieghi come raggiungere la Dimora di giada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200652,
					"content": "Non era necessario raggiungere il Monte Tianheng. Tornate al Porto di Liyue, trovate una guida al Padiglione Yuehai e poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200653,
					"content": "#Bene. Al nostro prossimo incontro, viaggia{F#trice}{M#tore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200654,
					"content": "Quella Yuheng non rispetterà gli dèi, ma Paimon crede che sia una tipa a posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200655,
					"content": "Anche a me ha dato una bella impressione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "Allora... Cosa regaliamo a Ningguang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200658,
					"content": "Volevi proprio troncare di netto il discorso, eh, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "Oh, ci sono! L'altra notte Paimon ha sognato un dolce delizioso: un <color=#00E1FFFF>Melmoso glassato</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200660,
					"content": "Paimon crede che sarebbe perfetto per una persona ricchissima come Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200661,
					"content": "Perché non le regaliamo quello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200662,
					"content": "Hai la ricetta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "No! Ma Paimon sa che basterà un pizzico di badabim-badabum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200666,
					"content": "Andiamo a raccogliere gli ingredienti. Chi ha tempo non aspetti tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200664,
					"content": "E... come facciamo a preparare questa cosa che hai sognato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "Con un pizzico di badabim-badabum, ovviamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200656,
					"content": "Sono d'accordo con alcune sue idee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "Paimon, sii seria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "Ningguang preferirebbe negoziare, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "(Noi abbiamo fatto ben poco, in realtà...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "Eh? Porta solo fin qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200702,
					"content": "Oh, se quella corrente d'aria fosse più forte, raggiungeremmo la cima in un lampo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200703,
					"content": "Meglio tornare a Liyue e chiedere ai Milleliti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "Eh? Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200705,
					"content": "Il modo per salire non dev'essere un segreto, oppure...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "#Oppure? Oh... Paimon ha capito! Se fosse stato un segreto, Ganyu non ci avrebbe permesso di scoprirlo da sol{M#i}{F#e}, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200707,
					"content": "Ok, seguiamo il tuo piano, poi potremo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200708,
					"content": "Oh! Aspetta un attimo. Guarda laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200709,
					"content": "A quanto pare siamo nei pressi della <color=#00E1FFFF>balista Guizhong</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200710,
					"content": "Mmmh... Oh... Paimon ha una nuova idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200711,
					"content": "Perché non ti spariamo fino alla Dimora di giada usando la balista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200712,
					"content": "No, grazie. Non ho voglia di morire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "Oh... Giusto. In effetti forse non è un metodo molto sicuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200716,
					"content": "Comunque sia, se ricordo bene la balista aveva un mirino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "Oh, giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200718,
					"content": "In effetti potremmo usare la balista Guizhong per vedere se qui vicino c'è un altro modo per salire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200714,
					"content": "Mi odi davvero così tanto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "Ehm... No. Forse Paimon si è solo dimenticata di pensare alle misure di sicurezza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}