			"dialogs": [
				{
					"id": 10200101,
					"content": "Guarda, lassù! Ecco la Dimora di giada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200102,
					"content": "Quanto è in alto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "Mmmh... Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200105,
					"content": "Ah, che guaio... Paimon dovrebbe essere la tua guida, ma Paimon non sa come raggiungere la Dimora di giada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200106,
					"content": "L'hai capito solo ora?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200109,
					"content": "Beh, visto che vogliamo andare alla Dimora di giada, la cosa più sensata è raggiungere la sua posizione sulla mappa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200110,
					"content": "Guardiamoci intorno. Qui nei paraggi dev'esserci un modo per salire fin lassù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200107,
					"content": "Avremmo dovuto chiederlo all'emissario Ganyu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "La domanda è: come ci arriviamo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
			"id": 102002,
			"completionStepIds": [
				102002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102002",
							"2"
						],
						"stepId": 102002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200201,
					"content": "Ehi, guarda! Qui c'è una specie di meccanismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200202,
					"content": "Visto che questo è il posto giusto, deve avere qualcosa a che fare con la Dimora di giada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200203,
						10200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200203,
					"content": "Che possa servire a raggiungerla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200204
					]
				},
				{
					"id": 10200204,
					"content": "Sì, dev'essere questo il modo per arrivarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200205,
					"content": "Sembra una specie di trappola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200206
					]
				},
				{
					"id": 10200206,
					"content": "Impossibile! Fidati dell'istinto di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102004,
			"completionStepIds": [
				102004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
