			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "Vi do il benvenuto. Ogni tesoro qui è unico, ve lo garantisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040102,
					"content": "Eheh... Sì, qui non c'è niente che Paimon conosca, questo è certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040103,
					"content": "Ahah, è proprio come ho detto! Questi sono tutti oggetti rari trovati dagli avventurieri in ogni angolo del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040104,
					"content": "C'è niente che attiri la tua attenzione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040105,
					"content": "È tutto così raffinato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "Ah, già! Ho dimenticato di dire che la mia attività si basa sul baratto: merci in cambio di altre merci, non si accettano Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040108,
					"content": "Al momento sto cercando di fabbricare una cosa alquanto speciale, e mi servono molti <color=#00E1FFFF>Sigilli di Anemo</color> per decorarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040109,
					"content": "Per caso hai dei <color=#00E1FFFF>Sigilli di Anemo</color> con te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040110,
					"content": "Ne ho alcuni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "Ahah, sembra che l'Archon di Anemo approvi le tue avventure, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040114,
					"content": "Per essere più specifici, se trovi un <color=#00E1FFFF>Sigillo di Anemo</color> puoi portarlo in questo negozio per scambiarlo con la merce in vendita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040115,
					"content": "Dai un'occhiata agli oggetti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "Cosa sono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "Sono una specie di marchio o emblema che l'Archon di Anemo dona agli avventurieri come segno di riconoscimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040106,
					"content": "Non oso chiedere il prezzo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
		{
			"id": 2050403,
			"completionStepIds": [
				2050403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050403",
							"2"
						],
						"stepId": 2050403,
						"stateName": "QUEST_STATE_UNFINISHED"
