			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Saborn",
					"Souffache",
					"Cimest"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "Il Regno delle Brezze e delle Campane ti dà il benvenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700102,
					"content": "E ora cosa accadrà?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "Ehm... Per prima cosa, devo annunciare al popolo che la reliquia si è espressa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700104,
					"content": "E che il Guardiano... sarà il signor Faurobert, che è venuto da terre lontane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700105,
					"content": "Eh?! E perché mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700106,
					"content": "Cercare di spiegare tutto quello che abbiamo passato sarebbe troppo complicato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700107,
					"content": "E poi, avrebbero bisogno di troppo tempo per capire che io sono sia la principessa che la Guardiana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700108,
					"content": "Al momento opportuno, scriverò un resoconto dettagliato di tutto quello che è accaduto per informare il mio popolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700109,
					"content": "Ma fino ad allora, mi occuperò di tutti gli affari del regno in qualità di principessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700110,
					"content": "Dopo che i \"terreni di prova\" diventeranno \"campi d'addestramento\", partirò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700111,
					"content": "Partirai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "Altezza, ricorda ancora... per chi si è illuminata la reliquia quando eravamo nella caverna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700114,
					"content": "Mmmh? Per chi... si è illuminata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700115,
					"content": "Sì, dato che eravamo entrambi vicini alla reliquia... Naturalmente, Sua Altezza merita questo riconoscimento, ma io... io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700116,
					"content": "Tu sei il campione che è stato riconosciuto da un campione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "Precisamente. E quel campione è venuto a chiedere proprio il tuo aiuto! Come puoi ancora pensare di non essere degno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700118,
					"content": "*sospira* Forse è solo che Sua Altezza è così radiosa che si sono sbagliati tutti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700119,
					"content": "Pfff... Bene, signor campione. Te la sentiresti di affrontare un'altra prova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700120,
					"content": "Io, Cimest, Principessa del Regno delle Brezze e delle Campane, sarò personalmente testimone delle tue imprese con questa reliquia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700121,
					"content": "Certo! Sì, sì, assolutamente sì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700122,
					"content": "Frena un attimo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "Si esalta ogni volta che sente il nome della principessa. Hihi, Faurobert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700125,
					"content": "Non fraintendetemi! L-Lo faccio per adempiere alla missione dello Stagno Cantapioggia! Mi sono allenato solo per salvare... ehm, volevo dire, per proteggere Sua Altezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700126,
					"content": "In più è un compito molto importante, quindi è normale che io debba assicurarmi che tutto proceda senza intoppi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700127,
					"content": "Desideri accompagnare Sua Altezza nel suo viaggio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "I-Io... Sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700129,
					"content": "Eheh, molto bene. Ottimo, signor \"campione\" Faurobert, sei pronto per la mia prova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700130,
					"content": "Sì, Altezza! Al suo comando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700131,
					"content": "Woah! La reliquia si è illuminata di nuovo, e stavolta è abbagliante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700123,
					"content": "Le mie orecchie... bruciano!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "Cos'hai intenzione di fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Faurobert",
					"Horellou",
					"Estampe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "Estampe! Dov'eri finito?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700202,
					"content": "Uh, in realtà stavo facendo un giro e mi sono cimentato nella prova. È stato divertente, ma ho dovuto adottare un approccio leggermente diverso per superarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700203,
					"content": "Il signor Horellou mi ha informato di quello che ti è successo. Non male, signor Guardiano. In fin dei conti, sembra che tu ne abbia proprio la stoffa, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700204,
					"content": "T-Tu... Se ti avessi avuto accanto, ti avrei buttato giù, questo è certo! Ti avrei fatto cadere dieci volte, se si fosse presentata l'occasione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700205,
					"content": "Ed è per questo che ho preferito partecipare alla prova. Faurobert, vecchio mio, ho sempre creduto in te. E ora... Ce l'hai fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700206,
					"content": "Ahahah, ma che carini che siete! Oggi è un giorno di buon auspicio per il nostro stagno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700207,
					"content": "Finalmente abbiamo un vero campione. Sebbene il signor Faurobert non abbia ancora salvato una principessa, so per certo che verrà il suo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700208,
					"content": "*sospira* In realtà non ho fatto nulla, signor Horellou, a parte stare a guardare Sua Altezza occuparsi di tutti i compiti più gravosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700209,
					"content": "Un compito ancora più importante! Non volevi certo far correre dei pericoli alla principessa, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700210,
					"content": "Beh... Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700211,
					"content": "Ah, basta così, signor Faurobert. Cibrelus in persona ti ha scelto per adempiere alla missione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700212,
					"content": "Oh, bubbole! Non sono neppure sicuro che si trattasse veramente di Cibrelus! Dopotutto conosco solo dei racconti su di lui, e non l'ho mai sentito parlare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700213,
					"content": "Senza contare che hai anche accettato di affrontare la prova della principessa. Se c'è un campione, quello sei tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700214,
					"content": "Possiamo... evitare di parlarne? Per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700215,
					"content": "Comunque, per farla breve... Il futuro dello Stagno Cantapioggia è nelle tue zampe esperte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700216,
					"content": "Ora possiamo dilettarci a saltare per il puro gusto di farlo! Al mio ritorno, suggerirò al comitato di stabilire il divertimento come nostro pilastro fondante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700217,
					"content": "Questa proposta avrà tutto il mio appoggio, ma ora torniamo indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700218,
					"content": "Ehi, non lasciatemi qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Faurobert"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cimest",
					"Saborn",
					"Souffache"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "Sia lei che quella rana di carta siete stati riconosciuti come Guardiani, Altezza?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700302,
					"content": "Incredibile, senza precedenti! Non era mai accaduta una cosa del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700303,
					"content": "E dovrà anche modificare la prova... No, non lo faccia, Altezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700304,
					"content": "Non può stravolgere una tradizione così antica per un capriccio, Altezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700305,
					"content": "Va bene, va bene, abbassate la voce. Mi state facendo venire mal di testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700306,
					"content": "È già tutto stabilito. Ora, considerato che sono sia una principessa che una Guardiana riconosciuta dalla reliquia, non avete alcuna autorità per fermarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700307,
					"content": "Ma, Altezza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700308,
					"content": "Dovete rilassarvi. Organizzerò una cerimonia per addestrare stuoli di affidabili scoiattoli volanti a difendere il regno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700309,
					"content": "Solo allora potrò partire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700310,
					"content": "Altezza, noi... *sospira* Lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700311,
					"content": "Non preoccupatevi. So badare a me stessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700312
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700312,
					"content": "In veste di principessa, spetta a me affrontare da sola i venti selvaggi che soffiano sul mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700313
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700313,
					"content": "Come desidera, Altezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saborn"
				}
			]
		}
	]
}