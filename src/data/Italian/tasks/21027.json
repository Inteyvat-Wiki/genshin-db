	"talks": [
		{
			"id": 2102701,
			"completionStepIds": [
				2102701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
