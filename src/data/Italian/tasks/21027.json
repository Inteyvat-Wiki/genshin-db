			},
			"dialogs": [
				{
					"id": 210270201,
					"content": "#Guarda un po' chi abbiamo qui, {F#la}{M#il} viaggiat{F#rice}{M#ore} e il Piccolo Meng! Come posso aiutarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270202,
					"content": "#Io... Ehm... Viaggiat{F#rice}{M#ore}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270203,
					"content": "Vorremo prendere in prestito la tua cucina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "Certo, anche se è una richiesta un po' improvvisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270205,
					"content": "Oh, se le cose stanno così... Va bene, è tutta vostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270206,
					"content": "Piccolo Meng, non essere troppo schizzinoso riguardo al cibo quando sarai in viaggio, mi raccomando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 210270207,
					"content": "C-Certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270208,
					"content": "#Viaggiat{F#rice}{M#ore}, insegnami a cucinare qualcosa di delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270209,
					"content": "Quando saremo in viaggio, vorrei fare una sorpresa al mio papà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270210,
					"content": "Certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270211,
					"content": "#Allora, {NICKNAME}, cosa vogliamo cucinare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
