			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccolo Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#Arrivi proprio al momento giusto, viaggiat{F#rice}{M#ore}! Ti stavo cercando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270102,
					"content": "Eh? Che succede, Piccolo Meng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270103,
					"content": "Ti ricordi quando ti ho chiesto di aiutarmi a spedire un messaggio in bottiglia con tutte le mie preoccupazioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270104,
					"content": "Onestamente, non ci speravo più di tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270105,
					"content": "Ma poi, uno dei soci in affari di mio padre è venuto a cercarlo qualche giorno fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270106,
					"content": "Ha detto che sta pensando di aprire un'attività fungaiola, e che ha intenzione di andare a Sumeru per svolgere un'indagine di mercato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270107,
					"content": "Quindi, ha chiesto a mio padre se volesse andare con lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270108,
					"content": "E ha anche detto che potevano portarmi con loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270109,
					"content": "Papà non era d'accordo all'inizio, ma poi, uno dei suoi amici ha tirato fuori una lettera e gli ha chiesto di parlargli in privato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270110,
					"content": "Hanno chiacchierato per un po', e poi papà ha detto che potevo andare con lui a Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270111,
					"content": "Beh, non so perché abbia cambiato idea così all'improvviso, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270112,
					"content": "Posso andare a Sumeru! Andremo a Sumeru! Evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270113,
					"content": "Complimenti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#È tutto merito di quel messaggio in bottiglia, me lo sento! Grazie mille, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270117,
					"content": "Papà ha detto che, dopo Sumeru, andranno in un posto chiamato il Villaggio di Qiaoying.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270118,
					"content": "Villaggio di Qiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Già. Papà dice che è un villaggio dove vengono piantati molti alberi da tè che producono foglie di tè d'alta qualità. Il nome non è semplicissimo, però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270120,
					"content": "Beh, non pensiamoci ora. Dobbiamo prima arrivare a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270121,
					"content": "È molto lontano da qui, quindi ci impiegheremo un bel po' per arrivarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270122,
					"content": "Ma ho sentito dire che bisogna prepararsi bene per viaggiare, dato che potresti trovarti in situazioni di ogni tipo durante il cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270123,
					"content": "Tu viaggi molto spesso, quindi... Forse potresti insegnarmi qualche trucchetto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270124,
					"content": "Tipo, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270125,
					"content": "Cosa mangi quando sei in viaggio, di solito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270126,
					"content": "Papà mi ha detto che mangiano sempre roba cucinata da loro. Ma io conosco solo pochi semplici piatti, e non so se siano davvero buoni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270127,
					"content": "#Oh-oh! La cucina non ha nessun segreto per noi, vero, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270128,
					"content": "Proprio così. Posso insegnarti a cucinare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "In tal caso, Paimon pensa che dovremmo andare a cercare un piano cottura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270131,
					"content": "Mmm, perché non prendiamo in prestito la cucina dello chef Mao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270132,
					"content": "Chef Mao? Ehm... Non è un po' inquietante quel tizio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270133,
					"content": "Chef Mao inquietante? È una persona fantastica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270134,
					"content": "D-Davvero? Ma quando io e mio papà andiamo lì a mangiare, aggrotta le sopracciglia ogni volta che mi vede scartare il Qingxin dal piatto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210270129,
					"content": "Proprio così. Ci penso io!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "Forse andrò a Sumeru anch'io, sai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "Davvero? Allora potremo incontrarci lì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Piccolo Meng"
				}
			]
		},
