			"dialogs": [
				{
					"id": 721411101,
					"content": "Venera, ascolta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411102
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411102,
					"content": "Egli è forte perché ascolta. Egli vede e sente tutto, perché è forte. Di conseguenza, egli vede tutto ciò che esiste. Ascolta tutto ciò che esiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411103,
					"content": "Né gli sciocchi di Sangonomiya né i folli dell'Isola di Narukami lo comprendono. Non lo percepiscono. Sanno solo affrontarsi, il sangue copiosamente versato li acceca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411104,
					"content": "Tu invece devi comprenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411105,
						721411106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411105,
					"content": "Non riesco a seguire il filo logico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				},
				{
					"id": 721411107,
					"content": "La venerazione ha tutte le risposte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411108
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411108,
					"content": "#Ricorda. Venera tre volte al giorno e verrai ricompensat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411106,
					"content": "Ho capito... forse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				}
			]
