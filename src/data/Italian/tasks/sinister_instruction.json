			"dialogs": [
				{
					"id": 721411201,
					"content": "Egli sta arrivando! Non smettere di venerarlo! Non devi interrompere la venerazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411202,
						721411203
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411202,
					"content": "Tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				},
				{
					"id": 721411204,
					"content": "Egli è accigliato. La sua rabbia presto esploderà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411205,
						721411206
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411205,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411207,
					"content": "E perché? Per via di quella donna! Quella che si è rifiutata di rendere omaggio! La malvagia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411208,
						721411209
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411208,
					"content": "Una donna...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411210,
					"content": "Lei fugge anche ora, ma come può sfuggirgli? Diciotto paia di occhi rosso sangue! Migliaia di zanne affilate e velenose! Innumerevoli bocche e lingue, sempre assetate di sangue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411211
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411211,
					"content": "Non può più nascondersi, non può più nascondersi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411212
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411212,
					"content": "Ah, la nazione desertica degli aridi sentimenti! E tu, mendicante senza cervello che si nasconde nella foresta, millantando saggezza... nessuno potrà proteggerla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411213,
						721411214
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411213,
					"content": "Calmati, per favore!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411215,
					"content": "#Tu sei benedett{F#a}{M#o}! Continua a venerare! Continua a venerare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411214,
					"content": "Ah, puoi giurarci, caro mio!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411215
					]
				},
				{
					"id": 721411209,
					"content": "Sicuro, che sia dannata. Giusto...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411210
					]
				},
				{
					"id": 721411206,
					"content": "Oh sì, presto esploderà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411207
					]
				},
				{
					"id": 721411203,
					"content": "Oh, egli sta arrivando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411204
					]
				}
			]
		},
