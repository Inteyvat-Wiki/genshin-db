			"dialogs": [
				{
					"id": 721410701,
					"content": "Rispetto alle sue immense benedizioni, questa ricompensa è ben poca cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410702,
					"content": "Prega. Venera. Ascolta le sue parole e lascia che egli ascolti le tue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410703,
					"content": "A quel punto, come me, potrai ascoltare la sua voce all'interno del tuo cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410704
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410704,
					"content": "Solo allora egli ti libererà dal dolore, premiandoti come meriti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410705,
						721410706
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410705,
					"content": "Beh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				},
				{
					"id": 721410707,
					"content": "#Ricorda. Venera tre volte al giorno e verrai ricompensat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410708,
					"content": "Ricorda, ricorda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410706,
					"content": "Come dici tu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
