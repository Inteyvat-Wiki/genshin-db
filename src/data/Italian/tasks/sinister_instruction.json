					"nextDialogs": [
						721410804
					]
				},
				{
					"id": 721410804,
					"content": "(La fragranza di fiori selvatici sconosciuti si diffonde. Sembra che una volpe si sia nascosta tra i cespugli, generando un fruscio. Provi ad ascoltare, ma non succede nulla.)",
					"roleType": "TALK_ROLE_NPC",
