			"dialogs": [
				{
					"id": 721411801,
					"content": "Sei qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411802
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411802,
					"content": "Come ti senti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411803
					]
				},
				{
					"id": 721411803,
					"content": "Grazie per aver perdonato i miei peccati. Lascia che io torni da te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411804
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411804,
					"content": "Parli con me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "Cosa? Ma perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411806,
					"content": "Ho presieduto a ogni sacrificio e accettato qualunque tua benedizione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411807
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411807,
					"content": "Lei invece... da te marchiata, da te creata... ha rifiutato tutte le tue benedizioni. Ci ha tradito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411808
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411808,
					"content": "Ma cosa stai dicendo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411809
					]
				},
				{
					"id": 721411809,
					"content": "Ah! Oh, chiedo scusa... Chiedo scusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411810
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411810,
					"content": "Non dovrei mettere in dubbio le sue scelte. Continua a sopportare... Continua ad adorare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411811
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411811,
					"content": "Riesci a sentirmi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411812
					]
				},
				{
					"id": 721411812,
					"content": "Continua a sopportare... Continua ad adorare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411813
