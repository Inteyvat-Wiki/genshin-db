			},
			"dialogs": [
				{
					"id": 721410601,
					"content": "Allora? Hai avuto la fortuna di ascoltare i suoi insegnamenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410602,
						721410603
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410602,
					"content": "Non ho sentito nulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				},
				{
					"id": 721410604,
					"content": "Oh, d'accordo. D'accordo. Egli vede. Egli sente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410605
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410605,
					"content": "Egli è confortato e chiunque presti orecchio verrà ricompensato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410606,
					"content": "La sua ricompensa non si trova su quella sponda. Sarà domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
						721410608
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410607,
					"content": "Hai idea di cosa stai dicendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "La prossima volta che tornerai, lo vedrai con i tuoi occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
