			},
			"dialogs": [
				{
					"id": 721411701,
					"content": "Egli va calmato. La sua rabbia deve chetarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411702,
					"content": "Ben fatto! Ottimo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411703,
					"content": "Ricorda, qualcuno proverà a ingannarti con delle maschere, ma egli ti aiuterà. Egli ti aiuterà sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411704,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "Quella donna è come uno dei demoni kitsune delle leggende. L'ho lasciata andare. Egli è molto adirato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411707,
					"content": "Egli è di nuovo adirato... Questo è il mio peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411708,
					"content": "Perdonami... Farò un nuovo sacrificio. Troverò un nuovo sacrificio per il ritorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411709,
					"content": "Perdonami, per favore. Perdonami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411710
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411710,
					"content": "Perdonami, per favore. Perdonami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411705,
					"content": "Bene... direi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				}
			]
