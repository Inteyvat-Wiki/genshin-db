			"dialogs": [
				{
					"id": 721130201,
					"content": "Paimon vuole vedere, Paimon vuole vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130202,
					"content": "Wow! È davvero un buon auspicio. Che bello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130203,
					"content": "Oggi è proprio il giorno fortunato di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130204,
					"content": "Il tuo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "Ma certo! La tua fortuna è la fortuna di Paimon, quindi se Paimon è fortunata lo sei anche tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130206,
					"content": "Quando Paimon mangia bene, la fortuna è sempre alle porte. Quindi, se vuoi che ci sorrida, dai a Paimon qualcosa di buono da mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
