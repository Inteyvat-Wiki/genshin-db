			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721130601,
					"content": "Eh? Che cos'è? Sembrano gli appunti di qualcuno. Fai vedere a Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130602,
					"content": "\"Shuumatsu... Fatui... complotto...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130603,
					"content": "Ma che cos'è? È proprio malridotto e ci sono macchie dappertutto. Paimon non riesce a leggere niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130604,
					"content": "Potrebbe essere un indizio per trovare un tesoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130605
					]
				},
				{
					"id": 721130605,
					"content": "In effetti hai ragione! Paimon darà un'altra occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130606,
					"content": "\"Quando questo messaggio sarà decifrato, il codice segreto...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130607,
						721130608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130607,
					"content": "Decifrare il messaggio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				},
				{
					"id": 721130609,
					"content": "Paimon vuole dare un'occhiata! \"La prima metà è 'Nel mezzo di una notte velata'...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130610,
					"content": "Si interrompono qui e Paimon non capisce cos'è l'altra metà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130611,
					"content": "Ma visto che ha utilizzato un codice segreto, dev'esserci qualcosa sotto, non pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130612,
					"content": "In ogni caso, sembra importante. La prossima volta che decifreremo un omikuji cerchiamo di confrontare i codici segreti, che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130608,
					"content": "Codice segreto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				}
			]
		},
