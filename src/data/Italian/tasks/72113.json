			"dialogs": [
				{
					"id": 721130701,
					"content": "Il modo di fare della signorina Gendou è lo stesso di sempre, eh? Comunque, controlliamo cosa c'è negli omikuji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130702,
					"content": "Eh? Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130703,
					"content": "Aaah, Paimon ha capito. Si riferisce sicuramente a qualche cattivone da sconfiggere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130704,
					"content": "Sì, dev'essere quello. Allora, signorina Gendou, lei è un agente segreto che utilizza questo metodo per comunicare e annientare chi cerca di colpire Inazuma, corretto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130705,
					"content": "Parlate un po' troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130706
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130706,
					"content": "Argh! M-Mi spiace! Ti prego, non sguinzagliarci contro la Shuumatsu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130707,
					"content": "Adesso andatevene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130708
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130708,
					"content": "Leviamo subito le tende! Andiamo nel posto indicato nell'immagine e vediamo se riusciamo a trovare il nostro obiettivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
