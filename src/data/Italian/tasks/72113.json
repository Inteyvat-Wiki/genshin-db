				},
				{
					"id": 721130302,
					"content": "Sì, niente male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130303,
					"content": "Essere in compagnia di Paimon porta sicuramente molta fortuna!",
