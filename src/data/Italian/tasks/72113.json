				{
					"id": 721130401,
					"content": "Paimon vuole vedere, Paimon vuole vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130402,
					"content": "Ah, è di cattivo auspicio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130403,
					"content": "Paimon sa cosa fare in questi casi! Bisogna... \"appendere l'omikuji nefasto sulla bacheca degli omikuji.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130404,
					"content": "\"Poi, è necessario dare a Paimon qualcosa di buono da mangiare. In questo modo, la sventura diventerà fortuna!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130405,
					"content": "Ah, sì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "Certamente! Vuoi forse mettere in discussione la saggezza degli antichi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130407,
					"content": "Il loro sapere era impressionante! Comunque, andiamo prima a cercare la bacheca degli omikuji!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
