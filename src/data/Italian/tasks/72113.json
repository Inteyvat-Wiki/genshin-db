					"content": "Siamo nel posto giusto, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130902,
					"content": "Non c'è niente di speciale qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130903,
					"content": "Eccovi qui, proprio come previsto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
		{
			"id": 7211310,
