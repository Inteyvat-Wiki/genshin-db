			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gendou Ringo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721131001,
					"content": "Chi sei tu, e quali sono le tue intenzioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131002,
					"content": "Ehi, quello dobbiamo dirlo noi! Perché attaccarci così, signorina Gendou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131003,
					"content": "Che modi. Rispondete alla mia domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131004,
					"content": "#Sono {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "Oh, conosco bene i vostri nomi. Ora ditemi, dove avete sentito del codice segreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131006,
					"content": "M-Me l'ha detto Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "Fermi tutti, che cosa?!? Di' subito alla signorina Gendou che cos'è successo! Non vedi che sguardo terrificante ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131010,
					"content": "#Capisco. Quindi siete incappat{F#e}{M#i} per caso in quegli appunti. In tal caso Momoka dev'essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131011,
					"content": "Chi è Momoka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "È l'autrice di quegli appunti ed era una mia collega. Sfortunatamente non potrà più servire Inazuma. Un vero peccato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131013,
					"content": "Sono certa che avrete mille domande. Suppongo che rispondervi non sarà un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131014,
					"content": "Io e Momoka siamo entrambe ninja della Shuumatsuban. Il nostro incarico è quello di liberare Inazuma dalle minacce esterne e questi \"pezzi di carta\" sono uno dei modi in cui comunichiamo i nostri incarichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131015,
					"content": "Di conseguenza, siamo avvezze al pericolo e al risentimento altrui, ad esempio da parte delle persone poco raccomandabili che si sono infiltrate nella nostra nazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131016,
					"content": "Gente di Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "In che senso \"gente di Mondstadt\"?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131020,
					"content": "Usiamo dei codici segreti per identificarci a vicenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131021,
					"content": "Ciascun codice corrisponde a una persona precisa. Sembra che Momoka ci abbia volutamente lasciato il suo codice nel tentativo di informarci della situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131022,
					"content": "Stava tentando di attirare il nemico che avrebbe voluto utilizzare quel codice segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131023,
					"content": "Quindi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "E lo ha scoperto immediatamente, non è così signorina Gendou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131025,
					"content": "Certo. Ecco perché dovevo controllare la situazione. Ma era davvero strano. Non riuscivo a capirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131026,
					"content": "Se foste davvero spie di Snezhnaya, allora perché completare gli incarichi che vi ho dato senza riferire tutto ai Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131027,
					"content": "Per questo credo alla tua storia dell'accampamento abbandonato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131028,
					"content": "#Dalle vostre azioni vedo che, sebbene inizialmente abbiate decriptato il codice segreto solo per curiosità, siete amic{F#he}{M#i} e non nemic{F#he}{M#i} di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131029,
					"content": "#Beh, abbiamo dimostrato la nostra innocenza... ma Paimon è ancora irritata dal fatto che ci abbia usat{F#e}{M#i} come manodopera gratuita per tutto questo tempo, signorina Gendou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131030,
					"content": "Però... eravate davvero voi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "Uff, vedo che l'hai capito. La Gendou che ti ha affidato degli incarichi in seguito è un'impostora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131032,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131033,
					"content": "Mentre vi stavo pedinando, sono stata aggredita da alcune spie dei Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131034,
					"content": "Visto che con le tecniche ninja me la cavo bene, ho finto di essere morta per ingannarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131035,
					"content": "In seguito, hanno semplicemente fatto in modo che uno dei loro si travestisse da me e mi sostituisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131036,
					"content": "Ecco perché era così strana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "Eh? Quindi la signorina Gendou tutta carina e gentile di prima in realtà non esiste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131039,
					"content": "Di buon cuore? Tsk, immagino che fosse molto popolare, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131040,
					"content": "Beh, ad ogni modo devono aver supposto che fossi un membro ufficiale della Shuumatsuban e hanno provato a usarti per infiltrarsi nella nostra organizzazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131041,
					"content": "Alla fine per me è stata una buona occasione. Mentre l'impostora non c'era, ho avuto modo di mettere in atto il mio piano per farvi arrivare qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131042,
					"content": "Ascoltatemi bene. Ora ho una proposta da farvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131043,
					"content": "#Potreste lavorare per noi come collaborat{F#rici}{M#ori} estern{F#e}{M#i}. Il nemico non sa ancora che sono viva, quindi al momento siamo in vantaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131044,
					"content": "E se io rifiutassi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "Potresti senz'altro provarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131046,
					"content": "#C'è da dire che i Fatui sono anche nostri nemici, {NICKNAME}! A questo punto, perché non collaborare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131049,
					"content": "#Una scelta saggia. Sentitevi liber{F#e}{M#i} di servirvi dei rifornimenti presenti in questo rifugio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131050,
					"content": "Molto bene. Mi farò sentire non appena ci saranno degli sviluppi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131051,
					"content": "Che la nostra collaborazione possa portare buoni frutti. A presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131047,
					"content": "Mi sembra ragionevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "Ecco perché ha chiamato gli omikuji correttamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "Proprio così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131008,
					"content": "Ascoltatemi. È andata così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "Abbiamo trovato un accampamento abbandonato su una collina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}