			"dialogs": [
				{
					"id": 750290601,
					"content": "Non sei niente male, continua così. So che puoi farcela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290602,
					"content": "Pff, pensavi davvero che avrei detto qualcosa del genere? No! Essere \"non male\" o \"bravi quanto basta\" non è sufficiente per i guerrieri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290603
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290603,
					"content": "#Dovresti dare il massimo per essere {F#la}{M#il} migliore! Chi non ci riesce è un fallimento totale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290604
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290604,
					"content": "Finché avrai il coraggio di provarci, continua a impegnarti! Allenati finché non sarai in grado di superarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
