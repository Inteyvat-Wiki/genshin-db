				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291301,
					"content": "Il Saurico volante è aperto tutto il giorno! Se vuoi partecipare all'addestramento speciale di Matahga, vieni al Saurico volante! Nota: allenarsi seriamente è motivo di grande orgoglio, così come la pigrizia è motivo di grande vergogna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291302,
					"content": "Ozia oggi e farai pena domani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291303,
					"content": "Solo coloro che hanno il coraggio di dare sempre il massimo conosceranno la vera grandezza come Cavalcatori di Saurici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502914,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7500001",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291401,
					"content": "L'ordine è il seguente: <color=#00E1FFFF>suona prima il corno sinistro, poi quello destro, e infine di nuovo il sinistro</color>! Non fare confusione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291402,
					"content": "(Sembra un promemoria lasciato da qualcuno chiamato Matahga. Si riesce quasi a sentire l'intensità delle sue emozioni.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291403,
					"content": "(Ma mettere un punto esclamativo alla fine di ogni promemoria è un po' come non metterne neanche uno... No?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}