			"dialogs": [
				{
					"id": 750290101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290102,
						750290103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290102,
					"content": "Ciao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				},
				{
					"id": 750290104,
					"content": "Ahahahahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290105,
					"content": "Waaah! A Paimon è preso un colpo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290106,
					"content": "A quanto pare siete qui anche voi per l'addestramento speciale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290107
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290107,
					"content": "Lo sapevo, me lo sentivo! Che si tratti di umani o Saurici, i guerrieri ambiziosi finiscono sempre per incontrarsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290108
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290108,
					"content": "Ebbene, non indugiamo oltre: diamo inizio all'addestramento speciale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290109,
						750290110
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290109,
					"content": "Quindi ce l'hanno anche qui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290111,
					"content": "#Non abbiamo nemmeno aperto bocca! Cosa ti fa pensare che siamo {F#venute}{M#venuti} qui per questo addestramento di cui parli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290112,
					"content": "E da come parli... non sembri affatto un allenatore, o Paimon sbaglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290113,
					"content": "Non tutti possono diventare allenatori, sai. Io non possiedo un talento simile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290114
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290114,
					"content": "#Un momento, volete dire che... non siete {F#arrivate}{M#arrivati} fin quassù per affrontare l'addestramento speciale di Matahga, ovvero il sottoscritto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290115,
						750290116
					],
					"speakerTitle": "Matahga",
					"speakerSubtitle": "Riservista del Clan Piumafiore"
				},
				{
					"id": 750290115,
					"content": "Siamo solo di passaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290117,
					"content": "Aver volato in groppa a un Saurico dimostra che avete già una base solida, ma a quanto pare vi manca l'ambizione... Che spreco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290118
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290118,
					"content": "#E io che credevo foste {F#guerriere}{M#guerrieri} in cerca di gloria come me... Ah, che gran peccato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290119
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290119,
					"content": "Sembra che vi abbia giudicato male... Non è proprio da me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290120
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290120,
					"content": "Paimon non capisce se Natlan è la nazione degli eroi o delle persone fin troppo esagitate... Perfino i bambini qui hanno l'argento vivo addosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290121,
						750290122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290121,
					"content": "I bambini? Certo che no...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290123,
					"content": "Tutt'altro! La pigrizia non è più una scusa quando si decide di diventare un guerriero! Coloro che mancano di coraggio, determinazione e ambizione sono destinati a fallire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290124
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290124,
					"content": "Ora ho dodici anni! Non sono più un bambino da quando ho raggiunto le due cifre... ma sono disposto a perdonarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290125
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290125,
					"content": "Certo, ammetto che, nonostante beva litri di latte, non riesco ancora a diventare più alto di così... Ma la mia forza di volontà è inarrestabile, e sono pronto a distruggere qualunque ostacolo mi si pari davanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290126
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290126,
					"content": "#E poi, anche se sto ancora crescendo, voi non siete di certo molto più {F#alte}{M#alti} di me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290127
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290127,
					"content": "Q-Quanta energia! Perché ci tieni così tanto a coinvolgerci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290128,
					"content": "Umpf! Ammetto che la forza fisica di un individuo dipende dalla sua costituzione, ma un vero guerriero non permetterebbe mai che questo diventi un limite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290129
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290129,
					"content": "La mente è più forte del corpo, sempre e comunque... Tutto sta nell'avere fede nei propri sogni e ambizioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290130
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290130,
					"content": "Un concetto così semplice di sicuro possono capirlo anche degli avventurieri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290131
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290131,
					"content": "È un discorso che non fa una piega, ma... Paimon si sente aggredita verbalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290132,
						750290133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290132,
					"content": "In effetti, anch'io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290134,
					"content": "#Stavo solo spiegando a voi scansafatiche quanto l'ambizione sia una qualità necessaria. Non sarete mai {F#delle vere eroine}{M#dei veri eroi} con un atteggiamento così pigro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290135
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290135,
					"content": "Come guerrieri... anzi, come persone... se ci si allena senza la minima ambizione e senza impegnarsi al massimo, non si è altro che un fallimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290136
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290136,
					"content": "Se non puoi solcare i cieli come un eroe o ricevere l'approvazione del Capo allenatore, non sei altro che un perdente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290137
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290137,
					"content": "Quindi allenatevi come si deve! Ricevuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290138
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290138,
					"content": "C-Capito! Ehm... Cosa facciamo? Fa un baccano assurdo, e quello che dice ha troppo senso per poterlo contraddire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290139,
					"content": "#Bene! Se siete {F#pronte}{M#pronti} ad affinare le vostre capacità, venite a trovarmi per l'addestramento speciale! L'obiettivo sarà far volare il vostro Saurico alla massima velocità lungo il percorso e totalizzare il punteggio più alto possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290140
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290140,
					"content": "Durante l'addestramento osserverò e valuterò le prestazioni dei partecipanti in ogni fase della prova. I risultati finali verranno suddivisi in quattro gradi in base ai punti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290141
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290141,
					"content": "Vola più veloce che puoi! Anche se non riesci a raggiungere la fascia più alta, almeno raggiungi quella appena prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290142
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290142,
					"content": "È il momento di dare il massimo. Non lasciate che la mia ombra vi faccia mangiare la polvere! Forza, forza, forza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290143
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290143,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290144
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290144,
					"content": "#{F#Guerriera}{M#Guerriero}! Attendo la tua risposta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290145,
						750290150
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290145,
					"content": "A-Agli ordini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290146
					]
				},
				{
					"id": 750290146,
					"content": "Alza la voce quando parli con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290147
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290147,
					"content": "AGLI ORDINI!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290148
					]
				},
				{
					"id": 750290148,
					"content": "Questo è il luogo dove gli aspiranti guerrieri vengono per allenarsi. Mostrami la tua determinazione e punta sempre a superare i tuoi limiti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290149
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290149,
					"content": "Vieni per l'addestramento quando pensi sia il momento giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290150,
					"content": "Capisco! Ma preferisco di no!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290151
					]
				},
				{
					"id": 750290151,
					"content": "Cosa? Non vuoi ancora sbarazzarti della tua pigrizia?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290152
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290152,
					"content": "Che attitudine vergognosa! Ma non importa. Verrà il giorno in cui il peso dei tuoi fallimenti diventerà intollerabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290153
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290153,
					"content": "Sottrarsi continuamente a sé stessi non porta da nessuna parte, e non ti lascerà niente! Solo avanzando si può sperare di elevarsi e far riecheggiare nel mondo la propria risata tonante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290154
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290154,
					"content": "Umpf! Ricorda le mie parole: quando arriverà il momento, sarai sempre in tempo per allenarti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290133,
					"content": "Perché ci stai aggredendo verbalmente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290122,
					"content": "Mi sembra un po' estremo, ragazzino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290116,
					"content": "Mai sottovalutare la curiosità di un avventuriere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290110,
					"content": "Definisci \"addestramento speciale\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290103,
					"content": "Ciao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				}
			]
		},
		{
			"id": 7502902,
			"completionStepIds": [
				7502904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502904",
							"2"
						],
						"stepId": 7502904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290201,
					"content": "Fantastico, straordinario! Mi hai superato, surclassato oserei dire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290202
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290202,
					"content": "Seguo un allenamento speciale nella speranza di battere il mio stesso record. Sfortunatamente non ci sono ancora riuscito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290203
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290203,
					"content": "Ma tu ce l'hai fatta! Mi hai dimostrato che dovrei partire, lasciare questo posto, poiché di certo esistono tanti guerrieri ben più straordinari di me, là fuori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290204
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290204,
					"content": "Sono sicuro che migliorerò ancora se continuerò ad allenarmi e a scambiare consigli con loro. Mio padre e mia sorella dovranno riconoscere le mie capacità, aspetta e vedrai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290205
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290205,
					"content": "Acomitl è escluso, ovviamente. Quel sacco di patate è totalmente privo di ambizione. Mi vergogno di chiamarlo fratello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290206
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290206,
					"content": "Acomitl...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290207
					]
				},
				{
					"id": 750290207,
					"content": "Ah, lasciamo perdere. Abbiamo parlato abbastanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290208
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290208,
					"content": "#{F#Guerriera}{M#Guerriero}! Non smettere mai di affinare le tue abilità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290209
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290209,
					"content": "Se vuoi entrare nella leggenda, devi caricare a tutta forza! Carica! Carica! Queste parole sono il regalo con cui ti saluto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502905,
			"completionStepIds": [
				7502904,
				7502906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502906",
							"2"
						],
						"stepId": 7502906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290501,
					"content": "#{F#Guerriera}{M#Guerriero}! Come procede il tuo addestramento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290502,
					"content": "Sto facendo progressi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "Puah, debole! Non fare passi avanti è come fare passi indietro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290506,
					"content": "Uff, come si può dire... Sembra che \"avanti\" e i suoi sinonimi siano gli unici vocaboli presenti nel dizionario di Matahga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290507,
					"content": "Sono più concentrato di chiunque altro, e sai perché? Perché l'unica cosa che riconosco è il duro lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290508,
					"content": "Devi allenarti, e lo stesso vale per me. Allenarmi solo con i Saurici non mi renderà un guerriero completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290509,
					"content": "Devo cercare un palcoscenico più grande per affinare le mie abilità! E ciò significa che dovrò intraprendere un viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290510,
					"content": "Non preoccuparti! Lascerò intatto il percorso qui, ma smantellerò la capanna e la porterò con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290511,
					"content": "Dove andrai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "Ah... A trovare mio padre e mia sorella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290515,
					"content": "Eh? Matahga sembra aver perso fiducia in sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290516,
					"content": "Che male c'è? Amare e rispettare la famiglia è una virtù che ogni guerriero dovrebbe possedere! Apri la mente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290517,
					"content": "Mio padre è il Capo allenatore migliore del Clan Piumafiore, e mia sorella è la miglior Cavalcatrice di Saurici! Sono fierissimo di loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290518,
					"content": "Ehi, piano! Paimon non voleva mica mettere in dubbio il loro giudizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290519,
					"content": "Capisco. Buona fortuna, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "#Buona fortuna anche a te, {F#guerriera}{M#guerriero}! Le mie parole di commiato per questo incontro sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290521,
					"content": "Fammi pensare... Non arrenderti mai! Diventa un eroe a qualunque costo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290513,
					"content": "Come hai intenzione di addestrarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "Mmh... Forse dovrei chieder loro come la pensano, prima di decidere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290504,
					"content": "Non ho avuto tempo di allenarmi oggi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "Che indolenza! Non dirmi che stai sprecando la tua vita bighellonando inutilmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
