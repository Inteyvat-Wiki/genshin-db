					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290801,
					"content": "Diventerò un guerriero! Anzi, un eroe! Aspetta e vedrai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502913,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
