			},
			"dialogs": [
				{
					"id": 750290701,
					"content": "#Fantastico! Mi hai superato, {F#guerriera}{M#guerriero}! Ma non adagiarti sugli allori, continua così e diventerai {F#una vera eroina}{M#un vero eroe}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502908,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
