	"talks": [
		{
			"id": 7220501,
			"completionStepIds": [
				7220501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220501",
							"2"
						],
						"stepId": 7220501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "Che strano! Avrei scommesso di averli in tasca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050102,
					"content": "Ehilà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "Oh no, dovevamo darli a nonna Una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050105,
					"content": "È diventata vecchia e non ricorda più molte cose. Ultimamente, ha iniziato a parlare di quello che le successe quand'era giovane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050106,
					"content": "Non fa che parlare di fiori di qua e fiori di là... Ha anche detto che erano fiori provenienti da oltre il Mare di nebbia, fiori diversi tra loro e molto belli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050107,
					"content": "Poi, un giorno, ho fatto un sogno. Ho sognato che la nebbia che avvolgeva l'isola all'improvviso scompariva. E lì, dall'altra parte dell'oceano, c'era una casa grande, alta e bellissima. Non era né di legno... né d'oro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050108,
					"content": "Anch'io ho fatto lo stesso sogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050109,
					"content": "In quel sogno, scalavo alte montagne e mi arrampicavo su enormi alberi, e raccoglievo tanti, tanti bei fiori. Non li avevo mai visti prima, ma sapevo che erano quelli che nonna Una stava cercando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050110,
					"content": "Ma i fiori erano troppo pesanti, così sono caduto dall'albero. Sono caduto, caduto e caduto... e poi mi sono svegliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050111,
					"content": "Ah! Così impari ad essere sempre così avido! Te l'avevo detto che ne avevamo già abbastanza, ma tu non mi hai voluto ascoltare! E alla fine sono caduta anch'io dall'albero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050112,
					"content": "Beh, ora le nostre tasche sono vuote... Non possiamo andare da nonna Una senza niente in mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050103,
					"content": "Avete bisogno di aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220512",
							"2"
						],
						"stepId": 7220512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050301,
					"content": "Ehi, ciao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050302,
						722050303
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050302,
					"content": "Ciao!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				},
				{
					"id": 722050304,
					"content": "Grazie per averci aiutati a trovare quei fiori! Tuttavia, penso che ci sia ancora qualcosa di sospetto qui intorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050305
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050305,
					"content": "Lo penso anch'io. Insomma, è piuttosto strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050306
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050306,
					"content": "Ogni volta che andiamo in un posto diverso, incontriamo sempre persone infelici... E nessuno riesce a sentire cosa dicono gli altri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050307
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050307,
					"content": "E ogni volta che troviamo un bel fiore e lo raccogliamo, sparisce in un baleno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050308,
						722050309
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050308,
					"content": "Beh, credo sia perché...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050310,
					"content": "Ah, sì? Non saprei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050311
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050311,
					"content": "Dobbiamo andarcene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050312
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050312,
					"content": "Anche l'uomo d'oro ha detto una cosa simile... Ma non possiamo ancora andare con lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050313
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050313,
					"content": "Dobbiamo ancora portare i fiori a nonna Una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050309,
					"content": "È arrivato il momento di andare, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050310
					]
				},
				{
					"id": 722050303,
					"content": "Siete due ragazzini piuttosto vivaci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050304
					]
				}
			]
		},
		{
			"id": 7220505,
			"completionStepIds": [
				7220513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220513",
							"2"
						],
						"stepId": 7220513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "Guarda chi si rivede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050502,
					"content": "Ciao di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050503,
					"content": "Ciao anche a voi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "Già, ancora qui! A proposito, sai a cosa serva questa grande roccia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050506,
					"content": "Eheh! Kito sa proprio tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050507,
					"content": "Non lo so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "Nonno Mata ha detto che è una pietra tombale che serve a guidare gli spiriti dei defunti. Gli spiriti perduti saranno attratti da queste grandi rocce, e poi si sveglieranno qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050510,
					"content": "Poi vagheranno per l'isola alla ricerca di qualcuno che possa esaudire i loro desideri. Una volta trovata la persona, le si aggrapperanno addosso finché i loro desideri non saranno esauditi, e potranno finalmente essere portati via dal battelliere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050511,
					"content": "Alcuni di questi spiriti sono gentili... altri invece no. Ed è per questo che coloro che di notte passano vicino a queste grandi pietre devono pronunciare a gran voce il loro nome e il loro clan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050512,
					"content": "Dopotutto, coloro che sanno chi sono i loro antenati ispirano molta più fiducia di qualche fantasma solitario. Dopo che avrai detto da dove vieni, se ne andranno via tranquillamente e non ti daranno più fastidio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050513,
					"content": "#Ehm... Il problema è che sei {F#una}{M#uno} stranier{F#a}{M#o}, vero? Quindi non appartieni a nessun clan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050514,
					"content": "Oh-oh, è vero. Cosa farai, se incontri uno spirito maligno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050515,
					"content": "Eheh, sai cosa? Andrà tutto bene, ti proteggerò io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050516,
					"content": "Sì! Proprio così! E ti aiuterò anche a scacciare gli spiriti maligni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050508,
					"content": "A cosa serve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "Ancora qui, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
		{
			"id": 7220507,
			"completionStepIds": [
				7220514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220514",
							"2"
						],
						"stepId": 7220514,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050701,
					"content": "Ehi, ci incontriamo di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050702
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050702,
					"content": "Oggi Kito non ha tanta voglia di parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050703,
						722050704
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050703,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				},
				{
					"id": 722050705,
					"content": "Non è nulla. Oggi giocherò da solo. Non preoccuparti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050706
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050706,
					"content": "Ma guarda un po', ha di nuovo messo il broncio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050707,
						722050708
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050707,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050709,
					"content": "#Dai, Kito, non è il caso di prendersela con {F#una}{M#uno} stranier{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050710
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050711
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050711,
					"content": "Scusa, non volevo prendermela con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050712,
						722050713
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050712,
					"content": "Non preoccuparti, va tutto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050714,
					"content": "L'uomo d'oro ci sta di nuovo assillando per salire sulla barca... Ha detto che andremo in un posto d'oro scintillante dove non c'è la nebbia! Io non voglio andarci! Voglio restare qui con nonna Una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050715
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050715,
					"content": "Lui non gioca mai con noi, e non dice mai niente d'interessante... Continua a dirci che dobbiamo andarcene! È terrificante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050716
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050716,
					"content": "Noi siamo perfettamente in grado di andarcene, ma abbiamo paura che nonna Una si preoccupi per noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050713,
					"content": "Ora vuoi raccontarmi cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050708,
					"content": "Posso essere utile in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050704,
					"content": "Non sembri molto felice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				}
			]
		},
