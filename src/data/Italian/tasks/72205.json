					"nextDialogs": [
						722050905
					]
				},
				{
					"id": 722050905,
					"content": "Grazie, ma questa volta non ci serve nulla. Stiamo per andarcene... Andremo nella terra senza nebbia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050906
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050906,
					"content": "Andremo a vedere la grande casa dorata e luccicante, e per arrivarci andremo in barca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050907
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050907,
					"content": "Ma prima, vogliamo ringraziarti... Ah, potresti dare una cosa alla nonna da parte nostra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050908
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050908,
					"content": "Nel momento in cui gliela darai, smetterà di preoccuparsi e verrà con noi!",
