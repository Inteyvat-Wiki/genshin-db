					{
						"sceneId": 1161,
						"position": [
							177.135,
							4.824,
							75.375
						],
						"pointId": 68
					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Fantastico... Direi che abbiamo recuperato quasi tutti i rottami più importanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160102,
					"content": "Mi dispiace che abbiate dovuto faticare così tanto, voi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160103,
					"content": "Non devi mica scusarti, Freminet! Per come la vede Paimon, non abbiamo \"lavorato\": abbiamo pescato un sacco di cose belle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160104,
					"content": "Abbiamo contribuito a ripristinare l'ambiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Grazie... È stata un'attività felice e appagante, e lo devo a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160107,
					"content": "Di niente! È stato un lavoro di squadra! E poi, Paimon pensa che tu abbia fatto grandi progressi: sei stato di grande aiuto sia sott'acqua che sulla terraferma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160108,
					"content": "Non c'è bisogno di arrossire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "Ah, beh... D'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160111,
					"content": "Scusate, a parte \"grazie\", non so davvero cos'altro dire in momenti del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160112,
					"content": "Forse... Forse ho bisogno di fare un po' più di pratica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160113,
					"content": "Fai con calma, non c'è nessuna fretta. Continua a impegnarti al tuo ritmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160114,
					"content": "Se ci sarà l'occasione, in futuro collaboreremo di nuovo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "Va bene, affare fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160117,
					"content": "...Ora che le pulizie sono finite, volevo tornare sott'acqua e passare un po' di tempo per conto mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160118,
					"content": "Ma stranamente, dopo aver parlato con voi... persino il cielo sembra essersi calmato. Volevo solo condividere questa sensazione con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160119,
					"content": "In ogni caso... farei meglio a tornare da Lyney e gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160120,
					"content": "Vi lascio il resto dei dati del rilevamento sottomarino. Spero che troverete quello che cercate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160121,
					"content": "Ehi, vi sentivo festeggiare da sopra. È successo qualcosa di bello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160122,
					"content": "Sì! Abbiamo fatto piazza pulita di tutta quella spazzatura che disturbava i pesciolini. E abbiamo anche trovato i pezzi mancanti del pianoforte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160123,
					"content": "Davvero? Fate vedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160124,
					"content": "Beh, direi che ci siamo... Con questi componenti, potrò finalmente riparare il pianoforte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160125,
					"content": "Potrebbe non tornare esattamente come prima, ma dovrebbe poter suonare di nuovo la sua musica stupenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160126,
					"content": "Eheh, sembri molto felice, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160127,
					"content": "A-Ah, sì? Vabbè. Vado, lo riparo e torno, non dovrebbe volermici molto. Intanto, posso chiedervi di dare una sistemata a questo posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160128,
					"content": "Uno strumento così bello merita un palcoscenico adeguato per valorizzarlo al meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160129,
					"content": "Ahhh, sembra proprio contenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160130,
					"content": "Woah! Che bel pianoforte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160131,
					"content": "È molto elegante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "Umpf, mi pare logico: l'ho riparato io, dopotutto! Ho anche rinforzato i collegamenti meccanici e ritoccato la scocca esterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160134,
					"content": "#Anche voi due siete {F#state}{M#stati} niente male: questo palco è decisamente degno di questo pianoforte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160135,
					"content": "Hihi, una sciocchezza! Comunque, basta chiacchiere. Non vuoi suonarci qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160136,
					"content": "...Eh? Adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160137,
					"content": "E quando, sennò? Perché aggiustare il pianoforte se poi non lo suoni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160138,
					"content": "Che ne dite di... rimandare l'esibizione a un altro giorno? Avrò tutto il tempo di suonare per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160139,
					"content": "Hai dimenticato lo spartito?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "Umpf... Che stupidaggine! H-Ho solo voglia di starmene seduta in silenzio per un po' a ricordare i vecchi tempi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160142,
					"content": "E non pensiate che le vostre insulse provocazioni basteranno a convincermi. Umpf, bisogna allenarsi, prima di esibirsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747160140,
					"content": "Sei timida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "Davvero magnifico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "Se hai bisogno d'aiuto, puoi sempre contare su di noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "E abbiamo trovato un sacco di tesori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}