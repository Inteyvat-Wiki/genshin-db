				"objectNames": [
					"Hiiragi Chisato"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070501,
					"content": "#Viaggiat{F#rice}{M#ore}, sei tornat{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070502
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070502,
					"content": "#Immagino tu abbia consegnato la mia lettera a Kamaji. Sei... riuscit{F#a}{M#o} a ottenere anche il permesso di viaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070503,
						728070505
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070503,
					"content": "Sì. Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070504
					]
				},
				{
					"id": 728070504,
					"content": "Non devi ringraziare me. Dovresti ringraziare Kamaji, piuttosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070506
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070506,
					"content": "Eh? Che cos'è? Dei dolcetti e... una lettera scritta da Kamaji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070507
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070507,
					"content": "Era questa la sua richiesta? Questi dango tricolori... Li ha preparati per me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070508
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070508,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Mi gusterò questi dolcetti. E... sarò molto felice di leggere questa lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070509
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070509,
					"content": "Grazie per tutto quello che hai fatto. Ecco, accetta questi oggetti in segno di ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070510
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070510,
					"content": "Chissà... Magari in futuro avrò di nuovo bisogno di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070505,
					"content": "Questo è da parte di Kamaji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070506
					]
				}
			]
		},
		{
			"id": 7280706,
