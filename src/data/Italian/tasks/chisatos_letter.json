				},
				{
					"id": 728070202,
					"content": "Riguardo a Kamaji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "Stai parlando del maestro Kamaji? Cosa vuoi da lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070204,
					"content": "(Mostra la lettera di Chisato)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "Hai detto che questa lettera è stata scritta dalla signorina Hiiragi Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070206,
					"content": "Se questa lettera è stata scritta davvero da Hiiragi Chisato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070207,
					"content": "Penso che... dovresti parlare direttamente con il maestro Kamaji. Ultimamente fa delle passeggiate vicino al ponte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sanada"
				}
			]
		},
		{
			"id": 7280703,
			"completionStepIds": [
				7280703
			],
