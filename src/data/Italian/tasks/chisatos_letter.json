			"dialogs": [
				{
					"id": 728070401,
					"content": "Ti do il benvenuto al Ristorante Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070402
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070402,
					"content": "Riguardo ai dolcetti per Kamaji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070403
					]
				},
				{
					"id": 728070403,
					"content": "Oh, ho già preparato i dolcetti che il maestro Kamaji ha ordinato. Te li porto subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070404
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070404,
					"content": "Mi chiedo però a chi abbia intenzione di darli il maestro Kamaji...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070405
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070405,
					"content": "Non è che un gesto di pubbliche relazioni, signorina Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070406
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070406,
					"content": "Un po' di tempo fa, il signor Hiiragi Shinsuke offrì a mio padre dell'ottimo tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070407
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070407,
					"content": "Mio padre sa che l'amata figlia del signor Hiiragi, Chisato, adora i dolcetti, pertanto mi ha chiesto di farne preparare alcuni come segno di ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070408
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070408,
					"content": "#Temevo ci sarebbe voluto troppo tempo per la consegna e che potessero esserci degli imprevisti inevitabili durante il viaggio... Perciò, ho chiesto espressamente a quest{F#a}{M#o} viaggiat{F#rice}{M#ore} di consegnarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070409
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070409,
					"content": "Signorina Kiminami, posso dare un'occhiata ai dolcetti? Voglio essere sicuro di non essermi dimenticato nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070410
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070410,
					"content": "Mmmh... Certo, eccoli qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070411
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 728070411,
					"content": "Ci sono tutti. Grazie, signorina Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070412
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070412,
					"content": "#Vieni con me, viaggiat{F#rice}{M#ore}. Devo dirti un paio di altre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070413
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070413,
					"content": "Questo è il permesso di viaggio. Ecco, tieni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070414
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070414,
					"content": "Con questo, potrai entrare e uscire da Ritou liberamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070415
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070415,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070416
					]
				},
				{
					"id": 728070416,
					"content": "Di nulla. Questo permesso faciliterà di molto la tua consegna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070417
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070417,
					"content": "Ah... Ecco la lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070418
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070418,
					"content": "Hai scritto tu stesso questa lettera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070419
					]
				},
				{
					"id": 728070419,
					"content": "Sì. Ho provato a scriverla con... tatto. Spero che la signorina Hiiragi non la trovi offensiva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070420
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070420,
					"content": "Per favore, consegnala alla signorina Hiiragi insieme ai dolcetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070421
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070421,
					"content": "Devo tornare di nuovo indietro...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070422
					]
				},
				{
					"id": 728070422,
					"content": "Eheh, ma questa volta avrai il permesso di viaggio. Dovrebbe essere molto più facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070423
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070423,
					"content": "#Affido tutto a te, viaggiat{F#rice}{M#ore}. Devo tornare a occuparmi di questioni ufficiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070424
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070424,
					"content": "Uff, riuscirò mai ad andarci di persona...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				}
			]
		},
