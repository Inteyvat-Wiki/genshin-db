				"objectNames": [
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "#Sei... Ah, sei {F#quella}{M#quel} viaggiat{F#rice}{M#ore} stranier{M#o}{F#a}. Cosa posso fare per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070302,
					"content": "Riguardo alla lettera di Hiiragi Chisato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "Questa lettera... La signorina Hiiragi ti ha davvero chiesto di consegnarla a me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070304,
					"content": "La grafia... È davvero lei... Grazie al cielo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070305,
					"content": "#Grazie per aver fatto tutta questa strada, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070306,
					"content": "Quanto al permesso di viaggio... Visto che è una richiesta personale della signorina Hiiragi, naturalmente la porterò a termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070307,
					"content": "Ma mi servirà un po' di tempo per prepararlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070308,
					"content": "Che ne dici di aspettarmi al Ristorante Kiminami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070309,
					"content": "Perché vuoi andare lì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Beh... Ho bisogno di un favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070311,
					"content": "Recentemente... anch'io ho pensato di inviare qualcosa alla signorina Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070312,
					"content": "Ho scritto una lettera e ho anche chiesto alla signorina Kiminami di prepararmi dei dolcetti. Avevo intenzione di inviarli alla signorina Hiiragi come regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070313,
					"content": "#Ma se mio padre venisse a sapere dei miei piani, potrebbe agitarsi... Sei arrivat{F#a}{M#o} proprio mentre stavo riflettendo sul da farsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070314,
					"content": "È solo un regalo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Mio padre non vuole che parli con la signorina Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070316,
					"content": "Capisco le sue preoccupazioni. Dopotutto, sono un membro del clan Kujou e uno dei responsabili del rispetto delle leggi della Commissione Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070317,
					"content": "La signorina Hiiragi appartiene al clan Hiiragi, della Commissione Kanjou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070318,
					"content": "Se mi avvicinassi troppo a lei, qualcuno tenterebbe inevitabilmente di trarre vantaggio dalla situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070319,
					"content": "Sebbene sia solo un regalo, agli occhi di alcuni è molto di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070326,
					"content": "Eheh, lasciamo perdere queste quisquilie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070327,
					"content": "#Viaggiat{F#rice}{M#ore}, aspettami al Ristorante Kiminami. Una volta che avrò approvato il permesso di viaggio, te lo porterò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070320,
					"content": "Tuo padre è molto severo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Mio padre... È naturale che sia severo. Capisco perché non voglia che io comunichi con la signorina Hiiragi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070322,
					"content": "Dopotutto, sono un membro del clan Kujou e uno dei responsabili del rispetto delle leggi della Commissione Tenryou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
