			},
			"dialogs": [
				{
					"id": 721780401,
					"content": "Dovrebbe essere questo il santuario di cui parlava Chouji, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780402,
					"content": "(Sembra un normale santuario... Non ci sono segni di tracce elementali.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780403,
					"content": "Esamina",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(Il santuario è semplice ma elegante. Il suo legno risplende lievemente, salutando gli ospiti e le loro offerte con un solenne silenzio.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780405,
					"content": "(Molti petali del Sakura sacro giacciono sparsi intorno al santuario, anche se non si tratta di uno scenario naturale. Sembra piuttosto che qualcuno li abbia sparsi intenzionalmente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780406,
					"content": "Mmmh... Anche qui non ci sono tracce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780407,
						721780408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780407,
					"content": "Guarda, fiori di sakura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "Ah, giusto. Chouji ha detto che sua madre presentava delle offerte al santuario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780410,
					"content": "Anche qui ci sono diversi petali... Non può essere una coincidenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780411,
					"content": "Torniamo indietro a dirglielo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780408,
					"content": "È l'offerta della madre di Chouji...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				}
			]
		},
