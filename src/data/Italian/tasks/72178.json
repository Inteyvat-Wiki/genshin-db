			"dialogs": [
				{
					"id": 721780101,
					"content": "(Sembra un normale santuario... Non ci sono segni di tracce elementali.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780102,
					"content": "Esamina",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(Questo santuario sembra essere in buone condizioni, e sembra essere stato tenuto con cura di recente. Chi se n'è occupato dev'essere sicuramente una persona attenta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780104,
					"content": "(A parte questo, non ci sono tracce che qualcuno sia stato qui.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780105,
					"content": "Che strano... Sembra che qualcuno sia già stato qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217802,
			"completionStepIds": [
				7217803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
