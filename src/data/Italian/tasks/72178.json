				"points": []
			},
			"dialogs": [
				{
					"id": 721780201,
					"content": "Laggiù c'è un altro santuario. Diamo un'occhiata, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780202,
					"content": "(Sembra un normale santuario... Non ci sono segni di tracce elementali.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780203,
					"content": "Esamina",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(Questo santuario è pulito e ordinato, ed emana la delicata fragranza del Sakura sacro. Qualcuno vi ha pregato di recente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780205,
					"content": "(A parte questo, non ci sono tracce più recenti.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780206,
					"content": "Questo profumo è... quello del Sakura sacro! La mamma di Chouji potrebbe essere passata di qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780207,
					"content": "Abbastanza di recente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217803,
