				},
				{
					"id": 721780502,
					"content": "(Sembra un normale santuario... Non ci sono segni di tracce elementali.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780503
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780503,
					"content": "Esamina",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780504
					]
				},
				{
					"id": 721780504,
					"content": "(Questo santuario sembra piuttosto fatiscente. La facciata di legno è sbiadita e rovinata, rivelando tracce sottostanti di inquietanti linee rosso scuro.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780505
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780505,
					"content": "Questo santuario è super inquietante... A Paimon sta venendo la pelle d'oca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780506,
					"content": "Andiamocene da qui!",
					"roleType": "TALK_ROLE_NPC",
