			},
			"dialogs": [
				{
					"id": 721780301,
					"content": "Questo santuario sembra molto nuovo! Diamo un'occhiata più da vicino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780302,
					"content": "(Sembra un normale santuario... Non ci sono segni di tracce elementali.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780303
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780303,
					"content": "Esamina",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780304
					]
				},
				{
					"id": 721780304,
					"content": "(Il legno di questo santuario è un po' vecchio, ma un'abile opera di manutenzione lo ha fatto sembrare più suggestivo e meno fatiscente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780305
					],
					"speakerTitle": "Santuario"
				},
				{
					"id": 721780305,
					"content": "Sembra che qualcuno venga spesso a prendersi cura di questo santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217804,
			"completionStepIds": [
				7217805
