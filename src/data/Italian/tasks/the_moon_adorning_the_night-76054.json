				]
			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "Oh, dov'è Colombina? Paimon non la vede da nessuna parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "Da questa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540103,
					"content": "Wow! Che ci fai lassù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "Unitevi a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540105,
					"content": "Che cosa finiremo a fare questa volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "Vi ricordate le pietre che abbiamo raccolto l'altra volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540107,
					"content": "L'ultima volta? Ah, dici i minerali che brillano dopo aver assorbito il Kuuvahki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "Esatto. Beh, dopo, le Kuuhenki ne hanno raccolte altre e io le ho divise in due tipi: quelle più scure e quelle più chiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540109,
					"content": "Quelle più scure e quelle più chiare? Ma perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "Per giocare a Scacchi lunari, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540111,
					"content": "Ehm... Che cos'è \"Scacchi lunari\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "Oh, non ci avete mai giocato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540113,
					"content": "...No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "Capisco... Volevo giocarci da quando ho visto le griglie disegnate per terra degli Eredi della Luna gelata. Ma non ho mai avuto nessuno con cui giocare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540115,
					"content": "Beh, quali sono le regole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "Mmmh... Faccio prima a mostrarvele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540117,
					"content": "Wow! È incredibile! Come hai fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "Mmmh? Con un po' di Kuuvahki, ovviamente... Voi non siete capaci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540119,
					"content": "#Ahahah... Forse dovresti abbassare le aspettative. Non siamo {F#tutte}{M#tutti} divinità della luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "Va bene. Questo è il tabellone, rappresenta il \"cielo notturno\". E i pezzi che ogni giocatore controlla rappresentano le \"lune\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540121,
					"content": "I due giocatori si alternano nel posizionare le lune nel cielo, e chi mette tre lune di fila per primo vince.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540122,
					"content": "Ah! Quindi è una versione di Tris...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "Quindi a Nod-Krai lo chiamano \"Scacchi lunari\"... Che dire, gli hanno dato un tocco locale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "Capisco. Beh, in questa versione, le lune ruotano, e ciò significa che non ci possono mai essere più di tre lune nel cielo contemporaneamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540125,
					"content": "Quindi, quando il cielo notturno è pieno, la luna che è sorta per prima svanisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540126,
					"content": "Ah... Ha senso, e poi rende il gioco molto più difficile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "Allora? Vogliamo fare un tentativo? Sarà la prima volta che gioco anche io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760540128,
					"content": "(Sembra che non veda l'ora...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "#Hihi, sembra divertente! Paimon farà da arbitro! Qui, però, l'intelligente è {NICKNAME}, quindi fai attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
