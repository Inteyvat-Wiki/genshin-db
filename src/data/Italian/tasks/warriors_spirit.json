			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880301,
					"content": "#Ehi, guarda, la signorina Kamisato e {F#la}{M#il} viaggiat{F#rice}{M#ore} sono arrivat{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "Yuu"
				},
				{
					"id": 736880302,
					"content": "Anche se ho già visto disegni di questo completo prima di adesso, vederlo indossato dalla signorina Kamisato sembra ancora più particolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "Sae"
				},
				{
					"id": 736880303,
					"content": "È valsa la pena mettersi in fila di prima mattina per ottenere posti in prima fila. Non vedo l'ora di assistere alla battaglia di oggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "Matsumae"
				},
				{
					"id": 736880304,
					"content": "Wow, non appena è arrivata, Ayaka ha catturato l'attenzione di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880305,
					"content": "Signore e signori, attenzione: la battaglia di esibizione Spirito del guerriero sta per cominciare. Siete pregati di entrare nell'arena con ordine e di prendere posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880306,
					"content": "#Signorina Kamisato, viaggiat{F#rice}{M#ore}, venite con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880307,
					"content": "#Sei pront{F#a}{M#o}, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880308,
					"content": "#Pront{F#a}{M#o}. Andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "Bene, mettiamocela tutta. Non vedo l'ora di combattere insieme a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880310,
					"content": "Ho ancora bisogno di tempo per prepararmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "#Oh, non preoccuparti, c'è ancora tempo. Non appena ti sarai occupat{F#a}{M#o} di tutto, possiamo entrare nell'arena insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "#Viaggiat{F#rice}{M#ore}, Ayaka, siamo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880402,
					"content": "È stata una battaglia straordinaria. Persino io che non ne capisco molto di scherma mi sono fatta prendere dal clima di tensione nell'arena. Il mio cuore continua a martellare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880403,
					"content": "Ogni mossa del vostro avversario prendeva Paimon di sorpresa, ma invece sembrava che voi ve le aspettavate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880404,
					"content": "#Viaggiat{F#rice}{M#ore}, signorina Kamisato, congratulazioni per aver vinto la battaglia di esibizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880405,
					"content": "Ehi, c'è Sara. Sei venuta anche tu ad assistere alla competizione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880406,
					"content": "Mi è stato ordinato dalla Shogun onnipotente. Voi due avete dimostrato notevole destrezza con la spada e cooperazione. Non solo avete fatto conoscere la bellezza delle arti della spada al pubblico, avete insegnato qualcosina anche a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880407,
					"content": "Sono lusingata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880408,
					"content": "Siete stati tutti molto presi con i preparativi per la competizione, e oggi l'evento Spirito del guerriero si è concluso in bellezza. La Shogun onnipotente elogia i vostri sforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880409,
					"content": "Ora, se vogliate scusarmi, devo fare ritorno al Tenshukaku e fare rapporto sulla battaglia di esibizione alla Shogun onnipotente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880411,
					"content": "A proposito, se non avete programmi potremmo andare a festeggiare al Ristorante Uyuu. Che ne dite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880412,
					"content": "#Idea fantastica! Ultimamente eravamo così pres{F#e}{M#i} dalla competizione che non abbiamo avuto tempo per un pasto come si deve! Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880413,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880414,
					"content": "Che succede, Ayaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "Oh, niente di che. Solo ora sto cominciando a prendere coscienza della vittoria. Kujou Sara ha detto di aver imparato molto dalla battaglia, e per me è lo stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880416,
					"content": "Probabilmente il pubblico non l'avrà notato, ma ci sono stati dei momenti in cui sarei stata in serio pericolo se non avessi avuto te al mio fianco, che allontanavi gli attacchi dell'avversario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880417,
					"content": "Per me sarebbe stato impossibile vincere senza il tuo aiuto. Proprio come mi aspettavo, la mia abilità con la spada non è ancora lontanamente paragonabile alla tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880418,
					"content": "#Ayaka, anche tu mi hai aiutat{F#a}{M#o} diverse volte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "Dici sul serio? Sentirtelo dire mi ha fatto venire improvvisamente voglia di allenarmi con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880421,
					"content": "#A dirti la verità, ho sperato di poterlo fare sin da quando ci siamo conosciut{F#e}{M#i}. Oggi, con la battaglia di esibizione quel desiderio si è avverato a metà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880422,
					"content": "La prossima volta troveremo del tempo per allenarci insieme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "Certo, ma... Fino ad allora, prenditi buona cura della tua spada. Semmai dovessi rubartela un giorno, anche la tua vita sarà nelle mie mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880424,
					"content": "Eheh... Ho sempre voluto dire qualcosa del genere. Ti è sembrato strano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880425,
					"content": "Sembrava una battuta della signorina Orith.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "Ehi, che succede qui? Di cosa state parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880428,
					"content": "#Stavamo solo discutendo dell'idea di tenere una battaglia per decretare chi di noi sia {F#la}{M#lo} spadaccin{F#a}{M#o} migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880429,
					"content": "#Wow, prendi la scherma molto seriamente. Ma tu e {F#la}{M#il} viaggiat{F#rice}{M#ore} non siete amic{F#he}{M#i}? Perché dovete combattere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880430,
					"content": "#È proprio perché siamo amic{F#he}{M#i} che dovremmo allenarci spesso insieme per imparare l'un{F#a}{M#o} dall'altra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880431,
					"content": "Oh, non fa una piega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880432,
					"content": "#Viaggiat{F#rice}{M#ore}, a proposito della nostra conversazione, manterrai il segreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880433,
					"content": "Eh? Che cos'ha detto Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880434,
					"content": "Niente, diamoci una mossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880426,
					"content": "Molto carina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "Sei troppo modesta, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
