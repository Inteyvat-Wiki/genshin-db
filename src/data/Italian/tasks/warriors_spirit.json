				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "Le tue abilità sono superlative. È stata una vittoria schiacciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Akatsuki Saemon Juuzou"
				},
				{
					"id": 736880102,
					"content": "È stato un onore combattere contro di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "#Signore e signori, dopo una battaglia esaltante, è stato decretato il campione dell'Esibizione di scherma Spirito del guerriero! Facciamo un bell'applauso a... {F#la}{M#il} viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880104,
					"content": "#Domani si terrà la battaglia di esibizione finale tra {F#la}{M#il} viaggiat{F#rice}{M#ore} insieme alla signorina Kamisato contro l'emissario scelto dalla Shogun onnipotente, un umanoide autonomo conosciuto come \"Maguu Kengou\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880105,
					"content": "Non potete mancare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880106,
					"content": "#Questa sì che è stata una battaglia avvincente, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880107,
					"content": "#Congratulazioni, viaggiat{F#rice}{M#ore}. Ti sei davvero meritat{F#a}{M#o} il titolo di {F#campionessa}{M#campione}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880108,
					"content": "Paimon non sapeva che l'avversario di domani sarebbe stato il Maguu Kengou... Il suo nome mi ricorda quel tipo problematico che abbiamo incontrato sull'Isola di Yashiori. Oh, Paimon non crede che sarà una battaglia facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880109,
					"content": "Non preoccuparti, Paimon. Anche se l'emissario scelto dalla Shogun ha una forza portentosa, nulla ci vieta di usare le Visioni nella battaglia di domani. Siamo una squadra formidabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880110,
					"content": "Finché riusciamo a seguire le sue mosse, ci sarà sempre modo di contrattaccare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880111,
					"content": "Oh, a sentirti così sicura di te Paimon si sente decisamente meglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880112,
					"content": "Non garantisco che vinceremo, ma dobbiamo fare del nostro meglio. Anche solo per dare al pubblico uno spettacolo che non dimenticheranno mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880113,
					"content": "Possiamo vincere, Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "Vedo che siete già sul piede di guerra, ma fareste meglio a risparmiare le forze e a riposarvi stanotte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880116,
					"content": "Domani vedremo anche il nuovo completo di Ayaka. Ayaka in un costume di Fontaine... Oh, Paimon non sta più nella pelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880117,
					"content": "Ah, già. Beh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880118,
					"content": "Anch'io non vedo l'ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "#Eh, viaggiat{F#rice}{M#ore}... Anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880121,
					"content": "Eheh, ormai non puoi più tirarti indietro, signorina Ayaka. Se non fossi impegnata domani, verrei anch'io con piacere a vedervi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880122,
					"content": "Bene, allora è deciso. Domattina vi aspetterò presso la Residenza dei Kamisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880120,
					"content": "Vuoi che domani mattina ti venga a prendere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "Di certo sarà una battaglia emozionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368803",
							"2"
						],
						"stepId": 7368803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirotatsu",
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "Ah! Siete qui, finalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880202,
					"content": "Ugh, c'è Hirotatsu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880203,
					"content": "#Non è passato molto da quando {F#la}{M#il} viaggiat{F#rice}{M#ore} ti ha già battuto ottenendo il titolo di {F#campionessa}{M#campione}. Cos'altro vuoi, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880204,
					"content": "#Calma, non sono qui per darvi problemi. Volevo solo scusarmi. Viaggiat{F#rice}{M#ore}, la tua è stata una vittoria onesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880205,
					"content": "#La tua destrezza con la spada è eccezionale. Colpi decisi, ma non aggressivi. Questo la dice lunga sulla tua personalità. Ti chiedo perdono per averti mal giudicat{F#a}{M#o} e offes{F#a}{M#o} con le mie parole e azioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880206,
					"content": "Non fa niente, non mi ha dato fastidio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "Immagino che voi due siate qui per la signorina Kamisato. Al momento si sta cambiando, sarà subito da voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880209,
					"content": "#Viaggiat{F#rice}{M#ore}, prima che arrivi la signorina, al costo di sembrare sfacciato, c'è qualcosa che vorrei chiederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880210,
					"content": "Certo, di cosa si tratta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "La signorina non ha mai parlato con noi servitori riguardo alla battaglia di esibizione di oggi, ma nonostante i mille impegni, ogni sera si è ritagliata un po' di tempo per esercitarsi con la spada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880212,
					"content": "La signorina è sempre stata diligente e coscienziosa. Anche se è solo una battaglia di esibizione e non importa chi vince o chi perde, sono sicuro che farà di tutto per vincere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880213,
					"content": "In quanto suo servitore, ovviamente credo in lei, ma... Spero comunque che tu possa assisterla nell'arena e assicurarti che non si faccia del male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880214,
					"content": "Non preoccuparti, lo farò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "#Viaggiat{F#rice}{M#ore}, lascerò la signorina nelle tue mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880217,
					"content": "Oh, sarà Ayaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880218,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880219,
					"content": "Eh? Che succede? Perché non parlate...? C'è qualcosa che non va con il completo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880220,
					"content": "Affatto! Ayaka, sei bellissima... Irradi bellezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880221,
					"content": "Questo completo ti sta a pennello.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "Sì, sì, sembri una ragazza grintosa appena scesa da una nave proveniente da Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880223,
					"content": "Lo pensi davvero? Temevo che fosse un tantino sopra le righe... Non ero sicura che mi si addicesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880224,
					"content": "Ma le vostre parole mi confortano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880229,
					"content": "Paimon non vede l'ora di vedere che faccia faranno tutti quando vedranno Ayaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880230,
					"content": "#Grazie per i complimenti, Paimon. Viaggiat{F#rice}{M#ore}, è tutto pronto, possiamo andare all'arena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880231,
					"content": "#Signorina, viaggiat{F#rice}{M#ore}, vi auguro buona fortuna nella battaglia di esibizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880225,
					"content": "È un bellissimo completo e ti sta alla perfezione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "Guardalo! C'è persino ricamato lo stemma del clan Kamisato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880227,
					"content": "Sì, Onodera l'ha fatto realizzare da qualcuno della famiglia durante gli ultimi giorni. Ho sentito che sono stati gli stessi spettatori a consigliarlo, scrivendolo sulle schede delle votazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880228,
					"content": "Il completo è ben fatto e mi lascia anche più libertà di movimento di quanto mi aspettassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880207,
					"content": "È stata una bella battaglia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
