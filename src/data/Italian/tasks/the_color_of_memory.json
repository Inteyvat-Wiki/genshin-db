			"dialogs": [
				{
					"id": 150290401,
					"content": "Ah, ce l'hai fatta? La tua indagine sulla Battaglia dei sette colori dev'essere stata davvero fruttuosa. Spero che condividerai ciò che hai scoperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290402
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290402,
					"content": "Wow, hai già finito di tessere il rotolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290403
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150290403,
					"content": "La saggezza dell'Anziano Tlapo non sbaglia mai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290404
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150290404,
					"content": "#Sì, abbiamo molto da spiegarvi... Inizia tu, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290405,
					"content": "Racconti tutto quello che hai scoperto sul colore speciale tenendo però segreto il contributo di Citlali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290406
					]
				},
				{
					"id": 150290406,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290407
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290407,
					"content": "Non sembri per niente sorpreso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290408,
					"content": "Ha perfettamente senso! La storia è la memoria di un popolo. Per raffigurarla, una tinta derivante dai ricordi delle persone è ovviamente la scelta migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290409
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290409,
					"content": "Ora è solo questione di preservare questa tecnica segreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290410
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290410,
					"content": "Mmmh... Dalla tua descrizione, sembra che per imparare la tecnica bisogna che il proprietario precedente condivida i propri ricordi, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290411
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290411,
					"content": "Ehm, sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290412,
					"content": "In tal caso, dovrò lavorare con i nostri sacerdoti per ricreare la tecnica in base ai principi descritti da voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290413
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290413,
					"content": "#Dopotutto, i ricordi sono un tesoro da condividere solo con le persone a noi più vicine. Non posso toglierti questa scelta, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290414
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290414,
					"content": "Hai portato a termine il tuo compito in modo ammirevole. D'ora in poi sarà nostro dovere trovare un modo per portare avanti questo lascito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290415
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290415,
					"content": "Ok! Lasciamo questa parte a voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290416,
					"content": "Oh, e per favore, portate i miei ringraziamenti a Nonna Itztli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290417
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290417,
					"content": "Abbiamo interrogato il mercante di Fontaine che ha catturato, e a quanto pare è il motivo per cui alcuni della nostra tribù hanno iniziato a mettere in dubbio la nostra storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290418
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290418,
					"content": "Ha assunto delle persone per diffondere delle informazioni false sulla Battaglia dei sette colori. Il recente conflitto all'interno della tribù è tutta opera sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290419
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290419,
					"content": "Abbiamo stilato un rapporto dei suoi reati e tra qualche giorno inizieremo a collaborare con le autorità di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290420
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290420,
					"content": "Quindi c'è sempre stato lui dietro alle controversie! Paimon immagina che sia più facile indagare quando le persone stanno già mettendo in dubbio qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290421,
					"content": "Comunque, ora è tutto chiaro! La gente non mette in dubbio la propria storia così senza motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290422,
					"content": "Grazie, Biram. Noi andiamo, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290423
					]
				},
				{
					"id": 150290423,
					"content": "Alla prossima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
