			"dialogs": [
				{
					"id": 150290501,
					"content": "Gli avete detto tutto, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290502
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290502,
					"content": "Sì! Abbiamo omesso la parte sul tuo contributo, ma sembra che il capotribù Biram l'abbia capito lo stesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290503,
					"content": "Avreste potuto semplicemente dirgli che era un \"dono degli spiriti\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290504
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290504,
					"content": "Sì, ma Biram si meritava qualcosa in cambio del suo duro lavoro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290505
					]
				},
				{
					"id": 150290505,
					"content": "...Immagino che sia diverso dai capitribù precedenti. Ma se scoprisse che sono stata io per tutti questi anni, sarei in un mare di guai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290506,
					"content": "Eccovi qua, vi ho cercato dappertutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290507
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290507,
					"content": "Oh, è l'altro ricercatore di Fontaine... Non è stato portato via con il suo capo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290508,
					"content": "Per favore, chiamatemi Allier... A seguito dell'interrogatorio, la tribù mi ha assolto da ogni crimine grave, quindi sono libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290509
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290509,
					"content": "Presto tornerò a Fontaine: dopotutto, nessun datore di lavoro significa nessuna remunerazione. Ma prima volevo concludere la mia ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290510
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290510,
					"content": "Vorrei fare delle domande su Huitzilin. Vorrei che la sua storia venisse raccontata a tutti coloro che abitano al di fuori di Natlan, ma ho ancora dei buchi narrativi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290511
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290511,
					"content": "Domande? Umpf... Perché dovrei lasciare che uno straniero racconti le nostre storie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290512,
					"content": "Non mi fraintenda: non ho intenzione di distorcere la storia o di usarla per guadagnarci dei soldi. È solo per pura curiosità, lo giuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290513
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290513,
					"content": "Credo che le storie straordinarie meritino di essere raccontate al mondo intero. Attraverso il dialogo e lo scambio, la cultura prospera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290514
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290514,
					"content": "Non ha tutti i torti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290515
					]
				},
				{
					"id": 150290515,
					"content": "Va bene, chiedi pure, ma sbrigati. Ho degli impegni importanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290516
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290516,
					"content": "Impegni importanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290517,
					"content": "Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290518
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290518,
					"content": "Allier conduce un'intervista approfondita, e se ne va solo quando Citlali esaurisce la pazienza.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290519
					]
				},
				{
					"id": 150290519,
					"content": "Un altro giorno, un'altra batteria sociale scarica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290520
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290520,
					"content": "Forse dovremmo andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290521
					]
				},
				{
					"id": 150290521,
					"content": "Mmh... Ah, aspetta... Tu mi devi due libri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290522
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290522,
					"content": "Oh, giusto... Quando si tratta di light novel, hai una memoria di ferro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290523,
					"content": "Ci vuole un po' per trovare dei libri così rari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290524
					]
				},
				{
					"id": 150290524,
					"content": "Dillo a me... Sì, non sarà facile. Forse dovrai andare alla Casa editrice Yae di persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290525
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290525,
					"content": "#{F#Tranquilla}{M#Tranquillo}, non mi servono subito. Ma non dimenticartene, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290526
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290526,
					"content": "Ma certo! Te li invieremo il prima possibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290527,
					"content": "Inviarmeli...? No, no, non voglio che uno sconosciuto bussi alla mia porta mentre ho i postumi di una sbornia. Ecco, prendete questa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290528
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290528,
					"content": "Che sarebbe...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290529,
					"content": "La chiave di casa mia. Così la prossima volta non dovrete bussare e non mi disturberete mentre dormo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
