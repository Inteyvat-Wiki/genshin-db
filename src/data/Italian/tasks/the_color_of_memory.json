			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Citlali"
				],
				"points": [
					{
						"sceneId": 1201,
						"position": [
							-7.54,
							0.032,
							2.908
						],
						"pointId": 2
					},
					{
						"sceneId": 1201,
						"position": [
							-9.541,
							0.032,
							11.813
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 150290101,
					"content": "Quando si tratta di tessere il rotolo in sé, non c'è bisogno di alzare un dito. Ma, se vogliamo trasmettere la tecnica di Huitzilin, la tua partecipazione è essenziale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290102,
					"content": "Cosa? In che senso, Citlali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290103,
					"content": "Seguitemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290104,
					"content": "Wow, guarda questo posto... Anche tu tessi i rotoli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290105,
					"content": "Rotoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290106,
					"content": "Rotoli? Pensavo volessi mostrarmi il tuo capolavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290107,
					"content": "Sì, amica mia. La tecnica che sto per mostrarti riguarda proprio i rotoli di tessuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290108,
					"content": "*sospira* E va bene, cos'è? Qualcosa che possa cambiare le sorti della guerra o prevenire un grande disastro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290109,
					"content": "Vuoi sfidarmi, non è vero? So che non hai le forze per un vero combattimento, quindi lascerò che tu mi batta almeno a parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290110,
					"content": "*tossisce* Vecchia amica, la mia vita sta per finire. Temo... di non avere tempo per un'altra sfida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290111,
					"content": "Ehi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290112,
					"content": "Non preoccuparti. Confido nelle credenze della nostra tribù... che la morte non è la fine, ma l'inizio di una nuova esistenza nel Regno della Notte, dove tutto è fatto di ricordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290113,
					"content": "Allora, sai perché i nostri antenati insistevano nell'usare dei rotoli di tessuto colorati per trascrivere la nostra storia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290114,
					"content": "Perché la storia... è la memoria di ogni popolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290115,
					"content": "Diamo ai nostri rotoli una tonalità arancione affinché i morti possano ancora percepire il calore del sole al tramonto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290116,
					"content": "Li decoriamo con semi di Granifrutto, così che i morti possano ancora godere dell'abbondanza dei nostri raccolti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290117,
					"content": "Lo so, ma... Perché affidi a me qualcosa di tanto importante? Perché non a uno dei tuoi allievi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290118,
					"content": "Eheh, in quanto tua amica, lo ammetto... Sono un po' egoista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290119,
					"content": "*tossisce* Non mi resta molto tempo, Citlali, e con quello che mi rimane non credo... di poter davvero spiegare la mia decisione. Ma so che un giorno la capirai comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290120,
					"content": "Per ora... ti chiedo solo di accettare la mia ultima richiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290121,
					"content": "...Solo per questa volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290122,
					"content": "Ora capisco, Huitzilin... Proprio come avevi predetto tu... Artiglio, aiutami a portarlo fuori. Lo voglio colorare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290123,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290124,
					"content": "#{NICKNAME}, Paimon, venite con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
