							-2002.646,
							176.821,
							9639.377
						],
						"pointId": 9679
					}
				]
			},
			"dialogs": [
				{
					"id": 150290201,
					"content": "Siamo come uccelli che solcano l'orizzonte del tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290203,
					"content": "(Filmato)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "Sapevo che avresti capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290205,
					"content": "Questo... è il rotolo speciale! Come facevi a sapere come tesserlo, Citlali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290206,
					"content": "Ricordate il \"dono degli spiriti\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "Aspetta, tu hai vissuto per più di duecento anni, e sai come tessere un rotolo speciale. Questo significa che... ci sei tu dietro ai \"doni degli spiriti\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290208,
					"content": "Beh, non volevo interagire con i prescelti, così ogni volta che consegnavo loro il rotolo, usavo delle illusioni per confonderli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290209,
					"content": "Se la cosa ha assunto la forma di un \"intervento divino\" è perché nessuno era abbastanza abile da capire i miei trucchi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290210,
					"content": "Perché non dirglielo e basta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "Ti sei fatta carico di questo dovere da sola per tutti questi anni? Anche se non ti piace interagire con le persone, avresti potuto insegnare a qualcun altro come fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290212,
					"content": "#...{NICKNAME}, tu riesci a vedere il colore speciale, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290213,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "L'essenza di quel colore è la memoria. Significa che per completare il rotolo speciale bisogna cercare il colore nei tuoi ricordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290215,
					"content": "Trasmettere la tecnica a qualcuno significa condividere i propri ricordi con quella persona. Bisogna lasciare delle tracce del proprio colore nella sua memoria, e quella persona dovrà fare lo stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290216,
					"content": "Avevo dei sospetti da molto tempo. E oggi finalmente ne ho avuto la conferma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290217,
					"content": "E, beh... Dopo la morte di Huitzilin, non ho più voluto stringere quel tipo di legame con altre persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290218,
					"content": "Oh, è così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290219,
					"content": "Era il suo ultimo desiderio, così mi sono arresa e ho accettato di prendermi quel fardello sulle spalle per sempre. In fondo ho tutto il tempo del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290220,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290221,
					"content": "Ma Artiglio non ha mai smesso di nominare nuovi candidati per la tessitura del rotolo, nonostante sappia esattamente cosa ne penso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290222,
					"content": "Vuoi dire che non ha mai smesso di cercare nuovi amici per te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "...Sapevo esattamente cosa stava facendo. E sì, se mai avessi voluto condividere i miei ricordi con qualcuno, quella persona sarebbe stata un amico. Ma nessuno è mai arrivato a esserlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290224,
					"content": "Questa volta però hai vinto tu, Artiglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290226,
					"content": "Prendi questo. Immagino... che sia la mia risposta a quello che mi hai detto l'altra sera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290227,
					"content": "Che cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290228,
					"content": "Se dovessi scegliere il mio colore, sarebbe il colore di questo fazzoletto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290229,
					"content": "Esistono innumerevoli persone nei miei ricordi, e so che un giorno anch'io diventerò il ricordo che vive nella memoria di qualcun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290230,
					"content": "Visto che tu hai una lunga vita davanti, sei la persona perfetta per conservare questo ricordo e il mio colore nella tua mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290231,
					"content": "#Significa che sono ufficialmente {F#tua amica}{M#tuo amico}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "...Tu conservalo, e non dimenticare il mio colore quando non ci sarò più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290233,
					"content": "Wow, è un po' presto per parlare di quel momento, non credi? Sono passati solo pochi secondi da quando abbiamo dichiarato ufficiale la nostra amicizia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290234,
					"content": "Non è a questo che servono gli amici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290235,
					"content": "#D'accordo, è un grosso impegno... Beh, Citlali, se anche {NICKNAME} lascerà il suo colore nella tua mente, probabilmente sarà l'oro, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290236,
					"content": "In realtà, un segno l'ha già lasciato. Ricordi l'effetto collaterale che non riuscivo a risolvere? Beh, finalmente ne sono venuta a capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290237,
					"content": "Condividere la propria percezione permette di instaurare una comunicazione tra coscienze diverse. E, naturalmente, anche i ricordi sono coinvolti in questo processo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290238,
					"content": "#Allora non lo sapevo, ma {F#entrambe}{M#entrambi} abbiamo la capacità di vedere il \"colore dei ricordi\", il che significa che, quando ho condiviso i miei sensi con te, tra i nostri ricordi si è creata una connessione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290239,
					"content": "E quella connessione è ciò che ha fatto impazzire il mio incantesimo originale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290240,
					"content": "#Quindi... puoi sentire i pensieri di {NICKNAME} perché avete davvero lasciato delle tracce di colore nei ricordi l'una {F#dell'altra}{M#dell'altro}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290241,
					"content": "Ed è per questo che poteva sentire anche i tuoi pensieri! Perché funziona in ambo le direzioni, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290242,
					"content": "Un ragionamento logico, ma solo chi è addestrato nelle arti mistiche è in grado di mantenere quel livello di connessione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290243,
					"content": "#Ecco perché io riesco ancora a sentire i pensieri di {NICKNAME}, ma non il contrario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290244,
					"content": "Ma non c'è bisogno di preoccuparsi. Ora che ho capito come funziona, me ne sbarazzerò in men che non si dica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290245,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290246,
					"content": "#(Ho mentito: in realtà sentire i pensieri l'{F#una}{M#uno} dell'altra dipende dalla forza della connessione tra i nostri ricordi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290247,
					"content": "(Quindi, dopo tutto quello che abbiamo appena passato, scommetto che riesci di nuovo a sentirmi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290248,
					"content": "(!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "(Lo sapevo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290250,
					"content": "(Ed esiste un modo per farlo smettere?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "#(Visto che i nostri ricordi sono già connessi, l'unico modo per rimuovere l'effetto è che {F#una}{M#uno} di noi due si dimentichi dell'{F#altra}{M#altro}.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290252,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "(Eheh, scherzo, scherzo... Sono una sciamana leggendaria, nella mia tribù! Ora che conosco la causa, è ovvio che posso rimediare.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290254,
					"content": "(Ma probabilmente ci vorrà ancora un po' di tempo. Quindi, per il momento, dovrai sopportare ancora per un po' i miei pensieri.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290255,
					"content": "(Tanto sono un libro aperto. Non sentirai niente di imbarazzante... Oh, ehm, a meno che non abbia bevuto qualche bicchierino.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290256,
					"content": "(Oh, quindi puoi annullarlo? Che peccato...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "(\"Che peccato\"? Beh, se mai ti mancherà questo pasticcio telepatico, potrò sempre condividere i miei sensi con te.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290258,
					"content": "(Ma non prometto nulla. Certi pensieri è meglio tenerli per sé stessi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290261,
					"content": "Ah... Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290259,
					"content": "(Oh, quindi puoi annullarlo? Buono a sapersi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "(Sì, e ti capisco. Certi pensieri è meglio tenerli per sé stessi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				}
			]
		},
