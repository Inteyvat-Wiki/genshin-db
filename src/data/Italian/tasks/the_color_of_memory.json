			},
			"dialogs": [
				{
					"id": 150295101,
					"content": "Ah, la vittoria di Natlan contro l'Abisso! Si addice perfettamente a un rotolo come questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295102
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150295102,
					"content": "Mi chiedo quanto tempo ci vorrà prima che l'Anziano Tlapo scelga il prossimo candidato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295103
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150295103,
					"content": "A proposito di Tlapo, ho sentito dire che è da ieri che non si trova! Sapete se gli è successo qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295104
					],
					"speakerTitle": "Besuci"
				},
				{
					"id": 150295104,
					"content": "Le vie dell'Anziano Tlapo sono sempre misteriose. Il motivo della sua partenza diventerà chiaro con il tempo, ma per ora non possiamo sperare di comprenderlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chogan"
				}
			]
		}
