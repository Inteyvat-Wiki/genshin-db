			"dialogs": [
				{
					"id": 790720101,
					"content": "#Oh, ma che onore. Tu devi essere {NICKNAME}, e quella al tuo fianco dev'essere la tua partner Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720102,
					"content": "Hihi, giusto! Siamo proprio noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790720103,
					"content": "#Siamo così {F#famose}{M#famosi}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "Le notizie viaggiano rapidamente a Sideropoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720105,
					"content": "#Devo ammettere che siete {F#arrivate}{M#arrivati} nel momento giusto. Stavo dando gli ultimi ritocchi a questo mio gioco chiamato \"Cappelli volanti\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720106,
					"content": "Temo di non potermi paragonare al Cappellaio volante che regalava un bel cappello a tutti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720107,
					"content": "Ma credo che \"Cappelli volanti\" porterà gioia a chi ci gioca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720108,
					"content": "Ho anche ideato tre modalità di gioco completamente diverse... Non preoccupatevi, le regole non sono troppo complicate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720109,
					"content": "Capirete tutto dopo una sola partita, ve lo garantisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720110,
					"content": "Fammi provare!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "Perfetto! Da questa parte, prego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720112,
					"content": "Adesso non ho tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "Oh, non c'è problema. Vieni a trovarmi quando puoi. Io resterò qui per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				}
			]
		}
	]
