			"dialogs": [
				{
					"id": 762000501,
					"content": "Lumi, anche tu pensi che sia qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000502,
					"content": "Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000503,
					"content": "Il gatto intrappolato è stato salvato...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "Quindi sei tu quello che stavano cercando, eh? Mm... Non sembri ferito. Ma se ti avessimo trovato più tardi... Chissà cosa sarebbe potuto succedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000505,
					"content": "Comunque, ti riportiamo subito dai tuoi amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
