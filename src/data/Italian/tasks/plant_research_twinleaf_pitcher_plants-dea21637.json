			"dialogs": [
				{
					"id": 762000201,
					"content": "Scusami, per caso hai visto un gatto tigrato da queste parti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000202
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000202,
					"content": "Un gatto tigrato? Mm, non mi pare... Lumi, tu ne hai visto uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000203
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000203,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000204
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000204,
					"content": "Sembra che neanche Lumi l'abbia visto. Il tuo gatto è scomparso? Posso aiutarti a cercarlo! Conosco bene questa zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000205
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000205,
					"content": "Ehi, Jukka! Non abbiamo soldi da spendere per assumere un avventuriere. E poi, è solo uno stupido gatto. Che vada dove gli pare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000206
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000206,
					"content": "Non dire così, Marja. Sarebbe triste se ti sentisse dire una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000207
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000207,
					"content": "Come se potesse sentirci! Se così fosse, non ci avrebbe ignorati nonostante tutte le volte che l'abbiamo chiamato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000208
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000208,
					"content": "Non c'è bisogno di pagarmi per quest'incarico. Dovevo comunque controllare la zona, quindi farò solo un po' più di attenzione. Andiamo, Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000209,
					"content": "(Qui non c'era nulla poco tempo fa, e ora è pieno di Mangione bifolia...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000210
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000210,
					"content": "(Forse qualche animale ha portato i semi qui; ma non posso lasciare che si diffondano in questo modo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
