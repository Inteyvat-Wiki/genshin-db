			"dialogs": [
				{
					"id": 762000801,
					"content": "Stupido gatto... Ma dove ti sei cacciato... Eh? L'hai trovato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000802,
					"content": "Era rimasto intrappolato in quella Mangiona bifolia laggiù. Sono piante carnivore che possono digerire le Lucciole lunari in appena pochi giorni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000803,
					"content": "Per fortuna l'abbiamo trovato giusto in tempo. Adesso è solo un po' debole, ma se fossimo arrivati più tardi... Chissà cosa sarebbe potuto succedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000804,
					"content": "C-Cielo... Davvero pericoloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000805,
					"content": "Umpf, non puoi prendertela con nessuno se non con te stesso per esserti infilato qui dentro, stupido gatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000806,
					"content": "Beh, non è davvero colpa del gatto. Queste Mangione bifolia emanano un profumo particolare. Gli esseri umani non ne sono influenzati, ma insetti e altre piccole creature potrebbero esserne attratti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000807,
					"content": "È così che le piante catturano le loro prede. Ce ne sono molte più del solito da queste parti, quindi anche gli animali più piccoli ne subiscono gli effetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000808,
					"content": "Ah... Capisco. Comunque, il fatto che ce ne siano così tante qui non è certo un buon segno, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000809,
					"content": "Esatto. Se non interveniamo, c'è il rischio che causino dei problemi seri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000810,
					"content": "Va bene, allora ci occuperemo noi di estirpare le erbacce. Jukka, vieni ad aiutare anche tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000811,
					"content": "Queste piante hanno fatto soffrire quello stupido gatto. Dobbiamo ricambiargli il favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000812,
					"content": "Con l'aiuto dei due cacciatori di tesori, le Mangione bifolia della zona vengono finalmente eliminate...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "Uff... Finalmente abbiamo finito. È ora di tornare a Nasha. Grazie mille per averci aiutato a trovare questo stupido gatto. Se non fosse stato per il tuo aiuto, chissà per quanto tempo sarebbe rimasto intrappolato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000814,
					"content": "A pensarci bene, Marja, se non ti fossi messa a urlare così forte, forse l'avremmo trovato persino prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000815
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000815,
					"content": "C-Cosa stai dicendo? Comunque, l'importante è che ora sia al sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000816
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000816,
					"content": "(Anche se lo chiama sempre \"stupido gatto\", in realtà ci tiene molto al suo compagno, eheh.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000817
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000817,
					"content": "Esatto. L'importante è che sia al sicuro. La natura selvaggia può essere ancora pericolosa, quindi fate attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000818
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000818,
					"content": "Grazie, lo faremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000819
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000819,
					"content": "E buona fortuna con le vostre indagini. Arrivederci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marja"
				}
			]
		},
