			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Questa foto è perfetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380203,
					"content": "*sospira* È ora di partire. Quando sento qualcuno dire frasi del tipo \"Un grande uomo è pronto a realizzare le sue aspirazioni ovunque\", oppure \"Meglio viaggiare per quindicimila chilometri che leggere quindicimila libri\", mi sento sempre così incoraggiato e ispirato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380204,
					"content": "Ma quando poi quello che deve partire sono io, l'incoraggiamento e l'ispirazione svaniscono. Vorrei solo soffermarmi qui ancora per un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380205,
					"content": "#Viaggiat{F#rice}{M#ore}, pensi che riuscirò a trovare quello che cerco in questo viaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380206,
					"content": "Non lo so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "Ahahah... Voglio dire, cosa sto cercando veramente? Lo so davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380210,
					"content": "#Ok, è quasi ora. Andrò a incontrare quel mercante. Per piacere, viaggiat{F#rice}{M#ore}, prendi questi come ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380211,
					"content": "Dopotutto, Que'er... non è qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380208,
					"content": "Dipende tutto da te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "Quindi... Stai dicendo che dipende tutto dal destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
