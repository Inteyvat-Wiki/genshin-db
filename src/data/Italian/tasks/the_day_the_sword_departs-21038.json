				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "#Viaggiat{F#rice}{M#ore}! Per fortuna sei qui. Temevo che oggi non saresti tornat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380102,
					"content": "Oggi è il giorno della partenza dal Porto di Liyue. Ti ho già creato molti problemi... Devo ringraziarti come si deve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380104,
					"content": "#Ehm... Stavo pensando a cosa dirti dopo averti vist{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380105,
					"content": "È il momento di dire davvero qualcosa, talvolta neanche ricordo le parole... Guarda come mi sto mettendo in ridicolo, ahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380106,
					"content": "#Non preoccuparti. Sono sicur{F#a}{M#o} che presto c'incontreremo di nuovo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "Davvero? Ahah, magnifico! Quando verrai ti mostrerò la città!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380109,
					"content": "Beh, a dire il vero avrei un ultimo favore da chiederti... Tu hai una Fotokamera, vero? Ti dispiacerebbe farmi una foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380110,
					"content": "Un marinaio mi ha detto che quando si viaggia all'estero è sempre consigliabile portarsi una foto della propria città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380111,
					"content": "Ma non ho una Fotokamera, quindi forse potresti farmi questa cortesia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380112,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "Mettiti in posa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "P—Posa!? Ma il soggetto è lo scenario dietro di me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380107,
					"content": "Ti verrò a trovare a Fontaine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
			"completionStepIds": [
				2103803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103803",
							"2"
						],
						"stepId": 2103803,
						"stateName": "QUEST_STATE_UNFINISHED"
