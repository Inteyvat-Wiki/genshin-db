			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#Ah! {NICKNAME}, Paimon, lieta di vedervi. Gli uccelli dei boschi mi avevano preannunciato il vostro arrivo. Siete qui per affari importanti, oppure... vi occorre la mia guida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010102,
					"content": "Stiamo solo dando un'occhiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "Questo luogo è ben pasciuto dal fulgore lunare. La fauna e la flora che vi abitano sono ben diverse da quelle che è possibile trovare nel resto del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010105,
					"content": "Pertanto, sì, trovo che sia un posto ideale per scattare foto eccellenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010106,
					"content": "Prego, guardatevi liberamente intorno. E, se avete quesiti, chiedete pure senza esitare. Risponderò al meglio delle mie facoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010107,
					"content": "Questo posto infonde un senso di tranquillità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "Sì. È il posto dove vengo a meditare e sussurrare a tutte le creature viventi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010110,
					"content": "Stare qui mi è bastevole per ridonare serenità al mio cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010111,
					"content": "Hihi, sei una vera poetessa, Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010112,
					"content": "In effetti, avrei una piccola richiesta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "Già. La tua figura si fonde alla perfezione con lo sfondo, sei come il centro di un dipinto stupendo! Paimon è certa che saresti bellissima in foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010115,
					"content": "Voi vorreste... scattarmi una foto? Questa è una novità. Se pensate che la placidità di questo luogo e la mia figura meritino di essere immortalate in uno scatto, sarò ben felice di accettare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010116,
					"content": "Sarebbe un onore poter aggiungere un altro lieto ricordo al vostro viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010117,
					"content": "Ordunque, cosa desiderate che faccia? Volete che guardi in una certa direzione o va già bene così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010118,
					"content": "Basta che tu sia te stessa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "Bene. Allora mi affido a te. Possa l'ispirazione, nella sua natura effimera, graziarti con la sua presenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010119,
					"content": "Catturerò il tuo profilo migliore, tranquilla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "Vorremmo scattarti una foto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "Di solito vieni qui a trascorrere il tempo libero, Lauma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "E cercando soggetti da fotografare, già che ci siamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
