					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010704
					]
				},
				{
					"id": 765010704,
					"content": "#Ah, capisco. Allora sentitevi {F#libere}{M#liberi} di fotografare tutto ciò che vi aggrada.",
					"roleType": "TALK_ROLE_NPC",
