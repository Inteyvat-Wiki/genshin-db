			"dialogs": [
				{
					"id": 730410501,
					"content": "Ahahah! Aralila è il peggiore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410502
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410502,
					"content": "#Nara dorat{F#a}{M#o} è eccezionale, mi ha trovato subito... Mmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410503
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410503,
					"content": "#Sì, Nara dorat{F#a}{M#o} è eccezionale, ma è anche Aralila a non essere bravo. Aranishat non si farà trovare così in fretta. Umpf! Stai a vedere.",
					"roleType": "TALK_ROLE_NPC",
