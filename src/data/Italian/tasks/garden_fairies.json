			"dialogs": [
				{
					"id": 730410101,
					"content": "#Ah, sei tu, Nara dorat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410102,
					"content": "#Amic{F#a}{M#o} Nara, vieni a giocare con Aralila! Aranishat non è bravo a questo gioco, quindi non giocare con lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410103,
					"content": "Pfff, Aralila ha perso contro Aranishat la volta scorsa, quindi Aralila è il peggiore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410104,
					"content": "#Va bene, non diamo fastidio con la storia del sole e della luna. L'amic{F#a}{M#o} Nara è qui, quindi giochiamo con {F#lei}{M#lui}. Gareggiamo e vediamo chi è il più forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410105,
					"content": "Va bene, gareggiamo. Aranishat non ha paura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410106,
					"content": "#Prima si nasconde Aralila, e l'amic{F#a}{M#o} Nara va a cercarlo. Poi si nasconde Aranishat, e l'amic{F#a}{M#o} Nara va a cercarlo. Perde chi viene trovato prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410107,
					"content": "#Vuoi giocare, amic{F#a}{M#o} Nara? Inizieremo appena sarai pront{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				}
			]
		},
