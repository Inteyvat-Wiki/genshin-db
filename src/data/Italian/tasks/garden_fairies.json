			},
			"dialogs": [
				{
					"id": 730410601,
					"content": "Cosa? Come?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410602
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410602,
					"content": "Anche Aranishat è stato trovato subito. Nemmeno lui è bravo, non solo Aralila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410603
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410603,
					"content": "#Ah... Sono pappemolli! Soltanto Nara dorat{F#a}{M#o} è forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410604,
					"content": "#Non va bene! Devo esercitarmi con l'Ararakalari. Con una forte Ararakalari, l'amic{F#a}{M#o} Nara non mi troverà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410605,
					"content": "Non penso che funzioni così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "Hai paura di perdere? Quando giochi, non devi preoccuparti di vincere o perdere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410609,
					"content": "#Anche se ho perso è stato divertente. Dopotutto, Nara dorat{F#a}{M#o} è {F#una}{M#un} Nara buon{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410610,
					"content": "#{F#La}{M#Il} nostr{F#a}{M#o} amic{F#a}{M#o} Nara ha vinto. Ottimo! Prendi i nostri fiori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410611
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410611,
					"content": "#Grazie, Nara buon{F#a}{M#o}! Sei {F#un'ottima}{M#un ottimo} amic{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410607,
					"content": "La prossima volta andrà meglio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410608
					]
				},
				{
					"id": 730410608,
					"content": "Già! La prossima volta non perderò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aranishat"
