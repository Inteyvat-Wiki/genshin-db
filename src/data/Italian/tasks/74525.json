			"dialogs": [
				{
					"id": 745250401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250402,
						745250403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250402,
					"content": "Hai un'espressione molto seria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				},
				{
					"id": 745250404,
					"content": "Ah, sei tu. No, le indagini di oggi sono terminate. Non è stato trovato nulla di insolito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250405,
					"content": "Mi stavo giusto chiedendo perché quegli Eremiti di passaggio sembrassero così... miti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250406,
						745250407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250406,
					"content": "Un viaggio faticoso, forse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250408,
					"content": "Immagino che abbiano dei problemi economici e che questi non siano isolati nel loro eremo, e nemmeno tanto miti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250409,
						745250410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250409,
					"content": "...Che ne dici di passare a un argomento un po' più miti-co?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250411,
					"content": "Ah, capisco. Però, se rimanessi semplicemente fermo, l'immagine risultante potrebbe mancare di impatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250412,
					"content": "Non preoccuparti, userò un po' di Electro per rendere le foto abbaglianti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745250413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250413,
					"content": "...Sembra un buon piano. Mi assicurerò di scattarti una foto mentre sei in azione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250414
					]
				},
				{
					"id": 745250414,
					"content": "Va bene. Mi affido a te. Non perderti il momento cruciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 745250410,
					"content": "Ti spiace se ti scatto una foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250411
					]
				},
				{
					"id": 745250407,
					"content": "Hanno fallito la loro missione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250408
					]
				},
				{
					"id": 745250403,
					"content": "Sei a caccia di un criminale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745250404
					]
				}
			]
		}
