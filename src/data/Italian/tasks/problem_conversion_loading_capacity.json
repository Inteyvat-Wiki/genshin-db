			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq",
					"Qishan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "D'accordo! Dovrebbe essere a posto. Vediamo che succede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210601,
					"content": "Cavoli! Il vostro scafo ha una falla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210615,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210602,
					"content": "Si sta inclinando! Cosa sta succedendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230210603,
					"content": "Rimuovi subito la roba! C'è qualcosa che non va!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210604,
					"content": "Tu e Rafiq svuotate in fretta la nave di tutti gli oggetti pesanti...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "Fiuu... Per fortuna non c'erano troppe cose da spostare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210606,
					"content": "Cosa diamine... Dove ho sbagliato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210607,
					"content": "Che ti avevo detto? I dati teorici che hai usato sono troppo estremi per essere affidabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210608,
					"content": "*sospira* Io... Io... D'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210609,
					"content": "Non sarebbe dovuto succedere... Ho fatto i calcoli con così tanta precisione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210610,
					"content": "#Grazie davvero per l'aiuto, viaggiat{F#rice}{M#ore}. Ecco, tieni, come compenso per il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210611,
					"content": "Torno a fare i miei calcoli. Qishan, potresti darmi una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210612,
					"content": "Parli come se non lo stessi già facendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210613,
					"content": "Lascia fare a me, e ricorda di offrirmi un caffè, dopo tutto questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
		{
			"id": 2302108,
			"completionStepIds": [
				2302108
			],
