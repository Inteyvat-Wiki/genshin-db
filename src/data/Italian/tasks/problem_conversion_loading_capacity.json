	"talks": [
		{
			"id": 2302101,
			"completionStepIds": [
				2302101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
