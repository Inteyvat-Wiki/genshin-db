					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210801,
					"content": "Sì! Ha funzionato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210802,
					"content": "Lo scafo non presenta problemi strutturali... Anche la linea di galleggiamento è stabile. Non c'è ribaltamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210803,
					"content": "Guarda, Qishan, il mio progetto e i miei calcoli sono immacolati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210804,
					"content": "Non lasciarti trasportare. Siamo solo alla prima fase del test di carico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210805,
					"content": "E non hai nemmeno tenuto conto dello spostamento del baricentro che si verificherà sulla nave a causa delle condizioni atmosferiche e del carico durante la navigazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210806,
					"content": "Uff... Terrò in considerazione questi fattori. Ma ti prego, lasciami assaporare il momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210807,
					"content": "#Oh, viaggiat{F#rice}{M#ore}, questa è la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210808,
					"content": "Qishan, non puoi essere felice per me almeno una volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210809,
					"content": "Ma essere felice per te non ti aiuterà a costruire la nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210810,
					"content": "È meglio se provi a rendere felice il tuo portafogli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
