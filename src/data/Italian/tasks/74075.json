			"dialogs": [
				{
					"id": 740751701,
					"content": "Ispezioni con cura lo spazio sulla parte alta del meccanismo, ma non trovi niente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740751702
					]
				},
				{
					"id": 740751702,
					"content": "Non c'è niente neanche qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751703,
					"content": "Cos'è che cerchiamo, esattamente, Caterpillar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751704
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740751704,
					"content": "Cerchiamo i materiali necessari per forgiare la Spada sacra di Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751705
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751705,
					"content": "L'Ordo è riuscito a riprodurre le quattro ipotetiche sostanze necessarie qui nel mondo materiale, sulla base delle filosofie esoteriche del regno sotterraneo e dell'antica Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751706
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751706,
					"content": "Non capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751707
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740751707,
					"content": "Queste sostanze enigmatiche sono puramente esperienziali. Si può dire che sono perfino più inafferrabili dalla logica ordinaria rispetto al potere elementale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751708
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751708,
					"content": "Decenni fa, ho immesso nei miei banchi di memoria tutti i libri di testo della Spantamad dell'Akademiya, dal livello introduttivo a quello intermedio. Non c'è niente di misterioso circa il potere elementale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751709
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740751709,
					"content": "Ma davvero? Comunque, ricapitolando, è il prodotto delle tradizioni di Fontaine, unite alla tecnologia dell'antico regno sotterraneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751710
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751710,
					"content": "E pertanto, quattro sostanze si sono formate: memoria, desiderio, anima e personalità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751711
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751711,
					"content": "Per evitare ulteriori ambiguità, li chiameremo il frammento della \"Memoria\", il frammento del \"Desiderio\", il frammento dell'\"Anima\" e il frammento della \"Personalità\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751712
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751712,
					"content": "Perché servono questi frammenti per creare la Spada sacra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751713,
					"content": "Nella versione della filosofia mistica propria dell'Ordo Narzissenkreuz, il tempio è un microcosmo dell'universo, i suoi membri sono sostituti degli dèi, e l'olio sacro è la forza di volontà temprata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751714
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751714,
					"content": "La Spada sacra, invece, è la \"ragione\", colei che apre squarci su tutto. Può nascere solo dalla consumata volontà umana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751715
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751715,
					"content": "Un concetto decisamente astruso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751716
					]
				},
				{
					"id": 740751716,
					"content": "L'esoterismo è questo, alla fine. Ci si aggrappa a qualunque cosa risulti sufficientemente simile; e, quando questo genere di cose assume connotati magici, ciò che è fittizio diventa reale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751717
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751717,
					"content": "E comunque, ora dovremmo dirigerci verso la prossima area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
