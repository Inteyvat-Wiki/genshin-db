					"nextDialogs": [
						740751802
					]
				},
				{
					"id": 740751802,
					"content": "Qualcuno ha preso anche... quello che c'era qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751803,
					"content": "Pare proprio di sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751804
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751804,
					"content": "Ma chi è...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751805
					]
				},
				{
					"id": 740751805,
					"content": "È Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751806
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751806,
					"content": "In passato abbiamo avuto uno scontro a Elynas. Cioè, in realtà di recente, non \"in passato\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751807
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740751807,
					"content": "Quando ho visto quel poveretto all'entrata, sapevo che era opera sua. Sembra che sia ancora attivo, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751808,
					"content": "E allora cosa vuole dalla roba che ha preso da qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751809,
					"content": "Semplice, anche lui vorrebbe riforgiare la Spada sacra di Narzissenkreuz. Il sogno dell'Ordo rimane irrealizzato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751810
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751810,
					"content": "Tuttavia, ora dovremmo dirigerci verso l'area finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
