			"dialogs": [
				{
					"id": 740751601,
					"content": "Ispezioni con cura lo spazio sulla parte alta del Meka, ma non trovi niente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740751602
					]
				},
				{
					"id": 740751602,
					"content": "Non c'è niente qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751603,
					"content": "Sembra che ci fosse qualcosa, ma che qualcuno l'abbia portata via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751604
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751604,
					"content": "Aspetta, ma non significa che il nostro piano è già fallito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751605,
					"content": "La nascita della \"Ragione\" richiede la fusione dei quattro ottanti. Se riusciremo a ottenere anche gli altri, siamo ancora in tempo per portarlo a termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751606
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740751606,
					"content": "In tal caso, meglio dirigersi in fretta verso la prossima area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
