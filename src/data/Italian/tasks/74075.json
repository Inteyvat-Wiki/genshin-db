			"dialogs": [
				{
					"id": 740750101,
					"content": "\"Qui giace l'Ottante delle anime, il tempio delle anime, lo spazio delle anime...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750102
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750102,
					"content": "\"Ti accompagno nell'eterno riposo\"... \"Nato in un istante, spesso in contraddizione, in unione perpetua\"... \"Sono il tesoro più prezioso della vita\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750103
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750103,
					"content": "Fiuuu... Niente di spaventoso questa volta. La risposta è un'orologio da tasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750104,
					"content": "A proposito, non ne hai uno anche tu, Ann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750105,
					"content": "Beh, gli orologi sono costosi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750106
					]
				},
				{
					"id": 740750106,
					"content": "E allora la risposta dev'essere il denaro, vale a dire i Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750107,
					"content": "Trapassare con le tasche piene di denaro è al secondo posto fra le grandi tragedie umane. Però non chiedermi cosa c'è al primo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750108,
					"content": "E allora qual è la più grande tragedia umana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750109,
					"content": "Questa la so. La soluzione è \"Riposare nella propria bara senza l'ombra di un Mora\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750110
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750110,
					"content": "Non penso di essere d'accordo. Non ci sono cose più importanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750111,
					"content": "Beh, per quello ho detto \"non chiedere\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750112
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750112,
					"content": "Chiedo scusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750113,
					"content": "E comunque, in base a quanto abbiamo detto prima, penso che la risposta non sia né un elegante orologio né i Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750114,
					"content": "E allora cosa potrebbe essere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750115,
					"content": "La risposta è semplice; ho un database di indovinelli semplici con una corrispondenza del 70%.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750116,
					"content": "Questo proviene da un romanzo della letteratura di secoli e secoli fa. Si legge: \"La mia nascita coincide con il fugace momento in cui gli occhi s'incontrano. Corro con la schiena rivolta verso ciò che inseguo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750117
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750117,
					"content": "\"Anche dopo aver tagliato via tutta la carne, tutte le ossa e tutte le interiora, giaccio ancora annidato nei resti del tuo midollo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750118
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750118,
					"content": "La risposta è \"l'amore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750119
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750119,
					"content": "Capisco ora. Questo orologio è proprio come quello che ho io; dev'essere perciò colmo di ricordi d'amore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750120,
					"content": "Ora, se solo riuscissimo ad aprirlo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750121
					]
				},
				{
					"id": 740750121,
					"content": "Certo, si aprirà, un giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750122
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750122,
					"content": "Ma che bravo che sei, stupido cane! Chi è il cane meccanico più carino del mondo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750123
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750123,
					"content": "È stato un piacere. Comunque \"carino\" è una descrizione soggettiva. Preferirei che mi si chiamasse \"l'affidabile e utile Prototipo 4ACV07\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750124,
					"content": "Ed è proprio per questo che sei così carino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750125
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750125,
					"content": "State citando un'altra conversazione? Mi pare di aver visto questa scena in passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750126
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750126,
					"content": "In ogni caso, lo hanno già risolto questo indovinello. Andiamo avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
