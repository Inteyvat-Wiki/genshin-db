				]
			},
			"dialogs": [
				{
					"id": 747000101,
					"content": "Eheh, Paimon si sta divertendo un sacco a riempire questo acquario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000102,
					"content": "Visto che a Sandrone non dispiace, dovremmo catturare altri pesciolini e abbellire questo posto ancora di più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000103,
					"content": "Ehi, voi due. Venite qui un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747000104,
					"content": "Eh? Tutto a posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000105,
					"content": "Tenete, è per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747000106,
					"content": "...Cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000107,
					"content": "Un dispositivo di mobilità subacquea a cui stavo lavorando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747000108,
					"content": "Eh?! Porca pupazza! Che gentile da parte tua, Sandrone, sei troppo buona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000109,
					"content": "È solo un dispositivo meccanico. Ho visto il modo in cui pescate e, come dire... È decisamente rudimentale... Francamente, era piuttosto difficile stare lì a guardarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747000110,
					"content": "Era... davvero così tremendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000111,
					"content": "Era inefficiente, maldestro e privo di eleganza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747000112,
					"content": "Scusa se ti abbiamo provocato un simile trauma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "Non c'è bisogno di scusarsi, ognuno fa le cose a modo proprio; ma giacché volete continuare ad arricchire l'acquario, credo vi convenga utilizzare questo dispositivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747000114,
					"content": "Le acque di Fontaine non ospitano solo innocui pesci ornamentali, ci sono anche molti predatori che potrebbero farvi del male. Questo dispositivo vi aiuterà a pescare, ma anche a fuggire in caso di pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747000115,
					"content": "Grazie mille.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "Bene. Ah, e se volete farvi una nuotata, andate pure. E non dimenticate di farmi sapere cosa ne pensate del dispositivo. Posso sempre applicare delle modifiche, se avete suggerimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747000116,
					"content": "Lo porterò con me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
}