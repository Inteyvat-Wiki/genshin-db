				]
			},
			"dialogs": [
				{
					"id": 751890401,
					"content": "Fiuu, ce l'abbiamo fatta! Finalmente abbiamo il permesso per entrare in quel \"Cuore della Montagna Sacra\" o come si chiama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890402,
					"content": "\"No. Come ho detto prima, questo è solo il guscio esterno del permesso...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890403
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890403,
					"content": "\"Un dispositivo costruito con una singola squama, privo di qualsiasi informazione riguardante il suo proprietario, non può essere convertito in un permesso.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890404
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890404,
					"content": "\"Altrimenti, sarebbe come una specie di passepartout usabile da un vecchio drago qualsiasi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890405
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890405,
					"content": "Presto, porta alla mia presenza un drago che si confaccia a tali condizioni!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890406
					]
				},
				{
					"id": 751890406,
					"content": "#E dove lo possiamo trovare un drago del genere... Ehi, aspetta! {REALNAME[ID(2)|SHOWHOST(true)]} non va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890407,
					"content": "Rrroar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890408
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890408,
					"content": "\"No... Al momento, no.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890409
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890409,
					"content": "Cosa facciamo, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890410,
					"content": "\"Tanto tempo fa, dopo che il grande sovrano era entrato nel Cuore della Montagna Sacra, vi furono alcuni che avevano l'autorità di attivare questo permesso, ma non lo fecero.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890411
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890411,
					"content": "\"Forse questo permesso particolarmente evidente è stato messo qui apposta...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Servitore della Fonte segreta"
				}
			]
		},
