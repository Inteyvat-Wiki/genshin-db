				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751890201,
					"content": "Sembra che non ti piaccia molto questo posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890202
					]
				},
				{
					"id": 751890202,
					"content": "\"E nemmeno a te piacerebbe, se ti avessero considerato un criminale.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Servitore della Fonte segreta"
