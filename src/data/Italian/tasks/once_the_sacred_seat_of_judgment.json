			},
			"dialogs": [
				{
					"id": 751890701,
					"content": "Minaccia nemico d'ombra rilevata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890702,
					"content": "Salvaguardia interna... Attivazione modalità autoriparazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890703,
					"content": "Ah! Paimon mai avrebbe pensato che in un posto così potessero esserci dei meccanismi del genere... Quei mostri non avevano scampo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890704,
					"content": "\"Questo luogo fu eretto per durare più a lungo degli eoni stessi. Non solo abbonda di sistemi di difesa, ma è anche in grado di autoripararsi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890705,
					"content": "Com'è luccicoso... Paimon vuole toccarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890706,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "\"Ahah, meglio evitare... Non è capace di distinguere tra 'amico' e 'nemico'... Si limita a bruciare tutto ciò che tocca.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890708,
					"content": "\"Un approccio rozzo e brutale... Umpf, quei folli hanno progettato le cose più assurde...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890709,
					"content": "Ma possiamo usarla per aprire il guscio che ricopre il permesso, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890710,
					"content": "Vale la pena di provarci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "Comunque sia, troviamo un modo per farlo salire, che ne dite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890712,
					"content": "Finalmente un'idea brillante da parte di Paimon! Più unico che raro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "Groar, roaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "\"Esattamente. Nemmeno io credevo che il nostro bianco emissario nascondesse una tale saggezza... Invero, un'autentica sorpresa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890715,
					"content": "Paimon non capisce perché siete così sorpresi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}