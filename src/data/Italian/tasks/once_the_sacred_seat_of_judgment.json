					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890102
					]
				},
				{
					"id": 751890102,
					"content": "\"Temo che sia molto diverso da quello che state pensando.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Servitore della Fonte segreta"
