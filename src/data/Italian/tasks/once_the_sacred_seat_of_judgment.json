						],
						"pointId": 70
					},
					{
						"sceneId": 101,
						"position": [
							224.056,
							360.155,
							-150.196
						],
						"pointId": 71
					},
					{
						"sceneId": 101,
						"position": [
							224.075,
							360.155,
							-154.628
						],
						"pointId": 72
					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "\"Ecco la luce dell'iscrizione che attiva la squama. Si tratta del permesso...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890602,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "Accidenti! Da qui si staglia tutta la Città sacra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890604,
					"content": "\"Sì, un'ombra del glorioso e patetico passato...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890605,
					"content": "Wrroh... Roarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "\"Volete sapere quale è stato il verdetto finale del processo? Ahah...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890607,
					"content": "\"Certamente, coloro che volevano un verdetto sacro sapevano che il maestro di tutte le luci e fiamme stava semplicemente fingendo la morte, ma quando il vero re, lucido di mente solo di tanto in tanto, fece la sua comparsa in carne e ossa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890608,
					"content": "\"I Tredici Signori e i Tre Prìncipi, che di solito non riuscivano a tenere la bocca chiusa per un secondo, ritirarono frettolosamente le loro parole, e l'intero processo divenne una farsa, senza giungere infine a una conclusione...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890609,
					"content": "Rooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "\"In seguito, i Tre Prìncipi vennero uccisi nella guerra contro l'umanità, mentre dieci dei Tredici Signori caddero quando Tollan, la Città sacra, collassò, e uno rimase a Chichen Uctokah...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890611,
					"content": "\"Uno di loro, però, è sopravvissuto fino ai giorni nostri...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890612,
					"content": "\"Anche se, senza dubbio, non nella forma che avrebbe voluto mantenere...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890613,
					"content": "\"Bene. Proseguiamo verso il Cuore della Montagna Sacra. È lì che tutto è sepolto... incluso un anelito per la fine del viaggio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890614,
					"content": "\"Presto il mio dovere sarà assolto... Prescelti dei Draghi, se solo aveste potuto ammirare questo luogo nel suo massimo splendore, nella sua bellezza più pura...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890615,
					"content": "\"Va', tocca la luce incisa nella fiamma... Ottieni il permesso per raggiungere il Cuore della Montagna Sacra...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890616,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "Awanyu... Ugh, è sparito di nuovo! Paimon si stava abituando a quel nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890618,
					"content": "Comunque sia, alla fine abbiamo ottenuto il permesso per accedere al Cuore della Montagna Sacra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890619,
					"content": "Rrroar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "La luce da questa parte... è sparita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
