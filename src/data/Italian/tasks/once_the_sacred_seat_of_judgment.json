						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 751890501,
					"content": "\"Sapevo che sareste venuti, così ho preparato un'accoglienza degna di tali circostanze...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890502,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "\"So che lo dici per educazione, ma sono davvero felice di vederti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890504,
					"content": "Ah, sei tu! Quindi, ehm, come ti chiami questa volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890505,
					"content": "\"Il mio nome attuale è appartenuto a uno scriba della Camera delle Delibere. In realtà, raramente toccava penna e inchiostro, perlomeno da quando i Servitori della Fonte segreta erano stati creati.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890506,
					"content": "\"Awanyu... Puoi chiamarmi così.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890507,
					"content": "Va bene, allora, Awanyu. Sei qui per aiutarci con questa faccenda del permesso per il Cuore della Montagna Sacra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890508,
					"content": "\"Senza quello, le Adunanze astrali al suo interno attaccheranno qualsiasi intruso...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890509,
					"content": "\"...Ho estratto i registri di 'Awanyu'. Secondo quanto vi è riportato, il permesso per accedere al Cuore della Montagna Sacra è stato posto sopra la Camera delle Delibere.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890510,
					"content": "\"Per questo motivo non ho avuto altra scelta che mettere piede in questo luogo... Un congresso di stolti arroganti, un'assemblea che si vanta della propria inutilità.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890511,
					"content": "\"Senza contare che si tratta di un covo di impostori che si arroga il diritto di giudicare i propri simili...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Servitore della Fonte segreta"
				}
			]
		},
		{
			"id": 7518906,
			"completionStepIds": [
				7518905
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518905",
							"2"
						],
						"stepId": 7518905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 101,
						"position": [
							226.969,
							360.155,
							-152.202
						],
						"pointId": 59
					},
					{
						"sceneId": 101,
						"position": [
							224.009,
							360.155,
