						"pointId": 89
					},
					{
						"sceneId": 101,
						"position": [
							291.503,
							56.8,
							-149.863
						],
						"pointId": 90
					}
				]
			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "\"Andiamo. Vediamo dove hanno nascosto il permesso...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890302,
					"content": "\"Credo che l'abbiano lasciato da quella parte... Non si sono presi la briga di nasconderlo?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890303,
					"content": "\"Eppure, non sembra altro che un guscio vuoto...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890304,
					"content": "Ehi, ehi, che ci fanno tutti questi Segugi della Faglia qui? Ah, significa che il permesso è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890305,
					"content": "\"La sicurezza all'ingresso potrebbe essere stata neutralizzata, permettendo loro di entrare.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890306,
					"content": "A-Allora che facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890307,
					"content": "\"Nessun problema. Dobbiamo solo attivare i meccanismi di purificazione e riparazione della Camera delle Delibere.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "Servitore della Fonte segreta"
				},
				{
					"id": 751890308,
					"content": "\"Da quella parte...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Servitore della Fonte segreta"
				}
			]
		},
