			"dialogs": [
				{
					"id": 240010301,
					"content": "Direi che l'abbiamo trovato, felice come una pasqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010302,
					"content": "Chissà se Mademoiselle Staelle capirà che, ai cani, di opera e romanzi non importa nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010303,
					"content": "Torniamo indietro. Sarà preoccupata da morire.",
					"roleType": "TALK_ROLE_NPC",
