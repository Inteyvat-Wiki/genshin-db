			"dialogs": [
				{
					"id": 240010401,
					"content": "Barea! Oh, cucciolo mio! Dove ti eri cacciato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010402,
					"content": "Ha semplicemente trovato un posticino dove riposare. Una semplice vacanzina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010403,
					"content": "Ah, ero così preoccupata! Grazie, agente Blathine, grazie! Comparirai certamente nel mio prossimo romanzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010404,
					"content": "Grazie per la considerazione, ma sarebbe uno spreco d'inchiostro. Dubito che a qualcuno interessi la vita quotidiana di un poliziotto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010405,
					"content": "Dovrò semplicemente drammatizzare un po' la sua storia... Sarà interessante, lo giuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010406,
					"content": "Questa promessa è già drammatica a sufficienza, credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010407,
					"content": "Ah, ma la conclusione dev'essere stimolante! Mi faccia pensare, chi potrebbe essere il suo partner...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				}
			]
		},
