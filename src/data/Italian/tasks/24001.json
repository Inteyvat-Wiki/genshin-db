					}
				]
			},
			"dialogs": [
				{
					"id": 240010101,
					"content": "La prego, mi aiuti! Stavo pensando alla storia del romanzo, e senza che me ne accorgessi, Barea è sparito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010102
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010102,
					"content": "È sicura di non averlo lasciato sulla sedia nel teatro, di non averlo legato alla porta del bagno, o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010103
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010103,
					"content": "Ho già cercato in tutti quei posti. Ho persino guardato sotto la sedia, ma Barea non c'era.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010104
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010104,
					"content": "Ah, il pensiero che il mio Bareuccio sia stato rapito... O che, colpito da una bellezza fulminante, ne abbia seguito ciecamente le tracce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010105
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010105,
					"content": "Mademoiselle Staelle, sono sicura che Barea non commetterebbe lo stesso errore due volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010106
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010106,
					"content": "Ma il mio Bareuccio è così piccino... e i bambini, si sa, commettono gli stessi errori di continuo, e ne vanno quasi fieri, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010107
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010107,
					"content": "Non credo che... Barea sia piccolo come dice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010108,
						240010109
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010108,
					"content": "Tra l'altro, chi è questo Barea? Se posso chiedere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				},
				{
					"id": 240010110,
					"content": "Il cane di Mademoiselle Staelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010111
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010111,
					"content": "La mia famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010112
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010112,
					"content": "La sua famiglia è sparita e mi sta chiedendo di aiutarla a ritrovarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010113
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010113,
					"content": "Mademoiselle Staelle, abbiamo già perlustrato quest'area. Immagino che Barea si sia diretto fuori dalla città, verso le aree selvagge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010114,
					"content": "Andiamoci anche noi, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010115
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010115,
					"content": "Per favore, Mademoiselle, le chiedo di rimanere in città. Con il vestito che indossa non riuscirebbe a prendere Barea nemmeno se lo trovasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010116
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010116,
					"content": "Assurdità! Barea salterebbe tra le mie braccia se mi vedesse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010117
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010117,
					"content": "Allora immagino non ci abbia sentiti quando lo chiamavamo all'interno del teatro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010118,
					"content": "Ecco, direi che ci siamo. Temo di non poter riportare da sola Barea a Mademoiselle Staelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010119
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010119,
					"content": "Non posso abbandonare a lungo la mia postazione, e di certo non posso chiedere ai miei colleghi di venire con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010120
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010120,
					"content": "#Ma se non ti dispiace, viaggiat{F#rice}{M#ore}, potresti aiutarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010121,
						240010122
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010121,
					"content": "Beh, non sarebbe un problema, di per sé...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010124
					]
				},
				{
					"id": 240010124,
					"content": "Bene, allora è deciso. Venite con me, cercheremo insieme Barea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010125
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010125,
					"content": "Considerando quanto pesa, non sarà andato lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010126
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010126,
					"content": "Cosa? Il mio Bareuccio è in perfetta forma, prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010127
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010127,
					"content": "Sono d'accordo, se parliamo di salute mentale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010128,
					"content": "Andiamo, prima che Barea si abitui alla libertà e scappi ancora più lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010129
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010129,
					"content": "Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010122,
					"content": "Anche voi poliziotti dovete occuparvi di questioni del genere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010123
					]
				},
				{
					"id": 240010123,
					"content": "Se i cittadini della Corte di Fontaine mi chiedono aiuto, non ho motivo di dir di no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010124
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010109,
					"content": "Come posso aiutarvi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				}
			]
		},
