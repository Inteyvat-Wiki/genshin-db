			"dialogs": [
				{
					"id": 240010501,
					"content": "Che a Barea non piaccia il mio nuovo romanzo? *sospira* Eppure dicono tutti sia molto bello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010502
					],
					"speakerTitle": "Staelle"
				},
				{
