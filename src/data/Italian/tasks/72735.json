			"trigger": {
				"objectNames": [
					"Sennichi Grantorre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "Ehi, chi di voi è il capobanda? Fatti avanti! È ora di combattere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "Sennichi Grantorre"
				},
				{
					"id": 727350102,
					"content": "Sono Sennichi Grantorre, un gigante tra i giganti. Il Granmaestro Hanakado mi ha chiesto la testa del leader della Banda di Arataki... e sono venuto qui a prenderla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "Sennichi Grantorre"
				},
				{
					"id": 727350103,
					"content": "Wow, sembra agguerrito... Anche nel modo in cui parla! Credo che stavolta dovremo vedercela con un avversario davvero forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350104,
					"content": "Da dove salti fuori? Eh? E quale sarebbe la grande idea? Mettere \"Gran\" nel tuo nome? Stai cercando di rubarmi la scena, teppista dei miei stivali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350105,
					"content": "Ok, \"gigante tra i giganti\", è ora di darti una bella ridimensionata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350106,
					"content": "C-Che alto! E sei... Sei un oni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "Sennichi Grantorre"
				},
				{
					"id": 727350107,
					"content": "H-Hai l'aria di uno che potrebbe mangiarmi a colazione! ...Perché t'interessano le lotte tra scarabei? È un gioco da bambini... Argh, in cosa mi sono cacciato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "Sennichi Grantorre"
				},
				{
					"id": 727350108,
					"content": "Mm, prego? Un gioco da \"bambini\"? Oh, non l'hai detto PER DAVVERO!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350109,
					"content": "Sembra che tu non conosca la prima regola della lotta tra scarabei. La tua errata convinzione dev'essere corretta da un veterano, amico mio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350110,
					"content": "Istruiscilo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "Già! Spupazzalo come si deve! Puoi farcela, Toro sdraiato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350113,
					"content": "Sta succedendo per davvero... Bene, fatti sotto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sennichi Grantorre"
				},
				{
					"id": 727350111,
					"content": "È tempo di metterlo in riga!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
}