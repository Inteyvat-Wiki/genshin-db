			},
			"dialogs": [
				{
					"id": 760370401,
					"content": "(A proposito del Kairagi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370402
					]
				},
				{
					"id": 760370402,
					"content": "\"Obiettivo della taglia: Gonpachi, un uomo di Inazuma che indossa abiti in stile Kairagi. Ricercato per: aggressioni casuali ai mercanti in viaggio. Segnalate molteplici vittime.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370403
					],
					"speakerTitle": "Caccia alla taglia"
				},
				{
					"id": 760370403,
					"content": "\"L'obiettivo è stato avvistato l'ultima volta vicino al <color=#00E1FFFF>Valico del Nulla</color>. Coloro che lo sconfiggeranno e forniranno prova della sua morte riceveranno una generosa ricompensa dalla Gilda.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caccia alla taglia"
				}
			]
		},
		{
			"id": 7603705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
