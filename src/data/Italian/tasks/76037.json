					"Leszek"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760370101,
					"content": "I dettagli su tutti e quattro gli obiettivi sono sulla bacheca. Posso spiegarti meglio se serve, ma non perdere tempo a contrattare sulle ricompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370107,
					"content": "Consegna la prova di aver sconfitto il bersaglio della taglia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "A proposito degli obiettivi delle taglie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "Al momento abbiamo quattro obiettivi, ma abbiamo delle piste per solo tre di questi. Il primo obiettivo è l'indovina di Sumeru Hidimbi, ricercata per frode. La si vede spesso nei pressi del <color=#00E1FFFF>porto meridionale</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370104,
					"content": "Il secondo è il Kairagi di Inazuma impazzito, che ha reclamato la vita di diversi mercanti viaggiatori di passaggio nel <color=#00E1FFFF>Valico del Nulla</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370105,
					"content": "Il terzo, invece, è un membro di una banda di contrabbandieri che traffica merci pericolose, secondo quanto riferito si nasconde in <color=#00E1FFFF>un accampamento sulla spiaggia a nord della città</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370106,
					"content": "Infine, c'è il famigerato pirata conosciuto come Hark Mascella rotta. Al momento non ci sono piste. Probabilmente si è nascosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370108,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Arrivederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
