			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760370301,
					"content": "(A proposito di Hidimbi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370302
					]
				},
				{
					"id": 760370302,
					"content": "\"Obiettivo della taglia: Hidimbi, un'indovina di Sumeru. Donna, età sconosciuta. Ricercata per: sospettata di aver lanciato maledizioni e di frode di alto valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370303
					],
					"speakerTitle": "Caccia alla taglia"
				},
				{
					"id": 760370303,
					"content": "Quella donna mi ha rubato 18 milioni di Mora! Ha detto che se avessi indossato la collana che diceva di aver ricevuto dal dio dell'amore, Al-Ahmar, le donne si sarebbero innamorate di me a prima vista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370304
					],
					"speakerTitle": "Caccia alla taglia"
				},
				{
					"id": 760370304,
					"content": "A quanto pare Al-Ahmar non è affatto il dio dell'amore. È morto migliaia di anni fa e non è nemmeno riuscito a conquistare la ragazza che amava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370305
					],
					"speakerTitle": "Caccia alla taglia"
				},
				{
					"id": 760370305,
					"content": "Quindi la collana che mi ha venduto è autentica, ma mi ha maledetto e per questo non troverò mai l'amore. Chiunque riesca a rintracciarla e a spezzare la maledizione riceverà una generosa ricompensa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caccia alla taglia"
				}
			]
		},
		{
			"id": 7603704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
