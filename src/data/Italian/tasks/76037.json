			},
			"dialogs": [
				{
					"id": 760370501,
					"content": "(A proposito dei contrabbandieri...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370502
					]
				},
				{
					"id": 760370502,
					"content": "\"Obiettivo della taglia: Nuova Banda del Salferro. Ricercati per: sospetto contrabbando su larga scala e traffico di merci pericolose soggette a restrizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370503
					],
					"speakerTitle": "Caccia alla taglia"
				},
				{
					"id": 760370503,
					"content": "Le indagini indicano che la banda ha un avamposto temporaneo presso <color=#00E1FFFF>un accampamento sulla spiaggia a nord della città</color>. Coloro che aiuteranno a fermare le loro operazioni di contrabbando saranno generosamente ricompensati dalla Spina di Rosula.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caccia alla taglia"
				}
			]
		},
