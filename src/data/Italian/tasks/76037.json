				{
					"id": 760370601,
					"content": "(A proposito di Hark Mascella rotta...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370602
					]
				},
				{
					"id": 760370602,
					"content": "\"Obiettivo della taglia: Hark Mascella rotta, ex timoniere dell'Atlas. Ricercato per: molteplici omicidi. Spietato fino al midollo. Attuale ubicazione sconosciuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370603
					],
					"speakerTitle": "Caccia alla taglia"
				},
				{
					"id": 760370603,
					"content": "Chiunque fornisca informazioni credibili sulla sua posizione riceverà una generosa ricompensa (dopo che tali informazioni saranno state verificate).\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caccia alla taglia"
				}
			]
		},
