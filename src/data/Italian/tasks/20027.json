				"points": []
			},
			"dialogs": [
				{
					"id": 200270101,
					"content": "#Grazie, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270102,
					"content": "Volevo solo occuparmi delle vigne e poi... guarda cosa è successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270103,
					"content": "*sospira* Per favore, non dire niente a mio figlio. È uno dei Cavalieri di Favonius, quindi sono sicuro che ha già molte preoccupazioni di suo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270104,
					"content": "Non c'è bisogno di allarmarlo per uno stupido vecchietto che finisce in un semplice pasticcio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270105,
					"content": "Comunque, di recente ho l'impressione che stiamo avendo un piccolo problema di Melmosi nell'area intorno al vigneto. Ho sempre paura che distruggano le mie vigne. Non ci dormo la notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270106,
					"content": "Non so se hai tempo da perdere per un povero vecchietto come me... Ma potresti cacciare i Melmosi dai dintorni, così da farli smettere di prendersela con la mia uva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270107,
					"content": "Certamente, vecchietto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "Grazie infinite! Finalmente potrò riposare meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270108,
					"content": "Neanche per sogno, vecchietto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "*sospira* Lo farei volentieri da solo, ma alla mia età la forza non è più quella di una volta... Per qualcuno di così giovane, questo non dovrebbe essere un problema. Dai, fai felice questo vecchietto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		}
	]
