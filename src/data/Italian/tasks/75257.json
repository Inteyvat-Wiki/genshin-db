			},
			"dialogs": [
				{
					"id": 752570301,
					"content": "L'ultima è venuta proprio bene! Il prossimo è questo bel ragazzone dei Fatui. Che tipo di foto vorrebbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570302,
					"content": "Vorrei che mi faceste sembrare un vero cecchino. Sapete, di quelli che basta guardarli per capire che non sbagliano un colpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570303,
					"content": "In questo modo non avrà poi così tanta importanza se mi classificherò tra gli ultimi nelle gare di tiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570304,
					"content": "Perfetto. Possiamo cominciare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
