			"dialogs": [
				{
					"id": 752570801,
					"content": "L'ultima è venuta proprio bene! Ora tocca a questo giovane affascinante, che tipo di foto desidera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570802,
					"content": "Ah, ma che bel complimento! Ho sempre dato molta importanza al portamento e all'eleganza, fin dal giorno della mia nascita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570803,
					"content": "Un portamento scorretto implica mancanza d'eleganza; e una carenza di garbo implica scarsa raffinatezza. Sicuramente avrete capito i miei requisiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570804
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570804,
					"content": "Ahh... Mi dia un attimo... Ecco qua, possiamo cominciare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
