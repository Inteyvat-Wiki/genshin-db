			"dialogs": [
				{
					"id": 752570101,
					"content": "Qui sembra funzionare tutto. Perché non è aperto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570102,
					"content": "Ah, mi dispiace. Purtroppo ieri sera il nostro decoratore ha esagerato con l'alcol e oggi non è potuto venire al lavoro. Posso chiedervi di tornare domani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570103,
					"content": "Oh, cribbio, sono troppo vecchia per trascinarmi qui domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570104,
					"content": "E poi abbiamo già dei piani per domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570105,
					"content": "Mi dispiace molto. Questa cabina fotografica estiva è stata allestita per fornire a ciascun cliente uno sfondo personalizzato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570106,
					"content": "Ma purtroppo, senza il nostro decoratore, non possiamo fare nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570107,
					"content": "Serve una mano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "Volete davvero aiutarmi? Sarebbe fantastico! Non è niente di complicato: dovete solo preparare lo sfondo fotografico in base alle richieste dei clienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525702,
			"completionStepIds": [
				7525701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
