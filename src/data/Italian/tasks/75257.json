			},
			"dialogs": [
				{
					"id": 752570701,
					"content": "Fiuu, questo era l'ultimo! Mi avete davvero tirato fuori dai guai. Se non fosse stato per voi, avrei già ricevuto un mare di lamentele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570702,
					"content": "#Non preoccuparti, eheh. Siamo {F#delle avventuriere}{M#degli avventurieri} a cui piace rendersi utili!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "#{F#Avventuriere}{M#Avventurieri}, eh? Che ne dite se vi scatto una foto? Voglio immortalare il vostro spirito altruistico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570704,
					"content": "Andiamo, sorridete! Che la Dolcebrezza estiva di Natlan sia con voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570705,
					"content": "Grazie ancora a tutt'e due. Per favore, accettate questi come ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
