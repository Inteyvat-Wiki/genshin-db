						"pointId": 12118
					},
					{
						"sceneId": 3,
						"position": [
							2260.4,
							200.2,
							9293.5
						],
						"pointId": 13302
					}
				]
			},
			"dialogs": [
				{
					"id": 760220301,
					"content": "Grazie mille per avermi salvato! Sono Peco, un mercante viaggiatore. Se in futuro ci dovessimo incontrare di nuovo, vi garantirò i prezzi migliori della zona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220302
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220302,
					"content": "Oggi non è il mio giorno fortunato... Dovevo proprio imbattermi in questa \"leggenda\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220303
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220303,
					"content": "\"Leggenda\"? È famoso o cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220304,
					"content": "Non in senso positivo. La voce gira tra noi commercianti... Alcuni colleghi che l'hanno incontrato hanno giurato di non voler mai più passare per questa strada. Non ci credevo, pensavo che stessero esagerando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220305
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220305,
					"content": "Sei più coraggioso di quanto sembri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220306,
					"content": "Noi mercanti viaggiatori ne vediamo di tutti i colori, sai? E, beh, a volte le storie vengono romanzate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220307
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220307,
					"content": "Ma comunque... Lo chiamano \"Gonpachi\". Si dice che si sia messo nei guai a Inazuma e sia fuggito qui con la sua amata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220308
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220308,
					"content": "Quindi quella \"Murasaki\" di cui borbottava...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220309
					]
				},
				{
					"id": 760220309,
					"content": "#Ah, vero! Continuava a borbottare quel nome durante il combattimento con {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220310,
					"content": "Una volta che ti allontani dalla retta via, è difficile rimettersi in carreggiata, anche in un posto nuovo. Senza un lavoro onesto, finisci per tornare al punto di partenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220311
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220311,
					"content": "Questo stile di vita potrebbe funzionare per un lupo solitario. Ma vivere della propria spada... Prima o poi, finirai per imbatterti nella persona sbagliata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220312
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220312,
					"content": "Da quello che ho sentito, è così che è morta la sua amata. Da allora, lui non è più... beh, non è più a posto con la testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220313
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220313,
					"content": "*sospira* Derubare la gente è terribile, ma... sapendo come è finito così, Paimon prova un po' di pena per lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220314,
						760220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220314,
					"content": "Speriamo che a Paimon non venga in mente di darsi al crimine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220315
					]
				},
				{
					"id": 760220315,
					"content": "EHI! Non è questo il punto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220318,
					"content": "D'accordo, non vi tratterrò oltre. Vi prego di accettare questo come segno della mia gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220316,
					"content": "Se Paimon venisse mai derubata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760220317
					]
				},
				{
					"id": 760220317,
					"content": "#Eheh, è un bene che ci sia tu qui! {NICKNAME}, {F#la guardiana}{M#il guardiano} dei miei Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220318
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}