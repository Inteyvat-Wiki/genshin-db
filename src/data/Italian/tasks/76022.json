				]
			},
			"dialogs": [
				{
					"id": 760220201,
					"content": "Ehi, tu! Che pensi di fare? Smettila immediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Mora... No, no! Tu hai ucciso Murasaki... Devi morire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Samurai infuriato"
				},
				{
					"id": 760220203,
					"content": "#Woah! Attenzione, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
