			"dialogs": [
				{
					"id": 760220101,
					"content": "Opporre resistenza è inutile, finirai solo per sanguinare. Lascia qui i Mora e vattene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220102
					],
					"speakerTitle": "Samurai infuriato"
				},
				{
					"id": 760220102,
					"content": "Aiuto! Qualcuno mi salvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220103
					],
					"speakerTitle": "Peco"
				},
				{
					"id": 760220103,
					"content": "Woah, dovremmo andare ad aiutare quel tipo!",
