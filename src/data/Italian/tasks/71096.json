			"dialogs": [
				{
					"id": 710960101,
					"content": "Hai trovato le Pietre arcaiche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960102,
					"content": "Eccole qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "Altre tre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960202,
					"content": "#Sarò ben felice di accettare le Pietre arcaiche consegnate da due cittadin{F#e}{M#i} modello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960203,
					"content": "Non mi aspettavo che ne avreste trovate tre così velocemente. E la loro qualità è anche migliore di quelle che ho visto in precedenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960204,
					"content": "*sospira*... Mi ricordano quella che avevo un tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960205,
					"content": "Hai una Pietra arcaica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960206,
					"content": "E allora perché hai mandato noi a cercarla?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "Ce l'avevo UN TEMPO.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960209,
					"content": "Un giorno, il mio vecchio consegnò dei minerali all'Unione di Shenglu. Quella pietra era uno scarto di bassa qualità, quindi me la regalò per giocarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960210,
					"content": "All'epoca litigavamo di continuo. Non avevo mai lavorato e, come se non bastasse, ero quasi sempre alla Sala da tè Yanshang. Di conseguenza, mi ritrovai con grossi debiti... e in enorme difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960211,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960212,
					"content": "Mi dispiace...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "Beh, chi non ha mai fatto qualche sciocchezza da giovane? Comunque, ero nei guai e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960214,
					"content": "Qualcuno ha riconosciuto la mia Pietra arcaica e si è offerto di comprarla a un buon prezzo. Per me non è stato un problema, anzi avrei scambiato una pietra per una somma di Mora che mi avrebbe tirato subito fuori da quella brutta situazione. È stato un ottimo affare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960215,
					"content": "Ma l'altro giorno mio padre è venuto da me e mi chiesto dove avessi messo la pietra che mi aveva regalato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960216,
					"content": "Non sono riuscito a dirgli altro se non che era soltanto una pietra e che l'avevo persa da tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960217,
					"content": "Eppure, mi chiedo cosa sarebbe successo se non l'avessi venduta... Se l'avessi mostrata a mio padre quando l'ha menzionata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960218,
					"content": "...Lasciamo stare. Non ha senso chiedersi come sarebbe potuta andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960219,
					"content": "Almeno, il figliol prodigo è tornato a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960220,
					"content": "Hai ragione... Ma ho ancora molta strada da fare prima di poter cancellare il mio debito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960221,
					"content": "Ho divagato. Se ne trovate altre, portatemele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960222,
					"content": "Queste non ti bastano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "Portatemene altre tre. Poi dovrebbero bastare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960225,
					"content": "Le Pietre arcaiche sono rare. Anche se l'Unione di Huishan ne volesse altre, dubito fortemente che le potremmo trovare qui nella Voragine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960223,
					"content": "Ma quante te ne servono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "Forza, consegna prima la tua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}