				},
				{
					"id": 728130905,
					"content": "Piacere, sono Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130909,
					"content": "Beh, a ogni modo... Il generale chiamato Gorou mi ha chiesto di aiutarti con le tue ricerche sui fertilizzanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130910,
					"content": "Sarà un piacere collaborare con te d'ora in avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130911,
					"content": "Davvero...? Fantastico! Se riusciamo a preparare del fertilizzante, potremo avere più coltivazioni qui sull'Isola di Watatsumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130912,
					"content": "Non dimenticare di mettere il fertilizzante un po' più lontano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "Eh? Ah! Capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130914,
					"content": "Sì, il piacere è tutto mio, signorina Alrani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130915,
					"content": "Farò del mio meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130916,
					"content": "Farò del mio meglio. È per la mia tesi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130906,
					"content": "Una specialista di fertilizzanti di Sumeru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130907
					]
				},
				{
					"id": 728130907,
					"content": "Piacere, sono Alrani... Un momento. Specialista di fertilizzanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130908
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130908,
					"content": "So... so solo qualcosina in merito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "Alrani"
				}
			]
