					"Kaushik"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "#Il significato di questo totem... Mmmh? Viaggiat{F#rice}{M#ore}? Vuoi discutere con me di qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130702,
					"content": "Si tratta di Alrani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "Alrani è qui? Sull'Isola di Watatsumi? Strano... Come mai? Non dovrebbe essere a Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130704,
					"content": "È stata arrestata da alcuni soldati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "Che cosa? *sospira* Ovviamente. Venire sull'Isola di Watatsumi nelle circostanze attuali... È ovvio che abbiano sospettato di lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130706,
					"content": "Ma lasciamo perdere per ora. Andiamo subito ad aiutare quella scriteriata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				}
			]
		},
		{
			"id": 7281308,
