				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130801,
					"content": "Alrani! Sei davvero tu! M-Ma perché sei qui a Inazuma? Non dovevi essere a Liyue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130802,
					"content": "Beh... Oh, è una storia lunga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130803,
					"content": "Signor Kaushik, conosci Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130804,
					"content": "Oh, tu... tu sei il generale Gorou, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130805,
					"content": "Esatto. Alrani e io siamo entrambi ricercatori dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130806,
					"content": "Abbiamo lasciato l'Akademiya per condurre degli studi sul campo, ciascuno nella propria area di ricerca. Non pensavo l'avrei incontrata qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130807,
					"content": "Ma... ehm, voi ricercatori potete lasciare liberamente l'Akademiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130808,
					"content": "Non lo definirei un \"lasciare liberamente\". Alrani e io siamo entrambi driyosh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130809,
					"content": "Viaggiare e imparare fanno parte delle nostre ricerche, per questo possiamo lasciare l'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130810,
					"content": "Generale Gorou, posso garantire che Alrani dice il vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130811,
					"content": "Va bene, allora nessun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130812,
					"content": "Fiuuu... Sono salva... Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130813,
					"content": "Hiroyuki, Ookubo, questa faccenda è risolta. Tornate a occuparvi delle vostre mansioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130814,
					"content": "Sì, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130815,
					"content": "Sì, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130816,
					"content": "Sono desolato, signorina Alrani. Ti abbiamo scambiato per qualcuno di sospetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130817,
					"content": "Detto questo, sebbene abbiamo chiarito l'incomprensione, il fatto che tu sia piombata così sull'Isola di Watatsumi ci ha creato non pochi problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130818,
					"content": "Eh? Avete... avete intenzione di multarmi? M-Ma non ho molti Mora con me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130819,
					"content": "Beh, visto che sostenevi di essere una venditrice di fertilizzanti e che sei anche una ricercatrice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130820,
					"content": "C'è qualcosa che puoi fare per noi. C'è un uomo di nome Iwata che sta effettuando degli studi sui fertilizzanti. Potresti dargli una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130821,
					"content": "Se riuscirai ad aiutarlo a preparare del fertilizzante che non costituisca una minaccia pubblica, potrai condurre tutte le ricerche che vorrai qui, proprio come il signor Kaushik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130822,
					"content": "F-Fertilizzante? Un momento, ma... io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130823,
					"content": "Ce la farà!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "Alrani, questa è una buona opportunità per raccogliere informazioni per la tua ricerca. Dato che sei qui a Inazuma, immagino che la tua tesi non sia ancora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130826,
					"content": "Eh... Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130827,
					"content": "Sai quali sono gli standard per diplomarsi presso l'Akademiya. Se non riesci a diplomarti per diversi anni di fila...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130828,
					"content": "L-Lo farò, lo farò, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130829,
					"content": "H-Ho imparato molto sui fertilizzanti dal signor Vahid... Ce la farò al primo tentativo, vedrete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130830,
					"content": "Diplomarsi porta alla maturazione personale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "Bene, per oggi la chiuderei qui. Signorina Alrani, la questione del fertilizzante è nelle tue mani. Io devo occuparmi di altre questioni, quindi se volete scusarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130833,
					"content": "Ah, sì. Ricordate a Iwata di, ehm, spostare altrove il suo fertilizzante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130834,
					"content": "Va bene, io proseguirò le mie ricerche. Rivolgiti pure a me per qualunque tipo di domanda, Alrani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130831,
					"content": "Per diplomarsi serve molta motivazione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130824,
					"content": "Ce la puoi fare, Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				}
			]
		},
