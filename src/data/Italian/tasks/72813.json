				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwata",
					"Gorou",
					"Paimon",
					"Ookubo Daisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}, grazie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130302,
					"content": "Stavo preparando il fertilizzante quando quei mostri sono comparsi dal nulla e mi hanno attaccato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130303,
					"content": "#Davvero insolito... Ma sei arrivat{F#a}{M#o} al momento giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130304,
					"content": "Forse è colpa di quel mucchio di fertilizzante, sai...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "D-Davvero? Ho sentito dire che quest'odore è un segno che forse il fertilizzante ha funzionato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130306,
					"content": "Beh, a ogni modo vieni qui e dai un'occhiata al fertilizzante. Ti spiego mentre lo apro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130307,
					"content": "Fermi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130308,
					"content": "Eh? Signor Gorou? Non sapevo saresti passato di qui oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130309,
					"content": "Sei di pattuglia, Gorou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "Ehm... Lascia stare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130311,
					"content": "Questo mucchio di... roba è opera vostra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130312,
					"content": "Ahahah, sì. Questo fertilizzante l'abbiamo preparato noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130313,
					"content": "Signor Gorou, sei venuto qui anche tu a dare un'occhiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130314,
					"content": "Eheh, in tal caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130315,
					"content": "Fermo! Un momento. Non sono qui per questo. Beh, in realtà sì, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130316,
					"content": "La faccia di Gorou è tutta contorta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130317,
					"content": "Aggiorniamoci... in un luogo un po' più distante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130319,
					"content": "Allora, signor Gorou, perché sei qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 728130320,
					"content": "Ultimamente, molti residenti si sono lamentati di un terribile tanfo qui nei paraggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130321,
					"content": "Per sicurezza sono quindi venuto a indagare, seguendo l'odore fin qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130322,
					"content": "È così che vi ho trovato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130323,
					"content": "Iwata, ho saputo che stai studiando come preparare del fertilizzante, ma il modo in cui lo stai facendo è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130324,
					"content": "Un disturbo della quiete olfattiva...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "Esatto. A ogni modo, Iwata, potresti sbarazzarti di quel fertilizzante? Proveremo ad aiutarti a trovare un'altra soluzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130327,
					"content": "Ehi! Gorou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130328,
					"content": "Sono qui. Che è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130329,
					"content": "Abbiamo catturato una persona sospetta in periferia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130330,
					"content": "Stava agendo in modo molto furtivo, definendosi una... commerciante di fertilizzanti o qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130331,
					"content": "Ho ritenuto tali circostanze parecchio sospette, quindi l'ho fatta arrestare. Pensavo volessi assistere al suo interrogatorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130332,
					"content": "Fertilizzante di qua, fertilizzante di là... Che diamine sta succedendo oggi coi fertilizzanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130333,
					"content": "Va bene, ti raggiungo subito. Torna indietro e aiuta gli altri a mantenere l'ordine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130334,
					"content": "Iwata, occupati della faccenda del fertilizzante. Ne riparleremo più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130335,
					"content": "#Viaggiat{F#rice}{M#ore}, perché non vieni con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130336,
					"content": "In effetti non sembra esserci altro da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "Qualcuno che vende dei fertilizzanti? A Paimon suona familiare la cosa... Ma non le viene in mente nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130339,
					"content": "Ah, beh, vabbè. Andiamo a vedere che succede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728130337,
					"content": "Una commerciante di... fertilizzanti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "Un po' troppo intenso...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
