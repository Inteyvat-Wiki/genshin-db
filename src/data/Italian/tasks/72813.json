		{
			"id": 7281305,
			"completionStepIds": [
				7281306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7281306",
							"2"
						],
						"stepId": 7281306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiroyuki",
					"Alrani",
					"Gorou",
					"Ookubo Daisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130501,
					"content": "Ferma, non ti muovere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130502
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130502,
					"content": "N-Non mi sto muovendo! Mi avete chiesto di parlare e vi ho spiegato che sono davvero una ricercatrice dell'Akademiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130503
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130503,
					"content": "Non avevi detto che stai pubblicizzando dei fertilizzanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130504
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130504,
					"content": "Eh? Una ricercatrice dell'Akademiya non può anche pubblicizzare dei fertilizzanti? Ascoltatemi un attimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130505
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130505,
					"content": "È lei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130506
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130506,
					"content": "Sì, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130507
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130507,
					"content": "Quando l'abbiamo catturata si stava aggirando nei paraggi con fare sospetto e non la smetteva di prendere appunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130508
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130508,
					"content": "Gorou, sono convinto che si tratti di una spia dello Shogunato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130509
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130509,
					"content": "Non è vero e non lo sono mai stata! Ve l'ho già detto, sono una ricercatrice! Stavo solo raccogliendo informazioni per la mia tesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130510
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130510,
					"content": "Piantala! Ti stavi aggirando per un campo di battaglia solo per una tesi? Chi pensi di prendere in giro?! Stai architettando ben altro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130511
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130511,
					"content": "...E che cosa potrei mai architettare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130512,
						728130513
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130512,
					"content": "Oh, sei tu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				},
				{
					"id": 728130514,
					"content": "#Viaggiat{F#rice}{M#ore}! Oh, meno male! Ti prego, di' loro che non sono una malintenzionata! Sono qui solo per scrivere la mia tesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130515
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130515,
					"content": "La conosci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130516
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130516,
					"content": "Beh, sì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130517
					]
				},
				{
					"id": 728130517,
					"content": "Possibile che i ricercatori di Sumeru si spingano a tanto pur di diplomarsi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130518
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130518,
					"content": "In base a quello che hai detto, però, vi conoscete appena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130519
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130519,
					"content": "Inoltre, il fatto che lei sia una \"ricercatrice di Sumeru\" è qualcosa che ti ha solo raccontato, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130520
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130520,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130521
					]
				},
				{
					"id": 728130521,
					"content": "Mmmh... temo che non abbiamo in mano nessuna prova schiacciante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130522
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130522,
					"content": "Ma se garantisci tu per lei, magari non è un una malintenzionata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130523
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130523,
					"content": "Gorou, se posso permettermi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130524
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130524,
					"content": "Ti ricordi di Kaushik? Il ricercatore che sta studiando la cultura e la storia della nostra isola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130525
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130525,
					"content": "È qui da molto tempo e la sua identità di ricercatore è già stata verificata... Perché non gli chiediamo di confermarci se questa... venditrice di fertilizzanti è davvero una ricercatrice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130526
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130526,
					"content": "#Mi sembra un buon piano. Viaggiat{F#rice}{M#ore}, potresti portare qui Kaushik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130527
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130527,
					"content": "Io resterò qui a vegliare su questa venditrice di fertilizzanti, non si sa mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130528
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130528,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130529
					]
				},
				{
					"id": 728130529,
					"content": "Affido tutto a te. Fa' presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130513,
					"content": "Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				}
			]
		},
