			"dialogs": [
				{
					"id": 750101201,
					"content": "Vedo che sei tornato, piccoletto. Com'è andata? Ti sei fatto degli amici alpaca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101202
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101202,
					"content": "Roar! Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101203,
					"content": "Ahah, sprizzi di gioia! Stai riempiendo di gioia anche me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101204
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101204,
					"content": "#Ehi, Wactana, non dovresti preoccuparti un po' di più di quello che succede agli alpaca? Quello con cui {REALNAME[ID(2)|SHOWHOST(true)]} ha fatto amicizia era in una brutta situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101205,
					"content": "Davvero? Allora devo parlare con Tortino, e dirgli di fare più attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101206,
						750101208
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101206,
					"content": "Non vedo una briciola di agitazione in te...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101207
					]
				},
				{
					"id": 750101207,
					"content": "Voglio dire, sto vivendo un vero e proprio sogno! Cercate di essere felici per me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101211,
					"content": "#Ah, sì. Se {REALNAME[ID(2)|SHOWHOST(true)]} vuole tenere quell'alpaca giocattolo qui a fianco, può averlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101212
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101212,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101213,
					"content": "#Sembra che {REALNAME[ID(2)|SHOWHOST(true)]} non sia tipo da fare tanti complimenti, eheh. Grazie, Wactana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101214,
					"content": "#Eh, di nulla. Tornate pure quando volete, siete sempre {F#le}{M#i} {F#benvenute}{M#benvenuti}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101208,
					"content": "Tortino non è in una situazione semplice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101209
					]
				},
				{
					"id": 750101209,
					"content": "Certo... Ma per indole tende sempre a preoccuparsi. Se lo sollevassi dai doveri di guardia degli alpaca, comincerebbe a perdere il pelo per via dello stress!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101210
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101210,
					"content": "Miglior situazione di questa non c'è. È soddisfatto del suo lavoro, e io mi godo una vita tranquilla. Tutti felici e contenti, non trovi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101211
					],
					"speakerTitle": "Wactana"
				}
			]
		},
