			"dialogs": [
				{
					"id": 750100201,
					"content": "Ah. Qualcosa di peloso. Qualcosa di peloso sta bloccando il vostro cammino...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100202
					]
				},
				{
					"id": 750100202,
					"content": "Mmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100203
					],
					"speakerTitle": "Alpaca vigoroso"
				},
				{
					"id": 750100203,
					"content": "Roarrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100204
					],
					"speakerTitle": "\"Tortino\""
				},
				{
					"id": 750100204,
					"content": "Mmmmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100205
					],
					"speakerTitle": "Alpaca vigoroso"
				},
				{
					"id": 750100205,
					"content": "Eh? Quindi siete tutti amici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100206,
					"content": "Roar! Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100207,
					"content": "Qualcuno che sembra essere a supervisione degli alpaca si avvicina e calma lo Yumkasauro...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100208
					]
				},
				{
					"id": 750100208,
					"content": "Ehi, ehi, calmati, Tortino. Vedi, è per questo che ti han dato quel nome, i tuoi giudizi sono troppo avventati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100209
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100209,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100210
					],
					"speakerTitle": "\"Tortino\""
				},
				{
					"id": 750100210,
					"content": "Non preoccuparti per lui, ha un forte senso del dovere. Si agita quando arrivano degli sconosciuti. Ma è anche grazie a questo che riesco a prendermi cura di questi alpaca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100211,
					"content": "Ehi! Cosa ci fate qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100212,
						750100214
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100212,
					"content": "#Stiamo solo girando. Sai, siamo de{F#lle}{M#gli} {F#avventuriere}{M#avventurieri}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100213,
					"content": "#Ah, {F#avventuriere}{M#avventurieri}! Immagino che Tortino vi abbia scambiato per delle persone pericolose dall'aura terrificante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100216,
					"content": "Uh. Paimon non sapeva che gli Yumkasauri potessero fare una cosa simile. E noi che pensavamo che gli alpaca stessero per essere attaccati! A quanto pare era un malinteso, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100217,
					"content": "Sì, ed è anche molto comune. So che il mio amico ha un aspetto minaccioso, ma è molto amico di quegli alpaca. Possono dirsi veri e propri amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100218
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100218,
					"content": "Rrrooo... Roar! Roar! Roarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100219,
					"content": "Mmh? Cosa c'è, piccoletto? Vuoi fare amicizia anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100220
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100220,
					"content": "Roar! Roooooooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100221
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100221,
					"content": "Wow, immagino di sì. Ma è vero, di solito vai in giro solo con noi due. Amici animali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100222,
					"content": "Sarebbe un'ottima cosa per lui, sì. E sarebbe anche una scenetta adorabile, non credi? Un piccolo Tepetlisauro circondato dagli amici alpaca? Io potrei mangiare tre ciotole di stufato di carne abbrustolita prima di annoiarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100223
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100223,
					"content": "Tuttavia, dipende se i miei alpaca accetteranno o meno. L'amicizia non si può forzare, non credi, Tortino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100224
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100224,
					"content": "Mmmh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100225,
						750100228
					],
					"speakerTitle": "\"Tortino\""
				},
				{
					"id": 750100225,
					"content": "#Ah, ehi! A qualcuno non va di fare amicizia con {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100226
					]
				},
				{
					"id": 750100226,
					"content": "#Ehi, ehi, non c'è bisogno di stare sulla difensiva! Diamo a {REALNAME[ID(2)|SHOWHOST(true)]} la possibilità di provare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100227,
					"content": "I bambini crescono quando imparano a cavarsela da soli, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100231,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100232
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100232,
					"content": "Beh, il tuo Tepetlisauro sembra avere disinvoltura da vendere. Penso che me ne andrò a riposare. Se ci sono problemi, fammelo sapere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100233
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100233,
					"content": "Un attimo, sai che ti dico? Tanto vale chiamare Tortino, invece. È lui l'esperto di alpaca, dopotutto... Scherzo, scherzo. Ok, piccoletto, è tutto nelle tue mani. Buona fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100228,
					"content": "#Va bene così. Qualsiasi cosa succeda, ci siamo noi con {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100229
					]
				},
				{
					"id": 750100229,
					"content": "Uh, Paimon sa che stai cercando di essere gentile nel caso in cui le cose non vadano per il verso giusto... Ma non è necessario essere pessimisti fin dall'inizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100230,
					"content": "#I bambini hanno bisogno di più incoraggiamenti per crescere sani e forti! Esatto, {REALNAME[ID(2)|SHOWHOST(true)]}, puoi farcela! Paimon crede in te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100214,
					"content": "Ultimamente ho pensato a una vita idilliaca e pastorale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100215
					]
				},
				{
					"id": 750100215,
					"content": "Allora sei nel posto giusto. Lascia che il tuo Saurico si occupi degli alpaca, come faccio io, e il mondo sarà a tua disposizione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				}
			]
		},
		{
