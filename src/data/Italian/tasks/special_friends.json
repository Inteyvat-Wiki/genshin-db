						750101608,
						750101610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101608,
					"content": "#Un tuo amico, {REALNAME[ID(2)|SHOWHOST(true)]}, è un mio amico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750101609
					]
				},
				{
					"id": 750101609,
					"content": "E anche di Paimon... Aspetta, da quando è diventata una gara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101612,
					"content": "Comunque, è un po' pericoloso che quell'alpaca sia qui tutto solo. Meglio andare a dirlo a Wactana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101613,
					"content": "#E poi, sarà sicuramente felice che {REALNAME[ID(2)|SHOWHOST(true)]} ha fatto una nuova amicizia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750101610,
