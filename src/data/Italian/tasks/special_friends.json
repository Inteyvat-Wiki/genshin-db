					"Wactana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750100101,
					"content": "\"Non ho grandi obiettivi o ambizioni. Sono una pastorella felice, senza condizioni. Solo dei miei alpaca mi prendo cura, tra stagioni, brezze, fresche piogge e ogni coltura...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100102
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100102,
					"content": "È la mia canzone preferita. Che ne pensi? Non male, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				}
			]
		},
