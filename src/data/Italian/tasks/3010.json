			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "Paimon si ricorda tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100102,
					"content": "#Bene, questa volta vi siete adattat{F#e}{M#i} rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100103,
					"content": "Alla fine di ieri sera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "#Nonostante ieri sera ci fossimo tolt{F#e}{M#i} i Terminali dell'Akasha, abbiamo sentito ancora quel bip. Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100105,
					"content": "Ci è stato impiantato un terminale in un'altra forma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "Ma ora possiamo almeno confermare una cosa: l'Akasha ha sicuramente qualcosa a che fare con ciò che ci intrappola in questo ciclo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100108,
					"content": "Paimon non capisce... Perché l'Akasha si spinge a tanto se vuole solo la saggezza di tutti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100109,
					"content": "È estremamente difficile per le cavie da laboratorio di un esperimento capire perché vengono trattate in quel modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100110,
					"content": "Se noi siamo cavie da laboratorio, allora tu cosa sei? Nahida, non ci hai mai detto nulla di te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100111,
					"content": "Mmmh... Credo di essere la Luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100112,
					"content": "La Luna? Non era il risultato della nostra divinazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100113,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "In ogni caso, sapere chi sono non vi aiuterà ad avvicinarvi alla verità, quindi dovreste concentrarvi su altre cose. Non distraetevi e non ignorate nessun indizio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100115,
					"content": "#Va bene, allora... Dehya ci ha aiutat{F#e}{M#i} molto ieri, andiamo a cercarla. Se Paimon ha fatto bene i conti, quei rapitori dovrebbero arrivare presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100106,
					"content": "Non abbiamo davvero spezzato il legame con i terminali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "Ah, eccovi. Mi sono già occupata di quei rapitori. Milady, si è fatta male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100202,
					"content": "Aspetta un attimo, qualcosa non torna...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "Eh? Dehya!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100204,
					"content": "Cosa c'è? Perché mi state fissando in quel modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100205,
					"content": "N-Non ti sei fatta male questa volta?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100206,
					"content": "#Eh? Cosa intendi con \"questa volta\"? Perché siete così sorpres{F#e}{M#i} che ne sia uscita indenne? Quei tizi erano dei dilettanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100207,
					"content": "Non ti stai ancora abituando al tuo nuovo spadone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "Shhh... Come fate a sapere del mio spadone? Non ne ho parlato con nessuno. Vi prego, non ditelo alla signorina Dunyarzad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100210,
					"content": "Quindi alla fine Dehya ha perso la memoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100211,
					"content": "Durante la tua battaglia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "Qualcosa di strano...? Sapete già che ho un nuovo spadone. Uhm... se devo essere onesta, è strano che un'arma così nuova sembri tanto familiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100214,
					"content": "È come se... l'avessi già usato per combattere un numero infinito di battaglie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100215,
					"content": "Stai dicendo che anche se non ricordi di averlo usato, il tuo corpo... si sente come se l'avesse fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100216,
					"content": "Proprio così. Sia i mercenari che i guerrieri si affidano molto sulla memoria muscolare. La sola conoscenza della teoria della battaglia non porta da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100217,
					"content": "#Viaggiat{F#rice}{M#ore}, cosa ne pensi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100218,
					"content": "Sarà perché abbiamo rimosso i nostri Terminali dell'Akasha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "Già, Paimon si sente davvero fiduciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100221,
					"content": "#È possibile che... ci siamo già liberat{F#e}{M#i}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "Oooh, è vero! Prima, nel samsara, una cosa del genere non sarebbe mai accaduta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100223,
					"content": "Lo sapremo con certezza alla fine della giornata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "Non ho idea di cosa stiate parlando, ma qui è ancora pericoloso, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100225,
					"content": "Quindi vuoi che portiamo Dunyarzad da qualche altra parte a riposare mentre tu controlli se ci sono altri rapitori in giro, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100226,
					"content": "Come facevate a sapere cosa avrei detto...? Sapete leggere nel pensiero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100227,
					"content": "Lascia perdere, vai a fare le tue cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100219,
					"content": "Non era mai successo prima...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "Non hai avvertito qualcosa di strano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "Quella mancanza di familiarità di solito ti procura qualche graffio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "Fiuuu, finalmente è notte. A parte il fatto che Dehya non si è ferita, tutto sembra essere rimasto invariato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100302,
					"content": "Ascolta, Nahida! Abbiamo scoperto che Dehya se l'è cavata bene oggi, mentre le altre volte è sempre rimasta ferita quando ha lottato contro i rapitori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100303,
					"content": "Pensi che il samsara sia stato spezzato? Abbiamo salvato Dunyarzad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100304,
					"content": "Davvero? Ottimo lavoro, avete fatto dei progressi. Godetevi un bel riposo stanotte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100305,
					"content": "Ehi, che razza di risposta è questa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100306,
					"content": "\"Il domani arriverà\". Tutti lo danno per scontato, ma l'unico modo per saperlo con certezza è viverlo, il domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100307,
					"content": "Quanti \"oggi\" sono passati? È possibile che a \"oggi\" segua \"ieri\"? Il \"domani\" esiste davvero, al di là di un concetto inventato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100308,
					"content": "È persino possibile che l'intero mondo sia una menzogna e che la sua storia sia stata solo un infinito Festival del Sabzeruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100309,
					"content": "Va bene, va bene, basta! Il cervello di Paimon si è già spento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100310,
					"content": "Eheh... Ecco perché non ha senso sprecare le proprie energie pensando alle cose che si impareranno domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100311,
					"content": "Riposate un po'! Tipo... andate in bagno e poi tirate lo sciacquone per affogare tutta quell'ansia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100312,
					"content": "Eh? Aspetta, cos'hai appena detto? Paimon ha sentito bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100313,
					"content": "La gente dice sempre di provare un senso di sollievo dopo essere andata in bagno. Per questo l'ho suggerito. È così strano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100314,
					"content": "Ugh... È così strano e così contrario al buon senso che Paimon è senza parole... Un minuto fa stavi facendo discorsi talmente intelligenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100315,
					"content": "Andiamo a riposare un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100316
					]
				},
				{
					"id": 30100316,
					"content": "#Già... Anche se il Festival del Sabzeruz ogni giorno è pieno di allegria e vivacità, sembra sia passato molto tempo dall'ultima volta che ci siamo rilassat{F#e}{M#i}. Torniamo nella nostra stanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100317,
					"content": "*bip*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100318,
					"content": "Continuiamo la raccolta. Rispetto ai risultati che otterremo, questi sacrifici sono insignificanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azar"
				}
			]
		},
		{
			"id": 301005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
