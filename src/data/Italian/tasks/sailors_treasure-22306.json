					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223060301,
					"content": "Sì, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060302
					]
				},
				{
					"id": 223060302,
					"content": "Va bene... Ecco fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060303,
					"content": "Buona fortuna! E non dimenticarti di riportare qui il tesoro, se lo trovi... Lo divideremo in tre parti, come da accordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
