		{
			"id": 7410025,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Al",
					"Petit Chou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002501,
					"content": "Se riusciremo a recuperare il tesoro della Principessa Lyris, le forze della giustizia cresceranno con il passare del tempo! Il giorno della nostra vittoria su Narcissus si avvicina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002502
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002502,
					"content": "...Per questo non possiamo dimenticare l'eroico sacrificio di Ney: se non avesse nascosto il tesoro, Narcissus avrebbe sicuramente già fatto breccia nella torre dove risiede la principessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002503
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002503,
					"content": "Sì! Ney è incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002504
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002504,
					"content": "#Non permetteremo che gli sforzi di Ney siano stati vani, né mancheremo di onorare lo straordinario aiuto di {NICKNAME}! Questa volta, con l'aiuto di tutti, salveremo la principessa Lyris!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002505
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002505,
					"content": "Esatto! Salveremo la principessa Lyris e poi, e poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002506
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002506,
					"content": "E poi il Regno di Narzissenkreuz sarà riportato alla sua gloria passata! La principessa ti potrà nuovamente stringere fra le sue braccia, pettinare le piume e accarezzare la piccola fronte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002507
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002507,
					"content": "I ricordi perduti nelle acque riemergeranno, e tutti i nostri amici si stringeranno attorno alla principessa ridendo assieme! Sarà una scena di gioia e mai più rivedremo problemi o dispute all'orizzonte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002508
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002508,
					"content": "Proprio come prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002509
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002509,
					"content": "...Esattamente, proprio come prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Al"
				}
			]
		},
		{
			"id": 7410026,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#{NICKNAME}, sei tu! Quando troveremo il tesoro di Mademoiselle Lyris, avremo la vittoria in pugno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002602,
					"content": "Avremo finalmente la possibilità di sconfiggere gli invasori e salvare Mademoiselle Lyris! E così, l'Orchestre Jak si esibirà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002603,
					"content": "La sezione finale dell'introduzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002604,
					"content": "Seriamente? È solo l'introduzione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "Oh? Pensavi davvero che tutto sarebbe finito dopo aver salvato la signorina Lyris e il regno? Ah! Il mondo reale non è come una semplice storiella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002607,
					"content": "È proprio perché ci sono persone ingenue che la pensano come te che la storia si ripete in continuazione! Il prossimo passo è ovviamente rovesciare la struttura di classe profondamente radicata e i metodi di distribuzione della ricchezza nella società.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002608,
					"content": "In un mondo ragionevolmente paritario, l'uguaglianza dovrebbe essere lo stato delle cose logico, ed è l'obiettivo che si è posta Mademoiselle Lyris. Ora, la considerazione per le circostanze attuali ha portato alla debita giustapposizione di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002609,
					"content": "Meglio tagliare la corda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "Prima di tutto, basandoci naturalmente su... dovremmo... costruire... e rovesciare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002605,
					"content": "Pensavo che fosse il culmine della sinfonia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
		{
			"id": 7410031,
