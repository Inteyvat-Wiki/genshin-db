			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "*annusa*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003102,
					"content": "Bau bau! Brava persona. Accarezzare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003103,
					"content": "Ma certo, a Mori vanno tutte le carezze e i grattini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "Accarezzi Mori.\\nDato che Mori è (un cane) fatto d'acqua, è piuttosto bagnato.\\nMa sembra piuttosto felice.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "Bau bau! Grazie, brava persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003106,
					"content": "Mori, ti farò ancora più carezze, la prossima volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "Bauuu... Mori cattivo, quindi no carezze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003108,
					"content": "Cosa c'entra con l'essere bravi o cattivi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "Bau bau! Cani bravi vengono accarezzati. Cani cattivi vengono... riparati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003110,
					"content": "*piagnucola*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003111,
					"content": "Vedendo Mori triste, allunghi la mano per accarezzarlo.\\nDato che Mori è (un cane) fatto d'acqua, è piuttosto bagnato.\\nGli occhi blu di Mori riprendono ora a brillare.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "Bau bau! Grazie per le carezze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				}
			]
		}
	]
