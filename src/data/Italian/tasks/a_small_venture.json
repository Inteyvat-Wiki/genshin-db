			"dialogs": [
				{
					"id": 761390101,
					"content": "Al giorno d'oggi, è difficile guadagnarsi da vivere nel mondo editoriale. Forse dovrei concentrarmi sugli investimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390102,
					"content": "Posso vedere i coupon d'investimento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "Va bene. 2.000 Mora a coupon, con ogni periodo d'investimento della durata pari a una settimana. Puoi metterli nella borsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390104,
					"content": "...Urgh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390105,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "N-Nulla. Semplicemente non mi aspettavo una sua visita, Lady Nefer. Intende forse... acquistare un coupon d'investimento anche lei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390107,
					"content": "#Oh, no, grazie. Sono qui insieme {F#alla mia amica}{M#al mio amico} per dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390108,
					"content": "Ho sentito che i suoi investimenti vanno a gonfie vele, signor Dhabit. Ora che sono qui a verificare di persona, posso confermare la veridicità di queste voci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390109,
					"content": "Oh, non è niente di che, ahah... Solo una piccola attività per sbarcare il lunario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390110,
					"content": "Davvero è possibile guadagnare così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "Ma certo. Il signor Dhabit è un uomo d'affari eccezionale. Basta seguire le sue indicazioni e non si incorrerà in alcuna perdita. Dico bene, signor Dhabit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390112,
					"content": "Sì, sì... ahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390113,
					"content": "Bene, allora. Vediamo se la fortuna è dalla mia oggi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "O-Oggi, eh... B-Beh, si dà il caso che tu abbia acquistato il nostro nuovo... coupon d'investimento a breve termine! E non finisce qui! I profitti e le perdite di questo coupon saranno calcolati immediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390115,
					"content": "Paimon ha come l'impressione che te lo sia appena inventato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390116,
					"content": "Ma... Ma figurati! C-Comunque, grazie mille per l'acquisto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390117,
					"content": "Ecco i profitti dei tuoi investimenti. Ti auguro una magnifica giornata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390118,
					"content": "Beh... Guadagnare Mora è sempre un bene, suppongo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "Davvero? Hihi, allora Paimon ne vuole una a forma di uccellino! È la preferita di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390121,
					"content": "Allora tolgo anch'io il disturbo. Come ho già detto, signor Dhabit, lei è davvero all'altezza della sua reputazione: un mercante onesto come pochi. Mi auguro che la sua attività possa prosperare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390122,
					"content": "La ringrazio per le sue parole gentili, Lady Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390123,
					"content": "Quanto a quella faccenda per cui le avevo chiesto aiuto l'altra volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390124
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390124,
					"content": "Abbiamo trovato quello che sta cercando, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390125,
					"content": "Abbia pazienza, signor Dhabit. Un passo alla volta, è così che si fanno gli affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390126
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390126,
					"content": "O-Oh, sì, ha ragione, naturalmente... Allora, lascio la questione nelle sue mani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390119,
					"content": "Forza, Paimon, andiamo a comprare delle sculture di zucchero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				}
