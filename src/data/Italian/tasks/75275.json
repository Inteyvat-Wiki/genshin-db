					],
					"speakerTitle": "Stele di pietra"
				},
				{
					"id": 752750204,
					"content": "...costruito questo santuario... onore ai caduti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stele di pietra"
				}
