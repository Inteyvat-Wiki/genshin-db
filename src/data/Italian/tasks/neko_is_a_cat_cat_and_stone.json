			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke",
					"Etsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "Ah, ciao. Cosa state facendo oggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120202,
					"content": "Aiutiamo Neko a realizzare una statua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "Eh... Cosa? Una statua, qui? Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120204,
					"content": "I-Imparerò subito a scolpire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120205,
					"content": "Dubito che farai in tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "Oh, è un'altra delle richieste di Neko?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120207,
					"content": "Sapete, non credo che sarà difficile trovare artigiani in cerca di lavoro, con i problemi che abbiamo avuto a Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120208,
					"content": "La Gilda ha ricevuto un bel po' di incarichi in questo campo, e ho sentito che c'è ancora gente in cerca di lavoro a Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120209,
					"content": "Durante un incarico ho trovato proprio un accampamento di queste persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120210,
					"content": "Quindi, se volete, potete tentare la fortuna lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120211,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "Eh, non c'è problema, non era così difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120215,
					"content": "E sapete una cosa? Alla fine piacerebbe anche a me vedere se questo santuario tornerà davvero a prosperare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120216,
					"content": "Specialmente quella \"Hibiki\" di cui Neko parla tanto. Mi chiedo che tipo di persona sia per essere così amata da un gatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120217,
					"content": "Oh, non prestatemi attenzione, sto parlando da sola. Andate a cercare quell'artigiano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120218,
					"content": "Quanto al fatto che sappiano scolpire la roccia o meno... Beh, immagino che dipenda dalla fortuna, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120219,
					"content": "Andiamo, Etsuko, anche tu vuoi aiutare Neko, vero? Ahah, sei proprio una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120220,
					"content": "Taisuke, il nostro piano di esplorazione è già pronto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120221,
					"content": "Ehm... Ho quasi finito. Scusa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120212,
					"content": "Sembri diversa dal solito, Etsuko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "#Che c'è, non siete abituat{F#e}{M#i} al fatto che vi dia informazioni di mia spontanea volontà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "Etsuko"
				}
			]
		},
		{
