					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120301,
					"content": "*sospira* Chissà se troverò mai un committente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120302,
					"content": "Cercavate me? Di cosa si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120303,
					"content": "Sai scolpire la pietra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "Eh? Oh... Fantastico! L'avete trovato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120306,
					"content": "Aspettate, chiedo scusa, ho dimenticato di presentarmi. Sono Ooshima Junpei, e lavoravo a Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120307,
					"content": "Dopo l'incidente, siamo stati tutti evacuati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120308,
					"content": "Ma finora, non ho ricevuto notizie su un possibile ritorno al lavoro, quindi sono stato disoccupato per tutto questo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120309,
					"content": "Quindi cercate qualcuno che sappia scolpire la pietra, giusto? Beh, non è esattamente la mia specialità, ma un po' me la cavo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120310,
					"content": "Che tipo di scultura vi serve? Me lo potete dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120311,
					"content": "Bene, la situazione è questa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "Mmmh... Quindi, fatemi capire, una gatta parlante vuole che troviate un artigiano che scolpisca una statua a sua immagine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120313,
					"content": "Non è che non vi creda o altro, è solo un po'... ehm, stravagante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120314,
					"content": "E anche se fossi d'accordo, come dovrebbe pagarmi quella... quella Gran Sacerdotessa provvisoria? Non ho intenzione di lavorare gratis, non importa cosa dicono gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120315,
					"content": "Rilassati, andrà tutto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "(Speriamo che tu abbia ragione...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120317,
					"content": "Davvero? Io... mmmh, ho l'impressione che mi stiate imbrogliando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120318,
					"content": "Comunque... Sapete cosa? Non importa, invece di restarmene qui con le mani in mano, tanto vale che venga con voi a dare un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120319,
					"content": "Spero davvero di poter essere pagato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 722120304,
					"content": "Stiamo cercando un artigiano che sappia lavorare la pietra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
		{
			"id": 7221204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221205",
							"2"
						],
						"stepId": 7221205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Ooshima Junpei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120401,
					"content": "#Ah, siete tornat{F#e}{M#i}. Questo è l'uomo della pietra, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120402,
					"content": "È l'artigiano che abbiamo assunto, sì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "Cosa?!? La gatta... parla davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120405,
					"content": "Miao miao miao, tutto questo stupore per così poco... È così strano che sappia parlare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120406,
					"content": "Non c'è bisogno di agitarsi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "Aspettate, state dicendo che è completamente normale per voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120409,
					"content": "Beh, sì, diciamo che ormai è la normalità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "Ma che genere di avventure avete vissuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120411,
					"content": "Suvvia, non siamo qui per chiacchierare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120412,
					"content": "Torniamo al nocciolo del discorso. Uomo della pietra, puoi battere un sasso affinché mi assomiglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120413,
					"content": "Eh? Uomo della pietra? Sarei io?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120414,
					"content": "\"Battere un sasso\"... Beh, posso provare a lavorare la pietra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120415,
					"content": "Ah sì? Meraviglioso, miao miao miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120416,
					"content": "Q-Quindi è così, eh... Beh, avere un lavoro è meglio di niente. Voglio dire, non ho mai lavorato per un gatto prima, quindi... Immagino che discuteremo del mio compenso più tardi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120417,
					"content": "Mmmh. In ogni caso, dovrò fare dei preparativi. Ci sono parecchie rocce su quest'isola, dovrò sceglierne una buona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120418,
					"content": "Ah, sì. Come devo chiamarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120419,
					"content": "Sono Neko, la Gran Sacerdotessa provvisoria del Santuario di Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120420,
					"content": "Per quanto riguarda il modo di rivolgerti a me, chiamami come vuoi, alto umano battipietre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120421,
					"content": "Oh, capisco... Bene, allora suppongo che la chiamerò Somma Sacerdotessa. Dopotutto, lei è la mia committente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120422,
					"content": "Cos'è un \"commiaottente\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120423,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120424,
					"content": "B-Beh, ehm... Andrò a dare un'occhiata in giro e a scegliere una roccia da usare, voi restate qui per ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120425,
					"content": "Lavorare per una gatta. Beh, c'è una prima volta per tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120426,
					"content": "Il signor Ooshima sembra aver completamente dimenticato il pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120407,
					"content": "È solo una gatta parlante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "Sì, l'uomo della pietra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
		},
