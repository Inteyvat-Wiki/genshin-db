			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "Tempismo impeccabile. Ho ancora bisogno del vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120102,
					"content": "Vai, ci siamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "Vorrei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120104,
					"content": "Aggiungere al santuario una pietra alta e grande, fatta a mia immagine e somiglianza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120105,
					"content": "E dove dovremmo trovare una cosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120106,
					"content": "Intende una statua, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "Chiamatela come volete, desidero qualcosa di simile a quelle pietre di volpi su quell'isola lontana, lontana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120108,
					"content": "Hibiki diceva che ce n'erano molte su quell'isola, e mi ha anche chiesto se ne volevo una che mi somigliasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120109,
					"content": "Ho la sensazione che debba essere una cosa buona, visto che Hibiki la voleva. Per questo, vi chiedo di far realizzare una pietra simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120110,
					"content": "Non ho alcuna abilità nella scultura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "Mmmh, come facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120112,
					"content": "Oh, perché non chiediamo a Taisuke? Gli piacciono molto i gatti e potrebbe essere disposto a dedicarsi alla scultura solo per aiutare Neko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120113,
					"content": "Beh, proviamo a chiedere a Taisuke...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "È vero! È così affezionato ai gatti, forse può aiutarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221202",
							"2"
						],
						"stepId": 7221202,
