			"dialogs": [
				{
					"id": 722120601,
					"content": "Eppure sono curiosa... Come farà una cosa dura come la pietra ad assumere il mio aspetto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120602,
					"content": "Quell'uomo della pietra è molto potente? Può usare qualche magia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120603,
						722120605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120603,
					"content": "Oh, è potentissimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120604
					]
				},
				{
					"id": 722120604,
					"content": "Ah, capisco. Meraviglioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120605,
					"content": "È come quella volta che ti abbiamo preparato da mangiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120606
					]
				},
				{
					"id": 722120606,
					"content": "Ah, capisco. I pasti che avete fatto tu e Hibiki erano cose buone, quindi anche l'uomo della pietra farà un buon sasso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120607,
					"content": "Sembra che ogni tanto gli umani nascondano una certa abilità. Vi ringrazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
