			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lily",
					"Rudolf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200291901,
					"content": "Ma babbo, è una brava persona, e racconta tante storie belle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200291902
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200291902,
					"content": "Lily, le cose non sono così semplici... *sospira* Ascolta... Papà ti spiegherà meglio quando sarai grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rudolf"
				}
			]
		},
		{
			"id": 2002927,
