				"points": []
			},
			"dialogs": [
				{
					"id": 200290501,
					"content": "#G-Grazie, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "Schuster terrorizzato"
				},
				{
					"id": 200290502,
					"content": "Quei mostri non smettevano più di inseguirmi, anche dopo aver corso fin qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "Schuster terrorizzato"
				},
				{
					"id": 200290503,
					"content": "Sei qui per raccogliere qualche Bacca uncinata, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "Eh? Sì, è stata Marjorie a chiedermelo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "Schuster terrorizzato"
				},
				{
					"id": 200290505,
					"content": "Non potevi portare qualcun altro con te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "...Su, chi mai avrebbe accettato di venire con me per lavorare a un incarico semplice come \"raccogliere delle piante\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "Schuster terrorizzato"
				},
				{
					"id": 200290508,
					"content": "Ovviamente so come funziona, ma si possono trovare delle Bacche uncinate solo qui, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "Schuster terrorizzato"
				},
				{
					"id": 200290509,
					"content": "E tutte le bacche uncinate che crescono in zone più sicure sono già state raccolte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "Schuster terrorizzato"
				},
				{
					"id": 200290510,
					"content": "Quindi mi sono allontanato per raccogliere le Bacche uncinate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "Schuster terrorizzato"
				},
				{
					"id": 200290511,
					"content": "Ma lasciamo perdere, per il momento. Potresti aiutarmi a portare queste Bacche uncinate a Marjorie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "Schuster terrorizzato"
				},
				{
					"id": 200290512,
					"content": "Ho bisogno di un momento per riposarmi. Pensavo che le gambe mi abbandonassero laggiù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schuster terrorizzato"
				},
				{
					"id": 200290507,
					"content": "Per favore, non andare così lontano per conto tuo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
		{
			"id": 2002906,
			"completionStepIds": [
				2002906
