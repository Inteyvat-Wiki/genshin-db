			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200292801,
					"content": "Bene, penso che sia finalmente giunto il momento di tornare a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292802
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292802,
					"content": "Ci abbandoni, Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200292803
					]
				},
				{
					"id": 200292803,
					"content": "Eh? Ah, sei tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292804,
					"content": "Esatto. Recentemente ho ricevuto ordini dall'alto: posso tornare a Snezhnaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292805,
					"content": "Non devo più restare a Mondstadt in attesa di nuovi ordini, visto che sarò trasferito presso un altro Messaggero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200292806,
					"content": "Non so proprio a quale di loro dovrò sottostare questa volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290107,
					"content": "Quando parti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "I superiori non l'hanno menzionato. Mi hanno detto soltanto di preparare le mie cose e di essere pronto a partire in qualsiasi momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290109,
					"content": "Cioè, è fantastico, no? Finalmente sarò libero dagli sguardi inquisitori delle sorelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290110,
					"content": "#Ah, giusto, viaggiat{F#rice}{M#ore}. Visto che abbiamo fatto affari insieme per così tanto tempo... Perché non mi fai un ultimo favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290111,
					"content": "Come al solito, tu fai il tutto, e io ti sgancio i soldi. Quando lavori per me, non lavori mai gratuitamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290112,
					"content": "Che storie mi racconterai stavolta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "Ahahah. A essere sinceri, non ho più storie dei Fatui da raccontarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290115,
					"content": "Questa volta ti pagherò sicuramente in Mora. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290116,
					"content": "Beh, a meno che tu non voglia che ti racconti le stesse favole che racconto a Lily...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290117,
					"content": "A cosa ti serve il mio aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "Sai cosa? Sarò sincero. Questa volta la richiesta ha anche a che fare con lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290121,
					"content": "Lei è... Beh, lei è la sola persona in tutta Mondstadt che ascolti tutto quello che \"il malefico zio Fatui\" racconta. Oltre a te, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290122,
					"content": "Dubito che tornerò mai a Mondstadt... Quindi volevo inviare a Lily un ultimo ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290123,
					"content": "Ma come ben sai, se solo uscissi e andassi a comprare qualcosa, sarebbe come avventurarsi su un campo di battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290124,
					"content": "Quindi, non posso fare altro che affidarti questo incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290125,
					"content": "Basta che vai da Marjorie e che mi aiuti a vedere se ha qualche regalo che potrebbe piacere a una bambina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290118,
					"content": "Fai ancora compagnia a Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "Ehm.. Beh... A volte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290113,
					"content": "Ahi, le storie dei Fatui non mancano mai quando ci sei tu nei paraggi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		}
	]
}