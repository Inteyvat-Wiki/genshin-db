				"points": []
			},
			"dialogs": [
				{
					"id": 200291701,
					"content": "Aiutami a consegnare il regalo a Lily. Dovrebbe essere <color=#00E1FFFF>vicino alla piazza</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200291702
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200291702,
					"content": "Se andassi di persona, sono sicuro che Rudolf mi guarderebbe malissimo per tutto il tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2002919,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
