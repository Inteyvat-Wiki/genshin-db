					"id": 200290903,
					"content": "Bene. Immagino che Rudolf abbia già condiviso la sua opinione da due Mora al riguardo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290904
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290904,
					"content": "Tsk, non serve neanche tu lo dica. Nessuno si fida di un Fatuus qui a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290905
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290905,
					"content": "Quando parti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290906
					]
				},
				{
					"id": 200290906,
					"content": "L'ordine ufficiale non è ancora arrivato. Ho preparato le mie cose in anticipo, e starò al Grand Hotel Goth per adesso... Pronto a partire in qualsiasi momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290907
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290907,
					"content": "Dai, perché questa faccia seria? Hai intenzione di dirmi addio in maniera formale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290908
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290908,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290909
					]
				},
				{
					"id": 200290909,
					"content": "Ahah, bene. Così ci siamo. Non siamo amici. Siamo solo soci occasionali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290910
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290910,
					"content": "Vienimi a cercare, se mai verrai a Snezhnaya. Potremo continuare a fare affari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290911
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290911,
					"content": "Bene, basta parlare. Ecco il tuo pagamento. Prendilo. Credo che sarà il nostro ultimo \"scambio equivalente\" qui a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290912
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290912,
					"content": "*sospira* Spero solo che il mio prossimo incarico non sia così problematico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
