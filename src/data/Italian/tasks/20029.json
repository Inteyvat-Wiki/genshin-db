			"dialogs": [
				{
					"id": 200290801,
					"content": "Lily, non dovresti parlare con quel Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290802
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290802,
					"content": "Ma perché no? Il signor Faffui mi ha raccontato un sacchissimo di storie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290803
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290803,
					"content": "Ehi, ciao Lily, Viktor ti ha fatto un regalo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290804
					]
				},
				{
					"id": 200290804,
					"content": "Wow! Il signor Faffui mi ha fatto un regalo? Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290805
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290805,
					"content": "Aspetta, perché quel Fatuus manda un regalo a Lily? Non dirmi che lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290806
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290806,
					"content": "Perché io ho dato al signor Faffui moltissime cose da mangiare! Ecco perché mi ha fatto un regalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290807
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290807,
					"content": "Lily, non è una brava persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290808
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290808,
					"content": "Ma mi racconta tante storie! Lui è una brava persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290809,
						200290810
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290809,
					"content": "Puoi considerarlo come un regalo d'addio dalla parte di Viktor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "Eh? Perché deve partire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290812,
					"content": "*sospira* Partirà? Bene. Ogni giorno ero fuori di me dalla preoccupazione, a causa di quel tipo che parlava con Lily ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290813,
					"content": "Babbo, voglio dire ciao ciao al signor Faffui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290814
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290814,
					"content": "*sospira* Lily, non dovresti avvicinarti troppo a quell'uomo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290815
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290815,
					"content": "Ma perché? Il signor Faffui... è stato molto gentile con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290816
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290816,
					"content": "Mi racconta delle storie! Un sacchissimo di storie! È gentile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290817
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290817,
					"content": "Lily, dai ascolto a papà. Le cose non sono così semplici... *sospira* Ascolta... Papà ti spiegherà meglio quando sarai grande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290810,
					"content": "Presto Viktor se ne andrà da Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				}
			]
		},
