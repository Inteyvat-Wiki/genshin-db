				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290201,
					"content": "#Ehi, viaggiat{F#rice}{M#ore}. Cosa posso fare per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290202,
					"content": "Hai qualche regalo per bambini qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "Regali per bambini... Fammi pensare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290204,
					"content": "Mmh, a dire il vero ultimamente ho provato a creare qualche piccolo giocattolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290205,
					"content": "L'unica fregatura è che ci vuole molta vernice di Bacche uncinate, ma non ne ho più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290206,
					"content": "Ho chiesto a Schuster di aiutarmi a raccoglierne, ma non è ancora tornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290207,
					"content": "#Puoi aiutarmi a cercare Schuster, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290208,
					"content": "Quando avremo raccolto abbastanza Bacche uncinate, potrò creare dei giocattoli per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290209,
					"content": "Va bene. Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "Ha detto che sarebbe andato <color=#00E1FFFF>vicino al Regno dei Lupi</color> a raccogliere le Bacche uncinate. Puoi andare a cercarlo lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290212,
					"content": "#Allora conto su di te, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290210,
					"content": "Dove si è cacciato Schuster?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
