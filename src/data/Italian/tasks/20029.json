				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290701,
					"content": "Com'è andata? Hai preso il regalo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290702
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290702,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290703
					]
				},
				{
					"id": 200290703,
					"content": "Ah, sei forte. Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290704
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290704,
					"content": "Ma cos'è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290705
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290705,
					"content": "Questa bambola è tutta storta e rovinata, e la vernice è ridicola... Beh, almeno ha un buon profumo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290706
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290706,
					"content": "Siamo sicuri che sia per bambini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290707,
						200290708
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290707,
					"content": "Marjorie me l'ha consigliata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290710
					]
				},
				{
					"id": 200290710,
					"content": "Questo regalo dovrà bastare. Ma dove metto la lettera... Ehi, sai cosa, la metto sotto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290711,
						200290712
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290711,
					"content": "Hai scritto una lettera per Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290713,
					"content": "Niente di speciale. Lascia stare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290714
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290714,
					"content": "Bene. Ecco, tieni, aiutami a consegnarla a Lily. Dovrebbe essere <color=#00E1FFFF>vicino alla piazza</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290715
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290715,
					"content": "Eheh. Posso immaginarmi gli sguardi che riceverei da Rudolf, se le consegnassi il regalo di persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290712,
					"content": "Cosa le hai scritto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290708,
					"content": "Potresti sempre comprarne una a Snezhnaya e fartela spedire qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290709
					]
				},
				{
					"id": 200290709,
					"content": "Ah, mi piacerebbe molto. Ma pensaci un attimo. Se un Fatuus spedisse qualcosa a Mondstadt, non verrebbe fermato alle porte della città dai Cavalieri di Favonius?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290710
					],
					"speakerTitle": "Viktor"
				}
			]
		},
