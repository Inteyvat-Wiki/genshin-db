			},
			"dialogs": [
				{
					"id": 200291401,
					"content": "Puoi aiutarmi a portare queste Bacche uncinate a Marjorie? Ho bisogno di un attimo per riposarmi. Pensavo che le gambe mi stessero per abbandonare laggiù...",
					"roleType": "TALK_ROLE_NPC",
