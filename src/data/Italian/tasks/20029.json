			"dialogs": [
				{
					"id": 200290401,
					"content": "Hai preso il regalo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290402,
					"content": "Cosa farai quando torni a casa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "Cosa farò? Beh, credo che aspetterò l'ordine di trasferimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290404,
					"content": "*sospira* Se le cose vanno male, potrei essere trasferito in un luogo dimenticato dagli Archon e messo ancora una volta in attesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290405,
					"content": "Ma mi va bene tutto, basta che non mi spediscano a Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290406,
					"content": "Perché questo trasloco improvviso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "Mi chiedi perché? A causa di Signora... Beh... Del suo sacrificio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290408,
					"content": "Anzi, sai cosa? Sono una persona comune. Eseguo gli ordini. Non c'è bisogno che pensi troppo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290409,
					"content": "Dov'è Lily?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "Rudolf ha accennato che l'avrebbe portata a fare un giro in piazza o qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290411,
					"content": "Eheh. Immagino che deve tenere la sua preziosa figliola lontano dal malefico Fatui, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290412,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
				{
					"id": 200290413,
					"content": "Ok, ti affido la faccenda del regalo allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
