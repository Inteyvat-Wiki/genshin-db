				"points": []
			},
			"dialogs": [
				{
					"id": 200290601,
					"content": "#Viaggiat{F#rice}{M#ore}, hai trovato Schuster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290602
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290602,
					"content": "Mi ha chiesto di portarti queste Bacche uncinate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290603
					]
				},
				{
					"id": 200290603,
					"content": "Ah! Grazie mille. Le prendo io allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290604
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290604,
					"content": "Mi assicurerò di pagare Schuster quando torna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290605
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290605,
					"content": "Ah, cercavi un giocattolo per bambini, giusto? Bene allora. Arriva subito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290606
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290606,
					"content": "Marjorie comincia a preparare il regalo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200290607
					]
				},
				{
					"id": 200290607,
					"content": "Bene, fatto! Ecco, tieni. Comunque, ti ringrazio per avermi portato quelle bacche uncinate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290608
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200290608,
					"content": "Questa bambola ha anche un leggero profumo. Sono sicura che la bambina a cui la darai l'adorerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
		{
			"id": 2002907,
			"completionStepIds": [
				2002907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
