				"points": []
			},
			"dialogs": [
				{
					"id": 4851101,
					"content": "C'è solo un modo per arrivare laggiù. Raptor dev'essere più avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851102,
					"content": "Sembra però che l'unico modo per raggiungerlo sia volare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851103,
					"content": "Ma ci sono un sacco di nemici a terra... Ci attaccheranno sicuramente mentre siamo in volo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851104,
					"content": "Se vogliamo farcela, <color=#00E1FFFF>dovremo volare e sconfiggerli in un colpo solo</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851105,
					"content": "#{NICKNAME}, ti mancava ancora l'ultima fase dell'esame, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851106,
					"content": "Sì, ma cosa c'entra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851107,
					"content": "Perché non consideriamo questa la terza e ultima fase del tuo esame di volo a vela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851108,
					"content": "Sei sicura che l'esame funzioni così?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851109,
					"content": "#È una versione personalizzata per {NICKNAME}, creata dalla sottoscritta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851110,
					"content": "#E poi, la versione normale non sarebbe adeguata per col{F#ei}{M#ui} che ha salvato Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851112,
					"content": "Vedrai, l'esame sarà una passeggiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851113,
					"content": "Vedrai, prendere Raptor sarà una passeggiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4851111,
					"content": "#Allora, che ne dici, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851114,
					"content": "Grande! Ottima risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851115,
					"content": "#{NICKNAME}, preparati al decollo! Una volta che <color=#00E1FFFF>avrai sconfitto tutti i nemici</color>, sarà la volta di Raptor. Dopodiché, il brevetto di volo a vela sarà tuo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
