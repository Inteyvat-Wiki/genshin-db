			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "Sembra che non ci sia modo di passare... Ugh, dev'essere qui da qualche parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850302,
					"content": "Amber, laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850303,
					"content": "Se proprio volete inseguirmi, fate pure... Eh? Chi si è portato dietro una bambina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850304,
					"content": "Tu devi essere Raptor! Non puoi scappare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850305,
					"content": "Ahah, non ho bisogno di scappare! Non arriverete mai fin qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850306,
					"content": "Oh... In effetti è abbastanza alto... e lontano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850307,
					"content": "Oh, piccoletta, perché non corri a casa e lasci che ci pensi il tuo capo? Non preoccuparti, ti prometto che, quando arriverà la Gran Maestra, mi arrenderò immediatamente! Ahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850308,
					"content": "Ehi, piano con le parole! Stai parlando con una Vigilante dei Cavalieri di Favonius! Te ne pentirai quando ti arresterò!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850309,
					"content": "Respiri profondi, Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "...Hai ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850312,
					"content": "Ugh... È proprio lì davanti a noi... Se solo potessimo arrivarci volando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850313,
					"content": "Come ha fatto LUI ad arrivarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850314,
					"content": "Con qualche meccanismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "Non vedo nessun meccanismo, e io ho una buona vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850316,
					"content": "E poi, non c'è un posto adatto per costruirne uno sul bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850322,
					"content": "Ciao ciao, ragazzina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850323,
					"content": "Oh, no! Sta scappando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850324,
					"content": "Non possiamo più esitare. L'unico modo per attraversare è volando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850325,
					"content": "Ma... ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850326,
					"content": "Non preoccupatevi: ricordate che sono la campionessa di volo a vela di Mondstadt! Se può farcela Raptor, posso farcela anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850327,
					"content": "Ehi, Vigilante! Hai meno probabilità di sopravvivere a questo volo che di saltare dalla statua del Dio di Anemo a Mondstadt senza il tuo aliante! Ahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850328,
					"content": "Mi fido di Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#Paimon capisce cosa vuoi dire, {NICKNAME}... Se escludiamo tutto ciò che è completamente impossibile, volare è l'unica idea che ci resta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}, ricordi il libro che ti ho prestato? Quello che pensavo fosse il manuale di volo a vela, ma non lo era?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850332,
					"content": "I primi uccellini non potevano volare. Il volo fu la loro ricompensa per aver avuto il coraggio di lanciarsi nel canyon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850333,
					"content": "State a vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850334,
					"content": "Pensaci tu, Vigilante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "Ricevuto! Facciamogli vedere di che pasta è fatta una Vigilante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850336,
					"content": "Aspetta... Ferma! Non ce la farai mai! Dai, vattene, torna a casa da brava bambina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "Raptor"
				},
				{
					"id": 4850337,
					"content": "Raptor dice che non ce la farò mai. Ma se ascolti con attenzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850338,
					"content": "Il vento! Il vento dice che CE LA FARÒ e questo mi basta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850329,
					"content": "Di coraggio ce ne vorrà parecchio, ma non è del tutto impossibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "Una magia elementale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#{NICKNAME}, vedi qualcosa con la tua Vista Elementale...? No? Oh, va bene... Non importa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850319,
					"content": "Un rampino, o scarpe chiodate, o qualcosa del genere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "Se è troppo lontano per volare, lo sarà sicuramente anche per strumenti del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850321,
					"content": "E poi non c'è alcuna traccia di punti di ancoraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850310,
					"content": "Esaminiamo ciò che ci circonda, proprio come mi hai insegnato tu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
							"2"
						],
						"stepId": 48506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "Fatto! L'ho preso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850602,
					"content": "Ho notato la corrente d'aria mentre ero in volo, e non ce ne sono altre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850603,
					"content": "Sarebbe un suicidio cercare di scappare nella direzione in cui stava andando Raptor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850604,
					"content": "In altre parole, Raptor non sarebbe potuto fuggire senza passarci davanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850605,
					"content": "Ah-ha! Quindi stava solo cercando di fregarci con quell'aria sfrontata. Sperava che rinunciassimo e che ce ne andassimo con la coda tra le gambe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850606,
					"content": "Si è dimenticato che noi non ci facciamo fregare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850607,
					"content": "#È stato merito dell'astuzia di {NICKNAME}! Proprio come disse una volta un uomo saggio: \"Una volta eliminato l'impossibile, ciò che rimane, per quanto improbabile, dev'essere la verità.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850608,
					"content": "Dopotutto, volare è al sette per cento tecnica, al tre istinto e al restante novanta coraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850609,
					"content": "Quello che hai appena fatto sembrava più novantanove per cento coraggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850610,
					"content": "Ah, è stato proprio come il mio primo esame di volo a vela... Ero super nervosa, ma alla fine non c'era nulla di cui aver paura e sono passata senza problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850611,
					"content": "Mi è un po' mancata quella scarica di adrenalina negli esami che ho fatto da allora... Era tutto così diverso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850612,
					"content": "...Ehm, scusa, Paimon non ha capito. Non avevi detto di essere passata senza problemi? Quali sono questi \"esami fatti da allora\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850613,
					"content": "Ah... Beh, vedi, il fatto è che Mondstadt è piena di divieti di volo a vela, zone ad atterraggio limitato e simili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850614,
					"content": "*sospira* Ogni volta che prendo il brevetto, me lo ritirano di nuovo. In tutto, devo aver fatto l'esame circa quindici volte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850615,
					"content": "Ma lo passo sempre al primo colpo. Forse il mio piccolo manuale di volo a vela non è poi così male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850616,
					"content": "#...{NICKNAME}, un giorno di questi andiamo a prendere una copia del vero manuale di volo a vela dalla Gran Maestra Reggente Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850617,
						4850618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850617,
					"content": "Buona idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				},
				{
					"id": 4850619,
					"content": "Io ti precedo, devo scortare Raptor in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850620,
					"content": "Quando torni in città, non dimenticarti di venire a trovarmi alla cattedrale. Lì ti consegnerò il tuo brevetto di volo a vela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850618,
					"content": "Mi dispiace per Jean...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				}
			]
		},
		{
			"id": 48508,
			"completionStepIds": [
				48508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48508",
