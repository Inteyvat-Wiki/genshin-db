	"talks": [
		{
			"id": 48503,
			"completionStepIds": [
				48503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
