			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850801,
					"content": "Complimenti, ecco il tuo brevetto di volo a vela! Ora puoi volare legalmente, evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850802
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850802,
					"content": "Non mi sorprende, però. Dopotutto hai un talento naturale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850803,
						4850804
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850803,
					"content": "Sì, è stato facile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				},
				{
					"id": 4850805,
					"content": "Ah, ti iscriverò al prossimo campionato di volo a vela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850806
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850806,
					"content": "Volo così veloce che nessuno riesce mai a starmi dietro. Sono sempre da sola a volare... È un po' noioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850807,
						4850808
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850807,
					"content": "Bene. Vincerò sicuramente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850809,
					"content": "Ooh... Quanta sicurezza! Eheh. Sembra che tu non abbia idea di quanto sia terrificante il campionato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850810
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850810,
					"content": "Bene, finché non ti schiaccerò in campionato, ti auguro un'esperienza di volo felice, rilassante e, soprattutto, legale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850811
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850811,
					"content": "Assicurati di rispettare le regole. E qualunque cosa tu faccia, non farti ritirare il brevetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850812,
					"content": "Oh, cavolo... Mi sembra che Amber predichi bene ma razzoli malissimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850808,
					"content": "Non avrai possibilità di vincere se partecipo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850804,
					"content": "#In realtà mi sono impegnat{F#a}{M#o} molto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850805
					]
				}
			]
		},
