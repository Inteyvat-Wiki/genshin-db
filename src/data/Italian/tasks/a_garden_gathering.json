			"dialogs": [
				{
					"id": 761820101,
					"content": "È questo il posto dove vivevi? È davvero carino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761820102,
					"content": "Una volta era ancora più bello. Ho un certo talento per il giardinaggio, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761820103,
					"content": "Ahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761820104,
					"content": "Che ci trovi da ridere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761820105,
					"content": "Mi stavo solo immaginando te accovacciata a curare i fiori. È un'immagine adorabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761820106,
					"content": "Posso dare un'occhiata all'interno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761820107,
					"content": "Certo, ho già pulito e spolverato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761820108,
					"content": "Cosa intendi fare con questo posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761820109,
					"content": "Uhm... Penso di volerlo tenere ancora. Posso tornare a sistemarlo quando ho tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761820110,
					"content": "Se sei impegnata, posso occuparmene io al posto tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761820111,
					"content": "Mi dà la stessa sensazione della tua vecchia stanza. È rassicurante... Un posto sereno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761820112,
					"content": "Bah... Fa' come vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
