			"dialogs": [
				{
					"id": 718110501,
					"content": "Oh? Che succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110502
					],
					"speakerTitle": "Nonna Shan"
				},
				{
					"id": 718110502,
					"content": "Riguardo alla Fotokamera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "Fotokamera... Ah, sì. Qualche giorno fa sono andata alla Gilda dei commercianti di Feiyun e ho chiesto loro di venire qui a scattarmi una foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "Nonna Shan"
				},
				{
					"id": 718110504,
					"content": "#Sei venut{F#a}{M#o} qui apposta per consegnarmela? Beh, grazie, allora. Tante grazie davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonna Shan"
				}
			]
		},
