			"dialogs": [
				{
					"id": 718110412,
					"content": "Riguardo alla Fotokamera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "#Sei riuscit{F#a}{M#o} a consegnare le foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110402,
					"content": "Tutto fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "#Grazie, grazie mille. Mi spiace averti disturbat{F#a}{M#o}, ma siamo davvero sommersi di lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110404,
					"content": "Ah, sì. Accetta questa Fotokamera come ringraziamento per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110405,
					"content": "Non vorrei approfittare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "Non c'è nessun problema. Il tuo lavoro l'hai fatto, o sbaglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110408,
					"content": "Comunque non si tratta di un modello estremamente costoso: è un campione che abbiamo ricevuto da Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110409,
					"content": "È leggermente diverso dalla versione ufficiale, ma le funzioni di base ci sono tutte. Vedrai che ha tutto ciò che ti serve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110410,
					"content": "Nel caso dovesse piacerti, potresti anche aiutarci a fare un po' di pubblicità in giro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110411,
					"content": "Ehm... In ogni caso, ti ringrazio dell'aiuto, ti prego di accettare questa Fotokamera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110406,
					"content": "Dev'essere molto costosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
