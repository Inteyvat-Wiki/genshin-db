						718110602
					],
					"speakerTitle": "Maestro del tè Liu Su"
				},
				{
					"id": 718110602,
					"content": "Riguardo alla Fotokamera...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110603
					]
				},
				{
					"id": 718110603,
					"content": "Ah, certo, certo. Sì, sono andato alla Gilda dei commercianti di Feiyun e ho fatto venire qui qualcuno a farmi una foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110604
					],
					"speakerTitle": "Maestro del tè Liu Su"
				},
				{
					"id": 718110604,
					"content": "Com'è venuta? L'hanno già stampata? Fammi dare un'occhiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110605
					],
					"speakerTitle": "Maestro del tè Liu Su"
				},
				{
					"id": 718110605,
					"content": "Oh, davvero niente male. Grazie di avermela portata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maestro del tè Liu Su"
				}
			]
