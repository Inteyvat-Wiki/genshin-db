			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "Ah... come posso fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680102,
					"content": "Mmh, cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "#Oh, sei tu. Sei arrivat{F#a}{M#o} al momento giusto. Timmie mi ha detto cos'hai fatto alle anatre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680104,
					"content": "Tu... tu... Come posso dire? Non è che non abbia sentito parlare delle tue gesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680105,
					"content": "Ma dovevi per forza dimostrare il tuo coraggio e la tua forza in quel modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680106,
					"content": "Avevo troppa fame...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "Se avevi davvero fame, avresti potuto guadagnarti del cibo onestamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680110,
					"content": "Con le tue capacità, otterresti sicuramente un posto nella Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680113,
					"content": "Ah, ormai è acqua passata. Ma Timmie è piuttosto giù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680114,
					"content": "Io... Il padre di Timmie una volta mi ha insegnato a cucinare una pietanza. Le frittelle di patate di Mondstadt con funghi anemofili sono il piatto preferito di Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680115,
					"content": "Perché non mi aiuti a trovare tre funghi anemofili, in modo da prepararli per Timmie? Questo dovrebbe tirarlo un po' su, oltre a farti perdonare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680116,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "Bene. Allora, ti aspetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680120,
					"content": "Per quanto riguarda i funghi anemofili... Dovresti riuscire a trovarne sotto le grondaie delle case nella parte meridionale della città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680121,
					"content": "Per favore, torna presto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680117,
					"content": "Sarà fatto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "Ne bastano solo tre! Cosa pensi di fare con tutti quei funghi? Hai intenzione di corrompere Timmie con una pietanza ogni volta che gli fai un torto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680107,
					"content": "È stato un incidente, giuro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "Hai colpito per sbaglio le anatre e i piccioni? Hai sconfitto per sbaglio anche i terribili nemici che hai incontrato nelle tue avventure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680108,
					"content": "La forza è frutto di esercizio quotidiano, come questo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "Tu... Io... Lascia perdere. Sembra che la tua \"forza\" sia piuttosto poliedrica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				}
			]
		},
