			"dialogs": [
				{
					"id": 200680501,
					"content": "Per favore, dai queste frittelle di patate di Mondstadt a Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680502,
						200680506
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680502,
					"content": "Questa \"mamma\" di cui parla Timmie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680503
					]
				},
				{
					"id": 200680503,
					"content": "Sono io. È da un po' che mi occupo dei bambini che hanno bisogno di cure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680504
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680504,
					"content": "Timmie è quello di cui mi sono occupata più a lungo. È arrivato persino a chiamarmi mamma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680505
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680505,
					"content": "Ma in realtà, non sono la sua vera madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680506,
					"content": "Perché Timmie è così arrabbiato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680507
					]
				},
				{
					"id": 200680507,
					"content": "Come fai a chiedermi una cosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680508
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680508,
					"content": "Quel bambino non ha molti amici o persone care in questa città. Quindi, a parte Nora e Glory, quegli animaletti sono gli unici a tenergli compagnia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680509
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680509,
					"content": "Infatti, quei piccioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680510
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680510,
					"content": "...No, non importa. Per favore, porta le frittelle di patate a Timmie il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
