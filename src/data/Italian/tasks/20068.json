			},
			"dialogs": [
				{
					"id": 200680401,
					"content": "Grazie, questi dovrebbero bastare. Aspetta un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680402,
					"content": "Questo dovrebbe andare bene. Per favore, dai queste frittelle di patate di Mondstadt a Timmie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680403,
					"content": "E per favore, non... fare più queste cose in futuro. Non ne vale la pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680404,
					"content": "Ascolta il mio consiglio. Non deludere Timmie... né me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680405,
					"content": "Beh, se solo la gente ascoltasse i consigli. Se così fosse, sorella Victoria non sarebbe così impegnata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
