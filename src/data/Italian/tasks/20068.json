			"trigger": {
				"objectNames": [
					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680301,
					"content": "...Mangia, mangia. Mangia e vai, presto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680302,
						200680303,
						200680304
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680302,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680305
					]
				},
				{
					"id": 200680305,
					"content": "Ancora tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680308,
					"content": "Che cos'hai in mente? Stai pensando di fare del male alle anatre e ai piccioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680309,
						200680310
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680309,
					"content": "Queste frittelle di patate sono per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680311,
					"content": "Frittelle di patate? Mmh. Come facevi a sapere come si cucinano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680312
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680312,
					"content": "So come, devi aver chiesto alla mamma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680313
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680313,
					"content": "Tsk. Stai cercando di corrompermi in questo modo? So cos'hai fatto a quei volatili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680314
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680314,
					"content": "#...Comunque, visto che la mamma ti ha mandat{F#a}{M#o} qui con le frittelle, immagino che sia il suo modo per dirmi di smetterla di creare problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680315
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680315,
					"content": "Deve ancora prendersi cura di Nora e Glory. Sarebbe immaturo da parte mia renderle le cose più difficili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680316
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680316,
					"content": "#Ma sia chiaro, non ti ho perdonat{F#a}{M#o}! È solo che non voglio creare problemi alla mamma. Capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680317
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680317,
					"content": "Comunque... Tsk, dato che sono solo un bambino, scommetto che dimenticherai la tua promessa alla prima occasione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680318
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680318,
					"content": "Quando tornerà papà, gli racconterò tutto di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680310,
					"content": "Per piacere, accetta queste frittelle di patate!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680311
					]
				},
				{
					"id": 200680303,
					"content": "Ehi, Timmie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680306
					]
				},
				{
					"id": 200680306,
					"content": "Ancora tu? Lasciami in pace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200680304,
					"content": "È successo qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680307
					]
				},
				{
					"id": 200680307,
					"content": "Con che coraggio me lo chiedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680308
					],
					"speakerTitle": "Timmie"
				}
			]
		},
