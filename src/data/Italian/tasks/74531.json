			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME} e Paimon, siete {F#tornate}{M#tornati}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310102,
					"content": "Ho scattato parecchie foto questa volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "È magnifico! Grazie mille per il tuo aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310105,
					"content": "#Mentre eri {F#impegnata}{M#impegnato} a scattare quelle foto, ho iniziato a pensare che non posso starmene con le mani in mano, altrimenti non farò mai progressi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310106,
					"content": "Così mi sono fatta coraggio e ho chiesto aiuto a qualche passante, e sono persino riuscita a scattare un bel po' di foto da sola! Credo che questi dovrebbero essere dati sufficienti per i test.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310107,
					"content": "#Eheh, sapevo che non mi avresti deluso! Grazie anche a {NICKNAME} per essere {F#intervenuta}{M#intervenuto}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310108,
					"content": "Lépine-Pauline! Quando sei tornata? Ninette ha detto che ultimamente sei stata impegnata con qualcos'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310109,
					"content": "Beh, ovviamente, è una questione gigantesca. Talmente grande da riempirmi le tasche fino all'orlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310110,
					"content": "Ultimamente sono stata piuttosto impegnata, quindi sono davvero felice che tu abbia aiutato Ninette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310111,
					"content": "Ha talento e buon gusto, questo è certo. È solo un po' timida. Ma con il tuo aiuto, ha fatto davvero un importante passo avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310112,
					"content": "Allora, qual è questa \"grande questione\" su cui sei così misteriosa? Non dire a Paimon che hai sentito un'altra voce assurda e ti ci sei buttata a capofitto di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310113,
					"content": "Cosa? Ma certo che no! Ho imparato la lezione. Questa volta è una questione seria, sicura e garantita per fare una fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310114,
					"content": "(Non sembra molto convincente...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "#Umpf, se ve la dico ora, rovinerò la sorpresa. Una volta pronta, sarete {F#le prime}{M#i primi} a provarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lépine-Pauline"
				},
				{
					"id": 745310103,
					"content": "L'obiettivo \"istantaneo\" ha funzionato alla grande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
