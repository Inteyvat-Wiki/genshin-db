				{
					"id": 220050301,
					"content": "L'hai trovata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050302
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050302,
					"content": "È questa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050303
					]
				},
				{
					"id": 220050303,
					"content": "Fammi vedere... No, non credo... Sembra troppo leggera, non può esserci quella reliquia dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050304
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050304,
					"content": "In ogni caso, ti ringrazio. Continuerò a cercarla per conto mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050305
					],
					"speakerTitle": "Bao'er"
				},
				{
