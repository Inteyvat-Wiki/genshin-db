				},
				{
					"id": 207400602,
					"content": "Puoi raccogliere della Lampadulina e dei Fiordolci nella Foresta dei Sussurri. Troverai delle Asterie del vento a Levanteolo, e delle Cecilie sul Promontorio Acchiappastelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400603
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400603,
					"content": "In queste aree potrai raccogliere i fiori più freschi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400604
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400604,
					"content": "Ti prego di tornare da me non appena avrai finito di raccoglierli.",
