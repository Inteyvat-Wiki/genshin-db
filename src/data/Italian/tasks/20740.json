			"dialogs": [
				{
					"id": 207400501,
					"content": "Allora, per quanto riguarda i denti di leone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400502
					]
				},
				{
					"id": 207400502,
					"content": "#Sei riuscit{F#a}{M#o} a prendere i denti di leone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400503,
					"content": "Sì, ce l'ho fatta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400504
					]
				},
				{
					"id": 207400504,
					"content": "Grazie, dovrebbero bastare. Li seminerò in questi vasi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400505
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400505,
					"content": "...Insieme ai fiori che hai trovato prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400506,
					"content": "Ah, giusto. Devo ringraziarti. Tieni, è un pensierino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400507,
					"content": "Ora devo sbrigarmi a mettere questi fiori nei vasi, i semi di dente di leone vanno laggiù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
