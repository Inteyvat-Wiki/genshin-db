			"dialogs": [
				{
					"id": 207400401,
					"content": "Quanto ai fiori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400402
					]
				},
				{
					"id": 207400402,
					"content": "Hai raccolto tutti i fiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400403,
					"content": "Eccoli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400404
					]
				},
				{
					"id": 207400404,
					"content": "Sono molto freschi... Grazie. Con questi fiori in vetrina attireremo tanti clienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400405
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400405,
					"content": "Posso chiederti un'altra cosa? Il vento ha portato via anche tutti i denti di leone che avevamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400406
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400406,
					"content": "Anche se i denti di leone che svolazzano nel vento non sono una brutta cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400407,
					"content": "Per una fioraia di Mondstadt è comunque strano non avere denti di leone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400408
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400408,
					"content": "I denti di leone non possono semplicemente essere raccolti e trasportati. Devono essere ripiantati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400409,
					"content": "Potresti trovarmi dei semi di dente di leone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400410,
						207400412
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400410,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400411
					]
				},
				{
					"id": 207400411,
					"content": "Conto su di te allora. Se mi ricordo bene, ci sono molti denti di leone proprio fuori Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400412,
					"content": "Da dove comincio?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207400413
					]
				},
				{
					"id": 207400413,
					"content": "Ci sono molti denti di leone fuori città. Dovresti trovarli facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
