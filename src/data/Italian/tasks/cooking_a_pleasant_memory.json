			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190501,
					"content": "La mia è sempre stata una famiglia di mercanti che si sposta dalla Voragine a Sumeru. Importiamo rare pietre preziose da Liyue ed esportiamo spezie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190502,
					"content": "Una volta, a causa di un imprevisto... Non so bene cosa fosse successo... Mio padre mi lasciò a Borgo Gandharva per molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190503,
					"content": "Feci amicizia con qualcuno nella foresta. Correvamo in giro assieme, finché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190504,
					"content": "Non so bene cosa sia successo in seguito. Non ricordo il suo nome, né il suo aspetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190505,
					"content": "Ricordo solo che ero molto felice. Poi mio padre tornò finalmente a prendermi. Pensai anche di tornare a cercarlo, ma non ne ebbi mai l'occasione e alla fine mi dimenticai tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190506,
					"content": "Se non fosse stato per voi che mi avete chiesto lo zucchero, non avrei mai ripensato a tutte queste cose. Chissà perché è andata così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301906,
			"completionStepIds": [
				7301906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301906",
							"2"
						],
						"stepId": 7301906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arasaka",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190601,
					"content": "Eccolo! Non pensavo che lo avreste trovato così in fretta... È proprio vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190602
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190602,
					"content": "#Non vi sarete inventat{F#e}{M#i} qualcosa per ingannarmi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190603
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190603,
					"content": "Sarebbe un miracolo se si potesse inventare qualcosa di sensato dalla tua descrizione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190604,
					"content": "Se non ci credi, assaggialo tu stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190605,
					"content": "...Non ci avete messo dentro nulla di strano, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190606
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190606,
					"content": "Certo che no! Tsk! Guarda che se non lo assaggi lo riportiamo indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190607,
					"content": "N-No, aspettate! Non riportatelo indietro. Lasciate... Lasciate che lo assaggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190608
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190608,
					"content": "Non riportatelo indietro, ok? Lo assaggerò proprio ora, proprio ora... Mm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190609
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190609,
					"content": "Ah, è proprio vero! Ecco il \"sapore della felicità\"! Eheh... Non è la prima volta che l'assaggio, eppure sono molto felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190610
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190610,
					"content": "Non credevo che l'avrei più assaggiato... Ah, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190611,
						730190612
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190611,
					"content": "Cosa c'è?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				},
				{
					"id": 730190613,
					"content": "Beh... Come posso dire? Il \"sapore della felicità\" è sempre lo stesso. Ma per qualche strano motivo non sono felice come la prima volta che l'ho provato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190614
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190614,
					"content": "Che lo zucchero che ci ha dato quel tipo non sia abbastanza dolce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190615,
					"content": "No, il gusto non è diverso. Ma quando l'ho mangiato con il mio amico in passato... Quella è stata la prima volta che ho assaggiato il \"sapore della felicità\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190616
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190616,
					"content": "Ho l'impressione che allora fossi molto più felice. Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190617
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190617,
					"content": "#È normale: anche quando {NICKNAME} prepara lo stesso piatto, il sapore è sempre diverso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190618,
					"content": "Anche l'umore di Paimon è diverso ogni volta che lo mangia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190619,
						730190620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190619,
					"content": "Esattamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190621,
					"content": "No, non può essere... Dev'esserci un modo per sentirmi felice come allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190622
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190622,
					"content": "So cosa fare! Dato che la prima volta l'ho assaggiato con un mio amico, vorrà dire che il \"sapore della felicità\" dev'essere condiviso con gli amici affinché sia delizioso, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190623
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190623,
					"content": "#Sì, dev'essere così. Voi siete Nara buon{F#e}{M#i} e avete trovato il \"sapore della felicità\". Voi siete mi{F#e}{M#ei} amic{F#he}{M#i}, quindi lo preparerò per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190624
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190624,
					"content": "#Sì, siamo tu{F#e}{M#oi} amic{F#he}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190625,
					"content": "Arasaka inizia immediatamente a cucinare, aggiungendo le pesche e lo zucchero alla pentola...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190626
					]
				},
				{
					"id": 730190626,
					"content": "Dopodiché, Arasaka porge il piatto pronto a te e a Paimon.\\nCome previsto non è molto saporito, a parte l'eccessiva \"dolcezza\".\\nForse è proprio questo il \"sapore della felicità\"...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730190627
					]
				},
				{
					"id": 730190627,
					"content": "Ah, che sapore felice. È squisito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190628
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190628,
					"content": "Già, questo piatto è piuttosto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190629,
					"content": "Piuttosto \"felice\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190630,
						730190631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190630,
					"content": "È troppo dolce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190632,
					"content": "Anche Paimon pensa che sia troppo dolce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190633,
					"content": "D-Davvero? Oh, mi sa che ne ho messo troppo, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190634
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190634,
					"content": "Ma... Eheh. È vero che il \"sapore della felicità\" è più felice quando viene condiviso con gli amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190635
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190635,
					"content": "Non è la stessa felicità che ho provato la prima volta che l'ho assaggiato, ma mangiandolo con voi... provo un altro tipo di felicità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190636,
						730190637
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190636,
					"content": "Beh, l'importante è che tu sia felice.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190638,
					"content": "All'inizio dubitavo di voi, ma non mi avete portato rancore... e mi avete aiutato a trovare il \"sapore della felicità\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190639
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190639,
					"content": "Grazie al vostro aiuto, sono riuscito a completare la mia Prelibatezza suprema e la mia pratica culinaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190640
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190640,
					"content": "Non è niente, davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190641,
					"content": "Come niente? Mi avete aiutato tantissimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190642
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190642,
					"content": "Ho trovato! Vi insegnerò a preparare questo piatto, in modo che potrete condividere il \"sapore della felicità\" con i vostri amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190643
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190643,
					"content": "(Mmm... Se apportiamo qualche modifica e aggiungiamo qualcosina alla ricetta, potrebbe venirne fuori uno spuntino niente male...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190637,
					"content": "Devo bere un po' d'acqua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190638
					]
				},
				{
					"id": 730190631,
					"content": "Devo bere un po' d'acqua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190632
					]
				},
				{
					"id": 730190620,
					"content": "Davvero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190621
					]
				},
				{
					"id": 730190612,
					"content": "Qualcosa non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190613
					]
				}
			]
		},
