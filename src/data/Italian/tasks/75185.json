					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850701,
					"content": "#Oh, siete voi, abili {F#viaggiatrici}{M#viaggiatori} provenienti da lontano! Avete provato a preparare le Uova magmatiche da {F#sole}{M#soli}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850702,
					"content": "Sì! È un piatto davvero energizzante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "Vero? In ogni boccone è racchiuso il potere della bontà vulcanica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850704,
					"content": "Si dice che, mangiandone ogni giorno, si diventi sempre più forti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850705,
					"content": "Le ho cotte troppo... Ho quasi perso i sensi dopo averle mangiate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "Ahah, è un sapore che rimane impresso, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850707,
					"content": "A dirla tutta non è affatto male, una volta che ci si abitua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850710,
					"content": "Ancora no. Magari la prossima volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "Non preoccuparti, va bene. Vi auguro buon viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		}
