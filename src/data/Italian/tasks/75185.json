			"dialogs": [
				{
					"id": 751850201,
					"content": "Se volete provarne uno, affrontate la sfida delle Uova magmatiche! Raggiungete il condotto geotermico laggiù, rompetelo, prendete l'uovo al suo interno e bam, ecco che avete la vostra prelibatezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518503,
			"completionStepIds": [],
