					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "Che cosa sono...? Uova?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "È un piatto che si può trovare solamente nella nostra regione vulcanica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850303,
					"content": "Lanciamo qualche uovo di uccello nei condotti, lasciamo che il Flogisto le cucini e, con il calore e il tempismo giusti, ecco che otteniamo un Uovo magmatico perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850304,
					"content": "Ma attenzione: se le si lascia lì troppo tempo, il sapore sarà... particolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
			"id": 7518504,
			"completionStepIds": [
				7518502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
