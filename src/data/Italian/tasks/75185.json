				"objectNames": [
					"Runtuma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850401,
					"content": "#Wow, che {F#brave}{M#bravi}! Avete finito la sfida in men che non si dica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850402,
					"content": "Vediamo... Wow, il colore e il profumo... Mi è venuta fame! Forza, provatene uno finché è ancora caldo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850403,
					"content": "Ah, ed ecco la ricetta. La prossima volta che ne volete, beh, saprete come prepararle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
