			},
			"dialogs": [
				{
					"id": 741660401,
					"content": "Questo è il refettorio dei Coupon, ogni persona può richiedere un pasto assistenziale gratuito al giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660402,
					"content": "L'unico problema è che ciò che si mangia dipende completamente dal destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660403,
					"content": "Ehm, tutto qua? Queste cose s'imparano il primo giorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660404,
					"content": "Calma, calma, ho anche delle informazioni segrete. Si dice che ci sia una parola in codice segreta che puoi dire a Bran quando si richiede il pasto assistenziale. Questa ti permetterà di avere il leggendario pasto misterioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660405,
					"content": "Ah, davvero? Quale parola in codice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660406,
					"content": "Purtroppo non lo so. Per quanto riguarda la parola in codice, lascerò che la scopriate per conto vostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660407,
					"content": "Questa è proprio la battuta di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660408,
					"content": "Non preoccupatevi di cosette del genere! Eccoci alla prossima fermata, la Troupe Tri-Coupon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strana persona"
				}
			]
		},
