			},
			"dialogs": [
				{
					"id": 741660501,
					"content": "Questa è la sede della Troupe Tri-Coupon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660502,
					"content": "Uh? Tutta qua la spiegazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660503,
					"content": "Non siete riusciti ad associarla a qualcosa? Dove c'è una troupe, c'è spettacolo! Dove c'è spettacolo, c'è romanticismo! Dove c'è romanticismo, c'è amore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660504,
					"content": "Si dice che se si viene qui a guardare i loro spettacoli ogni giorno, troverai il vero amore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660505,
					"content": "Davvero ci sono delle voci del genere? Se così fosse non dovrebbero essere tutti quanti qua ogni giorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660506,
					"content": "È così, ma per realizzarsi, non si deve essere prigionieri o guardie di Forte Méropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660507,
					"content": "Quindi nessuno può mai incontrare il vero amore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660508,
					"content": "Forse questo è proprio il nocciolo della questione. Comunque sia, andiamo alla prossima destinazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strana persona"
				}
			]
		},
