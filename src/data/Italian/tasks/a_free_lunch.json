			"dialogs": [
				{
					"id": 741660601,
					"content": "Questo è... l'ascensore per l'area di produzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660602
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660602,
					"content": "Non ci sono voci strane su questo posto, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660603,
					"content": "No, non ne circolano. È solo che detesto proprio questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660604,
					"content": "Oh? Come mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660605,
					"content": "Perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660606
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660606,
					"content": "Perché...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660607,
					"content": "Perché non voglio lavorare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660608,
					"content": "Sono qui proprio perché non avevo voglia di lavorare, quindi ho rubato una pagnotta di pane per sfamarmi, e questo è il risultato della sentenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660609,
					"content": "Quindi perché a Forte Méropide mi tocca lavorare?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660610,
					"content": "\"Anche il minimo lavoretto può mettermi al tappeto!\" Questo è il mio motto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660611,
					"content": "Uah! Sembra che stia diventando strano solo per il fatto di essere qui, usciamo da qui e andiamo al prossimo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
