			},
			"dialogs": [
				{
					"id": 741660701,
					"content": "#Ve bene, amic{F#he}{M#i}! Finalmente siamo giunti al mio posto preferito, il ring di Pankration! Questo posto è il nostro paradiso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660702
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660702,
					"content": "Questo posto... è davvero così strepitoso? È un po' diverso da quello che ha sentito Paimon in giro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660703,
					"content": "Certo, non devi dare ascolto alle voci che girano là fuori. È tutta una messinscena per ingannare gli altri. Venite, venite, ho un modulo di consenso proprio qui, basta solo una firma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660704
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660704,
					"content": "Ehi! Ancora tu! Stai di nuovo imbrogliando le persone facendogli firmare il consenso per partecipare alla gara?! Non scapperai, questa volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660705
					],
					"speakerTitle": "Guardia"
				},
				{
					"id": 741660705,
					"content": "#Siete stat{F#e}{M#i} piuttosto fortunat{F#e}{M#i} che l'abbia notato giusto prima che vi facesse firmare quei moduli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660706
					],
					"speakerTitle": "Guardia"
				},
				{
					"id": 741660706,
					"content": "In ogni caso, non date retta a questo imbroglione. Lui e l'organizzazione alle sue spalle sono specializzati nell'ingannare gente ignara a partecipare a delle gare pericolose, guadagnandoci sopra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660707
					],
					"speakerTitle": "Guardia"
				},
				{
					"id": 741660707,
					"content": "Non inventare cose del genere! Non ho mai imbrogliato nessuno! Sono tutti miei amici e firmano consensualmente dopo la mia raccomandazione da amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660708
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660708,
					"content": "Certo, come no. Conosco un posto migliore dove puoi continuare a raccontare le tue sciocchezze. Vieni con me, ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660709
					],
					"speakerTitle": "Guardia"
				},
				{
					"id": 741660709,
					"content": "La persona strana viene portata via dalla guardia...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741660710
					]
				},
				{
					"id": 741660710,
					"content": "Fiuu... I pasti gratis non esistono per davvero, dopotutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
