			"dialogs": [
				{
					"id": 741660301,
					"content": "Che mi dite? Ne avete discusso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660302,
					"content": "Come hai detto tu, dev'essere assolutamente gratuito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660303,
					"content": "Certo, certo, sarà completamente \"gratuito\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660304,
					"content": "Venite, venite, ora vi mostrerò Forte Méropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strana persona"
				}
			]
		},
