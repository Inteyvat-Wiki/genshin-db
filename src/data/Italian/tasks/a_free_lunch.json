					}
				]
			},
			"dialogs": [
				{
					"id": 741660201,
					"content": "#Scusami, {F#signorina}{M#signorino} laggiù. Sì, sì, proprio te! Vieni qui, vieni qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660202,
					"content": "Uh? Stai parlando con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "#Oh, {F#mie care amiche}{M#miei cari amici}, ho capito subito che siete {F#nuove}{M#nuovi} di qui. Immagino non abbiate molta familiarità con Forte Méropide, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660204,
					"content": "Vi faccio i miei complimenti per esservi imbattute in me oggi! Sono l'abitante più gentile di tutto il Forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660205,
					"content": "Lasciate che oggi vi aiuti a prendere familiarità con il Forte. Ovviamente, sarà tutto \"gratuito\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660206,
					"content": "A dire il vero, conosco già il posto abbastanza bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "Oh, non dire così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660208,
					"content": "Probabilmente pensi di conoscerlo abbastanza, ma con la mia guida, sono sicuro che scoprirai un sacco di cose che non avevi mai notato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660209,
					"content": "I pranzi gratuiti esistono per davvero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Certo, certo! Come ho detto, sono l'abitante più gentile di tutto il Forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660211,
					"content": "Uh, questo tizio è un po' strano. Lo abbiamo appena incontrato e fa già l'amicone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "#Ahah, {F#amiche mie}{M#amici miei}, non c'è nulla di cui preoccuparsi! Facciamo così, parlatene prima tra di voi, io aspetterò qui la vostra decisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Strana persona"
				},
				{
					"id": 741660213,
					"content": "Una volta che avrete deciso, tornate a cercarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Strana persona"
				}
			]
		},
