			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360301,
					"content": "Ce l'hai fatta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360302,
					"content": "C'era un sacco di vento, lassù...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "Ottimo, è quello che ci serve. In questo modo, i semi di dente di leone possono viaggiare lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360304,
					"content": "Forse raggiungeranno davvero Godwin, e gli porteranno quello che voglio dirgli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360305,
					"content": "Dammi la mano... Ecco, prendi. Questi sono per ringraziarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360306,
					"content": "Ci sono tante altre cose che vorrei dire a Godwin. In futuro, potrei aver bisogno del tuo aiuto un'altra volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		}
	]
