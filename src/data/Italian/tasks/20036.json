			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "Godwin... quando tornerai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360102,
					"content": "Ciao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "#Conosco quella voce... Ma guarda, è {F#la}{M#il} viaggiat{F#rice}{M#ore} dalle terre remote! Sia ringraziato il grande Archon di Anemo per aver incaricato il vento di condurti in questo luogo... Ho una richiesta per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360104,
					"content": "Il mio... ehm, ragazzo, Godwin... è tra i Cavalieri di Favonius, sai... ha lasciato la città secoli fa e non ha ancora fatto ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360105,
					"content": "Da quando è andato via, non ho ricevuto alcuna notizia da lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360106,
					"content": "Sono tanto preoccupata per lui. Povero Godwin, e se si imbattesse in quei terribili Hilichurl? Oppure, ha anche detto di essere in guerra contro l'Ordine dell'Abisso, e se restasse ferito? E... e ormai è via da così tanto, e se iniziasse a provare interesse per una di quelle belle ragazze tra i cavalieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360107,
					"content": "Ah, mi dispiace! Mi dispiace, mi... mi sono lasciata trasportare. Mia madre mi dice sempre che i denti di leone portano i desideri delle persone lontano, in un luogo remoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360108,
					"content": "Perciò, la mia richiesta è... potreste raccogliere tre semi di dente di leone da Levanteolo per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360109,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "Grazie davvero! Che l'Archon di Anemo sia con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360110,
					"content": "Ho cose più importanti da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "#Aspetta! Ti supplico, aiutami. Sicuramente, sarà una passeggiata per {F#una}{M#un} viaggiat{F#rice}{M#ore} con la tua esperienza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
			"id": 2003602,
			"completionStepIds": [
				2003604
			],
