			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Glory"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200360201,
					"content": "Eccoti, hai trovato i semi di dente di leone per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360202,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "Grazie! Puoi metterli nella mia mano? Non ci vedo, li perderei altrimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360204,
					"content": "Questi sono abbastanza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "Potresti metterli nella mia mano? È l'unico modo in cui posso risponderti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360206,
					"content": "Sì, bastano. E ora è il momento di dire tutto ciò che voglio dire a Godwin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360207,
					"content": "Ehm... tappati le orecchie, per favore. Non si origlia! Queste sono parole private condivise tra innamorati. Beh... *ridacchia* di sicuro avrai vissuto esperienze simili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360208,
					"content": "Ok, ho finito. Ora, portali in cima alla statua dell'Archon di Anemo e liberali nel vento. Il grande Archon in persona penserà a trasportarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360209,
					"content": "Spero li guiderà fino a Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
		{
			"id": 2003603,
			"completionStepIds": [
				2003606
