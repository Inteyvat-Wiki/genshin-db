			"dialogs": [
				{
					"id": 760300301,
					"content": "Così dovrebbe bastare, giusto? Sembra proprio che ne abbiamo prese un bel po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300302,
					"content": "Torniamo indietro. Non possiamo lasciare quell'opera d'arte incompiuta per sempre, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300303,
					"content": "*singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300304,
					"content": "Aaahh! Veloci, nascondetevi! C'è qualcuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300305,
					"content": "*singhiozza* Dove sono...? Mamma... Voglio tornare a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300306,
					"content": "Sembra che sia un membro degli Eredi della Luna gelata. Si è persa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300307,
					"content": "Vado ad aiutarla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300309,
					"content": "Sì, certo! Sembra aver bisogno di aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300310,
					"content": "Gli Eredi della Luna gelata sono molto diffidenti nei confronti degli estranei, vero? Non avete le corna, è tardi... E se la spaventaste...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300311,
					"content": "Certo, è possibile, ma non possiamo semplicemente non fare niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300312,
					"content": "Mmmh... Venite con me, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300313,
					"content": "Prego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
