			"dialogs": [
				{
					"id": 760300101,
					"content": "Mmmh. L'atmosfera qui è un po' diversa dal solito. Stai decorando questo campo di fiori, Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "Ah, non io, ma loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300103,
					"content": "Intendi... le Kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "Sì. Queste pietre emanano una luce debole, quando assorbono del Kuuvahki. Alle Kuuhenki piacciono molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300105,
					"content": "Quindi... Le mettono per terra e ci giocano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "Non esattamente. Avvicinatevi e guardate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300107,
					"content": "Eh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "Oooh! Se le guardi dall'alto formano un dipinto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "Ma sembra che ne manchi un pezzo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "Proprio così. Devo raccoglierne delle altre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300111,
					"content": "Oh, quindi stai uscendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "Sì, conosco un posto. È illuminato dalla luna e ricco di pietre di questo tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300113,
					"content": "Vuoi che ti accompagniamo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "Certamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300115,
					"content": "Bene, allora raccogliamole! Vogliamo vedere anche noi come sarà il dipinto terminato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
