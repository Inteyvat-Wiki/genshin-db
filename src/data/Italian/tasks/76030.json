			"dialogs": [
				{
					"id": 760300501,
					"content": "*piagnucola*... Eh? Cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300502,
					"content": "Che bello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300503,
					"content": "Così dovrebbe andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300504,
					"content": "Ah, ed ecco che se ne va. Il percorso con le pietre la porterà dritta all'Enclave della Luna gelata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300505,
					"content": "(Colombina ha detto che non vuole essere trattata come una divinità, ma aiuta comunque chi è in difficoltà...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "Aspetta, e il dipinto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300507,
					"content": "Non c'è problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300508,
					"content": "Possiamo completarlo un'altra volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760300509,
					"content": "Mi piace guardare le persone trovare la strada verso il luogo a cui appartengono, la loro casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		}
