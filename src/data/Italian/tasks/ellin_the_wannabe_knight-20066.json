			"dialogs": [
				{
					"id": 200660201,
					"content": "Allora? Ti è venuta l'illuminazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660202
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660202,
					"content": "Ci sto ancora pensando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660203
					]
				},
				{
					"id": 200660203,
					"content": "Ah. Ho già incontrato alcuni avventurieri, dicono tutti la stessa cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660204
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660204,
					"content": "Combattono i mostri da professionisti, ma nessuno ci capisce più niente quando si tratta di rompere qualche bastoncino di legno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660205
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660205,
					"content": "E rinforzano il legno come se stessero costruendo un rifugio dalla tempesta o qualcosa di simile... sopravvalutando eccessivamente la loro forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660206
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660206,
					"content": "Se vogliono tanto qualcosa di difficile, perché non se ne vanno nella natura a provocare il mostro più grande che trovano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
