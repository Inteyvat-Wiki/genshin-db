					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205150101,
					"content": "Oh, dove si sarà cacciata Anna, questa volta...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150102,
					"content": "Hai perso di nuovo Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "Sì. Ho perlustrato la città da cima a fondo, ma nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150104,
					"content": "Ti prego, aiutami a cercarla. Sono così stanco che quasi non riesco a muovermi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150105,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "Affido tutto a te, allora. Santo cielo... Se continua a correre in giro così mentre è ancora convalescente, finirà per far ammalare anche me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150111,
					"content": "Aspetta... Una volta Anna ha detto che voleva andare alla cattedrale per ringraziare le sorelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150112,
					"content": "Forse è meglio se inizi a cercarla lì. Meglio anche se parli con Albert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150113,
					"content": "Lui, ehm, bazzica spesso dalle parti della cattedrale. Chissà, magari ha visto qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150107,
					"content": "Forse è partita per diventare un'avventuriera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "Non è possibile. No... o sì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150109,
					"content": "E-Ehi, perché non rispondi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
