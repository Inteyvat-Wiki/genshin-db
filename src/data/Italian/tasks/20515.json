				{
					"id": 205150401,
					"content": "Quella tipa è davvero agile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150402
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150402,
					"content": "Scusa, hai visto una ragazza...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150403
					]
				},
				{
					"id": 205150403,
					"content": "Intendi Anna? L'ho vista eccome, mi ha superato correndo ed è sparita girando quell'angolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150404
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150404,
					"content": "Ma l'Anna che ricordavo io era sempre malata, e a volte si recava alla cattedrale per essere curata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150405
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150405,
					"content": "Però ora non mi sembra malata per nulla. Anzi, direi che ha addirittura più energia di me. Chissà cosa l'è successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
