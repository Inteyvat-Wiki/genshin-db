			},
			"dialogs": [
				{
					"id": 205150201,
					"content": "Wow, le sorelle sono davvero vigili. Quasi mi scoprivano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150202,
					"content": "Sei proprio agile, tu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150203
					]
				},
				{
					"id": 205150203,
					"content": "Ah! Come facevi a sapere che ero qui? Nemmeno le sorelle mi hanno vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150204,
					"content": "Beh, dato che mi hai trovata, me ne torno indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150205,
					"content": "Volevo solo godermi il panorama, non preoccuparti per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
