					"nextDialogs": [
						205150303
					]
				},
				{
					"id": 205150303,
					"content": "Sul tetto della cattedrale? Tutte quelle sorelle e nessuna l'ha notata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150304,
					"content": "Come accidenti ha fatto? Magari ha davvero la stoffa per diventare un'avventuriera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150305,
					"content": "Vado a farla scendere da lassù. Non è proprio il caso di disturbare le sorelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150306,
					"content": "Grazie per avermi aiutato. Ecco, prendi, in segno di ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
