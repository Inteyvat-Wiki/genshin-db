			"dialogs": [
				{
					"id": 721560101,
					"content": "E la seconda Pietra protettiva è sigillata. Ne mancano solo due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560102
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721560102,
					"content": "Diamo uno sguardo alle due Pietre protettive rimaste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560103
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721560103,
					"content": "Se sigilliamo tutte le Pietre protettive, la tempesta dovrebbe calmarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560104
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721560104,
					"content": "Allora sarà meglio muoversi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721560105
					]
				},
				{
					"id": 721560105,
					"content": "Spero solo che ciò che dice questa \"Neko\" sia vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721560106,
					"content": "È la nostra unica pista, riguardo alla tempesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721560107,
					"content": "In ogni caso, diamo prima un'occhiata a quelle Pietre protettive.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721560108,
						721560109
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721560108,
					"content": "Sì, andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721560110
					]
				},
				{
					"id": 721560110,
					"content": "La tempesta e queste Pietre protettive... Dovremo scrivere un bel rapporto dettagliato per la Gilda, più tardi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721560109,
					"content": "Perlomeno, avviciniamoci.",
