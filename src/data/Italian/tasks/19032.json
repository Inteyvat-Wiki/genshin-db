			"dialogs": [
				{
					"id": 1903203101,
					"content": "*singhiozza* Eh? Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203102,
					"content": "Mm... Puoi... P-Puoi aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203103,
					"content": "Aiutarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "Ehm, quell'esorcista... con i capelli blu... mi fa paura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203106,
					"content": "P-Puoi portarlo lontano da qui? Mi spaventa da morire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203107,
					"content": "Subisci l'influenza della sua energia yang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "Non avevo il coraggio di avvicinarmi a lui... La sua energia... è orribile! Mi farà sparire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203110,
					"content": "...Non voglio sparire! Ti prego, aiutami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203111,
					"content": "Chissà se ti considererebbe uno spirito maligno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "...Beh... H-Ho un'idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203114,
					"content": "Mmm... Qualche minuto fa ho visto l'esorcista dai capelli blu l-litigare con qualcuno laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203115,
					"content": "Farò scappare quei piantagrane, ma d-dovrai chiedere all'esorcista di lasciarmi andare, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203116,
					"content": "Stai dicendo la verità?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "C-Certamente... Qianqian non dice mai bugie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203120,
					"content": "Quindi, ecco... Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203121,
					"content": "Sarà lui a decidere, ma cercherò di spiegargli la situazione meglio che posso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "Ehm... oh, va bene... Quindi, immagino che sia un \"sì\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203123,
					"content": "Spero che l'esorcista dai capelli blu sia una brava persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203124,
					"content": "Ehm... quindi, io lo aiuto e tu vai a parlargli. Speriamo che mi lasci in pace... D'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203118,
					"content": "Posso pensarci io a toglierlo dai guai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "...Sì, ma... sarà complicato. Ho già in mente un piano, devi credermi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203112,
					"content": "Dovrà essere lui a decidere cosa fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "Ecco perché non ti avevamo ancora vista.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "Perché io?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}