					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745240401,
					"content": "#Bene, bene, {F#piccolina}{M#piccolino}. Che coincidenza! O sei {F#venuta}{M#venuto} di corsa dopo aver saputo del mio programma per la giornata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240402,
					"content": "Sei appena andata a vedere la Shogun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "Wow, che ottimo fiuto che hai... Ma no, stavo semplicemente portando degli spuntini e delle light novel popolari a un'amica che... non è proprio estroversa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240405,
					"content": "Anche Ei sta seguendo le ultime serie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "A sentir lei, intende \"informarsi sui recenti cambiamenti nelle preferenze degli abitanti di Inazuma in fatto di intrattenimento e svago\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240407,
					"content": "Ne ha persino discusso con me. È iniziata come una seria analisi delle preferenze dei lettori, naturalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240408,
					"content": "...Ma dopo poco, mi ha chiesto all'improvviso: \"Allora, che fine ha fatto quel personaggio?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240409,
					"content": "Eheh, a quanto pare nemmeno la possente Raiden Ei è immune al fascino di un racconto avvincente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240410,
					"content": "L'espressione che avevi mentre lo dicevi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "Oh? È questo il vero motivo per cui sei qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240413,
					"content": "Oh, quanto ti devo essere mancata durante i tuoi viaggi, per voler scattare queste foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240414,
					"content": "Fai pure. Ma scegli con attenzione le angolazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240411,
					"content": "...È davvero degna di essere ricordata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "Sento un profumo dolce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
