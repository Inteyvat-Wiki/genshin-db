					}
				]
			},
			"dialogs": [
				{
					"id": 750870701,
					"content": "Eh? Taruka! Sei già qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870702,
					"content": "#{NICKNAME}! Sono così felice che tu stia bene... Ho raccontato a mia sorella e agli altri cos'è successo. Lamizana è un idiota, proprio come pensavo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870703,
					"content": "Cruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870704,
					"content": "Sì, perfino più stupido di te, cervello di gallina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870705,
					"content": "Cruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870706,
					"content": "#D'accordo, va bene, dev'essere molto triste dopo esserti stato lontano così a lungo. Ha dimostrato di avere un grande spirito di squadra con {REALNAME[ID(2)|SHOWHOST(true)]}, poco fa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870707,
					"content": "Ci sono comunque margini di miglioramento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "Beh, è comunque un Saurico giovane. Fintanto che lo tratterai bene, Taruka, Paimon è sicura che diventerà un Qucusauro eccezionale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870709,
					"content": "Kraaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870710,
					"content": "A proposito... Come hai fatto a tornare qui? Qualcuno ti ha trovato e tratto in salvo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870711,
					"content": "Sono fuggito da solo. Volevo portare Oberon con me, ma era ossessionato dai Saurocracker e non voleva muoversi. Mi sono arrabbiato e me ne sono andato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870712,
					"content": "Eh? È stato così facile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870713,
					"content": "Dopo aver studiato i movimenti dei Saurici guardiani, ho scoperto che c'era una via d'uscita e sono riuscito a filarmela senza problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870714,
					"content": "Sai, forse sei la persona più affidabile tra i presenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870715,
					"content": "Perché ci avete messo tanto?! Stavo giusto per sistemare le cose con quella bugiarda... E p-per scusarmi ufficialmente con voi, naturalmente... Ho preso delle decisioni troppo arbitrarie e ho quasi incastrato delle persone innocenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870716,
					"content": "È troppo tardi ormai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "Proprio così! Sei arrivato solo dopo che era tutto finito. Se questo non è \"cercare di prendersi il merito degli altri\", Paimon non sa cosa sia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870720,
					"content": "Non so cosa dire. Ti pagherò il compenso pattuito o qualsiasi altra somma tu voglia. Non baderò a spese. E, se ti farà sentire meglio, puoi anche colpirmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870721,
					"content": "Sono un uomo di parola, non cercherò di sottrarmi alle mie responsabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870722,
					"content": "#Ti faremo prendere a pugni da {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "Ahi! Mi fanno già male solo al pensiero! Vi prego, abbiate pietà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870727,
					"content": "Hai appena detto che sei un vero uomo e che non cercherai di sottrarti alle tue responsabilità, no? Che razza di perdente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870728,
					"content": "#Lasciamo stare, non ci abbassiamo a tanto. {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}, siete d'accordo con Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870729,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Grazie per avermi perdonato. Le porte della scuola di volo... beh, non ha delle porte vere e proprie, ma le sue porte simboliche saranno sempre aperte per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870731,
					"content": "#Visto che tu e {REALNAME[ID(2)|SHOWHOST(true)]} siete così in sintonia, vorrei sapere come fai a fare amicizia con i piccoli Saurici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870732,
					"content": "Hihi, non c'è problema. Torneremo presto, non appena potremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870724,
					"content": "#Ti farò dare un bel calcio sulle dita dei piedi da {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870718,
					"content": "Pretendo un risarcimento! Insieme al premio di partecipazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870719
					]
				},
				{
					"id": 750870719,
					"content": "Quello non te lo sei dimenticato, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
