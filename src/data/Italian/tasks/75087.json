			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Temach"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750875901,
					"content": "Stiamo organizzando delle altre sfide di volo, trovi i dettagli sulla bacheca. Puoi provare a partecipare, se ti senti in grado... Ovviamente, se vincerai, avrai diritto a un premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875902,
						750875905,
						750875909
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875902,
					"content": "A proposito della Scuola di volo Pakpaka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875903
					]
				},
				{
					"id": 750875903,
					"content": "In realtà, non ho idea del perché si chiami proprio così. Ma parlando di Pakpaka... Hai mai sentito la storia di Kuntur e del malvagio stregone Rumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875904
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875904,
					"content": "Questo perfido mago sconfisse i guerrieri della tribù e li tramutò in Pakpaka... il che non sembra una cosa positiva. Magari i Pakpaka sono molto veloci quando volano... Non saprei proprio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875905,
					"content": "A proposito di Lamizana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875906
					]
				},
				{
					"id": 750875906,
					"content": "Ahah... È un bravo guerriero, ma come insegnante lascia a desiderare. E come avversario nelle competizioni di volo è... discreto, direi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875907
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875907,
					"content": "Ma in fondo, che senso avrebbe venire qui se non si avessero problemi con il volo? Non credo convenga essere troppo severi... *sospira* Beh, cose del genere sono capitate anche in passato, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875908
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875908,
					"content": "Per questo ora tendo a incoraggiare le persone il più possibile. Credo che come approccio possa portare agli stessi risultati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875909,
					"content": "Devo andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875910
					]
				},
				{
					"id": 750875910,
					"content": "Ci vediamo, torna pure quando vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				}
			]
		},
