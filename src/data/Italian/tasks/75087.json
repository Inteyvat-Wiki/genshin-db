					"nextDialogs": [
						750870303
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870303,
					"content": "Uhm... Sei tu, Oberon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870304,
					"content": "Croooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870305
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870305,
					"content": "Sei, ehm... cresciuto molto dall'ultima volta che ci siamo visti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870306,
					"content": "Taruka aveva ragione sul fatto che metti su peso facilmente. Ah, giusto, dov'è lui? Perché non è con te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870307,
					"content": "Cooo... Crrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870308
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870308,
					"content": "Ehm, in ogni caso, forse prima dovremmo andarcene da qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870309,
					"content": "Ora che abbiamo trovato Oberon, non dovremo più nasconderci, giusto? Paimon è ancora molto preoccupata per Taruka... Dobbiamo sbrigarci a trovarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
