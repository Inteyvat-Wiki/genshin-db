			"dialogs": [
				{
					"id": 750870501,
					"content": "#Visto che siete {F#riuscite}{M#riusciti} ad arrivare fin qui, ora posso smettere di recitare la parte della brava mercante, giusto? Mi serve una pausa da tutti quegli idioti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870502,
					"content": "Che perfida che sei! Come puoi accusare gli altri di aver fatto le cattiverie che hai commesso tu? Hanno tutti pensato male di noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870503,
					"content": "Sono cattiva, è naturale che commetta cattiverie. Inoltre, il fatto che quei tre idioti abbiano pensato male di voi dimostra solo che sono brava nel mio lavoro, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870504,
					"content": "Ahah, e ora farò qualcosa di ancora più malvagio! Questa volta non ve la caverete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870505,
					"content": "#{F#Prendile}{M#Prendili}, Mucchio di pelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870506,
					"content": "Guoooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870507
					],
					"speakerTitle": "Mucchio di pelo"
				},
				{
					"id": 750870507,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#Andiamo, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}! Davvero vuoi combattere contro un avversario molto più grande di te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870510,
					"content": "Crrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870511
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870511,
					"content": "Roar! Roooooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "Oberon sembra un po' fiacco. Paimon non capisce se sia perché è preoccupato per Taruka o perché ha mangiato troppi Saurocracker...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870513,
					"content": "#Che {REALNAME[ID(2)|SHOWHOST(true)]} abbia provato a proteggerci coraggiosamente per tirarlo su di morale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870514,
					"content": "In questo mondo, il coraggio da solo non basta a cambiare le cose. Rispetto a qualcosa di tanto illusorio, il controllo assoluto è più affidabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870515,
					"content": "Attacca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870516,
					"content": "#Incredibile! {REALNAME[ID(2)|SHOWHOST(true)]} ha schivato l'attacco! Questo è esattamente ciò che i Tepetlisauri sanno fare bene! Nemmeno il Signore dei cieli può toccarli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870517,
					"content": "Attacca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, è pronto ad attaccare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870530,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "L'attacco è andato a segno! E ha inflitto... pochissimi danni?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870532,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "È già sorprendente aver colpito l'avversario! Fiuuu, Paimon si sente già stremata. Siamo davvero solo al primo round? Cosa sta succedendo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870534,
					"content": "Ora tocca a me, giusto? All'attacco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870535,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ha assunto una posizione difensiva per resistere al feroce assalto dell'avversario! È riuscito a bloccare il colpo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870536,
					"content": "Aspetta, il tuo Saurico si è difeso da sé subito dopo l'attacco! Che imbroglione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870537,
					"content": "Il segreto per vincere un gioco a turni è non rispettare i turni stessi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "Qual è la prossima mossa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870539,
					"content": "...Krraaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870540
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870540,
					"content": "Eh? Sembra che Oberon si stia riprendendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870541,
					"content": "Roar! Roooooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870542
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870542,
					"content": "Paimon non capisce cosa stia dicendo, ma sembra che abbiano raggiunto una sorta di... tacita intesa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870543,
						750870545,
						750870547,
						750870550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870543,
					"content": "Usa un attacco coordinato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870544
					]
				},
				{
					"id": 750870544,
					"content": "Oh! Facci vedere cosa sa fare la futura stella della scuola di volo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870552,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#Oberon ha bloccato la via di fuga aerea dell'avversario e {REALNAME[ID(2)|SHOWHOST(true)]} sta lanciando un assalto! Questo attacco combinato è fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870554,
					"content": "Mucchio di pelo è stato colpito in pieno! Si sarà fatto male al piede? Sarà stato un po' come \"sbattere il mignolo del piede\"! L'avversario appare turbato e incapace di muoversi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870555,
					"content": "È il momento di attaccare, ma ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#Puoi farcela... ma dovresti lasciare che se ne occupi {REALNAME[ID(2)|SHOWHOST(true)]}, visto che non ha molte occasioni per mostrare le sue abilità! Non essere così infantile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870565,
					"content": "Kraaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870566,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#Oh? Sembra che {REALNAME[ID(2)|SHOWHOST(true)]} e Oberon abbiano un piano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870568,
					"content": "Dei Saurocracker? Da dove sono sbucati fuori?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870569,
					"content": "Coo! Krraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870570,
					"content": "Eh? Li stavi nascondendo sotto le ali? Che Saurico astuto... Taruka deve aver faticato molto a occuparsi di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870571,
					"content": "Crrooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870572,
					"content": "Non è il momento giusto! Ehi, fermati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870573,
					"content": "Eh? Mucchio di pelo ha ignorato il suo ordine e si è lanciato verso i Saurocracker! La possibilità di recuperare 5 PS è troppo allettante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870574,
					"content": "Non ha ancora capito che è il Saurico che sta per essere servito sul piatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870575,
					"content": "#In breve, la battaglia è continuata in questo modo, con scambi di colpi da parte di entrambi.\\n{REALNAME[ID(2)|SHOWHOST(true)]} ha agito con coraggio, come se avesse qualcosa da dimostrare. Sebbene non sia riuscito a dimostrarsi un allievo eccelso presso la scuola di volo, le sue altre capacità si sono dimostrate di grande aiuto per i suoi compagni.\\nSorprendentemente, persino la stazza di Oberon è tornata inaspettatamente utile al gruppo. Grazie alle sue dimensioni, ben maggiori di quelle della media dei Qucusauri, ha serrato i cieli della battaglia e inflitto un colpo micidiale a Mucchio di pelo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "La stessa Quilla si è dimostrata una combattente inefficace, ed è pertanto fuggita subito dopo che Mucchio di pelo ha perso il suo interesse nel combattere.\\n\"Insolente che non sei altro! La prossima volta non vincerai così facilmente, vedrai!\"\\nDopo aver pronunciato una tipica frase da cattivone in fuga, Quillia si allontana con Mucchio di pelo ferito.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "Ah! Paimon ha dimenticato di chiederle dove si trovi Taruka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870578,
					"content": "Cruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870579,
					"content": "Ehi, su con la vita. Taruka è molto intelligente, se la caverà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870580,
					"content": "Roar! Roooooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#Sì, è quello che pensi anche tu, {REALNAME[ID(2)|SHOWHOST(true)]}, vero? Ma prima riportiamo Oberon alla scuola di volo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870557,
					"content": "Persuadi l'avversario ad arrendersi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "Se le parole potessero risolvere i problemi, questo mondo non sarebbe così pieno di conflitti, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870559,
					"content": "Ahem... Paimon dice solo che è poco probabile che funzionerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870560,
					"content": "Catturalo con un oggetto magico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870562,
					"content": "Scappiamo adesso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "Roar... Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#Eddai! Stai facendo demoralizzare {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870545,
					"content": "Difenditi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "Un momento, siamo due contro uno. L'avversario probabilmente non riuscirà ad attaccare entrambi i bersagli contemporaneamente, non è come sprecare un turno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870547,
					"content": "Usa un oggetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "Mangia un Saurocracker per recuperare 5 PS!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870549,
					"content": "...Non che fosse necessario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870550,
					"content": "Scappa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "Suvvia, le cose stanno andando bene. Perché stai ancora pensando di filartela?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870519,
					"content": "Difenditi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "Rooo... Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#Sembra che {REALNAME[ID(2)|SHOWHOST(true)]} abbia capito che una difesa troppo cauta gli farà perdere delle buone occasioni, così ora si sta preparando ad attaccare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870522,
					"content": "Usa un oggetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "Non possiamo usare nulla, al momento! Inoltre, non credi che ormai sia troppo tardi per piazzare una trappola per belve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870524,
					"content": "Rooo... Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#Ah! {REALNAME[ID(2)|SHOWHOST(true)]} sta per attaccare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870526,
					"content": "Scappa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "Non è il momento di fuggire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870528,
					"content": "Wrrooo... Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#Persino {REALNAME[ID(2)|SHOWHOST(true)]} ha capito! Guarda, è pronto ad attaccare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
