			"dialogs": [
				{
					"id": 750876301,
					"content": "#{F#Benvenuta}{M#Benvenuto} alla Scuola di volo Pakpaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876302,
						750876303
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876302,
					"content": "Cosa fate qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876304
					]
				},
				{
					"id": 750876304,
					"content": "Offriamo a tutti i cadetti l'orientamento necessario e l'aiuto di cui hanno bisogno. Le cose sono cambiate tanto, sai. In passato, gli allievi non venivano trattati con altrettanto riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876305
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876305,
					"content": "Le cose cambiarono quando, tempo fa, un allenatore si espresse in modo... piuttosto severo nei confronti di un allievo, e disgraziatamente l'allievo in questione aveva un diavolo per capello, a dir poco... *sospira* Già, non è un aneddoto molto divertente da rivangare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876306
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876306,
					"content": "Comunque, la nostra politica riguardo all'insegnamento da allora è cambiata. In fondo, così come nessuno ama ricevere schiaffi in faccia, nessuno odia ricevere dei complimenti... Dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876303,
					"content": "Vado, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876307
					]
				},
				{
					"id": 750876307,
					"content": "Ti auguro buona giornata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				}
			]
		}
	]
