			},
			"dialogs": [
				{
					"id": 750870901,
					"content": "Perché qui ci sono dei Saurocracker? E questa lettera...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870902,
					"content": "Quindi c'era Quilla dietro a ogni cosa! Ma Paimon non pensava che il motivo fosse questo... Paran non è per niente fortunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870903,
					"content": "Quando Paimon pensa a Taruka e a Oberon prigionieri nell'accampamento davanti a noi, Paimon si sente male per non aver mosso un dito per aiutarli... Dopotutto, non hanno fatto nulla di male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870904,
					"content": "#Uhm... {NICKNAME}, pensiamo a un modo per salvarli, ci stai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870905,
					"content": "Se <color=#00E1FFFF>ci mescolassimo tra gli Iktomisauri di pattuglia</color>, forse riusciremmo a entrare più facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7508759,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_B_OR_ETCAND",
				"conditions": [
					{
