			},
			"dialogs": [
				{
					"id": 110000401,
					"content": "Questi cinghiali sembrano sani e vivaci. Scommetto che la loro carne è di ottima qualità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000402
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000402,
					"content": "Uff, solo a pensarci mi viene l'acquolina in bocca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				}
			]
		},
		{
			"id": 1100005,
			"completionStepIds": [
				1100005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100005",
							"2"
						],
						"stepId": 1100005,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"100061",
							"3"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "Wow! Fantastico! Una parte la cuocerò a frittura bassa, una parte la farò con i funghi... Ooh, e chissà come si sposa bene con la bava di Melmoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000502,
					"content": "È persa nel suo mondo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "Paimon pensa si sia completamente dimenticata di noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000506,
					"content": "Uh, scusate! Mi sono emozionata pensando a nuove ricette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000507,
					"content": "Come promesso, uno spuntino gustoso! Dai, provatelo e ditemi cosa ne pensate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000508,
					"content": "#Siamo {F#diventate le tue assaggiatrici}{M#diventati i tuoi assaggiatori}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000509,
					"content": "Accipicchia, è... delizioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000510,
					"content": "Puoi dirci come prepararlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000511,
					"content": "Ihihih, certo! Solo che non ho ancora scritto la ricetta, mmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000512,
					"content": "Ci sono! Ne preparo subito un altro, così potrete guardare anche voi. Sono sicura che imparerete subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000513,
					"content": "Sembra piuttosto difficile da realizzare, ci vorrà ben altro per imparare a cucinarlo. E non abbiamo nemmeno una padella o dei condimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000514,
					"content": "Suvvia, è semplice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000515,
					"content": "Possiamo friggere su una lastra di pietra e usare del grasso di cinghiale. Costruire una stufa con le pietre, usare l'erba secca per accenderla, dei ramoscelli per il fuoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000516,
					"content": "I Fiordolci andranno bene come dolcificante. Quanto al sale, l'altro giorno ho trovato un sacco di salgemma in una grotta; ce ne sarà ancora un bel po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000517,
					"content": "Sembra che l'abbia già fatto un milione di volte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "Ihihih, non riesco a trattenermi quando ho la possibilità di provare qualcosa di nuovo. Ma non posso nemmeno portare con me tutta la mia cucina ogni volta che esco di casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000520,
					"content": "Datemi un secondo per preparare tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000521,
					"content": "Ehi! Cosa pensate di fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000601,
					"content": "Questo è l'habitat naturale dei cinghiali; qui non potete cacciarli! Li farete scappare tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000602,
					"content": "Noi cacciatori sappiamo meglio di chiunque altro che non si uccide la gallina per prendere l'uovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000603,
					"content": "Ah! Capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000604,
					"content": "La carne più fresca e della migliore qualità proviene da cinghiali allevati all'aperto e cresciuti nel loro ambiente naturale! Se scappassero tutti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000605,
					"content": "...sarebbe un duro colpo per il mondo della cucina. Anzi, per l'umanità intera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000606,
					"content": "È un modo, ehm... peculiare di vedere la cosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "Mi dispiace. Mi sono lasciata trascinare e non ho pensato alle conseguenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000609,
					"content": "*sospira* Dovresti scusarti con Draff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000610,
					"content": "Come nostro capo, ci tiene a sottolineare sempre l'importanza delle regole di caccia. Temo che sia molto arrabbiato, in questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000611,
					"content": "Che cosa facciamo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
				},
				{
					"id": 110000613,
					"content": "Ho commesso un errore e dovrei andare a scusarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000614,
					"content": "Veniamo con te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000615
					]
				},
				{
					"id": 110000615,
					"content": "Ihihih, grazie. Quando tutto questo sarà finito, vi preparerò altri spuntini deliziosi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000616,
					"content": "Tranquilla, non preoccuparti. Paimon te lo ricorderà anche se ti dovesse passare di mente.",
