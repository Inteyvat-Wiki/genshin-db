			"dialogs": [
				{
					"id": 220070301,
					"content": "Mmmh... Abbiamo cercato dappertutto, ma non abbiamo ancora trovato niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070302,
					"content": "Vuoi continuare a cercare? O vuoi tornare da Bao'er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070303,
						220070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070303,
					"content": "Continuiamo a cercare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070305
					]
				},
				{
					"id": 220070305,
					"content": "Va bene, allora. Tieni gli occhi ben aperti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070304,
					"content": "Torniamo indietro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070306
					]
				},
				{
					"id": 220070306,
					"content": "Sì, andiamo a vedere se Bao'er ha qualcos'altro da dirci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
