			"dialogs": [
				{
					"id": 220070201,
					"content": "Dov'è finita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070202
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070202,
					"content": "Questa scatola è... un po'...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "Ehi! Guarda bene: vedrai che ho riempito la scatola con dei vestiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070204,
					"content": "Sono una studiosa professionista, eh! Non faccio errori da principiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070205,
					"content": "In ogni caso, grazie per avermi aiutato a cercare la reliquia, non potrei mai sconfiggere quei mostri da sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
