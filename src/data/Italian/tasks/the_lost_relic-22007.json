			"dialogs": [
				{
					"id": 220070401,
					"content": "Hai trovato la reliquia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070402
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070402,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070403
					]
				},
				{
					"id": 220070403,
					"content": "Fammi vedere... Wow! Sì, questa è una reliquia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070404
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070404,
					"content": "Uhm... Non sembra quella che ho perso. Ma è comunque una reliquia preziosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070405
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070405,
					"content": "Questa reliquia deve essere custodita da una persona esperta. Non preoccupatevi, è al sicuro con me... Eheheh... Vi ringrazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
