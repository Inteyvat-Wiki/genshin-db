			"dialogs": [
				{
					"id": 220070101,
					"content": "Dov'è finita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070102,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "Stavo esplorando delle rovine, quando all'improvviso dei mostri mi hanno attaccata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070104,
					"content": "In preda al panico, sono fuggita via e devo aver fatto cadere la reliquia proprio dove l'avevo trovata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070105,
					"content": "Dopo che i mostri se ne sono andati, sono tornata, ma non ho trovato la reliquia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070106,
					"content": "Ho cercato dappertutto, ma non sono riuscita a trovarla. Forse l'hanno presa quei mostri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070107,
					"content": "Potresti aiutarmi a cercarla? Se la trovi, puoi metterla in questa scatola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
		{
			"id": 2200702,
