			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "\"Da studente fuori sede, quando sono all'Akademiya percepisco ogni giorno di più la magnificenza dell'Archon di Dendro.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432102,
					"content": "\"A Mondstadt bisognerebbe sfogliare decine di libri solo per individuare le diverse teorie su una semplice domanda.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432103,
					"content": "\"Ma le informazioni rilevanti sono disponibili in un istante sul Terminale dell'Akasha. Credo che al mondo non esista invenzione migliore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324322,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
