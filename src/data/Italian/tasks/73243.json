	"talks": [
		{
			"id": 7324301,
			"completionStepIds": [
				7324301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324301",
							"2"
						],
						"stepId": 7324301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "\"Tutte le comunicazioni e gli annunci esecutivi dell'Akademiya sono stati trasferiti sull'Akasha. Questa bacheca degli annunci è riservata esclusivamente alle comunicazioni tra istruttori e studenti. Non sono ammessi commenti a opera di esterni!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "\"Per un'atmosfera più serena, per scambi accademici migliori e per scrivere tesine con il sorriso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430202,
					"content": "\"Mostriamo il nostro supporto a Vikram come prossimo Gran Conservatore!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430203,
					"content": "\"Siete invitati a unirvi agli 'Amici della confraternita di Vikram'. Assisteremo insieme all'ascesa di un Gran Conservatore giovane, affabile e divertente!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "\"Mai dimenticare le tre virtù e i sei peccati dell'Akademiya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430302,
					"content": "\"Ammonimento, Ingegno e Pragmatica... Le virtù a cui tutti i ricercatori dovrebbero aspirare.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430303,
					"content": "\"Tre virtù che Rifaet pratica da decenni.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430304,
					"content": "\"La 'Società di lettura Fravashi' vi accoglierà a braccia aperte per camminare con saggezza a fianco del futuro Gran Conservatore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "\"A tutti i membri, vi rendo onore per la vostra instancabile ricerca delle virtù.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430402,
					"content": "\"Tuttavia, ho sentito dire che più della metà degli scritti di Rifaet è opera di terzi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430403,
					"content": "\"È per questo che, nonostante i molti successi, ha mantenuto un basso profilo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430404,
					"content": "\"Anche se per i messaggi di una bacheca degli annunci non sono richieste fonti attendibili come succede per le tesine, tale bacheca non è fatta per lanciare attacchi personali.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430405,
					"content": "\"Tutti questi commenti sono dettati solo dalla gelosia!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430406,
					"content": "\"Ho anche sentito dire che Vikram ha conquistato il cuore di molte ragazze con la sua eloquenza.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430407,
					"content": "\"Non sanno nemmeno che è sposato. Provi invidia per la sua popolarità, quindi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430408,
					"content": "\"È proibito qualsiasi tipo di attacco infondato ai danni dei ricercatori dell'Akademiya. Chiunque oserà diffondere altre notizie fasulle sarà consegnato ai Matra.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
							"2"
						],
						"stepId": 7324305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "\"Questa bacheca degli annunci non fa ancora parte dell'Akasha e vi si può accedere al di fuori del sistema.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430502,
					"content": "\"Si prega di notare che i messaggi non attinenti al normale ambito accademico sono severamente vietati.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "\"Vi ricordiamo gentilmente di rispettare i protocolli e le buone maniere dell'Akademiya anche al di fuori del campus.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430602,
					"content": "\"La gestione centralizzata della conoscenza è il caposaldo della 'Terra della saggezza'. Non rinunciate all'opportunità di studiare all'Akademiya per via di semplici errori non intenzionali.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "\"Di recente sono stati riscontrati diversi casi di contrabbando di Conoscenze in scatola. A seguito di un'indagine, verranno divulgate informazioni dettagliate ai mentori e agli studenti delle scuole interessate attraverso l'Akasha prima del prossimo Giorno del Jnagarbha.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430702,
					"content": "\"I mentori sono invitati a migliorare la comunicazione con gli studenti per alleviare il loro stress mentale causato dalla redazione delle tesine e prevenire potenziali crimini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324308,
			"completionStepIds": [
				7324308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324308",
							"2"
						],
						"stepId": 7324308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "\"Qualcuno direbbe che l'Akademiya stia spingendo troppo l'Akasha. Beh, io invece penso che non lo faccia abbastanza. La maggior parte dei Mahamata ha una scarsa produttività, e per certi versi sono persino peggiori di quelli che avevamo prima.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430802,
					"content": "\"Pensate, se solo potessimo assegnare il lavoro direttamente tramite l'Akasha e fargli anche gestire il trading nella Borsa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430803,
					"content": "\"Potremmo licenziare come minimo la metà dei Mahamata in servizio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430804,
					"content": "\"Effettivamente hai ragione. Forse è per questo che non lo stiamo facendo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "\"Come tutti sappiamo, è compito dei ricercatori approfondire la conoscenza. Eppure, l'attuale Akademiya è troppo impantanata nelle questioni amministrative.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430902,
					"content": "\"Molti studenti sono costretti a interrompere le ricerche per essere mandati a fare i Mahamata da qualche altra parte dopo aver terminato gli studi. Ciò non contraddice forse lo scopo dell'Akademiya?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430903,
					"content": "\"Non eravamo già arrivati a una conclusione simile sull'Akasha molto tempo fa?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732430904,
					"content": "\"Mentre il popolo si affida ancora alle superstizioni, noi siamo i più vicini alla verità. Come possiamo sottrarci al dovere di informare il mondo? Se smettiamo di interessarcene, Sumeru precipiterà nel caos!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "\"Da studente fuori sede, quando sono all'Akademiya percepisco ogni giorno di più la magnificenza di Sua Eccellenza Maggiore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431002,
					"content": "\"A Mondstadt bisognerebbe sfogliare decine di libri solo per individuare le diverse teorie su una semplice domanda.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431003,
					"content": "\"Ma le informazioni rilevanti sono disponibili in un istante sul Terminale dell'Akasha. Credo che al mondo non esista invenzione migliore.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "\"Da Pir Kavikavus in poi, l'Akademiya non ha mai incrementato il budget annuale per la Kshahrewar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431102,
					"content": "\"I piani alti si sono limitati a sostenere un controllo rigido delle macchine e degli sviluppi della tecnologia per garantire una società stabile e serena. In tal caso, direi che l'Akasha si potrebbe anche spegnere!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431103,
					"content": "\"Se non fosse stato per i finanziamenti a lungo termine di abili imprenditori come Lord Sangemah Bay, la Kshahrewar sarebbe sparita da tempo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "\"Mi fido del giudizio dei saggi e dei maestri, ma non pensate che l'Akademiya si affidi troppo all'Akasha?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431202,
					"content": "\"È evidente che il numero di studiosi itineranti partiti dalla nostra sede si è ridotto una volta che ci siamo abituati a usare l'Akasha. Credo sia opportuno limitare l'accesso all'Akasha per i nuovi studenti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431203,
					"content": "\"Come puoi dire una cosa del genere? Non sai che, senza l'Akasha, i culti nel deserto hanno finito per divorare dei serpenti velenosi crudi per acquisire la saggezza?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431204,
					"content": "\"A parte Sua Eccellenza Maggiore Rukkhadevata, è l'Akasha ad aver garantito la purezza della nostra conoscenza.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "Il seminario di botanica di questa settimana, presentato dal Guardiano della foresta Tighnari, si terrà come sempre al Pardis Dhyai. Invitiamo chiunque desideri partecipare a iscriversi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431302,
					"content": "Chiunque provi interesse per la botanica è il benvenuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431303,
					"content": "Ci scusiamo per il disagio, ma a causa delle troppe iscrizioni al seminario, l'Akademiya ha limitato la partecipazione ai soli studenti dell'Amu{RUBY#[S]Biologia}rta e ai guardaboschi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "\"Qualcuno ha letto l'ultimo romanzo della Casa editrice Yae? È di un autrice di Sumeru chiamata Pursina o qualcosa di simile... Ovviamente, è una della scuola di Amurta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431402,
					"content": "\"Se solo mi avessero preso all'Amurta... Avrei potuto girare tutto il giorno e avere ancora il tempo per scrivere storie. Invece no, sono qui nella scuola di Haravatat, dove per me ci sono solo ricerca e scrittura di articoli, altro che vedere il mondo là fuori!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431403,
					"content": "\"Eh? La Casa editrice Yae ha pubblicato qualcun altro prima di me? Questo comprometterà la mia reputazione come autorità in materia di light novel...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "\"Il commercio vero e proprio è gestito in modo completamente diverso da come descritto nei libri di testo. Se solo non avessi lasciato il Gran Bazaar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431502,
					"content": "\"Ora non posso più scrivere articoli, e ho pure finito i soldi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431503,
					"content": "\"Se continua così, sarà meglio abbandonare gli studi e unirmi agli Eremiti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "\"Non ho pregiudizi su coloro che provengono dal deserto, ma penso che il generale Mahamatra dovrebbe essere un ricercatore famoso, soprattutto per le questioni accademiche non risolvibili con una scazzottata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431602,
					"content": "\"Eh, è comunque meglio di quando eravate voi della Rtawahist a gestire tutto, almeno ora non ci sono pregiudizi. O pensi davvero che nessuno conosca le vere storie dietro a quei tassi di pubblicazione annuale?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431603,
					"content": "\"Senti, tu della Kshahrewar! Farai bene ad avere delle prove, o mi rivolgerò ai Matra!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "\"Posso tollerare che degli stranieri si iscrivano, ma permettere loro di accedere all'Akasha è tutt'altra questione...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431702,
					"content": "\"A prescindere dall'influenza che le menti straniere potrebbero esercitare sull'Akasha, non sappiamo quanti danni potrebbe arrecare al commercio di Sumeru la diffusione della conoscenza.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431703,
					"content": "\"Ricercatori che si preoccupano dell'economia? Questa è nuova.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431704,
					"content": "\"Ecco perché voi dell'Haravatat siete visti da tutti come degli snob. Non sarei qui se non avessi deciso d'imparare a creare una pittura migliore!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "\"È da un po' che non vedo quel nano del deserto... Direi che possiamo rilassarci un po'.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431802,
					"content": "\"Mi chiedo cosa gli sia preso al personale didattico per non avermi fatto passare la verifica questo semestre.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431803,
					"content": "\"Basta presentarsi per superare la verifica, quindi non dare la colpa agli altri se tu non studi. E anche se i Matra sono a corto di personale, fai comunque attenzione a come parli.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431804,
					"content": "\"I Matra sono solo una gerarchia che ostenta la propria autorità. Fermi tutti, ho appena ricevuto un messaggio dall'Akasha...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431805,
					"content": "\"Tutti noi dovremmo fare attenzione.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324319,
			"completionStepIds": [
				7324319
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324319",
							"2"
						],
						"stepId": 7324319,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "\"...Riguardo alle indagini su Zandik... Dastur... Causa della morte... Possibile omicidio...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431902,
					"content": "\"...Zandik... dopo la cancellazione dall'elenco... riguardo all'Eleazar... ma mancano le prove...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431903,
					"content": "\"...La documentazione è sparita all'improvviso... Anno sconosciuto... Inizio dell'epidemia di Eleazar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431904,
					"content": "\"...Prima della scomparsa... Leggenda di Varuna... è un'ossessione...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732431905,
					"content": "(Il testo che segue è stato deturpato in modo da renderlo del tutto illeggibile.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324320",
							"2"
						],
						"stepId": 7324320,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "\"Dopo aver consultato il diario astrale del grande saggio di Tabari, ho finalmente capito una cosa: che si tratti della guerra degli dèi o della caduta di antichi imperi, alla fine è tutto un microcosmo dei movimenti celesti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432002,
					"content": "\"Il cielo stellato sopra di noi è l'unica cosa che vivrà in eterno.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432003,
					"content": "\"Ehm, sentimentalismi a parte, voi della Rtawahist avete intenzione di riassumere tutti gli avvenimenti antichi in un'unica soluzione?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432004,
					"content": "\"Vorrei che esaminaste la cosa da un punto di vista storico, senza limitarvi a guardare le stelle e a riflettere.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432005,
					"content": "\"Ma che ne sai tu?!? Si chiama esplorare le leggi dell'universo! Non mi stupisce che tutti voi della Vahumana siate dei topi di biblioteca!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324321,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
