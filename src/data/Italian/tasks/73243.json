						"stepId": 302821,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432201,
					"content": "\"Mi fido del giudizio dei saggi e dei maestri, ma non pensate che l'Akademiya si affidi troppo all'Akasha?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432202
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432202,
					"content": "\"È evidente che le prestazioni degli studiosi itineranti partiti dalla nostra sede si sono ridotte, una volta che ci siamo abituati a usare l'Akasha. Credo sia opportuno limitare l'accesso all'Akasha per i nuovi studenti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432203
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432203,
					"content": "\"Come puoi dire una cosa del genere? Non sai che, senza l'Akasha, i culti nel deserto hanno finito per divorare dei serpenti velenosi crudi per acquisire la saggezza?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432204
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432204,
					"content": "\"La gente non capisce che l'Akasha ha garantito la purezza della nostra conoscenza.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
		{
			"id": 7324323,
			"completionStepIds": [
				7324301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
