					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432401,
					"content": "\"Questa bacheca è a esclusivo uso interno dell'Akademiya. La diffusione di informazioni false e illecite è severamente vietata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432402
					],
					"speakerTitle": "Bacheca degli annunci"
				},
				{
					"id": 732432402,
					"content": "\"Il Matra ricorda ancora a tutti i ricercatori di seguire le norme del codice di condotta!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		}
