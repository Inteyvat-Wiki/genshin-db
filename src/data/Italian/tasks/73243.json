			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432301,
					"content": "\"Dato che il sistema dell'Akasha non è più in uso, la bacheca è nuovamente in servizio. Su di essa sarà possibile trovare tutti gli annunci esecutivi e le comunicazioni dell'Akademiya. Non sono ammessi commenti a opera di esterni!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca degli annunci"
				}
			]
		},
