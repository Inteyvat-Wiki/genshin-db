					}
				]
			},
			"dialogs": [
				{
					"id": 747010101,
					"content": "Eh? Perché Paimon ha l'improvvisa sensazione che qui ci sia una vasca in più? Che c'è scritto su quel cartello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010102,
					"content": "\"Pericolo. Non avvicinarsi!\" Che significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010103,
					"content": "Esattamente quello che c'è scritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010104,
					"content": "Waah! Sandrone... Hai fatto prendere uno spavento a Paimon! Hai messo tu questo cartello qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010105,
					"content": "Già. Spero eviterà ai curiosoni di caderci dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010106,
					"content": "Che ha questa vasca di così speciale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010107,
					"content": "È piena di piranha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010108,
					"content": "C-Che?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010109,
					"content": "Ahah, stavo scherzando. C'hai creduto davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010110,
					"content": "Ho scoperto che alcuni dei pesci nell'acquario sono molto territoriali, e possono diventare piuttosto aggressivi. Così li ho trasferiti qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010111,
					"content": "Non spaventare Paimon così! Quindi, è come una zona di quarantena speciale per i pescetti più ostili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010112,
					"content": "Esatto, l'acqua in questa vasca è molto più profonda e c'è molto più spazio. Aiuta a calmare i pesci più territoriali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010113,
					"content": "Ho anche chiesto delle esche speciali a Sigewinne di Forte Méropide per aiutarli a calmarsi un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010114,
					"content": "Oh, cavoli... Allora ti sta a cuore il benessere di questi pesciolini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010115,
					"content": "Credo che nessuno voglia vedere l'acquario trasformarsi in un bagno di sangue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010116,
					"content": "Sicuro! Comunque, perché non lasci che ce ne occupiamo noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010117,
					"content": "Se insistete. Quando i pesci nella vasca iniziano a sentirsi abbastanza a loro agio da nuotare in superficie, significa che si stanno riprendendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010118,
					"content": "Quindi, una volta che saranno tutti tranquilli e felici, potremo rimetterli nell'acquario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010119,
					"content": "Questo spetta a voi deciderlo. Io mi occupo solo di rimuovere quelli indisciplinati e portarli qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 747010120,
					"content": "Capito! Ma quel cartello è davvero troppo spaventoso. Potremmo cambiarlo con qualcosa di un po' meno terrificante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010121,
					"content": "Mmh... Se volete. I pesci sono vostri, lo lascio decidere a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
}