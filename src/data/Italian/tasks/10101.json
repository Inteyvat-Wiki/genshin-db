			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101011001,
					"content": "#Ah, rieccoti. Ho sbrigato le pratiche, ora sei {M#il}{F#la} custode di questo libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011002
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011002,
					"content": "Grazie, Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011003,
					"content": "...Ma Paimon pensa che ci stiamo dimenticando qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011004,
						101011005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011004,
					"content": "La Guida di viaggio di Teyvat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011007
					]
				},
				{
					"id": 101011007,
					"content": "Guarda su quello scaffale! Non è la <color=#00E1FFFF>Guida di viaggio di Teyvat</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011008,
					"content": "E guarda quante copie ce ne sono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011009,
					"content": "Eheh... La <color=#00E1FFFF>Guida di viaggio di Teyvat</color> è una pubblicazione in serie. Non fa parte della collezione ufficiale della biblioteca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011010
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011010,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011011,
					"content": "Prendine una. Considerala il tuo compenso per avermi fatto da aiutante oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011012
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011012,
					"content": "Con te al mio fianco, il mio lavoro fastidioso è stato un po' meno seccante del solito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011013
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011013,
					"content": "Bah! La Guida di viaggio di Teyvat era solo un'esca per farci lavorare tutto il giorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011014,
					"content": "Non avevo previsto che qualche restituzione di routine ci avrebbe portato fuori dalla città, figuriamoci in delle rovine sotterranee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011015
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011015,
					"content": "Come compenso per avervi trascinati in questo caos, prendete pure questi souvenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011016
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011016,
					"content": "Wow, Lisa è andata a comprarci dei souvenir speciali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101011017,
					"content": "In realtà erano destinati alla nostra prossima uscita insieme, ma... Non importa, possiamo parlare del da farsi quando sarà il momento. Spero che l'idea ti aggradi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011018
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011018,
					"content": "*sbadiglia*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011005,
					"content": "Un compenso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011006
					]
				},
				{
					"id": 101011006,
					"content": "#Che lett{M#ore}{F#rice} vorace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011007
					],
					"speakerTitle": "Lisa"
				}
			]
		},
