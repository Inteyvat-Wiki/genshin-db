			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "Il ladro vive in queste <color=#00E1FFFF>rovine</color>? La gente di Mondstadt è proprio stramba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010702,
					"content": "Ti prego, non trarre conclusioni così insensate sulle preferenze residenziali degli abitanti di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010703,
					"content": "Mi sembra molto più probabile che sia opera di qualche furfante malintenzionato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010704,
					"content": "Gli Hilichurl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "Rubare libri non è certo nello stile degli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010706,
					"content": "Al massimo lo userebbero per tenere acceso il loro fuoco da campo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010712,
					"content": "È più probabile che sia opera dell'<color=#00E1FFFF>Ordine dell'Abisso</color>. Dopotutto, sembrano avere un talento speciale nello scivolare dentro e fuori da qualsiasi luogo come fantasmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010713,
					"content": "Inoltre... C'è un sigillo elementale all'ingresso. Sembra l'incantesimo di un Mago dell'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010714,
					"content": "Un sigillo? Come lo spezziamo? Diventerà un'altra impresa titanica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010715,
					"content": "Non preoccuparti. Se pensi che un piccolo incantesimo possa fermarmi, ti sbagli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010716,
					"content": "Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010717,
					"content": "Avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010718,
					"content": "Wow...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010719,
					"content": "Allora anche Lisa a volte lavora sodo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010707,
					"content": "L'Ordine dell'Abisso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "È come se mi leggessi nel pensiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010709,
					"content": "La Gilda degli avventurieri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "Non mi sorprenderebbe, dato che sono noti per vagare tra le rovine sotterranee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010711,
					"content": "Ma gli Avventurieri di solito non rubano gli averi altrui... Beh, non ai vivi, almeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "È <color=#00E1FFFF>La principessa delle nevi e i sei nani</color>! A Paimon suona familiare, è questo che cercavi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010802,
					"content": "È proprio quello. Per fortuna non è danneggiato, altrimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010803,
					"content": "Altrimenti cosa? Vorresti dirmi che hai in serbo punizioni ancora più assurde?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010804,
					"content": "Eheh. Probabilmente in quel caso avrei dovuto fargli assaggiare una delle mie pozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010805,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010806,
					"content": "D'altro canto... Come dicevo, questo libro non proviene dalla sezione riservata. Altrimenti non avrei mai lasciato che un cittadino comune lo prendesse in prestito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010807,
					"content": "E non sembra possedere alcuna proprietà elementale anomala, a parte i marchi che ho apposto io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010808,
					"content": "Sì... Sembra solo un romanzo normale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010809,
					"content": "Ma allora perché l'Ordine dell'Abisso...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "#(Che mistero. Sono proprio incuriosit{M#o}{F#a}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "Il mio duro lavoro di bibliotecaria si conclude qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010812,
					"content": "Visto che questo libro ha suscitato il tuo interesse, perché non lo prendi in prestito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010813,
					"content": "Quando devo, ehm, riconsegnarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "Ti prego, non punirmi se lo restituisco in ritardo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "#Per te non c'è limite di tempo. Ti registrerò come custode anziché prestatari{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010816
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010816,
					"content": "È un privilegio esclusivo riservato ai cittadini più fidati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010817
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010817,
					"content": "Privilegio esclusivo? Perché Paimon sente che è solo un trucco per scaricare a qualcun altro i tuoi compiti fastidiosi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010818,
					"content": "Prego? Hai qualche lamentela sul mio operato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010819,
						101010820
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010819,
					"content": "Nossignora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010820
					]
				},
				{
					"id": 101010820,
					"content": "Tratterò questo libro con molta cura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010821
					]
				},
				{
					"id": 101010821,
					"content": "#Bene. Sei una persona ragionevole. Vorrei poterti assumere come mi{M#o}{F#a} assistente personale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010822
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010822,
					"content": "Il mio lavoro qui è finito. Torno indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010823
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010823,
					"content": "Non dimenticare di completare la registrazione in biblioteca, quando hai un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 1010110,
			"completionStepIds": [
				1010110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
