				"points": []
			},
			"dialogs": [
				{
					"id": 101011201,
					"content": "Come avete trovato questo posto? Era... così ben nascosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011202
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 101011202,
					"content": "Scoprire i nascondigli di voi piccoli mascalzoni non mi interessa. Però rivoglio il mio libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011203,
					"content": "Dimmi, com'è possibile che abbiate il tempo di nascondere la vostra roccaforte e applicare un sigillo magico, ma non di prendere un libro in prestito dalla biblioteca seguendo le regole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011204,
					"content": "Non avete alcun rispetto per il lavoro altrui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011205,
					"content": "V-Vuoi solo... <color=#00E1FFFF>il libro</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011206
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 101011206,
					"content": "Non credevo che qualcuno a Mondstadt volesse scoprire il segreto nascosto in questo libro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011207
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 101011207,
					"content": "Chi... Chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011208
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 101011208,
					"content": "La bibliotecaria. Anche se credo che questo fosse già abbastanza evidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011209,
					"content": "Restituisci il libro. Non te lo chiederò di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011210,
					"content": "Bah. Visto che insisti a nascondere la tua identità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011211
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 101011211,
					"content": "Sono ancora meno disposto a ridartelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011212
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 101011212,
					"content": "Dopotutto, contiene... il segreto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011213
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 101011213,
					"content": "Eh?! Che stai facendo? Che incredibile concentrazione di potere elementale! T-Ti prego, non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011214
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 101011214,
					"content": "Aaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011215,
						101011216
					],
					"speakerTitle": "Mago dell'Abisso"
				},
				{
					"id": 101011215,
					"content": "Lisa è... troppo forte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				},
				{
					"id": 101011217,
					"content": "Bah. Ai monelli che non danno retta serve una piccola punizione per tenerli in riga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011218,
						101011219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011218,
					"content": "Non hai neanche lasciato che finisse di parlare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011220,
					"content": "*sospira* Ecco perché dico che il mio lavoro è fastidioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011221,
					"content": "#Dovremo trovare il libro da sol{M#i}{F#e}. Dovrebbe essere qui da qualche parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101011219,
					"content": "Una PICCOLA punizione?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011216,
					"content": "Lisa è... troppo spaventosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				}
			]
		},
