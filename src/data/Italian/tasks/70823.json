					],
					"speakerTitle": "Capoturno Kuan"
				},
				{
					"id": 708230502,
					"content": "È pieno di mostri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708230503
					]
				},
				{
					"id": 708230503,
					"content": "Ah... *sospira* Sembra che non potremo riaprire la produzione lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230508
					],
					"speakerTitle": "Capoturno Kuan"
				},
				{
					"id": 708230508,
					"content": "Capisco la situazione. Per favore, prendi questi come ringraziamento per il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230509
					],
					"speakerTitle": "Capoturno Kuan"
				},
				{
					"id": 708230509,
					"content": "Ma di questo passo avremo bisogno di alcune proroghe per raggiungere le quote di produzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230510
					],
					"speakerTitle": "Capoturno Kuan"
				},
				{
					"id": 708230510,
					"content": "Argh, devo trovare un posto dove possiamo iniziare a lavorare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Capoturno Kuan"
				},
				{
					"id": 708230504,
					"content": "È pieno di Cacciatori di tesori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708230505
					]
				},
				{
					"id": 708230505,
					"content": "Cacciatori di tesori? E anche tantissimi mostri? Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230506
					],
					"speakerTitle": "Capoturno Kuan"
				},
				{
					"id": 708230506,
					"content": "Certo che quei Cacciatori di tesori farebbero di tutto per qualche Mora, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708230507
					],
					"speakerTitle": "Capoturno Kuan"
				},
				{
					"id": 708230507,
