			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Battelliere"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "La sponda vicina del fiume, ehi! Il cipresso dipinto d'argento, ohi! L'assenzio d'argento per terra, le pietre d'argento che giacciono tutt'intorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721740102,
					"content": "Chiedo scusa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "Ohohoh, guarda un po'... Degli ospiti? Volete salire a bordo, per caso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721740105,
					"content": "Ahi ahi ahi, vediamo, vediamo... Avete l'aria di essere forestieri. Bel problema, bel problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721740106,
					"content": "\"Bel problema\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "La barca d'argento splendente veleggia dolcemente la luna laggiù, ma non è stata preparata per voi, oh no! Non salite a bordo, non sporcate i ponti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721740109,
					"content": "Ahi ahi ahi... La nebbia è dispersa da molto tempo, e da molto tempo è dispersa la nebbia! Eppure chi non è salito a bordo? La signora della sala d'oro si arrabbierà. Molto si arrabbierà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721740110,
					"content": "Barca? Dov'è la barca?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "Eh eh ehi... La barca d'argento, rampollo di sole e pendii, ehi! Tutti devono tornare a casa, tutti devono tornare, nella dimora lunare che brucia dorata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721740112,
					"content": "Vergogna, vergogna! Alcuni bambini hanno smarrito la via e ancora non sono saliti a bordo! La signora si arrabbierà. Oh, molto, molto si arrabbierà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721740113,
					"content": "Ti serve aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "Venite, venite, salite sulla barca, la barca è per l'imbarco! Non vagate, non perdetevi più, perché la vita non è più in lutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721740114,
					"content": "Mi senti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "Di cosa stai parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "E tu chi sei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
