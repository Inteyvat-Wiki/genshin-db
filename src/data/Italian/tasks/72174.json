			"dialogs": [
				{
					"id": 721741001,
					"content": "Sono venuti tutti, ah-oh, ah-ehi, abbiamo il nostro allegro gruppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741002
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721741002,
					"content": "#Grazie, gentile stranier{F#a}{M#o}, oh! Finalmente ora si parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741003
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721741003,
					"content": "La sponda lontana del fiume, ehi! La quercia d'oro si erge laggiù, ohi! L'assenzio dorato per terra, le pietre d'oro tutt'intorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741004
					],
					"speakerTitle": "Battelliere"
				},
				{
					"id": 721741004,
					"content": "I panorami sono incantevoli come non mai, molto più lontano di quanto l'occhio possa vedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Battelliere"
				}
			]
