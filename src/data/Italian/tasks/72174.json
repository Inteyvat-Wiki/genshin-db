			"dialogs": [
				{
					"id": 721740501,
					"content": "La luna splendente d'argento, ah ehi, i cuori scintillanti d'argento, ah ohi... Quelli che custodiscono la pianura nebbiosa non vogliono restare in quei boschi nebbiosi. Sì, salite sulla barca, già, salite sulla barca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
