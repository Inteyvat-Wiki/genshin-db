					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ami",
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "È... per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090502,
					"content": "Non facevo sul serio per la scatola o il pezzo di carta! Non c'è bisogno che ti scusi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090503,
					"content": "Non preoccuparti, questo vaso di fiori non mi serve. Ti prego, prendilo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090504,
					"content": "Ho chiesto a qualcuno di procurarmi dei semi. Dovrebbe essere qui da un momento all'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090505,
					"content": "Semi in arrivo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "#Eh? E tu quando sei arrivat{M#o}{F#a}? Non me n'ero nemmeno accorto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090508,
					"content": "Ehm... Ami, tu volevi diventare una fioraia, giusto? Puoi iniziare piantando questi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090509,
					"content": "Grazie... Ma nel vaso potrebbero finirci degli insetti, e se lo mettessi a fianco del negozio di mio papà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090510,
					"content": "Sarebbe davvero un peccato, sia per gli insetti nel vaso che per gli adulti, che si ritroverebbero degli insetti nel cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090511,
					"content": "Se però mettessi i fiori un po' più in là, potrei dimenticarmi di loro. E anche questo sarebbe un problema: poveri fiori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090512,
					"content": "Inoltre papà ha sempre da fare e non mi permette mai di allontanarmi troppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090513,
					"content": "Ehm... Potremmo prendercene cura insieme, se vuoi. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090514,
					"content": "Anche se potrò venire solo dopo il lavoro, ho un po' di tempo libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090515,
					"content": "Grande! Ma mio papà potrebbe dire di no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090516,
					"content": "Il signor Jahangir e io siamo praticamente amici. Credo dirà di sì se gliene parliamo insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090517,
					"content": "Ok! Allora... vorrei degli altri fiori ancora! La rosa di Sumeru è la mia preferita! Un giorno... il negozio di mio papà sarà circondato da rose di Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090518,
					"content": "Bene! È un sogno bellissimo, piccola. Diamo il massimo per far sì che si avveri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090519,
					"content": "Tienine da parte una per me, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "Grazie! Vediamo... Vorrei anche un Fiordolce, e che altro...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090522,
					"content": "Allora è proprio vero che a questa bambina piacciono tanto i fiori. Spero si tenga sempre stretto il suo sogno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090523,
					"content": "Eheh... Spero che da grande non diventerà una persona qualsiasi e noiosa come il sottoscritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090524,
					"content": "#Ehm! Grazie davvero per l'aiuto, viaggiat{F#rice}{M#ore}. Ecco, tieni, come compenso per il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090525,
					"content": "Vivere la vita con tutto il tuo cuore è molto più che essere una persona qualsiasi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "Grazie. Non mi lamento, tuttavia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090528,
					"content": "Stavo solo... riflettendo, ora che ho visto il \"sogno\" che seppellii da bambino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090529,
					"content": "#Bene, sarà meglio che vada ora. Grazie per il tuo aiuto oggi, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090530,
					"content": "Forse dovrei... scrivere su un pezzo di carta un altro sogno e seppellirlo nello stesso luogo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090526,
					"content": "Vivere la vita con tutto il tuo cuore non è mai noioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "Puoi farcela!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "Ecco qui i semi di fiori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
		},
