	"talks": [
		{
			"id": 7310901,
			"completionStepIds": [
				7310901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310901",
							"2"
						],
						"stepId": 7310901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "Che strano... Dovrebbe essere da queste parti. Perché non riesco a trovarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090102,
					"content": "Cosa stai cercando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "#Tu sei... Ah, {F#la}{M#il} viaggiat{F#rice}{M#ore}, giusto? Ho sentito parlare di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090104,
					"content": "Sono Javi, un... normale mercante. Sto cercando la scatola dei sogni che ho sepolto in questa zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090105,
					"content": "Che nome strano per una scatola... Cosa contiene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090106,
					"content": "Beh... Se lo dovessi esprimere a parole, contiene i sogni che volevo realizzare da bambino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090107,
					"content": "Perché l'hai fatto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "Ahahah, per un gioco fatto con i miei amici quando ero piccolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090109,
					"content": "Tutti noi scrivemmo su un pezzo di carta il sogno più prezioso che avevamo e lo seppellimmo qui. Decidemmo che un giorno ci saremmo rivisti in questo luogo e avremmo disseppellito le nostre scatole dei sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090110,
					"content": "Ora il tempo è arrivato, ma... A quanto pare sono stato l'unico a ricordarsi della promessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090111,
					"content": "*sospira* Fa lo stesso... L'importante è che abbiano conservato i propri sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090112,
					"content": "A ogni modo, ho intenzione di disseppellire la mia scatola, così da chiudere questa faccenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090113,
					"content": "Però ho già cercato qui in giro e non ho trovato nulla. Possibile che se la sia presa qualcuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090114,
					"content": "Hai lasciato un segnale da qualche parte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "Ricordo di averla seppellita a fianco di un albero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090119,
					"content": "Un albero? M-Ma Paimon vede un sacco di alberi qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731090120,
					"content": "Da bambino non ci pensai. Lasciammo solo un piccolo segnale per ricordarcene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090121,
					"content": "Ma dopo tutto questo tempo non c'è più, e gli alberi vicini sono cresciuti prendendo forme molto diverse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090122,
					"content": "Ho solo la vaga impressione di aver seppellito la scatola qui nei paraggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090123,
					"content": "#Viaggiat{F#rice}{M#ore}, mi aiuteresti a trovarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090124,
					"content": "Ma come?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "Ho seppellito la scatola vicino a un albero, quindi... proviamo a scavare vicino agli alberi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090126,
					"content": "#Ti prego, viaggiat{F#rice}{M#ore}, dammi una mano. Ti pagherò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090130,
					"content": "Guarda quanti alberi ci sono qui. Non troverò mai la mia scatola senza un aiuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090131,
					"content": "Va bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "Eheh, grazie. Dividiamoci, allora. Io resterò qui, e tu potrai cercare là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090127,
					"content": "Ma ha già preso il volo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "Sì, il mio sogno ha preso il volo, ed è proprio per questo che voglio disseppellire la scatola: per rivedere il mio sogno di allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090129,
					"content": "#Ti prego, viaggiat{F#rice}{M#ore}, è solo un piccolo favore. Ti pagherò all'istante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090115,
					"content": "E così il tuo sogno è volato via...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "Ahahah... Non posso dirti di no, dato che non mi ricordo nemmeno cosa scrissi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090117,
					"content": "Ma anche se il mio sogno ha preso il volo, la scatola non può farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "Javi"
				}
			]
		},
		{
			"id": 7310903,
			"completionStepIds": [
				7310903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310903",
							"2"
						],
						"stepId": 7310903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "Oh, no. Questa non è la mia scatola dei sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090302,
					"content": "Abbiamo trovato una scatola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "Ahah... Anch'io ne ho trovata una...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090305,
					"content": "L'ho persino aperta e ho trovato un pezzo di carta con sopra il nome di Ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090306,
					"content": "Mi ricordo di lei: era la figlia di Jahangir ed era sempre nei pressi del negozio di alimentari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090307,
					"content": "E così sognava di diventare una fioraia che si sarebbe presa cura di un sacco di fiori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090308,
					"content": "Non me l'aspettavo. Ho sempre pensato che Jahangir le avrebbe ceduto il negozio, un giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090309,
					"content": "Vediamo il tuo sogno, prima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "Oh! Quasi dimenticavo, prima dovrei dare un'occhiata al mio sogno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090312,
					"content": "Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090313,
					"content": "\"Spero di diventare un Vanara e di vivere nella foresta per sempre...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090314,
					"content": "Allora era questo il mio sogno d'infanzia? Santo cielo, non riesco a credere che desiderassi una cosa simile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090315,
					"content": "Ma dai... Piccolo, essere un Vanara non fa guadagnare un granché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090316,
					"content": "Non ci vedo nulla di male.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "Sono solo delle idee infantili. Per qualcuno della mia età, i sogni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090320,
					"content": "È meglio pensare a dei modi per guadagnare più Mora: è questo che fa dormire sereni la notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090321,
					"content": "Ma basta parlare del mio sogno noioso, parliamo di Ami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090322,
					"content": "Dovrei decisamente fare qualcosa per farmi perdonare da lei, visto che ho aperto la sua scatola dei sogni senza il suo permesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090323,
					"content": "Bene, fammici pensare... Per diventare dei fiorai bisogna iniziare dall'imparare come si piantano i fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090324,
					"content": "E fatalità ho un vaso che posso donarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090325,
					"content": "#Viaggiat{F#rice}{M#ore}, non è che per caso conosci un luogo dove potrei procurarmi dei semi di fiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090326,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "#Conto su di te per i semi, viaggiat{F#rice}{M#ore}. Ci vediamo a fianco del negozio di Jahangir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090327,
					"content": "Perché vuoi fare una cosa simile?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "Ahahah... Diciamo solo che è una cosa spontanea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090329,
					"content": "Non realizzerò mai il mio sogno, visto che ormai ho tanti anni alle spalle, e... non mi importa più davvero del mio sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090330,
					"content": "Ma Ami è ancora giovane. Può ancora provare a realizzare il suo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090331,
					"content": "Come adulto noioso, donarle un vaso di fiori è il minimo che possa fare. Spero che le dimostri il mio sostegno e la incoraggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090317,
					"content": "I sogni non sono mai né buoni né cattivi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "Ecco qui, la tua scatola dei sogni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "Anche tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
