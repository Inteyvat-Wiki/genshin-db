						701120202
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120202,
					"content": "Un momento. Chi stai elogiando, esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120203,
					"content": "Ora, il passo successivo è valutare come ogni cosa s'influenza a vicenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120204
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120204,
					"content": "Osserva le reazioni elementali, le forze a lunga distanza e quelle a breve distanza. E ricorda di evitare alterazioni superflue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120205
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120205,
					"content": "Ehm, ma in che lingua stai parlando adesso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
