			"dialogs": [
				{
					"id": 701120101,
					"content": "Bene, Dexter. I tempi sono cambiati. Credo sia giunto il momento di lasciarti l'infanzia alle spalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120102
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120102,
					"content": "Anche tu dovrai sottoporti al battesimo che chiamiamo passaggio all'età adulta, imparare cose che conoscono solo i grandi. Osserva attentamente, ora. Farò una sola dimostrazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120103
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120103,
					"content": "Perché lo dici come se fossero le tue ultime parole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120104,
					"content": "Ecco la tua ultima lezione. Leggi insieme a me: \"La classificazione degli elementi\". Coraggio, prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Josephus"
				}
			]
		},
