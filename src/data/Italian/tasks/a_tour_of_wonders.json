			"dialogs": [
				{
					"id": 705310101,
					"content": "Aspetta! Anche tu sei qui per il Gran Premio Re delle Invokazioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310102,
					"content": "Se hai un minuto, vorrei parlarti di questo evento organizzato dalla Gilda degli avventurieri, chiamato \"Tour delle meraviglie\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310103,
					"content": "Oh.. va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "Grazie! Allora adesso presento i punti fondamentali dell'evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310106,
					"content": "In due parole, la Gilda degli avventurieri ha posizionato diversi punti di controllo panoramici in diverse posizioni nell'area che circonda Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310107,
					"content": "Tutto quello che devi fare è trovare questi punti di controllo panoramici e segnarli sul tuo manuale del turista con i francobolli commemorativi corrispondenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310108,
					"content": "La sfida verrà considerata completata quando avrai trovato tutti i punti di controllo panoramici e raccolto tutti i francobolli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310109,
					"content": "Sembra davvero qualcosa che la Gilda degli avventurieri organizzerebbe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Eheh... Abbiamo fatto molta attenzione al posizionamento di questi punti di controllo panoramici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310111,
					"content": "Tuttavia... Alcuni di loro si trovano in aree remote e non posso garantire che siano completamente prive di mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310112,
					"content": "Sono però sicura che affrontare questi mostri sarebbe una passeggiata per una persona esperta come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310113,
					"content": "E per me è tutto! Ecco il tuo manuale del turista. Divertiti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310104,
					"content": "Va bene, di che si tratta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				}
			]
		}
	]
}