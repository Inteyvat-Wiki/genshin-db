	"talks": [
		{
			"id": 1100901,
			"completionStepIds": [
				1100901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100901",
							"2"
						],
						"stepId": 1100901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "Ho riunito tutti qui oggi per un annuncio importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090102,
					"content": "Forse alcuni di voi avranno già sentito la notizia: ho deciso di ricostruire la Dimora di giada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090103,
					"content": "Ricostruire la Dimora di giada? È un'impresa titanica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090104,
					"content": "Allora le voci sono vere. Ecco perché il prezzo dei materiali da costruzione è schizzato alle stelle ultimamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090105,
					"content": "La Dimora di giada è davvero importante per Lady Ningguang. Farsi coinvolgere sarebbe una grande opportunità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090106,
					"content": "Lady Ningguang, come possiamo esservi d'aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090107,
					"content": "Abbiate pazienza... Ho reso pubblica la notizia solo qualche giorno fa, e sono già stata contattata da una moltitudine di persone interessate a partecipare al progetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090108,
					"content": "Tuttavia, ho alcune questioni che vorrei affidarvi oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090109,
					"content": "Abbiamo scelto la posizione del cantiere e raccolto la maggior parte dei materiali, ma mancano ancora tre elementi cruciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090110,
					"content": "Sono i seguenti: Vermiglionite crepuscolare, Mirabilnuclei e Adeptosigilli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090111,
					"content": "Uh... Perdoni la mia ignoranza, Lady Ningguang. Conosco abbastanza bene la Plaustrite, ma non ho mai sentito parlare del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090112,
					"content": "Solo i pezzi sufficientemente grandi di Plaustrite, o per la precisione di Vermiglionite, possono guadagnarsi l'appellativo \"crepuscolare\". È la pietra che permette alla Dimora di giada di levarsi in aria. I Mirabilnuclei, invece, sono i componenti chiave della sua struttura meccanica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090113,
					"content": "Gli Adeptosigilli fungono da legame tra i dispositivi meccanici e l'arte degli Adepti... e sono tanto indispensabili quanto lo stesso nucleo meccanico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090114,
					"content": "Nonostante questi tre oggetti siano rari, sono sicura che, grazie ai vostri contatti e alle vostre capacità, procurarli non sarà una questione di \"se\", ma di \"quando\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090115,
					"content": "Prendo il detto \"Il tempo è denaro\" più seriamente di molti altri. L'efficienza è tutto. Pagherò profumatamente i materiali che troverete e, inoltre, le prime tre persone che raccoglieranno tutti i materiali potranno farmi una domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090116,
					"content": "Potrete chiedermi qualsiasi cosa... e otterrete una risposta onesta. Spero che questa ricompensa sia soddisfacente per tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090117,
					"content": "Non sarà una passeggiata, ma se c'è la possibilità di scoprire qualche informazione riservata sul piano di sviluppo del Porto di Liyue per il prossimo anno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090118,
					"content": "Allora è l'affare della vita! Le informazioni di Lady Ningguang hanno un valore inestimabile. I primi ad averle si prenderanno il mercato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090119,
					"content": "Ahahah, che coincidenza! Non voglio dire troppo, ma ho sentito parlare di Plaustrite proprio l'altro giorno. Quindi scusatemi tutti, ma ho degli affari da sbrigare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090120,
					"content": "Oh, no... Meglio muoversi in fretta o ci soffieranno l'opportunità da sotto il naso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090121,
					"content": "Ningguang sta ricostruendo la Dimora di giada?!? Ma è una notizia bomba, partecipiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090122,
					"content": "Allora avete sentito il mio annuncio, vero? Che ne pensate? Vi interessa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090123,
					"content": "Potrò davvero chiedere qualsiasi cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "Sì, a patto che la domanda riguardi qualcosa che conosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090125,
					"content": "#(Forse potrei scoprire qualcosa su {F#mio fratello}{M#mia sorella}...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "Davvero? Oooh, allora Paimon chiederà come si gestisce un'impresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090127,
					"content": "Così non saremo mai più a corto di Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090128,
					"content": "Eheheh, certo, ma prima di parlare di informazioni vediamo come ve la cavate con il progetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090129,
					"content": "La costruzione della Dimora di giada richiede molto spazio. Abbiamo scelto come cantiere la miniera abbandonata fuori dal Palazzo dorato. Una volta trovati i materiali, portateli lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090130,
					"content": "Ora ho altri affari di cui occuparmi, altrimenti vi accompagnerei volentieri di persona al sito. Quando arrivate, per favore, cercate la mia segretaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090131,
					"content": "Ricordate, è una corsa contro il tempo. Vi ho offerto un'opportunità rara... non lasciate che qualcun altro ve la sfili di mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090132,
					"content": "Ningguang sembra super impegnata... Su, su, diamoci una mossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090133,
					"content": "#Per cominciare dobbiamo uscire dal Belvedere di Yujing... Eh? Guarda, {NICKNAME}, sembra che laggiù stia succedendo qualcosa di strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090134,
					"content": "Ehi, signorina... Mi sembri una persona eminente e distinta. Credo che vincerai facilmente la gara d'appalto organizzata da Lady Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090135,
					"content": "Si dà il caso che abbiamo delle informazioni sui materiali che penso davvero possano interessarti. Perché non troviamo un posto un po' più riservato e andiamo al sodo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090136,
					"content": "No, non mi servono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090137,
					"content": "Oooh, non fare così. Ehi! Insomma, non andare via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090138,
					"content": "Beh, non stare lì, seguiamola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090139,
					"content": "Oh, giusto, sì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiang il Coraggioso"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "Eheheh. Beh, guarda un po', la signorina non può più scappare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090202,
					"content": "Non c'è da aver paura, non siamo cattivi... Tu ci dai un po' di Mora, noi ti diamo un po' di informazioni e siamo tutti felici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090203,
					"content": "Capo, ho un brutto presentimento. Guardala... I capelli bianchi, l'energia che emana... Ti dico che ha qualcosa di diverso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "Qiang il Coraggioso"
				},
				{
					"id": 110090204,
					"content": "E quindi? È piena di Mora! Come faremo a ripagare quei debiti di gioco se ci lasciamo sfuggire i soldi quando li incontriamo, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090205,
					"content": "Ve l'ho già detto. Non ho bisogno delle vostre informazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090206,
					"content": "Se ancora non capisci, sarò felice di ripeterlo in un modo che non dimenticherai facilmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090207,
					"content": "*sospira* Suvvia, signorina, mi sembri una tipa intelligente, non dirmi che te lo devo proprio spiegare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090208,
					"content": "Non si tratta di avere bisogno delle informazioni o meno, chiaro? Si tratta di tirare fuori i soldi e darceli, così nessuno si fa male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090209,
					"content": "Io non...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090210,
					"content": "Basta scuse! So che hai dei soldi, ti ho vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090211,
					"content": "Sì, ti ho vista entrare nel Padiglione Liuli, ordinare una tavolata di cibo e assaggiare solo qualche boccone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090212,
					"content": "Poi nella Pagoda di Xinyue e nel Ristorante Wanmin. La stessa storia ogni volta... Ordini tutti i piatti speciali, assaggi qualche boccone e te ne vai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090213,
					"content": "Come puoi permetterti tutto questo spreco se non vieni da una famiglia ricca? E visto che sei così ricca, cosa ci perdi a darci qualche spicciolo, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090214,
					"content": "La maestra mi ha intimato di non mettere le mani addosso a nessuno nel Porto di Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090215,
					"content": "Ma a mali estremi... Forse... Sì, chiamiamolo \"destino\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090216,
					"content": "Capo, te l'ho detto, c'è qualcosa che non va...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "Qiang il Coraggioso"
				},
				{
					"id": 110090217,
					"content": "Di cosa hai paura? Stiamo solo vendendo informazioni, non è illegale. Se ci mette le mani addosso, tanto meglio, le faremo causa e le spilleremo fino all'ultimo centesimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090218,
					"content": "Eccoli lì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "Ah... Ancora voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090221,
					"content": "Un Millelite? Cosa ci fa qui? Siete stati voi?!? Dovreste farvi gli affari vostri! Giuro che..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090222,
					"content": "Silenzio! Come osate minacciare dei civili innocenti? Ora venite con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090223,
					"content": "Eheh... Non si arrabbi, signore, la prego, mi lasci spiegare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "Liu Cicatrice"
				},
				{
					"id": 110090224,
					"content": "Il Millelite porta via i teppisti che avevano fermato la ragazza dai capelli bianchi.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090226,
					"content": "Stai bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "...Shenhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090229,
					"content": "Shenhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090230,
					"content": "È il mio nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090231,
					"content": "#Oooh, quindi ti chiami Shenhe! Il nome di Paimon è... beh, Paimon! E {F#lei è la compagna}{M#lui è il compagno} di viaggio di Paimon, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090232,
					"content": "Ho già sentito parlare di voi due. Grazie per aver contribuito a calmare le acque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090233,
					"content": "Avrei potuto occuparmene da sola, comunque. Penso che sarebbe bastato sbattergli la testa per terra un paio di volte per farlo arrendere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090234,
					"content": "Aaah! N-Non dire così! Quanta violenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090235,
					"content": "Questo è il Porto di Liyue. Ci sono leggi contro questo tipo di cose, lo sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090236,
					"content": "...Leggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090237,
					"content": "Non hai mai sentito parlare della legge, Shenhe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "No, direi di no.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090239,
					"content": "Davvero?!? Quindi finora come hai fatto a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090241,
					"content": "Ehm... Cos'era quel rumore?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "È il mio stomaco che brontola. Non ho mangiato abbastanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090243,
					"content": "È così onesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090244,
					"content": "Aspetta, giusto... Hanno detto che sei andata in giro per tutti i ristoranti ordinando questo, quello e quell'altro, ma hai fatto solo un assaggio di ogni piatto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090245,
					"content": "Allora ci credo che hai fame! Vediamo... Vorresti qualcosa in particolare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090246,
					"content": "Dei Qingxin, degli Splendigigli e delle Campaviole. Questo è ciò che prendo solitamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090247,
					"content": "Ma sono tutte erbe medicinali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "Erbe medicinali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090249,
					"content": "È un po' difficile da spiegare... Comunque, la Farmacia Bubu non è lontana. Portiamo lì Shenhe per un bel pasto medicinale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090250,
					"content": "Dopotutto, non si può lavorare a stomaco vuoto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090227,
					"content": "Non preoccuparti, ora è tutto a posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "Cercano di intimidire la gente per costringerla a comprare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
			"completionStepIds": [
				1100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100903",
							"2"
						],
						"stepId": 1100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gui l'erborista"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "Siete qui per comprare delle erbe? Avrete una ricetta, spero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 110090302,
					"content": "Dei Qingxin, degli Splendigigli e delle Campaviole, per favore. Due etti di ciascuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090303,
					"content": "Che razza di ricetta è questa? Sembra più un ordine per il pranzo, ahah... Oh, ecco qui, è tutto quello che abbiamo in magazzino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "Gui l'erborista"
				},
				{
					"id": 110090304,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090305,
					"content": "Li sta... davvero mangiando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090306,
					"content": "Con stupore di tutti, Shenhe divora tutte le erbe medicinali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "La mia fame si è placata. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090308,
					"content": "Che sapore avevano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "Piuttosto orribile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090311,
					"content": "Anche se avevano una certa fragranza dolce, dopo averne mangiata una grande quantità resta in bocca solo l'amaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090312,
					"content": "Allora come mai ti abbuffi di erbe e tocchi a malapena il cibo del ristorante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090313,
					"content": "Se Paimon avesse abbastanza Mora, andrebbe nel ristorante più elegante della città, ordinerebbe una tavolata di cibo e mangerebbe tutto in un sol boccone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090314,
					"content": "Perché non sono sicura di rimanere qui in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090315,
					"content": "Il cibo dei mortali è molto delizioso, ma se dovessi tornare sulle montagne, desiderare i piatti di qui sarebbe solo un ostacolo al mio continuo sviluppo spirituale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090316,
					"content": "Mi basta assaggiare ogni piatto per apprezzarne il gusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090317,
					"content": "#\"Tornare sulle montagne\"... Ecco la prova... {NICKNAME}! Paimon lo sapeva che era un'Adepta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090318,
					"content": "Basta parlare di me. Quali sono le vostre prossime mosse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090319,
					"content": "Oh, giusto! Paimon quasi dimenticava... Siamo qui per partecipare alla ricostruzione della Dimora di giada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090320,
					"content": "E... ora probabilmente siamo super indietro, vista la lunga interruzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090321,
					"content": "Capisco... Ho sentito parlare della gara mentre passavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090322,
					"content": "Eheh... Sì, se vinci potrai fare a Ningguang qualsiasi domanda tu voglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090323,
					"content": "Interessava anche a te la gara, Shenhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090324,
					"content": "Sono qui per la ricostruzione della Dimora di giada, ma fino a questo momento non avevo alcuna intenzione di partecipare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090325,
					"content": "#Però siete stat{M#i}{F#e} gentili con me e ora vorrei aiutarvi. Non preoccupatevi, non chiederò nulla in cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090326,
					"content": "Wow! Non c'è davvero bisogno di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090327,
					"content": "Ma l'aiuto di un'Adepta renderebbe le cose molto più facili, quindi....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090328,
					"content": "Certo, allora uniamo le forze.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "Allora non perdiamo tempo, ho un piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090331,
					"content": "Grande! Paimon scommette che sarà il piano più fantastico di sempre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090332,
					"content": "Non sono sicura se, o fino a che punto, questo piano possa essere definito \"fantastico\". Credo, però, che sarà molto efficace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090333,
					"content": "Basta semplicemente sbarazzarci di tutti quelli che sono più avanti di noi. Così la vittoria sarà nostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090334,
					"content": "Nooo! Non si può fare, proprio per niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090335,
					"content": "Sul serio? Ma ho sentito dire che la competizione non è altro che l'arte di conquistare e mantenere un vantaggio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090336,
					"content": "Senti, vogliamo vincere questa gara in modo onesto, chiaro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090337,
					"content": "Vermiglionite crepuscolare, Mirabilnuclei e Adeptosigilli... Partiamo dalla cima della lista... Quindi, per la Plaustrite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090338,
					"content": "Mi chiedevo chi sentissi discutere qui dentro... Ed eccovi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090339,
					"content": "Baizhu! Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090340,
					"content": "Lady Ningguang vuole acquistare una grande quantità di bendaggi. Siamo a corto in negozio, quindi sono uscito personalmente a prendere gli ingredienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090341,
					"content": "Eh? Come mai all'improvviso Lady Ningguang ha bisogno di così tanti bendaggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090342,
					"content": "Non saprei. Ho sentito che sta pensando di ricostruire la Dimora di giada... Forse per il primo soccorso in cantiere? Non ho chiesto però... Lungi da me ficcare il naso negli affari personali dei miei clienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090343,
					"content": "Oh, e ha anche preso in prestito Qiqi... il che significa che la Farmacia Bubu è molto a corto di personale in questo momento. Non è che, per caso, qualcuno di voi stia cercando un lavoro part-time?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090344,
					"content": "No, no, abbiamo altro a cui pensare... Già che sei qui, però... Visto che sembri uno che sa il fatto suo, hai mai sentito parlare di una cosa chiamata \"Vermiglionite crepuscolare\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090345,
					"content": "Ah, la varietà di Plaustrite usata nella Dimora di giada, giusto? Viene menzionata nei \"Trattati delle Sette Montagne\". Una volta attivata, la Vermiglionite si eleva fino a raggiungere le nuvole. È davvero molto rara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090346,
					"content": "Secondo i documenti disponibili, praticamente tutta la Vermiglionite crepuscolare esistente è già stata estratta... Ma la Gilda dei commercianti di Feiyun ne sa sicuramente molto di più di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090347,
					"content": "Va bene! Allora andiamo a chiedere alla Gilda dei commercianti di Feiyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090348,
					"content": "Grazie, Baizhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090349,
					"content": "Non c'è di che. Buona fortuna a tutti voi... E se doveste servirvi dell'altro, venite pure alla Farmacia Bubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090329,
					"content": "Benvenuta nella nostra squadra.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "Sono davvero così buone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
