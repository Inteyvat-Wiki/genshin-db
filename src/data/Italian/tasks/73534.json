			},
			"dialogs": [
				{
					"id": 735340101,
					"content": "#Ehilà! Tu sei {F#quella}{M#quello} che mi assisterà durante la terapia onirica? Se devo essere onesto, non ho proprio idea di cosa parlerà il mio sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340102,
					"content": "Io sono di Mondstadt e non ho molti passatempi... al di là del bere, s'intende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340103,
					"content": "E sono il classico tipo che tende a combinarle grosse, quando è sbronzo, quindi... conto su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collingwood"
				}
			]
		},
