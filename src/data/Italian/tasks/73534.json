			"dialogs": [
				{
					"id": 735340301,
					"content": "Piacere di conoscerti. A quanto pare stiamo per entrare insieme nella dimensione onirica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340302,
					"content": "Mi chiamo Youguang, sono una guardia di Liyue. Di recente mi è capitato di toccare qualcosa di... \"poco pulito\", e da allora non riesco più a dormire bene. È per questo che ho cercato aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340303,
					"content": "Se riuscissimo a scacciare i miei incubi tramite questa terapia onirica, sarei veramente al settimo cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
		},
