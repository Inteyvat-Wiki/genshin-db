			},
			"dialogs": [
				{
					"id": 735340501,
					"content": "Molto piacere. Mi chiamo Higuchi Tetsuya, vengo da Inazuma e sono un autore di romanzi basati sugli youkai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340502,
					"content": "Ultimamente sto affrontando una forte pressione... Sono disposto a provarle tutte, farò il possibile per rimettermi in carreggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340503,
					"content": "A proposito, la dimensione onirica potrebbe avere un aspetto... alquanto inusuale, considerato che è un mondo di mia creazione, con tutti i pro e i contro che ne conseguono. Mi scuso in anticipo per tutte le stranezze a cui potresti assistere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Higuchi Tetsuya"
				}
			]
		},
