			"dialogs": [
				{
					"id": 735340901,
					"content": "#Quindi tu sei l'{F#amica}{M#amico} di cui parlava Dharmakirti? Mi chiamo Piyush, piacere di conoscerti. Lavoro nel campo dell'architettura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340902,
					"content": "Kaveh mi ha parlato di te, ma non era ancora mai capitato di incontrarci, che piacevole coincidenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340903,
					"content": "Presumo che il mio sogno riguarderà il progetto che ho appena consegnato. È stato un incubo nel vero senso della parola... Mi spiace esserci incontrati proprio in una circostanza del genere... Beh, quel che è fatto è fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piyush"
				}
			]
		},
