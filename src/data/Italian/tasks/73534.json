			"dialogs": [
				{
					"id": 735340701,
					"content": "#Ah, quindi il volontario qualificato per gli esperimenti con la dimensione onirica è {F#una ragazza}{M#un ragazzo}? Accidenti, la gioventù moderna è davvero piena di sorprese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340702
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340702,
					"content": "Chiamami Nitesh. Sono uno studioso itinerante della Spantamad, al momento sto svolgendo un lavoro a lungo termine a Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340703,
					"content": "#Noi anziani tendiamo sempre a passare guai di ogni genere. Spero che potrai aiutarmi a venire a capo del problema, {F#signorina}{M#giovanotto}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nitesh"
				}
			]
		},
