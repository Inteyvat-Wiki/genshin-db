			"dialogs": [
				{
					"id": 761530101,
					"content": "Al giorno d'oggi, è difficile guadagnarsi da vivere nel mondo editoriale. Forse dovrei concentrarmi sugli investimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530102,
					"content": "Posso vedere i coupon d'investimento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530103
					]
				},
				{
					"id": 761530103,
					"content": "Va bene. 2.000 Mora a coupon, con ogni periodo d'investimento della durata pari a una settimana. Puoi metterli nella borsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530104,
					"content": "...Urgh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530105,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530106
					]
				},
				{
					"id": 761530106,
					"content": "Oh, ciao, Jahoda. Che ci fai qui? Per caso, Lady Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530107,
					"content": "#Oh, no, no, sono solo venuta a fare shopping con {F#la mia amica}{M#il mio amico}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530108,
					"content": "Eheh, sembra che i tuoi affari con gli investimenti vadano a gonfie vele, capo Dhabit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530109,
					"content": "Oh, non è niente di che, ahah... Solo una piccola attività per sbarcare il lunario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530110,
					"content": "(Guardala... Tutta subdola e inquisitoria! Scommetto che è qui per ordine di Nefer. Tsk.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530111
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530111,
					"content": "Davvero è possibile guadagnare così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530112
					]
				},
				{
					"id": 761530112,
					"content": "Certo! Il capo Nef dice che il capo Dhabit è un uomo d'affari molto capace e con una reputazione impeccabile. Investire con lui è la mossa giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530113,
					"content": "Sì, sì... ahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530114
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530114,
					"content": "(Nefer! Lo sapevo!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530115,
					"content": "Allora, quando posso aspettarmi il mio ritorno d'investimento...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530116
					]
				},
				{
					"id": 761530116,
					"content": "Proprio oggi! Si dà il caso che tu abbia acquistato il nostro nuovo... coupon d'investimento a breve termine! I profitti e le perdite vengono calcolati immediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530117,
					"content": "Paimon ha come l'impressione che te lo sia appena inventato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530118,
					"content": "Ma... Ma figurati! C-Comunque, grazie mille per l'acquisto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530119,
					"content": "Ecco i profitti dei tuoi investimenti. Ti auguro una magnifica giornata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530120,
						761530121
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530120,
					"content": "Beh... Guadagnare Mora è sempre un bene, suppongo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				},
				{
					"id": 761530122,
					"content": "Davvero? Hihi, allora Paimon ne vuole una a forma di uccellino! È la preferita di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530123,
					"content": "Oh, allora mi accodo a voi. Ne prenderò una anche per il capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530124
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530124,
					"content": "J-Jahoda, ti prego, aspetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530125
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530125,
					"content": "Ah... Per caso hai un messaggio per me da parte di Lady Nefer...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530126
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530126,
					"content": "Ah! Il capo ha detto queste testuali parole: \"Abbiamo trovato quello che sta cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530127,
					"content": "Abbia pazienza, signor Dhabit. Un passo alla volta, è così che si fanno gli affari\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530128,
					"content": "Sì, sì, Lady Nefer ha ovviamente ragione... In tal caso, conto su voi due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530121,
					"content": "Forza, Paimon, andiamo a comprare delle sculture di zucchero.",
