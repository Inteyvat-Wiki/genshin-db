				{
					"id": 750691309,
					"content": "Non lo senti? Qualcuno piange accanto al tuo orecchio, qualcuno che sta morendo ma che non può urlare, il cui unico rumore è quello dei polmoni che lottano per respirare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691310
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691310,
					"content": "E solo allora vedrai un volto pallido che ti guarda con rabbia. Un volto... che è proprio come il tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691311
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691311,
					"content": "Ah, solo vicino alla cascata posso sfuggire a quei suoni inquietanti. Eheh, non riesci a sentirli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691312
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691312,
					"content": "#Se resti qui troppo a lungo, potresti finire come me, {F#coraggiosa guerriera}{M#coraggioso guerriero}. Quindi vai, finché sei in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691313,
					"content": "No, niente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691314
					]
				},
				{
					"id": 750691314,
					"content": "#Ah, è così...? Allora ascolta il mio consiglio, {F#coraggiosa guerriera}{M#coraggioso guerriero}. Vattene da qui in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
