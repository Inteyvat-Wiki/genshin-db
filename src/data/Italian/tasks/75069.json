						750691203,
						750691207
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691203,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691204
					]
				},
				{
					"id": 750691204,
					"content": "Sono... un guerriero della compagnia di avventurieri. Non sono forte come il nostro capo, Lord Taika, ma ho i miei punti di forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691205,
					"content": "Faccio la guardia al nostro accampamento... A volte, quando non riesco a dormire, pattuglio l'area per tenerla al sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691206,
					"content": "Ora, non so da quando è iniziato, ma ogni giorno ci sono sempre meno persone all'accampamento... Ah, aspetta. Che strano... Perché sono qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691207,
					"content": "No, niente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691208
					]
				},
				{
					"id": 750691208,
					"content": "#Ah, è così...? Allora ascolta il mio consiglio, {F#coraggiosa guerriera}{M#coraggioso guerriero}. Vattene da qui in fretta.",
