			},
			"dialogs": [
				{
					"id": 750690801,
					"content": "(Il corpo freddo e simile a una statua di Quenin, preservato senza il minimo segno di decomposizione, sembra essere congelato nel tempo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690802
					],
					"speakerTitle": "Corpo freddo"
				},
				{
					"id": 750690802,
					"content": "(E a giudicare dall'ambiente circostante, è rimasto in questo stato per molto tempo...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Corpo freddo"
				}
			]
		},
