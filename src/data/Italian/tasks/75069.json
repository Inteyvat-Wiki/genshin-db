			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quenin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "Ah, questo posto... Pochi lo visitano... Dopotutto, qui è pericoloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690202,
					"content": "Sei con la compagnia di avventurieri...? Umpf, dicono che l'ombra del serpente nero sia scesa dalla Tonatiuh... Dovresti fare attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690203,
					"content": "O meglio ancora, vai via finché sei in tempo. Ci sono cose inumane, nascoste all'interno della squadra, ahah... Quelle voci, quelle maledizioni... sono così rumorose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690204,
					"content": "Qui è abbastanza tranquillo grazie alla cascata. Ahah... Il rumore delle cascate sovrasta tutto il resto, quindi non si sente nient'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7506903",
							"2"
						],
						"stepId": 7506903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(Una pagina strappata, con delle parole scritte con cura all'inizio...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Diario di Quenin"
				},
				{
					"id": 750690502,
					"content": "\"...I mostri dell'Abisso stanno aumentando, come previsto... Alla fine, la compagnia di avventurieri ha fallito, ed è in corso il piano di ritirata.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Diario di Quenin"
				},
				{
					"id": 750690503,
					"content": "\"Dobbiamo assicurarci che i membri rimanenti possano evacuare in sicurezza. Fate attenzione a coloro che svaniscono di notte o che tornano da luoghi privi di luce.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Diario di Quenin"
				},
				{
					"id": 750690504,
					"content": "\"...I mostri dell'Abisso compaiono sempre più di frequente. La fortezza potrebbe presto essere scoperta, ma prima...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Diario di Quenin"
				},
				{
					"id": 750690505,
					"content": "(La grafia diventa tremolante e distorta...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Diario di Quenin"
				},
				{
					"id": 750690506,
					"content": "\"Ah, fa freddo... Fa freddo... Là, laggiù, il sangue si sta prosciugando...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Diario di Quenin"
				},
				{
					"id": 750690507,
					"content": "\"Il rumore della cascata è così forte... Sì, va bene. Finché... sotto la cascata, lì ci sarà silenzio... Facce pallide, bocche spalancate, sangue versato...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Diario di Quenin"
				},
				{
					"id": 750690508,
					"content": "\"Là... Proprio là... c'è qualcosa... qualcosa...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Diario di Quenin"
				},
				{
					"id": 750690509,
					"content": "\"Sotto la cascata, sotto la cascata, sotto la cascata, sotto la cascata, sotto la cascata, sotto la cascata...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diario di Quenin"
				}
			]
		},
		{
