	"talks": [
		{
			"id": 201101,
			"completionStepIds": [
				201101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201101",
							"2"
						],
						"stepId": 201101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "#Tra le stelle e l'abisso! Cosa posso fare per te, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110102,
					"content": "Riguardo al viaggio verso Inazuma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "Ah sì, ho sentito che avete già preso accordi con la capitana della flotta della Crux per il tuo viaggio ad Inazuma. Giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110105,
					"content": "Ora che ci penso, è da un bel po' di tempo che non visito quelle terre. Purtroppo non ho alcuna informazione attuale che valga la pena condividere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110106,
					"content": "#Eccoti qua! Tu saresti {F#la}{M#il} viaggiat{F#rice}{M#ore} che Beidou porterà a Inazuma, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "Drago del mare"
				},
				{
					"id": 20110107,
					"content": "È tutto il giorno che ti aspetto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "Ah, davvero? Eheh... Beh, è un onore conoscerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "Drago del mare"
				},
				{
					"id": 20110110,
					"content": "La flotta ha quasi completato il nuovo carico di scorte. Una volta che la ciurma avrà completato l'appello, possiamo partire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "Drago del mare"
				},
				{
					"id": 20110111,
					"content": "La capitana Beidou mi ha mandato a prenderti. Salperemo non appena sarai a bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "Drago del mare"
				},
				{
					"id": 20110112,
					"content": "Sembra che Beidou sia una capitana di parola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110113,
					"content": "Naturalmente! Sono molte le cose su cui la capitana insiste. Sono certo che avrete modo di vederlo da voi una volta a bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "Drago del mare"
				},
				{
					"id": 20110114,
					"content": "E così alla fine hai deciso di partire? Suppongo di dovermi congratulare con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110115,
					"content": "Che il viaggio davanti a te ti conduca sia nell'alto dei cieli che nelle profondità degli abissi, ogni passo che compirai sarà un nuovo traguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110116,
					"content": "Alla prossima, ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110117,
					"content": "Ad astra abyssosque, Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "Oh... È dura dirsi addio ora che ci vedevamo praticamente ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110120,
					"content": "Eheh, se è questo ciò che provate, perché non venite a scovarmi una volta lì? Vi aspetterò sull'Isola di Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110121,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "Quindi c'è un'altra Katheryne a Inazuma?! Vedi? Non c'è motivo di fare i sentimentali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110124,
					"content": "Ahah, beh, credo sia ora per voi di salutare il Porto di Liyue. Ora che ho consegnato il mio messaggio, posso ritornare. La nave è attualmente ancorata presso la Foresta di pietra di Guyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "Drago del mare"
				},
				{
					"id": 20110125,
					"content": "Ok, grazie per essere venuto fin qui a dircelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110126,
					"content": "Seguo soltanto gli ordini. Ci si vede a bordo dell'Alcor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drago del mare"
				},
				{
					"id": 20110122,
					"content": "...Lo sapevo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "Ci mancherai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "Le nostre informazioni sono arrivate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "Riguardo alla flotta della Crux...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201103",
							"2"
						],
						"stepId": 201103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "Ah, ce l'hai fatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110302,
					"content": "In tutti questi anni, con la pioggia o con le tempeste, la flotta della Crux non ha mai ritardato. Se si fosse trattato di chiunque altro, sarei salpata da un pezzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110303,
					"content": "Scusami, capitana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "#Ahahah, non essere così seri{F#a}{M#o}, stavo solo scherzando. Sei arrivat{F#a}{M#o} giusto in tempo, la ciurma ha appena finito gli ultimi preparativi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110306,
					"content": "*sospira* Beh, ora che siamo tutti qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110307,
					"content": "Siamo pronti a salpare per quelle terre turbate dalle bufere e dai temporali... La nazione dell'\"eternità\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110308,
					"content": "Issate le ancore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110304,
					"content": "È un onore essere a bordo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "Ah, alla fine ce l'hai fatta. Mi hai fatto aspettare, capitana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110702,
					"content": "E sembra che abbiamo un paio di scrocconi con noi... o forse dovrei dire, ospiti d'onore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110703,
					"content": "Ehi! Silenzio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110704,
					"content": "Dovresti prendertela con la Shogun onnipotente. Ultimamente le tempeste che circondano Inazuma sono diventate più violente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110705,
					"content": "Sebbene la flotta fosse pronta a una simile sfida, il tempo sfavorevole ha comunque causato dei ritardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110706,
					"content": "Ora, vorrei presentarvi tutti. Questo è Thoma, un compagno del mestiere che ho avuto modo di conoscere da poco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110707,
					"content": "Eheh, non sai da quanto tempo ho aspettato per vedervi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110708,
					"content": "Thoma, loro due sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110709,
					"content": "#Non c'è bisogno di presentazioni, la loro fama l{F#e}{M#i} precede. Sembra che neanche i mari in tempesta riescano a fermare le voci che girano sulle gesta di quest{M#i}{F#e} due stranier{M#i}{F#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110710,
					"content": "Piacere di conoscerti, Thoma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "Eheh, fa piacere sentirtelo dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110713,
					"content": "Ah, fortunatamente, questo non potrà che farvi partire qui col piede giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}, Thoma risiede a Ritou da un po' di tempo. È considerato a buon merito il mediatore da queste parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110715,
					"content": "Se vi imbattete in qualche problema qui, andate da Thoma. Ma se prova ad approfittarsi di voi, mi occuperò di lui personalmente la prossima volta che lo vedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110716,
					"content": "Eheheh, non c'è bisogno di preoccuparsi. Penso proprio che andremo d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110717,
					"content": "Bene. Allora, se non c'è altro da aggiungere, io andrei. Non vorrei che trovassero la mia nave ormeggiata qui. Dopotutto, ho un fuggitivo ricercato a bordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110718,
					"content": "Oh, giusto. Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110719,
					"content": "#Alla prossima, viaggiat{F#rice}{M#ore}. Ricordati di mettercela tutta, anche di fronte alla \"tempesta\" più pericolosa che tu possa incontrare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110720,
					"content": "Lo farò!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "Che il mare sia a tuo favore, capitana Beidou. Arrivederci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110723,
					"content": "Dunque, come prima cosa dobbiamo completare la registrazione al punto di controllo di confine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110724,
					"content": "Uhm, Paimon credeva che fosse meglio passare inosservati... Non finiremo dritti nelle mani del governo così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110725,
					"content": "Ahah, non sottovalutate l'estensione del Decreto Sakoku. Non sarebbe possibile evitare i controlli neanche volendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110726
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110726,
					"content": "Quindi meglio stare alle leggi... interpretandole a modo nostro.",
