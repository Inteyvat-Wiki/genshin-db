			"dialogs": [
				{
					"id": 701140101,
					"content": "È raro che Sandrone trovi il tempo di venire a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140102,
					"content": "Il tuo aiuto è stato inestimabile per le mie ricerche sulla matrice numerologica. Ci tenevo a ringraziarti di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 701140103,
					"content": "Sei troppo gentile. È un argomento che esula dal mio campo di competenza, il merito di averla completata dovrebbe spettare tutto a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140104,
					"content": "È stato un lavoro di squadra. Uhm... Ora che ci penso, dov'è Durin? Giacché sei praticamente il suo tutore, credevo che stesse perennemente appiccicato a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 701140105,
					"content": "Non hai tutti i torti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140106,
					"content": "Ma di recente ha fatto progressi con le sue abilità sociali, quindi sto cercando di incoraggiarlo a essere un po' più indipendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140107,
					"content": "Non sei in pensiero per lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 701140108,
					"content": "Un po'. In passato, se si trovava a interagire da solo con qualcuno dalla personalità... diciamo \"forte\", tendeva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140109,
					"content": "Ad acquisire abitudini bizzarre? Tipo imitare strani tic verbali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 701140110,
					"content": "Esattamente. Anche tu hai vissuto qualcosa di simile, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140111,
					"content": "Umpf, c'è bisogno di chiederlo? Sono praticamente un'esperta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 701140112,
					"content": "Di solito, dopo una riunione col Gran Maestro Varka, accompagno Durin da Sucrose perché l'aiuti con le sue ricerche. Questo gli permette di ritrovare la concentrazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140113,
					"content": "Ma se trascorre troppo tempo con la Gran Maestra Reggente Jean, lo accompagno da Klee così può riscoprire come rilassarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140114,
					"content": "Sembra un lavoraccio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 701140115,
					"content": "Mi prendo solo cura della mia famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140116,
					"content": "Tu come gestiresti situazioni del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140117,
					"content": "Io? Non ho l'energia per questo genere di cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 701140118,
					"content": "Ma sono dell'idea che, se una persona è buona per natura, non importa quanto venga influenzata, alla fine tornerà sempre al suo vero io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 701140119,
					"content": "Mmh... Ottima osservazione. Dovrei adottare anch'io questa linea di pensiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
