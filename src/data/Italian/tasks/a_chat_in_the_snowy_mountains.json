			"dialogs": [
				{
					"id": 701140201,
					"content": "Grazie per la tua ospitalità, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140202,
						701140203
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140202,
					"content": "(Restiamo seduti così ancora per un po'.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				},
				{
					"id": 701140204,
					"content": "Va bene, alla prossima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701140204
					]
				}
