			"dialogs": [
				{
					"id": 750280101,
					"content": "Ugh, siete... più forti di quanto sembriate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Topo"
				},
				{
					"id": 750280102,
					"content": "Argh. Chi abbiamo offeso al punto da mandare qualcuno a darci una lezione proprio oggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Gufo della Notte"
				},
				{
					"id": 750280103,
					"content": "#Ti prego, {M#fratellone}{F#sorellona}. In che modo ti abbiamo offeso? Diccelo e... non lo faremo più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Gufo della Notte"
				},
				{
					"id": 750280104,
					"content": "Ehi, piccolo furfante! Vuoi davvero umiliarti così davanti a questa carogna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Topo"
				},
				{
					"id": 750280105,
					"content": "Cosa c'è, fare la voce grossa ci darà di che vivere? Ah, non cominciare, ora ho capito tutto. Viviamo come dei ladri, degli imbroglioni. Non c'è niente di speciale nel trafficare Saurici, mi sbaglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Gufo della Notte"
				},
				{
					"id": 750280106,
					"content": "Perché non dovrei andare con loro, piuttosto che farmi derubare da un truffatore più forte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Gufo della Notte"
				},
				{
					"id": 750280107,
					"content": "#Non per vantarmi, {M#fratellone}{F#sorellona}, ma sono sicuro che ti sarei molto più utile di questi due. Chiamami se hai bisogno di qualcosa. Sistemerò tutto, e in modo pulito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Gufo della Notte"
				},
				{
					"id": 750280108,
					"content": "Uhm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Beh, si dà il caso che io stia cercando un partner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "Dici sul serio?!? Non se ne parla! Paimon te lo vieta categoricamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280112,
					"content": "Siete solo pessimi individui! Non faremmo mai squadra con voi trafficanti di Saurici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280113,
					"content": "Sì, non c'è persona più buona di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#Ahem! Comunque, qualsiasi cosa stiate facendo con i Saurici, è meglio che la smettiate ora, o noi... Beh, {NICKNAME} vi darà una bella lezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280118,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "I due trafficanti se ne vanno colmi di risentimento...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "Paimon si chiede come stia quel Qucusauro. Vogliamo andare a vedere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280114,
					"content": "Beh, si può sempre trovare un accordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#Ehi, così darai il cattivo esempio a {REALNAME[ID(2)|SHOWHOST(true)]}! Non preoccuparti, piccolino, non faremo mai squadra con questa teppaglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280116,
					"content": "Roar... Groooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Grazie della considerazione, ma non serve.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
		},
