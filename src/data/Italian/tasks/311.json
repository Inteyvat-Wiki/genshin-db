						3090405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090405,
					"content": "Comunque sia, in uno dei templi dei Quattro Venti abbiamo ottenuto un altro Anemoculus, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090406
					],
					"speakerTitle": "Paimon"
				},
				{
