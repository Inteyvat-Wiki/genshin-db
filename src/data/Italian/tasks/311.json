			"dialogs": [
				{
					"id": 3090201,
					"content": "Fiuuu, ce l'abbiamo fatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090202,
					"content": "Bene, ora tutte quelle linee \"geomantiche\" ed \"elementali\" di cui parlava Lisa dovrebbero essere tornate alla normalità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090203,
					"content": "Vuoi tornare indietro per vedere come se la passano i <color=#00E1FFFF>Cavalieri</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090204,
					"content": "Ma se hai in mente qualcosa di più divertente da fare, Paimon sarà felice di seguirti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090205,
					"content": "Tipo... andare a far compere... o dare un'altra occhiata alla <color=#00E1FFFF>Statua dei Sette</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090206,
					"content": "Poi, ai templi dei Quattro Venti avevamo trovato una specie di... \"venti solidi\", giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090207,
					"content": "Qui a Mondstadt li chiamano \"Anemoculi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090208,
					"content": "Si chiamano così perché possono essere inseriti negli occhi della statua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090209,
					"content": "Secondo alcuni racconti, originariamente gli occhi delle statue erano delle gemme, che poi furono portate via dalle rondini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090210,
					"content": "In origine, gli Anemoculi non avevano una forma fisica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090212,
					"content": "Le persone dotate di Visioni li raccolgono per offrirli alle <color=#00E1FFFF>statue</color> in cambio di benedizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090213,
					"content": "A differenza di altre persone con dei poteri, tu non hai una Visione. Tuttavia, le regole di questo mondo non sembrano valere per te, pertanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090214,
					"content": "Se ti va di provarci, possiamo andare subito a vedere che succede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090215,
					"content": "La statua di Levanteolo dovrebbe essere quella più vicina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090216,
					"content": "Paimon non vede l'ora di scoprire come reagiranno gli dèi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
