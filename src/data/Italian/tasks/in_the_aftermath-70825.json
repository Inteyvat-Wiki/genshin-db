			},
			"dialogs": [
				{
					"id": 708250401,
					"content": "*sospira* Se solo avessimo un paio di persone in più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250402,
					"content": "Cosa stanno facendo gli altri cavalieri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "Si occupano di mantenere in piedi le difese della città, aiutano a ricostruire e svolgono un mucchio di altri lavori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250404,
					"content": "Ogni singolo cavaliere è praticamente sommerso di lavoro, ora come ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250405,
					"content": "Per una volta, fare la guardia alle porte della città sembra il lavoro più facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250406,
					"content": "Potresti sollecitare l'aiuto della Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "Ci ha assistito fin dall'inizio, per fortuna. In principio, gli avventurieri ci aiutavano a trovare e trarre in salvo i feriti qui in città. Poi, più di recente, hanno tenuto d'occhio l'attività dei mostri nelle campagne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250408,
					"content": "Quando i mostri hanno cominciato a radunarsi nei pressi della città, siamo stati in grado di ideare piani di difesa più specifici ed efficienti proprio grazie agli avventurieri, che hanno prima svolto un lavoro di ricognizione e poi fatto rapporto a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250409,
					"content": "Ancora adesso stanno supportando i nostri sforzi nel rimettere in piedi la città. Onestamente, senza di loro i Cavalieri sarebbero crollati sotto il peso di un tale carico di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250410,
					"content": "Devo trovare il tempo di andare a ringraziare Cyrus di persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
