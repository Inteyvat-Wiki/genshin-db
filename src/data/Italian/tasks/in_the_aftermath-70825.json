			"dialogs": [
				{
					"id": 708250601,
					"content": "Come sta andando? Avere già ripulito l'area?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250602
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250602,
					"content": "Tutto finito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250603
					]
				},
				{
					"id": 708250603,
					"content": "Fantastico. Il vostro aiuto è stato preziosissimo. Se non fosse stato per voi, chissà per quanto ancora sarebbero rimasti laggiù, quegli obbrobri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250604
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250604,
					"content": "#Accetta questi come segno della mia gratitudine, Cavaliere Onorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		}
