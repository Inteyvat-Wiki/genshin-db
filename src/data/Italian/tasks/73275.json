			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732750102,
					"content": "Le rose dorate sono germogliate, e sono diventate piantine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "Questi semi... Come hai fatto a trovarne i semi, mi chiedo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750104,
					"content": "Li ho trovati in un posto lontano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "Ma allora...? Beh, suppongo che alla fine i semi che lo zio Shafaqat ha gettato abbiano trovato la via per tornare qui, dopo essere stati sparsi in ogni angolo del deserto... anche se il loro percorso è stato piuttosto tortuoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750107,
					"content": "Dovremo prenderci cura di queste piantine, voglio lasciarle alla giovane Sabbah. Quando io non ci sarò più, sarà lei a possederle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750108,
					"content": "Grazie, tesoro. Non ho molto da darti... ma ti prego di accettare questi frutti e fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
