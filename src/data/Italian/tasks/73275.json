				},
				{
					"id": 732750305,
					"content": "Ma allora...? Beh, suppongo che alla fine i semi che lo zio Shafaqat ha gettato abbiano trovato la via per tornare qui, dopo essere stati sparsi in ogni angolo del deserto... anche se il loro percorso è stato piuttosto tortuoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750307,
					"content": "Dovremo prenderci cura di queste piantine, voglio lasciarle alla giovane Sabbah. Quando io non ci sarò più, sarà lei a possederle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750308,
					"content": "Questo vecchio ha beneficiato tanto del tuo aiuto, e non hai neanche chiesto nulla in cambio. Ma non avrei l'animo in pace, se non ti mostrassi in qualche modo la mia riconoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750309,
					"content": "Le piantine hanno da poco fatto capolino dalla terra, e Sabbah ha suggerito di fartene dono. Le ha persino confezionate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750310,
					"content": "Accettale in nostro ricordo, e non dimenticare di essere resiliente come queste piantine e di coltivare la fede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
