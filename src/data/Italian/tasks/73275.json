					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732750501,
					"content": "A proposito della canzone popolare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "#Ah, quindi te la ricordi? Con te conto {F#una}{M#un} giovane in più che la conosce. Bene, bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750503,
					"content": "\"Rosa, oh rosa, esaudisci il mio desiderio. Sbocciando dalla pietra, la rosa dorata mi ha intonato un canto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750504,
					"content": "\"Non la terra mi è natia, ma lo è una melodia. Quella sfiderà il fato, cambierà ciò cui sono destinato.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750505,
					"content": "\"Mi sovrasteranno e supereranno il tempo. Sopravvivranno alla morte...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
