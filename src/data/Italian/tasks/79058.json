			},
			"dialogs": [
				{
					"id": 790580101,
					"content": "Questa è una scena tagliata dello spettacolo \"La grande fuga\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790580102,
					"content": "Nella storia originale, un Eidolon di Hydro rimane intrappolato in una caverna misteriosa, e cerca di scappare usando solo gli strumenti che trova all'interno di un certo tomo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790580103,
					"content": "Tuttavia, Idyia ha rifiutato categoricamente questo soggetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790580104,
					"content": "E ne aveva ben donde: agli Eidolon di Hydro non servono strumenti per scappare da una caverna, possono farlo quando vogliono. Inoltre, l'idea che gli strumenti fossero nascosti all'interno di un volume era alquanto forzata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790580105,
					"content": "Però... a livello commerciale è davvero un'idea pazzesca! Se soltanto Idyia si rendesse conto di quanto è geniale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790580106,
					"content": "Purtroppo, <color=#00E1FFFF>gli Hilichurl hanno rubato il libro che contiene gli strumenti</color>, e bisogna prima recuperarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790580107,
					"content": "— Regista",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Appunti di scena"
				}
			]
		},
