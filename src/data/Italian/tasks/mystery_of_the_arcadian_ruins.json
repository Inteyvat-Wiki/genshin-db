			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "Perché proprio a me? Non avrei dovuto aiutare quel <color=#00E1FFFF>tizio</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620302,
					"content": "Quale tizio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620303,
					"content": "Grazie per avermi salvata. Siete molto più affidabili di quei tizi di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620304,
					"content": "#Non è nulla. {F#Lei è una viaggiatrice}{M#Lui è un viaggiatore}, ha a che fare con cose del genere in continuazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620305,
					"content": "#U{F#na}{M#n} viaggiat{F#rice}{M#ore}? Ho sentito raccontare tante storie su di te. Non pensavo che sarei stata salvata proprio dalla <color=#00E1FFFF>persona che dovevo incontrare</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620306,
					"content": "Oh, quindi tu sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620307,
					"content": "Ahahah... Inizialmente non sapevo come farmi ripagare, ma ora credo proprio che ti fornirò le informazioni gratuitamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620308,
					"content": "Nella nostra cerchia sappiamo quanto siano importanti i buoni contatti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620309,
					"content": "Davvero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "Beh, mi hai salvato la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620312,
					"content": "CHE FORTUNA!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620313,
					"content": "Beh... Che fortuna per Kaeya. Toccava a lui pagare per le informazioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620314,
					"content": "Ascoltatemi bene, allora, ecco le informazioni sulle Rovine di Arcadia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620315,
					"content": "\"Tre giganti a sei braccia risiedono nella città nel lago. Due custodiscono la statua, uno il tesoro\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620316,
					"content": "Fin qui, ci sono... Aspetta, tutto qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620325,
					"content": "C'è anche questa mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620317,
					"content": "È una di quelle... con una grossa X che indica dove si trova il tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620318,
					"content": "Quindi l'indizio è una specie d'indovinello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620319,
					"content": "#Dovrebbe essere un gioco da ragazzi per te, vero, {NICKNAME}? Allora Paimon affiderà a te questo compito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620320,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "Se servirà aiuto, chiederemo a Kaeya. Anche lui sembra un discreto secchione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620326,
					"content": "Vi lascio le informazioni, così potrete rivederle in qualsiasi momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 4620327,
					"content": "Grazie, Vile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620323,
					"content": "\"Tre giganti a sei braccia risiedono nella città nel lago. Due custodiscono la statua, uno il tesoro\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620324,
					"content": "Che significa? Se non vuoi chiedere a Kaeya, è meglio che ti faccia venire in mente qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620321,
					"content": "Lo spero.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "Grazie di cuore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
		{
