					"content": "Ecco il suo ordine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260302
					]
				},
				{
					"id": 200260302,
					"content": "Ah! Le mie <color=#00E1FFFF>polpette di ravanello fritte</color>... E preparate proprio come volevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260303
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260303,
					"content": "Mmh... Sì, l'aggiunta di uova fa miracoli in termini di consistenza e aroma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260304
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260304,
					"content": "Oh sì! So quello che faccio quando si tratta di cibo. *smack*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260305
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 200260305,
					"content": "Ah, tieni. Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ernest"
				}
			]
		},
