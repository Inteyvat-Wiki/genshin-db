					"nextDialogs": [
						200260404
					]
				},
				{
					"id": 200260404,
					"content": "Vediamo... Eccellente! Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260405
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260405,
					"content": "Ecco, questo <color=#00E1FFFF>tortino di granchio, prosciutto e verdure al forno</color> è per te. Mangialo finché è caldo, è stato appena sfornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
