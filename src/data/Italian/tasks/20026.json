				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200260101,
					"content": "Ordina una consegna",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260102,
					"content": "#Ehi, viaggiat{F#rice}{M#ore}! Cosa sta succedendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260103,
					"content": "...Ah, sei qui solo per mangiare, dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260104,
					"content": "Capisco, davvero... Ma se mi dai una mano, ti prometto che poi ti preparerò il piatto più buono che tu abbia mai mangiato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260105,
					"content": "Ernest del Vigneto Prima Luce spesso ordina del cibo da abbinare al suo vino e i suoi ordini arrivano sempre con delle richieste speciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260106,
					"content": "Questa volta vuole delle <color=#00E1FFFF>polpette di ravanello fritte</color>, ma con l'aggiunta di uova, purtroppo non ne ho più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260107,
					"content": "Quindi sarebbe perfetto se potessi andare a prendermi un paio di uova di uccello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260108,
					"content": "Se insisti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "Dovrebbero esserci molte uova di uccello nei dintorni di Levanteolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260110,
					"content": "Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260111,
					"content": "Sono qui solo per mangiare, sto morendo di fame!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "Dovrebbero esserci molte uova di uccello nei dintorni di Levanteolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260113,
					"content": "Quando avrai fatto quello che ti ho chiesto, ti offrirò qualcosa dal menù speciale del Buon Cacciatore! Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
