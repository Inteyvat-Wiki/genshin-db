						200260202
					]
				},
				{
					"id": 200260202,
					"content": "Dovrebbero bastare. Un attimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260203,
					"content": "Sono pronte! Ora porta queste <color=#00E1FFFF>polpette di ravanello fritte</color> a Ernest, subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260204,
					"content": "...Non guardarmi così, lo so che stai morendo di fame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260205,
					"content": "Ci sarà una sorpresa speciale del Buon Cacciatore ad aspettarti quando tornerai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
