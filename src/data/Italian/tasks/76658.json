			"dialogs": [
				{
					"id": 766580101,
					"content": "Ohilà, Ginette! Hai ricevuto tutti i robot che abbiamo trovato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580102,
					"content": "Certo che sì! Un lavoro impeccabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580103,
					"content": "A proposito, abbiamo fatto delle nuove scoperte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580104,
					"content": "Sul serio? Sono tutt'orecchi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580105,
					"content": "Tu e Paimon raccontate a Ginette ciò che avete visto poco fa.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "A giudicare dai comportamenti che state descrivendo... I robot sembravano provare apprezzamento per voi, e così vi hanno mandato un messaggio: un invito a \"giocare insieme\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580107,
					"content": "Dici davvero? Porca pupazza, è fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580108,
					"content": "Mh-mh... Lo sapevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580109,
					"content": "Che cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580110,
					"content": "Ora ne sono certa: la mia idea può realizzarsi solo attraverso le interazioni fra questi robot. Più unità riusciamo a recuperare e più ci avvicineremo al mio intento originale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580111,
					"content": "Ora riescono già a comunicare con gli altri. Ciò che ci resta da fare è trovare i robot mancanti, e poi... Sì! Riesco già a vedere i frutti della mia creatività!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580112,
					"content": "Sembri davvero entusiasta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580113,
					"content": "Ah! Scusate, mi sto facendo trasportare... Mi servirà ancora il vostro aiuto, per il resto. Ecco, vi ho segnato l'area successiva sulla mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580114,
					"content": "Allora muoviamoci! Paimon è curiosissima di vedere come va a finire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}