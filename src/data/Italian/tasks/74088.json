			"dialogs": [
				{
					"id": 740880401,
					"content": "#Dovrebbe esserci un rilevatore di dati anche qui. Ora apro la porta, lascerò a te il compito di recuperarlo, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
