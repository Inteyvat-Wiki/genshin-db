		},
		{
			"id": 7408805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nacker"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880501,
					"content": "Credo che questo posto, in origine, fosse l'Istituto di applicazioni meccaniche di Butor. Nel campo dei dispositivi meccanici, lui era un autentico luminare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880502,
					"content": "Tuttavia, da un punto di vista scientifico, gli sviluppi e gli avanzamenti dei dispositivi meccanici tradizionali avevano subito una battuta d'arresto. In termini di applicazioni, quel genere di dispositivi erano ovviamente in grande svantaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880503,
					"content": "Comunque, l'Istituto finì progressivamente per accantonare il programma di Butor, che si ritrovò privo di fondi sufficienti e fece fatica a reclutare altri ricercatori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880504,
					"content": "A seguito di una serie di sfortunati incidenti, il gruppo di Butor infine si sciolse, e questa struttura venne completamente abbandonata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880505,
					"content": "*sospira* Per come la penso io, Butor è stato terribilmente sfortunato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				}
			]
		},
		{
			"id": 7408806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
