					"Chronie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880601,
					"content": "Già... Ancora non riesco a dimenticare come Choiseul abbia fatto a equivocare per tutto quel tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880602
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880602,
					"content": "E quel Raimondo, poi... Così altezzoso e arrogante. Hai visto come mi ha guardata per tutto il tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880603
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880603,
					"content": "Io credo che tu sia molto meglio di entrambi quei due. Le cose non sarebbero mai andate in questo modo se tu avessi ricoperto il loro ruolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chronie"
				}
			]
		}
	]
