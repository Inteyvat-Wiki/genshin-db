			"dialogs": [
				{
					"id": 401480101,
					"content": "#Buongiorno, {NICKNAME}. È ora di accendere i fornelli in vista di un'altra giornata di lavoro. Grazie ancora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480102,
					"content": "Grazie all'esperienza acquisita negli ultimi giorni, il lavoro risulta sempre più semplice...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480103
					]
				},
				{
					"id": 401480103,
					"content": "#Ottimo lavoro... Ogni giorno che passa, somigli sempre più a {F#una capocuoca}{M#un capocuoco}! Eheh, qualsiasi strambo personaggio entrerà da quella porta, so che riuscirai ad accontentarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480104
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480104,
					"content": "Aspetta, no! Ogni volta che dici qualcosa del genere, succedono dei pasticci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480105,
					"content": "Ehi, non è vero! Oltretutto, non era mia intenzione portare sfortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480106
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480106,
					"content": "Ahahahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480107,
					"content": "Ehilà! Che si dice, fratello?! Non sapevo fossi anche tu a Liyue! Ah, incontrare altri estranei di Inazuma è sempre un piacere... Aspetta, ho detto bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480108,
					"content": "Quasi. Penso sia \"altri stranieri di Inazuma\", capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480109
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480109,
					"content": "Sì, sì, esatto! Dobbiamo prenderci cura l'uno dell'altro, tanto lontano da casa! Non è vero, Ayato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480110,
					"content": "Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480111
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480111,
					"content": "...Toro sdraiato! Cosa ci fai qui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480112,
					"content": "#Uh? Ehilà, Melonlavanda volante... Ah, della varietà \"Biancoferro Squarciatrice dei cieli\"! E c'è anche {F#la mia compadre}{M#il mio compadre}! Tutti i miei amici in un posto solo, oggi è il mio giorno fortunato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480113
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480113,
					"content": "Non avevi detto che saresti tornato a casa per guadagnare un sacco di Mora? Come mai sei tornato a Liyue così presto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480114,
					"content": "Ahah, quello può aspettare. Non appena annuncerò che Arataki Itto è disponibile ad accettare nuovi incarichi, mi riempiranno di Mora... Per ora devo risolvere una questione più urgente: ho una voglia tremenda di mangiare piccante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480115,
					"content": "...Ah, e già che siamo qui, faremo un salto dal Granmaestro Hanakado per vedere come se la passa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480116,
					"content": "(Lo sguardo sul volto di Shinobu sembra dire: \"Non chiedere\".)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480117
					]
				},
				{
					"id": 401480117,
					"content": "Tu cosa mi racconti, Ayato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480118
					]
				},
				{
					"id": 401480118,
					"content": "...Non molto tempo fa, ho sentito che qualcuno stava organizzando un torneo di lotta tra Onikabuto a Liyue. Sono venuto qui il prima possibile... ma, ahimè, era troppo tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480119
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480119,
					"content": "Cosa? Te lo sei perso? Oh, cavoli, che peccato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480120
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480120,
					"content": "Un peccato davvero, anche se non è tutto perduto. Visto che sei qui, potrai raccontarmi ogni cosa al riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480121
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480121,
					"content": "Ahah, certo, amico mio! Ma parliamone davanti a un bel piatto fumante... Dov'è lo chef? Ehi, fa' venire lo chef! Ho dei compadre da sfamare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480122
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480122,
					"content": "#Sono io {F#la}{M#lo} chef.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480123
					]
				},
				{
					"id": 401480123,
					"content": "Sì, certo, anch'io... Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480124
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480124,
					"content": "Wow, Toro sdraiato ha organizzato tutto alla perfezione. Bisogna dargliene credito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480125,
					"content": "...Ma il capocuoco è un altro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480126
					]
				},
				{
					"id": 401480126,
					"content": "Uh... Ahah, bella questa, compadre! Ci ero quasi cascato. Ok, ora fa' venire lo chef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480127
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480127,
					"content": "Tu e Paimon andate a chiamare Yanxiao in cucina...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480128
					]
				},
				{
					"id": 401480128,
					"content": "Quindi, ehm... Siete pronti a ordinare? Se state aspettando degli ospiti, posso suggerire \"Gioielli del Palazzo\", \"Corde vibranti e canne ferventi\" oppure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480129
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480129,
					"content": "...Capo, occhio al budget...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480130
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480130,
					"content": "Giusto, ok, mm... Avete qualcosa di più, ahem... modesto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480131
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480131,
					"content": "Modesto...? Ah... Beh, abbiamo un modestissimo \"Umiltà e semplicità\". Un piatto sostanzioso e molto saporito, e non lesiniamo nemmeno sulle porzioni. È la scelta più conveniente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480132
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480132,
					"content": "\"Umiltà e semplicità\", eh? Sembra fatto apposta per me! Prendiamo quello, non ci serve nulla di sofisticato, siamo tra amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480133
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480133,
					"content": "Ottima scelta, Itto! Neanch'io sono un amante dell'ostentazione culinaria. Eh... Certe volte un fratello lo sa e basta, mmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480134
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480134,
					"content": "Un fratello lo sa e basta... Ahah, già! I fratelli non suppongono, lo sanno e basta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480135
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480135,
					"content": "Sul serio? Va beh, Paimon vi lascia alle vostre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
