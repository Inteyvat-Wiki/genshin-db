			"dialogs": [
				{
					"id": 401480401,
					"content": "Devo dirlo, il tuo amico è proprio un personaggio... Comunque sia, Umiltà e semplicità non è difficile da preparare, perciò non credo che avremo problemi con quest'ordine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480402,
					"content": "Ma perché si chiama \"Umiltà e semplicità\"? Un piatto generoso a base di carne è un buon inizio ma, per esperienza di Paimon, il cibo povero non è mai abbastanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480403,
					"content": "Uh, ho detto che è generoso, non che contenga della carne... Non farti ingannare dalle apparenze... In verità è a base di tofu, preparato per avere l'aspetto e il sapore della carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480404
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480404,
					"content": "Tofu?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480405
					]
				},
				{
					"id": 401480405,
					"content": "Aspetta un secondo! Il tofu è a base di soia... Toro sdraiato non può mangiarlo! Immagino che dovremo fargli scegliere un'altra pietanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480406,
					"content": "...Qual è il problema? Mi pare di aver sentito nominare il \"tofu\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480407
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480407,
					"content": "Un momento, che stai facendo? La cucina è riservata al personale... *sospira* Non importa, lascerò correre. Potresti chiedere al tuo capo di ordinare un piatto diverso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480408
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401480408,
					"content": "...Ahah! Nessuno capisce mio fratello Ayato come me! Dichiaro Umiltà e semplicità il simbolo eterno della nostra amicizia, o non mi chiamo più Arataki Itto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480409
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480409,
					"content": "...Ehi! Dov'è il nostro cibo? Presto, ho quasi finito di raccontare le epiche avventure di Bastone cremisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480410
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480410,
					"content": "...Come potete notare, cambiare l'ordinazione potrebbe essere un tantino difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480411
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480411,
					"content": "Caspiterina, il suo ego è smisurato... Anche se glielo dicessimo, probabilmente preferirebbe mangiare il tofu che rimangiarsi quello che ha detto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480412,
						401480413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480412,
					"content": "Non abbiamo altra scelta... Dobbiamo preparare quel piatto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				},
				{
					"id": 401480414,
					"content": "Buona idea. Mi assicurerò che si sazi con quelli... Per il resto, dovremo improvvisare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480413,
					"content": "E se servissimo qualche antipasto gratis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				}
			]
		},
