						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "Uh... Ecco da mangiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480202,
					"content": "Oh oh, e questo sarebbe Umiltà e semplicità? Gente, voi non scherzate! E che bella porzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480203,
					"content": "Forza, compadre, prendi una sedia. Siamo tutti amici qui, non perdiamoci nei convenevoli! Io mi abbuffo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480204,
					"content": "Ahem! Capo, dovremmo rispettare le usanze locali. Qui a Liyue aspettare che siano gli ospiti a mangiare per primi è un gesto di cortesia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480205,
					"content": "Un gesto di cortesia? Uh... Shinobu, pensavo che le vecchie tradizioni non fossero nelle tue corde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480206,
					"content": "#Ora che ho finito il mio lavoro in cucina, sarò {F#un'ospite}{M#un ospite} anch'io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "Eh? Scherzi, compadre? Oh, aspetta, ho capito. Il cibo ha un profumino talmente buono che ora tutti vogliono essere i primi a mangiare! Beh, pare che la colpa sia solo dei miei ottimi gusti. Forza, abbuffatevi, sarò l'ultimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480210,
					"content": "Tu, Paimon, Ayato e Shinobu iniziate a mangiare, lasciando pochissima \"carne\" nel piatto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "...Ah, capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480212,
					"content": "È il mio turno, finalmente! Evvai, ora prendo il pezzo più grosso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480213,
					"content": "Aspetta, non farlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480214,
					"content": "Eh? Cosa c'è adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480215,
					"content": "Prego, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "Uh... Ok, Paimon farà del suo meglio... Allora, ahem, Paimon ha dimenticato di raccontarti la fantastica storia sull'origine di questo piatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480218,
					"content": "La storia sull'origine di questo piatto? A chi importa da dove viene? Sappiamo tutti dove andrà a finire: nella mia pancia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480219,
					"content": "Uh, beh... Mmm... Saltare la storia sulla sua origine è come... viaggiare senza una guida turistica! Fidati di Paimon, una volta ascoltata la storia, la tua esperienza culinaria sarà stratosferica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480220,
					"content": "#Paimon ha ragione. Come ogni tipo di tè dev'essere apprezzato seguendo delle regole specifiche, gustare un piatto senza conoscerne la storia sarebbe come sdegnare le buone intenzioni {F#della}{M#dello} chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480221,
					"content": "#Sdegnare le buone intenzioni {F#della}{M#dello} chef, eh? Non posso farlo... Ok, allora, sentiamo questa storia! Sono tutt'orecchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480222,
					"content": "Così va meglio! Cominciamo dagli ingredienti... Anzi, no, dalla storia della Locanda Wangshu... che inizia con la storia della Palude di Dihua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480223,
					"content": "#(È la nostra occasione, {NICKNAME}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480224,
					"content": "(Tutto chiaro!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "Mentre Itto è distratto, tu e Shinobu iniziate a trangugiare il piatto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "...Caspita, la storia della Palude di Dihua è tosta... In passato la gente se la passava davvero male. Ti fa apprezzare quello che hai. \"Umiltà e semplicità\" è... un ottimo modo di concepire la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480227,
					"content": "(Mannaggia, ora Paimon non può parlare di tofu... Paimon è andata troppo fuori tema. Uff... Beh, la buona notizia è che nel piatto non è rimasto quasi nulla!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480228,
					"content": "(Ma abbiamo già... mangiato a sazietà...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "Aaah! Compadre, Shinobu! Avete mangiato per tutto il tempo?! Non mi avete lasciato praticamente niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480230,
					"content": "Basta, non aspetto più! Ora tocca a me mangiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480231,
					"content": "Un attimo! Capo, in realtà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480232,
					"content": "Aspetta un secondo, Itto. Avrei... una piccola richiesta, se volessi essere tanto gentile da prenderla in considerazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480233,
					"content": "Sono uscito di casa in fretta e furia, e non ho potuto portare con me nessuno dei miei familiari. Hanno sentito molto parlare di te e sono grandi ammiratori della Banda di Arataki, quindi saranno molto dispiaciuti di scoprire che hanno perso quest'opportunità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480234,
					"content": "Tuttavia... Se mi permettessi di portargli ciò che rimane dell'Umiltà e semplicità, sono certo che solleverebbe loro il morale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480235,
					"content": "Ehh... Sì, non saprei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480236,
					"content": "Capo, gli amici vanno sempre rispettati. È una virtù della gente di Liyue... Inoltre, hai già mangiato parecchio pesce alla griglia mentre aspettavamo la portata principale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480237,
					"content": "...Compreso il mio e quello di Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480238,
					"content": "Eh? L'avevate ordinato per voi?! Maledizione... Mi sono lasciato trasportare troppo dalla storia, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480239,
					"content": "Ahem, in tal caso... Porta i miei saluti alla tua famiglia, fratello! Chef, possiamo portare via il resto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480216,
					"content": "Sai come fare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "Forse potrei iniziare io a mangiare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
