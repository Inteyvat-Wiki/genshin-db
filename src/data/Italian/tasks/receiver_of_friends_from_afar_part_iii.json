			"dialogs": [
				{
					"id": 401489701,
					"content": "\"Conte Distruttore\", \"Mortecelere\"... Non pensavo che a Liyue ci fossero tutti questi scarabei lottatori d'élite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489702
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489702,
					"content": "In realtà non sei venuto per partecipare al torneo di lotta tra Onikabuto, vero...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489703
					]
				},
				{
					"id": 401489703,
					"content": "Eh, te lo immagini? Sarei leggermente in ritardo, ahah. In realtà, questo viaggio è per metà di lavoro e per metà di piacere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489704
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489704,
					"content": "Perché non sei venuto al Festival delle lanterne, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489705
					]
				},
				{
					"id": 401489705,
					"content": "Ogni visitatore ha i suoi programmi. Per alcuni le festività sono un motivo in più per venire, ma per altri sono esattamente il contrario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489706
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489706,
					"content": "In ogni caso, sembra che sia capitato nel posto giusto al momento giusto... Riguardo agli avanzi di tofu... Sì, sono sicuro che Thoma se ne sbarazzerà nel modo più opportuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayato"
				}
			]
		},
