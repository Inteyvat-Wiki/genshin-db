				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mualani",
					"Kinich",
					"Ajaw",
					"Kachina",
					"Citlali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "Wow, la nostra Archon è davvero incredibile! Ed è anche super coraggiosa. Ha persino affrontato Xbalanque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270102,
					"content": "Non essere così modesta. Tu avresti fatto lo stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270103,
					"content": "Ah, chi di noi non l'avrebbe fatto? Io avrei colto l'occasione! E tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 50270104,
					"content": "Io... non avrei osato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50270105,
					"content": "Combattere è nella natura di ogni guerriero. Se ti si fosse presentata l'opportunità, sono sicuro che il tuo istinto avrebbe prevalso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270106,
					"content": "*sospira* Siete tutti così pieni di energia... È di Lord Xbalanque che stiamo parlando. Il nostro più grande antenato! Hai così tanta voglia di confrontarti con i tuoi predecessori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50270107,
					"content": "Nonna Citlali! Un giorno vorrei provare ad affrontare te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270108,
					"content": "Assolutamente no, puoi scordartelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
							"2"
						],
						"stepId": 502701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mausau",
					"Ororon",
					"Iansan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "Che tipo di ortaggio pensi diventerò? Uno rosso, oppure... uno verde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270202,
					"content": "Tu? Ho il presentimento che... potresti diventare una cipolla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270203,
					"content": "Una cipolla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270204,
					"content": "Qualcuno dall'aspetto ordinario, ma in grado di far crollare e piangere chiunque l'attacchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270205,
					"content": "Davvero? Sembra molto forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270206,
					"content": "Di cosa stanno parlando quei due...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270207,
					"content": "Le cipolle sono super potenti. Un giorno sono andato a casa di un mio amico. Stava affettando delle cipolle, e ha iniziato a piangere. Poco dopo anche i Saurici hanno cominciato a piangere e, alla fine, quasi tutte le creature nella stanza stavano piangendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270208,
					"content": "E tu? Anche tu hai pianto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270209,
					"content": "Anch'io ero nella stanza, ma mi sono protetto gli occhi con il mio mantello giusto in tempo. Non potendo vedere il mio viso, Cacucu e Ifa hanno pensato che stessi piangendo anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270210,
					"content": "Anch'io vorrei diventare un uomo-cipolla per far piangere la gente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270211,
					"content": "Certo, nessun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270212,
					"content": "Vorrei davvero interrompervi, ma non ho idea di cosa dire per farvi cambiare discorso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270213,
					"content": "Beh, Iansan, tu sei un piccolo... fungo, che non è nemmeno un ortaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270214,
					"content": "Nessuno te l'ha chiesto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270215,
					"content": "Un fungo, eh? Niente male. I funghi sono resistenti, forti e pieni di vita. Mi piacciono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270216,
					"content": "Allora anche tu devi essere piena di vita. Vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270217,
					"content": "Proprio così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270218,
					"content": "Beh... Certo, perché no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		}
	]
}