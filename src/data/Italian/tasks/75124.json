						],
						"pointId": 10425
					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "*sospira* È scappato di nuovo. Ah, ne è rimasto solo uno nel salvagente... E ora che si fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240102,
					"content": "Quanto ci vorrà...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240103,
					"content": "Uhm, sembra che qualcuno stia scattando delle foto... ai pinguini Solcacorrenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240104,
					"content": "Beh, in effetti sono molto carini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240105,
					"content": "Il modo in cui ondeggiano da una parte all'altra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "Vero? Sono così carini, quando camminano ondeggiando. E quando si gonfiano e galleggiano sull'acqua... Ah, fanno sentire felice Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240109,
					"content": "Proprio così, mia adorabile signorina dai meravigliosi capelli argentini! Chiunque abbia creato i pinguini Solcacorrenti merita ogni lode che questo mondo possa offrire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240110,
					"content": "È così fantastico che... Ah, aspetta, non mi sono ancora presentato. Sono un fotografo appassionato di pinguini Solcacorrenti. Mi chiamo Jonvelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240111,
					"content": "#Certo! Paimon si chiama Paimon, e {F#lei}{M#lui} è {NICKNAME}... Ma perché sospiri con un'aria così triste? Non ci sono tantissimi pinguini Solcacorrenti attorno a te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240112,
					"content": "È... una storia lunga, ma la riassumerò. Ci sono molte persone come me, e ognuno di noi vuole scattare le foto più interessanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240113,
					"content": "E giusto pochi giorni fa ho avuto un'idea geniale: far indossare dei salvagente a tutti i pinguini Solcacorrenti nell'inquadratura della mia Fotokamera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240114,
					"content": "E quale sarebbe il significato di ciò, esattamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "Naturalmente, il significato è che non c'è alcun significato. I pinguini Solcacorrenti sanno nuotare, quindi far indossare loro dei salvagente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240116,
					"content": "...Non ha il minimo senso, proprio come lo è spendere Mora solo per riguadagnarli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240120,
					"content": "Sembra che tu gli stia mettendo troppe responsabilità sulle spalle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240121,
					"content": "È ciò che viene chiamata \"fotografia surrealista\"... Bisogna cercare un significato più profondo nella foto scattata... Peccato che, purtroppo, abbiamo riscontrato qualche problema in merito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240122,
					"content": "Come ci si può aspettare, i veri pinguini Solcacorrenti non indossano il salvagente, quindi non è possibile scattare fotografie simili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240123,
					"content": "Non hai usato la parola \"surreale\" a caso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#Un attimo. Potremmo occuparci noi di mettere il salvagente a tutti i pinguini Solcacorrenti, no? Forza, {NICKNAME}. Diamogli una mano, tra amanti dei pinguini Solcacorrenti bisogna collaborare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240125,
					"content": "Evviva, sì, una collaborazione entusiasmante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "Esattamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240129,
					"content": "Sul serio? Mi aiuteresti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240130,
					"content": "Hihi, basta che ci dai delle belle foto quando le avrai scattate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240131,
					"content": "B-Beh, allora sarò in debito con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240127,
					"content": "In realtà preferisco gli scoiattoli volanti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "Ehi, questo non è il momento per pensare a cose del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240117,
					"content": "In effetti, una persona normale non avrebbe mai pensato a una cosa del genere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "Quando i pinguini Solcacorrenti, che sanno galleggiare sull'acqua da sé, indossano dei salvagente, si crea una sovrabbondanza di significati all'interno della foto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240119,
					"content": "In questo modo, incarnano a dovere sia il tema di \"uso eccessivo\" che quello di \"spreco\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240107,
					"content": "In realtà preferisco gli scoiattoli volanti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "Beh, sono carini anche loro, ma riusciresti davvero a dire che gli scoiattoli volanti sono più carini davanti a un pinguino Solcacorrenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
