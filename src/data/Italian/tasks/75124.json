			"dialogs": [
				{
					"id": 751240301,
					"content": "Ah, tempismo perfetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240302,
					"content": "Non riesco a credere che la mia missione fotografica, in cui ho sempre fallito nonostante il mio impegno, sia stata completata così velocemente grazie al vostro aiuto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240303,
					"content": "Tutti questi pinguini Solcacorrenti, con le loro ondeggianti forme tondeggianti dentro a dei salvagente! Una vista talmente toccante da far scendere una lacrimuccia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240304,
					"content": "È davvero così emozionante...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "A volte, scegliamo come scopo della nostra vita qualcosa che gli altri non riescono a comprendere... Viene perfino ritenuto un'assurdità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240306,
					"content": "Cionondimeno, finché continuerò a scattare queste foto, credo che il numero di amanti dei pinguini Solcacorrenti sia destinato ad aumentare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240307,
					"content": "Anche Paimon crede al cento per cento in questo futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240308,
					"content": "Ah, vi ringrazio davvero tanto per il vostro aiuto! Ecco, prendete questi come segno di gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				}
			]
		},
		{
