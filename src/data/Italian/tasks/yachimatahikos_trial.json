				"points": []
			},
			"dialogs": [
				{
					"id": 722680101,
					"content": "#Io sono Uda dei Jibashiri. Ero{F#ina}{M#e} di Sangonomiya, riconosco che sei meritevole di affrontare questa sfida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680102
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680102,
					"content": "Con me dovrai affrontare la prova della saggezza. Avanza e risolvi tutti gli enigmi per riportare le Fiamme dell'alta Porta al loro posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680103
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680103,
					"content": "La saggezza cammina di pari passi con il coraggio, libera dall'incoscienza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722680104
					],
					"speakerTitle": "Uda"
				},
				{
					"id": 722680104,
					"content": "Attenderò che tu abbia completato la sfida alla torre dei tre regni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uda"
				}
			]
		},
