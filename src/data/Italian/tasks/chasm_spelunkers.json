				7103702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103702",
							"2"
						],
						"stepId": 7103702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "Fiuu, conosco bene quest'aria! Quanto tempo dall'ultima volta in cui sono scesa in queste miniere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370102,
					"content": "Non abbassare la guardia, Qiong. Io sento già qualcosa di strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370103,
					"content": "Comunque sia, non abbiamo raggiunto il fondo della miniera. Forse sono state le oscillazioni della gru a distrarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370104,
					"content": "Tu... tu hai passato troppo tempo in superficie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370105,
					"content": "Anche Paimon non sente nessun odore... Ma i minatori hanno tutti un olfatto così sensibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370106,
					"content": "Ahah! La mancanza di un buon olfatto può costare la vita da queste parti! Detto questo, non dovrebbero esserci problemi. I fringuelli stanno ancora benissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370107,
					"content": "Guardate, i Cristalluce sono arrivati fino a qui. L'ultima volta che eravamo in questo posto non c'erano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370108,
					"content": "Wow, è successo davvero! Andiamo a vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370109,
					"content": "Uff, pare che qualcuno abbia rubato la scena a Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "Chi avrebbe mai immaginato di trovare dei Cristalluce in un'area tanto vicina alla superficie! Ho sempre pensato che non potessero apparire in luoghi strutturalmente più esposti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370202,
					"content": "Sono frammenti di quella \"cosa\" nel sottosuolo. Sono arrivati fin qui attraverso i filoni nelle rocce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370203,
					"content": "Ehi! Smettila con queste assurdità. Erano rocce tipiche del posto. Sono diventate così solo perché hanno subito un qualche un processo di trasformazione che ha portato alla formazione dei cristalli, tutto qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370204,
					"content": "Le analisi che abbiamo condotto per conto delle Sette Stelle hanno rivelato che sono costituite in gran parte da minerali locali. Sono solo state modificate da qualche forza esterna, la quale ha indotto la formazione di questi strani cristalli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370205,
					"content": "#Oh, guarda laggiù! Quel cristallo è identico al catalizzatore che hai con te, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370231,
					"content": "#Perché non prendi il catalizzatore di Pietraluce e diamo un'occhiata, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370232,
					"content": "È vero. Il catalizzatore è fatto con lo stesso materiale di questi cristalli. Queste formazioni reagiranno naturalmente l'una all'altra, poiché costituite dallo stesso materiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370206,
					"content": "Che strano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "Ehi, è tutto qui quello che hai da dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370209,
					"content": "Su, smettete di litigare, voi due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370210,
					"content": "Non stiamo litigando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "È vero, non stavamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370212,
					"content": "Non mi importa se stavate litigando o meno. Io e Zhiqiong dobbiamo allestire un accampamento temporaneo poco più avanti, quindi non allontanatevi da qui mentre siamo occupate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370213,
					"content": "I cristalli che abbiamo scoperto ci torneranno molto utili per proseguire l'esplorazione. Se doveste trovare altre cose, fatemelo sapere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370214,
					"content": "Mi ricordo ancora come si lavora un minerale, perciò posso darvi una mano nel caso troviate dei materiali grezzi. Penso proprio che potrebbero esservi utili nelle vostre avventure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370215,
					"content": "E poi... ehm... Non litigate, capito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370216,
					"content": "Va bene, va bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370217,
					"content": "Capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "#Molto bene, che brav{F#e}{M#i} ragazz{F#e}{M#i}. Dopo vi darò un po' di caramelle. In ogni caso, se doveste trovare qualcosa di strano, segnalatelo al più presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370219,
					"content": "A proposito, Jinwu, ti ricordi cosa avevi detto riguardo a zio He l'altra volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370220,
					"content": "#Sì, certo che mi ricordo. Visto che sei qui, {NICKNAME}, potresti darmi ancora una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370221,
					"content": "Zio He era uno dei veterani della miniera. Alcuni anni fa, i minatori vennero evacuati e alcuni di loro furono dati per dispersi. Tra questi, c'era anche zio He. Non aveva un buon udito, quindi probabilmente non sentì l'allarme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370222,
					"content": "L'Unione di Huishan e l'Unione di Shenglu pagano delle pensioni piuttosto generose, quindi la sua famiglia fece celebrare il suo funerale tanto tempo fa. Tuttavia, sebbene io non creda molto nel soprannaturale, ho come il sentore che sia ancora vivo, quaggiù da qualche parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370223,
					"content": "Era davvero un veterano esperto. Sapeva come affrontare qualsiasi situazione, sia che si trattasse di evitare un disastro, fuggire dalla miniera o attendere i soccorsi. Mi ha anche insegnato molte cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370224,
					"content": "Ecco perché ritengo che debba essere ancora vivo, qui da qualche parte... Non ho intenzione di smettere di cercarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370225,
					"content": "Posso indicarti gli ultimi punti in cui lo videro prima dell'incidente. Chissà, magari facendo una ricerca riuscirai a trovare degli indizi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370226,
					"content": "Quanto a me, esplorerò le aree più profonde delle caverne della miniera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370233,
					"content": "Ah, sì! Non dimenticate le vostre caramelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370227,
					"content": "Non vieni con noi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "Deve ancora aiutarci a tracciare alcune mappe. I percorsi delle miniere nel sottosuolo della Voragine sono complessi e intricati. Senza quelle mappe, non andremo molto lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370229,
					"content": "Fai attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "Me la caverò. Non sono certo una principiante. Non preoccupatevi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370207,
					"content": "È davvero incredibile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
		{
			"id": 7103703,
			"completionStepIds": [
				7103709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
