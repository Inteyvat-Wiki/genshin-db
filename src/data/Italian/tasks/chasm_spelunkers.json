			},
			"dialogs": [
				{
					"id": 710370601,
					"content": "Tutto questo è accaduto grazie a te. Prendi, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370602
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370602,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370603
					]
				},
				{
					"id": 710370603,
					"content": "#Dai, su, non c'è bisogno di essere così formali, anche perché è Khedive quello che sborsa i Mora! Oh, aspetta, shhh... Meglio stare zitt{F#e}{M#i}, altrimenti lo studioso più taccagno di Sumeru potrebbe sentirci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370604
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370604,
					"content": "*tossisce* Ehm, allora andiamo a cercare Jinwu? Potremo mettere alla prova le sue conoscenze facendole qualche domanda sorta lungo il cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370607
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370607,
					"content": "Bene, non ti tratterrò oltre. Ti auguro buon viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
