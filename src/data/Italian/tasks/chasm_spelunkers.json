			"dialogs": [
				{
					"id": 710371101,
					"content": "Tutto questo è accaduto grazie a te. Prendi, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371102,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710371103
					]
				},
				{
					"id": 710371103,
					"content": "#Dai, su, non c'è bisogno di essere così formali, anche perché è Khedive quello che sborsa i Mora! Oh, aspetta, shhh... Meglio stare zitt{F#e}{M#i}, altrimenti lo studioso più taccagno di Sumeru potrebbe sentirci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371104,
					"content": "*tossisce* Ehm, allora andiamo a cercare Jinwu? Potremo mettere alla prova le sue conoscenze facendole qualche domanda sorta lungo il cammino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371105
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371105,
					"content": "Sai una cosa? Jinwu non ama parlarne, ma anche lei è era una figura di spicco qui nelle miniere, esattamente come te al Picco del Drago, per via delle tue imprese... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371106
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371106,
					"content": "Ho sentito che fece da guida alle squadre di ricerca dei Milleliti e che insieme salvarono molte vite. Tuttavia, ormai sono cose del passato. Non devo parlarne troppo, altrimenti potrebbe arrabbiarsi un'altra volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371107,
					"content": "Bene, non ti tratterrò oltre. Ti auguro buon viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		}
	]
