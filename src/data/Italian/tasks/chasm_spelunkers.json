			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#Ah, sei tu {NICKNAME}! Ben trovat{F#a}{M#o}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370502,
					"content": "Ho un messaggio per te da parte di Jinwu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "Un'altra ramanzina del tipo \"è pericoloso, bisogna fare attenzione\"? Sono già stufa ancora prima di sentirla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370504,
					"content": "Anch'io sono cresciuta in queste miniere. Pensi che non conosca bene le insidie di questi luoghi, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370505,
					"content": "Quanto ai pericoli sconosciuti... Beh, i nostri superiori erano soliti basarsi sulla propria esperienza per valutarne l'entità, per poi ritrovarsi a fare leva sui fatti per giustificare le loro valutazioni teoriche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370506,
					"content": "#Ne avevo fin sopra i capelli della loro arroganza. Immagino che anche tu, in qualità di avventurier{F#a}{M#e} espert{F#a}{M#o}, sia un po' come loro, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370507,
					"content": "#Beh, se Iris, con la sua solfa su rischi e pericoli, ti avesse spaventat{F#a}{M#o} tanto da indurti a non scalare il Picco del Drago, ti saresti pers{F#a}{M#o} un'avventura fantastica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370508,
					"content": "Quindi smetti di provare a convincermi. Non ho voglia di discutere con te di simili sciocchezze. Possiamo cambiare argomento, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370509,
					"content": "Guardati in giro. Sto studiando tutto il terreno qui intorno. È perfetto per disegnare le nostre mappe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370512,
					"content": "Peccato che... il cammino sia bloccato da una cosa strana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370513,
					"content": "Se tu potessi raccogliere dei campioni o scattare delle foto, sono sicura che al Ministero degli Affari Civili e alla Gilda degli avventurieri sarebbero molto contenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370514,
					"content": "Me ne sarei occupata io, se non fosse che... ho perso la mia Fotokamera mentre scendevo qui sotto, quindi ora non posso che contare su di te, eheh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370515,
					"content": "Inoltre, in alcuni punti, sparsi qua e là, ho trovato anche delle tracce di Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370516,
					"content": "Scusami, ma come si fa a sapere dove trovare cosa? Paimon non ci capisce più niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370517,
					"content": "Sulla mappa hai disegnato solo croci e linee...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Ahahah, perdonatemi... È l'abitudine. Spesso mi dimentico che non tutte le persone hanno un'indole naturale per la cartografia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370519,
					"content": "In ogni caso, nessun problema: vi seguirò e vi mostrerò dove andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370520,
					"content": "Possiamo cominciare da uno di questi luoghi, a voi la scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370521,
					"content": "In tal caso, andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "Fai attenzione mentre avanziamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "Certo, lo farò. Grazie del pensiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370510,
					"content": "Cosa ci fai di nuovo quaggiù?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370511,
					"content": "Beh, non l'ho appena detto? Sto studiando il terreno per disegnare una mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
