			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370301,
					"content": "#Oh, siete tornat{F#e}{M#i}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370302,
					"content": "Zio He ha lasciato in giro questi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "Eh? Davvero? Ditemi di che si tratta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370306,
					"content": "Racconti a Jinwu tutto ciò che avete trovato.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "Mmmh... Magma nero... Pietraluce... e dei funghi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370305,
					"content": "Oh, è tutto molto strano, ma allo stesso tempo anche un po' familiare. Torniamo all'accampamento, è meglio non restare qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103711",
							"2"
						],
						"stepId": 7103711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "Eccoci qua. Che strano... Dov'è finita Zhiqiong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370402,
					"content": "Ehi! Zhiqiong! Zhiqiong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370403,
					"content": "*sospira* Scommetto che è corsa di nuovo a disegnare le sue mappe in qualche angolo remoto di questo posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370404,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "#Non appena ve ne siete andat{F#e}{M#i}, si è messa a disegnare questa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370408,
					"content": "È probabile che si sia addentrata per continuare l'esplorazione. Per favore, ditele che deve smetterla di andarsene in giro da sola lasciandoci indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370409,
					"content": "Se dovesse accadere qualcosa di brutto, ne pagheremmo tutti le conseguenze. Il mio pugno non ci andrà leggero, potete contarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370410,
					"content": "Spaventoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370411,
					"content": "Sì, molto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "Molto bene, allora. Bando alle ciance e muoviamoci. Potete rimanere qui ad aiutarmi con l'accampamento oppure andare in esplorazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370413,
					"content": "Scusatemi se sono un po' brusca. Voglio semplicemente assicurarmi che ciò che faccio sia utile a tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370414,
					"content": "Ah, giusto, già che ci sono: se doveste trovare dei minerali di Pietraluce, portatemene un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370415,
					"content": "Troverò il modo di lavorarla per ottenere dei catalizzatori più efficienti. In base alla mia esperienza, posso dirvi che ci saranno molto utili nelle profondità delle miniere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370405,
					"content": "Zhiqiong è in pericolo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "No, non ancora. Però se continua ad andarsene in giro senza dirmi niente, prima o poi lo sarà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103705,
