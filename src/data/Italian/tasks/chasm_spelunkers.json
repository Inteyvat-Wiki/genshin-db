			"dialogs": [
				{
					"id": 710370901,
					"content": "È probabile che al vostro ritorno Zhiqiong avrà già completato la mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370902
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370902,
					"content": "In ogni caso, devo comunque aspettare che la squadra di trasporto in superficie ci mandi giù gli attrezzi, quindi, per ora, potete andare un po' in giro in esplorazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
