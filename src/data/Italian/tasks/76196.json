			"dialogs": [
				{
					"id": 761960201,
					"content": "Dorota? Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960202,
					"content": "Non potevi arrivare in un momento migliore, Linnea! Stavo proprio raccontando a tutti delle meraviglie dell'Argento lunare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960203,
					"content": "Oh, Argento lunare, Argento lunare... Esiste forse una pietra più perfetta in questo mondo illuminato dalla luna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960204,
					"content": "Guarda! La sua forma impeccabile, la sua consistenza liscia e arrotondata! E quel bianco iridescente abbinato a un'interazione elementale senza pari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960205,
					"content": "Ai miei occhi, solo la luna nel cielo può reggere il confronto con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960206,
					"content": "Umm... Sì. L'Argento lunare è un minerale bellissimo. Ne ho raccolti alcuni campioni anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960207,
					"content": "Vedi, sapevo che avresti capito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960208,
					"content": "Eppure, nessuno ne capisce di Argento lunare più di me! Anche se sei una consulente della Gilda degli avventurieri, non ti cederò il primo posto così facilmente. Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960209,
					"content": "Giusto! Visto che di solito sei tu a insegnare agli avventurieri, che ne dici se per una volta ti metto alla prova io?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960210,
					"content": "Ho qui tre pezzi di Argento lunare. Purtroppo, due di essi presentano dei piccoli difetti. L'ultimo, però, è il mio tesoro più prezioso. L'Argento lunare per eccellenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960211,
					"content": "Riesci a capire quale sia il più perfetto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960212,
					"content": "Vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960213,
					"content": "Quello a sinistra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960214,
					"content": "(Mmm? Che sta facendo Lumi?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960215,
					"content": "Questo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960216,
					"content": "Ahah, a quanto pare anche tu puoi sbagliare qualche volta, Linnea. Questo in realtà ha un piccolo difetto nascosto in un punto davvero poco visibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960217,
					"content": "Ok, mi hai beccata. Ma la prossima volta non perderò così facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960218,
					"content": "Per me va bene. Sono sempre pronta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960232,
					"content": "Linnea finisce per partecipare all'evento di apprezzamento dell'Argento lunare di Dorota, divertendosi un mondo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "Wow, non mi aspettavo che sarebbero stati tutti così entusiasti. È un peccato che momenti come questo finiscano così rapidamente... Bene, è ora di fare i bagagli e rientrare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960233,
					"content": "Lascia che ti aiuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960234,
					"content": "Oh, sarebbe fantastico! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960231,
					"content": "Fammi pensare di nuovo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960220,
					"content": "Quello al centro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960221,
					"content": "(Sembra che a Lumi piaccia questo qui.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960222,
					"content": "Questo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960223,
					"content": "Ah, la senti anche tu, vero? Quell'attrazione irresistibile che solo qualcosa di veramente perfetto può esercitare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960225,
					"content": "Quello a destra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960226
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960226,
					"content": "(Mmm? Che sta facendo Lumi?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960227,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960227,
					"content": "Questo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960228
