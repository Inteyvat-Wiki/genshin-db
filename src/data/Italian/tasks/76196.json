			"dialogs": [
				{
					"id": 761960301,
					"content": "Fiuu... Non ci siamo perse niente, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960302,
					"content": "Mmm... No, è tutto a posto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960303,
					"content": "Ti ho visto creare quei disegni divertenti sul terreno con l'Argento lunare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960304,
					"content": "Sì! Mi è costato un bel po' di fatica, ma credo che abbia aiutato davvero a far nascere in tutti l'amore per l'Argento lunare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960305,
					"content": "A proposito, ho sentito dire che esiste una leggenda popolare di Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960306,
					"content": "Parla di una ragazza che in origine viveva tra le stelle. Quando cadde sulla terra, lasciò enormi disegni sul terreno nel tentativo di tornare in cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960307,
					"content": "Alla fine, suo padre, il sole in cielo, vide la sua richiesta e la riportò a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960308,
					"content": "Magari vedrà i tuoi disegni e diventerà anche lui un fan dell'Argento lunare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960309,
					"content": "Ahah, se così fosse, sarei l'ambasciatrice suprema dell'Argento lunare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960310,
					"content": "Ma, a parte questo, mi preoccupa di più essere notata dagli uccelli dall'alto. Sai, anche i corvi e simili adorano le cose luccicanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960311,
					"content": "Vero. E, oltre ai corvi, dobbiamo anche fare attenzione alle Talpe fiutatrici e alle Donnoladre a terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960312,
					"content": "E anche a Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960313,
					"content": "Ahah, giusto! Anche a Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960314,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960315
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761960315,
					"content": "Comunque, grazie per l'aiuto di prima. Anche se questa è solo una piccola parte della mia collezione... Ecco, prendi! Consideralo un regalo per Lumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960316
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960316,
					"content": "Eheh, oggi è davvero una giornata fortunata, vero Lumi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960317
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960317,
					"content": "Ya-hoho!",
