				]
			},
			"dialogs": [
				{
					"id": 740450401,
					"content": "Benvenuti, benvenuti. Il nostro negozio offre la più ampia selezione di gemme preziose di tutta la Corte di Fontaine. Abbiamo anche una vasta gamma di prodotti in vendita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450402,
					"content": "C'è qualcosa che vi attira? Se non c'è, sarò più che lieto di esaudire le vostre richieste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450403
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450403,
					"content": "Abbiamo dei minerali misteriosi qui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450404
					]
				},
				{
					"id": 740450404,
					"content": "Esatto! Avendo un magazzino così esteso, di sicuro saprai dirci il suo valore, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450405,
					"content": "Oh? Quindi siete qua per commerciare minerali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450406
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450406,
					"content": "Allora siete nel posto giusto! Offriamo i prezzi migliori e i più onesti di tutta Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450407
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450407,
					"content": "Vediamo cosa avete qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450408
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450408,
					"content": "Mostri a Chesil lo strano minerale che avete trovato in precedenza.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450409
					]
				},
				{
					"id": 740450409,
					"content": "Woah... Nemmeno io ho mai visto una cosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450410
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450410,
					"content": "La lucentezza unica e la consistenza liscia... Si tratta senza dubbio di una varietà rara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450411
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450411,
					"content": "Scusate se chiedo, ma di cosa si tratta, esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450412,
						740450414,
						740450416
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450412,
					"content": "Non ne abbiamo idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450413
					]
				},
				{
					"id": 740450413,
					"content": "È per questo che siete venuti per una stima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450419,
					"content": "Davvero un peccato che ne abbiate portato solo un pezzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450420
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450420,
					"content": "Se avessimo un approvvigionamento stabile... potremmo creare accessori che farebbero faville a Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450421
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450421,
					"content": "(Puca ha detto che queste pietre erano ovunque vicino ai giacimenti minerari. Forse potremmo chiedere a lei...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450422,
						740450424,
						740450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450422,
					"content": "Ne abbiamo molto di più, in realtà.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450423
					]
				},
				{
					"id": 740450423,
					"content": "Davvero? Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450430,
					"content": "In ogni caso, oltre al minerale che avete portato, sono disposto ad acquistarne altro da voi per creare una serie di nuovi prodotti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450431
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450431,
					"content": "Sono disposto a pagarvi in anticipo per mostravi la mia sincerità, a patto che portiate altro minerale la prossima volta che venite a far visita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450432
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450432,
					"content": "Cosa ne pensi? Credo che sia un buon affare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450433
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450433,
					"content": "Eheh, anche Paimon lo pensa! Affare fatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450434,
					"content": "Perfetto! Ecco la vostra ricompensa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450435
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450435,
					"content": "Chissà come verranno fuori gli accessori fatti con questo minerale... Ahah, non vedo l'ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450436
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450436,
					"content": "Sarò qui in attesa di vostre notizie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450424,
					"content": "La fonte è un segreto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450425
					]
				},
				{
					"id": 740450425,
					"content": "Ah, ma certo, naturalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450426
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450426,
					"content": "Fintanto che hai un modo sicuro con cui li ottieni, è perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450427,
					"content": "Le puoi trovare vicino a Elynas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450428
					]
				},
				{
					"id": 740450428,
					"content": "Ehi! Perché gliel'hai detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450429,
					"content": "L'avete trovata a Elynas, uh? Sì, in genere le persone non vanno a cercare lì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450414,
					"content": "Uh, questa è una \"roccia Paimonica\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450415
					]
				},
				{
					"id": 740450415,
					"content": "Ehi, non dargli nomi bislacchi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450416,
					"content": "È oro cristallino abbagliante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450417
					]
				},
				{
					"id": 740450417,
					"content": "Woah! Te lo sei appena inventato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450418,
					"content": "Che nome straordinario! Non c'è da stupirsi che sia così speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				}
			]
		},
