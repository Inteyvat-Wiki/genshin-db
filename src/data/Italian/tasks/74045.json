				]
			},
			"dialogs": [
				{
					"id": 740450201,
					"content": "Puca, siamo qui! Abbiamo trovato il tuo amuleto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450202,
					"content": "Porgi l'amuleto a Puca.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Aah sì, è questo! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450204,
					"content": "Abbiamo trovato anche altre cose mentre cercavamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450205,
					"content": "È un minerale che non abbiamo mai visto prima. Abbiamo pensato che potesse essere di valore e lo abbiamo portato con noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450206,
					"content": "Se Paimon ricorda bene, spesso raccogli delle belle pietre in quest'area, giusto? Hai mai visto delle pietre come questa prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450207,
					"content": "Fatemi vedere... È davvero bella! Ma non è per niente preziosa... È una normalissima pietra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450208,
					"content": "È vero che non troverete nulla del genere in altri posti, ma si trovano ovunque nei giacimenti minerari qui vicino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450209,
					"content": "Ah, quindi è solo una normale roccia! Paimon pensava fosse preziosissima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450210,
					"content": "A quanto pare non possiamo usarla per nient'altro. Cerchiamo un posto dove buttarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450211,
					"content": "Ma se il minerale non si trova altrove...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Oh, intendi dire che possiamo guadagnarci molto se lo vendiamo altrove?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450214,
					"content": "#Hai ragione! La gente di solito non va a estrarre minerali nei villaggi delle Melusine, ciò significa che non hanno mai visto nulla del genere... Ottima pensata, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450215,
					"content": "Andiamo, portiamo questa pietra alla Corte di Fontaine e mostriamola ai mercanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450216,
					"content": "Se c'è altro che vorreste sapere riguardo ai minerali, sapete dove trovarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450217,
					"content": "Io però non gestisco un emporio di gemme come mia sorella e non so molto riguardo a valutazioni e lavorazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450218,
					"content": "Preferisco raccogliere ogni tipo di rocce uniche, piuttosto che gemme preziose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450219,
					"content": "Posso dire di conoscere i giacimenti minerari del posto piuttosto bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450220,
					"content": "Eheh, ho capito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450212,
					"content": "Se è specifico di questa regione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
