			},
			"dialogs": [
				{
					"id": 740450101,
					"content": "Puca, perché sei di nuovo qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450102,
					"content": "Non dovrebbero esserci altri mostri nei paraggi, ma chi lo sa quali altri pericoli potrebbero annidarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450103,
					"content": "Comunque, non dovresti scappare e andartene in giro da sola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450104,
					"content": "#Non sono scappata, Paimon e {NICKNAME}... Sto solo cercando il mio amuleto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450105,
					"content": "Eh? Hai perso il tuo amuleto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450106,
					"content": "Sì... Dovrebbe essere da qualche parte in quel posto in cui di solito raccolgo le rocce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450107,
					"content": "Mmm, forse l'hai lasciato lì per sbaglio quando sei rimasta intrappolata prima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450108,
					"content": "*tira su col naso* Sì, potresti avere ragione... Avevo troppa paura per pensare a qualsiasi altra cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450109,
					"content": "Ho ancora un po' paura a pensarci, ma il mio amuleto è molto importante... Devo trovarlo, devo solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450110,
					"content": "Mmm... Paimon pensa che sarebbe troppo rischioso per Puca andare là da sola. In questo caso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, perché non torniamo indietro e aiutiamo Puca a cercare il suo amuleto? Puca, tu vai a casa e aspettaci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450112,
					"content": "Lascia fare a noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#Grazie, {NICKNAME} e Paimon! Farò la brava e aspetterò a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450113,
					"content": "In ogni caso avevo intenzione di esplorare quel posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
