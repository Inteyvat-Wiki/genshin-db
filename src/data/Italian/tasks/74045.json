			"dialogs": [
				{
					"id": 740450601,
					"content": "Ehilà, rieccovi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450602
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450602,
					"content": "C'è qualcosa che vi piacerebbe sapere riguardo al minerale? Potete chiedere tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450603,
					"content": "Anche se potrei non avere una risposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450604,
					"content": "Riguardo alle gemme preziose...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "Ci sono molte pietre belle e scintillanti nei giacimenti di minerale nelle vicinanze, ma non sono all'altezza delle vere pietre preziose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450606,
					"content": "Se fossi più brava a trovare vere gemme, forse potrei aprire il mio negozio di gemme come Sluasi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450607,
					"content": "A proposito dell'uso dei minerali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "Uh? Non ci avevo mai pensato prima d'ora... Colleziono le pietre solo perché sono belle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450609,
					"content": "Non ho altre domande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450610
					]
				},
				{
					"id": 740450610,
					"content": "#Eheh, grazie di essere venut{F#e}{M#i} a giocare con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		}
