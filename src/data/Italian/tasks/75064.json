				{
					"id": 750641504,
					"content": "Beh, non me lo avete mai chiesto, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641505
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641505,
					"content": "E perché mai avremmo dovuto... Uff, non ce l'hai mai detto, come facevamo a sapere di dovertelo chiedere?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641507,
					"content": "#Che bello rivedere anche voi, {F#Mademoiselle}{M#Monsieur} {NICKNAME} e cara, piccola Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641508
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641508,
					"content": "Sapevo che ci saremmo incontrati di nuovo! E proprio al momento giusto! Ho bisogno del vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641509
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641509,
					"content": "Qui? È qualcosa di complicato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641510,
					"content": "No, non particolarmente. Lo saprete a breve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641511
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641511,
					"content": "Magnifico balza agilmente dal suo pallone aerostatico e recupera la Cinekamera e il treppiede dal suo bagaglio, assemblandoli in uno spazio aperto.\\nTermina in poco tempo il suo lavoro e si erge di fronte a voi, orgoglioso.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750641506
					]
				},
				{
					"id": 750641506,
					"content": "Eheh, in ogni caso, fate largo. Sto per atterrare!",
