			},
			"dialogs": [
				{
					"id": 750641101,
					"content": "Mmm... Il prossimo è un Iktomisauro sotto il chiaro di luna! Sì, mi sembra una buona idea. Però, ottenere la giusta luminosità richiederà un po' di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641102,
					"content": "#Uhm... Ah! È arrivato il tuo momento, {REALNAME[ID(2)|SHOWHOST(true)]}, mio piccolo amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641103
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641103,
					"content": "Piccolo? Pfff. Paimon ci tiene a farti notare che è più alto di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641104,
					"content": "Roar? Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641105,
					"content": "Molto bene, molto bene... Il tempismo è perfetto... Ahah! Il mio capolavoro è quasi completo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641106
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641106,
					"content": "Allora assicurati di scattare una bella foto, voglio che tu mi ritragga come una delle tue ragazze fontainiane! Eheh, la citazione è quella, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641107,
					"content": "Roar, roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641108,
					"content": "Ahah, rilassatevi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641109
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641109,
					"content": "Questa inquadratura! Il chiaro di luna! Ah! Ah! È semplicemente perfetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641110
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641110,
					"content": "Un momento, fammi vedere... Mi servono altre due fonti di luce. Una per illuminare il profilo dell'Iktomisauro, così che si crei un contrasto tra la luce calda e lo sfondo notturno... È così che si crea un'atmosfera di mistero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641111
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641111,
					"content": "E l'altra fonte di luce deve illuminare la sagoma del Saurico. Non per motivi complicati, ma è una necessità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641112
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641112,
					"content": "Sì, sì... È proprio quello che cercavamo! È come un sogno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641113
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641113,
					"content": "Ma che...? Accidenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641114
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641114,
					"content": "Mi dispiace, ma forse la concentrazione degli elementi nell'atmosfera qui è diversa da quella di Fontaine. C'è qualcosa che non va con la macchina... Ma non preoccupatevi, ci penso io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641115
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641115,
					"content": "*fischietta* Mmmh... Non qui... E neanche qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641116
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641116,
					"content": "Accidenti, accidenti a tutto! Uff! Che razza di canaglia, di rammollito, di stupido! Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641117
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641117,
					"content": "Tu... Tu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641118
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641118,
					"content": "Ehi, ehi, calmati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641119,
						750641120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641119,
					"content": "Sembra quasi che gli esca il fumo dalle orecchie!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641122
					]
				},
				{
					"id": 750641122,
					"content": "Fiuuu... Beh... è tutto finito, ormai, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641123
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641124,
					"content": "Ehi, non guardarmi così. Almeno ora mi sento meglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641125
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641125,
					"content": "*sospira* Beh, come puoi vedere, la luce artificiale è rotta. E dopo tutti i Mora che ci ho speso... Che delusione, proprio come la mia ex moglie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641126
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641126,
					"content": "D'accordo, fermiamoci un attimo. Calma, non c'è bisogno di farsi prendere dal panico. Siamo qui per aiutare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641127,
					"content": "*sospira* Mi dispiace... Fiuuu. Ok. Cosa devo fare? Ah, sì. Con una luce devo illuminare <color=#00E1FFFF>il lato sinistro del viso dell'Iktomisauro</color> e con l'altra <color=#00E1FFFF>il contorno del dorso</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641128
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641128,
					"content": "Nessun problema! Diamoci da fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641129,
					"content": "E così, Magnifico comincia ad armeggiare di nuovo con la sua Fotokamera, lasciandovi il compito di pensare a come creare una fonte di luce adatta...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750641120,
					"content": "Che succede? State divorziando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641121
					]
				},
				{
					"id": 750641121,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641122
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
