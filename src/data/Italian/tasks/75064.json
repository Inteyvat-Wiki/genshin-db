						],
						"pointId": 9815
					}
				]
			},
			"dialogs": [
				{
					"id": 750640601,
					"content": "Ahah, bene, bene! Vieni, mio piccolo modello, non muoverti... Sì, che intelligente che sei! Tre, due, uno, sorridi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640602,
					"content": "Ah, ma guarda qui! Un capolavoro? E di chi è? Sì, è mio, è di Magnifico de la Magnificans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640603,
					"content": "Grazie, grazie mille! Ahah! Ecco il resto che vi devo! Ah, e anche questo. Guardate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640604,
					"content": "Oooh, un pagamento finale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640605,
					"content": "Aspetta... Un solo Mora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640606,
					"content": "Fantastico... E ora, i nostri veri protagonisti stanno per fare la loro comparsa! Su, venite, non siate timidi! Siete delle star, dunque fate la vostra entrata spettacolare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640607,
					"content": "Fiuuu, abbiamo finito! Ecco, prendi una copia come regalo... e sappi che hai ottenuto questo capolavoro prima di ogni altra galleria di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640608,
					"content": "Grazie. Lo custodiremo con cura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "Ma il pagamento finale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640613,
					"content": "Ora mi dirigerò verso questo luogo... Ecco, ve lo segno sulla mappa. Chissà, forse ci incontreremo ben prima di quanto possiate aspettarvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640614,
					"content": "E quando accadrà, potrei avere ancora bisogno del vostro aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640615,
					"content": "Uff, ci stai dando per scontato, adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640616,
					"content": "Beh, non sono stato io a decidere del nostro incontro. È opera del fato, del destino... Sì, è stato lui a farci incontrare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640617
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640617,
					"content": "#Ci vediamo, e buona fortuna, {F#amiche mie}{M#amici miei}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640618
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640618,
					"content": "Roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640619,
					"content": "Magnifico raccoglie i bagagli e salta su un pallone aerostatico.\\nGuardi il pallone tremare violentemente, cosa che fa ridere di cuore Magnifico, e poi recuperare rapidamente la stabilità prima di fluttuare lontano.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750640610,
					"content": "Non sembra un oggetto di grande valore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640611
					]
				},
				{
					"id": 750640611,
					"content": "Roar? Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "Già... Anche Paimon è delusa... Pensava che il pagamento finale fosse più sostanzioso della caparra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
