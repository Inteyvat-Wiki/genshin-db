			"dialogs": [
				{
					"id": 750641501,
					"content": "Pensavo di aver sentito qualcuno parlare di me, ma non mi aspettavo che foste voi due! Ahah, che coincidenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641502
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641502,
					"content": "#Woah! Ci siamo {F#dimenticate}{M#dimenticati} che hai un pallone aerostatico, eh? Non che tu ci abbia mai portato con te, tirchio che non sei altro!",
					"roleType": "TALK_ROLE_NPC",
