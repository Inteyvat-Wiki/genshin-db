					"Magnifico"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750640801,
					"content": "\"Louis, Louis!\"... Ah! Mi hai spaventato a morte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640802
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640802,
					"content": "#Allora, hai cambiato idea o sei {F#venuta}{M#venuto} solo per salutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640803,
						750640806
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640803,
					"content": "Sono qui per salutare e per aiutare, già che ci siamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640804
					]
				},
				{
					"id": 750640804,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640805
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640805,
					"content": "Ahah, magnifico. Allora iniziamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640806,
					"content": "Siamo solo di passaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640807
					]
				},
				{
					"id": 750640807,
					"content": "Va bene, allora buona fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
