			"dialogs": [
				{
					"id": 750640412,
					"content": "Ta-dà! Ecco una miracolosa fusione di luce e ombra, l'ultima impresa industriale di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640413
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640413,
					"content": "Cosa? Non è niente di nuovo. E poi, non ci hai ancora detto perché hai bisogno di aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640414,
						750640416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640414,
					"content": "Sì, diccelo e basta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640415
					]
				},
				{
					"id": 750640415,
					"content": "Fai indovinare a Paimon. Vuoi che ti aiutiamo a scattare una foto, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640418,
					"content": "Oh... Beh, certamente! Ecco la caparra. Vi prego di accettarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640419
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640419,
					"content": "Un momento, ma sono un sacco di Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640420,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640421
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640421,
					"content": "Come avete visto, ho bisogno di scattare qualche foto ai Saurici. E non parlo di quelle proiezioni ortogonali che si trovano nei libri di animali illustrati... Sto cercando qualcosa che sprizzi vitalità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640422
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640422,
					"content": "S-Sì, va bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640423,
					"content": "D'altra parte... \"Più vitalità\" significa \"meno probabilità che mi ascoltino\". Quindi, se non è un problema, vi dispiacerebbe aiutarmi a scattare le foto che voglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640424
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640424,
					"content": "S-Sì, va bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640425,
					"content": "Ovviamente, non dovrete sforzarvi a fare qualcosa che va oltre le vostre capacità, ma credo che potrete almeno proteggermi dalle forme di vita ostili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640426
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640426,
					"content": "Quindi, per favore, tenete pure la caparra... e decidete voi se aiutarmi o no!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640427
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640427,
					"content": "Woah... Questo sacchetto di Mora è pesantissimo... Sei sicuro che sia tutto nostro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640428,
					"content": "Suvvia, potrei mai ingannarvi? Volete che ricontrolli la cifra per voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640429
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640429,
					"content": "Eheheh... Ahahah! Beh, sembra che tu abbia trovato le persone giuste, perché Paimon è una rinomata domatrice di Saurici qui a Natlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640430,
					"content": "#Non preoccuparti. Finché {NICKNAME} e Paimon sono qui, ogni Saurico che desideri domare sarà domato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640431,
					"content": "Tepetlisauri? Semplice! Qucusauri? Ancora più semplice! Iktomisauri? Semplicissimo... Oh, e poi ci sono anche i Koholosauri, gli Yumkasauri e i Tachankasauri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640432,
						750640433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640432,
					"content": "Tachankasauri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640434,
					"content": "...Saurici testoni, Saurici con le braccia corte, Saurici occhialuti, Saurici spaventosi, Saurici spaventosissimi, Saurici spaventosi ma non troppo, Saurici strani, Saurici nella norma, Saurici magrissimi, Saurici super muscolosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640435,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640436,
						750640437
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640436,
					"content": "Di cosa stai parlando, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640438,
					"content": "E... i Roarsauri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640439,
					"content": "Roar, roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640440
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640440,
					"content": "E anche i Wraahrosauri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640441,
					"content": "Wraah! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640442
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640442,
					"content": "Comunque, basta dirci il nome e ce ne occuperemo noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640443,
					"content": "Roar, roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640444,
						750640447
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640444,
					"content": "*sospira* D'accordo, ti aiuteremo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640445
					]
				},
				{
					"id": 750640445,
					"content": "#Certo che lo aiuteremo. Dopotutto, abbiamo già preso una caparra di queste dimensioni! Giusto, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640446,
					"content": "Ah, magnifico. Splendido!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640447,
					"content": "Scusa, ho altre cose da fare, ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640448
					]
				},
				{
					"id": 750640448,
					"content": "Ma abbiamo già preso i soldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640449,
					"content": "Ah, non fa niente. Aspetterò che tu abbia tempo! Non rischio mica di sciogliermi in una misera pozzanghera senza il tuo aiuto, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640437,
					"content": "Paimon, un attimo, ma sentiti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640433,
					"content": "Un attimo, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640416,
					"content": "Pagami e ti darò una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640417
					]
				},
				{
					"id": 750640417,
					"content": "Siamo molto forti, quindi prima i Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				}
			]
		},
