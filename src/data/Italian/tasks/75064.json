			"dialogs": [
				{
					"id": 750641401,
					"content": "#Un attimo... Perché sei {F#svanita}{M#svanito} quando è apparso l'Iktomisauro? E perché è scomparso quando sei {F#tornata}{M#tornato}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641402
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641402,
					"content": "Non è che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641403
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641403,
					"content": "#Esatto, è {F#andata}{M#andato} in bagno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641404,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641405
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641405,
					"content": "Ehm, pensaci un attimo. Non possiamo andarci tutti insieme, no? Sarebbe imbarazzante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641406,
					"content": "#Oh, giusto, sì... Ahah, certo! {NICKNAME} non può trasformarsi in un Saurico! Ovviamente! Non sarebbe comunque una cosa negativa, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
