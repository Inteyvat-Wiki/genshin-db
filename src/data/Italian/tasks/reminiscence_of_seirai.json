			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "*sospira* Quando troverò qualcuno che mi accompagnerà di nuovo laggiù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630302,
					"content": "Per caso sai qualcosa di questa mappa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "#Sei per caso... {F#un'avventuriera}{M#un avventuriere} della Gilda? Finalmente hanno ingaggiato altre persone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630304,
					"content": "#Ehm, sono solo {F#una viaggiatrice}{M#un viaggiatore} di passaggio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "Oh, capisco... A ogni modo, a quale mappa ti stavi riferendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630306,
					"content": "Vediamo un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630307,
					"content": "M-Ma questa... Possibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630308,
					"content": "Cosa hai notato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "È l'Isola di Seirai, vero?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630311,
					"content": "Così pare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "Ahahah, davvero? Ho solo tirato a indovinare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630314,
					"content": "In passato i miei antenati vivevano sull'Isola di Seirai, ma è trascorso moltissimo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630315,
					"content": "La mia generazione non ha più ricordi della nostra vecchia terra natia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630316,
					"content": "A casa nostra restano solo tre dipinti di paesaggi dell'isola. Gli ultimi elementi che ci legano a essa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630317,
					"content": "Allora perché vuoi tornarci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "Beh... Rimane comunque la mia \"terra d'origine\", no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630319,
					"content": "Sento di doverla visitare, a ogni costo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630320,
					"content": "Purtroppo, però, la mia attività mi prende molto tempo, quindi non ho mai occasione di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630321,
					"content": "Inoltre, è difficile trovare avventurieri disposti a scortarmi sull'Isola di Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630322,
					"content": "Per questo ho scelto l'opzione B, ovvero pubblicare un incarico presso la Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630323,
					"content": "Speravo che qualche avventuriere potesse aiutarmi a raggiungere l'Isola di Seirai, trovare i tre luoghi mostrati nei dipinti, fare alcuni scatti con una Fotokamera e consegnarmeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630324,
					"content": "Eppure, al momento ancora nessuno ha accettato l'incarico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630325,
					"content": "Lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "D-Davvero? Sarebbe fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630328,
					"content": "Non preoccuparti per la ricompensa, al tuo ritorno sarà già pronta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630329,
					"content": "#Che dire, {F#viaggiatrice}{M#viaggiatore}, sono nelle tue mani! Contando la mappa che hai portato, i luoghi da fotografare sono quattro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630330,
					"content": "#Dirigiti quindi verso questi quattro punti dell'isola e scatta delle foto, {F#viaggiatrice}{M#viaggiatore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630326,
					"content": "Posso andarci io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "Risposta esatta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "È la tua terra d'origine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
		{
			"id": 7216304,
			"completionStepIds": [
				7216307,
				7216310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216307",
							"2"
						],
						"stepId": 7216307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Oda Tarou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630401,
					"content": "Sei ritornato. Come va? Hai scattato tutte le foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630402,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "Fantastico! Diamo un'occhiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630404,
					"content": "È solo che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630405,
					"content": "Ahahah! Non riconosco per niente questi luoghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630406,
					"content": "Sembra che quei tre scorci siano cambiati moltissimo, da quando la mia famiglia si è trasferita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630407,
					"content": "Chissà se la signorina Fujiwara Toshiko sarebbe in grado di riconoscerli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630408,
					"content": "Beh... in realtà ne dubito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630409,
					"content": "Anche lei è originaria dell'Isola di Seirai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "A dire il vero siamo più che altro nella stessa situazione. Anche i suoi antenati vivevano laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630411
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630411,
					"content": "Anzi, sai che gli antenati di moltissimi abitanti della Città d'Inazuma erano nativi di quell'isola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630412
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630412,
					"content": "E perché si sono trasferiti in massa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630413
					]
				},
				{
					"id": 721630413,
					"content": "Non saprei con esattezza... È passato così tanto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630414
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630414,
					"content": "Forse per via delle feroci tempeste, o per prevenire il contrabbando e i transiti illegali alle frontiere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630415
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630415,
					"content": "Qualunque fosse il motivo, lo Shogunato organizzò il trasferimento degli abitanti del luogo sull'Isola di Narukami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630416
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630416,
					"content": "Comunque sia, ecco la tua ricompensa. Grazie di cuore per aver completato l'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630417
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630417,
					"content": "*sospira* Ah, come vorrei visitare di persona l'Isola di Seirai, prima o poi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630418
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630418,
					"content": "Purtroppo devo gestire la mia attività...",
