			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Furuya Noboru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "Mmmh, un bel grattacapo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630202,
					"content": "Per caso sai qualcosa di questa mappa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "In base alla topografia, direi che si tratta di uno scorcio dell'Isola di Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630204,
					"content": "Come fai a dirlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "In passato, la Gilda ha commissionato numerose spedizioni sull'Isola di Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630206,
					"content": "Gli avventurieri si incaricavano di compilare dei rapporti con varie informazioni sull'isola, che poi ci consegnavano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630207,
					"content": "Purtroppo, la mancanza di personale ci ha impedito di organizzare spedizioni su larga scala, quindi siamo costretti a inviare solo qualche avventuriere qua e là per esplorare l'area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630208,
					"content": "Temo che questo limiti la misura in cui posso esservi d'aiuto nell'analizzare questa mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630209,
					"content": "Tuttavia, conosco qualcuno che ne sa molto più di me sull'Isola di Seirai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630210,
					"content": "Si chiama Oda Tarou. Ho sentito dire che i suoi antenati vivevano sull'Isola di Seirai, prima di migrare qui per varie ragioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630211,
					"content": "A proposito, qualche tempo fa è passato dalla Gilda per ingaggiare alcuni avventurieri affinché lo accompagnassero sull'Isola di Seirai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630212,
					"content": "Puoi chiedere a lui informazioni sulla mappa. Con un po' di fortuna, potrebbe essere in grado di risponderti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furuya Noboru"
				}
			]
		},
		{
			"id": 7216303,
			"completionStepIds": [
				7216302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
