			"dialogs": [
				{
					"id": 721640301,
					"content": "Miao! Sì, questo compito mi è stato assegnato specificatamente da Hibiki. È un incarico cruciale, nessun altro può occuparsene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640302,
						721640311
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640302,
					"content": "Riguardo al tuo nome...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640303
					]
				},
				{
					"id": 721640303,
					"content": "Il mio nome è Neko. Me l'ha dato Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640304,
					"content": "Spesso era lei ad accogliere gli ospiti del santuario. Ero felice che un compito tanto gravoso non ricadesse sulle mie spalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640305,
					"content": "All'epoca non avevo né nome né ruolo. Dormivo dove preferiva lei e giocavo con chiunque le andasse a genio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640306
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640306,
					"content": "Un giorno Hibiki disse: \"Chiamerò questa dormigliona Neko\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640307,
					"content": "Attualmente Hibiki non è qui, ma un santuario non può definirsi tale senza una Gran Sacerdotessa. Ho dunque preso il suo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640308,
					"content": "Ecco perché desidero riportare il santuario alla vivacità di un tempo, prima del suo ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640309,
					"content": "Quando sarà qui, potrò nuovamente addormentarmi sulle sue ginocchia e non dovrò più attendere che ripari la cassetta delle offerte o che usi il bastone per rimuovere le foglie cadute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640310,
					"content": "Beh, lascio a voi quei compiti. Alcuni infidi insetti si sono insinuati nel santuario e devono essere accompagnati alla porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640311,
					"content": "Allora chi puliva il santuario, prima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640312
					]
				},
				{
					"id": 721640312,
					"content": "Hibiki. A volte, Domeki la aiutava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640313,
					"content": "Prima del sorgere del sole, Hibiki spesso usava quel bastone e lo agitava qua e là. Versava perfino dell'acqua a terra... Bleah, acqua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640314
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640314,
					"content": "Un attimo, prima versava l'acqua e poi... Mmmh, non ricordo con esattezza la sequenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640315
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640315,
					"content": "Talvolta Domeki partecipava alle pulizie impugnando una croce metallica che faceva zac-zac, e come per incanto rami e foglie iniziavano a cadere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
