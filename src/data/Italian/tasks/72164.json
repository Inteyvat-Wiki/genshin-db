			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "Miao, miao... La cassetta si è rivelata molto utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640102,
					"content": "#Ah, sei tornat{F#a}{M#o}. La cassetta che hai riparato è stata molto utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640103,
					"content": "#Poco dopo che sei andat{F#a}{M#o} via, due umani vestiti di verde sono arrivati al santuario. Miao miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640104,
					"content": "Hanno offerto dei Mora, poi l'umano alto mi ha sentita parlare e sembrava sconvolto. Certo che vi stupite per delle banalità, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640105,
					"content": "A ogni modo, la cassetta delle offerte è un buon manufatto. Se ne riparassi un'altra, forse attireremmo più persone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640106,
					"content": "Ehm, non credo funzioni così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "Ah no? I ragionamenti degli umani sono incomprensibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640108,
					"content": "S-Secondo Paimon sono le condizioni del santuario a non attirare le persone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640109,
					"content": "Cosa vuoi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640110,
					"content": "C'è un po' di disordine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "Davvero? È che quei monelli amano giocare nei mucchi di foglie secche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640113,
					"content": "Se ben ricordo, però, Hibiki aveva un lungo bastone appuntito con cui radunava le foglie in mucchietti. Beh, di solito le sue idee erano ottime, quindi penso sia la cosa giusta da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640114,
					"content": "Cosa dobbiamo spazzare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "Non ho mai capito come dipanare il gomitolo di pensieri di voi umani, però in casi simili Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640117,
					"content": "Prima del sorgere del sole, Hibiki spesso usava quel bastone e lo agitava qua e là. Mi divertivo ad inseguirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640118,
					"content": "Tuttavia il mio ruolo di Gran Sacerdotessa provvisoria, ora mi impone di non indugiare in comportamenti tanto puerili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640119,
					"content": "Rammento che Hibiki era anche solita bagnare il suolo... Un'azione nefasta, sinceramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640120,
					"content": "Talvolta Domeki partecipava alle pulizie impugnando una croce metallica che faceva zac-zac, e come per incanto rami e foglie iniziavano a cadere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640121,
					"content": "Domeki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "Un uomo alto e rumoroso. Si fermava spesso a giocare con Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640125,
					"content": "Bah... quel vandalo recideva sempre i miei rami preferiti. Che individuo esasperante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640126,
					"content": "Secondo Paimon stavano riordinando o riorganizzando le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640127,
					"content": "Spazzare il pavimento, lavarlo con l'acqua, potare i rami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640128,
					"content": "Nulla di nuovo, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "Ah, è ciò che si intende col termine \"riordinare\"? Allora posso chiedervi di metterlo in pratica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640130,
					"content": "Tralasciando lo zac-zac. I rami come sono adesso mi piacciono molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640131,
					"content": "Il bastone, le foglie e l'acqua basteranno. Hai compreso le mie parole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640132,
					"content": "Non preoccuparti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "Miao! Sì, questo compito mi è stato assegnato specificatamente da Hibiki. È un incarico cruciale, nessun altro può occuparsene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640133,
					"content": "In realtà, posso sapere chi era Hibiki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "Hibiki è Hibiki. È la Gran Sacerdotessa del Santuario di Asase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640135,
					"content": "E tu ti chiami...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "Il mio nome è Neko. Me l'ha dato Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640137,
					"content": "Spesso era lei ad accogliere gli ospiti del santuario. Ero felice che un compito tanto gravoso non ricadesse sulle mie spalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640138,
					"content": "All'epoca non avevo né nome né ruolo. Dormivo dove preferiva lei e giocavo con chiunque le andasse a genio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640139,
					"content": "Un giorno Hibiki disse: \"Chiamerò questa dormigliona Neko\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640140
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640140,
					"content": "Attualmente Hibiki non è qui, ma un santuario non può definirsi tale senza una Gran Sacerdotessa. Ho dunque preso il suo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640141
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640141,
					"content": "Ecco perché desidero riportare il santuario alla vivacità di un tempo, prima del suo ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640142
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640142,
					"content": "Così, quando sarà qui, potrò nuovamente addormentarmi sulle sue ginocchia e non dovrò più attendere che ripari la cassetta delle offerte o che usi il bastone per rimuovere le foglie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640143
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640143,
					"content": "Beh, lascio a voi quei compiti. Alcuni infidi insetti si sono insinuati nel santuario e devono essere accompagnati alla porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640144
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640123,
					"content": "Zac-zac?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640124
					]
				},
				{
					"id": 721640124,
					"content": "Neko forse si riferisce alle cesoie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640115,
					"content": "Cosa vuoi che facciamo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640111,
