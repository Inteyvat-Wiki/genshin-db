						721640202
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640202,
					"content": "Tutto è perfettamente pulito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640203
					]
				},
				{
					"id": 721640203,
					"content": "Miao, miao. Bene. Nel frattempo ho scacciato quelle fastidiose pesti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640204,
					"content": "Oh, questo santuario continua a migliorare. La cassetta è riparata, è decisamente ben pulito... Sì, di certo sempre più persone verranno a visitarlo, in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640205
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640205,
					"content": "Miao, miao... Questo santuario deve tornare alla gloria di un tempo, sì... Miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640206,
					"content": "Possiamo fermarci qui. Grazie per l'aiuto... Miao miao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640207,
					"content": "Parlare la vostra lingua è... stancante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640208,
					"content": "Vado a riposare un po'. Potrei chiedere di nuovo il vostro aiuto in seguito...",
