			"dialogs": [
				{
					"id": 733430101,
					"content": "Niente male, Sorush! Hai ridato vigore a quest'area in pochissimo tempo, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430102,
					"content": "I poteri delle Pari sono alquanto affascinanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430103
					]
				},
				{
					"id": 733430103,
					"content": "Che esagerazione! I miei poteri sono più che sufficienti a salvare un fiore di Sunyata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430104
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430104,
					"content": "La corrosione oscura si diffonde, e questo fiore di Sunyata non è che una delle molteplici vittime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430105
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430105,
					"content": "Neanche gli altri stagni floreali sono stati risparmiati. Sefana dev'essere molto agitata in questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430106
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430106,
					"content": "Questa Sefana di cui parli sembra essere una Pari che si impegna molto per prendersi cura dei fiori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430107,
					"content": "#Dovremmo andare ad aiutarla, che ne dici, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430108,
					"content": "#Bene, suppongo che questo possa contare come un'opportuna distrazione dal mio grande lavoro. In tal caso, mi{F#a}{M#o} Yasnapati, ti invito a prestare attenzione ai fiori di Sunyata di questo tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430109
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430109,
					"content": "Ti farò sapere quando ne vedrò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733430110
					]
				},
				{
					"id": 733430110,
					"content": "Sì! Salviamo questi bellissimi fiori assieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
