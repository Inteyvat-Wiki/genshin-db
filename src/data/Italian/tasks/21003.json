			"dialogs": [
				{
					"id": 210039901,
					"content": "Come sta andando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039902
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039902,
					"content": "Ho eliminato quei mostri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210039903
					]
				},
				{
					"id": 210039903,
					"content": "Grazie, il tuo aiuto è stato prezioso. Mi dispiace avertelo dovuto chiedere. So che avrei dovuto farlo io, ma alla fine l'hai fatto tu al mio posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039904
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039904,
					"content": "#...Non c'è bisogno di fare {F#la}{M#il} modest{F#a}{M#o}. Sei ricopert{F#a}{M#o} di terra, quindi sono sicuro che hai combattuto con le unghie e con i denti contro quei mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039905
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039905,
					"content": "Uff, chissà cosa passa per la testa dei miei superiori? Ormai avrebbero già dovuto mandarmi dei rinforzi. Quest'area è decisamente troppo grande per una persona sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039906
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039906,
					"content": "Saranno anche solo un paio di ponti, ma sono attraversati da tantissime persone ogni giorno. Se accadesse qualcosa, sarebbe una catastrofe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039907
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039907,
					"content": "Non appena ne avrò l'occasione, manderò ai miei superiori un rapporto approfondito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039908
					],
					"speakerTitle": "Qiaoxi"
				},
				{
