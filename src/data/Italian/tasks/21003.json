					"Qiaoxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210030111,
					"content": "*sospira* Se avessimo più Milleliti, non ci sarebbero problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030112
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030112,
					"content": "Sarei ben felice di andare a eliminarli, ma ho paura che, se lascio la mia postazione, qualche altro mostro ne approfitterà per tendere un'imboscata ai passanti. Rimanere tutto il giorno bloccato qui mi fa sentire così inutile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030113
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030113,
					"content": "Potresti andare tu a sistemare quei mostri? Mi toglierebbe un grosso peso e potrei concentrarmi su altre questioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
		{
			"id": 2100311,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
