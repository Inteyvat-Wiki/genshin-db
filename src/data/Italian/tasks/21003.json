			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiaoxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "Non ce la posso fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033002,
					"content": "Qualcosa non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "Mmm? Chi va là? Chiunque voglia attraversare questo ponte deve essere interrogato. Sono le regole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033004,
					"content": "Detto ciò... Guarda che abiti indossi! Di sicuro non sarai un problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033005,
					"content": "Perché? Pensaci: un criminale si vestirebbe nel modo più discreto possibile, no? Tu, invece, hai gli abiti più vistosi del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033015,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033006,
					"content": "Sono il Millelite responsabile di quest'area. È uno degli ingressi principali della Palude di Dihua, ed è da qui che passano tutti i mercanti e i turisti. Quindi sto facendo la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033007,
					"content": "Proprio l'altro giorno ho scoperto un gruppo di mostri qui vicino... Sembra che abbiano allestito un accampamento ed è un bel problema, per quanto non abbiano ancora fatto niente. Devo tenerli d'occhio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033008,
					"content": "Sarei ben felice di andare a eliminarli... ma ho paura che, se lascerò la mia postazione, qualche altro mostro ne approfitterà per tendere un'imboscata ai passanti. Rimanere tutto il giorno bloccato qui mi fa sentire così inutile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033009,
					"content": "Ho eliminato i mostri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "Davvero? Tutti? È... fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033011,
					"content": "Il tuo aiuto è stato prezioso. Mi dispiace avertelo dovuto chiedere. So che avrei dovuto farlo io, ma alla fine l'hai fatto tu al mio posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033012,
					"content": "Uff, chissà cosa passa per la testa dei miei superiori? Ormai avrebbero già dovuto mandarmi dei rinforzi. Quest'area è decisamente troppo grande per una persona sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033013,
					"content": "Non appena ne avrò l'occasione, gli manderò un rapporto approfondito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033014,
					"content": "Ti ringrazio. Tieni, un omaggio per sdebitarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
