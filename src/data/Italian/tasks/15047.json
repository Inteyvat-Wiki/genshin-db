				]
			},
			"dialogs": [
				{
					"id": 150470401,
					"content": "...Oh, sembra che gli impianti qui siano ancora in costruzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470402,
					"content": "Guardate, un dipendente Iktomisauro! Credete che possa aiutarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470403,
					"content": "Ciao! Per caso potresti aiutarci a costruire questi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470405
					],
					"speakerTitle": "Cucciolo di Iktomisauro"
				},
				{
					"id": 150470405,
					"content": "Um... Metterlo... qui... e costruire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470407
					],
					"speakerTitle": "Cucciolo di Iktomisauro"
				},
				{
					"id": 150470407,
					"content": "Non sembra in grado di capirci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470408,
					"content": "Già... Uhm, ora che facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470409,
					"content": "...Ohhhh, aspettate! Ho avuto un colpo di genio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470410,
					"content": "Iiih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470412
					],
					"speakerTitle": "Cucciolo di Iktomisauro"
				},
				{
					"id": 150470412,
					"content": "Iiih! Iiih! Iiih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470413,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470414
					],
					"speakerTitle": "Cucciolo di Iktomisauro"
				},
				{
					"id": 150470414,
					"content": "Hah, come non detto... Beh, ora sappiamo che non parla il koholasaurese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470415
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470415,
					"content": "Perché invece non...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470416
					]
				},
				{
					"id": 150470416,
					"content": "Oh, ecco un'altra idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470417
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470417,
					"content": "Ovvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470418,
					"content": "Una volta, ho sentito Ifa dire che gli Iktomisauri vanno pazzi per i Cornofunghi luminosi, e indovinate un po' cosa ho qui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470419
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470419,
					"content": "Forse ci siamo! Dopo che avrà finito di mangiare, saremo sulla stessa lunghezza d'onda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470420
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470420,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470421
					],
					"speakerTitle": "Cucciolo di Iktomisauro"
				},
				{
					"id": 150470421,
					"content": "Quando si parte per un viaggio lungo, bisogna sempre portarsi dietro il più possibile. Kachina ha avuto proprio una bella pensata. Dovrò ricordarmi di ringraziarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470422
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470422,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470423
					],
					"speakerTitle": "Cucciolo di Iktomisauro"
				},
				{
					"id": 150470423,
					"content": "Ehm, qualunque cosa fosse quella, non sembrava la lunghezza d'onda di Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470424,
					"content": "Che disastro... Siamo al primo giorno e il mio sogno di superare tutte le sfide della Baia Ondosa è già andato in frantumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470425
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470425,
					"content": "#Grande {F#eroina}{M#eroe} {NICKNAME}, hai qualche idea...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470426,
						150470427
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470426,
					"content": "Beh, c'è sempre un'opzione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				},
				{
					"id": 150470428,
					"content": "#Ok, facciamo così. Ti ringrazio, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470427,
					"content": "Posso andare a chiamare un altro Iktomisauro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				}
			]
		},
