					"Mualani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150470501,
					"content": "(Ritorni dopo aver preso possesso di un Iktomisauro nelle vicinanze...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150470502
					]
				},
				{
					"id": 150470502,
					"content": "Mualani, ecco qua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470503,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#Oh, ciao! Uuuh, ma che carino che sei! Aspetta, e {NICKNAME} dov'è {F#andata}{M#andato}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470505
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470505,
					"content": "#Oh... Ehm, {F#le}{M#gli} è venuto mal di pancia quindi... è {F#dovuta}{M#dovuto} correre in bagno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470506,
					"content": "(Paimon, non potevi inventarti una scusa migliore? Beh, l'importante è che Mualani se la beva...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470507
					]
				},
				{
					"id": 150470507,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "Acciderboli, sei proprio amichevole, tu! Ti va un Cornofungo luminoso? Ecco, prendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470509,
					"content": "(Ha un sapore interessante, in effetti. È corposo, succulento... Inaspettato, per essere un fungo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470510
					]
				},
				{
					"id": 150470510,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470511
					]
				},
				{
					"id": 150470511,
					"content": "Ahah, sono contenta che ti piaccia! Tieni, sono tutti tuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470512
					],
					"speakerTitle": "Mualani"
				},
