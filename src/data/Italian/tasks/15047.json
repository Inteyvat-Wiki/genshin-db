				]
			},
			"dialogs": [
				{
					"id": 150470101,
					"content": "Eccovi qua! Il personale sembra essersi allontanato per un po', ma credo di aver capito come farci un giro... Ahem, per collaudarla, s'intende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470102,
					"content": "Fantastico, allora mostraci come si fa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470103,
					"content": "In sostanza, una persona sale a bordo della barca mentre l'altra manda dei segnali al personale saurico. L'obiettivo consiste nel lavorare di squadra e guidare con successo la barca fino a destinazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470104,
					"content": "#Quindi sono piuttosto sicura che possiamo farcela: quando si tratta di collaborare, io e {NICKNAME} siamo imbattibili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470105,
					"content": "Ah, sì? Beh, non fare tanto la spaccona, o rischi di ribaltarti con tutta la barca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470106,
					"content": "Ehi, Paimon, non fare l'uccello del malaugurio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470107,
					"content": "Sì, sì, ok. Allora Paimon ti augura... buona navigazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470108,
					"content": "Eheh, questo è scontato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470109,
					"content": "A dire il vero, sono piuttosto in vena di stare a bordo della barca. Sono abituata ad affrontare le sfide di surf più toste, sarà divertente cambiare un po' il ritmo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470110,
					"content": "#Anch'io sono un po' {F#stufa}{M#stufo} di usare il Cavalcaonde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "Vedi, siamo già in perfetta sintonia! È la prova del nostro legame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470113,
					"content": "Ora corro a indossare il mio costume gonfiabile e salgo subito sulla barca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470111,
					"content": "Allora io mi occuperò dei segnali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
		{
