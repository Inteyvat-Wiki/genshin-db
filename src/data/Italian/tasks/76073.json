			"trigger": {
				"objectNames": [
					"Netochka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760034015,
					"content": "La cucina di Katya è fantastica... Novokitezhgrad può aspettare ancora un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034016,
						760034002,
						760034011
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034016,
					"content": "Netochka, ci incontriamo di nuovo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034017
					]
				},
				{
					"id": 760034017,
					"content": "Ah! Sei qui per il nostro duello? Q-Questo è un attacco a sorpresa! Se dobbiamo farlo, almeno fissiamo una data e un luogo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034018
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034018,
					"content": "Mi piacerebbe trascorrere altro tempo di qualità qui. Non ho nemmeno avuto l'opportunità di esplorare bene Nasha... Che ne dici di rimandare il duello a più tardi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034002,
					"content": "A proposito di Novokitezhgrad...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034003
					]
				},
				{
					"id": 760034003,
					"content": "Mi sentivo soffocare quando vivevo lì, ma ora che me ne sono andata, mi manca... È la prima volta che sono così lontana da casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034004
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034004,
					"content": "Pensavo che ci fossero molte fate anche in altri luoghi, come a casa mia. Persino a Snezhnograd ce ne sono un bel po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034005
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034005,
					"content": "Ma poi sono finita a Nod-Krai e non ne ho vista nemmeno una. Anche Paimon ha detto di non essere una fata. Mmh... Non avrà mica a che fare con il clima di qui, vero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034013
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034013,
					"content": "#Qui non ci sono tempeste di neve e non rimarrai {F#bloccata}{M#bloccato} qui fuori senza una stufa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034014
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034014,
					"content": "Oh, ho persino visto qualcuno bere liquore di Novokitezhgrad a Nod-Krai. Siamo famosi per la nostra industria degli alcolici tanto quanto per quella mineraria, ma comunque, vedere cose di casa mi rende... nostalgico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034011,
					"content": "Ci vediamo in giro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034012
					]
				},
				{
					"id": 760034012,
					"content": "Sì! Fino ad allora, buona fortuna a entrambi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				}
			]
		},
