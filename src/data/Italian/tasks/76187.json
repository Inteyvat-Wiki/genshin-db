			"dialogs": [
				{
					"id": 761870301,
					"content": "Mademoiselle Sandrone, a nome di Mademoiselle Mamère, la prego di accettare la mia gratitudine per il suo gentile invito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870302
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870302,
					"content": "Mh-mh, questo cibo è ottimo. Grazie, Sandrone, le tue abilità culinarie sono straordinarie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870303
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870303,
					"content": "Contenta che ti piaccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870304
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761870304,
					"content": "Prototipo 4ACV07, credo che questa sia la prima volta che c'incontriamo, dico bene? Come hai fatto a riconoscermi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870305
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761870305,
					"content": "Woah, è la prima volta che sento qualcuno chiamare Seymour in quel modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870306
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870306,
					"content": "Affermativo. Sebbene io conosca la sua gentilezza e il suo splendore, Mademoiselle Sandrone, non l'avevo mai vista di persona prima d'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870307,
					"content": "Sono in grado di riconoscerla perché il suo aspetto corrisponde a quello della mia padrona, Mademoiselle Mary-Ann Guillotin, che è registrato in modo permanente nella mia unità di memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870308
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870308,
					"content": "Mademoiselle Mary-Ann mi ha parlato di lei. Poiché il suo aspetto corrisponde a quello della mia padrona, il ragionamento logico necessario per riconoscerla è piuttosto semplice, Mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870309
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870309,
					"content": "Hah, persino le prime creazioni di Alain sono fuori dal comune. Anche se tu sembri aver ricevuto qualche miglioramento... Suppongo che ora debba chiamarti Seymour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870310
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761870310,
					"content": "Eri confuso quando mi hai visto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870311
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761870311,
					"content": "Negativo. Il mio comando primario è accompagnare e proteggere Mademoiselle Mary-Ann a nome di Alain Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870312,
					"content": "Pertanto, la mia conoscenza di Mademoiselle Mary-Ann è completa. Basandomi su un'analisi logica degli spazi vettoriali finiti, lei e Mademoiselle Mary-Ann siete totalmente differenti, Mademoiselle Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870313
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870313,
					"content": "Come la differenza che intercorre tra le foglie di tè della Vallata Chenyu e i Bulle della Regione di Béryl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870314,
					"content": "Sandrone è il tè o il Bulle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870315
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870315,
					"content": "Ricerca... Dati insufficienti. Impossibile rispondere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870316
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870316,
					"content": "(*sospira* Sono contenta che Alain abbia migliorato la struttura del suo modulo linguistico, quando ha creato me.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
