			"dialogs": [
				{
					"id": 761870401,
					"content": "Eheheh... Questo cibo è squisito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870402,
						761870403
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870402,
					"content": "(Restiamo seduti così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761870404,
					"content": "Eh?! Così presto? Grazie, Sandrone! Spero di rivederti la prossima volta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mamère"
				},
				{
					"id": 761870403,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870404
					],
					"speakerTitle": "La Marionetta"
				}
			]
