			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "Qualcuno ha già cucinato qui. Magari per presentare delle offerte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090202,
					"content": "Vediamo un po'... Se non sbaglio, non hanno finito tutti gli ingredienti... Abbiamo delle bocche di leone, dei frutti di loto, del tofu... Sembra una ricetta complicata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090203,
					"content": "Ehi, guarda... Ci sono degli appunti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090204,
					"content": "Quanti passaggi... Paimon ci crede che hanno preso appunti, quante cose da ricordare... Leggiamo con attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100903",
							"2"
						],
						"stepId": 100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "Ma... il pavimento è coperto di farina! Che cuoco pasticcione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090302,
					"content": "Mmm... Quella nella pentola sembra carne, ma Paimon non sa di che tipo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090303,
					"content": "Secondo te questo piatto lo hanno cucinato per un'offerta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090304,
					"content": "Mmm... A Paimon non viene in mente che piatto si possa preparare con carne e farina per un'offerta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090305,
					"content": "Eh? Il cuoco pasticcione si è fatto cadere un pezzo di carta... Bleah, a terra c'è anche un'impronta enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090306,
					"content": "Lasciamo stare l'impronta... Magari ha a che fare con il piatto misterioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100904",
							"2"
						],
						"stepId": 100904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "Qui è pulitissimo. Chi ha cucinato è un amante dell'ordine e della pulizia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090402,
					"content": "Paimon scommette che qui hanno preparato un'offerta per gli Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090403,
					"content": "Questi sembrano matsutake e carne cruda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090404,
					"content": "E guarda un po'... La ricetta è proprio qui. Che persona organizzata questo chef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100913,
