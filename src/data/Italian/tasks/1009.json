		{
			"id": 100914,
			"completionStepIds": [
				100914
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100914",
							"2"
						],
						"stepId": 100914,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vestale delle nuvole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "Costei è davvero colpita! Il cammino che attraversa questa dimora mette a dura prova coloro che sono privi di abilità speciali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091402,
					"content": "Vi trovate al cospetto dell'Adepta Vestale delle nuvole. Cosa vi conduce in questo loco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091403,
					"content": "Tutto questo è stato costruito da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "Me. La tua supposizione è corretta. È stata costei a creare questo posto e i meccanismi che operano al suo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091407,
					"content": "Gli stessi Guizhong e Rex Lapis hanno ritenuto le soluzioni tecnologiche di costei degne di encomio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091408,
					"content": "Che posto enorme! E pieno zeppo di meccanismi... Davvero qui vivi solo tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091409,
					"content": "Ma è uno spreco! Cos'è? Il tuo laboratorio privato o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091410,
					"content": "Proprio come dicono i libri!!! Gli Adepti lasciano il mondo degli umani, si ritirano in solitudine e poi se ne escono con queste invenzioni pazzesche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091411,
					"content": "Costei non ha alcuna inclinazione per le cerimonie della socialità, e preferisce godere di tranquillità e pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091412,
					"content": "Che regnavano entrambe... prima che arrivaste voi esibendo il Sigillo del consenso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091413,
					"content": "Bando ai convenevoli! Ora dite a costei cosa vi porta qui! Non perseverate nel turbare futilmente la sua quiete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091414,
					"content": "Rex Lapis... ucciso?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091415,
					"content": "Com'è possibile? Un atto così scellerato... Chi lo commetterebbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091416,
					"content": "Una notizia tanto assurda da risultare inconcepibile... Costei dovrà verificare di persona sulla faccenda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091417,
					"content": "Forse sarà prima necessario reprimere Liyue... e solo dopo riunire gli Adepti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091418,
					"content": "Prego?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "Ehi, c-cosa? Vorresti attaccare il Porto di Liyue? Vuoi davvero spazzare via l'intera città?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091420,
					"content": "Solo una risposta proporzionata all'affronto può prevenire altri incidenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091421,
					"content": "Ma gli Adepti hanno giurato di difendere la città...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "È come asserisci. Sotto la guida di Rex Lapis proteggiamo il Porto di Liyue da trentasette secoli. Ma di fronte a un simile oltraggio... occorrerà intraprendere azioni straordinarie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091425,
					"content": "Proprio perché costei non vuole sopportare ulteriori sofferenze, occorrono misure drastiche adatte a momenti straordinari come questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091426,
					"content": "Aaah! Presto, dobbiamo farci venire un'idea! Vuole radere al suolo Liyue... E non mi pare che stia scherzando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091427,
					"content": "Avendo accettato la nostra offerta, adesso ci lega un contratto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "Stava per dirlo anche Paimon! Abbiamo cucinato piatti deliziosi e te ne abbiamo offerto fino all'ultima briciola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091429,
					"content": "Speravamo che aiutassi Liyue... non che la annientassi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091430,
					"content": "O almeno... dai, parliamone prima! Che ne dici, non ti farebbe comodo una seconda opinione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091431,
					"content": "Un contratto, eh...? Una parola che adesso suona ironica, dopo la spietata uccisione del Dio dei Contratti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091432,
					"content": "La gente di Liyue sarà ben lieta di rinunciare ai vincoli contrattuali. Loro preferiscono prendere quel che è scritto nero su bianco e farlo sbiadire... renderlo grigio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091433,
					"content": "Considerando però che vi presentate al cospetto di costei invocando un vincolo contrattuale, lungi da me la volontà di venir meno ai miei obblighi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091434,
					"content": "Soprattutto considerando che recate con voi un Sigillo del consenso... *sospira* In origine, Rex Lapis li infuse del potere degli Adepti. Un potere che un tempo supportava il genere umano in battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091435,
					"content": "Nel tempo, quel potere è svanito... non lasciando altro che meri cimeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091436,
					"content": "Dei cimeli che non garantiscono la vostra affidabilità né la veridicità delle vostre parole, che costei preferisce verificare per proprio conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091437,
					"content": "Questa dev'essere la vera ragione per la quale Scultore della luna ci ha evocati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091438,
					"content": "La vostra udienza con l'Adeptus si conclude qui. Andatevene e non arrecatemi ulteriore disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091423,
					"content": "Quella gente non è sotto la protezione degli Adepti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "Hai ragione. Ma se Rex Lapis è davvero stato ucciso, allora Liyue è in grave pericolo. Procrastinare la repressione apre lo spazio a nuove tragedie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Vestale delle nuvole"
				},
				{
					"id": 10091405,
					"content": "Quindi anche la progettazione dei meccanismi...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "La tua supposizione è corretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Vestale delle nuvole"
				}
			]
		},
		{
