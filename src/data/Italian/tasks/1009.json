				"points": []
			},
			"dialogs": [
				{
					"id": 10091501,
					"content": "Ehi, chi ha messo qui un tavolo? È pure apparecchiato, con tanto di caraffa di vino e tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091502,
					"content": "Oooh, ci sono addirittura i segnaposti... con i nomi incisi sulle sedie! \"Posto di Vestale...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091510,
					"content": "\"Posto di Guizhong\"... \"Posto di Rex\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091503,
					"content": "Che Rex stia per Rex Lapis?!? Però Paimon questo Guizhong proprio non lo conosce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091504,
					"content": "Ah, e quella \"Vestale\"... So chi è! Quando Scultore della luna ha elencato i nomi dei suoi amici Adepti, tra loro c'era una certa Vestale delle nuvole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091505,
					"content": "Ma allora è qui che Vestale delle nuvole e gli altri Adepti organizzano le loro feste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091506,
					"content": "Eheh, che ne dici di preparare qualche pietanza speciale per loro? Così Vestale delle nuvole ci noterà di sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091507,
					"content": "Ma... cos'è che mangiano gli Adepti? Paimon non lo sa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091508,
					"content": "Mmm... Questo è un posto dove la gente presenta offerte agli Adepti. I resti di cibo potrebbero metterci sulla strada giusta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091509,
					"content": "Mm... Pensi che agli Adepti potrebbe piacere un po' di... arrosto al miele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
