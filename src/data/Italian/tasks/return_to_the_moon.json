			"dialogs": [
				{
					"id": 60280301,
					"content": "Tutto bene? Le tue ferite fanno ancora male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280302,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280303
					]
				},
				{
					"id": 60280303,
					"content": "Ho fatto preparare una medicina che potrebbe rivelarsi efficace. Prendila se ne hai bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280304,
						60280305
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280304,
					"content": "Grazie...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280306
					]
				},
				{
					"id": 60280306,
					"content": "In tal caso, permettetemi di riferire il contenuto della nostra chiamata ad Alice dopo l'incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280307
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280307,
					"content": "Quel Dottore è davvero astuto... Ha distratto l'Hexenzirkel creando un gran trambusto ai confini di Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280308
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280308,
					"content": "Pensavo che la causa fosse un'intrusione dell'Abisso dal mondo esterno, il che, a dire il vero, è un evento piuttosto comune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280309
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280309,
					"content": "Ma dopo aver saputo che siete riusciti a influenzare gli spettri a Nod-Krai, mi sono resa conto che forse questa interferenza proviene da dentro Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280310
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280310,
					"content": "Ma non siamo riusciti a cambiare i loro destini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280311
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280311,
					"content": "È vero, non avete potuto cambiare il finale delle loro storie. Ma avete creato delle \"variabili\" attorno a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280312
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280312,
					"content": "Variabili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280313
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280313,
					"content": "Sì: cose che avete sentito e che altrimenti non avreste potuto imparare, idee che altrimenti non vi sarebbero mai venute in mente... Sono tutte delle \"variabili\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280314
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280314,
					"content": "Naturalmente, la maggior parte delle variabili di solito rimangono insignificanti di fronte alla miriade di possibilità che esistono. Ma nel momento in cui inizi a trattarle come dei mattoncini e a metterli l'uno sopra l'altro, tutto cambia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280315
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280315,
					"content": "Questo è ciò che ha fatto Dottore, ed è così che ha creato le condizioni necessarie affinché, quando stasera avreste attivato il portale, tutto giocasse a suo favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280316
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280316,
					"content": "Tuttavia, non abbiamo modo di sapere esattamente cos'abbia fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 60280317,
					"content": "Sì. Dobbiamo anche accertarci dello stato di Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280318
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280318,
					"content": "E questo è quanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280319
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280319,
					"content": "Come sospettavo, Dottore è scomparso completamente. Se può consolarvi, non è riuscito a controllare Colombina come avrebbe voluto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280320
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280320,
					"content": "Temo sia una magra consolazione, data la situazione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280321
					]
				},
				{
					"id": 60280321,
					"content": "Oh, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280322,
						60280323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280322,
					"content": "Per sventare il piano del Luminare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280324,
					"content": "Eh? Cos'ha fatto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280325,
					"content": "Aspettate, nessuno di voi l'ha visto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280326
					]
				},
				{
					"id": 60280326,
					"content": "Abbiamo solo visto Dottore apparire e usare una specie di potere... E in men che non si dica, lui e Colombina sono spariti, mentre tu stavi cadendo in mare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280327,
					"content": "(Capisco... il Luminare ha congelato il tempo, ecco perché solo io potevo muovermi liberamente.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280328
					]
				},
				{
					"id": 60280328,
					"content": "(Dal loro punto di vista, la battaglia e la decisione di Colombina sono avvenute in un istante.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280329
					]
				},
				{
					"id": 60280329,
					"content": "#Quindi questo è il potere delle tre lune? Ma perché non ne sono {F#stata influenzata}{M#stato influenzato}? È perché sono {F#una}{M#un} Discendente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280330
					]
				},
				{
					"id": 60280330,
					"content": "Quindi, Colombina ha aperto di proposito la Porta della luna ed è fuggita nello stesso misterioso mondo di Rerir e Tholindis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280331
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280331,
					"content": "Non promette nulla di buono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280332
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280332,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280333,
						60280334
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280333,
					"content": "Dev'essere per questo motivo che Dottore è rimasto in disparte per tutto questo tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280335,
					"content": "Vista in quest'ottica, l'Allineamento trilunare e la comparsa di Rerir... Forse è stato Dottore a muovere i fili in entrambi i casi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280336
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280336,
					"content": "Secondo la signorina Alice, sta tentando di trascendere il suo destino e di portare a termine un esperimento che solo una divinità potrebbe completare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280337
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280337,
					"content": "...Un folle totale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280338
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280338,
					"content": "Un attimo, dov'è Cappellotto? Gli interesserebbe sentire queste cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280339,
					"content": "Dopo aver parlato con Alice, ha detto che forse aveva un'idea di cosa cercare, così ha preso il Dodocomunicatore ed è andato a indagare da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280340
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280340,
					"content": "L'espressione sul suo volto era terrificante... Non l'avevo mai visto così prima d'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280341
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280341,
					"content": "(Probabilmente prova rabbia e frustrazione per il fatto che Dottore fosse sempre un passo avanti, malgrado i suoi sforzi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280342
					]
				},
				{
					"id": 60280342,
					"content": "(E, a dire il vero, provo la stessa cosa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280343
					]
				},
				{
					"id": 60280343,
					"content": "Sono tornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280344
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280344,
					"content": "Cappellotto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280345
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280345,
					"content": "Sono andato di nuovo a cercare i fantasmi d'Iperborea. Credo di esserne venuto a capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280346
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280346,
					"content": "Sono riuscito a farli parlare con Nicole, che era dall'altro lato della linea. A quanto pare, la storia che descrivono è diversa da come la ricorda Nicole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280347
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280347,
					"content": "Davvero? Ma come? Nicole di certo non può essersi sbagliata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280348,
					"content": "Perché sono i fantasmi a essere stati ingannati. Parlano di un \"salvatore\" apparso nella loro storia, uno che non avrebbe mai dovuto esistere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280349
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280349,
					"content": "Questo salvatore promise di creare un novilunio nel cielo falso, e persino di riportare in vita le loro Dee della Luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280350
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280350,
					"content": "Come degli stolti, gli credettero e gli rivelarono tutto ciò che voleva sapere sulle lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280351
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280351,
					"content": "È ovvio che è stato Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280352
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280352,
					"content": "Ora che lo dici... La prima volta che siamo entrati nelle rovine d'Iperborea, abbiamo sentito i fantasmi discutere della loro storia, e ricordo che Nicole commentò che qualcosa sembrava un po' strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280353
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280353,
					"content": "Ma Dottore non avrebbe proprio dovuto riuscire a entrare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280354,
					"content": "Non c'è riuscito. Nicole ha detto che si trattava di uno stato anomalo innescato da interruzioni nelle connessioni causali tra i fantasmi della stessa epoca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280355
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280355,
					"content": "Le \"variabili\" che Dottore aveva introdotto erano abbastanza consistenti da influenzare persino gli spettri che non aveva mai incontrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280356
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280356,
					"content": "Quindi non è che i loro ricordi fossero confusi... erano stati manipolati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280357
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280357,
					"content": "Era proprio la possibilità che Dottore stava cercando di creare. Ha trasformato queste variabili in conoscenza e ha architettato la situazione affinché tutta quella conoscenza cadesse nelle sue mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280358
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280358,
					"content": "Poi, ha sfruttato quella conoscenza durante la Notte di Preghiera lunare... per creare davvero una \"luna falsa\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280359
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280359,
					"content": "Ma com'è possibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280360,
					"content": "Per essere precisi, ha sfruttato un punto debole nel funzionamento dell'incantesimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280361
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280361,
					"content": "L'incantesimo percepisce il Kuuvahki per rilevare la posizione della luna. Quindi, finché la \"falsa luna\" assomigliava più a una luna della Luna gelata oltre i cieli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280362
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280362,
					"content": "Quel portale avrebbe teletrasportato Colombina nella posizione della luna falsa... in altre parole, al fianco di Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280363
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280363,
					"content": "Una volta che l'ebbe sotto controllo, l'incantesimo di teletrasporto rimase attivo, e manipolò il suo potere per impadronirsi di entrambi i Midolli lunari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280364
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280364,
					"content": "In quel momento, i Midolli lunari scomparvero proprio davanti ai nostri occhi... Era già troppo tardi, nonostante stessimo lasciando le rovine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280365
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280365,
					"content": "Ormai, Dottore aveva già accumulato il potere di tutte e tre le lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280366
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280366,
					"content": "Dunque... E adesso? Che facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280367
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280367,
					"content": "Vorrei proprio sapere cosa ne pensa Sua Maestà, ora che le preoccupazioni che le avevo espresso si sono avverate. Ma non possiamo nemmeno stare ad aspettare che sia lei a decidere cosa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280368
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280368,
					"content": "E in ogni caso, non è la Messaggera dei Fatui, la \"Damigella\", a vederci come suoi amici, bensì Colombina Iposelenia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280369
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280369,
					"content": "Se, anche in circostanze così estreme, Sua Maestà non revocherà il divieto ai Messaggeri di sguainare le proprie armi l'uno contro l'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280370
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280370,
					"content": "Allora farò come il mio cuore comanda. Combatterò come Peruere, piuttosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280371
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280371,
					"content": "Arlecchino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280372,
					"content": "Il tempo stringe, quindi sarò io a fare la prima mossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280373
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280373,
					"content": "Mamma mia, a quanto pare anche Arlecchino sta perdendo la calma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280374,
					"content": "#(Sono {F#sicura}{M#sicuro} che si senta in parte responsabile di tutto ciò... Così come me...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280375
					]
				},
				{
					"id": 60280375,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280376
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280376,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280377
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280377,
					"content": "Va bene, va bene. Smettetela di fare quelle facce avvilite per un attimo, e lasciatemi dire due parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280378
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280378,
					"content": "La situazione sembra essere grave, onestamente. Molto grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280379
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280379,
					"content": "Dottore ha usato dei mezzi davvero subdoli per avere la meglio... per ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280380
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280380,
					"content": "E sì, siamo arrivati al punto in cui persino le maghe dicono che le sue \"variabili\" hanno influenzato il destino. Non ne sono così sicuro, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280381
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280381,
					"content": "Molti mi hanno detto che il destino di Teyvat è immutabile, e in effetti sembra essere così. Ma, allora, cosa rende Dottore così sicuro di essere un'eccezione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280382
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280382,
					"content": "E dato che è riuscito ad accumulare queste \"variabili\", chi può dire che non possiamo fare lo stesso anche noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280383
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280383,
					"content": "#Proprio tu, {F#viaggiatrice venuta}{M#viaggiatore venuto} da lontano, non dovresti scoraggiarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280384
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280384,
					"content": "Non è ancora finita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280385,
						60280386
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280385,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280387,
					"content": "#E non sei l'{F#unica}{M#unico}. Tutti qui lo fanno, che ne abbiano parlato finora o meno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280388
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280388,
					"content": "Ma nessuno di noi è il tipo da starsene con le mani in mano ad aspettare che il sole torni a splendere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280389
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280389,
					"content": "#È proprio così che dovrebbe agire un cavaliere: quando si viene buttati giù, ci si rialza e si torna in campo. Non dimenticare, {F#Cavaliere Onoraria}{M#Cavaliere Onorario}, anche tu sei un membro a pieno titolo di Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280390
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280390,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280391
					]
				},
				{
					"id": 60280391,
					"content": "Varka ha ragione! Non è affatto finita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280392
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280392,
					"content": "Dottore si merita un bel calcio nel sedere già da tempo, visto quello che ha combinato in passato. E dopo questo, se n'è guadagnato il doppio di calci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280393
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280393,
					"content": "Proprio così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280394
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280394,
					"content": "E voi altri, cosa ne pensate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280395
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280395,
					"content": "Userò il Kuuvahki per indagare sulla posizione di Colombina. Neanch'io sono disposta ad arrendermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280396
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280396,
					"content": "Lasciate a me la raccolta di informazioni. Qualsiasi cosa accada entro i confini di Nod-Krai, quando noi del Consiglio dei segreti vogliamo sapere qualcosa, troviamo sempre un modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280397
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280397,
					"content": "Aino e io faremo tutto il possibile per supportarvi. Tenteremo di ripercorrere le azioni di Dottore e cercheremo di fare progressi in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280398
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60280398,
					"content": "Alice e Nicole sono impegnate con un'emergenza ai confini di Teyvat, quindi non possono tornare per il momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280399
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280399,
					"content": "Ma sono entrambe molto arrabbiate per questo. Hanno chiesto ad Albedo e a me di agire per conto dell'Hexenzirkel e di fare tutto ciò che è in nostro potere per contrastare Dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280401
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280401,
					"content": "Sei pronto, allora? Dovremo condurre molte ricerche, sin dall'inizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280402,
					"content": "Farò del mio meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280403
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280403,
					"content": "Per quanto mi riguarda, conosco piuttosto bene il modus operandi di Dottore, quindi posso provare a prevedere la sua prossima mossa. Vi aiuterò con le indagini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280404
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280404,
					"content": "Bene. Sembra che ognuno abbia un incarico da svolgere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280405
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280405,
					"content": "Mi metterò in contatto con Flins e Illuga, affinché parlino con il loro Starsina. Non guasterebbe coinvolgere anche i Guardaluce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280406
