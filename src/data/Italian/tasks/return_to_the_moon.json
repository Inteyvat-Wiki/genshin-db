			"dialogs": [
				{
					"id": 60280201,
					"content": "Qui... Qui è dove il popolo di Iperborea comunicava con le lune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280202,
					"content": "La Luna eterna, la Luna gelata, la Luna iridescente... Quando il potere di tutte e tre converge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280203,
					"content": "Il portale verso le lune si aprirà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280204,
					"content": "Mmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280205,
					"content": "I Midolli lunari sono in posizione. Rimane solo l'ultimo passo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280206,
					"content": "...Sono sicura che Nasha sia più vivace che mai in questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280207,
					"content": "Già... È un peccato che tu non abbia potuto esserci. Ma ora o mai più, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280208,
					"content": "Va bene così. Questo è più che sufficiente... il mio ultimo bagaglio... il mio unico bagaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280210,
					"content": "Sento già la luna che mi chiama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280212,
					"content": "Questo raggio di luce ti guiderà a casa, Colombina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "La Fantesca"
				},
				{
					"id": 60280213,
					"content": "D'ora in poi, avremo finalmente un motivo per pregare la vera luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280214,
					"content": "Colombina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "Sì. Dimmi pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280216,
					"content": "Torna a trovarci quando ne avrai l'occasione!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "Ahah... Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280218,
					"content": "Ma se quell'occasione non dovesse presentarsi... Ricordati che hai degli amici su questo pianeta, delle persone a cui mancherà \"Colombina\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "Sì, lo farò. Grazie per tutto quello che avete fatto per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280220,
					"content": "E ricordate... Che sia notte o giorno, la luce della luna ci unirà sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60280221,
					"content": "#Ebbene... Addio, {F#amiche mie}{M#amici miei}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				}
			]
		},
