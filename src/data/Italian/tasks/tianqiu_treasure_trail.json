			"dialogs": [
				{
					"id": 718120201,
					"content": "Allora, hai trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120202,
					"content": "Sì, ecco qua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120203
					]
				},
				{
					"id": 718120203,
					"content": "Che cos'è...? Non ho mai visto niente del genere... Dove si trovava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120205,
					"content": "Vicino alle Rovine di Dunyu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "Le Rovine di Dunyu? Cosa ci faceva un oggetto simile laggiù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120207,
					"content": "Grazie per avere risolto questa faccenda. Come da regola del codice degli avventurieri, il bottino è tutto tuo. E lo stesso vale per la ricompensa, naturalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120208,
					"content": "Manderò qualcuno alle Rovine di Dunyu per effettuare una ricerca più approfondita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 718120209,
					"content": "Che strano... Le Rovine di Dunyu sono state setacciate una marea di volte... Come ha fatto quella cosa a sfuggirci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
