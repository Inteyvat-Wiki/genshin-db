			},
			"dialogs": [
				{
					"id": 150080301,
					"content": "Questi Koholasauri sembrano sicuramente all'erta. Non riusciremo mai a passare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080302,
					"content": "Dato che hai già usato le informazioni fornite dalla mappa per dedurre che l'indizio si trova in quella valle, perché non provi a scacciarli? Sei piuttosto forte, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080303
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080303,
					"content": "Innanzitutto, gli anziani della tribù ci hanno sempre raccomandato di non fare del male ai Koholasauri: porterebbe quasi sicuramente sfortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080304
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080304,
					"content": "In secondo luogo, non puoi semplicemente presentarti di punto in bianco e rovinare il loro raduno, figuriamoci mandarli via! Sarebbe terribile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080305
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080305,
					"content": "Ma su quale base...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080306
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080306,
					"content": "Ok, magari possiamo pensare a un altro modo per accedere alla valle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080307
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080307,
					"content": "Mmmh, dev'esserci un modo per entrare nella valle senza spaventarli. Trovare una soluzione da sola richiederebbe del tempo, quindi vorrei sentire le idee di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080308
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080308,
					"content": "Fai pensare Paimon... Esiste una deviazione o una strada alternativa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080309,
					"content": "Secondo la mappa, l'indizio è proprio al centro del branco di Koholasauri. Anche se provassimo ad avvicinarci dall'altro lato, c'imbatteremmo nello stesso problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080310
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080310,
					"content": "Mmh, che pasticcio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080311,
					"content": "Karya, ho notato che parli solo quando cerchi di rendere le cose più facili tra Viramdra e gli altri. Avrai sicuramente delle idee anche tu, perché non le condividi con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080312
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080312,
					"content": "Io? Va bene... Quando Viramdra ha deciso di cercare indizi sui Koholasauri, ho fatto anch'io delle ricerche su queste creature.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080313
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080313,
					"content": "Ho scoperto qualcosa di molto interessante... Pensavamo che i Koholasauri facessero affidamento sull'udito per rintracciare la propria preda, ma in realtà anche il loro senso dell'olfatto è molto sviluppato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080314
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080314,
					"content": "Non so quanto possa esserci utile questa informazione...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080315
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080315,
					"content": "Oh... Oh! In effetti ci è molto utile, signorina Karya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080316
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080316,
					"content": "Chiamami semplicemente Karya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080317
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080317,
					"content": "#In tal caso, per favore rimanete qui a tenere d'occhio i bagagli. {NICKNAME} e Paimon, venite con me. Ho un'idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
