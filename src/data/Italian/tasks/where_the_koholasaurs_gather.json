			"dialogs": [
				{
					"id": 150080201,
					"content": "Wow, qui ci sono un sacco di Koholasauri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080202,
					"content": "Come previsto, il primo indizio è legato ai Koholasauri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080203
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080203,
					"content": "Quando le persone esterne alla tribù ottengono una copia della mappa, molte di loro intuiscono che il primo indizio sia legato ai Koholasauri, ma spesso finiscono per guardare nella direzione sbagliata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080204
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080204,
					"content": "Quando il primo capo creò la mappa, lasciò un segno speciale. Si tratta di un codice usato dalla tribù per indicarne un branco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080205
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080205,
					"content": "Quindi non basterà trovare un paio di Koholasauri selvaggi per trovare un indizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080206
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080206,
					"content": "Sei una vera esperta di queste cose, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080207,
					"content": "Ma, stando alle informazioni che sono riuscito a trovare, ai Koholasauri non piace radunarsi in branco, a meno che non vogliano competere per le sorgenti termali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080208
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080208,
					"content": "Lascia che ti riveli un segreto noto solo a una guida del Popolo delle Sorgenti: di tanto in tanto, i Koholasauri selvaggi si radunano nella valle più avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080209
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080209,
					"content": "È quasi come quando la nostra tribù si riunisce per le feste. Anche se, col cambio di stagione, il gregge fa presto a disperdersi di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080210
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080210,
					"content": "A meno che tu non sia una guida che gira sempre per Natlan, assistere a questo fenomeno è piuttosto raro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080211
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080211,
					"content": "Davvero?! Devo subito prendere appunti e includere una spiegazione nella mia tesi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080212
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080212,
					"content": "Secondo quello che sono riuscita a decifrare sulla mappa, un indizio è nascosto nelle profondità di quella valle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080213
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080213,
					"content": "Questo significa che dovremo passare attraverso il branco di Koholasauri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080214,
					"content": "Mmmh, dovremo trovare un modo per passare senza farci notare. Si stanno radunando con i loro amici, quindi sicuramente non vogliono essere disturbati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080215
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080215,
					"content": "Vuoi dire che dovremo camminare nel bel mezzo di un branco di Koholasauri? Sembra un pochino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080216
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080216,
					"content": "Ehm... Dato che abbiamo concordato di lavorare insieme, ognuno dovrebbe fare la sua parte. Tuttavia, in passato Karya è stata attaccata dai Koholasauri, quindi questo non è un piano ideale per lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080217
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080217,
					"content": "Ma non dovrebbe essere un problema per me! Lasciamo che Karya aspetti qui, e io mi occuperò di tutti gli incarichi che avrebbe dovuto svolgere lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080218
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080218,
					"content": "Eheh, non preoccuparti. Non dobbiamo andare tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080219
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080219,
					"content": "#A dire il vero, qualcuno dovrà rimanere qui a controllare i bagagli, e potrete farlo voi due. {NICKNAME} e Paimon, venite con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080220
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080220,
					"content": "Davvero? Allora è perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080221
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080221,
					"content": "Ora capisco quanto t'importi della tua assistente accademica.",
					"roleType": "TALK_ROLE_NPC",
