			"dialogs": [
				{
					"id": 150080401,
					"content": "Trovata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080402,
					"content": "Cosa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080403,
					"content": "La soluzione per passare attraverso il branco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080404,
					"content": "Se i Koholasauri hanno un olfatto molto sviluppato, anche se provassimo a passare inosservati, si accorgerebbero della nostra presenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080405,
					"content": "Ma questa pianta può aiutarci a risolvere quel problema, perché ha un odore molto simile a quello di un Koholasauro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080406,
					"content": "Possiamo spalmarci addosso l'estratto di questa pianta e ingannare il loro senso dell'olfatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080407,
					"content": "Quindi dovremo... ricoprirci dell'estratto di una pianta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080408,
					"content": "Non temere, fa anche bene alla pelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080409,
					"content": "#Mualani raccoglie un po' di estratto della pianta e lo spalma su {F#tutte e tre}{M#tutti e tre}.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080410
					]
				},
				{
					"id": 150080410,
					"content": "Oh, Paimon si sente tutta viscida... Ma l'odore è proprio quello dei Koholasauri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080411,
					"content": "Perfetto! Ok, proviamo di nuovo a passare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
