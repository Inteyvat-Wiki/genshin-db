			},
			"dialogs": [
				{
					"id": 150080501,
					"content": "Ci stiamo avvicinando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080502,
					"content": "Guardate, alcuni di loro si stanno radunando attorno a quella roccia. Cosa stanno facendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080503,
					"content": "Mmmh... Forse, quando le cose si fanno noiose, si riuniscono per parlare di qualcosa di divertente? Peccato che non si riesca a capire cosa dicano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080504
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080504,
					"content": "Ma Paimon pensava che le guide del Popolo delle Sorgenti fossero in grado di comprendere i Koholasauri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080505,
					"content": "Sembra che qualcuno abbia cercato d'imbrogliarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080506,
					"content": "Vero, stavano sicuramente cercando di imbrogliarci... Eh? Hai visto quella roccia? Sembra ci sia sopra una specie di... disegno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080507,
					"content": "Ho sentito dire che esiste un tipo di muschio che cambia colore quando reagisce ai segnali biologici emessi dai Koholasauri, ma per innescare quel tipo di reazione avremo bisogno di un gran numero di Koholasauri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080508
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080508,
					"content": "Dev'essere questo l'indizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080509,
					"content": "Scattiamo una foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080510,
					"content": "Il flash potrebbe disturbarli. Proverò a copiarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080511
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080511,
					"content": "Mualani copia il disegno sul muschio, quindi fate silenziosamente ritorno da Viramdra e Karya e gli raccontate tutto quello che avete visto e sentito.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080512
					]
				},
				{
					"id": 150080512,
					"content": "Quindi abbiamo superato la prima fase del viaggio, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080513,
					"content": "Capisco... Se avessimo scelto di affrontare i Kohlasauri di petto, non avremmo mai trovato questo indizio... Alla fine, le tue affermazioni avevano effettivamente una base logica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080514
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080514,
					"content": "È sempre stato così, Karya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080515
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080515,
					"content": "È solo ossessionato dalla sua ricerca, tutto qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080516
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080516,
					"content": "Perlomeno, questo fatto ha dimostrato che il mio giudizio è corretto e sono affidabile. Così, la prossima volta non ci sarà bisogno di litigare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080517
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080517,
					"content": "Sì, capisco... E immagino che ci eviterà anche di perdere del tempo prezioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080518
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080518,
					"content": "Mualani è una guida coi fiocchi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080519,
					"content": "È una professionista, dopotutto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150080520
					]
				},
				{
					"id": 150080520,
					"content": "Ora dobbiamo usare l'indizio che abbiamo trovato per scoprire la nostra prossima destinazione. Vediamo un po'... Cosa rappresenta questo disegno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080521,
					"content": "Difficile a dirsi... Paimon non ne ha la più pallida idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080522,
					"content": "Ah-ha! Ho capito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080523
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080523,
					"content": "Sebbene le linee siano un po' indefinite, sembra che rappresentino il confine tra l'acqua e la terra presso la Collina Sbuffo di Giada. Se lo posiziono sopra la parte mancante della mappa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080524
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080524,
					"content": "Ecco la nostra prossima destinazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080525
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080525,
					"content": "Davvero? Hai capito tutto questo da delle linee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080526,
					"content": "Beh, l'intuito è importante per una guida. Forse ho visto talmente tante mappe, che ora mi viene più naturale capire questo genere di cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080527
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080527,
					"content": "La nostra pausa è terminata. Rimettiamoci in viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
