			"dialogs": [
				{
					"id": 701040301,
					"content": "Hai piazzato i sensori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040302,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040303
					]
				},
				{
					"id": 701040303,
					"content": "#Fantastico, sei stat{F#a}{M#o} di grande aiuto. Prendi questi e i miei ringraziamenti, ancora una volta, per tutto quello che hai fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040304,
					"content": "Uff, i sensori sono troppo pochi. Chissà se riuscirò a scoprire qualcosa di interessante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
