			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Esther"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "Hai trovato i miei sensori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040202,
					"content": "Sì, li ho trovati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "Vediamo... Sì, sono proprio questi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040204,
					"content": "Argh, guarda in che condizioni sono... I mostri non sono stati per niente delicati. Per fortuna non li hanno del tutto rovinati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040205,
					"content": "*sospira* Tuttavia, credo che non li userò nell'immediato... Ah, non posso farci niente. Dovrò accontentarmi di un'indagine su scala ridotta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040206,
					"content": "Qui ho degli altri sensori. Potresti posizionarli sulla montagna per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040207,
					"content": "Dove precisamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "È un sì? Lo prendo come un sì! Grazie! Ti segno i punti sulla mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040215,
					"content": "Fatto. Li ho segnati tutti. Posiziona i sensori in quelle aree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040216,
					"content": "Assicurati di posizionarli in punti elevati. Maggiore l'altitudine, più preciso sarà il rilevamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040209,
					"content": "Perché non puoi farlo da sola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "Non oserei... se nemmeno un'intera squadra di esploratori è riuscita a opporsi a quei mostri, certamente non tornerò lassù da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040211,
					"content": "Non riesco a trovare altri esploratori che abbiano intenzione di salire là in cima al momento, ma allo stesso tempo non posso rimandare la cosa all'infinito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040212,
					"content": "#Quindi sei la mia unica possibilità. Visto che sei riuscit{F#a}{M#o} a recuperare i miei sensori senza problemi, credo che tu sia più che all'altezza del compito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040213,
					"content": "Grazie ancora. Ti ricompenserò a dovere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040214,
					"content": "Ecco, ti segno la loro posizione sulla mappa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "Esther"
				}
			]
		},
