			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "Avete trovato i miei strumenti di pittura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060602,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "Proprio come pensavo, li avevo lasciati nel posto che ho usato come riferimento. Per abitudine, tendo a mettere a terra le cose che uso mentre dipingo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060604,
					"content": "Quando vado troppo di fretta, finisco per dimenticarmi qualche pezzo. Grazie mille. Se non fosse stato per voi, sarei dovuto tornare in città a ricomprare tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060605,
					"content": "Continuerai a dipingere qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "Oh, per favore, non voglio più sentirne parlare. Mi avevano detto di queste due statue con gli occhi che si illuminano e che sono visibili da lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060607,
					"content": "Statue giganti con occhi fiammeggianti, che fanno la guardia accanto a una montagna... Sarebbe stato sicuramente un ottimo dipinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060608,
					"content": "E invece, quando sono arrivato qui, le statue c'erano, ma degli occhi brillanti neanche l'ombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060609,
					"content": "Ho pensato di aver perso l'attimo giusto, o che l'angolazione fosse quella sbagliata... e così ho girato in tondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060610,
					"content": "Ma sembra che, dovunque mi ponga, lo scenario non cambi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060611,
					"content": "L'unica cosa che ho ottenuto da questa impresa è questa... L'ho trovato nelle pozze laggiù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060612,
					"content": "Mmmh, ne ho trovato uno anch'io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "Ah sì? Fatemi dare un'occhiata. Wow, ma... sono identici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060614,
					"content": "Strano. Ci sono anche delle parole incise sul retro. Vediamo, cosa dicono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060615,
					"content": "\"Le sentinelle di pietra bloccano il portone da tempo ancestrale, per chiunque non aggiunga un tocco finale\"... Cosa significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060616,
					"content": "Beh, questa pietra mi serve a poco comunque, quindi perché non la prendi tu? Considerala un ringraziamento per avermi aiutato a trovare i miei strumenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060617,
					"content": "In realtà, ho un'idea... È solo un'ipotesi, ma non pensate che queste due rocce assomiglino un po' a degli occhi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060618,
					"content": "Se sono davvero occhi, il \"tocco finale\" potrebbe avere qualcosa a che fare con queste due pietre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060619,
					"content": "Beh, è solo un'ipotesi, quindi non pensateci troppo. Ora vado a cercare altri punti di vista... Grazie ancora per aver trovato i miei strumenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
