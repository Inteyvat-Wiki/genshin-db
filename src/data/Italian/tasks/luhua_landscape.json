					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060803
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060803,
					"content": "Occhi... Quali occhi? Questa statua proprio non ce li ha.",
