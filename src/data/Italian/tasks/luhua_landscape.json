				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "Oh, è terribile. Come farò a dipingere così...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060102,
					"content": "Qualcosa non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "#Tu... Oh, siete voi, viaggiat{F#rice}{M#ore}. Beh, il problema è questo: stavo cercando l'ispirazione intorno al Lago Luhua e volevo dipingere qualcosa da portarmi a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060104,
					"content": "Però non sono riuscito a trovare una buona angolazione e nessuno dei miei dipinti mi soddisfa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060105,
					"content": "Ero così concentrato sul godermi il paesaggio da non accorgermi che la maggior parte dei miei pennelli e colori era sparita fino alla fine del viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060106,
					"content": "Devo averli dimenticati nei posti dove mi sono fermato a dipingere. Potreste aiutarmi a cercarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060107,
					"content": "In che posti ti sei fermato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "Ehm, a dire il vero... non me lo ricordo bene. Ogni volta ero troppo preso dalla pittura per prestare attenzione a ciò che mi circondava, quindi non posso indicarvi una posizione precisa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060109,
					"content": "Ma ho dipinto solo due quadri in quest'area, quindi possono essere solo quei due posti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060113,
					"content": "Sono sicuro di aver lasciato i miei strumenti nei punti che ho <color=#00E1FFFF>usato come riferimento</color> per quei dipinti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060114,
					"content": "Se li trovate, per favore riportatemeli. Io continuerò a guardarmi intorno... Sono sicuro che ci sia un'angolazione migliore da cui dipingere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060110,
					"content": "Va bene, ma da dove inizio a cercare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "Ogni volta ero troppo preso dalla pittura per prestare attenzione a ciò che mi circondava, quindi non ricordo bene i dettagli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060112,
					"content": "Ma ho dipinto solo due quadri in quest'area, quindi possono essere solo quei due posti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 7100602,
