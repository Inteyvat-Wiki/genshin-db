			"dialogs": [
				{
					"id": 710061001,
					"content": "Oh... allora è così! Queste due pietre sono davvero gli occhi delle statue, che brillano solo dopo averle inserite...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710061002
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710061002,
					"content": "Sembra che alla fine riuscirò a dipingere qualcosa di bello! Vado a cercare una buona angolazione! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
