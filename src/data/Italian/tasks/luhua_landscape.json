					"nextDialogs": [
						710060703
					]
				},
				{
					"id": 710060703,
					"content": "Sì? Perché improvvisamente vi interessa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060704,
					"content": "L'ho trovata mentre cercavo una buona vista sul <color=#00E1FFFF>Lago Luhua</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060705,
					"content": "Volete andare al <color=#00E1FFFF>Lago Luhua</color> a dare un'occhiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060706,
					"content": "Dovrete tenere gli occhi aperti. Ci sono cose di ogni tipo in quel lago, e non ho idea di chi abbia buttato questa pietra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
