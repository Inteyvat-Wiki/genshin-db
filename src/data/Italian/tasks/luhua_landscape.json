			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "Avete trovato i miei strumenti di pittura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060202,
					"content": "Eccoli qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "Proprio come pensavo, li avevo lasciati nel posto che ho usato come riferimento. Per abitudine, tendo a mettere a terra le cose che uso mentre dipingo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060204,
					"content": "Quando vado troppo di fretta, finisco per dimenticarmi qualche pezzo. Grazie mille. Se non fosse stato per voi, sarei dovuto tornare in città a ricomprare tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060205,
					"content": "Continuerai a dipingere qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "Oh, per favore, non voglio più sentirne parlare. Mi avevano detto di queste due statue con gli occhi che si illuminano e che sono visibili da lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060207,
					"content": "Statue giganti con occhi fiammeggianti, che fanno la guardia accanto a una montagna... Sarebbe stato sicuramente un ottimo dipinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060208,
					"content": "E invece, quando sono arrivato qui, le statue c'erano, ma degli occhi brillanti neanche l'ombra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060209,
					"content": "Ho pensato di aver perso l'attimo giusto, o che l'angolazione fosse quella sbagliata... e così ho girato in tondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060210,
					"content": "Ma sembra che, dovunque mi ponga, lo scenario non cambi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060211,
					"content": "L'unica cosa che ho ottenuto da questa impresa è questa... L'ho trovato nelle pozze laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060212,
					"content": "Non ho idea di cosa sia, ma più lo guardo e più assomiglia a un occhio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060213,
					"content": "Ma se questo è un occhio, allora potrebbe esserci un'altra roccia simile nelle vicinanze. Le persone hanno due occhi, dopotutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060214,
					"content": "*sospira* Beh, è solo un'ipotesi, non pensateci troppo. Questa pietra mi serve a poco comunque, quindi perché non la prendi tu? Considerala un ringraziamento per avermi aiutato a trovare i miei strumenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060215,
					"content": "Statue con occhi brillanti... Chissà quali segreti si nascondono nel Lago Luhua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
