			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "Salve! Ehm... Cosa vorresti sapere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175002,
					"content": "Come hai conosciuto il signor Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "Vieni subito al sodo, eh? Come tutti gli avventurieri, immagino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175004,
					"content": "Ho incontrato il signor Garcia perché... il nostro direttore di compagnia lo ha assunto come contabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175005,
					"content": "Ahah, a essere sincera, non ho mai visto qualcuno di tanto incompatibile con tutti noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175006,
					"content": "Stavamo suonando, ballando, bevendo e cantando e lui era lì in disparte, in silenzio a fare i suoi calcoli con Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175007,
					"content": "Un giorno lo vidi con dei vestiti strani pieni di disegni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175008,
					"content": "Ero curiosa e gli chiesi cosa fossero. Rispose che era il progetto di una macchina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175009,
					"content": "Aggiunse che lo aveva disegnato sui vestiti perché, quando stava illustrando la macchina a qualcuno, si era trovato senza carta e penna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175010,
					"content": "Così aveva usato del carbone per disegnare sui vestiti e spiegare il progetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175011,
					"content": "Poi trascorremmo un sacco di tempo a parlare dei vestiti e della macchina... E, ovviamente, fu soprattutto lui a parlare, mentre io rimasi ad ascoltare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175012,
					"content": "Eheh, è davvero strambo... ma è anche un ammaliatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaia"
				}
			]
		},
