					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170301,
					"content": "Mmh... Dovrebbero essere sufficienti per la mia ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170302,
					"content": "Ecco la tua ricompensa. Accettala, fammi il favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170303,
					"content": "#Viaggiat{F#rice}{M#ore}, perché mi guardi così? Mi innervosisci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170304,
					"content": "Ehm! Ora torno al lavoro. Sì, torno al lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
