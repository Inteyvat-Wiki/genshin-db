	"talks": [
		{
			"id": 2301701,
			"completionStepIds": [
				2301701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301701",
							"2"
						],
						"stepId": 2301701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "#V-Viaggiat{F#rice}{M#ore}, che tempismo! Stavo per tornare al lavoro dopo questa pausa con la signorina Kaia. Lascia che vi presenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170102,
					"content": "#Ah, viaggiat{F#rice}{M#ore}, devi essere la persona di cui parla Garcia. È un piacere incontrarti, io sono Kaia, una... ehm... Beh, io ballo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170104,
					"content": "Ciao, mi pare che Garcia ti abbia nominata in passato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Eheh, davvero? Mi fa piacere sentirlo. Iniziavo a pensare che non gli importasse d'altro che della sua macchina e di Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170106,
					"content": "Puoi tranquillamente escludermi dal pensiero. Credo che farà piacere anche al signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170107,
					"content": "Ma no! Senza di te Garcia si ritroverebbe senza un soldo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170108,
					"content": "Mi perdoni, ma devo dissentire. Sono certo che il signor Garcia risparmierebbe per due caffè, costi quel che costi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170109,
					"content": "Fai anche tre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170110,
					"content": "Dimostra un'empatia sorprendente, signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170111,
					"content": "#Beh, t-torniamo agli affari! Viaggiat{F#rice}{M#ore}, mi servono ancora degli emblemi che i Cacciatori di tesori portano con sé. Se ne troverai, li acquisterò volentieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170112,
					"content": "Ho guadagnato un po' di Mora di recente... Quindi non preoccuparti per la ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301702,
