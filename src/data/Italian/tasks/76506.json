			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#Oh, perdincibacco! Guarda chi si vede, {NICKNAME} e Paimon! Che piacere incontrarvi. Oggi dev'essere il mio giorno fortunato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060102,
					"content": "Dori? Che ci fai qui tutta sola? Stai pensando di aprire un negozio? Uhm, a Paimon però non sembra tu stia trasportando della merce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060103,
					"content": "Ah, vi chiedo scusa, ma la rinomata mercante itinerante Dori oggi è in pausa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060104,
					"content": "Potremmo dire che sto prendendo spunto dagli abitanti del posto e che mi godo una giornata tranquilla e spensierata in questo Elisio chiamato Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060105,
					"content": "Eh? Sul serio? Proprio tu, che non perdi mai un'occasione per guadagnare Mora? La prossima cosa che dirai è che nel deserto sta piovendo da un anno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060106,
					"content": "Eheh, dovete sapere una cosa: anche se la sottoscritta si prende una pausa, ci sono i suoi solerti e zelanti dipendenti ad aumentare costantemente gli introiti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060107,
					"content": "Quindi non c'è nulla di cui preoccuparsi... finché le cifre nel conto continuano a salire, s'intende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060108,
					"content": "Piuttosto, avete per caso qualche problema? Sarò anche in vacanza, ma non oserei mai rifiutare un affare che bussa alla mia porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060109,
					"content": "Stiamo solo dando un'occhiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "#Ahh, quindi siete {F#venute}{M#venuti} a scattare qualche foto ai suggestivi scenari di Nod-Krai, mh? Beh, allora è un bene che mi abbiate incontrato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060112,
					"content": "Conosco questo posto come il palmo della mia mano. Certo, non quanto la gente del posto, ma se vi servono consigli, io posso darvene quanti ne volete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060113,
					"content": "#E giacché siamo {F#amiche}{M#amici}, posso farvi personalmente da guida a un prezzo di favore. Dunque dunque... Che ne pensate di 500.000 Mora al giorno, mmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060114,
					"content": "Beh, sei sempre la solita Dori: non riesci a dire due frasi in successione senza trovare un modo per prenderti i nostri Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060115,
					"content": "#Oh, no, no, io lo faccio per voi, {F#mie care e stimate}{M#miei cari e stimati} clienti: voglio solo offrirvi una splendida e indimenticabile permanenza qui a Nod-Krai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060116,
					"content": "Beh, se ci tieni così tanto a darci una mano...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "Mmh? Un'idea interessante, non c'è che dire. Ma ricordate che foto del genere non si possono usare per fini commerciali. I miei diritti d'immagine valgono una fortuna, sapete?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060119,
					"content": "Ah, tranquilla, è solo la foto di una vecchia amica... Sai, come ricordo dei vecchi tempi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060120,
					"content": "#Ah! Ma certo, naturalmente! {NICKNAME}, visto che me lo chiedi di persona, farò un'eccezione. Ma solo per stavolta. Ti chiedo solo di farmi uscire bellissima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060121,
					"content": "Vediamo un po'... Che ne dite di \"Dori, Lord Sangemah Bay, e la sua vacanza paradisiaca\"... Un titolo geniale, non trovate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060117,
					"content": "Ti spiace se ti scattiamo una foto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "E cercando soggetti da fotografare, già che ci siamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
