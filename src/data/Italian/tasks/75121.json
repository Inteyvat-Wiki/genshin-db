				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "Mi hanno chiesto di trovare un paio di libri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "Descrivi a Kuroda i libri che vuole Citlali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "La prima edizione di \"Shogun onnipotente: Rinato come la Raiden dai poteri illimitati\" e l'edizione deluxe limitata di \"Per cortesia, Kitsune Guuji?\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210104,
					"content": "Devo ammettere che la tua amica se ne intende. In termini di valore da collezione, nulla di attualmente pubblicato dalla Casa editrice Yae può competere coi libri che cerchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210105,
					"content": "E pensare che non conosco una lettrice così perspicace... Davvero un peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210106,
					"content": "Sono ancora disponibili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "Non troverete nessuna di queste copie in un negozio ordinario, né tantomeno in un magazzino. Ogni copia è stata acquistata già da tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210108,
					"content": "Io, però, possiedo una copia di ciascuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210109,
					"content": "In cambio posso pagarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "No, no. Sarebbe molto meglio se fosse la tua amica a esserne in possesso, qualcuno che ne sappia apprezzare il vero valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210111,
					"content": "Quindi, sarei più che felice di darti i libri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuroda"
				}
			]
		}
	]
