						],
						"pointId": 13574
					}
				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "#Ma guarda chi si rivede! {F#Le nostre clienti}{M#I nostri clienti} abituali! Siete qui per investire di nuovo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470202,
					"content": "Un uccellino mi ha detto che i tuoi coupon d'investimento sono una truffa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "Cosa? Non starai facendo correre un po' troppo la tua immaginazione solo perché hai accumulato delle perdite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470204,
					"content": "Pensaci un attimo. Com'è possibile che ci sia un'attività che genera solo profitti senza spendere nulla? Alcuni vincono, altri perdono. Quando ero nella Città di Sumeru... Ehm, quello che voglio dire è che è da un po' che la fortuna non gira dalla mia parte, ma non possiamo mai sapere quando questo cambierà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470205,
					"content": "La \"speranza\" può essere ottenuta solo da coloro che non si arrendono mai. Devi continuare a investire se speri di guadagnare qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470206,
					"content": "D'accordo. Allora vuol dire che tornerò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "Aspetta, non dirai sul serio! Come puoi accettare e basta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470209,
					"content": "#Non finirà bene per te, amico. Noi siamo... giusto, siamo {F#le famose}{M#i famosi} {NICKNAME} e Paimon. Abbiamo un sacco di amici qui a Nasha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470210,
					"content": "\"Amici\"... Cosa intendi... Aspetta. Intendi \"quel\" tipo di amici?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470211,
					"content": "...Eh? Ehm, sì, proprio così! Sono esattamente quel tipo di amici che stai pensando, e ne abbiamo un sacco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470212,
					"content": "Cosa?! P-Perché non l'avete detto prima?! Io... Ehm. Mi dispiace, ok? Vi lascerò in pace. Ecco... Prendete questo. Prendete tutto e andate via, e non tornate a cercare coupon... Non che voglia venderveli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470208,
					"content": "Stai cercando di ingannarmi, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
