			"dialogs": [
				{
					"id": 760470101,
					"content": "Ehm... Allora, vi osservo già da un po', e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470102,
					"content": "Ooh! Vuoi dire che ci stavi spiando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "#Oh, no, è solo che... Vengo spesso qui a cercare libri, e mi è sembrato di capire che voi due foste {F#interessate}{M#interessati} a investire. Io... vi consiglio caldamente di non farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470104,
					"content": "Beh, è vero, non abbiamo ancora guadagnato chissà che... Ma perché ci sconsigli di provarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470105,
					"content": "Perché ho il sospetto che non ci sia niente da guadagnare. Il capo ha ancora molti debiti da ripagare e non credo voglia rischiare di subire altre perdite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470106,
					"content": "Una volta, un mio amico è stato coinvolto in una truffa simile, perciò fareste meglio a non cadere nei suoi errori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470107,
					"content": "#Aspetta, e se fosse davvero una truffa...? {NICKNAME}, dobbiamo trovare quel tizio e venirne a capo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
