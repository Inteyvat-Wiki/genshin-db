					"nextDialogs": [
						721123602
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123602,
					"content": "V-Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123603
					]
				},
				{
					"id": 721123603,
					"content": "Di solito nei santuari si riceve sempre un'accoglienza caritatevole, ma qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123604,
					"content": "Ecco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123605
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123605,
					"content": "Vediamo cos'ha in serbo per noi il destino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123606,
					"content": "Ah, giusto: si può pescare un solo omikuji al giorno. Non dimenticatelo, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123607
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123607,
					"content": "Altrimenti, sarebbe troppo faticoso... No, volevo dire... Altrimenti, non avreste la possibilità di usare la bacheca degli omikuji... No, anche questo è sbagliato. Cos'è che dovevo dire...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123608
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123608,
					"content": "\"Gli omikuji sono la manifestazione del volere della nostra Archon. Il nostro dovere di mortali è rispettarlo e fare del nostro meglio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123609
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123609,
					"content": "#Sentito? Una spiegazione chiara ed elegante. Dunque, siete pregat{F#e}{M#i} di tenere a mente che potete pescare un solo omikuji al giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
