			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Malta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "#{M#Signore}{F#Signorina}, ha visto quei Granchi rocciosi? Penso che stiano facendo una specie di rituale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050102,
					"content": "Probabilmente è così che passano la loro vita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "Davvero? Ah... Ora credo di aver capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050104,
					"content": "Ci sono molte persone a Nasha proprio come quei Granchi rocciosi. Alcuni camminano a braccetto, mentre altri si salutano a pugni e calci prima di andare ognuno per la propria strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050105,
					"content": "A quanto pare anche gli abitanti di Nasha trascorrono la loro vita così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050106,
					"content": "Esatto. Vedo che sei perspicace.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "#{M#Signore}{F#Signorina}, potrebbe convincere questi Granchi rocciosi a entrare nella pozza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050109,
					"content": "Come riunire in un unico posto tutti i Cacciatori di tesori all'Ammiraglia? I risultanti sarebbero sicuramente interessanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761051501,
					"content": "#Voglio proprio vedere cosa succede quando tutti i Granchi rocciosi si riuniscono... Umm, {M#signore}{F#signorina}, sei {F#libera}{M#libero} ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050107,
					"content": "Non credo sia esattamente la stessa cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
