			"dialogs": [
				{
					"id": 752250401,
					"content": "#Ah, {F#bravissima}{M#bravissimo}! Non credevo che riuscissi a distruggere tutti quei massi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752250402
					],
					"speakerTitle": "Sachya"
				},
				{
					"id": 752250402,
					"content": "Nemmeno i Capi allenatori della nostra tribù sarebbero riusciti a superare la sfida così facilmente! Sei persino più forte di quanto immaginassi, ahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752250403
					],
					"speakerTitle": "Sachya"
				},
				{
					"id": 752250403,
					"content": "Beh, oggi mi hai davvero fatto strabuzzare gli occhi. Tieni! La tua ricompensa. Te la sei più che guadagnata!",
