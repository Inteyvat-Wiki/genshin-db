			"dialogs": [
				{
					"id": 752250101,
					"content": "Ah, che bel percorso di sfida. Peccato che non si possa affrontare al di fuori dei cicli eruttivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752250102
					],
					"speakerTitle": "Sachya"
				},
				{
					"id": 752250102,
					"content": "#Ehilà, {F#guerriera}{M#guerriero} da terre lontane. Che gran bello sguardo pieno di determinazione che hai! Allora, ti va di provare il percorso dei macigni rotolanti? Le regole sono semplicissime! Supera i macigni rotolanti e raggiungi la fine del percorso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752250103
					],
					"speakerTitle": "Sachya"
				},
				{
					"id": 752250103,
					"content": "Per quanto mi riguarda, è una signora sfida. Cosa vuoi fare? Ti va di fare un tentativo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sachya"
