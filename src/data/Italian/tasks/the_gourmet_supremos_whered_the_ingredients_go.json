			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "Grazie, questi andranno bene. Se non fosse stato per te, mi sarei dovuta buttare nella mischia e occuparmene personalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260302,
					"content": "Se fosse successo, chissà se mi sarei ricordata di dover raccogliere fiori di sakura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260303,
					"content": "Comunque, grazie dell'aiuto. Ecco, prendi degli spiedini di pollo e funghi. La signora Lynn mi ha insegnato a preparare questo grande classico per gli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260304,
					"content": "Porterò questi fiori di sakura a Xudong. Chissà che prelibatezze si inventerà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		}
	]
}