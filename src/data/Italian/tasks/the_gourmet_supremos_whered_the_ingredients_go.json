			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "Mmmh... dovrebbe essere da queste parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260102,
					"content": "Julie? Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "#Eh? Ah viaggiat{F#rice}{M#ore}, non mi aspettavo di incontrarti qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260104,
					"content": "Sto cercando alcuni ingredienti. Xudong sta studiando nuove ricette e Parvaneh gli dà qualche idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260105,
					"content": "Xudong mi ha detto che vorrebbe creare un dessert dolce e morbido ispirato al dango tricolori di Inazuma. Però servirebbero diversi ingredienti per crearlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260106,
					"content": "Lo zio Munehisa è andato in città a comprare dei Melonlavanda. Io sono venuta qui a raccogliere i cosiddetti fiori di sakura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260107,
					"content": "Anche se ne ho raccolti alcuni, non sono abbastanza. Volevo andare a cercare più avanti, ma questa zona brulica di mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260108,
					"content": "#Viaggiat{F#rice}{M#ore}, ti prego, potresti aiutarmi e portarmi tre fiori di sakura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260109,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "Grazie! Ti offrirò qualcosa di fantastico al tuo ritorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260111,
					"content": "Questi mostri non dovrebbero crearti problemi, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "Beh, sì, di solito è così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260113,
					"content": "Ma... mmmh, come posso spiegartelo? Se dovessi davvero combattere contro quei mostri, mi dimenticherei della missione di recupero degli ingredienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260114,
					"content": "Sono fatta così fin dai tempi di Mondstadt. Ogni volta che dovevo affrontare dei mostri, dimenticavo tutto il resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260115,
					"content": "Solo una volta sconfitti del tutto i mostri mi ricordavo dei compiti assegnati ancora da portare a termine... Ecco perché fallivo così tanti incarichi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260116,
					"content": "Detesti davvero i mostri, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "Detestarli? Non proprio... Anzi, combatterli è molto divertente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260118,
					"content": "La consapevolezza di poterti dedicare interamente a sconfiggere i mostri è fantastica. Tu l'hai mai provata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260119,
					"content": "Beh, non pensiamoci. Quindi ti prego, aiutami a raccogliere i fiori di sakura. Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260120,
					"content": "Ti offrirò qualcosa di fantastico al tuo ritorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
