			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "Aspetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390102,
					"content": "#Sei {F#un'avventuriera}{M#un avventuriere}? Intendo un{F#a}{M#o} di quell{F#e}{M#i} abili in battaglia e che visita tanti posti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390103,
					"content": "Puoi dirlo forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#Hai visto, Hilmi? Lo dicevo che doveva essere {F#un'avventuriera}{M#un avventuriere}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390106,
					"content": "#Ma {F#le avventuriere}{M#gli avventurieri} non indossano sempre un abito verde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390107,
					"content": "#Sono troppo brav{F#a}{M#o} per indossare quel tipo di abito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390110,
					"content": "Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390111,
					"content": "Se è così, allora potrai aiutarci di sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390112,
					"content": "Vedi quel grande magazzino nel villaggio? Habachi ha detto che dobbiamo sorvegliarlo perché dentro ci sono cose molto importanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390113,
					"content": "Ci ha anche detto che se dovessero arrivare dei malintenzionati, disattiverà l'ascensore e impedirà l'accesso al ponte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390114,
					"content": "L'ascensore però è abbastanza lontano dal magazzino. Per disattivarlo, Habachi dovrà correre tantissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390115,
					"content": "Pensavamo di poterci allenare con lui, ma non ha fatto altro che ignorare la nostra richiesta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390116,
					"content": "Però quando cerchiamo di andare di nascosto a tirare i sassi per farli rimbalzare sull'acqua, non ci ignora mai, eh! Umpf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390117,
					"content": "Ehm, comunque sia, se dovessero arrivare dei malintenzionati e Habachi fosse troppo stanco, ci penseremo noi a disattivare l'ascensore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390118,
					"content": "#Visto che sei {F#un'avventuriera}{M#un avventuriere}, di sicuro correrai anche tu come un fulmine! Per favore, allenati con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390119,
					"content": "Certo. Corriamo insieme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "Evviva! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390126,
					"content": "Abbiamo scelto il punto di partenza. Andiamoci subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390127,
					"content": "Eheh, sarò io a competere con te. Per tua informazione, sappi che sono molto veloce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390121,
					"content": "Potete fidarvi di Habachi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "Per favore, gioca con noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390123,
					"content": "#Per favore, gioca con noi, gentile signor{F#a}{M#e}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390124,
					"content": "D'accordo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "Evviva! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390108,
					"content": "#Sono una persona speciale e non sono tenut{F#a}{M#o} a indossare quell'abito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "Direi che è una descrizione accurata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
		},
