					"nextDialogs": [
						230390404
					]
				},
				{
					"id": 230390404,
					"content": "Eheh, te l'avevo detto che sono veloce! Non pensavi, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390405
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390405,
					"content": "Anche correndo così veloce, però, non riusciamo mai a battere Habachi. Non riesco proprio a capire il perché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390406,
						230390407
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390406,
					"content": "Forse c'è una scorciatoia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390408,
					"content": "Dici davvero? Non credo ci sia una scorciatoia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390409
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390409,
					"content": "#Signor{F#a}{M#e}, puoi giocare con noi la prossima volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390410
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390410,
					"content": "Ehm, volevo dire... allenarti con noi! Potremmo provare la corsa sul \"sentiero nella natura selvaggia\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390411
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390411,
					"content": "Hai ragione! Se non possiamo battere Habachi, possiamo cercare di evitarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390412
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390412,
					"content": "Però ci abbiamo già provato, non è vero? E non ha mai funzionato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390407,
					"content": "Magari sta usando qualche trucchetto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390403,
					"content": "Stavi quasi... volando...",
					"roleType": "TALK_ROLE_PLAYER",
