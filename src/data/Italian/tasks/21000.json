					"Piccolo Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000301,
					"content": "Ma cosa... E pensare che queste cose esistono davvero! Spaventoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000302,
					"content": "Grazie mille! Forza, continuiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000303,
					"content": "...Aspetta. Dov'è il mio messaggio in bottiglia? L'avevo in mano, ma ora è scomparso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000304,
					"content": "L'ho fatto cadere mentre stavamo combattendo contro quel... Malefiore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000305,
					"content": "Per favore, aiutami a trovarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				}
			]
		},
		{
			"id": 2100005,
			"completionStepIds": [
				2100011
			],
