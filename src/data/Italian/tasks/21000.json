			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccolo Meng",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000501,
					"content": "Fiuuu... Sono stato sveglio tutta la notte a scrivere il messaggio. Se l'avessimo perso, avrei dovuto riscrivere tutto da capo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000502
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000502,
					"content": "Wow, tutta la notte? Hai davvero molti pensieri, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000503,
					"content": "Beh... Non proprio. Voglio solo sapere come fare per diventare adulto.",
