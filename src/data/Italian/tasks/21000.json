			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "*sospira* Posso farcela davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000102,
					"content": "Qualcosa non va, Piccolo Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#Oh... Sei tu, viaggiat{F#rice}{M#ore}. Come stai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000104,
					"content": "Sembri giù di morale, Piccolo Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000105,
					"content": "Cosa succede? Gli altri bambini hanno smesso di giocare ai pirati con te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000106,
					"content": "Eh? No, no. La Piccola Lulu e il Piccolo Fei sono appena tornati a casa, tutto qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000107,
					"content": "Io... Volevo farmi una passeggiata da solo, ecco perché sono ancora qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000108,
					"content": "I tuoi genitori non si preoccupano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000109,
					"content": "Dovrebbero essere ancora al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000110,
					"content": "Ma parliamo d'altro. Posso farti una domanda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000111,
					"content": "E cioè?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "Dunque... Molte persone mi hanno raccontato delle storie su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000115,
					"content": "Hai visitato molti posti e visto tante cose, forse puoi darmi una risposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000116,
					"content": "Oh, perché così serio? Qual è la domanda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000117,
					"content": "Vorrei chiederti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000118,
					"content": "Come si diventa \"adulti\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000119,
					"content": "Ci vuole del tempo per diventare maturi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "Quindi stai dicendo che le persone diventano adulte semplicemente crescendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000121,
					"content": "Ma allora non si diventa adulti troppo tardi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000124,
					"content": "Beh, se vuoi farti un viaggetto fuori città, noi possiamo accompagnarti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000125,
					"content": "Sarebbe... Non voglio disturbarvi. E dubito che mi succeda qualcosa di speciale uscendo semplicemente dalla città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000126,
					"content": "Invece mi piacerebbe che mi aiutassi in un altro modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000127,
					"content": "Ho saputo che scrivere un messaggio in bottiglia è un ottimo modo per risolvere i problemi, basterà lasciare che la bottiglia galleggi sul fiume...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000128,
					"content": "In questo modo potrebbero davvero risolversi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000129,
					"content": "Ma ho anche sentito dire che là fuori ci sono molti mostri. Non sarebbe sicuro avventurarmi da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000130,
					"content": "Quindi, potresti proteggermi mentre faccio questa cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000131,
					"content": "Certamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "Grazie mille! Non preoccuparti, ho dei risparmi. Posso pagarti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000134,
					"content": "Forza, per prima cosa andiamo al Fiume Bishui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000132,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "Devi fare delle esperienze speciali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Esperienze speciali, eh... Ma in vita mia non me ne sono mai andato dal Porto di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000112,
					"content": "Ora temo di non avere tempo per quel gioco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Ahahah, faccio quel gioco solo con la Piccola Lulu e col Piccolo Fei e, visto che non sono qui, ti assicuro che non sto giocando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "Piccolo Meng"
				}
			]
		},
