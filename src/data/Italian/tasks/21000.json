					"content": "Siamo arrivati? Mm... Dobbiamo scegliere un buon punto dove gettare il nostro messaggio in bottiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000202
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210000202,
					"content": "Se vogliamo che vada lontano, dovremmo trovare un luogo più a monte...",
					"roleType": "TALK_ROLE_NPC",
