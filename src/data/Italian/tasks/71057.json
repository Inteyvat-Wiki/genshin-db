			"dialogs": [
				{
					"id": 710570133,
					"content": "All'improvviso senti sussurrare alle tue spalle:\\n\"Eheheh... carne di fungo... Eheheh...\"",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "Ehi... Eheheh, che ci fate qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570102,
					"content": "Wow! Questo tizio ha una cera terribile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570103,
					"content": "#Ed è spuntato senza fare il minimo rumore, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570104,
					"content": "Potrebbe essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570105,
					"content": "Probabilmente no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "Eheheh, c-che cosa ci fate qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570107,
					"content": "Anche voi avete finito il cibo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570108,
					"content": "Sei zio He?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "#Ehm... eh? Che cosa stai dicendo, car{F#a}{M#o}? Non ti sento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570110,
					"content": "Ho chiesto se sei zio He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570111,
					"content": "Aaaah, sì. Eheheh, sono io, eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570112,
					"content": "#Anche tu sei intrappolat{F#a}{M#o} qui? Anche tu hai finito il cibo? *sospira* Che sfortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570113,
					"content": "#Eheheh, non preoccuparti. Ne ho un po' qui... Devi essere affamat{F#a}{M#o}... Eheheh",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570114,
					"content": "A furia di parlare di cibo, la pancia di Paimon brontola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570115,
					"content": "Questa \"carne di fungo\" sembra sospetta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "Eh... hai ragione. Sembra un po' fuso e cos'è quel colorito? Paimon scommette che c'entra con la carne di fungo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570118,
					"content": "Carne di fungo? Eheheh, certo, è deliziosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570119,
					"content": "Ne vuoi un po'?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570120,
					"content": "Ahahah ti piace? Mmmh... Cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570121,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570122,
					"content": "La carne di fungo è sparita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570123,
					"content": "Sai cosa? Lasciamo perdere, torniamo subito all'accampamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570124,
					"content": "Non ci vengo con voi! Ho finito la carne di fungo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570125,
					"content": "Senza di essa non avrò la forza nemmeno per camminare. Non vado da nessuna parte... Niente carne di fungo... e niente cibo da nessun'altra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570126,
					"content": "Ma con la carne di fungo posso andare ovunque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570127,
					"content": "Dove possiamo trovarla, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570128,
					"content": "Carne di fungo... Ah, eheheh, so dove si trova. Vado a prenderne un po'. Riempiamoci la pancia e poi avremo le forze per lavorare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570129,
					"content": "Dovrebbe essere da queste parti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570130,
					"content": "#Beh, {NICKNAME}, Paimon pensa che possiamo solo fare come dice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570131,
					"content": "Sembra essere l'unica possibilità, al momento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "Carne di fungo... Eheheh... tanta carne di fungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570116,
					"content": "Non ti infilare in bocca qualsiasi cosa trovi in giro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
		{
