					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570422,
					"content": "Sono sicura che saranno tutti contenti del suo ritorno. E in salute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570423
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570423,
					"content": "#{NICKNAME}, ti ringrazio tanto. Appena Khedive avrà finito di visitare lo zio He, lo porterò via a qualunque costo dalla Voragine.",
