			"dialogs": [
				{
					"id": 710570201,
					"content": "Li ha fatti fuori tutti in un lampo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570202,
					"content": "Wow! È forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570203,
					"content": "Eheheh... Carne di fungo... carne di fungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570204
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570204,
					"content": "Da quando ho iniziato a mangiare carne di fungo, il dolore lombare è sparito e ho più forze. Eheheh, è come se fossi ringiovanito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570205,
					"content": "E le creature fungose sono anche più deliziose della carne di fungo! Più sono grandi, più sono buone... Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570206
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570206,
					"content": "Forse zio He è diventato così forte a forza di mangiare carne di fungo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}, perché non la proviamo, visto che potrebbe renderci più forti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570208,
						710570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570208,
					"content": "Davvero ambisci solo a diventare \"più forte\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570209
					]
				},
				{
					"id": 710570209,
					"content": "Paimon è solo curiosa di sapere di che cosa sa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570212,
					"content": "Ma tornando a noi, zio He non dovrebbe avere problemi a tornare con noi, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570213,
					"content": "Carne di fungo... Eheheh, gnam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570214,
					"content": "Zio He, andiamo insieme all'accampamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570215,
					"content": "Eh? \"Condiamo insieme\"? Certamente, la carne di fungo così è ancora meglio. Eheheh, sai che quella essiccata si conserva molto, molto a lungo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570216,
					"content": "Paimon voleva dire che torniamo all'accampamento insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570217,
					"content": "\"Appartamento\"? Dove? Ah, che mi importa. Va bene... Eheheh, ora che ho mangiato carne di fungo posso andare ovunque, anche all'appartamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570218,
					"content": "*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}, riportiamo lo zio He da Jinwu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570210,
					"content": "Per piacere, passa a una dieta meno creativa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "Oh, va bene, Paimon capisce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105703,
			"completionStepIds": [
				7105707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
