			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zio He",
					"Jinwu",
					"Paimon",
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710570601,
					"content": "Carne di fungo... eheheh... Un banchetto di funghi nella mia pancia, funghetti, creature di fungo, fungoni... Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570602
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570602,
					"content": "Zio He? Che cosa è successo al tuo viso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570603
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570603,
					"content": "*sospira* Sapevo che eri ancora vivo! E pensare che la tua famiglia mi ha persino invitato al tuo funerale! Mi sono rifiutata di andare, dato che senza un corpo la speranza non muore mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570604
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570604,
					"content": "Guarda che faccia. Dev'essere stato difficile restare intrappolato nella miniera in quel modo. Comunque sono felice che tu sia ancora vivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570605
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570605,
					"content": "Essere vivi è bello, sì! I funghi vivi sono deliziosi! Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570606
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570606,
					"content": "Zio He?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570607
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570607,
					"content": "L'abbiamo trovato in queste condizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570608,
					"content": "Non era proprio... presente e continuava a dire di voler mangiare funghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570609,
					"content": "Funghi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570610
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570610,
					"content": "La Voragine è un posto pericoloso per la gente comune. Le piante o i funghi che vi crescono possono essere dannosi per gli umani. Ecco perché l'Unione di Huishan ha stabilito regole ferree contro il loro consumo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570611
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570611,
					"content": "Ma lo zio He è rimasto intrappolato lì per anni senza altro cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570612
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570612,
					"content": "Cosa dirò ai suoi cari quando lo vedranno in queste condizioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570613,
						710570614
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570613,
					"content": "A proposito dei funghi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570615
					]
				},
				{
					"id": 710570615,
					"content": "Ora che ci penso, Khedive potrebbe essere in grado di aiutarti. Dopotutto è uno studioso di Sumeru. Deve aver condotto qualche ricerca sui funghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570616
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570616,
					"content": "Aspetta qui, per favore. Lo porto qui, così potrà visitare lo zio He.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570617
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570617,
					"content": "Carne di fungo... carne di fungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570618
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570618,
					"content": "*sospira* Paimon non è sicura che lo zio He si riprenderà, visto com'è messo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570619,
					"content": "Sarebbe comunque molto triste per la sua famiglia se dovesse tornare da loro in queste condizioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570620,
					"content": "Jinwu, non puoi costringermi a venire qui mentre sono a metà della mia relazione! So che sei responsabile della sicurezza della squadra, ma non è giusto interrompere in questo modo le mie ricerche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570621
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570621,
					"content": "Sto seriamente pensando di tagliare il tuo budget, com'è già stato proposto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570622
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570622,
					"content": "Lascia perdere il budget.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570623
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570623,
					"content": "Ti prego, devi controllare se quest'uomo sta bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570624
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570624,
					"content": "Mi prudono le orecchie... Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570625
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710570625,
					"content": "Eh? Chi è questo? E perché ha quell'aspetto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570626
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570626,
					"content": "#L'hai trovato tu, {NICKNAME}? Seriamente, non so come riesci a finire sempre in situazioni così particolari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570627
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570627,
					"content": "Beh... com'era quando l'hai trovato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570628
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570628,
					"content": "Racconti a Khedive che cosa è successo allo zio He...\\nKhedive lo visita attentamente.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570629
					]
				},
				{
					"id": 710570629,
					"content": "Sta bene. Non ha nulla di grave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570630
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570630,
					"content": "Sai perché si lamenta sempre del prurito nelle orecchie? Perché le spore di miceti sono penetrate lì dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570631
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570631,
					"content": "Sebbene consumare a lungo termine questo tipo di miceti... voglio dire, di funghi, sia dannoso per la mente, non fa male al corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570632
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570632,
					"content": "Quindi stai dicendo che potrà riprendersi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570633
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570633,
					"content": "Ho già liberato il suo corpo dai miceti e preparato un medicinale per curare il suo disturbo neurologico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570634
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570634,
					"content": "È molto probabile che si rimetterà in sesto, se gli verrà concesso adeguato riposo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570635
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570635,
					"content": "Capisco. A proposito del prezzo del medicinale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570636
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570636,
					"content": "Nessuno degli ingredienti è particolarmente costoso... diciamo che in tutto costano quanto un mese di pasti alla Pagoda di Xinyue. Nulla di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570637
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570637,
					"content": "Ehm... troverò un modo per ripagarti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570638
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570638,
					"content": "Non ce n'è bisogno. Anzi, questo incidente mi dà qualcosa di nuovo da scrivere nella mia relazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570639
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570639,
					"content": "Da quando mi sono imbattuto in questi funghi nella Voragine, mi sono incuriosito sugli effetti a lungo termine della loro assunzione. Finora però non avevo ancora trovato assistenti... volontari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570640,
						710570642
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570640,
					"content": "Assistenti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570641
					]
				},
				{
					"id": 710570641,
					"content": "Sì, qualcuno che abbia il compito di mangiare i funghi. Sembrano tutti restii a farlo. Sebbene sappiano che non subiranno grossi danni, non hanno il coraggio di mangiarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570644
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570644,
					"content": "Ma... vista la peculiarità della Voragine, è possibile che sia stato anche l'ambiente a provocargli i sintomi. Comunque, fai in modo che prenda il medicinale e si riposi. Ha ottime probabilità di riprendersi, anche in queste condizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570645
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570645,
					"content": "Che sollievo... Più tardi lo riporterò in superficie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570646
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570646,
					"content": "Una volta che si sarà ripreso, lo riporterò a casa sua e informerò anche i suoi amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570647
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570647,
					"content": "È un minatore veterano e piuttosto agile. Si è preso molta cura dei giovani che iniziavano a lavorare in miniera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570648
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570648,
					"content": "Quando scomparve, qualche anno fa, si chiesero tutti perché Rex Lapis non l'avesse protetto. Dissero che la vita di un brav'uomo non sarebbe dovuta finire così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570649
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570649,
					"content": "Sono sicura che i suoi amici saranno confortati dalla notizia del suo ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570642,
					"content": "Non sarebbe il caso di chiamarli \"cavie\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570643
					]
				},
				{
					"id": 710570643,
					"content": "Probabilmente, ma abbiamo studiato questi funghi e la nostra conclusione è che non provocano danni irreversibili al corpo o alla mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570644
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570614,
					"content": "Conosci qualcuno che fa ricerche sui funghi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570615
					]
				}
			]
		},
