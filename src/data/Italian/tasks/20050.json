			},
			"dialogs": [
				{
					"id": 200500101,
					"content": "Ah, che mal di testa... Cosa dovrei fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500102,
					"content": "Cosa combini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "Mi esercito per le prove dei Cavalieri di Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500104,
					"content": "*sospira* Ma non sono neanche lontanamente forte come Jean...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500105,
					"content": "Credo che sia meglio concentrarmi sulla tecnica, piuttosto che sulla potenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500106,
					"content": "Per esempio, stavo pensando a come spaccare tutti questi manichini di legno con un unico fendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500107,
					"content": "Se hai tempo, ti andrebbe di aiutarmi a trovare una soluzione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500108,
					"content": "Ci penserò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "Certo, prenditi il tempo che ti serve. Tanto, questi manichini non vanno da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500111,
					"content": "Così come la mia vita, dato che sono ancora bloccata qui a cercare una soluzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500114,
					"content": "Ho sentito che gli elementi interagiscono in modi speciali. Mi chiedo se ci sia un modo in cui possiamo usare il fuoco di questo braciere per innescare una piccola esplosione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500115,
					"content": "Ma prima, serve che ci sia del vero fuoco nel braciere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500109,
					"content": "E se facessimo un tentativo insieme?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "Ti piace il combattimento di squadra, allora? Va bene per alcuni... C'è sempre qualcuno ad aiutarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500113,
					"content": "Per persone come me, il meglio che posso fare è cercare di cavarmela come combattente solitaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
