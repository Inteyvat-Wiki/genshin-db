			"dialogs": [
				{
					"id": 760680101,
					"content": "Ah, Aria. A quanto pare anche tu hai già scelto una forma \"umana\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680102,
					"content": "Eheh, hai proprio l'aspetto che immaginavo, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680103,
					"content": "Però lo ammetto: non pensavo che avresti creato di proposito una forma del genere per quelle adorabili creaturine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680104,
					"content": "È naturale, Aria: quelle fragili vite ripongono in me la loro fiducia e mi invocano, perciò intendo rispondere alle loro voci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680105,
					"content": "Siamo nate per preservare il mondo. Se gli esseri noti come \"umani\" sono disposti a stabilirvisi, ascoltare le loro suppliche adempie alla missione che il nostro Re ci ha affidato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680106,
					"content": "Sì. Dopotutto, ha detto che tutte le forme di vita al di là del mare di stelle sono nostre alleate, e combattono al nostro fianco contro l'oscurità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680107,
					"content": "Ma non mi stavo riferendo a quello. Non mi aspettavo che proprio tu, la \"Luna gelata\", avessi un lato così sentimentale. È davvero adorabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680109,
					"content": "...Vedo che il modo di parlare di quei piccoli umani ha già iniziato a influenzarti, Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680110,
					"content": "Le loro parole sono sempre molto ambigue, evita di usarle. Non riesco a comprendere cosa cerchi di comunicare con quell'\"adorabile\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680111,
					"content": "Oh, ma dai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680112,
					"content": "Sorelle, ora che abbiamo plasmato dei corpi tutti nostri, per prima cosa non dovremmo sgattaiolare fuori e divertirci un po' con la gente della superficie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680113,
					"content": "Altrimenti, li avremo creati per niente! Presto, prima che qualcuno ci scopra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680114,
					"content": "Eheh. Sembra che la nostra cara sorella non riesca proprio ad aspettare, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680115,
					"content": "Eppure, ricordo che quando iniziarono a edificare la loro civiltà in superficie, tu dicesti persino: \"Quello straniero è fonte di guai, e di conseguenza anche le sue creazioni\". Non ti degnavi nemmeno di guardarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680116,
					"content": "Q-Quella è un'altra storia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680117,
					"content": "Continuo a pensare che voi due non avreste dovuto far entrare quello straniero, ma la gente in superficie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680118,
					"content": "Ah... Basta che vi divertiate. Va' pure, ma ricorda di restare vicina ad Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680119,
					"content": "Eh? Tu non vieni, Canon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680120,
					"content": "La servitrice di quel Discendente ha detto che doveva discutere con me del potenziale gravitazionale e del ten{RUBY#[D]leggi del tempo}sore metrico di questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680121,
					"content": "Parli di Istaroth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680122,
					"content": "Credo che quello fosse il suo nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680123,
					"content": "Faresti meglio a memorizzare i nomi delle persone, sorella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680124,
					"content": "E forse è solo la mia immaginazione, ma ho... una strana sensazione riguardo a come lei vede quel Discendente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680125,
					"content": "Non voglio trarre conclusioni affrettate, Aria, ma terrò gli occhi aperti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680126,
					"content": "Buono a sapersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680127,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680128,
					"content": "Eheh, lascia stare. Allora andiamo, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680129,
					"content": "Non preoccuparti, io e Sonnet ti porteremo un regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680130,
					"content": "...Non mi servono regali. Fate solo attenzione a non farvi riconoscere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}