			"dialogs": [
				{
					"id": 761250201,
					"content": "(Come previsto, Colombina non è qui...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "Che Colombina sia davvero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250203,
					"content": "(È passata attraverso la \"Porta della luna\". Nessuno sa cosa ci sia dentro, ma è un luogo che ha distrutto il potentissimo Vindice di Solnari...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "(Se solo avessi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250205
					]
				},
				{
					"id": 761250205,
					"content": "Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250207
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250207,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250208
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250208,
					"content": "Ah, siete voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250209,
					"content": "~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250210
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250210,
					"content": "Anche voi... state aspettando il ritorno di Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250212
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250212,
					"content": "Quindi, anche tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250214
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250214,
					"content": "Ehi... Dai, non essere così triste. Su col morale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250215,
					"content": "Se tutti fossero tristi, sarebbe come... come...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250216,
					"content": "Paimon non vuole nemmeno pensarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250217,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250218
					]
				},
				{
					"id": 761250218,
					"content": "(...Non posso lasciarmi andare ai sensi di colpa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250219
					]
				},
				{
					"id": 761250219,
					"content": "(Colombina non si è sacrificata per farci finire così, per non parlare di...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250220
					]
				},
				{
					"id": 761250220,
					"content": "#Non... mi sono ancora {F#arresa}{M#arreso}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250221
					]
				},
				{
					"id": 761250221,
					"content": "Colombina, tutti i suoi amici... Nessuno di loro si arrenderebbe mai in questo modo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250222
					]
				},
				{
					"id": 761250222,
					"content": "Dacci un po' più di tempo. Non posso promettere nulla, ma farò tutto quello che posso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250223
					]
				},
				{
					"id": 761250223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250224
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250224,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250225
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761250225,
					"content": "Stanno... facendo il tifo per noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250226,
					"content": "Mmh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250227
					]
				},
				{
					"id": 761250227,
					"content": "Grazie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250228,
					"content": "Possiamo aiutarvi in qualche modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250229,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250230
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250230,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250231
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761250231,
					"content": "Questa Kuuhenki... Paimon pensa sia quella a cui piace suonare la lira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250232,
					"content": "Questa Kuuhenki... Paimon pensa che sembri un po' agitata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250233,
					"content": "Perché non suoni qualcosa? Magari sentendo una melodia familiare si calmerà un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250234,
					"content": "Una melodia familiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250235
					]
				},
				{
					"id": 761250235,
					"content": "Proviamo la canzone che canta sempre Colombina...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250236
					]
				},
				{
					"id": 761250236,
					"content": "Oooh... Stanno dormendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250237,
					"content": "Sembra che non facessero una bella dormita da molto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250238,
					"content": "Shhh, andiamo via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250239,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250240
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761250240,
					"content": "Sandrone! Cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250241,
					"content": "Cosa, non posso più fare una passeggiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250242
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761250242,
					"content": "Non è ancora tornata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "Come immaginavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250244
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761250244,
					"content": "I miracoli hanno sempre un prezzo, lo sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250245
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761250245,
					"content": "Ehi, dove stai andando? Ehm, Paimon intendeva dire... Non ci vediamo spesso, forse potremmo farti un po' di compagnia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761250246,
					"content": "Meglio di no. Oggi non sono dell'umore giusto e non ho niente di carino da dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250247
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 761250247,
					"content": "Inoltre, la comodità è l'ultima cosa di cui questo posto ha bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
