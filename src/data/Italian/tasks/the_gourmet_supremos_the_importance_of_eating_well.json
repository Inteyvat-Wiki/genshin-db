	"talks": [
		{
			"id": 2201602,
			"completionStepIds": [
				2201603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201603",
							"2"
						],
						"stepId": 2201603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160201,
					"content": "#Parvaneh... e {F#la viaggiatrice}{M#il viaggiatore}? Che cosa ci fai qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160202,
						220160205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160202,
					"content": "Sono qui per aiutarvi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160203
					]
				},
				{
					"id": 220160203,
					"content": "Davvero? Non so come ringraziarti! Sembra che Julie si sia allontanata ancora di più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160204,
					"content": "Lì ci sono branchi di mostri. È difficile gestirli solo in due. Ma con il tuo aiuto forse ce la caveremo meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160210,
					"content": "Mettiamoci in marcia. Julie dovrebbe essere nella foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160205,
					"content": "Sono qui per il banchetto che hai promesso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160206
					]
				},
				{
					"id": 220160206,
					"content": "Nessun problema. Ma non posso prepararlo da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160207
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160207,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti farmi un favore e aiutarci prima a ritrovare Julie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160208
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160208,
					"content": "Sembra che Julie si sia allontanata ancora di più... lì ci sono una valanga di mostri. Sarà dura gestirli solo in due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160209
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160209,
					"content": "Dopo aver ritrovato Julie, preparerò il banchetto come promesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201603,
			"completionStepIds": [
				2201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201609",
							"2"
						],
						"stepId": 2201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh",
					"Xudong",
					"Julie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160301,
					"content": "Ehi! Se rompi il wok come faremo a cucinare?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160302,
					"content": "Non sottovalutare la qualità dei wok di Liyue. Questo è in ghisa, progettato specificamente per saltare gli ingredienti. Non si romperà facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160303,
					"content": "Comunque si tratta solo di qualche mostro. Che razza di wok di ghisa sarebbe se non li stendesse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160304,
					"content": "Ti aspetti troppo da una padella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160305,
						220160308,
						220160312
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160305,
					"content": "Xudong è un tipo piuttosto baldanzoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160306
					]
				},
				{
					"id": 220160306,
					"content": "Certamente! Uno chef deve avere un certo portamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160307,
					"content": "Non ho mai sentito una cosa del genere! Perché uno chef dovrebbe imparare a sconfiggere i mostri con una pentola di ghisa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160315,
					"content": "Ok. Julie, andiamocene. E di corsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160316,
					"content": "A-Aspetta. Dobbiamo aiutare zio Munehisa! Sta combattendo da solo i Kairagi nel bosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160317
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160317,
					"content": "I Kairagi? Non dei mostri comuni? Come ci sei finita in mezzo a quelli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160318,
					"content": "T-Te lo dico più tardi. Andiamo ad aiutarlo! È tutto solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160319
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160319,
					"content": "#Va bene, ho capito. Viaggiat{F#rice}{M#ore}, puoi venire con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160320,
						220160321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160320,
					"content": "#Sono pront{M#o}{F#a}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160325
					]
				},
				{
					"id": 220160325,
					"content": "Forza, andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160321,
					"content": "Combatterai contro i Kairagi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160322
					]
				},
				{
					"id": 220160322,
					"content": "Assolutamente. Il mio wok non vede l'ora, hai visto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160323
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160323,
					"content": "Comunque gli chef non se la filano alla vigilia di una battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160324,
					"content": "Ti ho detto di non avere aspettative così alte sugli chef con i wok di ghisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160325
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160308,
					"content": "Dove posso acquistare un wok come il tuo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160309
					]
				},
				{
					"id": 220160309,
					"content": "Ahah, ottima domanda! Me lo sono fatto forgiare appositamente alla Ferriera Hanfeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160310,
					"content": "Si dice che la ghisa contenga materiali estratti dalla Voragine. Se ne vuoi uno, vai alla Ferriera Hanfeng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160311
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160311,
					"content": "Ma ho sentito che la Voragine ormai è sigillata da tanto tempo. Dubito che ne forgerebbero uno adesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160312,
					"content": "Anche Parvaneh se la sta cavando bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160313
					]
				},
				{
					"id": 220160313,
					"content": "#Eh? Beh... ahahah, ho solo lanciato qualche libro addosso ai mostri. Sei stat{F#a}{M#o} tu a sconfiggerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160314,
					"content": "Aspetta. Dov'è il volume 6 di \"Al fianco degli dèi\"? Ho lanciato anche quello? Non l'avevo ancora finito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
			"id": 2201604,
			"completionStepIds": [
				2201608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"2"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Julie",
					"Xudong",
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160401,
					"content": "Ehm... Mi dispiace che tu mi abbia dovuto vedere in questo stato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160402
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160402,
					"content": "Zio Munehisa, stai bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160403
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160403,
					"content": "Ho preso solo qualche ceffone. Niente di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160404
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160404,
					"content": "Ora, Julie, potresti raccontarci tutta la storia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160405
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160405,
					"content": "Parla, ti prego, non dirmi che ho distrutto i miei libri per niente... Argh, le pagine ora sono tutte stropicciate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160406,
					"content": "È semplice... volevo solo portargli del cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160407
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160407,
					"content": "*sospira* Lo conosci appena. Perché... ti fidi così tanto di lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160408
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160408,
					"content": "Sono sicura che sia un brav'uomo! Moriva di fame, eppure, invece di tenerlo per sé ha dato il cibo a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160409
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160409,
					"content": "Chiunque sia disposto a condividere il cibo con gli altri quando questi hanno fame... deve essere una brava persona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160410
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160410,
					"content": "La tua concezione di bene e male è così netta e pura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160411
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160411,
					"content": "Vivi nel mondo delle fiabe, non a Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160412
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160412,
					"content": "Ahahah, però credo che abbia ragione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160413
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160413,
					"content": "Sono d'accordo. Chi mantiene onore e decenza quando ha fame non può essere così terribile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160414
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160414,
					"content": "Che logica semplice e diretta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160415
					]
				},
				{
					"id": 220160415,
					"content": "Comunque... Julie, continua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160416
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160416,
					"content": "Quindi gli ho preparato degli spiedini di pollo e funghi e ho provato a ritrovare il posto in cui l'abbiamo incontrato per la prima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160417
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160417,
					"content": "E lui era lì, a quanto pare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160418
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160418,
					"content": "Stavo per andare a salutarlo, quando ho notato che era alle prese con alcuni Kairagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160419
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160419,
					"content": "Volevo scappare, ma mi hanno vista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160420
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160420,
					"content": "Continuo io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160421
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160421,
					"content": "Tra quelle... persone ci sono alcuni vecchi amici che hanno prestato servizio con me sotto lo Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160422
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160422,
					"content": "Dopo il cambiamento repentino di Inazuma, abbiamo tutti lasciato lo Shogunato uno dopo l'altro per andare a guadagnarci da vivere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160423,
						220160425,
						220160427
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160423,
					"content": "È così che si guadagnano da vivere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160424
					]
				},
				{
					"id": 220160424,
					"content": "Sì. Non abbiamo altri modi per mantenerci se non con le spade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160432,
					"content": "Da allora sono diventati i Kairagi che vedi adesso, e si guadagnano da vivere saccheggiando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160433
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160433,
					"content": "Non volevo andare avanti in quel modo, così mi sono messo a vagabondare per queste terre alla ricerca di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160434
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160434,
					"content": "Nessuno, tuttavia, voleva assumermi, appena scopriva i miei trascorsi da samurai che aveva lasciato lo Shogunato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160435
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160435,
					"content": "Da allora, come puoi vedere, ho dovuto cercare cibo in natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160436
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160436,
					"content": "Di recente, i miei ex compagni sembrano essere a corto di personale, così hanno iniziato a venire qui tutti i giorni per cercare di convincermi a unirmi a loro. Ho rifiutato ogni volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160437
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160437,
					"content": "Oggi, quando è apparsa Julie, devono aver pensato che mi fossi unito a qualche clan o simile, e che stessi cercando di liberarmi di loro. Così ci hanno attaccati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160438,
						220160440
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160438,
					"content": "Che razza di persone irragionevoli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160439
					]
				},
				{
					"id": 220160439,
					"content": "Non si sono mai comportati ragionevolmente. Ma nella loro situazione... non c'è ragionamento che tenga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160444,
					"content": "Mentre lui è andato a occuparsi di loro, io sono rimasta dov'ero in attesa che tornasse. Poi, all'improvviso, è apparso un gruppo di mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160445
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160445,
					"content": "Avresti dovuto essere in grado di affrontarli, no?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160446
					]
				},
				{
					"id": 220160446,
					"content": "Normalmente, sì. Ma quel giorno non avevo mangiato niente prima di partire, avevo troppa fame e mi mancavano le energie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160447
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160447,
					"content": "Ho perso tutti gli spiedini di pollo e funghi che avevo con me quando sono stata adocchiata da quei Kairagi... Per fortuna c'era zio Munehisa a proteggermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160448,
						220160449
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160448,
					"content": "Ecco perché la colazione è un pasto importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160450,
					"content": "Ci sono ancora tanti Kairagi folli a Inazuma. Saremo qui ancora per un po' e non sembra una situazione sicura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160451
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160451,
					"content": "Possiamo affrontare qualche mostro debole, ma sarà impossibile gestire un gruppo di persone che conoscono le arti marziali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160452
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160452,
					"content": "Ehm... Zio, dicevi di cercare lavoro, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160453
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160453,
					"content": "Ti andrebbe di venire con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160454
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160454,
					"content": "Sì, sarebbe fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160455
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160455,
					"content": "Ma visto che lui è un samurai che ha lasciato lo Shogunato... non ci metterà nei guai a Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160456
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160456,
					"content": "È vero. Se venissi con voi potrei mettervi in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160457
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160457,
					"content": "Ahahah, non penso che abbia importanza! Stiamo solo andando in giro alla ricerca di ingredienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160458
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160458,
					"content": "La cosa migliore da fare, nella sua situazione, è starsene lontano da qualsiasi faccenda relativa a Shogunato e samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160459
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160459,
					"content": "Quando lavori per qualcuno in veste di guardia o addetto alla sicurezza, è normale attirare l'attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160460
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160460,
					"content": "In più, non sarebbe giusto lasciare che un tipo come te muoia di fame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160461
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160461,
					"content": "In qualità di chef, dubito di poter risolvere molti problemi nel mondo, ma posso almeno assicurarmi che tu sia ben nutrito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160462
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160462,
					"content": "Signore, voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160463
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160463,
					"content": "Eheh. Beh, che ne pensi? Ti andrebbe di unirti a noi? Non possiamo offrirti molti Mora, ma il cibo non mancherà mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160464
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160464,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160465
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160465,
					"content": "In tal caso, sono al vostro servizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160466
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160466,
					"content": "Evviva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160467
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160467,
					"content": "È una cosa positiva, giusto? Sì, è la soluzione migliore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160468
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160468,
					"content": "Bene! Dopo tutte queste fatiche sono sicuro che abbiamo tutti una gran fame. Non è un bel posto dove cucinare, ma... troverò il modo di preparare qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160469
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160469,
					"content": "#Viaggiat{F#rice}{M#ore}, riposati. Ci penso io. Aspetta qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160470
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160470,
					"content": "Va bene. È ora di cominciare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160471
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160471,
					"content": "Fatto... ahah. Onigiri con riso avanzato. Sono un po' duretti... ma vi riempiranno lo stomaco. Forza, si mangia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160472
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160472,
					"content": "#Viaggiat{F#rice}{M#ore}, grazie per l'aiuto. Questa ricetta è per te. Me l'ha data zio Munehisa e te ne ho fatta una copia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160473
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160473,
					"content": "Ha detto di averla imparata mentre lavorava per lo Shogunato. È molto particolare. Se ti va puoi provarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160474
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160474,
					"content": "Bando alle ciance, è ora di mangiare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220160449,
					"content": "Beh, immagino che d'ora in poi non salterai più la colazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160440,
					"content": "Tipi permalosi, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160441
					]
				},
				{
					"id": 220160441,
					"content": "Non mi sorprende vista la loro posizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160442
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160442,
					"content": "Credo che cercassero solo una scusa per disfarsi di una persona disobbediente come me. Volevano esercitare un po' il loro potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160443
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160443,
					"content": "Dopotutto li ho rifiutati più volte. Per loro dev'essere stato un affronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160425,
					"content": "Tutti i Kairagi sono...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160426
					]
				},
				{
					"id": 220160426,
					"content": "Non tutti. Comunque, quelli erano dei codardi che alzavano la spada contro i più deboli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160427,
					"content": "Perché hai lasciato lo Shogunato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160428
					]
				},
				{
					"id": 220160428,
					"content": "Perché... non ero d'accordo con quello che lo Shogunato stava facendo a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160429
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160429,
					"content": "Sono solo un marzialista. Non so cosa può essere giusto o sbagliato per Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160430
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160430,
					"content": "Sapevo solo che andava contro ciò che reputavo giusto, così ho scelto di andarmene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160431
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160431,
					"content": "Eheh. Forse ero troppo all'antica... Non ridere, ti prego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
		{
			"id": 2201605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
