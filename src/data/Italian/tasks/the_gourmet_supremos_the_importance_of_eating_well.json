			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Parvaneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160701,
					"content": "Non posso credere che quei due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160702,
					"content": "Ancora non ti fidi di lui, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "Intendi Kamei Munehisa? Certo che no... l'abbiamo visto solo alcune volte, come faccio a fidarmi di lui così all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160704,
					"content": "Non mi fido di Kamei Munehisa, ma mi fido del giudizio di Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160705,
					"content": "Fai parte dell'Akademiya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "Diciamo di sì. All'inizio stavo facendo ricerche sul campo per conto dell'Akademiya, quando ho incontrato Xudong a Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160707,
					"content": "Lui stava pianificando di fare dei viaggi per trovare ricette e l'argomento che studiavo era collegato al cibo. Dopo averne parlato un paio di volte, abbiamo deciso di viaggiare insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160708,
					"content": "Prima siamo andati a Mondstadt, dove alcuni mostri ci hanno circondato. A quel punto è arrivata Julie e ci ha aiutato a cacciarli via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160709,
					"content": "Quando ha sentito che stavamo viaggiando per provare cucine diverse, si è unita a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160710,
					"content": "Ha detto di voler andare all'avventura, ma ho la sensazione che volesse solo mangiare buon cibo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160711,
					"content": "La nostra prossima tappa è Sumeru. Ho quasi terminato la mia ricerca, quindi è arrivato il momento di tornare all'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160712,
					"content": "Quando arriveremo a Sumeru, farò in modo che assaggino le nostre specialità locali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160713,
					"content": "Arrivederci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160714
					]
				},
				{
					"id": 220160714,
					"content": "Va bene, ciao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
		},
		{
			"id": 2201608,
