			"trigger": {
				"objectNames": [
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160801,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160802,
						220160807,
						220160814,
						220160819
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160802,
					"content": "Perché hai accettato di unirti a Xudong?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "Come ha detto Xudong, se voglio avere abbastanza da mangiare... lavorare per lui al momento è la mia opzione migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160804,
					"content": "Poi Julie e Xudong hanno una solida tempra morale e sarà un onore viaggiare con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160805,
					"content": "Parvaneh... è una persona premurosa. Capisco perché è diffidente nei miei confronti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160806,
					"content": "Del resto è solo un po' sospettosa, non mi ha ostracizzato immediatamente, e questo... mi basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160807,
					"content": "Davvero hai vagabondato finora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "Sì. Non mentirei mai. Da quando ho lasciato lo Shogunato ho vagabondato qui e là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160809,
					"content": "Di solito mi riempio la pancia di frutti selvatici e, se sono fortunato, cacciagione di giornata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160810,
					"content": "Occasionalmente aiuto la gente a respingere i mostri o i Kairagi, e così ricevo piccoli compensi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160811,
					"content": "Eheh... Per uno come me, la cui unica abilità è saper usare la spada, le opportunità lavorative sono un po' scarse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160812,
					"content": "Per non parlare del fatto che ho lasciato lo Shogunato. La gente mi associa sempre ai Kairagi, e questo rende ancora più difficile trovare lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160813,
					"content": "Non ho una casa o una famiglia a Inazuma. Dal momento che non avevo un posto dove andare, mi sono messo a vagabondare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160814,
					"content": "Perché hai lasciato lo Shogunato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160815
					]
				},
				{
					"id": 220160815,
					"content": "Perché... non ero d'accordo con quello che lo Shogunato stava facendo a Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160816
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160816,
					"content": "Sono solo un marzialista. Non so cosa può essere giusto o sbagliato per Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160817
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160817,
					"content": "Sapevo solo che andava contro ciò che reputavo giusto, così ho scelto di andarmene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160818
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160818,
					"content": "Eheh. Forse ero troppo all'antica... Non ridere, ti prego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160819,
					"content": "Alla prossima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160820
					]
				},
				{
					"id": 220160820,
					"content": "Arrivederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		}
	]
