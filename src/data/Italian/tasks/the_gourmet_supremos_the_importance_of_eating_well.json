			},
			"dialogs": [
				{
					"id": 220160601,
					"content": "Eheh! È un piatto davvero delizioso, farò sicuramente il bis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160602,
						220160606,
						220160609
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160602,
					"content": "Perché volevi portargli del cibo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160603
					]
				},
				{
					"id": 220160603,
					"content": "Beh... non volevo che morisse di fame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160604
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160604,
					"content": "L'ultima volta che l'ho visto sembrava triste. Ho pensato che fosse perché non aveva abbastanza cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160605
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160605,
					"content": "Quindi volevo che assaggiasse qualcosa. Ho pensato che una volta sazio non sarebbe stato così triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160606,
					"content": "Perché ti sei fidata di lui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160607
					]
				},
				{
					"id": 220160607,
					"content": "Potrei definirlo... intuito da avventuriera. Sono bravissima a distinguere i buoni dai cattivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160608
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160608,
					"content": "Solo le brave persone offrono cibo quando hanno fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220160609,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160610
					]
				},
				{
					"id": 220160610,
					"content": "Ciao. Non salterò mai più la colazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
		{
			"id": 2201607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
