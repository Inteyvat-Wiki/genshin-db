			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "Le avete appese tutte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150302,
					"content": "Tutto fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "Miao miao, meraviglioso. Ora il santuario sarà di certo più vivace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150305,
					"content": "Mmmh. Perché ancora non arrivano gli umani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150306,
					"content": "Penso che ci vorrà un po' di tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "#Ah, gli umani sono così difficili da capire. Beh, tu sei un'eccezione, naturalmente, sei più illuminat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150309,
					"content": "Beh, non ci saranno ancora persone... ma almeno quei furfantelli non si perderanno più, miao miao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150310,
					"content": "L'uomo della pietra dice che il suo sasso sarà pronto molto presto, venite a vederlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150311,
					"content": "Mmmh, sì, c'era un'altra cosa, una cosa strana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150312,
					"content": "Sono andata a chiedere a quei due umani verdi notizie di Hibiki e Domeki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150313,
					"content": "Entrambi hanno detto che non conoscono Hibiki e non l'hanno mai sentita nominare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150314,
					"content": "Ma l'umano verde alto ha detto che ha letto di un \"Ako Domeki\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150315,
					"content": "Ha detto... \"bandito\" questo e \"taglia\" quello... Comunque sia, stava cercando di dire che Domeki era una brutta persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150316,
					"content": "Ci deve essere un errore... Hibiki giocava sempre con lui, quindi Domeki dovrebbe essere una brava persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150317,
					"content": "#Quell'umano dev'essere un po' limitato. Sembra che, alla fine, l'uman{F#a}{M#o} più affidabile sia sempre tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150318,
					"content": "Ah, quando tornerà Hibiki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150307,
					"content": "Non è così semplice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}