			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "Spero che stavolta spunti fuori, ormai sto finendo le piste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "Come mai sei qui? Se vuoi saperne di più sulla Gilda, parla con Katheryne laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080104,
					"content": "#Ah, sei già un{M# }{F#'}avventuriere? Allora mi scuso. Sono la Presidentessa, ma non mi occupo personalmente della gestione giornaliera della Gilda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080105,
					"content": "#Infatti non conosco i nuovi arrivati... Detto ciò, non mi sembri esattamente {M#un novellino}{F#una novellina}, vero? Sembri avere una certa esperienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080106,
					"content": "Se è così, forse potresti darmi una mano. Voglio precisare che non si tratterebbe di una missione per la Gilda, ma più che altro di un incarico da parte mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080107,
					"content": "Accetto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "Apprezzo l'entusiasmo, ma non è molto furbo accettare un incarico senza prima esaminarne i dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080111,
					"content": "Se deciderai di accettare l'incarico, dovrai sconfiggere due Hilichurl molto forti, provvisti di scudi giganteschi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080112,
					"content": "Quegli scudi sono infusi dell'energia di Geo. Non saranno esageratamente pericolosi, ma fai comunque attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080113,
					"content": "Ti chiedo solo di batterli, poi torna da me e riceverai una ricompensa adeguata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080114,
					"content": "Ah, a proposito, se trovi qualcosa di riconducibile a una spada... comunicamelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080115,
					"content": "Altrimenti non importa, basta che tu sconfigga gli Hilichurl e riceverai comunque la tua ricompensa. Tutto qua. Vai pure a prepararti, ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080108,
					"content": "Dimmi di più e valuterò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "Una risposta cauta... Penso tu abbia appreso con le cattive il valore della circospezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2210802,
