			},
			"dialogs": [
				{
					"id": 221080201,
					"content": "Li hai già sconfitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080202,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "#Va bene, non serve correre. Un{M# }{F#'}avventuriere che fa le cose di fretta finisce per mettersi nei guai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221080204,
					"content": "Detto questo... Non trascurare comunque la velocità, dal momento che la ricompensa è basata su quanto rapidamente completerai l'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
