				]
			},
			"dialogs": [
				{
					"id": 761260101,
					"content": "Jahoda? E... signor Zompaynco. Cosa vi porta qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260102,
					"content": "Io... ehm... in realtà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260103,
					"content": "Vorrebbe visitare gli Eredi della Luna gelata, ma non riesce proprio a chiederlo, quindi spera che tu lo possa aiutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260104,
					"content": "Sì! Sì, è proprio così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260105,
					"content": "S-Salve, signorina Lyylikki! Che piacere incontrarla. Ehm... Ho portato questo esemplare di fossile da Natlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260106,
					"content": "Grazie, ma signor Zompaynco... ehm... Ci siamo già incontrati, vero? Non c'è bisogno di essere così formali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260107,
					"content": "Uh? Ma... come ha fatto a notarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260108,
					"content": "È sempre stato presente durante la distribuzione dei pasti, non è così? Si avvicinava alla fila camminando avanti e indietro, ma senza mai unirsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260109,
					"content": "Pensavo che ne volesse uno, ma che si vergognasse a chiederlo, così ho tenuto da parte una porzione per lei in segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260110,
					"content": "Ma non è mai venuto a ritirarlo. E se non fosse venuto qui oggi, avrei chiesto a qualcuno di andare a controllare se avesse bisogno di aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260111,
					"content": "Ah... M-Mi scuso. Ho continuato a esitare perché non sapevo come approcciarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260112,
					"content": "Allora, signorina Lyylikki... Sarebbe possibile visitare gli Eredi della Luna gelata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260113,
					"content": "Certamente. Abbiamo ospitato già diversi visitatori stranieri, ma potrei chiederle il motivo di questa visita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260114,
					"content": "Vorrei scattare delle foto, prendere appunti, consultare degli archivi e, se possibile... chiedere in merito alle leggende locali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260115,
					"content": "Sono un membro dell'Associazione delle Reliquie Sauriche di Natlan. Trovare dei materiali relativi alle mie ricerche sarebbe qualcosa di inestimabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260116,
					"content": "Capisco... Quindi vorrebbe consultare gli archivi, ho capito bene? Vediamo un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260117,
					"content": "Beh, visto che le cose sembrano andare per il verso giusto, considererò questo incarico completato. Ora devo tornare a riferire al mio capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260118,
					"content": "Grazie, signorina Jahoda! Ma... devo proprio pagarla per il disturbo. Non sarebbe corretto averla fatta venire qui per nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260119,
					"content": "E per favore, si assicuri di esprimere la mia gratitudine al capo Nefer una volta rientrata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260120,
					"content": "Ci conti. Ora vi lascio. Voi due godetevi la chiacchierata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
