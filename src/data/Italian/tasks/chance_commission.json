				]
			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "Ah... Jahoda? Cosa la porta qui? Mmh... Il capo Nefer è disponibile al momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260202,
					"content": "(Come immaginavo, vuole vedere il capo Nef... Uhm, dovrei riuscire a gestire una faccenda così piccola da sola.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260203,
					"content": "Non serve disturbarsi tanto. In realtà, sono qui perché il capo mi ha mandato ad aiutarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260204,
					"content": "Eh? C-Che cosa intende? Questo significa che il capo Nefer ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260205,
					"content": "Ha sempre voluto fare visita agli Eredi della Luna gelata, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260206,
					"content": "Quindi, il piano è fare amicizia con Lyylikki per prima cosa, e poi chiederle di farsi condurre dagli Eredi della Luna gelata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260207,
					"content": "Cosa?! Lady Nefer ha sempre saputo tutto? Ma l'ho tenuto nascosto nel mio cuore e non l'ho mai detto a nessuno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260208,
					"content": "(Ora è il momento di usare quella frase stupenda che ha detto il capo! Aspetta, com'è che faceva...? Ehm... Ah!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260209,
					"content": "Eheh, signor Zompaynco, quando si custodisce un segreto, bisogna anche saper nascondere il fatto che lo si sta custodendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260210,
					"content": "Altrimenti, non importa quanto alto sia il muro eretto intorno al proprio cuore, il vento lo scalfirà, prima o poi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260211,
					"content": "*sospira* Non sono mai stato bravo a controllare le mie emozioni, nemmeno quando ero ancora nella mia città natale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260212,
					"content": "(EVVAI! L'ho detta bene! Tutta quella pratica ha dato i suoi frutti, eheheh!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260213,
					"content": "Beh, visto che sa già tutto, potrebbe presentarmela? Sono uno straniero, e non voglio disturbare la signorina Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260214,
					"content": "Non si preoccupi, è molto gentile. Che si tratti di un completo sconosciuto o di un essere non del tutto umano, è sempre calorosa e cordiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260215,
					"content": "Oh? Davvero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260216,
					"content": "Ma, in ogni caso, presentarsi da lei senza preavviso è piuttosto scortese... Ehm, ma se lei la conosce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260217,
					"content": "Certo, nessun problema! A quest'ora dovrebbero aver quasi finito di distribuire i pasti. Possiamo andarci subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260218,
					"content": "Ah! A proposito, il capo ha anche detto che per questa volta non ci deve nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260219,
					"content": "Oh, grazie infinite! Vado a prendere le mie cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		}
	]
}