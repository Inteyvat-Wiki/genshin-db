			"dialogs": [
				{
					"id": 740920101,
					"content": "Perché... Perché deve andare così...? È spregevole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920102,
					"content": "Chronie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}! Sei qui! Che gioia... Almeno tu conosci la verità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920105,
					"content": "Stai calma, Chronie. Ti... Ti senti bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920106,
					"content": "Anche se... se il mio articolo non venisse pubblicato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920107,
					"content": "Che cos'ha di sbagliato il tuo articolo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "#Già! Eravamo ansios{F#e}{M#i} di poterlo leggere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920109,
					"content": "Io non l'ho visto... Non l'ho visto, sì... Proprio così... e non l'avrete visto neanche voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920110,
					"content": "Sembri... un po' agitata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "È così... Quando sono tornata dall'Istituto di ricerca di Fontaine, ho iniziato a scrivere il mio articolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920112,
					"content": "Nella bozza ho scritto tutto ciò che ho visto, sentito e percepito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920113,
					"content": "Di come l'Istituto non ha mai completamente rimosso l'Arkhium, e ha piuttosto ripreso un altro progetto di ricerca collegato a esso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920114,
					"content": "Qualcuno che lavorava per conto di Edwin è stato inviato a esplorare le rovine dell'Istituto, ma ha perso la vita in un'esplosione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920115,
					"content": "Raimondo, il tecnico senior, non ha voluto confermare la sua morte e afferma che l'esplosione era pianificata e prevista dal progetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920116,
					"content": "E quelle gigantesche macchine fuori controllo nelle rovine, e l'acqua inquinata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920117,
					"content": "Tutto ciò che l'Istituto di ricerca di Fontaine voleva insabbiare io l'ho riportato per filo e per segno nel mio articolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920118,
					"content": "Però... dopo che l'ho mandato, mi hanno informata che l'Istituto ha intentato una causa contro di me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920119,
					"content": "Secondo le norme editoriali, tutti i fatti che riguardano l'Istituto di ricerca di Fontaine che ho riportato nell'articolo devono essere sottoposti a un esame di attendibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920120,
					"content": "Così il mio articolo sull'argomento è stato rifiutato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920121,
					"content": "Un esame di attendibilità?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "No, l'esame non c'entra nulla col reportage, ma con me nello specifico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920124,
					"content": "In parole povere, l'Istituto di ricerca di Fontaine mi ha accusata di aver inserito pareri soggettivi nell'articolo a causa dei conflitti d'interessi con l'Istituto, e quindi di aver tentato di divulgare informazioni false...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920125,
					"content": "E... tu hai davvero dei conflitti d'interessi con l'Istituto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "Ha solo fotografato qualche roccia consunta e qualche macchina danneggiata... Quali conflitti d'interessi potrebbe mai avere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920127,
					"content": "È perché hai rivelato le loro pratiche immorali?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "Mi... Mi hanno accusata di aver divulgato illegalmente il progetto della loro ultima versione della Fonta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920129,
					"content": "Hanno affermato che alcune delle foto che ho scattato nelle rovine contengono informazioni che riguardano quella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920130,
					"content": "Devono esaminare attentamente tutte le foto. Fino ad allora, non intendono ritirare la denuncia, e io dovrò continuare a essere sottoposta all'esame di attendibilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920131,
					"content": "È chiaramente tutta una montatura per impedire che l'articolo vada in stampa... Ma io non mi arrendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920132,
					"content": "Ecco, prendete questo! È una copia del giornale che ho stampato in segreto. Presto ne distribuirò delle altre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920133,
					"content": "Tutti devono sapere quali verità si nascondono dietro all'Istituto di ricerca di Fontaine, e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920134,
					"content": "Mademoiselle Chronie! Che ci fa ancora qui? L'ho cercata dappertutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920135,
					"content": "Oh, no, arriva qualcuno. Non posso restare qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920136,
					"content": "Ecco la copia, tenetela al sicuro. Tutta la storia è contenuta al suo interno, dalla prima all'ultima parola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920137,
					"content": "A quest'ora dovrebbe trovarsi alla Maison Gestion per sottoporsi all'esame di routine, è la regola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920138,
					"content": "Ehi! La prego, non corra, Mademoiselle Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920139,
					"content": "Si tratta solo di Fonta, e probabilmente c'è stato solo un malinteso! Se lei potesse spiegare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920140,
					"content": "Un attimo! Aspetti, Mademoiselle Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920122,
					"content": "Il tuo giornale non reputa affidabile il tuo reportage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}