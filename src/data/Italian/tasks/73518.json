			"trigger": {
				"objectNames": [
					"Vinayak",
					"Shriya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735180101,
					"content": "Come previsto, l'unità di caricamento funziona senza problemi... Come hai detto, l'ambiente elementale in quest'area sta tornando alla normalità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180102,
					"content": "...Dopo qualche tempo, anche le attività degli Unut si ridurranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180103,
					"content": "Esatto... Grazie al tuo adorato cannone Ammazzaunut, ora possiamo riferire il nostro successo e tornare a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180104
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180104,
					"content": "È il NOSTRO adorato cannone Ammazzaunut, Shriya. Non ho mai dimenticato che questo progetto è stato uno sforzo condiviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180105,
					"content": "...Abbiamo sicuramente avuto le nostre divergenze, ma senza di te non avremmo mai avuto successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180106,
					"content": "Che... Che ti prende? Tutto questo è perché vuoi che metta una buona parola per te nella mia relazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180107,
					"content": "Beh, sento solo che ciò che abbiamo passato è molto simile alla nostra esperienza dell'altr'anno: non è stata una passeggiata, ma alla fine ce l'abbiamo fatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180108,
					"content": "E ammettiamolo: alla fine, la tua soluzione si è dimostrata più efficiente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180109
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180109,
					"content": "Io non... Uh... Non posso prendermi tutto il merito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180110
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180110,
					"content": "...Perché il merito è anche tuo. Se non avessi testato il cannone Ammazzaunut, non avrei ottenuto i dati necessari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180111
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180111,
					"content": "\"Per riparare una macchina potresti solo dover cambiare il motore, ma la vera sfida è trovare il motore...\" Queste parole del mio mentore ora iniziano ad avere senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180112,
					"content": "Sono contento che tu sia qui, Shriya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180113,
					"content": "Uh... Anch'io sono contenta che tu sia qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180114
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180114,
					"content": "Huh? L'atmosfera tra questi due all'improvviso si è fatta totalmente diversa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180115,
						735180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735180115,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				},
				{
					"id": 735180117,
					"content": "Ahah! Quando stavamo lavorando assieme al progetto di laurea, non andavamo molto d'accordo perché non eravamo abbastanza maturi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180118
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180118,
					"content": "È vero. A ripensarci adesso non era niente di serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180119
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180119,
					"content": "Beh... Che ne dici se la prossima volta ci incontrassimo alla caffetteria per bere qualcosa? Potremmo discutere di come scrivere la relazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180116,
					"content": "Lascia stare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				}
			]
		}
	]
}