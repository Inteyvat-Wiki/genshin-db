			"dialogs": [
				{
					"id": 761630101,
					"content": "...Sonnet. Negli ultimi anni hai fatto sempre più spesso finta di lavorare per sgattaiolare fuori e giocare con gli umani, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630102,
					"content": "C-Cosa c'è di strano?! Possiamo lasciare il lavoro agli emissari lunari, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630103
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630103,
					"content": "A voi piace il nostro nuovo padrone, sorelle, e lui è disposto a mandare dei subordinati per condividere il nostro lavoro. Che altro potevo fare a parte accettare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630104
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630104,
					"content": "Tra l'altro, anche tu ti sei divertita un sacco a bighellonare, Canon! Hai persino partecipato a un festival umano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630105
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630105,
					"content": "...Faceva parte dei miei doveri. Il loro Sommo Sacerdote aveva invocato il mio nome, non potevo non rispondere alla sua voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630106,
					"content": "Anche fingere di essere una normale ragazza umana e ballare davanti alla propria statua faceva parte dei tuoi doveri? Per me è una novità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630107,
					"content": "...Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630108
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630108,
					"content": "Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630109
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630109,
					"content": "Non ti stavo chiedendo di dire il mio nome... Ah, lascia perdere. Visto che la nuova emissaria lunare non ha problemi ad aiutare Sonnet con il suo lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630110,
					"content": "Zibai. Si chiama Zibai. Dovresti cercare di memorizzare i nomi delle persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630111
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630111,
					"content": "...Dal momento che Zibai non ha obiezioni, non ho altro da aggiungere. Tuttavia, Sonnet, in quanto Volontà della luna, non puoi dimenticare le formule fondamentali che mantengono il moto del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630112
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630112,
					"content": "Preparati, ti assegnerò dei problemi fondamentali sulla verifica degli isomorfismi morfologici. Non potrai tornare in superficie finché non li avrai risolti tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630113
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630113,
					"content": "Eheh, che cattiveria. Sei proprio come l'antagonista di un romanzo terrestre che vuole riportare la principessa fuggitiva sulla luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630114
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630114,
					"content": "Infatti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630115
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630115,
					"content": "...Tu sei la luna! Non dire cose del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}