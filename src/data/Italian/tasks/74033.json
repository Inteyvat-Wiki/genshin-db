			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Caterpillar",
					"Mitul"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4596.75,
							-46.38,
							4590.743
						],
						"pointId": 4614
					},
					{
						"sceneId": 3,
						"position": [
							4595.909,
							-46.38,
							4592.177
						],
						"pointId": 5582
					},
					{
						"sceneId": 3,
						"position": [
							4595.084,
							-46.38,
							4591.131
						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "Mitul, tutto bene? Spero che tu non sia rimasto intrappolato troppo a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330402,
					"content": "Sei qui, finalmente! Mi hai salvato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330403,
					"content": "Dov'è Koblenz? Non è con voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330404,
					"content": "Mi ha detto che eri intrappolato qui e mi ha chiesto aiuto, ma se n'è andato perché una guardia ci ha interrotti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330405,
					"content": "Lo sapevo che non era affidabile! Probabilmente è corso via perché si sentiva in colpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330406,
					"content": "Voglio dire, come si può guadagnare nel mondo degli affari se non si corrono dei rischi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330407,
					"content": "È stato maldestro e troppo cauto per avviare... Cioè, l'Acqua pura è una cosa, ma perfino la Fonta è disponibile oggigiorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330408,
					"content": "Se la Fonta è qui, come dovremmo sopravvivere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330409,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330410,
					"content": "Che c'è? Piace anche a te la Fonta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330411,
					"content": "Non ti piace la Fonta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "Certo che mi piace! Devo ammetterlo, è un rivale formidabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330415,
					"content": "In ogni caso, devo risolvere la cosa con Koblenz. Comunque, ti ha pagato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330416,
					"content": "No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330417,
					"content": "...A volte vorrei infilarlo in un grosso secchio. Lo farebbe riflettere su quello che ha fatto. Comunque, prendete questi coupon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330418,
					"content": "#{NICKNAME} e Paimon, prendeteli voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330419,
					"content": "Cosa? Vuoi che li prendiamo tutti noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330420,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330421,
					"content": "Beh, che dire? Grazie. Più tardi possiamo andare al Di Tutto un Po' per vedere se hanno qualcosa di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330422,
					"content": "Comunque, vorrei scusarmi per avervi trascinati in tutto questo. Ho delle bevande fresche e salutari... ne volete una bottiglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330423,
					"content": "Bevande fresche... e salutari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330424,
					"content": "Esatto! Più salutari dell'Acqua pura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330425,
					"content": "Ne prendo una.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "(Ehi, Caterpillar non ha detto che non dobbiamo accettare da bere?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330427,
					"content": "#No, non era quello che {NICKNAME} intendeva! Voleva dire che abbiamo già bevuto tanto prima di venire qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330431,
					"content": "Ma Paimon scommette che queste bevande sono buone! La prossima volta le assaggeremo sicuramente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330432,
					"content": "Brutta tempistica, eh? Beh, quando ne avete la possibilità, fate di nuovo un salto, vi offrirò un giro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330433,
					"content": "Comunque, ora devo andare a parlare con Koblenz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330434,
					"content": "Devo occuparmi di un'altra faccenda, per cui devo andare. Non vi preoccupate troppo dei coupon. <color=#00E1FFFF>Metterò gli indizi che trovo sulla lavagna</color>. Incontriamoci dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330435,
					"content": "A dopo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330428,
					"content": "Prendo una Fonta, grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "Beh, allora ne prendo una anch'io. Un attimo. Non ti piacciono le mie bevande salutari? Perché lascia che ti dica che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330430,
					"content": "#{NICKNAME} non intendeva quello! È solo che... abbiamo già bevuto molto prima di venire qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330413,
					"content": "Non è male.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "Un cliente con del gusto, vedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				}
			]
		}
	]
}