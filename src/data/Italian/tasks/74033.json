			"dialogs": [
				{
					"id": 740330101,
					"content": "Nessuno viene più qui dopo che il Tunnel dei geodi è stato chiuso, e i dispositivi che ci sono non li possono usare tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330102,
					"content": "E questo è esattamente quello che è successo stavolta. Qualcuno ha armeggiato con la valvola di trasmissione e ha intrappolato il suo stesso compagno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330103,
					"content": "In ogni caso, apriamo il passaggio per il <color=#00E1FFFF>magazzino di rifornimento n. 1</color>. Comunque, se vi offrono da bere, è meglio che rifiutiate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330104,
					"content": "E chi ci dovrebbe offrire da bere? E perché non dovremmo accettare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330105,
					"content": "Lo scoprirete presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
		{
			"id": 7403304,
			"completionStepIds": [
				7403304
			],
