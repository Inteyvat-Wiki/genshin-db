			},
			"dialogs": [
				{
					"id": 240190301,
					"content": "Che ti avevo detto? Dei veri gentiluomini. Molto più educati di quelle canaglie vicino al Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190302,
					"content": "Davvero ben educati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "Esatto! Stare qui a sedere è così rilassante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190304,
					"content": "Cioè, immagina di essere un gabbiano: la gente viene, ti dà da mangiare, e tutto quello che devi fare è prendere il sole e pensare al senso della vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190305,
					"content": "*sospira* Perché mi ritrovo a essere un funzionario giudiziario e non un gabbiano pescatore violucente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
