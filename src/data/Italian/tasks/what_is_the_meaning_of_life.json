			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "Beh, è tutto quello che ho. Spero che siano satolli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "Sto dando da mangiare a questi gabbiani. Vedi, stanno mangiando a sazietà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "Woah... Quando siete diventati così tanto amici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "Non ti avevano rubato le patatine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "No. A quanto pare la gente viene qui specificamente per dare da mangiare ai gabbiani, per cui non gli interessano le mie patatine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "Ma non avevi detto che, se ti allontani troppo dal tuo luogo di lavoro, rischi di assentarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "Ahahah, non c'è problema. È il mio giorno libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "Nessun collega che mi trascina in conversazioni lavorative e nessuna persona o animale che mi ruba le patatine... Sì, questo posto è semplicemente perfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "I gabbiani qui sono molto amichevoli: non mi rubano le patatine e non mi assalgono causando tafferugli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "Da quando ho dato loro da mangiare un paio di volte, pare abbiano imparato a riconoscermi. Non sembrano opporre resistenza, anche se gli tocco le piume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "Oserei quasi definirli come dei \"perfetti gentiluomini\" se messi a confronto con quelli che circolano al Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "Se potessero usare gli artigli per adoperare la macchina da scrivere, ci potrebbero quasi sostituire nel lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "I gabbiani pescatori violucenti non aiutano le questioni degli umani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "Ma non renderebbero nemmeno le cose peggiori. E tutti sanno che certe cose sono semplicemente troppo difficili per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "Ma lasciamo stare. Ti va di provare a fare amicizia con questi \"gentilgabbiani\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "Ai tuoi occhi, sono già dei gentiluccellini, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "Non si offendono se mi avvicino a loro così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "No, sono molto tolleranti. Finché non gli scompigli le piume, non ti faranno nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "Vieni, ho preparato questo pesce appositamente. Prendilo e mettilo in quella ciotola là.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "Rilassati. I gabbiani pescatori violucenti sono molto tolleranti. Apprezzano chiunque dia loro da mangiare, e non fanno domande sull'origine dei pesci o sul loro metodo di preparazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "Devo fare attenzione a qualcosa mentre tento di farci amicizia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Niente di che, in realtà. Cerca di non toccare direttamente le loro piume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "I gabbiani pescatori violucenti non parlano il nostro linguaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "Non ne sarei così sicuro. Forse fanno solo finta così da poter vivere un'esistenza piacevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
