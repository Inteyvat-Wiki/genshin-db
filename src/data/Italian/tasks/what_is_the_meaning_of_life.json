					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "Come... Come hai potuto? Loro non sono quelle canaglie di fronte al Palais Mermonia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190802,
					"content": "Scusa, non l'ho fatto apposta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "*sospira* Non ho nemmeno avuto il tempo di fermarti. Perché l'hai fatto...? Uno di loro ti ha attaccato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190804,
					"content": "Fa niente, se ne sono andati. Ah, beh, dovrò tornare fra qualche giorno e offrire loro del cibo in segno di scuse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
