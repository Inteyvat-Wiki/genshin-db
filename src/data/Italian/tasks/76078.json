			"dialogs": [
				{
					"id": 760780301,
					"content": "(Anche se i mostri sono spariti, l'oscurità rimane. Potresti aver bisogno dell'aiuto di un professionista che conosce meglio la Caccia selvaggia.)",
					"roleType": "TALK_ROLE_NPC",
