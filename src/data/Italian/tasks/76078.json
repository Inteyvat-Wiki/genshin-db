					}
				]
			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "Qui c'è anche una Lanterna del giuramento. Deve essere appartenuta a qualcuno venuto prima di noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780502,
					"content": "La lanterna è ancora macchiata dalla corruzione della Caccia selvaggia. Non è difficile immaginare cosa sia successo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780503,
					"content": "Dal giorno in cui prendiamo la Lanterna del giuramento, le nostre vite sono legate alla fiamma che brucia al suo interno, fino al momento in cui la nostra legittima missione non sarà compiuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780504,
					"content": "A te, che hai combattuto fino all'ultimo respiro per la pace e la sicurezza di Nod-Krai, offro il mio più profondo rispetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780505,
					"content": "Per ora prenderò io la tua lanterna. Stai tranquillo, la corona degli eroi caduti custodirà la tua eredità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780506,
					"content": "La riporterò al quartier generale, ne ravviverò la fiamma e la affiderò a qualcuno degno di portare avanti la tua volontà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780507,
					"content": "Illuga pulisce la lanterna, poi la ripone con attenzione.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "E così, la Caccia selvaggia è stata spazzata via da questo luogo e lo spirito del nostro predecessore ha finalmente trovato pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}