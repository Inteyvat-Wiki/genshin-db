							9661.866
						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "Oh, una lanterna. Questo è un oggetto che tutti i Guardaluce portano con sé, ed è uno strumento chiave per disperdere la Caccia selvaggia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780202,
					"content": "La lanterna è ancora qui, e su di essa persiste il tanfo della permeazione della Caccia selvaggia. Il portatore, tuttavia, non si trova da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780203,
					"content": "Capisco. Sebbene sia sconcertante, non è difficile dedurre cosa sia successo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780204,
					"content": "I sacrifici dei nostri fratelli Guardaluce sono a volte silenziosi come un sussurro. Scoprire che i miei colleghi sono morti in questo modo è... sempre un peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780205,
					"content": "...Permettimi di prendermi cura della lanterna che hai lasciato, persona senza nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780206,
					"content": "Il suo corpo sarà purificato e la sua luce sarà riaccesa. Troverà una nuova casa tra le braccia di un altro Guardaluce che ha giurato di proteggere Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780207,
					"content": "Flins pulisce la lanterna, poi la ripone con attenzione.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "Questa lanterna dev'essere il motivo per cui la Caccia selvaggia non è scomparsa del tutto. La terrò con me finché qualcuno del quartier generale non verrà a recuperarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780209,
					"content": "...Aspetta, c'è qualcosa sotto la lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780210,
					"content": "Deve essere una reliquia lasciata dallo stesso collega. Dovrebbe rimanere insieme alla sua lanterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
