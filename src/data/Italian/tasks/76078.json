				]
			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "Di solito, una volta eliminati i mostri nei paraggi, le faglie da queste parti dovrebbero svanire da sole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780402,
					"content": "Allora perché la presenza della Caccia selvaggia permane ancora qui... È fin troppo strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780403,
					"content": "Che mi sia sfuggito qualcosa? Qualcos'altro contaminato dalla Caccia selvaggia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
