			"dialogs": [
				{
					"id": 760780101,
					"content": "Di norma, una volta sconfitti tutti i mostri che seguono la Caccia selvaggia, il tanfo della contaminazione dovrebbe svanire insieme a loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780102,
					"content": "Ma questa fenditura persiste... Insolito, ma non senza precedenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780103,
					"content": "È il caso di perlustrare la zona. Forse c'è ancora qualcosa di impuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
