			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970301,
					"content": "Hihi, è così che dovrebbe essere sempre! È questa la connessione stabile con la Statua dei Sette che stavamo cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970302,
					"content": "Quindi il problema che abbiamo avuto era dovuto a quel cattivone nel Regno della Notte, eh? La Statua dei Sette dev'essersela passata proprio male... Ottimo lavoro, Statua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970303,
					"content": "#Beh, non avresti potuto {F#conferirle}{M#conferirgli} il potere di risuonare con Pyro nemmeno se avessi voluto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970304,
					"content": "Sì, è successo mentre combattevo al fianco dell'Archon di Pyro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970305
					]
				},
				{
					"id": 750970305,
					"content": "Paimon era terrorizzata... Ma, a quanto pare, sei davvero troppo forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970306,
					"content": "In ogni caso, è fantastico che siamo riusciti a sbarazzarci di tutti quei mostri dell'Abisso e a riportare le statue come prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}