			"dialogs": [
				{
					"id": 402010401,
					"content": "Ok, abbiamo finito con le bombe sul ponte. Che ne pensi della stiva? Facciamo in tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010402,
					"content": "È già tutto sistemato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010403,
					"content": "#Ottimo lavoro, voi due. Siete {F#rimaste calme}{M#rimasti calmi} e avete agito in fretta. È stata la risposta perfetta a una situazione come questa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010404,
					"content": "#Yelan! Onestamente, è stato tutto merito tuo. È stata una tua idea salire a bordo della nave. E non saremmo mai {F#riuscite}{M#riusciti} a decifrare quel messaggio senza il tuo cifrario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010405,
					"content": "Un momento... Dove sono Corder e Doddamani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010406,
					"content": "Eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010407,
					"content": "A riprendersi dallo shock, immagino. Scoprire di essere nel mirino di un individuo pericoloso... Sarà stata un'esperienza traumatica per voi, giusto? Avete quasi perso tutto il carico e la vostra vita in un colpo solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010408
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010409
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010409,
					"content": "Sì. E pensare che al mondo possa esistere qualcuno di tanto malvagio... Cos'avrò mai fatto per meritarmi di morire...? È incomprensibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010410
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010410,
					"content": "Beh, non abbiate paura. Avviserò subito la Maison de la Garde e chiederò loro d'inviare degli agenti a Porto Lumidouce. Voi due avete urgente bisogno di protezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010411,
					"content": "Inoltre, la merce dovrà essere ispezionata dalle autorità, Corder, per eliminare ogni potenziale pericolo. Dopodiché, la Maison de la Garde scorterà il carico alla sua destinazione, naturalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010412,
					"content": "Quindi, se posso chiedere... Dov'è diretta la merce, Corder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010413
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010413,
					"content": "All'Hotel Débord. Ci sarà un'asta tra due giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010414
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010414,
					"content": "Ah, allora puoi stare tranquillo. Gli agenti della Maison de la Garde sono diligenti e responsabili. Ti assicuro che la tua merce arriverà all'asta senza un graffio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010415
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010415,
					"content": "Grazie di cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010416
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010416,
					"content": "Poco dopo, la nave attracca a Porto Lumidouce. La Maison de la Garde conduce un'ispezione di sicurezza e scarica tutte le merci.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010417
					]
				},
				{
					"id": 402010417,
					"content": "Nel frattempo racconti a Yelan del biglietto lasciato dal Baro a Corder e Doddamani.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
