			"dialogs": [
				{
					"id": 402010201,
					"content": "Gentili passeggeri, vi porgiamo le nostre scuse per il disagio. A causa dello spazio limitato nella stiva, parte del carico dovrà essere posizionato sul ponte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010202
					],
					"speakerTitle": "Membro dell'equipaggio"
				},
				{
					"id": 402010202,
					"content": "Ah, non dovete scusarvi per il vostro successo negli affari! Spero solo che contagi anche il resto di noi, ahahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010203
					],
					"speakerTitle": "Passeggero amichevole"
				},
				{
					"id": 402010203,
					"content": "Sembra che tutte le merci con il simbolo del Baro siano state inviate da Corder. Doddamani è nella stiva a controllare che tutte le merci siano pronte per la consegna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010204
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010204,
					"content": "Stanno... ispezionando qualcosa? Perché stanno rovistando in quelle casse? Paimon non riesce a capire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010205,
					"content": "Ecco, prendi questo cifrario. Ti aiuterà a decifrare i loro messaggi in codice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010206,
					"content": "Ecco il piano: mentre io distraggo Corder e Doddamani, voi due esaminate la merce che reca il simbolo del Baro. Potremmo scoprire qualcosa di utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010207,
						402010208
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010207,
					"content": "Se trovo qualcosa di preoccupante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				},
				{
					"id": 402010209,
					"content": "Assolutamente sì. Mi fido del tuo giudizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010210
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010210,
					"content": "Eh? A-Aspetta! Vuoi andarci a parlare?! Yelan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010211,
					"content": "Mm? Oh, chiedo scusa, gentiluomini, ma... ci conosciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010212
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010212,
					"content": "Sei Corder, il famoso antiquario del Quartiere Lyonnais, giusto? Credo che ci siamo già incontrati una volta. Nella Sala da tè Jiulue sul Pontile Yilong, se non erro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010213
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010213,
					"content": "Eh? Sei... tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010214
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010214,
					"content": "...Ah, la Maestra dei dadi della Sala da tè Yanshang... Che piacere, Yelan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010215
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010215,
					"content": "Ah, dunque sai chi sono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010216
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010216,
					"content": "Sì, una volta mi sono gustato un tè assolutamente squisito in quel posto. Alla Sala da tè Yanshang è praticamente impossibile non sentire parlare delle tue leggendarie abilità con i dadi. E sembra che l'amore per il tè continui a farci incontrare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010217
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010217,
					"content": "Già, proprio così... Beh, ci siamo incontrati al momento giusto. Sto per andare in vacanza a Fontaine. Hai qualche consiglio su cosa visitare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010218
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010218,
					"content": "Magari un posto dove trovare del tè squisito...? O una mostra d'arte? Oppure un'asta? Ho sentito dire che il tè nero di Fontaine ha un sapore unico. Immagino che anche i vostri servizi da tè siano una gioia per gli occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010219
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010219,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010220
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010220,
					"content": "Ah, anche a questo gentiluomo interessano i servizi da tè?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010221
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010221,
					"content": "Io... Ahem! Naturalmente. Piacere di conoscerti, Yelan. Anch'io sto andando a Fontaine, su invito di Corder. Anche se, a dire il vero, questa nave è mia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010222
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010222,
					"content": "Sì, Yelan sta davvero parlando con loro! Sarà una buona idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010223,
						402010224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010223,
					"content": "Non abbiamo molto tempo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010225,
					"content": "Va bene! Allora andiamo in un posto dove non possano vederci per iniziare a esaminare quelle casse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010226,
					"content": "*tossisce* Queste casse emanano un odore molto forte... Sembra che contengano merce di ogni tipo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010227,
					"content": "E c'è anche uno strano biglietto. Ma Paimon non riesce a leggerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010228,
						402010229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010228,
					"content": "È scritto in codice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010230,
					"content": "Yelan pensa veramente a tutto! Ma, ehm... Sai come usarlo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010231,
					"content": "Beh? Allora? Cosa c'è scritto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010232,
						402010233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010232,
					"content": "Se ho ragione, vogliono sbarazzarsi della merce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010234,
					"content": "F-F-Facendo esplodere la nave?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010235,
					"content": "Ma sono fuori? Paimon pensava che volessero passare inosservati! Non attirare l'attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010236,
						402010237,
						402010238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010236,
					"content": "Il Baro sta proteggendo il capo dell'operazione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010239,
					"content": "Ok, Yelan aveva ragione! Questo tizio sta fuori come una campana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010240,
					"content": "Ci sono delle persone innocenti a bordo di questa nave! Dobbiamo trovare le bombe e disinnescarle il prima possibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010237,
					"content": "Quindi vuole distrarci con qualcosa di ancora più grande...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010238,
					"content": "E rendere nulle tutte le nostre piste...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010233,
					"content": "...Facendo esplodere la nave.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010229,
					"content": "Per fortuna abbiamo il cifrario...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010224,
					"content": "Ci sta dando un'opportunità! Sfruttiamola!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010208,
					"content": "Posso occuparmene seduta stante?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				}
			]
		},
		{
