			},
			"dialogs": [
				{
					"id": 402010301,
					"content": "Oh, hai fatto prendere un colpo a Paimon, Yelan! Andarci a parlare così di punto in bianco... E se avessero capito tutto e... compiuto un gesto disperato?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010302,
					"content": "Non è una questione di \"se\", Paimon. Sanno perfettamente cosa comporterebbe... Ma, nell'interesse della loro sopravvivenza, hanno dovuto stare al gioco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010303
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010303,
					"content": "Ora sappiamo che il Faccendiere Nero sta perdendo il controllo. Sulla nave non ha fatto altro che tagliare la corda per salvarsi la pelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010304
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010304,
					"content": "Voleva sbarazzarsi di tutto ciò che avrebbe potuto collegarlo alla sua attività criminale. Facendo esplodere la nave, la merce per l'asta finisce in fondo al mare, e tutte le colpe ricadono sul Baro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010305
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010305,
					"content": "L'ultima cosa che voleva era che la merce raggiungesse la casa d'aste. Ma adesso abbiamo la certezza che arriveranno, per cui ora non ha altra scelta che completare l'operazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010306
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010306,
					"content": "Avrebbe potuto scegliere di non mandare uno dei suoi intermediari all'asta, facendo acquistare la merce a un acquirente ignaro. Ma non dobbiamo dimenticarci che il suo valore era gonfiato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010307
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010307,
					"content": "L'acquirente si sarebbe accorto dell'errore nella valutazione e lo avrebbe segnalato alle autorità. In quanto venditore, Corder sarebbe stato condannato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010308
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010308,
					"content": "Nel migliore dei casi, il Faccendiere Nero dovrebbe escogitare un nuovo piano per riciclare i Mora. Nel peggiore dei casi, perderebbe uno dei suoi ultimi intermediari fidati a Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010309,
						402010310
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010309,
					"content": "E, se dovesse decidere di vendere la merce all'asta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				},
				{
					"id": 402010311,
					"content": "Esattamente. La nostra scia di prove è ancora intatta, e abbiamo lasciato che l'acquirente all'asta ci conducesse al Faccendiere Nero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010312
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010312,
					"content": "D'accordo, ehm... Quindi, uh... Questo significa che, ehm... Potresti ripetere tutto quanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010313,
					"content": "#Non preoccuparti. {NICKNAME} te lo rispiegherà con parole a prova di Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010314
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010314,
					"content": "#Siamo in dirittura d'arrivo, e l'asta sarà la fase cruciale... Per cui, teniamoci {F#pronte}{M#pronti}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010315
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010315,
					"content": "L'agente Edler ha già un informatore sulla scena. Questa lettera d'invito vi consentirà di accedere all'asta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010316
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010316,
					"content": "Ci rivedremo all'Hotel Débord fra due giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010310,
					"content": "Sarà comunque un vantaggio per noi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				}
			]
		},
