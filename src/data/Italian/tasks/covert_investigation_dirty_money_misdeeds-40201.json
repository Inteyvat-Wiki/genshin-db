				]
			},
			"dialogs": [
				{
					"id": 402010501,
					"content": "Ok, è confermato. Quei due sono estremamente impazienti di trasportare tutto il loro carico a Fontaine in una volta sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010502,
					"content": "Ma quegli strani simboli? Cosa significano...? Andiamo a chiedere a Yelan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010503,
					"content": "Trovate Yelan e le racconti dei risultati dell'indagine...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010504
					]
				},
				{
					"id": 402010504,
					"content": "Ottimo lavoro. Per quanto riguarda l'asta, l'agente Edler è riuscita a raccogliere delle informazioni utili. Abbiamo praticamente la certezza che il loro obiettivo è l'asta che si svolgerà all'Hotel Débord tra due giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010505
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010505,
					"content": "I simboli che avete trovato sono stati applicati con una vernice speciale. È quasi impossibile vederli senza una tecnologia speciale come lo Scanner forense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010506
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010506,
					"content": "Credo che si tratti di un emblema dei Cacciatori di tesori. Tutti i pezzi grossi dell'organizzazione ne hanno uno. Una sorta di firma personale, si direbbe. E, considerando quello che sappiamo sul caso, scommetto che quello appartiene al Baro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010507,
						402010508
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010507,
					"content": "Quindi... sta etichettando la merce? Ma perché?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010509
					]
				},
				{
					"id": 402010509,
					"content": "In base al manifesto di carico del porto, sembra che le merci segnate includano... un fertilizzante di Sumeru, dei fuochi d'artificio locali, del sapone e del profumo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010510
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010510,
					"content": "Niente di speciale, quindi... Solo dei prodotti per l'agricoltura e per uso quotidiano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010511,
					"content": "Fertilizzante, sapone e profumo... No, c'è qualcosa che non va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010512
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010512,
					"content": "Potrebbe essere rischioso, ma voglio indagare a bordo, e già che ci sono mi farò portare a Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010513,
						402010514
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010513,
					"content": "#{F#Arrivate}{M#Arrivati} a questo punto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010515,
					"content": "Sì, vediamo di risolvere questa faccenda una volta per tutte! Paimon deve sapere che sta succedendo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010516,
					"content": "Beh, finora avete dato prova del vostro valore, quindi non ci vedo alcun problema. Tuttavia, una volta a bordo, è probabile che ci troveremo faccia a faccia con Corder e Doddamani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010517
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010517,
					"content": "Perciò, preparatevi. Questa volta, la nostra indagine potrebbe prendere una piega inaspettata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010514,
					"content": "Verremo con te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010515
					]
				},
				{
					"id": 402010508,
					"content": "Che informazioni sta cercando di trasmettere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010509
					]
				}
			]
