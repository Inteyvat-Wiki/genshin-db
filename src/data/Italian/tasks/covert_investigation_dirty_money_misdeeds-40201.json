			"dialogs": [
				{
					"id": 402010101,
					"content": "Ben fatto, voi due. Giusto in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010102,
					"content": "Come procede il caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "Il giorno dopo il nostro ingresso nella loro base, i due tirapiedi del Faccendiere Nero, Corder e Doddamani, hanno iniziato a spostare la merce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010105,
					"content": "Vedi quella nave? È stata inviata da Doddamani proprio per questo. Opera come nave merci e passeggeri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010106,
					"content": "Woah, è una nave enorme! Paimon riesce a vedere tutte le merci ammassate sul molo! Sembra che trasporti anche un bel po' di passeggeri a Porto Lumidouce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010107,
					"content": "E se non fossero le merci che stiamo cercando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "Stai già pensando alla prossima mossa, eh? Mi piace. Impari in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010110,
					"content": "Se Corder e Doddamani pensano che le autorità gli stiano alle calcagna, è possibile che la merce che stanno inviando a Porto Lumidouce sia solo un mucchio di ciarpame. Un'esca per far uscire allo scoperto le forze dell'ordine sulle loro tracce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010111,
					"content": "Ma dobbiamo essere prudenti. Diversi membri dell'equipaggio hanno confessato che un Cacciatore di tesori veterano, conosciuto come il \"Baro\", è coinvolto con il Faccendiere Nero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010112,
					"content": "Il Baro è un fuggitivo e un esperto nel nascondersi. Secondo le nostre prime indagini, è chiaro che sia stato lui a perlustrare l'area del faro dei Milleliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010113,
					"content": "Io sorvolerò l'area per distogliere l'attenzione del Baro, voi due invece ispezionerete la merce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010114,
					"content": "Ricordate di non dare nell'occhio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010115,
					"content": "Ricevuto. Faremo attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#Sì! E Paimon farà del suo meglio per... volare bassa! Sempre sotto le spalle di {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010116,
					"content": "Non preoccuparti. Ci pensiamo noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "Dovremmo controllare, per sicurezza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "Qualche sviluppo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
