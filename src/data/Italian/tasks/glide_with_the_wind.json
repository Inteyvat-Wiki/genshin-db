	"talks": [
		{
			"id": 48101,
			"completionStepIds": [
				48101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48101",
							"2"
						],
						"stepId": 48101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "Abbastanza bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "Continuo a farmi prendere la mano e a volare troppo in alto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#Ehi, {NICKNAME}! Ti ho cercat{F#a}{M#o} dappertutto! Come va con l'aliante che ti ho dato l'altra volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810104,
					"content": "Sembra che tu ci stia prendendo gusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810105,
					"content": "Però non hai un brevetto di volo a vela, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810106,
					"content": "Un brevetto di volo a vela? Mmh... E cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810107,
					"content": "Non è ovvio? Ti serve un brevetto di volo a vela per poter volare legalmente a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810108,
					"content": "#Oh... Ma {NICKNAME} e Paimon volano da parecchio tempo ormai. Questa è la prima volta che ne sentiamo parlare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810109,
					"content": "Sì, avete volato un po' dappertutto... L'hanno notato tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810110,
					"content": "Eh-he!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810111,
					"content": "Quiiindi... Sei venuta a cercarci perché vuoi darci un brevetto di volo a vela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810112,
					"content": "Ma ti pare! I Cavalieri di Favonius hanno regole severe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810113,
					"content": "I Cavalieri vi rilasceranno il brevetto solo dopo aver superato un esame apposito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810114,
					"content": "#Oggi sono qui in veste di esaminatrice per valutare l'esame ufficiale di volo a vela di {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810115,
					"content": "Sono stata io a darti l'aliante, quindi è mia responsabilità. O almeno così direbbe la Gran Maestra Reggente Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810117,
					"content": "...Ci andrai piano con me, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "D'accordo. Posso farcela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "Un esame! Che rottura di scatole. Però, dato che l'esaminatrice è Amber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810118,
					"content": "Assolutamente no! N-O! Chiaro?! Non sottovalutare l'autorità dell'esaminatrice Amber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810120,
					"content": "#Sono sicura che filerà tutto liscio, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810121,
					"content": "Voglio dire... L'intera città ha visto come hai volato bene il giorno dell'attacco di Terrore alato, sono certa che non avrai problemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810122,
					"content": "Ma è importante rispettare le regole e volare correttamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810123,
					"content": "Tieni, prendi questo manuale di volo a vela. Non devi impararlo a memoria, basta che tu prenda dimestichezza con il contenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810124,
					"content": "Per esempio: solo una persona per aliante, non superare il limite di carico indicato, non decollare usando un Melmoso di Anemo, e così via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810125,
					"content": "Comunque, vedi di leggerlo, va bene? Anch'io ho dovuto leggere un sacco di libri pesantissimi quando Lisa mi stava insegnando la magia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810126,
					"content": "Wow, che librone... Secondo Paimon, è meglio iniziare subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810127,
					"content": "Bene. Venite a cercarmi quando avete finito, sarò a Levanteolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810401,
					"content": "*sospira* Il manuale di volo a vela dei Cavalieri di Favonius NON sembra una lettura divertente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810402,
					"content": "Beh, sarà meglio che cominci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "Sembra quasi una fiaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "La gente di Mondstadt coglie appieno l'aspetto romantico del volo a vela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "Mmh... È una storia interessante... Ma il manuale di volo a vela dei Cavalieri è davvero scritto in quello stile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810604,
					"content": "Ma pensa. Comunque, andiamo a cercare Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}