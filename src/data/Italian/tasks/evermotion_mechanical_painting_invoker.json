			},
			"dialogs": [
				{
					"id": 705330101,
					"content": "Che sorpresa. E pensare che la mia invenzione può essere usata in questo modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330102,
					"content": "#Ah, viaggiat{F#rice}{M#ore}! Ci rivediamo, a quanto pare... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330103,
					"content": "Pensavo che avessi già lasciato Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "Era mia intenzione, sì, ma... le cose cambiano, sai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330108,
					"content": "*tossisce* Ma torniamo a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330109,
					"content": "Questa volta, mi hanno invitato alla Gilda degli avventurieri di Mondstadt per creare diversi dipinti meccanici sulla base di alcune facce di carte che possono essere disassemblate e riassemblate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330110,
					"content": "Per quanto riguarda il gioco di carte, di cosa si trattava...? Ah, certo, si chiama Invokazione del genio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330111,
					"content": "Stando a quello che dicono, questi dipinti saranno utilizzati durante il Gran Premio Re delle Invokazioni come sorta di minigioco per ravvivare un po' le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330112,
					"content": "*sospira* Questa roba è troppo complicata per me. Dovrei concentrarmi solo sulle mie invenzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330113,
					"content": "Ah, certo, ho con me i dipinti meccanici che ho fatto a Mondstadt, per cui se vuoi provarli, accomodati pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330105,
					"content": "Qualcosa è andato storto di nuovo con la tua invenzione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "No, per niente! Non questa volta... O, per meglio dire, non c'è mai stato un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330107,
					"content": "Quando ho chiesto il tuo aiuto, avevo un problema con i mostri, non con le mie invenzioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				}
			]
		}
	]
}