			},
			"dialogs": [
				{
					"id": 207030501,
					"content": "Hai trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030502,
					"content": "Ho preso qualche foglia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "...Delle foglie? Fammi vedere. Ah, le hai anche messe in una scatola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030504,
					"content": "Se le tieni in mano, queste foglie ti faranno davvero sentire l'Anemo al loro interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030505,
					"content": "E pensare che quest'albero aveva così tanto potere! Se solo avessi avuto una Visione, non avrei sprecato tutto questo tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030506,
					"content": "Grazie. Questa è una risorsa molto preziosa che userò con molta attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030507,
					"content": "Ma non so come conservare queste foglie. È decisamente possibile che l'Anemo che contengono si disperda troppo velocemente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030508,
					"content": "Prendi comunque questa ricompensa. Chissà, forse in futuro ti chiamerò per aiutarmi a raccogliere altro materiale per la ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dottoressa Edith"
				}
			]
		}
	]
