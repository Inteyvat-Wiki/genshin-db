					"nextDialogs": [
						207030202
					]
				},
				{
					"id": 207030202,
					"content": "Ottimo, conto su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030303,
					"content": "Riesci a vedere gli elementi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030304,
					"content": "Credo che basti seguire le tracce d'Anemo e cercare in quella direzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030305,
					"content": "Ti aspetto sotto l'albero. Se trovi qualcosa, portamelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dottoressa Edith"
				}
			]
		},
