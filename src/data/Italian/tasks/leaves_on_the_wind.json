			"dialogs": [
				{
					"id": 207030401,
					"content": "Devo ammettere che una persona come te è decisamente più adatta a fare ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030402,
					"content": "Hai davvero molta esperienza d'avventura e una grande tenacia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030403,
					"content": "E soprattutto, riesci a controllare gli elementi anche senza usare una Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030404,
					"content": "Gli elementi... Su questo continente esistono veramente delle ricerche che possano scoprirne i segreti? Per un ricercatore, la capacità di usare una Visione o meno è davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030405,
					"content": "Ah, eccomi partita di nuovo per la tangente... Scusami, non farmene una colpa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dottoressa Edith"
				}
			]
		},
