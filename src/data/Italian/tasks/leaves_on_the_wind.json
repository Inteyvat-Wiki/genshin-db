			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dottoressa Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "Che peccato, non posso usare nemmeno questo materiale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030102,
					"content": "A cosa stai lavorando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "Vorrei scrivere un nuovo libro sulla storia di Mondstadt, concentrandomi su Anemo. Sto cercando l'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030104,
					"content": "Se ci pensi, questo posto è il luogo ideale. C'è una Statua dei Sette che rappresenta Anemo, e un albero che è strettamente connesso alla leggenda di Vennessa, la grande eroina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030105,
					"content": "Eppure, e so che può sembrare strano, cercare e raccogliere Anemo senza una Visione, che non ho, è troppo difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030106,
					"content": "E la cosiddetta ricerca dell'ispirazione? Sto solo guardando nel vuoto. E in più la maggior parte del mio materiale è un riassunto di fonti secondarie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030107,
					"content": "Ecco la vita di una persona senza Visioni su questo continente: fare molto e non ottenere niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030108,
					"content": "Impossibile utilizzare il potere degli elementi senza Visione. Che sia nella ricerca o nella vita di tutti i giorni, le persone senza Visioni vivono ai margini del loro stesso mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030109,
					"content": "Ahahah, forse, agli occhi degli dèi, i possessori di Visioni sono i protagonisti di questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030110,
					"content": "Scusa, parlo troppo. Nonostante tutto, continuerò la mia ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030111,
					"content": "Io non ho una Visione, ma non lascerò che vada tutto all'aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030112,
					"content": "E mi hanno detto che gli elementi possono essere utilizzati anche senza una Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030113,
					"content": "Se potessi aiutarmi a trovare degli oggetti infusi d'Anemo, mi aiuteresti molto a continuare la mia ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "Dottoressa Edith"
				},
				{
					"id": 207030114,
					"content": "Puoi aiutarmi a salire su quest'albero per dare un'occhiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dottoressa Edith"
				}
			]
		},
