						"rawParams": [
							"7106110",
							"2"
						],
						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#Gloria a {NICKNAME}! Gloria a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610302,
					"content": "Nessuno ha risposto alle richieste d'aiuto di Xamaran. I multipiedi e i quadrupedi non gli hanno prestato attenzione e i bipedi hanno fatto orecchie da mercante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610303,
					"content": "#Solo {F#le sagge}{M#i saggi} hanno risposto. Paimon ha dimostrato di possedere saggezza, e lo stesso vale per {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610304,
					"content": "#Voi due, {F#le più sagge}{M#i più saggi} tra i bipedi, riceverete la gratitudine di Xamaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610323,
					"content": "Umpf, meglio non sottovalutare Paimon la saggia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610305,
					"content": "Non c'è di che.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#Con il tempo, {NICKNAME} e Paimon diventeranno grandi quanto Xamaran e la sua stirpe. Di questo Xamaran è certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610307,
					"content": "Aspetta, che cosa vorresti dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610308,
					"content": "I multipiedi sono inferiori ai quadrupedi e i quadrupedi sono inferiori ai bipedi, quindi naturalmente i bipedi sono inferiori a chi non possiede gambe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610309,
					"content": "#Ma ciò che manca a {NICKNAME} e Paimon, naturalmente, può essere compensato con il duro lavoro. Potreste anche cambiare il corso del destino un giorno, chi può dirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610310,
					"content": "Wow, questo fungo luminoso le spara grosse! Paimon si chiede se i funghi luccicanti siano buoni da cucinare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610311,
					"content": "Per gli spiedini di pollo e funghi, sicuramente sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "I bei funghi mentono. Questo qui potrebbe essere velenoso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "Questa Paimon è proprio golosa. Un morso al fungo oggi, un altro domani e cento giorni dopo non c'è più Paimon, sono rimasti solo i funghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610314,
					"content": "#Ehm, {NICKNAME}, Schifungo inizia a dire cose inquietanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610315,
					"content": "Ah, quindi non hai colto l'umorismo in quella frase. Che peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610316,
					"content": "Non era per niente divertente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610317,
					"content": "Xamaran è libero dall'energia nefasta, eppure la sua stirpe soffre ancora. Adesso Xamaran non ha le energie per proteggere i deboli come faceva una volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610318,
					"content": "#Per piacere, {NICKNAME}, Xamaran ti supplica. Fai uso della tua benevolenza e salva gli indifesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610319,
					"content": "#Vuoi dire che ci sono altri funghi malati? {NICKNAME}, che ne dici di aiutarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610320,
					"content": "Già che ci siamo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "Purché non si tratti di una grossa deviazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "Andiamo allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Wow! Da dove viene questo fango nero? È l'energia nefasta di cui ha parlato Schifungo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
