					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610401,
					"content": "#Gloria a {NICKNAME}! Gloria a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610402,
					"content": "Se Xamaran può permettersi, voi bipedi avete un modo di dire: \"Chi dà una mano aiuta a portare a termine il piano\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610403,
					"content": "Stai dicendo che ci sono altre faccende da sbrigare, non è così?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "Ma i modi di dire umani si applicano ai funghi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "#Tra tutti i bipedi, voi due meritate sicuramente il titolo di {F#\"sagge\"}{M#\"saggi\"}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610406,
					"content": "Siamo tutti esseri viventi illuminati dalla benevolenza della terra. È naturale che ci aiutiamo a vicenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610407,
					"content": "Prendi queste, le Benedizioni della saggezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610408,
					"content": "Ricevi le Benedizioni della saggezza.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "Wow, che cos'è? Sembra tutto un po' sospetto, a dire il vero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610410,
					"content": "Xamaran sente nell'aria l'odore persistente dell'energia nefasta, ma non riesce a capire da dove provenga. Segui l'acqua e la troverai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610411,
					"content": "#Dovrai solamente utilizzare le Benedizioni della saggezza sulla fonte dell'energia nefasta, {NICKNAME}, e la stirpe di Xamaran si occuperà del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610412,
					"content": "La fonte dell'energia... Effettivamente è una questione non trascurabile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "Ma perché non te ne occupi tu stesso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME}, sei molto più {F#spiritosa}{M#spiritoso} di Paimon. Xamaran non ha le gambe, ma tu sì. In quanto senza gambe, Xamaran non può interferire troppo nelle faccende dei bipedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610415,
					"content": "Inoltre, Xamaran ha un impegno ancora più gravoso da assolvere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610416,
					"content": "Un impegno più gravoso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "Xamaran ha usato troppe energie. La conversazione con voi due è stata piacevole, ma ora Xamaran deve riposare e conservare le forze per respingere il male e fornire un rifugio alla sua stirpe, affinché questa possa prosperare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610418,
					"content": "#{NICKNAME} e Paimon, siate benedett{F#e}{M#i} nel vostro cammino futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610419,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610420,
					"content": "Ehi, Schifungo! Svegliati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}, sembra che Schifungo si sia addormentato. Beh, allora andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Wow! Da dove viene questo fango nero? È l'energia nefasta di cui ha parlato Schifungo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
