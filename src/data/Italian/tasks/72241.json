			]
		},
		{
			"id": 7224106,
			"completionStepIds": [
				7224108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224108",
							"2"
						],
						"stepId": 7224108,
