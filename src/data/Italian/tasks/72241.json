			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410601,
					"content": "Il mio nome è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410602
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410602,
					"content": "Aberaku, il Creatore di Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410603
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410603,
					"content": "E il nome di Paimon è... beh, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410604,
						722410609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410604,
					"content": "Ci dobbiamo anche presentare ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410605
					]
				},
				{
					"id": 722410605,
					"content": "Beh, dato che lui ha iniziato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410606,
					"content": "L'ho fatto anch'io, per educazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410607,
					"content": "#È il minimo che possa fare. Dopotutto, vi ho trattat{M#i}{F#e} con estrema negligenza, avendovi ricevuto in un tale stato pietoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410608
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410608,
					"content": "#Non preoccuparti! Non è un problema, vero, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410613,
					"content": "Comunque, perché sei qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410614,
					"content": "Io... Io sono il Creatore di Helios, e questo posto è il mio... luogo di eterno riposo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410615
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410615,
					"content": "Addormentarsi in un posto buio e gelido, e non potersi svegliare mai più... Come ho potuto morire in tal modo? Io, il Creatore di Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410616
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410616,
					"content": "Il Creatore di Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410617,
					"content": "Cos'è questo Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410618,
					"content": "Ah, giusto. Sono io che l'ho chiamato Helios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410619
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410619,
					"content": "Forse voi non lo sapete, ma il popolo di Byakuyakoku lo chiama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410620
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410620,
					"content": "Il Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410621
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410621,
					"content": "Helios è il Dainichi Mikoshi, il carro solare che guida l'Hype{RUBY#[S]Byakuya no Hikari}rion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410622,
						722410623
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410622,
					"content": "Quindi tu sei il creatore del Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410624,
					"content": "Ebbene sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410625
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410625,
					"content": "#O viaggiat{F#rice}{M#ore} di terre lontane. Anche se l'ho creato io, sono stato condannato agli arresti domiciliari e imprigionato al di sopra della mia stessa creazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410626
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410626,
					"content": "Dopo la mia morte, la mia anima venne sparsa per la terra di Byakuyakoku, e molti dei miei ricordi andarono perduti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410627
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410627,
					"content": "Rammento che c'era qualcosa di molto importante... sopra il Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410628
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410628,
					"content": "Ma non riesco più a ricordare cosa fosse. Viandante di terre lontane... Potresti aiutarmi a recuperare i miei vestiti, la mia corona e le mie ossa, che sono stati riposti in tre luoghi diversi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410629
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410629,
					"content": "Potrai trovarli presso le Forre, nel Tempio della Notteterna e nel Cuore del Serpente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410630
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410630,
					"content": "Offrili sui tre altari, e la mia anima sarà ricongiunta, così potrò aprirti la strada per il Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410631
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410631,
					"content": "E allora potrai viaggiare sopra il Dainichi Mikoshi, negli spazi racchiusi e nascosti nel velo della Notteterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410623,
					"content": "Sei stato tu, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410609,
					"content": "Il mio nome è...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410610
					]
				},
				{
					"id": 722410610,
					"content": "#Capisco. Quindi sei un {F#una visitatrice}{M#un visitatore} da terre lontane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410611
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410611,
					"content": "#Mi dispiace solo di avervi incontrat{M#i}{F#e} in condizioni così terribili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410612
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410612,
					"content": "Non fa niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224112",
							"2"
						],
						"stepId": 7224112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410701,
					"content": "Rivendica le offerte presso le Forre, nel Tempio della Notteterna e nel Cuore del Serpente. In tal modo, la mia anima sarà ricongiunta, e potrò aprirti la strada per il Dainichi Mikoshi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				}
			]
		},
		{
			"id": 7224108,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410801,
					"content": "#O viaggiat{F#rice}{M#ore} di terre lontane, sei tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410802
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410802,
					"content": "Grazie a te, la mia anima è di nuovo intera, e ora ricordo tutto. Incredibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410803
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410803,
					"content": "Forse saprai già che, in un lontano passato, a Byakuyakoku regnava solo una grande oscurità, e che gli abitanti del luogo erano terrorizzati dagli Eredi dei draghi delle Profondità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410804
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410804,
					"content": "A quel tempo, fui io a gestire la creazione del Dainichi Mikoshi, per cui a Byakuyakoku la notte e il giorno iniziarono a susseguirsi ciclicamente, e così nacque il nome Byakuya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410805
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410805,
					"content": "La gente diceva: \"Ora che il Dainichi Mikoshi è stato creato, anche se questa terra è immersa nella notte eterna, possiamo almeno distinguere il nero dal bianco\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410806
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410806,
					"content": "È stato mortificante non riuscire a ricordare il giorno in cui vidi la folla di persone intorno al Dainichi Mikoshi, appena terminato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410807
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410807,
					"content": "Avrebbe dovuto essere il mio più bel ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410808
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410808,
					"content": "Ma, ahimè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410809
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410809,
					"content": "Ahimè cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410810,
					"content": "Quando il Dainichi Mikoshi fu costruito, gli Eredi dei draghi furono sconfitti, respinti da una luce a cui non erano abituati. Così le persone ritrovarono la pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410811
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410811,
					"content": "Ma nel momento in cui la pace cominciò a regnare... Ah, è difficile comprendere il cuore umano. Chi si sarebbe immaginato che avrebbero cominciato a nutrire intenti così malvagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410812
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410812,
					"content": "#O viaggiat{F#rice}{M#ore} di terre lontane, sono certo che tu sappia con quanta voracità i malvagi possano impadronirsi di ricchezze e potere, se ne viene concessa loro la possibilità... Più di quanto non meritino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410813
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410813,
					"content": "E così si sono serviti delle persone, plagiandole al culto del Dainichi Mikoshi, portandole a venerare oggetti vani e ormai defunti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410814
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410814,
					"content": "Alla fine, hanno persino proclamato il dominio sulla terra del \"Figlio {RUBY#[S]Phaethon}del sole\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410815
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410815,
					"content": "Il Figlio del sole?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410816
					]
				},
				{
					"id": 722410816,
					"content": "Proprio così. Di volta in volta, veniva scelto un bambino per diventare il Figlio del sole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410817
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410817,
					"content": "Naturalmente, questi bambini non avevano l'età per capire il mondo. Non erano adatti per governare e agivano semplicemente come burattini nelle mani di chi ne tirava i fili sullo sfondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410818
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410818,
					"content": "Io volevo oppormi, ma sono stato accusato di alto tradimento dal Figlio del sole sotto il loro comando, finendo con l'essere imprigionato qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410819
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410819,
					"content": "Ah, il Figlio del sole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410820,
					"content": "Ma non si sono mai accorti di essere manipolati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410821,
					"content": "È per questo motivo che nessun Figlio del sole ha mai raggiunto la maturità. Perché è proprio così: le persone adulte non si lasciano influenzare così facilmente dai malvagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410822
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410822,
					"content": "\"Figlio del sole, nel giorno natale venerato, in sella a Pegaso possa tu raggiungere la festa dell'astro infuocato.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410823,
						722410824
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410823,
					"content": "Aspetta, non vorrai dire che...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				},
				{
					"id": 722410825,
					"content": "Sì. Venivano portati nel punto più interno del Dainichi Mikoshi, vestiti per il rituale della nascita e con il cuore pieno di gioia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410826
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410826,
					"content": "...Ciò che è nascosto qui è legato a loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410827
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410827,
					"content": "Questa Briglia dimostra la legittimità di un Figlio del sole. L'ho nascosta qui, pensando che un giorno avrei potuto consegnarla mettendo in guardia il popolo... Ma suppongo che ormai un atto del genere sia privo di significato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410828
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410828,
					"content": "#Viaggiat{F#rice}{M#ore} di terre lontane... Non sono stato in grado di proteggere quei bambini, né questa nazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410829
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410829,
					"content": "Il mio nome è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410830
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410830,
					"content": "Aberaku, il Creatore di Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410831
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410831,
					"content": "Sono stato io a predisporre la creazione del Dainichi Mikoshi. Sono stato io ad appendere uno specchio luminoso nel bel mezzo della Notteterna, ritenendomi un genio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410832
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410832,
					"content": "Credevo di avere talento... Così tante abilità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410833
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410833,
					"content": "Ho sognato di eliminare l'oscurità con il Dainichi Mikoshi, ma all'epoca ignoravo che erano l'avidità e la cupidigia umana a essere la vera notte divoratrice di tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410834
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410834,
					"content": "#Visitat{F#rice}{M#ore} da terre lontane, ti affido la Briglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410835
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410835,
					"content": "Questa Briglia divina è una testimonianza della nostra storia così risibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410836
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410836,
					"content": "Conservala... Anzi, fanne ciò che vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410837
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410837,
					"content": "È un dono troppo prezioso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410838
					]
				},
				{
					"id": 722410838,
					"content": "Ah! No, era già privo di significato. L'essere nuovamente uno e potertene fare dono fa parte del destino. Sarà una giusta fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410839
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410839,
					"content": "Ah... Il mio talento, le mie abilità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410824,
					"content": "Così, nel giorno del loro compleanno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				}
			]
		},
