			]
		},
		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tie Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "Alt! La Voragine è chiusa. Se non siete di queste parti... Ah, siete voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460202,
					"content": "Oh, no! Scappa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460203,
					"content": "Dai, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "Ahahah! Scusate se vi ho spaventato. Certo che mi ricordo. Come potrei dimenticarmi di chi mi ha salvato la vita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460207,
					"content": "Io stesso sono stato trasferito qui da poco... Non pensavo di incontrarvi. Devo essere fortunato, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460208,
					"content": "Davvero ti abbiamo salvato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460209,
					"content": "Ma certo! Ero alla Dimora di giada, abbiamo combattuto insieme quel mostro marino. Mi sono lievemente infortunato e ho ripreso servizio solo di recente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460210,
					"content": "Potreste non ricordarvi di me, ma io non vi dimenticherò mai. Tutti i compagni che combattevano quel giorno hanno visto cos'avete fatto per Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460211,
					"content": "Potresti parlarmi un po' della Voragine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "Due anni fa si è verificato uno strano incidente nelle profondità delle caverne e le Sette Stelle hanno ordinato di chiudere il posto. Buona parte dei minatori è stata fatta evacuare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460213,
					"content": "È proprio un peccato che una miniera così grande abbia chiuso, di punto in bianco. I lavoratori hanno preso ciò che spettava loro e se ne sono andati... Una volta che disperdi un gruppo in questo modo, temo che sia difficile ricomporlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460214,
					"content": "Oh, scusate, sto divagando. Immagino che siate qui per affari importanti, non vi farò perdere altro tempo. Se avete domande, chiedete direttamente a Muning. Dovrebbe essere all'accampamento, all'ingresso della miniera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460215,
					"content": "E poi, ehm, non è che non mi fidi di voi, ma è mio compito ricordarvi di non violare la legge in alcun modo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460216,
					"content": "Non preoccuparti! Ti puoi fidare di noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460204,
					"content": "Mi riconosci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "Ci hanno riconosciuto! Squagliamocela!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}