			"dialogs": [
				{
					"id": 710460101,
					"content": "Alt! La Voragine è un luogo sensibile. È vietato l'ingresso al personale non autorizzato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
