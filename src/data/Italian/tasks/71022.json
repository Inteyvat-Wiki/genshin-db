					"Zhiping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "Ugh, ora anche la Valle di Tianqiu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220102,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#Oh, {NICKNAME}, siete voi. È un piacere vedervi, anche se non mi aspettavo certo di incontrarvi oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220104,
					"content": "#Comunque... Siete stat{F#e}{M#i} alla Valle di Tianqiu o a Nantianmen di recente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220107,
					"content": "Negli ultimi tempi, la Gilda ha ricevuto un flusso costante di segnalazioni di terremoti in quelle zone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220108,
					"content": "All'inizio si trattava solo di piccole scosse, ma col tempo sono diventate sempre più preoccupanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220109,
					"content": "Poi, non molto tempo fa, abbiamo ricevuto notizia di un terremoto particolarmente forte che ha fatto crollare parte delle montagne e delle rovine, rivelando una gigantesca caverna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220110,
					"content": "Il rapporto menzionava anche che nella zona sono stati avvistati alcuni mostri sconosciuti che, in base alle descrizioni, potrebbero essere i Geosauri e i Geosauri primordiali che un tempo terrorizzavano Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220111,
					"content": "Ti serve aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "Beh, vorrei chiedervi di andare nella Valle di Tianqiu per indagare su quell'enorme caverna e fare rapporto sull'impatto che il terremoto ha avuto sull'ambiente circostante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220113,
					"content": "E per quanto riguarda i mostri... Se è vero che stanno comparendo in gran numero, allora non possiamo permetterci di ignorarli. Dobbiamo decidere quali contromisure adottare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220114,
					"content": "Naturalmente, questo conta come un incarico ufficiale per la Gilda, e riceverete una giusta ricompensa. Cosa ne pensate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220115,
					"content": "Ci sto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "Grazie infinite. Fate attenzione quando esplorate quell'area.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiping"
				}
			]
		},
