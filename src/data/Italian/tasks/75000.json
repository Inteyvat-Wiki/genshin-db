			"dialogs": [
				{
					"id": 750000101,
					"content": "Ehi, ehi, bestione... Tutto ok? Riesci ad alzarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000102,
					"content": "Oh, no, sembra così debole. Uff, ma insomma! Quei cani fantasma fluttuanti combinano sempre guai... Paimon lo dice sempre: bisogna sempre diffidare delle cose che fluttuano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000103,
					"content": "Anche tu fluttui, però...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "Paimon non è mica come loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000105,
					"content": "Comunque, lasciamo perdere, per ora. Vediamo se riusciamo a fargli mangiare qualcosa, dopodiché... lo lasceremo riposare un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000106,
					"content": "Presto starà meglio, Paimon ne è sicura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000107,
					"content": "È troppo tardi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "No...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000110,
					"content": "*respira affannosamente*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "Bestione?"
				},
				{
					"id": 750000111,
					"content": "#Oh, no. Starà soffrendo così tanto, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000112,
					"content": "Abbiamo sconfitto i tuoi nemici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "*respira affannosamente*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "Bestione?"
				},
				{
					"id": 750000115,
					"content": "C'è... qualcos'altro che ti turba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "C'è... qualcosa che vorresti dirmi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "#Protendi la mano... {F#Prescelta}{M#Prescelto} dei Draghi... Avvicinati a me...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "Uniamo le forze... Sii testimone di ogni cosa... Infine, dona a tutti la libertà...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#Che succede, {NICKNAME}? Non è il momento di distrarsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000120,
					"content": "Non è niente. Solo un attimo di confusione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000121
					]
				},
				{
					"id": 750000121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000122
					],
					"speakerTitle": "Bestione?"
				},
				{
					"id": 750000122,
					"content": "Fruuu... Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000123
					],
					"speakerTitle": "Bestione?"
				},
				{
					"id": 750000123,
					"content": "È questo il tuo desiderio o...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000124
					]
				},
				{
					"id": 750000124,
					"content": "(Allunga la mano verso la bestia morente...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000125
					]
				},
				{
					"id": 750000125,
					"content": "Cosa stai facendo? Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000126,
					"content": "#{NICKNAME}, tu...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000113,
					"content": "Ora puoi riposare, bestione. Sei stato bravo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000108,
					"content": "Ha dovuto resistere per troppo a lungo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				}
			]
		},
