			"dialogs": [
				{
					"id": 750000601,
					"content": "Ah... Stai bene, piccolino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000602,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000603
					],
					"speakerTitle": "Piccolino?"
				},
				{
					"id": 750000603,
					"content": "C-Che succede? Non hai un bell'aspetto. Ti fa male la coda? Te la sei ferita quando sei caduto dalla barriera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000604,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000605
					],
					"speakerTitle": "Piccolino?"
				},
				{
					"id": 750000605,
					"content": "Se solo potessimo fasciarla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000606
					]
				},
				{
					"id": 750000606,
					"content": "Eheh, è arrivato il momento di fare il tifo per Paimon! Il tuo zaino è così pieno che, anche in caso di emergenza, ci vuole un'intera giornata per trovare qualsiasi cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000607,
					"content": "Usiamo questa sciarpa dallo zaino d'emergenza di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000608,
					"content": "Non so neanche dove dovrebbe essere il tuo zaino...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000609
					]
				},
				{
					"id": 750000609,
					"content": "Umpf! In un posto segreto e sicuro, ovviamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000610,
					"content": "Comunque, vuoi usarla o no, questa sciarpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000611,
					"content": "Sì, certo. Grazie infinite, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000612
					]
				},
				{
					"id": 750000612,
					"content": "Mmmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000613
					],
					"speakerTitle": "Piccolino?"
				},
				{
					"id": 750000613,
					"content": "Va bene. Non ti muovere, piccolino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000614,
					"content": "#Hihi, è molto educato. Vero, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000615,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000616,
					"content": "Così dovrebbe andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000617
					]
				},
				{
					"id": 750000617,
					"content": "Ottimo. Ti senti meglio ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000618,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000619,
					"content": "Bene, ora sembra stare meglio. Che sollievo... In ogni caso, come sei finito nella barriera? E quei Segugi della Faglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000620,
					"content": "Mmmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000621,
					"content": "Quindi non lo sai nemmeno tu, eh? Non capiamo cosa stai dicendo... ma ora che ti abbiamo salvato, puoi tornare a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000622,
					"content": "Ehrrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000623,
					"content": "Aspetta, non sai dov'è casa tua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000624,
					"content": "E i tuoi parenti, allora? Oh, quel bestione di prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000625,
					"content": "#Che facciamo, {NICKNAME}? Non possiamo lasciarlo qui, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000626,
					"content": "Wrroh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000627
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000627,
					"content": "Forse sarebbe meglio se ti unissi a noi per un po'...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000628
					]
				},
				{
					"id": 750000628,
					"content": "Sì, giusto. Forse troveremo la sua famiglia una volta a Natlan... Ma non abbiamo mai visto niente di simile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000629,
					"content": "#Ah. \"{F#Prescelta}{M#Prescelto} dei Draghi\"... Non sarà che...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000630
					]
				},
				{
					"id": 750000630,
					"content": "Ah, vuoi dire che hai sentito qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000631,
					"content": "Ora che Paimon ci pensa, Natlan è conosciuta come la \"Nazione dei draghi\", quindi significa che... Aspetta, queste creaturine le chiamano \"Saurici\", giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000632,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000633
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000633,
					"content": "Assomiglia un po' a un Elementosauro. Sai... Due zampe, una coda e tutto il resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000634,
					"content": "Rraaa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000635,
					"content": "Siamo felici che viaggi con noi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000636
					]
				},
				{
					"id": 750000636,
					"content": "Però prima dovremmo chiedergli cosa vorrebbe fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000637
					]
				},
				{
					"id": 750000637,
					"content": "Vero, verissimo. Ehi, piccolino. Ti piacerebbe viaggiare con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000638,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000639
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000639,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000640
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000640,
					"content": "#Eheh! Direi che siamo a posto. Paimon si chiama Paimon, e {F#lei}{M#lui} è {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000641,
					"content": "Rraa? Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000642
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000642,
					"content": "Ah, sì, ti serve un nome... Fa' pensare Paimon. Giusto! Visto che sei tutto giallo e marrone, potremmo chiamarti \"Frittella\", che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000643
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000643,
					"content": "Rroooo... Rraaaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000644,
						750000646
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000644,
					"content": "Sembra un nome che sentiresti solo al Buon Cacciatore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000645
					]
				},
				{
					"id": 750000645,
					"content": "Intendi dire che non piacerebbe da nessun'altra parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000647,
					"content": "Roo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000648
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000648,
					"content": "#Vuoi che sia {NICKNAME} a darti un nome? Beh... è meglio che Paimon non si esprima sulla sua capacità di inventarsi i nomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000649,
						750000650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000649,
					"content": "Ci tengo a precisare che tutti i nomi che mi sono venuti in mente finora sono stati perfettamente normali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000650,
					"content": "Povera creaturina... Subire un destino così infausto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000646,
					"content": "Sembra che quel nome non gli piaccia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000647
					]
				}
			]
		},
