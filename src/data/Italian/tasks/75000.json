					"id": 750000902,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000903
					]
				},
				{
					"id": 750000903,
					"content": "...Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000904,
					"content": "#Sembra che questo nome gli piaccia! Beh, con un po' di fortuna, qui a Natlan risolveremo il mistero che ti circonda... Ah, e forse otterremo qualche indizio sul perché {NICKNAME} è {F#riuscita}{M#riuscito} a entrare improvvisamente nel corpo di quel Saurico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000905,
					"content": "#Ah, già, a proposito! Stai bene, {NICKNAME}? Tutt'a un tratto ti sei {F#trasformata}{M#trasformato} in un Saurico... Avverti niente di strano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000906,
					"content": "Oh, solo un po' di mal di Saurico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "Ma come sarebbe a dire?! Non è il momento di scherzare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000910,
					"content": "#Comunque, {NICKNAME}, Paimon non ha mai sentito parlare di qualcuno a Natlan in grado di trasformarsi in un Saurico... È un po' strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000911,
					"content": "#Siamo appena {F#arrivate}{M#arrivati} e sembra ne siano già successe di tutti i colori... Comunque, come facciamo a uscire da qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000912,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "Mmmh? Sai dov'è l'uscita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000908,
					"content": "Diventare un Saurico per un po' non ha dato grossi problemi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000909
					]
				},
				{
					"id": 750000909,
					"content": "#E sarà meglio che non ne dia mai! Le cose potrebbero mettersi male se un giorno ti trasformassi in un Saurico e non potessi più tornare {F#umana}{M#umano}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				}
			]
		},
