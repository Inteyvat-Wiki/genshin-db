			"dialogs": [
				{
					"id": 750000901,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}. Ti chiamerai così d'ora in poi, piccolino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
