			"dialogs": [
				{
					"id": 740121301,
					"content": "Vediamo cos'abbiamo qui... Sembra proprio una leva corredata da una scritta, \"Non toccare in nessuna circostanza\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740121302,
					"content": "Tira la leva.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740121303
					]
				},
				{
					"id": 740121303,
					"content": "Tiri la leva.\\nIl macchinario inizia a borbottare e a tremare, per poi sputare fuori una pila di nastri di carta...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740121304
					]
				},
				{
					"id": 740121304,
					"content": "Perfetto! Adesso abbiamo i dati di monitoraggio della Stazione di Crêpe Suzette!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121305
					],
					"speakerTitle": "Paimon"
				},
				{
