			"dialogs": [
				{
					"id": 740120501,
					"content": "Woah! È così severo! Paimon non vuole proprio lavorare per quel tizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120502,
					"content": "Con che coraggio osano parlare di \"onore collettivo\"? Cosa c'è di onorevole nel non dare da mangiare a nessuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120503,
					"content": "Non ha tutti i torti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "Che regola incomprensibile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "Beh, la disciplina è importante, ma... non è un po' esagerato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120506,
					"content": "Vero?! Più le persone non sanno come fare le cose, più rompono le scatole con regole e disciplina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120507,
					"content": "Ah... Ora che Paimon ci pensa, se facessimo rumore anche noi, è probabile che quello Shumilov a comando dell'unità scenderebbe giù a controllare, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120508,
					"content": "#A quel punto potremmo salire... {NICKNAME}, proviamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
