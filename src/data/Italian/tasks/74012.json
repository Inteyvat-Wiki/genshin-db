			"dialogs": [
				{
					"id": 740121001,
					"content": "Tira la leva.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740121002
					]
				},
				{
					"id": 740121002,
					"content": "#Ehi! Cosa stai facendo, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740121003,
					"content": "Tiri la leva senza la minima esitazione.\\nL'intera torre comincia subito a tremare, causando un potentissimo rimbombo assordante, come se il cielo crollasse e la terra tremasse...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740121004
					]
				},
				{
					"id": 740121004,
					"content": "Dopodiché, con un botto, il meccanismo sputa una pila di nastri di carta direttamente nelle tue mani.\\nTutto è di nuovo tranquillo.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740121005
					]
				},
				{
					"id": 740121005,
					"content": "T-Tutto qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740121006,
					"content": "Uhm... Paimon non ha idea di cosa ci sia sopra, ma sembra abbastanza importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740121007,
					"content": "#{NICKNAME}, perché non teniamo con noi questo nastro di carta per ora? Chissà, magari più avanti ci tornerà utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
