			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Castiglione"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762060101,
					"content": "Kanou, perché non la smetti di scorrazzare e non finisci quel paravento? Faresti meglio a capire come dipingere quella cascata. Per Egeria, chi mai userebbe la prospettiva accidentale per dipingere una cascata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060102
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060102,
					"content": "Mh? Oh, chiedo scusa. Un volto nuovo, vedo. Dal rumore dei passi, ti avevo scambiato per Kanou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060103
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060103,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762060104
					]
				},
				{
					"id": 762060104,
					"content": "Come puoi vedere, sto dipingendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060105
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060105,
					"content": "Ma chiariamo una cosa, prima che tu fraintenda: sarò anche abile a dipingere animali, ma gli animali che dipingo non sono destinati a essere mangiati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060106
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060106,
					"content": "Aspetta, quindi stai dicendo che le tue opere d'arte si possono mangiare?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762060107,
					"content": "Le persone che dipingo appaiono in carne e ossa, quindi anche le bestie nelle mie opere possono finire nel piatto... *sospira* Detto ciò, spero che tu non sia come quella Jing-gui di Liyue, che mi tormenta per farmi dipingere solo filetti di pesce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060108
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060108,
					"content": "L'Arte, la venerabile Arte! A prescindere dall'epoca, il suo scopo principale dovrebbe essere la salvezza dell'anima umana e la coltivazione del proprio carattere, per guidarci con Verità, Bontà e Bellezza verso un regno spirituale più elevato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060109
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060109,
					"content": "Per esempio, quando si sta in piedi sulla vetta più alta di una montagna, il paesaggio è naturalmente chiaro e autentico. È questa l'arte a cui aspiro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060110
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060110,
					"content": "Mmh... Temo che non riuscirai a cogliere la vera essenza del discorso, poiché le parole hanno dei limiti. Facciamo così: lascia che ti dipinga una piattaforma fluttuante. Sali pure e scoprila di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Castiglione"
				}
			]
		}
	]
}