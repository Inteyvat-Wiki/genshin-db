				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "Oh, salve! Ci si rivede! Che fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790102,
					"content": "Scusa, tu sei...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "Gygax! Sai, no? Quello del Cacciavento! Non ti dice niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790106,
					"content": "Ah, ecco chi sei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706790107,
					"content": "Ah, sì, ora ricordo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "Dici di ricordare, ma la tua espressione dice il contrario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790109,
					"content": "Comunque, guarda qui. Di sicuro ti ricordi almeno del Cacciavento, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790110,
					"content": "Non mi avevi dato una marea di suggerimenti dopo aver fatto una partita di prova? Ed erano pure delle belle idee. Le ho adottate tutte quante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790111,
					"content": "Ho riguardato le regole e le modalità di gioco... Cioè, in realtà le ho riguardate diverse volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790112,
					"content": "Non saranno troppo complicate e formulate in modo strano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "Oh, non preoccuparti, sono sicuro che lo adorerai. Vieni, ti faccio un piccolo resoconto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790115,
					"content": "Per prima cosa, ho introdotto una cosa chiamata \"dispositivo di segnalazione\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790116,
					"content": "Se i Ribelli riescono ad attivare quattro di questi dispositivi, il Cacciatore è sconfitto e loro vincono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790117,
					"content": "Mentre per il Cacciatore... Beh, per il Cacciatore non cambia niente! Se riesce a catturare tutti i Ribelli, allora vince.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790118,
					"content": "Ma in questa versione del Cacciavento, quando i Ribelli vengono catturati dal Cacciatore, non vengono eliminati subito. Vengono invece rinchiusi in quella che viene chiamata la \"Zona di sorveglianza\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790119,
					"content": "Dopo un certo lasso di tempo, o con l'aiuto di altri Ribelli, possono fuggire dalla Zona di sorveglianza e continuare a giocare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790120,
					"content": "Se però un Ribelle che è già stato catturato una volta viene catturato nuovamente... A quel punto è fuori dal gioco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790121,
					"content": "Sembra un po' complicato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "#{F#Tranquilla}{M#Tranquillo}. Può sembrare complicato all'inizio, ma con qualche turno di prova ci prenderai la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790124,
					"content": "In tal caso, fammi provare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "Ma certo! Di qua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790126,
					"content": "Non ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "Nessun problema. Torna quando vuoi... Io rimarrò qui per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790122,
					"content": "Ci sono parecchie nuove regole...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "Non è che hai aggiunto qualche strana modalità di gioco, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "Sei... quel tizio del Cacciavento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "Gygax! Ma sì, sono io... E no, non sono per niente scocciato che il Cacciavento sia più famoso di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
}