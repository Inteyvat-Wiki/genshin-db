				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lohen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "Oh? Fammi vedere. Mmm... Il concetto non è male. Darei un sei su dieci alla creatività. Quanto alla praticità... forse un quattro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090502,
					"content": "Q-Questo è un piano criminale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090503,
					"content": "Ahah. Curiosamente, sono venuto qui dalla mia postazione perché ho sentito delle voci secondo cui qualcuno da queste parti stava tramando uno strano \"piano criminale\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090504,
					"content": "...Ma, dopo aver letto questo biglietto, credo di aver capito come sono nate quelle voci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090505,
					"content": "Lo consegnerò ai Cavalieri, giusto per sicurezza. E se più tardi hai un po' di tempo, passa dalla mia postazione. Potresti assistere a qualcosa d'interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		}
	]
}