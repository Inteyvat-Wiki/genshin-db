						],
						"pointId": 16779
					}
				]
			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(All'interno del nido giacciono dei pezzi di carta sparsi, con sopra quelle che sembrano delle parole scritte...)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "Hanno fatto a brandelli tutta questa carta per usarla come materiale per il nido?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090303,
					"content": "C'è anche scritto qualcosa. Forse dovremmo provare a ricomporlo per vedere cosa dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090304,
					"content": "#Immagino che dovremo farlo noi {F#stesse}{M#stessi}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "#Dai, non sei nemmeno un po' {F#curiosa}{M#curioso}? E se fosse una mappa del tesoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090306,
					"content": "Dopo le ripetute insistenze di Paimon, i pezzi di carta vengono finalmente rimessi assieme...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "Bene, è il momento della verità... Questo è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090308,
					"content": "Aspetta... Non può essere... Questo è una specie di piano criminale?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090309,
					"content": "Che razza di genio del crimine perderebbe mai il proprio piano a causa di un uccello?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "E-Ehi, questo genere di cose succede continuamente nei romanzi! Un piano perfetto e infallibile che poi va a rotoli a causa dell'unica cosa che nessuno si aspettava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090313,
					"content": "Controlliamo la taverna qui vicino e vediamo se ultimamente hanno sentito delle voci su qualcuno che \"sta pianificando un crimine\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090311,
					"content": "Meglio prevenire che curare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "S-Sì! Esatto... E se qualcuno stesse davvero tramando qualcosa? Se lo ignoriamo e poi succede un pasticcio, non potremo più rimediare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7080904,
			"completionStepIds": [
				7080907
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
