			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"L'autoproclamato \"Tang Wuchou\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "#Che c'è, ti sei di nuovo impantanat{F#a}{M#o} nei giochetti del Vecchio Chou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				},
				{
					"id": 710820102,
					"content": "E dai, ora mi tocca ripetertelo... Ecco come funziona la sua caccia al tesoro: <color=#00E1FFFF>più la merce sarà di buona qualità, più barili esplosivi avrà intorno e viceversa.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				},
				{
					"id": 710820103,
					"content": "Hai capito, stavolta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"L'autoproclamato \"Tang Wuchou\"",
					"Zio He",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "Brutto scarto d'un Cacciatore di tesori... *ansima* Se solo non fossi esausto a causa della recente mancanza di... funghi da mettere sotto i denti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710820202,
					"content": "Ti avrei già riempito di lividi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710820203,
					"content": "Vecchio ladruncolo! Come puoi chiamare i miei Splendi... cioè, Qingxin! Come osi chiamarli funghi e poi... raccoglierli e mangiarli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				},
				{
					"id": 710820204,
					"content": "*tossisce* Non ne avevi il diritto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				},
				{
					"id": 710820205,
					"content": "Ehm... Perché state litigando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820206,
					"content": "S-Stavo cercando della carne di fungo! Ahah, sì, carne di fungo! Ma non mi fanno tornare più nelle miniere, no-no! Q-Quindi sono venuto a cercarne qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710820207,
					"content": "Ho cercato e ricercato, finché non li ho finalmente trovati! Ma, mentre stavo per prenderli, questo furfante mi ha attaccato dal nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710820208,
					"content": "#Ah! Io, un furfante?! Sei tu quello che ha profanato il campo d'addestramento di noi Guhua! E, come se non bastasse, questi fiori appartengono a me... e all'eroic{F#a}{M#o} {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				},
				{
					"id": 710820209,
					"content": "E all'eroica Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820210,
					"content": "Esatto, e all'eroica Paimon! Solo noi tre possiamo mettere piede su questo terreno sacro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				},
				{
					"id": 710820211,
					"content": "Scarto d'un Cacciatore di tesori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710820212,
					"content": "Ladruncolo infame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				},
				{
					"id": 710820213,
					"content": "D'accordo, va bene. Zio He, Tang Wuchou non è più un Cacciatore di tesori. Inoltre, qui ha piantato dei fiori, non dei funghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820214,
					"content": "Eh? Ah, sì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710820215,
					"content": "Forza, dai un'occhiata più da vicino. Questi sono dei Qingxin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820216,
					"content": "Ah! È vero, sono dei Qingxin! A quanto pare, sono ancora un po' rintronato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710820217,
					"content": "E tu, Tang Wuchou, davvero vuoi ancora coltivare quel \"maestoso giardino di Splendigigli\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820218,
					"content": "Beh, sarebbe bellissimo da vedere, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				},
				{
					"id": 710820219,
					"content": "Vabbè, in ogni caso, smettetela di litigare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820220,
					"content": "*sospira* Niente funghi. Me ne vado. Addio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "Zio He"
				},
				{
					"id": 710820221,
					"content": "Ora che quel vecchiaccio se n'è andato, posso finalmente piantare qualche fiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "L'autoproclamato \"Tang Wuchou\""
				}
			]
		}
	]
}