			"dialogs": [
				{
					"id": 401499701,
					"content": "Quando ero in spedizione con il Gran Maestro, spettava spesso a me cucinare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499702
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401499702,
					"content": "Date le circostanze, potevo solo cucinare piatti molto semplici... Ma sembravano piacere molto a tutti quanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499703
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401499703,
					"content": "Forse, era la passione l'ingrediente segreto?",
					"roleType": "TALK_ROLE_NPC",
