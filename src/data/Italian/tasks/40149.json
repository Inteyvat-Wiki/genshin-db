			},
			"dialogs": [
				{
					"id": 401490301,
					"content": "#Eccoti qua, {NICKNAME}! Grazie per il tuo duro lavoro di questi giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490302,
					"content": "È stato un piacere... Sempre che mi paghi, ovviamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490303
					]
				},
				{
					"id": 401490303,
					"content": "#Ahahah, vai {F#dritta}{M#dritto} al punto, eh? Ecco, tieni. Ho aggiunto anche un piccolo extra... Consideralo un bonus. Da noi, il duro lavoro viene ricompensato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490304,
					"content": "Evvai! La stanchezza e lo stress sono spariti come per magia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490305,
					"content": "Sono stato fortunato che tu mi abbia sostituito solo per pochi giorni. Al ritmo con cui stavi migliorando, dopo qualche settimana sarei stato licenziato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490306
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490306,
					"content": "Beh, non vedo l'ora di assaporare la tua cucina molte altre volte in futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490307
					]
				},
				{
					"id": 401490307,
					"content": "Ahah, quando vuoi! Porta con te degli amici la prossima volta, e ti mostrerò cosa sa fare Yanxiao quando cucina con due mani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490308
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490308,
					"content": "Grandioso! Anche se... mi raccomando, cerca di fare più attenzione d'ora in poi! Non sia mai che la sfortuna colpisca di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4014904,
