							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "...Come vola il tempo. Le mie bruciature sono quasi guarite, per cui penso di poter riprendere le redini della cucina già a partire da domani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490102,
					"content": "#Hai fatto un ottimo lavoro in questi giorni, {NICKNAME}. Oggi è il tuo ultimo giorno... Speriamo che vada tutto liscio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490103,
					"content": "Uh, perché Paimon ha l'impressione che tu ci stia portando di nuovo sfortuna...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490104,
					"content": "La giornata trascorre senza intoppi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "#Fiuuu, siamo {F#arrivate}{M#arrivati} alla fine della giornata! È andato tutto liscio, dopotutto. Sarà perché abbiamo acquisito esperienza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490106,
					"content": "Abbiamo fatto molti progressi dal primo giorno, vero? All'inizio facevamo fatica persino a ricordare chi avesse ordinato cosa... Ma ora è tutto un gioco da ragazzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490107,
					"content": "Meglio che tu non ti sieda ancora sugli allori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "Sì, ma chi mai verrebbe a quest'ora della sera? Oh... A dire il vero, ora che Paimon ci pensa, il primo giorno Lyney e i suoi fratelli sono venuti a quest'ora, no...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490110,
					"content": "#{NICKNAME}? Paimon? Che piacere vedervi qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490111,
					"content": "Amber? E ci sono anche Eula e Mika! Siete qui per cenare? Come mai così tardi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490112,
					"content": "Abbiamo appena portato a termine un incarico per una carovana di mercanti. Il piano originale era di consumare le nostre razioni da campo e proseguire a nord verso la Porta di pietra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490113,
					"content": "Ma la capitana Eula ha fatto notare che nessuno di noi gustava la cucina di Liyue da parecchio tempo. Così abbiamo pensato di passare alla locanda per ordinare qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490114,
					"content": "Ooh, quindi paga Eula, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490115,
					"content": "...Ahem! Abbiamo mangiato razioni da campo per tutto il viaggio, ho semplicemente pensato che fosse giusto consumare un pasto come si deve. È un problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490116,
					"content": "Bene, allora vi do il benvenuto alla Locanda Wangshu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "Bella domanda, cosa prendiamo... Mm? Aspetta un attimo, perché ci stai chiedendo cosa prendiamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490119,
					"content": "#{NICKNAME} ha dovuto sostituire lo chef! Siete arrivati al momento giusto, sarete i suoi ultimi clienti prima che lo chef effettivo riprenda servizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490120,
					"content": "Wow, davvero? È un bene che Eula abbia suggerito di venire qui! Non me lo sarei perso per nulla al mondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490121,
					"content": "Allora? Cosa prendiamo? Ehm... Non ho più molta familiarità con la cucina di Liyue come un tempo... Mika, Eula, cosa vi andrebbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490122,
					"content": "#Per me va bene tutto! Sono solo impaziente di provare la cucina {F#della Cavaliere Onoraria}{M#del Cavaliere Onorario}. Sono certo che sarà un'ottima occasione di apprendimento per me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490123,
					"content": "...Qualcosa di leggero, immagino. Appena finito di mangiare dovremo riprendere il viaggio. A parte questo, va bene tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490124,
					"content": "Non è stata tua l'idea di venire qui? Oook, è come cercare di cavare del sangue da una rapa... Va beh, immagino che spetti a te decidere, Amber. Dimmi cosa vuoi e lo prepareremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490125,
					"content": "Uh? Credo di volere... Eh, neanche per me ha importanza. Mi va bene tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490126,
					"content": "Uff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490117,
					"content": "Cosa vi porto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "La giornata non è ancora finita.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
		{
			"id": 4014902,
