						401499402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499402,
					"content": "Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499403
					]
				},
				{
					"id": 401499403,
					"content": "#...Ah, scusa. Ero persa nei miei pensieri, non ti ho {F#vista}{M#visto} arrivare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499404,
					"content": "Hai qualche pensiero per la testa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499405
					]
				},
				{
					"id": 401499405,
					"content": "Sì... Il piatto che ci hai appena cucinato, mi ha ricordato dei pasti che il nonno era solito prepararmi. Credevo di essermi dimenticata del loro sapore, ma in un istante mi è tornato tutto in mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499406,
					"content": "Preparava sempre piatti di Liyue. Facevo i miei allenamenti da Vigilante con lui fino a sera, e poi aspettavo pazientemente al tavolo per mangiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499407,
					"content": "...Rimanevo seduta lì, con un delizioso profumo che proveniva dalla cucina, in attesa che portasse la cena a tavola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499408,
					"content": "A volte, per cena c'era anche Eula, e anche se trovava sempre qualcosa di cui lamentarsi, sapevo che il cibo le piaceva veramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499409,
						401499410
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499409,
					"content": "Ah... Quindi magari si ricorda anche lei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				},
				{
					"id": 401499411,
					"content": "...Parole tue, non mie. Meglio non parlarle di questo, o rischi di sorbirti un'altra lamentela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499410,
					"content": "E forse è per questo che ti ha consigliato di venire a mangiare qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				}
			]
		},
