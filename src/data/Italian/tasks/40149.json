							363.918
						],
						"pointId": 310400534
					},
					{
						"sceneId": 3,
						"position": [
							924.154,
							258.972,
							367.775
						],
						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "...Mm, è delizioso! Stagionato alla perfezione, e persino il riso trabocca di sapore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490202,
					"content": "Non c'è nulla di meglio di un pasto caldo servito appena cotto... Mi era mancato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490203,
					"content": "#Eheh, hai appena dato scacco matto alle razioni più raffinate di Favonius, e non è un'impresa da poco... Dicci, {NICKNAME}, come si chiama questo piatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490204,
					"content": "Si chiama... Ahem... Paimon pensa che si possa chiamare semplicemente \"Mi va bene tutto\", ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490205,
					"content": "...Aiuto, Paimon non sa come spiegare questo piatto! Non ha un nome, ci sono solo degli ingredienti di base e la cottura è semplice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490206,
					"content": "#Ingredienti di base, cottura semplice? Davvero? Avrei giurato che ci fosse dentro qualche ingrediente raffinato, o che {F#la}{M#lo} chef ci avesse aggiunto il suo tocco magico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490207,
					"content": "Non è il piatto più raffinato del mondo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "Ma è quello che vi serve adesso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "Non è il piatto più raffinato del mondo, ma è quello che gli serve adesso...? Ok, Paimon ha perso il filo del discorso, cosa intendi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490210,
					"content": "Siete in viaggio da molto tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "E avete mangiato soltanto razioni da campo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "Quindi vuoi dire che... pensiamo sia buono solo perché abbiamo fame? Mm, non può essere solo per questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490213,
					"content": "...Forse l'aroma del cibo appena cotto è una piacevole novità rispetto alle fredde razioni da campo preconfezionate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490214,
					"content": "Ah, come la sensazione del profumo di pane appena sfornato la mattina? In effetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490215,
					"content": "Sì... Mi sembra quasi di essere tornata al Buon Cacciatore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490216,
					"content": "Eh? Ma il Buon Cacciatore è a Mondstadt... Perché provare la cucina di Liyue se non noti nemmeno la differenza di sapore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490217,
					"content": "Oh, non mi riferisco al sapore. Parlavo solo della sensazione di... conforto, sai? È come tornare a casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490218,
					"content": "Conforto... Tornare a casa... Beh, Yanxiao ha detto che dobbiamo far sentire i nostri clienti come se fossero a casa loro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490219,
					"content": "Ciò che rende saporito un piatto è estremamente soggettivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "I gusti sono gusti",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "Ma un cuoco cerca di soddisfare tutti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "Dobbiamo metterci nei loro panni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "#...E include anche la passione {F#della}{M#dello} chef nel mettere un sorriso sul volto dei clienti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "Quindi, in altre parole... l'ingrediente segreto è la \"passione\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490224,
					"content": "Sebbene suoni terribilmente scontato, ammetto che rispecchia la verità per questo piatto. Ben fatto... Appuntati le mie parole: ricorderò questa ricetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490225,
					"content": "Ok, ma una ricetta ha comunque bisogno di un nome, giusto? Come vuoi chiamare questo piatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490226,
						401490227
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490226,
					"content": "A dire la verità, non ci ho ancora pensato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490227,
