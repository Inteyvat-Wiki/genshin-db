						],
						"pointId": 310400533
					}
				]
			},
			"dialogs": [
				{
					"id": 401490401,
					"content": "\"Mi va bene tutto\", eh? Oh cielo... Questo è il peggior incubo di uno chef. Senza alcuna indicazione sui gusti del cliente non si può far altro che tirare a indovinare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490402
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490402,
					"content": "Tuttavia, ora che hai lavorato in cucina per così tanti giorni, sono certo che non sbaglierai. Avanti, mostragli quello di cui sei capace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490403
					],
					"speakerTitle": "Yanxiao"
				},
				{
					"id": 401490403,
					"content": "(Fammici pensare... Cosa potrebbe piacergli? Di cosa avranno voglia?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
