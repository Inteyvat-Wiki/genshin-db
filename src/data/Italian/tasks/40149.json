			"dialogs": [
				{
					"id": 401499601,
					"content": "Mi spiace! Non ho proprio idea di cosa mangiare... Potrei scegliere qualcosa a caso dal menù, ma mi sentirei più a mio agio se lo facesse lo chef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499602,
					"content": "Oh, solo una cosa. So di aver detto che mi va bene tutto, ma niente alcol, per favore. Nessuno di loro due beve... davvero un peccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499603
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401499603,
					"content": "H-Ho ancora dell'acqua frizzante qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				}
			]
		},
		{
