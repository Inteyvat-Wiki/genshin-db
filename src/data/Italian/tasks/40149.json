			"dialogs": [
				{
					"id": 401499801,
					"content": "Le razioni che abbiamo portato con noi sono ispirate ai miei famosi Tortini lunari. Per proporre qualcosa di ancora più delizioso... mi affido a te, hai fatto un ottimo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499802
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401499802,
					"content": "...Comunque, la prossima volta che passerete in città dovete provare la Torta tempestosa. Insisto.",
