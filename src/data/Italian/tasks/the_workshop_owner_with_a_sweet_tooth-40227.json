			"dialogs": [
				{
					"id": 402270101,
					"content": "Mh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270102,
					"content": "Ehi, voi due!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270103,
					"content": "#{NICKNAME}, Paimon, salve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270104,
					"content": "Stiamo sbrigando alcune faccende per conto di Nefer, abbiamo sentito che il Laboratorio di Krumkake parteciperà alla fiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270105,
					"content": "Affermativo. Aino sta effettuando un ultimo giro di debugging sui suoi \"Robot difensori Sberle e Ceffoni\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270106,
					"content": "Ah, è quello il suo progetto per la fiera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270107,
					"content": "Sì. Le talpe e altre piccole creature vengono spesso a rubare dal Laboratorio, così Aino si è basata su di loro per progettare degli appositi robot di difesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270108,
					"content": "Dopo dei test avanzati, si sono rivelati molto efficaci, così Aino ha deciso di apportare alcune migliorie al progetto per presentarlo alla fiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270109,
					"content": "Aspetta, quindi Aino ha davvero intenzione di vendere uno dei suoi robot?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270110,
					"content": "Non esattamente. A parte alcuni ordini speciali, è raro che Aino venda i suoi prodotti finiti. Quello che intende offrire durante la fiera è il progetto, non il prodotto finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270111,
					"content": "Ohhh... Beh, allora siete pronte ad andare, ragazze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270112,
					"content": "Jahoda ha chiesto di sbrigarvi. Vi ha messo da parte un posto fantastico e teme che la gente possa iniziare a fare domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270113,
					"content": "Le ho già detto che prima devo finire il debugging! Se mi mette fretta, non avrò nulla da mostrare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270114,
					"content": "Cavoli. Mai vista Aino così seria, prima d'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270115,
					"content": "Il Laboratorio sta attraversando una grave carenza di fondi. Aino spera che la fiera possa migliorare la nostra situazione economica, perciò vuole fare tutto con la massima cura possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270116,
					"content": "Dove sono finiti tutti i soldi? In qualche ricerca particolarmente costosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270117,
					"content": "Negativo. È il nostro budget per i dolci a essere insufficiente. Abbiamo avuto almeno 47 casi in cui l'acquisto eccessivo di dolci ha portato a una carenza di fondi per la ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270118,
					"content": "Pertanto, ho deciso di separare il budget per la ricerca da quello per i dolci. Ad Aino è vietato attingere da uno per trasferire fondi all'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270119,
					"content": "E, pochi giorni fa, ha prosciugato l'intero budget per i dolci del mese corrente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270120,
					"content": "Capisco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "Ecco, finito! Robot difensori Sberle e Ceffoni, fatemi onore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270123,
					"content": "Sembra che ora possiamo andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270121,
					"content": "Non mi sorprende affatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
