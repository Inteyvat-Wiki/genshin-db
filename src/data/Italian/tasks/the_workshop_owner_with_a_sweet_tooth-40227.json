			"dialogs": [
				{
					"id": 402270201,
					"content": "Conducete Aino e Ineffa al luogo dell'evento.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "Uhm... Questo sembra un buon punto per la pedana di presentazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270203,
					"content": "Questo nuovo robot sembra molto interessante, Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270204,
					"content": "Eheheh! Venite a provarlo quando volete! Vi lascerà a bocca aperta, garantito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270205,
					"content": "Grazie dell'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270206,
					"content": "Nessun problema! Oh, e per la registrazione, sarete solo voi due?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270207,
					"content": "Mmh... Parteciperò io, non c'è bisogno di registrare Aino. Non le piace stare in mezzo a troppe persone. Una volta iniziata la fiera, tornerà direttamente al Laboratorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270208,
					"content": "Ottima osservazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
