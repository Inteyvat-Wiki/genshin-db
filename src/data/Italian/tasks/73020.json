			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "#Sono così felice di aver raccolto il Fungo testone, completato la mia pratica culinaria e conosciuto u{F#na}{M#n} Nara forte e affidabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200402,
					"content": "#Anche Arapacati, Arasaka, Arapas e Araphala te ne saranno grati. Nara {NICKNAME}, sei u{F#na}{M#n} buo{F#na}{M#n} Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200403,
					"content": "Grati? Perché?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "Perché aiutandomi avranno la possibilità di assaggiare il Fungo testone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				}
			]
		},
		{
			"id": 7302005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
