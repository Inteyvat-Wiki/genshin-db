			"dialogs": [
				{
					"id": 730200501,
					"content": "(Sembra un po' più grande di un normale Fungoide. È meglio raccoglierlo più tardi, una volta eliminata la zona di Avvizzimento...)",
					"roleType": "TALK_ROLE_NPC",
