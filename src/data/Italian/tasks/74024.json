					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240703,
					"content": "O meglio, sei davvero in grado di ottenere \"colori chiari\" con materiali come questi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240704,
						740240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240704,
					"content": "Sospetto di no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "Ma Sluasi sembra felice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240708,
					"content": "#Comunque andrà, grazie a entramb{F#e}{M#i} per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240709,
					"content": "Per sdebitarmi, ecco a voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240710,
					"content": "Gemme brillanti, e componenti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240711,
					"content": "Eheh. Sono contenta che vi piacciano. Se in futuro vorrete delle decorazioni su misura, sapete dove trovarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240706,
					"content": "Non è proprio impossibile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "Vero, anche i colori che usa Mamère sono piuttosto strani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				}
			]
