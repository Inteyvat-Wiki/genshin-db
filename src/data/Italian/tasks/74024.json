			"dialogs": [
				{
					"id": 740240516,
					"content": "Sluasi esamina con cura il materiale prima di riconsegnartelo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240501
					]
				},
				{
					"id": 740240501,
					"content": "Ah, capisco, è questo il colore che chiamate \"bianco\", vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240502
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240502,
					"content": "Ho la sensazione che questo sia tutto il contrario del \"colore del sole\". Non pensate che il suo opposto sia più appropriato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240503
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240503,
					"content": "Il suo \"opposto\"... Vuoi dire il nero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240504,
					"content": "\"Nero\"... Certo, proprio quello. \"Nero\". Una soluzione brillante, stimata Paimon. Dev'essere quello il colore del sole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240505,
						740240506
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240505,
					"content": "C'è qualcosa di sbagliato in tutto ciò...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240508
					]
				},
				{
					"id": 740240508,
					"content": "Ma perché proprio il nero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240509,
						740240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240509,
					"content": "Beh, il sole è dorato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240512
					]
				},
				{
					"id": 740240512,
					"content": "In tal caso, posso chiedervi un'altra cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240513
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240513,
					"content": "Per favore, portatemi qualcosa di \"nero\". In questo modo, saprò che materiale usare per creare un \"colore radioso come il sole\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240514
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240514,
					"content": "Dobbiamo davvero cercarlo? Paimon pensa che stiamo iniziando ad allontanarci da qualsiasi cosa possa essere associata al sole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240515,
					"content": "Ma dato che ce l'ha chiesto... Andiamo a trovarle qualcosa di \"nero\", vuoi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240510,
					"content": "Per cui il sole di notte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240511
					]
				},
				{
					"id": 740240511,
					"content": "Il sole non diventa nero di notte! Lasciamo stare, di notte non c'è nemmeno il sole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240506,
					"content": "Proprio ciò che direbbe una persona della tua caratura, stimata Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240507
					]
				},
				{
					"id": 740240507,
					"content": "Ehi, smettila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
