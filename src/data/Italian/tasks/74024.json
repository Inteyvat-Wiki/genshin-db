				},
				{
					"id": 740241002,
					"content": "Ah, com'è caldo... ha un odore così buono ed è così soffice, davvero, come un bacio del sole. Gli umani se ne servono per cucinare? Comunque, grazie mille, mi ricorderò di quest'articolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241003
					],
					"speakerTitle": "Sluasi"
