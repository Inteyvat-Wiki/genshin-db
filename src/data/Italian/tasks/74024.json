			"dialogs": [
				{
					"id": 740241301,
					"content": "Ah, capisco, capisco... questa è la \"bacca\" di cui mi parlavi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740241302
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740241302,
					"content": "Freddo e duro, eppure morbido... e ti fa strizzare gli occhi come il sole di un pomeriggio d'inverno. Dev'essere sicuramente un metallo con cui gli umani forgiano le loro armi! Grazie mille. Mi ricorderò di questo articolo.",
