					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130202,
					"content": "La taverna non è troppo affollata e non potrei essere di umore migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 1011302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130211,
					"content": "Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130212,
					"content": "A distanza di tanti anni da quella tragedia, non è nemmeno più il suo amico a trattenerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130213,
					"content": "Ma credo che la gente di Mondstadt non dimenticherà quella storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 1011303,
			"completionStepIds": [
				1011303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011303",
							"2"
						],
						"stepId": 1011303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "Dimmi, Stanley... Dimmi cosa devo fare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130302,
					"content": "Eh? Perché continua a ripetere il suo nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130303,
					"content": "Sta nascondendo qualcosa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "Potrebbe esserci qualcun altro che si chiama Stanley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130307,
					"content": "*singhiozza* Oh, Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130308,
					"content": "Toccava a me! Avrei dovuto essere io a morire nel Mare Jivari quel giorno... Perché il tuo spirito non viene a impedirmi di usare il tuo nome? Perché, Stanley, perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130309,
					"content": "Se solo non avessi dovuto salvare un novellino come me, non saresti mai morto in quell'angolo di mondo senza vento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130310,
					"content": "Eri un famoso avventuriere, destinato a diventare una leggenda... Ma ora... non accadrà più, perché la tua vita è stata spezzata... E tutto a causa di un aiutante inutile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130311,
					"content": "Uhh... Qualcuno riesce a capire cosa sta succedendo qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130312,
					"content": "...Penso che il nostro amico sia davvero arrivato fino al Mare Jivari. E credo che anche la tragedia che ha vissuto lì sia reale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130313,
					"content": "Ma il vero avventuriere, il vero Stanley, era il suo compagno d'avventure. Non lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130314,
					"content": "Il vero Stanley è morto per salvare il nostro \"Stanley\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130315,
					"content": "Aspetta... Quindi l'unico motivo per cui il nostro Stanley si chiama Stanley è perché ha rubato il nome all'altro Stanley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130316,
					"content": "Temo sia proprio così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130317,
					"content": "Stanley, per così tanti anni ho vissuto nella paura... Paura che Mondstadt si dimenticasse di te... Per questo racconto le storie delle tue avventure ogni volta che ne ho l'occasione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130318,
					"content": "Mondstadt deve ricordare: Stanley ha raggiunto il centro del Mare Jivari... È il più grande avventuriere che sia mai esistito e la sua memoria vive ancora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130319,
					"content": "Stanley non morirà mai, perché... io sono Stanley! Io... sono Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130320,
					"content": "Mi dispiace, Stanley... Sto diventando troppo vecchio... ormai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130321,
					"content": "*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130322,
					"content": "Avete intenzione di origliare ancora per molto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130323,
					"content": "Ops! Che figuraccia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130305,
					"content": "C'è un altro Stanley.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "Sicuramente no. Nemmeno io ho mai sentito parlare di un altro Stanley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1011304,
			"completionStepIds": [
				1011304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011304",
							"2"
						],
						"stepId": 1011304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "*sospira* Andate via. Risparmiatemi le vostre domande... Lasciatemi in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130402,
					"content": "Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130403,
					"content": "Andatevene subito! Non fatevelo ripetere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130404,
					"content": "#Cavaliere Onorari{F#a}{M#o}! Venti! E Paimon! Sono così felice di trovarvi qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130405,
					"content": "Vi ho cercati dappertutto! Volevo ringraziarvi ancora per avermi aiutato a trovare la spada e lo scudo. Finalmente i miei genitori mi sostengono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130406,
					"content": "Oh... Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130407,
					"content": "Sì, davvero! Hanno anche detto che pagheranno qualcuno per aggiustare la Spada del Valore sfavillante e lo Scudo dell'Onore sublime, così potrò portarli in giro con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130408,
					"content": "È magnifico! Allora, Jack, questa è la parte in cui dici addio a Mondstadt e parti per un'intrepida avventura in giro per Teyvat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130409,
					"content": "No, non ancora. Al momento non ho le capacità necessarie per andare troppo lontano da casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130410,
					"content": "Inoltre, sono sicuro che Stanley abbia ancora qualche storia da raccontarmi. Eheh... Sono le sue storie ad avermi spinto a diventare un avventuriere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130411,
					"content": "Stanley, io... Oh, sei di nuovo ubriaco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130412,
					"content": "Allora ci vediamo domani. Dopo che i postumi della sbornia saranno svaniti, potresti raccontarmi qualche altra tua storia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130413,
					"content": "Stanley è davvero affezionato a quel ragazzo, non credete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130414,
					"content": "*singhiozza* Jack? Jack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130415,
					"content": "Jack se n'è andato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130416,
					"content": "Oh, capisco... Beh, grazie per non avergli svelato il mio segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130417,
					"content": "Eh? All'improvviso affronti la realtà? Non è da te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130418,
					"content": "È solo che, in questo momento... non avrei potuto reggere il suo sguardo. Il suo spirito d'avventuriere è così puro... senza macchia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130419,
					"content": "Sono solo un vecchio e stanco imbroglione incapace, ma quel ragazzo è una nuova stella splendente, dal grande potenziale... Non posso permettere che i suoi sogni vengano infranti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130420,
					"content": "Non sei un imbroglione totale... Le storie e le esperienze avventurose di Stanley sono tutte vere, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130421,
					"content": "Storie... Esperienze... Che senso hanno ormai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130422,
					"content": "A essere onesti, i miei ricordi delle avventure e di Stanley... sono un po' confusi, ormai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130423,
					"content": "Questo è il mio più grande segreto. E la mia più grande paura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130424,
					"content": "Per tutti questi anni ho vissuto solo per raccontare la sua storia. Ma la sua personalità e i dettagli della sua vita, non li ricordo più così chiaramente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130426,
					"content": "Per tutta la vita, è affogato nel senso di colpa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "Tutto ciò che gli resta è il suo amico immaginario...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "L'unica cosa che non potrò mai dimenticare... è che è morto in una terra senza vento, dove il suo spirito non potrà mai essere recuperato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130428,
					"content": "Esatto... Anche nella sua memoria, il vero Stanley non è più l'amico in carne ed ossa che conosceva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130429,
					"content": "Si è fissato con l'immagine di lui come guerriero segnato dalla battaglia... e quell'immagine lo ha tenuto prigioniero per tutta la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130430,
					"content": "Sono troppo vecchio... Non ho mai voluto dimenticare, eppure così tanto è scivolato via tra i miei ricordi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130431,
					"content": "Sono completamente e incredibilmente inutile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130432,
					"content": "Nessun avventuriere dovrebbe subire quella sorte... Mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130433,
					"content": "Io... Non ci posso credere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130434,
					"content": "Grazie a tutti! E grazie a te, Supremo Barbatos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130435,
					"content": "Mi dispiace, mi ci vorrà un po' per calmarmi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130436,
					"content": "Ma penso che... starò bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130437,
					"content": "Ah, fantastico! Stanley ha finalmente fatto pace con sé stesso e Jack potrà andare per la sua strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130438,
					"content": "Bisogna festeggiare! E con festeggiare intendo, ovviamente, brindare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130439,
					"content": "E per brindare intendi che non lascerai questa taverna finché non sarai troppo ubriaco anche per camminare, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130440,
					"content": "Ahah... no. Il vino qui è troppo caro. Jack me ne deve ancora, però... Mi ha promesso un'annata rara in cambio dell'aiuto ricevuto, ricordi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130441,
					"content": "Vado a prendere il vino. A fra poco! Incontriamoci al <color=#00E1FFFF>solito posto</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130443,
					"content": "Nessuno lo sa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "Penso di sapere dov'è... forse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "Va bene, ci vediamo lì!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "Eh? E dove sarebbe? Perché Paimon non ne ha mai sentito parlare? Ehi, Bardo stonato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130446,
					"content": "Ehi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011305,
			"completionStepIds": [
				1011305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130501,
					"content": "Ce l'avete fatta... Finalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130502,
					"content": "Specifica il posto la prossima volta, va bene?! Ti abbiamo cercato ovunque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130503,
					"content": "Mmmh... Allora... Almeno sei riuscito a trovare il vino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130504,
					"content": "Sì! Beh, più o meno... Jack ha fatto credere che fosse un'annata rara, in edizione limitata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130505,
					"content": "...invece è solo mezza bottiglia di normalissimo sidro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130506,
					"content": "Ah, che nostalgia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130507,
					"content": "La prima volta che ho visto questo panorama, non avevo ancora nemmeno assunto questa forma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130508
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130508,
					"content": "...Cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130509
					]
				},
				{
					"id": 101130509,
					"content": "Era circa duemilaseicento anni fa, prima che il mondo passasse sotto il dominio dei Sette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130510,
					"content": "A quel tempo, la Vecchia Mondstadt era governata da un tiranno, che aveva sigillato il perimetro della città con un feroce uragano. Nemmeno gli uccelli potevano entrare o uscire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130511
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130511,
					"content": "Vecchia Mondstadt? Oh, Paimon ricorda... È quella che oggi è considerata il Covo di Terrore alato, giusto? Ce ne avevi già parlato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130512,
					"content": "Esatto. Il tiranno dei venti che un tempo regnava da quella torre era Decarabian, Dio delle tempeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130513,
					"content": "All'epoca, io non ero che un soffio tra mille venti. Non ero un dio di nulla... Non avevo nemmeno forma umana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130514,
					"content": "Ero solo un minuscolo essere elementale che viveva nel vento, una leggera brezza che portava flebili cambiamenti per il meglio, o piccoli semi di speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130515
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130515,
					"content": "Un minuscolo essere elementale? Senza forma umana? Venti... vuoi dire che prima eri diverso da come sei adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130516,
					"content": "Già. Il mio aspetto attuale ha molto in comune con la storia del falso Stanley... Ho assunto la forma di un amico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130517,
					"content": "E poi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130518,
					"content": "Cos'è successo al tuo amico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130519,
					"content": "(La stessa situazione dell'amico di Stanley...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130520
					]
				},
				{
					"id": 101130520,
					"content": "Ehi, Paimon, vuoi ascoltare la parte successiva della storia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130521,
					"content": "Sì, certo! La suspense sta uccidendo Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130522,
						101130524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130522,
					"content": "Paimon, va' a prenderci un paio di mele.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130523
					]
				},
				{
					"id": 101130523,
					"content": "Ti sembra il momento di farsi venire voglia di mele? Fai sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130526,
					"content": "Ahahah, ti è venuto un certo... languorino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130527
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130527,
					"content": "Oh, sì, che languorino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130528
					]
				},
				{
					"id": 101130528,
					"content": "Uff! Paimon ne ha fin sopra i capelli di voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130529,
					"content": "Ah... Sai, sei così intelligente che a volte mi metti quasi a disagio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130530
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130530,
					"content": "Ma in fondo, forse è giusto che i veri amici riescano a capire cosa sta pensando l'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130531
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130531,
					"content": "Una bevanda rinfrescante, una brezza leggera... *sospira* Momenti come questi mi riportano sempre indietro con la memoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130532
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130532,
					"content": "A una canzone che ascoltai per la prima volta da lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130533
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130533,
					"content": "Ti ascolto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 101130524,
					"content": "Paimon, potresti portarci un po' di carne o di pesce?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130525
					]
				},
				{
					"id": 101130525,
					"content": "Ma Venti sta raccontando la sua storia! Come può venirti voglia di carne proprio adesso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}