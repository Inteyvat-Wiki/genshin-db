					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220410101,
					"content": "#Sei giunt{F#a}{M#o} proprio al momento giusto. C'è una cosa che mi dà pensiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410103
					]
				},
				{
					"id": 220410103,
					"content": "Ti ricordi di quel piccoletto, Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410104,
					"content": "Quel monellaccio è andato a giocare qui nei paraggi e non è ancora tornato. Inizio a temere che gli sia successo qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410105,
					"content": "Ti prego, aiutami a cercare Konbumaru e a riportalo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410106,
						220410108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410106,
					"content": "Consideralo fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "Magnifico. Ricorda, devi trovare Konbumaru e portarlo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410108,
					"content": "È scappato solo lui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "Sì... Forse si è arrabbiato perché l'ho sgridato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410110,
					"content": "Ah, perché quel piccolino non vuole ascoltare quanto gli si dice...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410111,
					"content": "A ogni modo, ti prego, trova Konbumaru e riportalo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
