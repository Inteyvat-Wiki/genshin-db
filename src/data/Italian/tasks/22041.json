				"points": []
			},
			"dialogs": [
				{
					"id": 220410301,
					"content": "Come procede? Hai trovato Konbumaru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410302,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410303
					]
				},
				{
					"id": 220410303,
					"content": "...Eh, cosa? È scappato di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410304,
						220410305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220410304,
					"content": "Vado subito a riprenderlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				},
				{
					"id": 220410306,
					"content": "No, non c'è bisogno di inseguirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410307,
					"content": "Quel piccoletto è ancora arrabbiato con me... Più tardi gli darò una lezione personalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410308,
					"content": "Ah, ormai è quasi un gatto adulto, perché è ancora così testone? Cosa faremmo se spaventasse gli umani che vengono a visitare il Santuario?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410309,
					"content": "Bene. Questo è per te, per ringraziarti dell'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410310,
					"content": "*sospira* Perché quel piccoletto non può essere docile come Meshi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410305,
					"content": "Oh, diamine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220410306
					]
				}
			]
		}
	]
