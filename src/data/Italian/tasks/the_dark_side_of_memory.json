			},
			"dialogs": [
				{
					"id": 60080101,
					"content": "#Vediamo un po' cos'è cambiato da quando ce ne siamo {F#andate}{M#andati}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080102,
					"content": "Non tanto quanto mi aspettavo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "Sì. Se non altro, sembra che le acque si stiano calmando. Tipico di Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080104,
					"content": "#Ciao, Lauma. Siamo {F#tornate}{M#tornati}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080105,
					"content": "Come sta andando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "Il lavoro di pulizia è stato più complicato di quanto mi aspettassi. Risolvere i problemi che si sono accumulati nel tempo è davvero difficile, per non dire altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080107,
					"content": "Credo che mi ci vorrà qualche altra settimana. Fortunatamente, quelli che sono rimasti sembrano aver superato la confusione iniziale e stanno diventando più proattivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080108,
					"content": "È come se fossero stati finalmente costretti ad aprire gli occhi sulla loro fede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080109,
					"content": "E tutto grazie a te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080110,
					"content": "No, io... avrei dovuto farlo molto prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080111,
					"content": "In questi giorni mi sono presa cura di me stessa, quindi mi sento bene. Ora dovrei essere in grado di aiutarti a indagare sul passato tramite il Midollo lunare che stai custodendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080112,
					"content": "Grazie per essertene ricordata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "A proposito... Hai sentito qualcosa su quel fantasma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080114,
					"content": "Ho provato a chiedere a delle persone, ma non ho avuto fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080115,
					"content": "E voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080116,
					"content": "Non abbiamo fatto molti progressi, ma ecco cos'abbiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080117,
					"content": "Ho capito... Sembra che anche voi abbiate un sacco di lavoro da fare. Ricordatevi di non trascurare la vostra salute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080118,
					"content": "#A ogni modo... Vieni con me, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "Cosa vedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080121,
					"content": "(Questa è... Nod-Krai? Ha un aspetto familiare...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "(Quella nel cielo è... una stella cadente?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "(No, aspetta! È la nostra astronave!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "È già finita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080125,
					"content": "Sembra sia successo tanto, tantissimo tempo fa. I ricordi che ho percepito sono estremamente confusi e caotici, quindi questo è tutto ciò che il mio potere mi permette di cogliere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080126,
					"content": "(Almeno ora sappiamo che la nostra nave è atterrata a Nod-Krai... Vicino alla Spiaggia di Sabbia Stellata, o così sembra.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#(Coincide con quello che mi ha detto {F#Aether}{M#Lumine}... Ma voglio saperne di più...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 60080129,
					"content": "Eh? Qualcosa non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080130,
					"content": "I fiori hanno cambiato colore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080131,
					"content": "(Questi fiori sono un riflesso dei poteri della Damigella. Questo significa che lei...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "(Ricordo che ha menzionato di voler usare il Midollo lunare per ripristinare parte del suo potere...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "Sì, dovremmo andare da lei per vedere se possiamo darle una mano in qualche modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080135,
					"content": "Lascerò fare a voi, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080136,
					"content": "Oh, un momento. Tieni! Questa è la medicina che avevi chiesto di aiutare a preparare al Consiglio dei segreti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080137,
					"content": "#Ah. Grazie per aver fatto tutta questa strada per portarla. Siete {F#state}{M#stati} di grande aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080138,
					"content": "Inoltre... Se posso, ho la sensazione che quella \"Kuu{RUBY#[S]Fanciulla lunare}tar\" possa aiutarti a visualizzare meglio i ricordi della tua astronave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080139,
					"content": "Ooh, è vero. Dopotutto, è la Kuutar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080140,
					"content": "Ma prima sarebbe meglio controllare come sta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080141,
					"content": "Ci vediamo più tardi, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
