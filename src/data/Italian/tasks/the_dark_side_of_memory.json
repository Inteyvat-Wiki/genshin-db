			},
			"dialogs": [
				{
					"id": 60080201,
					"content": "Oh... Non ha un bell'aspetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080202,
					"content": "S-Scusa per il disturbo, ma stai bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080203,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080204,
					"content": "Le tue condizioni si sono aggravate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "...Mi gira la testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080206,
					"content": "...È come se... stessi tornando sulla luna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080207,
					"content": "Aspetta, non può essere così terribile, vero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080208,
					"content": "Hmm? Io... sento il potere... della luna dentro di te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080209,
					"content": "Abbiamo recuperato il Midollo lunare dai Fatui. Può esserti utile in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Mmmh... E cosa vi serve stavolta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080211,
					"content": "Suvvia, non devi preoccuparti per questo. Pensa piuttosto alla tua salute, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080213,
					"content": "(Che sia diventata un'abitudine per lei, dopo aver vissuto così a lungo in relazioni di vantaggio reciproco...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "Potrei avere bisogno del tuo aiuto, in futuro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "...Oh, molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080216,
					"content": "Dammi la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080217,
					"content": "*sospira* Sono tornata sulla terra. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080218,
					"content": "Uuuh, i tuoi piedi non l'hanno mai lasciata... Comunque sia, ti senti meglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080219,
					"content": "Notevolmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080220,
					"content": "Che cos'hai fatto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "La luna nel tuo corpo è... silenziosa come un riflesso nell'acqua... Affascinante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080223,
					"content": "Ho solo tirato fuori dall'acqua un raggio della sua luce. Per ora mi basta per rimanere ben salda a terra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080224,
					"content": "Sento che ci sono stati anche altri cambiamenti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "È la \"Grazia della Dea della Luna\". Tutto ciò con cui entro in contatto riceve questo marchio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080226,
					"content": "È completamente innocuo e si dissolve col tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080227,
					"content": "A proposito, ora che hai riacquisito i tuoi poteri, vuoi custodire tu il Midollo lunare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080228,
					"content": "In ogni caso, è qualcosa che appartiene agli \"dèi\", giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080229,
					"content": "Sono i Resti di Aria, Dea della Luna eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080230,
					"content": "Quindi ha a che fare con... Aspetta, cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080231,
					"content": "Non lo sapevate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080232,
					"content": "Lauma ha detto che era diverso dagli altri frammenti, e che al suo interno poteva percepire un potere divino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080233,
					"content": "E ha detto bene. Quando ho tirato fuori quel raggio di luna dal Midollo, ho anche estratto alcuni ricordi al suo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080234,
					"content": "È per questo che so che appartiene alla Dea della Luna eterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080235,
					"content": "Ma anche Lauma ha osservato il passato usando il Midollo lunare. Perché lei non l'ha visto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080236,
					"content": "(Lauma ha detto di aver colto solo frammenti brevi e sfocati... Forse è qualcosa che solo una Dea della Luna può percepire...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "Tanto tempo fa, in cielo vi erano tre lune, ognuna appartenente a una dea regnante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080238,
					"content": "Ma dopo la Guerra delle fiamme funerarie, le tre perirono e due delle tre lune furono distrutte nel conflitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080239,
					"content": "Dopo la morte di Aria, i suoi poteri si sono fusi in questo Midollo lunare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080240,
					"content": "I Resti della Luna iridescente non sono mai stati trovati e, sebbene la Dea della Luna gelata sia morta, la sua luna non si è mai infranta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080241,
					"content": "Come affermato nella profezia, questa luna avrebbe dato alla luce una nuova divinità, che gli Eredi della Luna gelata chiamano \"Kuu{RUBY#[S]Fanciulla lunare}tar\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080242,
					"content": "Sento che il mio potere appartiene alla Luna gelata. Ma giace oltre il cielo falso, troppo lontano da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080243,
					"content": "\"Controllarlo\" è fuori questione... Anche solo percepirlo richiede uno sforzo immane...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080244,
					"content": "A-Aspetta, ora Paimon fa un riassuntino... Abbiamo il Midollo della Luna eterna, nessuno riesce a trovare quello della Luna iridescente... Quindi significa che hai il Midollo della Luna gelata dentro di te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080245,
					"content": "No, può formarsi solo dopo la morte della Dea della Luna. È una sorta di nucleo energetico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080246,
					"content": "È come se mi chiedeste se sulla luna ci sono delle rocce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080247,
					"content": "Ah, quindi stai dicendo che tu rappresenti il potere della Luna gelata, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080248,
					"content": "#Sì. Una divinità con una Gnosi viene chiamata Archon... Visto che tu porti il Midollo lunare, questo allora ti rende {F#una \"Dea della Luna\"}{M#un \"Dio della Luna\"}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080249,
					"content": "Non credo che sia la stessa cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "Non vuoi diventare come loro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080251,
					"content": "Non è questo il punto! E poi, perché sei così ansiosa di passare il titolo a qualcun altro?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080252,
					"content": "#Comunque, per ora lasciamo perdere questa storia del \"diventare {F#la Dea della Luna}{M#il Dio della luna}\". Stiamo solo chiedendo se dovremmo restituirti il Midollo lunare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080253,
					"content": "Io non lo desidero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080254,
					"content": "Prego?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080255,
					"content": "E nemmeno lui desidera venire da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080256,
					"content": "E... cosa significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080257,
					"content": "Quando sono entrata in contatto con il suo potere, ho percepito una sorta di... \"rifiuto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080258,
					"content": "Non posso che pensare che sia perché sono una Dea della Luna anch'io. Non possono sorgere due lune nello stesso momento, tantomeno possono consumarsi tra loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080259,
					"content": "Immagino che per ora dovrò tenerlo io, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "#Siamo {F#sicure}{M#sicuri} che sia giusto? Lauma ha detto che hai nascosto bene il suo potere, ma la Damigella l'ha percepito senza problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080261,
					"content": "Ed è della Caccia selvaggia che stiamo parlando, non di un nemico come gli altri. Se riesce a rilevare il Midollo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080262,
					"content": "La Caccia selvaggia? Parlate di quel fenomeno come se fosse una persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080263,
					"content": "Beh, sembra che dietro tutto questo ci sia una persona, e che abbia un obiettivo molto chiaro. Sta cercando il Midollo lunare senza sosta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080264,
					"content": "Questo mi ricorda qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080265,
					"content": "Uh? Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080266,
					"content": "Quand'ero ancora coi Fatui, i miei colleghi avevano menzionato qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080267,
					"content": "Era originario di Khaenri'ah e aveva ottenuto il potere dell'Abisso durante il Cataclisma... Oltre ad avere una fissazione per le lune...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080268,
					"content": "Khaenri'ah? Beh, non sappiamo se il fantasma che abbiamo visto c'entri qualcosa, ma i dettagli corrispondono... Com'è che si chiamava?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080269,
					"content": "So solo come lo chiamano gli altri: il \"Vindice di Solnari\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080270,
					"content": "Uno dei Cinque Peccatori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Ah... C'era anche quel titolo, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080272,
					"content": "Eh? Aspetta un secondo... Dain ne aveva parlato, vero? V-Vuol dire che il nostro nemico è Rerir, uno dei Cinque?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080273,
					"content": "In tal caso, dovrebbe essere più forte di così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "Ho sentito dire che è scomparso poco dopo il Cataclisma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080275,
					"content": "Ma quando ho chiesto ai miei colleghi dove fosse andato, hanno risposto: \"Davvero non lo sai?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080276,
					"content": "E perché hanno detto così...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080277,
					"content": "Si narra che sia caduto nel \"riflesso della luna\", da cui non esiste ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080278,
					"content": "Un attimo, aspetta, frena... Sono troppe informazioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080279,
					"content": "L'ho pensato anch'io. Ho avuto l'impressione che, secondo loro, ero io a dover sapere tutto sulle lune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080280,
					"content": "Ma, come ho detto... il mio \"prologo\" si trova oltre il cielo falso. Non ricordo nemmeno il mio nome...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080281,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080282,
					"content": "In ogni caso, dopo la sua partenza la situazione della Caccia selvaggia peggiorò drasticamente, e da allora è diventata sinonimo di disastro abissale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080283,
					"content": "Il fenomeno attuale ne avrà conservato il nome, ma supera di gran lunga l'incarnazione passata sia per dimensioni che letalità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080284,
					"content": "Uff. Se Paimon pensa che dovremo affrontare uno dei famigerati Cinque Peccatori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080285,
					"content": "Per noi è troppo! L'incidente sulla Spiaggia di Sabbia Stellata dev'essere stato un colpo di fortuna... O forse il suo potere non era al massimo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080286,
					"content": "Eppure, ha sconfitto la Marionetta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080221,
					"content": "...O meglio, cos'ho fatto io?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
			"id": 600804,
			"completionStepIds": [
				600802,
				600803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"La Damigella"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2143.145,
							109.201,
							11210.94
						],
						"pointId": 11739
					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "Mm? Cosa? Ti dispiacerebbe... ripetere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080402,
					"content": "Ehm... È la tua... ex-collega? Sì, eravamo sulla Spiaggia di Sabbia Stellata insieme, e anche lei è stata attaccata dalla Caccia selvaggia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080404,
					"content": "Hai appena... riso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080405,
					"content": "...No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080406,
					"content": "(E invece sì!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080407,
					"content": "Non andate d'accordo, per caso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "No... Ho solo immaginato la sua espressione contrariata dopo la sconfitta e l'ho trovata... interessante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080409,
					"content": "Sembrava piuttosto scossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "Oh, si riprenderà presto. È brava in questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080411,
					"content": "#Ok, comunque, siamo {F#andate}{M#andati} fuori tema. Ora che sappiamo quanto sia pericoloso il tipo che sta cercando il Midollo lunare... Sei {F#sicura}{M#sicuro} di volerlo continuare a custodire tu, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "Se le informazioni dei Fatui sono affidabili, Rerir prevarrà anche se tutta Nod-Krai si rivoltasse contro di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080413,
					"content": "Forse c'è qualcosa che lo limita... Seppur momentaneamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080414,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Prima di decidere ho un favore da chiederti, Colombina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "Cosa ti serve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080417,
					"content": "#Pensi di potermi mostrare cos'è successo quando io e {F#mio fratello}{M#mia sorella} siamo arrivati a Nod-Krai? Cioè, quando è atterrata la nostra astronave?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Certamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080419,
					"content": "Che rapidità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "Come ho già detto, per me non è niente di speciale, è come un raggio di luna. Niente di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080421,
					"content": "Dammi la mano, e preparati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(È quello che abbiamo visto prima, solo più nitido...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(Sembra che almeno siamo atterrati sani e salvi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(Pare sia trascorso molto tempo...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#(Siamo ancora all'interno della nave. E pensare che ci siamo stati così a lungo... Quand'è che {F#Aether è uscito}{M#Lumine è uscita}, mi chiedo?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(Un attimo. Ma {F#quello è Aether}{M#quella è Lumine}?!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(Ma come può essere? Nessuno ha lasciato la nave da quando siamo atterrati... Il portello non è ancora nemmeno aperto!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "Dove... sono?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{F#Lumine}{M#Aether}! Presto! Dobbiamo lasciare questo posto!",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "E-Ehi! Stai bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "La nostra astronave... È passato tantissimo tempo da quando siamo atterrati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#Nessuno è uscito dalla nave in quel momento, ma {F#Aether}{M#Lumine}... in qualche modo mi ha {F#trovata}{M#trovato} dall'esterno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "Eh?! Com'è possibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080437,
					"content": "Non lo so...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "I segreti nascosti nei ricordi sono come le briciole dei biscotti. Basta un morso, e cadono dappertutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080439,
					"content": "(Sta... succedendo qualcosa di davvero strano. Devo andare in fondo alla questione.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(Ma, come ha detto Nefer, se Nod-Krai venisse distrutta per prima, non ci sarebbe niente su cui indagare...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "Va bene... Continuerò a custodire il Midollo lunare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "Uhh... Beh, se la metti così Paimon non ti può fermare, ma... Oooh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080444,
					"content": "Avrai bisogno di aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080445,
					"content": "Per cosa...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "Potrei aiutarti a nascondere il Midollo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080447,
					"content": "Davvero? Sarebbe grandioso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "Rilevarlo dentro di te è già un'impresa, ma posso insegnarti a nasconderne la presenza usando il Kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080449,
					"content": "Così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080450,
					"content": "Ohh! Sembra uno scudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(È così... morbido e delicato... Proprio come il chiaro di luna...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "Riesci a percepirlo? Ora prova a mantenerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080453,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "Impari piuttosto in fretta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080455,
					"content": "Uh. Sembra abbastanza robusto. Potrebbe essere usato per difendersi nei momenti di difficoltà, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080456,
					"content": "Grazie per avermelo insegnato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "Sei sempre qui, Colombina? Qui fuori è un po' pericoloso, certo, ma non hai mai pensato di uscire a fare una passeggiata o qualcosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080458,
					"content": "Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080459,
					"content": "...Non sopporto gli estranei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080460,
					"content": "E noi cosa siamo per te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "Un pochino meglio degli estranei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080462,
					"content": "Una volta che tutta questa storia della Caccia selvaggia sarà finita...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "Esatto! Gli Eredi della Luna gelata sono cambiati dall'ultima volta che li hai visti. Chissà? Potrebbero persino piacerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080465,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080466,
					"content": "Ci penserò su...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080467,
					"content": "Sembra piuttosto stanca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080468,
					"content": "Probabilmente è da un po' che non parla così tanto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "In ogni caso, grazie mille per aver accettato di aiutarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080470,
					"content": "...Non ho fatto nulla di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080471,
					"content": "#Questi fiori... adorano {F#le}{M#gli} ospiti come voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 60080463,
					"content": "Faremo una passeggiata assieme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}