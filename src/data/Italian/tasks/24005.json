			},
			"dialogs": [
				{
					"id": 240051201,
					"content": "Scusa per il disturbo, ora mi occuperò di loro. Qualcuno deve impedirgli di perdersi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051202
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240051202,
					"content": "Se riuscissi a diventare un critico per l'Uccello a vapore, potrei guadagnarmi da vivere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240051203,
					"content": "Ma Monsieur Delerue ha detto che, se voglio diventare un critico, non devo fissarmi troppo con i Mora. Altrimenti, comincerei con il piede sbagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051204
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240051204,
					"content": "Ma io ho veramente bisogno dei Mora... Cosa dovrei fare...? *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		}
	]
