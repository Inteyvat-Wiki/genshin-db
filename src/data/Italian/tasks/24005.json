			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verut",
					"Aurèle",
					"Lovi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "Dai, da questa parte! Non avevamo ancora visto quella grande casa, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "Non correre, Verut, o cadrai di nuovo. Anche tu, Lovi. Tuo padre ha detto che la tua salute è cagionevole, potresti prenderti un raffreddore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050103,
					"content": "Uff, tuo fratello è una vera lagna, proprio come mia madre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "Lo so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "Voi due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050106,
					"content": "Ci ritroviamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "Ehi, sei tu! Beh, stavolta non stiamo giocando a nascondino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "Per essere più precisi non stiamo più giocando... e ci siamo anche beccati una lavata di capo da Mademoiselle Nour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050110,
					"content": "È sempre così seria quand'è al lavoro, con le sue prediche assillanti... E pensare che in passato le avevo persino regalato dei biscotti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "Beh, comunque sia eravamo stanchi. Volevo portare Verut e Aurèle a prendere qualcosa di buono da mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "Che ne diresti di unirti a noi nella nostra... Mm... com'è che si dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "Passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050114,
					"content": "Sì, passeggiata! Vieni con noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "Andiamo nella piazza laggiù. Voglio vedere la fontana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "Va bene, allora facci strada, signorina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Va bene, allora! Andiamo prima nella piazza. Ci sono delle fontane molto belle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "Va bene, allora facci strada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "Cosa state facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
		{
