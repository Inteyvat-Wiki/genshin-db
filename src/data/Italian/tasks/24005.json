				]
			},
			"dialogs": [
				{
					"id": 240050201,
					"content": "Wow... Come vorrei saltarci dentro per rinfrescarmi i piedi o farci un bagno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050202,
					"content": "Ti rimprovererebbero. Limitati a guardarle, per piacere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050203,
					"content": "Ma se la gente non può giocare con le fontane, perché sono così grandi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050204,
					"content": "Saranno anche belle, ma se si possono soltanto guardare, allora non sono altro che delle pozze d'acqua. Che barba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050205,
					"content": "Questa non è una fontana normale, sai. Ma... Aspetta, mio padre parlava di fontane ordinarie... Cos'è che ha detto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050206,
					"content": "\"L'obiettivo principale dei progetti d'abbellimento della Corte di Fontaine è quello di risolvere i problemi relativi alla dichiarazione delle tasse in maniera flessibile.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050207,
					"content": "Monsieur Delerue me lo stava per l'appunto spiegando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050208,
					"content": "Ah, per un attimo mi era sembrato di sentire parlare mio padre. Non mi stupisce che tu gli piaccia, Aurèle... Ogni volta che parla con te, tira fuori una montagna di libri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050209,
					"content": "Non ci ho capito una parola, ma scommetto che mio fratello sta di nuovo rovinando l'atmosfera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050210,
					"content": "Lovi, cerchiamo un altro posto per giocare. Cioè... Ora non devi studiare, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050211,
					"content": "Va bene, cerchiamo un altro posto. Fammi pensare... L'Uccello a vapore dovrebbe essere ancora aperto. Andiamo là!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
