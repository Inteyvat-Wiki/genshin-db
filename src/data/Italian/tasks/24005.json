				]
			},
			"dialogs": [
				{
					"id": 240050401,
					"content": "Monsieur Louis! Vorrei... un po' di porzioni di patatine al gusto di Bulle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050402,
					"content": "Ah, la solita Lovi! Temo di aver finito i Bulle per oggi. C'è stato il pienone al porto, mi dispiace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050403,
					"content": "M-Ma gliel'avevo anticipato, ricorda? Ho anche portato degli amici con me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050404,
					"content": "*sospira* Sono spiacente. Oggi sono venuti tantissimi clienti, e mi sono dimenticato... Però ho delle patatine classiche. Tieni, le offre la casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050405,
					"content": "Va bene, allora. Grazie, Monsieur Louis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050406,
					"content": "Sei senza Bulle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "Beh, se ne avessi qualcuno, potrei preparare della salsa seduta stante. Mi sono rimasti dei condimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050409,
					"content": "Evviva! Sei davvero un mito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050410,
					"content": "Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050411,
					"content": "Mi dispiace. Sembra che ogni volta che c'incontriamo tu debba risolvere qualche nostro problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050412,
					"content": "Non c'è bisogno di essere tanto formali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "Va bene. Dovrei imparare da te. Monsieur Delerue dice che sono troppo flemmatico, il che m'impedirà di essere un bravo critico, in futuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050415,
					"content": "*tossisce* Non importa. Terrò d'occhio quei due. Per quanto riguarda i Bulle, contiamo su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050413,
					"content": "Non è il caso di demoralizzare tutti quanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "Potrei procurartene qualcuno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
