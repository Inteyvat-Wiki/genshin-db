				]
			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "Dunque questo sarebbe l'Uccello a vapore? Non... sembra tanto speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050302,
					"content": "Un luogo piuttosto normale, sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "Wow, hanno davvero un uccello meccanico qui! Mitico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050305,
					"content": "Vero? Mio padre mi ci porta spesso per comprare il giornale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050306,
					"content": "Adora l'Uccello a vapore. Passerebbe tutto il giorno a leggerlo. Certe volte ritaglia addirittura degli articoli e li incolla in un quaderno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050307,
					"content": "Dice che sono le sue \"recensioni\", e talvolta le legge anche a me e a mia madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050308,
					"content": "A noi non interessano molto, però. Commentiamo solo con dei \"Sì\", \"Oh\", \"Davvero?\" e robe così, ma lui è talmente preso dalla lettura che non ci fa caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050309,
					"content": "E cosa intende per \"recensione\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "In pratica, una recensione è un'opinione che il critico esprime da una prospettiva personale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050311,
					"content": "Delerue, il padre di Lovi, è uno scienziato dell'Istituto di ricerca di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050320,
					"content": "In più, scrive recensioni sull'Uccello a vapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050312,
					"content": "Sì, e adora dilungarsi in recensioni su... beh, ogni cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050313,
					"content": "Talvolta pensa a voce alta, e corre nella sua stanza a scarabocchiare qualcosa. Non mangia nemmeno, beve solo del tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050314,
					"content": "Però! Puoi guadagnare Mora solo dando la tua opinione su qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050315,
					"content": "Quello non basta a renderti un \"critico\". Se vuoi scrivere una recensione degna di nota, devi seguire alcune regole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050316,
					"content": "Mm... Ehm... Beh, qualcuno ha fame?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050317,
					"content": "Monsieur Louis mi ha detto che ha aggiunto le patatine al gusto di Bulle al menù. Andiamo a provarle, offro io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050318,
					"content": "Oh... Beh, sicuro! Dai, fratello. Piantala di straparlare, muoviamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050319,
					"content": "Voi due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050303,
					"content": "Non ha nulla di speciale, già.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				}
			]
		},
