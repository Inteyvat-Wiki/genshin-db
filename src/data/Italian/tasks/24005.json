			"dialogs": [
				{
					"id": 240050601,
					"content": "Questi dovrebbero andar bene. Datemi un momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050602
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050602,
					"content": "Louis inizia a preparare la salsa di Bulle...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240050603
					]
				},
				{
					"id": 240050603,
					"content": "Et voilà! Come ho già detto, queste patatine appena sfornate le offre la casa. Potete mangiarle subito, ma attenzione: scottano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050604
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050604,
					"content": "Wow! Forza, abbuffatevi. Sono buonissime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050605
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050605,
					"content": "Oh, e Aurèle... Non dirlo a mio padre, o mi farà di nuovo la predica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050606,
					"content": "Eh, non preoccuparti. In ogni caso, dubito che a Monsieur Delerue interesserebbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050607
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050607,
					"content": "Beh... E io?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050608
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050608,
					"content": "Tu limitati a mangiare. Potete dividervi la mia porzione. Le patatine non mi fanno impazzire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050609
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050609,
					"content": "Eheheh, in tal caso non farò i complimenti! Forza, dovresti provarne un po' anche tu. Ed è tutto grazie a te, eheh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050610,
					"content": "Ah, giusto, più tardi devo comprare del caffè a Monsieur Delerue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050611,
					"content": "Un momento, non puoi! La mamma ha vietato a papà di bere caffè già da tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050612,
					"content": "Ogni volta che beve caffè inizia a tossire all'infinito nella sua stanza. Gli viene persino la raucedine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050613
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050613,
					"content": "Papà dice che lo fa per questioni di lavoro, ma che razza di lavoro ti obbliga a soffrire così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050614
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050614,
					"content": "...Che sia il \"prezzo\" da pagare per scrivere delle ottime recensioni di cui ci aveva parlato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050615
					],
					"speakerTitle": "Aurèle"
				},
				{
					"id": 240050615,
					"content": "Il lavoro di un critico sembra parecchio faticoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurèle"
				}
			]
		},
		{
