	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Arama",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "#Oh! Guarda un po' chi si vede, {F#la}{M#il} Nara dorat{F#a}{M#o}! Ahimè...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130102,
					"content": "#Arapacati non deve avere paura. Nara {NICKNAME} è Nara buon{F#a}{M#o}, come {F#il}{M#la} Nara dei racconti. Nara {NICKNAME} e Paimon ci hanno aiutato molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130103,
					"content": "#Va bene, Arapacati non ha paura. Arapacati si fida di Arama, di erba, di foglie e di semi. Tutti dicono che sei Nara buon{F#a}{M#o}. Ciao, Nara {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130104,
					"content": "Ciao, Arapacati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130105,
					"content": "#E se in realtà fossi cattiv{F#a}{M#o}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "Ehi! Non fare scherzi del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130107,
					"content": "#Sei buon{F#a}{M#o}. Arapacati lo sa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130108,
					"content": "#Tanti venti portano tanti piccoli semi che arrivano nel Vanarana con Nara. Loro dicono che Nara {NICKNAME} è brav{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130109,
					"content": "Anche Arama ha detto una cosa del genere! A questo proposito, \"tanti venti portano tanti piccoli semi\"... Intendi forse i semi di dente di leone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130110,
					"content": "O i semi di Asteria del vento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#Nara {NICKNAME} aiuterà Arana a creare un Bija. Così prepareremo insieme il Festival di Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130116,
					"content": "Oh, il Festival di Utsava...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130117,
					"content": "Arapacati ha un'aria strana. Qualcosa ti preoccupa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130118,
					"content": "Fratelli maggiori di Arapacati non sono tornati nel Vanarana. Non possiamo festeggiare Festival di Utsava insieme se non tornano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130119,
					"content": "Anch'io non vedo Arachatora, Arasaka, Arapas e Araphala nel Vanarana da molto tempo. Non li ho più visti, dopo l'incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130120,
					"content": "Da quanto tempo, di preciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130121,
					"content": "Molte, molte lune fa, quando piantine erano appena germogliate. Ma ora sono già alberi grandi, così grandi da tenere pioggia lontana dagli Aranara! Sono alti quanto sette Arapacati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130122,
					"content": "Da piantine ad alberi... Wow, è davvero tanto tempo, allora! I tuoi fratelli sono scomparsi, Arapacati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130123,
					"content": "Scomparsi? È un tipo di seme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130124,
					"content": "Ooh! Quindi semi dei Nara si chiamano \"Scomparsi\"? Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130125,
					"content": "#Nara sono fantastici! Nara {NICKNAME} deve avere molti Scomparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130126,
					"content": "Uhm, non è quello che intendevamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130127,
					"content": "\"Scomparsi\" significa che non sai dove si trovano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "Oh, non è così. Arapacati sa dove sono Arachatora, Arasaka, Arapas e Araphala. Fratelli non sono scomparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130129,
					"content": "Loro fanno addestramento nel Vanarana da molto, molto tempo. Pratica culinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130136,
					"content": "Oh, pratica culinaria. Paimon ha capito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130137,
					"content": "Sembra qualcosa che piacerebbe molto anche a Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#Mmmh... Paimon è più interessata alla pratica culinaria di {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130139,
					"content": "Quindi, in cosa consiste di preciso questa pratica culinaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130140,
					"content": "È successo tutto durante ultimo Festival di Utsava. I Nara hanno preparato molto cibo da far assaggiare agli Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130141,
					"content": "Così, per cucinare cibo in cambio per i Nara durante questo Festival di Utsava, Arachatora e altri hanno iniziato la pratica culinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130142,
					"content": "Paimon non vede l'ora che arrivi il Festival di Utsava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130143,
					"content": "Ma è il cibo degli Aranara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "Il piacere del cibo è il linguaggio comune di tutte le creature viventi! Andrà tutto bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130146,
					"content": "Ma Arapacati, dato che sai dove si trovano, perché non vai a cercarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130147,
					"content": "Grandioso Festival di Utsava sta per iniziare. Arapacati deve preparare tante cose. Non ha tempo per andare a cercarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130148,
					"content": "Se ne sono andati nel Vanarana per imparare a cucinare cibo per Festival di Utsava. Ma non sanno che Festival di Utsava sta per iniziare! Arachatora, Arasaka, Arapas e Araphala stupidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130149,
					"content": "#Allora lascia che ce ne occupiamo noi! Andremo nella foresta con Arama a cercare gli Aranara e penseremo anche ai preparativi per il Festival di Utsava. Giusto, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130150,
					"content": "Lascia fare a noi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "Ma come faremo a trovare Arachatora, Ara... Non ricordo gli altri nomi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130153,
					"content": "Arachatora, Arasaka, Arapas, e Araphala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130154,
					"content": "Uff! Arana, Arama, Araja, Arapacati... I nomi degli Aranara sono così difficili da ricordare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130155,
					"content": "Paimon, non dire queste cose su nomi degli Aranara. Renderai gli Aranara tristi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130156,
					"content": "Va bene. Allora, come facciamo a trovarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130157,
					"content": "Facevano pratica culinaria qui nel Vanarana. Ma facevano troppo fumo, così Arapacati li ha cacciati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130158,
					"content": "Tutti erano molto spaventati. Alcuni Aranara andarono addirittura in letargo. Per fortuna Arama ha avuto coraggio e ha eliminato fumo. Arapacati era furiosa e li ha cacciati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130159,
					"content": "Quindi, per trovarli, basterà cercare nella foresta le <color=#00E1FFFF>colonne di fumo che si levano in cielo</color>, credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130160,
					"content": "Quindi li hai cacciati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130161,
					"content": "Sì. Ho sbagliato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130162,
					"content": "#Uhm, non proprio... A ogni modo, dobbiamo andare, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130163,
					"content": "Oh, giusto. Un'altra cosa: se fratelli si comportano in modo strano, colpiscili con <color=#00E1FFFF>potere di Dendro</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130164,
					"content": "In passato, hanno creato molto, molto fumo. Tutto nel Vanarana era piena di fumo. Anche loro avevano paura e correvano dappertutto. A volte diventavano così anche quando toccavano strani funghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130165,
					"content": "Ma gli Aranara sono spiriti della foresta. Quindi possiamo riprenderci e riacquistare i sensi assorbendo <color=#00E1FFFF>potere di Dendro</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130166,
					"content": "#Paimon ha capito ora. Seguendo questa logica, {NICKNAME} si riprende dopo aver mangiato il pollo ai Fiordolci, quindi {NICKNAME} deve essere uno spirito del pollo ai Fiordolci. Sì, ha perfettamente senso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130167,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130169,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130170,
					"content": "...Comuuunque, diamoci una mossa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130172,
					"content": "#Buona fortuna, Nara {NICKNAME}! Buona fortuna, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130171,
					"content": "Sì, andiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "Non vedo l'ora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "So cosa si prova...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#Nara {NICKNAME} sa come mi sento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130132,
					"content": "#Sì, anche {NICKNAME} ha {F#un}{M#una} {F#fratello}{M#sorella} scompars{F#o}{M#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130133,
					"content": "#Oh. Nara {NICKNAME}, anche tu{F#o}{M#a} {F#fratello}{M#sorella} sta facendo pratica culinaria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130134,
					"content": "Eh? Paimon crede che ci sia un malinteso... Se una persona è scomparsa significa che non sai dov'è andata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130135,
					"content": "Oh, non è così. Arapacati sa che fratelli maggiori non sono scomparsi. Vanno a fare addestramento lontano nel Vanarana per molto, molto tempo. Pratica culinaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130111,
					"content": "O forse delle pigne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "Che siano stati i venti ad aver portato i semi di quelle storie...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130114,
					"content": "Ciao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301302",
							"2"
						],
						"stepId": 7301302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "...È così difficile parlare con i Nara, e sono così alti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130202,
					"content": "Ciao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#Aaah! È Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130204,
					"content": "Arapacati non ha paura. Fratelli sono molto coraggiosi, quindi neanche loro hanno paura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130205,
					"content": "Dovresti trovarli avvicinandoti alle <color=#00E1FFFF>colonne di fumo</color>. Se si comportano in modo strano, colpiscili con il <color=#00E1FFFF>potere di Dendro</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "Arapacati è mooolto arrabbiata! Grrr! Più che arrabbiata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130302,
					"content": "Foresta è molto pericolosa perché Marana dilaga lì. Prima di loro partenza, Arapacati ha ricordato a fratelli di collaborare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130303,
					"content": "Ma avete iniziato a litigare appena andati via. Arachatora, tu hai anche mangiato cosa strana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130304,
					"content": "*singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130305,
					"content": "Arapacati ha deciso. Arachatora non può raccogliere funghi finché Tramontini non sono maturati dieci volte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130306,
					"content": "Noooo... *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130307,
					"content": "Esattamente! Cos'avremmo fatto se avesse portato spore cattive e se fossero cresciuti funghi mostruosi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130308,
					"content": "Araphala, parlo anche con te! Hai raccolto frutti molto lontano dal Vanarana. Ci sono molte cose brutte laggiù! Araja ce ne ha parlato apposta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130309,
					"content": "*singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130310,
					"content": "Esatto. Frutti hanno bisogno di bere acqua e Aranara ha bisogno di bere acqua, quindi acqua è cosa migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130311,
					"content": "Arapas, tra tanti posti dovevi proprio andare alla Macchina di Varuna? Non lo sai che perfino Nara Varuna ha detto che acqua del Vanarana è la più buona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130312,
					"content": "*singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130313,
					"content": "E-Ecco, solo il \"sapore della felicità\" può rendere felice nostra sorella più piccola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130314,
					"content": "#Arasaka, ho saputo che hai causato molti problemi a Nara {NICKNAME} per via del tuo \"sapore della felicità\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130315,
					"content": "T-Tutto ciò che ho fatto è per la \"Prelibatezza suprema\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130316,
					"content": "Lo scopo di preparare la \"Prelibatezza suprema\" è di far vedere frutti di \"pratica culinaria\". Ma a cosa serve pratica se la puoi completare solo con aiuto di qualcun altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130317,
					"content": "Arapacati pensa che Arasaka abbia bisogno di riflettere su di sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130318,
					"content": "*singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130319,
					"content": "Arapacati! Siamo qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130320,
					"content": "Ah, voi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130321,
					"content": "#Nara {NICKNAME} e Paimon hanno aiutato Arapacati e risolto problema alla radice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130322,
					"content": "Grazie a voi, Arapacati non deve più preoccuparsi che fratelli perdano il Festival di Utsava o che siano in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130323,
					"content": "Arapacati e fratelli sono tutti riconoscenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130324,
					"content": "Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130325,
					"content": "Ma c'è una cosa che Paimon è curiosa di sapere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130326,
					"content": "#Chi è quest{F#o}{M#a} Nara Varuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "#È nostr{F#o}{M#a} amic{F#o}{M#a}, {F#un amico}{M#un'amica} del Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130328,
					"content": "#{F#Un amico}{M#Un'amica} di Aranara di tanto, tanto tempo fa. {F#Un}{M#Una} Nara dorat{F#o}{M#a} proprio come Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130329,
					"content": "Oh. Paimon ha ancora un'altra domanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130330,
					"content": "Si tratta dei suoi fratelli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "Sì. Arapacati, quale tra i tuoi fratelli è il più grande e quale è il più piccolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130332,
					"content": "Mmmh? Il più grande e il più piccolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130333,
					"content": "Le loro età...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "Età... Ah, Arapacati capisce. Come anelli per alberi. Mmmh, Figli della foresta non si distinguono per età.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130337,
					"content": "Eh? Allora perché loro sono tuoi fratelli e tu sei la loro sorella minore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130338,
					"content": "#Oh, ti spiego. Tempo fa avevamo {F#un}{M#un'} amic{F#o}{M#a} Nara: Nara Varuna. Diceva di avere {F#una}{M#un} \"{F#sorella}{M#fratello}\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130339,
					"content": "#Quando Arapacati e fratelli {F#lo}{M#la} sentirono parlare {F#della}{M#del} \"{F#sorella}{M#fratello}\", Nara Varuna sembrò felice e triste allo stesso tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130340,
					"content": "In questo modo abbiamo capito che \"sorella minore\" è Nara importante per \"fratello maggiore\". E \"fratello maggiore\" è Nara importante per \"sorella minore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130341,
					"content": "Abbiamo pensato fosse molto bello, così Arapacati e fratelli hanno deciso di diventare fratelli e sorelle. Nara Varuna sembrava felice. Dovremmo tenerci stretta nostra famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130342,
					"content": "Proprio così, la famiglia è un tesoro da custodire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "Mmmh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130344,
					"content": "Paimon ha un'ultima domanda... Gli Aranara hanno bisogno di mangiare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130345,
					"content": "Umani trasformano ingredienti in cibo, e anche Figli della foresta sanno trasformare ingredienti in cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130346,
					"content": "Nara Varuna ci ha insegnato come mangiano i Nara. Ecco perché Arapacati e fratelli hanno iniziato pratica culinaria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130347,
					"content": "Paimon ha capito, anche se è decisamente strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130348,
					"content": "È come se steste facendo un gioco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "Arapacati e fratelli sono seri perché Nara Varuna ha detto che condividere cibo è cosa molto bella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130351,
					"content": "#Oh, Arapas ha detto che anche Nara {NICKNAME} sa cucinare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130352,
					"content": "#Sì! Le abilità culinarie di {NICKNAME} sono state abbondantemente messe alla prova!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130353,
					"content": "#Arapacati ha capito... Nara {NICKNAME} deve andare al Festival di Utsava e cucinare con fratelli di Arapacati. Loro sono principianti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130354,
					"content": "Stupiscili mostrando loro le vere abilità culinarie e il cibo che solo i Nara conoscono e che gli Aranara non possono capire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130355,
						730130356
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130355,
					"content": "Proverò a non farvi rimanere a bocca aperta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "Arapacati non vede l'ora. Questo Festival di Utsava sarà fantastico!",
					"roleType": "TALK_ROLE_NPC",
