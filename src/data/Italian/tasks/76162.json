			},
			"dialogs": [
				{
					"id": 761000701,
					"content": "Levati di mezzo, muoviti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "Eheh... Quanta fretta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000703,
					"content": "In un modo o nell'altro, morirete tutti... Ma alcuni di voi, avranno solo il privilegio di andarsene un po' prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000704,
					"content": "Si lamentava di non essere morto allora... tre anni fa... Perciò, adesso... esaudirò il suo desiderio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000705,
					"content": "...Bjorn? Che cosa gli hai fatto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "Era troppo debole... I deboli... inutili... insetti striscianti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000707,
					"content": "...Sono buoni solo a morire, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000708,
					"content": "Non osare insultarlo! Lui non è affatto debole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "Ah... Ai tuoi occhi... era una persona forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000710,
					"content": "Ma... anche i più forti alla fine muoiono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000711,
					"content": "Pensavo che tu potessi capirlo meglio di chiunque altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000712,
					"content": "Quelli più forti di te... sono morti tutti, dico bene? Sono morti tre anni fa... e anche dieci anni fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000713,
					"content": "...Stai zitto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "Sì... L'unico debole qui... sei tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000715,
					"content": "Altrimenti... perché ogni volta... ogni singola volta... sei l'unico a sopravvivere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000716,
					"content": "Sei fuggito dal campo di battaglia, non è vero? Un semplice codardo aggrappato alla vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Voce del mostro"
				},
				{
					"id": 761000717,
					"content": "Illuga, non ascoltarlo! Sono tutte sciocchezze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "Ora basta! È ora di morire!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#...{NICKNAME}! Risolviamola alla svelta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
