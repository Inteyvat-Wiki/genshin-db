				]
			},
			"dialogs": [
				{
					"id": 761001601,
					"content": "...Come sta Bjorn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001602
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001602,
					"content": "...È ferito gravemente. L'attacco è stato troppo improvviso e, per proteggerci, lui... *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001603
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001603,
					"content": "...Il campo di battaglia era troppo pericoloso e lui non era in condizioni di essere spostato. Non abbiamo avuto altra scelta che curarlo qui sul posto, ma con le nostre attuali risorse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001604
					],
					"speakerTitle": "Egle"
				},
				{
					"id": 761001604,
					"content": "Capitano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001605
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001605,
					"content": "Bjorn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001606
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001606,
					"content": "Mi dispiace... Non sono riuscito... a completare la missione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001607
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001607,
					"content": "Sei stato grande! La postazione è ancora sicura e sono tutti salvi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001608
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001608,
					"content": "Davvero...? Allora ce l'ho fatta... Meno male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001609
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001609,
					"content": "Smetti di parlare. Devi riposarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001610
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001610,
					"content": "Se non lo dico ora... non avrò un'altra occasione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001611
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001611,
					"content": "...Non dire così! È un ordine del tuo capitano! Andrà tutto bene... Starai bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001612
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001612,
					"content": "Ah... D'accordo... Agli ordini... Non lo dirò più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001613
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001613,
					"content": "Se non altro... finalmente potrò affrontare Veyde... senza rimpianti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001614
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001614,
					"content": "Lui direbbe che... noi Guardaluce siamo... come l'Erba invernale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001615
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001615,
					"content": "Di fronte alla Caccia selvaggia... ognuno di noi è fragile... come i petali del fiore dell'Erba invernale... Ci rompiamo con troppa facilità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001616
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001616,
					"content": "Ma... finché le foglie rimangono... finché le radici restano salde nel terreno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001617
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001617,
					"content": "Quando arriverà la prossima stagione... e quella dopo ancora... altri fiori continueranno a sbocciare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001618
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001618,
					"content": "Noi non falliremo... Vero, Capitano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001619
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001619,
					"content": "...Sì. Non falliremo! Seppellirò quel mostro con le mie mani, una volta per tutte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001620
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001620,
					"content": "Sei il più forte tra noi... Io credo in te... Capitano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001621
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001621,
					"content": "Non temere, Bjorn... Manterrò la nostra promessa. Ora riposa... Quando ti sarai ripreso, le cose saranno cambiate in meglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001622
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001622,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001623
					],
					"speakerTitle": "Bjorn"
				},
				{
					"id": 761001623,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001624
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001624,
					"content": "#...{NICKNAME}, Paimon, dobbiamo andare. La missione non è ancora finita. Non possiamo più restare qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001625
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761001625,
					"content": "Illuga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761001626,
						761001627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761001626,
					"content": "Dobbiamo continuare a muoverci, per Bjorn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001627,
					"content": "Sconfiggeremo il nemico e reclameremo la vittoria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761001628
					]
				},
				{
					"id": 761001628,
					"content": "...Sì. Andiamo avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}