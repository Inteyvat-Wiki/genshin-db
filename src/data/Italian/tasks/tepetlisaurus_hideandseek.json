			"dialogs": [
				{
					"id": 750250101,
					"content": "Woah, cos'è questo posto misterioso? Ci sono un sacco di Tepetlisauri piccoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250102,
					"content": "Che sia una specie di... luogo di raduno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250103,
					"content": "Roar! Rrroar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250104,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} sembra decisamente entusiasta! Non capita tutti i giorni di poter incontrare così tanti compagni allo stesso tempo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250105,
					"content": "Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#Ah, dici che vuoi andare a giocare con loro? Ora che Paimon ci pensa, {REALNAME[ID(2)|SHOWHOST(true)]} non ha tante occasioni per interagire con altri suoi simili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250107,
					"content": "Fa' attenzione, d'accordo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#Ahh, Paimon è un po' agitata... Comunque, troviamo un posto dove rilassarci e mangiare qualcosa in attesa che {REALNAME[ID(2)|SHOWHOST(true)]} torni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250111,
					"content": "#Lì a poca distanza, tu e Paimon trovate un bel posticino dove riposare finché {REALNAME[ID(2)|SHOWHOST(true)]} non finisce di giocare.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "Purtroppo, l'attesa si rivela più lunga del previsto...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#Strano... Perché {REALNAME[ID(2)|SHOWHOST(true)]} ancora non torna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250114,
					"content": "Paimon spera che non gli sia successo niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250115,
					"content": "Magari si sta divertendo molto e ha perso la cognizione del tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "Se è così, allora dovremo fargli un bel discorsetto. Il sole è quasi tramontato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250117,
					"content": "Uff... Andiamo a cercarlo, prima che faccia buio, o non vedremo più niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250108,
					"content": "Non stare via troppo a lungo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				}
			]
		},
