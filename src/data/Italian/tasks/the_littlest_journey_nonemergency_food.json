					"nextDialogs": [
						210291107,
						210291108
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210291107,
					"content": "Meglio non abbondare con i peperoncini di Jueyun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210291109
					]
				},
				{
					"id": 210291109,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}! Ti garantisco che mi ricorderò come preparare questo piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291110
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
