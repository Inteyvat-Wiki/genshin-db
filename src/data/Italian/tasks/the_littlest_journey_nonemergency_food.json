					"nextDialogs": [
						210291104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210291104,
					"content": "Fiuuu... Ok, ora va meglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291105
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210291105,
					"content": "Anche se è un po' piccantino, onestamente penso che questo piatto sia delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291106
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 210291106,
					"content": "E, in effetti, i peperoncini mi hanno, ehm, dato una svegliata.",
