			"dialogs": [
				{
					"id": 210291101,
					"content": "Bene! Iniziamo a preparare questo piatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291102
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
