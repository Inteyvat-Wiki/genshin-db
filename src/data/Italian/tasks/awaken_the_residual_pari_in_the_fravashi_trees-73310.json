			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733100201,
					"content": "Quindi è questo l'aspetto con cui si sono ritrovate... Che pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100202
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100202,
					"content": "Sorush, di cosa stai parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100203,
					"content": "Non farci caso. Ho appena scoperto lo stato di degrado in cui versano le mie simili. Non ha importanza, proseguiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100204,
					"content": "Se dici così, fai incuriosire Paimon ancora di più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100205,
					"content": "Paimon vuole vedere... Oh, wow, quest'albero è proprio strano! Con quella struttura circolare sembra quasi una porta, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100206,
						733100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100206,
					"content": "Se l'attraversassimo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733100208
					]
				},
				{
					"id": 733100208,
					"content": "Hihi, a Paimon piacerebbe un sacco attraversarlo per prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100209,
					"content": "Gli alberi di Fravashi non sono porte. Se ci passaste attraverso, finireste solo per disturbare le Pari residue che vi abitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100210
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100210,
					"content": "Dunque quello è un albero di Fravashi? Ma dove sono le Pari residue? Paimon non ne vede neanche una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100211,
					"content": "Pallidina volante, è normale che non le veda. Dopotutto, sono ancora intrappolate dalle ossessioni del passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100212
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100212,
					"content": "Potrà anche non essere ciò che desideravano, ma vederle così morbosamente attaccate a questo mondo per me è... insostenibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100213
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100213,
					"content": "Eppure a Paimon sembra così rigoglioso. Non è una cosa positiva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100214,
					"content": "Umpf, cosa vuoi capirne tu, Pallidina volante! Questi alberi di Fravashi sono le Pari che combatterono fino all'ultimo contro la contaminazione che corrodeva la terra. Dopo aver consumato tutto il loro potere, assunsero le sembianze attuali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100215
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100215,
					"content": "Le loro forze si esaurirono al punto tale da non riuscire più a mantenere una forma corporea, e vennero respinte dall'Oasi di Vourukasha perché contaminate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100216
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100216,
					"content": "La leggenda narra che, in tempi antichi, l'Ordine degli Scettici tenesse un rituale di purificazione così da permettere loro di fare ritorno all'Oasi di Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100217
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100217,
					"content": "Tuttavia, oggi non vi è più nessuno nell'Ordine degli Scettici in grado di compiere quel rituale. Non possono far altro che mantenere in vita questi alberi di Fravashi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100218
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100218,
					"content": "Ma alla fine si tratta solo di prolungare le loro pene. A giudicare dal loro aspetto attuale, sembra che gli siano rimasti solo dei ricordi amari da sopportare in solitudine. Niente più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100219,
						733100220
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100219,
					"content": "Forse dovremmo aiutarle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733100221
					]
				},
				{
					"id": 733100221,
					"content": "Ah, Paimon non ha certo intenzione di lasciarle qui a soffrire da sole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100222,
					"content": "A dirla tutta, questo è il nostro destino. Continuare a custodire questa terra in questo modo potrebbe essere un loro desiderio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100223
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100223,
					"content": "Beh, questo è ciò che pensi tu. Loro potrebbero non essere d'accordo, eh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100224,
					"content": "Se Paimon fosse intrappolata qui, di sicuro vorrebbe tornare a casa da tutti i suoi cari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100225,
					"content": "Pallidina volante, come osi sottovalutare la nostra volontà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100226
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100226,
					"content": "Umpf, sia come vuoi. Userò il mio potere per svegliarla, così potrai ascoltare la sua diafana voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100220,
					"content": "Allora c'è un modo per salvarle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733100221
					]
				},
				{
					"id": 733100207,
					"content": "...Potrebbe condurre da qualche parte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733100208
					]
				}
			]
		},
