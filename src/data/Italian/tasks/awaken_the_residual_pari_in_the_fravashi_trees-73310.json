					"speakerTitle": "Sorush"
				},
				{
					"id": 733100312,
					"content": "Potrà anche non essere ciò che desideravano, ma vederle così morbosamente attaccate a questo mondo... Quanto sono patetiche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100313
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100313,
					"content": "Avranno anche un aspetto strano, ma definirle \"patetiche\" non è molto carino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100314,
					"content": "E a vederti circondata da così tante piante, Paimon pensava che ti saresti sentita come a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100315,
					"content": "Mi sento a casa solo su un campo di battaglia. Solo una battaglia lunga fino alla fine dei tempi può essere percepita come la vera eternità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100316
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100316,
					"content": "Ora che mi segui, ti conviene afferrarlo il prima possibile, Pallidina volante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100317
					],
					"speakerTitle": "Sorush"
				},
				{
