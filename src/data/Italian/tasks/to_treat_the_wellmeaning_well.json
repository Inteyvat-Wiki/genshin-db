	"talks": [
		{
			"id": 200501,
			"completionStepIds": [
				200501
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200501",
							"2"
						],
						"stepId": 200501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Oomori",
					"Yuuya",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "Dicono che la Commissione Tenryou sia direttamente controllata dalla Shogun. Sono loro i responsabili del mantenimento della legge e dell'ordine a Inazuma, coloro che fanno rispettare il Decreto di caccia alle Visioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050102,
					"content": "Ma perché dovrebbero agire contro un compagno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050103,
					"content": "Paimon non lo capisce... Eh? Sembra che ci sia del movimento laggiù, andiamo a vedere cosa sta succedendo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050104,
					"content": "Lo chiederò ancora una volta... Intendete trattenere le provviste di emergenza di questo mese?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050105,
					"content": "L'intero clan conta su quel cibo. Vogliamo una spiegazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050106,
					"content": "Quante volte devo ripeterlo... Non so nulla riguardo alle provviste di emergenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050107,
					"content": "Osi forse mentirci? Queste provviste sono essenziali, lo vuoi capire? Non sono destinate a gonfiare le tasche di avidi samurai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050108,
					"content": "Voi samurai pensate di poter fare quello che volete!? La Commissione Tenryou lo verrà a sapere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050109,
					"content": "Provviste di emergenza... come cibo di emergenza?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "Eh? E voi chi sareste? Membri della banda di Kurosawa, senza dubbio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050111,
					"content": "Cosa? Siamo solo di passaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050112,
					"content": "Abbiamo sentito il trambusto e abbiamo pensato di venire a vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050113,
					"content": "Capisco, ci avete raggiunto al momento giusto. Forse potete aiutarci a risolvere la questione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050114,
					"content": "Lui è Kurosawa, è un samurai e un membro dell'esercito della Shogun. È il responsabile della distribuzione di provviste di emergenza nella zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050115,
					"content": "In passato bastava chiedergli le razioni e ci venivano consegnate. Ora, all'improvviso, non vuole darci più nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050116,
					"content": "Tiene le provviste per sé, ci scommetto! Moriremo di fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050117,
					"content": "A nessuno sembra importare di noi... Pensavamo che Kurosawa fosse un uomo gentile, ma ha mostrato il suo vero volto. È come tutti gli altri samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050118,
					"content": "Non mi stupisce che tutte le Visioni siano state confiscate. La Shogun Raiden non ha bisogno di persone come lui che la aiutino a governare la nazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050119,
					"content": "Deve essere una di quelle persone che Ayaka ci ha chiesto di aiutare. Ma perché mai avrebbe voluto che aiutassimo uno come lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050120,
					"content": "Forse dovremmo parlare con Kurosawa e vedere cos'ha da dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200502,
			"completionStepIds": [
				200503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200503",
							"2"
						],
						"stepId": 200503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ken",
					"Tadao",
					"Paimon",
					"Gou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "Uff, addio ai Mora... Abbiamo lavorato sodo per rubarli, sodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050202,
					"content": "Dai capo, pensa a qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050203,
					"content": "Ehm... Non male, giovane... Hai... Hai mai pensato di unirti ai Cacciatori di tesori? Persone come te ci farebbero comodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050204,
					"content": "Scordatelo. Raccontaci tutto quello che sai su Kurosawa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "Kurosawa? Oh... Mi ricordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050207,
					"content": "Quindi è lui che vi ha mandato a cercarci, eh? Tsk, la nostra solita sfortuna... Sapevo che non dovevamo saccheggiare quel posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050208,
					"content": "Allora, cosa c'era dentro? Era pieno di scorte di cibo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050209,
					"content": "Scorte di cibo? Stai scherzando? Quel posto era un disastro... Abbiamo trovato solo una scatola dall'aspetto strano che spero contenga oggetti di valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050210,
					"content": "Non volevo che qualcun'altro la vedesse, quindi pensavo di aprirla personalmente una volta fatto ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050211,
					"content": "Ma ora che ci avete beccato, che ne dite di fare uno scambio? Quella piccola scatola per la nostra libertà... Che ne dite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050212,
					"content": "Affare fatto. Ora mostraci cosa c'è nella scatola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050213,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050214,
					"content": "Ma cosa...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050215,
					"content": "Qui... qui dentro ci sono solo cambiali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050216,
					"content": "Sì, e parecchie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050217,
					"content": "Sembrano tutte intestate alla proprietaria di un emporio, una certa signorina Aoi... Abbiamo a che fare con un sacco di Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050218,
					"content": "Faremmo meglio a parlare con questa signorina Aoi e ad andare fino in fondo a questa faccenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050219,
					"content": "Quanto a voi, potete andare. Preghiamo solo che le nostre strade non si incrocino più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050220,
					"content": "S...Sì, certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050221,
					"content": "Quindi ci siamo riscattati per alcune cambiali... Significa che siamo in bancarotta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050222,
					"content": "Taci! Andiamocene da qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050205,
					"content": "Non se ne parla. Gira voce che abbiate saccheggiato la sua casa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
		{
			"id": 200503,
			"completionStepIds": [
				200504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200504",
							"2"
						],
						"stepId": 200504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aoi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050301,
					"content": "Il Negozio di alimentari Tsukumomono vi dà il benvenuto, qui trovate tutto ciò di cui avete bisogno. Posso aiutarvi a cercare qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050302,
					"content": "O per caso... c'è qualcosa su cui desiderate avere informazioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050303,
					"content": "Riguardo a queste cambiali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "Ah, conoscenti di Kurosawa, suppongo. Ahah. Siete qui per saldare i suoi debiti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050305,
					"content": "Ehi, ehi, non traiamo conclusioni affrettate... Siamo qui solo per sapere da dove vengono tutte queste cambiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050306,
					"content": "Perché Kurosawa ti deve così tanti soldi? Ha comprato qualcosa di molto costoso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050307,
					"content": "Fammi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050308,
					"content": "Kurosawa veniva regolarmente per acquistare grandi quantità di generi alimentari. Accreditava sempre il pagamento sul proprio conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050309,
					"content": "Tuttavia, di recente il prezzo delle provviste ha iniziato a salire vertiginosamente e il suo stipendio non è più bastato a sostenere le spese. Così, ha iniziato a firmare cambiali per coprire ciò che non poteva più permettersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050310,
					"content": "Ecco come si procurava quelle provviste di emergenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050311,
					"content": "Ma perché ha continuato ad acquistare lo stesso numero di provviste? Se i prezzi aumentavano, non poteva semplicemente comprarne meno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050312,
					"content": "A pensarci bene, i cittadini che hanno ricevuto le provviste di emergenza devono aver calcolato attentamente la quantità necessaria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050313,
					"content": "Kurosawa deve aver pensato che sarebbe stata una grossa delusione per loro scoprire che le provviste non erano abbastanza. Soprattutto dopo una pianificazione così lunga e meticolosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050314,
					"content": "Quindi ha preferito indebitarsi piuttosto che deludere quella gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050315,
					"content": "Wow, Kurosawa stava acquistando tutte le provviste di emergenza a proprie spese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050316,
					"content": "...e nessuno ha mai apprezzato quello che ha fatto... Sono stati capaci solo di lamentarsi e di dargli la colpa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050317,
					"content": "Gli atteggiamenti delle persone riflettono sempre le circostanze in cui si trovano. Di fronte alle difficoltà, nessuno si preoccupa di farsi domande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050318,
					"content": "Per come la vedo io, se Kurosawa avesse detto a tutti la verità sulle provviste fin dall'inizio, non ci sarebbe stata questa reazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050319,
					"content": "Certo, ci sarebbero stati comunque dei disordini. Il suo era davvero un compito ingrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050320,
					"content": "Quanto al motivo per cui ha scelto di spendere i suoi soldi per le provviste e non dirlo a nessuno... Nemmeno io ne ho chiaro il motivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050321,
					"content": "Perché non andate a chiederlo direttamente a lui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050322,
					"content": "Purtroppo non si ricorda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "Capisco... Ora che ci penso... sembra che la sua Visione sia stata recentemente confiscata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050324,
					"content": "Che sfortuna... Se non cancella il debito a suo nome, non avrà altra scelta che vendere quella spada che gli è tanto cara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050325,
					"content": "Spada? Quale spada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050326,
					"content": "Non ve l'ha detto? Possiede una lama molto pregiata... La porta con sé ormai da molti anni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050327,
					"content": "Gli ho chiesto da dove provenisse, ma mi ha detto che era un regalo di suo padre... e che era troppo preziosa per venderla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050328,
					"content": "Ripensandoci, mi pento di non aver mai fatto un'offerta... Ogni cosa ha il suo prezzo, o almeno, io la penso così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050329,
					"content": "Perché non gli chiedete della spada? Forse vi darà anche le risposte che state cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050330,
					"content": "Oh, ma prima di andare, se voleste gentilmente saldare il conto di oggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050331,
					"content": "Eh? Ma non abbiamo comprato niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050332,
					"content": "Eheh, anche le informazioni sono merce, non è forse così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050333,
					"content": "Non preoccupatevi, quello che vi ho detto su Kurosawa non vi costerà troppo. Non vi ho rivelato nulla di esplicitamente confidenziale, dopotutto. Vediamo... 2.000 Mora dovrebbe essere un prezzo onesto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050334,
					"content": "Mi sembra giusto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "Almeno ora sappiamo da dove provenivano le provviste di emergenza, e inoltre abbiamo scoperto che Kurosawa possiede una spada di inestimabile valore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050336,
					"content": "Andiamo a parlare di nuovo con Kurosawa e vediamo se riesce a ricordare qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200504,
			"completionStepIds": [
				200505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200505",
							"2"
						],
						"stepId": 200505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "Ehi, cosa ci fai qui da solo? Dove sono finiti quegli altri due?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050402,
					"content": "Ho lasciato a loro la scelta: andarsene o subire l'ira della mia spada. Se ne sono andati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050403,
					"content": "Mi ha fatto risparmiare un sacco di tempo, in effetti. Forse dovrei farlo più spesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050404,
					"content": "Avete rintracciato i Cacciatori di tesori? Tutto quello che ho detto era vero, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050405,
					"content": "In effetti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "Per farla breve... Stavi davvero distribuendo provviste di emergenza, ma sono state tutte acquistate a tue spese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050407,
					"content": "Strano... Ero davvero quel tipo di persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050408,
					"content": "Non ricordo nulla del genere. Anche dopo tutto quello che mi avete detto, non ricordo niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050409,
					"content": "Perché stavo acquistando provviste di emergenza? E perché mai dovrei mettermi in una situazione così complicata... *sospira* Proprio non capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050410,
					"content": "Ma non posso negare che quando ho impugnato la spada per spaventare quei due, il mio corpo era in qualche modo riluttante a farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050411,
					"content": "La spada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "Questa spada era di mio padre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050414,
					"content": "Ricordo che una volta, da giovane, ho tentato di sgattaiolare fuori per mostrarla ai bambini che vivevano lì vicino. Mio padre mi colse sul fatto e mi rimproverò severamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050415,
					"content": "Quello che mi disse... Ah. Ho dimenticato anche quello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050416,
					"content": "Sembrerebbe che molti ricordi importanti mi siano stati portati via insieme alla Visione. Così tanti momenti sono ormai perduti per sempre, non importa quanto io mi sforzi di richiamarli alla mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050417,
					"content": "Ricordo solo che mio padre mi disse che questa lama rappresentava tutto ciò in cui credeva. Prima di morire, mise la spada nelle mie mani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050418,
					"content": "...E mi disse: \"Con questa spada dovrai...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050419,
					"content": "Ehi... Se guardi attentamente, sembra che ci siano alcune parole incise sull'elsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050420,
					"content": "Riesci a leggerle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050421,
					"content": "C'è scritto: \"Virtù e giustizia\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "\"Virtù e giustizia\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050423,
					"content": "In qualche modo, queste due parole sembrano spiegare tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050424,
					"content": "Caricarsi di un'infinità di debiti per rendere felici gli altri. Immagino che dopotutto questa fosse la mia più grande ambizione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050425,
					"content": "Ma a che servono virtù e giustizia? Ho comprato le provviste per i bisognosi, ed ecco come sono andate le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050426,
					"content": "La Commissione Tenryou si è impossessata della mia Visione, e le stesse persone che cercavo disperatamente di aiutare si rifiutano di capirmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050427,
					"content": "Chiamala ironia della sorte, ma nonostante tutto... In qualche modo ero dispiaciuto mentre li minacciavo con la mia lama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050428,
					"content": "Non sono capace di essere una brava persona... eppure non sono nemmeno capace di essere cattivo. Io... non so cosa fare di me stesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050429,
					"content": "Un'altra anima tormentata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050430,
					"content": "Quando ne avremo la possibilità, parleremo con Thoma del debito di Kurosawa. La Commissione Yashiro aiuterà senz'altro a coprire le sue spese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050431,
					"content": "In ogni caso, non dobbiamo permettergli di svendere quella spada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050432,
					"content": "Perdere una Visione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "Già, sembra che perdere ogni ambizione sia un'esperienza terribile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050435,
					"content": "Fortunatamente per noi, tu non hai una Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050436,
					"content": "Andiamo a cercare la prossima anima inquieta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050433,
					"content": "...Non è cosa da poco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "Ti dispiace se diamo un'occhiata?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
		},
		{
			"id": 200505,
			"completionStepIds": [
				200506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200506",
							"2"
						],
						"stepId": 200506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050501,
					"content": "Non ho mai nemmeno sentito parlare di queste provviste di emergenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050502
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050502,
					"content": "Non so se siano solo delle voci o se stiano cercando di ricattarmi, ma in ogni caso è ridicolo. Se accumulo provviste come dite, come mai sono ancora povero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050503
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050503,
					"content": "La mia stessa famiglia riesce a malapena a tirare avanti... Ora, se volete scusarmi, ho altre faccende di cui occuparmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050504
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050504,
					"content": "Abbiamo saputo che hai perso la Visione di recente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050505
					]
				},
				{
					"id": 20050505,
					"content": "Questa è la prima cosa vera che sento in tutto il giorno. L'esercito della Shogun mi ha detto che non ero degno della Visione. Sosteneva che rallentasse il mio lavoro. A quanto pare ho anche deluso la Shogun Raiden. Ecco perché hanno confiscato la mia Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050506
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050506,
					"content": "Che strano, stavi aiutando a far rispettare il Decreto di caccia alle Visioni. Perché non saresti degno della Visione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050507,
					"content": "A dire il vero... Credo di non ricordarne i dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050508
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050508,
					"content": "So solo che facevo qualcosa ogni mese, ma non ricordo cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050509
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050509,
					"content": "E non è tutto... Ho questa sensazione inquietante dentro di me, come... come se qualcuno mi dovesse qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050510
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050510,
					"content": "Avrà a che fare con le provviste di emergenza mancanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050511,
					"content": "Io non ne so nulla! Come ho già detto, se le avessi prese per me, non avrei attraversato momenti così difficili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050512
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050512,
					"content": "Per di più, la mia casa è stata appena saccheggiata dai Cacciatori di tesori... ed è per questo che sono venuto qui. Li stavo inseguendo, ma sono stato trattenuto da questi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050513
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050513,
					"content": "Se non mi credete, andate a cercare i Cacciatori di tesori! Se ci fossero state provviste di emergenza, le avrebbero trovate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050514
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050514,
					"content": "Uhm... Sembra stia dicendo la verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050515,
					"content": "Ma sarà meglio verificare. Cerchiamo di intercettare quei Cacciatori di tesori e vediamo cos'hanno da dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050516,
					"content": "Dovremmo riuscire a seguire le loro tracce. Non possono essere andati troppo lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
