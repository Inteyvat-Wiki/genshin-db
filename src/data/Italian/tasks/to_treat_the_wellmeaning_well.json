			},
			"dialogs": [
				{
					"id": 20050801,
					"content": "Questa volta ci siamo davvero superati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050802
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050802,
					"content": "Tutte quelle case di samurai stracolme di merci, ahah! Abbiamo messo a segno un colpaccio. Insomma, a parte quella casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050803
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050803,
					"content": "Non avete ancora visto nulla, ci sarà ancora un mucchio di roba da quelle parti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050804
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050804,
					"content": "Oggi è stato solo l'inizio. Condurrò tutti voi in un'epica impresa di assalti e saccheggi che passerà alla storia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050805
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050805,
					"content": "Sei il nostro eroe, capo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050806
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050806,
					"content": "Sembrano proprio i Cacciatori di tesori che stiamo cercando. Diamogli una lezione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
