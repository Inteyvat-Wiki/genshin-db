				]
			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "Ma non è possibile... Come hai fatto?! La... La mia reputazione è distrutta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665002,
					"content": "È stato un onore combattere contro di te, mio buon signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "Morte lampo senza fronzoli"
				},
				{
					"id": 716665003,
					"content": "Ma che... gentilezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665004,
					"content": "Hihi! Allora? Sei stato molto indaffarato a perdere mentre eravamo via, Toro sdrai{RUBY#[S]\"Re Combattente Stercorario Supremo\"}ato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665005,
					"content": "Io non la vedo in questo modo. A meno che il Re Combattente Stercorario Supremo non intenda arrendersi, non ha ancora perso contro di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "Morte lampo senza fronzoli"
				},
				{
					"id": 716665006,
					"content": "In battaglia, così come nella vita, è normale incontrare degli ostacoli lungo la strada. Ma tali ostacoli diventano dei fallimenti solo se si decide deliberatamente di rinunciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "Morte lampo senza fronzoli"
				},
				{
					"id": 716665007,
					"content": "Altroché! Ci puoi giurare! Non getterò la spugna proprio ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665008,
					"content": "D'altronde, accampare scuse di continuo non dà alcun tipo di vantaggio. Non sprecare le tue energie per dire cose senza senso... Sfruttale per combattere meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "Morte lampo senza fronzoli"
				},
				{
					"id": 716665009,
					"content": "Ahia, che male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665010,
					"content": "Re oni, non mi sembri molto abile con questo tipo di nemico. Suggerisco di schierare un altro dei tuoi subordinati e osservare attentamente il combattimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716665011,
					"content": "Guardare gli altri combattere è una parte cruciale dell'addestramento di un guerriero. Alcune abilità si apprendono con la pratica, altre tramite l'osservazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716665012,
					"content": "Giusto, Granmaestro! E che tempismo perfetto, compadre! Braccio destro del Re oni, lascio continuare il combattimento a te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665013,
					"content": "#Ahah! Finalmente è il tuo turno! Fatti valere, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665014,
					"content": "Eheh! Un gioco da ragazzi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#Quindi dovrò scontrarmi direttamente con {F#la leggendaria}{M#il leggendario} {NICKNAME}? Sarà meglio tenere alta la guardia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morte lampo senza fronzoli"
				},
				{
					"id": 716665015,
					"content": "Oh-oh! Che paura!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
