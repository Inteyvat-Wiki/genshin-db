			},
			"dialogs": [
				{
					"id": 716665101,
					"content": "Ben fatto, mi hai sconfitto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "Morte lampo senza fronzoli"
				},
				{
					"id": 716665102,
					"content": "#Ammetterò che perdere contro {NICKNAME} è stato un vero onore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "Morte lampo senza fronzoli"
				},
				{
					"id": 716665103,
					"content": "Ahhh, quindi è così che riesci a vincere! Non ci avrei mai pensato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665104,
					"content": "Già! Quando ti ritrovi ad affrontare un nemico astuto, devi usare la creatività.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665105,
					"content": "Quando le tue tattiche falliscono, devi cambiare la tua prospettiva. Durante i nostri viaggi in lungo e in largo per il mondo, dobbiamo spesso reagire velocemente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665106,
					"content": "Per quanto ci si sforzi, rimanere ancorati ai vecchi metodi non risolverà mai il problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665107,
					"content": "Mi sembra che una volta l'abbia detto anche Shinobu. Penso che ci sia un fondo di verità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665108,
					"content": "Ma ci rifletterò ancora. Per ora devo concentrarmi sul presente, ovvero sulle lotte tra scarabei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
