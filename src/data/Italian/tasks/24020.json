	"talks": [
		{
			"id": 2402001,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "Che sfortuna nera! Non mi immergerò mai più sott'acqua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "Ah, sei tu. È davvero bello vederti! Ci ho quasi lasciato le penne, là sotto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200105,
					"content": "Stavo lavorando sott'acqua come faccio di solito. Sono emerso schivando le piante acquatiche ed evitando i rifiuti, e non mi sono tagliato né punto con alcun oggetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200106,
					"content": "Ma, proprio quando stavo recuperando qualcosa, dal fango è spuntato un gruppo di mostri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200107,
					"content": "Non riesco a ricordare bene di che creature si trattasse, so soltanto che mi si sono avventate contro... Non ho potuto far altro che fuggire e nuotare verso l'alto con tutta la mia forza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200108,
					"content": "Ma poco dopo mi sono imbattuto in un banco di strani pesci meccanici, e anche loro mi hanno caricato non appena mi hanno visto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200109,
					"content": "Non so come sia arrivato a riva, ma ce l'ho fatta, e apparentemente senza neanche un graffio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200110,
					"content": "Se la situazione è tanto pericolosa, forse dovresti stare alla larga da questo posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "Ma non posso, capisci?! L'ha indicato Goldman... Che importa se qualcuno ci si è ferito o ha perfino perso la vita lavorandoci...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200113,
					"content": "Con il passare del tempo neanche le sue minacce di detrarre gli stipendi sono riuscite a convincere qualcuno a lavorare qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200114,
					"content": "Quindi dopo un po' ha cambiato tattica, dichiarando che avrebbe pagato il triplo dei Mora a chi avesse accettato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200115,
					"content": "Quindi... Io e alcuni amici al verde abbiamo preso il lavoro, e abbiamo persino comprato alcune fiocine per autodifesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200116,
					"content": "Ma non è passato neanche qualche giorno che le abbiamo rotte o perdute... Gli altri sono andati in città per comprarne di nuove, mentre io sono rimasto a difendere il forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200117,
					"content": "E allora perché ti sei immerso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "Sono andati via da secoli! Se non ci diamo una mossa, non so a che ora mi toccherà finire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200120,
					"content": "Lascia che ti aiuti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "No! Sarebbe inutile! Questi sono mostri veri, che ti daranno del filo da torcere! Neanche gli avventurieri possono sconfiggerli... No, non ti permetterò di farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200122,
					"content": "#Non sono {F#un'avventuriera}{M#un avventuriere} come gli altri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "Beh, no di certo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200125,
					"content": "Va bene. Se insisti, ti segnerò dov'è... Ma per favore, sii prudente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200123,
					"content": "#Ti sembro {F#un'avventuriera}{M#un avventuriere} come tant{F#e}{M#i}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "Sei andato sott'acqua senza armi di autodifesa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "Sembra davvero troppo pericoloso. Dovresti trovare un altro posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "Che è successo stavolta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
		{
			"id": 2402002,
