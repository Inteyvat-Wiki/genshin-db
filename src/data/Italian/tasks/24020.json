			"dialogs": [
				{
					"id": 240200201,
					"content": "Mi hai aiutato a recuperare quelle cose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402003,
			"completionStepIds": [
				2402005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402005",
							"2"
						],
						"stepId": 2402005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200301,
					"content": "Esatto, questo è ciò che andiamo a pescare ogni giorno: spazzatura, spazzatura e ancora spazzatura... Forse quell'avida canaglia di Goldman se la mangia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200302
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200302,
					"content": "Grazie dell'aiuto. Questo è l'anticipo sullo stipendio che ho chiesto a Goldman. Ti prego di accettarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200303
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200303,
					"content": "Non posso accettarlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200304
					]
				},
				{
					"id": 240200304,
					"content": "Ma devi! È la paga per il TUO lavoro. Non mi appartiene più... E, se non la prenderai, getterò questo sacchetto di monete in acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200305
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200305,
					"content": "Va bene, va bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200306
					]
				},
				{
					"id": 240200306,
					"content": "Così si fa! Se in futuro avessi bisogno di recuperare qualcosa, vieni pure da me... Te lo consegnerò tutt'intero, qualsiasi cosa sia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200307
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200307,
					"content": "Ho bisogno di riposare un altro po'... Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402004,
			"completionStepIds": [
				2402006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402006",
							"2"
						],
						"stepId": 2402006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200401,
					"content": "Questi sono... Cosa sono tutti questi ninnoli? Sono davvero quello che Goldman vuole farci recuperare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200402
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200402,
					"content": "Grazie mille per l'aiuto! Ecco... Prendi questi Mora, ma mi raccomando: acqua in bocca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200403
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200403,
					"content": "Se potessi vendere queste cose, potrei comprarmi una tuta da immersione tutta mia. Non avrei più bisogno di noleggiarla da quel Goldman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200404,
						240200405
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200404,
					"content": "Non posso accettare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				},
				{
					"id": 240200406,
					"content": "No, no! Questa è la paga che ti spetta... Sicuramente questi Mora non sono nulla a confronto della tua fatica, ma è tutto ciò che ho. Stavo pensando di comprarci un cicchetto stasera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200407
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200407,
					"content": "Quindi ti prego, accettala. Ora devo occuparmi di alcune cose, e poi penserò a come... sì, a come vendere queste cose in segreto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200405,
					"content": "Le mie labbra sono cucite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200406
					]
				}
			]
		},
		{
			"id": 2402005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402002",
							"2"
						],
						"stepId": 2402002,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402003",
							"2"
						],
						"stepId": 2402003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200501,
					"content": "Puah, quello spilorcio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200502,
						240200508,
						240200512
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200502,
					"content": "Puoi parlarmi di nuovo di Goldman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200503
					]
				},
				{
					"id": 240200503,
					"content": "È il mio capo: uno specialista nell'assumere gente come me, con nessuna abilità ma con forza a volontà con cui arrivare alla fine del mese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200504
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200504,
					"content": "Ha la Fonta al posto del cervello, ed è severo e tirchio fino al midollo! Insiste che rispettiamo quel grosso, spesso manuale mentre lavoriamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200514
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200514,
					"content": "Inoltre, perfino le tute da immersione che usiamo al lavoro ce le \"affitta\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200505
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200505,
					"content": "Se violiamo le condizioni o se la tuta da immersione si danneggia, siamo noi a dover pagare lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200515
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200515,
					"content": "In altre parole, se ho una svista al lavoro anche solo una volta, non solo devo ripagarlo, ma devo anche strisciare e scongiurarlo che non mi licenzi! Bah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200506
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200506,
					"content": "Perché vuoi sapere altro su di lui, comunque? T'imploro, per favore, mantieni le distanze da lui... Fosse solo per il tuo amor proprio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200516
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200516,
					"content": "Senza vergogna, ecco com'è! E si circonda di individui come lui, delle mele marce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200507
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200507,
					"content": "Non associarti a quel tizio... Non rimuoveresti quel fango né ti puliresti la coscienza nemmeno con un intero serbatoio d'acqua pura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200517
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200517,
					"content": "Ma vedi... Non ci vuole molto a sporcare dell'acqua limpida con del fango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200508,
					"content": "Il tuo lavoro è estremamente faticoso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200509
					]
				},
				{
					"id": 240200509,
					"content": "Ah, hai ragione! Ma questo è l'unico modo che conosco per guadagnarmi da vivere. Non sono intelligente e non possiedo altre abilità, ma non mi darò mai al crimine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200518
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200518,
					"content": "Se devo compiere delle cattive azioni per mangiare, allora preferisco morire di fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200510
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200510,
					"content": "Sì, fatico molto, ma la notte posso dormire tranquillo. Non devo temere di essere odiato da qualcuno, o che qualcuno mi accoltelli nel sonno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200511
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200511,
					"content": "Se la vedi in questo modo, la mia vita è molto meglio di quella di Goldman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200512,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200513
					]
				},
				{
					"id": 240200513,
					"content": "#Certamente. Lascerò il lavoro di recupero a te, {F#ragazza}{M#giovanotto}. Quanto a me, mi serve ancora un po' di riposo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2402006,
			"completionStepIds": [
				2402001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2402001",
							"2"
						],
						"stepId": 2402001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"2401701",
							"2"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200601,
					"content": "Argh, che sfortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200602
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200602,
					"content": "Sei riuscito a vendere la roba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200603
					]
				},
				{
					"id": 240200603,
					"content": "Ah, sei tu. Uff, lascia perdere. Avevo anche trovato un acquirente, ma poi Goldman è piombato a casa mia e ha preso la scatola di ninnoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200604
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200604,
					"content": "Se non avesse più bisogno che lavorassi per lui, avrei sicuramente preso una batosta anch'io... Comunque sia, mi ha detratto due mesi di stipendio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200616
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200616,
					"content": "Mi vuole pagare solo dopo che avrò completato il lavoro di quest'anno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200605
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200605,
					"content": "*sospira* Lascia perdere. La fortuna non sorride agli idioti come me... Aspetta. Goldman non sarà mica venuto a bussare alla tua porta, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200606,
						240200609
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200606,
					"content": "No.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200607
					]
				},
				{
					"id": 240200607,
					"content": "Bene, allora. Io sconfitto? Pazienza. Ma non vorrei mai causarti dei problemi con lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200608
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200608,
					"content": "Non gli ho parlato del tuo lavoro di recupero, ma sospetto che qualcun altro l'abbia scoperto e gliel'abbia detto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200611,
					"content": "Ma oggi avrò di nuovo bisogno del tuo aiuto. La mia tuta da immersione non è stata ancora riparata, e Goldman ha insistito per farmi recuperare i giorni in cui non ho potuto completare il lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200612
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200612,
					"content": "Non ho avuto altra scelta che prendere in prestito la tuta da immersione di qualcun altro, ma anche così, non sono riuscito a finire il mio lavoro in fretta... Purtroppo, dovrò contare di nuovo sulla tua gentilezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200613,
						240200614
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200613,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200615,
					"content": "Grazie. Ti segnerò dove si trovano gli oggetti in questione. Ci divideremo e ci metteremo alla ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200614,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200609,
					"content": "Se venisse me, avrei una lezioncina da dargli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200610
					]
				},
				{
					"id": 240200610,
					"content": "Per favore, non avvicinatevi nemmeno a quel patetico ammasso di carne! Una persona onorevole come te non dovrebbe nemmeno parlarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				}
			]
		}
	]
}