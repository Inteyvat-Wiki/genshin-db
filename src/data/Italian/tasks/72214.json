				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "Oooh... Guardate che belle venature di grasso... Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140402,
					"content": "Tra poco mi preparerò un pranzetto. Magari, dopo aver mangiato, riuscirò a finire la scultura più in fretta, ahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140403,
					"content": "Non ho ben capito il collegamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "Beh, mangiare della buona carne ti dà la forza di andare avanti! Non era la stessa cosa con quei pesci, sentivo proprio che le mie mani erano troppo deboli per il lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140405,
					"content": "Onestamente, cominciavo a preoccuparmi che avrei avuto bisogno di più tempo del previsto per finire la statua. Beh, ora non è più un problema, grazie a voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140406,
					"content": "Voglio dire, lavoro per una... gatta, certo, ma non è una buona scusa per consegnare in ritardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140407,
					"content": "In ogni caso, finirò il prima possibile... Ora che ci penso, la Somma Sacerdotessa ha detto che, una volta completata la statua, succederà qualcosa di buono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140408,
					"content": "Non saprei cosa significhi esattamente, ma beh... non vedo l'ora, in realtà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140409,
					"content": "Tornate tra un po', così vedrete l'opera finita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
	]
}