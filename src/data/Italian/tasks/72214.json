			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "È... incredibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140102,
					"content": "È finita la statua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "Quando abbiamo iniziato, quel sasso non era per niente simile a me, ma a ogni sguardo lo diventa sempre di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140104,
					"content": "Voi umani siete davvero incredibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140105,
					"content": "È molto rumoroso, sì, ma io sono la Gran Sacerdotessa provvisoria, non posso lamentarmi per questioni così banali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140106,
					"content": "Porta questo pesce a quell'umano alto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140107,
					"content": "È una cosa buona, e potrebbe andare bene per il suo... \"compescio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140108,
					"content": "Solo del pesce?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "Miao, ho convinto Konbumaru a guidare gli altri gattini a una caccia al fringuello, ma non è andata molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140110,
					"content": "Per loro è più semplice prendere i pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140111,
					"content": "È \"compenso\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "Miao miao miao, siete peggio delle pulci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140113,
					"content": "Dateglielo e basta, è una cosa buona dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221402",
							"2"
						],
						"stepId": 7221402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "Beh, direi che la somiglianza è innegabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140202,
					"content": "Ahah, siete voi. Che dite, ora sembra un po' la Somma Sacerdotessa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140203,
					"content": "Direi proprio di sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "Vero? Ah, ci ho lavorato giorno e notte, e ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140207,
					"content": "Ah, sono piuttosto affamato, credo... È ora di andare a cercare nuovamente qualcosa da mangiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140208,
					"content": "Neko ti manda del pesce.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "Mmmh, beh, ringrazio la Somma Sacerdotessa, ma ehm... Penso che cercherò del cibo per conto mio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140210,
					"content": "È da giorni che mangio solo pesce, non credo di riuscire a mandarne giù un altro boccone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140211,
					"content": "Ho provato ad andare a caccia. Quando sono fortunato, riesco a prendere un fringuello o un piccione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140212,
					"content": "*sospira* Ma quello che mi piacerebbe davvero è un po' di carne come si deve, sapete? Tenera e succulenta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140213,
					"content": "#Dunque, ehm, {F#viaggiatrice}{M#viaggiatore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140214,
					"content": "Se non ti dispiace, potresti portarmi 3 porzioni di carne cruda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140215,
					"content": "Non sono bravo a cacciare, e non sono riuscito a procurarmi granché in questi ultimi giorni... Quindi, per favore, dammi una mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140216,
					"content": "Va bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "Mi aiutereste, per favore? Bastano 3 porzioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140217,
					"content": "Perché non torni sull'Isola di Narukami per mangiare qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "Beh, tanto per cominciare è molto lontana, e poi... stavo giusto prendendo confidenza con questa scultura. Se partissi ora, rischierei di perdere il tocco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140219,
					"content": "Preferirei mangiare un pasto veloce qui e rimettermi subito al lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140205,
					"content": "È sicuramente molto più grande.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "Beh, certo, la Somma Sacerdotessa è un po' più grande del gatto medio... E una statua davvero maestosa dev'essere ancora più grande. È per un santuario, dopotutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
