			"completionStepIds": [
				7221403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221403",
							"2"
						],
						"stepId": 7221403,
						"stateName": "QUEST_STATE_UNFINISHED"
