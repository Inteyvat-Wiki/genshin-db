				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "Dall'interno, qualcuno sente i movimenti...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "Salve. Desiderate qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330503,
					"content": "Beh, siamo qui per consegnarti questo vaso di fiori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "Eh... È da parte di Raef?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330505,
					"content": "Ci sono fiori dentro il vaso? Davvero? Grazie per avermelo portato in sua vece. È un regalo bellissimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330506,
					"content": "Ma... riuscirò a far crescere bene questi fiori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330507,
					"content": "È la prima volta che ti prendi cura dei fiori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "Beh, no, però... Non sono bravissima a prendermi cura delle piante. Finora le ho fatte appassire tutte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330509,
					"content": "Allora immagino che questo vaso di fiori sia persino più delicato. Se ancora una volta dovessi fallire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330510,
					"content": "Oh, no! Non lascerò che accada... Ora che i fiori mi sono stati affidati, sarò in grado di curarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330511,
					"content": "Forse nonna Kulsoom ha una soluzione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
			"id": 7323306,
			"completionStepIds": [
				7323306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
