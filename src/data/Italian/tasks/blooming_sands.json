			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "#Sei di ritorno, viaggiat{F#rice}{M#ore}. Grazie davvero per l'aiuto... Come sta Nermin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330602,
					"content": "Teme di non essere all'altezza di badare ai fiori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "Beh... L'aiuterò a trovare una soluzione. E, se non ci riusciremo, troveremo qualcuno a cui chiedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330604,
					"content": "E se non riusciremo a fare neanche quello... suppongo che... cercherò qualcosa che sia facile da far crescere e tenere in vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330608,
					"content": "#In ogni caso, viaggiat{F#rice}{M#ore}, grazie per l'aiuto. Prendi la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330609,
					"content": "Più tardi le manderò il resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330610,
					"content": "Aspetta un momento. Questi attrezzi da giardino non includevano dei manuali d'istruzioni? Oh, no. Non ho idea di come usarli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330605,
					"content": "È la prima volta che le regali dei fiori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "Beh, non proprio, ma di solito glieli compravo già sbocciati, e quando arrivavano al villaggio erano già mezzi appassiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330607,
					"content": "Ecco perché stavolta ho deciso di regalarle dei fiori appena piantati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				}
			]
		},
