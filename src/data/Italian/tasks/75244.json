			"dialogs": [
				{
					"id": 752440402,
					"content": "#Sei ancora {F#preoccupata}{M#preoccupato} per quei criminali? Non ce n'è bisogno. Se ti capita d'incontrarli, digli il mio nome e ti lasceranno stare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440403
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440403,
					"content": "Non chiedermi perché, però. Noi due eravamo destinati a incontrarci, mi hai persino aiutato a recuperare il cappello. Consideralo un gesto di gratitudine da parte mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Rantiy"
				}
