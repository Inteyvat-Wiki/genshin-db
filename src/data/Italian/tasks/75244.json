			"dialogs": [
				{
					"id": 752440101,
					"content": "Ehi, anche tu qui per pescare? Beh, se l'hai già fatto in passato, saprai anche che è indispensabile indossare un cappello robusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440106,
					"content": "...A cosa ti serve il cappello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "Vuoi sapere perché? Beh, un cappello robusto è molto più sicuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440107,
					"content": "Non hai niente sulla testa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "È uno dei motivi per cui ti ho rivolto la parola... Sai, il vento si è portato via il mio cappello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440104,
					"content": "Se non ti dispiace, mi daresti una mano a trovarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440108,
					"content": "Perché non vai a cercarlo da solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "Se andassi a cercarlo da solo, mi toccherebbe posare la canna da pesca; ma, se tengo in mano quella, non posso andare a cercare il cappello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440109,
					"content": "Per favore, ti supplico, aiutami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rantiy"
				}
			]
		},
		{
