			"dialogs": [
				{
					"id": 752440201,
					"content": "Ehilà! Hai trovato il mio cappello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440202
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440202,
					"content": "È questo qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
