			},
			"dialogs": [
				{
					"id": 4871001,
					"content": "Prince! Micetto mio. Sapevo che saresti tornato a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871002,
					"content": "*ansima* Gwah! Dopo aver cercato ovunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871003,
					"content": "Oh, Prince, come hai potuto andartene via così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871004,
					"content": "Sembra che questi due abbiano bisogno di stare un po' da soli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871005,
					"content": "Prince vi ha fatto girare in lungo e in largo, eh? Si vede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871006,
					"content": "Ehi, su col morale! Anche se non l'avete trovato, è comunque grazie a voi che è tornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871007,
					"content": "E ha ancora con sé le corde di Ferro astrale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871008,
					"content": "Per ringraziarvi, vi delizierò con una mia esibizione privata usando proprio queste corde! Scusatemi se è poco! E... E...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871009,
					"content": "\"E\" cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871010,
					"content": "ETCIÙÙÙ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871011,
					"content": "*tossisce* Ahah... Scusatemi. Da questa distanza la mia allergia ai gatti si fa sentire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 4871012,
					"content": "Oh, ora Paimon capisce perché non ti sei messo tu stesso a cercare le corde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4871013,
					"content": "Eheh! In ogni caso, grazie mille dell'aiuto. Ora devo andare... E... Etciùùù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
