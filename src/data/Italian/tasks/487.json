			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870501,
					"content": "Wow, Prince ha dei sensi molto sviluppati. C'è voluto poco per farlo correre via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870502,
					"content": "Prova ad accovacciarti. In questo modo, i tuoi passi faranno meno rumore e potrai sorprenderlo <color=#00E1FFFF>alle spalle</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870503,
					"content": "Dev'essere dura la vita di chi non sa fluttuare nell'aria, ihihih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870504,
					"content": "Se vuoi trovare Prince in fretta, perché non provi ad attirarlo con del <color=#00E1FFFF>pesce</color>? I gatti ne vanno ghiotti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870505,
					"content": "Se ti ritrovi senza <color=#00E1FFFF>pesce</color>, puoi trovarne altri al lago. E ora, al lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
