			},
			"dialogs": [
				{
					"id": 4870101,
					"content": "...Quindi sei tu che hai perso il gatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870102,
					"content": "Venti! Sei venuto ad aiutarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870103,
					"content": "Aiutarvi? E perché? Semmai è il contrario, sono io che ho bisogno di aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870104,
					"content": "Ma Paimon ti ha appena visto mentre parlavi di Prince con Margaret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870105,
					"content": "Ahhh! Allora il demonietto felino che ha rubato le mie <color=#00E1FFFF>corde di Ferro astrale</color> si chiama Prince!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870106,
					"content": "Sebbene mi renda felice vedere che l'ethos dello spirito libero tipico di Mondstadt è vivo e vegeto in ogni creatura grande o piccola... stavolta ha esagerato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870107,
					"content": "Ahah, effettivamente Prince è un gattino alquanto monello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870108,
					"content": "Proprio come direbbe un genitore che sceglie di viziare un tale birbante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870109,
					"content": "Esatto. Proprio come Barbatos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870110,
					"content": "Ahahah! Ebbene sì... ebbene sì... Ahem! Adesso facciamo in modo di avere un'udienza con Prince, il regale monello di Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870111,
					"content": "Stasera devo esibirmi e, senza le mie corde di riserva, deluderò il pubblico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870112,
					"content": "Ma cosa se ne fa un gattino delle corde di una lira?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870113,
					"content": "Tutti sanno che i gatti vanno pazzi per i gomitoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870114,
					"content": "Ma cosa c'entra?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870115,
					"content": "Le mie corde sono fatte di Ferro astrale, un materiale che contiene l'energia di Anemo. Questo le rende estremamente longeve, pertanto le arrotolo come un gomitolo per portarmele dietro più facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870116,
					"content": "È uno dei segreti del mestiere di un bardo errante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870117,
					"content": "Le corde contengono energia di Anemo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870118,
					"content": "#Questo ci aiuterà! {NICKNAME}, è arrivato il momento di utilizzare di nuovo la tua <color=#00E1FFFF>Vista elementale</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870119,
					"content": "Paimon è sicura che ci siano delle impronte elementali o qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870122,
					"content": "Vi ringrazio. Prince dovrebbe essere da qualche parte al mercato o nella zona residenziale. È un gatto nero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870121,
					"content": "Ah, prendi questo <color=#00E1FFFF>pesce</color>, il piccolo Prince ne va ghiotto. Forse ti aiuterà a trovarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		}
