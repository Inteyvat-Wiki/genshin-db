			"dialogs": [
				{
					"id": 716663001,
					"content": "Gli Onikabuto sono nostri amici, proprio come i gatti e i cani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "Ranuncolo del terrore"
				},
				{
					"id": 716663002,
					"content": "Un'altra ragazzina? Uff, credevo che ne avessimo già parlato, o sbaglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663003,
					"content": "Beh, sì, ma anche il Granmaestro Hanakado è un ragazzino. E c'era un altro bambino che l'altra volta se l'è cavata egregiamente. Non è dall'età che si misura la bravura di un combattente di scarabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663004,
					"content": "Anche se Ranuncolo del terrore non ha esperienza di lotte tra scarabei, l'Onikabuto che ha scelto sembra un guerriero formidabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716663005,
					"content": "Non capisco di cosa parlate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "Ranuncolo del terrore"
				},
				{
					"id": 716663006,
					"content": "È stato il mio papà a regalarmi l'Onikabuto. L'ha preso da un amico che ha conosciuto durante il suo ultimo viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "Ranuncolo del terrore"
				},
				{
					"id": 716663007,
					"content": "Ohoh, direi che tuo padre è proprio un tipo a posto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663008,
					"content": "Va bene, affideremo questa battaglia a Melonlavanda Biancoferro Squarciatrice dei cieli. Non voglio che qualcuno pensi che siamo dei prepotenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663009,
					"content": "Umpf! Sembra tu voglia insinuare che Paimon sia la più debole del gruppo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663010,
					"content": "Eppure, probabilmente Paimon è la scelta più sicura... Ma solo perché, quando siete in vena di competere, voi due pazzoidi siete un pericolo per voi stessi e per gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663011,
					"content": "Non essere nervosa, signorina! È solo un gioco, l'obiettivo è divertirsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
