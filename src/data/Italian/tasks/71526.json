			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "Fiuuu... Paimon stava per combinare un guaio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663102,
					"content": "Per poco non mi è venuto un colpo! Quella bestiolina è tosta! Anch'io me la sarei vista brutta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663103,
					"content": "Com'è possibile diventare così bravi senza un maestro? Quelli di Liyue sono tutti guerrieri nati o cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663104,
					"content": "Quindi è così che giocano assieme gli Onikabuto? Ora ho capito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "Ranuncolo del terrore"
				},
				{
					"id": 716663105,
					"content": "Avete tempo per giocare ancora un po'? E voglio anche starvi a guardare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "Ranuncolo del terrore"
				},
				{
					"id": 716663106,
					"content": "Pare che Ranuncolo del terrore abbia un talento naturale per questo... E la cosa mi terrorizza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663107,
					"content": "Ehi, Toro sdraiato, se avessi lo stesso talento, probabilmente avresti imparato a comunicare con le creature col guscio semplicemente ascoltando Guoba parlare con Tornado di cristallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663108,
					"content": "Ah... Ahah, ahah... Magari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
