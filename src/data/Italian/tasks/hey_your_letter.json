	"talks": [
		{
			"id": 2503501,
			"completionStepIds": [
				2503501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
