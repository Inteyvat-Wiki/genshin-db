			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Quegli imbranati... Come hanno fatto a perdere un altro carico di pacchi? Gli avevo detto di non combinare pasticci durante le consegne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350102,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "Alcuni dei nostri fattorini hanno di nuovo ignorato le istruzioni, e indovina un po'? Hanno perso un sacco di pacchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350104,
					"content": "*sospira* Non si rendono conto che una tale negligenza danneggia la reputazione dei Discendenti delle Vette?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350105,
					"content": "Quando sei fuori per lavoro, concentrati sulla consegna! Se stai scendendo lungo un pendio, prosegui come faresti normalmente. Non dovresti far finta di essere sugli scivoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350106,
					"content": "Gliel'ho detto tantissime volte, ma quei giovani non mi ascoltano. Pensano solo a divertirsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350107,
					"content": "*sospira* Ora mi toccherà chiedere a qualcuno di recuperare quei pacchi. Fammi pensare, chi è libero in questo momento...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350108,
					"content": "Ti darò una mano io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "Eh? M-Mi aiuteresti davvero? Magnifico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350110,
					"content": "Mi ci vorrebbe un bel po' di tempo per trovare qualcuno che potesse aiutarmi e, se ci andassi io, non resterebbe nessuno a sorvegliare la Capanna del fattorino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350117,
					"content": "E non preoccuparti, non ti lascerò andare alla cieca. Conosco i percorsi di quei ragazzini, quindi posso darti un'idea su dove siano finiti quei pacchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350118,
					"content": "Ti segnerò i luoghi possibili. Grazie in anticipo. Conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350111,
					"content": "Sono dei pacchi grandi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "No, non lo sono. Ma è questo che li rende difficili da trovare. *sospira* Quei bietoloni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350113,
					"content": "...Allora, se hai tempo, ti andrebbe di aiutarmi a recuperarli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350114,
					"content": "Al momento la Capanna del fattorino è a corto di personale, se andassi a cercarli io non rimarrebbe nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350115,
					"content": "Nessun problema, ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "Magnifico! Grazie infinite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				}
			]
		},
