			"dialogs": [
				{
					"id": 250350801,
					"content": "Due... Tre... Benissimo! Ottimo lavoro, li hai recuperati tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350802,
					"content": "...Un attimo, questo non doveva essere consegnato da Tundama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350803,
					"content": "Ecco il tuo pagamento, grazie per l'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350804,
					"content": "Argh, dovrò fare un bel discorsetto a Tundama...",
