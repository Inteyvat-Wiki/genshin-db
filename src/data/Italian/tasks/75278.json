			"dialogs": [
				{
					"id": 752780101,
					"content": "U-Un momento, fermatevi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780102,
					"content": "Possiamo aiutarti, piccola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780103,
					"content": "\"Porta il miracolo dei Guitzli in fiore, e lascia che la Fiamma sacra illumini il tuo sorriso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780104,
					"content": "Eh? Che succede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780105,
					"content": "\"A nome del Resort Dolcebrezza, vi porgo i miei saluti in un balletto di benvenuto! Brilla, idol Pipilpan!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780106,
					"content": "Ah! Di nuovo quella frase?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780107,
					"content": "#Sì, sono io, \"Chiton\"! Eheh, da quanto tempo, {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780108,
					"content": "#Ah, ma sei tu, \"Chiton\"! Paimon pensava che ci fossimo {F#imbattute}{M#imbattuti} in qualche altro malintenzionato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780109,
					"content": "Sembri felice. Ci sono novità?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Eheh, indovinate un po'? Papà mi allenerà personalmente per diventare una ballerina vera e propria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780112,
					"content": "Lo vedi? Fa tanto il duro, ma in realtà ci tiene molto a te! Anche se Paimon spera che non ti insegnerà... cose discutibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780113,
					"content": "Ah, già, questo è per voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780114,
					"content": "Un attimo, ma questo non è il tuo costume da esibizione? Come farai senza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780115,
					"content": "Non c'è problema! Papà me ne ha fatto uno nuovo della mia misura! Ora non rischierò più di cadere dal palco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780116,
					"content": "Consideratelo un souvenir! Prendetelo pure, come simbolo della nostra amicizia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780117,
					"content": "La prossima volta che c'incontreremo, ballerò per voi indossando il mio nuovo costume. Promettetemi che verrete a trovarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780118,
					"content": "Promesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780119,
					"content": "\"Chiton\"! È ora di allenarsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780120,
					"content": "#Ok, tempo di allenare i miei di muscoli. Alla prossima, {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780121,
					"content": "Ciao ciao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780122,
					"content": "(Vuoi andarci per davvero?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "Ovviamente! Anche se... sarebbe bello vedere una normale esibizione di un idol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780110,
					"content": "Come ti vanno le cose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}