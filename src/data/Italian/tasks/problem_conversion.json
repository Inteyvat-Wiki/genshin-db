			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "Lo sapevo, fare così è molto più costoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190102,
					"content": "Di cosa stai parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "Ah, ciao. Sto studiando un problema di progettazione navale e ora mi trovo di fronte a un blocco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190104,
					"content": "Te lo dico chiaro e tondo. Voglio delle navi che possano trasportare più cose senza aumentare il costo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190105,
					"content": "Se il peso è eccessivo, la struttura diventa più soggetta a rotture. Una distribuzione del peso non uniforme influisce sull'equilibrio, e così via...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190106,
					"content": "Il modo migliore per risolvere questi problemi è usare materiali migliori, ma se lo facciamo rischiamo di incorrere in costi maggiori. Ecco il nocciolo del problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190107,
					"content": "*sospira* A essere sincero, non dispongo dei Mora, ma voglio comunque costruire una buona nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190108,
					"content": "Quindi se ci sono dei problemi che possono essere risolti con i Mora, mi tocca trovare qualche mezzo tecnico per aggirarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190109,
					"content": "Puoi farlo davvero...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "Ahahah, puoi non crederci, ma lo fanno in molti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190111,
					"content": "Le navi che costruiamo sono pescherecci costieri, dopotutto. Non incontreranno tempeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190112,
					"content": "Quando si tratta di costruzioni navali, aderiamo al principio di risparmiare tutto ciò che può essere risparmiato, e di aggiustare e riparare tutto ciò che si può... Finché si può usare, improvvisiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190113,
					"content": "Grazie a questo principio, la nostra attività di riparazione navale ha sempre il vento in poppa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190114,
					"content": "#Viaggiat{F#rice}{M#ore}, se sei disponibile, aiutami a controllare la nave che è appena rientrata in porto. Sembra che abbia qualche problema perché trasporta spesso carichi pesanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190115,
					"content": "Il caso vuole che stia studiando proprio questo argomento, quindi magari riesco a trovare dell'ispirazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190116,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "Lascio fare a te, allora! Devo correre a riparare un'altra nave...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190118,
					"content": "Perché non ci vai tu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "Mi piacerebbe, ma mi hanno chiesto di riparare un'altra nave che deve salpare di nuovo a breve per pescare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190120,
					"content": "#Quindi non posso fare altro che affidarti quest'incarico, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
