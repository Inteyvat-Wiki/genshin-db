			"dialogs": [
				{
					"id": 230190401,
					"content": "Allora? Hai finito di controllare la nave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190402,
					"content": "Sì...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "Descrivi le condizioni della nave.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "Capisco. Le strutture con cui si è cercato di ridurre i costi hanno dei problemi, come previsto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190405,
					"content": "Ma costerà molto ripararle. Il proprietario di quella nave... Ricordo che ha sempre bisogno di risparmiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190406,
					"content": "*sospira* Sarà meglio che ci parli. La sua vita è decisamente più importante di qualche Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		}
