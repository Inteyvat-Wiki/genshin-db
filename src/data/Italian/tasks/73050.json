			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aranaga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "#Il Festival di Utsava... Sembra familiare... Eh? Bianchina volante... e {F#la}{M#il} Nara dorat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730500302,
					"content": "#Ma è l'amic{F#a}{M#o} Nara, e l'amica dell'amic{F#a}{M#o} Nara. Spero vi divertirete al Festival di Utsava.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730500303,
					"content": "#Un amico di un amico è anche nostro amico! Nara dorat{F#a}{M#o} e Bianchina volante sono entramb{F#e}{M#i} amic{F#he}{M#i} di Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		}
	]
