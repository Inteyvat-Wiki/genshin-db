			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#Nara {NICKNAME} e Paimon! Non preoccupatevi. I cattivi che hanno fatto ammalare il Vanarana non torneranno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500202,
					"content": "#Grazie, Nara {NICKNAME} e Paimon, per aver aiutato Ararycan a proteggere Vanarana. Ararycan ha dei fiori per voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730500203,
					"content": "#Prendete questi fiori, amic{F#he}{M#i} di Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
		{
			"id": 7305003,
			"completionStepIds": [
