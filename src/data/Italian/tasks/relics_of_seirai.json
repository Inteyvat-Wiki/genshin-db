			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Fujiwara Toshiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "G-Grazie... Uff, non pensavo che questi tizi avrebbero provato a cogliermi di sorpresa in quel modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620102,
					"content": "Chi sei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "Mi chiamo Fujiwara Toshiko e sono qui per... ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620105,
					"content": "Beh, dal momento che mi avete salvata posso anche dirvelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620106,
					"content": "In realtà, sono qui per trovare il tesoro che i miei antenati hanno lasciato da queste parti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620107,
					"content": "T-Tesoro...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721620108,
					"content": "L'hai già trovato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "Ahahah, certo che sì! Ho seguito alcuni indizi fino al luogo in cui si trova il tesoro e pianificato un modo per entrare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620110,
					"content": "Però proprio quando stavo per attivare l'interruttore e raggiungere l'area in cui è nascosto, quei mostri mi hanno attaccata all'improvviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620111,
					"content": "Vi devo la vita. Grazie per aver scacciato quegli Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620112,
					"content": "Ehm... Se vi chiedessi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620113,
					"content": "Se vi chiedessi di proteggermi un po' più a lungo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620114,
					"content": "Devo ancora trovare il tesoro, ma temo di non riuscire a tenere a bada tutti quei mostri da sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620115,
					"content": "Potrei... Potrei perfino condividere una parte del tesoro con voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620116,
					"content": "C'è davvero un tesoro qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "Sono sicura di poterlo trovare, eccome! Fidatevi di me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620119,
					"content": "So già dove si trova l'interruttore che ci permetterà di raggiungere il luogo in cui è nascosto il tesoro. È proprio laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620120,
					"content": "Detto ciò... Non sembra qualcosa che possiamo banalmente attivare. A quanto pare dovremo usare un metodo particolare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620121,
					"content": "I miei antenati hanno lasciato una mappa, ce l'ho qui con me. Contiene indizi su come far funzionare il meccanismo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620122,
					"content": "Però... Insomma, non ci ho ancora capito molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620123,
					"content": "Tieni, prova a dare un'occhiata. Magari riuscirai a capire come dobbiamo procedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620124,
					"content": "*sospira* Come faccio a risolvere un rompicapo del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620117,
					"content": "Pensi davvero di poterlo trovare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620103,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				}
			]
		},
