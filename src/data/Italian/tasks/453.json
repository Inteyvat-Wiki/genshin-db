			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530101,
					"content": "Santo cielo... È tremendo, questo povero ragazzo non riesce nemmeno ad alzarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530102,
					"content": "Ma è terribile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530103,
					"content": "Solo che... in realtà non è ferito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530104,
					"content": "Esatto. È tremendo, i lupi lo hanno spaventato così tanto che è paralizzato dalla paura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530105,
					"content": "È... davvero tremendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530106,
					"content": "Ricordate di aver notato qualche dettaglio insolito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530107,
					"content": "N-Non avevo mai visto un lupo in vita mia prima d'oggi, è stato terrificante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530108
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4530108,
					"content": "...Nessun dettaglio, quindi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530109,
					"content": "Perlustriamo di nuovo la zona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 45305,
			"completionStepIds": [
				45305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45305",
							"2"
						],
						"stepId": 45305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530501,
					"content": "Peli di lupo... Ho sentito dire che a Liyue li usano per farci pennelli da calligrafia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530502,
					"content": "Il colore non somiglia per niente alla pelliccia dei lupi di Mondstadt, almeno stando ai libri. Possibile che vengano da qualche altra parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530503,
					"content": "I peli hanno un aspetto diverso nelle varie parti del corpo. Lo stesso vale per i lupi. Non sappiamo da dove provengano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530504,
					"content": "Ma guarda qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530505,
					"content": "Altri peli. Cosa c'è attaccato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530506,
					"content": "Un seme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "È il seme di una Bacca uncinata. Guardate, è coperto di piccoli uncini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530509,
					"content": "Gli unici posti in cui cresce a Mondstadt sono il Regno dei Lupi e il Canyon di Coronsplendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530510,
					"content": "Quindi vengono davvero dal Regno dei Lupi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530511,
					"content": "Sì, da quella zona, ma è possibile che altri branchi di lupi abbiano sconfinato nel loro territorio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530512,
					"content": "Questo non ci racconta la storia completa, ma ci fornisce una buona pista. Basta per iniziare a indagare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530513,
					"content": "Andrò a parlare con gli abitanti del villaggio prima di partire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530507,
					"content": "È un seme speciale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
		{
			"id": 45306,
			"completionStepIds": [
				45306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
