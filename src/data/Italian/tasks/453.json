			},
			"dialogs": [
				{
					"id": 4530701,
					"content": "Questi segni di artigli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530702,
					"content": "Esaminandoli, possiamo capire il numero e le dimensioni dei lupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530703,
					"content": "Questa volta ce n'erano almeno due, e devono essere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530704,
					"content": "Devono essere...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "Sì, sì! Devono essere alti almeno... due metri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530706,
					"content": "...Paimon, sai cos'è un lupo, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "Ehi! I lupi sono creature misteriose, non si vedono mica tutti i giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 45308,
			"completionStepIds": [
				45308
			],
