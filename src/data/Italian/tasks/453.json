			},
			"dialogs": [
				{
					"id": 4530801,
					"content": "Questo è un dente di lupo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530802,
					"content": "Deve aver sbattuto contro la porta nella foga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530803,
					"content": "Forse ha una carenza di calcio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530804
					]
				},
				{
					"id": 4530804,
					"content": "In ogni caso, è una bella fortuna che nessuno nel villaggio sia seriamente ferito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
