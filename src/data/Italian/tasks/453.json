			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hopkins il Meraviglioso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "Come procede la vostra indagine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4530602,
					"content": "Cos... Sei in piedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530603,
					"content": "Mi sono ripreso, per fortuna. Sono risalito dagli abissi dell'inferno con le unghie e con i denti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4530604,
					"content": "Allora, Cavalieri di Favonius, cos'avete scoperto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4530605,
					"content": "Esaminando i peli di lupo rimasti sulla scena, è evidente che provengano dal Regno dei Lupi. Oltre a questo, non sappiamo altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530606,
					"content": "Ma ti prego di mantenere la calma. Sto per recarmi nel Regno dei Lupi per chiarire la questione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530607,
					"content": "I Cavalieri di Favonius non lasceranno impunita questa minaccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530608,
					"content": "Bene. Meglio tardi che mai, immagino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4530609,
					"content": "Che maleducato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530610,
					"content": "Nel frattempo, dovremo continuare a occuparci del problema per conto nostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4530611,
					"content": "Non prendete decisioni avventate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530612,
					"content": "Ahah! Da queste parti abbiamo metodi un po' diversi, a cui voi forze dell'ordine probabilmente non siete abituate. Pagheranno per quello che hanno fatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4530613,
					"content": "Addio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "Hopkins il Meraviglioso"
				},
				{
					"id": 4530614,
					"content": "È preoccupante, davvero preoccupante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530615,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530616,
					"content": "Il loro futuro, intendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530617,
					"content": "Sono d'accordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "I giovani possono essere così impulsivi, a volte. Se non è di troppo disturbo, vorrei che li teneste d'occhio per impedire che si caccino nei guai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530619,
					"content": "Nessun disturbo, siamo qui per questo. Anche se quel tipo non è esattamente un campione di cortesia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530620,
					"content": "Lascia fare a noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530621,
					"content": "Andiamo nel Regno dei Lupi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 45307,
