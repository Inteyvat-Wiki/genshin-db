					}
				]
			},
			"dialogs": [
				{
					"id": 766500301,
					"content": "Wow, che statua enorme! Sì, non sarebbero mai riusciti a spostarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500302,
					"content": "Probabilmente non sarebbero riusciti neanche a oltrepassare lo Specchio... Lauma, che valore ha questa statua, di preciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500303,
					"content": "In termini di Mora? Non molti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500304,
					"content": "È stata scolpita in modo approssimativo, e la pietra utilizzata è comune e si trova ovunque qui nei dintorni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500305,
					"content": "Ma per le Cantaluna di quell'epoca, e per gli Eredi della Luna gelata di oggi, è un tesoro inestimabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500306,
					"content": "Se non altro, ora ho una prova tangibile della sua esistenza. Basta per confermare l'affidabilità di diversi documenti sull'argomento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500307
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500307,
					"content": "Per me basta per considerare tutto questo un successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500308,
					"content": "#Grazie dell'aiuto, {NICKNAME}. Sapevo di averti {F#giudicata}{M#giudicato} bene. Lo Specchio lunare non rappresentava un ostacolo per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500309,
					"content": "E la nostra piccola amica qui è molto colpita dalle tue abilità nel manovrare i meccanismi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500310,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500311
					],
					"speakerTitle": "Donnoladra"
				},
				{
					"id": 766500311,
					"content": "Cosa sta dicendo, Lauma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500312,
					"content": "#Che {NICKNAME} è {F#la migliore cacciatrice}{M#il miglior cacciatore} di tesori che abbia mai visto. Desidera, se può, unirsi a te in un'avventura per trovare tutti i bauli del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500313,
						766500314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500313,
					"content": "#Wow, però così mi fa sembrare {F#una ladra}{M#un ladro}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				},
				{
					"id": 766500315,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500316
					],
					"speakerTitle": "Donnoladra"
				},
				{
					"id": 766500316,
					"content": "\"D'ora in poi, ti chiamerò se mai dovessi trovare un baule che non riesco ad aprire!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500317,
					"content": "Uh... Ok, allora ciao... Non ci ha neanche lasciato scegliere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500318,
					"content": "Non preoccuparti, non busserà alla finestra ogni giorno con un Mora in bocca, tentando di trascinarti in una caccia al tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500319,
					"content": "E di sicuro non ti visiterà in camera nel pieno della notte, lamentandosi di serrature che non riesce ad aprire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500320,
					"content": "#{NICKNAME}! Assicuriamoci di chiudere a chiave tutte le porte e le finestre prima di andare a dormire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500321,
					"content": "Non preoccuparti. Non ha cattive intenzioni, è solo giovane. Ed è solo... più loquace delle altre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500322,
					"content": "Bene, torniamo indietro. È quasi ora di cena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500323,
					"content": "Oh, dobbiamo anche trovare il modo di riportare questa statua nella biblioteca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500324
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500324,
					"content": "...Sembra che avrò bisogno di un po' d'aiuto dai miei amici, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500314,
					"content": "Però è vero che ho aperto moltissimi bauli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				}
			]
		},
