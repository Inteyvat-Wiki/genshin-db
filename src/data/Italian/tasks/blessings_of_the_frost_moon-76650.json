			"dialogs": [
				{
					"id": 766500101,
					"content": "~♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500102
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 766500102,
					"content": "...Sì, sono sicura tu abbia davvero tanti amici, ma non è quello il problema. Anche se chiamassi tutti gli ibis dell'Isola di Hiisi, non penso che riusciresti comunque a muovere lo Specchio lunare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500103,
					"content": "E anche se ci riuscissi, la Sembianza lunare al suo interno sarebbe comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500104,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500105
					],
					"speakerTitle": "Donnoladra"
				},
				{
					"id": 766500105,
					"content": "...Vuoi scavare? Mmmh. Potresti, sì, ma spostare lo Specchio sarebbe comunque un'impresa, anche per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500106,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500107
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 766500107,
					"content": "Eh? Se serve, puoi davvero chiamare tutti gli ibis dell'isola...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500108,
					"content": "E tu, invece, pensi che questo piano sia ridicolo, anche se coinvolge l'intera famiglia dell'ibis...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500109,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500110
					],
					"speakerTitle": "Donnoladra"
				},
				{
					"id": 766500110,
					"content": "Wow, le cose stanno prendendo una brutta piega qui... Sembra che quella Donnoladra stia litigando con l'uccello...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500111,
						766500112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500111,
					"content": "State organizzando una rapina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				},
				{
					"id": 766500113,
					"content": "Stiamo \"pianificando e complottando\", a dirla tutta. Mi dicono che prima di poter procedere, bisogna organizzare tutto per bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500114,
					"content": "Ma i miei complici non sono d'accordo su quale metodo seguire, e non sono neanche particolarmente diplomatici. Sono state usate parole pesanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500115,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500116
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 766500116,
					"content": "Va bene, va bene, ti credo... Hai delle amicizie importanti. Anche se mi chiedo dove tu abbia imparato a parlare così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500117,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500118
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 766500118,
					"content": "...Da una ragazzina con un braccio di metallo e un cappello?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500119,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500120
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 766500120,
					"content": "Ah, certo che puoi continuare a parlare così, purché continui a piacerti. Ma... Sii ragionevole quando sei con lei, va bene? Non copiarla in tutto e per tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500121
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500121,
					"content": "#Ora vado a fare due chiacchiere con {NICKNAME} e Paimon, quindi fate i bravi e abbassate la voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500122,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500123
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 766500123,
					"content": "Wow, ora è davvero più silenzioso! Capire il linguaggio animale... Che bello! Anche Paimon vorrebbe quest'abilità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500124,
					"content": "...Fidati, Paimon. Non ti divertiresti molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500125,
						766500126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500125,
					"content": "Wow, che frase inquietante...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500127,
					"content": "Ah, non fraintendermi. Non succederebbe nulla di terribile, e non ti farebbe impazzire o qualcosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500128
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500128,
					"content": "...Anche se, a dirla tutta, a volte è un'abilità un po' travolgente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500129
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500129,
					"content": "Quando ho scoperto di comprendere il linguaggio animale, ero felicissima, ma ho presto capito che c'era un lato negativo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500130
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500130,
					"content": "È un'abilità sempre attiva, e non posso controllarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500131,
					"content": "Ah... Sì, sarebbe un problema. E se non puoi controllarla, significa che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500132,
						766500133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500132,
					"content": "Dalla foresta al mare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500134,
					"content": "...Proprio così. Molte persone dicono che ascoltare il canto degli uccelli nel bosco conferisca loro un profondo senso di pace e tranquillità, in grado di sollevare il loro spirito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500135
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500135,
					"content": "Ma non importa dove vada, io... Non posso mai trovare pace e tranquillità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500136,
					"content": "Quando sono nella foresta, sento le chiacchiere dei gatti selvatici, dei conigli, dei Cervi Cornabrina, degli Elegantassi e degli Ibis Lungapiuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500137
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500137,
					"content": "Litigano animatamente su chi è il responsabile del danneggiamento di un nido, o da quale parte del bosco provengono i rametti migliori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500138,
						766500139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500138,
					"content": "Quindi le tue orecchie non possono mai riposare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500140,
					"content": "O-Ok... Paimon immagina che parlare con gli animali non sia così bello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500141,
					"content": "Il cinguettio degli uccelli al mattino è un bel suono, ma... se il cinguettio non è altro che un litigio, all'improvviso non sembra più tanto piacevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500142,
						766500143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500142,
					"content": "#Sappiamo {F#entrambe}{M#entrambi} che ci vuole molto di più di un semplice cinguettio per svegliarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500144,
					"content": "Per quanto mi riguarda... Vivo in questo modo da così tanto tempo che ci sono abituata. In effetti, sarebbe probabilmente un bel cambiamento se un giorno mi svegliassi e non sentissi i fringuelli discutere su quale tazza, in quale casa, sia la migliore per fare il bagno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500145
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500145,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500146
					],
					"speakerTitle": "Donnoladra"
				},
				{
					"id": 766500146,
					"content": "#...Sì, pianificando e complottando, grazie per avermelo ricordato, mi sono distratta un attimo. Anche se ora che c'è {NICKNAME}, potremmo aver trovato una soluzione al nostro problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500147,
						766500148
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500147,
					"content": "Anch'io ho delle amicizie importanti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500149,
					"content": "No, no, basterai tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500150
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500150,
					"content": "Il compito consiste nell'introdursi in un magazzino, rimuovendo il sigillo creato con lo Specchio lunare da una precedente Cantaluna. Ma per una persona talentuosa come te, sono sicura non sarà un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500151,
						766500152
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500151,
					"content": "Creato da una precedente Cantaluna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500153,
					"content": "Non preoccuparti, andrà tutto bene. Su, andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500152,
					"content": "Avrò bisogno di un po' di addestramento sul posto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500148,
					"content": "Mi serve solo un po' di tempo per riunire tutti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500143,
					"content": "Quante volte ti ho dovuta svegliare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500139,
					"content": "Dovunque tu vada, sono chiacchiere interminabili...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500133,
					"content": "Ovunque ci siano degli animali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500126,
					"content": "Mi sono venuti i brividi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500112,
					"content": "Stanno litigando su come dividersi il bottino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				}
			]
		},
		{
			"id": 7665002,
			"completionStepIds": [
				7665002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
