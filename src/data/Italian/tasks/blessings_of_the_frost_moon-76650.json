						],
						"stepId": 7665002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1900.978,
							232.324,
							10455.41
						],
						"pointId": 11806
					}
				]
			},
			"dialogs": [
				{
					"id": 766500201,
					"content": "Eccoci qui. Ciò che vedete è lo Specchio lunare, al cui interno è sigillata la Sembianza lunare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500202,
					"content": "Dev'essere una statua molto preziosa, se si sono impegnati così tanto per sigillarla... Ci saranno delle trappole al suo interno? Sai, di quelle che scagliano frecce a caso se calpestiamo qualcosa di sbagliato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500203,
						766500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500203,
					"content": "#Sono {F#pronta}{M#pronto}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				},
				{
					"id": 766500205,
					"content": "Non preoccuparti, questa piccoletta ha fatto delle ricognizioni per conto mio. Il sigillo non contiene nessuna trappola letale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500206
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500206,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500207
					],
					"speakerTitle": "Donnoladra"
				},
				{
					"id": 766500207,
					"content": "Oh, fantastico! Buono a sapersi. Effettivamente è un lavoro perfetto per una Donnoladra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500208,
						766500209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500208,
					"content": "Ma sembra proprio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500210,
					"content": "Ahah. È vero. Ogni volta che le chiedo aiuto, devo darle un Mora in più la prossima volta che ci vediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500211
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500211,
					"content": "Ihih, una bella ladruncola! ...Oh, aspetta, effettivamente ha senso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500212,
					"content": "Mmmh, ma considerando che ti aiuta a tenere d'occhio la Sembianza lunare, forse dovrebbe cambiare nome.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500213,
					"content": "Che ne dici di... \"Donnoguardia\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500214,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500215
					],
					"speakerTitle": "Donnoladra"
				},
				{
					"id": 766500215,
					"content": "Ihih, non puoi prendere Paimon, perché Paimon sa volare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500216,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500217,
						766500218
					],
					"speakerTitle": "Donnoladra"
				},
				{
					"id": 766500217,
					"content": "Ehi, ehi, non arrampicarti su di me...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500219,
					"content": "#Suvvia, sii gentile con {F#le nostre}{M#i nostri} ospiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500220
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500221,
						766500222
					],
					"speakerTitle": "Donnoladra"
				},
				{
					"id": 766500221,
					"content": "Come possiamo aiutare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500223,
					"content": "Per recuperare la Sembianza lunare, dobbiamo attivare una coppia di meccanismi in due luoghi diversi. Quindi servono due persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500224
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500224,
					"content": "#{NICKNAME}, io mi occupo di questo lato, se tu vai dall'altra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500225
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500225,
					"content": "Ma come facciamo ad attivarli contemporaneamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500226
					]
				},
				{
					"id": 766500226,
					"content": "Non sarà un problema. C'è chi guarda per me in cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500227
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500227,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500228
					],
					"speakerTitle": "Ibis Lungapiuma"
				},
				{
					"id": 766500228,
					"content": "Mi terrà aggiornata sulla tua posizione e sul meccanismo davanti a te. Non preoccuparti, ti basterà seguire le mie istruzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500222,
					"content": "Come facciamo ad aprire questo meccanismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500218,
					"content": "Non i capelli! Non i capelli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500209,
					"content": "Che questa Donnoladra non lavori gratis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500204,
					"content": "#Ci sono {F#abituata}{M#abituato}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				}
			]
		},
