			"dialogs": [
				{
					"id": 766500401,
					"content": "Qui va benissimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500402
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500402,
					"content": "Uh. È stato un po' deludente. Paimon si aspettava sarebbe successo qualcosa di emozionante una volta messa giù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500403,
					"content": "Eheh, beh, è solo una vecchia statua, una reliquia storica. Non ha alcun potere mistico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500404
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500404,
					"content": "Il suo vero valore sta nelle storie... E il mio compito è ritrovarle, ovunque queste siano nascoste, verificarle e poi condividerle col popolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500405,
					"content": "Fantastico! Allora è un bene che l'abbiamo riportata qui tutta intera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500406,
					"content": "Sì, e devo ringraziare voi due per questo. Prendete questi frutti e placate la vostra sete, gli animali li hanno raccolti nel bosco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500407,
					"content": "Dopodiché... Vi chiedo scusa, ma avrei un'altra richiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500408
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500408,
					"content": "Certo. Cosa ti serve?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500409
					]
				},
				{
					"id": 766500409,
					"content": "#Chiedo scusa, potrò sembrare presuntuosa, ma ho visto quanto siete {F#conosciute}{M#conosciuti}, e ho sentito dei vostri viaggi in luoghi segreti e dimenticati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500410
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500410,
					"content": "Se in futuro vi imbatteste in testi sugli Eredi della Luna gelata, potrei prenderli in prestito e farne una copia per arricchire la nostra biblioteca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500411,
						766500412
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500411,
					"content": "Ovviamente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500413
					]
				},
				{
					"id": 766500413,
					"content": "Ti ringrazio, a nome degli Eredi della Luna gelata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500414,
						766500415
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500414,
					"content": "Ora torno alla frutta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500416
					]
				},
				{
					"id": 766500416,
					"content": "Ahhh, che delizia! Molto più buona di quella a cui è abituata Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500417,
					"content": "Eheh. Gli animali hanno vissuto tutta la loro vita in questa foresta. Ovviamente, sanno dove trovare la frutta migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500418
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500418,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500419
					],
					"speakerTitle": "Fraticella"
				},
				{
					"id": 766500419,
					"content": "Eheh... Questo qui dice di mangiarne a volontà, perché è il miglior cercatore di frutta di tutta la foresta. Ve ne prenderà altra all'istante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500420
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500420,
					"content": "Fantastico. Grazie mille!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500421
					]
				},
				{
					"id": 766500421,
					"content": "Fantastico. Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500415,
