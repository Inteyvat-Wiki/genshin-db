			},
			"dialogs": [
				{
					"id": 205200101,
					"content": "#V-Viaggiat{F#rice}{M#ore}... A-Aiutami... Ti prego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200102,
					"content": "Cosa ti sta succedendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "P—Per piacere... Ho... ho bisogno di scaldarmi... Fa t-troppo freddo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200104,
					"content": "O f-forse... un po' di cibo c-caldo potrebbe farmi b-bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200105,
					"content": "P-Per piacere... Fa troppo... F-Freddo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
