			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tommy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205200401,
					"content": "#Fiuu... Va molto meglio. Grazie, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200402,
					"content": "Cosa ti porta qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "*sospira* Un incarico, cos'altro? Sono stato all'accampamento per tutto questo tempo a causa di un incarico abbastanza... complicato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200404,
					"content": "Ma visto che non volevo restarci per sempre, stavo cercando qualcos'altro da fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200405,
					"content": "Lo chef Harris stava cercando qualcuno che potesse trovare della carne congelata sulla montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200406,
					"content": "Ha detto che sarebbe bastato un piccolo cinghiale congelato, e che non ci sarebbe stato bisogno di salire troppo in alto sulla montagna, che non ci sarebbe stato nessun pericolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200407,
					"content": "Dato che mi sembrava abbastanza facile, ho accettato l'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200408,
					"content": "Mi sono anche preparato... Mi sono allenato, abituandomi piano piano al clima del Picco del Drago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200409,
					"content": "...Tutto ciò per portare a termine l'incarico assegnatomi da quell'alchimista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200410,
					"content": "Ma non mi aspettavo di perdermi subito dopo aver cominciato la scalata, e di rischiare di morire congelato. Per fortuna mi hai trovato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200411,
					"content": "Il mio unico rimpianto è... Di non aver completato l'incarico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200412,
					"content": "#Viaggiat{F#rice}{M#ore}... Sembri conoscere bene questa montagna. Posso chiederti un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200413,
					"content": "Devi solo trovare una porzione di carne congelata. Me ne basta una per completare l'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200414,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "Grazie. In questo caso, segnerò sulla tua mappa i luoghi dove Harris ha detto che potremmo trovare dei piccoli cinghiali congelati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200416,
					"content": "Scenderò all'accampamento ai piedi della montagna e aspetterò lì tue notizie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
