			"dialogs": [
				{
					"id": 205200501,
					"content": "Hai trovato della carne congelata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200502
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200502,
					"content": "Ce l'ho proprio qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "Ottimo! Quindi questa è carne congelata? Non vedo nessuna differenza, oltre al fatto che è fredda al tatto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200504,
					"content": "Beh, l'importante è che l'incarico sia completato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200505,
					"content": "#Grazie, viaggiat{F#rice}{M#ore}. Se non fosse stato per te, sarebbe finita male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200506,
					"content": "Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
