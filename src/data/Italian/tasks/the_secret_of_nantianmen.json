			"dialogs": [
				{
					"id": 718080301,
					"content": "Già di ritorno? Com'è la situazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080302
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080302,
					"content": "Allora, ecco cosa sta succedendo a Nantianmen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "Terremoti, mostri e una bambina... Che si sia smarrita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080304,
					"content": "Ecco quello che ha detto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "...Ha detto cosa? Chi è che dovrebbe risorgere? Che mucchio di sciocchezze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080306,
					"content": "Chissà quali libri strani avrà letto di recente... Comunque, non è questo il punto. Chiederò subito a qualcuno di andare a prendere la bambina e riportarla in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080307,
					"content": "Prima i terremoti, ora i mostri... Non deve succederle nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080308,
					"content": "Grazie mille. Per favore, prendi questi come ringraziamento per il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080309,
					"content": "Uff, mai una giornata tranquilla al lavoro, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
