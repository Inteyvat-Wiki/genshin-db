						],
						"pointId": 266
					}
				]
			},
			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}, Paimon... grazie. Sono davvero felice di avervi incontrato alla fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950102,
					"content": "Hihi. Semmai, sembra che tu sia stata trascinata in tutto questo per colpa nostra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950103,
					"content": "Aspetta, perché \"alla fine\"? Cosa intendi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950104,
					"content": "Intendo che... sono state tutte avventure piuttosto pericolose. Ma ho potuto vedere così tante cose incredibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950105,
					"content": "Non sembra poi così male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950106,
					"content": "Ehi! Non liquidare la domanda di Paimon così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950107,
					"content": "La sto liquidando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zeitlind"
				}
			]
		},
		{
			"id": 7609503,
