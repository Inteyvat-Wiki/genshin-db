					},
					{
						"sceneId": 103,
						"position": [
							156.335,
							170.333,
							410.095
						],
						"pointId": 108
					},
					{
						"sceneId": 103,
						"position": [
							154.182,
							170.359,
							413.867
						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "Istoria, abbiamo praticamente liberato tutte e tre le aree. Anche la maggior parte delle persone è al sicuro, ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950302,
					"content": "E abbiamo persino ritrovato tutto ciò che Zeitlind aveva perso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950303,
					"content": "Oh, grazie mille. Devo dire che Nihilita ha davvero buon occhio per la gente, ora che l'ha aperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950304,
					"content": "Bene, ora tocca a te! Hai detto che c'è un modo per salire lassù, e che ha un prezzo da pagare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950305,
					"content": "Forza! Se si tratta solo di un paio di avventure o di un po' di Mora, Paimon non ha paura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950306,
					"content": "Ah! E Zeitlind? Come facciamo a rimandarla a terra ora che ha finito qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950307,
					"content": "Posso spiegarvi tutto, ma prima dovreste riposare. Domani vi racconterò ogni cosa nel dettaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950308,
					"content": "Va bene. Ma, ehm, qui non c'è un letto. E nemmeno del cibo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950309,
					"content": "Qui quei bisogni svaniscono. Pensaci: sei qui da tutto questo tempo, ma non hai fame. E non sei stanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950310,
					"content": "Eh? E allora cosa dovrebbe fare Paimon tutto il giorno mentre ci riposiamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950311,
					"content": "Questo posto è pieno di persone straordinarie di ogni epoca; parlare con loro potrebbe essere divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950312,
					"content": "#Va bene, va bene. Ma Paimon dormirà quando le pare. Stanca o no, Paimon continuerà a dormire sulla testa di {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950313,
					"content": "Zeitlind, dopo che ti sarai riposata un po', potremmo parlare? Riguarda quello che ho menzionato prima, la cosa su cui avevo bisogno di tempo per riflettere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950314,
					"content": "Vieni a parlarmi più tardi, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950315,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME}, Paimon... Quando vi sarete {F#riposate}{M#riposati}, venite a cercarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
