							413.867
						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950501,
					"content": "#Ti sei {F#riposata}{M#riposato} per bene? Hai parlato con tutti quelli con cui volevi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950502,
						760950504
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950502,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950503
					]
				},
				{
					"id": 760950503,
					"content": "Va bene. Fai con calma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950506,
					"content": "Zeitlind, calmati un attimo e ascoltami. Non intendo mancarti di rispetto né di parlare per vana speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950507
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950507,
					"content": "Tua sorella potrebbe essere ancora viva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950508
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950508,
					"content": "Ho visto la sua tomba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950509
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950509,
					"content": "La sua foto era proprio lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950510
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950510,
					"content": "Ma... è possibile che non ci sia nulla sepolto lì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950511
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950511,
					"content": "Paimon vorrebbe tanto che fosse così, davvero. Ma non è un po' troppo ottimistico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950512,
					"content": "Nell'ultima lettera che mi ha scritto, mia sorella diceva di aver già deciso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950513
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950513,
					"content": "Quell'addio non era inteso come un addio definitivo, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950514
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950514,
					"content": "Ha detto che sarebbe andata in un posto lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950515
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950515,
					"content": "Me ne aveva parlato prima. Ha sempre desiderato viaggiare per il mondo prima d'invecchiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950516
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950516,
					"content": "Hilda non stava parlando in senso figurato. Ha davvero lasciato la casa di cura e si è messa in viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950517
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950517,
					"content": "Te ne ha parlato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950518
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950518,
					"content": "Era sempre così solare. Andava molto d'accordo con tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950519
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950519,
					"content": "Allora probabilmente non ti ha mai detto che... eravamo tutto ciò che avevamo l'una per l'altra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950520
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950520,
					"content": "Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950521
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950521,
					"content": "Lascia che sia sincera. Lascia che sia fredda per un momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950522
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950522,
					"content": "Se la sua partenza avesse causato dolore a tre o quattro persone, quel peso avrebbe potuto superare la sua tristezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950523
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950523,
					"content": "Ma ora ci sono solo io. Sapeva che avrei capito. Che l'avrei perdonata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950524
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950524,
					"content": "Non è così. Non dovresti vederla in questo modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950525
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950525,
					"content": "Non devi dispiacerti per me. Quand'eravamo piccole, i nostri genitori erano ancora con noi e la vita era bella. Quei ricordi sono stati sufficienti a farci andare avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950526
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950526,
					"content": "Ma crescendo... il mondo diventa più difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950527
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950527,
					"content": "Sono sempre stata piuttosto introversa, e avere a che fare con le persone al lavoro mi stanca moltissimo. Pensavo che mia sorella, essendo così estroversa, se la cavasse meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950528
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950528,
					"content": "Ma anche lei sembrava sempre esausta, da quando era diventata adulta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950529
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950529,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950530,
					"content": "Voi avete ancora un futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950531
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950531,
					"content": "Oh. Allora probabilmente non ti ha mai parlato del suo fidanzato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950532
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950532,
					"content": "Era davvero una brava persona. Un tipo normale, gentile e interessante. A volte vorrei che non lo fosse stato. Se fosse stato un uomo cattivo, le cose sarebbero state più facili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950533
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950533,
					"content": "I suoi familiari soffrivano di una strana malattia ereditaria... Non vivevano mai a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950534
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950534,
					"content": "A volte ci scherzava su, dando la colpa all'Archon di Anemo per aver pianificato Mondstadt così bene che persino una famiglia come la sua non si era mai estinta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950535
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950535,
					"content": "Un giorno disse che avrebbe salvato il mondo, e poi se ne andò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950536
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950536,
					"content": "Salvare il mondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950537
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950537,
					"content": "Beh, il mondo gira ancora. Quindi forse, da qualche parte là fuori, in un luogo che nessuno ha notato, l'ha fatto davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950538
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950538,
					"content": "Sai come dici sempre... Che se qualcuno che vive per sempre non può amare tutti ed essere ricambiato, il mondo annegherebbe nel dolore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950539
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950539,
					"content": "Penso che tu abbia ragione. Il che significa che a una vita breve non è concesso nemmeno questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950540
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950540,
					"content": "Voleva dedicare la sua vita all'amore. E questo ha solo fatto soffrire di più mia sorella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950541
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950541,
					"content": "Tanto che fu mandata in una casa di cura in montagna, lo stesso posto sotto i nostri piedi. Un luogo intriso di maledizioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950542
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950542,
					"content": "Non mi ha mai raccontato nulla di tutto questo. Mi dispiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950543
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950543,
					"content": "E sapendo tutto questo, credi ancora che sia viva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950544
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950544,
					"content": "Sì. Perché ha fatto qualcosa qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950545
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950545,
					"content": "E, a causa della mia paura, lei è stata costretta a continuare a vivere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950546
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950546,
					"content": "Ti rispetto moltissimo, Istoria, davvero. Ma credo che tu abbia visto troppa sofferenza nel corso della storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950547
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950547,
					"content": "Un dolore così vasto da sommergere il mondo... Per una persona comune come me, anche solo una piccola parte basterebbe a seppellire una vita intera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950548
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950548,
					"content": "Non puoi comprendere completamente me e mia sorella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950549
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950549,
					"content": "Quindi... Come posso tornare a calpestare la terra dei mortali? La mia è una vita breve ed effimera. L'eternità non è fatta per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950550
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950550,
					"content": "*sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950551
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950551,
					"content": "Istoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950552
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950552,
					"content": "Questo luogo un tempo era completamente isolato dal mondo in superficie. Non c'era modo di entrare né di uscire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950553
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950553,
					"content": "Ma, dopo la caduta di Nihilita, sembra che Dex abbia acquisito la capacità di trasportare le persone del mondo dei vivi tra la Sala dei Pilastri e la superficie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950554
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950554,
					"content": "Ciononostante, non può riportare indietro coloro che sono stati scelti per venire qui. È un Osservatore nella sua forma giovanile, e questa limitazione fa parte della sua natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950555
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950555,
					"content": "Eh? Stai dicendo che Dex è lo stesso tipo di essere di Nihilita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950556
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950556,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950557
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950557,
					"content": "Se vogliamo tornare sulla terra, c'è solo un modo: dobbiamo rinunciare a ogni ricordo che abbiamo, a tutto ciò che conosciamo, e salire fino in cima. In passato, questo significava incontrare la Signora. Ora significherebbe incontrare Melanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950558
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950558,
					"content": "Quindi non posso venire con voi. Ma almeno, lasciate che vi accompagni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950504,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950505
					]
				},
				{
					"id": 760950505,
					"content": "Molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				}
			]
		},
