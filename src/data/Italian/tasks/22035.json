	"talks": [
		{
			"id": 2203501,
			"completionStepIds": [
				2203501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203501",
							"2"
						],
						"stepId": 2203501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "#Viaggiat{F#rice}{M#ore}, ci incontriamo di nuovo. Grazie al tuo aiuto l'ultima volta, ora Sango è certa dell'identità del colpevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350102,
					"content": "Ma se vogliamo davvero metterlo nel sacco, c'è ancora qualcosa che dobbiamo fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350103,
					"content": "Mentre Sango si occupa d'altro, proseguiremo quanto abbiamo già iniziato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350104,
					"content": "Cercare rogne con i Cacciatori di tesori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "Esatto. Anche se, in realtà, il colpevole non ha niente a che fare con loro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350106,
					"content": "Quei Cacciatori di tesori hanno comunque cattive intenzioni, quindi tanto vale farci \"aiutare\" da loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350112,
					"content": "Sango ha indicato il luogo dove si trovano di preciso. Non è distante dalla città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350113,
					"content": "E per quanto riguarda ciò che accade dentro la città... Sango ha chiesto in segreto ad Amano e al signor Andou di aiutarci in questa operazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350114,
					"content": "Ha anche promesso che il merito per la risoluzione di questo caso andrà tutto a loro, in modo da incentivarli a lavorare con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350115,
					"content": "Lasciamo i piani a lei. Noi limitiamoci a mantenere la nostra \"corrispondenza\" con quei Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350116,
					"content": "Ho anche segnato dove si trovano sulla tua mappa. Forza, andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350107,
					"content": "Ingannare il nostro colpevole?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "Esatto. Dobbiamo continuare a fargli credere che il nostro bersaglio siano i Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350109,
					"content": "In questo modo, Sango avrà più tempo per portare a termine il suo piano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350110,
					"content": "*ridacchia*... Non che quei Cacciatori di tesori abbiano comunque buone intenzioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350111,
					"content": "Tanto vale chiedere il loro \"aiuto\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2203502,
			"completionStepIds": [
				2203508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
