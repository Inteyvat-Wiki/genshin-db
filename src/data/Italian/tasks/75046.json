				},
				{
					"id": 750460413,
					"content": "Cucciolotti miei... Prometto che non sarò mai più così severo con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460414
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460414,
					"content": "Sono di nuovo tutti qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460415
					]
				},
				{
					"id": 750460415,
					"content": "Li hai riportati indietro tu? Non potrò mai ringraziarti abbastanza. Ecco, prendi la ricompensa da questi bauli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460416
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460416,
					"content": "Andrò a trovarli tra un secondo. Oh, piccoli Saurici, i miei adorati piccoli Saurici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460417
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460417,
					"content": "Ora posso tornare a concentrarmi sul mio lavoro da allenatore. Oh, a proposito... Se ti interessa partecipare alla Sfida del guerriero, vieni pure da me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
