						750460806
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460806,
					"content": "Sono ancora piccoli! Che succederebbe se venissero presi di mira dagli Hilichurl...? O se si perdessero...? O se rimanessero intrappolati da qualche parte...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460807
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460807,
					"content": "Saresti così gentile da dirmi se per caso hai visto i miei piccoli Tatankasauri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460808
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460808,
					"content": "Puoi descrivermeli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460809
					]
				},
				{
					"id": 750460809,
					"content": "Ho allevato la loro mamma. È come una figlia per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460810
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460810,
					"content": "È uno degli esemplari di Saurico più stupefacenti della Comunità dell'Abbondanza. Ha persino vinto il primo premio alla gara di bellezza regionale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460811
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460811,
					"content": "Quelle otto canaglie hanno tutte ereditato il bell'aspetto della madre: pelle rosa pallido e una spennellata di viola su quelle loro simmetricissime corna a ventaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460812
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460812,
					"content": "Se li vedi, potresti riaccompagnarli da me, per favore? Conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460813
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460813,
					"content": "Cucciolotti miei... Prometto che non sarò mai più così severo con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460814
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460814,
					"content": "Ne ho trovato qualcuno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460815
					]
				},
				{
					"id": 750460815,
					"content": "Grazie, molto gentile. Siano ringraziate le Wayob i piccoli stanno bene, ero così in ansia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460816
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460816,
					"content": "Ne manca ancora qualcuno. *sospira* Ti sarei molto grato se potessi dare un'altra occhiata qui attorno. Se li vedi, ti prego, riportali da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		}
	]
}