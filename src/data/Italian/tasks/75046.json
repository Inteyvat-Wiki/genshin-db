			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Urubamba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "Ehilàààààà... Tornate qui, piccoletti! Piccoliiiniii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460102,
					"content": "Ciao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "Ehiiiiii... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460104,
					"content": "Mi sento malissimo. Triste da morire... Come posso... rimediare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460105,
					"content": "Uff, sono andato un attimo a comprare del fieno e ora non ho idea di dove siano scappati gli altri otto cuccioli di Tatankasauro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460106,
					"content": "Sono ancora piccoli! Che succederebbe se venissero presi di mira dagli Hilichurl...? O se si perdessero...? O se rimanessero intrappolati da qualche parte...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460107,
					"content": "Saresti così gentile da dirmi se per caso hai visto i miei piccoli Tatankasauri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460108,
					"content": "Puoi descrivermeli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "Ho allevato la loro mamma. È come una figlia per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460110,
					"content": "È uno degli esemplari di Saurico più stupefacenti della Comunità dell'Abbondanza. Ha persino vinto il primo premio alla gara di bellezza regionale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460111,
					"content": "Quelle otto canaglie hanno tutte ereditato il bell'aspetto della madre: pelle rosa pallido e una spennellata di viola su quelle loro simmetricissime corna a ventaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460112,
					"content": "Se li vedi, potresti riaccompagnarli da me, per favore? Conto su di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460113,
					"content": "Cucciolotti miei... Prometto che non sarò mai più così severo con voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460118,
					"content": "Terrò gli occhi aperti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "Grazie, sei molto gentile. Possa tu raggiungere un nuovo record alla panca piana e portare a termine tutte le tue serie di flessioni senza neanche un crampo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
