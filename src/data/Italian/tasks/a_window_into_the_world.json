					}
				]
			},
			"dialogs": [
				{
					"id": 761410101,
					"content": "#{F#Bentornate}{M#Bentornati}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410102,
					"content": "Ma non è ancora il momento per un lungo, emotivo e commovente addio... Dopotutto, non avete ancora terminato il tour del mio piccolo rifugio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410103,
					"content": "#Ma Paimon potrebbe giurare che siamo già {F#state}{M#stati} in tutte le stanze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410104,
					"content": "Beh, non ho mai detto che non ci fossero stanze segrete nascoste, o sbaglio? A noi praticanti della magia piace avere delle piccole stravaganze... Ormai dovresti esserci abituata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410105,
					"content": "Da questa parte, prego.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614102",
							"2"
						],
						"stepId": 7614102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							17.908,
							6.364,
							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "Essendo uno dei punti di osservazione fissi per i cambiamenti del mondo, mi occorre che abbia una visibilità eccellente. Proprio come uno scultore ha bisogno di uno scalpello o uno scrittore di penna e inchiostro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410202,
					"content": "Le mie capacità in questi due campi artistici saranno anche discutibili, ma quando si tratta del mio lavoro principale, prendo le cose con la massima serietà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410203,
					"content": "Negli ultimi tempi, il \"fato\" di Teyvat è stato scosso sempre più di frequente. Sono sicura che l'hai percepito anche tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410204,
					"content": "A volte non posso fare a meno di pensare che, se avessi ancora la forma, il potere e le abilità che possedevo un tempo, potrei fare molto di più di quanto non riesca a fare adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410205,
					"content": "Ma tendo a scacciare subito questi pensieri. Se le cose fossero come prima, avrei molte più restrizioni imposte dal cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410206,
					"content": "Il pensiero di avere così tante cose di cui non posso nemmeno parlare lo fa sembrare un compromesso terribile. Insomma, come posso raccontare delle storie senza la libertà di dire ciò che voglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410207,
					"content": "Ecco perché non mi sono mai pentita del prezzo che ho pagato, né di nessuna delle scelte che ho fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410208,
					"content": "Volevo diventare umana, vivere come una persona comune... Ma una vita simile è un lusso: non posso dimenticare di essere un angelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410209,
					"content": "Anche se fossi costretta a rimanere in silenzio, come angelo continuerei a compiere il mio dovere: difendere la civiltà, difendere la vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410210,
					"content": "Oh, cielo, ho ricominciato a parlare di cose troppo serie? Forse è per via del luogo in cui ci troviamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410211,
					"content": "In realtà, sono abbastanza soddisfatta del mio lato angelico. Si potrebbe persino dire che ne vado fiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410212,
					"content": "E fai bene! Non intervieni spesso, ma quando lo fai, sappiamo tutti di essere in buone mani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410213,
					"content": "Hai tutte le ragioni per esserne fiera.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "Lo credete davvero? Eheh, se mi vedete come qualcuno su cui contare, allora di certo sto facendo un ottimo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410215,
					"content": "Oh, si è fatto tardi. Ecco, prendete le mie benedizioni e proseguite la vostra avventura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410216,
					"content": "Non temete mai di smarrire la via, e non dimenticate che c'è un angelo a vegliare su di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
