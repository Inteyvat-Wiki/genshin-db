			"dialogs": [
				{
					"id": 711170401,
					"content": "Oh, questa stele di pietra sembra dire che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170402,
					"content": "Con il lancio della carne cruda nel fiume, possiamo anche evocare vecchi amici che non vediamo da tanto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170403,
						711170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170403,
					"content": "Un attimo, sai leggere quelle iscrizioni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170404
					]
				},
				{
					"id": 711170404,
					"content": "Ehi, non sottovalutare Paimon... Ha solo tentato di decifrare quello che non si capisce, prendendo come riferimento quello che si capisce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170405,
					"content": "Guarda... Paimon capisce solo le ultime due righe, per cui è impossibile che abbia torto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170408,
					"content": "Va bene, buttiamoci dentro questa carne cruda. Forse davvero si paleserà un'Adepta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711170406,
					"content": "Oh, riguarda probabilmente il lancio del cibo in memoria di un amico...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711170407
					]
				},
				{
					"id": 711170407,
					"content": "Davvero?... Beh, Paimon pensa che anche la sua interpretazione sia corretta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711170408
					],
					"speakerTitle": "Paimon"
				}
			]
