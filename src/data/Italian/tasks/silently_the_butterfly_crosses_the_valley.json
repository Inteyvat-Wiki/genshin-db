				]
			},
			"dialogs": [
				{
					"id": 711150401,
					"content": "Uh... Eh? Chi osa disturbare il mio riposo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150402,
					"content": "Eh?!? C-Chi va là?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150403,
					"content": "Argh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150404,
					"content": "Waaaah!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150405,
					"content": "Ahahahahah! Sì, esatto! È normale che abbiate tema di me! Se non fossi rimasto confinato in questa pietra, vi avrei già divorato in un sol boccone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150406,
					"content": "Cosa...? Ah! Quindi sei solo una statua parlante... Paimon credeva che fossi una specie di mostro spaventoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150407,
					"content": "Umpf! Cosa intendi per \"solo una statua parlante\"?! Un simile accadimento non è già di per sé spaventevole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150408,
					"content": "Beh, il fatto è che di statue come te ne abbiamo già viste a iosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150409,
					"content": "C-Che cosa?!? *sospira* E va bene. Sembra che riuscire a spaventarvi sia fuori questione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150410,
					"content": "E perché vorresti farlo?! Cavoli, sei solo una statua di pietra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150411,
					"content": "Umpf! Sarò anche \"solo una statua di pietra\", ma vi trovate pur sempre nella dimora della Signora delle erbe! Quando ella era ancora con noi, non gradiva affatto che degli estranei ne turbassero la quiete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150412,
					"content": "Ed è per questo che io sono qui, per spaventare e scacciare i seccatori! E continuerò a farlo anche in sua assenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150413,
					"content": "Detto questo, la vostra presenza è diversa da quella dei comuni mortali, e considerato che non sono in grado di spaventarvi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150414,
					"content": "Vi dispiacerebbe se vi chiedessi un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150415,
					"content": "Eh? Possiamo fare qualcosa per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150416,
					"content": "Ahem! Guardate queste vivaci farfalle! Da quando la nostra signora è partita, queste piccole creature si sono sparpagliate dappertutto e svolazzano in giro indisturbate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150417,
					"content": "Shhh... Non fiatare, ne hai una sulla testa! Aspetta, ti aiutiamo a prenderla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
