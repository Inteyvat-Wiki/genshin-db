			"dialogs": [
				{
					"id": 711151201,
					"content": "Cavoli, è cambiato completamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151202,
					"content": "#La Signora delle erbe ha affidato a me la cura dell'albero, non potevo sopportare di vederlo in quelle condizioni! Grazie di cuore, gentili {F#umane}{M#umani}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151203
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711151203,
					"content": "Ma se non ti ricordavi nemmeno la formula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151204,
					"content": "Ah, dettagli, dettagli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151205
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711151205,
					"content": "Oh! Se vi interessa, posso confidarvi un segreto! Se reciderete un ramo e lo metterete nella giara rotta al di fuori della dimora, il portale di pietra si aprirà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effigie spensierata"
				}
			]
		},
