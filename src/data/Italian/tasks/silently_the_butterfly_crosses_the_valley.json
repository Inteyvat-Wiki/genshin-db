					{
						"sceneId": 3,
						"position": [
							1565.445,
							176.293,
							1792.852
						],
						"pointId": 310100247
					}
				]
			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "Fiuuu... Sì, esattamente ciò che intendevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150502,
					"content": "Queste farfalle colorate un tempo adornavano la porta della dimora della Signora delle erbe, ma in seguito il meccanismo è stato distrutto. In origine... le farfalle e la giara medicinale servivano a nutrire l'albero adeptico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150503,
					"content": "Albero adeptico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150504,
					"content": "Eheh, proprio così! All'epoca, tale albero venne piantato personalmente dalla Signora delle erbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150505,
					"content": "Ora sarà anche appassito, ma la Signora delle erbe disse che, finché le farfalle non si fossero allontanate, l'albero sarebbe potuto rinascere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150506,
					"content": "*sospira* Ella ci lasciò quando non ebbe più abbastanza potere per sostenere la sua forma umana. Chissà dove si trova, in questo momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150507,
					"content": "\"Quando le vivaci farfalle si riuniranno nella giara, l'albero avvizzito potrà sorgere a nuova vita...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "Già, proprio così! Finché... Un momento, come fate a saperlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150509,
					"content": "#Lasciamo perdere. Comunque, questo è quanto! Se quelle farfalle tornano nella giara, potremo dare nutrimento all'albero avvizzito! Affido a voi questo compito, gentili {F#umane}{M#umani}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effigie spensierata"
				}
			]
		},
