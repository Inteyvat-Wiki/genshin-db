				]
			},
			"dialogs": [
				{
					"id": 711151101,
					"content": "Ehi! Sei un bugiardo! Abbiamo rimesso tutte le farfalle nella giara, ma l'albero adeptico a Paimon sembra tale e quale a prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151102,
					"content": "#Mmh...? Chi osa disturbare il mio... Ah, siete voi, gentili {F#umane}{M#umani}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711151103,
					"content": "#Ooh! Non immaginavo che sareste {F#riuscite}{M#riusciti} davvero a ritrovare tutte le farfalle colorate! L'avevo detto tanto per dire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711151104,
					"content": "No, cioè... Ho percepito anche le energie adeptiche! Ora dobbiamo solo recitare la formula che la Signora delle erbe ci ha lasciato, dopodiché potremo infondere nuova linfa nell'albero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711151105,
					"content": "Un momento... Com'era quella formula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711151106,
					"content": "\"...Nato in inverno, fiorisce e appassisce col passare del tempo. Ma io agogno alla primavera, quando rinasce la beltà...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711151107,
					"content": "Le farfalle volteggiano... volteggiano... Ah, non mi ricordo cosa viene dopo, ma alla fine ogni cosa rinasce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effigie spensierata"
				}
			]
		},
