			"dialogs": [
				{
					"id": 711150601,
					"content": "Fiuuu... Sì, esattamente ciò che intendevo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150602,
					"content": "Queste farfalle colorate un tempo adornavano la porta della dimora della Signora delle erbe, ma in seguito il meccanismo è stato distrutto. In origine... le farfalle e la giara medicinale servivano a nutrire l'albero adeptico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150603,
					"content": "Albero adeptico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150604,
					"content": "Eheh, proprio così! All'epoca, tale albero venne piantato personalmente dalla Signora delle erbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150605,
					"content": "Ora sarà anche appassito, ma la Signora delle erbe disse che, finché le farfalle non si fossero allontanate, l'albero sarebbe potuto rinascere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150606,
					"content": "*sospira* Ella ci lasciò quando non ebbe più abbastanza potere per sostenere la sua forma umana. Chissà dove si trova, in questo momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150607,
					"content": "Quindi, cosa vuoi che faccia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "Ah, domando scusa. Mi sono lasciato trasportare dai ricordi della mia signora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150609,
					"content": "#Ahem! Ascoltate attentamente, {F#umane}{M#umani}! Se quelle farfalle tornano nella giara, potremo dare nutrimento all'albero avvizzito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150610,
					"content": "Eheh, si tratta di un meccanismo adeptico progettato dalla Signora delle erbe. Davvero notevole, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150611,
					"content": "Fammi provare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "#Certo, fa' pure. Affido a voi questo compito, gentili {F#umane}{M#umani}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150613,
					"content": "Perché proprio delle farfalle colorate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "Eh? Sì, beh, in effetti... Forse è perché alla Signora delle erbe piacevano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "Effigie spensierata"
				},
				{
					"id": 711150615,
					"content": "#Ehm... Comunque, affido a voi il compito di rimetterle all'interno della giara, gentili {F#umane}{M#umani}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effigie spensierata"
				}
			]
		},
		{
