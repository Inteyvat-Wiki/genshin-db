				{
					"id": 718300602,
					"content": "Ci vorrà ancora un po' di tempo per rimettere in sesto il tempio, quindi mi tratterrò qui ancora per un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300603
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300603,
					"content": "Semmai avessi un po' di tempo libero, passa pure a vedere come vanno le cose.",
					"roleType": "TALK_ROLE_NPC",
