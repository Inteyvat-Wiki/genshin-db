			"dialogs": [
				{
					"id": 718300701,
					"content": "Ehi, ciao. Hai trovato dei Cacciatori di tesori in giro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300702,
					"content": "Ah, quindi se ne sono andati. Molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300703,
					"content": "C'è qualcos'altro che posso fare per aiutarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "Ahahah. Ti ringrazio della gentilezza, ma mi hai già aiutato molto, non vorrei approfittare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300705,
					"content": "Se ti va, però, potresti aiutarmi a recuperare un po' di <color=#00E1FFFF>Legno sabbioso</color>. Consideralo un tuo contributo ufficiale alla ricostruzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300706,
					"content": "Dopotutto, si tratta di un'opera buona. Partecipare personalmente potrebbe portarti fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300707,
					"content": "Vado subito a prenderlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "Ahah, molto bene. Porta pure qui da me tutto il <color=#00E1FFFF>Legno sabbioso</color> che trovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300709,
					"content": "Le altre persone hanno donato qualcosa per la ricostruzione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "Mmmh, non molte, a dire il vero. Siamo in un luogo molto isolato, quindi gran parte della gente ignora totalmente l'esistenza del tempio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300711,
					"content": "Inoltre, sospetto che poche persone ricordino lo Yaksha noto come Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300712,
					"content": "Ma ora basta con le chiacchiere. Porta pure qui da me tutto il <color=#00E1FFFF>Legno sabbioso</color> che trovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
