			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "Sta diventando un progetto bello impegnativo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300202,
					"content": "Stai proprio ricostruendo tutto da zero, eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "Oh, sei tu. Non ti avevo forse detto che adesso sono un cittadino onesto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300204,
					"content": "Tuttavia, devo ammettere che si tratta di un progetto molto più imponente di quanto pensassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300205,
					"content": "Quando ho detto all'architetto coinvolto nei lavori che si trattava di un tempio degli Yaksha, si è subito messo all'opera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300206,
					"content": "Non solo ha tirato fuori una marea di piani di progettazione, mi ha pure trascinato ad acquistare i materiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300207,
					"content": "Sono sicuro che se avesse vent'anni in meno, insisterebbe per fare direttamente lui i lavori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300208,
					"content": "Finora non ti sei mai ritrovato in pericolo, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "In pericolo? Ah, intendi attaccato da mostri e Cacciatori di tesori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300212,
					"content": "Non devi preoccuparti. Quando al Ministero degli Affari Civili hanno saputo del mio piano di rimettere in sesto il tempio degli Yaksha, hanno inviato alcuni Milleliti a proteggermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300213,
					"content": "Ormai hanno praticamente messo in fuga tutti i mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300214,
					"content": "Per quanto riguarda i Cacciatori di tesori, invece, sembra che la presenza dei Milleliti li tenga buoni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300215,
					"content": "Tuttavia, l'entità dei lavori necessari a rimettere in sesto il tempio è ben superiore a quanto avessi stimato. Abbiamo realizzato di non aver predisposto materiali a sufficienza, e abbiamo dovuto ordinare altri rifornimenti dalla città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300216,
					"content": "Non credo che i Cacciatori di tesori si azzarderebbero ad attaccarci qui dove ci sono i lavori, ma potrebbero tenderci un'imboscata lungo il tragitto dei rifornimenti per rubare i materiali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300217,
					"content": "I Milleliti non hanno problemi a proteggere il tempio, ma se i Cacciatori di tesori dovessero assalire chi consegna i rifornimenti, non riuscirebbero mai a intervenire in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300218,
					"content": "Posso chiederti un favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300219,
					"content": "So che sei molto abile e che i Cacciatori di tesori non avrebbero alcuna possibilità contro di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300220,
					"content": "Ti andrebbe di dargli una bella lezione e dissuaderli dall'ostacolare il nostro lavoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300221,
					"content": "Lo farò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Grazie! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300223,
					"content": "Perché non chiedi il favore ai Milleliti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "Stanno già sorvegliando il tempio giorno e notte. Non me la sento di sobbarcarli ulteriormente di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300225,
					"content": "#Ti lascio al tuo incarico, allora, viaggiat{M#ore}{F#rice}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300210,
					"content": "Se ricordo bene, questa zona non è molto sicura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "Intendi dire che qui intorno è pieno di mostri e Cacciatori di tesori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
		{
