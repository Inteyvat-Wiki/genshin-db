			"trigger": {
				"objectNames": [
					"Capo dei Cacciatori di tesori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "B-Basta, per favore! Abbiamo perso! Ti prego, risparmiaci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300402,
					"content": "Prendete la vostra roba e andatevene!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "S-Sì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300405,
					"content": "P-Però... posso chiedervi cosa vi abbiamo fatto di male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300406,
					"content": "Avete per caso trovato dei tesori da queste parti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300407,
					"content": "Stiamo solo ricostruendo un tempio nelle vicinanze.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "R-Ricostruendo un tempio? Qui tra le montagne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300409,
					"content": "Quindi qui intorno c'è un tempio in onore di un Adeptus?!? Un momento, non è che si tratta di quella vecchia casa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300410,
					"content": "Capo, effettivamente avevamo notato la statua di un uccello quando ci eravamo fermati tempo addietro. Mi sa che era...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Tirapiedi dei Cacciatori di tesori"
				},
				{
					"id": 718300411,
					"content": "Pervases, uno degli Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "Eh?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300413,
					"content": "C-Capo! A-Abbiamo davvero offeso un Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Tirapiedi dei Cacciatori di tesori"
				},
				{
					"id": 718300414,
					"content": "S-Smettila di dire sciocchezze! Non potevamo saperlo, quindi non conta! L'abbiamo fatto per ignoranza! Non credo che l'Adeptus ci giudicherà... Dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300415,
					"content": "In ogni caso, grazie per averci informato sulla ricostruzione del tempio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300416,
					"content": "Chiediamo scusa per la nostra ignoranza e scortesia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300417,
					"content": "Torneremo indietro e diremo agli altri di stare alla larga dal tempio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300418,
					"content": "Capo, non dovremmo andare al tempio e accendere un paio di bastoncini d'incenso per chiedere perdono all'Adeptus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Tirapiedi dei Cacciatori di tesori"
				},
				{
					"id": 718300419,
					"content": "Ehi, ehi, da quando in qua sei diventato un chiacchierone? Forza, andiamocene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Capo dei Cacciatori di tesori"
				},
				{
					"id": 718300403,
					"content": "Non fatevi più vedere da queste parti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
