			"dialogs": [
				{
					"id": 718300301,
					"content": "Ehi, ehi! Fai attenzione con quell'affare! Non danneggiare la statua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300302,
					"content": "*sospira* A quanto pare, i lavori dureranno per un bel pezzo...",
					"roleType": "TALK_ROLE_NPC",
