			"dialogs": [
				{
					"id": 750220703,
					"content": "Lo Yumkasauro divora il cibo davanti a sé in un lampo.\\nPraticamente non riesci a vedere come ha fatto, da quanto è stato veloce a inghiottirlo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "Guarda! Neanche lo mastica il cibo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220305,
					"content": "Paimon, qualcuno ti fa concorrenza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "Sembra... che una porzione non sia sufficiente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "Ehi, cosa vorresti dire? Paimon ha un palato raffinato, è molto esigente riguardo al cibo e non ingoierebbe mai la qualunque così... Come può uno godersi davvero il cibo se lo ingurgita senza neanche masticarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220308,
					"content": "#S-Sì! Paimon non l'aveva notato prima, ma questo piccolino è un vero \"Megasnackasauro\"... Per fortuna {REALNAME[ID(2)|SHOWHOST(true)]} non mangia tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220309,
					"content": "Forse il poverino stava semplicemente morendo di fame! Piccolino... Diamogli un'altra porzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220310,
					"content": "Aruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#Anche {REALNAME[ID(2)|SHOWHOST(true)]} vuole mangiare? Diamo da mangiare anche a lui, e poi ti prepariamo qualcosa per cui ti leccherai i baffi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220312,
					"content": "Il Saurico affamato mangia tutto quello che gli appoggi davanti in un solo boccone.\\nSbatti le palpebre, come stessi rivivendo un déjà-vu...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "Ok, ora dovrebbe avere la pancia piena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220314,
					"content": "Ehi, un attimo, perché ti stai sedendo di nuovo? Due porzioni non bastano?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220315,
					"content": "Wow, e poi se ne va a dormire proprio davanti alla grotta dopo aver mangiato? A quanto pare non ha la minima intenzione di togliersi dai piedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220316,
					"content": "#Cosa facciamo, {NICKNAME}? Paimon non capisce... Se vuoi fare un pisolino dopo aver mangiato, almeno non bloccare la strada agli altri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220317,
					"content": "Non credo che abbia mai accettato di togliersi di mezzo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "Mi sa proprio che ci ha fregato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "Grrr! E ha mangiato tanto di quel cibo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220320,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#Neanche {REALNAME[ID(2)|SHOWHOST(true)]} riesce a tollerare una vista del genere! Forza, {NICKNAME}, dobbiamo farlo svegliare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
