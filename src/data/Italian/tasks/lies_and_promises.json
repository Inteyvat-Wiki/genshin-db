			},
			"dialogs": [
				{
					"id": 750220801,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "Eheh, ben fatto! Ora vediamo che tesoro si nasconde nel baule!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220803,
					"content": "Eh? Non c'è niente! Solo un biglietto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220804,
					"content": "#Oh, quindi la persona che ha lasciato il biglietto era il padrone del Saurico? Quindi non siamo {F#state ingannate}{M#stati ingannati} dall'animale, ma dall'umano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220805,
					"content": "Che irresponsabile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "Sì! Anche se era molto malato, come ha potuto lasciare qui il suo Yumkasauro?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220807,
					"content": "E voleva perfino sfruttare l'avidità delle persone per... No, anzi, voleva sfruttare l'empatia delle persone nei confronti del suo compagno Saurico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220810,
					"content": "*sospira* Però non possiamo lasciarlo qui a ingannare la gente per ottenere da mangiare. Andiamo a cercare il capotribù dei Discendenti delle Vette e riferiamogli la situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220811,
					"content": "Spieghi la situazione a Wayna, il capo dei Discendenti delle Vette, e lo porti sul posto.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "#Oh, cielo, quando siete {F#venute}{M#venuti} da me, me lo sentivo che si trattava di questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220813,
					"content": "Chi avrebbe mai pensato che fosse stato quel delinquente ad abbandonare questa creatura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220814,
					"content": "Quale delinquente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "Rrroar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "Uno della tribù che commise uno sbaglio e, per paura di essere punito, se ne andò di sua spontanea volontà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220817,
					"content": "Non c'è motivo di dirvi il suo nome. Forse lui stesso era ben consapevole di ciò che aveva fatto. Vedete? Non ha nemmeno firmato alla fine della sua lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220818,
					"content": "Però il Saurico lo ha scelto come compagno...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "No, non possiamo dire che lo abbia \"scelto\". I Saurici sono creature semplici, non riescono a distinguere facilmente tra il bene e il male. La maggior parte delle volte seguono semplicemente le proprie emozioni e si fidano dei propri compagni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220820,
					"content": "...Come sospettavo, nel profondo è rimasto lo stesso. Qualunque minima astuzia la usa per ingannare gli altri, persino il suo amico Saurico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220821,
					"content": "Invieremo delle persone a nutrire regolarmente questo Yumkasauro. Dopotutto, è un figlio della tribù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220822,
					"content": "Per quanto riguarda quel vigliacco... *sospira* È un finale davvero tragico, ma mi rifiuto di provare compassione per lui. La gente dev'essere responsabile delle proprie azioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220808,
					"content": "Quindi, coloro che mangiano troppo verranno inevitabilmente abbandonati dai loro amici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "Ehi! Non ci scherzare neanche! Inoltre, in tutta questa storia il Saurico è la vittima, forse sta solo aspettando il ritorno del suo padrone ed è per questo che si rifiuta di muoversi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				}
			]
		},
