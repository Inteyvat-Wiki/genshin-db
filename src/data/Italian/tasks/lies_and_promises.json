				},
				{
					"id": 750221006,
					"content": "#Boh, Paimon non ha capito niente! {REALNAME[ID(2)|SHOWHOST(true)]}, riesci a tradurci quello che sta tentando di dire questo Yumkasauro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
