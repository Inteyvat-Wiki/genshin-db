					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220608
					],
					"speakerTitle": "Yumkasauro strano"
				},
				{
					"id": 750220608,
					"content": "Wow, hai proprio fame, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220609,
					"content": "Un Saurico qui tutto solo e senza ombra del suo padrone... Probabilmente non riesce nemmeno a procurarsi da mangiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220610,
					"content": "#Dai, {NICKNAME}, aiutiamolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220611,
					"content": "Quando sarà sazio e si allontanerà, il tesoro sarà tutto nostro! Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220612,
					"content": "Ma cosa gli diamo da mangiare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "Lascia che Paimon ci pensi su! I Saurici qui mangiano un po' di tutto, e Paimon non è sicura di cosa mangino gli Yumkasauri... A giudicare dal suo colore, Paimon direbbe che mangia foglie, erba e altri vegetali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220614,
					"content": "Troviamone un po' e vediamo se gli piace! Quando uno ha fame tende a non fare lo schizzinoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
