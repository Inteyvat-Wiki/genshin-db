			"trigger": {
				"objectNames": [
					"Linyang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726640101,
					"content": "Mmh... Devo posizionare un'altra serie di bauli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640102,
					"content": "Qualcuno ha parlato di bauli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "#Eh?! Oh... Sei tu, viaggiat{F#rice}{M#ore}! Sei qui per partecipare al Festival della luna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640104,
					"content": "Puoi dirlo forte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "#Sei arrivat{M#o}{F#a} giusto in tempo, allora! La Gilda degli avventurieri sta organizzando un evento per celebrare il festival.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640106,
					"content": "Vorresti saperne di più?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640107,
					"content": "Di che tipo di attività stiamo parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "Durante il Festival della luna, la Gilda ha piazzato dei talismani lunari in vari posti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640111,
					"content": "Chi riesce a trovare questi talismani può riportarceli e ottenere in cambio diverse ricompense.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640112,
					"content": "Abbiamo anche mobilitato un gruppo d'avventurieri per piazzare molti bauli speciali in giro fuori dalla città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640113,
					"content": "Questi bauli speciali sono pieni di prelibatezze che abbiamo preparato proprio per quest'occasione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640114,
					"content": "Oltre a queste due attività, abbiamo anche qualche sfida più tosta per gli avventurieri d'élite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640115,
					"content": "Nello specifico... Beh, si tratta di invadere una serie di accampamenti di mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640116,
					"content": "E cosa c'entra questo con il festival?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "Ahah... Ahahah... Voglio dire, ehm, non c'è bisogno di metterla così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640119,
					"content": "Se sconfiggi i mostri, riceverai dei premi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640120,
					"content": "Che differenza c'è con gli incarichi normali? Dai...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "...Per favore, aiutaci! La maggior parte dei nostri avventurieri è andata a godersi il festival, e molti incarichi se ne stanno lì, senza nessuno che se ne occupi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640122,
					"content": "Dacci una mano! Con le tue abilità, sarà un gioco da ragazzi, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640123,
					"content": "Ok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "#C-Certamente, riceverai una bella ricompensa, viaggiat{F#rice}{M#ore}, non preoccuparti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640126,
					"content": "Resterò qui per tutta la durata del Festival della luna. Per qualsiasi domanda, non esitare a chiedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640127,
					"content": "#Contiamo su di te, viaggiat{F#rice}{M#ore}. Bene, allora... Buon festival!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640124,
					"content": "Meglio se prepari subito il pagamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "Ma non ha niente a che vedere con il Festival della luna!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "Oh, no, non i piatti del giorno di nuovo. Tutto tranne quelli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "No, no! Quest'attività è proprio da avventurieri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "Linyang"
				}
			]
		}
	]
}