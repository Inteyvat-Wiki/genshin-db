				"objectNames": [
					"Shitoki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722070101,
					"content": "Non è abbastanza... Non è abbastanza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070102,
					"content": "Il tesoro che mio fratello mi ha lasciato è in quelle conchiglie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070103,
					"content": "Ma, ahimè, sono state sparpagliate, sparpagliate dappertutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070104,
					"content": "È il tesoro di mio fratello. Non posso ancora andarmene, no, no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070105,
					"content": "Un tesoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "Lui provò ad attraversare il Mare di nebbia, e questo fece arrabbiare molto il prete. Il prete disse che lo spirito di mio fratello maggiore non sarebbe mai più potuto tornare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070108,
					"content": "Ma mio fratello ha detto che lì ci sono dei bei fiori e dei mari con delle perle. Papà porta una barca, lui e la nostra sorellina ci salutano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070109,
					"content": "Ha lasciato il suo tesoro qui, è uscito in mare, e non è più tornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070106,
					"content": "Forse ho già sentito questa storia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
		},
