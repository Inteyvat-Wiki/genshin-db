			"dialogs": [
				{
					"id": 722070301,
					"content": "Ah, capisco. Ecco dov'era il tesoro, allora! Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070302
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070302,
					"content": "Anche se non possiamo andare insieme nella terra dei sogni, mi trasformerò in granelli di luce e tornerò a cercarti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070303
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070303,
					"content": "Chissà se anche gli spiriti che vagano in terre straniere sognano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitoki"
