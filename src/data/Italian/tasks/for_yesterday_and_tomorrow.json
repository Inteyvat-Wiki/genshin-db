						],
						"pointId": 8198
					}
				]
			},
			"dialogs": [
				{
					"id": 741850101,
					"content": "#Este, siamo {F#tornate}{M#tornati}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850102,
					"content": "Oh, ma siete... Aspetta, no. Chi siete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850103,
					"content": "#Eh? Non puoi esserti già dimenticato di noi! Siamo {NICKNAME} e Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} e Paimon... Ricordo di aver sentito questi nomi, ma credevo fosse in un sogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850105,
					"content": "Uhm... Ma eri sicuramente sveglio, Este! Inoltre, mentre eravamo là sotto, non abbiamo visto anche...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850106,
					"content": "*sospira* Ho sognato che tutti in città erano pietrificati, trasformati in statue... Mi sono sentito indifeso e solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850107,
					"content": "#Finché, alla fine, due {F#coraggiose eroine}{M#coraggiosi eroi} non sono {F#arrivate}{M#arrivati} e hanno deciso di salvare tutti... Davvero non era un sogno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850108,
					"content": "Forse sì, forse no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "Già. Dopotutto, ora sono tutti tornati normali, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850111,
					"content": "Ma sembra che tutti abbiano fatto sogni molto strani: cosa è successo? Abbiamo subìto un'ipnosi di massa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850112,
					"content": "Ci vorrebbe un'eternità per spiegarlo come si deve... Per ora lascia perdere l'ipnosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850113,
					"content": "Eh? A proposito di ipnosi, avete portato anche un gatto! Che sguardo intelligente che ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850114,
					"content": "Ed è ancora più intelligente di quanto sembri, credimi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "E poi è il nostro compagno di viaggio! Purtroppo non possiamo portarlo con noi nella prossima tappa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850118,
					"content": "Beh, ma che bella coincidenza! Si dà il caso che il nostro Club abbia a disposizione una cuccia per gatti. È rimasta vuota da quando quel ricercatore sull'ipnosi è andato in viaggio, portandosi il suo gatto appresso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850119,
					"content": "Se non vi dispiace, lasciatelo pure qui con noi. Ci prenderemo cura di lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850120,
					"content": "È una sensazione strana, ma mi sembra ci sia un legame tra di noi, come se c'entrasse il destino. Farò tutto il possibile perché venga trattato al meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850121,
					"content": "Il gattile si trova dall'altra parte dell'edificio. Prosegui in quella direzione e lo vedrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741850116,
					"content": "È il nostro compagno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "Vero, ma non possiamo comunque portarlo con noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850109,
					"content": "Non ha importanza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
