			},
			"dialogs": [
				{
					"id": 741850301,
					"content": "Ehi, questa sarà la tua casa d'ora in poi, Osse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850302,
					"content": "Miaaao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850303,
					"content": "Però è un po' strano... Cassiodor dovrebbe essersene già andato, no? E allora chi è Osse adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850304,
					"content": "Non sarà mica il gatto originale non posseduto da Cassiodor, o sarà forse il Monsieur Os con cui abbiamo condiviso tante avventure? A Paimon sta venendo un crampo al cervello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850305,
					"content": "Paimon, non sei proprio fatta per pensare a cose del genere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "Paimon non ci arriva proprio, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850309,
					"content": "Comunque, ora abbiamo trovato una nuova casa anche per Osse! Quando avremo tempo magari verremo a giocare con lui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850310,
					"content": "Miao miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850307,
					"content": "\"Osse\" è \"Osse\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "Certo, ha senso, anche se Paimon brancola comunque nel buio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
