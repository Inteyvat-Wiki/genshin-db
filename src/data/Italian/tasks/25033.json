			"dialogs": [
				{
					"id": 250330201,
					"content": "Incredibile! Sei veloce come Mayta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330202,
						250330203
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330202,
					"content": "Ho commesso qualche errore...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				},
				{
					"id": 250330204,
					"content": "Sei già fin troppo veloce. Io e Qica non possiamo reggere il confronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330205
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330205,
					"content": "*sospira* Dovremo allenarci un sacco, prima di poter competere con te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330206
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330206,
					"content": "Roar, roo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330207,
						250330208
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330207,
					"content": "Puoi farcela, Qica!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330209,
					"content": "Roar? Roar, roo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330210
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330210,
					"content": "Bravo, Qica. Ricordi cosa ha detto zio Yawar? Se continuiamo a lavorare sodo, diventeremo più forti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330211
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330211,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330212
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330212,
					"content": "Comunque sia, grazie mille per l'aiuto. Ecco, prendi questi frutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330213
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330213,
					"content": "Qica li ha appena colti... E, come ben sai, è più veloce di prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330214
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330214,
					"content": "Eheh, sicuramente è diventato così bravo perché aveva un ottimo modello da seguire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330215
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330215,
					"content": "Roar... Roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330216
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330216,
					"content": "D'accordo allora, torniamo indietro a cercare Mayta. Ormai avrà raggiunto la tribù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330208,
					"content": "Ho fiducia in voi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330203,
					"content": "Non è andato tutto liscio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				}
			]
		},
