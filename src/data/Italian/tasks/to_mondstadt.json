					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010501,
					"content": "Allora, che ne pensate? Ho soddisfatto le vostre aspettative?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010502,
						105010503
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010502,
					"content": "Le tue abilità di combattimento sono eccezionali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "Semplice routine per un'astrologa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010505,
					"content": "Le menzogne sono assolutamente inutili al cospetto dell'astrologia. Destino e verità sono scritti nelle stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010506,
					"content": "Anche se può volerci del tempo per scoprire i dettagli, riesco a comprendere al volo ogni situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010507,
					"content": "Ma per altre cose hai avuto qualche piccola difficoltà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010508,
					"content": "Questo perché le stelle di Teyvat possono mostrare soltanto i destini e le verità di questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010509,
					"content": "Tutto ciò che ti riguarda sembra avvolto da un velo di nebbia che nemmeno io riesco a squarciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010510,
					"content": "Ecco perché devo incontrare l'erede. Unendo le nostre conoscenze, potrei scoprire qualcosa sul tuo destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010511,
					"content": "Devo ammettere che non vedo l'ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "Sia come sia, non hai nulla da perdere da questo viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010514,
					"content": "Molto bene, mi sono riposata abbastanza. Rimettiamoci in viaggio per <color=#00E1FFFF>Mondstadt</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010515,
					"content": "*sospira* Se solo avessimo un carro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010516,
					"content": "Pensavo che non fossi stanca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010512,
					"content": "Non voglio illudermi troppo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "È stato davvero incredibile il modo in cui hai smascherato quei banditi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
			]
		},
