			"dialogs": [
				{
					"id": 105011101,
					"content": "E questa zuppa di germogli di bambù...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011102
					]
				},
				{
					"id": 105011102,
					"content": "Uno dei piatti preferiti dai nostri clienti abituali. Germogli di bambù, carne e prosciutto vengono cotti assieme fino a creare una zuppa molto saporita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011103
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011103,
					"content": "Mettetene qualche cucchiaiata in ogni ciotola di riso... e non riuscirete a smettere!",
