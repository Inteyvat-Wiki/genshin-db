			},
			"dialogs": [
				{
					"id": 105011201,
					"content": "Li ordino tutti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011202
					]
				},
				{
					"id": 105011202,
					"content": "T-Tutti? Siamo solo in tre... Anzi due persone e mezzo... Non pensi che sia troppo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011203,
					"content": "Non è così che si conta! E poi Paimon non ha ancora ordinato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011204,
					"content": "Pesce scoiattolo, pollo al peperoncino di Jueyun e Zuppa di gemme, prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011205,
					"content": "Certamente. C'è altro da ordinare, signorina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011206
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011206,
					"content": "I-Io... Potrei sapere qual è il totale dei piatti ordinati finora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011207,
					"content": "Uhm... circa 20.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011208
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011208,
					"content": "Allora... ehm... c-credo che prenderò solo dei tagliolini vegetariani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011209,
					"content": "Molto bene. Una ciotola di tagliolini vegetariani. Vi serviremo al più presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011210
					],
					"speakerTitle": "Yuhua"
				},
				{
					"id": 105011210,
					"content": "Paimon non ha potuto fare a meno di chiedersi una cosa da quando abbiamo iniziato a mangiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011211,
					"content": "Perché Mona ha ordinato un solo piatto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011212
					]
				},
				{
					"id": 105011212,
					"content": "Forse... perché non ha abbastanza soldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011213,
					"content": "Ehi, riesco a sentirvi! Ho detto che avrei offerto io. Come posso preoccuparmi di qualcosa di tanto triviale come il denaro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011214,
					"content": "La mente di un astrologo è concentrata sullo studio delle stelle. Se fossi distratta tanto facilmente da questioni così banali, il mio giudizio ne soffrirebbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011215,
					"content": "Senza contare che l'eccessiva autogratificazione derivante dai Mora è tanto volgare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011216,
					"content": "*stomaco che brontola*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011217,
					"content": "...quanto pericolosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011218,
					"content": "Quindi non mangiare i piatti che abbiamo ordinato fa parte dell'orgoglio di un astrologo? Paimon non capisce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011219,
					"content": "Ma a Paimon non sembra giusto che solo noi abbiamo mangiato e bevuto a sazietà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011220,
					"content": "Lascia che prepari qualcosa per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011221
					]
				},
				{
					"id": 105011221,
					"content": "Oh, sì, ci pensiamo noi! Dacci solo un minuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
