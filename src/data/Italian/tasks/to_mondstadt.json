			"dialogs": [
				{
					"id": 105011501,
					"content": "Q-Questo aroma è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011502,
						105011504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011502,
					"content": "Ecco qualcosa per accompagnare i tuoi tagliolini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011503
					]
				},
				{
					"id": 105011503,
					"content": "Non avrei mai pensato a qualcosa di così squisito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011506,
					"content": "#E va bene. Dato che {F#la mia discepola}{M#il mio discepolo} ha profuso così tanti sforzi, dovrò mio malgrado accettare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011507,
					"content": "...Aaah! È squisito! È la cosa più deliziosa che abbia mangiato ultimamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011508,
					"content": "Ah, cioè... volevo dire... *tossisce* Non immaginavo che avessi tanto talento. In qualità di tua maestra, la cosa mi rincuora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011509,
						105011510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011509,
					"content": "L'importante è che tu faccia un pasto completo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011511,
					"content": "La fama delle prelibatezze di Liyue è davvero meritata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011512,
					"content": "Immagino che alla fine non sia stato uno spreco totale di Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011513,
					"content": "Ah, come non detto. Ora che abbiamo mangiato e bevuto a sazietà, dovremmo rimetterci in marcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011514,
					"content": "Dirigendoci a nord, raggiungeremo la <color=#00E1FFFF>Porta di pietra</color>. Una volta oltrepassata, saremo all'interno dei confini di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011515,
					"content": "Quali reconditi misteri scopriremo? *ridacchia* Non vedo l'ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011510,
					"content": "Però a me sembra che tu lo stia anche apprezzando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011504,
					"content": "Ordine speciale in arrivo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011505
					]
				},
				{
					"id": 105011505,
					"content": "W-Wow! Ma è... incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011506
