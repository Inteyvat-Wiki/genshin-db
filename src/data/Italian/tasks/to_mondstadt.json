			"dialogs": [
				{
					"id": 105010301,
					"content": "Non dovete darvi tanto disturbo per me... Non ho bisogno urgente di mangiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010302,
					"content": "Ho solo un po' di fame... ma non è un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1050104,
			"completionStepIds": [
				1050107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050107",
							"2"
						],
						"stepId": 1050107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010401,
					"content": "Uff... È stato faticoso, ma eccoci finalmente a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010402,
					"content": "La nostra missione per sondare le magnifiche profondità della conoscenza è sicuramente ardua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010403,
					"content": "Paimon non è stanca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010404,
					"content": "Urgh... Beh, perché tu fluttui nell'aria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010405,
					"content": "Beh, a me non sembra che gli astrologi siano tutto questo granché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010406,
					"content": "Perché evidentemente nutri troppe fantasie poco realistiche sull'astrologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010407,
					"content": "Ehilà, anche voi vi state riposando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010408
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010408,
					"content": "Chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010409,
					"content": "Io e i miei fratelli siamo mercanti. Abbiamo appena concluso i nostri affari a Liyue e ci stiamo preparando a tornare a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010410
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010410,
					"content": "Avete l'aria stanca. Il carro che abbiamo noleggiato arriverà tra non molto. Che ne dite di un passaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010411,
						105010413
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010411,
					"content": "#In effetti sono un po' stanc{F#a}{M#o}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010412
					]
				},
				{
					"id": 105010413,
					"content": "Dobbiamo pagare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010414
					]
				},
				{
					"id": 105010412,
					"content": "Bene, allora andiamo. Potremo fare quattro chiacchiere durante il viaggio. Più siamo, meglio è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010414,
					"content": "Non ce n'è bisogno. Andiamo comunque nella stessa direzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010415,
					"content": "Non abbiamo bisogno di passaggi. E ora toglietevi di mezzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010416,
					"content": "Eh? Signorina... Qualcosa non va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010417
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010417,
					"content": "Ora puoi anche smettere di fingere, bandito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010418,
					"content": "Avvicinare persone sulla strada che sembrano vulnerabili, derubarle di tutti i loro averi una volta salite sul carro e poi portarle in chissà quale posto dimenticato dagli Archon... È questo che fate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010419,
					"content": "C-Che stai dicendo?! Eravamo venuti solo a scambiare quattro chiacchiere ed è così che ci ripaghi? Con accuse e insulti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010420
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010420,
					"content": "Se non volete un passaggio, bene! Squinternata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010421
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010421,
					"content": "D'accordo... Vuoi che ti elenchi gli oggetti rubati che hai addosso al momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010422,
					"content": "Se hai qualcosa da ridire, possiamo chiamare qualcuno che confermi ciò che ho detto... e la questione sarà risolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010423,
					"content": "Se perdo la scommessa, ti pagherò ventimila Mora; ma se vinco, tutti voi stasera cenerete nella prigione del Porto di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010424,
					"content": "Allora, che ne dici? Se siete davvero uomini d'affari, come hai detto, non avete nulla da temere, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010425,
					"content": "Ma... razza di...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010426,
					"content": "Ti sei spinta troppo oltre, mocciosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010427,
					"content": "Non so come tu l'abbia scoperto, ma se ci liberiamo di voi, nessun altro lo verrà a sapere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427,
						105010428
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010428,
					"content": "Attenta, Mona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010429,
					"content": "Non vi permetterò di toccarla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010430,
					"content": "Non ti preoccupare, sono solo un paio di banditi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010431
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010431,
					"content": "Prima hai detto che gli astrologi non sono questo granché... Beh, credo che questo sia il momento perfetto per mostrarvi cosa sa fare la vostra maestra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 1050105,
			"completionStepIds": [
				1050109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
