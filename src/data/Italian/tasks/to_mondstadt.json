			"trigger": {
				"objectNames": [
					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105010201,
					"content": "Salve, come posso aiutarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010202,
					"content": "Vorremmo usare la vostra cucina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010203,
					"content": "Una mia amica vorrebbe assaggiare un piatto speciale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "Oh, capisco. Va bene. Se avete tutti gli ingredienti necessari, usate pure la cucina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010206,
					"content": "Se posso chiedere: conosci bene l'arte culinaria, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010207,
					"content": "Ma certo! Se preparo qualcosa, è sempre delizioso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "Ahah, un vero talento! Avrei una piccola proposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010211,
					"content": "A giudicare dai tuoi abiti, non devi essere di queste parti. Ma dato che sei qui a Liyue, che ne dici di cimentarti con la cucina locale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010212,
					"content": "Ho la ricetta del granchio dorato, un classico della cucina di Yue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010213,
					"content": "Si tratta di polpa di granchio passata nella farina, fritta in immersione e poi in padella con zenzero e aglio. Quando lo impiatti, il granchio sembra come adagiato su un letto d'oro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010214,
					"content": "Granchio... dorato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010215,
					"content": "Sembra un tantino complicato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#Granchio dorato, {NICKNAME}! Granchio dorato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010218,
					"content": "E va bene... D'accordo... E granchio dorato sia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "Eheh, allora diamoci da fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010221,
					"content": "Con le tue doti culinarie, sarà una passeggiata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010219,
					"content": "Immagino che imparerò la ricetta anche per te...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "Imparare un piatto totalmente nuovo apposta per Mona mi pare un po'...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "Non esattamente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "Ahah, quanta modestia. Avrei una piccola proposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010204,
					"content": "La mia amica vorrebbe mangiare qualcosa preparato da me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
		{
