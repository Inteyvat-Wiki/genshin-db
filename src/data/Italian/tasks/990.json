				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 9901508,
					"content": "Come ti trovi qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901509
					]
				},
				{
					"id": 9901519,
					"content": "Ti andrebbe di fare due chiacchiere con me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901520
					]
				},
				{
					"id": 9901536,
					"content": "C'è qualcosa in particolare che ti piacerebbe fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "Oh, mi piace molto stare qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901510,
					"content": "Il paesaggio è completamente diverso da quello di Mondstadt. È davvero rigenerante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901511,
					"content": "E poi, qui posso cantare a squarciagola senza dovermi preoccupare di disturbare qualcuno! È il modo migliore per esercitarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901512,
					"content": "Non credo che qualcuno potrebbe mai considerare la tua dolce voce un disturbo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "Fantastico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901514,
					"content": "Sei molto gentile! Ma, ehm... Voglio assicurarmi di essere sempre rispettosa nei confronti degli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901515,
					"content": "In ogni caso, sono molto felice che tu mi abbia invitata qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901517,
					"content": "Già... Sono davvero felice che tu mi abbia invitata qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901518,
					"content": "Mi piacerebbe rimanere ancora un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901520,
					"content": "Oh, certamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901521,
					"content": "Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901522,
					"content": "Perché sorridi in questo modo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "Oh, mi sono appena resa conto che non parlo con qualcuno da molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901525,
					"content": "All'improvviso mi sento molto fortunata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901526,
					"content": "Sembri una persona facile da accontentare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "Il motivo è che metti sempre gli altri al primo posto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "Ehm... Sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901528,
					"content": "Beh, forse hai ragione... Ma non è necessariamente un difetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901529,
					"content": "Quanto più facile è per te ricevere gioia, tanta più energia avrai per condividerla con altre persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901531,
					"content": "Certo che metto sempre gli altri al primo posto, è il minimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901532,
					"content": "Ci sono sempre state tante persone a prendersi cura di me. Voglio solo fare tutto il possibile per ripagare la loro gentilezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901533,
					"content": "Sei davvero una persona meravigliosa come dicono.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "Ahh... Dai, mi stai inondando di complimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901535,
					"content": "Le critiche costruttive ci fanno migliorare, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901537,
					"content": "Oh, in questi giorni ho iniziato a lavorare a una nuova canzone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901538,
					"content": "Ma sto ancora mettendo a punto i dettagli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901539,
					"content": "Quando ripeto il ritornello, dovrei salire di mezzo tono? Sono indecisa... E credo che ci siano margini di miglioramento per quanto riguarda la coreografia, ma non ne sono sicura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901541,
					"content": "Puoi contare su di me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "Sarebbe un onore per me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "Se non fosse un problema, ti sarei davvero grata se potessi assistere alla mia esibizione e darmi qualche consiglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901543,
					"content": "Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901544,
					"content": "Ehm... Se l'esibizione non fosse perfetta, ti prego di non ridere di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901545,
					"content": "Ci ho pensato parecchie volte, ma mi ci è voluto un sacco di tempo per trovare il coraggio di esibirmi davanti a te a una distanza così ravvicinata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901547,
					"content": "Non preoccuparti, non riderò di te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
					]
				},
				{
					"id": 9901546,
					"content": "Se ridessi di me, mi nasconderei dalla vergogna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901547
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901549,
					"content": "Oh... Ok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901550
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901550,
					"content": "Beh, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901551
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901551,
					"content": "Che lo spettacolo abbia inizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
