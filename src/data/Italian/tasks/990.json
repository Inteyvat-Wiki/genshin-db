		{
			"id": 99015,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99007",
							"2"
						],
						"stepId": 99007,
						"stateName": "QUEST_STATE_UNFINISHED"
