					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "\"Nella luce dei cicli dei giorni che si alternano, è possibile vedere sul ponte la figura del faro diretta verso casa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 735020102,
					"content": "C-Cos'è questa roba...? Un rompicapo? O magari un proverbio, o...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020103,
					"content": "Cicli dei giorni che si alternano? Figura diretta verso casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020104,
					"content": "#Salve, viaggiat{F#rice}{M#ore}. Anche tu sei interessat{F#a}{M#o} al rompicapo di Drusus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020105,
					"content": "Davvero è un rompicapo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "È stato preparato da un ricercatore dell'Akademiya di nome Drusus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020108,
					"content": "Per quanto ne so, è ritenuto un eccentrico anche dai membri dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020109,
					"content": "Adora parlare di indovinelli con tutti, oltre a studiare codici cifrati di ogni genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020110,
					"content": "Ma alcuni dei suoi rompicapi sono davvero incomprensibili, quindi pochi decidono di provare a risolverli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020111,
					"content": "E così si è inventato questa storia del risolvere indovinelli per ottenere dei premi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020112,
					"content": "In breve, questo rompicapo nasconde in sé un indizio per trovare un tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020113,
					"content": "Basta raggiungere il posto giusto nel momento giusto con il metodo adeguato per ottenere una sostanziosa ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020114,
					"content": "Drusus ha detto anche che questi luoghi si trovano tutti entro i confini della Città di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020115,
					"content": "Ma, come puoi vedere, nessun avventuriere è riuscito nell'impresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020116,
					"content": "#Potresti provarci tu, se sei interessat{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020117,
					"content": "Ma, se vuoi il mio parere, credo sarebbe meglio dedicarsi a qualcosa di più produttivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamal"
				},
				{
					"id": 735020106,
					"content": "Conosci chi l'ha preparato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350203",
							"2"
						],
						"stepId": 7350203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "Non arriverà nessuno nemmeno oggi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020302,
					"content": "È questo l'\"ingresso principale del Tempio della conoscenza\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "Esatto! Proprio questo. A quanto pare hai risolto tutti i miei rompicapi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020304,
					"content": "Ed è fantastico! Temevo che anche oggi nessuno ci sarebbe riuscito! A dire il vero, stavo quasi per andare in pausa pranzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020305,
					"content": "Perché hai scritto quei rompicapi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "Ma perché è divertente, ovvio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020307,
					"content": "Che risposta fulminea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735020308,
					"content": "A parte questo, perché credi abbia scritto quei rompicapi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020309,
					"content": "Credi mi diverta semplicemente a fare il celebrale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020310,
					"content": "Chi lo sa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "Ahahah, allora mi hai frainteso, come alcuni membri dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020313,
					"content": "Ho scritto quegli indovinelli semplicemente perché adoro la profonda riflessione necessaria per risolverli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020314,
					"content": "Sei dai un'occhiata ai miei rompicapi dopo averli risolti, noterai che c'è sempre una parola chiave che conduce alla risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020315,
					"content": "Partendo da questa e continuando a rifletterci su, arriverai progressivamente alla soluzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020316,
					"content": "Se avessi voluto solo rendere le cose difficili agli altri, avrei eliminato ogni indizio e reso i rompicapi davvero irrisolvibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020317,
					"content": "Ma sorvoliamo. Dato che hai risolto tutti i miei indovinelli, puoi avere un premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020318,
					"content": "Questa è la tua ricompensa per aver vinto con la forza del pensiero. Goditela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735020311,
					"content": "Non lo so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
