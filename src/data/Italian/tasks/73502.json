	"talks": [
		{
			"id": 7350201,
			"completionStepIds": [
				7350201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350201",
							"2"
						],
						"stepId": 7350201,
