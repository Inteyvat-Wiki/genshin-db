			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "Già di ritorno? Che efficienza! Ora capisco perché piaci così tanto a quel gentiluomo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180202,
					"content": "Dammi i soldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "Che freddezza. La ricompensa è proprio qui. Ma ti prego, pensa anche ai sentimenti della tua amica messaggera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180204,
					"content": "È un onore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "Oh, no! L'onore è tutto mio. Accetta questa ricompensa... È un piacere fare affari con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051805",
							"2"
						],
						"stepId": 2051805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "Giusto, meglio che vi nascondiate, ladri, perché se scopro dove siete nascosti... Ma dove siete nascosti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180302,
					"content": "So dove si nascondono.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "Tu? Come fai a... Ah, le indicazioni su questa mappa sono molto dettagliate... Da chi le hai ottenute? Vile? E pensare che lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180304,
					"content": "...Non è per niente vicino al luogo che avevamo stabilito in precedenza. Ma qual è l'obiettivo di questi Cacciatori di tesori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180305,
					"content": "Scusami, ma mi segno queste indicazioni... Bene, ecco fatto. Chiederò agli altri di verificare questi posti immediatamente e, quando li avremo verificati, andremo a respingere i Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180306,
					"content": "Ti ringrazio di nuovo per il tuo contributo a Mondstadt. Stavolta, non ci sfuggirà nessun Cacciatore di tesori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051806",
							"2"
						],
						"stepId": 2051806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "Già di ritorno? Che efficienza! Ora capisco perché quel gentiluomo preferisce che sia tu a prendere in mano la situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180402,
					"content": "Ho affidato il compito ai Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "I Cavalieri di Favonius... Ehi, ma non t'avevo appena detto che coinvolgerli sarebbe stato un problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180404,
					"content": "Che scansafatiche... Per fortuna, quel signore immaginava che tu potessi farlo, così ho preparato un piano B.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180405,
					"content": "Beh, non preoccuparti del resto. *sospira* È arrivato il momento di darsi da fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180406,
					"content": "Ma secondo quel gentiluomo, le tue azioni potrebbero ancora condurci in direzioni interessanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180407,
					"content": "Dopotutto, riferire io stessa i movimenti dei Cacciatori di tesori sarebbe stata una mossa troppo ovvia, e poi quel gentiluomo non può nemmeno avvicinarsi direttamente ai Cavalieri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180408,
					"content": "Ecco, tieni. Sono tuoi. Come li ha chiamati quel gentiluomo? Una piccola ricompensa per aver \"cambiato la direzione del vento\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051802",
							"2"
						],
						"stepId": 2051802,
						"stateName": "QUEST_STATE_UNFINISHED"
