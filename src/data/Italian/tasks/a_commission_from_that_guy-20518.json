	"talks": [
		{
			"id": 2051801,
			"completionStepIds": [
				2051801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051801",
							"2"
						],
						"stepId": 2051801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180101,
					"content": "Ehi, ci incontriamo di nuovo. Come va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180102
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180102,
					"content": "Ah sì, dimenticavo. Finora Jilliana non ha fatto né troppo bene né troppo male. La buona notizia è che non è ancora partita da Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180103
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180103,
					"content": "Ma la brutta notizia è che ha già confessato la sua situazione a sorella Victoria, la quale non ha fatto ancora granché al riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180104
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180104,
					"content": "Possiamo solo aspettare e vedere come finirà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180105
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180105,
					"content": "Cosa stai pensando di fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180106
					]
				},
				{
					"id": 205180106,
					"content": "Dai, su. Non guardarmi così. Non sono cattiva. Anzi, non ti sto forse dando dei consigli su come aiutarla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180107
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180107,
					"content": "Bene, andiamo al sodo. Sono qui per risolvere le questioni che abbiamo lasciato in sospeso dopo lo scorso incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180108
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180108,
					"content": "In poche parole, è vero che hai sconfitto i Cacciatori di tesori, ma allo stesso tempo hai anche fatto saltare la copertura di Jilliana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180109
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180109,
					"content": "I Cacciatori di tesori non tollerano i tradimenti. Per quanto ne so, ci sono già giunte voci delle loro tracce, e non abbiamo mai visto nessuno di questo gruppo prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180110
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180110,
					"content": "Probabilmente vogliono trovare Jilliana, e allo stesso tempo vendicare le loro perdite. Al momento, non possiamo fare altro che chiederti di affrontarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180111,
						205180113,
						205180115
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180111,
					"content": "Tutto questo non è opera tua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180112
					]
				},
				{
					"id": 205180112,
					"content": "Oh, ti prego, anch'io obbedisco a degli ordini. Se non fosse stato per l'insistenza di quel gentiluomo, che voleva che fossi tu a occupartene, non sarei venuta a cercarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180121,
					"content": "Non preoccuparti, questa volta le ricompense saranno molto ricche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180122
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180122,
					"content": "Questa volta, a differenza della precedente, in cui ho dovuto pagarti di tasca mia, il nostro caro gentiluomo mi ha dato molti Mora... Ah, giusto! Devo anche segnarti la posizione dei Cacciatori di tesori sulla mappa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180123
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180123,
					"content": "Bene. Se non altro, puoi proteggere Jilliana, Rudolf, Lily e Mondstadt per i Mora. Tutto dipende da te ormai, metticela tutta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180113,
					"content": "Fallo da sola!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180114
					]
				},
				{
					"id": 205180114,
					"content": "Non dire così. Sai che non sono forte come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180115,
					"content": "Questo è un lavoro da Cavalieri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180116
					]
				},
				{
					"id": 205180116,
					"content": "Hai ragione, ma quel gentiluomo ritiene che, nelle circostanze attuali, meno persone conoscono gli affari di Jilliana, meglio è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180117
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180117,
					"content": "E poi quel gentiluomo non vuole coinvolgere i Cavalieri. Dopotutto, i Cavalieri sono troppo abituati ad agire allo scoperto, e a volte esagerano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180118
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180118,
					"content": "Prendiamo il nostro affidabilissimo Huffman, per esempio. Se sentisse che ci sono dei Cacciatori di tesori vicino a Mondstadt, lancerebbe l'allarme entro un'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180119
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180119,
					"content": "E se tutti i Cavalieri marciassero in bella vista, i Cacciatori di tesori fuggirebbero in un lampo, rendendo inutile il nostro piano per liberarci di loro una volta per tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180120
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180120,
					"content": "Perciò, se ti chiediamo di agire per conto tuo, e di eliminarli in modo efficace, è solo perché non abbiamo altra scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051802,
			"completionStepIds": [
				2051804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051804",
