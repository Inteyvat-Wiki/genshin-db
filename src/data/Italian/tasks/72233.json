				"points": []
			},
			"dialogs": [
				{
					"id": 722330401,
					"content": "#C'è qualcos'altro che vuoi chiedermi, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330402,
					"content": "A proposito delle Chiavi sigillo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "Le abbiamo collocate nella Pinna e nel Cuore di Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330404,
					"content": "A dire il vero, abbiamo cercato un compromesso tra distanza e segretezza, e quei due santuari si trovano proprio in luoghi piuttosto nascosti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330405,
					"content": "Abbiamo fatto del nostro meglio. Davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330406,
					"content": "Dove posso trovare gli altari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "Li puoi trovare a nord e a est. Sono ubicati lungo la seconda parete montuosa che circonda le Profondità seleniche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330408,
					"content": "Se tracciate due linee tra il Santuario dei Sangonomiya e la Pinna e il Cuore di Watatsumi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330409,
					"content": "E poi le collegate con l'arco della parete montuosa, dovreste ottenere due posizioni. È lì che troverete gli altari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
