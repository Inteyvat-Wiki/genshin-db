				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#Ciao, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330102,
					"content": "Ciao, Tsuyuko. Come sono andati i preparativi per recuperare quell'aggeggio di corallo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330103,
					"content": "Ah, ahimè! Il nostro lavoro finora è stato piuttosto... travagliato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330104,
					"content": "Tsuyuko, anche se fai la faccia triste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330105,
					"content": "Non convincerai nessuno se continui ad ammiccare così verso di noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330106,
					"content": "Ahah, capisco. Così anche voi avete compreso la gravità della nostra situazione. Se è così, non farò più finta di nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330107,
					"content": "Non stavi affatto facendo finta di nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330108,
					"content": "Abbiamo ottenuto la Chiave delle Profondità seleniche ed Enkanomiya si sta lentamente risvegliando. Tuttavia, siamo a corto di persone e le nostre indagini procedono a rilento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330109,
					"content": "Queste sono circostanze particolarmente difficili, dopotutto. Non sappiamo ancora se le relazioni con l'Isola di Narukami si distenderanno davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330110,
					"content": "Sai che io ho solo due mani, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "#Ah, ma questo è un altro discorso. Secondo la tradizione, \"{F#un'eroina}{M#un eroe}\" è un requisito fondamentale per ottenere il Corallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330112,
					"content": "#Dobbiamo creare una base e aiutare {F#l'eroina}{M#l'eroe} a ripercorrere i sentieri dei nostri antenati, prima di affrontare la prova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330113,
					"content": "In questo modo, costruiremo una strada sicura per la vittoria...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330114,
					"content": "O queste erano le vostre intenzioni... Ma non potete realizzarle perché vi mancano le persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330115,
					"content": "#Proprio così. Per non parlare del fatto che non sappiamo neanche che faccia abbia \"{F#questa eroina}{M#questo eroe}\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330116,
					"content": "#Ma aspetta, adesso credo di aver capito. {F#La nostra eroina}{M#Il nostro eroe} ha... Sì, {F#la nostra eroina}{M#il nostro eroe} ha i capelli biondi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330117,
					"content": "Sembra una vera seccatura. Paimon pensa che fare questo viaggio non sia una buona idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330118,
					"content": "Ah, ma di solito l'esplorazione comporta la scoperta di tesori rari. Normalmente, verrebbero consegnati al clan Sangonomiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330119,
					"content": "Ma, in questo caso, credo che potremmo chiudere un occhio, nel caso in cui trovaste qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330120,
					"content": "Non mi dispiacerebbe se chiudeste entrambi gli occhi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "#Ah, {F#la nostra eroina, la nostra prode guerriera, la nostra paladina e salvatrice}{M#il nostro eroe, il nostro prode guerriero, il nostro paladino e salvatore}! Questo significa che accetti, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330123,
					"content": "Beh, come potremmo voltare le spalle ai Sangonomiya in un momento del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330124,
					"content": "Meraviglioso! Sembra proprio che i metodi che ci ha consigliato Madame Kokomi siano piuttosto persuasivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330125,
					"content": "#Ha persino previsto che sareste tornat{F#e}{M#i} a cercarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330126,
					"content": "Scusa, cos'hai detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330127,
					"content": "Oh, niente, niente. Vi prego di venire con me. Vorrei mostrarvi qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330128,
					"content": "Incontriamoci presso l'altare al di sotto dell'area davanti a noi. Se non riuscite a vederlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330129,
					"content": "Se non riusciamo a vederlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330130,
					"content": "Vi basterà guardare a sud-est e strizzare gli occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330121,
					"content": "Sai, credo di andare piuttosto d'accordo con Madame Kokomi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223302",
							"3"
						],
						"stepId": 7223302,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223303",
							"2"
						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "Questa è una \"Chiave sigillo\". Un tempo era l'araldica usata in tutta Enkanomiya. Riemerge solo quando il sentiero sta per essere aperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330202,
					"content": "Si dice che, quando Enkanomiya si risveglia, ci sia un secondo set di chiavi affidato alla gente dell'Isola di Watatsumi, e i nostri annali mostrano che ci sono in totale cinque tipologie di Chiavi sigillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330203,
					"content": "Al momento, ne abbiamo trovate tre su cinque sull'Isola di Watatsumi. In questo modo, potremo rimetterle al loro posto e rimuovere il sigillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330204,
					"content": "Abbiamo rimosso le tre che abbiamo trovato dalle loro serrature, in modo da collocarle in altri luoghi sparsi per tutta l'Isola di Watatsumi. In questo modo, la barriera potrà essere ripristinata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330205,
					"content": "L'obiettivo di tutto ciò era evitare che i bambini, le spie dei Fatui, gli abitanti dell'Isola di Narukami o i forestieri riuscissero a intrufolarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330206,
					"content": "Mmm... Tu non fai parte della categoria dei \"forestieri\", niente paura. Ahahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330207,
					"content": "Al momento non siamo in grado di contattare la Gilda degli avventurieri, quindi neanche agli avventurieri è consentito l'accesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330208,
					"content": "Avete mai consentito loro l'accesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330209,
					"content": "Ci sono diverse testimonianze. Stavamo cercando un accordo vantaggioso per entrambi. Fa sempre comodo avere persone esperte in esplorazione... Come voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330210,
					"content": "Oh-oh, questo significa che stavolta nessuno è arrivato prima di noi, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330211,
					"content": "Ehi, Paimon, che modi sono...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "Beh, come posso dire? La barriera temporanea che abbiamo creato non è molto affidabile. È alquanto probabile che, da quando abbiamo cercato la posizione delle Chiavi sigillo a quando le abbiamo rimosse dalle serrature, qualcuno si sia intrufolato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330213,
					"content": "Dopotutto, siamo a corto di personale. In altre parole, qualora incontraste Fatui, Cacciatori di tesori, Kairagi o loro simili... Date loro una bella lezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330214,
					"content": "Aspetta: se sono riusciti a scendere così facilmente, che senso ha avuto recuperare quella chiave delle profusità selvagge o come si chiama lei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330215,
					"content": "Enkanomiya potrà risvegliarsi solo se recuperiamo la Chiave delle Profondità seleniche. Allo stesso modo, solo quella chiave può attivare il sistema della prova al suo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330216,
					"content": "E se c'è qualcuno che non è entrato a Enkanomiya per eseguire il rituale del Rito sacro di Watatsumi... Beh, chissà in quale modo contorto sarà riuscito a intrufolarsi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330217,
					"content": "In ogni caso, per favore recuperate in fretta le altre Chiavi sigillo sull'isola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330218,
					"content": "Le Chiavi sigillo sono state posizionate nella Pinna e nel Cuore di Watatsumi. Per quanto riguarda i loro due altari, si trovano dove una linea che collega uno dei due santuari e il Santuario dei Sangonomiya si interseca con la seconda parete montuosa che circonda le Profondità seleniche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330219,
					"content": "Bene, attenderò vostre notizie al solito posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
		{
			"id": 7223303,
			"completionStepIds": [
				7223308
			],
