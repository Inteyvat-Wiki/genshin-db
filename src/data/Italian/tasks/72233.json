			"dialogs": [
				{
					"id": 722330501,
					"content": "#C'è qualcos'altro che vuoi chiedermi, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330502
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330502,
					"content": "A proposito di Byakuyakoku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Un tempo, il nome di Enkanomiya era Byakuyakoku. Un regno sotterraneo privo sia del sole che della luna, i cui unici fenomeni astronomici erano la Biancanotte e la Notteterna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330504,
					"content": "Una delle mie antenate era una sacerdotessa di nome Eboshi. Ha ricoperto un ruolo piuttosto importante nella storia di Byakuyakoku, ed è grazie a lei se sono responsabile del Rito sacro di Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		}
	]
}