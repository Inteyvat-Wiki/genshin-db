						],
						"stepId": 7223308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330301,
					"content": "Ora è il momento di spezzare il sigillo. Ecco, prendete la Chiave delle Profondità seleniche recuperata prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330302,
					"content": "Come, scusa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330303,
					"content": "Chiave delle Profondità seleniche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330304,
					"content": "Puoi ripeterlo tre volte velocemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330305,
					"content": "Chiave delle Profondità seleniche, Chiave delle Profondità seleniche, Chiave delle Profondità seleniche... Ah! Mi si è ingarbugliata la lingua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330306,
					"content": "Visto? Paimon ti aveva detto che era un nome strano! Dovreste pensare a cambiarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330307,
					"content": "Anche se dovessimo cambiare il nome oggi, tornerebbe a essere importante solo tra un paio di secoli. Per ora, accontentatevi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330308,
					"content": "*tossisce* A ogni modo, adesso inizierò il rituale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330309,
					"content": "Sfortunatamente, non abbiamo dettagli sulla natura della prova di Enkanomiya, quindi dovrete fare affidamento solo su di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330310,
					"content": "Se dovessimo dare la colpa a qualcuno, dovremmo incolpare le stupide tradizioni volte a preservare i misteri. Vi auguro buona fortuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330311,
					"content": "Inoltre, per favore non spingetevi troppo in là. La vostra sicurezza viene prima di tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
