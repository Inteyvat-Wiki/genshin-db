					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160304,
					"content": "Avessi davvero perso il mio manuale, poi, non so come avrei fatto a chiederne a Katheryne uno nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708160305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 708160305,
					"content": "Un avventuriere che perde il suo manuale durante un incarico... Che barzelletta...",
