	"talks": [
		{
			"id": 1011204,
			"completionStepIds": [
				1011204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
