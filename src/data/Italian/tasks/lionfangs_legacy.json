					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120633,
					"content": "Mani nini Biaodomu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120636
					]
				},
				{
					"id": 101120636,
