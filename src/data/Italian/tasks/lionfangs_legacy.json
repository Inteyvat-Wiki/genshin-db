				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "Eheh. Guardate un po', la <color=#00E1FFFF>Spada del Valore sfavillante</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120402,
					"content": "Sei sicuro? A Paimon sembra piuttosto modesta e anche un tantino malandata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120403,
					"content": "Perché gli Hilichurl dovrebbero inchinarsi davanti a un pezzo di ferraglia come questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120404,
					"content": "(Ahh... Sembra che qualcuno abbia gettato una vecchia spada in un mucchio di reliquie che quegli Hilichurl stavano già venerando...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120405,
					"content": "È in condizioni terribili! Ed è così modesta, io... sono senza parole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120406,
					"content": "Mmmh... Dimmi, Jack, hai mai visto un Cristallottero di Anemo? Si trovano in aperta campagna intorno alla Città di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120407,
					"content": "Se ne vedessi uno in pieno giorno, non batteresti ciglio. Ma nel buio pesto della notte? Il suo bagliore sfavillante è davvero affascinante... Somiglia proprio a un delizioso cristallo che danza nella notte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120408,
					"content": "Non è forse così anche il coraggio? Quando tutto va per il verso giusto, sembra privo di significato e passa in secondo piano. Ma nelle difficoltà, il coraggio è ciò che ti infiamma e ti fa reagire. È il raggio di luce sfavillante che ti guida fuori dall'oscurità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120409,
					"content": "Una supercazzola davvero geniale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "È vero... Hai ragione! Allora dev'essere proprio questa: è la Spada del Valore sfavillante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120413,
					"content": "Eheheh, mh-mh! Quindi... abbiamo la spada, ora dobbiamo solo trovare lo scudo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120414,
					"content": "Cerchiamo in giro! È sicuramente nella <color=#00E1FFFF>Valle Dadaupa</color>. Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120415,
					"content": "C'è qualcuno lì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120416,
					"content": "Stanley? Che ci fa qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120417,
					"content": "Si comporta in modo strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120418,
					"content": "Che succede? Perché vi siete fermati all'improvviso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120419,
					"content": "Eh? Oh, ah, nulla. È solo passata una di quelle Donnoladre sputa-Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120420,
					"content": "Cosa? Dove? Voglio vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120421,
					"content": "Forse un'altra volta, eheh. Abbiamo uno scudo da trovare, ricordi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120410,
					"content": "Salvato in calcio d'angolo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "Ci avevo quasi creduto anch'io!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
				1011206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
