			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hilichurl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "Ecco, lo <color=#00E1FFFF>Scudo dell'Onore sublime</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120602,
					"content": "Le bugie hanno le gambe corte! È solo un pezzo di legno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120603,
					"content": "Un pezzo di legno di scarto con attaccata un'impugnatura... Chi, sano di mente, lo userebbe come scudo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120604,
					"content": "Ci sono anche delle macchie di vino sopra... Sì, sono abbastanza sicuro che sia stato ricavato da una botte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120605,
					"content": "Eppure, il mio intuito da bardo mi dice che questo è senza ombra di dubbio lo Scudo dell'Onore sublime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120606,
					"content": "I guerrieri esibiscono le loro cicatrici di guerra con orgoglio e gli scudi non sono da meno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120607,
					"content": "Uno scudo intatto è certamente uno scudo estraneo al campo di battaglia. Non è forse proprio lo scudo rotto e scheggiato quello che ha combattuto innumerevoli battaglie ed è sopravvissuto per raccontare la sua storia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120608,
					"content": "Sebbene il corpo del soldato sia stanco e logoro, non smette mai di combattere, finché non ha più sangue da versare. Quale magnifica forza di volontà... Non è questo il vero significato dell'onore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120609,
					"content": "Concordo con Venti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "Hai ragione... Gli scudi nuovi e lucenti non rimangono tali a lungo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120613,
					"content": "D'accordo, allora... Beh, forse se glielo chiediamo gentilmente, ci lascerà prendere lo Scudo dell'Onore sublime senza pagare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120614,
					"content": "*si schiarisce la voce* Mi scusi, signor Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120615,
					"content": "Dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120616,
					"content": "#Vabbè! Dai, pensaci tu, {NICKNAME}! Spero che tu conosca un po' di hilichurliano. In caso contrario, c'è sempre il linguaggio dei segni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120617,
					"content": "Pagherò un sacco di Mora per quello scudo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120623,
					"content": "Oh-oh... <color=#00E1FFFF>Non sembra aver apprezzato</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120624,
					"content": "Prego, prendi questo Fiordolce che ho raccolto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 101120628,
					"content": "Sembra piuttosto <color=#00E1FFFF>felice</color>. Forse le trattative andranno a buon fine, dopotutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120631,
					"content": "Venti canta canzone, tu dai scudo, sì?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "Mmh? Ebbene, se insisti, strimpellerò qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "Venti"
				},
				{
