			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "Grazie mille! Non riesco a credere di averli trovati davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121002,
					"content": "Mamma! Papà! Date un'occhiata alle armi leggendarie che ho trovato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121003,
					"content": "Ehi, aspetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121004,
					"content": "Il vino, l'avevi promesso! Uff, e pensare che stavolta ho effettivamente aiutato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121005,
					"content": "Mmmh? Che ci fai qui, Stanley? In giro per una passeggiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121006,
					"content": "Ah... Ahah, ah... Ehi...! Che ci fai qui, bardo? Che coincidenza, eh? Uh... Anche tu in giro per una passeggiata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121007,
					"content": "Esatto, una passeggiata digestiva, per la precisione. Stavamo anche aiutando un amico a cercare qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121008,
					"content": "(Paimon sta iniziando a sospettare che Stanley possa essere un impostore...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121009,
					"content": "(Sto seriamente iniziando a pensarlo anch'io.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "(Stanley ha lasciato la spada e lo scudo qui in precedenza per non ferire i sentimenti di Jack?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121012,
					"content": "Gli avventurieri devono conoscere piuttosto bene la Valle Dadaupa. Poi tu hai già combattuto delle battaglie qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121013,
					"content": "Puoi scommetterci! Potrei girare per tutta la zona a occhi chiusi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121014,
					"content": "Caspita. Allora ammiro la tua perseveranza e la tua memoria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121015,
					"content": "È il minimo, per un grande avventuriere come me! Fareste meglio a stare attenti, però. Questo posto pullula di Hilichurl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121016,
					"content": "Io, ah... Adesso torno alla mia, ehm... ah... passeggiata. A presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121017,
					"content": "Coscienza sporca, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121018,
					"content": "Beh, non avrebbe dovuto vantarsi così tanto con Jack, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121019,
					"content": "Anche se, riflettendoci, devo dire che sono incuriosito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121020,
					"content": "Qualcuno che non riesce a lasciare andare il passato e rinuncia così al presente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121021,
					"content": "Mi chiedo... Se una persona del genere fosse costretta a fare il primo passo verso il futuro, in che direzione andrebbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121022,
					"content": "Di che parli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121023,
					"content": "Ahah, stavo solo riflettendo ad alta voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121024,
					"content": "#Comunque, {NICKNAME}, propongo di fare un giro al <color=#00E1FFFF>Dono dell'Angelo</color>, stasera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121010,
					"content": "(È sicuramente un impostore. Non ci sono dubbi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
		},
