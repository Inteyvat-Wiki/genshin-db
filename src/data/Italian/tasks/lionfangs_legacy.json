			},
			"dialogs": [
				{
					"id": 101120801,
					"content": "Yaya ika! Kundala ye plata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120802
					],
					"speakerTitle": "Hilichurl"
				},
				{
