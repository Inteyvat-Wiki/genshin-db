			"dialogs": [
				{
					"id": 740590201,
					"content": "#{NICKNAME}, Paimon, ne è passato di tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590202,
					"content": "Siete alla ricerca delle stesse strane rocce della scorsa volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590203,
					"content": "Uh, sì, ma c'è dell'altro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590204,
					"content": "Date a Puca il prototipo di orologio di Chesil e le dici dei suoi piani di realizzare orologi usando il particolare minerale.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "I-Incredibile! Possono realizzare cose del genere dalle rocce?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590206,
					"content": "Eh? Solo i meccanismi interni sono realizzati con quella pietra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590207,
					"content": "Si può persino sentire il ticchettio sott'acqua... Non ho mai visto un orologio del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590208,
					"content": "Chesil ha detto che ha una struttura a ostrica... O era a conchiglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590209,
					"content": "Eheh, solo sentire il suono dell'orologio mi rende felice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590210,
					"content": "Non avrei mai immaginato che persino delle pietre tanto comuni potessero servire a qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590211,
					"content": "Ho sempre pensato che si dovesse essere come mia sorella e che solo le pietre più rare potessero essere trasformate in tesori. Non avrei mai pensato che si potesse creare qualcosa di incredibile anche con delle rocce così comuni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590212,
					"content": "Ogni cosa ha il suo valore e scopo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "Uhuh, all'improvviso mi sento molto bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590214,
					"content": "Puca mette con attenzione l'orologio in un bel posto.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "Bene, ora tutto quello che dovrai fare è preparare il minerale e venderlo a Chesil quando gli serve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590216,
					"content": "In questo modo potrai avere il tuo personale emporio di pietre preziose, proprio come tua sorella!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590217,
					"content": "Dopotutto, hai raccolto un sacco di pietre diverse. Forse riuscirai a trovare un uso per ciascuna di esse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590218,
					"content": "Giusto! Mi preparerò per bene! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590219,
					"content": "Se mai vi servisse qualche pietra, venite a trovarmi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590220,
					"content": "Eheh, non c'è problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
