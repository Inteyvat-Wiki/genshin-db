			"dialogs": [
				{
					"id": 740590101,
					"content": "#Ah, siete voi due, quell{F#e}{M#i} che mi hanno venduto le gemme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590102,
					"content": "Esatto! L'ultima volta che ci siamo visti avevi detto qualcosa riguardo a trasformarle in bellissimi accessori... Come procede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590103,
					"content": "Paimon non vede l'ora di vedere come sono diventate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590104,
					"content": "Riguardo a quello... Mi dispiace deludervi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590105,
					"content": "Uh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590106,
					"content": "Avrei davvero voluto crearci dei gioielli, ma il minerale è fin troppo duro per essere lavorato a mano nel dettaglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590107,
					"content": "E questa non è la parte peggiore. Chi avrebbe mai detto che il minerale, una volta tagliato e lucidato, avrebbe perso tutta la sua lucentezza originale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590108,
					"content": "In ogni caso, non è adatto per creare accessori...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590109,
					"content": "Ah... Paimon non se lo aspettava. Pensavamo davvero che queste pietre potessero essere utili in qualche modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590110,
					"content": "Utili, dici... Beh, diciamo che non sono inutili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590126,
					"content": "Chesil posiziona un orologio meccanico sul bancone mentre parla.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "Guarda questo nuovo orologio meccanico, costruito con quel minerale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590112,
					"content": "Stavo per rimproverarmi di aver valutato male il minerale e stavo per sbarazzarmene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590113,
					"content": "Poi alcuni orologiai sono passati di qua e hanno notato gli scarti rimasti dai nostri tentativi di lavorazione... Dal momento che il minerale è così duro, ne hanno preso un po' con loro e l'hanno usato per creare i componenti dei loro orologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590114,
					"content": "Sono rimasto sorpreso di scoprire che grazie all'elevata resistenza all'abrasione del minerale, è superiore ai materiali tradizionalmente usati per i componenti in movimento degli orologi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590115,
					"content": "Ma se fosse usato per realizzare orologi, i rifornimenti dovrebbero essere ancora più affidabili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590116,
					"content": "Credo che si possa fare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "Racconti a Chesil di Puca e delle vene minerarie.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "Capisco. Allora è davvero una fantastica coincidenza! Il prototipo di orologio è stato realizzato con l'ultimissimo design impermeabile a conchiglia. In altre parole, è stato progettato fin dall'inizio per le Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590120,
					"content": "In tal caso, potresti portare questo prototipo a Mademoiselle Puca e spiegarle la situazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590121,
					"content": "Dopotutto, non ho mai fatto affari con le Melusine prima d'ora... Se Mademoiselle Puca potesse fornirci un approvvigionamento stabile, saremmo in grado di mettere in piedi una linea di produzione completamente nuova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590122,
					"content": "In futuro le farò sicuramente visita di persona! Mmmh... Sarebbe una buona idea implementare elementi di design delle Melusine nei prossimi progetti degli orologi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590123,
					"content": "Eheh, credo che anche Puca ne possa trarre vantaggio se la cosa va in porto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590124,
					"content": "Ooh, questa potrebbe essere un'ottima opportunità per avviare una propria fabbrica di gemme per Puca! Forza, andiamo a parlarle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590125,
					"content": "Conto su di voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590117,
					"content": "Se contatti direttamente Puca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
