			"dialogs": [
				{
					"id": 740590401,
					"content": "Se la signorina Puca riuscisse a fornire un approvvigionamento stabile saremmo in grado di produrre questi orologi in grandi quantità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590402,
					"content": "Comunque, conto su di voi!",
