			"dialogs": [
				{
					"id": 751200101,
					"content": "Puoi saltare da luoghi elevati quanto vuoi, ma è il punto in cui finisci a essere cruciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200104
					],
					"speakerTitle": "Bitsin",
					"speakerSubtitle": "Capo allenatore, Maestri del Vento della Notte"
				},
				{
					"id": 751200104,
					"content": "È per questo che è stata creata questa Sfida del guerriero. Non importa quanto si vada in alto, bisogna fare attenzione a dove si mettono i piedi... Ti andrebbe di fare un tentativo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200102,
						751200103
					],
					"speakerTitle": "Bitsin",
					"speakerSubtitle": "Capo allenatore, Maestri del Vento della Notte"
				},
				{
					"id": 751200102,
					"content": "Cominciamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
					"speakerSubtitle": "Capo allenatore, Figli degli Echi"
				},
				{
					"id": 751200103,
					"content": "Dammi un attimo per prepararmi...",
