			"dialogs": [
				{
					"id": 751200201,
					"content": "#Mh? {F#Coraggiosa forestiera}{M#Coraggioso forestiero}, desideri partecipare a questa Sfida del guerriero? Ho appena corretto gli intervalli della mia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751200204
