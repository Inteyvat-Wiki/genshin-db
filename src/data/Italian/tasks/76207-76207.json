			"dialogs": [
				{
					"id": 762070201,
					"content": "Ah... Un tempo ero il linguaggio stesso. Ora sono ridotto a un'illusione in frantumi, che torna ancora una volta a questo \"simbolo\" imperfetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070202,
					"content": "Aaah! Un tizio strano che dice cose strane è appena saltato fuori da un libro strano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762070203,
					"content": "\"Strano\" è un termine impreciso. Implica un'entità unica che non può essere descritta, trascritta o circoscritta. Io chiaramente non rientro in tale definizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070204,
					"content": "Stavo semplicemente cercando un punto d'accesso alla \"realtà\" all'interno di queste pagine, ma sono scivolato inavvertitamente in un infinito differimento di metafore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070205,
					"content": "Sono diventato un resto che sfida ogni simbolizzazione. Grazie al tuo intervento, sono stato liberato dalla tirannia del linguaggio e posso finalmente ricominciare a misconoscere me stesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070206,
					"content": "Per favore, parla come mangi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "Sono caduto accidentalmente tra le pagine e sono rimasto incastrato... Grazie per avermi tirato fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tosalis"
				}
			]
		}
	]
