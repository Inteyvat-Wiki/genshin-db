					}
				]
			},
			"dialogs": [
				{
					"id": 741180601,
					"content": "Grazie, agente Menthe. A quel farabutto è bastato vederti per darsela immediatamente a gambe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180602
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180602,
					"content": "Ho fatto solo il mio dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180603
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180603,
					"content": "Signore, credo che sarebbe d'uopo lasciare in fretta la città e fare immediatamente ritorno a Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180604
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180604,
					"content": "Ho l'impressione che stiano perdendo la pazienza, e non escludo che... potrebbero ricorrere ad azioni drastiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180605
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180605,
					"content": "Lasciate che informi i miei superiori. Riceverete una risposta entro pochi giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180606
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180606,
					"content": "Se possibile, vi assegneremo degli agenti per farvi da scorta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180607
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180607,
					"content": "Bisogna però tener presente che le nostre risorse sono limitate e concentrate perlopiù all'interno della città. Potremo scortarvi per una parte del cammino, ma non fino a Petrichor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180608
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180608,
					"content": "Inoltre, dovreste trovare un posto più sicuro dove stare, per il momento. La questione potrebbe... richiedere un po' di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180609,
						741180610
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180609,
					"content": "Gli farò io da scorta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				},
				{
					"id": 741180611,
					"content": "Grazie mille. Fintanto che sarai al nostro fianco, non credo agiranno in maniera avventata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180612
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180612,
					"content": "Ma Kaia non fa parte della troupe? Se voi andrete a Petrichor, lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180613,
					"content": "Mi unirò a loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180614
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180614,
					"content": "Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180615
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180615,
					"content": "Kaia, te lo chiedo con tutto il cuore. Non farlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180616
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180616,
					"content": "Mio caro Lutong, non provare a dissuadermi. Lo sai, sono una persona ostinata, proprio come il tuo capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180617
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180617,
					"content": "M-Ma potremmo incorrere in pericoli di ogni genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180618
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180618,
					"content": "A maggior ragione, verrò con voi! O vuoi forse abbandonarmi come la volta scorsa, quando mi hai lasciata con nient'altro che uno spartito senza inizio né fine tra le mani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180619
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180619,
					"content": "Tra l'altro, il direttore della troupe trova molto interessante la musica generata dalla tua macchina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180620
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180620,
					"content": "Sono certa che appoggerebbe la mia decisione di venire con voi. Detto questo, dove si va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180621
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180621,
					"content": "P-Proprio come a Sumeru. Garcia non può neanche sognarsi di controbattere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180622,
					"content": "Garcia non potrà mai vincere un confronto con Kaia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180623
					]
				},
				{
					"id": 741180623,
					"content": "Forse il signor Garcia non ci tiene affatto a vincere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180624
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180624,
					"content": "*tossisce* Lutong! Muoviamoci, dobbiamo trovare un posto adeguato dove fermarci! Se possibile, un posto particolarmente affollato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180625
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180625,
					"content": "Un posto affollato... Allora, vediamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180626
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180626,
					"content": "Che ne pensate dell'hotel dove alloggia la nostra troupe? C'è tanta gente e ci conosciamo tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180627
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180627,
					"content": "Se mai qualcuno provasse a infiltrarsi, verrebbe scoperto immediatamente. Inoltre, al direttore della troupe interesserebbe saperne di più sulla tua macchina numeratrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180628
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180628,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180629
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180629,
					"content": "Affare fatto, allora! Fantastico, tutti i nostri problemi sono risolti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180630
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180630,
					"content": "Tutti i nostri problemi?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180631
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180631,
					"content": "#È deciso. Ecco, prendi, {NICKNAME}. Consideralo un acconto per i tuoi servizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180632
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180632,
					"content": "Non so quando potremo metterci in viaggio... ma conto su di te, per quando sarà il momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180633
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180633,
					"content": "Perché ho la sensazione di essere in guai ancora maggiori, adesso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180610,
					"content": "Ci penserò io a proteggerli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				}
			]
		},
