			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3508.936,
							459.464,
							3665.876
						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "...Qui dovrebbe andare bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180302,
					"content": "Iniziamo dal principio. Da quando ci avete aiutati a Sumeru con la macchina numeratrice, ne abbiamo enormemente migliorato le prestazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180303,
					"content": "Il signor Garcia ne è entusiasta e vuole continuare a migliorarla. Tuttavia, come lui stesso ha ammesso, si scontra con i limiti di funzionamento della struttura di trasmissione nei meccanismi tradizionali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180304,
					"content": "Migliorare ancora le prestazioni di questa macchina numeratrice si stava rivelando sempre più difficile, così abbiamo deciso di cercare nuove idee e fonti di ispirazione facendo ritorno a Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180305,
					"content": "Ma al nostro ritorno, il signor Garcia è stato avvicinato da un tipo strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180306,
					"content": "L'ha approcciato proponendo finanziamenti per le sue ricerche, e persino la collaborazione di altri ricercatori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180307,
					"content": "A un condizione, però: pretendeva che il signor Garcia condividesse con lui i suoi progetti e i dati raccolti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180308,
					"content": "Naturalmente, Garcia non avrebbe mai accettato delle condizioni simili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "Esatto! Chiedere fin da subito di condividere le scoperte delle proprie ricerche non è tanto diverso dal rubare, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180311,
					"content": "Proprio così. Per questo il signor Garcia ha declinato l'offerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180312,
					"content": "Una volta ripresa la nostra strada, però, abbiamo avuto la sensazione che qualcuno ci stesse pedinando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180313,
					"content": "Come se non bastasse, mentre non c'eravamo, qualcuno si è introdotto nella nostra stanza e ha rovistato tra le nostre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180314,
					"content": "Si è preso la briga di rimettere tutto a posto affinché non si notasse... Ma alcune tracce non sono sfuggite all'occhio del signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180315,
					"content": "C-Che paura... Voleva prendersi ciò che gli avevate negato, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180316,
					"content": "È possibile... Dopo esserci resi conto dell'accaduto, abbiamo pensato di mettere insieme la somma necessaria per fare ritorno a Petrichor il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180317,
					"content": "Una volta lì, contatteremo gli altri stimati membri del Club delle Fantasticherie e cercheremo insieme una soluzione al problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180318,
					"content": "Del resto Petrichor... eheh, diciamo che è territorio del signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180319,
					"content": "Non esiste posto più sicuro, per lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180320,
					"content": "Ci preparavamo a partire proprio oggi, ed era nostra intenzione chiedervi di scortarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180321,
					"content": "L'ultima cosa che ci aspettavamo era di trovare qui Kaia... Ho chiesto al signor Garcia di riaccompagnarla in città, per la sicurezza di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180322,
					"content": "C'è nulla che possa fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "Credo che dovremo ritardare la partenza. Ti chiedo di trovare in fretta il signor Garcia. Come dicevamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180325,
					"content": "La tua fama ti precede, e potrebbe rimuovere eventuali problemi ancor prima che si presentino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180326,
					"content": "Vado subito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "Il signor Garcia spiegherà la situazione a Kaia... Sarà poi lei in prima persona a decidere come procedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180331,
					"content": "A ogni modo, dovremmo tornare in città il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180327,
					"content": "Non sono davvero in pericolo, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "No, non credo. Il signor Garcia, dopotutto, si trova ancora nei confini della Corte di Fontaine, che è sorvegliata da un gran numero di Mekagarde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180329,
					"content": "Se quei tipi decidessero di ricorrere alla violenza, la Maison de la Garde risolverebbe gran parte del problema al posto nostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180323,
					"content": "Come posso aiutarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "Che modo losco di agire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
