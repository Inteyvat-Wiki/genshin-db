			"dialogs": [
				{
					"id": 741180401,
					"content": "Come mi aspettavo, stanno tenendo d'occhio il signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180402
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180402,
					"content": "Guarda l'uomo col cappello di fronte a lui, vicino al tavolo accanto al bancone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180403
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180403,
					"content": "Ho la quasi certezza che sia lui quello che ci sta seguendo da giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180404,
						741180405
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180404,
					"content": "Vado a chiamare la Garde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				},
				{
					"id": 741180406,
					"content": "Segnalare la situazione alla Garde sembra la cosa migliore da fare... E uno dei loro agenti è proprio qui vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180407
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180407,
					"content": "Abbiamo segnalato tutto all'agente Menthe, è già al corrente della situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180408
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180408,
					"content": "Non ho dubbi che sarà disposta ad aiutarci. Dubito che quei tipi tenteranno mosse azzardate, fintanto che vedranno un'agente della Garde nei paraggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180409
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180409,
					"content": "#{NICKNAME}, vai a parlare con l'agente Menthe, per favore. Io troverò il signor Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180410
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180410,
					"content": "Benissimo, muoviamoci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180405,
					"content": "Che aspetti? Vai a chiamare la Garde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				}
			]
		},
