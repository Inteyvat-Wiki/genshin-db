					}
				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "Signore... Forse per prima cosa dovremmo andare a Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180102,
					"content": "Lo so che Xavier e Félix non ci saranno, ma al villaggio dovremmo trovare Mécantre e Babisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180103,
					"content": "Forse riusciranno a darle qualche suggerimento o a ispirarla. E, male che vada, si presteranno ad ascoltare tutti i suoi crucci e le sue difficoltà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180104,
					"content": "No, ti ringrazio, caro Lutong. No... Le ricerche condotte da Mécantre e Babisse avanzano ormai inesorabili, come un incendio che trova continuamente di che alimentarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180105,
					"content": "Nella loro ultima lettera, hanno scritto di una brillante mente dell'Istituto di ricerca di Fontaine che era appena arrivata a Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180106,
					"content": "Un certo Bossuet, persona di grande cultura e sensibilità, che li ha aiutati a risolvere ben più di una questione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180107,
					"content": "E io... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180108,
					"content": "Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#Che sorpresa, {NICKNAME}. Fontaine è l'ultimo posto in cui pensavo di vederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180111,
					"content": "Il tuo tempismo... è impeccabile come sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180112,
					"content": "#Proprio così, un tempismo impeccabile... Ma ci fa piacere rivederti, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180113,
					"content": "Woah, che aria sbattuta! E che occhiaie impressionanti... È come se avessero esaurito ogni energia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180114,
					"content": "Che succede, Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "Noi, ehm... Le sue ricerche si sono scontrate con degli ostacoli... mai visti prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180116,
					"content": "È una lunga storia, e non voglio tediarvi... Pensavamo di andare all'Opéra Épiclèse per far quadrare certi conti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180117,
					"content": "Una volta finito, potremo sederci a fare due chiacchiere insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180118,
					"content": "Non avete ancora finito di lavorare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "Beh, lavorare non è il termine esatto. Diciamo che offriamo la nostra assistenza coi calcoli, laddove richiesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180120,
					"content": "Nello specifico, ultimamente l'Opéra Épiclèse ha ospitato diverse troupe e ha bisogno di tirare le somme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180121,
					"content": "Quindi, per guadagnare quel che serve per il ritorno a Petrichor, noi... cioè io, a nome del signor Garcia, accetterò l'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180122,
					"content": "Tsk! È come eliminare un formicaio a colpi di cannone! I \"conti\" da fare sono così semplici che ci riuscirebbe persino un bambino. Ci metterei meno di un pomeriggio, anche senza la macchina numeratrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180123,
					"content": "Si tratta di un modo eccellente per mettere insieme dei fondi. Muoviamoci, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180124,
					"content": "#A proposito, {NICKNAME}, ti andrebbe di venire con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180125,
					"content": "La tua fama ti precede, e potrebbe rimuovere eventuali problemi ancor prima che si presentino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180126,
					"content": "Naturalmente, ti offriremo una ricompensa adeguata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180127,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "Forse è meglio non parlare troppo in fretta, eheh... A ogni modo, mettiamoci in marcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180128,
					"content": "Non vi accadrà nulla, in città.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "Sei tornato a Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
		{
			"id": 7411802,
