						],
						"pointId": 5696
					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "Devo ammetterlo, questo teatro dell'opera è splendido. Immagino porti dei bei ricavi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180202,
					"content": "Il teatro dell'opera... *sospira* Mettiamoci subito al lavoro. Una volta finito, faremo ritorno a Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180203,
					"content": "E, una volta lì, aprirò una bellissima panetteria e non toccherò mai più una macchina numeratrice in vita mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180204,
					"content": "Ehm... Signore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180205,
					"content": "Che succede, Lutong? Hai una faccia... Neanche avessi visto uno spettro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180206,
					"content": "Beh, c'è davvero... uno spettro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180207,
					"content": "Garcia...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180208,
					"content": "Signorina Kaia?! Che ci fa qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180209,
					"content": "Guarda un po' che coincidenza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "Signore, non è affatto bello quel che ha detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180211,
					"content": "Oh, chiudi il becco, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180212,
					"content": "#Garcia. Che piacere vederti. E lo stesso vale per te, {NICKNAME}. Vediamo un po'... Scommetto che siete qui per aiutare il teatro dell'opera con i conti, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180213,
					"content": "E se il conto in questione fosse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "Certo che no! La nostra troupe non si è mai esibita qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180215,
					"content": "Però conosco Garcia abbastanza bene, e non è certo uno che va a teatro nel tempo libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180216,
					"content": "Se si trova qui, non posso fare a meno di pensare che sia per lavoro... Mi sbaglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180217,
					"content": "Credo che per questo gentiluomo tu sia una compagnia migliore di me, Kaia. Lo dico con estrema sincerità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180218,
					"content": "Ognuno di noi è insostituibile, caro Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180219,
					"content": "Kaia... ehm... che piacere vederti, io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180220,
					"content": "Eppure non mi sembri molto felice... Le tue ricerche si sono impantanate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180221,
					"content": "Come hai fatto a indovinare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "Beh, non credo non gli faccia piacere vedermi, né credo sia turbato a causa tua o di Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180223,
					"content": "C'è solo una cosa che in grado di rovinargli l'umore, ed è quella macchina numeratrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180224,
					"content": "Come fai a conoscere Garcia così bene, Kaia? È tantissimo tempo che non vi vedete...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180225,
					"content": "Deve avere un intuito eccezionale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "Forse è meglio se ci sediamo a chiacchierare in una caffetteria. Non sono cose che si riescono a spiegare in maniera sommaria e frettolosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180228,
					"content": "Devo ancora... Ehm, no, sono felicissimo, ma noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180229,
					"content": "Niente paura, signore. Sono calcoli semplici, posso occuparmene anche da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180230,
					"content": "Del resto, non può costringere la signorina Kaia ad aspettare in un angolo finché non abbiamo finito. Dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180231,
					"content": "Sei davvero cortese, Lutong. Grazie. Al mio ritorno, ti porterò una tazza di caffè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180232,
					"content": "Grazie, Kaia. Spero che tu e il signor Garcia vi godrete dell'ottimo caffè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180233,
					"content": "Kaia e Garcia si allontanano insieme...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "E se ne vanno via così, a prendersi il caffè...? Noi non c'entravamo nulla sin dall'inizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180235,
					"content": "Non c'entravamo proprio un bel niente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#Ti sbagli, {NICKNAME}. Il vero incarico è quello che sta per arrivare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180238,
					"content": "Devo procurare degli ingredienti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "Molto divertente. Ma preferisco non farti perdere tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180242,
					"content": "In realtà, io e il signor Garcia... siamo in pericolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180243,
					"content": "Eh? Cosa?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180244,
					"content": "Andiamo a parlarne laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180239,
					"content": "Devo recuperare dei pezzi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "Vado a scattare un po' di foto per loro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "Ma allora... che ci facciamo qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "Forse non è così difficile decifrare Garcia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
		{
			"id": 7411803,
			"completionStepIds": [
				7411803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
