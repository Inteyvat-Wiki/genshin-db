			"dialogs": [
				{
					"id": 741185001,
					"content": "#Al tuo servizio, {F#cara}{M#caro} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185002,
						741185008,
						741185014
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185002,
					"content": "Cos'hai intenzione di fare, ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185003
					]
				},
				{
					"id": 741185003,
					"content": "Credo che dovremmo verificare l'identità di quelle persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185004,
					"content": "Gli agenti della Garde non possono esserci di grande aiuto se non forniamo loro qualche indizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185005,
					"content": "E, considerate le dimensioni della Corte di Fontaine, non possiamo aspettarci che siano in grado di proteggerci ovunque e comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185006
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185006,
					"content": "Per non parlare del coinvolgimento di Kaia... che complica ulteriormente le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185007,
					"content": "Spero che il signor Garcia convinca Kaia a lasciare Fontaine. Così potremo tornare al nostro piano originale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185008,
					"content": "A ogni modo, la ricerca di Garcia è a un punto morto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "Essere a un \"punto morto\" di solito significa che non ci sono altre prospettive di miglioramento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185010,
					"content": "In termini di applicazioni pratiche, la macchina numeratrice può offrire ancora molto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185011,
					"content": "È solo che il signor Garcia non si è mai preoccupato troppo del suo impiego concreto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185012,
					"content": "Penso che questo sia uno degli aspetti all'origine delle sue frustrazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185013,
					"content": "Ma potrebbe essere anche ciò che gli permette di recitare alla perfezione la parte del ricercatore depresso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185014,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "D'accordo. Conto su di te, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
