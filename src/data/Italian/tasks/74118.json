			"dialogs": [
				{
					"id": 741180501,
					"content": "Salve, come posso aiutarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180502
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180502,
					"content": "Beh, per farla breve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180503
					]
				},
				{
					"id": 741180503,
					"content": "Racconti a Menthe tutto ciò che è successo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180504
					]
				},
				{
					"id": 741180504,
					"content": "Si tratta di Monsieur Garcia, dunque. Ho capito, andremo da lui insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180505
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180505,
					"content": "Almeno ci libereremo di quell'individuo sospetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Menthe"
				}
			]
