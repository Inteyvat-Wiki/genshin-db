			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "(A poco a poco Hora si rilassa. Stira tutto il corpo e sfodera gli artigli. È ora di dar loro una limata.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212610,
					"content": "Seguendo le indicazioni di Cazcal, limi con cura gli artigli di Hora.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "Ahahah, chi avrebbe mai immaginato che te la saresti cavata così bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212602,
					"content": "Roarrr, roarrr, roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212603,
					"content": "Anche Hora ti ringrazia. Hai fatto un lavoro così minuzioso che ora di sicuro scaverà ancora più velocemente di prima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212604,
					"content": "Tieni, prendi questi in segno di riconoscenza. Ah, già, sarà meglio che ti avverta... Se in futuro dovessi prenderti cura di altri cuccioli di Saurico, non devi seguire per forza il metodo che ti ho insegnato oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212605,
					"content": "Ogni cucciolo di Saurico ha la propria indole, perciò bisogna prendersene cura in modo diverso. Anche se l'esperienza non mi manca, so giusto come prendermi cura di Hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212606,
					"content": "Ma mi fa piacere aver compreso le sue esigenze. Dopotutto, dovremo sopportarci a vicenda ancora per molto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212607,
					"content": "Eh? Dov'è Hora? Non dirmi che è scappato di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212608,
					"content": "Hora! Hooooraaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
