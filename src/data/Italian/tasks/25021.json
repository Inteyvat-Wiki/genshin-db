				"points": []
			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Hora sembra tutt'altro che rilassato, e si limita a fissarti con aria confusa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212710,
					"content": "(Cazcal prende in mano la situazione prima che degeneri ulteriormente. Dopo un altro ciclo di scrupolosa toelettatura, finisce di limare gli artigli di Hora...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "Non preoccuparti, anch'io a volte non so cosa voglia. L'importante è che Hora capisca che siete amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212702,
					"content": "Roar... Roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212703,
					"content": "Ahahah! Visto, cosa ti avevo detto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212704,
					"content": "Molte grazie per l'aiuto. Ecco, tieni, come compenso per il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212705,
					"content": "I piccoli Saurici sono davvero difficili da trattare. Mi ci è voluto molto tempo per familiarizzare con Hora e riuscire a capire cos'avesse in mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212706,
					"content": "Però sono felice di avercela fatta. Dopotutto, dovremo sopportarci a vicenda ancora per un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212707,
					"content": "Eh? Dov'è Hora? Non dirmi che è scappato di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212708,
					"content": "Hora! Hooooraaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
