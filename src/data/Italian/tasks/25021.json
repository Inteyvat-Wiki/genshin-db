			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "Non correre via di nuovo stavolta, d'accordo, Hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210102,
					"content": "R-Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210103,
					"content": "Hora si è comportato bene, oggi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "Vero? È tutto merito della Fluttipalla che mi hai aiutato a realizzare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210105,
					"content": "Grazie a questa palla, potrò convincere Hora a fare un sacco di cose: lavarsi, mangiare, dormire, allenarsi... D'ora in poi sarà tutto molto più facile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210106,
					"content": "Potrò anche limargli gli artigli, finalmente! Prima mi sfiniva anche solo inseguirlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210107,
					"content": "Ora basta fargli vedere la palla e si siede come se fosse stato addomesticato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210108,
					"content": "Roarrr, roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210109,
					"content": "#Hora, ti ricordi chi è? È {M#lui}{F#lei} che mi ha aiutato a costruire il tuo giocattolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210110,
					"content": "Roar, roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210111,
					"content": "Che bravo sei!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "Wow, Hora si ricorda di te! Ed è anche felice di vederti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210114,
					"content": "Vuoi provare a limargli gli artigli? Già che ci sei, puoi anche pulirgli il corno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210115,
					"content": "È molto importante per i cuccioli di Tepetlisauro. Devono essere in grado di scavare le rocce e la terra, perciò i loro artigli devono essere sempre ben affilati. E, se capita che si spezzino o si deformino, vanno limati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210116,
					"content": "È l'unico modo per garantire loro artigli perfetti, una volta adulti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210117,
					"content": "Tieni, prendi! Visto che dobbiamo comunque limargli gli artigli, possiamo approfittarne per rimettere Hora completamente a nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210118,
					"content": "Quanti dettagli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "Roar, roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210121,
					"content": "*tossisce* Beh, è raro che Hora si comporti così bene. Che sollievo rendermi conto che oggi non dovrò inseguirlo ovunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210122,
					"content": "...Si direbbe un compito difficile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "Ma no, è sopportabile! Comunque sia, ci conviene iniziare subito. Rimarrò qui a darti indicazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210124,
					"content": "Per far rilassare Hora, devi pulirgli delicatamente la schiena con la spazzola grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210130,
					"content": "Poi passa a una spazzola più fine per pulire il corno. Strofina energicamente o non riuscirai a eliminare la sporcizia tra le fessure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210125,
					"content": "Dopodiché, devi usare un asciugamano per asciugare tutto il corpo... Pian piano inizierà a rilassarsi e a sfoderare gli artigli, così potrai dargli una limata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210126,
					"content": "È una routine molto precisa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "È normale! Dopotutto, sono io che l'ho cresciuto. Non c'è nessun altro in tutta la tribù... Anzi, in tutta Natlan, che lo conosca meglio di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210129,
					"content": "D'accordo, segui le istruzioni che ti ho appena dato e aiutami a dare una limata agli artigli di Hora. Sarò qui accanto a te, quindi chiedi pure se qualcosa non ti è chiaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210127,
					"content": "Sembri conoscerlo piuttosto bene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "Come mai questa improvvisa ondata di entusiasmo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(Accarezzi Hora.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
