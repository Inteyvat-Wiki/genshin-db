			"dialogs": [
				{
					"id": 750150501,
					"content": "Fiuuu, lindo e pinto, finalmente... I-Immagino che tocchi a Paimon iniziare a pescare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150502,
					"content": "Aspettate e vedrete, Paimon ne prenderà uno grosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150503,
					"content": "Purtroppo la superficie rimane liscia come uno specchio, senza nemmeno un'increspatura.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150504
					]
				},
				{
					"id": 750150504,
					"content": "Uh... C'è qualcosa che non va con l'acqua qui? Sembra che i pesci non abbiano per nulla intenzione di farsi vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150505,
						750150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150505,
					"content": "Per poco, eheh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150506
					]
				},
				{
					"id": 750150506,
					"content": "Per poco! Eppure... non ci siamo. Ah, ci vorrà una vita, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150507,
					"content": "È un po' presto perché Paimon getti la spugna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150511,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150512,
					"content": "L'hai preso! Ha abboccato!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150513
					]
				},
				{
					"id": 750150513,
					"content": "Ehi, basta con le distrazioni... Cavoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150514,
					"content": "Ehhh?! Ha abboccato! Ha abboccato! È il momento di riavvolgere il filo e scoprire cos'ha preso Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150515,
					"content": "#Ma che... Non è un pesce, è una bottiglia! Ed è pure legata a una delle assi di legno... Ah, beh, il fatto che anche {NICKNAME} peschi sempre stranezze fa sentire Paimon un po' meglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150516,
					"content": "Sembra che tu riesca a pescare di tutto... tranne i pesci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150517
					]
				},
				{
					"id": 750150517,
					"content": "Ehi, anche tu catturi spesso cose strane! Comunque, dato che Paimon ha preso qualcosa, vediamo di cosa si tratta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150518,
					"content": "Saranno stati forse quei due che hanno appena lasciato quella pila di roba? Le persone ossessionate dalla pesca sono... piuttosto spaventose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150519,
					"content": "Sembra che stiano usando questa bottiglia per passarsi dei messaggi... Sarà meglio rigettarla in acqua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150520,
					"content": "Coooomunque, Paimon ha l'impressione che la prossima volta prenderà un pesce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150521,
					"content": "La canna da pesca si abbassa improvvisamente, come se qualcosa di grosso e pesante l'avesse tirata.\\nQualcosa di enorme e pesante sul fondo dell'acqua ha abboccato all'esca...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150522
					]
				},
				{
					"id": 750150522,
					"content": "Ha abboccato finalmente! Dev'essere un pescione da paura... Vieni su, fagottone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150523,
					"content": "Esatto, fagottone! Vieni su!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150524
					]
				},
				{
					"id": 750150524,
					"content": "R-Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150525,
					"content": "#Dato che Paimon sta facendo fatica,\\ntu e {REALNAME[ID(2)|SHOWHOST(true)]} la tenete...\\nMa il pesce sta tirando con una forza sorprendente...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150526
					]
				},
				{
					"id": 750150526,
					"content": "Alla fine, con un gigantesco plop, il pesce scappa...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150527
					]
				},
				{
					"id": 750150527,
					"content": "*singhiozza* Doveva essere enorme altrimenti non sarebbe mai fuggito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150528,
					"content": "Ah, che fastidio... Eh? Sta ancora nuotando sotto il pelo dell'acqua! Seriamente?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150529,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150530,
					"content": "No, non se ne parla. Il mare è troppo pericoloso e comunque non riusciresti mai a raggiungerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150531,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150532
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150532,
					"content": "#Se solo riuscissimo a trovare un modo per prendere quel pesce, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150508,
					"content": "Non ci vorrà molto, fidati di me! Mantieni la calma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150509
					]
				},
				{
					"id": 750150509,
					"content": "Mmmh, probabilmente hai ragione. Dopotutto quando iniziano ad abboccare procede tutto più speditamente. Proprio come quando vuoi raccogliere un Fiordolce... per poi scoprire che si tratta di un Malefiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150510,
					"content": "Devi solo mantenere la concentrazione e aspettare... aspettare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				}
			]
		},
