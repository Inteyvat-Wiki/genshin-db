			"dialogs": [
				{
					"id": 750150401,
					"content": "#Ta-da! Cosa ti aveva detto Paimon? Se c'è una persona che poteva avere la meglio su questa preda scivolosa, quella persona è {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150402,
					"content": "A proposito di abilità, se gettassimo tutte le esche e i pesci mangiassero tanto da ribaltarsi e salire galleggiando in superficie... Sarebbe comunque una tecnica di pesca, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150403,
					"content": "Roar... roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#Quindi anche {REALNAME[ID(2)|SHOWHOST(true)]} la pensa così? Paimon lo capisce dal luccichio nei suoi occhi! Eheh, proviamoci la prossima volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150405,
					"content": "Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#Un attimo, non è ancora pronto! Dobbiamo aspettare che {NICKNAME} finisca di cucinarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150407,
					"content": "Una volta che il pesce è pronto, tutti si siedono e mangiano la propria porzione.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "Ah... Questo pesce grigliato era veramente speciale. Forse perché l'ha pescato Paimon, eheh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150410,
					"content": "Ottimo lavoro, Paimon! D'ora in poi ti occuperai di pescare!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "Ohhh... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150412,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "#Ehi, il pranzo non è gratis, {REALNAME[ID(2)|SHOWHOST(true)]}! Dovrai aiutare anche tu la prossima volta, se vuoi mangiare dell'altro pesce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150414,
					"content": "Rrroar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "Umpf, guarda un po' chi fa lo gnorri adesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
