			"dialogs": [
				{
					"id": 221110201,
					"content": "Ho una lettera per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110202,
					"content": "#Ad astra abyssosque! Benvenut{M#o}{F#a} nella Gilda degli avventurieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110203,
					"content": "Immagino che questa sia per te...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110204
					]
				},
				{
					"id": 221110204,
					"content": "#Una lettera per me? Oh... Dunque tu sei un{F#'}{M# }avventurier{F#a}{M#e} di Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110205,
					"content": "Cos'è questo? Un dente di leone? Perché la busta ne contiene uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110206,
					"content": "#Avventurier{F#a}{M#e}, hai inserito tu un dente di leone nella busta per dimostrare che vieni da Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110207,
					"content": "Non era necessario, la lettera contiene informazioni sufficienti sulla tua identità e le imprese che hai compiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110208,
						221110210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110208,
					"content": "Non è opera mia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110209
					]
				},
				{
					"id": 221110209,
					"content": "Non che abbia importanza, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110214,
					"content": "#Questa lettera della Gilda degli avventurieri di Mondstadt ti definisce un{M# }{F#'}avventurier{F#a}{M#e} di grande esperienza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110215,
					"content": "#Se così fosse, sono certa tu sia pront{M#o}{F#a} ad accettare incarichi dalla Gilda degli avventurieri di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110216,
					"content": "Ti attende un nuovo mondo di straordinarie avventure. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110210,
					"content": "Scommetto che è stata Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110211
					]
				},
				{
					"id": 221110211,
					"content": "Katheryne? Oh, intendi la Katheryne di Mondstadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110212,
					"content": "#Perché avrà messo un dente di leone insieme alla lettera? Che strano... Un dente di leone non è molto utile a un{M# }{F#'}avventurier{F#a}{M#e}, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110213
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110213,
					"content": "Non che abbia importanza, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110214
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
