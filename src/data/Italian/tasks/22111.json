			"dialogs": [
				{
					"id": 221110101,
					"content": "Ci sono nuovi incarichi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110102,
					"content": "#Salve, avventurier{F#a}{M#e}. Ormai tutta Mondstadt parla delle tue fantastiche imprese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110103,
					"content": "#Continua così e verrai ricordat{M#o}{F#a} come un{M#o}{F#a} degli avventurieri più grandi della nostra epoca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110104,
					"content": "Hai un incarico per me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "Ogni avventuriere che mira a una grande fama deve ampliare la sua zona di comfort, a un certo punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110106,
					"content": "Ormai puoi vantare una grande esperienza per quanto riguarda le avventure. Forse è tempo di esplorare qualcosa di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110110,
					"content": "Prendi questa lettera e consegnala alla Katheryne di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110111,
					"content": "C'è una Katheryne anche a Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "Sì, sono certa che non avrai problemi a trovarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110115,
					"content": "Comunque sia, una volta consegnata questa lettera alla Katheryne di Liyue, il punto di contatto per le tue avventure future sarà lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110116,
					"content": "Naturalmente, ogni volta che tornerai a Mondstadt, sarò felice di poterti aiutare io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110117,
					"content": "Ti chiederei di non aprire la lettera lungo il tragitto. Se qualcosa al suo interno si perdesse, sorgerebbero parecchi problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110118,
					"content": "#Avventurier{F#a}{M#e}! È giunto il momento di compiere il passo successivo verso le stelle e l'abisso. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110113,
					"content": "In futuro quindi dovrò chiamarti la \"Katheryne di Mondstadt\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "#Se serve a far progredire la tua carriera di avventurier{F#a}{M#e}, chiamami come preferisci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110107,
					"content": "Però conosco solo Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "Questo perché finora le tue avventure si sono limitate all'area di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110109,
					"content": "Tutto ciò sta per cambiare. Presto potrai esplorare il resto del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2211102,
