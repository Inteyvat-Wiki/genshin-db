			},
			"dialogs": [
				{
					"id": 761360301,
					"content": "(Forse <color=#FFCC33FF>Jahoda</color> vuole esaminare il baule...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761360302
					]
				},
				{
					"id": 761360302,
					"content": "Eheh... Vediamo un po' quanto abbiamo guadagnato di recente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360303,
					"content": "Il capo aveva detto di volermi dare un bonus. Direi che posso prendermelo da sol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360304,
					"content": "Eh? Dove sono i soldi? Qui c'è soltanto un pezzo di carta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360305,
					"content": "\"Mia cara Jahoda, il tuo bonus non si trova in questa scatola. Assicurati di richiuderla per bene.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360306,
					"content": "Pfff, sta cercando di spaventarmi di nuovo. Forse c'è uno scomparto segreto, da qualche parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360307,
					"content": "Non c'è nessuno scomparto segreto. Il tuo bonus si trova qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360308,
					"content": "Oh, grazie, capo. Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360309,
					"content": "WAAAH! CAPO!!! S-S-S-stavo solo... contando i contanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360310
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360310,
					"content": "Mi metto subito al lavoro, immediatamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360311,
					"content": "Ferma lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360312
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360312,
					"content": "Sissignora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360313
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360313,
					"content": "Chiudi bene la scatola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360314
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360314,
					"content": "Sissignora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761360315,
					"content": "Adesso puoi andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761360316
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761360316,
					"content": "Sissignora!",
					"roleType": "TALK_ROLE_NPC",
