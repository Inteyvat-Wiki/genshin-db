			"dialogs": [
				{
					"id": 790590101,
					"content": "Questa è una scena tagliata dello spettacolo \"Il pellegrinaggio in Oriente\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790590102,
					"content": "L'idea originale ruota attorno alla storia di un pellegrino, che compie un viaggio verso oriente da Fontaine alla Città di Sumeru per trovare un'umile saggezza presso la Casa di Daena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790590103,
					"content": "Questa scena mostra il pellegrino mentre salva il Maestro delle trasformazioni terrene dal finire schiacciato da un macigno gigantesco, e come le loro strade si uniscano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790590104,
					"content": "Sfortunatamente, gli Eidolon di Hydro che recitavano le parti del pellegrino e del Maestro delle trasformazioni terrene sono spariti entrambi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790590105,
					"content": "Se soltanto qualcuno potesse <color=#00E1FFFF>riportarli indietro</color> e immortalare le prove dal macigno gigante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
					],
					"speakerTitle": "Appunti di scena"
				}
			]
		},
