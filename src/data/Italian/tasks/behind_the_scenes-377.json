			},
			"dialogs": [
				{
					"id": 3770201,
					"content": "Sei qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770202,
					"content": "#Aspetta, ma tu sei {NICKNAME}...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770203,
						3770204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770203,
					"content": "...Jean?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				},
				{
					"id": 3770205,
					"content": "Beh, per prima cosa, ho contattato varie persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770206,
					"content": "In secondo luogo, è qui solo come Jean, non come Gran Maestra Reggente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770207
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770207,
					"content": "#Una Jean che non vedresti mai, neanche in veste di Cavaliere Onorari{F#a}{M#o}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770208,
					"content": "Che sorpresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770209,
					"content": "Ho sentito della Lira sacra, ma non avrei mai sospettato di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770210,
					"content": "E così, il suono della Lira sacra può purificare Terrore alato e farlo tornare alla normalità... È vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770211
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770211,
					"content": "#Esattamente! {NICKNAME} sta facendo del suo meglio per tentare di risolvere la questione di Terrore alato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770212,
					"content": "Ecco l'asso dei Cavalieri di Favonius di cui parlavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770213,
					"content": "Mi sento come se stessimo infrangendo la legge...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770214,
					"content": "So bene che è difficile credere a questa assurda spiegazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770215,
					"content": "Possiamo chiedere al bardo di suonare di nuovo per provare a persuadere....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770216,
					"content": "Vi credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770217
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770217,
					"content": "A persuadere la nostra testarda coman... Eh? Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770218,
					"content": "Non trovo alcun motivo che giustifichi il tradimento di Dvalin, dato che in passato era addirittura uno dei Quattro Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770219
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770219,
					"content": "Se è stato avvelenato nella battaglia per Mondstadt così tanto tempo fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770220,
					"content": "...e poi corrotto dal Mago dell'Abisso al suo risveglio... non possiamo sicuramente incolparlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770221,
					"content": "In qualità di Gran Maestra Reggente, ovviamente non posso dichiarare pubblicamente una cosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770222
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770222,
					"content": "La pressione diplomatica dei Fatui ci impedisce di trovare una risoluzione pacifica al problema riguardante Terrore alato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770223
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770223,
					"content": "La gente penserebbe che io non capisca più la gravità della situazione. Ecco perché mi è possibile parlarne solamente in privato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770224
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770224,
					"content": "Bah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770225,
					"content": "È uno dei motivi per cui non mi piacciono i Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770226,
					"content": "#Quello che mi stupisce è che tu creda così facilmente a un{F#a}{M#o} stranier{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770227,
					"content": "#Mio attento e meticoloso <color=#00E1FFFF>superiore</color>, anche tu ti fidi di {M#lui}{F#lei}. Non è così, signore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770228
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770228,
					"content": "Ti ho già detto di non chiamarmi \"signore\"... Lascia stare, non ci capiterà poi così spesso di lavorare insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770229,
						3770230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770229,
					"content": "\"Signore\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770231,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770232
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770232,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770233
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770233,
					"content": "Cavoli! Ehm... Questo sì che è imbarazzante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770234,
					"content": "Ho una vaga idea di dove si trovi la Lira sacra celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770235,
					"content": "(Wow! È davvero brava a cambiare argomento...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770236
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770236,
					"content": "Il conflitto tra Mondstadt e Snezhnaya nasce dallo scontro tra le sette nazioni e i rispettivi dèi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770237
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770237,
					"content": "I Fatui del Dio di Cryo sembrano puntare ai poteri del Dio di Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770238,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770239,
						3770240
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770239,
					"content": "Quindi vogliono prendere il controllo delle difese di Mondstadt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770241,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770242
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770242,
					"content": "Se i Cavalieri di Favonius impedissero pubblicamente un attentato alla sicurezza di Dvalin, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770243,
					"content": "L'unico modo per influenzare i poteri del Dio di Anemo è quello d'impossessarsi della Lira sacra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770244,
					"content": "I Fatui sono giunti a Mondstadt in gran numero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770245
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770245,
					"content": "Sono già riuscito a... estrapolare qualche informazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770246
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770246,
					"content": "Stando a quello che dice Diluc, la Lira sacra non si trova nel Grand Hotel Goth.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770247,
					"content": "Non credo vogliano lasciare un oggetto rubato in un luogo in cui potremmo trovarlo così facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770248
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770248,
					"content": "Paimon capisce. Non vogliamo sicuramente fare una scenata, altrimenti potremmo causare un grosso incidente diplomatico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770249,
					"content": "Bah, questa è la diplomazia tra le sette nazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770250
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770250,
					"content": "#Stranier{F#a}{M#o}, sei pront{F#a}{M#o} ad andare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770240,
					"content": "Quindi vogliono uccidere Dvalin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770230,
					"content": "(Fingi di non aver sentito...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770204,
					"content": "Perché la Gran Maestra Reggente è qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				}
			]
		},
