				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Piccola Que'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010701,
					"content": "A dire la verità, sono per la tua gola.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "#Ehm! {F#Mia cara amica}{M#Mio caro amico}, eviterei di...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010703,
					"content": "Stai dicendo che sono debole? Oh, quindi pensi che basti il più fievole soffio di vento per farmi venire mal di gola!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010704,
					"content": "Beh, per fortuna i Qingxin non andranno sprecati... Perché servono anche per il mal di testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010705,
					"content": "Ascolta, Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010706,
					"content": "Andiamo, mettiti al riparo dal vento e troviamo un posto dove possa stenderti! Ti preparerò un bel tè caldo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010707
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010707,
					"content": "Quanto a te... Prendi questa ricompensa e sparisci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Que'er"
				}
			]
		},
		{
			"id": 2270108,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
