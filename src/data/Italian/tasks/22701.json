			"dialogs": [
				{
					"id": 227010101,
					"content": "#Ferm{F#a}{M#o} lì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010102,
					"content": "Dalla sicurezza nella postura e nel modo di camminare, deduco che siamo spiriti affini, praticanti delle arti marziali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270102,
			"completionStepIds": [
				2270101,
				2270106
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270101",
							"2"
						],
						"stepId": 2270101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "Cosa vuoi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "Ehi! Mostra un po' più di rispetto quando parli con lui, chiaro?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010203,
					"content": "Non c'è bisogno di agitarsi... Sono stato io a iniziare la conversazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010204,
					"content": "Tsk! Va bene, basta che non siano degli altri buoni a nulla in cerca di Adepti che vogliono rubarci il posto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010205,
					"content": "#Sì, bene, grazie per l'interessamento... Penso che andrà tutto bene. Ora... Perché non ti prendi un po' di meritato riposo mentre parlo con {F#la nostra nuova amica}{M#il nostro nuovo amico}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010206,
					"content": "#Ma... Non {F#le}{M#gli} dirai nulla che non diresti davanti a me, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010207,
					"content": "Finirei solo per annoiarti, non è davvero nulla che ti possa interessare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010208,
					"content": "Tsk, va bene, ho capito l'antifona, vuoi parlare di nuovo del clan Guhua... Chiaro. Se non vuoi che ascolti, ti lascerò in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010209,
					"content": "#{F#Amica mia}{M#Amico mio}, vieni con me. Così potremo fare due chiacchiere come si deve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
