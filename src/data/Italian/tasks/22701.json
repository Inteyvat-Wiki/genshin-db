				"points": []
			},
			"dialogs": [
				{
					"id": 227010501,
					"content": "#Sei tornat{F#a}{M#o}! Riguardo alla questione che ti ho affidato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010502,
					"content": "Ho raccolto i fiori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "#Perfetto, sono più che sufficienti. Grazie mille, {F#amica mia}{M#amico mio}, accetta questo piccolo dono in cambio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010504,
					"content": "Eh? A cosa servono tutti questi Qingxin? Oh, no! Hai di nuovo mal di testa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Que'er"
				}
			]
		},
		{
			"id": 2270106,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu",
					"Piccola Que'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "Sì, esatto! Sono per il suo mal di testa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "Ma sarei andata volentieri io a prendere le medicine che ti servivano... Che bisogno c'era di chiedere aiuto a qualcun altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010603,
					"content": "E poi non sappiamo nulla di loro o da dove arrivano, e se...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010604,
					"content": "Basta, Que'er. Ci hanno aiutati, no? Non abbiamo niente contro di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010605,
					"content": "Grazie ancora. Per favore, accetta questa ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010606,
					"content": "Sì, prendi e continua per la tua strada... Ha mal di testa, meglio non trattenerlo qui fuori al freddo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "Piccola Que'er"
				},
				{
					"id": 227010607,
					"content": "Presto, mettiti al riparo dal vento! Ti preparerò un bel tè caldo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccola Que'er"
				}
			]
		},
		{
			"id": 2270107,
			"completionStepIds": [
				2270105
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2270105",
							"2"
						],
						"stepId": 2270105,
						"stateName": "QUEST_STATE_UNFINISHED"
