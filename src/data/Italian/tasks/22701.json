			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "Perfetto, qui andrà benissimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010402,
					"content": "Cosa sta succedendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "*sospira* Si tratta di lei... della Piccola Que'er, la mia \"sorellina\". Siamo sempre stati inseparabili nelle arti marziali, come una forma con la sua ombra... e le sue abilità non sono in alcun modo inferiori alle mie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010404,
					"content": "Siamo venuti qui in cerca della guida degli Adepti, ma il viaggio è stato arduo, e Que'er non smette mai di parlare... Pochi giorni fa ha preso freddo e ora ha mal di gola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010405,
					"content": "Sembri davvero forte... e vorrei chiederti di aiutarci. Se riuscissi a scalare questa montagna e a raccogliere 3 Qingxin che si trovano in cima, potrei usarli per fare un infuso e dare un po' di sollievo alla gola dolorante di Que'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010406,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "#Grazie {F#amica mia}{M#amico mio}. Que'er è un tipo irrequieto, e non oso lasciarla sola per andare in cerca di medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010408,
					"content": "Perché lo stai facendo a sua insaputa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "So che potrebbe sembrare sciocco, ma Que'er ha uno spirito esuberante e non accetta di sentirsi in svantaggio rispetto agli altri, quali che siano le circostanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010410,
					"content": "Se proponessi di cercare una medicina per lei mentre ci ascolta, rifiuterebbe senza pensarci due volte. Quindi sono costretto a farlo di nascosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010411,
					"content": "Inoltre, non oserei lasciarla da sola mentre vado in cerca di medicine. È per questo motivo che ho bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2270105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
