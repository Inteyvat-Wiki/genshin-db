				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140401,
					"content": "Dovrebbero bastare. Aspetta qui, vedrò cosa posso fare con questi ingredienti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140402,
					"content": "Fatto. Però non mi sembra diverso dai piatti che preparo di solito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140403,
					"content": "Porta il piatto a Xudong. Spero che questo risolva il suo problema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				}
			]
		},
