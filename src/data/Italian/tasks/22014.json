					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140601,
					"content": "Questi germogli di bambù hanno un bell'aspetto. Ne raccoglierò alcuni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140602,
					"content": "Eh? Sei tu. Che cosa ci fai qui? Vuoi che ti prepari di nuovo qualcosa di delizioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140603,
					"content": "Beh, avrei bisogno del tuo aiuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "Ah. Preparare ingredienti di Inazuma con le tecniche di Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140608,
					"content": "Eheh, hai trovato la chef giusta! Ho sentito parlare di una tecnica di Inazuma in cui impani gli ingredienti nella farina e poi li friggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140609,
					"content": "Si chiama tempura e viene servita con una salsa speciale in cui intingere i bocconi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140610,
					"content": "Mi interessava molto la salsa, quando ho provato a preparare la tempura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140615,
					"content": "Ne ho provati così tanti: nettare del Malefiore, Fiorardente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140611,
					"content": "È a base di bava di Melmoso, per caso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "No, no. La bava di Melmoso non è appropriata per questo piatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140616,
					"content": "Però preferisco aggiungere la polvere di ali di Cicin di Electro per dare una consistenza più complessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140613,
					"content": "Ti scrivo la ricetta, casomai dovessi dimenticarla. Così potrai mostrarla a Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140614,
					"content": "*sospira* Mi piacerebbe poter andare a Inazuma. Devono esserci tanti ingredienti che ancora non ho utilizzato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140604,
					"content": "Hai reagito proprio come lo chef Mao...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "#Ah, sei andat{F#a}{M#o} al ristorante? Mmmh. Ora che ti vedo di nuovo, non sembra che tu sia qui per mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140606,
					"content": "Stai avendo problemi culinari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "Xiangling"
				}
			]
		},
