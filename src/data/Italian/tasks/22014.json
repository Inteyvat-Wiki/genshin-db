			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "#Ciao viaggiat{F#rice}{M#ore}. Che bello rivederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140102,
					"content": "Posso fare qualcosa per te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "Ricordi che ti ho promesso un pasto? Sto ultimando i preparativi proprio ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140106,
					"content": "Abbiamo raccolto ingredienti freschi ovunque per preparare un ottimo pasto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140107,
					"content": "Ho quasi tutti gli ingredienti, quindi sto provando a capire come cucinarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140108,
					"content": "Dove sono Julie e Parvaneh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "Beh, Parvaneh è in giro a rintracciare altri ingredienti per il condimento supremo che voleva preparare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140110,
					"content": "Ha portato Julie con sé... Hanno detto che non si sarebbero allontanate molto dalla città, quindi non preoccuparti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140111,
					"content": "Però mi serve il tuo aiuto per una cosa. Anche se ho già molti ingredienti freschi, non ho... l'ispirazione necessaria per fare il salto di qualità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140112,
					"content": "Guarda qui. Alghe... ganoderma marino e... ehm, fiore di sakura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140113,
					"content": "Sono piuttosto freschi, ma non so proprio da dove iniziare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140114,
					"content": "Volevo chiedere consigli a uno chef locale qui a Inazuma, ma così facendo cucinerei la solita roba del posto e non qualcosa di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140115,
					"content": "Così ho pensato di usare gli ingredienti di Inazuma e lo stile degli chef di Liyue, per creare qualcosa di davvero entusiasmante e nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140116,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti andare a Liyue e consultarti con lo chef Mao del Ristorante Wanmin per conto mio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140117,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "Ti ringrazio molto. Io aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140124,
					"content": "Spero che lo chef Mao abbia qualche idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140119,
					"content": "Vuoi un po' di badabim-badabum, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "Badabim-badabum? Che cos'è? Intendi forse... una specie di sensazione di meraviglia davanti al cibo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140121,
					"content": "Sarebbe fantastico se riuscissi a trovare una ricetta che facesse quell'effetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140122,
					"content": "Ma non conosco nessuno con una ricetta del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140123,
					"content": "Comunque, ti prego di andare prima a parlare con lo chef Mao per conto mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220140104,
					"content": "Mi vuoi offrire il pasto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "Ahahah, è esattamente per quello che mi dedico ai preparativi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201402",
							"2"
						],
						"stepId": 2201402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "#Eh? Viaggiat{F#rice}{M#ore}, che cosa ci fai qui? Vuoi che ti prepari di nuovo qualcosa di delizioso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140202,
					"content": "A dire il vero sono qui per chiederti un consiglio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "Xudong è andato a Inazuma per cucinare? È davvero un tipo determinato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140204,
					"content": "Lo conosci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "Più o meno. Un tempo eravamo chef rivali, poi siamo... arrivati a un'impasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140206,
					"content": "Aveva detto di voler viaggiare per il mondo alla ricerca di un salto di qualità... Non pensavo che l'avrebbe fatto davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140207,
					"content": "Però sembra che sia arrivato a un punto morto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140208,
					"content": "Sai dirmi cosa potrebbe aiutarlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "Non garantisco che possa funzionare, ma ci proverò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140214,
					"content": "Alghe... ganoderma marino e... fiore di sakura? Sono ingredienti strani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140215,
					"content": "Forse con le alghe e il ganoderma marino potrei creare una ricetta... ma mi servirebbero degli altri ingredienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140216,
					"content": "#Viaggiat{F#rice}{M#ore}, potresti andare a raccogliere del peperoncino di Jueyun e del pollame?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140217,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "Grazie. Portameli quando li avrai trovati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140219,
					"content": "Ah, ingredienti classici...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "Ahahah, sicuramente lo sono. Sono anche difficili da sbagliare. Portameli quando li avrai trovati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140221,
					"content": "Detto questo, non so davvero come cucinare i fiori di sakura... Come li preparano gli chef di Inazuma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140210,
					"content": "Forse Xiangling sa come risolvere il suo problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "Xiangling... Giusto, è sempre stata una chef creativa. Forse potrebbe trovare lei la soluzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140212,
					"content": "Ma adesso è al Villaggio di Qingce a raccogliere germogli di bambù, quindi non c'è. Ci vorrà un po' di tempo per trovarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "Chef Mao"
				},
				{
					"id": 220140213,
					"content": "Xudong starà aspettando con ansia. Vediamo se posso risolvere io il suo problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Chef Mao"
				}
			]
		},
