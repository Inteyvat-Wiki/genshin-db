			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "Oh, Nora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580902,
					"content": "Sei tu che ti occupi di lei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "Sì, per vari motivi sua madre è... lontana da casa. Nel frattempo, mi prendo cura io di lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580904,
					"content": "Mi occupo anche di altri bambini che hanno bisogno di qualcuno che si prenda cura di loro. Fa parte del mio dovere di suora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580905,
					"content": "È come se, all'improvviso, avessi una nuova famiglia composta da bambini. Si comportano bene, e vanno anche molto d'accordo con Glory.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580906,
					"content": "Timmie è quello di cui mi sono occupata più a lungo. Ha persino iniziato a chiamarmi mamma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580907,
					"content": "Parlami del padre di Nora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "Suo padre è Patton. Il suo alcolismo ha causato gravi problemi in casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580909,
					"content": "La Chiesa e i Cavalieri di Favonius l'hanno avvertito molte volte, ma non ha mai cambiato atteggiamento. Alla fine, è stato patron Diluc ad agire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580910,
					"content": "Convinto che Patton non fosse nelle condizioni di prendersi cura di Nora e che avesse bisogno di tempo per riflettere, sorella Victoria l'ha affidata alle cure della Chiesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580911,
					"content": "Ma, quando Nora crescerà, la scusa che le propiniamo sempre, ovvero: \"papà è impegnato col lavoro e ha bisogno di tempo per sé\", non reggerà più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580912,
					"content": "E persino i denti di leone dell'Archon di Anemo non arrivano così lontano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
