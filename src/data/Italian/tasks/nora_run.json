			"dialogs": [
				{
					"id": 200580301,
					"content": "Ci hai messo pochissimi minuti a volare fin lì, esattamente {ChallengeCurrValue10}! Fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580302
					],
