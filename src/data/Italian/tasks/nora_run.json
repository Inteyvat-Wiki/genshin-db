					"nextDialogs": [
						200581103
					]
				},
				{
					"id": 200581103,
					"content": "Sììì! Diventerò grande più in fretta che posso, così, quando papà finirà di lavorare, potrà giocare con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
