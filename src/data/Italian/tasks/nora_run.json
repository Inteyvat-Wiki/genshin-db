			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580202,
					"content": "Perché vuoi andare lassù?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "La zia Grace dice che, se vuoi dire un segreto a qualcuno, devi dirlo a un dente di leone e poi liberarlo nel vento... L'Archon di Anemo porterà i semi di dente di leone e il segreto che hai detto alla persona che desideri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580204,
					"content": "E più sarà alto il luogo da cui li lascerai andare nel vento, più velocemente il tuo messaggio arriverà a quella persona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580205,
					"content": "Una volta, Glory ha ingaggiato un avventuriere per arrampicarsi sulla statua e lanciare dei semi di dente di leone da parte sua. Solo pochi giorni dopo, Godwin le ha risposto con una lettera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580206,
					"content": "Ho un segreto da raccontare a papà, e ho già un dente di leone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580207,
					"content": "Ma la zia Grace non mi permette di farlo. Dice che potrò tornare a vivere col mio papà quando sarò cresciuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580208,
					"content": "Vorrei esistesse un modo per crescere più in fretta... Ci sto provando più che posso, ma sono ancora così bassa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580209,
					"content": "Ah, sì, ti vedo sempre volare per la città. Puoi insegnarmelo? Come fai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580210,
					"content": "Certo, te lo mostro subito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "Eheh, evviva! Io resto qui a guardare, almeno questo posso farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580212,
					"content": "Vuoi volare con me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "Non posso! La zia Grace si infurierebbe se mi vedesse fare una cosa simile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
