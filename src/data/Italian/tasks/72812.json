			"dialogs": [
				{
					"id": 728120201,
					"content": "Bene, è tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120202,
					"content": "Non... mi sono mai sentito così stanco. La storia è sempre stata così complessa...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120203,
					"content": "Così impari a non definire subito i dettagli. Senza dei paletti, i vari elementi finiscono per scontrarsi l'uno con l'altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120204,
					"content": "Quando questo accade, si finisce per perdere il controllo della trama. Ti sfiancherai a prescindere da quello che scrivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120205,
					"content": "#*sospira* E va bene... Non ho più le forze per ribattere. Viaggiat{F#rice}{M#ore}, grazie per il tuo... aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120206,
					"content": "Mi sa che ho imparato molto da questa storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120207,
					"content": "Ecco, come segno della mia gratitudine. Mi rimetterò al lavoro a breve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120208,
					"content": "Mmmh, dettagli o narrativa... Cos'è più importante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
