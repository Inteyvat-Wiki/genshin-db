				]
			},
			"dialogs": [
				{
					"id": 740640101,
					"content": "Hai due opzioni: o trovi un modo per rimuoverlo, o scopri chi è stato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640102
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640102,
					"content": "Facile a dirsi... Ho provato tutti i tipi di pulitori, senza successo. Se ha bisogno di qualcosa di più forte... Dobbiamo provare con il Fantasma di Hydro Vialamacchia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640103
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640103,
					"content": "Fantasma di Hydro Vialamacchia? Vuoi forse fare un buco nella parete?! Ci ritroveremo a dormire con i pesci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640104
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640104,
					"content": "E allora dovremo trovare il colpevole. Ma non sappiamo proprio chi possa essere stato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640105
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640105,
					"content": "Cosa c'è che non va? C'è qualcosa che possiamo fare per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640106,
					"content": "Beh... Vedi quel segno sul muro? I graffiti sono vietati all'interno di Forte Méropide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640107
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640107,
					"content": "Abbiamo provato di tutto, ma non riusciamo ancora a rimuoverlo, per cui se potessimo almeno capire chi è stato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640108
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640108,
					"content": "Aspetta, un attimo solo. Ora che ci penso, abbiamo degli indizi e anche degli indiziati. Clynes ha fatto menzione di un segno decifrabile secondo un metodo speciale, che si trova nell'Istituto di ricerca di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640109
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640109,
					"content": "Stai dicendo che è lo stesso tipo di segno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640110
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640110,
					"content": "Non mi interessava per niente quando me ne ha parlato, e perciò non gli ho chiesto altro. Forse potrebbe darci la soluzione, se fosse qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640111,
						740640113
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640111,
					"content": "Forse è lui il colpevole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640112
					]
				},
				{
					"id": 740640112,
					"content": "Certo, non possiamo escluderlo. Ma se fosse davvero così, eheh... Dovrebbe sapere il regolamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640115,
					"content": "#{NICKNAME} e Paimon, siete de{F#lle}{M#gli} avventurier{F#e}{M#i} con un ricco bagaglio di esperienze, avete qualche idea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640116
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640116,
					"content": "Aiutateci a trovare il colpevole dei graffiti, o portate qui Clynes, affinché ci dia un'occhiata. Mmm... Consideratelo un incarico ufficiale, per cui riceverete dei Coupon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640117
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640117,
					"content": "Va bene, se si tratta di un incarico ufficiale, allora possiamo provarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640118,
					"content": "Grazie. Nel frattempo, proverò a trovare altri metodi di rimozione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640113,
					"content": "Allora andiamo a prenderlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640114
					]
				},
				{
					"id": 740640114,
					"content": "Non so proprio dove si trova... Non lo vedo da un giorno intero. Davvero gli chiederemo di aiutarci? Ogni volta che gli chiedo qualcosa, perdo un po' di dignità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "Maupoil"
				}
			]
		},
		{
			"id": 7406402,
