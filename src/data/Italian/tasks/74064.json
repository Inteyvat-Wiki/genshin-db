			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maupoil",
					"Galvaryet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640201,
					"content": "Potremmo catturare una Blobbofoca e farla sputare sul segno... Funzionerà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640202
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640202,
					"content": "Dici sul serio? Ti hanno fatto stressare troppo? Stai ancora bene con la testa? Ti hanno dato troppi turni al lavoro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640203
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640203,
					"content": "Sto benissimo. È solo che non ho mai visto una Blobbofoca che sputa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640204
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640204,
					"content": "Devi prenderti un giorno di riposo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				}
			]
		},
		{
			"id": 7406403,
			"completionStepIds": [
				7406403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406403",
							"2"
						],
						"stepId": 7406403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clynes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640301,
					"content": "Eh? Quello non è Clynes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640302,
						740640304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640302,
					"content": "Salve, Clynes. Ci ritroviamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640303
					]
				},
				{
					"id": 740640303,
					"content": "Eh? Se Clynes è qui, allora quel graffito dev'essere opera sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640306,
					"content": "Eh? E che ci fate voi due qui...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640307
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640307,
					"content": "Di cosa state parlando? Non vi seguo proprio. Perché non chiedete a qualcun altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640308,
						740640310
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640308,
					"content": "Penso non sia stato lui, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640309
					]
				},
				{
					"id": 740640309,
					"content": "#Oh, è innocente, vero... Un attimo! Non farti ingannare, {NICKNAME}! Non c'è nessun altro qui! Dev'esser stato lui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640312,
					"content": "Va bene, avete vinto. Sono stato io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640313
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640313,
					"content": "*sospira* Avevo in programma di servirmene per fare due chiacchiere con dei vecchi amici, non mi aspettavo che vi presentaste voi due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640314
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640314,
					"content": "Fare due chiacchiere con degli amici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640315,
					"content": "Quella delle lettere in codice è una tecnologia sviluppata da Monsieur Butor, e sono in pochi a sapere come decifrarla, perfino nell'Istituto di ricerca di Fontaine. L'unico motivo per cui so come leggerla è perché era il mio benefattore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640316
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640316,
					"content": "Sfortunatamente, ci ha lasciati troppo presto, e la tecnologia delle lettere in codice non interessa più a nessuno. Per cui ho pensato che se qualcuno riuscisse a decifrarla, avremmo avuto un argomento in comune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640317
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640317,
					"content": "Oh, non voglio dire che non ci sia niente da dire fra di noi, ma ci sono molti argomenti che non abbiamo in comune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640318,
						740640321
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640318,
					"content": "Non sforzarti, non c'è niente da dire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640319
					]
				},
				{
					"id": 740640319,
					"content": "Quanta onestà! Una volta avevo un amico che era sincero come te, e che per via della sua onestà si è cacciato nei guai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640320
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640320,
					"content": "Ma a ripensarci, quelli sì che erano tempi felici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640325,
					"content": "E comunque, è questo l'unico motivo per cui siete qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640326
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640326,
					"content": "Paimon stava per dimenticarsene! Galvaryet e Maupoil ci hanno chiesto di scovare l'artefice dei graffiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640327,
					"content": "Costituisciti, per favore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640328
					]
				},
				{
					"id": 740640328,
					"content": "Costituisciti da solo! Non saremo clementi con te se resisti all'arresto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640329,
					"content": "*sospira*... Possiamo parlarne un attimo? Lasciamo stare Maupoil, non voglio cadere fra le grinfie di Galvaryet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640330
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640330,
					"content": "Sarebbe possibile, tipo, far finta di niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640331
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640331,
					"content": "Ma Maupoil l'ha detto chiaro e tondo: i graffiti sono proibiti nel Forte. Infrangere le regole è sbagliato, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640332,
					"content": "Parlando in senso molto ampio, le lettere in codice sul muro non sono poi così diverse dalle altre scritte che si trovano sulle pareti. Si tratta di semplici decorazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640333
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640333,
					"content": "#Facciamo così: vengo con voi, ma sarà {NICKNAME} a decidere se consegnarmi o meno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640334
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640334,
					"content": "Ovviamente, se scegliessi aiutarmi e salvarmi dalle grinfie di Galvaryet, ti ripagherei per la buona azione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640335
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640335,
					"content": "Il mio destino è nelle vostre mani. Andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640321,
					"content": "Mi dispiace molto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640322
					]
				},
				{
					"id": 740640322,
					"content": "Aha! Come vuoi che risponda a commenti del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640323
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640323,
					"content": "Lo so che in momenti come questo, dovrei essere gentile e dire qualcosa del tipo, \"sarebbe bello sentirti raccontare qualche avventura\", ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640324
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640324,
					"content": "Ma almeno in momenti del genere, ho deciso di essere onesto prima di tutto con me stesso. Non voglio sentire storie sul mondo esterno, tutto quello che voglio fare è ritrovarmi con vecchi amici. Dovrei essere io a dire che mi dispiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640310,
					"content": "Guardati intorno. Vedi qualcun altro qui a parte te?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640311
					]
				},
				{
					"id": 740640311,
					"content": "Esatto! Smetti di provare a ingannarci con i tuoi trucchetti da quattro soldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640304,
