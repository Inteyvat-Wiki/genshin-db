			"dialogs": [
				{
					"id": 740640401,
					"content": "Vedo che hai trovato Clynes. Ma... Hai trovato il responsabile dei graffiti? O almeno hai delle piste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640402
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640402,
					"content": "Beh, diciamo che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640403,
						740640413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640403,
					"content": "È stato Clynes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640404
					]
				},
				{
					"id": 740640404,
					"content": "Me l'immaginavo anche io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640405
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640405,
					"content": "Oh, e nel giro di due secondi, tutte le scuse che mi ero inventato sono diventate inutili. Adesso mi ritrovo sul patibolo, alla vostra mercé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640406
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640406,
					"content": "Le regole non si discutono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640407,
					"content": "Onestamente, mi preoccupa più la rimozione di questo segno, per pensare alla tua punizione c'è tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640408
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640408,
					"content": "Ti interessa la tecnologia delle lettere in codice? Ci vuole un po' per spiegarla, per cui magari puoi sederti e ascoltarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640409
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640409,
					"content": "No, non mi interessano le specifiche. Dimmi come si rimuove...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640410
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640410,
					"content": "Anche quella è una lunga storia. Dopotutto, vengono utilizzate vernici e tecniche speciali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640411,
					"content": "Ho altre mansioni da svolgere, quindi stringi. Oh... Per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640412
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640412,
					"content": "#Lasciamoli qui. {NICKNAME} e Paimon, ecco il compenso che vi è stato promesso. Grazie del vostro aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640413,
					"content": "Ci vuole un professionista. Clynes, prova a dare un'occhiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640414
					]
				},
				{
					"id": 740640414,
					"content": "Clynes, questo è il segno speciale di cui parlavi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640415
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640415,
					"content": "Fammi vedere... Mmm... Ah... Non sembra praticamente un ingranaggio? E un ingranaggio così grande da dove potrebbe venire, se non dall'Istituto di ricerca di Fontaine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640416
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640416,
					"content": "Viene dall'Istituto... proprio come te. Direi che il collegamento fra voi due è abbastanza evidente. Ammettilo, sei stato tu, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640417
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640417,
					"content": "Non puoi accusarmi così! Se un giorno sarò abbastanza fortunato da condividere un pasto con Galvana all'Hotel Débord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640418
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640418,
					"content": "Se sei ancora nel mondo dei sogni, te la do io la sveglia. E se pensi che i miei pugni non siano abbastanza forti, c'è anche Roussimoff che non vede l'ora di dartene un paio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640419
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640419,
					"content": "Calmati, sto facendo un esempio! Solo un esempio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640420
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640420,
					"content": "Dov'ero... Eh-ehm, comunque, se io e Galvana uscissimo insieme, pur essendo entrambi del Forte, non significa per forza che c'è un collegamento fra di noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640421
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640421,
					"content": "Vedi? Assolutamente nessun collegamento! Non c'è alcun collegamento fra me e questo segno, proprio come non c'è alcun collegamento fra me e Galvana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640422
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640422,
					"content": "Va bene, mi hai convinta. Anche se solo nella parte del rapporto fra te e la sorella.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640423
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640423,
					"content": "Significa che non ti ha convinta per niente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640424
					]
				},
				{
					"id": 740640424,
					"content": "Non abbiamo altro da dire a riguardo. Ora tocca a voi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640425,
					"content": "Beh, a ogni modo vi sono debitore. Il compenso che vi è stato promesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640426
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640426,
					"content": "#Vero! {NICKNAME} e Paimon! Mi ero quasi dimenticato del compenso! Anche se è un vero peccato che non siate riuscit{F#e}{M#i} a trovare il colpevole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640427
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640427,
					"content": "Ma sono sicura che Clynes saprà come rimuovere il segno! Lascerò fare il resto a lui e Galvaryet. Io, nel frattempo, ho altro da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		},
