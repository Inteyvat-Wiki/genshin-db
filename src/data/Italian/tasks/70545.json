			},
			"dialogs": [
				{
					"id": 705450101,
					"content": "Miao, miao miao... Miaaaaaao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450102,
					"content": "Miao! Miao miao miao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "Coniglietta"
				},
				{
					"id": 705450103,
					"content": "Mmh... Hanno ragione sia Coniglietta che Amber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450104,
					"content": "Ah, allora è così che stanno le cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450105,
					"content": "Acuta osservazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "In realtà neanche Paimon ha capito molto bene, ma di sicuro può dire che Amber e Coniglietta hanno raggiunto un accordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}, Paimon! Siete qui! Stavo giusto per venire a cercarvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450109,
					"content": "Ho saputo che state aiutando Valerina alla Rocca Gattosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450110,
					"content": "#Quest{F#e}{M#i} sono {NICKNAME} e la Paimon che conosco! Avete appena rimesso piede a Mondstadt e già state aiutando tantissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450111,
					"content": "#Io, {F#la Cavaliere Onoraria}{M#il Cavaliere Onorario}, compirò la mia missione, di qualunque natura essa sia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "A proposito, di cosa parlavate tu e Coniglietta poco fa? Sembravate divertirvi molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450114,
					"content": "Miao, miao miao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "Coniglietta"
				},
				{
					"id": 705450115,
					"content": "Oh! Stavo solo chiedendo a Coniglietta del tempo, e se secondo lei pioverà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450116,
					"content": "Eh? I gatti sanno queste cose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450117,
					"content": "Eheh, Lisa ha detto qualcosa del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450118,
					"content": "Secondo un libro che ha letto, i gatti sono molto sensibili all'umidità e non gli piace la sensazione di bagnato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450119,
					"content": "Perciò, se notano un aumento improvviso dell'umidità, cominciano a toccarsi nervosamente il muso e a leccarsi il pelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450120,
					"content": "Se un gatto ha un comportamento del genere, è un segnale che con ogni probabilità sta arrivando una tempesta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450121,
					"content": "Woah, Paimon non ne aveva idea! È fantastico! È bello imparare qualcosa di nuovo così per caso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450122,
					"content": "#Allora, {NICKNAME}, facciamo molta più attenzione ai gatti durante i nostri viaggi! In questo modo... non ci bagneremo dalla testa ai piedi per quegli enormi acquazzoni che scrosciano dalle nuvole quando sono scure come il carbone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450123,
					"content": "Buona idea, prestiamoci più attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "Inizialmente ero venuta qui per fare una domanda a Valerina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450126,
					"content": "Ma, mentre parlavo con lei, questa piccolina si è acciambellata vicino a me e ha sbadigliato profondamente! È stato dolcissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450127,
					"content": "Dato che si era dimostrata così affettuosa verso di me... Beh, anch'io dovevo dimostrarle quanto so essere socievole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450128,
					"content": "Così mi sono ricordata delle parole di Lisa e ho chiesto a Coniglietta che tempo farà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450129,
					"content": "Ma lei mi ha risposto strofinandosi il muso su di me, poi ha fatto ondeggiare la coda e infine si è accoccolata per terra vicino alla mia mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450130,
					"content": "*sospira* Ma quindi pioverà oppure no, nei prossimi giorni...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450124,
					"content": "Quand'è che non avrei prestato attenzione a dei teneri gattini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "La difesa dei gatti di Mondstadt è una delle mie molte responsabilità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "#Un secondo, mi sono {F#persa}{M#perso}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}