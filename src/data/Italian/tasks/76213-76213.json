			"dialogs": [
				{
					"id": 762130101,
					"content": "Eh? Sembra che questi libri siano d'intralcio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130102,
					"content": "State cercando un libro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130103,
					"content": "#Ah... Non esattamente. Eravamo solo un tantinellino {F#curiose}{M#curiosi} di sapere cosa ci fosse lì dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130104,
					"content": "Forse possiamo entrare da uno dei lati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "Non si può entrare lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130106,
					"content": "Sposto i libri, e sposto i libri. Se non è così, allora non è ancora completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130107,
					"content": "Non sto capendo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "Io sposto i libri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130109,
					"content": "E cosa vuoi dire con \"io sposto i libri\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "Se i libri non sono qui, allora devono essere stati spostati. Tutto quello che faccio è guardarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130111,
					"content": "Allora lascia che ci provi io con Dex.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "Vai dritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				}
			]
		},
		{
