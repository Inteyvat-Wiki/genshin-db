			"dialogs": [
				{
					"id": 762130201,
					"content": "Sogni, illusioni, bolle e ombre: perché affannarsi per afferrarli? Anche se studi i principi per mille anni, se mantieni la mente completamente immobile e \"non ancora nata\", non capirai e basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130202,
						762130212
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130202,
					"content": "Quindi... stai cercando un libro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
				{
					"id": 762130203,
					"content": "#Sei mai {F#stata}{M#stato} qui prima d'ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130204,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "Allora sei in grado di capire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130208,
					"content": "Capire... cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "Quando hai bisogno di dormire, dormi. Quando hai bisogno di capire, capisci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130211,
					"content": "Ora faresti meglio a tornare indietro. Quando il mondo finirà, lasciati andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130209,
					"content": "E come potrei capire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130205,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130206,
					"content": "No, mai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130212,
					"content": "Parli per enigmi. Me ne vado. Arrivederci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130213
					]
				},
				{
					"id": 762130213,
					"content": "Vai pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				}
			]
		}
	]
