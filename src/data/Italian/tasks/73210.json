			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "Mmmh... Paimon si chiede che tipo di tesoro troveremo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100502,
					"content": "Gli scaffali sono pieni di libriccini. Li sfogliate e scoprite che sembrano essere dei documenti ospedalieri, come cartelle cliniche o resoconti finanziari.\\nChiudi la porta con disappunto.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "Paimon pensava che all'interno ci fosse un tesoro speciale... Persino le casse e i barili di legno che troviamo nelle nostre avventure sono meglio! Almeno in quelle ci sono cavoli o pollame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100504,
					"content": "Eh? E questo cos'è? Sembra che sia caduto da qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100505,
					"content": "Lascia dare un'occhiata a Paimon... Forse ci condurrà a un tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100507,
					"content": "Uhm... L'Eleazar sembra davvero spaventoso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100508,
					"content": "Mmmh, cosa dice l'altro documento...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100510,
					"content": "Mmmh... Paimon non ci ha capito nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100511,
					"content": "Nemmeno io ho capito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100512,
					"content": "Paimon ha capito solo la parte che dice \"la voce di Dio mi guida\"... Significa che delle strane voci ci faranno da guida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100515,
					"content": "Potrebbe trattarsi di flussi d'acqua sotterranei o di creature...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "Sì! Chissà, potrebbero esserci delle rovine sotterranee! Ascoltiamo se c'è qualche suono e controlliamo più da vicino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100513,
					"content": "È il caso di dire \"beata ignoranza\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "Eh? Tu l'hai capito? Paimon ha afferrato solo la parte che dice \"la voce di Dio mi guida\"... Significa che delle strane voci ci faranno da guida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
