					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370201,
					"content": "Da dove sono spuntati tutti questi funghi...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370202,
					"content": "#Sono venut{F#a}{M#o} per rimuoverli!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "Ti ha inviato il signor Vahid per aiutarmi a liberarmi dei funghi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370206,
					"content": "Uhm, allora sono tutti tuoi. Ce ne sono fin troppi nel campo. Non è un lavoro per un vecchietto come me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370207,
					"content": "Come hanno fatto quei funghi a crescere così rapidamente...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370203,
					"content": "Mi dispiace per l'inconveniente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "Oh, i funghi? Beh, di sicuro non mancheranno nella mia dispensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
		{
			"id": 2203703,
			"completionStepIds": [
				2203703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
