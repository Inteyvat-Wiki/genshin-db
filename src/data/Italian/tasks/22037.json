			"dialogs": [
				{
					"id": 220370403,
					"content": "Li hai raccolti tutti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370404
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370404,
					"content": "Ecco, sono tutti qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370405
					]
				},
				{
					"id": 220370405,
					"content": "Ce n'erano tantissimi, ma sembra che tu li abbia raccolti proprio tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370406
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370406,
					"content": "#Grazie, giovinastr{F#a}{M#o}. Davvero non so cosa avrei fatto senza di te. Ecco, prendi, in segno della mia riconoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370407
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370407,
					"content": "Devo dire che quei vostri fertilizzanti sono incredibili. I funghi sono cresciuti in un baleno. Se solo anche le altre piante avessero fatto altrettanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370408
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370408,
					"content": "Quando ne avrò il tempo, verrò sicuramente a comprarne ancora per provarli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				}
			]
