				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "Va tutto bene... tutto bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090202,
					"content": "Cosa va bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "#Oh, sei tu, viaggiat{F#rice}{M#ore}. Che disastro è successo in città, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090204,
					"content": "Beh, almeno non ha avuto conseguenze gravi... E inoltre, è bello che tutte le bancarelle della città siano ancora aperte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090205,
					"content": "Altrimenti, cosa ne sarebbe stato di tutte quelle prelibatezze che mi piacciono tanto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090206,
					"content": "Ah, quindi parlavamo di cibo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "Ehi, non parlarne con sprezzo. Il modo più veloce per apprezzare una località è assaggiarne la cucina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "Hao"
				},
				{
					"id": 718090208,
					"content": "Mi viene fame al solo parlarne. Forse dovrei fare uno spuntino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hao"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180906",
							"2"
						],
						"stepId": 7180906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fan Er'ye"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "Più ascolto quest'opera e meno ci capisco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090302,
					"content": "C'è qualcosa che non va?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "#Oh, salve, viaggiat{F#rice}{M#ore}. Il problema è che, di recente, la Sala da tè Heyu ha prodotto delle nuove opere teatrali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090304,
					"content": "Sono... vivacissime, poco ma sicuro. Eppure non le capisco, né comprendo perché i giovani sembrino apprezzarle tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090305,
					"content": "Qual è la tua opinione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "Ottima domanda. Personalmente, non mi dispiacciono i vecchi classici. Ci sono abituato, in fondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090307,
					"content": "Ma al tempo stesso il Porto di Liyue sta andando incontro tanti cambiamenti... Le nuove opere sembrano allineate all'umore dominante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090308,
					"content": "*sospira* Tutte queste novità in così poco tempo... Le vecchie opere non vanno in scena da un po'. Cosa direbbe Rex Lapis... No, meglio non parlarne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fan Er'ye"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180909",
							"2"
						],
						"stepId": 7180909,
						"stateName": "QUEST_STATE_UNFINISHED"
