				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "#Che cos'ha appreso, mi{F#a}{M#o} buo{F#na}{M#n} signor{F#a}{M#e}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090402,
					"content": "Un po' di cose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "Invero? Ordunque, me ne parli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090404,
					"content": "Al molo sud ci sono molti cani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "Ottimo, ottimo. Una zona assai vivace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090406,
					"content": "Vicino alla Farmacia Bubu vivono molti fringuelli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "Fringuelli, sì... Un simbolo di placidità. Che immagine deliziosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090408,
					"content": "Alcuni pensano solo a mangiare...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "Ahah! Come biasimarli... Il cibo è una delle necessità e gioie primarie della vita, specialmente al Porto di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090410,
					"content": "Tutto molto affascinante. Ne prendo nota, potrebbe tornarmi utile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090411,
					"content": "Alcuni pensano che le cose stiano cambiando troppo velocemente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "Mmmh, c'era da aspettarselo, in effetti. Per taluni, è come se Liyue cangiasse pelle all'alba d'ogni nuovo giorno. Persino io arranco e fatico ad accettare ogni cambiamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090413,
					"content": "Codesta è una faccenda assai ampia... Temo che non basti un singolo poema a immortalarla. Malgrado ciò, io lo scriverò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090414,
					"content": "#Dovrebbe bastare, per ora. È stata cosa saggia affidarmi al suo aiuto, mi{F#a}{M#o} buo{F#na}{M#n} signor{F#a}{M#e}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090415,
					"content": "Ora potrò senza meno aggiungere un paio di nuovi componimenti alla mia prossima antologia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090416,
					"content": "#Oh, giusto. A parte alcuni beni materiali, ho preparato un piccolo presente per lei. Le sono grato per essere giunt{M#o}{F#a} in mio soccorso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090417,
					"content": "Una volta pubblicata la mia nuova antologia, potrà scambiare questo autografo con una copia gratuita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
