				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150801,
					"content": "#Sembra che tu sia interessat{M#o}{F#a} all'agenzia investigativa, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150802,
					"content": "#Posso diventare {F#investigatrice}{M#investigatore}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "#Vuoi diventare {F#investigatrice}{M#investigatore}? È un lavoro difficile, non lasciarti ingannare dai romanzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150804,
					"content": "Non ti imbatterai in inseguimenti emozionanti o in questioni di vita o di morte, durante le indagini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150805,
					"content": "Un'intera stanza piena di documenti, strade sterrate fangose e sospettati che lasciano pochissime tracce... Questo è quello che gli investigatori affrontano ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150806,
					"content": "Forse è difficile da capire solo dalle mie parole... Proprio qui ho un piccolo caso aperto. Perché non fai un po' di esperienza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150815,
					"content": "Il mio assistente, Ryuuji, è uscito a cercare indizi un po' di tempo fa e non è ancora tornato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150816,
					"content": "A questo punto, però, dovrebbe aver raccolto abbastanza indizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150817,
					"content": "Potresti andare a cercare Ryuuji per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150818,
					"content": "Non è in pericolo, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "Gli ho insegnato tutto. Anche se dovesse succedere qualcosa di imprevisto, dovrebbe essere in grado di gestirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150820,
					"content": "Quello che mi preme di più è sapere se abbia effettivamente trovato ciò che sto cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150826,
					"content": "Perciò, aspetterò tue notizie e, ovviamente, ti spetterà una paga. E poi... è la tua occasione per sperimentare la vita da investigatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150821,
					"content": "Non può esserci stato un incidente... vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "Non credo. Gli ho spiegato ogni dettaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150823,
					"content": "Anche se dovesse verificarsi un imprevisto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150824,
					"content": "Con le sue capacità, dovrebbe essere in grado di cavarsela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150825,
					"content": "Quello che mi preme di più è sapere se abbia effettivamente trovato ciò che sto cercando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150807,
					"content": "Sembra una bella seccatura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "Esatto. Gli investigatori sono esperti nel risolvere i problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150809,
					"content": "Gli inseguimenti emozionanti e le questioni di vita o di morte esistono solo nei romanzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150810,
					"content": "Un'intera stanza piena di documenti, strade sterrate fangose e sospettati che lasciano pochissime tracce... Questo è quello che gli investigatori affrontano ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150811,
					"content": "Una cosa vera nei romanzi però c'è: gli investigatori hanno sempre una serie di assistenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150812,
					"content": "Quindi, anche tu hai degli assistenti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150813
					]
				},
				{
					"id": 220150813,
					"content": "Certo. Il mio è impegnato proprio in questo momento. Perciò, ora... me ne servirebbe un altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150814
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150814,
					"content": "Te la sentiresti di aiutarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				}
			]
		},
