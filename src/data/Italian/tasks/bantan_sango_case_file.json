			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150205,
					"content": "Ah, tu sei l'assistente di cui parlava Sango?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150206,
					"content": "Mi stavi aspettando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "Beh... non esattamente. Sango ha semplicemente detto che qualcuno stava venendo ad aiutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150208,
					"content": "Ehi, cosa state facendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150209,
					"content": "Quelli non sono Cacciatori di tesori? Perché sono così vicini alla città?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150210,
					"content": "#Ryuuji, cosa ci fai qui? E quest{F#a}{M#o} stranier{F#a}{M#o} sospett{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150211,
					"content": "Parli con me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "#Sì, sei l'unic{F#a}{M#o} stranier{F#a}{M#o} qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150215,
					"content": "Va bene, non facciamo i puntigliosi. Ryuuji, cosa ti porta qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150216,
					"content": "Stavo seguendo una persona sospetta qui, secondo le istruzioni di Sango, ma poi mi sono imbattuto in dei Cacciatori di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150217,
					"content": "#Sango ha ingaggiato {F#la}{M#il} viaggiat{F#rice}{M#ore} come assistente. Abbiamo scacciato i Cacciatori di tesori insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150218,
					"content": "Capisco... Ma perché c'erano dei Cacciatori di tesori qui vicino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150219,
					"content": "Ryuuji, hai appena detto che stavi seguendo delle persone sospette... Ehi! Hai seguito i Cacciatori di tesori dall'interno della città?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150220,
					"content": "Credo di sì. Sango si stava occupando di un caso di furti seriali. Io stavo setacciando la città in base alle sue ipotesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150221,
					"content": "Poco dopo, ho scorto un uomo sospetto vicino Hanamizaka, è andato via in stato di panico dopo che gli ho fatto qualche domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150222,
					"content": "L'ho seguito fuori dalla città, e poi sapete tutti cos'è successo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150223,
					"content": "Mmmh... Ryuuji, come mai tutto d'un tratto sei così bravo a parlare? Questa mi è nuova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150224,
					"content": "Lavorare con Sango ti ha reso molto eloquente, vedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150225,
					"content": "Cosa ci fate voi due qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "Andou ha detto che c'era una persona bionda sospetta che si aggirava per la città, così siamo venuti a vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150227,
					"content": "Per questo ti abbiamo seguito, non pensavamo fossi l'assistente di Sango. Mi scuso per il malinteso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150232,
					"content": "Ah... Ryuuji, hai detto che hai trovato la persona sospetta in città, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150233,
					"content": "Corretto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150234,
					"content": "Come osa mettere le sue zampacce nella nostra città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150235,
					"content": "Sì. Ma se siamo solo... noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150236,
					"content": "(Perché improvvisamente gli mancano le parole?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "Mmmh... Però, possiamo a malapena scacciare uno o due Cacciatori di tesori con le nostre forze. Per liberarci totalmente di loro, abbiamo bisogno di voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150239,
					"content": "Se volete vedere le prove, potete andare in città a cercare Sango. Lei vi spiegherà tutto nel dettaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150240,
					"content": "Mmmh... Amano, andiamo a cercare Sango. Se ci sono davvero dei Cacciatori di tesori in città, dovremmo fare qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150241,
					"content": "Sì... sì, proprio così! Andiamo da Sango. Ryuuji, anche tu dovresti tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150242,
					"content": "Uuuh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150243,
					"content": "Torniamo indietro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150244,
					"content": "Ciò che hai appena detto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "Sango mi ha chiesto di dirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150246,
					"content": "Abbiamo fatto la nostra parte, ora torniamo indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150237,
					"content": "(Sembra essersi dimenticato cosa stava per dire.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "Quindi, anche voi stavate seguendo una persona sospetta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "Esatto. Anche se, la persona sospetta che stavamo seguendo, in realtà, sei tu. Ehm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150230,
					"content": "Andou ha detto che c'era una persona bionda sospetta che si aggirava per la città, così siamo venuti a vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150231,
					"content": "Per questo ti abbiamo seguito, non pensavamo fossi l'assistente di Sango. Mi scuso per il malinteso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150213,
					"content": "Sono l'assistente di Sango.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "L'assistente di Sango? Ora è tutto ancora più sospetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				}
			]
		},
		{
			"id": 2201503,
			"completionStepIds": [
				2201505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
