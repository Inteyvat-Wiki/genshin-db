			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150301,
					"content": "Signorina Sango, è vero quel che si dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150302,
					"content": "La serie di furti in città è davvero opera dei Cacciatori di tesori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150303,
					"content": "Esatto. Vi ho appena mostrato le prove, sono certa che grazie al vostro istinto professionale, l'abbiate già capito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150304,
					"content": "I Cacciatori di tesori... come osano! Non hanno alcun riguardo per noi, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150305,
					"content": "Amano! Torniamo indietro e facciamo rapporto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150306,
					"content": "Dobbiamo schierare le nostre pattuglie, non dobbiamo lasciare scampo a questi farabutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150307,
					"content": "Signorina Sango, possiamo prendere in prestito le prove? Ne abbiamo bisogno per convincere i piani alti ad agire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150308,
					"content": "Nessun problema, servitevi pure. Gestire i Cacciatori di tesori non fa parte delle responsabilità della nostra agenzia. Dovremo contare sulla polizia per questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150309,
					"content": "Stanne certa, non lasceremo sfuggire neanche un Cacciatore di tesori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150310,
					"content": "Grazie. E ora... dovrebbe essere tutto pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150311,
					"content": "#Pront{F#a}{M#o}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "Sì, i due doushin della stazione di polizia sono degli importanti \"assistenti\" ai fini della risoluzione di questo caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150316,
					"content": "Una volta che i doushin avranno schierato le loro pattuglie, i Cacciatori di tesori in città saranno in massima allerta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150317,
					"content": "Ryuuji, hai combattuto contro i Cacciatori di tesori nel luogo in cui ti avevo chiesto, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150318,
					"content": "#Sì, io e {F#la}{M#il} viaggiat{F#rice}{M#ore} li abbiamo combattuti e scacciati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150319,
					"content": "Mmmh... Bene, di sicuro avrete fatto abbastanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150320,
					"content": "Ora dobbiamo solo attendere la nostra opportunità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150321,
					"content": "#Grazie dell'aiuto, viaggiat{F#rice}{M#ore}. Ecco il tuo compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150322,
					"content": "Non so se ho davvero aiutato o no..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "#Non dire così, hai attirato l'attenzione di Andou essendo {M#uno}{F#una} stranier{M#o}{F#a}, e hai spinto Amano a inseguirti e incontrare Ryuuji...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150324,
					"content": "Ora hanno visto coi loro occhi la minaccia dei Cacciatori di tesori, il che li porterà a dispiegare un maggior numero di pattuglie in città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150325,
					"content": "Solo tu potevi rendere possibile tutto questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150326,
					"content": "Dopotutto, è stato molto più efficace lasciare che i doushin vedessero coi loro occhi i Cacciatori di tesori, piuttosto che spiegarglielo e basta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150327,
					"content": "Comunque, prendi. Chissà, magari un giorno mi servirà ancora il tuo aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150313,
					"content": "Cosa hai intenzione di fare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "Sono un'investigatrice, ho intenzione di risolvere il caso, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150315,
					"content": "I due doushin della stazione di polizia sono degli importanti \"assistenti\" ai fini della risoluzione di quel caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				}
			]
		},
