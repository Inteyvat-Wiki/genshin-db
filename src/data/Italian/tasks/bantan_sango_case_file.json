				"points": []
			},
			"dialogs": [
				{
					"id": 220150601,
					"content": "Non ho mai visto un investigatore a Liyue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150602
					]
				},
				{
					"id": 220150602,
					"content": "Liyue non ha bisogno di investigatori. Ho sentito parlare del valore che danno ai contratti, lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150603
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150603,
					"content": "E poi, hanno i Milleliti, che risolvono tutti i problemi, grandi e piccoli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150604,
					"content": "Anche se ci fosse un'agenzia investigativa, suppongo che chiuderebbe per mancanza di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
