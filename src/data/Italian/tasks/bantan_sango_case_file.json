			"dialogs": [
				{
					"id": 220150501,
					"content": "Non ho mai incontrato un investigatore a Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150502
					]
				},
				{
					"id": 220150502,
					"content": "Mondstadt... Oh, intendi la Città di Mondstadt. Ne ho sentito parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150503,
					"content": "Mondstadt è rinomata per due cose: il vino e la libertà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150504,
					"content": "Ahahah, quelle due cose sono complementari... Se ci fossero degli investigatori a Mondstadt, i loro affari andrebbero sicuramente a gonfie vele ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
