			},
			"dialogs": [
				{
					"id": 220150701,
					"content": "Ho conosciuto un solo consulente legale...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "Consulente legale? Ah, ne ho sentito parlare... è molto difficile avere a che fare con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150703,
					"content": "Non fanno altro che complicare problemi di per sé semplici. Prendono una cosa semplice, la rendono difficile e poi la trasformano in contratti confusionari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150704,
					"content": "Spero di non incontrarne mai uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201508,
			"completionStepIds": [
				2201501
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
