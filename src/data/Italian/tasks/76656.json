					"nextDialogs": [
						766562004
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562004,
					"content": "#{NICKNAME}, mentre rintracci gli altri robot, potresti fare caso a eventuali comportamenti anomali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562005
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766562005,
					"content": "Del tipo...?",
