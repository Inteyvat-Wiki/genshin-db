				},
				{
					"id": 766562002,
					"content": "Uuh, c'è la banda al completo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766562003,
					"content": "Di problemi non ne ho ancora avuti, finora, ma mi è venuta un'altra idea...",
