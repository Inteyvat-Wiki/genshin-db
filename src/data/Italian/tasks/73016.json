				"objectNames": [
					"Paimon",
					"Arabalika"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730161501,
					"content": "Fiuuu... Che spavento! Per fortuna Arabalika ci ha aiutato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161502,
					"content": "Arabalika te lo aveva detto. Paimon finirà nei guai se è imprudente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161503
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161503,
					"content": "E va bene, va bene, Paimon ha capito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161504,
					"content": "Le Guardie delle rovine sono qui per fare il proprio lavoro, in fondo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "Sì, le guardie dovrebbero tenere gli intrusi alla larga da qualcosa. Dopotutto, per loro siamo solo degli estranei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161506,
					"content": "#Nara {NICKNAME} e Paimon sono estrane{F#e}{M#i} a Vana, ma Arabalika no. Pezzo di ferro grosso dice cose strane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161507,
					"content": "Arabalika farà tornare il senno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161508,
					"content": "Wow... Paimon sarà saggia in futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161509,
					"content": "La considero una promessa, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "Certo! Da domani... Anzi, no, a partire da ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161511,
					"content": "#Solo Aranara possono risvegliare pietra qui. Nara {NICKNAME} e Paimon, Arabalika penserà al resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161512,
					"content": "Oooh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161513,
					"content": "Manca poco affinché la Macchina di Varuna venga risanata! Dopodiché, non ci saranno più tutte quelle spore nei Boschi di Apam... Solo a pensarci, a Paimon inizia a prudere il naso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161514,
					"content": "Macchina di Varuna purificherà acqua piovana, così non ci sarà più pioggia nera né tante spore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161515
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161515,
					"content": "Ma ci saranno ancora funghi cattivi. Paimon deve fare attenzione a non farsi mangiare dai funghi cattivi come Aranakula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161516
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161516,
					"content": "Sì... Paimon farà attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161517,
					"content": "#Non c'è più bisogno di Arabalika qui. Arabalika tornerà all'\"area di relax\" per cercare Arapandu. Nara {NICKNAME} e Paimon, verrete con Arabalika?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161518,
						730161520
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161518,
					"content": "Andiamo insieme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161519
					]
				},
