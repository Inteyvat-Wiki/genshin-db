			"dialogs": [
				{
					"id": 711209101,
					"content": "Ancora voi due?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Tigre seduta"
				},
				{
					"id": 711209102,
					"content": "Smettetela di ficcanasare in giro. Fate finta di non averci visto e noi faremo lo stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Serpente arrotolato"
				},
				{
					"id": 711209103,
					"content": "Cosa state sorvegliando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "#Indovinate per cosa siamo pagati, {F#amiche}{M#amici}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Serpente arrotolato"
				},
				{
					"id": 711209105,
					"content": "Cosa?! Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "Ahem! *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Serpente arrotolato"
				},
				{
					"id": 711209107,
					"content": "(Lo dirò solo a voi due, quindi non ditelo a nessuno... Dai, avvicinatevi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Serpente arrotolato"
				},
				{
					"id": 711209108,
					"content": "(Paimon è tutta orecchi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "È per sbarazzarsi di persone come voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Serpente arrotolato"
				},
				{
					"id": 711209110,
					"content": "Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "Ho sentito uno strano rumore provenire dall'interno della grotta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "Ho fatto una puzzetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Tigre seduta"
				},
				{
					"id": 711209113,
					"content": "Ah... già. Ha fatto una puzzetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Serpente arrotolato"
				},
				{
					"id": 711209114,
					"content": "Q-Quindi è tutto a posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
