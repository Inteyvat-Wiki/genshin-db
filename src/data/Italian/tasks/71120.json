			"dialogs": [
				{
					"id": 711200101,
					"content": "Ehi, alla larga! Questo è il territorio del capo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Tigre seduta"
				},
				{
					"id": 711200102,
					"content": "Uoh! Che cattivo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200103,
					"content": "Chi siete?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "Dipende da te. Se sei gentile, possiamo diventare amici. Ma se ficchi il naso dove non dovresti potremmo fartela pagare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Serpente arrotolato"
				},
				{
					"id": 711200105,
					"content": "#Dovresti sviluppare un cervello e tornare da dove sei {F#venuta}{M#venuto}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Tigre seduta"
				},
				{
					"id": 711200109,
					"content": "Siete dei tipi sospetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200110,
					"content": "#Sospetti? Ehi, ehi, siamo dei semplici portinai. Se c'è qualcuno che si comporta in modo sospetto, {F#quelle}{M#quelli} siete proprio voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Serpente arrotolato"
				},
				{
					"id": 711200111,
					"content": "Non importa, non abbiamo niente da dirti! Smettila di disturbarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tigre seduta"
				},
				{
					"id": 711200106,
					"content": "Chi è questo \"capo\" di cui parli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "Chi è il \"capo\"? Ahah! Se te lo dicessi, ti spaventeresti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Tigre seduta"
				},
				{
					"id": 711200108,
					"content": "#È per il tuo bene, {F#amica}{M#amico}! Lascia stare le questioni che non ti riguardano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Serpente arrotolato"
				}
			]
		},
		{
