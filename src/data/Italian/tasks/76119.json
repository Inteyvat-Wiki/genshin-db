			"dialogs": [
				{
					"id": 761190201,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190202,
					"content": "È stato troppo facile per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190203
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190203,
					"content": "Se vuoi tornare a giocare, cercherò di mescolare i cappelli più velocemente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190204
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190204,
					"content": "Paimon è curiosa... Esattamente, come hai fatto a giocare assieme a loro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190205,
					"content": "Non si vede nulla se non si usa il Kuuvahki; ma se lo si usa, risulta fin troppo facile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190206,
					"content": "Beh, posso aprire gli occhi, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190207
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190207,
					"content": "Oh, già. Paimon non ci aveva pensato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
