			"dialogs": [
				{
					"id": 761190101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190102,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190103,
					"content": "...Ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190104,
					"content": "Sembra che si stiano divertendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190105,
					"content": "Salve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190106,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190107,
					"content": "Salve anche a te, Luonnotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190108,
					"content": "È un gioco nuovo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "Sì. Ho visto delle persone giocarci coi propri amici usando i bicchieri all'Ammiraglia, così ho preso in prestito l'idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190110,
					"content": "Posizionavano una gemma sotto uno dei bicchieri, dopodiché mescolavano rapidamente questi ultimi sul tavolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190111,
					"content": "Una volta finito di mescolare, l'altro giocatore doveva indovinare sotto quale bicchiere si trovava la gemma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190112,
					"content": "Le Kuuhenki adorano volteggiare avvolte nella stoffa, così ho preso come riferimento il cappello della Maga e ho apportato qualche miglioria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190113,
					"content": "È adorabile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190115,
					"content": "Aspetta. Quindi sei andata all'Ammiraglia... Hanno capito che eri tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190116,
					"content": "Qualcuno me l'ha chiesto e io ho risposto: \"Oggi mi sono vestita da Dea della Luna. Le assomiglio, non è vero?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190117,
					"content": "Cavoli, hai sfruttato appieno lo stratagemma della Notte di Preghiera lunare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190118,
					"content": "E ti hanno creduto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "Beh... Non del tutto, ma dopo non mi hanno più rivolto la parola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190120,
					"content": "Forse la mia recitazione non era abbastanza naturale? La prossima volta mi eserciterò andando da un'altra parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190121,
					"content": "Paimon ha la sensazione che qualcuno abbia imparato tutte le lezioni sbagliate...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190122,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190123,
					"content": "Luonnotar vorrebbe che provassi a indovinare dove si nasconde. Ti va?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190124,
					"content": "Ci sto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "Allora, per iniziare, devi puntare 100.000 Mora. Sono le regole dell'Ammiraglia, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 761190126,
					"content": "Okay, quella è una lezione che avresti proprio dovuto saltare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
