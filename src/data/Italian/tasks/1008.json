				{
					"id": 10089901,
					"content": "Vi prego, aiutatemi a salvare mio fratello. Non so quale ambra l'abbia catturato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089902
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089902,
					"content": "So solo che siamo sempre stati sul <color=#00E1FFFF>sentiero che sale su per la montagna</color>. Quindi l'ambra sarà nelle vicinanze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089903
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089903,
					"content": "O potenti portavoce degli Adepti illuminati, salvatelo, vi supplico...",
