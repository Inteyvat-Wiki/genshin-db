			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li Ding"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080601,
					"content": "Grazie per aver salvato mio fratello, potenti portavoce degli Adepti illuminati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080602
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080602,
					"content": "Hai mai visto qui l'Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080603
					]
				},
				{
					"id": 10080603,
					"content": "Cosa? No... Come altri, anche io ho sentito dire che ce n'è uno che vive sul Monte Hulao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080604
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080604,
					"content": "Ma non credo che si mostrerebbe a persone come me. Proprio per nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080605
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080605,
					"content": "Per voi la cosa è diversa, siete portavoce degli Adepti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080606
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080606,
					"content": "A ogni modo, penso che abbiamo sostato fin troppo nel regno dell'Adeptus. Andiamo. Grazie, potenti portavoce degli Adepti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080607
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080607,
					"content": "Sì... Grazie, portavoce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080608
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10080608,
					"content": "Cavoli, sarebbe davvero utile essere portavoce degli Adepti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080609,
					"content": "Sembra che questo Adeptus abbia qualche problema di gestione della rabbia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080610,
					"content": "Ma noi non abbiamo fatto niente di male... Dovremmo passarla liscia... Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089601,
					"content": "Chi osa violare i confini delle mie montagne? Chi osa mettere in libertà i miei prigionieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10089602,
					"content": "Stupidi mortali, fatevi avanti e ricevete la vostra punizione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Formamontagne"
				}
			]
		},
		{
			"id": 100807,
			"completionStepIds": [
				100807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100807",
							"2"
						],
						"stepId": 100807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Formamontagne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080701,
					"content": "Osate violare i sacri confini del Monte Hulao, distruggere l'ambra della mia montagna e sottrarmi un prigioniero la cui libertà non vi appartiene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080702
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080702,
					"content": "L'ignoranza di quei ladri ha offeso gli Adepti... ma le vostre azioni sono persino peggiori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080703
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080703,
					"content": "Aspetta! Lasciaci spiegare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080704,
						10080706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080704,
					"content": "Ecco qui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080705
					]
				},
				{
					"id": 10080705,
					"content": "Un Sigillo del consenso? Non pensavo ne esistessero ancora nel regno dei mortali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080708,
					"content": "È un... Sigillo del consenso? Pensavo che non ne esistessero più nel regno dei mortali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080709
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080709,
					"content": "In origine, Rex Lapis li realizzò con le proprie mani per l'umanità. Erano pochi, e dopo migliaia di anni, ne sono rimasti ancor meno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080710
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080710,
					"content": "Parlate. Cominciate col dirmi cosa vi porta qui, dopodiché le vostre parole saranno soggette a riprova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080711
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080711,
					"content": "#È opportuno che siate completamente sincer{M#i}{F#e}. Liyue non è lontana, e mi costerebbe davvero poco smentirvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080712
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080712,
					"content": "Rex Lapis... ucciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080713
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080713,
					"content": "Durante il Rito della discensione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080714
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080714,
					"content": "Quale mortale al mondo, non solo a Liyue, commetterebbe un'azione tanto ripugnante? O forse dovrei chiedermi quale potere di questo mondo vorrebbe una cosa del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080715
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080715,
					"content": "Rex Lapis ha incaricato gli Adepti di proteggere Liyue, e noi abbiamo adempiuto al nostro dovere. Quando l'umanità ha prosperato, ci siamo progressivamente ritirati sulle montagne, in un atto di benevolenza nei confronti del genere umano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080716
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080716,
					"content": "Ma adesso... Rex Lapis non c'è più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080717
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080717,
					"content": "#Viaggiat{M#ore}{F#rice}, ho ascoltato le tue parole. Adesso so perché Scultore della luna ti ha mandat{M#o}{F#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080718
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080718,
					"content": "Mi occuperò di certe incombenze per le quali è richiesta la mia presenza, poi convocherò una riunione degli Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080719
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080719,
					"content": "Qualcuno mi spiegherebbe cosa c'entra l'ambra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080720
					]
				},
				{
					"id": 10080720,
					"content": "Ci pensa Paimon! Hai presente i poteri che gli Adepti hanno nelle storie dei libri? A quanto pare sono veri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080721,
					"content": "C'è scritto anche che le distese d'erba e i fiumi sono i capelli e la saliva degli Adepti... Mi sa che qualcosa del genere valga anche per l'ambra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080722,
						10080723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080722,
					"content": "Le gocce di pioggia sono lacrime degli Adepti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080724,
					"content": "Quando la smetterete di dire idiozie? L'ambra è prodotta da un fiore piantato qui da me, noto con il nome di Scalavette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080725
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080725,
					"content": "La pianta cresce quasi completamente sottoterra. Se la si calpesta, espelle l'ambra che intrappola l'intruso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080726
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080726,
					"content": "Gli Scalavette sono stati piantati per garantire la pace e l'inviolabilità di questa montagna dopo l'arrivo degli Adepti. Nel tempo, hanno tenuto lontane minacce e fastidi, ma hanno anche catturato prede davvero singolari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080727
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080727,
					"content": "Quindi l'ambra... è viva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080728,
					"content": "Proprio così. Ecco perché non mi concedo una partenza immediata. Alcuni innocenti rischiano di perdere la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080729
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080729,
					"content": "Pertanto, è necessario risolvere prima la questione. Il vostro commiato può invece avvenire rapidamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10080723,
					"content": "L'ambra potrebbe essere la cristallizzazione di... bleah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080706,
					"content": "È Scultore della luna che ci manda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080707
					]
				},
				{
					"id": 10080707,
					"content": "#Scultore della luna avrebbe scelto {M#un}{F#una} mortale come su{M#o}{F#a} portavoce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "Formamontagne"
				}
			]
		},
		{
