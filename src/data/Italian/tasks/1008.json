				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li Ding"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080201,
					"content": "Abbi pietà, prode Adeptus! Ti supplico... Abbi pietà di me e di mio fratello... Risparmia le nostre vite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080202
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080202,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080203
					]
				},
				{
					"id": 10080203,
					"content": "Chi siete? Cosa sta succedendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080204
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080204,
					"content": "Te l'abbiamo chiesto prima noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080205,
					"content": "Oooh! Avete attraversato incolumi i Monti di Jueyun... Può significare solo una cosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080206
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080206,
					"content": "#Siete portavoce degli Adepti, che vi hanno mandat{M#i}{F#e} a salvare me e mio fratello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080207
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080207,
					"content": "Ma che dice?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080208,
					"content": "Abbiate pietà, potenti portavoce degli Adepti illuminati! Vi supplico, salvateci... Io e mio fratello siamo venuti qui solo per rimediare alla povertà della nostra famiglia. Si dice che ci siano tesori nascosti nell'ambra del Monte Hulao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080209
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080209,
					"content": "Siamo stati sciocchi... Ma volevamo trovare qualche tesoro da vendere per sfamare i nostri cari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080210
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080210,
					"content": "Abbiamo risalito il <color=#00E1FFFF>sentiero su per la montagna</color>, ma poi l'ambra ha inghiottito mio fratello Li Dang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080211
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080211,
					"content": "Fuggendo sono arrivato qui, e ho capito che avevamo violato il territorio degli Adepti, e questa era la nostra punizione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080212
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080212,
					"content": "Non sapevo come salvare mio fratello, quindi ho cominciato a pregare gli Adepti affinché avessero pietà. E ora, finalmente, due portavoce giungono in mio soccorso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080213
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080213,
					"content": "Portavoce? No, ti sbagli... Anche noi cerchiamo gli Adepti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080214,
					"content": "Nooo, ditemi che siete portavoce degli Adepti... Vi prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080215
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080215,
					"content": "Non so quale ambra l'abbia preso... Dovete salvarlo! V'imploro, mi appello alla carità degli Adepti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080216,
						10080218
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080216,
					"content": "E va bene. Vado a vedere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080217
					]
				},
				{
					"id": 10080217,
					"content": "Grazie, grazie! Oh, potenti portavoce degli Adepti, giuro che non commetteremo mai più una simile sciocchezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080218,
					"content": "Ci hai parlato abbastanza del vostro errore, della situazione difficile e anche del tuo pentimento, basta così.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080219
					]
				},
				{
					"id": 10080219,
					"content": "#Wow, che parole! Quando parli così sembra di sentire un{M# vero}{F#a vera} portavoce degli Adepti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080220,
					"content": "#Ringrazio l'Adeptus del Monte Hulao e {M#i suoi}{F#le sue} portavoce! Non saremo mai più così sconsiderati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Ding"
				}
			]
		},
		{
			"id": 100806,
			"completionStepIds": [
				100806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
