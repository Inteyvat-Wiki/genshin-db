			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Li Ding"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10089701,
					"content": "Mio fratello mi ha detto tutto... Grazie per averlo salvato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089702
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089702,
					"content": "*sospira* La nostra famiglia vive di stenti... Quando abbiamo sentito le storie sui tesori nascosti del Monte Hulao, non avendo altre risorse, siamo venuti a cercarli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089703
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089703,
					"content": "Non abbiamo riflettuto abbastanza... Pensavamo di poterci intrufolare e portar via un bottino sufficiente a supportare la nostra famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089704
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089704,
					"content": "#Invece, l'Adeptus ci ha puniti per la nostra avidità. L'ambra mi ha inghiottito e, se non foste arrivat{F#e}{M#i} voi a salvarmi, chissà quando ne sarei uscito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089705
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089706,
					"content": "Portavoce?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089707
					]
				},
				{
					"id": 10089709,
					"content": "Ci hai parlato abbastanza del vostro errore, della situazione difficile e anche del tuo pentimento, basta così.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089710
					]
				},
				{
					"id": 10089705,
					"content": "#Ma l'Adeptus è stato clemente. Ha mandato {M#i suoi}{F#le sue} portavoce a salvarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089706,
						10089709
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089707,
					"content": "Sì! Voi due avete salvato mio fratello proprio mentre io invocavo il perdono dell'Adeptus, qui in cima alla montagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089708
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089708,
					"content": "Sono certo che siate portavoce degli Adepti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089710,
					"content": "#Wow! Sei proprio tagliat{M#o}{F#a} per il ruolo di portavoce degli Adepti! Ti si addice a pennello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089711,
					"content": "Grazie... Ci dispiace veramente, io e mio fratello abbiamo imparato la lezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089712,
					"content": "L'Adeptus ci ha graziati con la sua clemenza. Promettiamo di cambiare, e che d'ora in poi lavoreremo onestamente. Anche se vorrà dire che dovremo spaccarci la schiena al porto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089713
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089713,
					"content": "A ogni modo, penso che abbiamo sostato fin troppo nel regno dell'Adeptus. Andiamo. Grazie, potenti portavoce degli Adepti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089714
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089714,
					"content": "Sì... Grazie, portavoce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089715
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089715,
					"content": "Cavoli, sarebbe davvero utile essere portavoce degli Adepti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080609,
					"content": "Sembra che questo Adeptus abbia qualche problema di gestione della rabbia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080610,
					"content": "Ma noi non abbiamo fatto niente di male... Dovremmo passarla liscia... Eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089601,
					"content": "Chi osa violare i confini delle mie montagne? Chi osa mettere in libertà i miei prigionieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Formamontagne"
				},
				{
					"id": 10089602,
					"content": "Stupidi mortali, fatevi avanti e ricevete la vostra punizione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Formamontagne"
				}
			]
		},
