			"dialogs": [
				{
					"id": 751330201,
					"content": "Avete trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330202
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330202,
					"content": "Diamo un'occhiata più da vicino e vediamo se riusciamo a trovare un meccanismo o un passaggio segreto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				}
			]
		},
