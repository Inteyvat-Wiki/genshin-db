			},
			"dialogs": [
				{
					"id": 751330301,
					"content": "#È aperto! {REALNAME[ID(2)|SHOWHOST(true)]}, sei un mito! Non avremmo mai trovato il meccanismo senza di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330302,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, sapevo che ce l'avresti fatta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "Ma non montarti la testa. Ci aspettano ancora molte altre sfide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330305,
					"content": "Ora che l'ingresso è aperto, non abbiamo motivo di arrenderci a metà strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330306,
					"content": "Sono d'accordo, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330307,
					"content": "Whiip... Whiip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330308,
					"content": "Cosa c'è? Perché non vuoi entrare? Hai paura? Siamo a metà del viaggio, non possiamo tornare indietro ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330309,
					"content": "Ku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "\"Cocouik\""
				},
				{
					"id": 751330310,
					"content": "Sembra davvero spaventato, non dovresti forzarlo, Bona. Che ci sia qualcosa di estremamente pericoloso, laggiù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330311,
					"content": "Ho paura anch'io!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#Dici sul serio? Suvvia, torna in te come ha fatto {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330313,
					"content": "È piuttosto emozionante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "Paimon non pensava che fossi così entusiasta. Ma Paimon crede che tu sia in grado di affrontare qualsiasi cosa troveremo laggiù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330315,
					"content": "Non temere, il nostro piccolo Saurico è molto coraggioso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "Roar... Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "Se Coco ha così tanta paura, forse dovrebbe restare qui... Aspetta, non possiamo lasciarlo da solo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330318,
					"content": "Immagino che non ci sia altra scelta. Io resterò qui con Coco, ma tu puoi prendere la Pyrofosforite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330319,
					"content": "Qualsiasi cosa troverete laggiù, dovrete tornare a riprendermi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330320
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330320,
					"content": "Non lasceremo nessuno indietro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330321
					]
				},
				{
					"id": 751330321,
					"content": "Mi fido di te. Aspetteremo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330322
					],
					"speakerTitle": "Bona"
				},
