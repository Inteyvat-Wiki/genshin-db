			"dialogs": [
				{
					"id": 10293301,
					"content": "Ehi, Ushi. Pare che il nostro piccolo Melonlavanda si sia addormentato, eh? Pensi che stia sognando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293302,
					"content": "Muu? Muu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293303,
					"content": "Cavolo, sembra davvero sfinita. Mi spiace vederla così. Voglio dire, di solito non sta praticamente mai zitta... Ah, poverina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293304,
					"content": "E anche quel piccoletto sembra bello esausto. Ah, sono un po' preoccupato per loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293305,
					"content": "Muu, muu, muu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293306,
					"content": "Anch'io dormo così quando sono in prigione? Ahah! Bella questa! In effetti, è vero che me la dormo come un re.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293307
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293307,
					"content": "#{NICKNAME}?! Quando sei arrivat{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
