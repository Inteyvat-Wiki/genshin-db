					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293202,
					"content": "Va tutto bene? Non hai più detto nemmeno una parola. Non è da te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293203
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293203,
					"content": "Shhh, riparliamone più tardi. Sto solo elaborando tutti gli indizi raccolti finora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293204
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293204,
					"content": "Forse la soluzione per la nostra fuga si cela in qualche dettaglio che abbiamo trascurato. Devo riesaminare tutto un'altra volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293205
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293205,
					"content": "Molto bene, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293206,
					"content": "Oh, non preoccuparti. Non scriverò nulla di tutto quello che ci hai detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293207
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293207,
					"content": "Non era per quello... Volevo solo dire che se vuoi portare avanti un'analisi dei fatti, puoi contare su di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
