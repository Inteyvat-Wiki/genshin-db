			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zio Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "Wow, questa miniera è enorme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210102,
					"content": "È qui che è avvenuto l'incidente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210103,
					"content": "Sei giorni fa, un gruppo di noi si è allontanato per occuparsi di altre questioni. Quando siamo tornati, i quattro uomini che erano rimasti qui sono spariti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210104,
					"content": "Ho guidato una spedizione di ricerca in tutta la miniera, ma non abbiamo trovato tracce. Così ho deciso di chiedere aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210105,
					"content": "Dunque sono scomparsi quattro minatori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210106,
					"content": "Sì, eravamo in dieci. Abbiamo perso Long, Cen l'Audace, Cen il Coraggioso e Mao. Lavoravo con tutti loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210107,
					"content": "Solitamente, in questo settore i lavoratori sono giovanotti nel fiore degli anni. È possibile che i quattro siano partiti per un'altra miniera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210108,
					"content": "Non credo. Non ci sono altri posti dove poter alloggiare nel raggio di chilometri, e non abbiamo visto miniere lungo la strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210109,
					"content": "Mmh... è una miniera così grande. Sei riuscito davvero a setacciarne ogni angolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210110,
					"content": "Sottoterra, in superficie... abbiamo cercato ovunque. Abbiamo provato di tutto, a parte scavare ancora più a fondo. Come hanno fatto quattro giovani ragazzi a svanire tra le rocce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210111,
					"content": "Prima di trarre conclusioni dovremo esplorare il posto con i nostri occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210112,
					"content": "Molto bene, aspetterò qui. Procedete come meglio credete. Se trovate qualche indizio, non esitate a comunicarmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zio Dai"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
