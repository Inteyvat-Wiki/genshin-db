			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "Kun Jun, che cos'hai trovato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210202,
					"content": "Oh, giusto in tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210203,
					"content": "Hai trovato qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210204,
					"content": "Qui c'è un frammento di minerale, forse all'interno si nasconde un indizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210205,
					"content": "Minerale? Che cosa c'entra con la scomparsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210206,
					"content": "Lo scopriremo. Fatemi tentare. Un momento, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210207,
					"content": "...Ok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210208,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210209,
					"content": "Mmh... Sembra che si stia concentrando. Che cos'ha in mente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210210,
					"content": "Vedo... quattro uomini... seguire una persona fuori dalla miniera... Sembra un bambino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210211,
					"content": "Un bambino? Che cosa ci fa un bambino in una miniera?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210212,
					"content": "Non sono sicuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210213,
					"content": "E poi, come hai fatto a \"vederlo\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210214,
					"content": "Oh! Non intendo \"vedere\" in senso tradizionale... V-Vorrei che quanto sto per dirvi rimanga un segreto. È un po' strano... Non ho mai avuto il coraggio di dirlo a nessuno prima d'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210215,
					"content": "Riesco... a percepire i ricordi dei minerali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210216,
					"content": "Eh...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210217,
					"content": "\"Percepire?\" Quindi non... si tratta di speculazioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210218,
					"content": "Vuoi dire che ti basta toccare una pietra e... abracadabra! Succede e basta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210219,
					"content": "Ho sempre percepito che i minerali sono dotati di \"ricordi\". A volte capita che registrino avvenimenti accaduti nelle loro vicinanze. Mi basta toccarne uno e concentrarmi per poter accedere ai suoi ricordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210220,
					"content": "Straordinario! In questo modo puoi scoprire tutto quello che è successo in un luogo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210221,
					"content": "Dipende dal minerale. Alcuni hanno ricordi stupefacenti, mentre altri, come il ferro o il ferro bianco, non sono un granché. I loro sono ricordi confusi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210222,
					"content": "I ricordi dei cristalli e del Cor Lapis sono molto più vividi. Registrano un numero maggiore di eventi e più nel dettaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210223,
					"content": "Leggere le pietre... affascinante. Un'abilità davvero rara. Zio Dai ha fatto bene a ingaggiarti, signor Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210224,
					"content": "Ahah, sono felice di poter aiutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210225,
					"content": "In base a ciò che ho visto, credo che siano andati da questa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210226,
					"content": "La strada ci porterà a nord, lontano dalla miniera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210227,
					"content": "Nord... un altro indizio per zio Dai! Teniamolo a mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112103",
							"2"
						],
						"stepId": 1112103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Signore, lei lavora da queste parti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210302,
					"content": "Ah! Sì, sì! Siete qui per la sparizione, immagino. Vi prego, trovateli se potete!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210303,
					"content": "Io... Non so che cosa sia successo. Quel giorno il cielo era nuvoloso, il capo si era allontanato con un paio di uomini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210304,
					"content": "Io sono rimasto con gli altri quattro. Dopo un po', ho deciso di fare una pausa... giusto per riprendere fiato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210305,
					"content": "Alla fine mi sono addormentato all'interno del rifugio. Quando mi sono svegliato, di loro non c'era più nessuna traccia! E pensare che ci avevo parlato fino a poco tempo prima, poi... il nulla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210306,
					"content": "Forse... Forse sarò il prossimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210307,
					"content": "E così gli uomini che stavano lavorando là fuori sono scomparsi, mentre l'unico rimasto a poter raccontare l'accaduto dormiva nel rifugio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210308,
					"content": "Forse è successo tutto sul luogo di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210309,
					"content": "Oh... Che paura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210310,
					"content": "Un incidente sul luogo di lavoro... Dovremmo annotare anche questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "Da questa parte! Che cosa sono questi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210402,
					"content": "Una pila di camicie, dei pantaloni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210403,
					"content": "Oggetti di uso quotidiano, devono appartenere a zio Dai e ai suoi uomini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210404,
					"content": "Uno, due, tre, quattro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210405,
					"content": "Ah... giusto. Dieci camicie e dieci paia di pantaloni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210406,
					"content": "Sono vestiti di ricambio, giusto? Gli abiti di zio Dai sono identici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210407,
					"content": "Quei quattro sono scomparsi da sei giorni senza neanche un ricambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210408,
					"content": "In giro ci sono anche un paio di fazzoletti e del sapone... Oh, e qualche cintura degli attrezzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210409,
					"content": "Oggetti per lavarsi la faccia prima del turno mattutino... attrezzatura da miniera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210410,
					"content": "Quindi... non hanno preso nessuna provvista...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210411,
					"content": "Mmh, esatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "Forse non ne avevano bisogno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Poco probabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210415,
					"content": "Mancano quattro picconi. Sembra che se ne siano andati con gli strumenti di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210416,
					"content": "Hanno avuto il tempo di prendere i loro attrezzi, ma non degli oggetti essenziali? Strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210417,
					"content": "Mmh... Perché qualcuno dovrebbe partire con i propri attrezzi, dimenticandosi però i bagagli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210418,
					"content": "Uno: stavano lavorando nelle vicinanze e non avevano bisogno di portarsi i bagagli. Considerato però che devono ancora fare ritorno, sembra un'ipotesi alquanto improbabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210419,
					"content": "Oppure, due: sono stati costretti ad andarsene e non hanno avuto il tempo di pensare ad altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210420,
					"content": "Oh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210421,
					"content": "Credi che... siano stati rapiti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "Non possiamo escluderlo. Ci serviranno altri indizi prima di dare una risposta a questo enigma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210423,
					"content": "Se non se ne sono andati di loro volontà, forse sono stati costretti ad andarsene... Prendiamone nota e comunichiamolo a zio Dai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210413,
					"content": "O magari li hanno semplicemente dimenticati?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zio Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "Eccovi qui! Come va la ricerca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210702,
					"content": "Abbiamo trovato tre indizi nei paraggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210703,
					"content": "Innanzitutto, mancano quattro picconi, ma gli oggetti di uso quotidiano sono ancora al loro posto. Questo vuol dire che i tuoi uomini non hanno deciso di andarsene volontariamente, ma che sono stati costretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210704,
					"content": "Costretti? Ma... chi rapirebbe mai dei minatori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210705,
					"content": "Giusta osservazione. In secondo luogo, nella miniera c'erano cinque lavoratori. Uno di loro si era allontanato per riposarsi. Quando si è svegliato, i suoi colleghi erano scomparsi senza lasciare traccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210706,
					"content": "Tutti quelli che avevano continuato a lavorare sono scomparsi. Quello che si era allontanato per primo è tornato sano e salvo. Sembra che l'episodio sia avvenuto sul posto di lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210707,
					"content": "Ora che mi ci fate pensare, ricordo che Hu aveva detto di essersi preso una pausa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210708,
					"content": "È possibile che qualcuno si sia avvicinato e che sia riuscito ad allontanarsi indisturbato con loro?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210709,
					"content": "Il che mi porta al terzo punto. Il signor Kun Jun ha sfruttato le sue... abilità... per giungere a una conclusione. I tuoi uomini sono stati portati via da un bambino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210710,
					"content": "Un bambino?! Da queste parti non ci sono insediamenti nel raggio di chilometri! È impossibile che un bambino abbia raggiunto la miniera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210711,
					"content": "Per quanto assurdo possa sembrare, siamo giunti a questa conclusione. I tuoi uomini stavano seguendo un bambino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210712,
					"content": "Dove sono andati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210713,
					"content": "Crediamo che abbiano seguito il sentiero verso nord, lontano dalla miniera e verso le rovine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210714,
					"content": "Nord! Bene, radunerò i miei uomini e partirò all'inseguimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210715,
					"content": "Hai bisogno di aiuto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "Il vostro contributo è stato fondamentale per le indagini, ma lasciate fare a noi adesso. Se partiamo subito e ci sbrighiamo, dovremmo riuscire a raggiungerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210717,
					"content": "Aspetta. L'episodio è avvenuto sei giorni fa. Anche se sono partiti a piedi, avranno comunque percorso un bel po' di strada ormai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210718,
					"content": "Uff, hai ragione... Cambio di programma. Condurrò la mia squadra di ricerca verso gli insediamenti più lontani per fare qualche domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210719,
					"content": "Gli insediamenti con alloggi per la notte sono pochi da queste parti. Indagheremo e vedremo se riusciremo a scoprire qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210720,
					"content": "Nel frattempo, potete continuare a cercare indizi. Se non ci vediamo, incontriamoci alla Locanda Wangshu domani sera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210721,
					"content": "Eh, già.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210722,
					"content": "Va bene, io e i miei uomini ci mettiamo in marcia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Zio Dai"
				},
				{
					"id": 111210723,
					"content": "Quindi... loro andranno a parlare con la gente presente negli insediamenti, mentre noi rimarremo qui a indagare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210724,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210725,
					"content": "Ma... nella miniera non ci sono più indizi... Non dovremmo andare a nord?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210726,
					"content": "Aspettate... Ci stiamo dimenticando di qualcuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210727,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210728,
					"content": "Oh giusto, dov'è Kun Jun? Paimon scommette che sta ancora indagando. Andiamo a cercarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112108",
							"2"
						],
						"stepId": 1112108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "Kun Jun! Che cosa stai cercando? Non ci sono più indizi da trovare! Muoviamoci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210802,
					"content": "Ah, scusate, sto conducendo una breve ricerca personale. Sto cercando una pietra preziosa nota come Drafine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210803,
					"content": "Drafine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210804,
					"content": "Non ne ho mai sentito parlare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "La Drafine è spesso usata nella forgiatura. A che ti serve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210807,
					"content": "Non... non lo so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210808,
					"content": "M-Mi dispiace, non ricordo perché la sto cercando... Ultimamente, mi sento particolarmente... distratto. A parte il mio nome e dove abito, ho problemi a ricordare le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210809,
					"content": "In realtà, mi sento estremamente... in ansia... come se fossi perennemente insoddisfatto per qualcosa. È... una sensazione sgradevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210810,
					"content": "Oh, Paimon sa come ci si sente! Quando sai di aver dimenticato qualcosa ma non ricordi esattamente cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210811,
					"content": "Uff... Non so nemmeno da dove iniziare. Ho... vagato senza una meta. Quel giorno al mercato, ho ascoltato una conversazione mentre stavo comprando qualcosa. Ho sentito parlare della Drafine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210812,
					"content": "Mi suonava così familiare, come se qualsiasi cosa dovessi fare fosse legata a quella pietra... Così ho deciso di mettermi alla sua ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210813,
					"content": "Forse, se riesco a trovarne un po', mi ricorderò cosa devo fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210814,
					"content": "Capisco... Se ne avrò l'opportunità, ti darò una mano durante il nostro viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210815,
					"content": "Davvero? Oh, grazie signor Zhongli! Sei troppo gentile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210816,
					"content": "Non c'è di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210817,
					"content": "Non dovremmo darci una mossa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210818,
					"content": "Spostandoci a nord della Voragine, dovremmo raggiungere il Passo di Lingju. Se la strada che hanno scelto è davvero questa, ci saranno delle tracce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210819,
					"content": "Bene! Diamo un'occhiata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210805,
					"content": "Non è il mio campo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
		},
		{
			"id": 1112109,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
