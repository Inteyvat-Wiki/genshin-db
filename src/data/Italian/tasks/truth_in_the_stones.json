				"points": []
			},
			"dialogs": [
				{
					"id": 111210901,
					"content": "Forse è meglio se ci dividiamo. Inizierò a esplorare da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210902
					],
					"speakerTitle": "Kun Jun"
				},
				{
