			"dialogs": [
				{
					"id": 750350101,
					"content": "Chiedo scusa... Ehm, sei tu il maestro Kulahaw?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350102,
					"content": "In effetti, mi chiamano così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350103,
					"content": "Hihi, quindi tu sei il maestro di gemme in cerca d'ispirazione! È stata Imix a consigliarci di rivolgerci a te. Stavi fissando quell'albero, abbiamo notato. Eri impegnato a estrarre gemme di creatività?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350104,
					"content": "Uh, a dire il vero... Lasciamo stare, non è importante. *sospira* C'è nulla che posso fare per voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350105,
					"content": "#Abbiamo trovato una gemma stupenda, ci stavamo chiedendo se non potessi trattarla per {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350106,
					"content": "#Hihi. Dai, {REALNAME[ID(2)|SHOWHOST(true)]}, fagliela vedere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350107,
					"content": "Roar! Roooh...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "Ehhh?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350109,
					"content": "#Senti degli improvvisi battiti d'ala nelle orecchie...\\nDopo un attimo di smarrimento, ti accorgi che la gemma è sparita dalle zampe di {REALNAME[ID(2)|SHOWHOST(true)]} senza lasciare traccia.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "Roooooh! Rooooaaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "Ma che acciden... Aspetta, dov'è finita? Era una gemma enorme, non può essere sparita così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350112,
					"content": "Sembra che un uccello l'abbia sgraffignata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "Che?!? Ci sono anche gli uccelli ladri in questo posto?! Ma che screanzati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350114,
					"content": "Roooarrr! Rooooahr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "In realtà, anche se non l'avessero rubata, stavo giustappunto per dirvi che non avrei potuto fare nulla per voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350116,
					"content": "Quei dannati uccellacci mi hanno rubato tutti gli attrezzi! Ciò che stavo fissando poco fa erano proprio quegli uccelli: li stavo scrutando a uno a uno per capire quale avesse messo le sue sporche zampe sui miei attrezzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350117,
					"content": "#Ma... Ma com'è possibile una cosa del genere? Questi uccelli sono dei criminali! Forza, {NICKNAME}, andiamo a riprenderci quella gemma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350118,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "E anche i miei attrezzi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				}
			]
		},
