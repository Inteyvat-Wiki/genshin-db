			"dialogs": [
				{
					"id": 750350801,
					"content": "Oh, cielo! I miei attrezzi! Li avete riportati! È stupefacente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350802
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350802,
					"content": "Prima non ho potuto guardarla con attenzione, ma devo dire che è una gemma davvero splendida! Ha lo stesso colore giallo del tarso di un volatile... Bah! Non dovrei usare quelle canaglie pennute come analogia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350803
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350803,
					"content": "È come il cielo che si rischiara all'alba, come il primo raggio di sole, come la prima luce che illumina il mattino... Sì, questa è una buona descrizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350804,
						750350806
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350804,
					"content": "Sarai anche un maestro, ma le tue metafore non sono così magistrali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350805
					]
				},
				{
					"id": 750350805,
					"content": "Ehi, io faccio il gemmario, mica il poeta! Gli unici colori che mi serve ricordare sono quelli della natura... Usare belle parole per descriverli non è il mio forte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350808,
					"content": "A ogni modo, alla gemma penserò io. Come ho già detto, lo farò a titolo gratuito. Consideratelo un regalo per aver recuperato i miei attrezzi. Riguardo al quanto ci vorrà... Passate al Gemporio fra un paio di giorni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350806,
					"content": "Quindi è questo che significa \"cercare l'ispirazione\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350807
					]
				},
				{
					"id": 750350807,
					"content": "Oh? Quindi ne avete già sentito parlare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				}
			]
		},
