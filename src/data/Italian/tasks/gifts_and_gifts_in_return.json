							-1325.08,
							140.986,
							7600.912
						],
						"pointId": 8840
					}
				]
			},
			"dialogs": [
				{
					"id": 750350301,
					"content": "Ah, siete qui. Il maestro Kulahaw ha lasciato la gemma lavorata al negozio, mi ha detto espressamente di consegnarla a voi di persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350302,
					"content": "Eh? Oggi il maestro Kulahaw non c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350303,
					"content": "Eh, già. È uscito di nuovo in cerca d'ispirazione. A proposito, ha fabbricato anche una serie di lucchetti da portarsi dietro, diceva che servono a evitare che qualcuno rubi i suoi attrezzi. Strano, però... Chi mai avrebbe interesse nel rubare i nostri attrezzi da taglio per rivenderli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350304,
					"content": "Infatti non è mica per quello! È perc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350305,
					"content": "(Imix ancora non sa che gli uccelli li avevano rubati, a quanto pare... Meglio risparmiare a Kulahaw l'imbarazzo!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350306,
					"content": "È perché... perché c'è qualcuno che pensa che rubarglieli significhi privarlo anche della sua abilità, eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350307,
					"content": "Lasciamo perdere... Comunque, grazie per la gemma! Ha una forma bellissima. È questo ciò che di solito si definisce un \"capolavoro\", eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350308,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#Anche {REALNAME[ID(2)|SHOWHOST(true)]} ne sembra molto soddisfatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350310,
					"content": "Permettici di ringraziarvi anche a nome suo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "Ehi, suvvia. Sono felice che al piccolo Saurico piaccia! Riferirò i vostri complimenti al maestro Kulahaw. Tornate ancora a trovarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
