			"dialogs": [
				{
					"id": 750351201,
					"content": "Paimon se lo sentiva, quando ha visto quei pilastri là fuori, ma davvero non si aspettava di finire qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351202,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351203,
					"content": "Se non altro, sembra che questo posto ti piaccia! Beh, è normale: in fondo, chissà quanto tempo ci avrai trascorso, prima d'incontrare noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351204,
					"content": "Paimon si chiede se quei pilastri luminosi non scompariranno dopo che ce ne andremo... Comunque, prima di tutto diamo una ripulita, dopodiché potremo riposarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351205,
					"content": "#Tu, {REALNAME[ID(2)|SHOWHOST(true)]} e Paimon mettete tutto a posto.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351206
					]
				},
				{
					"id": 750351206,
					"content": "Hihi, ottimo lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351207,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#Mmmh, sei parecchio euforico, {REALNAME[ID(2)|SHOWHOST(true)]}! C'è qualcosa che vuoi dirci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351209,
					"content": "Rooohr... Rrroar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351210,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351211,
					"content": "Eh? Vuoi che ci voltiamo dall'altra parte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351212,
					"content": "Non ci avrai mica preparato una sorpresa! Hihihi, ormai sei come un libro aperto per noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351213,
					"content": "E va bene, staremo al gioco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351214,
					"content": "#Tu e Paimon vi voltate, e tutto ciò che sentite sono solo rumori metallici e tintinnii continui.\\nSembra che {REALNAME[ID(2)|SHOWHOST(true)]} stia armeggiando con qualcosa di non ben precisato...\\nDopo qualche minuto, {REALNAME[ID(2)|SHOWHOST(true)]} vi chiama col suo \"Roar, roar!\", invitandovi a girarvi verso di lui...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351215
					]
				},
				{
					"id": 750351215,
					"content": "Porca pupazza, è un sacco di roba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351216,
					"content": "Fai vedere a Paimon! Dunque... Un ramo super dritto, una roccia rotondissima... e cibi di vario genere con gli odori e i colori più strani. Beh, sembra che siano rimasti qui da chissà quanto tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351217,
					"content": "Hai raccolto tu tutte queste cose? Sono regali per noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351218,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351219,
					"content": "Beh, però, purtroppo noi non possiamo mangiare il cibo avariato, e nemmeno tu! Rischiamo di farci venire un bel male al pancino. Dobbiamo buttarlo via...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351220,
					"content": "Aruuuu... Roooar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351221,
						750351223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351221,
					"content": "Però questo ramo è sensazionale!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351222
					]
				},
				{
					"id": 750351222,
					"content": "Già! Se lo impugni sembra proprio una spada che emana un'aura potentissima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351225,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351226
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351226,
					"content": "Mh-mh, accettiamo molto volentieri! Hihi, Paimon metterà tutto nella tasca segreta del suo zaino! Chissà, magari un giorno potrebbero tornarci utili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351227,
					"content": "#Mmh, giacché {REALNAME[ID(2)|SHOWHOST(true)]} ci ha fatto un regalo, forse dovremmo ricambiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351228,
					"content": "Vediamo, Paimon dovrebbe avere qualcosa nella sua scorta segreta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351229,
						750351231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351229,
					"content": "Caspita, è raro vederti così generosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351230
					]
				},
				{
					"id": 750351230,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} si è impegnato tanto per mostrarci quanto ci tiene a noi, non possiamo mica ignorarlo! E poi, se il suo zaino diventa troppo pesante, Paimon non potrà più volare, quindi tanto vale toglierci qualcosa e darlo a lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351233,
					"content": "#Tadaaa! Ecco una gemma iperscintillante per te! Ti piace, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351234,
					"content": "Roar! Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351235
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351235,
					"content": "Ooh! Pare che Paimon c'abbia azzeccato in pieno! Ehi, attento, non farla cadere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351236,
					"content": "Oh, cavoli... Paimon ha l'impressione che finirai per perderla, se la tieni così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351237,
					"content": "Perché non andiamo dai Figli degli Echi? Sicuramente tra di loro ci sarà un gemmario che può darle una forma migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351231,
					"content": "Si può sapere dove lo tieni nascosto, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351232
					]
				},
				{
					"id": 750351232,
					"content": "#Paimon ha detto che è un segreto, è la sua scorta privata! Anche se siamo super{F#migliorissime amiche}{M#migliorissimi amici}, non è una cosa che Paimon può dirti così alla leggera! Comunque, c'è di tutto e di più per fare un regalo a {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351223,
					"content": "Questa roccia è perfettamente rotonda!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351224
					]
				},
				{
					"id": 750351224,
					"content": "E guarda come luccica! Hihi, abbiamo attraversato fiumi in ogni dove e visto rocce di ogni tipo, quindi possiamo garantirti che questa è proprio una gemma tra le rocce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}