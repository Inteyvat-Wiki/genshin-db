			"dialogs": [
				{
					"id": 250220301,
					"content": "Questo sì che è un bel fiore. Anche il nome suona bene... Hora, ti va di assaggiarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220304,
					"content": "Roar... Roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220305,
					"content": "(Hora mastica con cura, come per assaporare il gusto dei petali.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220306,
					"content": "R-Roar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220307,
					"content": "Si direbbe che gli piaccia molto. Ma i fiori da soli non basteranno a saziarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220308,
					"content": "Inoltre, questo tipo di fiore non sembra economico... Comunque sia, per ora me lo appunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220309,
					"content": "Ma come si fa a trasformare i fiori in cibo? Ah, forse potremmo... impastarli e farci una specie di torta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
		{
