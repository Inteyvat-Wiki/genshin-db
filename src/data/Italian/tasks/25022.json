			"dialogs": [
				{
					"id": 250220401,
					"content": "Caspita, che frutto gigantesco! A occhio e croce dovrebbe bastare a saziarlo. Ti va di provare, Hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220404
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220404,
					"content": "Roar... Roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220405
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220405,
					"content": "(Hora inizia a mangiare e in breve tempo fa fuori tutto.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220406,
					"content": "Roar! Roarrrrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220407,
					"content": "Ahahah, l'hai spazzolato via subito. Deve esserti piaciuto molto, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220408,
					"content": "Roarrr, roar! Roarrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220409,
					"content": "Ottimo! Tra poco vado a cercare qualcuno a cui chiedere. Vediamo se qualcuno sa dove trovare dei mercanti di Inazuma. Ho bisogno di procurarmi altri Melonlavanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
