			"dialogs": [
				{
					"id": 250220101,
					"content": "Mmmh, a quanto pare dovrò provare un altro metodo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220102,
					"content": "Roar! Roarrrrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220103,
					"content": "Un'altra idea brillante? Sentiamo un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "R-Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220107,
					"content": "Di solito si spazzolava un'intera ciotola di frutta e, dopo mangiato, continuava a giocare per tutto il giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220108,
					"content": "Adesso, invece, mangia solo mezza ciotola e se ne sta fermo senza muovere un muscolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220109,
					"content": "Temevo fosse malato, perciò sono andato a cercare un veterinario nel cuore della notte per chiedergli consiglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220110,
					"content": "Abbiamo passato l'intera nottata a tentare di capire quale fosse il problema, solo per renderci conto che non era affatto malato, ma semplicemente... molto schizzinoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220111,
					"content": "Il veterinario ha detto che la soluzione migliore era proporgli una nuova ricetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220112,
					"content": "In alternativa mi ha proposto di far ascoltare musica a Hora durante i pasti, potrebbe stimolargli l'appetito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220113,
					"content": "È un'ottima idea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "Ahahah, già, ho trovato un disco, e sembrava pure piacergli molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220116,
					"content": "Ma abbiamo dovuto accantonare l'idea... dato che Hora si è avventato sul disco e l'ha morso, spaccandolo in due.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220117,
					"content": "Non fare quella faccia sconvolta. Per un Tepetlisauro, un disco fatto di ossidiana e Flogisto è una vera e propria delizia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220118,
					"content": "Ora non ho altra scelta che recarmi dai Discendenti delle Vette, magari qualcuno di loro mi suggerirà qualche nuovo ingrediente da provare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220119,
					"content": "Andrò a cercare qualche ingrediente per te.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "Vuoi davvero aiutarmi? Sarebbe fantastico! I miei amici Discendenti possono cercare solo all'interno di Natlan, ma tu puoi procurarti ingredienti ovunque, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220124,
					"content": "Aspetta, fammi dare un'occhiata alla lista degli ingredienti consigliati dal veterinario. Quel dottore ne sa a pacchi, anche di cose al di fuori dei nostri confini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220125,
					"content": "Mmmh... Dice che potremmo provare <color=#00E1FFFF>rose arcobaleno, Melonlavanda</color> e <color=#00E1FFFF>Qingxin</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220122,
					"content": "Grazie mille per l'aiuto. Se dovessi trovare qualche ingrediente speciale, portamelo subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220123,
					"content": "Roar, roaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220120,
					"content": "Nella raccolta di ingredienti, sono pressoché imbattibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "Non sapevo esistessero dischi simili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "(Accarezzi Hora.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "R-Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
					],
					"speakerTitle": "Hora"
				}
			]
		},
