			"dialogs": [
				{
					"id": 250220501,
					"content": "Questo ha un profumo delizioso. Che aroma rinfrescante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220504,
					"content": "Hora? Ma guarda un po'! Se l'è già mangiato tutto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220505,
					"content": "(Hora inghiotte il Qingxin in un solo boccone, poi ti guarda sbattendo le palpebre...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220506,
					"content": "(Hora si gira di colpo e divora in un sol boccone la mezza ciotola di frutta accanto a lui...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "Hora sembra aver improvvisamente ritrovato l'appetito... Ma come è successo? È stato davvero tutto merito del Qingxin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220508,
					"content": "D-Devo parlarne col veterinario...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
