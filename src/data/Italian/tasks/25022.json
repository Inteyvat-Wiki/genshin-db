			"dialogs": [
				{
					"id": 250221201,
					"content": "Ah, giusto! Ecco una ricompensa per il tuo disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221202
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221202,
					"content": "Grazie al tuo aiuto, riuscirò sicuramente a creare la ricetta perfetta per Hora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221203
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221203,
					"content": "Hora, devi ricominciare ad alimentarti come si deve, intesi? Così diventerai un Tepetlisauro grande e forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250221204
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250221204,
					"content": "Roarrr, roarrr, roarrrrrr!",
