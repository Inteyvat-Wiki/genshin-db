			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Joel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020501,
					"content": "Ehi! Ci sono notizie?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020502
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020502,
					"content": "Oh... Quindi lo zio Cyrus non è ancora riuscito a trovare papà, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020503,
						708020504
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020503,
					"content": "Abbi un po' di fiducia in lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020505
					]
				},
				{
					"id": 708020505,
					"content": "Hai ragione... Chiederò altri dettagli allo zio Cyrus, quando arriverà. Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020506
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020506,
					"content": "Dove sei, papino...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020504,
					"content": "Almeno hanno qualche indizio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020505
					]
				}
			]
