			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus",
					"Pallad il Temerario"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "Pallad, sei sicuro che fosse questa l'area?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020202,
					"content": "Ne sono certo, signor Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020203,
					"content": "State parlando del padre di Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "#Guarda un po' chi si vede, {M#il viaggiatore}{F#la viaggiatrice}! Scommetto che ti ha mandato Joel, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020205,
					"content": "Quel ragazzino ha mandato ogni giorno qualcuno a chiedere se ci fossero notizie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020206,
					"content": "Stavolta però abbiamo ottime notizie per lui, ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020207,
					"content": "Poco fa, stavamo organizzando un addestramento speciale sul Picco del Drago...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020208,
					"content": "Signor Cyrus, penso sia meglio che continui io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020209,
					"content": "Dunque... durante l'addestramento ho perso il sentiero principale, a causa di una bufera di neve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020210,
					"content": "Mentre cercavo di tornare a tentoni sulla strada, ho visto una figura su una rupe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020211,
					"content": "Ho pensato fosse un avventuriere perso nella tormenta come me, allora ho urlato per provare ad attirare la sua attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020212,
					"content": "Sfortunatamente, le mie urla hanno solo attirato l'attenzione di alcuni mostri nei paraggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020213,
					"content": "Non so cosa avreste fatto al mio posto, ma io non ero sicuro che sarei riuscito a batterli in condizioni del genere, quindi ho scelto di battere in ritirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020214,
					"content": "Una volta tornato, ho raccontato tutto al signor Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020215,
					"content": "Pensi che la persona che hai visto fosse il padre di Joel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "Non ne siamo sicuri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020218,
					"content": "In ogni caso, sappiamo che \"qualcuno\" è bloccato sul Picco del Drago e, di conseguenza, è nostro dovere salvarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020219,
					"content": "Che quella persona sia o meno Joserf, il padre di Joel, è tutto da vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020220,
					"content": "A ogni modo, ho già inviato una spedizione di ricognizione al Picco del Drago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020221,
					"content": "Mi preparerò anch'io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020222,
					"content": "Verrò con voi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "Davvero? Ma è fantastico! Allora partiamo insieme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020223,
					"content": "Mi occuperò io di quei mostri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "Poteva essere un avventuriere smarrito qualunque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
