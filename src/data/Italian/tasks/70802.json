			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020401,
					"content": "#Ah, viaggiat{M#ore}{F#rice}, sei tornat{M#o}{F#a}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020402,
						708020404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020402,
					"content": "Pallad ha iniziato le ricerche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "Ma davvero? Ah! Lo sapevo che aveva un suo senso di responsabilità, in qualche modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020406,
					"content": "Non appena sbrigherò alcune questioni che richiedono la mia attenzione, andrò di persona al Picco del Drago e informerò Joel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020407,
					"content": "Quindi, se ti è possibile, digli che a breve sarò da lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020408,
					"content": "Ci vorrà un po' prima che finisca queste faccende. Su, ora vai, non fare aspettare il ragazzino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020404,
					"content": "Pensi che lo troveremo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "Non abbiamo alcuna garanzia, purtroppo... L'unica cosa che posso dire è che faremo del nostro meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 7080205,
			"completionStepIds": [
				7080208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
