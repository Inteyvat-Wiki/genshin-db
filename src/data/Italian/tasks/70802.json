			"dialogs": [
				{
					"id": 708020301,
					"content": "Beh, almeno grazie a te questa zona è più sicura. Molte grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020302
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020302,
					"content": "Ma Joserf...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020303
					]
				},
				{
					"id": 708020303,
					"content": "Purtroppo non sono riuscito a trovare nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020304
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020304,
					"content": "In ogni caso, adesso la via è libera e continuerò a cercare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020305
					],
					"speakerTitle": "Pallad il Temerario"
				},
				{
					"id": 708020305,
					"content": "Potresti tornare dal signor Cyrus e riferirgli che ho iniziato la ricerca? Ti ringrazio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pallad il Temerario"
				}
			]
		},
		{
			"id": 7080204,
			"completionStepIds": [
