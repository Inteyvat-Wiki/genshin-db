			},
			"dialogs": [
				{
					"id": 750700901,
					"content": "Ahah! Perfetto! Ecco, prendine una copia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700902,
					"content": "Wow, è davvero fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700903,
					"content": "Ecco la vostra ricompensa. È la seconda... anzi, la terza volta che mi aiutate. Senza di voi... dubito che avrei potuto portare a termine il mio viaggio fotografico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700904,
					"content": "La mia destinazione è... qui. L'ho segnata sulla mappa. Ancora una volta, se vi interessa, non vedo l'ora di collaborare ancora con voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700905,
					"content": "Ah! È quasi ora. Devo andare. A presto e buona fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700906,
					"content": "Magnifico finisce di fare i bagagli e salta felicemente a bordo del suo pallone aerostatico.\\nMentre il pallone scompare lentamente, la sua risata esuberante si riduce fino a restarne solo un eco distante...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
