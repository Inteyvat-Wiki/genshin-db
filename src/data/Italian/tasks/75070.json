				]
			},
			"dialogs": [
				{
					"id": 750700701,
					"content": "Ahah! Sapevo che ci saremmo incontrati di nuovo! Il tuo tempismo è impeccabile: stai per assistere al mio secondo capolavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700702
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700702,
					"content": "Mmm... Forse non il secondo. Ho un sacco di opere meravigliose, dopotutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700703
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700703,
					"content": "#In ogni caso, siete {F#fortunate}{M#fortunati}, perché sarete {F#le prime}{M#i primi} ad assistere al mio primo tentativo di fotografia dinamica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700704
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700704,
					"content": "Dopotutto, tutte le foto che scattavo erano di vittime di scene del crimine... Uh, non importa. Meglio non entrare nei dettagli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700705
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700705,
					"content": "Quindi, hai di nuovo bisogno del nostro aiuto, Monsieur Magnifico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700706,
					"content": "Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750700707,
					"content": "No, no di certo... Uhm, ripensandoci, sarebbe sensazionale! Avanti, lasciate che vi spieghi tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700708
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700708,
					"content": "Allora, la situazione è questa: devo fotografare un Qucusauro che si tuffa da questa cascata verso la superficie dell'acqua. Dobbiamo catturare il momento in cui tocca l'acqua, è quella la scena più emozionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700709
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700709,
					"content": "Ho nascosto del cibo che può attirare i Qucusauri nel laghetto sotto la cascata. È solo che... *sospira* Non sono ancora scesi con l'angolazione giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700710
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700710,
					"content": "Mmh? Aspetta un momento. Cos'è quel cerchio grande sulla superficie dell'acqua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700711,
					"content": "Non me ne preoccuperei troppo, anche se non so esattamente di cosa si tratti... È solo qualche cianfrusaglia che ho raccolto da una tribù vicina da usare come bersaglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700712
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700712,
					"content": "*sospira* Tutte le foto scattate finora erano piuttosto banali, al punto che ormai è irritante. Potrei continuare ad aspettare, ma dato che sei qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700713
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700713,
					"content": "#Magari potresti... ehm, guidarli? Insegnargli a fare un bel tuffo? Voglio dire, sei {F#una domatrice}{M#un domatore} di Saurici {F#famosa}{M#famoso} in tutta Natlan, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700714
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700714,
					"content": "Va bene? Fantastico! Invierò un segnale da qui. Andrà bene finché riuscirai a raggiungere la posizione esatta dell'obiettivo vicino all'acqua quando arriverò a \"uno\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700715,
						750700717
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700715,
					"content": "Possiamo provarci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700716
					]
				},
				{
					"id": 750700716,
					"content": "Ahah, ottimo! Proviamo, allora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700717,
					"content": "Non possiamo garantire nulla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700718
					]
				},
				{
					"id": 750700718,
					"content": "#Va bene. Se fallissimo, avremmo solo perso un po' di tempo. E siamo {F#viaggiatrici}{M#viaggiatori}, nessun tempo vale meno del nostro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700719,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
