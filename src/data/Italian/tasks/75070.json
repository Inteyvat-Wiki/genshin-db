			"dialogs": [
				{
					"id": 750701401,
					"content": "Accidenti, dobbiamo ricominciare! Ehm... se non ti dispiace, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701402,
					"content": "*sospira* Non si tratta di \"dispiacere\" Paimon o meno. Tanto siamo già qui, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701403,
					"content": "Proseguiamo, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "Grazie infinite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701405,
					"content": "Facciamo prima una pausa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "Esatto. Saltare giù da un dirupo è difficile, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701407,
					"content": "Ah... sì. Non ci avevo pensato. Va bene, cominciamo quando vuoi. Ti aspetterò qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
