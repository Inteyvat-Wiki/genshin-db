			"dialogs": [
				{
					"id": 750701601,
					"content": "*sospira* E come puoi vedere, i risultati sono... tutt'altro che ideali. Come le sue azioni, anche l'uomo è... fallimentare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701602,
					"content": "Ah... La mia famiglia mi ha sempre detto che anche gli alberi più piccoli possono gettare delle ombre enormi... Ma è una sciocchezza! Una sciocchezza! Volevano solo umiliarmi, ovviamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701603
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701603,
					"content": "Ugh...",
