							"1110010",
							"2"
						],
						"stepId": 1110010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladro di stelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111001001,
					"content": "Ehm... Ciao! Lascia che ci presentiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001002,
					"content": "Se siete qui per ringraziarmi, non ce n'è bisogno. Liberare il mondo dal male è il dovere degli Adepti. Non dovete ringraziarmi, costui di certo non lo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111001003,
					"content": "Aspettate, chi siete voi? Costui pensava che foste dei seguaci, ma guardando più da vicino sembra che non ci siamo mai incontrati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111001004,
					"content": "#Siamo solo viaggia{F#trici}{M#tori} di passaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#Paimon si chiama Paimon! E {F#lei}{M#lui} è {NICKNAME}, il braccio destro di Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001006,
					"content": "Capito. Anche costui deve presentarsi, perché farlo è buona educazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111001010,
					"content": "Ehm... Vi trovate al cospetto dell'Adeptus Maestro delle stelle, anche conosciuto dai suoi seguaci come Ladro di stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111001011,
					"content": "Costui è disceso dalla sua dimora di montagna per liberare il mondo dal male, e il destino ha voluto che le nostre strade si incrociassero. Ora, ditemi cosa desiderate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111001012,
					"content": "Cosa desideriamo? Paimon pensava che gli Adepti di Liyue fossero soltanto bravi a combattere... Ciò significa che puoi anche esaudire i desideri delle persone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001013,
					"content": "Ahah... Ci sono diversi tipi di Adepti... Le stelle non sono forse più in alto delle montagne, delle nuvole e della luna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111001014,
					"content": "Tuttavia, non è appropriato per un Adeptus vantarsi dei propri poteri. Costui dovrebbe prima farvi parlare con i suoi seguaci, così potrete fare le vostre valutazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111001007,
					"content": "Stiamo seguendo le tracce degli Adepti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#Paimon si chiama Paimon! E {F#lei}{M#lui} è {NICKNAME}, il braccio destro di Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001009,
					"content": "Allora è giusto che le nostre strade si incontrino. Anche costui dovrebbe presentarsi, perché farlo è buona educazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Ladro di stelle"
				}
			]
		},
		{
			"id": 1110023,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
