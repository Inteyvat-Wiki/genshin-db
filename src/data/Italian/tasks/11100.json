				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#Ehi, {NICKNAME}, è un'impressione di Paimon o quegli Hilichurl laggiù hanno un non so che di strano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000102,
					"content": "Emanano un'energia maligna, in effetti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "Paimon la pensa allo stesso modo. Abbiamo già incontrato molti Hilichurl. Sono malvagi, ma ora c'è qualcosa di diverso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000106,
					"content": "Oh-oh, si trovano vicino alla Locanda Wangshu, questo significa che gli ospiti sono in serio pericolo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000107,
					"content": "#Ora che lo sappiamo, se non facciamo nulla, Paimon si sentirà davvero in colpa... Andiamo ad aiutarli, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000104,
					"content": "Sembrano insolitamente agitati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "È vero! Forse c'entra con quella specie di... energia oscura che sprigionano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110003",
							"2"
						],
						"stepId": 1110003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000301,
					"content": "Questi Hilichurl super malvagi sono anche più difficili da sconfiggere rispetto ai soliti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000302,
					"content": "Ehi, sembra che la gente si stia riunendo laggiù... Mi chiedo cosa stia succedendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000303,
					"content": "Wow, hai visto quel tipo con la maschera? Ha m-messo in fuga tutti gli Hilichurl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000304,
						111000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000304,
					"content": "Potrebbe essere un Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				},
				{
					"id": 111000306,
					"content": "Oh, intendi come Xiao? Ora che mi ci fai pensare, la maschera di questo tizio è piuttosto simile a quella che indossa lui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000307,
					"content": "Ma la magia che stava usando sembrava ancora più da Adeptus di quella di Xiao. Andiamo a salutarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000305,
					"content": "Sembrava che stesse usando una specie di arte degli Adepti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000306
					]
				}
			]
		},
		{
			"id": 1110004,
			"completionStepIds": [
				1110004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110004",
							"2"
						],
						"stepId": 1110004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Credente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "Hai mai visto Maestro delle stelle in azione? Il suo potere è realmente divino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000402,
					"content": "Credo che ora ci sia finalmente una speranza per il mio padre ammalato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000403,
					"content": "Raccontami di Maestro delle stelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "È sufficiente guardarlo usare la sua magia. Un vero Adeptus, non c'è dubbio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000405,
					"content": "Non molto tempo fa, gli ho chiesto delle medicine per conto di mio padre ammalato. La differenza con le prescrizioni della Farmacia Bubu era abissale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000406,
					"content": "Dopo aver preparato la medicina, questa emanava una nebbia eterea... sembrava proprio l'opera di un Adeptus! Mh... O forse perché dentro c'era un Fiordinebbia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000407,
					"content": "La medicina degli Adepti è senza dubbio la più efficace. Mio padre guarirà presto, me lo sento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000408,
					"content": "Certo, bisogna fare qualche sacrificio se si chiede aiuto a un Adeptus come Maestro delle stelle: ho dovuto rinunciare a qualche reliquia. Ma la vita di mio padre vale molto di più di qualche vecchia reliquia, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Credente"
				}
			]
		},
		{
			"id": 1110005,
			"completionStepIds": [
				1110005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110005",
							"2"
						],
						"stepId": 1110005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Credente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "Finalmente, una vita con uno scopo e ricca di speranza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000502,
					"content": "Cosa ne pensi di Maestro delle stelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "Oh, anche voi siete suoi seguaci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000504,
					"content": "Dopo che il mio fidanzato mi ha lasciato, piangevo ogni giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000505,
					"content": "Ma poi mi sono rivolta a Maestro delle stelle per chiedergli aiuto. Su suo suggerimento, ho iniziato a bruciare i dipinti del mio fidanzato e a gettare le ceneri nell'oceano all'alba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000506,
					"content": "Non riesco a spiegarlo... ma ha funzionato per davvero! In cuor mio, so che lui ritornerà. E non mi sto illudendo solo per restare positiva, ne sono certa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "Credente"
				},
				{
					"id": 111000507,
					"content": "Sono così felice che ho dato come offerta una parte dei soldi del mio matrimonio a Maestro delle stelle. Dopo tutto, se non fosse stato per lui, non avrei riavuto il mio fidanzato, e in tal caso non ne avrei comunque avuto bisogno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Credente"
				}
			]
		},
		{
			"id": 1110006,
			"completionStepIds": [
				1110006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110006",
							"2"
						],
						"stepId": 1110006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mercante credente"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "I Milleliti non hanno bisogno di lavorare quando c'è Maestro delle stelle nelle vicinanze, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "Mercante credente"
				},
				{
					"id": 111000602,
					"content": "Cosa sai di Maestro delle stelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "Sono un commerciante, e di recente ho dovuto trasportare delle merci di valore. Così, nonostante fosse una richiesta presuntuosa, ho chiesto a Maestro delle stelle di accompagnarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "Mercante credente"
				},
				{
					"id": 111000604,
					"content": "Gliel'ho chiesto perché è sufficiente che prenda il suo talismano per far scappare i mostri a gambe levate. Non abbiamo avuto nessun tipo di problema per tutto il viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "Mercante credente"
				},
				{
					"id": 111000605,
					"content": "Non è costato poco, certo... Ma d'altronde, richiedere i servizi di un Adeptus è una questione da non sottovalutare, basti pensare al Rito della discensione! Quindi io sono disposto a farlo, ma dubito che la stessa cosa valga anche per la maggior parte delle persone al di fuori di Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mercante credente"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ladro di stelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "Cosa ne pensate? Anche se i suoi seguaci possono esagerare un po', parlano con il cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000802,
					"content": "Con la fantasia, direi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "Ahah, stai sicuramente scherzando. Un tempo c'era un Adeptus, Xue Wuliang, che il popolo chiamava \"Liangzi\". Egli disse queste parole:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000804,
					"content": "\"Tutte le cose sono connesse tra loro. Ciò che i mortali chiamano immaginazione non è altro che il ponte tra lo spirituale e il materiale.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000805,
					"content": "In altre parole, i loro desideri si trovano già sul percorso di transizione verso la realtà. La mia spiegazione vi è stata d'aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000806,
					"content": "Ahh... No, in realtà ha reso il tutto ancora più complicato da capire... In parole povere, quello che stai dicendo è che i loro desideri possono diventare realtà, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000807,
					"content": "Giusto. Sei perspicace, piccoletta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000808,
					"content": "Capisco. Allora, abbiamo un'altra domanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000809,
					"content": "Oh? Chiedete pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000810,
					"content": "Perché indossi una maschera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "Costui... si aggira tra i mortali, compie buone azioni e libera il mondo dal male. Costui non rivela il suo volto per non arrecare a questo regno più disturbo di quanto sia necessario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000815,
					"content": "Ah, capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000816,
					"content": "Dunque, quali sono i vostri desideri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000817,
					"content": "#Vorrei sapere dov'è {F#mio fratello}{M#mia sorella}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "Mmh... Costui intuisce che dietro questo desiderio si cela una storia tragica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000824,
					"content": "E così sia. Il potere di costui è in grado di esaudire questo desiderio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000825,
					"content": "Ma prima, costui deve avere una prova della tua... fede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000826,
					"content": "Cosa significa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000827,
					"content": "Le mere parole non sono sufficienti per comprendere un Adeptus. Costui deve cercare le profonde verità che si celano dietro di esse... Se non riesci a cogliere il significato nascosto delle sue parole, allora, purtroppo, costui non potrà darti alcun aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000828,
					"content": "Cosa facciamo? Paimon non riesce proprio a capirlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000829,
					"content": "Credo che voglia che addolciamo la pillola...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "Oh, giusto! Alcuni di quei seguaci hanno detto che hanno dovuto pagare una cospicua somma per ottenere l'aiuto dell'Adeptus, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000832,
					"content": "Beh, Paimon non ha intenzione di sborsare nessun Mora, e noi non abbiamo niente di valore con noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000833,
					"content": "Non hai neanche una Visione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000834,
					"content": "Non credo che la gente metta in vendita la propria Visione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "Ehi, perché non gli prepariamo qualcosa di delizioso? Nessuno può resistere alla tentazione del buon cibo, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000837,
					"content": "Nessuno che la pensi come te, di sicuro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "Sì, un po' di cibo delizioso funzionerà sicuramente! Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000840,
					"content": "Perché non andiamo a vedere alla Libreria Wanwen se hanno qualche nuova ricetta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000838,
					"content": "Gnam! Buona idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "Grazie per avermelo ricordato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "Credo che voglia un po' di Mora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "Voglio un potere che possa competere con quello degli dèi.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "Effettivamente, un potere come quello degli dèi permette di superare molti ostacoli. Ma costui non può fare a meno di chiedersi: perché nutri rancore nei confronti degli dèi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000821,
					"content": "#Vorrei diventare ricc{M#o}{F#a} subito!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#Aspetta un attimo! Hai dimenticato {M#tua sorella}{F#tuo fratello}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000823,
					"content": "Questo è un sentimento comune tra i mortali. Anche se dal tuo aspetto è evidente che non provieni da Liyue, costui percepisce l'influenza materialista che ha su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Ladro di stelle"
				},
				{
					"id": 111000811,
					"content": "Avanti, toglitela, fammi vedere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "Ehi! Non è un po' inopportuno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000813,
					"content": "Mh. Infatti, è un po' inopportuno che costui si tolga la maschera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "Ladro di stelle"
				}
			]
		},
		{
			"id": 1110010,
			"completionStepIds": [
				1110010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
