	"talks": [
		{
			"id": 1110001,
			"completionStepIds": [
				1110001
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110001",
							"2"
						],
						"stepId": 1110001,
						"stateName": "QUEST_STATE_UNFINISHED"
