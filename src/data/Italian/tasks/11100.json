			},
			"dialogs": [
				{
					"id": 111002301,
					"content": "Parla pure con loro, se desideri. Costui non desidera darsi arie, saranno le parole degli altri a dire la verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladro di stelle"
				}
			]
		}
	]
