		},
		{
			"id": 200202,
			"completionStepIds": [
				200202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200202",
							"2"
						],
						"stepId": 200202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020201,
					"content": "Uhm, perché non è ancora qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020202,
					"content": "#Non importa, possiamo iniziare prima con il tuo ingresso, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020203,
					"content": "Ascoltate, gente. Datemi la vostra attenzione, prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020204,
					"content": "Abbiamo raggiunto il culmine del Torneo della Crux. Siamo all'incontro finale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020205,
					"content": "Abbiamo assistito a molte battaglie emozionanti oggi e ora, finalmente, abbiamo i due finalisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020206,
					"content": "#Ora, vorrei presentarvi {F#la}{M#il} nostr{F#a}{M#o} prim{F#a}{M#o} combattente. Sebbene in pochi l'abbiano vist{F#a}{M#o} di persona, la sua reputazione non conosce limiti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020207,
					"content": "#Incute terrore nell'animo di Osayal, e i Messaggeri dei Fatui impallidiscono al solo udire il suo nome... Vi presento l'ero{F#ina}{M#e} itinerante di Liyue, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020208,
					"content": "Wooooow!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "Partecipante"
				},
				{
					"id": 20020209,
					"content": "Aspettavo questo momento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "Partecipante"
				},
				{
					"id": 20020210,
					"content": "Sono certa che avete assistito a un incontro emozionante in semifinale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020211,
					"content": "Ma l'ultimo round di oggi alzerà sicuramente il livello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020212,
					"content": "Riguardo all'altro nostro combattente... Ah, non è ancora arrivato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020213,
					"content": "Andiamo, perché ci mette così tanto? Non puoi semplicemente rinunciare per non esserti presentato come nei round precedenti... Questa è la finale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020214,
					"content": "Vi chiedo scusa! Rimanete qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020215,
					"content": "Forse ha confuso l'orario dell'incontro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "Non abbiamo altra scelta... Se non si presenta non ci resta che rimandare l'incontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020218,
					"content": "Un momento. Qualcosa non quadra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020219,
					"content": "Capitana Beidou, forse dovremmo controllare il premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}, vieni con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020216,
					"content": "Forse ha troppo paura di presentarsi alla finale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
		{
			"id": 200204,
			"completionStepIds": [
				200204
