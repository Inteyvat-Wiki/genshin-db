				"points": []
			},
			"dialogs": [
				{
					"id": 20021201,
					"content": "Eh? Beidou è già partita? Forse è tornata alla sua nave.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021202,
					"content": "Se state cercando la capitana, è stata convocata da Lady Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021203,
					"content": "Sembra che il Torneo della Crux sia sfuggito di mano e abbia attirato la sua attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021204,
					"content": "La capitana Beidou stava borbottando qualcosa sul fatto che Ningguang fosse una guastafeste mentre si dirigeva verso il Porto di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021205,
					"content": "Ahah, non è insolito che quelle due non vadano d'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021206,
					"content": "Tuttavia, la capitana Beidou era dispiaciuta di non essere riuscita ad assistere all'incoronazione del nuovo campione. Non vedeva l'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021207,
					"content": "Chi ha rubato la Visione doveva inizialmente essere l'avversario di questa persona nel round finale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021208,
					"content": "Sapeva di non avere speranze di vincere l'incontro, perciò ha avuto la cattiva idea di rubare il premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021209,
					"content": "In tal caso, il Torneo della Crux è chiaramente concluso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021210,
					"content": "Eh? Allora è andata così?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021211,
					"content": "#Se è così, allora le regole prevedono che sia squalificato... e che questa persona venga dichiarata {F#la campionessa}{M#il campione}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021212,
					"content": "Paimon pensava che avremmo vinto, ma non così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021213,
					"content": "Non importa, come si suol dire, \"onore dato, onore meritato\". Comunque, vado a preparare la medaglia da consegnarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021214,
					"content": "Quindi potremo andare a Inazuma adesso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "Sì, credo di sì. Anche se la capitana Beidou non è più qui, mi assicurerò che ne venga a conoscenza. È una donna di parola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021216,
					"content": "Ma il viaggio verso Inazuma è pericoloso. Una tempesta continua ti ostacolerà durante tutto il viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021217,
					"content": "In realtà, la pioggia e il vento implacabili sono una materializzazione della volontà della Shogun Raiden di chiudere la nazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021218,
					"content": "Aspetta un secondo, stai dicendo che può cambiare il clima con il potere della sua mente?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021219,
					"content": "Non dimentichiamoci che è una dei Sette Archon. Se Morax di Liyue riuscito a formare la Foresta di pietra di Guyun scagliando le sue lance di pietra, non dovrebbe sorprendere che la Shogun Raiden possa evocare una tempesta perpetua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021220,
					"content": "Basti pensare che se vuoi andare a Inazuma, all'Alcor servirà un po' di tempo. Ti avviserò una volta che tutti i preparativi saranno stati ultimati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021221,
					"content": "Nel frattempo, ho intenzione di intraprendere un viaggio per conto mio. Viaggerò attraverso le vaste terre di Liyue, nella speranza di trovare un modo per risvegliare la Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021222,
					"content": "Paimon è sicura che troverai un modo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021223,
					"content": "Grazie. Possano i nostri viaggi rivelarsi significativi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021224,
					"content": "Ho un ultimo avvertimento da dare. Dopo che avrai superato la tempesta, il tuo viaggio potrebbe rivelarsi ancora più arduo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
