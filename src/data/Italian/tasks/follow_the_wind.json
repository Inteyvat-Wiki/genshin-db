						],
						"stepId": 200209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fei Fei",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "Mi avete raggiunto... Com'è possibile?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020902,
					"content": "Avevo persino preparato una barca per assicurarmi una fuga veloce, eppure mi avete raggiunto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020903,
					"content": "Nessuna barca potrebbe mai eguagliare la velocità del vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020904,
					"content": "Il vento? Di che parli? Oh, ho capito... la tua Visione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020905,
					"content": "Cavolo, se solo avessi una Visione... O se fossi riuscito ad attivare questa, non mi avreste mai preso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020906,
					"content": "Non ha nulla a che vedere con le Visioni. Sarai anche abile a fuggire, ma sembra che tu sappia poco su come nasconderti dallo sguardo della natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020907,
					"content": "Inoltre, la via di fuga che hai scelto non andava bene per troppi motivi e, per di più, riuscivo a sentire nel vento le tue risate da sbruffone mentre ti inseguivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020908,
					"content": "In altre parole, non sei riuscito a soddisfare nessuno dei criteri di base per una grande rapina: ovvero velocità, furtività e stile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020909,
					"content": "Tu... Tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020910,
					"content": "Ma la cosa più deludente di tutte è lo stato della Visione che hai in mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020911,
					"content": "Sembra che la Visione non risponda al desiderio umano indiscriminatamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020912,
					"content": "Ok, va bene! Lo ammetto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020913,
					"content": "Ho messo gli occhi su questa Visione da un po' di tempo ormai. Ho deciso d'iscrivermi dopo aver sentito che questo torneo era pieno di pessimi combattenti. Mi son fatto strada fino alla finale e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020914,
					"content": "Ah, quindi dovevi essere tu il nostro avversario!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020915,
					"content": "#Avevo intenzione di vincere il torneo solo grazie alle mie abilità, ma poi sei arrivat{F#a}{M#o} tu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020916,
					"content": "Dopo aver visto le semifinali, sapevo di non avere speranze. Ma non potevo rinunciare alla Visione così facilmente dopo aver fatto tutta questa strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020917,
					"content": "Visto che non sarebbe servito a niente affrontarti nell'incontro, ho deciso di usare le mie abilità mentre l'attenzione di tutti era su di te e Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020918,
					"content": "Ero convinto di essermi preparato accuratamente per fuggire... ma in qualche modo siete comunque riusciti a raggiungermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020919,
					"content": "Non puoi più scappare, arrenditi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "Uff... Cavolo... Poteva... doveva andare diversamente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020923,
					"content": "Se resisti ulteriormente, ne pagherai le conseguenze.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "Ahah! Riconosco una falsa minaccia quando ne sento una!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020928,
					"content": "Bene... spero tu sia di parola! Non si è attivata nemmeno una volta presa, non è altro che un guscio inutile per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020929,
					"content": "Sai, secondo le leggi del mare, la pena per il furto consiste nel spezzare le braccia del colpevole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020930,
					"content": "Eh?! Stai scherzando, vero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020931,
					"content": "Senza contare che l'oggetto che hai rubato era un premio, che non ti sei presentato all'incontro finale e che hai rovinato la reputazione del capitano della flotta della Crux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020932,
					"content": "Sarebbe più giusto marchiarti la parola \"ladro\" in fronte con un ferro rovente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020933,
					"content": "Wow, wow, non abbiamo bisogno di arrivare fino a tanto, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020934,
					"content": "Uff, non avrei mai immaginato che potessi essere così crudele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020935,
					"content": "Se parlare mi mette nei guai, allora scordatelo. Rischierò lottando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020921,
					"content": "Consegna la Visione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "Dopo tutto quello che ho passato per averla? Scordatelo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020925,
					"content": "Fai come diciamo e non ci saranno ulteriori conseguenze.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "D-Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20020927,
					"content": "Se rinunci alla Visione, ti lasceremo andare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
