					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021101,
					"content": "A-Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021102
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20021102,
					"content": "No, no! Fai quello che vuoi, ma ti prego, non marchiarmi la fronte, ti prego!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021103
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20021103,
					"content": "Mmmh... Ha resistito fino all'ultimo, e ora la morte incombe... eppure, gli dèi non gli concedono il loro favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021104,
					"content": "...Metti giù la Visione e vattene. Ho cambiato idea... Non sarai punito ulteriormente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021105,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021106
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20021106,
					"content": "Che c'è? Vuoi essere punito ancora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021107,
					"content": "Dipende da te. Un desiderio simile è ammirevole e si addice a un samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021108,
					"content": "N-No, non ce n'è bisogno. Grazie per avermi lasciato andare. Quanta generosità in te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021110
					],
					"speakerTitle": "Fei Fei"
				},
				{
					"id": 20021110,
					"content": "Oh, Paimon non capisce. Stavi solo cercando di spaventarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021111,
					"content": "Non provo alcun piacere a spaventare gli altri. Stavo solo verificando ogni possibilità mentre la Visione era in mano sua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021112,
					"content": "Quando le persone sono messe alle strette, è allora che mostrano la loro forza più grande. Ho pensato che potesse essere la sua occasione per risvegliare la Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021113
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021113,
					"content": "Ma purtroppo non è successo niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021114,
					"content": "Quindi era questo il tuo piano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021115
					]
				},
				{
					"id": 20021115,
					"content": "Sì, volevo sapere se fosse possibile risvegliare una Visione spenta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021116,
					"content": "Da quando ha rubato la Visione, ho deciso di usarlo per questo esperimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021117
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021117,
					"content": "Ho provato molti altri metodi in passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021190
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021190,
					"content": "Anche se pochi racconti narrano di un \"risveglio della Visione senza padrone\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021191
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021191,
					"content": "Dopo averti visto padroneggiare più elementi, ho pensato che nulla è impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021192
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021192,
					"content": "Vieni, perché non ci provi? Vediamo se riesci a darmi la risposta che spero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021118,
						20021119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021118,
					"content": "Ci proverò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				},
				{
					"id": 20021120,
					"content": "Mmmh, la Visione non sembrava reagire affatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021121,
					"content": "Capisco... Quindi neanche tu sei in grado di riaccendere la Visione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021122
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021122,
					"content": "...Non importa, me l'aspettavo. Immagino che questa Visione sia ancora da considerare mia per ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021123,
						20021124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021123,
					"content": "Perché ci tieni così tanto a questa Visione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021125,
					"content": "Già, cos'ha di importante questa Visione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021126,
					"content": "La sua importanza riguarda un vecchio amico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021127
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021127,
					"content": "Forse un giorno potrei scoprire che tutto ciò che ho fatto è privo di significato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021128,
					"content": "Ma in quanto samurai errante, trovo un senso nel viaggiare e nell'immensa bellezza della natura che si trova lungo il percorso, seppur continui a preservare la \"via del guerriero\" nel mio cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021129,
					"content": "Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021130,
					"content": "Eheh, è solo un altro modo per dire che faccio come mi pare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021131,
					"content": "Va bene. È ora di tornare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021132,
						20021134
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021132,
					"content": "Andiamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021133
					]
				},
				{
					"id": 20021133,
					"content": "Lasciate che raccolga ancora una volta il vento per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021134,
					"content": "Se hai bisogno di parlare ancora, sarò qui ad ascoltarti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021135
					]
				},
				{
					"id": 20021135,
					"content": "...Non preoccuparti dei miei sentimenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021136
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021136,
					"content": "Ma grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021124,
					"content": "Perché sei così deciso a riattivare la Visione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				}
			]
		},
		{
