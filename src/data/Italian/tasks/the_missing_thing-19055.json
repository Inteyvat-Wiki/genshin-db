			"dialogs": [
				{
					"id": 190550901,
					"content": "Todoroki, la spedizione è arrivata ed è pronta per l'ispezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550902
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190550902,
					"content": "Bene, andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190550903,
					"content": "Ehi, è Todo... mmmf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190550904,
					"content": "Shhh! Fai silenzio. Seguiamolo e vediamo dove ci porta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shikanoin Heizou"
