			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tokuda",
					"Todoroki",
					"Masashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "Le tue informazioni erano corrette. Quando siamo arrivati, i Nobushi stavano ancora dormendo, ahah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551002,
					"content": "Li abbiamo catturati tutti, abbiamo recuperato la merce e l'abbiamo riportata qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551003,
					"content": "Fatemi dare un'occhiata. Mmmh... Sembra tutto in ordine, buon lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551004,
					"content": "Grazie al lavoro con le carovane, il prezzo del grano nel villaggio è diminuito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551005,
					"content": "È vero, e chi avrebbe mai pensato che le ferite subite durante la guerra avrebbero avuto un effetto così persistente sul nostro corpo. Ma fortunatamente, hai anche portato con te alcune medicine preziosissime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Masashi"
				},
				{
					"id": 190551006,
					"content": "Le cose stanno migliorando grazie agli aiuti dall'alto. A proposito, in che condizioni è l'inventario del villaggio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551007,
					"content": "Assicuratevi che sia confermato stasera, devo partire domani mattina dopo essere andato al Santuario dei Sangonomiya e aver ricevuto istruzioni dal generale Gorou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551008,
					"content": "Non preoccuparti, abbiamo già preparato l'elenco, seguiteci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masashi"
				}
			]
		},
