			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gorou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#Mi scuso ancora per non essere stato completamente onesto con voi, {NICKNAME}. Mi dispiace davvero, ma... dovevo farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551602,
					"content": "Capisco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "A proposito, Kokomi sa di tutto questo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "Ah sì, Sua Eccellenza... Beh, diciamo che la guerra ha portato molte cose terribili e ci ha anche costretti a imparare molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551605,
					"content": "Sì, ma questo non risponde alla domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551606,
					"content": "#Beh... non siete curios{F#e}{M#i} di sapere chi sta spingendo per la nuova legge sulle merci? Di sicuro non è la Commissione Kanjou, perché non ne trae un vantaggio immediato, e noi non abbiamo alcun legame con loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551607,
					"content": "Sì... è come se gli dèi fossero apparsi all'improvviso per offrirvi una mano divina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551608,
					"content": "Ahah, sì, gli dèi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551609,
					"content": "Qualche tempo fa sono stato invitato a partecipare al Festival di Irodori sull'Isola di Narukami con Sua Eccellenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551610,
					"content": "Al festival, ho aspettato al mercato mentre Sua Eccellenza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
