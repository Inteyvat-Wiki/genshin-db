			"dialogs": [
				{
					"id": 190551701,
					"content": "È andata a trovare Lady Yae.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551702
					]
				},
				{
					"id": 190551702,
					"content": "Già.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551802
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551802,
					"content": "È andata alla Commissione Kanjou per incontrare Lady Yae... Apparentemente per la recensione di un libro, ma c'erano anche altri punti all'ordine del giorno. L'incontro non è stato reso pubblico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551803
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551803,
					"content": "Dopo il suo ritorno, abbiamo iniziato i nostri tentativi di incrementare l'attività commerciale, e non è passato molto tempo prima che venisse proposta una nuova legge per le merci sull'Isola di Narukami...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551804,
					"content": "Allora, cosa ne pensate? Credete che Sua Eccellenza ne sia a conoscenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
