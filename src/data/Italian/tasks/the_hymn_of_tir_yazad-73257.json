					"nextDialogs": [
						732573004
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573004,
					"content": "Ora però che il sigillo è stato rimosso, anche il sudiciume del passato è stato liberato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573005
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573005,
					"content": "Il rito non potrà essere proseguito se io e Rashnu non diamo tutta la nostra energia. Quindi ti prego di prenderti cura di questi luoghi per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732573006
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732573006,
					"content": "Eheh, lascia fare a me! È compito della Guardiana della fioritura combattere la contaminazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
