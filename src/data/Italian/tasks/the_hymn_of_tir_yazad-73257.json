			"dialogs": [
				{
					"id": 732572901,
					"content": "Fatto. Il sentiero che conduce alle profondità si è aperto e la nostra missione è completata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572902
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572902,
					"content": "Che velocità. Continuavi a parlare di \"riti\" e tutto il resto, così Paimon ha pensato che ci sarebbe voluta una buona dose di incantesimi pieni di parole difficili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572903,
					"content": "Umpf, solo gli umani hanno bisogno di cose così, poiché non riescono a brandire il potere degli elementi da soli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572904
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572904,
					"content": "Noi Pari siamo diverse. Sia il nostro potere che quello di Khvarena condividono la stessa fonte. È come per voi umani camminare: non vi occorrono incantesimi per farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572905
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572905,
					"content": "Uhm... Sebbene non cammini, tu fluttui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572906
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572906,
					"content": "Come ha detto Paimon, la tua logica è strana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572907,
					"content": "Comunque, non perdiamo tempo su un argomento così triviale. Lascerò che siate voi a occuparvi del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732572908
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732572908,
					"content": "\"Possa la Khvarena eterna guidarci lungo il nostro cammino di ascesa.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
