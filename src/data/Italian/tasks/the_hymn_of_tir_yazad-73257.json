			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "Sorush non ha aperto bocca da quando abbiamo lasciato la fabbrica in rovina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570102,
					"content": "Fino a prima non faceva che parlare in continuazione, Paimon non è abituata a vederla così silenziosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570103,
					"content": "Dev'essersi spaventata molto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "Coraggio, Sorush! Abbiamo ancora tanto da fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570107,
					"content": "Per esempio, dobbiamo eseguire... ehm, quel rito col nome strano e richiudere quel buco gigante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570108,
					"content": "Dopodiché, potremo goderci un bel pasto delizioso come premio per il duro lavoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570109,
					"content": "Potremmo mangiare un po' di... Ehm, Paimon non sa cosa piace alle Pari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570111,
					"content": "...Alle Pari non occorre nutrirsi, Sciocchina volante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570112,
					"content": "*sospira* Come sono caduta in basso. Ci mancava solo la Pallidina volante che tenta di consolarmi... Che onta indicibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570113,
					"content": "Preferirei essere sigillata nei Cristalli grigi seduta stante, o trovare una caverna dove addormentarmi indisturbata finché tutti quelli che conosco non ci saranno più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570114,
					"content": "Paimon ti ha detto che Paimon non è una Pallidina volante! Ma una caverna simile esiste davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570115,
					"content": "Evitare il problema non lo risolve di certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "Cosa vuoi che me ne importi, a questo punto?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570119,
					"content": "Come posso continuare a vivere sopportando la vergogna di essere stata buggerata da Nasejuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570120,
					"content": "In ogni caso, ora che avete raccolto tutti i Grandi Canti di Khvarena, potete andare da Mihir o da Rashnu per risolvere l'anomalia nel cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570121,
					"content": "Qualunque cosa decidiate di fare, lasciatemi in pace e fate finta di non aver udito una sola parola di quello che ho detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570122,
					"content": "Ehm, di roba strana ne hai detta un bel po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570123,
					"content": "#\"{F#La mia}{M#Il mio} Yasnapati\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "Aaaaah, basta! Ti prego, smettila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}, smettila di prenderla in giro! Abbiamo viaggiato insieme a lei così a lungo, dopotutto. Paimon non vuole che se ne vada così, a metà strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570128,
					"content": "E poi, anche Sorush ha le sue... qualità... Per esempio, ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570129,
					"content": "Stai esitando! *piagnucola* Smettila con questa supponenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570130,
					"content": "Agisci con sollecitudine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "Sì sì! E ci siamo impegnati a fondo per eliminare il Segno di Apaosha, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570133,
					"content": "#È solo grazie a te se siamo arrivat{F#e}{M#i} fin qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570134,
					"content": "Com'è che era? Lascia pensare Paimon... Ah, sì: \"Se continui così, sarà solo una questione di tempo e diventerai una vera avventuriera\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570135,
					"content": "Dite sul serio? I vostri sono complimenti sinceri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570136,
					"content": "#Sì, sinceri come lo sarebbe un{F#'}{M# }amic{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "Eheh, sapevo di essere eccezionale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570138,
					"content": "Eheh, ho ritrovato la motivazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570139,
					"content": "Ora che la vecchia Sorush è di nuovo con noi, torniamo da Zurvan, sistemiamo quel buco gigante e prendiamoci la ricompensa! Paimon non vede l'ora di rimpinzarsi a volontà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570131,
					"content": "Hai un grande senso di responsabilità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "\"Il mio portamento valoroso\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "\"Ineluttabile sacrificio\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "Hai ancora un compito da svolgere, non è vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "Lo so, lo so, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570104,
					"content": "Beh, considerato quanto è successo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "Magari è solo stanca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325702",
							"2"
						],
						"stepId": 7325702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "#Zurvan, siamo tornat{F#e}{M#i}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570202,
					"content": "#Ah! {NICKNAME}, Sorush e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570203,
					"content": "A giudicare dai vostri volti, avete ottenuto tutti i Grandi Canti di Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570204,
					"content": "Anche se c'è stato qualche intoppo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "In ogni caso, è il risultato sperato. Affidare a voi la missione è stata la scelta migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570207,
					"content": "Senza di voi, i Grandi Canti di Khvarena avrebbero rischiato di finire in mano a individui dalle intenzioni malvagie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570208,
					"content": "Uh. Perché Paimon ha l'impressione che Zurvan c'abbia visto lungo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570209,
					"content": "Eheh, dunque non ci sono andata lontano! Avete avuto a che fare coi seguaci della fossa oscura, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570210,
					"content": "Come lo sai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "Ebbene... Piuttosto che fare domande simili, perché non mi dici cos'è accaduto esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570214,
					"content": "Racconti a Zurvan l'avventura nelle rovine sotterranee e il tradimento di Nasejuna.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "Eheh, perfino il Vijnanapati dell'Ordine si è schierato con la fossa oscura. Inaspettato. Non che nutrissi speranze in loro, ma questo oltrepassa ogni misura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570216,
					"content": "Se non erro, Nasejuna è stato indotto alla ricerca dei Grandi Canti di Khvarena dal servo della fossa oscura che avete affrontato. È una mia vecchia conoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570217,
					"content": "Eh? Conosci quel tizio che appartiene all'Ordine dell'Abisso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570218,
					"content": "Umpf, apparteneva all'Ordine degli Scettici. Diversi secoli or sono, una squadra d'indagine proveniente dalla foresta venne a esplorare i segreti dei dahriani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570219,
					"content": "Insistevano nel voler accedere alle rovine dahriane malgrado le ammonizioni dell'Ordine. Così, il Vijnanapati dell'epoca inviò quell'uomo insieme alla squadra onde evitare che accadesse il peggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570220,
					"content": "Nessuno sapeva ciò che avrebbero trovato nelle rovine, ma quando egli riapparve aveva già abbracciato i favori della corruzione, e della squadra d'indagine non si ebbe più notizia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570221,
					"content": "Poi arrivarono i seguaci della fossa oscura. Erano alla ricerca dei Grandi Canti di Khvarena e, a tale scopo, evocarono orde demoniache di Dev per attaccare l'Oasi di Vourukasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570222,
					"content": "Grazie all'aiuto di un gran numero di Pari e guerrieri umani, riuscimmo a proteggere la nostra casa, ma non fummo in grado di sgominare i seguaci della fossa oscura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570223,
					"content": "Per assicurarmi di non lasciare loro alcun margine d'azione, sigillai l'Oasi di Vourukasha e le molte rovine col potere dei Grandi Canti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570224,
					"content": "L'Ordine degli Scettici non si è mai ripreso da quell'incidente. I loro antichi archivi finirono in fiamme e gradualmente divennero ciò che sono ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570225,
					"content": "Da quanto li avete menzionati l'ultima volta, ho percepito un certo fermento tra i seguaci della fossa oscura, ma non immaginavo lontanamente che avrebbero finito col corrompere anche il capo degli Scettici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570226,
					"content": "Comunque sia, Paimon ripensa ancora a quello che ha detto Nasejuna. Tu sai niente a proposito degli antenati degli Scettici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570227,
					"content": "Ci hai combattuto insieme, dopotutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "Eheh, la storia diviene leggenda, e la leggenda diviene racconto... È così che permangono le tradizioni. Anche l'oblio è parte integrante della storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570229,
					"content": "Più ci si aggrappa all'idea di tradizione, più si tende a ricordare solo la storia che si desidera, finendo per smarrirsi nel dedalo dei racconti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570230,
					"content": "In un mondo dove ci si dimentica di qualcosa quotidianamente a ogni ora, ciò che scolpiamo sulla terra è molto più affidabile di ciò che cantiamo al vento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570231,
					"content": "#Per questo confido in voi: siete franch{F#e}{M#i} e sembra che non vi lasciate condizionare dal giudizio altrui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570232,
					"content": "So che sono dei complimenti, ma il modo in cui lo dici è un po' strano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570233,
					"content": "Avverto un filo di sarcasmo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "Immagino che l'anziana Zurvan si riferisca a me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570235,
					"content": "In quanto a ciò che è accaduto cinquecento anni fa, confido preferiate assistervi di persona piuttosto che ascoltare la mia versione della storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570236,
					"content": "E ora se ne presenta l'opportunità perfetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570237,
					"content": "A proposito, Sorush, sembra che tu sia diventata più affidabile. Dopo quanto hai passato, ti sei finalmente risvegliata da quei deliranti miti umani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570238,
					"content": "Anziana! La prego, dimentichiamo quella storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570239,
					"content": "#Immagino che affidare a {NICKNAME} e Paimon la faccenda sia stata la decisione più giusta. Stando così le cose, credo di potervi affidare senza remore anche il Rito dell'Ab-Zohr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570240,
					"content": "Il Rito dell'Ab-Zohr...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "Paimon ricorda che Zurvan l'aveva già menzionato! Serve a purificare... mmh, la contaminazione di qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570242,
					"content": "Il Rito dell'Ab-Zohr è un cerimoniale atto a purificare la contaminazione dell'Harvisptokhm. Normalmente basta officiarlo all'ombra degli alberi per sopprimere le tenebre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570243,
					"content": "Tuttavia, il sigillo si è indebolito e l'anomalia nel cielo è riapparsa, quindi ci occorrerà qualcosa in più del solito per risolvere il problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570244,
					"content": "L'anomalia è apparsa sull'Harvisptokhm poiché l'albero ha assorbito una notevole quantità di contaminazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570245,
					"content": "Con una quantità così eccessiva di sudiciume al suo interno e la corruzione causata dall'anomalia, l'Harvisptokhm non è più in grado di sostenere il potere di Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570246,
					"content": "L'unica cosa che possiamo fare è entrare nell'Harvisptokhm per purificarlo e risvegliare la nostra dea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570247,
					"content": "Quindi è possibile entrare nell'Harvisptokhm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570248,
					"content": "Certamente. Pensavi che il Rito del Chinvat andasse officiato all'interno della fossa oscura? Perfino una Pari non riuscirebbe a sopportare la sua contaminazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570249,
					"content": "Nell'Harvisptokhm c'è un loto gigante, il Gaokerena, al cui interno riposa la coscienza della nostra dea. Purificando la contaminazione, il Sacrofiore tornerà a sbocciare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570250,
					"content": "L'Amrita ripulirà la terra da ogni impurità. Può sembrare un processo contorto, ma sono certa che voi non troverete ostacoli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570251,
					"content": "Molto bene, ho già inviato Rashnu e Mihir alla Fossa di Tunigi. Portate con voi i Grandi Canti, così potrete radunare il potere di Khvarena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570252,
					"content": "Khvarena risveglierà i grandi alberi che sopprimono l'oscurità e purificherà l'empia fanghiglia nelle profondità. Dopo ciò, potrete officiare il Rito del Chinvat e dunque aprirvi la strada nell'Harvisptokhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570253,
					"content": "Una volta dentro, la Corona rivelerà a Sorush le grandi gesta degli antichi eroi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570254,
					"content": "Tutti i ricordi relativi a Khvarena sono destinati a tornare all'Harvisptokhm, pertanto, anche se le leggende vengono narrate o alterate, tali ricordi non sbiadiranno mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570255,
					"content": "Non ne avevo mai sentito parlare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570256,
					"content": "Eheh, la Corona era parte dell'Harvisptokhm, in origine. Saprai tutto quando sarai lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570257,
					"content": "Ora, vi prego, andate ed eliminate il Segno di Apaosha. Ci incontreremo di nuovo quando l'Amrita cadrà dal cielo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570212,
					"content": "Sì, è così.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "Oh, allora riferitemi tutto, per filo e per segno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570205,
					"content": "Sono a pezzi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				}
			]
		},
		{
			"id": 7325704,
			"completionStepIds": [
				7325704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325704",
							"2"
						],
						"stepId": 7325704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rashnu",
					"Mihir",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570401,
					"content": "Perché Sorush ci mette tanto...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570402
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570402,
					"content": "Stiamo aspettando qui da non so quanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570403,
					"content": "Che stanchezza... Voglio... tornare a... dormire... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570404
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570404,
					"content": "Ehi, non è giusto. Sono io quella che si sta dando da fare, voi non avete fatto niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570405
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570405,
					"content": "Non è vero. Aspettare fa parte del lavoro. Infatti, l'azione non è che un attimo, l'attesa è per sempre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570406,
					"content": "Che razza di logica assurda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570407,
					"content": "Tale è la filosofia di noi Pari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570408
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570408,
					"content": "Ma non è questo il momento per filosofeggiare. Ora dobbiamo pensare ai Grandi Canti di Khvarena. Immagino che li abbiate raccolti tutti, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570409
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570409,
					"content": "Ovviamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570410,
					"content": "In tal caso, rimuoviamo il sigillo. Dopodiché potrete radunare il potere di Khvarena grazie ai Grandi Canti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570411
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570411,
					"content": "Ma fate attenzione. Poiché il sudiciume si è accumulato nei secoli, non ho idea di cosa emergerà da esso una volta rimosso il sigillo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
		},
