			},
			"dialogs": [
				{
					"id": 732571701,
					"content": "Mh, il nostro lavoro è finito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571702,
					"content": "Sembra che siano cresciuti dei fiori sull'albero. Ma ora che facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571703,
					"content": "Ah, non guardare me. Ne so meno di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571704
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571704,
					"content": "Ora che Sorush ha finalmente indossato la Corona bicorne, può usare il suo potere per connettersi alle memorie e alla saggezza dell'Harvisptokhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571705
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571705,
					"content": "Prova, Sorush.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571706
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571706,
					"content": "Sì, è solo che non sono ancora abituata alla Corona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571707
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571707,
					"content": "Uhm... Mi sembra d'intravedere dei nuovi germogli, ma il sudiciume non è stato ancora del tutto purificato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571708
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571708,
					"content": "Dobbiamo ancora purificare questi fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732571709,
					"content": "Allora il potere della purezza di Khvarena prospererà di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
