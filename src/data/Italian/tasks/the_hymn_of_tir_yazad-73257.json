			},
			"dialogs": [
				{
					"id": 732571401,
					"content": "C'è silenzio, finalmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732571402,
					"content": "Adesso esegui il Rito del Chinvat prima che il sudiciume inizi a fuoriuscire nuovamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571403,
					"content": "Così il nostro compito sarà terminato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571404
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571404,
					"content": "E questo significa... Che potrò dormire in pace... senza nessuno che mi disturbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571405
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732571405,
					"content": "Dai, Sorush!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732571406,
					"content": "Sorush, sbrigati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571407
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732571407,
					"content": "Dobbiamo esserci tutte e tre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
		},
