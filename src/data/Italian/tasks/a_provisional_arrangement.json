			"dialogs": [
				{
					"id": 210230201,
					"content": "Dobbiamo riparare in fretta le scale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230202,
					"content": "Sei tu il locandiere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "Sì. Cosa posso fare per voi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230204,
					"content": "Di sotto, un tizio ci ha chiesto di darti questo pacchetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210230205,
					"content": "Oh, dev'essere un pacchetto inviatomi da un ospite. Ma perché Zhen Qiang non me lo ha portato di persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230206,
					"content": "Ha ancora delle merci da prendere, eh? Ah, scommetto che in realtà è solo pigro e non ha voglia di far su e giù con l'ascensore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230207,
					"content": "#Mi dispiace che le scale fossero rotte proprio ora che sei nostr{F#a}{M#o} ospite. Sto cercando un modo per ripararle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230208,
					"content": "E pensare che ti è stato anche chiesto di portarmi questo pacchetto fin quassù. Prendi, in segno della mia gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230209,
					"content": "All'inizio spettava a Zhen Qiang, ma mi hai consegnato tu il pacchetto, quindi è giusto che la ricompensa vada a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230210,
					"content": "#Bene, allora. Ora devo andare a organizzare i lavori di riparazione. Sentitevi liber{F#e}{M#i} di fare un giro della locanda, e non esitate a cercarmi se avete bisogno di qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
	]
