			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "Ehilà, che ne pensi di questi fiori sbocciati? Non sono splendidi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270102,
					"content": "Altroché se lo sono!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "Eheh, grazie. Me ne prendo cura con amore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270106,
					"content": "A ogni modo, posso chiederti un altro favore? Ora che i fiori sono sbocciati, volevo selezionarne alcuni da far essiccare, per allegarli alle lettere che invierò alle persone non ancora tornate a vivere a Tatarasuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270107,
					"content": "Però, non so... Sono uscita per raccoglierli, ma la stanchezza ha avuto la meglio... Forse davvero per la mancanza di sonno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270108,
					"content": "Potresti per favore raccogliere alcuni Fiordolci qui nei dintorni? Ne basteranno tre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270109,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "Allora lascio fare a te. Io mi prendo una pausa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270112,
					"content": "Voglio solo la delicata fragranza dei Fiordolci, allegherò alla lettera altri fiori essiccati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270113,
					"content": "Penso che l'umore di chiunque leggerà questo messaggio, arricchito da un profumo tanto piacevole, migliorerà come per incanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270114,
					"content": "Conto su di te, allora. Nel frattempo mi riposerò un po'... Una volta raccolti i fiori, torna pure da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721270111,
					"content": "I Fiordolci crescono ovunque...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "Da quanto tempo stai piantando fiori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "Non troppo, è solo che... Diciamo che dormo un po' di meno, ecco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
		{
