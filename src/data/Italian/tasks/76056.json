			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560601,
					"content": "#Non posso credere di aver perso contro {F#una}{M#un} passante... tre volte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560602,
					"content": "No, no, noi due abbiamo perso due volte ciascuno, e il capo ha perso solo una volta, quindi non è poi così male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560603,
					"content": "#Eh! Una sconfitta è una sconfitta, inutile rimuginare. {NICKNAME}, ci sai fare davvero!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560604,
					"content": "#Voi due non potete battermi nemmeno in un giorno fortunato... E ora avete visto {F#una vera maestra}{M#un vero maestro} in azione. Capito? Dovrete allenarvi molto di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560605,
					"content": "E io? Hah... Forse è tempo di pensare a un pensionamento anticipato. Mi chiedo se stiano ancora assumendo gente al campo di addestramento di Vaino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605607,
