					"nextDialogs": [
						710800643
					]
				},
				{
					"id": 710800643,
					"content": "#Ahah! Che storia interessante! \"'Oggi è un brutto giorno, poiché siamo stati salvati da{F#lla}{M#l} nostr{F#a}{M#o} acerrim{F#a}{M#o} nemic{F#a}{M#o}!' sospirò il serzhant Anton...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800644
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800644,
					"content": "\"Eppure, chi oggi è nostro amico, domani potrebbe diventare un nemico.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
