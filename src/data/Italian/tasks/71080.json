			"dialogs": [
				{
					"id": 710800701,
					"content": "Grazie per avermi aiutato a completare il mio poema epico... Ah, giusto! Accetta questa copia del mio manoscritto in segno di ringraziamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800702,
					"content": "Fiuuu... Questo manoscritto racchiude ogni mia emozione e ambizione. Ti prego, prendilo. Dartelo è il minimo che possa fare per ringraziarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7108008,
