			"dialogs": [
				{
					"id": 710800634,
					"content": "#Racconta della ricerca di tu{F#o fratello}{M#a sorella}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800635
					]
				},
				{
					"id": 710800635,
					"content": "Racconti a Taliesin quanto è accaduto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800636
					]
				},
				{
					"id": 710800636,
					"content": "È... davvero affascinante. Una terra antica e dimenticata, sacrifici ignorati, una punizione ingiusta che porta alla follia... Che tematiche importanti! Che storia vasta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800637
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800637,
					"content": "E pensare che sono tutte cose che ti sono successe nei tuoi viaggi, e che sono così vicine ai tuoi obiettivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800638
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800638,
					"content": "Grazie infinite per avermi raccontato tutto. Lo trascriverò, ma non credo di poter ancora comporre un poema in merito... Credo che questi racconti non siano che brevi capitoli della saga della tua vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800639
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800639,
					"content": "Non sono abbastanza bravo per scrivere la tua storia... Ti chiedo solo di raccontarmi del tuo viaggio non appena l'avrai portato a termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800640
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800640,
					"content": "Ho l'impressione che, quando arriverà il momento, avrò l'onore di ascoltare la storia più eroica mai tramandata al mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
