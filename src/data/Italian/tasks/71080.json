				{
					"id": 710800607,
					"content": "Racconta di come hai rimosso la Matrice delle Sette Stelle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800608
					]
				},
				{
					"id": 710800608,
					"content": "Racconti a Taliesin quanto è accaduto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800609
					]
				},
				{
					"id": 710800609,
					"content": "Ehm... \"Perciò, con l'aiuto di una fedele serva\"... No, aspetta, così non va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800610
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800610,
					"content": "#\"Con l'aiuto di una fedele amica, {NICKNAME} aprì la strada verso le miniere!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800611
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800611,
					"content": "Ehm... Sicuro si possa fare? Non le abbiamo chiesto se possiamo citarla nella storia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710800612,
					"content": "Ah, non temere! Gli eroi si comportavano diversamente dalla gente comune, e non sono vincolati da regole tanto banali! Non importerà a nessuno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
