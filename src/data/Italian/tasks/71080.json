			"dialogs": [
				{
					"id": 710800617,
					"content": "Racconta del cristallo azzurro trovato nelle profondità della Voragine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800618
					]
				},
				{
					"id": 710800618,
					"content": "Racconti a Taliesin quanto è accaduto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800619
					]
				},
				{
					"id": 710800619,
					"content": "\"Il cielo e l'acqua scorrevano sulla superficie del cristallo, e le chiazze viola e rosse svanirono...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800620
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800620,
					"content": "#\"L'antica creatura delle rovine vacillò, poiché era stata colpita dal pugno di ferro di {NICKNAME}, e fu proprio allora che arrivò la star principale!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800621
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800621,
					"content": "#\"...La misteriosa alleata arrivata in aiuto de{F#lla}{M#l} viaggiat{F#rice}{M#ore} era svanita senza lasciare traccia, ma il gigantesco serpente artificiale era già stato fatto in mille pezzi dal cristallo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
