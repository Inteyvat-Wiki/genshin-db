					"nextDialogs": [
						710800624
					]
				},
				{
					"id": 710800624,
					"content": "Affascinante... Quasi inimmaginabile... Lasciatemi riflettere un attimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800625
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800625,
					"content": "\"Sebbene quel fungo imponente svettasse fino al cielo, le tenebre sconfinate lo resero impotente...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800626
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800626,
					"content": "#\"In risposta alla sua chiamata, {NICKNAME} si fece avanti e purificò la terra, prevenendo una crisi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
