					]
				},
				{
					"id": 710800630,
					"content": "Racconti a Taliesin quanto è accaduto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800631
					]
				},
				{
					"id": 710800631,
					"content": "#È... meraviglioso! \"E così, {F#la}{M#il} predestinat{F#a}{M#o} viaggiat{F#rice}{M#ore} disse: 'Non serve attaccarmi uno per volta, posso farvi fuori tutti insieme!'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800632
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800632,
					"content": "Ehm, stai un po' esagerando...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800633
					]
				},
				{
					"id": 710800633,
					"content": "Non preoccuparti... Se me lo permetti, vorrei un po' di licenza poetica nel raccontare le vite precedenti di quei nove spadaccini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
