			"dialogs": [
				{
					"id": 710800601,
					"content": "Forse ti sembrerà una richiesta improvvisa, ma... Avresti tempo di raccontarmi una o due delle tue avventure, così che io possa convertirle in canzoni da tramandare ai posteri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800602,
						710800603
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800602,
					"content": "Beh, se vuoi solo che ti racconti qualcosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				},
				{
					"id": 710800604,
					"content": "Te ne sarei eternamente grato! Bene, spara pure! Sono tutt'orecchi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800603,
					"content": "Posso raccontarti un sacco di storie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				}
			]
		},
