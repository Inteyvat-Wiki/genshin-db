			"dialogs": [
				{
					"id": 710800613,
					"content": "Racconta dell'oscurità e delle creature provenienti dall'Abisso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800614
					]
				},
				{
					"id": 710800614,
					"content": "Racconti a Taliesin quanto è accaduto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800615
					]
				},
				{
					"id": 710800615,
					"content": "Oh, cielo! Questa è fantastica, è perfetta! Dammi un attimo, la devo scrivere tutta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800616
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800616,
					"content": "\"La nebbia oscura li schiacciava come una valanga, e i due apostoli dell'Abisso, ora separati, svanirono così com'erano apparsi, senza lasciare traccia.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
