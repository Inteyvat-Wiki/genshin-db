				"points": []
			},
			"dialogs": [
				{
					"id": 200390401,
					"content": "Iniziamo col farti preparare un po' di olio essenziale folgorante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390402,
					"content": "#È un prodotto alchemico fondamentale, perfetto per {F#una}{M#un} principiante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390403,
					"content": "Per preparare l'olio essenziale folgorante, ti serviranno dei Cristalli di Electro e una rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390404,
					"content": "Entrambi si trovano facilmente fuori dalla città... Come? Non vedi il collegamento tra cristallo e olio essenziale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390405,
					"content": "Ahahah, ma è perché non c'è! Il Cristallo di Electro è per la parte elettrica, è la rana che fornisce l'olio essenziale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390406,
					"content": "Quando avrai raccolto tutto, prova a preparare dell'olio essenziale folgorante. Non usare mezze misure, metticela tutta! Io ti osservo da qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390407,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
