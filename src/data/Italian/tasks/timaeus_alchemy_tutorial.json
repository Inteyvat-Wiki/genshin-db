					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390503
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390503,
					"content": "Per preparare l'olio essenziale congelante, ti serviranno una coda di lucertola e alcune corolle di Fiordinebbia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390504
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390504,
					"content": "Entrambe si trovano facilmente in natura... Qual è il senso della coda di lucertola, dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390505,
					"content": "Beh, la croccantezza di una coda di lucertola congelata rende la pozione molto più appetitosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390506
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390506,
					"content": "Ahah, scherzo, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390507,
					"content": "Quando avrai raccolto tutto, prova a preparare dell'olio essenziale congelante. Non usare mezze misure, metticela tutta! Io ti osservo da qui.",
