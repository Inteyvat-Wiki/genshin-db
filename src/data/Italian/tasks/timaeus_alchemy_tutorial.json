			"dialogs": [
				{
					"id": 200390101,
					"content": "Voglio scoprire di più sull'alchimia",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390102,
					"content": "L'antica arte dell'alchimia è semplicemente affascinante... vorrei che fosse apprezzata da più persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390103
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390103,
					"content": "Oh, anche a te piace l'alchimia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390104,
					"content": "Sì, direi di sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200390105
					]
				},
				{
					"id": 200390105,
					"content": "#Beh, allora {F#ragazza}{M#ragazzo}, è tempo che tu faccia un po' di esperienza diretta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390106,
					"content": "Tutte le grandi scoperte iniziano da delle basi solide, e da lì proseguono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
