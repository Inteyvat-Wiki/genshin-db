			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Susukida"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-3098.524,
							214.543,
							-4296.803
						],
						"pointId": 322100690
					},
					{
						"sceneId": 3,
						"position": [
							-3097.322,
							214.326,
							-4298.16
						],
						"pointId": 322100714
					}
				]
			},
			"dialogs": [
				{
					"id": 120460301,
					"content": "Sai, stamattina sono uscito in mare, ed ero talmente distratto che la rete mi è scappata di mano... Ah, beh, sono cose che capitano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460302,
					"content": "Già, anch'io sono scombussolato, oggi... Ma, alla fine, qual è il problema? È scappato qualche bandito, ma non è la fine del mondo. Ahahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460303,
					"content": "Ehi, voi due! Murasaki e Shion si sono ammalate, ed è tutta colpa dei vostri brutti sogni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460304,
					"content": "Wow, qualcuno si è svegliato con la luna storta. Troppo divertente, ahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460305,
					"content": "Infatti, che risate. Eheheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460306,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460307,
					"content": "Che cosa c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460308,
					"content": "Si comportano in modo strano! Paimon è stata parecchio aggressiva, ma loro non hanno battuto ciglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460309,
					"content": "...Permettetemi. Cari signori, ricordate che ieri sera siete venuti alle Terme Aisa per una terapia di regolazione onirica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460310,
					"content": "Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460311,
					"content": "A me non pare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460312,
					"content": "Mh... Ricordate se avete avuto qualche incubo, di recente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460313,
					"content": "No, perché? Cosa c'è di tanto brutto al mondo da provocare gli incubi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460314,
					"content": "Mmh... No, non mi viene in mente nulla. Gli incubi sono qualcosa di parecchio raro, no? In fondo, basta guardarsi vicino per rendersi conto di quanto la vita sia meravigliosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460315,
					"content": "Ma che sta succedendo? Si sono completamente scordati di ieri sera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460316,
					"content": "E stanno dicendo cose troppo strane. Sembra che non abbiano davvero più avuto neanche un incubo... Questo significa che il metodo di Emura Ichigensai funziona sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460317,
					"content": "#No, è evidente che stanno vaneggiando... {NICKNAME}, Paimon, concentratevi a fondo per un istante. Sto per fare qualcosa di poco ortodosso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460318,
					"content": "Wow! Che cos'hai fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460319,
					"content": "Sono entrata nella loro mente subconscia. Avevo notato che entrambi erano dissociati dal loro subconscio, il che significa che potevo accedervi. È più o meno la stessa cosa che faccio con i sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460320,
					"content": "No, nooo! Non permetterò a quella teppaglia di passarla liscia! Non glielo permetterò!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "Susukida",
					"speakerSubtitle": "Susukida infuriato"
				},
				{
					"id": 120460321,
					"content": "Il mare oggi è troppo mosso... Forse farei meglio a restare sulla terraferma per il momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "Umihiko",
					"speakerSubtitle": "Umihiko terrorizzato"
				},
				{
					"id": 120460322,
					"content": "Eh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460323,
					"content": "Come vedete, i loro problemi non sono andati da nessuna parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460324,
					"content": "Susukida sembra un tipo piuttosto irascibile, il che lo porta ad agire in maniera inopportuna. Questo deve avergli causato parecchi problemi sul lavoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460325,
					"content": "Umihiko, invece... credo che abbia sviluppato una fobia per il mare in tempesta dopo aver vissuto un'esperienza ai confini della morte. Da allora ha difficoltà a navigare, e questo sta avendo un impatto devastante sul suo stile di vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460326,
					"content": "Le loro emozioni negative sono state isolate dalla loro mente cosciente e abbandonate a fluttuare nel subconscio. Per questo, dall'esterno, l'unica emozione che lasciano trasparire è la felicità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460327,
					"content": "Ma queste emozioni represse hanno continuato a incancrenirsi nel loro subconscio, e col tempo si sono trasformate negli incubi che hanno provocato l'indigestione di Murasaki e Shion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460328,
					"content": "Com'è potuto accadere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "...Se è davvero opera di Emura Ichigensai, immagino che non sia un totale ciarlatano come avevamo pensato. Forse conosce davvero dei metodi per influenzare le emozioni umane. Questo spiegherebbe perché nessuno ha mai detto nulla sul suo conto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460330,
					"content": "#Voi avete notato nulla di strano quando siete {F#venute}{M#venuti} qui ieri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460331,
					"content": "Niente di che. Ma erano molto più seri di oggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460332,
					"content": "In realtà, ora che lo chiedi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "Ricordi lo strano sogno che hai fatto ieri e lo racconti a Mizuki.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "Non avevi detto nulla a Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460335,
					"content": "Non ci ho dato molto peso, là per là.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "#Oh, no, no, no... {F#Ragazze}{M#Ragazzi}, dobbiamo trovare Emura Ichigensai immediatamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460337,
					"content": "Mizuki... Che sta succedendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460338,
					"content": "#Qualcosa di inumano ha preso possesso di Emura Ichigensai. Il sogno che ha avuto {NICKNAME} ne è la prova... Tutti quelli che hanno ricevuto la sua \"guida\" sono diventati delle vittime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460339,
					"content": "Se non lo troviamo e fermiamo al più presto, la psiche di quelle persone potrebbe subire danni irreversibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460340,
					"content": "Porca paletta... Beh, allora è meglio insistere ancora con questi bellimbusti. Sapete dirci quando arriva Emura Ichigensai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460341,
					"content": "Perché tanta fretta? Che importanza ha quando arriva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460342,
					"content": "Già, verrà qui quando sarà pronto. Non ha alcun senso mettergli fretta, eheh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460343,
					"content": "Uff, che nervi questi due!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460344,
					"content": "...Voi due ricordate benissimo cos'è successo ieri sera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460345,
					"content": "È solo che non volete parlarne, perché non riuscite a concepire la presenza di un incubo nella felicità che state provando in questo istante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460346,
					"content": "Il solo pensiero vi provoca un senso di sopraffazione, come se foste al punto di rottura. È qualcosa che non riuscite a esprimere a parole, ma temete di essere a un passo dal crollo totale... Non ho ragione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460347,
					"content": "...Ti prego, smettila. Andrà tutto bene finché evitiamo di pensarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460348,
					"content": "È chiaro che la terapia di Emura Ichigensai vi ha lasciato feriti e vulnerabili. Ma non preoccupatevi, non intendo strapparvi a forza dal vostro stato di negazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460349,
					"content": "...Purché voi rispondiate alla nostra domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460350,
					"content": "D'accordo... Però noi non lo sappiamo davvero. Abbiamo già chiesto in giro, ma sappiamo solo che oggi non verrà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460351,
					"content": "Sì, ehm... a quanto pare le sedute di ieri lo hanno... spossato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460352,
					"content": "Che stia cercando di nascondersi da me ancora una volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460353,
					"content": "Non sanno veramente nulla? Accidentaccio. Quindi siamo a un punto morto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460354,
					"content": "Immagino che non sappiate dove abita, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460355,
					"content": "No. L'abbiamo chiesto anche noi, ieri, ma perfino la guardia che lavora per lui non lo sapeva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460356,
					"content": "Se è così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460357,
					"content": "Hai trovato quello che cercavi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "Credo di sì... So da cosa erano causati quei brutti sogni, quindi posso somministrare loro un rimedio appropriato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460360,
					"content": "Vacci subito, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "In realtà, avete già fatto la vostra parte accompagnandomi qui. Non è giusto che continui ad affidarmi a voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460363,
					"content": "Non ti dimenticare che abbiamo un appuntamento da prenotare! Prima potrai smettere di preoccuparti di Emura Ichigensai, prima potremo averti tutta per noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460364,
					"content": "Quindi ti aiuteremo per tutto il tempo necessario, finché il centro termale non tornerà in affari come prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460365,
					"content": "...Allora non mi resta che accettare il vostro aiuto. Devo andare a preparare la cura per Murasaki e Shion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460366,
					"content": "Ma avrò bisogno della vostra piena cooperazione. Se riuscite a trovare Emura Ichigensai, non avvicinatevi a lui per nessuna ragione. Fatemi avere un messaggio e tenetelo d'occhio finché non arrivo io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460367,
					"content": "Non voglio assolutamente che corriate dei rischi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460368,
					"content": "Ah, di questo non ti devi preoccupare! Abbiamo affrontato tipacci della peggior specie, in passato. Questo a confronto è una mezza cartuccia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460369,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460370,
					"content": "...Sì, sì, d'accordo. Ci terremo a distanza e ti faremo avere il messaggio, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460371,
					"content": "Molto bene. Allora muoviamoci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460372,
					"content": "...Audace da parte tua, dire che rintracceremo questo tizio. È bello che tu voglia dare un pensiero in meno a Mizuki, ma... Che accicacchio facciamo, adesso? Non è mica detto che lo troveremo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460373,
					"content": "#Forse non te ne sei {F#accorta}{M#accorto}, ma questi due non sanno un bel niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460374,
					"content": "Già, loro di sicuro non ne hanno idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "Ma certo, hai ragione... È stata lei ieri a farci la soffiata su dove trovarlo! Forse sa molto di più di quanto voglia dare a vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460377,
					"content": "Non perdiamo tempo, andiamo al Gran Santuario di Narukami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460375,
					"content": "Ma ho il sospetto che Miko sappia qualcosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "Io rintraccerò Emura Ichigensai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "Ora puoi aiutare Murasaki e Shion?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
		{
			"id": 1204604,
			"completionStepIds": [
				1204604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204604",
							"2"
						],
						"stepId": 1204604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2470.723,
							445.64,
							-4409.953
						],
						"pointId": 322100692
					}
				]
			},
			"dialogs": [
				{
					"id": 120460401,
					"content": "In genere la si trova qui nei paraggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460402,
					"content": "#Siete qui per pescare un omikuji, {F#piccole}{M#piccoli}? Oppure per fare visita a un'amica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460403,
					"content": "Waaah! Da dove salti fuori?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460404,
					"content": "Ne è passato di tempo, Lady Guuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460405
					]
				},
				{
					"id": 120460405,
					"content": "#Che saluto tiepido. Inizi a comportarti quasi come lei... Comunque, convenevoli a parte, qual buon vento? Mi sembrate un po' {F#scombussolate}{M#scombussolati}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460406,
						120460407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460406,
					"content": "Dobbiamo trovare una persona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				},
				{
					"id": 120460408,
					"content": "#Vi ho dato proprio ieri un indizio su dove trovarlo, e non era neanche troppo velato. Mi state forse dicendo che non ci siete ancora {F#riuscite}{M#riusciti}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460409,
					"content": "Ah-ha, quindi l'avevi fatto di proposito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460410,
					"content": "#...Direi di sorvolare su questo. Siete {F#venute}{M#venuti} qui a chiedermi aiuto, no? Potreste farmi un riassunto della situazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460411,
					"content": "#Sì, in effetti... Siamo {F#andate}{M#andati} nel posto che avevi detto, ma lui ci è sfuggito da sotto il naso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460412,
					"content": "Stando agli ultimi aggiornamenti, ora non sta più visitando i suoi pazienti. Sembra che gli piaccia la pace e la solitudine... Quindi, capirai anche tu che non abbiamo idea di dove cercarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460413,
					"content": "*sospira* Sapeste che fatica ho dovuto fare per darvi quella posizione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460414,
					"content": "Non so se può aiutarti, ma ieri abbiamo scoperto qualcosa su di lui. Per esempio, un tizio che corrisponde alla descrizione di Emura Ichigensai è stato paziente di Mizuki, una volta... ma all'epoca si faceva chiamare \"Emura Chuuya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460415,
					"content": "Aspetta, cosa? Emura Chuuya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460416
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460416,
					"content": "Lo conosci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460417,
					"content": "Una volta ho chiesto alla Casa editrice Yae di organizzare un evento dal vivo per i collaboratori della rubrica della posta. Speravo potesse essere un evento dove conoscere persone affini e scambiare quattro chiacchiere in allegria... ma poi si è presentato quel tizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460418
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460418,
					"content": "Mi state dicendo che quel piantagrane ed Emura il guaritore sono la medesima persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460419,
					"content": "Stando ai frutti delle nostre indagini, pare proprio di sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460420,
					"content": "Capito. Beh, se è così... provate a questo indirizzo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460421,
					"content": "Eh... Sei sicura? Chi mai sceglierebbe di vivere laggiù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460422,
					"content": "È l'indirizzo di spedizione che Emura comunicò alla casa editrice, quando una volta ordinò diverse decine di libri tutte in una volta. Richiese anche il pagamento alla consegna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460423
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460423,
					"content": "I responsabili del magazzino diedero per scontato che fosse uno scherzo, così l'ordine venne rifiutato... Peccato che, così facendo, si meritarono una menzione d'onore nella sua lettera di reclamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460424,
					"content": "Ovviamente, col senno di poi, il perché viva lì è piuttosto ovvio. Una persona asociale come lui difficilmente trova posto altrove...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460425,
					"content": "Effettivamente... Sembra proprio che venire da te sia stata la decisione migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460426,
					"content": "Questo e altro pur di aiutare una vecchia amica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460427,
					"content": "Parli di Mizuki? Allora è vero che vuoi aiutarla, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460428,
					"content": "È evidente che l'attività alle Terme Aisa la appassiona molto. È naturale che io sia preoccupata e voglia tenderle la mano, se gli affari le stanno andando male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460429
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460429,
					"content": "Sul serio? Perché ieri sembrava quasi che volessi attaccare briga con lei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460430,
					"content": "Presumo che Mizuki vi abbia detto che mi considera una sua concorrente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460431
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460431,
					"content": "Questa è una vecchia storia che risale a quando eravamo compagne di classe. E ora che sono la Guuji del Gran Santuario di Narukami, credo proprio che voglia dimostrare il suo valore gestendo al meglio le Terme Aisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460432
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460432,
					"content": "L'ultima cosa che vuole è che qualcuno di esterno si intrometta e salvi la situazione quando le cose si mettono male... Perciò, se voglio aiutarla, devo rispettare i suoi sentimenti e agire con cautela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460433
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460433,
					"content": "È raro vederti così premurosa nei confronti altrui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460434
					]
				},
				{
					"id": 120460434,
					"content": "Lo prenderò come un complimento. Mizuki è sempre pronta a farsi in quattro per gli altri, è il caso che qualcuno la ripaghi del suo altruismo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460435,
						120460436
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460435,
					"content": "Beh, visto che tu sei in una situazione difficile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460437,
					"content": "#Bene, vedo che hai capito al volo. Suvvia, per quanto mi piacerebbe continuare a chiacchierare, siete {F#venute}{M#venuti} qui in tutta fretta. Non è il caso che andiate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460438
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460438,
					"content": "Aaah, giusto! Dobbiamo metterci subito in contatto con Mizuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460436,
					"content": "...Forse posso pensare io a fare gli onori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460407,
					"content": "Sai dove possiamo trovare Emura Ichigensai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				}
			]
		},
