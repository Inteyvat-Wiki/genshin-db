			},
			"dialogs": [
				{
					"id": 710121101,
					"content": "Il tempo e il vento... Cos'avrà trovato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121102,
						710121106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121102,
					"content": "Il tempo e il vento?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121103
					]
				},
				{
					"id": 710121103,
					"content": "Oh, è una cosa che il mio amico ha menzionato nell'ultima lettera che mi ha mandato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121104,
					"content": "Ha detto che \"il tempo e il vento\" nascondono uno dei segreti di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121105,
					"content": "Però, non ho mai udito questa frase prima d'ora, e sono di queste parti. Chissà dove l'ha sentita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121106,
					"content": "Hai studiato a Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121107
					]
				},
				{
					"id": 710121107,
					"content": "Sì, anche se sono di Mondstadt, ho sempre studiato all'Akademiya di Sumeru. Probabilmente ho passato più tempo lì che a Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121108,
					"content": "Volete sapere cosa succede lì dentro? Beh, non è un segreto, quindi... Mmmh, come dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121109,
					"content": "È gente proprio strana. Mmmh, forse è troppo irrispettoso... Potrei dire che sono \"persone che si fanno notare...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121110
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121110,
					"content": "Se vi capiterà di andarci, capirete cosa intendo. Ma limitatevi a dare un'occhiata, è meglio se non vi fermate troppo a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		},
