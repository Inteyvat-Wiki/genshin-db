			},
			"dialogs": [
				{
					"id": 710120101,
					"content": "\"Le storie portate dal vento sbocceranno a tempo debito in leggende.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "Incisioni abrase"
				},
				{
					"id": 710120102,
					"content": "Che cosa significa? Paimon non ne ha idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120103,
					"content": "Eppure, questo posto sembra nascondere qualche segreto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120104,
					"content": "Controlliamo questa zona, potremmo trovare qualche indizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101215",
							"3"
						],
						"stepId": 7101215,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710120201,
					"content": "\"Le storie portate dal vento sbocceranno a tempo debito in leggende.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120202
					],
					"speakerTitle": "Incisioni abrase"
				},
				{
					"id": 710120202,
					"content": "Questa dev'essere la meridiana di cui parlava il taccuino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120203,
					"content": "Paimon però non capisce cos'abbia di speciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120204,
					"content": "Forse dovremmo rileggere quel taccuino con più attenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101210",
							"2"
						],
						"stepId": 7101210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121001,
					"content": "#Mmmh? Avevate degli affari da sbrigare qui, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121002
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121002,
					"content": "A proposito dell'Occhio del ciclone...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121003
					]
				},
				{
					"id": 710121003,
					"content": "Un Occhio del ciclone? Sono stato in questa zona per tutto questo tempo e non ho mai visto una cosa del genere, a parte quell'improvvisa e fortissima raffica di vento prima...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121004
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121004,
					"content": "Ma sono sicuro che non si trattava di un Occhio del ciclone, uno di quelli lo riconoscerei ovunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121005,
						710121007
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121005,
					"content": "Se lo dici tu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121006
					]
				},
				{
					"id": 710121006,
					"content": "Credetemi, non riuscirei a dimenticare una cosa del genere che interrompe la mia ricerca, nemmeno se ci provassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121009,
					"content": "Per essere precisi, sto facendo ricerca con un amico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121010
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121010,
					"content": "Anche lui è uno studioso e abbiamo frequentato insieme l'Akademiya di Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121011
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121011,
					"content": "Poi è diventato un archeologo, in viaggio per il mondo e impegnato con gli scavi, mentre io ho continuato i miei studi all'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121012
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121012,
					"content": "Quando è arrivato a Mondstadt, mi ha detto con entusiasmo che stava lavorando al Tempio dei Mille Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121013
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121013,
					"content": "Ha anche detto qualcosa del tipo: \"Quando avrò scoperto i segreti della tua patria, sarai la prima a saperlo\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121014
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121014,
					"content": "Dopodiché non ci siamo più sentiti. Ho chiesto a qualcuno di inviare una lettera a Cyrus, per chiedere alla Gilda degli avventurieri di aiutarmi a trovare il mio amico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121015
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121015,
					"content": "Ma di lui non arrivavano notizie, così ho interrotto gli studi e sono tornato qui di corsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121016
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121016,
					"content": "Ma qui c'è solo una meridiana... e non ci sono altri indizi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121017
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121017,
					"content": "Beh, c'è una meridiana anche su quell'isola...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121018
					]
				},
				{
					"id": 710121018,
					"content": "Cosa? C'è un'altra meridiana identica a questa, e si trova su un'isola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121019
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121019,
					"content": "Oh, sì! Ora mi ricordo. In effetti ogni tanto vedo quell'isola, quando c'è bel tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121020
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121020,
					"content": "Aspettate... Avete detto di aver trovato un taccuino vicino alla meridiana? Forse il mio amico è stato lì...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121021
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121021,
					"content": "Grazie. Se ne avrò l'occasione, andrò su quell'isola per dare un'occhiata. Per ora, però, devo ancora capire come funziona questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121022
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121022,
					"content": "Devo continuare la mia ricerca. Se vi interessa, potete dare un'occhiata ai miei appunti. Li ho lasciati lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121023
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121023,
					"content": "Chissà, forse c'è qualcosa che potrebbe aiutarvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121007,
					"content": "Cosa ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121008
					]
				},
				{
