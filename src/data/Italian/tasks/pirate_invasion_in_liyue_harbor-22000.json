			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Piccolo Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220000201,
					"content": "#Pront{F#a}{M#o}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "Che il gioco abbia inizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000203,
					"content": "Come si comincia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000204,
					"content": "Ehm... All'arrembaggio! Ti sto derubando!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "Aiuto! Pirati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Piccola Lulu"
				},
				{
					"id": 220000206,
					"content": "Non preoccuparti, Lulu, ti salverò io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220000207,
					"content": "#Tu devi essere {F#una}{M#un} pirat{F#essa}{M#a}. Allora dimmi: perché ci stai derubando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000208,
					"content": "#Perché sono {F#una}{M#un} pirat{F#essa}{M#a}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "Non tutti. Ci sono pirati buoni e pirati cattivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000211,
					"content": "Beidou, ad esempio, è una piratessa, e non è cattiva. Ci regala tanti spuntini! Tutti adorano Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000212,
					"content": "#Non puoi essere anche tu così? Perché devi fare quell{F#a}{M#o} cattiv{F#a}{M#o}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000213,
					"content": "Sei stato tu a dire che i pirati sono persone cattive che vanno in giro a rubare le cose degli altri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220000214,
					"content": "Riconosco i miei errori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Bene! Ammettere i propri errori è un primo passo per diventare una persona migliore. Così dice Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000217,
					"content": "#Il passo successivo è rimettere tutto in ordine. Se fai buone azioni, puoi essere una brava persona. Perfino {F#una}{M#un} brav{F#a}{M#o} pirat{F#essa}{M#a}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000215,
					"content": "Dichiaro espressamente che non farò più uso della suddetta cattiveria.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "È quello che fanno i pirati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
