			"dialogs": [
				{
					"id": 220000501,
					"content": "Hai finito di ripulire il ponte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000502,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "Sbrigati. Questa è la tua occasione per cambiare e dimostrare che puoi essere una brava persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000504,
					"content": "Ehi, stai davvero dicendo che basti dare una ripulita per diventare una brava persona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220000505,
					"content": "Per essere una brava persona bisogna solo avere la volontà di fare la cosa giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000506,
					"content": "Detta così, sembra fin troppo semplice...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220000507,
					"content": "Fai del bene, sei una brava persona. Fai del male, sei una persona cattiva. Sì, è piuttosto semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000508,
					"content": "Beh, se è così, perché ci sono ancora tante persone cattive in questo mondo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220000509,
					"content": "Perché in questo mondo è tutto più facile a dirsi che a farsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000510,
					"content": "E fare del male è sempre più facile che fare del bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000511,
					"content": "Te l'ha insegnato Beidou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220000512,
					"content": "No, questo l'ho letto in un libro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				}
			]
		},
