			"dialogs": [
				{
					"id": 220000301,
					"content": "Hai finito di ripulire il ponte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000302,
					"content": "Sì, ho finito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "Evviva! Grazie, eccoti un regalo. Mi sono divertito un sacco a giocare con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000304,
					"content": "E ricordati: essere una brava persona dev'essere un'abitudine che ti accompagna per tutta la vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000305,
					"content": "Ehi, quando tocca a me fare il capitano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220000306,
					"content": "La prossima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000307,
					"content": "Me lo avevi già detto la volta scorsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Fei"
				}
			]
		},
