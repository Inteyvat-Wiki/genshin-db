					"Piccolo Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220000101,
					"content": "Allora, come vogliamo fare stavolta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000102,
					"content": "Tsk. Se nessuno vuole fare il pirata, non possiamo proprio giocarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Piccolo Fei"
				},
				{
					"id": 220000103,
					"content": "Nessuno vuole fare il pirata. Quindi, come possiamo fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000104,
					"content": "Cosa state facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "Volevamo fare un gioco, ma nessuno vuole fare il pirata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000106,
					"content": "Se nessuno fa il pirata, non ci sarà nemmeno qualcuno a derubare gli altri... Quindi non possiamo giocare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000107,
					"content": "#Oooh, ci sono, puoi aiutarci tu! Vuoi fare {F#la}{M#il} pirat{F#essa}{M#a}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000108,
					"content": "Affare fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "Evviva! Bene, prepariamoci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000115,
					"content": "#Quando ti senti pront{F#a}{M#o}, raggiungici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000110,
					"content": "La pirateria non è il mio campo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "Non dovrai fare nulla di complicato! Un pirata è solo una persona molto cattiva che va in giro a rubare cose degli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000112,
					"content": "Io non ho mai visto un pirata, però. Questo è solo quello che mi ha detto Beidou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000113,
					"content": "Ma penso che fare finta di essere un pirata sia piuttosto semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "Piccolo Meng"
				},
				{
					"id": 220000114,
					"content": "Eheheh, puoi farcela! Forza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Piccolo Meng"
				}
			]
		},
		{
			"id": 2200002,
			"completionStepIds": [
				2200002
			],
