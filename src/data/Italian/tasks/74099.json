			"dialogs": [
				{
					"id": 740990101,
					"content": "A proposito di prendere mostri anziché pesci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "Oh! Ora che ci penso... è stata un'esperienza alquanto unica quella l'aver attirato dei mostri invece che dei pesci con la propria esca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990103,
					"content": "Sebbene non mi facciano paura i mostri, ero solita fare la pendolare da sola tra l'Istituto di ricerca di Fontaine e la Corte di Fontaine. Ho lottato molte volte contro i banditi lungo la strada e ho vinto la maggior parte delle volte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990104,
					"content": "Comunque, ora dirigo l'Associazione di pesca, per cui devo comportarmi come si conviene al ruolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990105,
					"content": "Se facessi scappare via i pesci o causassi problemi alle persone che pescano qui vicino, lo sentirei in ogni caso come un fallimento nel soddisfare le aspettative della gente in quanto direttrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990106,
					"content": "Ecco perché devo avere autocontrollo e fare attenzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
		}
