				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "Li hai sconfitti, immagino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010602,
					"content": "Già!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "*sospira* Sei davvero forte. Se solo fossi eccezionale come te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010604,
					"content": "Anch'io vorrei lasciare dietro di me delle leggende sull'uccisione di draghi e sulla salvezza del mondo, ma alla fine non sono riuscito nemmeno a battere un branco di Hilichurl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010605,
					"content": "Uff... Comunque, io... Che imbarazzo... Ho un favore da chiederti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010606,
					"content": "In verità sono venuto al Tempio dei Mille Venti perché presto dovrò affrontare una prova di valutazione del mio grado avventura...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010607,
					"content": "Pensavo che, se avessi dimostrato le mie capacità in questa situazione, la prova sarebbe stata più semplice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010608,
					"content": "Non immaginavo minimamente che non solo non avrei dimostrato nulla, ma avrei anche quasi perso la vita provandoci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010609,
					"content": "T-Ti posso chiedere di non dire niente a Cyrus? Se tutto ciò avesse delle conseguenze sulla mia valutazione, sarei veramente nei pasticci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010610,
					"content": "Il tuo segreto è al sicuro con me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "Grazie mille! Prometto che non sarò così avventato in futuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010612,
					"content": "Non è affatto giusto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "Lo so, e Cyrus dice sempre che gli avventurieri dovrebbero essere onesti con sé stessi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010614,
					"content": "Ma... *sospira* Lasciamo stare. Spero solo che non si arrabbi troppo con me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
