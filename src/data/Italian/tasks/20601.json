			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "*sibilando* Che... male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010502,
					"content": "Grazie mille. Pensavo che non sarei più riuscito a tornare a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010503,
					"content": "Come ti senti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "Eh... *farfuglia* Fa solo un po'... male! Solo un po'. Sto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010505,
					"content": "Ho scoperto un gruppo di Hilichurl in un accampamento più avanti. Sospettavo che stessero tramando qualcosa, così li ho seguiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010506,
					"content": "...Mi sono avvicinato troppo e mi hanno scoperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010507,
					"content": "Ma non preoccuparti per me... Per favore, elimina quegli Hilichurl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010508,
					"content": "Sono sempre di più. Non possiamo permettere che i loro piani si realizzino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010509,
					"content": "Quanto a me... Posso badare a me stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
