					"nextDialogs": [
						206010805
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010805,
					"content": "*sospira* Essere coraggiosi è un bene... Ma sarebbe meglio se fosse un po' più posato. Si può essere avventurieri solo da vivi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010806
