				"points": []
			},
			"dialogs": [
				{
					"id": 400000201,
					"content": "Ciao! Ti andrebbe di provare a giocare al Teatro meccanico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000202,
					"content": "Teatro meccanico? Cosa sarebbe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "Oh, non ne hai mai sentito parlare? Allora lascia che te lo spieghi... Il Teatro meccanico è un gioco da tavolo inventato dalla sottoscritta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000204,
					"content": "Vedi le cose sul tavolo? Sono tutti oggetti importanti usati nel Teatro meccanico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000205,
					"content": "Sembra piuttosto complesso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "A prima vista sembra complicato, ma basta giocare un paio di volte per prenderci la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000207,
					"content": "Allora? Vuoi fare un tentativo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000208,
					"content": "Ehm, beh... Quanto costa giocare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "No, per niente. Dopotutto, è il Festival delle lanterne. E poi vorrei raccogliere il maggior numero possibile di pareri sul gioco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000211,
					"content": "Quindi giocare ti costerà solo una lanterna Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000212,
					"content": "Se vuoi provare, non dovrai fare altro che portarmi una lanterna Xiao!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000213,
					"content": "Dai, prova! Ti lascerò addirittura giocare gratis il primo round, così potrai tenerti la lanterna Xiao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000209,
					"content": "Dev'essere molto costoso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
