				"points": []
			},
			"dialogs": [
				{
					"id": 710500501,
					"content": "A proposito di questo strano oggetto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500502
					]
				},
				{
					"id": 710500502,
					"content": "L'hai pescato dall'acqua? Mmmh. A dire il vero, sembra proprio un'esca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500503
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500503,
					"content": "È normale pescare cose del genere? Anisa va ogni giorno a pescare sull'Isola di Watatsumi, ma non ha mai trovato niente di speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500504
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500504,
					"content": "Magari è chi pesca a fare la differenza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500505
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500505,
					"content": "Vediamo. Uhm, percepisco un'incredibile concentrazione di energia di Hydro al suo interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500506
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500506,
					"content": "Le acque sotterranee della Voragine sono insolitamente ricche di potere elementale. Avrà qualcosa a che fare con questi oggetti che crescono al suo interno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500507
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500507,
					"content": "Però, da quando l'hai pescato, la sua energia elementale si è affievolita. Forse dobbiamo rimetterlo vicino all'acqua per vedere di cosa è capace il suo potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500508
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500508,
					"content": "Metterlo vicino all'acqua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500509
					]
				},
				{
					"id": 710500509,
					"content": "Sì, e attivarlo con dell'energia di Hydro. Sospetto che allora ci rivelerà i suoi segreti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500510
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500510,
					"content": "Che ne dici di andare ad attivarlo? Dato che l'hai pescato tu... Fammi sapere se ottieni qualche risultato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500511
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500511,
					"content": "Se scopri qualcosa di valore dal punto di vista accademico, ti pagherò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105008,
			"completionStepIds": [
				7105104
			],
