					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500801,
					"content": "A proposito dello strano oggetto vicino all'acqua...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "Eh? L'hai messo vicino all'acqua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500803,
					"content": "Com'è? È successo qualcosa di particolare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500804,
					"content": "È apparso un Geosauro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "Un Geosauro? Si è trasformato in un Geosauro con l'acqua?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500806,
					"content": "Ah, non volevi dire che si è trasformato in un Geosauro, ma che ne ha attirato uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500807,
					"content": "Uff, che spavento! Se si fosse davvero trasformato in Geosauro, tutta la mia concezione del mondo sarebbe andata in frantumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500808,
					"content": "Allora, cos'è esattamente quella cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "La risposta è semplice. Come dire? Mmmh, beh, perché non mi dici prima se il Geosauro aveva qualcosa di particolare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500810,
					"content": "Aveva, per esempio, caratteristiche Hydro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500811,
					"content": "Qualcosa del genere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500816,
					"content": "Quel Geosauro probabilmente è in grado di utilizzare l'energia di Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500817,
					"content": "Le acque sotterranee nella Voragine contengono una forte energia di Hydro. Come tali, alcune aree ad alta concentrazione sono diventate terreno fertile per le simil erbacce acquatiche che vi hai pescato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500818,
					"content": "Il Geosauro, come le altre creature amanti dell'acqua presenti nella Voragine, ha accresciuto i suoi poteri cibandosi di quelle erbacce acquatiche ricche di energie di Hydro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500819,
					"content": "Quindi quell'affare è... solo erbaccia acquatica ricca di elementi Hydro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500820,
					"content": "Solo erbacce acquatiche, eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "Sì, erbacce acquatiche, ma che contengono un'energia elementale di Hydro incredibilmente densa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500822,
					"content": "Di solito non si trovano in ambienti comuni, a meno che un potere immenso e puro non abbia alterato la fonte idrica... Lasciamo perdere, dannate erbacce acquatiche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500823,
					"content": "Un giorno potrebbero trasformarsi in creature elementali senzienti. Sai cosa? Non sarebbe male come argomento per una ricerca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500813,
					"content": "Non l'ho notato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#Devi averlo fatto fuori troppo in fretta per non aver notato la sua caratteristica speciale. Impressionante, ma c'era da aspettarselo {F#dalla leggendaria}{M#dal leggendario} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500815,
					"content": "Ecco la mia ipotesi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				}
			]
		}
	]
}