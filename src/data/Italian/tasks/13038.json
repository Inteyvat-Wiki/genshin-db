			"dialogs": [
				{
					"id": 130380501,
					"content": "Così finisce il secondo duello. Ora passeremo al terzo. Duellanti, fatevi avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380502
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380502,
					"content": "Sono pronto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380503
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380503,
					"content": "Anche io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380504
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380504,
					"content": "Questa è la parte finale del rito. Ricordo a entrambi che i termini che avete accettato sono vincolanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380505
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380505,
					"content": "Quando siete pronti, iniziate pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380506
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380507
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380507,
					"content": "Sono Sethos, ricettacolo di Hermanubis, nipote di Bamoun, il leader del Tempio del Silenzio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380508
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380508,
					"content": "Per molti anni abbiamo mantenuto il giuramento fatto a Lord Hermanubis, custodendo i segreti di Re Deshret. E perfino nel nostro momento più oscuro, quando la luce sembrava lontana, abbiamo scelto di non abbandonare la speranza e di intraprendere un nuovo esperimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380509
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380509,
					"content": "Abbiamo chiesto con sincerità l'intercessione di Lord Hermanubis, desiderando che il suo spirito e la sua luce discendessero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380510
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380510,
					"content": "Ora combatterò per diventare l'erede designato di questo potere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380511
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380511,
					"content": "Io sono Cyno, generale Mahamatra dell'Akademiya, studente e successore di Cyrus, saggio della Spantamad. Combatto per difendere il mio potere, il mio professore e la mia nazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380512
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380512,
					"content": "E tu? Sicuro di aver detto tutto? Questo è un duello sacro, ed Hermanubis ci sta guardando. Per cui, metti a nudo la tua anima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380513
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380514
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380514,
					"content": "(Tutti... Vecchi e giovani, forti e deboli, attendono di sapere come finirà il duello.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380515
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380515,
					"content": "Mio nonno è un leader avveduto. È anche noto per essere un regnante che non teme di sporcarsi le mani con il sangue. Capisco molto bene ciò in cui crede, e so cosa si aspetta da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380516
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380516,
					"content": "Ma la nostra fede ci ha frenati a lungo. Una volta cresciuto, sono stato nella Foresta pluviale e ho visto con i miei occhi gli abitanti della città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380517
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380517,
					"content": "I tempi sono cambiati. La gente di Sumeru è più felice ora rispetto al passato. Ci ho pensato mentre mi trovavo su uno dei punti più alti della città, osservando le strade al di sotto di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380518
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380518,
					"content": "E poi ho pensato a te, Cyno. Entrambi possediamo lo stesso potere, eppure le nostre vite non potrebbero essere più diverse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380519
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380519,
					"content": "Ogni Frammento di Ba rappresenta qualcosa di diverso: potere, gloria... o uno dei tanti altri segreti che devono ancora essere svelati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380520
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380520,
					"content": "Una volta pensavo che fosse la natura dei nostri frammenti a renderci così diversi. Ma... forse è solo perché tu hai trovato la tua risposta, e io sto ancora cercando la mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380521
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380521,
					"content": "Sono molto più che un guerriero. Sono me stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380522
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380522,
					"content": "...Esattamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380523
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380524
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380524,
					"content": "Il nome di Hermanubis ha lasciato il segno su entrambi, plasmando le nostre vite. Siamo i suoi ricettacoli, ma anche molto altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380525
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380525,
					"content": "Per cui mostrami la tua risposta, Cyno. Mostrami che non è la mia fede, né il potere che possiedo, a definirmi... Mostrami la persona che posso diventare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380526
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380526,
					"content": "Fatti sotto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380527
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380527,
					"content": "Come va? Tutto bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380528,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380529
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380529,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
