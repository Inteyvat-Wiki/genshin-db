					}
				]
			},
			"dialogs": [
				{
					"id": 130380601,
					"content": "Beh, ora non possiamo più tornare indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380602
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380602,
					"content": "Non avremmo mai potuto farlo. Tornare indietro non è mai stata un'opzione per me, dal momento in cui il professore è fuggito per tornare nel deserto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380603
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380603,
					"content": "Devi vincere. Hai bisogno di questo potere, in quanto generale Mahamatra e per te stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380604
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380604,
					"content": "Proprio così! Inoltre, il potere ti accompagna da quando eri piccolo. Mi sembra un segnale positivo: vuol dire che si considera tuo di diritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380605,
					"content": "...In quanto generale Mahamatra e per me stesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380606,
					"content": "Sì, detta così... Ho dovuto superare un sacco di ostacoli per riuscire a controllare e dominare questo potere. Non è una cosa che avrebbe potuto fare chiunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380607
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380607,
					"content": "Esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380608,
						130380609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380608,
					"content": "Non distraiamoci. Concentriamoci sulla vittoria!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				},
				{
					"id": 130380610,
					"content": "#Io e {NICKNAME} non perderemo mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380611
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380611,
					"content": "E neanche io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380612
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380612,
					"content": "Il deserto ospitava un'antica e gloriosa civiltà che, per una varietà di motivi, entrò in conflitto con quella della Foresta pluviale. Proprio come diceva Dehya, furono i pregiudizi a fare allontanare la gente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380613
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380613,
					"content": "Ma devono esserci stati anche dei fattori personali. Non riesco a non pensare che a Bamoun stiano a cuore molte più cose di quanto non lasci trapelare, e non penso che Sethos sia cattivo: fa solo ciò che ritiene essere la cosa migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380614,
					"content": "...Domani si risolverà tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380609,
					"content": "Anche noi daremo una mano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				}
			]
		},
