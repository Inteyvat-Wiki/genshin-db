			},
			"dialogs": [
				{
					"id": 130380201,
					"content": "Sethos, parliamo un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380202,
					"content": "Ti sei deciso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380203,
					"content": "Non così in fretta! Ho nel mio curriculum diverse esperienze mediche, e mi chiedevo se potessi dare un'occhiata a tuo nonno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380204,
					"content": "Non ho alcuna obiezione, anche se qui abbiamo i nostri dottori. Dubito che potrai dirci qualcosa che non sappiamo già.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380205,
					"content": "C'è solo un modo per scoprirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380206,
					"content": "Seguimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380207,
					"content": "Tenete la voce bassa. Non vogliamo disturbarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380208,
					"content": "Tighnari prende il suo kit medico e fa una prima visita a Bamoun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380210,
					"content": "Vieni fuori, così parliamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380211,
					"content": "Bamoun è entrato in coma profondo, e la sua prognosi è abbastanza grave. Sono sicuro che i tuoi medici sono giunti alla stessa conclusione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380212,
					"content": "Sembra aver subìto un grave infortunio da giovane, che è andato peggiorando col passare degli anni anche a causa del lavoro pesante. E ora, con la vecchiaia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380213,
					"content": "Purtroppo devo informarti che... sulla base di quello che ho visto in pazienti in condizioni simili, non gli rimane molto. Una manciata di giorni, a essere ottimisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380214,
					"content": "...Lo sapevo già da molto tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380215,
					"content": "Sei il suo erede, vero? Si vede che lo rispetti molto. Ma non hai le sue stesse idee, anzi, hai uno spettro di interessi più ampio e un approccio più pragmatico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380216,
					"content": "Allora dimmi come porre fine a questa situazione secondo i tuoi termini. Troviamo un modo per trovare una soluzione, mentre Bamoun è ancora vivo... È questo che conta davvero per te, lo so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380217,
					"content": "Certo, non c'è tempo da perdere. Lo sai meglio di tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380219,
					"content": "Sai, voi due vi trovate in una situazione molto simile, al momento. Entrambi avete una prospettiva molto diversa rispetto a chi vi ha cresciuti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380220,
					"content": "Certo. E non siete stati voi a creare questa situazione, ma loro... Eppure, avete finito col dover prendere voi le decisioni difficili...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380221,
					"content": "...Hai ragione. Entrambi consideriamo questo problema in una maniera molto diversa rispetto alle persone da cui l'abbiamo ereditato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380222,
					"content": "Sono d'accordo, Cyno. Tutto ha avuto inizio a causa di Hermanubis, quindi segniamone la fine con un rito creato proprio da lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380223,
					"content": "Secondo la leggenda, dopo essere arrivato a Tulaytullah, Hermanubis lottò contro i residenti della città. Lui e i suoi due compagni dimostrarono il proprio valore combattendo nell'arco di diversi giorni, e guadagnandosi il supporto di molti illustri individui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380224,
					"content": "Quei sostenitori furono tra i primi membri del Tempio del Silenzio, e gli incontri di lotta divennero uno dei nostri riti fondanti... Il Rito dei duelli. È così che tutto è cominciato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380225,
					"content": "Sembra perfetto. Mi hai convinto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380226,
					"content": "In quanto ricettacolo di Hermanubis, i tuoi legami con il Tempio del Silenzio sono profondi. Per cui ti permetterò di partecipare al rito assieme ai tuoi compagni scelti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380227,
					"content": "Tre contro tre. Direi che ci siamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380228,
					"content": "Vorrei però aggiungere delle ulteriori clausole. In quanto sfidanti, la vittoria sarà vostra solo se vincerete tutti gli incontri. E, Cyno... dovremo mettere in palio i rispettivi Frammenti di Ba. Il vincitore se li aggiudicherà entrambi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380229,
					"content": "Lasciare che Cyrus se ne andasse con uno dei Frammenti di Ba è stato un errore. Un errore commesso per pietà da mio nonno. È un problema annoso che va risolto affinché il Tempio del Silenzio possa voltare pagina. Non posso fare alcuna concessione su questo fronte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380230,
					"content": "Non è necessaria nessuna concessione. La pensiamo allo stesso modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380231,
					"content": "Se vincerò io, il Tempio del Silenzio dovrà lasciare andare Cyrus e considerare risolto questo contenzioso del passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380232,
					"content": "Se vincerai tu, ti restituirò il mio potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380233,
					"content": "Affare fatto. Allora vediamoci nella sala delle cerimonie domani sera alle otto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
