					}
				]
			},
			"dialogs": [
				{
					"id": 130380101,
					"content": "Il gruppo si riunisce all'orario concordato...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "Ci ho riflettuto un po'... La mia ipotesi è che il professor Cyrus sia venuto nel deserto conscio del fatto che difficilmente avrebbe fatto ritorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380103,
					"content": "È un uomo testardo, con la tendenza a infierire quando è convinto di qualcosa. Non combineremo un bel niente tentando di convincerlo a fuggire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380104,
					"content": "Sono d'accordo. Il mio maestro, Naphis, dice la stessa cosa: quando Cyrus si mette in testa qualcosa, non vuole sentire ragioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380105,
					"content": "Mmh, sappiamo almeno questo. Ma mi sono venute in mente anche altre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380106,
					"content": "Avete sentito tutto ciò che dovevate sentire sul Tempio del Silenzio, per cui non ho altro da aggiungere in merito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380107,
					"content": "I miei ricordi di questo posto sono abbastanza confusi, probabilmente a causa della soverchiante presenza dei Frammenti di Ba. Questo spiegherebbe perché da bambino avevo sempre febbre e mal di testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380108,
					"content": "Ricordo di aver vissuto momenti di profonda emozione, quando delle immagini vaghe apparivano nella mia mente. Ma non ricordo altro, solo alcuni frammenti sparsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380109,
					"content": "Ero ancora piccolo però, e tutto ciò che potevo capire era che dentro di me c'era questa forte volontà. A ripensarci ora, immagino si trattasse del modo in cui Hermanubis mi incoraggiava, anche quando non potevamo comunicare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380110,
					"content": "Il potere che venne a risiedere nel mio spirito era probabilmente uno dei capisaldi della loro fede. Per cui, se la volontà e il potere di Hermanubis sono reali e tangibili, e loro sono i suoi legittimi adoratori, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380111,
					"content": "Non vorrai assecondarli, vero? Ci sarà sicuramente un altro modo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380112,
					"content": "Non prendere decisioni azzardate, Cyno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "No, non ho intenzione di restituirlo. Senza questo potere non posso proteggere Sumeru. Ma il Tempio ha il diritto di decidere il suo destino, dato che appartiene a una delle Sette Colonne di Re Deshret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380115,
					"content": "Li sfiderò a testa alta e vincerò il diritto di detenere questo potere, con la più totale lealtà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380116,
					"content": "Mmmh, questo mi ricorda qualcosa di cui Alhaitham mi parlava proprio prima che ce ne andassimo. Il Tempio del Silenzio era originariamente stato fondato dall'élite dominante del periodo. Tradizionalmente, organizzazioni simili sono vincolate da un rigoroso e arcaico codice nobiliare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380117,
					"content": "Kaveh si è espresso in maniera simile circa le tribù del deserto che ha osservato durante i suoi viaggi di lavoro. Ha detto che molte di queste possiedono le proprie regole, basate sull'importanza di non disonorare mai i loro legami tribali, né le regole imposte dai loro antenati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380118,
					"content": "Penso che potremmo sfruttare tutto ciò a nostro vantaggio, e avanzare una controproposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380119,
					"content": "Wow... Abbiamo ribaltato la situazione come se niente fosse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380120,
					"content": "A quanto pare abbiamo avuto la stessa idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380121,
					"content": "Rispondiamo finché possiamo, in termini che non possono rifiutare. Così la spunteremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380122,
					"content": "Sembra un'ottima idea.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "Perfetto. E so anche come iniziare il discorso. Andiamo a cercare Sethos. Gli diremo che ho una certa conoscenza in fatto di medicina e che vorrei esaminare le condizioni di salute di suo nonno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380113,
					"content": "Dev'esserci un altro modo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
