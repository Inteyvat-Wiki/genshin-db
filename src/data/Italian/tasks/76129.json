			"dialogs": [
				{
					"id": 761290101,
					"content": "Grazie ancora per tutto l'aiuto che avete dato alla Gilda, capo Nefer, signorina Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761290102,
					"content": "Non c'è bisogno. In fondo, siamo collaboratori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290103,
					"content": "È vero, ma ci tengo comunque a ringraziarla, capo Nefer: è stata così disponibile ad aiutare la Gilda con quel... complicato lavoro investigativo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290104,
					"content": "Anche la Gilda degli avventurieri ha inviato diversi delegati ad aiutarci nel nostro lavoro. Stiamo tutti lavorando insieme per lo stesso obiettivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290105,
					"content": "Spero che le nostre future collaborazioni siano altrettanto piacevoli, signor Sarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290106,
					"content": "Certo, capo Nefer. Può stare certa che la Gilda degli avventurieri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290107,
					"content": "Ah, su questo ci tengo a essere chiaro: noi della Gilda degli Avventurieri di Nod-Krai saremo sempre vostri partner affidabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290108,
					"content": "Eh, questo mi è ben chiaro, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290109,
					"content": "(Bene, ottimo, continui pure a parlare così, capo Nef, mia carissima capo Nef, la prego, non mi guardi, la prego, non mi guardi, la prego, non mi guardi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290110,
					"content": "Jahoda, perché sei così silenziosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290111,
					"content": "(NO, mi ha guardata!!! Va bene, basta che non guardi la bacheca degli incarichi, la prego, non guardi la bacheca degli incarichi, la prego, non guardi la bacheca degli incaric...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290112,
					"content": "Eh? I-Io? Ehm, non ho nulla da dire! Ehm... Grazie... per l'incarico...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290113,
					"content": "Oh, dobbiamo ringraziare anche lei per l'assistenza, signorina Jahoda. Senza il suo aiuto, le scartoffie della Gilda si sarebbero accumulate a più non posso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290114,
					"content": "Non deve ringraziarmi... Sono pagata per svolgere il mio lavoro al meglio, dopotutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290115,
					"content": "(*sospira* Si è totalmente scordata quello che le ho insegnato a dire...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290116,
					"content": "A proposito, già che siamo tutti qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290117,
					"content": "(Ma no! Stavamo andando così bene, capo! La prego, mi serve un attimo di tregua!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290118,
					"content": "Signor Sarin, potrebbe per favore portarmi l'ultima serie di incarichi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290119,
					"content": "Jahoda, scegli l'incarico che ritieni più importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290120,
					"content": "Voglio che tu ci rifletta attentamente, quindi prenditi il tempo che ti serve, intesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290121,
					"content": "Ok... Sì, capo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290122,
					"content": "(URGH! SONO FINITA!!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
