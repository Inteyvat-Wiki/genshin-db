			"dialogs": [
				{
					"id": 706960201,
					"content": "Miko ci ha dato un bel po' di fumetti. Visto che l'idea è di condividerli con gli altri, perché non li mettiamo in un posto dove tutti possano vederli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960202,
					"content": "Mettiamoli vicino allo stand dei libri all'accampamento della Legione delle Anime ardenti. Così tutti potranno sfogliarli facilmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960203,
					"content": "Prendi in prestito una libreria e sistemi i fumetti di Miko sugli scaffali.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960204
					]
				},
				{
					"id": 706960204,
					"content": "Niente male! Ora la gente potrà scegliere cosa leggere quando avrà del tempo libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
