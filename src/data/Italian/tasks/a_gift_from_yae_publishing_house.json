			"dialogs": [
				{
					"id": 706960101,
					"content": "#Salve, {F#piccola}{M#piccolo}. Che bella sorpresa. Dove ti hanno portato i tuoi ultimi viaggi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960102,
					"content": "Racconti a Miko di Minnie, della Legione delle Anime ardenti e della Sfida campestre del Picco del Drago.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "Ohh, sembrano tutti così adorabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960104,
					"content": "Dev'essere stata una bella avventura per loro: venire da così lontano e attraversare i confini nazionali per incontrare spiriti affini... Ah, è una storia piena di romanticismo giovanile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960105,
					"content": "La Saga delle Anime ardenti sembra avere un seguito piuttosto forte. Forse è il momento di fare un'altra ristampa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960106,
					"content": "Con dei fan così appassionati, è giusto offrire loro qualcosa in segno di gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960107,
					"content": "Che ne dite di qualche fumetto gratis? Mmh... Il vostro è un gruppo piuttosto numeroso, dovrò assicurarmi che ce ne siano abbastanza per tutti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960108,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "Queste sono prime edizioni... Non le troverete in vendita da nessuna parte. Trattateli con cura, mi raccomando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960109,
					"content": "Farò in modo di condividerli con il resto del gruppo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
		},
