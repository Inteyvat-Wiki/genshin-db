			"dialogs": [
				{
					"id": 402260201,
					"content": "Conducete Navia e Clorinde al luogo dell'evento.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "Wow, è ancora più grande di quanto mi aspettassi. Spero che arrivi più gente, però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260203,
					"content": "Ci sarà più movimento, una volta iniziate le cose. Comunque, sembra che Jahoda abbia un gran bisogno di assistenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260204,
					"content": "Bene, io e Clorinde siamo a posto, per ora. Passate a trovarci, quando ne avete l'occasione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		}
