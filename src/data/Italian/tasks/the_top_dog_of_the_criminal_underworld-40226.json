			"dialogs": [
				{
					"id": 402260101,
					"content": "L'Ammiraglia... A quanto pare questo partecipante ha deciso di pensare prima all'alloggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260102,
					"content": "Partner! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260103,
					"content": "Navia! Da quanto tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260104,
					"content": "Anche tu qui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "Indovinato. In rappresentanza della Spina di Rosula, ovviamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260107,
					"content": "La numero uno della criminalità organizzata... Già, non fa una piega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260108,
					"content": "La numero uno della criminalità organizzata... Già, non fa una piega.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260109,
					"content": "Ahah, è un mio nuovo soprannome? Non mi dispiace, ha un certo che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260110,
					"content": "Che bello averti trovato! Abbiamo l'incarico di raccogliere le registrazioni dei partecipanti. Sai, verifica delle merci e cose del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260111,
					"content": "Oh, capisco. Beh, in tal caso, accomodatevi. Ho ordinato un sacco di cibo. Clorinde e Chevreuse sono andate a disfare i bagagli, ma dovrebbero tornare tra non molto... Ah, lupus in fabula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260112,
					"content": "Stavate parlando di noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260113,
					"content": "Clorinde! Chevreuse! Ci siete anche voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260114,
					"content": "Nod-Krai è un luogo caotico e pericoloso. Considerata l'importanza della Spina per Fontaine, l'ultima cosa che vogliamo è che succeda qualcosa alla sua presidentessa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260115,
					"content": "Viaggiare con gli amici è bello, ma suvvia... Guarda con chi stai parlando! Cosa vuoi che succeda di così grave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260116,
					"content": "Non si sa mai, quando si è troppo spensierati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260117,
					"content": "Giusto. Suppongo che possiate indicare la qui presente campionessa duellante come mia... guardia del corpo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260118,
					"content": "Il capo di una gang e la sua guardia del corpo... Capito. Dobbiamo registrare anche te per la fiera, Chevreuse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260119,
					"content": "Non ce n'è bisogno, io sono qui per lavoro. Ultimamente abbiamo avuto molti casi legati a Nod-Krai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260120,
					"content": "...E questo significa che Paimon si terrà a debita distanza, hihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260121,
					"content": "Oh, ancora una domanda! Cosa intende presentare la Spina alla fiera?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260122,
					"content": "Ah, questa meraviglia qui! Una delle ultime invenzioni dell'Istituto di ricerca di Fontaine. È una sorta di sistema di trasmissione che consente di sprigionare energia Pneuma e Ousia in battaglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260123,
					"content": "Quindi è... un'arma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260124,
					"content": "Certo! In un mercato privo di ogni controllo legale come questo, le armi sono le prime a sparire!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260125,
					"content": "Vero anche questo... Però, vantarsi di trasgredire la legge davanti a Chevreuse non mi sembra molto adeguato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260126,
					"content": "Non badate a me. Nei romanzi gialli ne ho lette tante, sulle \"terre senza legge\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260127,
					"content": "In qualità di ispettrice, so già di dover chiudere un occhio, se voglio portare a termine il mio incarico qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260128,
					"content": "Tra l'altro, è meglio che mi metta al lavoro. I membri della Pattuglia mi stanno aspettando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260129,
					"content": "Allora, siete pronte a dirigervi verso la sede dell'evento? Seguiteci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260130,
					"content": "Bene, diamo inizio alle danze! Ho proprio voglia di fare anche un po' di shopping.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260105,
					"content": "...per la fiera?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
