			"dialogs": [
				{
					"id": 742530101,
					"content": "Sinceramente, sono ancora scioccata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530102
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530102,
					"content": "Sai, a quei tempi, io e Alain pensavamo che tu avessi già lasciato questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530103,
					"content": "Mmh... Se ci fossimo svegliate prima, forse avremmo potuto far visita a te e ad Alain, ma suppongo che il destino non volesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530104
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530104,
					"content": "Mademoiselle Mary-Ann...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530105
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530105,
					"content": "Le vie del destino sono davvero misteriose. Mai avremmo pensato di vedere un manifesto cinematografico col tuo ritratto, durante i nostri viaggi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530106
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530106,
					"content": "Quindi è per questo che mi avete contattata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530107
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530107,
					"content": "Esattamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530108
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530108,
					"content": "Ah... L'aroma del caffè mi riempie di nostalgia... Eheh, grazie per averci invitato al tuo ricevimento, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530109
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530109,
					"content": "Il tuo giardino è organizzato in modo davvero elegante, perfetto per una dama raffinata come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530110
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530110,
					"content": "È la casa che io e Alain condividevamo in passato, mi sembrava giusto preservarne la bellezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530111
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530111,
					"content": "Vedi? In questo sei già molto più brava di mio fratello.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530112
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530112,
					"content": "Alain non ha mai nemmeno decorato la sua stanza: non aveva idea di come disporre degli oggetti carini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530113
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530113,
					"content": "Infatti, e lo stesso vale per René. Io e Jakob eravamo gli unici capaci di arredare una stanza come si deve, e anche a saper organizzare un ricevimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530114
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530114,
					"content": "Quindi anche da piccolo era così? Ho sempre pensato che fosse per via della sua età...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530115
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530115,
					"content": "È sempre stato così: era un genio se si trattava di libri, ma in tutto il resto era abbastanza un imbranato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530116
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530116,
					"content": "Forse è per questo che è stato l'unico tra noi a scegliere il dolore della realtà invece dell'illusione di un dolce sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530117
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530117,
					"content": "Uh. Non credo che abbia rimpianto quella scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530118
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530118,
					"content": "No, perché quello era il suo desiderio da eroe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530119
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530119,
					"content": "Il rimpianto è nostro. Il suo desiderio non avrebbe mai dovuto restare inascoltato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530120,
					"content": "E tu, Sandrone? C'è nulla che desideri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530121
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530121,
					"content": "Alain mi ha fatto esattamente la stessa domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530122
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530122,
					"content": "Mh? Dici sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530123
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530123,
					"content": "Mio fratello deve essere maturato molto: non era tipo da chiedere cose del genere, per come lo conoscevo io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530124
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530124,
					"content": "\"Desiderio\" è una parola così vuota. È davvero possibile ottenere tutto ciò che si vuole? Bah, se fosse così, non esisterebbe il male nel mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530125
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530125,
					"content": "Sto facendo ciò che voglio fare, ciò che credo sia giusto. Non so se questo conti come desiderio, ma è ciò che mi rende felice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530126
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530126,
					"content": "Mmh, è una cosa davvero meravigliosa. Ti invidio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530127
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530127,
					"content": "Allora tu... provi risentimento verso Alain? Perché ti ha creata... a immagine di Mary-Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530128
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530128,
					"content": "Nient'affatto. Mi ha sempre fatto capire che ho una mia identità unica e distinta... e che sono libera di scegliere la mia vita. Ed è esattamente quello che ho fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530129
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530129,
					"content": "Ahah! Che si tratti di storie o di cibo, finché sei felice delle tue scelte, Sandrone, allora sono le scelte giuste per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530130
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530130,
					"content": "Esattamente. E ora, godiamoci in tranquillità il cibo che ci hai preparato con tanta cura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				}
			]
		},
