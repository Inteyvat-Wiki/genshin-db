					"Mary-Ann"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742530201,
					"content": "Non c'è nulla di meglio di una vita serena e tranquilla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530202,
					"content": "(Restiamo seduti così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 742530204,
					"content": "Si è già fatto così tardi? Ahah. Dovremmo vederci più spesso, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
}