			},
			"dialogs": [
				{
					"id": 731000701,
					"content": "#Araminali ha la pancia piena, ma i \"bauli\" hanno ancora fame. La fame è brutta. Nara {NICKNAME} e Paimon camminano sempre, devono avere tanta fame. Nara {NICKNAME} e Paimon devono mangiare tanti funghi per recuperare le forze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		}
