			"dialogs": [
				{
					"id": 731000601,
					"content": "#Araminali non è pronto! I \"bauli\" hanno ancora fame. Nara {NICKNAME} e Paimon possono \"riposare liberamente\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000602,
					"content": "#Mmh, no, non è corretto. Nara {NICKNAME} e Paimon possono \"vagare liberamente\". In questo modo, potrebbero imbattersi negli Aranara che hanno bisogno di aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310007,
