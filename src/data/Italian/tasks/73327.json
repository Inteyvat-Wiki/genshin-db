	"talks": [
		{
			"id": 7332701,
			"completionStepIds": [
				7332701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7332701",
							"2"
						],
						"stepId": 7332701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}?!? S-Sei proprio tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270102,
					"content": "E c'è anche Paimon! Non mi aspettavo di incontrarvi qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270103,
					"content": "Jeht, sei qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270104,
					"content": "Ahah! Abbassa la voce, o mi farai scappare tutti i pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270105,
					"content": "Bip bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270106,
					"content": "Uh... Stai pescando, allora? Non dovresti utilizzare una canna da pesca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270107,
					"content": "Bip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270108,
					"content": "#Questo non è vero, Benben! Comunque... {NICKNAME}, perché non cambiamo argomento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270109,
					"content": "Allora, riguardo alla tua canna da pesca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "Ma che...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270111,
					"content": "Si è... rotta. Ma la colpa è della canna stessa, eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270112,
					"content": "*sospira* Non credevo che pescare fosse tanto diverso dal cacciare. Davvero, perché dev'essere così difficile?! Non ho la pazienza di starmene ferma ore e ore ad aspettare che qualcosa abbocchi all'amo, così ho pensato... \"Perché non salto in acqua e non li acchiappo di persona?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270113,
					"content": "Ma non ne hai ancora catturato neanche uno, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270114,
					"content": "Umpf! Sì, invece. Ne ho preso uno gigantesco, era più grande di te di... ehm, di metà dell'altezza di Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270115,
					"content": "Bip! Bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270116,
					"content": "L'ho arrostito e me lo sono mangiato, non ne ho lasciato nemmeno una lisca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270117,
					"content": "Bip...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270118,
					"content": "E sì, anche Benben ne ha assaggiato un po'. E a te non abbiamo lasciato niente di niente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270119,
					"content": "Come no, Paimon ci crede eccome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270120,
					"content": "Ahahah! Peggio per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270125,
					"content": "Come vanno le cose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "Eh? Bene, non preoccuparti per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270127,
					"content": "Non è la prima volta che viaggio da sola...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270128,
					"content": "Bip! Bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270129,
					"content": "Ahahah! Su, su, lo so che ci sei tu con me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270130,
					"content": "Dopo quanto è successo con i Tanit, le varie tribù del deserto hanno smesso di fornirmi cibo e rifugio... Ormai non sono più disposte a proteggermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270131,
					"content": "Qualche tempo dopo... Rukh Shah del Gruppo dei Trenta mi ha offerto un posto in città, ma... non mi sentivo a mio agio laggiù. Mi faceva pensare troppo a mia madre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270132,
					"content": "Così ho lasciato la Città di Sumeru. Pensavo di partire per un'altra nazione e scoprire meraviglie che non ho mai visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270133,
					"content": "Mi sono imbarcata su una nave mercantile e, tra una cosa e l'altra, sono finita qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270134,
					"content": "Dopodiché... Beh, non c'è granché altro da dire, ahah! Ovunque vai, c'è sempre richiesta per una buona guardia del corpo. Questo vale specialmente in città grandi come questa, dove transitano carovane a ogni ora del giorno. Direi che non mi posso lamentare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270135,
					"content": "Eheh, mi trovo bene. Sono soddisfatta della vita che conduco. Non ho legami con nessuno e mi adatto giorno per giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270136,
					"content": "Io e Benben siamo un po' come te e Paimon, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270137,
					"content": "Umpf, non c'è paragone tra Paimon e Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270138,
					"content": "Bip bip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 733270139,
					"content": "#Ahahah! Su, ora non litigate... Beh, {NICKNAME}, non voglio trattenerti oltre. Mi sarebbe piaciuto offrirti un bel pasto abbondante, ma anche noi guardie private abbiamo delle regole da seguire... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270140,
					"content": "Ahem! Basta con i piagnistei! Voglio darti un mare di abbracci come augurio di buon viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270141,
					"content": "#{F#Non dimenticare ciò che ti ho detto dai Tanit... Nel caso ti sentissi stanca o avessi bisogno di riposare... di sicuro le nostre strade si incroceranno di nuovo.}{F#Di sicuro, le nostre strade si incroceranno di nuovo. Non dimenticarlo!}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270121,
					"content": "Non mi aspettavo di trovarti qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "Già... Idem. È stata una bella sorpresa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733270123,
					"content": "Eheh, non abbiamo interrotto la tua pesca... cioè, la tua caccia al pesce, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733270124,
					"content": "Piantala, piccola Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "Jeht"
				}
			]
		},
