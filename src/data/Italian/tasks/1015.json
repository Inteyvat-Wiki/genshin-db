			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "È enorme! Paimon non stenta a credere che sia stata costruita da un Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150302,
					"content": "Ma... come si usa questo affare? Immaginate quanta forza servirebbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150303,
					"content": "Mmm... In ogni caso, al momento è inutilizzabile: quest'arma è rotta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150304,
					"content": "Nooo, cosa? È rotta?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150305,
					"content": "Dopo millenni di usura del tempo, anche gli arnesi degli Adepti possono subire danni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150306,
					"content": "Quindi cosa facciamo? Svelto, Zhongli! Usa i tuoi poteri della conoscenza illimitata da cittadino illustre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150307,
					"content": "Mmmh. Mi descrivi quasi come una sorta di... parassita borghese, la cui unica utilità consiste nel fornire a comando bizzarre curiosità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150308,
					"content": "Detto questo, lasciami riflettere... Ah, sì. Quando la balista Guizhong fu costruita, vennero creati anche dei pezzi di ricambio, qualora avesse subito danni in battaglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150309,
					"content": "A quanto ricordo, da qualche parte lungo il passo c'è un avamposto di rifornimento militare di quel periodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150310,
					"content": "Se riuscissimo a recuperare i pezzi di ricambio, potremmo essere in grado di riparare la balista Guizhong. Occorre solo comprenderne i princìpi di funzionamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150311,
					"content": "Quindi... stai dicendo che conosci tali princìpi di funzionamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150312,
					"content": "Ho un'infarinatura di base sull'argomento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150313,
					"content": "Avendo i <color=#00E1FFFF>pezzi</color>, potrei tentare di aggiustarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101506",
							"2"
						],
						"stepId": 101506,
						"stateName": "QUEST_STATE_UNFINISHED"
