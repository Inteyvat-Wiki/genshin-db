					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151102,
					"content": "Uuuh... Finalmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151103,
					"content": "#Allora, viaggiat{M#ore}{F#rice}: che te ne pare della nostra avventura, finora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151104,
					"content": "È stata... strana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151105
					]
				},
				{
					"id": 10151105,
					"content": "Strana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151106,
						10151107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151106,
					"content": "Non ho ancora capito se abbiamo vissuto una vita di lusso...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				},
				{
					"id": 10151108,
					"content": "Ahah! Quale sarà la verità, mi domando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151109,
					"content": "Viaggi come questo ispirano sempre domande difficili. Molto bene, vi lascerò riflettere per conto vostro. Per quanto riguarda il compenso per il vostro aiuto, ho deciso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151110,
					"content": "...di invitarvi a cena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151111,
						10151112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151111,
					"content": "Zhongli... che offre qualcosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151113,
					"content": "Oh? Ma certo, non preoccupatevi. Mi ricorderò di portare con me un po' di Mora, stavolta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151114
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151114,
					"content": "Questa sera vi porterò in un vecchio bugigattolo rinomato in tutta Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151115
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151115,
					"content": "Bugigattolo? Un modo per dire... buon ristorante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151116,
					"content": "Esatto. Vediamoci alla taverna Le Tre ciotole, vicino al porto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151112,
					"content": "Wow. Fantastico!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151107,
					"content": "Oppure conosciuto i problemi della povertà...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				}
			]
