			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "Questi pezzi ci saranno utili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150602,
					"content": "Datemi un attimo: proverò a ripararla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150603,
					"content": "Fatto. La balista Guizhong è ancora più complessa di quanto pensassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150604,
					"content": "Wow! Ora come l'attiviamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150605,
					"content": "È molto semplice. Dobbiamo solo fare così... Guardate, ha anche un mirino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150617,
					"content": "Allora, qui c'è... poco da vedere. E di qua invece... proprio niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150606,
					"content": "Ehi! Cosa credete di fare!?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "Huang il Lentigginoso"
				},
				{
					"id": 10150607,
					"content": "Avete riparato la torretta... per sfruttarla in che modo, esattamente?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "Huang il Lentigginoso"
				},
				{
					"id": 10150608,
					"content": "Non è una torretta, ma una balista Guizhong. Inoltre, potreste gentilmente qualificarvi prima di fare domande. Per educazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150609,
					"content": "Ah! Per caso non ci vedi bene? Hai davanti il capo dei Cacciatori di tesori, elegantone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "Huang il Lentigginoso"
				},
				{
					"id": 10150610,
					"content": "Si dice che questa zona sia stracolma di tesori nascosti, ma finché quest'affare funzionava, non potevi neanche avvicinartici. Sembrerà un meccanismo come tanti altri, ma questa cosa ha un'anima, fidati di me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "Huang il Lentigginoso"
				},
				{
					"id": 10150611,
					"content": "L'ultima volta che ci siamo avvicinati alla montagna, per poco non infilzava uno dei nostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "Huang il Lentigginoso"
				},
				{
					"id": 10150612,
					"content": "Alcuni di noi hanno rischiato la vita per disattivarla e... incredibilmente ci siamo riusciti. Poi voltiamo le spalle due secondi, ARRIVATE VOI E LA RIPARATE!?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "Huang il Lentigginoso"
				},
				{
					"id": 10150613,
					"content": "La prossima cosa che riparerete saranno le vostre facce. Sempre che ne usciate vivi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "Huang il Lentigginoso"
				},
				{
					"id": 10150614,
					"content": "Tsk. Vandalizzare l'eredità di un Adeptus per fini personali. Che comportamento vergognoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150615,
					"content": "Non siamo noi a meritare un rimprovero. Siete voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150616,
					"content": "#Ben detto! Diamogli una lezione, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "Perdonaci, non siamo riusciti a rispettare la nostra parte dell'accordo. Non abbiamo trovato alcuna traccia della Coccocapra, l'Adeptobestia che hai menzionato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150702,
					"content": "Ah, sono dispiaciuta. Non preoccupatevi. Tuttavia, sono molto dispiaciuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150703,
					"content": "Oh, povera Qiqi... Perché Paimon si sente improvvisamente tanto in colpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150704,
					"content": "Qiqi, avresti altri indizi da darci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "Il latte di Coccocapra è così buono. Così buono. Molto meglio del latte di capra comune. Solo un'Adeptobestia potrebbe produrre latte così buono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150707,
					"content": "Mi dispiace. Ho poca memoria. Non riesco a ricordare il nome del latte. Ecco perché l'ho appuntato. Dove ho messo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150708,
					"content": "Ah. Ecco. Questo è il nome: \"latte di cocco\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150709,
					"content": "Eeeh?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150711,
					"content": "Vi devo le mie scuse. Ho frettolosamente stretto con questa bambina zombi un accordo apparentemente equo, mentre forse avrei dovuto valutare la cosa in maniera più scrupolosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150712,
					"content": "Non ti preoccupare, Zhongli: non potevi saperlo. \"Ogni cosa è casuale, quindi come possiamo azzardarci a prevedere?\" dicono a Liyue. In pratica, nessuno poteva immaginarselo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150713,
					"content": "Scusatemi. Qiqi ha detto qualcosa di male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150714,
					"content": "#Oooh... Mi dispiace tanto, {NICKNAME}, ma Paimon lascerà a te il compito di far crollare il mondo addosso a questa bambina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150715,
					"content": "È ora che tu sappia da dove viene il latte di cocco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "No... I-Impossibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150718,
					"content": "Pare che Qiqi l'abbia presa molto male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150719,
					"content": "Ha solo bisogno di tempo per elaborare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "Eheheh, oggi qualcuno ha imparato una buona lezione di vita, vero? Grazie dei vostri riguardi per la mia piccola Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150722,
					"content": "Posso chiedere chi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150723,
					"content": "Oh, che maleducato che sono. Mi chiamo Baizhu, sono il proprietario della Farmacia Bubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150724,
					"content": "Paimon pensava che fosse Qiqi la proprietaria... E invece è un tipo strano che si porta un ingrediente al collo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150725,
					"content": "Che situazione desolante... Quella piccola mascotte è ancora più sciocca di Qiqi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150726,
					"content": "Ah! L'ingrediente... Ehm... il serpente sa parlare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150727,
					"content": "Wow, un serpente parlante!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "Uff! Di solito preferisco non parlare, ma davanti agli sconosciuti mi tocca farlo. Altrimenti, mi scambiano per un medicinale caduto dall'armadietto. Sono una serpentessa viva e vegeta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150730,
					"content": "Eheheh, non fate caso a Changsheng. È una burlona, davvero. Quanto a voi tre... Cosa vi porta qui, a parte Qiqi \"combinaguai\" che ormai tutti conosciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150731,
					"content": "Avete dell'Incenso perenne da vendere, nella vostra bella bottega?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150732,
					"content": "Incenso perenne? Ma certamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150733,
					"content": "Oh, finalmente! Ora sì che cominciamo a fare progressi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150734,
					"content": "Tre milioni di Mora. Qualità elevatissima, garantisco io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150735,
					"content": "Tre milioni?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "A questo punto, rapina direttamente il Palazzo dorato! Oh, ma ora è sotto il controllo delle Sette Stelle... Sarà ancora più sorvegliata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150739,
					"content": "Mmmh, tre milioni... I numeri di per sé sono innocui, ma dal punto di vista pratico, accumulare una somma del genere potrebbe rivelarsi difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150740,
					"content": "È un prezzo pazzesco! Noi due non saremo mai in grado di tirare su così tanti Mora. E per quanto riguarda Zhongli... gli mancano giusto tre milioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150741,
					"content": "Esattamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150742,
					"content": "Non ho parole...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "E ora cosa facciamo? Ci tocca tornare dal Principe con la coda tra le gambe...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150744,
					"content": "Ahahahahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10150745,
					"content": "Coccocapra! Coccoca... Ahahahah! Mi fa male tutto... Oh, santo cielo! Come avete potuto CREDERE a una cosa del genere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10150746,
					"content": "Ehi, ridi un po' meno e supportaci di più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150747,
					"content": "Sto praticamente piangendo dal ridere... Ah, vi ringrazio: non ridevo così da molto tempo. In cambio, sarò ben contento di risolvere il pasticcio in cui vi siete messi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10150748,
					"content": "Mi scusi, signore... Lei è il dottor Baizhu, giusto? Molto onorato. Io sono il Principe, uno dei Messaggeri dei Fatui. Perdoni la mia audacia, ma vedo per noi all'orizzonte molte opportunità di collaborazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10150749,
					"content": "Qualora la Farmacia Bubu avesse bisogno di forniture regolari di, per esempio, latte di cocco, i Fatui vi aiuterebbero con una solida e rapida rete di distribuzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10150750,
					"content": "Strano... Sapevo che i Fatui s'infiltrano nelle aziende proponendo accordi allettanti, ma... tanto disturbo per del latte di cocco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150751,
					"content": "Latte di cocco. Baizhu. Svelto. Qiqi vuole latte di cocco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150752,
					"content": "Ah... sì, certo. Qualunque cosa desideri, Qiqi... Grazie, Principe. Attendo con ansia le nostre future collaborazioni. Vi posso anche offrire uno sconto sull'Incenso perenne. Facciamo... 2.990.000 Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150753,
					"content": "Ma non c'è praticamente alcuna differenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150754,
					"content": "Mmmh, 2.990.000... Altri numeri di per sé innocui, ma in pratica si tratta di diecimila Mora in meno rispetto ai tre milioni di partenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150755,
					"content": "Bene, ora che abbiamo trovato un accordo, dobbiamo tornare al Belvedere di Yujing. Principe, dottor Baizhu, piccola Qiqi... Arrivederci a presto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150756,
					"content": "Quella combriccola è un vero spasso. Francamente, era da una vita che non ridevo così tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10150757,
					"content": "Allora, hai origliato come si deve, spero. Cosa mi sono perso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10150758,
					"content": "Sì, nobile Principe. Hanno detto che le Sette Stelle hanno occupato il Palazzo dorato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10150759,
					"content": "Bene, bene, bene. Ningguang e compagine assortita. Cos'altro nasconderanno nel Palazzo dorato se non... l'Exuvia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10150760,
					"content": "#Mi dispiace, {NICKNAME}, ma te l'avevo detto, non è vero? Come si dice a Liyue: \"Anche i muri hanno orecchie\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Il Principe"
				},
				{
					"id": 10150737,
					"content": "A questo punto, rapina direttamente il Palazzo dorato!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "Peccato che ora sia sotto il controllo delle Sette Stelle... Sarà ancora più sorvegliata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150728,
					"content": "Ormai a Liyue non mi stupisco più di nulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "Prima o poi bisogna crescere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "Tutto ha inizio dal frutto della palma da cocco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "A cosa ti serve la Coccocapra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "Oh, eccoti qua! Ma non arrivi nemmeno al banco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150902,
					"content": "Ma è... una zombi?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "Ah... Paimon crede che tu abbia ragione! Guarda il talismano sulla fronte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150908,
					"content": "Vi do il benvenuto alla Farmacia Bubu. Sono Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150909,
					"content": "Tanto tempo fa, Qiqi morì. Poi, Qiqi fu salvata dagli Adepti. Ora, Qiqi è una zombi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150910,
					"content": "Una rivelazione incredibile raccontata con tanta nonchalance...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "Una cosa del genere sarebbe inconcepibile a Mondstadt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150913,
					"content": "Salve... piccolina. Vendete dell'Incenso perenne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150914,
					"content": "Mi scusi, signore. Ha la ricetta medica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150915,
					"content": "Ehm.. sicuramente non serve una ricetta per acquistare dell'Incenso perenne. Non è vincolato alla prescrizione medica...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150916,
					"content": "Qiqi può darvi la medicina, ma solo se mostrate a Qiqi la ricetta. Questi sono gli ordini di Qiqi, da Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150917,
					"content": "Ordini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "Gli zombi possono agire solo nei limiti degli ordini loro impartiti. In questo caso, per qualche ragione, la zombi se li dà da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150921,
					"content": "Mia cara Qiqi: purtroppo non abbiamo una ricetta, ma speriamo che tu possa comunque aiutarci a trovare dell'Incenso perenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150922,
					"content": "Molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150923,
					"content": "Come hai fatto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150924,
					"content": "Ma se Qiqi aiuta voi, voi aiutate Qiqi. È giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150925,
					"content": "Da quando i clienti devono assistere il servizio alla clientela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150926,
					"content": "Non importa. Consideriamolo un accordo tra due parti vantaggioso per entrambe. A volte, a Liyue gli affari si fanno ottenendo ciò che si vuole tramite trucchetti psicologici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150927,
					"content": "Andate al Monte Tianheng. Cercate la balista Guizhong. E catturate una Coccocapra. Per favore. Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150928,
					"content": "Catturare cosa, dove e con cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "La balista Guizhong... Ne ho già sentito parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150932,
					"content": "È una sorta di torretta con una balestra, installata in un'epoca remota da un Adeptus sul Monte Tianheng. Un meccanismo antico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150933,
					"content": "Situata sul Passo di Tianheng, era progettata per colpire automaticamente grossi mostri, proteggendo così Liyue da minacce esterne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150934,
					"content": "Zhongli sa ogni cosa su Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150935,
					"content": "Non proprio, a quanto pare... Questa è la prima volta che sento parlare della \"Coccocapra\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150936,
					"content": "La Coccocapra è un animale leggendario. Un'Adeptobestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150937,
					"content": "Volevi aggiungere ancora qualcosa, oppure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150938,
					"content": "No. Solo che la Coccocapra è un animale leggendario. Un'Adeptobestia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150939
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150939,
					"content": "Come è fatta, non so. Dove trovarla, non so. Da dove viene, anche non so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150940,
					"content": "Se ti torna in mente qualcosa, non esitare a dircelo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "Molto bene, allora. Cominciamo indagando nei pressi della <color=#00E1FFFF>balista Guizhong</color>. Forse troveremo qualche indizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150943
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150943,
					"content": "Ma che cos'è una Coccocapra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150941,
					"content": "Non abbiamo molto su cui basarci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "Ci sta prendendo in giro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150931
					]
				},
				{
					"id": 10150931,
					"content": "Io non credo. Della balista Guizhong, almeno, ho già sentito parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150918,
					"content": "Perché complica tanto le cose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150919
					]
				},
				{
					"id": 10150919,
					"content": "Temo che abbia ragione. Dev'essere per via degli ordini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150920
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150911,
					"content": "Anche gli zombi sono Adepti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150904,
					"content": "Paimon, non è che tu sia tanto più alta, eh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150905
					]
				},
				{
					"id": 10150905,
					"content": "Paimon sa volare, quindi non conta. E vola più in alto di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150906,
					"content": "Comunque è una tipa un po' strana... Cos'è quel talismano sulla fronte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150907,
					"content": "Non può essere... È... una zombi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
