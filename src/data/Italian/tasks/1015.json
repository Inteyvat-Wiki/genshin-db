			"dialogs": [
				{
					"id": 10151101,
					"content": "Bene, ricapitoliamo: abbiamo assunto gli aiutanti e acquistato l'Incenso perenne. Ormai manca poco alla fine dei preparativi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151102
