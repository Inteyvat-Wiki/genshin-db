					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151410
					]
				},
				{
					"id": 10151410,
					"content": "Non risolveremo niente rimanendo qui a spremerci le meningi. Torniamo alla Farmacia Bubu, spieghiamo che non siamo riusciti a trovare la Coccocapra e poi vedremo come procedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151411,
					"content": "Buona idea. Abbiamo fatto del nostro meglio, è questo che conta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151408,
					"content": "Che la riparazione è stata una perdita di tempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151409
					]
				},
				{
					"id": 10151409,
					"content": "Paimon non sarebbe così drastica. Abbiamo fatto una cosa buona, giusto?",
