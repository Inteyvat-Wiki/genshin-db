			"dialogs": [
				{
					"id": 760290401,
					"content": "(Mmh? Il suono di una lira? Sembra che Colombina stia suonando per la Kuuhenki.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290402
					]
				},
				{
					"id": 760290402,
					"content": "#(L'ultima volta che siamo {F#passate}{M#passati}, la lira non era ancora stata riparata, molto prima che Colombina conoscesse tutti...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290403
					]
				},
				{
					"id": 760290403,
					"content": "Poco fa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
