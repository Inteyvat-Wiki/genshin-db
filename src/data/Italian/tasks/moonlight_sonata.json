			"dialogs": [
				{
					"id": 760290101,
					"content": "Salve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290102,
					"content": "Eh? Vai via, Colombina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290103,
					"content": "Sì. Devo far riparare una lira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290104,
					"content": "...Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290105,
					"content": "La lira di una Kuuhenki si è rotta. Ci tiene molto, quindi voglio che venga riparata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290106,
					"content": "Certo che le Kuuhenki sono piene di talenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290107,
					"content": "Concordo. Spesso questa piccoletta suona qui, e a volte l'accompagno col canto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290108,
					"content": "Sai, Paimon ci pensa da un po', le vizi davvero tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290109,
					"content": "Beh, è giusto così. Mi hanno tenuto compagnia per molto tempo, e spesso mi portano degli oggetti interessanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290110,
					"content": "(Lauma aveva parlato dell'istinto naturale delle Kuuhenki di provare a far felici le Dee della luna.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "Se non ti dispiace che Paimon te lo chieda, come pensi di riparare la lira? Non dicevi che non ti volevi far vedere dagli altri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290112,
					"content": "Mmm... In passato degli animaletti o delle Kuuhenki mi aiutavano a consegnare degli oggetti rotti davanti alla porta di un'artigiana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290113,
					"content": "Tutto ciò che dovevo fare era aspettare che l'artigiana li trovasse. Ovviamente, a volte ci volevano diversi giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290114,
					"content": "Sembra un modo decisamente contorto di fare le cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290115,
					"content": "Perché non lasci che ce ne occupiamo noi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290117,
					"content": "Sì, lascia fare a noi. Chissà, magari riusciremo a fare tutto oggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290118,
					"content": "...Bene. Vi ringrazio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290119,
					"content": "Non c'è di che! A proposito, a quale artigiana porti le tue cose di solito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290120,
					"content": "Non conosco il suo nome, ma vicino alla porta c'è una grande mano meccanica. E vive in una casa rotonda, simile a una conchiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290121,
					"content": "(Aspetta, starà parlando di...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "E spesso si sente l'odore dei krumkake provenire dall'interno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760290123,
					"content": "Sì, questo chiarisce ogni cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
