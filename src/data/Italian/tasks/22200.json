			"dialogs": [
				{
					"id": 222000301,
					"content": "Hai trovato la pietanza in grado di saziare il mio appetito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000302,
						222000304
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000302,
					"content": "Ce l'ho qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000303
					]
				},
				{
					"id": 222000303,
					"content": "Ottimo, fammi assaggiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000304,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000305
					]
				},
				{
					"id": 222000305,
					"content": "D'accordo. Se scegli il Toast del pescatore, so che il Ristorante Wanmin lo vende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000307
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000307,
					"content": "Ho sentito da un mercante di Mondstadt che nel menù del Buon Cacciatore c'è la zuppa ai gigli di calla e frutti di mare. Secondo me, è buonissima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000308
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000308,
					"content": "A proposito di piatti di Mondstadt, il pesce alla griglia e il pollo ai Fiordolci sembrano abbastanza facili da realizzare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000309
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000309,
					"content": "*BRONTOLIO* Ecco, mi è bastato pronunciare i nomi di quelle pietanze per farmi venire ancora più fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
		{
