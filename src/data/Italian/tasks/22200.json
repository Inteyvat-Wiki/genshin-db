					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000601,
					"content": "Non so che darei per del pesce scoiattolo o del pollo al peperoncino di Jueyun, ma dicono che anche i piatti di Mondstadt come lo stufato di carne e verdure e l'uovo fritto di Teyvat siano eccezionali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000602
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000602,
					"content": "Se solo mi fermo a pensarci, io *BRONTOLIO*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000603
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000603,
					"content": "Ti prego, procurami uno di quei piatti... Voglio che lo stomaco *BRONTOLIO* mi dia tregua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
