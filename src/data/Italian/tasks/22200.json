			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "Beh, mi dicono un gran bene di alcune pietanze di Mondstadt: pollo ai Fiordolci, pesce alla griglia di Mondstadt, Toast del pescatore, zuppa ai gigli di calla e frutti di mare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000202,
					"content": "Insomma, scegli quello che pensi mi riempia meglio lo stomaco, e grazie per l'aiuto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000203,
					"content": "Così almeno il mio stomaco non mi assorderà per tutto il giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
