			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "Ehilà, ti *BRONTOLIO*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000102,
					"content": "Oh, no! Il mio stomaco si è di nuovo messo a rumoreggiare... Stavo dicendo, per caso ti *BRONTOLIO*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000103,
					"content": "Non ho capito.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "*sospira* Ogni volta che sono affamato, il mio stomaco fa così. Brontolii continui e belli potenti. A volte non riesco neanche a sovrastarli col suono della mia voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000105,
					"content": "Sono andato *BRONTOLIO* a farmi visitare alla Farmacia Bubu, ma il dottore ha detto che non sono malato. Tutta colpa della fame, quindi l'unica cura è... *BRONTOLIO*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000106,
					"content": "Secondo il medico, mi basterebbe consumare dei pasti completi, però il mio stomaco è *BRONTOLIO* senza fondo! Dovessi mangiare sempre a sazietà, andrei letteralmente in rovina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000107,
					"content": "Jiayi pensa che, se i pasti principali non mi riempiono, devo fare degli spuntini durante il giorno per non compromettere il mio lavoro quotidiano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000108,
					"content": "\"Spuntini\"... Bah... L'elenco dei piatti che assaggerei volentieri è lunghissimo e non so quale riuscirebbe a riempirmi lo stomaco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000109,
					"content": "#{M#Viaggiatore}{F#Viaggiatrice}, tu hai di certo esperienza da vendere. Quali cibi saziano maggiormente, secondo te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000110,
					"content": "Mi aiuteresti a scegliere il piatto più delizioso e nutriente dalla mia lista?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000111,
					"content": "Stavolta cosa vorresti mangiare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "Oh, che scelta difficile... Fammi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
		{
			"id": 2220002,
			"completionStepIds": [
				2220002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
