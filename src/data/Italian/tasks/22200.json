			"dialogs": [
				{
					"id": 222000401,
					"content": "Vorrei una zuppa di semi di loto e uova d'uccello, ma anche un po' di stufato di persico a dorso scuro... Certo che però anche le specialità di Mondstadt... Mmm... Spiedino di pollo e funghi? Pancake? Chi più ne ha più ne metta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000402
					],
