				},
				{
					"id": 222000504,
					"content": "Non ancora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000505
					]
				},
				{
					"id": 222000505,
					"content": "Ho saputo che lo chef Mao del Ristorante Wanmin prepara un ottimo stufato di persico a dorso scuro. Puoi rivolgerti a lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000506
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000506,
					"content": "Gui l'erborista, invece, credo conosca la ricetta della zuppa di semi di loto e uova d'uccello. Se vuoi parlargli, lo trovi alla Farmacia Bubu del Belvedere di Yujing.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000507
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000507,
					"content": "Un mercante mi ha detto un gran bene dei pancake del Buon Cacciatore di Mondstadt. Riempiono moltissimo, a quanto pare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000508
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000508,
					"content": "Per quanto riguarda lo spiedino di pollo e funghi... Beh, sembra un piatto semplice da realizzare, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000509
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000509,
					"content": "*BRONTOLIO* Ecco, mi è bastato pronunciare i nomi di quelle pietanze per farmi venire ancora più fame...",
					"roleType": "TALK_ROLE_NPC",
