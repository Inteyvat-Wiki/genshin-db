				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "Signore, le suggerisco sinceramente di trovare un modo per pagare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140102,
					"content": "Sembravano più banditi che mercanti! Come possono chiedere così tanto per un paio di emblemi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140103,
					"content": "Forse avranno notato come le si sono illuminati gli occhi alla loro vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140104,
					"content": "Perché hai bisogno di un emblema?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "#Viaggiat{F#rice}{M#ore}! Il tuo tempismo è sempre perfetto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140106,
					"content": "Grazie al tuo aiuto della scorsa volta, ho prodotto un lubrificante accettabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140107,
					"content": "Tuttavia, ho avuto l'ennesimo problema. Mentre riproducevo alcune delle parti, ho visto che... il loro materiale eccessivamente duro danneggia le altre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140108,
					"content": "Inoltre, queste parti estremamente dure si rompono, in misura diversa, perfino al minimo impatto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140109,
					"content": "Quindi ho iniziato a cercare un materiale che fosse duro ma anche flessibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140110,
					"content": "Dopo inarrestabili ricerche...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140111,
					"content": "...E dopo aver assillato senza sosta il signor Ahangar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140112,
					"content": "Ho pensato che avrei potuto trovare il materiale che cercavo negli emblemi che i Cacciatori di tesori portano con sé.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140113,
					"content": "Ma quei mercanti potevano benissimo essere dei Cacciatori di tesori, per come mi stavano derubando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140114,
					"content": "Ed è qui che entro in gioco io, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "Dovrei incidere il tuo nome sul cuscinetto principale della mia macchina numeratrice! Non potrò mai esprimere la mia gratitudine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140115,
					"content": "Beh, ti aiuterò a trovarne un po'.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
