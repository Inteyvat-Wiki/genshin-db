			"dialogs": [
				{
					"id": 230145001,
					"content": "Ritengo che dovremo guadagnarci un po' di Mora, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145002,
					"content": "Ho sentito che nella Città di Sumeru c'è un teatro, e che stanno cercando qualcuno che si occupi della contabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145003,
					"content": "Inoltre, il personale di scena... guadagna un bel po' di Mora, ma non ha idea di come tenerne traccia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145004,
					"content": "Sento odore di opportunità, signore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145005,
					"content": "Il tuo talento in materia di contabilità e affari è sorprendente, mio caro Lutong...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145006,
					"content": "Ma dammi un attimo, fammi pensare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
