				},
				{
					"id": 230140302,
					"content": "Dovrò prima riprodurre l'ingranaggio... Anzi, prima dovrei affrontare il problema dei cuscinetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140303,
					"content": "#Ecco la tua ricompensa, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140304,
					"content": "Date le circostanze, probabilmente ci aspetta una collaborazione a lungo termine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140305,
					"content": "Uff, i conti del signor Garcia... Solo a sistemarli mi fa venire il mal di testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
