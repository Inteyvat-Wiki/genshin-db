			"dialogs": [
				{
					"id": 230140301,
					"content": "#Grazie mille, viaggiat{F#rice}{M#ore}. Dovrebbero essere sufficienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
