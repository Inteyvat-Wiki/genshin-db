			"dialogs": [
				{
					"id": 730151301,
					"content": "Ecco dove si nascondeva. Paimon non crede che l'avremmo trovato senza Aranakula a guidarci...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151302,
					"content": "Dove sono le sue foglie? Paimon non le vede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151303,
					"content": "Le foglie... Si trovano vicino a questo grande albero, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151304
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151304,
					"content": "Mmm.... . I Miconoidi non riusciranno a raggiungerci. Aspettaci qui, Aranakula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151305,
					"content": "Arapandu ha detto che dobbiamo rivolgere le \"foglie\" sulle tre pietre verso il \"ramo\", giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151306,
					"content": "#Grazie, Nara {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
