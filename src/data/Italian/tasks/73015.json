				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151101,
					"content": "#Oh! Grazie, Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151102,
					"content": "Vana ricorda tutto ciò che è successo dopo arrivo di Nara Varuna. Grandi alberi ricordano e semi ricordano, ma non sappiamo se Nara Varuna lo sa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151103,
					"content": "Per questo abbiamo creato memorie visibili. Così, quando Nara Varuna tornerà, Nara Varuna saprà che Vana e Aranara non hanno dimenticato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151104,
					"content": "Ora Paimon ha capito... La Memoria di pietra è come una targa commemorativa. Beh, anche gli esseri umani erigono monumenti commemorativi per non dimenticare delle cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151105,
					"content": "Beh, i Nara sono creature smemorate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151106
					]
				},
				{
					"id": 730151106,
					"content": "...Paragonati alla foresta, i Nara sono come delle piccole piante che non diventeranno mai imponenti alberi e che non possiedono gli anelli degli alberi per ricordare tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151107,
					"content": "Aranara non lasceranno Vana. Aranara rimarranno per sempre a Vana. Ma Nara vanno e vengono, proprio come Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151108
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151108,
					"content": "Ci sono molti Aranara, proprio come ci sono molti alberi grandi a Vana. Molti Aranara hanno vari nomi, proprio come alberi grandi hanno vari rami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151109
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151109,
					"content": "#{F#Il}{M#La} Nara dorat{F#o}{M#a} ricorda molti nomi Aranara e ricorda che io sono Aranakula. È come raccogliere una foglia svolazzante e sapere da quale albero proviene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151110
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151110,
					"content": "#Nara Varuna dev'essere stat{F#o}{M#a} {F#un}{M#una} Nara molto speciale per gli Aranara: ecco perché hanno eretto un monumento per {F#lui}{M#lei}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151111,
					"content": "Beh, non è proprio la stessa cosa, ma abbiamo già visto statue con volti di persone scolpiti su di esse, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151112,
					"content": "...Intendi le Statue dei Sette?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151113
					]
				},
				{
					"id": 730151113,
					"content": "#Sì! E ora che conosciamo la storia di Nara Varuna, non vuoi sapere che aspetto ha, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151114,
					"content": "Gli Aranara conoscono la musica, quindi è possibile che siano abili anche in altre arti! Magari sono in grado di realizzare anche delle statue realistiche o qualcosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151115,
						730151117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151115,
					"content": "Sì, mi piacerebbe vederle, se ne hanno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151116
					]
				},
				{
					"id": 730151116,
					"content": "#Vero? Eheh, Nara Varuna, {F#un}{M#una} Nara dorat{F#o}{M#a}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151119,
					"content": "Ooh, giusto! Paimon immagina che ora possiamo andare a risanare i rami e le foglie della Macchina di Varuna, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151120,
					"content": "#Sì. Aranakula porterà lì Nara {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151117,
					"content": "Gli Aranara praticano delle arti molto semplici, quindi sarà un po' difficile interpretarle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151118
					]
				},
				{
					"id": 730151118,
					"content": "Mmh... Oppure le loro arti potrebbero essere troppo avanzate per te...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				}
			]
		},
