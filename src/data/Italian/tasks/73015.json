					"Paimon",
					"Aranakula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "#Aranakula, siamo tornat{F#e}{M#i}! Da qui in poi, però, dovrai occuparti tu del resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151602,
					"content": "#Grazie, Paimon, e grazie, Nara {NICKNAME}. Aranakula sa cosa fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151603,
					"content": "Oh! Sembra che anche qui andrà tutto a posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151604,
					"content": "Spero che la foresta torni presto alla normalità.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "Lo farà dopo che la Macchina di Varuna verrà riparata. Ma Marana... deve essere eliminato per Vana e il Sarva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151606,
					"content": "Proprio come monumento creato per Nara Varuna era ricoperto da semi cattivi, anche Antro di Ashvattha è stato colpito da Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151607,
					"content": "Tempo fa, prima che Nara Varuna arrivasse nel Vanarana, i Nara e gli Aranara creavano i vivai insieme. Ma ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151608,
					"content": "Ora soltanto i bambini del Villaggio di Vimara possono ancora vedervi. Per gli adulti, esistete solo nelle storie... E i vivai del passato sono diventati deserti a causa di Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151609,
					"content": "Aranakula vuole riempire i vivai di fiori. I Nara hanno dimenticato gli Aranara, ma va bene così perché i Nara vedranno i fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151610,
					"content": "Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151611,
					"content": "#Nara {NICKNAME}, Paimon, grazie. Aranakula non lo dimenticherà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151612,
					"content": "Ora Aranakula tornerà ad \"area di relax\". Arapandu sarà felice di sapere che monumento è stato ripulito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151613,
					"content": "#Nara {NICKNAME} e Paimon torneranno ad \"area di relax\" con Aranakula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151614,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "#Mi sento al sicuro viaggiando con Nara dorat{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151616,
					"content": "Mi dispiace, ho altro da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#Che Aramuhukunda vegli su Nara {NICKNAME} e Paimon. Non fatevi mangiare da brutti mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
