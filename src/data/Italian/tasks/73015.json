		},
		{
			"id": 7301511,
			"completionStepIds": [
				7301511
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301511",
							"2"
						],
						"stepId": 7301511,
						"stateName": "QUEST_STATE_UNFINISHED"
