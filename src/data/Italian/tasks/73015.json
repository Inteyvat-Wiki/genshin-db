			},
			"dialogs": [
				{
					"id": 730150901,
					"content": "#Nara {NICKNAME}, questa è Memoria di pietra che Aranara hanno creato per Nara Varuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150902
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150902,
					"content": "Finalmente siamo qui... Paimon aveva tanta paura di essere scoperta dai Miconoidi lungo la strada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150903,
						730150905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150903,
					"content": "Si sta meglio senza combattere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150904
					]
				},
				{
					"id": 730150904,
					"content": "Paimon immagina che tu abbia ragione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150907,
					"content": "Mmmh... Quindi questa è la Memoria di pietra? Sembra una stele di pietra realizzata dagli Aranara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150908,
					"content": "#Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150909
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150909,
					"content": "Eliminerò i semi cattivi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150910
					]
				},
				{
					"id": 730150910,
					"content": "#Aranakula, non preoccuparti! Lascia che se ne occupi Nara {NICKNAME}. Sarà un gioco da ragazzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150905,
					"content": "Consideralo come un modo per conservare razioni di emergenza nella foresta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150906
					]
				},
				{
					"id": 730150906,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
