			},
			"dialogs": [
				{
					"id": 220450401,
					"content": "Com'è andata? Hai scattato le foto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450402,
					"content": "Non è stato così difficile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450403
					]
				},
				{
					"id": 220450403,
					"content": "Fammi vedere... Ooh! Che inquadratura... e questa posa... Molto bene! Davvero niente male!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450404,
						220450405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450404,
					"content": "Sembri davvero emozionato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				},
				{
					"id": 220450406,
					"content": "Oh, eccome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450407,
					"content": "#Grazie mille, viaggiat{F#rice}{M#ore}. Ecco, tieni. Inizierò a esercitarmi tra un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450408,
					"content": "Oh-oh-oh, ora si che ragioniamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450405,
					"content": "Ti vanno bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				}
			]
		},
