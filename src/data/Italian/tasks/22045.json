				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "Mmmh, ancora non ci siamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450102,
					"content": "Cosa succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "#Ah, viaggiat{F#rice}{M#ore}! Stavo pensando proprio a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450104,
					"content": "Di recente, mi sono reso conto che le mie piccole sculture in legno... sono prive... sai, di vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450105,
					"content": "Beh, sono fatte di legno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "Oh, non è quello che intendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450108,
					"content": "Uhm, come posso spiegartelo? Ciò che sto cercando è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450109,
					"content": "Vedi, la nostra Gran Sacerdotessa provvisoria dorme molto, ma talvolta si sveglia e vaga per il Santuario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450110,
					"content": "Durante le sue passeggiate, balza o saltella qua e là, si lancia su qualche foglia secca, si stiracchia... Cose di questo genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450111,
					"content": "Vorrei immortalarla in quei momenti. Mi piacerebbe realizzare delle sculture usando quelle azioni come base. Questo è ciò che intendo con \"vita\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450112,
					"content": "Beh, vai ad ammirarla con i tuoi occhi, allora...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "Ecco, io, ehm... mi sento un po' in imbarazzo a farlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450115,
					"content": "A prescindere da tutto, è pur sempre il mio capo. Temo che non sarebbe molto felice se mi accovacciassi al suo fianco per osservarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450116,
					"content": "La relazione che c'è tra voi, invece, si presta molto meglio a questo genere di cose. Ti dispiacerebbe scattarle qualche foto che possa usare come riferimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450117,
					"content": "E va bene, va bene, ho capito...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "#Allora grazie mille, viaggiat{F#rice}{M#ore}. Portami le foto appena le avrai scattate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450118,
					"content": "Non garantisco di riuscire a immortalare le azioni che vuoi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "Nessun problema. Non c'è bisogno d'immortalare grandi movimenti. Non credo che le mie attuali tecniche di scultura sarebbero comunque all'altezza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450120,
					"content": "Pensa solo a immortalare alcune pose. Per ora dovrebbe bastare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450113,
					"content": "Beh, è proprio là...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "Che genere di \"vita\" vorresti infondere nelle tue opere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
