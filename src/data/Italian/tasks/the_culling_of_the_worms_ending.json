			},
			"dialogs": [
				{
					"id": 735190101,
					"content": "Non capisco... È stata lei a proporre l'idea di andare in caffetteria per scrivere la relazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190102,
					"content": "Perché sei qui da solo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "*sospira* Non ne voglio parlare. Sta lavorando alla relazione da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190105,
					"content": "Avremmo dovuto incontrarci alla caffetteria ieri, ma le ci è voluta un'eternità per presentarsi. E non ha portato né carta né penna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190106,
					"content": "L'ho criticata perché stava perdendo tempo che avrebbe potuto dedicare alla relazione, e se n'è andata collerica! Ha detto che l'avrebbe scritta da sola e mi ha mandato via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190107,
					"content": "Non trovi che sia ridicolo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190108,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "Comunque sia, sono abituato al suo carattere impetuoso. Si calmerà tra un paio di giorni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190110,
					"content": "Se solo riuscisse a controllare le sue emozioni come premendo un interruttore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190111,
					"content": "Ti auguro in bocca al lupo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "Huh? Anche tu ti comporti in modo strano... Oh, beh, non importa... Qui intorno ci sono ancora alcuni Unut sotto l'influsso dell'ambiente elementale. Sono sicuro che, se li lasciamo stare, la situazione si calmerà da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190114,
					"content": "Ma, se avessi tempo, sarei felice se mi aiutassi a impedire che minaccino i passanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190115,
					"content": "Comunque, ora l'ambiente elementale e il dispositivo di ricarica sono tornati alla normalità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190116,
					"content": "Non c'è mai stato momento migliore per provare il cannone Ammazzaunut alla massima potenza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190112,
					"content": "Buona fortuna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "Dov'è Shriya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
