			},
			"dialogs": [
				{
					"id": 731053001,
					"content": "Alrani... dimmi che stai bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053002,
					"content": "Com'era Alrani all'Akademiya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "Era piuttosto diligente. Ma già allora inseguiva delle strane via senza uscita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053004,
					"content": "Come studentessa è più che qualificata, e credo che lo sarà altrettanto da ricercatrice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053005,
					"content": "È difficile per gli studenti far approvare le proprie tesi all'Akademiya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "A essere sincera, sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053007,
					"content": "La revisione delle tesi è complicata. Bisogna tenere in conto l'argomento della propria ricerca, quanto ricca è la bibliografia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053008,
					"content": "Ed è sempre una buona idea tenere d'occhio eventuali sovrapposizioni o conflitti con gli elaborati degli altri. Una volta inviata la propria proposta di tesi, è possibile imbattersi comunque in difficoltà di ogni sorta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053009,
					"content": "*sospira* Ma devo dire che è incredibilmente sfortunata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				}
			]
		},
