			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzam",
					"Alrani",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050701,
					"content": "Alrani! Allora, hai intenzione di uscire da quella gabbia o no?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050702,
					"content": "No! Al diavolo le ricerche e l'Akademiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050703
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050703,
					"content": "Vi ho pagati per farmi stare qui. Non potete lasciarmi in pace e basta?!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050704
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050704,
					"content": "Sei testarda, fastidiosamente testarda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050705,
						731050706
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050705,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				},
				{
					"id": 731050707,
					"content": "S-Salve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050708,
					"content": "Mmmh? Oh, tu sei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050709
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050709,
					"content": "#V-Viaggiat{F#rice}{M#ore}! *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050710,
					"content": "Signorina Alrani, sei davvero qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050711,
					"content": "Sono felice di vedere che stai bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "*piange* ...Avevo già scritto io una tesi su quell'argomento! Non è giusto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050714,
					"content": "Se non fossi stata bloccata a Inazuma così a lungo, la mia tesi sarebbe stata accettata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050715,
					"content": "Calmati ora... Vuoi ancora finire di scrivere la tua tesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050716,
					"content": "*ansima*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050717,
					"content": "Io... Io getto la spugna! Tesi, Akademiya... Ne ho fin sopra i capelli! Solo gli idioti scrivono tesi! L'Akademiya può fare quel che le pare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050718,
					"content": "Ho pagato Narzam perché mi protegga. Nessuno mi costringerà a lavorare a quella tesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050719,
					"content": "Bah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050720,
					"content": "E tu sei...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "Narzam. E per quanto riguarda il mio lavoro... Tsk, di sicuro lo saprai già. Andiamo dritti al sodo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050722,
					"content": "#Ti conosco, viaggiat{F#rice}{M#ore}. Sei stat{F#a}{M#o} molto attiv{F#a}{M#o} in questa zona, di recente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050723,
					"content": "Se hai accettato un incarico per riportare indietro la ragazza, provaci pure. Io non ti fermerò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050724,
					"content": "Ehi! Ma io vi ho pagati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050725,
					"content": "Per cosa? Quei soldi non bastano nemmeno a pagarci il cibo per qualche altro giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050726,
					"content": "A ogni modo, io indietro non ci torno. Là ci sono solo nuovi argomenti e ricerche sul campo. Non avrei più pace, né di notte né di giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050727,
					"content": "Potrei anche finire catturata da della gentaglia o imbattermi in mostri strani. E in tal caso non avrei abbastanza tempo per finire la mia tesi e dovrei saltare la discussione... di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050728,
					"content": "*singhiozza* No... Preferisco restare chiusa qui dentro. *piange*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050729,
					"content": "#Viaggiat{F#rice}{M#ore}, ti prego, riferisci questo mio messaggio alla signorina Niloofar. Ti scriverò un biglietto. Non voglio tornare indietro, ti prego...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050738,
					"content": "Alrani scrive il biglietto in preda ai singhiozzi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "Ecco a te. *singhiozza* ...Ma perché a qualcuno è venuto in mente di inventarsi le tesi? *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050731,
					"content": "Ok... Calmati. Nessuno ha intenzione di portarti via, per ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050732,
					"content": "Signorina Alrani... Al momento sembra davvero instabile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050733,
					"content": "Lasciamola qui e portiamo questo biglietto a Niloofar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050734,
					"content": "Ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "Non c'è da preoccuparsi se finiremo col ferirla. È come ha detto lei: mi ha pagato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050737,
					"content": "E poi... Tsk, finalmente ho trovato qualcuno di erudito. Ci sarebbe molto utile qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050735,
					"content": "I Cacciatori di tesori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "Niloofar ci ha detto del tuo elaborato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050706,
					"content": "Chiedo scusa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				}
			]
		},
