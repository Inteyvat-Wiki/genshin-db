			},
			"dialogs": [
				{
					"id": 731050801,
					"content": "#Viaggiat{F#rice}{M#ore}! Hai trovato Alrani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050802
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050802,
					"content": "Sì, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050823,
					"content": "Racconti a Niloofar cos'è successo e le consegni il biglietto...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050803
					]
				},
				{
					"id": 731050803,
					"content": "Narzam? Ma come...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050804
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050804,
					"content": "La conosci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050805,
					"content": "Non di persona. Ho sentito qualcuno dire che è una strana Cacciatrice di tesori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050806
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050806,
					"content": "Dicono che quando deruba qualcuno, gli pone una domanda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050807
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050807,
					"content": "Letteratura, elementi, ogni genere di argomento. Anche indovinelli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050808
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050808,
					"content": "Se rispondi correttamente, ti restituisce tutto quello che ti ha rubato e ti scorta fino in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050809
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050809,
					"content": "Allora è proprio una tipa strana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050810,
						731050811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050810,
					"content": "Chi è questa... enigmista fuorilegge?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "Nessuno lo sa. Io so queste cose perché il mio mentore una volta la incontrò nelle terre selvagge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050813,
					"content": "La sua domanda fu: \"Cosa riempie velocemente una stanza vuota?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050814,
					"content": "Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050815,
					"content": "Il vento! Paimon ha indovinato? Dev'essere il vento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050816,
					"content": "Uhm... La luce di una candela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "Il mio mentore rispose: \"Gli elementi sono ovunque\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050818,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "Questo è barare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050820,
					"content": "Ahahah. A ogni modo, Narzam scortò il mio mentore in città, dove i due si salutarono quasi amichevolmente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050821,
					"content": "Non mi preoccuperei più di tanto, sapendo che Alrani è con lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050822,
					"content": "Ma non può restare là per sempre. Devo trovare un modo per aiutarla con la sua tesi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050811,
					"content": "Cosa sta tramando esattamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				}
			]
		},
