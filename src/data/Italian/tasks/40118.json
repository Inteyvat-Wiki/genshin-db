			"dialogs": [
				{
					"id": 401181101,
					"content": "Questa è la prima volta che assaggio un tè con questo sapore. Sembra che il tè di Inazuma sia molto diverso da quello che abbiamo a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401181102,
					"content": "Ah, già. Sembra che a Sumeru si usi aggiungere delle spezie nel tè, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401181103,
					"content": "Sì, è così! Ma non riesco ancora ad abituarmici... Se dovessi scegliere, berrei del caffè, anche se talvolta non mi fa dormire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
