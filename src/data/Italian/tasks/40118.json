				"points": []
			},
			"dialogs": [
				{
					"id": 401180901,
					"content": "Da discendente dell'illustre clan Lawrence, durante il mio viaggio ho appreso molte abilità, ad esempio... preparare il pane piatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180902,
					"content": "Bene, la temperatura dovrebbe essere quella giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180903,
					"content": "Non avevo idea che sapessi preparare il pane... Ti credevo il tipo che non mette mai piede in una cucina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180904,
					"content": "Ah, volevo chiederti... Avresti tempo più tardi? Puoi insegnarmi a preparare quei tuoi spuntini deliziosi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180905,
					"content": "Eh? Ma ci potrebbe volere del tempo. Inoltre non siamo qui per conoscerci a vicenda come una famiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180906,
					"content": "Sei nuovamente preoccupata per i nostri legami all'interno della famiglia Lawrence...? Ma sei stata tu a dire che siamo solo gente comune, quindi perché non impariamo l'uno dall'altra come se fossimo cugini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lessig"
				}
			]
		},
		{
			"id": 4011810,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
