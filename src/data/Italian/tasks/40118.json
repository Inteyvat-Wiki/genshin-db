				"points": []
			},
			"dialogs": [
				{
					"id": 401181001,
					"content": "Voglio salire sulla Navetta Flapflap con la signorina Generale! Dai, dai, dai e... WOOSH!!! Ma boh, forse il giro le fa venire le vertigini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181002,
					"content": "Ah, l'hai notato? Molto bene. Ci sei arrivata dopo aver visto le stelline che le ruotavano attorno alla testa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401181003,
					"content": "Mh-mmh, ieri ha detto che c'erano molte stelline dorate che le fluttuavano attorno. Ma oggi sembra che stia molto meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181004,
					"content": "Se la mamma fosse qui, probabilmente direbbe che le stelle sono dei pesci caduti dalle nuvole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
