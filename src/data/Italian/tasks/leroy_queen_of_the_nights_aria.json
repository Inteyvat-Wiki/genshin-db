					"Morticia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "Lasciamo che se ne occupino loro. Non interferirò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "Oh, mia cara Autumn, vuoi davvero farmi questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561103,
					"content": "Tra i bambini del Fleuve Cendre, chi altri è mai stato fortunato quanto te? I dolci che hai mangiato, i vestitini di seta che hai indossato, i romanzi che hai divorato... Tutte queste cose richiedono molto denaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561104,
					"content": "Mentre gli altri hanno dovuto sopportare il freddo e la fame, tu hai potuto indossare vestiti eleganti e mettere collane ai nostri cani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561105,
					"content": "Ho fatto di tutto per donarti una vita simile, e perciò credo di meritarmi qualcosa in cambio. Nessuno, a questo mondo, fa mai niente per niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561106,
					"content": "Io? Crudele nei tuoi confronti? Sono stato più che generoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561107,
					"content": "Autumn, pensaci bene. C'è stata anche solo una parte della tua vita di cui io non mi sia occupato? Ogni volta che hai preso la strada sbagliata e avuto sfortuna, è stato a causa delle tue stesse decisioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561108,
					"content": "Ah, \"signor\" Benoît, sei davvero incredibile nel distorcere le parole fino a ribaltarne la logica. Sostieni la generosità e la gentilezza, mentre invece cerchi solo di perseguire i tuoi fini egoistici. Alla fine si tratta solo di te stesso, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561109,
					"content": "La tua cosiddetta gentilezza era solo per poter sfruttare la situazione a tuo vantaggio. Risparmiami le menzogne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561110,
					"content": "Provo così tanta compassione e pietà nei tuoi confronti che non desidero altro che finirti rapidamente. Ma prima, dimmi, dov'è la mia bambina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561111,
					"content": "Sia nella vecchia casa che in quella in cui vivi ora, non c'è traccia di lei. Dove l'hai mandata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561112,
					"content": "Se te lo dico, mi lascerai andare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561113,
					"content": "No, ma ti concederò una morte meno dolorosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561114,
					"content": "...Se non te lo dico, morirò. Se te lo dico, morirò lo stesso. Eh, se non ci guadagno nulla, perché dovrei renderti le cose facili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561115,
					"content": "*sospira*... Autumn, non sai proprio mentire, eh? Ora non scopriremo mai dov'è andata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561116,
					"content": "Beh, so dove si trova, eheh! Ma non ve lo dirò! Giammai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561117,
					"content": "Non la troverete, mai e poi mai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741561118,
					"content": "Ora basta. Lo riporterò a casa sua, qualcuno ha qualche obiezione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561119,
					"content": "Prego, non ti ostacoleremo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "A-Allora sbrigatevela voi. Non sono affari che ci riguardano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561121,
					"content": "Benoît continua a ripetere: \"Non la troverete mai, mai e poi mai\", mentre Autumn lo porta via in silenzio.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "Non avevo intenzione di far sapere a qualcun altro di tutto questo. Dopotutto, c'è un mandato di arresto per lei. Forse è il caso di dire che anch'io sono oggetto di un simile mandato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561123,
					"content": "Se ora andaste alla Maison de la Garde a fare denuncia, potreste racimolare un bel gruzzoletto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561124,
					"content": "Ma non ve lo consiglio. Se lo farete, i nostri amici non lo dimenticheranno. Provare per credere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561125,
					"content": "Non sporgerò alcuna denuncia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "Ahah, lo sapevo che avresti detto così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561128,
					"content": "In tal caso, questa rosa arcobaleno è per te. Ci piace questo tipo di fiore, perché è carico di significato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561129,
					"content": "In questo momento, rappresenta un avvertimento di non cambiare idea su quello che hai appena detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561130,
					"content": "Arrivederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561131,
					"content": "Quindi... è questo che è successo. Che famiglia complicata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561132,
					"content": "Paimon non sa proprio cosa dire! Meno male che non abbiamo mai segnalato nulla alla Maison de la Garde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561133,
					"content": "Ma Paimon si sente triste per Autumn, non è mai riuscita a trovare sua figlia alla fine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561134,
					"content": "All'inizio Paimon pensava che Benoît fosse una brava persona! Uh... Pensi che Paimon sia facile da abbindolare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561135,
					"content": "Te ne rendi conto soltanto ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "Ehi! Non esagerare! Prendere in giro Paimon in una situazione del genere... Umpf! Paimon non ti perdonerà fino a quando non le offrirai una cena abbondante all'Hotel Débord!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561136,
					"content": "Sei un po' una citrulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "Non ho bisogno di soldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
