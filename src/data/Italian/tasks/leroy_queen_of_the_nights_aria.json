			},
			"dialogs": [
				{
					"id": 741560801,
					"content": "Ciao, papà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560802
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560802,
					"content": "...È finita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560803
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741560803,
					"content": "Quando Autumn mi ha detto che avevi intenzione di fuggire, sono rimasto piuttosto sorpreso. Ti abbiamo tenuto rinchiuso così a lungo, eppure non sei ancora crollato né ti sei arreso del tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560804,
					"content": "#Anzi, hai persino cercato di cogliere l'occasione per incoraggiare {F#queste}{M#questi} due \"{F#paladine}{M#paladini} della giustizia\" ad aiutarti nella fuga. Trovo la tua voglia di vivere piuttosto commovente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560805,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560806,
					"content": "Ma tra tutti i posti in cui saresti potuto andare, alla fine hai scelto quello che tu e Autumn eravate soliti visitare? Davvero uno sciocco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560807
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560807,
					"content": "Io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560808
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741560808,
					"content": "Non c'è bisogno di spiegazioni. Capisco. Quando le persone sono prese dal panico, seguono il percorso che per loro è più familiare, non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560809,
					"content": "Fortunatamente Autumn se n'è andata dopo di te. Non è ancora arrivata, e non mi va di discuterne di fronte a lei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560810
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560810,
					"content": "Quindi cosa pensavi di fare? Non capisco, davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560811
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560811,
					"content": "Con la scusa del matrimonio, l'hai venduta ad altri come se fosse solo una merce. E lo hai fatto due volte. La prima volta l'hai scambiata con una grande casa nella Corte di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560812
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560812,
					"content": "La seconda volta, hai scelto qualcuno a caso per sbarazzarti di lei, in modo che la proprietà e tutto il resto fossero solo tuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560813
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560813,
					"content": "Quando è stata maltrattata e umiliata, ti sei voltato dall'altra parte. Ti ha dato da crescere la figlia nata dal suo secondo matrimonio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560814
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560814,
					"content": "E ti sei sbarazzato anche di sua figlia. Suppongo che tu l'abbia fatto per mettere le mani sui soldi destinati al loro sostentamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560815
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560815,
					"content": "Come fai a invitare i bambini a casa tua per dar loro caramelle ed essere in pace con la coscienza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560816
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560816,
					"content": "La tua coscienza non ti logora neanche un po'? Non provi il minimo senso di colpa, nemmeno per un momento? Lo trovo completamente sconcertante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560817
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560817,
					"content": "A dire il vero, ho incontrato Autumn quando vagava per le strade. È davvero una madre affettuosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560818
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560818,
					"content": "Si prende cura della figlia di una mia amica, Penny. Se sta un giorno senza vederla, la piccola Penny si arrabbia perché vuole rivederla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560819
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560819,
					"content": "E se pensi di avere ancora una possibilità di ribaltare la situazione, ripensaci. Autumn ora ha un sacco di amici, non solo me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560820
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560820,
					"content": "Non importa dove ti nasconderai, ti daremo la caccia fino ai confini di Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560821
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560821,
					"content": "Perché un'anima gentile come lei dev'essere tormentata in questo modo e non avere nulla, mentre un furfante come te conduce una vita di agi? Per me c'è qualcosa che non va.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560822
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560822,
					"content": "Non c'è bisogno di fare discorsi filosofici, non ne vale la pena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560823
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741560823,
					"content": "Ah! Mi hai sentito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560824
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560824,
					"content": "Oh, quindi tu sei Autumn! Finalmente Paimon inizia a capire cosa succede. La famiglia Leroy è davvero complicata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560825,
					"content": "#{NICKNAME}, abbiamo seguito Benoît fino a qui, ma sembra che molte cose siano diverse da come ce le aspettavamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560826,
					"content": "Ora che le cose stanno così, dovremmo ancora farci coinvolgere in tutto questo? Decidi tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
