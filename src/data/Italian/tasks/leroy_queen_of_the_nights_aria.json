			"dialogs": [
				{
					"id": 741560401,
					"content": "Paimon è davvero nervosa! Stando a quello che c'è scritto, non dobbiamo far altro che aspettarlo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560402,
					"content": "Allora aspettiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "Va bene, faremo come dici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560405,
					"content": "#Dopo aver atteso in silenzio e con pazienza, la finestra si apre con uno scricchiolio e appare un volto familiare. Benoît osserva attentamente l'ambiente circostante e, dopo avervi {F#viste entrambe}{M#visti entrambi}, esce con cautela dalla finestra.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Benoît, ma che succede...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560407,
					"content": "#{F#Svelte}{M#Svelti}, presto! Se mi scoprono è finita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741560403,
					"content": "Ho qualche domanda da fargli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
