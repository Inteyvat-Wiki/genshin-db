			"dialogs": [
				{
					"id": 706910101,
					"content": "#Prode {M#Cavaliere Onorario}{F#Cavaliera Onoraria}! Di qua, di qua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910102,
					"content": "Klee si è appena fatta delle nuove amiche! Vuoi venire a giocare con noi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910103,
					"content": "Ci hanno insegnato un gioco nuovo che si chiama Caccianeve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910104,
					"content": "Le regole non sono difficili. È solo una versione molto speciale del nascondino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910105,
					"content": "Oh! Klee, Yaoyao e Sayu, quindi avete già fatto amicizia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910106,
					"content": "A giudicare dal nome, questo gioco sembra una versione migliorata del Cacciavento, giusto? Hihi, Paimon non vede l'ora di giocare con voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910107,
					"content": "Nascondino? Perfetto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "Etciù... Anche se non fa molto freddo all'accampamento, ho ancora un po' di sonno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910110,
					"content": "#Mmh? Ci vedo male io, o voi siete {NICKNAME} e Paimon...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910111,
					"content": "#Ci vedi benissimo. Sono proprio {NICKNAME} e Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910112,
					"content": "Ehilà, Yaoyao e Sayu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "Ottima idea! Se ci muoviamo e ci divertiamo un po', vedrete che non ci appisoleremo così facilmente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910115,
					"content": "E poi Sumire, quella signorina così austera, ha detto che trascorrere più tempo sulle montagne innevate avrebbe giovato alle tue abilità, Sayu. Non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910116,
					"content": "Urgh. Non ci credo, ve lo siete ricordato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910117,
					"content": "Va bene... Ma se perdo contro delle mie pari o persino contro quel super ninken, poltrire sarà molto più difficile, in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910118,
					"content": "Sembra che dovrò proprio rimboccarmi le maniche, in questo viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910119,
					"content": "E non ti preoccupare! Ho ideato una nuova ricetta per il gulasch con peperoncino di Jueyun e pepe macinato, ne ho appena preparato un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910120,
					"content": "Dagli qualche morso prima di iniziare, ti garantisco che non sentirai freddo durante il gioco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910121,
					"content": "Fantastico! Aspetta, allora ne mangio una ciotola intera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910122,
					"content": "Anche Paimon ne vuole un po'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910123,
					"content": "Benissimo. Che la partita a nascondino abbia inizio qui, sulle montagne innevate!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910124,
					"content": "Eheh! L'intera montagna è coperta di neve... È il nascondiglio perfetto per Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910113,
					"content": "Volete giocare a nascondino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "Mi piacerebbe molto conoscere anche le nuove amiche di Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}