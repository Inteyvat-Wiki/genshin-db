			},
			"dialogs": [
				{
					"id": 790490101,
					"content": "Cosa ci fa un diario nascosto in un angolo in questo modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490102
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790490102,
					"content": "A quanto pare l'enorme lastra di pietra all'esterno è quella che Idyia ha dato al pittore come tela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790490103,
					"content": "Uhm, sembra che non solo abbia trovato i paesaggi che amava nel Miraggio di Veluriyam, ma che abbia anche fatto amicizia con i Gocciolotti e trovato nuove ispirazioni per i suoi dipinti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790490104,
					"content": "Un incontro davvero fortunato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "Aaah! Ora che mi ci fai pensare, Paimon ha sentito parlare di alcune persone che impazziscono dopo un fallimento: continuano a provare e riprovare fino a quando non si perdono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790490107,
					"content": "Grazie agli strumenti di pittura di Idyia e alla compagnia dei Gocciolotti non è impazzito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leggi"
				},
				{
					"id": 790490105,
					"content": "Meglio che esercitarsi fino all'ossessione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				}
			]
		},
