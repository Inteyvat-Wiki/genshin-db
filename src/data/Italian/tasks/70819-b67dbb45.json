					"Hannelore"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708190201,
					"content": "Ah... Sei davvero gentile, ma in quanto sorella della Chiesa di Favonius, non posso accettare doni simili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190202,
					"content": "Per me, è sufficiente respirare una traccia di questa fragranza portata dalla brezza marina. Le cose belle appartengono al vento, non a una singola persona. Questa è la via di coloro che camminano nella fede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190203,
					"content": "Ciononostante, la tua gentilezza, calda come la brezza del sud, mi ha raggiunto. Ti prego, accetta questo libro come un piccolo dono in cambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190204,
					"content": "Possa l'Archon di Anemo vegliare su di te. E che la strada davanti a te sia colma, come questa fragranza, di virtù, libertà e compassione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hannelore"
				}
			]
		},
