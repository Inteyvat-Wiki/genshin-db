		},
		{
			"id": 7516502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516502",
							"2"
						],
						"stepId": 7516502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "#Ah, {F#cara}{M#caro} viandante, dato che hai fatto tutta questa strada fino a Teteocan, ne deduco che stai cercando di diventare più forte, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650202,
					"content": "Forse hai già visto qualcuno che la Comunità dell'Abbondanza definirebbe forte. Hah! Delle teste vuote, a parer mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650203,
					"content": "#Tu invece sei piuttosto {F#magra}{M#magro}, però non sei {F#ossessionata}{M#ossessionato} come quei \"palestra-dipendenti\", con i loro sollevamenti e le loro panche piane quotidiani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650204,
					"content": "Dammi retta, è tutta fuffa, la loro. Non farti ingannare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650205,
					"content": "Non ti piace allenarti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "Beh, le cose non sono così semplici. Ma idolatrare l'essere super muscolosi e affermare che la forza di un guerriero derivi dai muscoli? Cavolate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650208,
					"content": "Sappi solo che gli eroi di un tempo non avrebbero mai potuto essere solo muscoli, pelle e ossa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650209,
					"content": "Vivevano in condizioni ben più avverse di quelle in cui viviamo noi oggi, in cui la sopravvivenza e la difesa erano di fondamentale importanza. Per poter affrontare un vero combattimento, dovevano per forza mantenere un bello strato di grasso corporeo per proteggersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650210,
					"content": "Per cui il loro fisico doveva essere grosso modo come il mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650211,
					"content": "E sì, questa corporatura un po' in carne che ho è la stessa che sicuramente avevano gli eroi del passato: un corpo equilibrato in termini di impatto e agilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650212,
					"content": "Purtroppo, la gente di questa tribù non riesce a vedere la verità. Ah, che idioti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650213,
					"content": "#Non sembri {F#convintissima}{M#convintissimo}... Mmm, facciamo così!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650214,
					"content": "Prova la sfida spaccavasi che ho costruito! Ho creato questo posto per allenarmi, ma non ho problemi a fartelo provare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650215,
					"content": "Dopo che l'avrai provato, vedrai quanto aiuta in combattimento avere un fisico forte e poderoso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650206,
					"content": "Detesti i muscoli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
