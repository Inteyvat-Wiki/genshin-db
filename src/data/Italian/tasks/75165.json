			"dialogs": [
				{
					"id": 751650301,
					"content": "Ho bisogno di un attimo per prepararmi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650302
					]
				},
				{
					"id": 751650302,
					"content": "#Nessun problema. Torna quando sei {F#pronta}{M#pronto}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516504",
							"2"
						],
						"stepId": 7516504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "#Ehilà, {F#cara}{M#caro} viandante! Qui, qui! Sì, dico a te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "Aaah, sei pelle e ossa... Ma mangi abbastanza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "È solo che... La mia guida Paimon si è mangiata tutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "Qualunque siano i motivi o i problemi che stai affrontando, la prima regola è sempre: mangia a dovere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "#Visto che siete {F#venute}{M#venuti} fino a Teteocan, probabilmente avete già conosciuto i guerrieri della Comunità dell'Abbondanza, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "Dal profondo del cuore, vi offro un consiglio: non fidatevi di quei palestrati ossessionati dalla forma fisica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "Il grasso con cui l'Archon ci ha benedetto è un dono prezioso. Rinunciare a tutti i cibi deliziosi per perderlo e avere dei muscoli scolpiti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "È l'idea più stupida di sempre. Faresti pena perfino ai cinghiali della foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "E se proprio vogliamo dirla tutta sull'estetica, tutta questa venerazione del culturismo è diventata di moda solo negli ultimi decenni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "Mio nonno mi ha raccontato che ai suoi tempi le persone preferivano corpi più in carne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "Perciò non lasciarti deviare verso il cammino perverso del dimagrimento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "Se però un giorno tu finissi col diventare come i miei parenti della Comunità dell'Abbondanza e decidessi di perdere peso in nome della forza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "Un'altra cosa da ricordare: quando si parla di agilità, anche i guerrieri rotondetti possono essere agili come pesci. Ma se si parla di forza, quei tizi mingherlini non hanno speranza contro di noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "Se ti servono prove, guarda i vasi su questo campo d'allenamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "Nonostante la mia stazza, posso facilmente <color=#00E1FFFF>scattarvi in mezzo senza romperne neanche uno</color>. Scommetto che quei rami secchi non riescono a raggiungere un tale livello di agilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "Ti vedo, stai tentando di non ridere, eh? Bene... Fa' pure, non credermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "Forza, prova! Corri attraverso il campo di allenamento più veloce che puoi, ma fai attenzione <color=#00E1FFFF>a non rompere neanche un vaso</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "Vediamo come te la cavi: prova a battere il mio record.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "Eh? Mi vuoi offrire da mangiare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "Beh, no, non intendevo offrirti da mangiare... Ma se stai proprio morendo di fame, ho della carne grigliata nella borsa. Ma lasciamo perdere per il momento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
