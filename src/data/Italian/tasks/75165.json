					"nextDialogs": [
						751650602
					]
				},
				{
					"id": 751650602,
					"content": "#Nessun problema. Torna quando sei {F#pronta}{M#pronto}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				}
			]
		},
		{
			"id": 7516507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
