			"dialogs": [
				{
					"id": 722460301,
					"content": "Hai già qualche idea su dove andare, Lady Sumida?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460302,
					"content": "Mmm... Ora che ho scoperto che a Mondstadt c'è una biblioteca molto grande...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
