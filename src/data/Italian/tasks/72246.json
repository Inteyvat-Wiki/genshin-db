	"talks": [
		{
			"id": 7224601,
			"completionStepIds": [
				7224602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224602",
							"2"
						],
						"stepId": 7224602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "Che bel braccialetto! Che bel vaso! Tutto a Liyue è così bello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460102,
					"content": "Mm, aspetta, no. Una terminologia così banale non si addice a una scrittrice come me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460103,
					"content": "Forse dovrei acquistare uno di questi gingilli di porcellana sapientemente realizzati e usarli come riferimento per il mio prossimo romanzo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460104,
					"content": "Mmm, sì! Ecco cosa posso scrivere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460105,
					"content": "\"La chiave che avrebbe determinato la svolta era una Visione nascosta nel vaso!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460106,
					"content": "Sì, potrebbe essere un'idea molto interessante! Cosa ne pensi, Kama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460107,
					"content": "Signorina Sumida, io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460109,
					"content": "Io penso che la descrizione di questo vaso dovrebbe essere equilibrata. Se la descrizione risulta molto lunga, diventerà evidente che è un presagio. Ma allo stesso tempo, con una descrizione breve, sembrerà che la trama si sia evoluta in modo troppo improvviso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460110,
					"content": "Mmm, non hai tutti i torti! Aspetta, ora me lo appunto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460111,
					"content": "Anzi, no, facciamolo altrove.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460112,
					"content": "E poi, non ti ho già detto mille volte di non chiamarmi signora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460113,
					"content": "Ma, a pensarci bene, in una coppia di viaggiatori all'apparenza ordinari è piuttosto comune che l'uno si rivolga all'altro con cortesia, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "Fiuuu... Che bella sensazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460202,
					"content": "O forse sarebbe meglio scrivere: \"è così che dovrebbe essere la più grande biblioteca del Nord\"? E pensare che avrei potuto terminare la collana di Malinconia di Vera tutto d'un fiato! Ah, è stato fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460203,
					"content": "Lady Sumida, sarebbe meglio abbassare la voce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460204,
					"content": "Ah, giusto. Scusami. Colpa dell'emozione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460205,
					"content": "No, temo che tu possa essere ferita. Quella bibliotecaria emana un'aura molto forte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460206,
					"content": "Eh? Davvero? Pensavo fosse una comune strega, solo un po' pigra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460207,
					"content": "Mmm, ora che ci penso, questi personaggi sono di solito quelli più difficili. Beh, meglio non farla arrabbiare, allora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460208,
					"content": "In effetti, potrei scrivere una storia basandomi proprio su un personaggio del genere, vero? Qualcosa come: la maga della grande biblioteca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460209,
					"content": "Come procedono i tuoi viaggi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "Ah, ne è passato del tempo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460211,
					"content": "#Oh-oh! Guarda un po' chi si vede, {F#la}{M#il} leggendari{F#a}{M#o} {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460212,
					"content": "Mmm, sai, prima viaggiavo molto: ero sempre alla ricerca di nuovi spunti per i miei romanzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460213,
					"content": "Sono stata alla Valle di Musoujin per imparare come descrivere le tempeste, alla Testa del Serpente per apprendere come descrivere un demone serpente, ho perfino fatto entrare Kama nell'esercito per saperne di più sulla vita dei fuggitivi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460214,
					"content": "Cavolo, non è facile essere Kama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "Non ho fatto nulla di che.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460216,
					"content": "Questo, invece, è un vero e proprio viaggio. Un viaggio senza nessun obiettivo preciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460217,
					"content": "Solo ora scopro che in questo mondo esistono tante cose interessanti su cui vale la pena scrivere, proprio come ne I viaggi di Kino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460218,
					"content": "Io e Kama abbiamo visitato i luoghi e i negozi più famosi di queste parti, poi ci siamo accampati nella natura, raccontandoci storie con viaggiatori sconosciuti davanti al fuoco...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460219,
					"content": "E quando ci siamo svegliati, abbiamo scoperto che le nostre cose erano scomparse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460220,
					"content": "Aspetta, alla fine è andato tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "Sì. Onestamente, quando abbiamo scoperto che i ladri erano dieci o anche più, pensavo che non saremmo riusciti a recuperare le nostre cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460222,
					"content": "Ma non so come, Kama è riuscito a convincerli a restituircele. Gli hanno anche dato delle monete con sopra l'emblema del corvo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460223,
					"content": "Peccato... Ho pensato che sarebbe stata una storia interessante, ma Kama non ha voluto dirmi come sono andate le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460224,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "Ho solo fatto quello che dovevo. Non preoccuparti, Lady Sumida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460227,
					"content": "Sei insostituibile, Kama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460228,
					"content": "Con te al mio fianco, so che andrà tutto bene, anche se le nostre avventure dovessero portarci ai confini del mondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460229,
					"content": "A proposito, sei cambiato molto, dopo l'incidente dell'Isola di Tsurumi. Se ci sono cose che vorresti fare, od opinioni e dubbi che vorresti esternare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460230,
					"content": "Beh, se credi sia opportuno, signorina Sumida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460231,
					"content": "Certo! Per me, ogni tua opinione è importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460232,
					"content": "Bene, vi lascio da soli, allora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#Certo. Ci vediamo, {NICKNAME}. Incontriamoci alla fine di tutto, proprio come in Fiori per la principessa Fischl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460235,
					"content": "#Ci vediamo, {NICKNAME}. Abbi cura di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460233,
					"content": "Chissà, magari ci incontreremo di nuovo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "Sei un brav'uomo, Kama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
		{
			"id": 7224603,
			"completionStepIds": [],
