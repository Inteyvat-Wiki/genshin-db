				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460401,
					"content": "Il mondo è vasto e infinito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460402
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460402,
					"content": "È una citazione di Joururi Kidoutai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460403
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460403,
					"content": "Esattamente. Hai una memoria di ferro, Kama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460404
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460404,
					"content": "Me la raccontasti tu quella storia, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				}
			]
		}
