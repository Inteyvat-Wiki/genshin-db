			"dialogs": [
				{
					"id": 741411101,
					"content": "#Ehi, sei già {F#tornata}{M#tornato}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411102,
					"content": "Quanto tempo è passato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411103
					]
				},
				{
					"id": 741411103,
					"content": "Mmh, un battito di ciglia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411104,
					"content": "Se per te è durato solo un battito di ciglia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411105
					]
				},
				{
					"id": 741411105,
					"content": "Cosa c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411106,
					"content": "Niente, ma direi che lì dentro è molto pericoloso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411107
					]
				},
				{
					"id": 741411107,
					"content": "Ah, sì...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411108,
					"content": "Comunque, dov'è Canotila? Non è andata alla Corte di Fontaine per diventare una guardia, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411109,
					"content": "...Mi gira un po' la testa. Torniamo un'altra volta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411110
					]
				},
				{
					"id": 741411110,
					"content": "Oh, va bene. Cerchiamo qualcosa da mangiare? Paimon era così preoccupata per te che ora sta morendo di fame!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741411111,
					"content": "Ma non era stato solo un battito di ciglia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411112
					]
				},
				{
					"id": 741411112,
					"content": "Beh, preoccuparsi per te toglie tantissime energie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
