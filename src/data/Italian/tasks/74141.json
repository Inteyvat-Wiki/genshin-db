					{
						"sceneId": 3,
						"position": [
							2385.29,
							-252.747,
							4843.136
						],
						"pointId": 6835
					}
				]
			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "Davvero? Allora sarà tutto più semplice. Come ti chiami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411002,
					"content": "Caterpillar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#Non pensavo di vederti qui, {NICKNAME}. Ma dov'è Paimon? Non la vedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411004,
					"content": "Un attimo: non sei un mostro che ha preso le sembianze di qualcuno che conosco per ingannarmi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411005,
					"content": "Ci siamo visti non molto tempo fa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "...Davvero? Mi sembra passata un'eternità dal nostro addio. Ma forse è colpa della mia età, e la mia memoria peggiora ogni anno di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411007,
					"content": "...Davvero non sei un mostro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411008,
					"content": "Ricordi ancora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "Il giardino del gigante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "Sì, ricordo. Sei davvero tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411012,
					"content": "Scusa, qui ho visto troppe cose incredibili... e troppe battaglie impossibili da vincere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411013,
					"content": "Ma le cose sono cambiate, finalmente. Sono sorti raggi di luce e sono sbocciati i girasoli. Nemmeno l'universo immaginato dalle persone dell'antichità è immune ai cambiamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411014,
					"content": "Forse le cose miglioreranno. Forse finalmente capirò e riuscirò a lasciarmi tutto alle spalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411015,
					"content": "Caterpillar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "Vieni con me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "Ahah, sei davvero tu, immagino. Ora ricordo... Ti conoscevo, e sei sempre uguale. Ficchi sempre il naso negli affari degli altri, perché sei gentile e leale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411018,
					"content": "Ma non devi preoccuparti per me. Non mi serve aiuto... Sai di cosa sono capace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411019,
					"content": "Inoltre... forse conosco questo luogo meglio di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411020,
					"content": "#Hilichurl, di' {M#al ragazzo}{F#alla ragazza} di andarsene subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "C'è qualcosa che devi dirmi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "...Capisci ciò che dico? Interessante. Dimmi una cosa... Come mi vedono i tuoi occhi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "Come un cane.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "Mmh. Forse c'è ancora speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "Va' via da questo luogo, giovane. Per il tuo bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#Sono d'accordo, {NICKNAME}. Tu appartieni a un mondo più splendente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741411027,
					"content": "Ho una domanda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "No. Addio, e non tornare mai più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "L'apprendista e il pesciolino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
