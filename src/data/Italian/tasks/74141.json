					}
				]
			},
			"dialogs": [
				{
					"id": 741410101,
					"content": "(Il contenuto delle pagine consta di simboli, lettere, lingue arcaiche e figure geometriche incomprensibili. Ma concentrarsi un po' rende il loro significato sempre più chiaro.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410102
					],
					"speakerTitle": "Leggi"
				},
				{
					"id": 741410102,
					"content": "Pare che Canotila non sia qui. Forse è di nuovo in quel luogo misterioso! Magari dovremmo dare inizio alla meditazione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410103,
					"content": "Ciò che ha detto la volta scorsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410104
					]
				},
				{
					"id": 741410104,
					"content": "Mi preoccupa un po'. Vado a dare un'occhiata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410105
					]
				},
				{
					"id": 741410105,
					"content": "Beh... È abbastanza sconcertante, ma andiamoci insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410106,
					"content": "Paimon, perché non mi aspetti qui fuori?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410107
					]
				},
				{
					"id": 741410107,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410108,
					"content": "Il mondo nel Libro della rivelazione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410109,
						741410110
					]
				},
				{
					"id": 741410109,
					"content": "Potrebbe essere più pericoloso del previsto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				},
				{
					"id": 741410111,
					"content": "E non voglio che tu corra rischi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410112
					]
				},
				{
					"id": 741410112,
					"content": "#Ma... finora siamo sempre {F#state}{M#stati} un duo! Insieme possiamo superare qualsiasi difficoltà e sconfiggere qualsiasi nemico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410113,
					"content": "La forza bruta potrebbe non bastare a fronteggiare i pericoli là dentro.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410114
					]
				},
				{
					"id": 741410114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410115,
					"content": "#Beh, se proprio insisti! Tra {F#le}{M#i} due sei tu {F#quella}{M#quello} più intelligente, e Paimon si fida di te. Ma non abbandonare Paimon! Paimon rimarrà qui ad aspettarti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410110,
					"content": "Forse c'è qualcosa che ancora non sappiamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				}
			]
		},
