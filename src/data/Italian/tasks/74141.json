					"id": 741410804,
					"content": "Sei tu... mi ricordo di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410805
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410805,
					"content": "Che ci fai qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410806
					]
				},
				{
					"id": 741410806,
					"content": "Stavo per chiederti la stessa cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410807
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410807,
					"content": "Niente, è solo che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410808
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410808,
					"content": "#Tu sei {NICKNAME}, no? E... dov'è quella cosina bianca che è sempre al tuo fianco? Non ricordo come si chiama. Perché non è qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410809,
						741410811
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410809,
					"content": "Paimon mi sta aspettando fuori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410810
					]
				},
				{
					"id": 741410810,
					"content": "È così che si chiama? Comunque, non importa. Tu sei una bella persona, e anche Paimon lo è.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410812
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410812,
					"content": "Sono venuto a cercare una cosa importante. Sai di cosa si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410813
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410813,
					"content": "Mmh, lascia stare, come non detto. Comunque, che ci fai qui? È un luogo molto pericoloso... Dovresti andartene subito. Una volta sono venute delle persone interessate alla prova, ma si sono smarrite e le loro menti sono finite in poltiglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410814
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410814,
					"content": "Oh, ora ricordo. Noi due... abbiamo fatto qualcosa di incredibile insieme. L'unica cosa della mia vita per cui provo orgoglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410815
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410815,
					"content": "Vuoi dire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410816,
						741410818
					]
				},
				{
					"id": 741410816,
					"content": "Sconfiggere Narzissenkreuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410817
					]
				},
				{
					"id": 741410817,
					"content": "Cosa gli è successo? Fai parte dell'Ordo Narzissenkreuz? Oppure... sei dalla parte di Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410820,
					"content": "Ah, la farfalla dorata, splendente come il sole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410821
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410821,
					"content": "Quando hai una luce del genere, tutto... Tutto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410818,
					"content": "Salvare Lanoire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410819
					]
				},
				{
					"id": 741410819,
					"content": "Ora mi ricordo. Sì, fuggimmo dalla prigione sotto il mare con lei... Che bella cosa. Quello non era un luogo adatto a una bambina. Lei dovrebbe vivere sotto il sole e in mezzo ai fiori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 741410811,
					"content": "Tutto bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410812
					]
				}
			]
		},
		{
			"id": 7414110,
			"completionStepIds": [
				7414110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
