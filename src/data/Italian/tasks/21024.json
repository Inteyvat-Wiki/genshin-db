			"dialogs": [
				{
					"id": 210240901,
					"content": "Hai trovato le fatture?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240902,
					"content": "Eccole qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "Grazie infinite, davvero! Meraviglioso, sono contento che sia filato tutto liscio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240904,
					"content": "Non riesco a immaginare quanto si sarebbe arrabbiato il mio capo se le fatture fossero andate perse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240905,
					"content": "Mi vuoi chiedere per che genere di affari siano, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240906,
					"content": "Mi dispiace, non posso dirtelo. È un segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240907,
					"content": "Beh, eccoti la ricompensa... Aspetta un momento, perché la scatola è stata aperta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240908,
					"content": "...Hai incontrato qualcuno che ci ha sbirciato dentro dopo averla trovata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240909,
					"content": "Oh, sono morto. Morto! C-Così non va bene. Devo dirlo subito al capo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240910,
					"content": "Oh, non preoccuparti, non sospetto di te. Cioè, ho studiato molto bene il tuo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240911,
					"content": "Ehm. Devo trovare un modo per contattare il mio capo. Continua pure con ciò che stavi facendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Landa"
				}
			]
		},
