			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "Questo non sembra utile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240602,
					"content": "Scusa, per caso hai visto una scatola?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "Una scatola? Beh, sì, a dire il vero ne ho trovata una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240604,
					"content": "Ci ho sbirciato dentro e c'erano un bel po' di fatture. A quanto pare, qualcuno stava facendo un bell'affare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240605,
					"content": "Oh, cielo, chissà quanto pagherebbe il proprietario di questa scatola per riaverla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240606,
					"content": "...Cosa vuoi dire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "Ehi, non agitarti. Ti stavo prendendo in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240608,
					"content": "Le merci menzionate su quelle fatture sono di grande valore. Mi chiedo chi sia il pezzo grosso di Liyue che ha autorizzato la compravendita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240609,
					"content": "So come va il mondo, e non ho intenzione di svegliare il can che dorme solo perché posso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240610,
					"content": "Tuttavia, sarebbe assurdo dartela gratuitamente dopo tutta la fatica che ho fatto per proteggerla, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240611,
					"content": "Che ne dici di fare uno scambio? È il modo più antico per risolvere questioni del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240612,
					"content": "Portami 3 Giade nottilucose e ti darò le fatture. Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240613,
					"content": "Cioè, probabilmente 3 Giade nottilucose non valgono niente rispetto alle merci menzionate in quelle fatture.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240614,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "Bene, allora muoviti. Quando tornerai, faremo lo scambio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240616,
					"content": "Comunque, cosa c'è scritto sopra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "Oh, non lo sai? Quindi sei qui per conto di qualcun altro. Va bene, non importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240619,
					"content": "Ti do un consiglio: è meglio se non fai troppe domande riguardo a compravendite di questa portata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240620,
					"content": "Bene. Allora vai a prendermi quelle Giade nottilucose e ti darò le fatture, così potrai consegnarle a chi ti ha chiesto aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240621,
					"content": "Tutto fatto, nessun problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
