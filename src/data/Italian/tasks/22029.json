			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "Devo! Devo..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290102,
					"content": "Eh? E tu chi sei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290103,
					"content": "Ho accettato il tuo incarico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "Oh, intendi la mia richiesta per un compagno di addestramento. Sì, l'ho pubblicata io. Voglio trovare qualcuno che mi faccia da compagno nell'addestramento delle arti marziali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290105,
					"content": "Quindi, sei tu la persona che l'ha accettato? Non credo di averti mai visto in città prima d'ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290106,
					"content": "Scusa, non voglio mettere in dubbio la tua forza, ma non so come potrebbero essere le tue abilità nelle arti marziali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290107,
					"content": "Ho sconfitto draghi giganti prima d'ora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "Ahahah... Ah sì? In realtà sono più curioso di dove tu abbia trovato una di quelle. Ne ho sentito parlare prima d'ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290112,
					"content": "Oh, non preoccuparti, sono molto abile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "Ahah, le parole non provano niente. Mettiamole alla prova con le nostre mani, piuttosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290114,
					"content": "Molto volentieri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "Un attimo, perché hai pubblicato quell'incarico in modo anonimo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "Beh, è per via di una cosa di cui... non sono orgoglioso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290117,
					"content": "Ehm, visto che hai già accettato, ti dirò la verità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290118,
					"content": "Tempo fa, sono andato in missione con alcuni doushin. Mentre facevamo ritorno, abbiamo incontrato un gruppo di Kairagi che si stavano preparando ad assaltare una carovana mercantile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290119,
					"content": "Siamo corsi a salvare la carovana. Inizialmente, abbiamo avuto la meglio, e si sono ritirati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290120,
					"content": "Ma, quando stavamo per riprendere fiato, un altro gruppo di Kairagi è comparso dal nulla e sembrava che avesse un capo al loro comando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290121,
					"content": "Prima che io e i miei colleghi potessimo reagire, ci avevano già sopraffatto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290122,
					"content": "Ormai avevamo perso il nostro vantaggio, e potevamo solo cercare di allontanare i Kairagi mentre scortavamo i mercanti in città.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290123,
					"content": "E, mentre combattevo contro il leader dei Kairagi... si è impossessato della mia arma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290124,
					"content": "Quel tipo si è tenuto la mia arma dopo averla presa, prendendosi gioco di me nel frattempo. È stato così umiliante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290125,
					"content": "Cos'è successo a quel gruppo di mercanti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "Ci siamo imbattuti in altri doushin durante la nostra ritirata, e così quei Kairagi si sono a loro volta ritirati dopo averli visti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290127,
					"content": "Anche i mercanti sono stati scortati fino in città da noi. Ma le loro merci sono tutte... *sospira* È tutta colpa della mia mancanza di abilità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290128,
					"content": "Dopo il mio ritorno, ho preso un'altra arma. Ma non sono ancora riuscito a superare quanto è successo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290129,
					"content": "Perciò, ho pubblicato quell'incarico nella speranza di affinare le mie abilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290130,
					"content": "Quando sarò forte abbastanza, sconfiggerò i Kairagi io stesso e mi riprenderò la mia arma e il mio onore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290109,
					"content": "Ho visto coi miei occhi la caduta di un dio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "Eh, di che parli? Intendi dire che hai preso parte al Rito della discensione a Liyue, prima d'ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290111,
					"content": "Ahahah, in base alla tua logica, molte persone a Liyue hanno \"visto coi loro occhi la caduta di un dio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2202902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
