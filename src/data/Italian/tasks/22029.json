			"dialogs": [
				{
					"id": 220290201,
					"content": "Per caso stavi trattenendo la tua forza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290202,
					"content": "Non preoccuparti del mio orgoglio, ti prego, non trattenerti... Devo diventare più forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2202903,
