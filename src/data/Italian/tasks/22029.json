				"points": []
			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "*ansima* Sei... davvero formidabile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290302,
					"content": "Ho... imparato molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290303,
					"content": "Stai bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "Non... importa. Devo solo prendere fiato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290306,
					"content": "Ma sei così potente che ci avrei creduto anche se mi avessi detto che hai sconfitto un drago gigante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290307,
					"content": "In realtà, ne ho sconfitto vari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Ahahah... Ti credo, ovviamente. Grazie per aver impiegato del tempo ad allenarti con me. Ricorderò quello che ho imparato da questo incontro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290309,
					"content": "#Se non ti dispiace, ti prego, vieni ad allenarti con me spesso, d'ora in poi. Avendo {F#una}{M#un} guerrier{F#a}{M#o} forte come te come compagn{F#a}{M#o}... sono certo che compirò presto la mia impresa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290310,
					"content": "\"La tua impresa\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "Ehm... è solo un piccolo desiderio che ho in mente. Grazie del tuo aiuto. Ti prego di accettare questa ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290312,
					"content": "Ora devo tornare indietro e fare una pausa. Le tue sono mosse alquanto forti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290304,
					"content": "Scusa, non ho controllato la mia forza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
