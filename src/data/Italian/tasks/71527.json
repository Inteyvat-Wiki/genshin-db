			},
			"dialogs": [
				{
					"id": 716664101,
					"content": "L'Onikabuto di Yanfei è così forte! Cosa caspita gli avrà dato da mangiare Madame Ping?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664102,
					"content": "Visto? L'Onikabuto della tua salvatrice è una forza della natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716664103,
					"content": "Ma proprio come l'altra volta, quando i miei subordinati ti hanno colto di sorpresa, neanche la lama più potente può annientare il proprio nemico se non nelle mani di un Maestro della spada esperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716664104,
					"content": "#P-P-Parole sagge, Granmaestro... Oook... Per fortuna {F#la mia}{M#il mio} compadre ha mantenuto la calma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664105,
					"content": "Wow, grandioso! Potrei davvero appassionarmi a queste lotte tra scarabei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "Concorrente con attrezzatura Super OP"
				},
				{
					"id": 716664106,
					"content": "È così divertente! Grazie a tutti! Continuerò a giocare ancora un po'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Concorrente con attrezzatura Super OP"
				}
			]
		},
