					}
				]
			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "Ehilà! Eccomi di ritorno! Allora? Come va con il \"Campo di addestramento Arataki per le sfolgoranti lotte tra scarabei corazzati\"...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "Concorrente con attrezzatura Super OP"
				},
				{
					"id": 716664002,
					"content": "Che tempismo perfetto, Yanfei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664003,
					"content": "La mia salvatrice! Grazie per avermi aiutato con l'autorizzazione! E per il fantastico lavoro artistico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664004,
					"content": "Un momento, conosco quello sguardo... Vuoi, ehm, combattere anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664005,
					"content": "Eh? E cosa ci sarebbe di male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "Concorrente con attrezzatura Super OP"
				},
				{
					"id": 716664006,
					"content": "Ho una grossa cliente con un giro d'affari internazionale... A ogni modo, ogni volta che l'ho aiutata a vincere una causa importante mi ha sommersa di regali, tra cui un Onikabuto molto speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "Concorrente con attrezzatura Super OP"
				},
				{
					"id": 716664007,
					"content": "A quel tempo non sapevo come prendermene cura, quindi ho chiesto alla nonna di occuparsene per un po'. Ultimamente ha preso parecchio peso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "Concorrente con attrezzatura Super OP"
				},
				{
					"id": 716664008,
					"content": "Posso partecipare? Non sarai preoccupato che intralci il tuo stile, vero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "Concorrente con attrezzatura Super OP"
				},
				{
					"id": 716664009,
					"content": "Non dovremmo dire di no alla tua salvatrice, Re oni. Ciò che le manca in esperienza è compensato da uno degli Onikabuto più resistenti e spettacolari che abbia mai visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "Granmaestro Hanakado"
				},
				{
					"id": 716664010,
					"content": "La tua è un'offerta che non posso rifiutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664011,
					"content": "#Bene, è giunto il momento di schierare Braccio destro del Re oni con Bastone cremisi. So che {F#la mia}{M#il mio} compadre manterrà il sangue freddo sotto pressione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664012,
					"content": "Puoi scommetterci!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#Quindi sono io contro {NICKNAME}? Bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "Concorrente con attrezzatura Super OP"
				},
				{
					"id": 716664015,
					"content": "Non sono ancora pratica in questo gioco, quindi chiedo scusa in anticipo per eventuali svarioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Concorrente con attrezzatura Super OP"
				},
				{
					"id": 716664013,
					"content": "Grazie per la fiducia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
