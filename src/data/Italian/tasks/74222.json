	"talks": [
		{
			"id": 7422201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422201",
							"2"
						],
						"stepId": 7422201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "#Mai abbassare la guardia, {F#cittadina}{M#cittadino}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220102,
					"content": "Cosa stai facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "Io? Cosa ti sembra che stia facendo? Faccio fronte alla minaccia barbara! I loro attacchi incombono, potrebbero anche aver mandato delle spie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220104,
					"content": "Non è una faccenda da poco! È necessario rimanere all'erta finché non arrivano i rinforzi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220105,
					"content": "#Per qualsiasi altro problema, puoi parlare con il mio assistente, {F#cittadina}{M#cittadino}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220106,
					"content": "Un bambino tutto solo qua fuori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "Eh? Un bambino? E da dove è spuntato fuori? Qualche legionario deve aver contravvenuto agli ordini portando con sé la famiglia... di nuovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220108,
					"content": "*sospira* Il Dominus Cassiodor è fin troppo indulgente con questi pivelli. Se fosse successa una cosa simile trent'anni fa, un altro Tribunus avrebbe già impugnato la frusta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220109,
					"content": "È successo niente di sospetto ultimamente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "Al momento, no. Detto ciò, i barbari sono alla stregua di scaltre bestie. Colpiscono quando meno te l'aspetti, perché il fattore sorpresa è l'arma più letale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220111,
					"content": "Con metodi ripugnanti si infiltrano nelle nostre città alla ricerca dei nostri segreti. La minima disattenzione può portare alla catastrofe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220112,
					"content": "*sospira* Trent'anni fa, quando seguii il Dominus Boethius nella conquista del remoto Nord, non erano che un branco di primitivi, incapaci anche solo di escogitare sotterfugi. Dove avranno mai imparato stratagemmi del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220113,
					"content": "Trent'anni fa... I tuoi genitori non erano neanche nati...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "#Eh? Cos'hai detto, {F#cittadina}{M#cittadino}? Il mio udito non è più quello di una volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220115,
					"content": "*sospira* Il tempo è davvero crudele. Durante la conquista di Bituria riuscivo a sentire le campane dei loro raduni da miglia di distanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220116,
					"content": "Arrivederci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "#Stammi bene, {F#cittadina}{M#cittadino}! Vieni pure a fare rapporto quando più ti aggrada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
							"2"
						],
						"stepId": 7422202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "*sospira* Chissà quando finirà questa guerra...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220202,
					"content": "Che ci fai lassù sul tetto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "#Eh? Osservo l'area in cerca di attività sospette da parte dei barbari, ovviamente! Di recente... Un momento, come hai fatto a salire sulla torre di guardia, {F#cittadina}{M#cittadino} ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220204,
					"content": "Volevo chiederti la stessa cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "*sospira* Non importa ora. Il Tribunus Mettius dice che l'attacco dei selvaggi incombe. Stando agli ultimi bollettini, potrebbero aver inviato delle spie fra di noi. Non abbassiamo la guardia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220206,
					"content": "Ma davvero a quei bruti interessa tanto la nostra cittadina sperduta? Manderebbero davvero delle spie qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220207,
					"content": "Anche il più piccolo dei pesci è nutrimento per una balena.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "#Ah, hai proprio ragione, {F#cittadina}{M#cittadino}! Ognuno deve attenersi ai propri doveri. Mmm... Hai forse esperienza in faccende del genere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220209,
					"content": "In tal caso, posso chiederti di sorvegliare l'area circostante? Se i barbari si sono addentrati fin qua, avranno sicuramente lasciato dietro di sé un qualche indizio compromettente. Magari una spada di legno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220210,
					"content": "Eh, come i bambini che giocano alla guerra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "Beh, si tratta pur sempre di selvaggi. Sarebbe così strano se usassero rami e bastoni come armi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220212,
					"content": "#In ogni caso, conto su di te. Se scopri qualcosa, qualsiasi cosa, fanne rapporto a me, adempi al tuo dovere da {F#buona remuriana}{M#buon remuriano}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422207,
