			"dialogs": [
				{
					"id": 706890114,
					"content": "<color=#FFCC33FF>Ci sono novità?</color>",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890101
					]
				},
				{
					"id": 706890101,
					"content": "#Ah, {NICKNAME}, sei {F#arrivata}{M#arrivato} al momento giusto, ho qualcosa per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890102,
						706890103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890102,
					"content": "È una lettera d'aiuto, oppure un indizio per un tesoro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890104
					]
				},
				{
					"id": 706890104,
					"content": "...So che hai molta dimestichezza col tipo di lavoro che facciamo, ma questo incarico non ha niente a che fare con questi tipi di missioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890105,
					"content": "Ecco, questo nuovo taccuino della Gilda degli avventurieri è per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890106,
						706890107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890106,
					"content": "Ma ho già il Manuale dell'avventuriere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890108
					]
				},
				{
					"id": 706890108,
					"content": "Il Manuale dell'avventuriere serve a tenere traccia delle missioni che completi e delle informazioni sui mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890109,
					"content": "Questo taccuino, invece, è per annotare le persone fantastiche e gli eventi speciali che incontrerai nei tuoi viaggi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890110,
						706890111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890110,
					"content": "Oh...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890112
					]
				},
				{
					"id": 706890112,
					"content": "Spero ti sarà d'aiuto. Comunque, per stavolta non c'è altro. Il mio \"incarico\" è terminato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890113,
					"content": "#Fai buon viaggio, {NICKNAME}. Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706890111,
					"content": "In effetti, può essere utile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890112
					]
				},
				{
					"id": 706890107,
					"content": "Perché vuoi darmene un altro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890108
					]
				},
				{
