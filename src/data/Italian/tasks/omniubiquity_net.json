	"talks": [
		{
			"id": 7267201,
			"completionStepIds": [
				7267201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7267201",
							"2"
						],
						"stepId": 7267201,
