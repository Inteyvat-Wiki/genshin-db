			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "...Quei Cacciatori di tesori... Oh, mi dispiace! C'è qualche problema?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190302,
					"content": "Dei Cacciatori di tesori si aggirano intorno a Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "Cacciatori di tesori? Anche noi siamo sulle loro tracce. Come osano quei ladri avvicinarsi tanto a Mondstadt. Senza contare che non sappiamo affatto quali siano le loro intenzioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190304,
					"content": "Quale che sia il motivo, di sicuro non è niente di buono. Abbiamo reindirizzato molti uomini per occuparcene, quindi temo di non averne abbastanza per la tua segnalazione in questo momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190305,
					"content": "Comunque ne prendo nota. Quando avremo finito con quei Cacciatori di tesori, me ne occuperò. Ti ringrazio per la segnalazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
