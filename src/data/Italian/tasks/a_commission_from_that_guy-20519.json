			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190201,
					"content": "Già di ritorno? Che efficienza! Ora capisco perché piaci così tanto a quel gentiluomo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190202,
						205190204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190202,
					"content": "Dammi i soldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190203
					]
				},
				{
					"id": 205190203,
					"content": "Che freddezza. La ricompensa è proprio qui. Ma ti prego, pensa anche ai sentimenti della tua amica messaggera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190204,
					"content": "È un onore.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190205
					]
				},
				{
					"id": 205190205,
					"content": "Oh, no! L'onore è tutto mio. Accetta questa ricompensa... È un piacere fare affari con te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
