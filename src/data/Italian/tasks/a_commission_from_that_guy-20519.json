			"dialogs": [
				{
					"id": 205190501,
					"content": "C-Cosa posso fare per te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190502
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190502,
					"content": "Sto ancora aspettando che sorella Victoria mi dia una risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190503
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190503,
					"content": "Questo incidente... Sono pronta ad affrontare le conseguenze, qualunque esse siano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
