			"dialogs": [
				{
					"id": 402130101,
					"content": "È tutta colpa mia, Kapitan. Un estraneo che si appropria dell'Istituto di Progettazione... Non credevo che potesse verificarsi una simile negligenza. Farò di tutto per venire a capo della questione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130102
					],
					"speakerTitle": "Praporshchik"
				},
				{
					"id": 402130102,
					"content": "Non serve. Prendi i tuoi uomini e riprendi il controllo della struttura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130103
					],
					"speakerTitle": "Kapitan-Poruchik"
				},
				{
					"id": 402130103,
					"content": "Niente indagini, quindi? Sono ordini dall'alto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130104
					],
					"speakerTitle": "Praporshchik"
				},
				{
					"id": 402130104,
					"content": "Niente indagini. Sono stato chiaro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130105
					],
					"speakerTitle": "Kapitan-Poruchik"
				},
				{
					"id": 402130105,
					"content": "Signorsì, Kapitan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130106
					],
					"speakerTitle": "Praporshchik"
				},
				{
					"id": 402130106,
					"content": "Mh? E voi che ci fate qui? Questa struttura appartiene all'Istituto di Progettazione sperimentale del Kuuvahki. Non sono ammessi estranei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kapitan-Poruchik"
				}
			]
