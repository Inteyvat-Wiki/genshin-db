			"dialogs": [
				{
					"id": 733560101,
					"content": "È davvero assurdo. Non avrei mai immaginato di ritrovarmi qui a bere del tè in tua compagnia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560102
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560102,
					"content": "Ti pare così strano? Volevo solo ringraziarti per l'unità di elaborazione centrale che hai fornito per la matrice numerologica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560103
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560103,
					"content": "E perché continui a parlare come se sapessi tutto di noi? Dai quasi l'impressione di conoscerci a fondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560104
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560104,
					"content": "Te l'ho detto, sono bravo a capire il carattere delle persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560105
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560105,
					"content": "Anche se... Ahah, hai ragione. Devo smetterla di supporre di riuscire a capirvi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560106,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560107
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560107,
					"content": "Anche rispetto al nostro ultimo incontro, ho la sensazione che tu sia cambiata molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560108,
					"content": "Umpf! Non importa quanto indietro tu voglia \"confrontare\", ma gli unici cambiamenti che ho subito sono stati accettare gli errori nel mio nucleo e aprire gli occhi su alcune cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560109
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560109,
					"content": "E tu? In quanto collega \"marionetta\", hai mai sperimentato errori di calcolo nel tuo cuore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560110,
					"content": "Hah... Ho sperimentato ben più che dei semplici errori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560111
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560111,
					"content": "Vai avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560112
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560112,
					"content": "Non ci conosciamo ancora abbastanza per questo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560113,
					"content": "Mah, come preferisci. Chiedevo solo per cortesia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560114
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560114,
					"content": "A ogni modo, una marionetta deve affrontare molte deviazioni prima di trovare il proprio cuore. Almeno, per me è stato così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560115
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560115,
					"content": "Sembra che tu abbia avuto un buon rapporto col tuo creatore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560116
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560116,
					"content": "Sì. Mi ha aiutato e insegnato molto, sia quand'era vivo... che dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560117
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560117,
					"content": "Sotto questo aspetto, c'è una differenza fondamentale tra noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560118
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560118,
					"content": "...Ah. Dici sul serio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560119
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560119,
					"content": "Mi spiace. Anche se in quanto marionette condividiamo delle somiglianze, non avrei dovuto usarle come unico riferimento per valutarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560120
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560120,
					"content": "Non c'è problema. Per parafrasare le tue parole, anch'io ho accettato i miei errori passati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560121,
					"content": "È solo che ho sbagliato strada fin troppe volte. Devo percorrere un cammino ancora più lungo per porre rimedio a tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560122,
					"content": "In tal caso... buona fortuna? Per restituire il favore con una frase, non ti conosco ancora abbastanza per darti altri consigli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560123
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560123,
					"content": "Ahah... Ben detto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
