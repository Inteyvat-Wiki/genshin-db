			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cappellotto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "Ognuno di noi ha il proprio cammino da percorrere, non serve aggiungere altro. A proposito, buono questo tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Cappellotto"
				},
				{
					"id": 733560202,
					"content": "(Restiamo seduti così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 733560204,
					"content": "Va bene, ci vediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cappellotto"
				},
				{
					"id": 733560203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
}