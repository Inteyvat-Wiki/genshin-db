			"dialogs": [
				{
					"id": 740318101,
					"content": "#Sono {F#una pacifista}{M#un pacifista}, non mi piace combattere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740318102
					]
				},
				{
					"id": 740318102,
					"content": "#{F#Una pacifista}{M#Un pacifista} che combatte la violenza con la violenza? A ciascuno il suo, immagino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318103
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740318103,
					"content": "Ma questo non è un combattimento vero e proprio, è solo un allenamento. Lo facciamo per difendere meglio la pace. Quindi, se sei quel tipo di pacifista, dovremmo sicuramente allenarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740318104,
					"content": "Non hai tutti i torti. Cominciamo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740318105
					]
				},
				{
					"id": 740318105,
					"content": "Ah! Molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318106
					],
					"speakerTitle": "Nizami"
				},
				{
