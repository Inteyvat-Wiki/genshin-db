			"dialogs": [
				{
					"id": 740310101,
					"content": "#Giovane guerrier{F#a}{M#o}, ti va di allenarti con me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310102
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310102,
					"content": "Uh, quanta fretta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740310103,
					"content": "#Come ti pare. {F#Biondina}{M#Biondino}, basta uno sguardo per capire che sei {F#una veterana}{M#un veterano}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310104,
					"content": "Mi annoio terribilmente, nessuno vuole allenarsi con me. Se tu accetti, ti darò dei Coupon! Ne ho vinti parecchi da Roussimoff, e non ho ancora deciso come spenderli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310105,
					"content": "Che ne dici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				}
			]
		},
