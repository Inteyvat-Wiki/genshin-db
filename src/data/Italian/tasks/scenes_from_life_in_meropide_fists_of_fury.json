			"dialogs": [
				{
					"id": 740310301,
					"content": "Ah! Incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310302
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310302,
					"content": "#Lo sapevo! Sei {F#una degna avversaria}{M#un degno avversario}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310303,
						740310305
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310303,
					"content": "Non sei male nemmeno tu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740310304
					]
				},
				{
					"id": 740310304,
					"content": "Pare che dovrò allenarmi di più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310307
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310307,
					"content": "Però sono un tipo schietto, proprio come te. Eccoti i Coupon. Rifacciamolo, uno di questi giorni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310305,
					"content": "Hai ancora della strada da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740310306
					]
				},
				{
					"id": 740310306,
					"content": "#Non hai peli sulla lingua, {F#giovincella}{M#giovincello}. Mi piace!",
