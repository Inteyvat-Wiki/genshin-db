						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "Che ci fate da queste parti? Non c'è nemmeno una tratta qui ed è molto in alto, ai margini del Miraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540102,
					"content": "La gente viene raramente qui. Persino Idyia... Dubito che sappia dell'esistenza di questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540103,
					"content": "Allora se non c'è niente, tu che ci fai qui, Jeroney?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540104,
					"content": "Sono uscito solo per prendere una boccata d'aria... Ehi, non guardarmi con quell'aria da: \"Sei scappato di casa dopo aver litigato di nuovo con Ferdinand\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540105,
					"content": "Suvvia, non c'è stata nessuna discussione. Sto solo facendo una passeggiata per... beh, come dire, motivi personali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540106,
					"content": "Immagino che sappiate già che la Navetta Flapflap è stata una mia idea. All'epoca, pensavo solo a qualcosa che potesse raggiungere facilmente grandi altezze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540107,
					"content": "Così io... ehm, così Jeroney, per amore del cielo e delle altezze, ha ideato la Navetta Flapflap e i binari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540108,
					"content": "Sembra una sciocchezza, vero? Ricordo che a Inazuma c'è un detto che dice: \"Solo gli idioti e il fumo amano salire in alto\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540109,
					"content": "È fantastico che tu sia riuscito a inventare la Navetta Flapflap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "Ma può esistere solo nel Miraggio di Veluriyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540112,
					"content": "Lascia perdere, non parliamone. Sono venuto qui anche per osservare le stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540113,
					"content": "So che le stelle qui sono solo un'ombra effimera dall'esterno del Miraggio, ma per me sono comunque molto belle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540114,
					"content": "Ogni sera, quando guardo il cielo stellato... mi sento in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540115,
					"content": "La persona che ama il cielo stellato... è Jeroney?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "Ma chiunque veda un cielo stellato come questo non può che innamorarsene. Se solo potessi vedere le stelle di giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540117,
					"content": "O meglio ancora, se non dovessi salire qui ogni giorno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540118,
					"content": "Aspetta! È possibile! Paimon ha avuto un'idea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540119,
					"content": "Eh? Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540120,
					"content": "Possiamo scattare una foto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "F-Foto? Sembra una tecnologia avanzata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540122,
					"content": "Sì, perché non scattiamo una foto al cielo stellato per Jeroney?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540123,
					"content": "Potete farlo davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540124,
					"content": "Certo che sì!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "Ma... Paimon non è sicura di conoscere un buon posto per fotografare il cielo stellato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540126,
					"content": "Qui! Di notte, su questa piattaforma, si può ammirare la più bella volta celeste di sempre! Questo è il motivo per cui sono qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540127,
					"content": "Davvero? Magnifico! Jeroney, la tua foto sta arrivando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540110,
					"content": "Secondo me è divertentissimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
