			},
			"dialogs": [
				{
					"id": 790540301,
					"content": "Jeroney, siamo di nuovo qui! Ecco, questa è la foto. Dai un'occhiata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540302,
					"content": "Wow, mi sembra quasi di vedere il cielo con i miei stessi occhi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540303
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540303,
					"content": "Me la state dando davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540304
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540304,
					"content": "Certo, l'abbiamo scattata apposta per te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540305,
					"content": "Ahah, grazie... Grazie davvero, non avrei mai pensato di vedere una tecnologia così sorprendente. Con un progresso tecnico del genere, forse un giorno potremo anche costruire una Navetta Flapflap fuori dal Miraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540306
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540306,
					"content": "Che splendido cielo notturno... Se solo avessimo avuto una tecnologia come questa a quei tempi... Così avrebbe potuto ammirare questo splendido spettacolo ogni volta che voleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeroney"
				}
			]
		},
