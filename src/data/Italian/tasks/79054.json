			"dialogs": [
				{
					"id": 790540401,
					"content": "Foto... Non riesco a credere che esista qualcosa di così straordinario. Ora è possibile catturare ricordi di paesaggi meravigliosi a non finire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540402
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540402,
					"content": "#Bene, {NICKNAME}, hai finito di fare le foto? Non vedo l'ora di vederne una delle stelle!",
					"roleType": "TALK_ROLE_NPC",
