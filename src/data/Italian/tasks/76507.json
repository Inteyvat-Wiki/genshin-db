			},
			"dialogs": [
				{
					"id": 765070101,
					"content": "#Cavoli, {NICKNAME}, guarda! Sembra ieri che abbiamo ricevuto quest'album, eppure l'abbiamo già riempito da cima a fondo! E che foto fantastiche abbiamo fatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070102,
					"content": "Il tempo vola quando ci si diverte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "Hihi, Paimon non credeva che avremmo visto così tanti luoghi stupendi e scattato tutte queste foto insieme ai nostri amici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070105,
					"content": "Oooh, e guarda questa! Ci abbiamo messo una vita per trovare l'angolazione giusta, ma visto il risultato n'è valsa davvero la pena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070106,
					"content": "È merito tuo se siamo arrivati fin lì, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "Hihi, mi pare logico! Paimon è la guida migliore del mondo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070109,
					"content": "E comunque, con questi fantastici ricordi abbiamo recuperato eccome i soldi spesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME}, come ci si sente a usare questa Fotokamera? Credi che le tue abilità siano migliorate di molto? Pensi che siamo al livello del leggendario Pierre Leblanc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070111,
					"content": "Le mie abilità? Beh, ho ancora parecchia strada da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "Hihi, è vero! Essere contenti è la cosa più importante! E Paimon pensa che le tue foto siano degne dei migliori fotografi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070114,
					"content": "Perché ognuna di esse racchiude una storia che abbiamo vissuto insieme. Secondo Paimon, è qualcosa d'insostituibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070115,
					"content": "In futuro, dopo che... ehm, quando andremo altrove in cerca di avventure e ripenseremo a questi ricordi stupendi... Paimon pensa che sarà super interessante, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070116,
					"content": "In futuro ne scatteremo ancora di più.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "Sì! È una promessa, allora! Il nostro prossimo album sarà ancora più grande, più bello e più ricco di ricordi speciali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070112,
					"content": "L'importante è godersi il processo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "È tutto merito dei tuoi fondi di emergenza, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "Ogni foto è legata a un ricordo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
