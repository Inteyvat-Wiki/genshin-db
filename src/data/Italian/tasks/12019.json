			"dialogs": [
				{
					"id": 120190101,
					"content": "Volevate parlarmi di qualcos'altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190102,
					"content": "Per quanto riguarda il latte ai dango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "Avrà adorato quella bevanda, ne sono certa. Di sicuro le ha fatto piacere assaggiarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190104,
					"content": "Ciò che intendeva davvero dire era: \"Quanto tempo servirebbe per esportarla nel Piano dell'eutimia?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190105,
					"content": "Riguardo alla Shogun Raiden...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "Il burattino, sì. Anche io ho sentito dire che modificare le regole operative di un burattino è estremamente difficile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190107,
					"content": "Probabilmente è la prima volta che qualcuno si pone il problema. Potete immaginarne la complessità, visto che ha confuso perfino la saggia e potente Ei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190108,
					"content": "Si tratta di una situazione che non si risolve neanche con la Musou no Hitotachi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190109,
					"content": "Riguardo alle light novel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "Non pensate sia divertente immaginare qualcuno che rinasce nei panni della Shogun Raiden? È ciò che ci si aspetta da una light novel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190111,
					"content": "Per lei, però... Sì, forse è uno stile troppo sperimentale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190112,
					"content": "Uhm, e se commissionassi un seguito di quel libro? \"Rinato come la Guuji Yae\"... Che ve ne pare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190113,
					"content": "Non ho altro da dire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}