			"dialogs": [
				{
					"id": 722690101,
					"content": "#Io sono Eki dei Jibashiri. Ero{F#ina}{M#e} di Sangonomiya, riconosco che sei meritevole di affrontare questa sfida.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690102
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690102,
					"content": "Con me dovrai affrontare la prova dell'intuizione. Avanza e risolvi tutti gli enigmi per riportare le Fiamme dell'alta Porta al loro rispettivo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				},
				{
					"id": 722690103,
					"content": "Il campo di battaglia cambia continuamente. Solo se terrai gli occhi e le orecchie ben aperti riuscirai ad avere il controllo della situazione e ad affrontare tutte le possibili variabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722690103
					],
					"speakerTitle": "Eki"
				}
