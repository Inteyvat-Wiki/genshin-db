			"dialogs": [
				{
					"id": 760100201,
					"content": "Venticinque... ventisei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100202
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100202,
					"content": "Mmh? Cosa stai contando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100203,
					"content": "Silenzio! Abbassa la voce... Ah, lascia stare. Tanto non avrei preso nulla comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100204
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100204,
					"content": "Dai, ragazzina, non è ovvio? Sto cronometrando in quanto tempo abboccano. Che c'è? Pensavi che stessi agitando questa canna da pesca per lanciare incantesimi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100205,
						760100207
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100205,
					"content": "Beh... sei un membro degli Eredi della Luna gelata, quindi non sarebbe così assurdo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100206
					]
				},
				{
					"id": 760100206,
					"content": "#Ahah, mi sopravvaluti, {M#giovanotto}{F#signorina}. Sono a malapena mezzo Erede della Luna gelata. Non sono nemmeno nel sacerdozio. Sono un tipo normale senza il potere del Kuuvahki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100210,
					"content": "Comunque, è la prima volta che Paimon vede qualcuno cronometrare la pesca al secondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100211,
					"content": "Beh, quello che conta è la tua tecnica di pesca, non quanto tempo resti sulla riva. Il vecchio Ilmari non l'ha mai capito... non c'è da meravigliarsi che non abbia mai preso nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100212
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100212,
					"content": "#Mmh? Quindi voi due dovete essere {F#cacciatrici}{M#cacciatori} di tesori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100213
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100213,
					"content": "#No, siamo {F#avventuriere}{M#avventurieri}... Ma sì, accettiamo incarichi. Ti serve qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100214,
					"content": "#Più o meno. Finché siete {F#disposte}{M#disposti} a essere {F#pagate}{M#pagati} per fare un lavoro, per me va bene lo stesso. Ho qualcosa in cui potreste aiutarmi... se avete tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100215
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100215,
					"content": "Sono decisamente il miglior pescatore dell'Isola di Hiisi. Nessuno, nemmeno le successive generazioni di Cantaluna della storia, riuscirebbe a superarmi nella pesca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100216
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100216,
					"content": "Davvero? Incredibile... Aspetta, questo non significa nulla! La pesca non fa nemmeno parte del lavoro da Cantaluna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100217,
					"content": "Eppure, nonostante le mie abilità, ultimamente non ho preso neanche un pesce. Non ha senso, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100218
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100218,
					"content": "Quindi ovviamente il problema non sono io, ma l'ambiente. Proprio come con quell'Occhio di Kratti maledetto, ci deve essere qualcosa sott'acqua che influenza i pesci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100219
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100219,
					"content": "Che ragionamento... curioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100220,
					"content": "#Comunque, speravo che voi due poteste esaminare le acque qui vicino, per vedere cosa sta spaventando i pesci. Non preoccupatevi, sarete adeguatamente {F#ricompensate}{M#ricompensati} per i vostri sforzi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100221
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100221,
					"content": "Beh, dato che c'è una ricompensa di mezzo, daremo un'occhiata in giro... ma non promettiamo di trovare qualcosa di strano, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100207,
					"content": "Forse vuoi acchiappare il miglior compagno di viaggio che ci sia... Chi lo sa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100208
					]
				},
				{
					"id": 760100208,
					"content": "Eh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100209
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100209,
					"content": "Ehi! Non dire che chiunque può pescare il suo migliore compagno di viaggio con una canna da pesca! Aspetta... non è nemmeno questo il punto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
