							10671.01
						],
						"pointId": 12598
					}
				]
			},
			"dialogs": [
				{
					"id": 760100601,
					"content": "Ehi, hai visto? Non so nemmeno cosa sia successo. Un attimo prima stavo guardando altrove, e poi, all'improvviso, quel grosso masso è volato via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100602,
					"content": "Spieghi quello che è successo...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "Oh, mamma mia! Non ho idea di cosa significhi tutto ciò, ma se riuscite a fare qualcosa di così straordinario, dovete essere nelle grazie della Fanc{RUBY#[D]Kuutar}iulla lunare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100604,
					"content": "Oh, la Dea della Luna ci protegge! Ci protegge davvero! Ora posso pescare qui quanto mi pare, sempre che quel bardo fastidioso non porti il suo animaletto o, che non sia mai, inizi a cantare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100605,
					"content": "Come promesso, ecco il tuo pagamento. Anche se ultimamente non ho pescato nemmeno un pesce, ho tirato su un sacco di cose di ogni tipo, alcune delle quali dovrebbero valere parecchio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100606,
					"content": "Non che i Mora servano a molto sull'Isola di Hiisi comunque, quindi sono tutti tuoi. Grazie per l'aiuto... Ora voglio solo pescare in pace!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pekkani"
				}
			]
		}
	]
