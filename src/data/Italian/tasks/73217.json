			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "\"Il servizio dell'Hotel Shapur è buono, ma l'isolamento acustico è pessimo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170902,
					"content": "\"Ho soggiornato qui perché i prezzi a Porto Ormos erano bassi. Ora dovrò spostarmi alla Città di Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170903,
					"content": "\"Se neanche quest'anno supero l'esame, dovrò tornare a casa a lavorare nei campi. Non so se potrò portare con me la 'Benedizione di Anahita'...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "\"Questi Mahamata che hanno mandato sono uno più inutile dell'altro. Non sanno rispondere a neanche una delle mie domande.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171002,
					"content": "\"E ora che abbiamo accesso all'Akasha, questi Mahamata dilettanti non sono nemmeno al mio livello.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171003,
					"content": "\"Quello scriba che vediamo raramente e che l'ultima volta ci ha aiutati a definire il programma di spedizione è l'unica eccezione. Sembra che all'Akademiya non siano tutti degli ottusi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "\"Le responsabilità sono più pesanti da quando Cyno è diventato un generale Mahamatra, anche se in realtà sono diminuite dal momento che non devo più occuparmi di tediosi interessi di parte.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171102,
					"content": "\"Altrimenti non potrei starmene qui a bighellonare mentre sono in viaggio di ricerca.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171103,
					"content": "\"Non so dove sia Cyno. Immagino che non mi beccherà se lo scrivo qui.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171104,
					"content": "\"Ho visto tutto. Presentati da me entro domani a mezzogiorno e riceverai la punizione.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171105,
					"content": "\"Non farmi perdere tempo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321712",
							"2"
						],
						"stepId": 7321712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "Il nostro commercio consiste nel trasportare gemme e minerali preziosi prodotti a Liyue, attraverso un numero sufficiente di canali d'approvvigionamento stabili e una cooperazione a lungo termine con diverse flotte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171202,
					"content": "È in vendita una selezione di sete eleganti. Offerta limitata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171203,
					"content": "Contattateci se avete un buon canale di approvvigionamento per prodotti locali di Sumeru, come tappeti, erbe, gemme e prodotti di broccato. Commerciamo e facciamo amicizia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
						],
						"stepId": 7321713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "\"Lo scorso mese sono stato in un paese il cui re non aveva mai visto un cavallo. Riuscite a crederci?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171302,
					"content": "\"Così ho deciso di vendere alcune bestie da soma spacciandole per cavalli, ahah. Se chiudessi un affare con loro, forse lì potrei diventare io un re o qualcosa del genere!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171303,
					"content": "\"Cos'è un re?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171304,
					"content": "\"È come il Navbed o un visir, ma con un potere molto più grande del loro. Più o meno come i leggendari Ventinove Dey. Caspita, è così difficile da descrivere.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171305,
					"content": "\"Te lo stai inventando.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321714,
			"completionStepIds": [
				7321714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321714",
							"2"
						],
						"stepId": 7321714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171401,
					"content": "\"Sì noiosa è la predica del saggio. Portate il vino fatto di fiori, poiché per sette mari ci condurrà il viaggio.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321715,
			"completionStepIds": [
				7321715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321715",
							"2"
						],
						"stepId": 7321715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "All'attenzione di marinai, viaggiatori, mercanti e residenti del porto: le norme portuali sono qui indicate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171502,
					"content": "In caso di controversia, contattare lo sceriffo Shyam per assistenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "\"Invece di visitare il Gran Bazaar della Città di Sumeru, dovreste visitare gli antichi mercati di Porto Ormos.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171602,
					"content": "\"I Mahamata hanno rovinato il Gran Bazaar. Qui invece stiamo mantenendo molte più tradizioni e caratteristiche di Sumeru.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171603,
					"content": "\"Ma naturalmente, se volete assistere a uno spettacolo di danza, dovrete comunque andare al Teatro Zubayr.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171604,
					"content": "\"Cafoni. La Città di Sumeru è stata costruita con cura seguendo i delicati progetti dei ricercatori: la zonizzazione e la pianificazione di ogni singola area sono supportate da ricerche scientifiche.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171605,
					"content": "\"Vedo che qualcuno qui ha la testa piena di sciocchezze. Le strade confusionarie di Porto Ormos in qualche modo sono diventate un tesoro ai suoi occhi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171606,
					"content": "\"Cosa? Non ti sento!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "\"È imbarazzante dirlo. Eravamo lavoratori che si occupavano della manutenzione delle navi mercantili grazie a competenze tramandate di generazione in generazione.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171702,
					"content": "\"Ma da qualche tempo all'Akasha sono state aggiunte nuove tecnologie, e i nostri anni di esperienza sono diventati inutili. I giovani possono ancora imparare attraverso l'Akasha, ma i vecchi come noi non hanno altra scelta che cambiare lavoro.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171703,
					"content": "\"Lo scriba ha detto che possiamo andare per mare e tentare la fortuna, ma non abbiamo soldi per una cosa del genere al momento. Se avete qualche ingaggio, per favore venite da noi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171704,
					"content": "\"Non ascoltate lo scriba. Si dà il caso che io conosca una buona cliente che ha bisogno di artigiani. Vi presenterò a lei. Prendete anche i soldi. Scordatevi di andare per mare.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171705,
					"content": "\"Vorrei che si facessero meno cose senza senso. Alcune persone avranno successo e altre falliranno, è così che funziona il mondo. Perché interferire solo per fare i santarellini?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171706,
					"content": "\"Ecco che lo scriba ricomincia con il misticismo. Perché l'ho fatto, dici? Perché mi rende felice!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171707,
					"content": "\"E non dimenticate che il mondo è guidato anche dall'assistenza reciproca, dall'equità e dalla giusta rabbia, non da sciocchezze come quella secondo cui solo il più forte ce la fa!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171708,
					"content": "\"Intendiamoci. Non ho mai negato il tuo discorso, ma tu non capisci affatto quello che ti sto dicendo io. Fine della conversazione!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171709,
					"content": "\"Discutere con gli impulsivi fa venire il mal di testa. Comunque, dov'è il tuo bilancio? Non dirmi che spendi tutte le sovvenzioni dell'Akademiya in queste sciocchezze.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171710,
					"content": "\"I poveri soffrono per la ricchezza dei ricchi. Per questo, i ricchi dovrebbero dare via le proprie ricchezze per una buona causa. Così, dice il saggio Zolfikar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171711,
					"content": "\"Non lo ha mai detto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171712,
					"content": "\"Invece sì.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171713,
					"content": "\"No, non lo ha mai detto. E questo mese pagherai ciò che bevi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171714,
					"content": "\"Non voglio discutere con te di questo argomento. Ma dammi un mese. Dimostrerò che lo ha detto.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321718,
			"completionStepIds": [
				7321718
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321718",
							"2"
						],
						"stepId": 7321718,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "\"La nostra compagnia ha aperto la rotta verso Porto Dornman. Vi invitiamo cordialmente a unirvi al nostro commercio di frutta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171802,
					"content": "\"Un attimo. Davvero è possibile importare frutta da Mondstadt, nonostante il lungo viaggio? La cosa potrebbe interessarmi se si parlasse di alcolici.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171803,
					"content": "\"Tutti sanno che importare vino da Mondstadt è un'attività comune, ma importare frutta? Solo io faccio questo tipo di affari qui. Ecco perché si tratta di una grande opportunità!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171804,
					"content": "\"E non è necessario importare merce da Mondstadt...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321719,
			"completionStepIds": [
				7321719
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321719",
							"2"
						],
						"stepId": 7321719,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171901,
					"content": "\"La rotta per Ritou è di nuovo aperta. Vi invitiamo caldamente a fare affari con noi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171902
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171902,
					"content": "\"Il commercio di funghi selvatici tra Sumeru e Inazuma della nostra Associazione è stato approvato dal comandante del porto. Ora siamo disponibili a cooperare con i mercanti di funghi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171903
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732171903,
					"content": "\"Siete liberi di contattarci se riscontrate problemi o difficoltà durante il viaggio a Inazuma.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
