				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170101,
					"content": "\"Questa bacheca è stata allestita dal comandante di Porto Ormos per pubblicizzare le questioni importanti del porto e dintorni. Su di essa è anche possibile lasciare dubbi o domande riguardanti gli avvisi esposti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "\"Problemi con il formato della tesina? State ancora cercando idee per il vostro elaborato? È il momento di provare qualcosa di nuovo!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170202,
					"content": "\"Ho una laurea presso la Harav{RUBY#[S]Semiotica}atat e sono competente sia nelle discipline della Spant{RUBY#[S]Elementalismo}amad sia in quelle della Kshah{RUBY#[S]Tecnologia}rewar. Fornisco un servizio di tutorato per la stesura di tesine.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170203,
					"content": "\"È il momento di liberarsi dai dolori. Contattare il signor Amandeep presso l'hotel. Costo del servizio negoziabile.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170204,
					"content": "\"Scrivi per conto di altri?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170205,
					"content": "\"No, l'ispettore non ammette una condotta simile.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170206,
					"content": "\"Indubbiamente. Concentrati sullo studio e non tentare la fortuna.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "Avete mai sentito parlare di levitazione? Avete mai visto qualcuno volare? Volete scoprire i segreti della bestia da soma volante? Allora non perdetevi la prima esibizione a Sumeru dei Levitanti di Fontaine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170302,
					"content": "Benvenuti, lo spettacolo ha inizio! Non perdetevi questa esibizione unica nel suo genere! Solo cinque Mora a biglietto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170303,
					"content": "\"È stato meraviglioso. Non ho mai visto nulla di simile, nemmeno a Fontaine!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321704",
							"2"
						],
						"stepId": 7321704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "Promemoria speciale: gli Eremiti sono l'unica organizzazione di mercenari autorizzata a Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170402,
					"content": "Non fidatevi facilmente degli estranei per evitare truffe da parte di malintenzionati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170403,
					"content": "Chiunque desideri ingaggiare guardie del corpo, addetti alla sicurezza, o abbia altre richieste, è invitato a contattare il capitano Feroz del Gruppo dei Trenta a Porto Ormos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321705,
			"completionStepIds": [
				7321705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321705",
							"2"
						],
						"stepId": 7321705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170501,
					"content": "Le informazioni personali di tutti coloro che attraccano con un'imbarcazione devono essere comunicate al comandante del porto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170502,
					"content": "Le navi mercantili devono fornire dettagli sul carico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170503,
					"content": "Le navi mercantili non possono scaricare il carico o commerciare senza essere registrate qui. Qualsiasi violazione sarà severamente punita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321706,
			"completionStepIds": [
				7321706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321706",
							"2"
						],
						"stepId": 7321706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "Sono in corso indagini per monitorare attività di contrabbando. Tutte le merci che passano dal porto devono essere registrate e ispezionate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170602,
					"content": "Tutte le merci non registrate o di contrabbando saranno confiscate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170603,
					"content": "Tutte le conseguenze saranno a carico del proprietario del carico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321707,
			"completionStepIds": [
				7321707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
