			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170701,
					"content": "Attenzione alle bestie marine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170702,
					"content": "Di recente abbiamo assistito a un aumento dell'attività delle bestie marine. Le navi in partenza dal porto devono prestare attenzione agli avvisi emessi dal Faro di Pharos oppure ottenere informazioni marittime in anticipo tramite l'Akasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170703,
					"content": "Per qualsiasi domanda, si prega di contattare il guardiano del faro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321708,
			"completionStepIds": [
				7321708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321708",
							"2"
						],
						"stepId": 7321708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170801,
					"content": "In qualità di hotel più grande di Porto Ormos, offriamo un servizio accurato a mercanti e turisti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170802
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170802,
					"content": "Abbiamo uno sconto speciale per gli studenti e i laureati dell'Akademiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
					"speakerTitle": "Bacheca"
				},
				{
					"id": 732170803,
					"content": "Se avete bisogno di conservare della merce, vi preghiamo di contattare Wikala Funduq.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bacheca"
				}
			]
		},
		{
			"id": 7321709,
