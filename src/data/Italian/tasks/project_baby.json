					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042201,
					"content": "Eh? Ma questi cappelli... Ahah, li avevo realizzati per i serpenti. Come ho fatto a dimenticarmene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042202,
					"content": "Avevo fatto un berretto da notte per ogni serpente così da attirare i bambini a vedere lo spettacolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042203,
					"content": "Uno rosso per Jori, uno verde per Amum, uno giallo per Gana e uno blu per Drak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042204,
					"content": "Adorabili! Lo spettacolo dev'essere stato un successo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042205,
					"content": "Inizialmente stava andando tutto bene, ma quando i serpenti hanno spalancato le fauci, i bambini sono scoppiati a piangere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042206,
					"content": "Oh, lasciamo perdere... Ecco la tua ricompensa. Non è nulla di che, ma è qualcosa, perlomeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
