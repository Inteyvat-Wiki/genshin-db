			"dialogs": [
				{
					"id": 230040501,
					"content": "Sì, esatto! Quindi alla fine l'avevo davvero lasciato all'accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040502
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040502,
					"content": "Al nostro arrivo, c'erano dei Miconoidi che cercavano di rubarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040503,
					"content": "#Miconoidi, eh... Fiuuu, per fortuna ci siete andat{F#e}{M#i} voi al posto mio. Grazie mille, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040504
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040504,
					"content": "Non so davvero come ringraziarti. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040505
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040505,
					"content": "Ecco il pasto, piccoletti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
