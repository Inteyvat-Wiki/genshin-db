					"content": "Quindi questa roba piace molto agli animali? Forse dovrei aprire un'attività...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040605
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040605,
					"content": "Ehm... Non badate a me. Grazie infinite, ecco la vostra ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
