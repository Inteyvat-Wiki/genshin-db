			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gulabgir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230042001,
					"content": "Eh? Questa perla... Come... Dove l'hai trovata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042002,
					"content": "Era all'accampamento, dentro un vasetto. L'avevi lasciata tu lì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042003,
					"content": "Ah, in passato la usavo negli spettacoli. Ogni volta che suonavo il flauto, i miei cuccioletti portavano il vasetto sulla testa, alzavano la parte superiore del corpo e danzavano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042004,
					"content": "Ma ormai è da un sacco che i numeri come questo non hanno successo, ed è da un bel po' che non ne eseguo. Non mi ero neanche accorto di aver perso l'ambra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042005,
					"content": "Comunque, grazie per avermela riportata. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
