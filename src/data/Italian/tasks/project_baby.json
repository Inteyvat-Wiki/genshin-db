			"dialogs": [
				{
					"id": 230040901,
					"content": "Sì, esatto! Quindi alla fine l'avevo davvero lasciato all'accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040902
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040902,
					"content": "Ma perché il tuo accampamento è in mezzo ai rovi?! Non ti fa male dormire lì?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040903,
					"content": "Nah, sono bravissimo a vivere in mezzo alla natura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040904
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040904,
					"content": "Inoltre, quando l'ho messo su, non c'erano così tanti rovi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040905
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040905,
					"content": "È da molto che sei lontano dalla foresta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040906
					]
				},
				{
					"id": 230040906,
					"content": "Diciamo di sì. Non ricordo bene i dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040907
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040907,
					"content": "Ahah, sono un po' arrugginito nel metter su accampamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040908
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040908,
					"content": "Molti degli accampamenti che ho messo su in passato sono ormai abbandonati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040909
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040909,
					"content": "Chissà come sarebbe stata la vita se fossi rimasto nella foresta pluviale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040910
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040910,
					"content": "...Scusami, ho detto troppo. Ecco, prendi la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
