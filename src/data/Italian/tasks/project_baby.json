			},
			"dialogs": [
				{
					"id": 230041101,
					"content": "I serpenti domestici mangiano del cibo speciale? Non mangiano topi e cose così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041102,
					"content": "Beh, sì, un tempo cacciavano da soli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041103
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041103,
					"content": "Ma quando mangiavano, spaventavano i bambini, quindi ora impedisco loro di uscire senza di me. Ho iniziato a preparare il loro cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041104
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041104,
					"content": "*sospira* Ma da allora non si muovono più e si rifiutano di mangiare qualsiasi altra cosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041105
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041105,
					"content": "*sospira* Paimon credeva che non esistessero i pasti gratuiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041106,
						230041107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041106,
					"content": "È delizioso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041108
					]
				},
				{
					"id": 230041108,
					"content": "Paimon non gli ha ancora chiesto che sapore abbia, puoi continuare a sognare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041109,
					"content": "Godersi il cibo è il mestiere di Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041110,
					"content": "Oh, è molto ragionevole da parte tua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041111
					]
				},
				{
					"id": 230041111,
					"content": "Devo aver lasciato il loro cibo in uno dei miei accampamenti mentre raccoglievo delle erbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041112
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041112,
					"content": "Ma non posso andarmene, perché devo occuparmi dei miei cuccioletti e cose così. Non voglio che, mangiando, spaventino qualcun altro quando cercano del cibo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041113
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041113,
					"content": "#Viaggiat{F#rice}{M#ore}, ti dispiacerebbe andare a recuperare il cibo dall'accampamento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041114,
						230041117,
						230041119
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041114,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041115
					]
				},
				{
					"id": 230041115,
					"content": "Grazie infinite. Chissà cosa potrebbe capitare, se mi portassi i miei cuccioletti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041116
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041116,
					"content": "Se decidessero di farsi un giretto nella foresta per qualche giorno, sarei finito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041122,
					"content": "#A ogni modo, occupatene tu, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041123
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041123,
					"content": "Ti segno sulla mappa gli accampamenti dove sono stato, così puoi darci un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041117,
					"content": "Negli accampamenti non ci sono altri serpenti, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041118
					]
				},
				{
					"id": 230041118,
					"content": "No, niente affatto. Ho messo su gli accampamenti lontano da tane di serpente, così da non aver problemi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041119,
					"content": "Mi ripeti quanti accampamenti hai?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041120
					]
				},
				{
					"id": 230041120,
					"content": "Beh, quando vivevo nella foresta pluviale ne ho messi su un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041121
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041121,
					"content": "Non ci vivo più, ma se vado a raccogliere le erbe mi fermo ancora a riposare ai miei accampamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041122
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041107,
					"content": "Davvero buonissimo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041108
					]
				}
			]
		},
