			},
			"dialogs": [
				{
					"id": 230042401,
					"content": "Ah! Ma questa è la torre d'arrampicata per serpenti che ho costruito! Wow, quanti ricordi mi tornano in mente! Ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042402,
					"content": "Torre d'arrampicata per serpenti? Che cos'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042403,
					"content": "È un giocattolo su cui i serpenti possono arrampicarsi. Non posso averli sempre addosso, capisci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042404,
					"content": "Grazie per avermela portata. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042405,
					"content": "Quindi l'ho progettata in questo modo? Ahah, quanti ricordi mi tornano in mente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		}
	]
