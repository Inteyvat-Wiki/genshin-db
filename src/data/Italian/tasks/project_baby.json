				{
					"id": 230041901,
					"content": "Cosa c'è? Vuoi dirmi qualcos'altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041902
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041902,
					"content": "Ho trovato un'altra cosa nell'accampamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 2300420,
			"completionStepIds": [
				2300420
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
