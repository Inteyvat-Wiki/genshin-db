						230040802
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040802,
					"content": "A proposito dell'accampamento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230040803
					]
				},
				{
					"id": 230040803,
					"content": "Capisco... Forse è stata opera di qualche bestia selvatica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040804
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040804,
					"content": "Ora che ci penso, il cibo che preparo attira Miconoidi e uccelli... Quindi ha senso che attragga gli animali selvatici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040805
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040805,
					"content": "Forse dovrei davvero prendere in considerazione l'idea di vendere mangime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040806
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040806,
					"content": "Se ha successo come attività, potrebbe essere molto più remunerativa degli spettacoli che metto su...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040807
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040807,
					"content": "Oh, scusami, sto divagando. Grazie dell'aiuto. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
