			"dialogs": [
				{
					"id": 230040701,
					"content": "Sì, esatto! Quindi alla fine l'avevo davvero lasciato all'accampamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040702
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040702,
					"content": "Era stato sotterrato dalle rocce. A quanto pare, il tuo accampamento è finito sotto una frana che ha portato via tutta la tua roba. A dire il vero, abbiamo dovuto cercare a lungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230040703,
					"content": "Sul serio? Come ha fatto a esserci una frana? Lì non ci sono mai stati problemi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040704
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040704,
					"content": "Oh! Ricordo che quand'ero accampato lì, di notte sentivo dei rumori strani e qualcosa che grattava sulla mia tenda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040705
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040705,
					"content": "I miei serpenti erano molto agitati e non facevano che svegliarmi. Ma per quanto controllassi, non ho mai trovato niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040706
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040706,
					"content": "Mah, sai che c'è, lascia perdere... Grazie dell'aiuto. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
