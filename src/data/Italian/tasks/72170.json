			"dialogs": [
				{
					"id": 721700401,
					"content": "Davvero dobbiamo trovare un modo per immergerci lì sotto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700402
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700402,
					"content": "Non possiamo andare da un'altra parte? Dobbiamo proprio prendere qui le alghe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700403
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700403,
					"content": "Oh, e dai, ancora quella barriera... Perché il meccanismo dev'essere lì dentro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
