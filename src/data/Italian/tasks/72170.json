				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700201,
					"content": "#Hai raccolto qualche alga, viaggiat{F#rice}{M#ore}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700202,
					"content": "#Ah, sì, ecco. Grazie per l'aiuto, viaggiat{F#rice}{M#ore}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700203,
					"content": "Bene, è tempo di cucinare il piatto chiamato... onigiri, giusto? Ho sentito dire che è abbastanza facile da preparare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700204,
					"content": "Va bene, aspetta qui mentre cucino. Ci vorrà un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7217003,
			"completionStepIds": [
				7217004
			],
