			"dialogs": [
				{
					"id": 721700701,
					"content": "Sembra che questa non sia la prima volta che l'area qui sotto si allaga...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700702
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700702,
					"content": "Sì, lo dimostrano anche i segni dell'acqua. Di sicuro questo posto si è allagato non molto tempo fa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700703
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700703,
					"content": "Ma perché all'improvviso l'acqua si è ritirata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700704
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700704,
					"content": "Uff, qui è tutto bagnato. L'acqua mi entrerà nelle scarpe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700705
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700705,
					"content": "Vabbè, lasciamo perdere. Raccogliamo qualche alga il più in fretta possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700706
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700706,
					"content": "Che ci fate qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "#Oh, ma guarda un po'! Ci incontriamo di nuovo, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700708,
					"content": "Siamo appena scesi lì sotto per raccogliere delle alghe fresche per preparare un piatto chiamato onigiri. È stata dura. Le mie scarpe sono fradicie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700709,
					"content": "#Ma comunque, viaggiat{F#rice}{M#ore}, ci aiuteresti a raccogliere qualche altra alga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700710
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700710,
					"content": "Sembra che l'area qui sotto si sia allagata non molto tempo fa. Ora l'acqua si è ritirata, ma non sappiamo quando risalirà di nuovo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700711
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700711,
					"content": "Quindi credo che sia meglio raccogliere qualche altra alga il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700712,
						721700715
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700712,
					"content": "Nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700713
					]
				},
				{
					"id": 721700713,
					"content": "#Contiamo su di te, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700714
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700714,
					"content": "Ti prego di tornare da me non appena le avrai raccolte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700715,
					"content": "Non le prendete dalla riva?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700716
					]
				},
				{
					"id": 721700716,
					"content": "Potremmo, sì, ma di solito le alghe sulla riva non sono freschissime, e i piatti preparati con ingredienti poco freschi mancano sempre di sapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700717
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700717,
					"content": "#La qualità delle alghe che si trovano qui dovrebbe essere di gran lunga superiore. In ogni caso, ci serve il tuo aiuto, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700718
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700718,
					"content": "Ti prego di tornare da me non appena le avrai raccolte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
