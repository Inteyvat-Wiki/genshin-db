					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700301,
					"content": "Allora. Alghe... pesce... e riso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700302,
					"content": "Dovrebbe essere così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700303,
					"content": "Sì, ecco fatto! Vi presento gli onigiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700304,
					"content": "Com'è... semplice. Bene, io prendo questo. Dubito che riuscirei a mangiarne di più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700305,
					"content": "Beh, l'importante è che sia buono! Io prendo questo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700306,
					"content": "#Questa è la tua porzione, viaggiat{F#rice}{M#ore}... E, ovviamente, ecco una copia della ricetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700307,
					"content": "Questi onigiri sembrano il piatto più facile del mondo, ma per prepararli bene serve un bel po' di pratica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700308,
					"content": "Bene, allora. Ora ne mangio qualcuno anch'io. Tutta quella fatica mi ha fatto venire fame...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700309,
					"content": "Ehi, Parvaneh, non avevi detto che non saresti riuscita a mangiarne di più?! Lasciamene qualcuno, dai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
