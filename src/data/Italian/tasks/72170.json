			},
			"dialogs": [
				{
					"id": 721700101,
					"content": "Non possiamo andar lì sotto così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700102,
					"content": "Cos'è successo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "#Viaggiat{F#rice}{M#ore}, ci incontriamo di nuovo! Stiamo cercando un modo per... immergerci nelle acque lì davanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700104,
					"content": "Vogliamo prendere delle alghe fresche per preparare dei cosiddetti \"onigiri\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700105,
					"content": "Non potete prenderne dalla riva?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "Potremmo, sì, ma di solito le alghe sulla riva non sono freschissime, e i piatti preparati con ingredienti poco freschi mancano sempre di sapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700109,
					"content": "Ho chiesto alla gente del posto, e mi hanno detto che lì sotto crescono alghe di buona qualità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700110,
					"content": "Ma oggi, quando siamo arrivati, abbiamo scoperto che l'acqua del mare ha allagato tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700111,
					"content": "E come se non bastasse, nessuno di noi sa immergersi, quindi non possiamo che rimanere a guardare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700112,
					"content": "Ci sono dei meccanismi da queste parti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "Ce n'è uno laggiù...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700114,
					"content": "Ma è dentro la stessa barriera di prima, quindi non possiamo entrarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700115,
					"content": "*sospira* Continuiamo a ragionare su come fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700116,
					"content": "#In ogni caso, viaggiat{F#rice}{M#ore}, facci sapere se sai come possiamo fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700117,
					"content": "Ovviamente, la cosa migliore sarebbe se ci portassi direttamente tu le alghe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700118,
					"content": "Signor Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700119,
					"content": "*tossisce* Voglio dire, se ci portassi direttamente tu le alghe, ti ricompenseremmo a dovere! E come ulteriore incentivo, ti preparerò un grande banchetto di onigiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700120,
					"content": "Non puoi fare un \"grande banchetto\" di onigiri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700121,
					"content": "Oh, e dai, basterà prepararne di più... *tossisce* Oh, va bene, ok. Cerchiamo di trovare una soluzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700107,
					"content": "Dovete proprio immergervi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "Le alghe che si trovano sulla riva non sono freschissime, e i piatti preparati con ingredienti poco freschi mancano sempre di sapore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7217002,
			"completionStepIds": [
				7217003
			],
