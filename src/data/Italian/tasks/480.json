			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "Beh, l'ho letto, ma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "...non posso dire di aver compreso appieno le regole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "Bene, sei qui! Hai studiato a fondo il manuale di volo a vela? Hai appreso tutte le regole?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820204,
					"content": "#Ti sei annoiat{F#a}{M#o} parecchio, eh? Lo so, ci sono passata anch'io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820205,
					"content": "Il manuale di volo a vela è un mattone... Non sono proprio riuscita a farmelo piacere. Non dirlo a Jean, però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820206,
					"content": "Davvero? Mmh... Paimon pensava che ci fossero delle storie interessanti nel manuale di volo a vela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820207,
					"content": "Storie interessanti? Ah, sicuramente intendi gli esempi nell'Appendice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820208,
					"content": "Alcuni di quelli mi piacciono. Il mio preferito è quello sul decollo illegale con un Melmoso di Anemo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820209,
					"content": "A quanto pare, se fai scoppiare un Melmoso di Anemo e usi la raffica di vento per decollare, finirai molto, ma molto in alto... Voglio proprio provarci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820210,
					"content": "No, non quella storia. Paimon intendeva quella dell'uccellino che voleva imparare a volare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820211,
					"content": "Ah... Eh...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820212,
					"content": "Fammi dare un'occhiata... Cavolo, questo è il libro di fiabe che leggevo da bambina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820213,
					"content": "Ops, scusate! Ho messo entrambi i libri nella stessa pila e devo aver preso quello sbagliato quando sono uscita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820214,
					"content": "Come diamine si fa a confondere una storia della buonanotte con un manuale di istruzioni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820215,
					"content": "Ooh... Che vergogna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820216,
					"content": "È perché... Forse è perché, in fondo, quella è stata la fiaba che mi ha insegnato veramente a planare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820217,
					"content": "\"Quello che vi mancava non era il vento, ma il coraggio che vi ha permesso di diventare i primi uccellini a volare in questo mondo.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820218,
					"content": "Leggerla mi ha dato il coraggio di volare, di diventare una Vigilante e infine di diventare campionessa di volo a vela di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820219,
					"content": "...In ogni caso, passiamo all'esame, adesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820220,
					"content": "#Non essere nervos{F#a}{M#o}, vola come faresti di solito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820222,
					"content": "#Sono pront{F#a}{M#o}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Bene. Devi semplicemente seguire il <color=#00E1FFFF>percorso indicato</color> fino al traguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		},
