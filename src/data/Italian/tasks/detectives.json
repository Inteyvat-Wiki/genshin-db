					"nextDialogs": [
						191854902
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854902,
					"content": "E, a pensarci bene, Bernard ha attirato la nostra attenzione proprio perché è venuto a cercare Bonnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191854903
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854903,
					"content": "Potrebbe essere che anche la persona che ha scritto la lettera non sapesse dove si trovasse Bonnie...? O che il suo intento fosse completamente diverso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
