				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Esamina"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3926.022,
							443.657,
							4548.217
						],
						"pointId": 340100651
					}
				]
			},
			"dialogs": [
				{
					"id": 191851101,
					"content": "Il materiale con cui sono fatte queste borse... è piuttosto raro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851102,
					"content": "[Conoscenza] (Aiuta Lyney a esaminare il materiale...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "Non è simile al materiale usato per le tue Magiborse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "...È identico, a dire la verità: si tratta della fibra dei fiori di Romaritime. Ma c'è qualcosa di speciale nella composizione di queste borse. Le ho esaminate più attentamente, e sembra che non siano solo impermeabili, ma anche resistenti alla corrosione e a tenuta stagna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851105,
					"content": "Persino i lacci sembrano realizzati appositamente per tenere le borse ben chiuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851106,
					"content": "Proprio adesso ho visto delle borse fatte con lo stesso materiale, ma erano molto più piccole e sottili. Non davano l'idea di essere troppo resistenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851107,
					"content": "Quindi... sono simili a quelle piccole borse sigillate?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "...Molto, in verità. Normalmente, per un barboncino guardiano sarebbe facile fiutare del Sinthe contraffatto. Ma, se fosse chiuso in una borsa come queste, potrebbe passare diverso tempo prima che qualcuno riesca ad accorgersene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851109,
