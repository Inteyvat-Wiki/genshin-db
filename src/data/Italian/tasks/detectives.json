				]
			},
			"dialogs": [
				{
					"id": 191851201,
					"content": "Ahah, proprio come pensavamo... È qui che è stato prodotto il Sinthe contraffatto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851202,
					"content": "[Medicina] (Aiuta Chevreuse a identificare le medicine...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851203
					]
				},
				{
					"id": 191851203,
					"content": "Queste boccette e questi barattoli... Contengono tutti del Sinthe contraffatto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851204
					]
				},
				{
					"id": 191851204,
					"content": "...Sembra che qui intorno ci sia ben altro che del Sinthe contraffatto... Oltre alle materie prime necessarie a sintetizzare quella sostanza, c'è una consistente quantità di detergenti e anche alcuni farmaci che non sono stata in grado di identificare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851205
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851205,
					"content": "È probabile che questi detergenti servano per eliminare le tracce della sostanza... come il suo odore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851206,
					"content": "La Pattuglia speciale ha condotto delle ricerche sul Sinthe contraffatto. Secondo i dati in nostro possesso, per le persone normali rilevare le tracce lasciate da quella sostanza non è per niente facile. Sono sicura che sia stato lo stesso per Pierre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851207
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851207,
					"content": "Ci sarà voluto un mucchio di tempo e abilità per riuscire a rimuovere tutte quelle tracce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851208
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851208,
					"content": "Ma a cosa servono questi altri farmaci...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		},
