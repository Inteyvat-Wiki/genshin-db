					},
					{
						"sceneId": 3,
						"position": [
							3938.103,
							443.774,
							4554.202
						],
						"pointId": 340100546
					},
					{
						"sceneId": 3,
						"position": [
							3942.292,
							441.271,
							4545.01
						],
						"pointId": 340100652
					}
				]
			},
			"dialogs": [
				{
					"id": 191851001,
					"content": "...Quando lo Spettro Maréchaussée ha perquisito la casa di Pierre, non ha trovato traccia di questi barili, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851002,
					"content": "Deve averli spostati. Ma trasportarli fin qui avrebbe attirato troppa attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "Hai ragione. Non sembra il suo modo di fare le cose... Come sarà riuscito a portarli qui, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851004,
					"content": "(Esamina i barili...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "(I barili mostrano segni di danni causati dall'acqua. Intorno alla loro circonferenza sono visibili delle macchie d'acqua...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 191851006,
					"content": "(La posizione delle macchie d'acqua sembra seguire uno schema. Per qualche ragione appaiono limitate alla metà inferiore dei barili.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 191851007,
					"content": "(I coperchi non sembrano ben chiusi, e lasciano degli spazi considerevoli lungo i bordi. Eppure, all'interno dei barili non è visibile alcuna traccia d'acqua.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 191851008,
					"content": "Pare che soltanto la metà inferiore dei barili sia stata immersa nell'acqua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
		{
			"id": 1918511,
			"completionStepIds": [
				1918511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
