			},
			"dialogs": [
				{
					"id": 220100801,
					"content": "I doushin mantengono l'ordine ad Hanamizaka. Nessun criminale può sfuggire al loro sguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100802,
					"content": "Nella storia, i cavalieri del nemico hanno le stesse mansioni dei doushin. Ma per renderli più interessanti, saranno dieci volte più forti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100803,
					"content": "Non dire numeri a caso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "Le scale numeriche sono la cosa più semplice del mondo. Questo ci aiuterà a dimostrare le capacità del personaggio principale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100806,
					"content": "Beh, io... darò al personaggio principale l'abilità di camuffarsi. Ad esempio, potrà cambiare il suo aspetto, o la sua voce, quando ne avrà bisogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100807,
					"content": "Quindi il personaggio principale acquisisce all'improvviso questa abilità?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "Ma no, l'ha sempre avuta, era solo nascosta. Un incontro con i nemici è l'occasione ideale per rivelarla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100809,
					"content": "Te lo sei appena inventato, vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100810
					]
				},
				{
					"id": 220100810,
					"content": "N-No... Lo avevo in mente fin dall'inizio. Dai, lasciami stare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100811
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100811,
					"content": "In ogni caso, andrà bene. Andiamo a raccontare a Shigeru la mia idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100805,
					"content": "E come farà il personaggio principale a risolvere questa situazione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100806
					]
				}
			]
		},
