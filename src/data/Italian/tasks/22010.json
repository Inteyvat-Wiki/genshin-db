			},
			"dialogs": [
				{
					"id": 220100922,
					"content": "A dire il vero, l'idea di Shigeru mi sembra più ragionevole...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100923
					]
				},
				{
					"id": 220100923,
					"content": "Ragionevole? La ragionevolezza non corrisponde a una trama avvincente. Una trama ragionevole sarebbe noiosa senza una storia emozionante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100924
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100924,
					"content": "Tu... ricorda le mie parole: se mai dovrai concludere la storia di un romanzo, vedrai quant'è difficile cercare di risolvere ogni buco di trama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100925
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100925,
					"content": "I-Io ho preso appunti. Non avrò nessun problema a concludere il romanzo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100926
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100926,
					"content": "Devi prendere appunti per ricordare tutti i dettagli, vero? Credi che anche i lettori prendano appunti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100927
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100927,
					"content": "Uhm... Beh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100928
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100928,
					"content": "Non sto dicendo che non puoi fare nessun cambiamento. Sto solo dicendo che devi fare attenzione a quanti cambiamenti fai e a quando li inserisci nella storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100929
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100929,
					"content": "Scrivere un romanzo è come correre una maratona: se vai troppo veloce all'inizio, finirai per perdere terreno più avanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100930
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100930,
					"content": "La chiave per un romanzo di successo è andare avanti con costanza, un passo alla volta. Fidati di me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100931
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100931,
					"content": "Ok, ok... *sospira*",
