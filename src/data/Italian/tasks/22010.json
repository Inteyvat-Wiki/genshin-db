					"nextDialogs": [
						220101112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101112,
					"content": "Raccontalo a qualcun altro. Sai benissimo che i lettori cominciano a essere confusi da tutto quello che ti inventi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220101113,
					"content": "#Uff, non voglio più parlare con te. Sei così noioso. Vediamo cosa ne pensa {F#la}{M#il} viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220101114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101114,
					"content": "#Viaggiat{F#rice}{M#ore}, chi pensi che abbia ragione: io o Shigeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220101107,
					"content": "Cosa sta facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220101108
					]
				}
			]
		},
