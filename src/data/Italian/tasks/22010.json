			},
			"dialogs": [
				{
					"id": 220100601,
					"content": "Volano scintille quando i martelli si scontrano con le incudini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100602,
					"content": "La Fucina Amenoma è un luogo pieno d'ispirazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100603,
					"content": "I fabbri trasformano le billette e i minerali grezzi in armi potenti usando degli strumenti molto semplici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100604,
					"content": "Se si utilizza l'alchimia per forgiare i materiali, non sarebbe possibile creare delle armi indistruttibili?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100605,
					"content": "No, non lo è...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "Sì! Buona idea. Il personaggio principale avrà un'arma potentissima, che verrà forgiata grazie all'alchimia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100609,
					"content": "Ora devo solo pensare a un nome per quest'arma e a una trama spettacolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100610,
					"content": "Ci sono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100611,
					"content": "#Viaggiat{F#rice}{M#ore}, torniamo da Shigeru. Devo raccontargli la mia idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100606,
					"content": "Non credo tu conosca il senso dell'alchimia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "Cosa intendi dire? L'alchimia non è quella cosa che rende l'impossibile possibile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
