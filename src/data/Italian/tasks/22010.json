			"dialogs": [
				{
					"id": 220100901,
					"content": "Ho trovato l'ispirazione alla Fucina Amenoma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100902
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100902,
					"content": "Davvero? Wow, ce l'hai fatta. Grandioso! Raccontami, allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100903
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100903,
					"content": "Una notte, il personaggio principale ha una rivelazione improvvisa e scopre di avere una superba abilità alchemica: la \"Rinascita della spada\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100904
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100904,
					"content": "Può trasformare una lama arrugginita in un'arma potente solo pronunciando il suo nuovo nome!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100905
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100905,
					"content": "E così... Aspetta, ho detto qualcosa di sbagliato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100906
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100906,
					"content": "Oh no... lo stai facendo di nuovo, vero?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100907,
						220100908
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100907,
					"content": "Di nuovo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100909
					]
				},
				{
					"id": 220100909,
					"content": "Fammi indovinare: per continuare la storia, darai al personaggio principale una nuova abilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100910
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100910,
					"content": "E poi aggiungerai dei dettagli sempre più intricati finché non finirai il capitolo, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100911
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100911,
					"content": "Non mi importa quanto ti piaccia il personaggio, smetti di dargli tutte queste abilità! Confonderai i lettori, in questo modo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100912
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100912,
					"content": "Questo è il mio stile di scrittura. Penso sia interessante. I lettori lo adoreranno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100913
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100913,
					"content": "Raccontalo a qualcun altro. Sai benissimo che i lettori cominciano a essere confusi da tutto quello che ti inventi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100914
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100914,
					"content": "#Uff, non voglio più parlare con te. Sei così noioso. Vediamo cosa ne pensa {F#la}{M#il} viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100915
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100915,
					"content": "#Viaggiat{F#rice}{M#ore}, chi pensi che abbia ragione: io o Shigeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100908,
					"content": "Cosa sta facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100909
					]
				}
			]
