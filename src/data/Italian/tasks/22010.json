			"dialogs": [
				{
					"id": 220100916,
					"content": "A dire il vero, penso che Junkichi abbia avuto una buona idea...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100917
					]
				},
				{
					"id": 220100917,
					"content": "Una buona idea? Se continua così, finirà per confondere anche sé stesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100918
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100918,
					"content": "#Ahahah, visto? {F#La}{M#Il} viaggiat{F#rice}{M#ore} è dalla mia parte. Questo significa che la mia idea è interessante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100919
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100919,
					"content": "La cosa più importante in un romanzo è una trama emozionante e avvincente. Sto scrivendo con questo obiettivo in mente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100920
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100920,
					"content": "*sospira* Tu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100921
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100921,
					"content": "Dai, rilassati. So quello che faccio. Sono sicuro che verrà apprezzato da tutti, vedrai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
