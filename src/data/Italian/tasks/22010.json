				"objectNames": [
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100701,
					"content": "Il Negozio di alimentari Tsukumomono ha tanti oggetti simili a quelli trovati dal protagonista del mio romanzo nel suo viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100702,
					"content": "Aoi dice sempre: quello che è spazzatura per un uomo è un tesoro per un altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100703,
					"content": "Mmmh... Sembra che conoscere le esigenze dell'acquirente sia il segreto per vendere merci a un prezzo elevato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100704,
					"content": "Ma se lo scrivo in questo modo, dovrei spiegarlo dal punto di vista psicologico e andrei fuori tema...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100705,
					"content": "E se il personaggio principale ottenesse dei poteri psichici grazie ai quali riesce a intuire le esigenze dell'acquirente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100706,
					"content": "Non puoi cambiare la storia del personaggio all'improvviso!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "Si chiama evoluzione del personaggio. Andrà bene, non preoccuparti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100710,
					"content": "Ci sono! So cosa scrivere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100711,
					"content": "#Viaggiat{F#rice}{M#ore}, torniamo da Shigeru. Devo raccontargli la mia idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100708,
					"content": "Come inserirai questo cambiamento nella trama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "Mmmh, mi verrà in mente mentre lo scriverò, non sarà un problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201008,
