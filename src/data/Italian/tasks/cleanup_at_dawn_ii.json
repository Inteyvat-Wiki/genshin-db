			"dialogs": [
				{
					"id": 201040201,
					"content": "Com'è andata?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040202
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040202,
					"content": "Le hai tolte tutte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040203
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040203,
					"content": "Fino all'ultima.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "Caspita, sei un portento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040205,
					"content": "#Viaggiat{F#rice}{M#ore}, sei una persona fantastica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040206,
					"content": "Grazie! Ora Adelinde non se la prenderà con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040207,
					"content": "Ti prego, prendi questo come ringraziamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040208,
					"content": "Bene, abbiamo altri posti da pulire. Grazie ancora! Ci vediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				}
			]
		},
