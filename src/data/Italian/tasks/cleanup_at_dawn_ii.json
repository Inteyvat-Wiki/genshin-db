			"trigger": {
				"objectNames": [
					"Moco"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "Cosa facciamo adesso?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040102,
					"content": "Adelinde sarà fuori di sé...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040103,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "Adelinde ci ha chiesto di mettere in ordine l'area attorno al vigneto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040105,
					"content": "La maggior parte della zona andava bene, ma ci sono tutte queste balle di fieno in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040106,
					"content": "Connor dice che le tiene lì perché gli servono per delle cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040107,
					"content": "Sono ben legate, quindi almeno non volano via col vento; ma un po' di foglie sono comunque finite in mezzo alla paglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040108,
					"content": "Abbiamo lavorato sodo, ma non siamo riuscite a ripulire del tutto dalle foglie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040109,
					"content": "Se va avanti di questo passo, la governante Adelinde perderà le staffe... Cosa facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040110,
					"content": "Ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "Davvero? Ma è fantastico! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040112,
					"content": "È molto difficile liberarsi delle foglie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "Decisamente, quando si mischiano alla paglia dobbiamo toglierle una a una, e ci vuole un'eternità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040114,
					"content": "Se hai un'idea migliore, sono tutt'orecchi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
