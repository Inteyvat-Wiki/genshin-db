			"dialogs": [
				{
					"id": 201040301,
					"content": "Perché l'hai fatto?! Hai ridotto le balle di fieno in cenere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040302,
					"content": "Tante grazie... Ora Adelinde si infurierà sicuramente... Peggio ancora, ci licenzierà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040303,
					"content": "È stato un incidente...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "Bah, avremmo dovuto continuare a raccoglierle una a una.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040305,
					"content": "Diamine... Non c'è modo di tornare indietro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040306,
					"content": "Ecco, io...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "#Viaggiat{F#rice}{M#ore}, è meglio che te ne vada. È una nostra responsabilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040308,
					"content": "È colpa nostra, non avremmo dovuto farci aiutare da una persona che non si intende di pulizie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040309,
					"content": "Cosa farà Adelinde quando lo scoprirà...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040310,
					"content": "Si arrabbierà tantissimo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
