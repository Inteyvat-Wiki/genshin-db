						],
						"pointId": 15570
					}
				]
			},
			"dialogs": [
				{
					"id": 700740501,
					"content": "Ehi! Avete fatto scappare tutti i piccioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740502,
					"content": "...G-Gran Maestro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740503,
					"content": "Ehi, ma guarda chi si vede, il piccolo Timmie! Sei cresciuto un bel po', eh? Stai mangiando come si deve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740504,
					"content": "S... Sì, signore! Non ho mai dimenticato quello che mi ha detto... Che devo mangiare bene e allenarmi sodo se voglio diventare grande e forte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740505,
					"content": "L'atteggiamento di questo ragazzino...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "Beh, immagino sia l'effetto Varka... Onestamente, Paimon dubita fortemente ci sia anche un solo bambino in questa città che non ammiri la nostra \"leggenda vivente\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740508,
					"content": "Perdonami per aver spaventato i tuoi piccioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740509,
					"content": "Tra l'altro, volevo chiederti... C'è un modo per avvicinarsi ai piccioni senza spaventarli... e allo stesso tempo farli restare felici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740510,
					"content": "Mmh... A dire il vero, di solito mi avvicino a loro in silenzio e spargo un po' di mangime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740511,
					"content": "Boom, perfetto! Senti, hai del mangime extra con te in questo momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740512,
					"content": "Ne ho un bel po', ma... Gran Maestro... Ehm... cosa ha intenzione di fare...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740513,
					"content": "Non preoccuparti, ometto, ci serve giusto una piuma o due... Hai la mia parola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740514,
					"content": "Ah... Va bene allora, nessun problema! E grazie, Gran Maestro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740506,
					"content": "È cambiato in un batter d'occhio!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
