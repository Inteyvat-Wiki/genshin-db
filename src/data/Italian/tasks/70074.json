			"dialogs": [
				{
					"id": 700740401,
					"content": "Incredibile! Quindi è COSÌ che si fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740402
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740402,
					"content": "Uff... Come mai Paimon ha la sensazione di aver già sentito questa reazione tipo un centinaio di volte...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740403,
					"content": "Mmm... Sì, questo andrà bene! La forma, la consistenza, la qualità... Eccellente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740404,
					"content": "Paimon non riesce a capire come fai a distinguere una scheggia di legno dall'altra... Vabbè, basta che tu sia felice. Ora, passiamo alle \"piume di piccione perse per la gioia\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7007405,
			"completionStepIds": [
