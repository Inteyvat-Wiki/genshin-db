					},
					{
						"sceneId": 3,
						"position": [
							1612.496,
							249.147,
							-1612.986
						],
						"pointId": 15599
					},
					{
						"sceneId": 3,
						"position": [
							1607.029,
							246.406,
							-1601.496
						],
						"pointId": 15600
					}
				]
			},
			"dialogs": [
				{
					"id": 700740901,
					"content": "Incredibile... Da quando gli Hilichurl sono così ragionevoli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740902,
					"content": "Ella! Non è che hai visto Varka da queste parti?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740903,
					"content": "Certo che l'ho visto, proprio adesso. È andato a farsi prestare un \"gran calderone\" dagli Hilichurl... e indovina un po'? Gliel'hanno dato non appena lo hanno visto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740904,
					"content": "La cosa più strana è che si sono a malapena scambiati qualche parola. Non capisco proprio come sia andato tutto così liscio... Che il Gran Maestro conosca il linguaggio del corpo degli Hilichurl e io no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740905,
					"content": "Non credo si possa parlare di \"comunicazione\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "Uff, non è questo il punto! Comunque, dov'è adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740908,
					"content": "Laggiù!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740909,
					"content": "Finalmente è pronto! Il miglior vino di tutta Teyvat... è mio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740910,
					"content": "Varka! Non...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "#Oh, ehi {F#ragazze}{M#ragazzi}... Alla fine ce l'avete fatta! Quegli Hilichurl di prima sono stati incredibilmente ragionevoli... Non mi aspettavo che sarebbe andata così liscia, eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740912,
					"content": "Comunque, è ora di scoprire che sapore ha questo bel vino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740913,
					"content": "...Aspetta, non berlo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "#Eh? Vuoi assaggiarlo tu per {F#prima}{M#primo}? Eheh, scordatelo, {F#ragazzina}{M#ragazzino}... Il primo bicchiere spetta a me!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740915,
					"content": "Non è quello che...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "#{F#Tranquilla}{M#Tranquillo}! Te ne lascerò un po'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740917,
					"content": "Glu glu glu... Aaah... M-Mmh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740918,
					"content": "Aspetta... Perché mi sento... così male...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740919,
					"content": "Varka! Tutto ok? Varka? Varkaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740920,
					"content": "Gran Maestro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "Forza! Hai sconfitto un dio e pensi di poter morire qui?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740923,
					"content": "Ugh... Argh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740924,
					"content": "...Per un istante, giuro di aver visto tutti i Cavalieri di Boreas del passato qui di fronte a me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740925,
					"content": "Non so se dovrei farti una ramanzina per esserti ridotto in questo stato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "In ogni caso, mi serve un momento per digerire il tutto... sia la bevanda che la lezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740928,
					"content": "Spieghi a Varka del talento infallibile di Diona nel preparare le bevande.\\n\"In altre parole,\" gli dici, \"solo lei potrebbe trasformare degli ingredienti così strani in un alcolico di prima qualità...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "Ah, quindi l'ingrediente mancante era la benedizione della Fata della sorgente... Ahah, non l'avrei mai detto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740930,
					"content": "Ehi, non fare il finto innocente! Ci devi una spiegazione per aver cercato di prenderci in giro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740931,
					"content": "Scusate, scusate... La verità è che credevo davvero avrebbe funzionato... e avevo comunque intenzione di confessare tutto davanti a un bicchiere o due...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740932,
					"content": "Ma immagino che... probabilmente non vogliate più berlo, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740933,
					"content": "Per stavolta... passo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "Mmm... Beh, direi che vi devo un favore! Che ne dite se vi offro da mangiare al Buon Cacciatore una volta che saremo tornati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740936,
					"content": "Ora sì che si parla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740937,
					"content": "Sei fin troppo facile da corrompere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "Oh, andiamo! Hai visto in che stato era dopo aver tracannato quel bicchiere. Paimon è sicura che abbia imparato la lezione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740939,
					"content": "*sospira* Suppongo di non poter incolpare nessuno se non me stesso, eh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740940,
					"content": "Cooomunque... Torniamo a parlare del tuo \"incarico\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "Ahah, beh... Pensavo di raccontare questa storia alla taverna, ma direi che anche qui all'aria aperta andrà bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740943,
					"content": "...Quindi stai dando degli \"incarichi\" a tutti a Mondstadt, eh? Che idea interessante... Ce n'è uno anche per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740944,
					"content": "Eheh! Beh, se proprio vuoi saperlo, il tuo incarico era \"cambiare il destino riflesso nell'astrolabio\". Ma l'hai già fatto un bel po' di tempo fa... Per essere precisi, nel momento in cui hai deciso di partire per la tua spedizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alice"
				},
				{
					"id": 700740941,
					"content": "Perché è vuoto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740934,
					"content": "Non credo di avere il coraggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740926,
					"content": "O meravigliarmi del fatto che tu sia ancora in piedi...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740921,
					"content": "Dai, amico, riprenditi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740906,
					"content": "Almeno, non in un linguaggio riconoscibile... né verbale, né del corpo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				}
			]
		},
