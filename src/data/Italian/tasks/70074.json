			},
			"dialogs": [
				{
					"id": 700740201,
					"content": "Quindi è così che otterremo del \"legno scheggiato da cavalieri\", eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740202,
					"content": "#Ah! Gran Maestro! {F#Cavaliere Onoraria}{M#Cavaliere Onorario}! Anche voi siete qui per addestrarvi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740203,
					"content": "Beh, non proprio, diciamo... Ma siamo qui per raggiungere un obiettivo, quindi, sì, lo potresti considerare un addestramento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740204,
					"content": "Siete già così abili, eppure aspirate ancora alla perfezione... Prego, addestratevi come preferite! Io rimarrò qui di fianco a prendere appunti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
