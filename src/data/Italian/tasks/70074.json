				]
			},
			"dialogs": [
				{
					"id": 700740801,
					"content": "Gru gru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "Piccione"
				},
				{
					"id": 700740802,
					"content": "Prese! Le piume sono nel sacco. Ripeto, le piume sono nel sacco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740803,
					"content": "Finalmente! Quest'incarico è molto più difficile di quanto Paimon pensasse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740804,
					"content": "Manca solo un altro ingrediente... \"Brodo medicinale preparato in un gran calderone\". Deve essere la Valle Dadaupa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740805,
					"content": "Ci vado subito. Raggiungimi appena puoi, d'accordo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740806,
					"content": "Ehi, aspetta un...! Caspita, che entusiasmo... È volato via più veloce di uno stormo di piccioni spaventati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740807,
					"content": "Sempre il solito \"spirito libero\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "...Quel vecchio ubriacone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740810,
					"content": "Mmh? Chi va là?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740812,
					"content": "Diona? Che ci fai qui? E perché ti stavi nascondendo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740813,
					"content": "I-Io... sono qui solo per raccogliere un po' di frutta, lo giuro! È che non mi aspettavo di imbattermi in quel rompiscatole persino qui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740814,
					"content": "Uff, ultimamente non fa che tormentarmi perché gli prepari di nuovo da bere. Ne ho le scatole così piene che lo evito ogni volta che posso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740815,
					"content": "Qual è la storia di questa bevanda, allora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "Allora, sai che è tornato di recente insieme a parte del corpo di spedizione, no? Beh, indovina un po'? Praticamente la prima cosa che ha fatto è stata passare alla Coda di Gatto per \"un bicchierino o due\" per festeggiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740817,
					"content": "Davvero? Paimon pensava che se ne sarebbero rimasti alla sede dei Cavalieri di Favonius...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740818,
					"content": "Personalmente, ho sempre pensato che Varka fosse più un tipo da Dono dell'Angelo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "Uff... Ecco perché ho detto \"praticamente\". Hanno fatto questo e molto di più! La Coda di Gatto è stata la terza tappa del loro tour di taverne della città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740820,
					"content": "...E Paimon scommette che lo rifaranno la prossima volta che un altro gruppo di soldati tornerà a casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740821,
					"content": "Sicuramente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "Comunque, per farla breve, non potevo sopportare la vista di quei vecchi ubriaconi nemmeno per un altro secondo! Così ho deciso di preparare loro le bevande più disgustose e nauseabonde di tutta Teyvat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740823,
					"content": "Ma, Diona...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "Già... Ecco perché ho provato a farle preparare a Prince al posto mio. Uff, se solo quegli ubriaconi non avessero iniziato a rompergli le scatole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740826,
					"content": "...E così Prince è scappato via prima che potesse finire. Almeno ha dato una bella graffiata a quel vecchio ubriacone mentre se ne andava! Ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740827,
					"content": "(Ahh, quindi è così che Varka si è procurato quella cicatrice...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "Mi stavo avventurando in un domi{RUBY#[D]taverna}nio profondo e oscuro, combattendo alcuni dei mos{RUBY#[D]Prince}tri più feroci e spietati che avessi mai visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740829,
					"content": "Ad ogni modo, era proprio lì, di fronte a me, pronta per essere ultimata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740830,
					"content": "...Quindi sei stata tu a dare il tocco finale?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "Già.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740832,
					"content": "Giusto per curiosità, vorrei chiederti un'altra cosa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "Uhm... Qualche scheggia di legno che ho notato sui vestiti dei cavalieri, qualche piuma di piccione che ho raccolto nella foresta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740835,
					"content": "...E un po' di zuppa d'erbe degli Hilichurl che avevo intenzione di trasformare in un rimedio per smaltire la sbornia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740836,
					"content": "Aspetta un attimo... Hai detto che è successo poco dopo il ritorno di Varka, giusto? Questo significa che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740837,
					"content": "Nessuno gli ha detto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "Oh-oh, la cosa non promette bene! Dobbiamo andare a fermarlo prima che sia troppo tardi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740838,
					"content": "...Che solo Diona può rendere buona una ricetta così terribile!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "Cosa ci hai messo dentro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "Non riusciresti a preparare una bevanda cattiva neanche se ci provassi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "Scommetto che non vede l'ora che inizino a servire da bere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
		{
			"id": 7007409,
