			"dialogs": [
				{
					"id": 700740601,
					"content": "Sembrano delle impronte di piccione queste. Aspettiamo qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740602
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740602,
					"content": "#Quando appaiono, avvicinati a loro in silenzio e spargi il mangime... ma occhio a non far loro del male. {F#Pronta}{M#Pronto}?",
					"roleType": "TALK_ROLE_NPC",
