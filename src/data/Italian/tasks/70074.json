					}
				]
			},
			"dialogs": [
				{
					"id": 700740101,
					"content": "Comunque sia, visto che è stato Varka ad aver avuto l'idea di tenere una \"riunione\" con l'Hexenzirkel, come mai non abbiamo mai scoperto quale incarico gli avessero assegnato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740102,
					"content": "Vediamo un po'... Varka, Varka... Aspetta, perché non c'è scritto niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740103,
					"content": "Perché non glielo andiamo a chiedere di persona?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740104
					]
				},
				{
					"id": 700740104,
					"content": "Hai ragione... Beh, sapendo com'è fatto, faremmo meglio a controllare tutte le taverne e i ristoranti del posto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740105,
					"content": "...Non è ancora qui, eh? Sembra che dovrò sbrigarmela da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740106
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740106,
					"content": "Parli del diavolo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740107
					]
				},
				{
					"id": 700740107,
					"content": "Ehi, Varka! Volevamo chiederti qualcosa sul tuo \"incarico\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740108,
					"content": "#Oh, ehi, {F#Cavaliere Onoraria}{M#Cavaliere Onorario} e Paimon! Il mio \"incarico\"...? Di che parlate?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740109,
						700740110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740109,
					"content": "L'Hexenzirkel ha assegnato un incarico a tutti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				},
				{
					"id": 700740111,
					"content": "Ora che mi ci fai pensare, sono abbastanza sicuro che Alice mi abbia detto qualcosa al riguardo... Credo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740112,
					"content": "\"Credi\"? Questa tua \"riunione\" è il motivo per cui esistono questi \"incarichi\"! Uff... Comunque, perché il TUO non c'è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740113,
					"content": "...Se dovessi tirare a indovinare, direi che probabilmente sarebbe un po' troppo per il loro libricino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740114,
						700740115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740114,
					"content": "Ora hai la mia attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740116,
					"content": "Il mio incarico... è produrre il vino più pregiato che Teyvat abbia mai visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740117,
					"content": "...E questo sarebbe \"troppo\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740118,
					"content": "Fidati, è una faccenda seria... Vedi questa nuova cicatrice sul mio braccio? È il prezzo che ho pagato per mettere le mani sulla ricetta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740119,
					"content": "Mi stavo avventurando in un dominio profondo e oscuro, combattendo alcuni dei mostri più feroci e spietati che avessi mai visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740120,
					"content": "Sul serio...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740121
					]
				},
				{
					"id": 700740121,
					"content": "#Ora ci mancano solo tre ingredienti speciali per finire! {F#Cavaliere Onoraria}{M#Cavaliere Onorario}, Paimon, vi andrebbe di darmi una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740122,
					"content": "Uff, e va bene, perché no...? Visto che si tratta solo di tre cose, Paimon farà finta di credere alla tua storia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740123,
					"content": "Bene! Eheh... Allora, ci servono ancora del \"legno scheggiato da cavalieri\", delle \"piume di piccione perse per la gioia\" e un \"brodo medicinale preparato in un gran calderone\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740124,
					"content": "Aspetta un attimo... Ma non dovevamo fare del \"vino\"? A Paimon questa sembra una specie di pozione super sospetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740125,
					"content": "Mmh, hai ragione... Beh, dopotutto i nostri supervisori sono delle maghe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740126
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740126,
					"content": "Stiamo seguendo la ricetta alla lettera, quindi tutti e tre gli ingredienti devono soddisfare i requisiti. Forza, cominciamo con quelle schegge di legno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740115,
					"content": "Cosa intendi con \"troppo\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740110,
					"content": "Ma il tuo sembra non esserci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				}
			]
		},
