			"dialogs": [
				{
					"id": 220230101,
					"content": "Ahhh, sarebbe così bello poter mangiare qualche piatto di Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230102,
					"content": "Tutto ok?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230103
					]
				},
				{
					"id": 220230103,
					"content": "#E tu saresti? Quei vestiti... Sei {F#la}{M#il} viaggiat{F#rice}{M#ore}? Scusa, è che mi manca un po' casa mia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230104,
						220230105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230104,
					"content": "Hai detto che hai voglia di mangiare qualche piatto di Liyue?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				},
				{
					"id": 220230118,
					"content": "Eh? Per caso tu... sai come preparare i piatti di Liyue? Ma è fantastico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230119
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230119,
					"content": "A-Allora aiutami, ti prego! Preparami qualche delizia tipica di Liyue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230120
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230120,
					"content": "Fammi pensare... Quello che vorrei davvero mangiare al momento è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230121
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230121,
					"content": "Mmmh! Ho voglia di mangiare carne! Tanta, tanta carne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230122
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230122,
					"content": "La consistenza delicata e il profumo fragrante della carne insieme alle spezie speciali di Liyue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230123
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230123,
					"content": "Mi basta pensarci che mi viene l'acquolina in bocca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230124
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230124,
					"content": "Perciò, voglio mangiare carne! Ti prego, aiutami a preparare un piatto di Liyue a base di carne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230105,
					"content": "Posso aiutarti in qualche modo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230106
					]
				},
				{
					"id": 220230106,
					"content": "Lascia che mi presenti. Sono Tang Wen, una storica di Liyue. Ho effettuato alcune ricerche sul campo sui costumi e sul folklore unici di Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230107,
					"content": "Stavo per tornare a Liyue, dato che avevo quasi finito di raccogliere informazioni. Ma a causa del Decreto Sakoku di Inazuma, sono finita bloccata qui per un bel po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230108,
					"content": "A dire il vero, credo sia una buona cosa. Credo infatti che questo sia un momento storico per Inazuma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230109,
					"content": "Sono abbastanza sicura che questo periodo lascerà un'impronta profonda negli annali della storia di Teyvat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230110,
					"content": "Osservare gli eventi con i propri occhi e prendere nota di tutto in modo autentico, completo e chiaro per i posteri è il dovere di ogni storico che si rispetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230111,
					"content": "Ma... questa causa non riuscirà a soddisfare il mio stomaco, per quanto l'abbia a cuore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230112
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230112,
					"content": "Ti sta venendo fame?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230113
					]
				},
				{
					"id": 220230113,
					"content": "Non posso dire... che sia solo la fame. Ahahah, anche il cibo di Inazuma è molto saporito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230114
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230114,
					"content": "Mi piace davvero come preparano la tempura qui, anche se sembra si limitino a impanare tutto e a friggerlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230115
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230115,
					"content": "Ma dopo aver gustato le prelibatezze d'Inazuma per tanto tempo, inizia a mancarmi la cucina di Liyue. Purtroppo, non sono riuscita a trovare un ristorante che prepari i veri piatti della tradizione del mio paese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230116,
					"content": "Alla fine, qualche giorno fa, ho deciso di pubblicare un incarico culinario presso la Gilda degli avventurieri, ma non ho ancora ricevuto alcuna risposta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230117
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220230117,
					"content": "Posso provarci io?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				}
			]
		},
