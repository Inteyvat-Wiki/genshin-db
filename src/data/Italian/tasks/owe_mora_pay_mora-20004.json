			},
			"dialogs": [
				{
					"id": 200040401,
					"content": "Come è andata? Hai trovato Ast... Ehm, la tua amica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040402
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040402,
					"content": "Ecco i soldi dell'affitto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040403
					]
				},
				{
					"id": 200040403,
					"content": "Ah, bene, bene. Basteranno. Grazie mille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040404
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040404,
					"content": "Detto ciò, posso chiederti che lavoro fa la tua amica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040405
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040405,
					"content": "Sembra una ragazza molto in gamba, ma sempre a corto di Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				}
			]
		},
		{
			"id": 2000405,
			"completionStepIds": [
				2000405
