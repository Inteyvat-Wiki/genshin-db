			"dialogs": [
				{
					"id": 200040501,
					"content": "Eccoti. Immagino che Goth sia stato pagato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040502
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040502,
					"content": "Esatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040503
					]
				},
				{
					"id": 200040503,
					"content": "Bene. Per fortuna, l'affitto di questa casa non è troppo caro. Semplicemente non riuscivo a racimolare abbastanza Mora in una tale situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040504,
					"content": "Comunque, penso che mi nutrirò di insalata ancora per qualche giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
