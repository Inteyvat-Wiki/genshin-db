			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040301,
					"content": "Ah, eccovi. Ne è passato di tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040302,
					"content": "Che strano, sembrate andare di fretta. Per caso mi stavate cercando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040303,
					"content": "Dove sei stata, Mona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040304,
					"content": "Ti abbiamo cercata negli ultimi giorni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "Ah, non è stato molto... opportuno da parte vostra. Qualche giorno fa, l'Uccello a vapore mi ha inviato una richiesta per un nuovo manoscritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040306,
					"content": "Il tema era \"I cambiamenti celestiali in relazione ai destini mutevoli di una persona\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040307,
					"content": "Quindi negli ultimi giorni sono stata molto all'aperto, a studiare le stelle. Tornavo a casa solo a notte fonda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040308,
					"content": "Sembra che Mona stia lavorando sodo per guadagnare Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040309,
					"content": "Beh, ecco, c'è un nuovo globo celeste che ho già ordinato da Fontaine. Ho perfino pagato la caparra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040310,
					"content": "Dopo aver inviato questo manoscritto, riceverò i Mora con cui potrò ripagare quanto dovuto e recuperare il globo celeste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040311,
					"content": "Ok, ma non dimenticarti di pagare l'affitto a Goth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "L'affitto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040313,
					"content": "Ah! Io, ehm... Ovviamente, ho messo da parte un po' di Mora per l'affitto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040314,
					"content": "Un secondo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040315,
					"content": "Mona fruga nella borsa...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "Questi... e questi! Ecco, dovrebbero bastare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 200040317,
					"content": "(Ha praticamente svuotato le tasche...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "Bene, allora. Vi va di aiutarmi a passare questi Mora a Goth?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
