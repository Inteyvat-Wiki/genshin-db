			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Goth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200040101,
					"content": "*sospira* Suppongo che dovrò risolvere la situazione per conto mio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040102
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040102,
					"content": "Ahi, di questo passo le mie vecchie ossa cadranno a pezzi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040103
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040103,
					"content": "È un problema urgente?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040104
					]
				},
				{
					"id": 200040104,
					"content": "#Oh, viaggiat{F#rice}{M#ore}? Beh, questo non lo chiamerei \"un problema urgente\", ma la cosa ti sta sicuramente sfuggendo di mano...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040105
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040105,
					"content": "Come ben sai, quei Fatui hanno prenotato l'intero hotel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040106
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040106,
					"content": "E, come ben sai, io, in quanto proprietario del Grand Hotel Goth, devo occuparmi di loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040107
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040107,
					"content": "Coordino la ristorazione, la manutenzione e una sfilza di altre faccende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040108
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040108,
					"content": "Ultimamente, i mobili di alcune camere sono stati danneggiati, così ho dovuto chiedere a della gente di portare il legno giusto ad alcuni falegnami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040109
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040109,
					"content": "Poi c'è il problema di riscuotere l'affitto di qualche appartamento... e in più il mio figliolo Marvin è sparito chissà dove.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040110
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040110,
					"content": "*sospira* Mi chiedo per quanto ancora potrò continuare così... O quando quel ragazzo si deciderà a crescere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040111,
						200040112
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040111,
					"content": "Ti aiuto io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				},
				{
					"id": 200040113,
					"content": "Vuoi davvero aiutarmi? Oh, che bello!... *sospira* Se solo quel chiassoso di Marvin avesse la testa sulle spalle come te... Mi sarei risparmiato molti guai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040114
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040114,
					"content": "In questo caso, posso chiederti di andarmi a prendere del legno d'abete rosso e del legno di betulla? Ho bisogno di spedirli presto ai falegnami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040112,
					"content": "Prima riposati qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040113
					]
				}
			]
		},
		{
			"id": 2000403,
			"completionStepIds": [
				2000403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
