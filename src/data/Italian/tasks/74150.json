			"dialogs": [
				{
					"id": 741490601,
					"content": "Consegna giornali? Lascialo di fianco alla porta, grazie. Lo vengo a prendere dopo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741490602,
					"content": "(Hai già aiutato Benoît oggi. Sarebbe scortese disturbarlo mentre riposa. Hai accettato di vederlo domani, sarebbe meglio fare così.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bussa"
				}
			]
		},
