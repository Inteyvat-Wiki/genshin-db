				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500701,
					"content": "(Vecchie casse pesanti e deteriorate, ricoperte da strati di polvere. La loro presenza è davvero una nota stonata nella luminosa e pulita Corte di Fontaine.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500702
					],
					"speakerTitle": "Casse insolite"
				},
				{
					"id": 741500702,
					"content": "(Nella parte inferiore, queste scatole si sono macchiate di acqua nel corso degli anni. In passato erano state di certo impilate e conservate in un posto estremamente umido.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500703
					],
					"speakerTitle": "Casse insolite"
				},
				{
					"id": 741500703,
					"content": "(Le macchie sulla porta non sono niente: queste scatole sembrano aver bisogno di una pulizia ancora più urgente.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Casse insolite"
				}
			]
		},
		{
			"id": 7415008,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
