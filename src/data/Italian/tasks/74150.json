						],
						"stepId": 7415005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500801,
					"content": "Ah, è inutile bussare a quest'ora. Morticia e Athos non sono in casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500802
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500802,
					"content": "Hanno detto che sarebbero tornati oggi, ma a quanto pare, per qualche motivo, non sono ancora rincasati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500803
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500803,
					"content": "Ah, è questo il problema con i figli adulti. Hanno sempre qualcosa da fare, e quando ne hai bisogno non ci sono mai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				}
			]
		}
	]
}