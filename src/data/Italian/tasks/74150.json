			},
			"dialogs": [
				{
					"id": 741500301,
					"content": "Avete finito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500302,
					"content": "Sì sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "Certo, le pulizie sono finite, e Molli ha anche dato da mangiare alla gatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500304,
					"content": "Ah! E, Benoît, ci sono un mucchio di vecchie scatole luride vicino a casa tua. Diamo una pulita anche a quelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500305,
					"content": "Oh, quelle? Ci metto solo della roba vecchia... Non le uso per altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500306,
					"content": "In alcune ci sono dei mobili e in altre piccoli oggetti che erano nella mia vecchia casa. Non me la sono sentita di buttarli... Però, allo stesso tempo, non c'entrano niente con la casa nuova, così sono rimasti lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500307,
					"content": "Non le tocco praticamente mai, ma dato che qui ci abitano solo persone perbene, e nessuno ha mai rubato niente, per me possono rimanere dove sono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500308,
					"content": "Monsieur Leroy, Monsieur Leroy, le sono stata d'aiuto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500309,
					"content": "Ma certo che sì, Molli. Non dimenticare di salutarmi i tuoi. Se lo farai, ti sarò ancora più riconoscente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500310,
					"content": "E ho qui dei dolcetti e degli spiccioli, bambini cari, sono tutti per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500311,
					"content": "Oh, no, no, gli spiccioli non mi servono. Vorrei solo accarezzare Nana ancora un po'. Posso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500312,
					"content": "Oh, certo, ma fai attenzione agli artigli; e vieni a prendere qualcosa da sgranocchiare quando hai finito, mi raccomando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500313,
					"content": "Perché sei uscito, papà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500314,
					"content": "Beh, mi sentivo solo, e sentivo tanto la mancanza dei miei bambini; così ho deciso di andare a prendere un po' d'aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500315,
					"content": "Ah, ma sentilo, Morticia... Siamo stati via per un paio di giorni e già ci mette il muso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500316,
					"content": "Ma sicuramente ci perdonerà alla vista del regalo che gli abbiamo portato, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500318,
					"content": "Regalo? Beh, su, cosa mi avete portato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500319,
					"content": "Qualcosa di favoloso, ovviamente. Lo scoprirai quando lo vedrai. Morticia sa che adori la roba carina e costosa; l'ha scelto apposta per te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500320,
					"content": "Grazie, figlia mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500321,
					"content": "Ho fatto solo ciò che dovevo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500322,
					"content": "#Ah, già. Anche {F#queste due adorabili visitatrici}{M#questi due adorabili visitatori} sono {F#venute}{M#venuti} qui a giocare mentre voi non c'eravate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500323,
					"content": "Salve. Mio padre è un tipo molto alla mano, e adora i bambini. Grazie di avergli tenuto compagnia, davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500324,
					"content": "Comunque, dato che io e mia moglie siamo tornati, ora possiamo pensarci noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500325,
					"content": "Ah, è davvero una gioia riavervi qui. Dai, su, fatemi dare un'occhiata al mio regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500326,
					"content": "Va bene, papà. Andiamo a casa, vuoi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500327,
					"content": "Certo, certo. Athos, ricordati di dare loro il giusto compenso e un po' di dolcetti. Hanno passato la scopa per terra e hanno anche dato da mangiare a Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500328,
					"content": "Ah, e dai un po' di dolcetti anche a quella signorinella! Io me ne torno dentro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500329,
					"content": "Monsieur Leroy, Nana mi ha permesso di accarezzarle la pancia... Eh? Dov'è andato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500330,
					"content": "Cerchi mio padre, piccola? Io sono suo genero... Beh, puoi anche considerarmi figlio suo, per rendere le cose più semplici. Chiamami pure Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500331,
					"content": "Oh, lo so cos'è un genero. Praticamente lei è il marito di sua figlia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500332,
					"content": "Ahah, ne sai davvero tante, eh? Grazie per avergli tenuto compagnia. Lui è rientrato, nel frattempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500333,
					"content": "Questi dolcetti sono per te. Del resto possiamo occuparci io e mia moglie, puoi anche non venire più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500334,
					"content": "E comunque, dovresti andare subito a casa. La tua famiglia si preoccuperà se rimani troppo fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500335,
					"content": "Oh, non si preoccupi, Monsieur. Non è stato un problema. E comunque, io e Monsieur Leroy abbiamo fatto un patto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500336,
					"content": "Penso che in futuro avrà ancora bisogno di me... Posso venire a dare da mangiare alla gatta, innaffiare le piante, o anche altro. Mi piace aiutare le persone, per cui tornerò di sicuro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500338,
					"content": "Tsk. Questo finirà per complicare le cose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500339,
					"content": "Ehm, c'è qualcosa che non va, Monsieur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500340,
					"content": "No, signorinella, no. Ho qualcosa d'importante da discutere con te... Anzi, no, più che discutere, ho bisogno che tu faccia qualcosa per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500341,
					"content": "Certo. Di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500342,
					"content": "Allora, adesso prendi questi spiccioli e questi dolcetti... e non tornerai mai più qui. Siamo intesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500343,
					"content": "Eh? Perché? Ho fatto qualcosa di male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500344,
					"content": "No, nient'affatto. È solo che mio padre non è molto in salute, e negli ultimi tempi la sua insonnia è peggiorata molto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500345,
					"content": "Io e mia moglie vorremmo che si trovasse in un ambiente adatto al riposo, per non compromettere la sua salute. Lo capisci, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500346,
					"content": "Oh, quindi Monsieur Leroy non sta bene... Capisco, la prossima volta gli porto un po' di Bulle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500347,
					"content": "Papà mi dice che ogni volta che mi viene il mal di pancia, bisogna mangiare meno dolci e più frutta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500348,
					"content": "Se Monsieur Leroy mangia un po' di frutta ogni giorno, si riprenderà prima di subito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500349,
					"content": "...*sospira* E va bene, mi sa che non ho altra scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500350,
					"content": "Per quanto riguarda voi due, ecco dolcetti e ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500351,
					"content": "Ora lasciate che mi spieghi meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500352,
					"content": "Parlo a nome dell'intera famiglia Leroy: spero che non verrete ancora a disturbarci in futuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500353,
					"content": "So che siete giovani, ma penso possiate capire cosa sto dicendo; quindi, vi prego, non tornate più in questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500354,
					"content": "Questo è tutto. Ora devo andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500355,
					"content": "Uhm. E perché non possiamo tornare? Che strano! Monsieur Leroy era così alla mano, e invece quello lì vuole che non torniamo più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500356,
					"content": "Eh, sì! Questo tizio sarà pure gentile, ma non ha un briciolo di calore umano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500357,
					"content": "Beh, non mi interessa quello che dice lui. Domani andrò a trovare Monsieur Leroy. E voi due?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500358,
					"content": "Dai, su, venite con me. Nana è così adorabile, mi piacerebbe accarezzarla un altro po'... E poi Monsieur Leroy ci darà altri dolcetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500359,
					"content": "Facciamo a gara a chi arriva prima!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "Una promessa è una promessa, intesi? Verremo a giocare con la gatta e stare un po' col Monsieur Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500361,
					"content": "Se abbiamo tempo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "Va bene, allora alla prossima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
