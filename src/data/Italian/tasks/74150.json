				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500601,
					"content": "I miei figli non sono in casa, e la pulizia di tutto quel lerciume che si accumula sulla porta e sul retro della casa è un bel problema. Conto su di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				}
			]
		},
		{
			"id": 7415007,
			"completionStepIds": [],
