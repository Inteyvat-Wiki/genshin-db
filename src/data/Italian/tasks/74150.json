			},
			"dialogs": [
				{
					"id": 741500101,
					"content": "Grazie, Molli. I tuoi adorabili occhi color lavanda scintillano di gentilezza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500102
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500102,
					"content": "Eheh, davvero? Le è piaciuta quella bambola che le ho portato la volta scorsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500103
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500103,
					"content": "Oh, certo, certo che sì. Era davvero adorabile. Le ho perfino riservato un posto a tavola, sai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500104
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500104,
					"content": "Sul serio? Oh, ne sarà felicissima! E oggi che facciamo? Vuole appoggiarsi a me durante la camminata, oppure vuole che vada a prenderle il giornale?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500105,
					"content": "Posso leggerglielo io, se non riesce a capire bene cosa c'è scritto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500106
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500106,
					"content": "La mamma dice che devo fare una buona azione al giorno, e la mia insegnante vuole che per questa settimana le consegni un tema sulle belle persone e sulle buone azioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500107,
					"content": "Oh, ehm... Questo non significa che quello che faccio è motivato solo dai compiti, ma se non le dispiace, sarò ben felice di aiutarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500108
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500108,
					"content": "Ahah. Oh, non ti preoccupare. La migliore cosa che potresti fare per aiutarmi è dire ai tuoi genitori che vieni spesso a giocare da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500109
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500109,
					"content": "Lo so, Monsieur Leroy, e gliel'ho detto, ma non ne sembrano contentissimi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500110,
					"content": "E, anche così, continuerai a venirmi a trovare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500111
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500111,
					"content": "Certo che sì, anche se non me lo permetteranno. Voglio dire, abbiamo fatto un patto, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500112,
					"content": "Ahah, sei proprio una bambina di parola. Molto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500113
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500113,
					"content": "#Ah, siete voi due. {F#Benvenute}{M#Benvenuti}, anime gentili, {F#benvenute}{M#benvenuti}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500114
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500114,
					"content": "*tossisce* Oh, non volevamo intrometterci o interrompere qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500115,
					"content": "Disturbiamo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500116
					]
				},
				{
					"id": 741500116,
					"content": "No, no, nient'affatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500117
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500117,
					"content": "La mia giovane amica Molli sta andando a sbrigare delle faccende, deve finire di fare i compiti. Si è fermata qui da me solo un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500118
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500118,
					"content": "Le piacerebbe fare qualcosa di buono per me, per avere qualcosa di cui scrivere nel suo tema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500119
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500119,
					"content": "Ehi! Non c'entrano mica i compiti! Beh, non del tutto, diciamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500120
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500120,
					"content": "Certo, certo. Dopotutto, sei una bambina di buon cuore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500121
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500121,
					"content": "#Proprio come {F#queste due visitatrici}{M#questi due visitatori}, che non offrono il proprio aiuto solo per tornaconto personale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500122
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500122,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500123
					]
				},
				{
					"id": 741500123,
					"content": "Oh, beh... Noi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500124,
					"content": "Suvvia, era una battuta. Non ve la prenderete mica con un vecchietto come me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500125
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500125,
					"content": "I giovani hanno così tanto tempo libero, e voi volete trascorrerlo con me, che adoro stare in mezzo ai giovani... Non c'è niente di sbagliato in questo, dopotutto, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500126
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500126,
					"content": "Forse dovrei darvi qualcosa da fare. La gente va e viene dall'ingresso, lo sporco tende ad accumularsi molto rapidamente ed è da giorni che nessuno dà una spazzata. Per cui, se posso chiedervi un favore, aiutatemi a ripulire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500127
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500127,
					"content": "Beh, d'accordo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500128,
					"content": "Molli, faresti compagnia alla mia gatta? Ah, e porta un filetto di pesce, magari... A proposito, si chiama Nana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500129
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500129,
					"content": "È un nome che ha ereditato da una cagnolina che avevo in precedenza... Purtroppo mia figlia se l'è portata con lei quando si è sposata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500130
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741500130,
					"content": "Va bene, Monsieur Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500131
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500131,
					"content": "#Bene, {F#bimbe}{M#bimbi}, andate pure.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoît Leroy"
				}
			]
		},
