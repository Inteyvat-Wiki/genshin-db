				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪Rosa, oh rosa, esaudisci il mio desiderio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050502,
					"content": "Mmmh? Siete ancora qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050503,
					"content": "Perché vivi qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "Beh, sono un vecchio svitato e \"i vecchi svitati si comportano in modo inspiegabile\". Sono poche le persone che mi fanno le domande che fai tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050505,
					"content": "Ho sempre voluto andarmene e dare una svolta alla mia vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050506,
					"content": "Appena sposato, stavo quasi per andarmene con gli Eremiti, ma poi ci ho pensato su e ho capito che non potevo abbandonare mia moglie per intraprendere una vita da girovago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050507,
					"content": "In seguito, ho incontrato un mercante itinerante e volevo fare affari proprio come lui, ma non ci sono riuscito perché non avevo abbastanza Mora a disposizione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050508,
					"content": "Quando mia moglie è morta, non c'era più nulla che mi trattenesse, ma ormai ero troppo vecchio per andarmene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050509,
					"content": "Ho indugiato fino a oggi, e ora sento di essermi perso così tante cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050510,
					"content": "Col senno di poi, ho capito che non appartengo a questo villaggio, né a nessun altro luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050511,
					"content": "Così alla fine mi sono trasferito ai confini del villaggio e ho scoperto che la vita qui è più confortevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050512,
					"content": "E così sono trascorsi decenni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050525,
					"content": "Probabilmente questi fiori sbocceranno domani o dopodomani. Mi farebbe piacere se ci foste anche voi. Riuscirete a venire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050526,
					"content": "Certo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "Va bene, va bene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050528,
					"content": "♪Rosa, oh rosa, esaudisci il mio desiderio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050513,
					"content": "A proposito del vecchio fantasma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "Solo i forestieri fanno domande sul vecchio fantasma. Tutti i bambini del villaggio lo conoscono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050515,
					"content": "Ogni volta che un bambino si comporta male, i genitori gli dicono: \"il vecchio fantasma verrà a prenderti\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050516,
					"content": "Questi giovani non conoscono affatto il vecchio fantasma, ma sono piuttosto bravi a usare il suo nome per spaventare le persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050517,
					"content": "Quand'ero piccolo, ho incontrato il vecchio fantasma. È vero che non gli piacevano i bambini, ma non era spaventoso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050518,
					"content": "Per qualche motivo la gente ha iniziato a chiamarlo \"vecchio fantasma\". Pensavo che fosse solo un mucchio di persone che parlava di lui alle sue spalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050519,
					"content": "Non eravate amici?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "Da ragazzino, m'intrufolavo nel suo giardino per giocare. Non appena mi vedeva, mi inseguiva con una zappa per scacciarmi via.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050521,
					"content": "Probabilmente pensava che fossi un birbante che voleva causare problemi. Perché avrebbe dovuto ricordarsi di me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050522,
					"content": "Forse non sapeva chi fossi, ma io mi ricordo ancora di lui e del suo piccolo giardino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050523,
					"content": "Quindi suppongo di poterlo considerare mio amico, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050524,
					"content": "Vorrei coltivare gli stessi fiori che coltivava lui, per ricreare quel piccolo giardino rimasto impresso nei miei ricordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320601,
			"completionStepIds": [
				7320601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
