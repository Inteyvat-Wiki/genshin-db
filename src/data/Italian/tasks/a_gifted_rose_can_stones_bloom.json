			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060301,
					"content": "Continuerò a innaffiarli e a concimarli... Ma funzionerà davvero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060302,
					"content": "Ormai non lo so più... *sospira*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060303,
					"content": "Dopo aver temporeggiato così a lungo, ho finalmente deciso di fare qualcosa, ma le cose non vanno per il verso giusto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060304
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060304,
					"content": "Non sono riuscito a esaudire il tuo desiderio, vecchio fantasma. Mi dispiace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060305
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060305,
					"content": "Nonno Affan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060306,
					"content": "Grazie per oggi, bambini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
