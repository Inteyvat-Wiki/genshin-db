			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060101,
					"content": "Oh... Siete voi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060102,
					"content": "Come sta andando con i semi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "Non sono ancora germogliati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060104,
					"content": "Ho esaminato attentamente la superficie dei semi e non c'è nemmeno il minimo accenno di germinazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060105,
					"content": "Come mai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060106,
					"content": "Sono sicuro che i semi sono quelli giusti. Li ho trovati nel magazzino, proprio come è scritto negli appunti del vecchio fantasma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060107,
					"content": "Gli appunti dicevano anche che i semi hanno una durata di conservazione molto lunga, e che se vengono tenuti in un luogo asciutto non andranno mai a male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060108,
					"content": "Inoltre, li ho innaffiati e concimati nel modo corretto... Quindi non capisco proprio perché non siano ancora germogliati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060109,
					"content": "Non preoccuparti. Perché non proviamo ad aspettare un altro po', nonno Affan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060110,
					"content": "Quando noi andiamo a raccogliere frutti e fiori in natura, dobbiamo aspettare diversi giorni perché ricrescano dopo averli raccolti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060111,
					"content": "Bisogna avere pazienza.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "Ah, immagino che non mi resti altro da fare che aspettare. Se oggi avrete un po' di tempo, mi aiuterete a innaffiarli di nuovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060114,
					"content": "Mi ci sono volute ore per ammorbidire il terreno nel vivaio, e ora sono troppo stanco per tornare a prendere l'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060115,
					"content": "Ricevuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060112,
					"content": "Continua a innaffiarli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				}
			]
		},
		{
			"id": 7320603,
			"completionStepIds": [
				7320603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
