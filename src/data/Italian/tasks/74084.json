			"dialogs": [
				{
					"id": 740840801,
					"content": "...Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840802,
					"content": "Pahsiv, cosa ci fai qui? Allontanati dall'Elementosauro! È pericoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840803,
					"content": "Paimon bene, Pahsiv! Pericolo, Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840804,
					"content": "Pahsiv allunga una mano per accarezzare la testa dell'Elementosauro e la bestia furiosa si sdraia obbediente.\\nApre la bocca, sputa una goccia scintillante e poi si tuffa di nuovo in acqua.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "Una chiave! L'Elementosauro la conservava in bocca! Come mai adesso l'ha ceduta spontaneamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840806,
					"content": "Cosa blu, buona! Protegge chiave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840807,
					"content": "La \"cosa blu\" sarebbe l'Elementosauro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "Pahsiv, tu e l'Elementosauro siete amici? Ti stava aiutando a proteggere la chiave?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840809,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840810,
					"content": "Cosa viola, rubato chiave... Cosa blu, svenuta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840811,
					"content": "C-Cosa viola? E chi sarebbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840812,
					"content": "#Cosa viola, cosa cattiva! Cosa blu, Paimon, {NICKNAME}, cosa buona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840813,
					"content": "Ehm... Sì? Suona tutto un po' strano, ma sembrerebbe proprio un complimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840814,
					"content": "Cosa viola, cosa cattiva, Érinnyes, molto Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840815,
					"content": "Vuoi dire che... la cosa viola è una minaccia per l'isola? Beh, almeno adesso abbiamo le chiavi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840816,
					"content": "#Paimon, {NICKNAME}, Pahsiv! Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840817,
					"content": "Chiave, chiave, chiave, piazza, ovest...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840818,
					"content": "Paimon lo sa. Non preoccuparti, Pahsiv. Andremo subito alla piazza a ovest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
