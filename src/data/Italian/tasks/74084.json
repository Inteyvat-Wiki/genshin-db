			"dialogs": [
				{
					"id": 740841201,
					"content": "...Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841202,
					"content": "Pahsiv? Da dove salti fuori?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841203,
					"content": "Scomparsa, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841204
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841204,
					"content": "Va bene, certo, ma stai alla larga da quell'Elementosauro! È pericoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841205,
					"content": "Paimon bene, Pahsiv! Pericolo, Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841206,
					"content": "Pahsiv allunga una mano per accarezzare la testa dell'Elementosauro e la bestia furiosa si sdraia obbediente.\\nApre la bocca, sputa una goccia scintillante e poi si tuffa di nuovo in acqua.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740841207
					]
				},
				{
					"id": 740841207,
					"content": "Chiave, chiave, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841208,
					"content": "Wow! L'Elementosauro ti ha dato la chiave quando l'hai chiesta. Non me l'aspettavo proprio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841209,
					"content": "Cosa blu, buona! Protegge chiave!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841210,
					"content": "La \"cosa blu\" sarebbe l'Elementosauro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841211
					]
				},
				{
					"id": 740841211,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841212,
					"content": "Ti stava aiutando a proteggere la chiave? Tu e l'Elementosauro siete amici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841213,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841214,
					"content": "Cosa viola, rubato chiave... Cosa blu, svenuta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841215
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841215,
					"content": "C-Cosa viola? E chi sarebbe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841216,
					"content": "#Cosa viola, cosa cattiva! Cosa blu, Paimon, {NICKNAME}, cosa buona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841217
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841217,
					"content": "Ehm... Sì? Suona tutto un po' strano, ma sembrerebbe proprio un complimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841218,
					"content": "Cosa viola, cosa cattiva, Érinnyes, molto Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841219
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841219,
					"content": "In ogni caso, Paimon non aveva mai incontrato una Melusina così peculiare... Pensavamo che tutte le Melusine vivessero nella Corte di Fontaine o nel Villaggio di Merusea. Come mai sei qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841220,
					"content": "Corte di Fontaine? Villaggio di Merusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841221
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841221,
					"content": "Sembri confusa. Non hai mai sentito parlare di questi posti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841222,
					"content": "Corte di Fontaine, Melusina... Villaggio di Merusea, Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841223,
					"content": "Ah... Érinnyes, Pahsiv, casa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841224,
					"content": "Érinnyes... Pahsiv, proteggere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841225
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841225,
					"content": "Aspetta, vuoi dire che questa è la tua casa? E che la stai proteggendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841226,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841227,
					"content": "Ma le Melusine non vivono nel Villaggio di Merusea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841228
					]
				},
				{
					"id": 740841228,
					"content": "Sì, è un po' strano. Ci sono Melusine che nascono in altri posti? Paimon, però, non ne vede altre qui in giro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841229,
					"content": "Pahsiv, vivi qui da sola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841230,
					"content": "Sola? Melusina. Niuvilett! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841231
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841231,
					"content": "Visitatore? C'è una persona che ti fa visita? Chi è?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841232,
					"content": "#Quel... visitatore! Paimon, Paimon, {NICKNAME}, {NICKNAME}. Niuvilett, Niuvilett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841233
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841233,
					"content": "Chi è esattamente questo Niuvilett?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841234
					]
				},
				{
					"id": 740841234,
					"content": "Pahsiv... stai cercando di dirci che si chiama \"Niuvilett\", come Paimon si chiama Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841235,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841236,
					"content": "Ah-ah! Paimon aveva ragione. Paimon l'ha sempre detto di essere intelligente, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841237,
						740841238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841237,
					"content": "È un nome molto strano.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841238,
					"content": "È un nome fantastico.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841239,
					"content": "Niuvilett, Pahsiv, conoscenza, bum, sbam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841240
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841240,
					"content": "Ehm... Vuoi dire che questo Niuvilett ti sta insegnando delle cose?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841241,
					"content": "Pahsiv! Tante parole. Sapere. Tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841242,
					"content": "Ehm, Paimon non crede che siano proprio \"tante\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841243,
					"content": "Pahsiv, Niuvilett, proteggere, bum, sbam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841244,
					"content": "E ti aiuta a proteggere questo posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841245,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841246
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841246,
					"content": "Sei tu che lo aiuti a proteggere questo posto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841247
					]
				},
				{
					"id": 740841247,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841248
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841248,
					"content": "Quindi è così... Ma chi è questo Niuvilett? E come mai ha bisogno del tuo aiuto per proteggere questo posto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841249,
					"content": "Anche qui sono successe delle cose brutte. Abbiamo visto che qualcuno ha cancellato l'iscrizione sulla stele di pietra... e c'è anche un sacco di sporcizia... È a causa della cosa viola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841250,
					"content": "Paimon curiosa, Pahsiv! Ma tempo non tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841251
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841251,
					"content": "Chiave, chiave, chiave, piazza, ovest, bum, sbam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841252
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841252,
					"content": "#Saremo velocissim{F#e}{M#i}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841253
					]
				},
				{
					"id": 740841253,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841254
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv fa due salti di gioia e se ne va in tutta fretta.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740841255,
					"content": "Pare che ci rimanga davvero poco tempo, ma almeno abbiamo già due chiavi. Andiamo avanti e troviamo la terza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}