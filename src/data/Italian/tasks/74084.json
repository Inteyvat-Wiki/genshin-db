			"dialogs": [
				{
					"id": 740840605,
					"content": "Attenzione! C'è un Elementosauro vicino all'altare! Sembra stia dormendo, ma sarà meglio essere prudenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840601,
					"content": "Eh? Ma come? Com'è possibile che non ci sia una chiave? Magari l'altare è già stato attivato e qualcuno l'ha presa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840602,
					"content": "Roooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "Elementosauro dormiente"
				},
				{
					"id": 740840603,
					"content": "Oh, no! L'Elementosauro si è svegliato! Scappiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840604,
					"content": "L'Elementosauro vicino all'altare si sveglia di soprassalto con occhi pieni di rabbia e odio...\\nNuotate verso la riva più velocemente possibile, ma la bestia continua a seguirvi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
