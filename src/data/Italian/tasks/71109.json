			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2196.306,
							344.585,
							2034.784
						],
						"pointId": 5063
					}
				]
			},
			"dialogs": [
				{
					"id": 711090201,
					"content": "Woah! Chi si immaginava che un segreto tanto importante fosse stato nascosto in questa sala in rovina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090202,
					"content": "Sul serio, neppure io me lo aspettavo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "Paimon pensa che nemmeno Huang il Terzo sapesse di questo posto... Un attimo, che sia questa la Sala del tesoro Guhua di cui parlano le leggende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090205,
					"content": "#E guarda laggiù, {NICKNAME}: Paimon vede qualcosa che luccica su quella piattaforma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090206,
					"content": "Dev'essere il tesoro!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "Andiamo subito a dare un'occhiata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090207,
					"content": "Potrebbe trattarsi di un... meccanismo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "Forse è questo che intendono quando si dice che \"l'abito non fa il monaco\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110903",
							"2"
						],
						"stepId": 7110903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "\"Infedeli sono i cieli, e rari sono coloro che cercano le loro benedizioni e vengono ascoltati. Il fato è imprevedibile, e pochi sono quelli la cui prosperità perdura... Spesso, la via viene preclusa ai favoriti, e tutti gli altri subiscono una sorte peggiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "Iscrizione scolpita"
				},
				{
					"id": 711090502,
					"content": "...Questo monumento è stato lasciato qui per porre questa domanda alle generazioni future: quando vi ritroverete a un punto morto, cosa farete?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "Iscrizione scolpita"
				},
				{
					"id": 711090503,
					"content": "(Tocca la stele.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "(Vai via.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7110906,
			"completionStepIds": [
				7110906
