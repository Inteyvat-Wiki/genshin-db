							2250.204,
							346.642,
							2187.956
						],
						"pointId": 7885
					}
				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "Eh? Su questa spada sembra esserci un'iscrizione. Fai vedere a Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "\"Accarezzo la lama, cantando continuo ad avanzare, per sterminare i draghi e il loro sangue assaporare. La divina luce, come sinuosa folgore, come frigida onda, sulle montagne sento incombere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Incisioni dell'Antico Spadaccino"
				},
				{
					"id": 711090603,
					"content": "All'ombra del Monte Tianheng, le tigri uccido; nel Mare di Nubi, nella bestia squamosa il mio ferro affondo... Quando farò ritorno, dal successo incoronato, vivremo in pace in quel luogo beato...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Incisioni dell'Antico Spadaccino"
				},
				{
					"id": 711090604,
					"content": "Accanto c'è pure una tavoletta di pietra... Eh? La grafia in basso sembra diversa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "\"...Avrei voluto lasciare qui del buon cibo da mangiare, ma dato che sarebbe andato a male nel giro di qualche tempo, ho deciso di lasciare delle ricette di cucina. Vi assicuro che sono davvero deliziose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Incisione antica"
				},
				{
					"id": 711090606,
					"content": "...A parte quelle, non rimane altro. Solo questa spada e questo magnifico paesaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Incisione antica"
				},
				{
					"id": 711090607,
					"content": "...Cosa bisogna fare quando ci si ritrova in un vicolo cieco? Di certo conoscete già la risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Incisione antica"
				},
				{
					"id": 711090608,
					"content": "...Non prendete... tesoro, lasciando soltanto un... da qui in avanti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Incisione sbilenca"
				},
				{
					"id": 711090609,
					"content": "Possano le mie ultime gesta diventare un simbolo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Incisione sbilenca"
				},
				{
					"id": 711090610,
					"content": "Porca pupazza... Queste righe sono impossibili da leggere, Paimon non ci capisce un Tramontino secco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "In buona sostanza, sta dicendo di non aver portato nulla con sé.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "*singhiozza* Dopo tutta questa fatica, non abbiamo trovato un bel niente di prezioso. E Paimon che ci sperava pure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "A chi lo dici...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Comunque, Paimon non si aspettava che avremmo potuto ammirare un paesaggio del genere in un luogo ridotto in questo stato... È un buon premio di consolazione, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "Tranquilla. Ti preparerò qualcosa da mangiare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#Eh? Dici sul serio?! Allora ci conto, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "Nemmeno io riesco a capire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
			"id": 7110925,
