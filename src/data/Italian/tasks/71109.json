			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wen il Quarto",
					"Huang il Terzo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "*sospira* E pensare che dopo mille anni di storia, il capo custode del clan Guhua si è ridotto a imbrogliare il prossimo per sopravvivere... Che razza di situazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "Wen il Quarto"
				},
				{
					"id": 711092502,
					"content": "Uff... Suvvia. Non sto forse facendo tutto il possibile perché il mio giovane confratello non patisca la fame mentre fa la guardia ai cancelli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "Huang il Terzo"
				},
				{
					"id": 711092503,
					"content": "#E non fare quella faccia. Sei sempre giù di morale... Ma poco fa ti ha fatto piacere vedere di cosa è capace {NICKNAME}, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "Huang il Terzo"
				},
				{
					"id": 711092504,
					"content": "#Quell{F#a}{M#o} {F#sciocca}{M#sciocco} di prima? Fai curiosare la gente in giro in cambio di un po' di riso con carne? E dovrebbe farmi piacere? Se avessi qualche anno in meno, ti schiaffeggerei a morte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "Wen il Quarto"
				},
				{
					"id": 711092505,
					"content": "Ah! Ma se solo pochi anni fa la tua tecnica era inferiore alla mia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "Huang il Terzo"
				},
				{
					"id": 711092506,
					"content": "Comunque sia, ascolta... Noi anziani siamo rimasti in pochi. Cos'altro ci resta da fare se non mettere alla prova potenziali discepoli che potrebbero unirsi a noi? Vogliamo portarci quei libri nella tomba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "Huang il Terzo"
				},
				{
					"id": 711092507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "Wen il Quarto"
				},
				{
					"id": 711092508,
					"content": "Ah... Lascia perdere. Che senso ha fare discorsi così deprimenti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "Huang il Terzo"
				},
				{
					"id": 711092509,
					"content": "#Oh, perché non assaggi il cibo che {F#quelle giovincelle}{M#quei giovincelli} mi hanno preparato? Eheh! È persino meglio della cucina del Ristorante Wanmin! Avanti, dai un morso! Uno soltanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huang il Terzo"
				}
			]
		}
	]
}