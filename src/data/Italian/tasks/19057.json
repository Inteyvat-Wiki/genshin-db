			"trigger": {
				"objectNames": [
					"Etsu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570701,
					"content": "Chiedo scusa per prima, non so cosa mi sia preso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570702,
					"content": "Ah, l'investigatore Heizou? Non sopporta le persone come me, ne sono sicura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570703,
					"content": "Anche se sembra educato e amichevole, so che tratta in modo diverso i detenuti condannati per frode... Ha qualcosa contro di noi, me lo sento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570704,
					"content": "Secondo voi è possibile che qualcuno l'abbia truffato in passato? Impossibile, chi potrebbe mai essere abbastanza furbo da fregare il grande investigatore Heizou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsu"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905702",
