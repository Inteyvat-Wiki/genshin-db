			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kano Nana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "#Ciao, {F#viaggiatrice}{M#viaggiatore}. Mi scuso per mio cugino... di certo vi avrà causato un sacco di problemi. È sempre stato una peste... ma giuro che non ha cattive intenzioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "Kano Nana"
				},
				{
					"id": 190570802,
					"content": "Se esagera, mettetelo pure in riga. E se osa protestare, ditegli che se non obbedisce dovrà vedersela con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kano Nana"
				}
			]
		},
		{
			"id": 1905709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
