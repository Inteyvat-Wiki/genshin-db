			"dialogs": [
				{
					"id": 760710301,
					"content": "Meraviglioso, grazie! Con questo frumento appena raccolto, posso finalmente preparare di nuovo del pane caldo e confortante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710302
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710302,
					"content": "Ora, come promesso, ti insegnerò a preparare il Fungo fantasma. Memorizza bene il procedimento...",
