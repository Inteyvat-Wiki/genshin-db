			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beryna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "Se potessi preparare del buon pane, riuscirei sicuramente a tirare tutti su di morale. Ma con la situazione attuale, non è così facile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710102,
					"content": "Ci sono dei problemi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "Sto cercando di rifare un tipo di pane che mia madre mi preparava quando ero piccola. Assomigliava un po' a un fungo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710106,
					"content": "Da quello che ricordo, per prima cosa si prepara il ripieno cuocendo funghi e bacche, poi lo si inserisce nell'impasto appena lavorato e infine si inforna il tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710107,
					"content": "Ma la parte più importante è usare la farina ricavata dal frumento appena raccolto. È questo che conferisce al pane il suo aroma caldo e confortante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710108,
					"content": "Sono venuta qui sperando di raccogliere un po' di frumento, ma a quanto pare nessuno ha avuto tempo di occuparsi dei campi ultimamente. Ora ci sono ogni sorta di strane creaturine che gironzolano da queste parti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710109,
					"content": "Se ci fosse il signor Valdis, sono sicura che saprebbe come occuparsene, ma io non sono per niente brava in queste cose...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710110,
					"content": "Allora, ehm... potresti aiutarmi a raccogliere del frumento? Me ne serve solo un po'. In cambio, posso insegnarti a preparare del pane caldo ai funghi. Ti prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710103,
					"content": "Ci vediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "Ehi, non andartene. Potresti darmi una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				}
			]
		},
