				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "Com'è andata? Hai gettato la bottiglia nel fiume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261002,
					"content": "Riuscirà ad arrivare fino al Piccolo Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "Eheh. Beh, è piuttosto improbabile, se non impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261004,
					"content": "Quindi abbiamo fatto tutto per niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210261005,
					"content": "Ahah, rilassati. Ho detto che una persona adulta e responsabile l'avrebbe aiutato, ricordi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261006,
					"content": "Hai mai sentito parlare di un posto chiamato Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261007,
					"content": "Alcuni dei miei amici sono imprenditori. Stanno valutando di aprire un'attività fungaiola, quindi andranno lì per svolgere delle indagini di mercato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261008,
					"content": "Ma, come saprete, solitamente le indagini di mercato consentono di ritagliarsi del tempo libero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261009,
					"content": "Dato che il Piccolo Meng vuole viaggiare, posso chiedere a questi miei amici di portare con loro un'altra persona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261010,
					"content": "Non vi preoccupate, organizzerò tutto io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261011,
					"content": "Ho fatto un'altra copia della lettera, che mi servirà per altri scopi. Per quanto riguarda la bottiglia... Lasciala andare per la sua strada, anche se dubito che qualcuno la raccoglierà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261012,
					"content": "Grazie per l'aiuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "Beh, realizzare i sogni dei bambini non è forse un compito che spetta agli adulti? Rilassati e lascia che me ne occupi io.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261015,
					"content": "Ah giusto, dovrei chiedere ai miei amici di vestirsi in modo un po' più adeguato. Non è il caso di spaventare la gente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261013,
					"content": "Perché sei così intenzionato ad aiutare il Piccolo Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
