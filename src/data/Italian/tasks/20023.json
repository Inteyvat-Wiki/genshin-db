				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230201,
					"content": "Ahahah, questo è il momento che aspetto ogni giorno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230202,
					"content": "Pensavo avessi smesso di bere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "Ah! Oh, mi hai spaventato... Pensavo fossi mia moglie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230204,
					"content": "Un bicchierino ogni tanto non fa male a nessuno! E poi, oggi è stata una dura giornata di lavoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230205,
					"content": "Va bene, ho capito! Finisco l'ultima e poi torno a casa. Tanto Eury ha probabilmente già finito di fare la spesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
			"id": 2002303,
			"completionStepIds": [
				2002304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
