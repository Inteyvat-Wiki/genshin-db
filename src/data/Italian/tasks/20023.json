			"dialogs": [
				{
					"id": 200230901,
					"content": "Hai già controllato come sta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230902
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230902,
					"content": "Nimrod è completamente sobrio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230903
					]
				},
				{
					"id": 200230903,
					"content": "...Davvero? È sobrio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230904
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230904,
					"content": "Purtroppo non c'è nessuna prova...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230905
					]
				},
				{
					"id": 200230905,
					"content": "Va bene. Finché non trovi delle prove che sta bevendo, sono felice di credere che sia un uomo cambiato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230906
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230906,
					"content": "Finché non ricevo una prova del contrario, sono sempre disposta a credere nell'innocenza delle persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230907,
					"content": "Ma quando c'è una montagna di prove riguardo a chissà quale misfatto... Allora è davvero una situazione buffa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230908
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230908,
					"content": "Per piacere, prendi questo per il disturbo. Spero che non avrai mai nulla di cui pentirti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		}
	]
