	"talks": [
		{
			"id": 2002301,
			"completionStepIds": [
				2002301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
