			},
			"dialogs": [
				{
					"id": 200230301,
					"content": "Ehi? Posso aiutarti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230302,
					"content": "Parlami di Nimrod.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "È stato qui a bere per ore. Guarda, ecco il suo conto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230304,
					"content": "Se continua così, saremo obbligati a far venire Eury.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230305,
					"content": "Vuoi prenderlo in prestito? Penso che non ci sia niente in contrario... Ma a cosa ti serve?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
			"id": 2002304,
