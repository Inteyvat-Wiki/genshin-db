			"dialogs": [
				{
					"id": 200230401,
					"content": "Hai già controllato come sta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230402
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230402,
					"content": "Questo è il conto di Nimrod della taverna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230403
					]
				},
				{
					"id": 200230403,
					"content": "Tsk. Proprio come pensavo: ci risiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230404,
					"content": "La gente si dimentica di tutto quello che è successo in passato, a meno che non abbia veramente sofferto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230405,
					"content": "Per piacere, accetta questo pagamento per il disturbo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230406,
					"content": "E per quanto riguarda come farla pagare a Nimrod... Ci penserò su.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
