			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "Chissà se si pentirà questa volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230102,
					"content": "Pentirsi di cosa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "Molta gente viene qui ogni giorno per confessarsi e ricevere il perdono degli dèi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230104,
					"content": "Ma se lo dici e basta e non agisci, non pensi sia una perdita di tempo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230105,
					"content": "Prendi Nimrod, per esempio. È venuto qui diverse volte per confessare di fare abuso d'alcol, ma non è cambiato per niente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230106,
					"content": "Se hai tempo, forse puoi passare a vedere come sta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230107,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "Oh, e se sta ancora bevendo, portami delle prove per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230109,
					"content": "A volte i recidivi hanno bisogno di qualche istruzione che li aiuti a correggere i propri modi di fare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230110,
					"content": "Quindi bere è peccato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "Bere in sé non è peccato. Ma è peccato bere al punto da recare indebita angoscia agli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230112,
					"content": "Se tutti si comportassero così senza scrupoli, prima o poi l'intera Mondstadt si ritroverebbe in una situazione molto spiacevole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230113,
					"content": "Quindi, ogni volta che spunta un peccato, bisogna subito stroncarlo alla radice. Ora vai subito a vedere come sta Nimrod.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
		{
			"id": 2002302,
			"completionStepIds": [
				2002302
			],
