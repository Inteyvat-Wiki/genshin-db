			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "Ti dispiacerebbe andare nei campi e vedere se riesci a trovare i miei <color=#00E1FFFF>tre cuccioli di Saurico</color>? Ti prego, riportali da me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "Ehi, tu! Tu, laggiù! Sì, parlo con te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880202,
					"content": "Da quanto cammini veloce, sembra che tu abbia le ali ai piedi... Si vede che sei forte. Sei decisamente una persona che si allena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880203,
					"content": "#Sei {F#una guerriera}{M#un guerriero} della Comunità dell'Abbondanza? Oppure vieni da un'altra tribù?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880204,
					"content": "#Sono soltanto {F#un'avventuriera}{M#un avventuriere} di passaggio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "Capisco, è un peccato. *sospira* Beh, immagino che la comparsa di qualcuno pronto ad aiutarti nel momento più opportuno sia una fortuna che si trova solo nei sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880207,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "Beh, ho una fattoria, come di certo avrai notato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880209,
					"content": "L'ho sempre mandata avanti con le mie sole forze, ma ultimamente sto avendo poca fortuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880210,
					"content": "Qualche giorno fa ho partecipato a un incontro di lotta libera contro un guerriero della tribù e mi sono fatto male alla schiena. Sì, lo so, è stata un'idea parecchio stupida...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880211,
					"content": "Comunque, di conseguenza non solo non riesco più ad aiutare il mio vecchio a liberare nuovi campi, ma non riesco nemmeno più a gestire la mia, di fattoria. In questo momento anche camminare fa male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880212,
					"content": "#Stavo giusto pensando di assumere qualcuno per qualche giorno per farmi dare una mano, e poi sei {F#arrivata}{M#arrivato} tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880213,
					"content": "È un peccato che tu sia solo di passaggio. Il lavoro in fattoria richiede un impegno e una cura giornalieri, quindi se sei da queste parti solo di tanto in tanto, il raccolto andrebbe a male.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880214,
					"content": "Ma al momento non ho le forze per recarmi fino alla tribù per cercare qualcuno. *sospira* A parte i pochi cuccioli di Tatankasauro che ho allevato, non ho proprio nessuno qui ad aiutarmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880215,
					"content": "Negli ultimi giorni quei piccoli mascalzoncelli stanno combinando guai su guai. Se ne stanno tutti e tre a oziare nei campi e non tornano nemmeno da me, se li chiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880216,
					"content": "Potresti farmi un piccolo favore e riportarli qui? Faccio proprio fatica a camminare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880217,
					"content": "Certo, nessun problema.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "Grazie, lo apprezzo molto. Di solito si comportano bene e mi tengono spesso compagnia quando lavoro nei campi. Non so cosa gli sia preso in questi ultimi giorni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880219,
					"content": "Se li chiami a squarciagola, sicuramente... Ehm, quasi sicuramente i miei tre piccoli Saurici torneranno di loro spontanea volontà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880205,
					"content": "Non sono di Natlan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518804",
							"2"
						],
						"stepId": 7518804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "Sono tornati tutti e tre i miei piccoli. Ti ringrazio tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880402,
					"content": "Grazie per la tua gentilezza, viandante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880403,
					"content": "Mi fa ancora male la schiena, ma comunque mi sento molto meglio con i miei piccoli Saurici di nuovo al mio fianco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880404,
					"content": "Non ho grandi ricchezze, ma posso comunque offrirti una piccola ricompensa. Ti prego di accettare questo come segno della mia gratitudine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		}
	]
}