				]
			},
			"dialogs": [
				{
					"id": 741540201,
					"content": "C'è qualcosa di sospetto... Persino Paimon ha capito che c'è sotto qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, tu che sei {F#una tipa scaltra}{M#un tipo scaltro}: cosa dovremmo fare adesso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Benoît ha chiaramente bisogno di aiuto, ma insiste nel dire che non è così...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Allora che ne dici se diamo un'altra occhiata vicino alla casa di Benoît? Non c'era una strana cassa accanto alla finestra sul retro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "C'è nascosto sicuramente qualcosa, e potrebbe essere la prova che stai cercando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "Forse quei due vengono dal Fleuve Cendre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "A giudicare da come hanno reagito, direi che qualcosa bolle in pentola...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "Ho delle teorie, ma nessuna prova a supporto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
