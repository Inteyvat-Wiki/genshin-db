						"pointId": 7528
					},
					{
						"sceneId": 3,
						"position": [
							3582.002,
							435.073,
							4514.881
						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Considerata la vostra perseveranza, non mi aspettavo che avreste lasciato perdere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540702,
					"content": "#Pensavo che sareste {F#corse}{M#corsi} alla Maison de la Garde, ma non l'avete fatto. Pare che abbiate i vostri metodi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540703,
					"content": "Perché state trattenendo Benoît?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "Se devo essere sincero, mi avete parecchio impressionato. Se solo usaste meglio il vostro entusiasmo, vi attenderebbe un futuro radioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540706,
					"content": "È un peccato, perché in questo modo non arriverete da nessuna parte. *sospira* Non avete paura, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540707,
					"content": "Hai scelto la persona sbagliata da intimorire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "Oh? È perché non hai davvero idea di cosa stia succedendo qui o per via della tua convinzione di essere dalla parte della giustizia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540709,
					"content": "A proposito, il mercante affogato di cui parlano le notizie di cronaca si chiamava Brandt. Era sicuramente un tipo molto loquace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540710,
					"content": "Indovina un po'? Secondo l'articolo non è affogato, ma è stato ucciso e gettato nel lago.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540711,
					"content": "Dopo delle indagini lunghissime, lo Spettro Maréchaussée ha stabilito che si è trattato di omicidio, e che l'assassino si è reso colpevole di un crimine orrendo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540712,
					"content": "Così c'era scritto sul giornale. Chissà cos'è successo realmente? Chi era più meritevole di morire: l'assassino o la vittima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540713,
					"content": "Mm... Domanda difficile, e ancora non ho deciso quale sia la risposta giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540714,
					"content": "Comunque sia, sto divagando! Tutto questo non ha nulla a che fare con ciò di cui dobbiamo discutere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540715,
					"content": "Cosa stai cercando di dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540716,
					"content": "Sto dicendo che agire in modo incauto prima di aver compreso appieno la situazione è da stupidi, e potrebbe avere delle sgradevoli conseguenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540717,
					"content": "Osservare qualcuno mentre compie un'ingiustizia e non muovere neanche un dito... Pura follia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Ahah... Beh... Se ci fossimo incontrati in una situazione diversa, forse saremmo diventati amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540720,
					"content": "Anche se mi piace come ragioni, ho delle faccende di cui occuparmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540721,
					"content": "Ho esaurito la pazienza. La prossima volta che vi vedrò curiosare vicino alla mia casa, passerò dalle parole ai fatti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540722,
					"content": "Dopo aver farfugliato qualcosa d'incomprensibile, Athos se ne va.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "Il suo atteggiamento bizzarro ti sorprende, e cominci a chiederti come dovresti porti in quella situazione...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "D'un tratto senti un lieve picchiettio provenire dalla finestra sul retro, seguito da un cigolio quasi impercettibile... Noti un biglietto cadere dalla finestra.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "Il messaggio color marrone sul biglietto sembra essere stato scritto in fretta e furia, probabilmente con del caffè...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "Presto, vediamo cosa dice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540727,
					"content": "È di Benoît!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540728,
					"content": "Sssh!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "...Scusa! In ogni caso, teniamo d'occhio la ciotola del gatto e aspettiamo un suo segnale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540718,
					"content": "Se m'imbatto in un'ingiustizia, agisco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "Qual è la vostra relazione con Benoît?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
