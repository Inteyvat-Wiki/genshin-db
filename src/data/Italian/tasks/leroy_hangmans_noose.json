					},
					{
						"sceneId": 3,
						"position": [
							3598.11,
							435.073,
							4532.42
						],
						"pointId": 7533
					},
					{
						"sceneId": 3,
						"position": [
							3598.08,
							435.073,
							4533.55
						],
						"pointId": 7534
					}
				]
			},
			"dialogs": [
				{
					"id": 741540801,
					"content": "#{NICKNAME}, guarda! È pesce fresco, e il pavimento sembra pulito. Qualcuno deve aver messo in ordine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540802,
					"content": "Di sicuro in casa di Benoît c'è qualcuno. Avviciniamoci per ascoltare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540803,
					"content": "...Ha ragione, non può scomparire così nel nulla. Deve pur farsi vedere fuori, di tanto in tanto... per una passeggiata o cose simili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540804,
					"content": "Se non altro, così eviteremo che i vicini chiamino la Maison de la Garde... Preferirei non avere alle costole i moschettieri della Pattuglia speciale...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540805,
					"content": "Papà, vuoi uscire per una passeggiata, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540806
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540806,
					"content": "P-Posso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540807
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540807,
					"content": "Certamente! E non solo, saremmo lieti di accompagnarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540808
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540808,
					"content": "#Facciamo attenzione... Potrebbe approfittare dell'occasione per chiedere aiuto. {F#Quelle due svitate}{M#Quei due svitati} hanno sorvegliato questo posto come avvoltoi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540809,
					"content": "Papà non lo farà, ne sono sicura.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540810
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540810,
					"content": "Papà, non vuoi che la Maison de la Garde sappia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540811
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540811,
					"content": "...Cosa?! Perché parlano a voce così bassa? Paimon non riesce a sentire una Baccaduta secca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540812,
					"content": "Stanno per uscire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540813
					]
				},
				{
					"id": 741540813,
					"content": "Ok, dobbiamo allontanarci. Stavolta dobbiamo pensare a un modo per parlare con Benoît, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540814,
					"content": "Non hai tutti i torti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540815
					]
				},
				{
					"id": 741540815,
					"content": "Bene, filiamocela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540816,
					"content": "Come va, papà? Ti senti un po' meglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540817
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540817,
					"content": "Siete voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540818
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540818,
					"content": "Benoît...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540819,
					"content": "...Aiutatemi! Uh, voglio dire... Non aiutatemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540820
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540820,
					"content": "Che stai dicendo, papà? Cos'è questo \"aiutatemi, non aiutatemi\"? Eheh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540821
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540821,
					"content": "Oh, siete voi. Ora capisco perché papà abbia fatto di tutto pur di parlarvi... Vi conosce, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540822
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540822,
					"content": "...N-No, non è vero! Non ci conosciamo assolutamente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540823
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540823,
					"content": "No? Ma allora perché ti avrebbero aspettato qui, papà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540824
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540824,
					"content": "#Sono {F#state}{M#stati} così gentili da procurarci i documenti. Sono persino {F#andate}{M#andati} al Fleuve Cendre per parlare con il nostro vecchio vicino Snodgrass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540825
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540825,
					"content": "Penso che siate molto intimi! Non mi meraviglia, ti sono sempre piaciuti molto i bambini, non è vero, papà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540826
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540826,
					"content": "Anche a me piacciono, ma non sono altruista come mio padre. Amo più di tutti mia figlia, peccato che... se ne sia andata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540827,
						741540829
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540827,
					"content": "Cosa state facendo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540828
					]
				},
				{
					"id": 741540828,
					"content": "Athos e io siamo i figli di nostro padre. Papà ci vuole bene, e noi vogliamo bene a lui. Non è ovvio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540831,
					"content": "Morticia, guarda che magnifica giornata. Ideale per una passeggiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540832
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540832,
					"content": "Davvero, Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540833
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540833,
					"content": "Hai letto l'Uccello a vapore di oggi? Ci sono alcune storie davvero interessanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540834
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540834,
					"content": "Oh, cielo. No, non l'ho ancora letto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540835
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540835,
					"content": "C'è un articolo su un vecchietto che ha fatto una brutta fine. Pare che abbia incontrato dei ladri e, non avendo nessuno che si prendesse cura di lui, sembra che caduto da un dirupo e sia morto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540836
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540836,
					"content": "Oh, davvero? Che orrore! Davvero terribile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540837
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540837,
					"content": "E poi ce n'è un altro su uno sfortunato mercante affogato. Sembra che avesse bevuto troppo, abbia camminato nel lago in uno stato di torpore e, niente... è annegato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540838
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540838,
					"content": "Ah! Santi numi! Una vera tragedia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540839
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540839,
					"content": "#E l'ultimo è davvero curioso! Riguarda {F#una}{M#un} ficcanaso che non sapeva farsi gli affari suoi... *sospira* e ha preso la medicina sbagliata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540840
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540840,
					"content": "#Ha bevuto del veleno al posto della medicina, assumendone una quantità enorme! Alla fine è {F#morta}{M#morto} tra atroci sofferenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540841
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540841,
					"content": "Oh, mamma! Ci sono così tanti modi di morire... Per favore, continua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540842
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540842,
					"content": "...Perdono, perdono! Non lo farò mai più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540843
					],
					"speakerTitle": "Benoît Leroy"
				},
				{
					"id": 741540843,
					"content": "Di cosa stai parlando, papà? Non stiamo cercando di dire che sia colpa tua. Ma... devi essere piuttosto stanco dopo aver camminato tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540844
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540844,
					"content": "Athos, perché non torniamo a casa e leggiamo un articolo a papà? Sei abbonato a molti giornali, vero, papà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540845
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540845,
					"content": "Va bene! Abbiamo chiacchierato a sufficienza, meglio tornare indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540846
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540846,
					"content": "Andiamo a casa, papà adorato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540829,
					"content": "Perché l'avete fatto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540830
					]
				},
				{
					"id": 741540830,
					"content": "Vuoi dire perché lo abbiamo accompagnato a fare una passeggiata? Siamo i suoi figli, è un nostro dovere. Non adempiere a una responsabilità tanto basilare sarebbe un modo abietto di ripagarlo, dopo che lui si è preso così tanta cura di noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				}
			]
		}
	]
}