			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722470301,
					"content": "P-Paimon vede qualcosa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470302,
					"content": "Sembra una specie di immagine residua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470303,
					"content": "Il mio nome è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470304
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470304,
					"content": "Aberaku, il Creatore di Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470305
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470305,
					"content": "Ooh, Paimon lo conosce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470306,
					"content": "Quindi, ha detto che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470307,
					"content": "Che è il Creatore di Helios, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470308,
						722470309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470308,
					"content": "Non lo stavi ascoltando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				},
				{
					"id": 722470310,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470311,
					"content": "Aberaku... Che nome strano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470312,
					"content": "Aspetta... Ma se lui è Aberaku, cos'è questo Helios, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470313,
					"content": "Ah, Helios! Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470314,
					"content": "La mia creazione... Helios! La sua luce si diffuse da un orizzonte all'altro, e così il popolo si salvò dal flagello del drago!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470315
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470315,
					"content": "Ah, il modo in cui il popolo posò gli occhi su di esso! Versarono calde lacrime e alzarono le braccia gridando di gioia, non riuscendo a trattenere le loro forti emozioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470316
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470316,
					"content": "No, aspetta. P-Perché sono qui? Perché la mia anima è nel regno dei sogni, e non riesce ad avere pace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470317,
					"content": "Hai capito ora, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470318
					]
				},
				{
					"id": 722470318,
					"content": "Certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470319,
					"content": "Questo spirito sembra... turbato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470320,
					"content": "Ora ricordo: la mia anima è lacerata! Potrò trovare pace solo quando verrà ricostruita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470321,
					"content": "In questo incarico avrai un ruolo fondamentale, quindi ti dico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470322
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470322,
					"content": "Oh-oh, ora arrivano i guai...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470323,
					"content": "Una parte delle mie ossa dovrebbe essere custodita in questo luogo, ma sono ormai marcite da tempo... Per favore, ti supplico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470324
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470324,
					"content": "Porta con te questi oggetti che contengono i miei pensieri residui... Tuttavia, qui vi sono dei mostri che hanno intrappolato la mia anima, e che arriveranno a frotte non appena un oggetto contenente la mia anima verrà spostato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470325
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470325,
					"content": "#È molto rischioso. Dimmi quando sei pront{F#a}{M#o}, viaggiat{F#rice}{M#ore}, e inizieremo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470309,
					"content": "No, il suo nome è Aberaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722470310
					]
				}
			]
		},
