			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rolf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "È meglio che continui a correre, amico! Questo posto è molto pericoloso. Se la Caccia selvaggia dovesse apparire, non posso assicurarti che sarò in grado di proteggerti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920102,
					"content": "Come fai a sapere che apparirà la Caccia selvaggia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "In quanto Guardaluce, occuparmi della Caccia è mio dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920104,
					"content": "Vedi quella Pietra Sigilmarea? Per assicurarmi che la Caccia sia completamente e assolutamente eliminata, devo rimanere di guardia qui per tre giorni e tre notti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920105,
					"content": "Pietra Sigilmarea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "Queste pietre sono sigilli posti da noi Guardaluce per dissipare la permeazione della Caccia selvaggia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920107,
					"content": "Anche se non sono sicuro di come funzioni, se questa diffusione non viene controllata, tende a richiamare la Caccia nello stesso luogo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920108,
					"content": "Ecco perché di solito posizioniamo queste pietre nelle zone dove la Caccia selvaggia è stata respinta. Se la Caccia dovesse tornare, le pietre potranno proteggerci durante il combattimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920109,
					"content": "La Caccia selvaggia non mi fa paura!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "Non so da dove viene tutta questa tua sicurezza, ma la Caccia non è un nemico da sottovalutare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920111,
					"content": "Lascia che ti dia un consiglio. Quando ti imbatti in luoghi con queste Pietra Sigilmarea, faresti meglio a procedere con cautela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920112,
					"content": "Non ti disturberò ulteriormente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "Ci vediamo. Fai attenzione per strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				}
			]
		},
