			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650501,
					"content": "Se non riusciremo a contattare l'Eroe oscuro al più presto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650502
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650502,
					"content": "Cosa facciamo riguardo alla sfida lanciata dall'Ordine dell'Abisso?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650503
					]
				},
				{
					"id": 4650503,
					"content": "Oh, siete voi. Devo ammettere che la questione dell'Eroe oscuro sta diventando un bel problema.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650504
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650504,
					"content": "Abbiamo appena tenuto una riunione per decidere come rispondere. Riuscite a indovinare di che si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650505,
						4650508
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650505,
					"content": "Nascondere la testa nella sabbia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650506
					]
				},
				{
					"id": 4650506,
					"content": "Ahah, divertente... No. I Cavalieri non possono restare a guardare, se esiste anche solo il minimo sospetto di una minaccia nei confronti di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650507
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650507,
					"content": "Se lo facessimo, sempre più persone farebbero affidamento sull'Eroe oscuro piuttosto che sui Cavalieri di Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650511,
					"content": "Bene, allora qual è il piano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650512,
					"content": "Scoprire la vera identità dell'Eroe oscuro e offrirgli la nostra protezione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650513
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650513,
					"content": "\"Protezione\"? A me sembra che finora se la sia cavata piuttosto bene anche senza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650514,
					"content": "Umpf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650515
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650515,
					"content": "Beh, dato che avete aiutato i Cavalieri in passato, immagino di potervelo dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650516
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650516,
					"content": "L'offerta di protezione è solo uno stratagemma per permettere ai Cavalieri di Favonius di assumere piena ed esclusiva responsabilità sulla questione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650517
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650517,
					"content": "Non volete che l'Eroe oscuro faccia le sue... cose eroiche? Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650518,
					"content": "Per prima cosa, per dare prova del potere dei Cavalieri, dimostrando al popolo che può affidarsi a noi per la salvaguardia della pace e dell'armonia in città, anche senza l'Eroe oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650519
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650519,
					"content": "In secondo luogo, l'Ordine dell'Abisso non conosce pietà. Se all'Eroe oscuro dovesse accadere qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650520
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650520,
					"content": "...la cosa finirebbe col facilitare i loro malvagi piani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650521
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650521,
					"content": "Santo cielo! Paimon non pensava che la vita di un cavaliere fosse così piena d'angoscia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650522,
					"content": "Ma il nostro piano non funzionerà, se non riusciremo a identificare in tempo l'Eroe oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650523
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650523,
					"content": "Non disperare, Huffman. Segui il mio piano e vedrai che andrà tutto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650524,
					"content": "Ah, capitano Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650525
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650525,
					"content": "Ultimamente patron Diluc ha lavorato ogni sera al Dono dell'Angelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650526,
					"content": "Voglio solo che tu lo tenga d'occhio. Pensi di potercela fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650527,
					"content": "Sì, capitano Kaeya! Ma... questo significa che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650528
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650528,
					"content": "Che l'Eroe oscuro è patron Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650529
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650529,
					"content": "Chi lo sa? È solo un'intuizione. Ma qualche volta sbaglio anch'io...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650508,
					"content": "Unire le forze con l'Eroe oscuro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650509
					]
				},
				{
					"id": 4650509,
					"content": "No. Se lo facessimo lanceremmo il messaggio che i Cavalieri sono a favore della presenza dell'Eroe oscuro in città... e non è così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650510
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650510,
					"content": "Incoraggiare questi atti di eroismo individuale mina alle basi l'autorità dei Cavalieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				}
			]
		},
