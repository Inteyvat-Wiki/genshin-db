			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650201,
					"content": "Patron Diluc! Abbiamo fatto visita ai Cavalieri di Favonius e... beh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650202,
					"content": "Immagino vogliate avvisarmi della \"dichiarazione di guerra\" dell'Ordine dell'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650203,
					"content": "Lo so già, ma vi ringrazio comunque per aver fatto tutta questa strada per avvertirmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650204,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650205,
					"content": "La rete di spionaggio del Vigneto Prima Luce non si occupa soltanto di questioni commerciali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650206,
					"content": "Fantastico! Allora cos'hai intenzione di fare, patron Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650207,
					"content": "Accetto suggerimenti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650208,
					"content": "Penso che dovresti unire le forze con i Cavalieri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "No. Se lo facessi farei il gioco dell'Ordine dell'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650210,
					"content": "Sanno bene che non siamo in buoni rapporti e stanno usando la cosa per spingermi a uscire allo scoperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650211,
					"content": "Se la mia identità fosse rivelata, tutte le mie future attività sarebbero soggette a qualche tipo di interferenza da parte dei Cavalieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650212,
					"content": "Dopotutto, a nessuna potente organizzazione piace essere messa in secondo piano da qualcuno che non ne fa parte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650217,
					"content": "Uff... L'Ordine dell'Abisso ti ha davvero giocato un brutto tiro, stavolta! Sono proprio una banda di farabutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650218,
					"content": "Esiste una soluzione, ma affinché funzioni mi servono altre informazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650219,
					"content": "In particolare, devo decifrare le parti in codice della dichiarazione di guerra dell'Ordine dell'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650220,
					"content": "Parti in codice? Intendi quelle che Paimon non è riuscita a leggere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650221,
					"content": "Dev'essere un codice che solo i membri dell'Ordine dell'Abisso sono in grado di capire, utilizzato per trasmettere messaggi all'interno dell'organizzazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650222,
					"content": "Ma perché dovrebbero mandarti un messaggio che possono leggere solo loro?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "Non si tratta soltanto di una dichiarazione di guerra, ma anche di un messaggio ai loro membri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650225,
					"content": "Quando prendi una posizione, diventi un eroe per alcuni e un nemico per altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650226,
					"content": "E dato che sono stato un nemico dell'Ordine dell'Abisso per tutto questo tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650227,
					"content": "...hanno fatto di me un bersaglio contro cui radunare le loro truppe e concentrare le loro forze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650228
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650228,
					"content": "Wow... A quanto pare serve un bel cervello per fare il supereroe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650229,
					"content": "Conosco semplicemente il mio nemico. Come dice quell'adagio popolare: \"Eroi e cattivi sono due facce della stessa medaglia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650230,
					"content": "Quindi cosa facciamo con le informazioni scritte in modo incomprensibile? Come facciamo a... \"comprensibilizzarle\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650231,
					"content": "Semplice! Quando non capisci qualcosa... chiedi a qualcun altro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650232
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650232,
					"content": "Ho già individuato una delle loro <color=#00E1FFFF>roccaforti</color>. Se la cosa vi interessa, venite pure con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650223,
					"content": "Se sapevano già che non saremmo stati in grado di leggerlo, allora perché scriverlo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650213,
					"content": "Resta al Vigneto finché le acque non si saranno calmate.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650214
					]
				},
				{
					"id": 4650214,
					"content": "Sarebbe come capitolare di fronte ai Cavalieri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650215,
					"content": "Se fossero stati all'altezza del compito fin dall'inizio, la situazione non sarebbe degenerata fino a questo punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650216,
					"content": "Comunque sia, le cose non sono così gravi da costringermi a nascondermi, lasciando i Cavalieri da soli ad affrontare le conseguenze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				}
			]
		},
