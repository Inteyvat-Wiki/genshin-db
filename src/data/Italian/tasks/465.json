			"dialogs": [
				{
					"id": 4650301,
					"content": "Ci siamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650302
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650302,
					"content": "Rovine abbandonate come questa sono il luogo preferito dall'Ordine dell'Abisso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650303
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650303,
					"content": "Forza, non c'è tempo da perdere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 46504,
			"completionStepIds": [
				46510
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46510",
							"2"
						],
						"stepId": 46510,
						"stateName": "QUEST_STATE_UNFINISHED"
