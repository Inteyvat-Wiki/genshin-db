			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "Huffman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650102,
					"content": "Oh, siete voi! Grazie per aver accettato il mio invito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650103,
					"content": "Allora, avete scoperto qualcos'altro sull'Eroe oscuro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650104,
					"content": "Potremmo prima sapere che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "Ah, sì, certo. Lasciate che vi metta al corrente e scusatemi per i miei modi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650108,
					"content": "La situazione è... Ecco, date un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650109,
					"content": "Wow, che grafia terribile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650110,
					"content": "Mmh... Alcune parti sono del tutto incomprensibili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650111,
					"content": "Esatto. Anche se è scritto nella lingua comune, sembra che l'autore abbia usato una sorta di codice in diversi passaggi del testo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650112,
					"content": "Tuttavia, è comunque possibile afferrare il senso del messaggio dalle parti in chiaro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650119,
					"content": "Si tratta di una dichiarazione di guerra da parte dell'Ordine dell'Abisso nei confronti dell'Eroe oscuro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650113,
					"content": "Cioè... Vuoi dire che i cattivi vogliono che l'Eroe oscuro sparisca per sempre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650114,
					"content": "Più o meno. Ecco perché stiamo cercando di contattarlo il prima possibile per provare a coordinare un piano di risposta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650115,
					"content": "In fondo, la questione non riguarda più solo l'Eroe oscuro, ma l'intera città di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650116,
					"content": "Grazie per l'informazione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "Se scoprite qualcosa, venite a riferirmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650117,
					"content": "Lo terrò presente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "Mi dispiace, ma non abbiamo scoperto nulla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "Un vero peccato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 46502,
