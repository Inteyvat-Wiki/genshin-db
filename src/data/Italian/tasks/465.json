			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Interroga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650401,
					"content": "Come mi avete trovato?! Feccia di Favonius!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4650402,
					"content": "Non sono un Cavaliere di Favonius. E ora comincia a parlare! Qual è il vostro piano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650403,
					"content": "Oh, hai ricevuto la nostra lettera... Ma se pensi che ti rivelerò i nostri segreti, ti sbagli di grosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4650404,
					"content": "Credo che tu non comprenda la situazione in cui ti trovi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651001
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651001,
					"content": "Brucialo con la <color=#00E1FFFF>Mano ardente</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "H-Hai usato una Visione di Pyro per lanciare f-fuoco dalle mani?! Aaaah! Brucia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4650601,
					"content": "Vediamo quanto ci metto a farti parlare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650405,
					"content": "Brucialo di nuovo con la <color=#00E1FFFF>Mano ardente</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "Basta! Basta! Che dolore! Smettila... Ti prego!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4650406,
					"content": "Brucialo di nuovo con la <color=#00E1FFFF>Mano ardente</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "Urgh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4651403,
					"content": "Fingere di essere morto non ti salverà. Quel fuoco non era di certo sufficiente a... Oh, sembra <color=#00E1FFFF>svenuto</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651404,
					"content": "Ehi tu! Dormirai solo quando lo dirò io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651405,
					"content": "Aaaah! Brucia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4650901,
					"content": "Parlerò! Parlerò! Ahi ahi ahi... T-Ti prego, basta! Ti dirò <color=#00E1FFFF>tutto</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4650902,
					"content": "L-L'Ordine dell'Abisso... ha radunato una forza unita dall'odio comune per l'Eroe oscuro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4650903,
					"content": "Marcerà verso le <color=#00E1FFFF>porte della città</color> di Mondstadt alle 22:00 di domani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4650904,
					"content": "È tutto ciò che so... Ti prego, non usare ancora quelle fiamme su di me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "Interroga"
				},
				{
					"id": 4650905,
					"content": "Tutto qui? Beh, suppongo che non saresti tanto stupido da nascondermi qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651201,
					"content": "<color=#00E1FFFF>Interrogalo</color> sui loro piani di attacco.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650901
					]
				}
			]
		},
		{
			"id": 46505,
