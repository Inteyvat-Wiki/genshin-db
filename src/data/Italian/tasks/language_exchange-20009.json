			},
			"dialogs": [
				{
					"id": 200090201,
					"content": "Per fortuna ce n'è uno sveglio proprio ora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090202,
					"content": "Eccolo, andiamo a salutarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090203,
					"content": "Fa' attenzione però, sarebbe da maleducati svegliare gli altri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090204,
					"content": "Bisogna evitare che pensino che stiamo irrompendo nel loro accampamento per attaccarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090205,
					"content": "Altrimenti non vorranno parlare mai con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
