			"dialogs": [
				{
					"id": 760761101,
					"content": "#Salve, {F#amiche}{M#amici}. È un piacere ritrovarvi tra le tombe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761102,
					"content": "Descrivi le \"Lanterne del giuramento\" che hai visto e le parole incomprensibili incise su di esse.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760761103
					]
				},
				{
					"id": 760761103,
					"content": "\"I venti si risvegliano, le foglie volano\"... Questo è il giuramento che le persone pronunciano quando si uniscono ai Guardaluce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761104,
					"content": "Di solito, ognuno di noi porta con sé la propria lanterna, abbandonando il compito di prendersene cura solo quando non c'è altra scelta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761105,
					"content": "Di conseguenza, ogni lanterna senza padrone è un segno di sventura, una tragedia che mi riempie di dolore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761106,
					"content": "Ma sapevano che questo sarebbe stato il loro destino sin dal giuramento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761107,
					"content": "Se c'è qualcosa che possiamo fare per loro, è ricordare i giuramenti che hanno fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760761108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760761108,
					"content": "Il loro più grande desiderio... Era sostenere e difendere le \"lanterne illuminate della speranza eterna\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		}
	]
}