			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Golshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "*sospira* Come faremo a trovare qualcuno che ci aiuti a quest'ora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "#Oh! C-Ciao, viaggiat{F#rice}{M#ore}. Hai bisogno di cure?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060104,
					"content": "Sono solo di passaggio...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "Eheh... è così evidente? Beh, hai ragione: sono preoccupata per qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060107,
					"content": "Non so perché, ma ultimamente sempre più persone vengono al Bimarstan per essere curate. Il nostro personale è molto impegnato con i pazienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060108,
					"content": "Tuttavia, il dottor Zakariya ha insistito affinché trovassi un modo per mantenere pulita l'area circostante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060109,
					"content": "Ha detto che solo se viene garantita la pulizia dell'ospedale e dei pazienti, questi potranno ricevere più facilmente la benedizione dell'Archon di Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060110,
					"content": "*sospira* Ma non c'è nessuno al momento che può aiutarci, e non posso certo chiedere una mano ai pazienti affetti da sintomi lievi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060111,
					"content": "Che ne dici se mi occupo io di pulire?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "Ci aiuteresti davvero? È molto gentile da parte tua! Vado a preparare il tuo compenso. Solo che... forse dovrai ridimensionare le tue aspettative al riguardo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060123,
					"content": "*sospira* Che l'Archon di Dendro protegga le persone dalle malattie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060113,
					"content": "Non puoi assumere qualcuno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "Poche persone sarebbero disposte a lavorare in un posto pieno di malati. Inoltre, il nostro budget non è sufficiente per assumere così tante persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060115,
					"content": "Di solito facciamo i turni per pulire, ma non c'è nessuno disponibile al momento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060116,
					"content": "#Pertanto, viaggiat{F#rice}{M#ore}, potresti... darmi una mano?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060117,
					"content": "Ti ricompenseremo! Non sarà tanto, però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060118,
					"content": "Comunque, di cosa soffrono i pazienti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "La maggior parte dei nostri pazienti è affetta da disturbi lievi, come il mal di testa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060120,
					"content": "Il dottor Zakariya ha detto più volte alle persone che queste condizioni non sono così preoccupanti come si pensa, ma nessuno crede alle sue spiegazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060121,
					"content": "Suppongo che non sia la patologia a incutere timore, ma il fatto di ammalarsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060122,
					"content": "#Le pulizie le affido a te allora, viaggiat{F#rice}{M#ore}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060105,
					"content": "Sembri piuttosto preoccupata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
