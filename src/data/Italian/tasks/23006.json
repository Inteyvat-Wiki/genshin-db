					"speakerTitle": "Golshan"
				},
				{
					"id": 230060402,
					"content": "Sì.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060403
					]
				},
				{
					"id": 230060403,
					"content": "#Non so davvero come ringraziarti, viaggiat{F#rice}{M#ore}. Ecco la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060404
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060404,
					"content": "Di recente il signor Gurgen si sta forzando di nuovo a lavorare. Ci vorrà ancora un po' di tempo affinché riesca a fargli cambiare idea...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060405,
					"content": "Ultimamente abbiamo tante cose di cui occuparci, per cui è possibile che ti chiederò anche la prossima volta di occuparti delle pulizie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
