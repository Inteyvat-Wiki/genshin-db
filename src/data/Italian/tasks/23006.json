			"dialogs": [
				{
					"id": 230060301,
					"content": "#Viaggiat{F#rice}{M#ore}, vorresti chiedermi qualcosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060302,
						230060306
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060302,
					"content": "Puoi dirmi di più su Zakariya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "Il dottor Zakariya è un medico eccellente e un devoto credente dell'Archon di Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060304,
					"content": "Cura i pazienti giorno e notte e a stento ha il tempo di mangiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060305,
					"content": "Il dottor Zakariya ha persino detto che è suo dovere diffondere la benedizione dell'Archon di Dendro a più persone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060306,
					"content": "La benedizione dell'Archon di Dendro è davvero così fondamentale ai fini della guarigione?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "Per la precisione, la \"cura\" stessa è la benedizione dell'Archon di Dendro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060308,
					"content": "È per la grazia dell'Archon di Dendro che siamo riusciti a trovare le cure per i pazienti e a coltivare le erbe per curare le malattie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060309,
					"content": "Archon di Dendro, ti ringraziamo per la tua benedizione. Possano tutti essere protetti dalle malattie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
		},
