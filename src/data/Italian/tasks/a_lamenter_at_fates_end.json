			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110301,
					"content": "Altolà, umani! Non vi ho concesso il diritto di accedere a questo luogo per indagare sul destino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "Apostolo del Destino"
				},
				{
					"id": 80110302,
					"content": "(Un Apostolo dell'Abisso? No, non sembra appartenere all'Ordine...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "Mmh, insistete per essere ricevuti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Apostolo del Destino"
				},
				{
					"id": 80110304,
					"content": "...Molto bene, allora vi conferisco la prova del destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Apostolo del Destino"
				}
			]
		},
		{
			"id": 801104,
			"completionStepIds": [
				801108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
