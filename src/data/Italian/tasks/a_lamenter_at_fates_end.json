					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110501,
					"content": "Penso che... siamo arrivati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110502
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110502,
					"content": "E quella cos'è?!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110503
					]
				},
				{
					"id": 80110503,
					"content": "(Avvolta nelle catene, appesa a mezz'aria, emana un'aura sinistra... Non c'è dubbio: è uguale alla Statua dissacrata!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110504
					]
				},
				{
					"id": 80110504,
					"content": "(Allora c'è davvero un collegamento con l'Ordine dell'Abisso. E questi Hilichurl in adorazione mi ricordano un po' troppo il Gran Razziatore...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110505
					]
				},
				{
					"id": 80110505,
					"content": "Eide, questo posto non mi piace. Dobbiamo andarcene!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110506
					]
				},
				{
					"id": 80110506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110507
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110507,
					"content": "Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110508
					]
				},
				{
					"id": 80110508,
					"content": "O cara creatura, perché t'inchini? È per la paura dell'ignoto? O è per un potere che brami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110509
					],
					"speakerTitle": "Crea"
				},
				{
					"id": 80110509,
					"content": "(Di chi è questa voce? Sembra provenire da dentro la mia testa... Eide non può sentirla?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110510
					]
				},
				{
					"id": 80110510,
					"content": "O cara creatura, perché t'inchini? Non sono un dio... Sono solo un \"Peccatore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110511
					],
					"speakerTitle": "Crea"
				},
				{
					"id": 80110511,
					"content": "(Un \"Peccatore\"...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110512
					]
				},
				{
					"id": 80110512,
					"content": "Sei come un fiore nato nel peccato, ma puro e incorrotto... Conosco bene il tuo destino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110513
					],
					"speakerTitle": "Crea"
				},
				{
					"id": 80110513,
					"content": "Non hai più bisogno di trattenere il tuo risentimento, né di accettare le infinite menzogne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110514
					],
					"speakerTitle": "Crea"
				},
				{
					"id": 80110514,
					"content": "Avanti, trascendi, levati al di là del fato che ti è stato elargito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110515
					],
					"speakerTitle": "Crea"
				},
				{
					"id": 80110515,
					"content": "E verserò una lacrima alla fine dei tempi... osservando la tua vita passata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110516
					],
					"speakerTitle": "Crea"
				},
				{
					"id": 80110516,
					"content": "(...Chi sei? Cosa significano queste parole?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110517
					]
				},
				{
					"id": 80110517,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110518
					],
					"speakerTitle": "Crea"
				},
				{
					"id": 80110518,
					"content": "(La voce... è svanita...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110519
					]
				},
				{
					"id": 80110519,
					"content": "!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110520
					]
				},
				{
					"id": 80110520,
					"content": "...Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110521
					]
				},
				{
					"id": 80110521,
					"content": "*ansima* Cos'è successo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110522
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110522,
					"content": "Quando ho visto quella cosa il mio cuore ha trovato immediatamente la pace... S-Sono stato travolto da un senso di meraviglia... o di gioia, perfino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110523
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110523,
					"content": "È tutto a posto, ora?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110524
					]
				},
				{
					"id": 80110524,
					"content": "Sì... Mi sento bene, in effetti... Anche meglio di quando sono arrivato qui. Che cosa strana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110525
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110525,
					"content": "Questo posto non mi convince. Dobbiamo andarcene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110526
					]
				},
				{
					"id": 80110526,
					"content": "Oh, d-dici? D'accordo, come vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110527,
					"content": "Uscite dalla caverna infausta e tornate alla casa di Eide.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 801106,
			"completionStepIds": [
				801111,
				801112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801111",
							"2"
						],
						"stepId": 801111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110601,
					"content": "Caribert! Oh, meno male, non gli è successo nulla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110602,
					"content": "Non dobbiamo ancora andare dalla Statua dei Sette?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "Io... ho la strana sensazione che quanto è appena successo non sia stato un caso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110605,
					"content": "Se è accaduto proprio quando temevo di dover adorare una Statua dei Sette... è come se il destino mi avesse chiamato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110606,
					"content": "Hai detto che mi sono inchinato dinanzi a quell'oggetto, quindi forse... potrebbe funzionare allo stesso modo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110607,
					"content": "Mi sembra un'idea ridicola...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "Devo provare, costi quel che costi. L'hai detto anche tu: devo tentarle tutte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110610,
					"content": "Somministrate un'altra dose della medicina all'Hilichurl...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "Caribert...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110613,
					"content": "...P-Papà...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110614,
					"content": "*sussulta* Caribert! Oh, santo cielo, ha funzionato! È un miracolo!!! Oh, Caribert, figlio adorato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110615,
					"content": "Non posso crederci...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "Visto?! Ha funzionato! Caribert può parlare di nuovo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110618,
					"content": "Dov'è... la mamma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110619,
					"content": "La mamma è... Caribert, guardami. Sai chi sono?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110620,
					"content": "Sì... Tu sei papà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110621,
					"content": "Ahahahah... Sì! Ahah... Redenzione, dolce redenzione... Sì, ecco cosa si prova...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110622,
					"content": "Come ti senti, Caribert? Sei completamente sveglio ora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110623,
					"content": "Sì, è come se mi fossi svegliato da un sonno lunghissimo. Ho sognato che mi stavo nascondendo in una stanzetta. Non osavo uscire e nemmeno lo volevo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110624,
					"content": "Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110625,
					"content": "Il mio corpo! Cosa mi è successo? Questo... sono io?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110626,
					"content": "Papà, che cos'ho?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110627,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110628,
					"content": "...Non agitarti, tesoro mio. È solo che... mentre stavi dormendo siamo finiti in un mondo fiabesco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110629,
					"content": "Khaenri'ah non esiste più, abbiamo perso la nostra casa. Ma sai questo cosa significa? Mai più cieli vermigli... Basta fine del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110630,
					"content": "In questo mondo dovrai essere un piccolo mostro... ma papà sarà sempre al tuo fianco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110631,
					"content": "Sono... morto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110632,
					"content": "No, no, certo che no! Guarda, Caribert... Hai ancora il foulard della mamma sul braccio. Questo vuol dire che lei sta ancora vegliando su di te e ti sta proteggendo. Come potresti essere morto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110633,
					"content": "Davvero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110634,
					"content": "Sì, davvero! Ti sei appena svegliato, e dev'essere tutto molto confuso per te. Per ora riposati qui... Le cose andranno meglio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110635,
					"content": "Oh, e... mmh, devi promettermi una cosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110636,
					"content": "Non toglierti mai la maschera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110637,
					"content": "Capito? Qualsiasi cosa accada, non devi toglierla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110638,
					"content": "Va bene, papà... Non lo farò, promesso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110639,
					"content": "Padre e figlio parlano per un po'. Dopo la sua esperienza religiosa, Eide sembra un uomo diverso...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "È da quel giorno che non sono più stato così felice... Non posso credere che stia succedendo per davvero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110641,
					"content": "Già...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "Umpf, sapevo che riporre le mie speranze nei Sette sarebbe stato uno spreco di tempo... Ho persino venerato una di quelle loro statue come uno stupido. Non mi ero mai abbassato a tanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110644,
					"content": "Chi è un assassino lo rimane per sempre... Sono stato un ingenuo a pensare che gli dèi che avevano cospirato contro di noi mi avrebbero concesso la redenzione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110645,
					"content": "Ma il dio che abbiamo visto in quella caverna... Quello sì che era potente! Non come i Sette!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110646,
					"content": "Quel potere prodigioso... era davvero abbagliante... Sarà stato per quello che mi sono prostrato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110647,
					"content": "Mmh, orbene... Dopo che si è supplicato un dio, e il dio ha risposto esaudendo le preghiere, si dovrebbe, ehm... fare qualcosa per mostrargli devozione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110648,
					"content": "La pietà non è propriamente la mia area di competenza... ma dovrei sicuramente onorare il dio che ha esaudito i miei desideri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110649,
					"content": "Ma Eide... Quello non era un dio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "Un \"Peccatore\"? Non dire assurdità. Non sai nulla di lui... Come osi proferire una tale blasfemia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110652,
					"content": "Siamo stati entrambi testimoni del suo potere divino. Quand'è che i Sette hanno compiuto un miracolo del genere? Mai... Lui è più potente di loro! E lo definisci un \"Peccatore\"? Assurdo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110653,
					"content": "Non importa... Credi a ciò che vuoi. Non riuscirai a scuotere la mia fede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110654,
					"content": "Gli renderò omaggio... Con o senza di te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110655,
						80110656
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110655,
					"content": "Ma tu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110657,
					"content": "(L'esperienza di Eide lo ha profondamente colpito... Non che fosse molto equilibrato neanche prima, ma questo suo... fervore religioso non è normale...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110658
					]
				},
				{
					"id": 80110658,
					"content": "(Comunque, immagino che sarà meglio raggiungerlo. Ci sono mostri dappertutto... Non posso lasciare che finisca tra le loro grinfie.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110656,
					"content": "Bene, fa' pure.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110657
					]
				},
				{
					"id": 80110650,
					"content": "Era... un \"Peccatore\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110642,
					"content": "È incredibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110616,
					"content": "È stupefacente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
