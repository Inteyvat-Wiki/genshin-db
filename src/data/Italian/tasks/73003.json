			"dialogs": [
				{
					"id": 730030101,
					"content": "#Sono davvero felice che siate venut{F#e}{M#i} con me. A ogni modo, dovrò riferire a Tighnari dell'espansione della zona di Avvizzimento qui vicino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030102
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030102,
					"content": "Eh? Ma quello... non è il bambino del Villaggio di Vimara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030103,
					"content": "Eh? Iotham! Aspetta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				}
			]
		},
		{
