				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#Mi dispiace... {NICKNAME}, Paimon, ho bisogno di riposare... Aspettami, Iotham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030802,
					"content": "Rana, sei sicura di star bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030803,
					"content": "Andiamo a cercare aiuto...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "No, no, sto bene... Ho solo bisogno... di riposarmi un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030805,
					"content": "Mi dispiace, Rana... Mi dispiace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030806,
					"content": "Uffa... Quante volte devo ripeterlo? Sto bene! Ma sono molto arrabbiata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030807,
					"content": "Mi avevi promesso... che non saresti andato nella foresta. Quando mi sarò ripresa, ti darò una bella lezione... piccola canaglia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030808,
					"content": "Aaah... Ho sentito Alphonso dire che qui ci sono dei funghi giganti! E volevo portarti dei funghi freschi da mangiare... così avresti recuperato le energie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030809,
					"content": "Sciocchino... Non ce n'era bisogno. Pensare a voi già mi dà energia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030810,
					"content": "A ogni modo, ahahah... È vero, ci sono dei funghi giganti qui... Sono sicura che sarebbero deliziosi con il curry...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030811,
					"content": "Alphonso ti ha lasciato venire qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "No... Alphonso mi aveva detto di non scappare. Ma volevo dare a Rana qualcosa di buono da mangiare, e così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030813,
					"content": "Alphonso non glielo avrebbe mai permesso, è il fratello maggiore di Iotham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030814,
					"content": "Paimon capisce... Ma Iotham, come sei rimasto intrappolato nella zona di Avvizzimento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030815,
					"content": "Quando ero nella foresta, pensavo che qualcuno mi stesse seguendo... Mi sono spaventato, pensavo fosse l'Avatar di Marana... Così, ho continuato a correre... *singhiozza*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030816,
					"content": "E alla fine mi sono imbattuto in Marana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030817
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030817,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030818,
						730030823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030818,
					"content": "\"Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "È... l'Avvizzimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030820,
					"content": "Ah... già, l'Avvizzimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030821,
					"content": "\"Avatar di Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "Proprio così. Fa accadere cose brutte per conto del Marana... È una cosa grossa e nera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030828,
					"content": "Marana... Che nome buffo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030829,
					"content": "Mmmh... Come facevo a sapere che il Marana è l'Avvizzimento? Accidenti... mi gira la testa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030830,
					"content": "Iotham, cos'era quella cosa verde che ho visto poco fa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030832,
					"content": "È l'Ararakalari... Può proteggere le persone dalla corrosione del Marana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030833,
					"content": "Ci sono sempre più cose che non capisco...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "Questa è... una sorta di magia della foresta, ma è anche una specie di musica... È un Ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030835,
					"content": "Di che si tratta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "Non preoccuparti, Rana, hai bisogno di riposare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030838,
					"content": "Ce l'ho sulla punta della lingua, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030839,
					"content": "Mi dispiace, Rana, mi dispiace... Non scapperò mai più in quel modo, farò il bravo e rimarrò a casa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030840,
					"content": "Lo so. Diventerai intelligente, sano e saprai distinguere il bene dal male... È come riconoscere quali funghi si possono mangiare e quali no...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030841,
					"content": "Lo so, lo so... Mi dispiace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030842,
					"content": "#Saprai che il Marana è il male e... la foresta è il bene... Diventerai una persona forte e buona, aiuterai le persone che hanno bisogno di aiuto... Proprio come {NICKNAME} e Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030843,
					"content": "E ricordati: la foresta non dimenticherà...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030844,
					"content": "Aaah, così non va affatto bene. Paimon pensa che le condizioni di Rana stiano peggiorando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030845,
					"content": "Vado a cercare aiuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "Eh? Oh... Sto bene, davvero... Ho solo bisogno di riposare un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}, riporta indietro Iotham... fallo per me...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030849,
					"content": "Ok. Andiamo, Iotham. Non ti muovere, Rana! Torniamo subito!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030846,
					"content": "Rana, aspettaci.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030837,
					"content": "Lascia stare per ora, riposati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030838
					]
				},
				{
					"id": 730030823,
					"content": "\"Avatar di Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030824
					]
				},
				{
					"id": 730030824,
					"content": "Proprio così. Fa accadere cose brutte per conto del Marana... È una cosa grossa e nera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030825
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030825,
					"content": "\"Marana\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030826
					]
				},
				{
					"id": 730030826,
					"content": "È... l'Avvizzimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030827
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030827,
					"content": "Ah... già, l'Avvizzimento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Iotham"
				}
			]
