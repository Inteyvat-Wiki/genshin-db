						730030713,
						730030715
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030713,
					"content": "Non è quella cosa che abbiamo visto prima?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030714
					]
				},
				{
					"id": 730030714,
					"content": "Fiuuu... Hai spaventato Paimon! Paimon pensava che fossi una verdura parlante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030716,
					"content": "Non verdura, Arana. Gli Aranara sono amici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030717,
						730030722
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030717,
					"content": "\"Aranara\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030718
					]
				},
				{
					"id": 730030718,
					"content": "Eh? Hai detto Aranara? Ora che Paimon ti guarda attentamente, Paimon pensa che ti abbiamo già visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030719,
					"content": "\"Arana\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030720
					]
				},
				{
					"id": 730030720,
					"content": "Paimon crede che abbiamo già sentito questo nome durante il racconto di Iotham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030721,
					"content": "Sì. Nara Iotham è amico di Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030727,
					"content": "#Gli Aranara sono figli della foresta, noi viviamo con alberi. Non come te, Nara {NICKNAME}. Tu sei figli{F#a}{M#o} del dente di leone, sempre in viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030728
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030728,
					"content": "#Come fai a sapere il nome di {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030729,
					"content": "Non importante come Arana sa. Ma Arana vuole aiutare Narana, questo molto importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030730,
						730030732
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030730,
					"content": "Narana... Sembra uno scioglilingua.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030731
					]
				},
				{
					"id": 730030731,
					"content": "Vuoi aiutare Rana? Cosa vuoi che facciamo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030733,
					"content": "#Grazie, Nara buon{F#e}{M#i}. Lei è amica molto importante di Arana. Quindi, Arana la proteggerà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030734
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030734,
					"content": "#Ma non basta. Per curare Narana, ci serve Bija. Nara {NICKNAME} deve andare nel Vanarana e chiedere aiuto a tutti per trovare Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030735,
						730030736
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030735,
					"content": "Bija...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030737,
					"content": "Narana è stata infettata da Marana, molto grave. Insettacci rosicchiano radici di albero. Albero appassirà, frutti marciranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030738
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030738,
					"content": "Vita dei Nara è come albero. Insetti cattivi come Marana. Solo Bija può far stare meglio Narana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030739
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030739,
					"content": "Uhm... Quindi, dobbiamo andare in un posto chiamato \"Vanarana\" e trovare un modo per ottenere il Bija, giusto? Così Rana potrà guarire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030740
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030740,
					"content": "Sì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030741,
						730030744
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030741,
					"content": "Allora le condizioni attuali di Rana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030742
					]
				},
				{
					"id": 730030742,
					"content": "Non preoccupare. Arana sarà qui e combatterà corrosione di Marana. Così, condizioni di Rana non peggioreranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030743
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030743,
					"content": "Ma senza Bija, condizioni di Rana non miglioreranno nemmeno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030745
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030745,
					"content": "Seguite sentiero di foresta, continuate a seguire luogo da cui arriva acqua, poi raggiungerete il Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030746
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030746,
					"content": "Poi cantate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030747,
						730030748
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030747,
					"content": "Cantare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030750
					]
				},
				{
					"id": 730030750,
					"content": "(Una melodia affiora nella mia mente...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030751
					]
				},
				{
					"id": 730030751,
					"content": "Questa è Melodia del Gran Sogno. Cantatela per entrare nel Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030752
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030752,
					"content": "Entrate nei nostri sogni, nel nostro mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030748,
					"content": "Così attireremo i Malefiori...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030749
					]
				},
				{
					"id": 730030749,
					"content": "#Nara {NICKNAME}, molto divertente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030750
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030744,
					"content": "Capito. Come facciamo ad arrivarci?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030745
					]
				},
				{
					"id": 730030736,
					"content": "Che cos'è?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030732,
					"content": "Come posso aiutare?",
