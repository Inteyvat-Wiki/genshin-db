				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030201,
					"content": "Iotham... Cos'è successo...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030202,
					"content": "#Aaah! Rana... E {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030203,
					"content": "Eh? Cosa ci fate in una... zona di Avvizzimento...? E ci sono così tanti mostri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030204,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030205,
					"content": "Lascia fare a me.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "No... Non c'è tempo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030208,
					"content": "#Maledizione! {NICKNAME}, proviamoci insieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030209,
					"content": "Iotham, aspetta li e non muoverti! Ora veniamo a salvarti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030206,
					"content": "Cos'è quella cosa verde...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				}
			]
		},
		{
