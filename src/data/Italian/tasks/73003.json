						730030704
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030704,
					"content": "Cosa sta succedendo qui...? Forse è quell'Ara-coso di cui parlavano Iotham e Rana? Non ricordo come si chiama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030705,
						730030708
					],
					"speakerTitle": "Paimon"
