			},
			"dialogs": [
				{
					"id": 730030301,
					"content": "Fiuuu... Ah... Finalmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030302,
					"content": "Rana... Aaah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030303,
					"content": "Iotham... Va tutto bene, ometto, non c'è motivo di piangere. Ascolta... Se riuscirò a raccontare ciò che è successo nella zona di Avvizzimento... a quei ricercatori dell'Akademiya... loro si sbarazzeranno dell'Avvizzimento una volte per tutte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030304,
					"content": "#E poi... Mi hai vista... combattere? Anzi, no... Hai visto {NICKNAME} combattere? Mi raccomando, ricordati di ringraziarl{F#a}{M#o}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030305,
					"content": "Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030306,
					"content": "Dai, può bastare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Rana, è meglio che ti riposi un po'...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030309,
					"content": "Ah... ahah... Va tutto bene. Mi sento solo un po' frastornata, tutto qui. E un po' stanca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030310,
					"content": "Rana... Mi dispiace...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030311,
					"content": "D... Di cosa stai parlando? Sei il mio tigrotto, quindi basta piangere! Stai bene, vero? Ti fa male qualcosa, Iotham...? Ti senti stordito, debole o...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030312,
					"content": "Io sto bene, ma tu, Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030313,
					"content": "Non è niente... Starò bene. In fin dei conti, sono una Guardiana della foresta temprata da molte battaglie! Andiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030308,
					"content": "Vado a cercare aiuto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
