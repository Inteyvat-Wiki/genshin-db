			"dialogs": [
				{
					"id": 730031101,
					"content": "#Grazie al cielo eri qui, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031102,
						730031103
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031102,
					"content": "Non preoccuparti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031105
					]
				},
				{
					"id": 730031105,
					"content": "A quanto pare Alphonso non stava scherzando, quei Fatui sono davvero pericolosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031106
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031106,
					"content": "A ogni modo, ne parleremo dopo. Iotham deve essersi addentrato nella grotta, proseguiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031103,
					"content": "Hai combattuto bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031104
					]
				},
				{
					"id": 730031104,
					"content": "Davvero? Eheh, sarà perché c'eravate tu e Paimon al mio fianco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031105
					],
					"speakerTitle": "Rana"
				}
			]
