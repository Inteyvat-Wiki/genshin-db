			"dialogs": [
				{
					"id": 730030501,
					"content": "#Iotham? Perché tu... e {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030502
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030502,
					"content": "Abbiamo poco tempo, quindi faremo in fretta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030503,
					"content": "Spieghi rapidamente cos'è successo.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730030504
					]
				},
				{
					"id": 730030504,
					"content": "...Capisco. Iotham, vai a riposarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030505
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030505,
					"content": "Ok. Mi dispiace, Alphonso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030506
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030506,
					"content": "#Non preoccuparti, l'importante è che tu stia bene... Aspettami qui un momento, {NICKNAME}. Verrò con te non appena avrò preparato qualche medicina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030507
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030507,
					"content": "Non c'è tempo. Ecco il posto, raggiungilo il prima possibile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030508
					]
				},
				{
					"id": 730030508,
					"content": "Sì, dobbiamo affrettarci a tornare per prenderci cura di Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030509
					],
					"speakerTitle": "Paimon"
