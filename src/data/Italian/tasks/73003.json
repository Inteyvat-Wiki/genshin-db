					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "Sì, giusto! Paimon crede che abbiano detto che è in grado di contrastare la corrosione del Marana o qualcosa del genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030707,
					"content": "Sì. Nara è intelligente. Ararakalari può contrastare Marana.",
					"roleType": "TALK_ROLE_NPC",
