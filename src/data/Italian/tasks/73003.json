					"nextDialogs": [
						730030733
					]
				},
				{
					"id": 730030722,
					"content": "\"Arana\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030723
					]
				},
				{
					"id": 730030723,
					"content": "Paimon crede che abbiamo già sentito questo nome durante il racconto di Iotham...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030724,
					"content": "Sì. Nara Iotham è amico di Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030725
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030725,
					"content": "\"Aranara\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030726
					]
				},
				{
					"id": 730030726,
					"content": "Eh? Hai detto Aranara? Ora che Paimon ti guarda attentamente, Paimon pensa che ti abbiamo già visto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030715,
					"content": "Verdura...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "Scusa, puoi ripetere?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "Paimon crede che abbiano detto che è in grado di contrastare la corrosione del Marana o qualcosa del genere... Aveva un nome buffo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030710,
					"content": "Si chiama Ararakalari. Può combattere Marana. Ararakalari. NON è un nome buffo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				}
			]
		},
		{
