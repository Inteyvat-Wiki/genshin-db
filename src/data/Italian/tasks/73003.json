			},
			"dialogs": [
				{
					"id": 730031001,
					"content": "...Chi siete voi? Non osate intralciarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031002
					],
					"speakerTitle": "Sergente dei Fatui"
				},
				{
					"id": 730031002,
					"content": "Tsk, dovrei essere io a farvi questa domanda! Faccio parte dei Guardiani della foresta, qui, e sto cercando un bambino scomparso. Dichiarate i vostri nomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031003,
						730031004
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031003,
					"content": "Sono i Fatui! Ma da dove arrivano?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031005
					]
				},
				{
					"id": 730031005,
					"content": "Eh? Quindi loro sono i Fatui di cui parlava Alphonso? Dichiarate le vostre intenzioni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031006
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031006,
					"content": "Alphonso...? Non importa, sappiate che non ve ne andrete di qui senza prima combattere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031007
					],
					"speakerTitle": "Sergente dei Fatui"
				},
				{
					"id": 730031007,
					"content": "Beh, sembra che stavolta non riusciremo a risolverla con le parole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031004,
					"content": "Sono i Fatui. Fa' attenzione.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031005
					]
				}
			]
		},
