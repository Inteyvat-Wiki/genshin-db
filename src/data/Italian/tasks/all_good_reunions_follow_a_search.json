			"dialogs": [
				{
					"id": 752470301,
					"content": "*sospira*... Ce l'abbiamo fatta, finalmente! Che lavoraccio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470302,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470303,
					"content": "Oh, tu devi essere Cacasha! Tu e Cacucu siete una coppia spettacolare! E Paimon lo sa bene, dato che anche lei fa parte di un duo formidabile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470304,
					"content": "Notevole, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470305,
					"content": "Capisci cosa intendo? Quando quei due uniscono le forze, batterli è quasi impossibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470306,
					"content": "Cacucu, posso dichiarare ufficialmente che ti sei guadagnato il tuo certificato in \"arte della mimesi\". D'ora in poi, potrai autodefinirti \"Maestro camaleonte\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470307,
					"content": "Oh, wow! Sei un grande, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470308
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470308,
					"content": "Ehi, e a me niente? Abbiamo giocato insieme un sacco di volte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470309
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470309,
					"content": "Sei un grande anche tu, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470310
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470310,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470311
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470311,
					"content": "Ah... Credo che voglia darci qualcosa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470312
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470312,
					"content": "Cacasha mostra un Uovo regalo al resto del gruppo...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						752470313
					]
				},
				{
					"id": 752470313,
					"content": "Oh! Un'altra di quelle uova, e anche un'altra foto. Credo di aver visto questo simbolo da qualche parte al Mercato Dolcebrezza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470314
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470314,
					"content": "Amico, pare che abbiamo un'altra sfida da affrontare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470315
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470315,
					"content": "Oh? Che sia una sorta di caccia al tesoro segreta organizzata dal resort? Voglio vedere dove va a parare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470316
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470316,
					"content": "Affrontala, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470317
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470317,
					"content": "Cacucu sembra davvero divertito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470318,
					"content": "#Beh, non sarebbe un'avventura senza {NICKNAME} e Paimon! Che ne dici, ti va di scoprire dove ci porterà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470319,
					"content": "Assolutamente sì! Vediamo dove va a parare!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470320
					]
				},
				{
					"id": 752470320,
					"content": "E va bene, a quanto pare non ho scelta: dovrò unirmi a voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				}
			]
		},
		{
			"id": 7524704,
			"completionStepIds": [
				7524704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7524704",
							"2"
						],
						"stepId": 7524704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ifa",
					"Challwa"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							412.321,
							207.098,
							13921.28
						],
						"pointId": 11895
					}
				]
			},
			"dialogs": [
				{
					"id": 752470401,
					"content": "Trovato! Avevamo ragione sul Mercato Dolcebrezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470402
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470402,
					"content": "Mercato Dolcebrezza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470403
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470403,
					"content": "Calmati, scricciolo. Lo so che sei euforico, ma prima dobbiamo capire la situazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470404
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470404,
					"content": "Ahem... Avvicinatevi, gentili clienti! Scegliete una di queste uova e lasciate che la fortuna vi guidi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470405
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470405,
					"content": "Potete provarle gratuitamente! Che cosa ne dite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470406
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470406,
					"content": "Oh, allora è qui che voleva condurci la foto. Dev'essere il posto da cui provengono le Uova regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470407,
					"content": "Beh, hihi... A questo punto, lasciamo che la fortuna ci guidi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470408,
					"content": "P-Prego, avvicinatevi! Le Uova regalo sono pronte per la raccolta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470409
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470409,
					"content": "Uhm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470410
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470410,
					"content": "Dopo di te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470411
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470411,
					"content": "Ma che, davvero, amico? Non dirmi che credi alla \"sfortuna dei primi\"? E va bene, come ti pare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470412
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470412,
					"content": "Asha della fortuna, donatemi qualcosa di buono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470413
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470413,
					"content": "Woah, dei Saurocracker! Buoni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470414,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470415
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470415,
					"content": "Pfff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470416
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470416,
					"content": "Non ti piacciono i Saurocracker, Ifa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470417,
					"content": "Oh, non fraintendete, ci piacciono un sacco; più che altro, se parliamo di Uova regalo, come premio non sono esattamente un granché.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470418
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470418,
					"content": "Mah, onestamente, l'importante è che abbiano un buon sapore. Ecco, prendetene uno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470419
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470419,
					"content": "Sfotti quanto vuoi, amico. Col cavolo che ti aiuto, se ti becchi una di quelle Uova magmatiche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470420
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470420,
					"content": "Impossibile. Aiutare le persone è un tuo bisogno naturale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470421
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470421,
					"content": "Duuunque... C'è qualche rituale speciale da eseguire, prima di aprire l'uovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470422,
					"content": "Qualsiasi cosa pensi ti porti fortuna, suppongo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470423
					]
				},
				{
					"id": 752470423,
					"content": "Capito. \"Squadra di pattugliamento del Clan Piumafiore, aprire il fuoco!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470424
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470424,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470425
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470425,
					"content": "Woah, una confezione di \"CantoBene\", la specialità del Clan Piumafiore... Pare che quel rituale abbia funzionato davvero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470426,
					"content": "Ottimo! Mi va bene tutto, tranne la Zuppa mistica. Ne ho davvero abbastanza di quella roba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470427
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470427,
					"content": "Questo barattolone di caramelle è più che ben accetto! Prendete e mangiatene tutti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470428
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470428,
					"content": "Sei un grande, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470429,
						752470431
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470429,
					"content": "Dopo aver fatto incetta di Saurocracker, Cacucu prende una caramella e la mastica col becco.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470430
					]
				},
				{
					"id": 752470430,
					"content": "Lo zucchero dà sempre una scarica d'energia...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470431,
					"content": "Ora tocca a Paimon! Mmh, cosa potrebbe dire come buon auspicio... Aaah, ma certo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470432,
					"content": "Ahem... \"Primo premio, primo premio! Paimon vuole il primo premio!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470433,
					"content": "Hihi... Oh! È la bevanda che non voleva Ororon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470434,
					"content": "Buon per te, Paimon! Hai vinto qualcosa che puoi goderti da sola!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470435
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470435,
					"content": "Ah, giusta osservazione. Bene, più roba per Paimon! Hihi, l'assaggia subito...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470436,
					"content": "Ah, dolce e rinfrescante! Perfetta per questa stagione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470437,
					"content": "Bene, allora siete rimasti solo voi due... Chi vuole andare per primo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470438
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470438,
					"content": "Niente fretta, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470439,
						752470440
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470439,
					"content": "Allora vado prima io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				},
				{
					"id": 752470441,
					"content": "#In bocca al lupo, {NICKNAME}! E non dimenticarti la frase di buon auspicio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470442,
					"content": "(Una frase di buon auspicio, eh...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470443
					]
				},
				{
					"id": 752470443,
					"content": "(Inspira profondamente...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470444
					]
				},
				{
					"id": 752470444,
					"content": "Brigata dell'avventura di Benny, a raccolta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470445
					]
				},
				{
					"id": 752470445,
					"content": "Delle Gemme scintillanti... Wow, di nuovo qualcosa di dolce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470446,
					"content": "Eheh, mi ricordano di quando ho accolto la mia discepola sotto la mia ala...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470447
					]
				},
				{
					"id": 752470447,
					"content": "#Sembra che {F#Altra Nonna}{M#Nonno} si sia {F#immersa}{M#immerso} in qualche bel ricordo. Direi che è stata un'estrazione fortunata...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470448
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470448,
					"content": "Bene, Cacucu, tocca a te. Mostragli quello che sai fare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470449
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470449,
					"content": "Ahahah... Metticela tutta, amico! O almeno... cerca di fare meglio di Ifa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470450
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470450,
					"content": "Sì, sì, come ti pare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470451
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470451,
					"content": "Andiamo, amico! \"Piacere di conoscerti, amico!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470452
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470452,
					"content": "Wow... Che roba è?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470453
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470453,
					"content": "Ho vinto! Ho vinto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470454
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470454,
					"content": "Oh, ma guarda un po'!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470455
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470455,
					"content": "Ahem... E abbiamo il vincitore! Congratulazioni al signor Cacucu per essere il terzo cliente del giorno a ricevere il primo premio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470456
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470456,
					"content": "Oltre ai nostri esclusivi Paninetti Asha, siamo lieti di offrire al signor Cacucu una porzione di ogni piatto disponibile nelle nostre Uova regalo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470457
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470457,
					"content": "Ma che, davvero, amico?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470458
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470458,
					"content": "Già! Ma che, davvero, amico?! Paimon non credeva che a vincere sarebbe stato proprio Cacucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470459,
					"content": "Ahah, complimenti, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470460
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470460,
					"content": "Cacucu, bello mio... Ah, no, mio buon signore. Avrei un'umile richiesta da farti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470461
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470461,
					"content": "Dicono che basti una stretta di mano per scambiarsi la fortuna. Ti dispiace se...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470462
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470462,
					"content": "Ahah! Fai pure, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470463,
						752470466
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470463,
					"content": "Tutti seguono l'esempio di Ororon e danno a Cacucu una stretta d'ala.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470464
					]
				},
				{
					"id": 752470464,
					"content": "La sensazione è contagiosa e, nel giro di pochi secondi, tutti iniziano anche ad accarezzargli la testa.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470465
					]
				},
				{
					"id": 752470465,
					"content": "È così morbido e rotondo... Vorresti che momenti simili non finissero mai.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470466,
					"content": "Hihi, ora Paimon dovrebbe avere fortuna a sufficienza fino alla fine dell'anno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470467,
					"content": "#Ci puoi contare, Paimon. In fondo, hai {F#una compagna}{M#un compagno} di viaggio molto speciale. Proprio come Cacucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470468
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470468,
					"content": "C-Che hai da guardarmi così...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470469
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470469,
					"content": "Beh, questo era il tuo piano, vero? Non credi sia il momento di confessare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470470
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470470,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470471
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470471,
					"content": "Eh? Di che stai parlando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470472,
						752470473
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470472,
					"content": "Un momento, quindi la fortuna di Cacucu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470474,
					"content": "Ok, ok. Non è nulla di che, d'accordo? Questo scricciolo è molto fortunato ad avere un amico come me, e si vede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470475
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470475,
					"content": "Smettila di girarci attorno e ammettilo: ci sei tu dietro ogni cosa, dico bene? La pesca, il nascondino, tutto quanto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470476
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470476,
					"content": "Beh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470477
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470477,
					"content": "Questo significa che conoscevi già l'avventuriere di Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470478
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470478,
					"content": "No, non esattamente. L'ho incontrato un giorno prima di te e gli ho chiesto di indicarmi la direzione giusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470479
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470479,
					"content": "E sì, ho escogitato la faccenda delle foto affinché Cacucu potesse giocare con l'Asha e i capibara. E ho anche organizzato l'estrazione delle uova.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470480
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470480,
					"content": "Cavoli, amico...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470481
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470481,
					"content": "Ahah... Il Re dei capibara sembra aver frainteso, però. In fin dei conti, un animale selvatico non è in grado di comprendere tutto quello che gli si dice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470482
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470482,
					"content": "Credo abbia pensato che stessimo cercando di rubare le cose che avevo preparato per Cacucu, e questo l'ha fatto arrabbiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470483
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470483,
					"content": "Ah, quindi si chiama davvero \"Re dei capibara\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470484
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470484,
					"content": "Certo che no! Ma ho voluto usare il nome che gli avevi dato tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470485
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470485,
					"content": "Oh, wow, amico! Sono commosso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470486
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470486,
					"content": "...Beh, questo è quanto! Siamo vicini all'anniversario in cui io e Cacucu ci siamo conosciuti, così volevo fare qualcosa di speciale per lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470487
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470487,
					"content": "Non sappiamo quand'è il vero compleanno di Cacucu, quindi abbiamo sempre usato questo anniversario come data per festeggiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470488
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470488,
					"content": "A Cacucu piace darsi arie da fratellone adulto e responsabile, ma in realtà è ancora un piccolo Saurico che si diverte a giocare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470489
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470489,
					"content": "Lo so che sei uno scricciolo in tutto e per tutto, bello. Quindi divertiti pure quanto vuoi, intesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470490
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470490,
					"content": "Amici, amici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470491
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470491,
					"content": "Oh, hai qualcosa da aggiungere, Cacucu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470492
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470492,
					"content": "Amici, non è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470493
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470493,
					"content": "Amico, non devi dirlo. L'abbiamo capito. Ti vogliamo bene anche noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470494
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470494,
					"content": "Già, non vergognarti, amico. Finché siamo in questo posto, sei libero di dare sfogo al Qucusauro selvatico che è in te. Non pensare a niente se non a divertirti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470495
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470495,
					"content": "Buon anniversario, Cacucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470496
					]
				},
				{
					"id": 752470496,
					"content": "Amici! Amici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470473,
					"content": "Era dovuta tutta a...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470440,
					"content": "È giusto che il migliore di noi vada per ultimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				}
			]
		},
		{
			"id": 7524750,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
