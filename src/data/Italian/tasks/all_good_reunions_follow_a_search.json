						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ifa",
					"Ororon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752475001,
					"content": "Beh, sei contento, bello? Ti sei divertito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475002,
					"content": "Oh, wow, amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475003,
					"content": "Credo abbia detto di sì. Buon compleanno, amico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475004,
					"content": "Oh, ora che ci penso... Amico, perché non mi hai parlato del piano? Sul serio, amico, tra amico e amico non dovrebbero esserci questi segreti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475005,
					"content": "Ahah... A dire il vero, volevo vedere se ti saresti ricordato dell'anniversario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475006,
					"content": "Tsk... Sei cambiato, Ifa. Come posso fidarmi di te se tradisci così un amico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475007,
					"content": "Eheh... Beh, peggio per te: me lo sono ricordato, come vedi. Ho messo da parte un po' di miele fresco per Cacucu. So a cosa andrei incontro se mi dimenticassi dell'anniversario... e non voglio farmi beccare in testa per tutto l'anno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475008,
					"content": "Non succederà, amico! Sei un grande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		},
		{
			"id": 7524751,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7524704",
							"3"
						],
						"stepId": 7524704,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cacucu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752475101,
					"content": "#Ciao di nuovo, {F#amica}{M#amico}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475102,
					"content": "Prima stavo cercando di dire a Ifa che ha sbagliato la data.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475103,
					"content": "Ma ho preferito evitare. Immagino che essere maturi significhi anche sapere quando lasciar correre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		}
	]
}