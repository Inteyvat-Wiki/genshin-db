			"dialogs": [
				{
					"id": 752470101,
					"content": "Il posto mostrato nell'immagine dovrebbe essere questo. Guarda, ci sono Ororon e Ifa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470102,
					"content": "Ehilà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470103,
					"content": "Ah, sembra proprio che sia arrivata una Paimon felice. Fantastico! Allora non dovremo stare all'erta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470104
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470104,
					"content": "Come se una \"Paimon arrabbiata\" potesse nuocere in qualche modo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470105
					]
				},
				{
					"id": 752470105,
					"content": "#Urgh! Bada a come parli, {F#bella}{M#bello}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470106,
					"content": "Se serve, ti basta darle qualcosa da mangiare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470107
					]
				},
				{
					"id": 752470107,
					"content": "Ehi! Paimon non è Cacucu! Non si lascia mica comprare con qualche biscottino...! Anche se, beh, di sicuro aiuterebbe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470108,
					"content": "Sapete che c'è? Non importa! Oggi Paimon è di buonumore, e non intende guastarsi la giornata a causa vostra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470109,
					"content": "Un momento, a proposito di Cacucu... Dov'è? Il Re dei capibara non se lo sarà mica mangiato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470110,
					"content": "Che? Ma ti ascolti quando parli, amica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470111
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470111,
					"content": "Cacucu si è unito al nemico per maltrattarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470112
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470112,
					"content": "Maltrattarvi? Cacucu? Ahahah, questa è bella, Ororon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470113,
					"content": "Guarda che non era una battuta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470114
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470114,
					"content": "Eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470115,
					"content": "E chi sarebbe questo \"nemico\" di cui parli?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470116
					]
				},
				{
					"id": 752470116,
					"content": "Ha detto di chiamarsi \"Cacasha\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470117,
					"content": "Aspetta, quindi vuoi dire che è un Asha? Un Asha parlante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470118,
					"content": "Woah, frena. Ororon sta un po'... esagerando. Lasciate che vi spieghi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470119,
					"content": "Cacucu è andato a, ehm... giocare a nascondino qui intorno insieme a un Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470120
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470120,
					"content": "E con questo, intendiamo che sono in combutta contro di noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470121,
					"content": "Cacucu è veloce e Cacasha può camuffarsi... Abbiamo a che fare con un avversario molto astuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470122,
					"content": "Abbiamo giocato con loro per un bel po', prima che arrivaste voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470123
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470123,
					"content": "Cacucu è formidabile a questo gioco, parola mia. E sono estremamente fiero di lui, ma ammetto che mi sta sfiancando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470124
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470124,
					"content": "È colpa tua, non hai frequentato il corso dell'allenatrice Iansan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470125
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470125,
					"content": "*sospira* La cosa certa è che setacciare tutta quest'area per trovare quegli scriccioli è una vera impresa... Ho la schiena che implora pietà!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470126
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470126,
					"content": "È normale. Colpa tua che non hai frequentato il corso dell'allenatrice Iansan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470127
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470127,
					"content": "...Sì, sì, ho capito! Inizierò ad andarci una volta tornati a casa. Contento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470128,
					"content": "Ehi, non fareste meglio ad andare in cerca di Cacucu e Cacasha, invece di starvene qui a bisticciare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470129,
					"content": "Beh, in realtà pensavo che potremmo approfittare del limone che ci è appena caduto tra le mani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470130,
					"content": "Ti riferisci di nuovo... a me?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470131
					]
				},
				{
					"id": 752470131,
					"content": "Mh-mh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470132,
					"content": "Va bene, ci penso io.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470133
					]
				},
				{
					"id": 752470133,
					"content": "#Sei grande, {F#Altra Nonna}{M#Nonno}! E anche tu, Nonna Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470134
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470134,
					"content": "Divertitevi, e chiamateci se vi serve aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470135
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470135,
					"content": "Aspetta, pensavo che anche noi saremmo stati degli Asha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470136
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470136,
					"content": "Oh, no... Ti prego, non dire a Paimon che volete nascondervi insieme a loro e costringere noi a cercarvi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470137,
					"content": "Esatto! Da adesso in poi, io sono \"Orasha\" e lui è \"Ifasha\". Dobbiamo andare a nasconderci. Buona fortuna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470138
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470138,
					"content": "Cosa? Ma che...?! Argh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470139
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470139,
					"content": "Scusate tanto. Vi spiacerebbe assecondarlo solo per un po'?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470140,
						752470141
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470140,
					"content": "Niente affatto. È divertente!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				},
				{
					"id": 752470142,
					"content": "#Grazie mille, {F#belle}{M#belli}! Allora corro a nascondermi anch'io!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470141,
					"content": "Non preoccuparti! Per tua fortuna, sono in perfetta forma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				}
			]
		},
