			"dialogs": [
				{
					"id": 790550101,
					"content": "Questa è una scena tagliata dello spettacolo \"Naufragio d'amore\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790550102,
					"content": "Originariamente, la storia parlava di due Eidolon di Hydro che s'innamorano su una barca che sta naufragando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790550103,
					"content": "Dopo essersi dichiarati il loro amore, si soffermano sulla prua della barca illuminata dal bagliore residuo del tramonto. La scena è estremamente romantica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790550104,
					"content": "Tuttavia, questa scena è stata abbandonata perché... gli Eidolon di Hydro che recitavano quella parte erano troppo carichi d'energia, e non riuscivano a stare fermi un attimo nello stesso punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790550105,
					"content": "Se solo riuscissi a riprenderli <color=#00E1FFFF>sulla prua della barca contemporaneamente</color>, la scena sarebbe perfetta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "Appunti di scena"
				},
				{
					"id": 790550106,
					"content": "— Regista",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Appunti di scena"
				}
			]
		},
