			"dialogs": [
				{
					"id": 721300101,
					"content": "La strana lanterna di pietra sembra emettere un'energia sinistra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721300102,
					"content": "Questa lanterna di pietra mette i brividi... Ma ha un'aria familiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300103,
					"content": "Oh, qualcuno ha lasciato un messaggio sul lampione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300104,
					"content": "\"Ai soldati che presidiano questo luogo: per qualunque domanda su questo amuleto, contattate il signor Kaji nella Valle di Musoujin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721300105,
					"content": "Il testo sembra recente, ma la pioggia l'ha rovinato. In basso si leggono distintamente alcune parole scritte in piccolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721300106,
					"content": "\"Non credete a questi strani messaggi. Non c'è tempo da perdere! Deve trattarsi di un trucco del nemico per rallentarci.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721300107,
					"content": "\"Chi lascerà la squadra senza permesso verrà severamente punito!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "Esamina"
				},
				{
					"id": 721300108,
					"content": "Questo signor Kaji sembra molto preoccupato per via delle lanterne di pietra. Perché non lo raggiungiamo nella Valle di Musoujin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
