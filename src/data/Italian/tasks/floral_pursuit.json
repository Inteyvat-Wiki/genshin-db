			"dialogs": [
				{
					"id": 705280401,
					"content": "*sospira* La Gilda può davvero farsi carico di lavori così grandi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280402,
					"content": "#Ah, viaggiat{F#rice}{M#ore}! Le mie scuse per non averti notat{F#a}{M#o} prima. Stavo pensando alla Gilda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280403,
					"content": "Devi esser qui a Mondstadt per il Festival del Florvento, immagino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280404,
					"content": "Sei giusto in tempo: la Gilda ha appena escogitato un nuovo gioco, divertente e con dei premi in palio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280405,
					"content": "Che ne dici? Vuoi provarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280406,
					"content": "Adesso permettimi di presentarti questo piccolo gioco. La persona che l'ha progettato lo ha chiamato \"Scacchi floreali\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280407,
					"content": "Ha detto di esser stata ispirata dai petali fluttuanti e dal vento che li insegue...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280408,
					"content": "E il gioco è pensato per imitare il... romanticismo legato all'inseguimento dei petali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280409,
					"content": "Ma che bella... storia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "Beh, questo inventore è un bardo, per cui ha... molta fantasia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280412,
					"content": "In soldoni, quando giochi a questa variante degli scacchi, devi raccogliere quanti più Palloncini floreali possibili sulla scacchiera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280413,
					"content": "Dovrai evitare vari ostacoli nel mentre... e ci saranno anche degli attrezzi a portata di mano che ti forniranno del supporto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280414,
					"content": "Quel tipo ha perfino scritto un manuale intero per il gioco, a cui potrai dare uno sguardo in seguito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280415,
					"content": "Se ti interessa, gioca pure. Ricorda, basta partecipare per vincere dei premi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280410,
					"content": "È abbastanza complicata...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
