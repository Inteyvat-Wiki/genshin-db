			"dialogs": [
				{
					"id": 4610612,
					"content": "Vorrei chiederti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610602
					]
				},
				{
					"id": 4610602,
					"content": "Ehi! Sai qualcosa delle Rovine di Arcadia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610603,
					"content": "Arcadia... Non credo di averne mai sentito parlare. Mi dispiace, sono nuovo qui, quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610604,
					"content": "Davvero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610605,
					"content": "Ma potete provare ad affiggere una richiesta per vedere se qualche avventuriere ne sa qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610606,
					"content": "La risposta è un NO grande come una casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610607,
					"content": "Non possiamo rischiare che arrivino al tesoro prima di noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610608,
					"content": "(Ecco, l'ha fatto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610609
					]
				},
				{
					"id": 4610609,
					"content": "Dici sul serio?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610610
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610610,
					"content": "Ebbene, terrò gli occhi aperti per il vostro tesoro... Voglio dire, per le Rovine di Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610611
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 4610611,
					"content": "Fantastico! Grazie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
