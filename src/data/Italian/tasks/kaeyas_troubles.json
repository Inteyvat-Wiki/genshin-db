					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610404,
					"content": "Uff! Non siamo qui per faccende così noiose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610405,
					"content": "Cerchiamo una spada caduta da Celestia... Una spada che può uccidere banshee a otto teste e idre dai capelli d'argento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610407,
					"content": "Vorrai dire idre a otto teste e banshee dai capelli d'argento...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610408
					]
				},
				{
					"id": 4610410,
					"content": "Hai già parlato troppo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610411
					]
				},
				{
					"id": 4610406,
					"content": "È super, mega, iper potente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610407,
						4610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610408,
					"content": "È esattamente quello che ha detto Paimon! È una spada super epica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610409,
					"content": "Comunque, va tutto bene. Basta che Paimon non dica loro dove si trova il tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610411,
					"content": "Va tutto bene! Basta che Paimon non dica loro dove si trova il tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610413,
					"content": "(Ecco, l'ha fatto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610414
					]
				},
				{
					"id": 4610412,
					"content": "Allora, Cyrus, sai per caso dove potremmo trovare le Rovine perdute di Arcadia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610414,
					"content": "Rovine di Arcadia... Mai sentite nominare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610415
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 4610415,
					"content": "Grazie comunque per le informazioni. Se doveste trovare queste rovine, mi piacerebbe vederle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610416
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 4610416,
					"content": "Ehm... le... informazioni...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610429,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
