			"dialogs": [
				{
					"id": 4610513,
					"content": "No. Siamo qui per...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610502
					]
				},
				{
					"id": 4610502,
					"content": "No. Vogliamo solo sapere se sei mai stato alle Rovine di Arcadia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610503,
					"content": "Rovine di Arcadia? Ma pensa... Allora ci sono dei posti in cui non sono ancora stato...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610504
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610504,
					"content": "Eh? Nemmeno il grande Stanley ne sa niente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610505,
					"content": "Lasciate perdere questa Arcadia... Dovreste sentire cosa mi è capitato nel Mare Jivari e nel Regno dei geyser...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610506
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610506,
					"content": "Non abbiamo tempo per le tue storie. Pensaci bene, per favore. Abbiamo bisogno di indizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610507,
					"content": "Il Mare Jivari... Era un luogo di morte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610508
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610508,
					"content": "Urgh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610509,
					"content": "Quando troveremo il <color=#00E1FFFF>tesoro</color> di Arcadia, la nostra sarà certamente una storia molto più avvincente delle tue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610510,
					"content": "(Ecco, l'ha fatto...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610511
					]
				},
				{
					"id": 4610511,
					"content": "Tesoro...? E anche epiche gesta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610512
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 4610512,
					"content": "Bah! È una perdita di tempo parlare con lui. Andiamocene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
