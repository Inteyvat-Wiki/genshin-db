			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610101,
					"content": "Non va bene... Che seccatura... E ora cosa faccio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610102,
					"content": "Cosa c'è che non va, Kaeya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#Oh, grazie ai Mille Venti! {NICKNAME}, il tuo arrivo è una benedizione degli dèi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610105,
					"content": "#Se posso permettermi, {F#emissaria inviata}{M#emissario inviato} dal Dio di Anemo per salvare questo semplice mortale, avresti un momento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610106,
					"content": "Ehi, dacci un taglio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610107,
					"content": "Non posso dire di non avere tempo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "Benissimo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610110,
					"content": "Non posso permettere che i miei compagni lo vengano a sapere! Sei l'unica persona a cui posso rivolgermi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610111,
					"content": "Coraggio, troviamo un posto più adatto a confidenze di questo genere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610112,
					"content": "Andiamo a parlare nel cortile appena fuori dal quartier generale. Seguitemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610113,
					"content": "Perché tutta questa circospezione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610109,
					"content": "Raccontami cos'è successo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "Di solito non perdi la calma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46109",
							"2"
						],
						"stepId": 46109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "Qui può andar bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610202,
					"content": "Dicci di che si tratta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610203,
					"content": "Da dove posso iniziare... Oh, giusto, prima vi svelo un segreto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610204,
					"content": "È un segreto che appartiene al mio passato e confido che saprete mantenerlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610205,
					"content": "Non preoccuparti, le labbra di Paimon sono sigillate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610206,
					"content": "Vedete, mio nonno era un pirata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610207,
					"content": "Oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610208,
					"content": "...Aspetta, perché quel tono divertito? Pensate che me lo stia inventando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610209,
					"content": "Vedete questa benda sull'occhio? L'ho ereditata da mio nonno. È la prova concreta di un legame di sangue!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610210,
					"content": "Non avevo mai sentito dire che si potesse ereditare una benda sull'occhio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#Cielo! {NICKNAME}, come fai a non sapere una cosa così universalmente nota?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610212,
					"content": "È un po' come quando i bambini ereditano il taglio di capelli dai loro genitori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610214,
					"content": "Ieri stavo dando un'occhiata ad alcuni appunti lasciati da mio nonno, e mi sono imbattuto in certe annotazioni che parlavano di un <color=#00E1FFFF>tesoro</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610215,
					"content": "...Un tesoro?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610216,
					"content": "Secondo i suoi appunti, il tesoro è sepolto tra le \"Rovine perdute di Arcadia\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610217,
					"content": "Un tesoro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610218,
					"content": "Ma, al momento, nessuno sa dove si trovino. Ho provato a cercare indizi, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610219,
					"content": "Un tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610220,
					"content": "Kaeya! Di che tipo di tesoro si tratta? Oro? O meglio ancora, gemme?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610221,
					"content": "Uff! Oro e gemme sono tesori da rigattiere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610222,
					"content": "Il tesoro di mio nonno è una spada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610223,
					"content": "Una spada magica che conferisce a chi la impugna un potere senza pari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610224,
					"content": "Oh, caaavoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610225,
					"content": "Una divinità fece cadere la spada in mare da Celestia. In seguito, il caso volle che proprio l'equipaggio di mio nonno la ritrovasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610226,
					"content": "Nel momento stesso in cui afferrò la spada, i tuoni rimbombarono, le onde urlarono e il blu terso del cielo fu improvvisamente inghiottito da venti impetuosi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610227,
					"content": "Con il potere della spada magica mio nonno riuscì a sconfiggere un'idra, una banshee dai capelli d'argento e un malvagio drago degli abissi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610228,
					"content": "Ma quell'immenso potere attirò un gran numero di avidi pirati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610229,
					"content": "Per evitare inutili conflitti, mio nonno nascose la spada magica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610230,
					"content": "Idre a otto teste, banshee dai capelli d'argento... Esistono davvero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "Il mondo in cui viviamo è così affascinante, pieno di meraviglie sconosciute e inspiegabili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610233,
					"content": "Queste avventure elettrizzanti sono storie romantiche che solo i pirati possono raccontare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610234,
					"content": "Santo cielo! È incredibile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610235,
					"content": "Ultimamente, un gruppo di <color=#00E1FFFF>Cacciatori di tesori</color> si è dato molto da fare, ha spogliato diverse rovine delle loro reliquie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610236,
					"content": "Temo che presto scopriranno le Rovine di Arcadia e la spada magica sarà perduta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610237,
					"content": "Non permetteremo che cada nelle mani sbagliate! Dobbiamo trovare la spada prima che lo facciano loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610238,
					"content": "#Stai pur certo che Paimon e {NICKNAME} ti daranno una mano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610239,
					"content": "Wow!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610240
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610240,
					"content": "Fantastico! E, per favore, deve rimanere un segreto. Aspetterò buone notizie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610241
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610241,
					"content": "#Ehi! Allora che ne pensi, {NICKNAME}? Non è emozionante? Una spada dal potere travolgente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610242,
						4610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610242,
					"content": "Ma sarà tutto vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610244,
					"content": "Beh... Andiamo alla <color=#00E1FFFF>Gilda degli avventurieri</color> e cerchiamo altre informazioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610245,
					"content": "Gli avventurieri dovrebbero essere ben informati sulle rovine, giusto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610243,
					"content": "Proprio tutto vero?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610232,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610233
					]
				},
				{
					"id": 4610213,
					"content": "Sorprendente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610214
					]
				}
			]
		},
