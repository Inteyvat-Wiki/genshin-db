			"dialogs": [
				{
					"id": 4610801,
					"content": "#Oh, siete {F#tornate}{M#tornati}. Ci sono novità?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610802
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610802,
					"content": "Abbiamo chiesto alla Gilda degli avventurieri e abbiamo scoperto... Beh, un bel niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610803,
					"content": "Ahah... Come mi aspettavo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610804
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610804,
					"content": "Perché?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610805,
					"content": "Beh, che divertimento ci sarebbe se fosse tutto facile?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610806
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610806,
					"content": "A ogni modo, ho qualche indizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610807
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610807,
					"content": "Ho mandato qualcuno a cercare informazioni al mercato nero. Sembra che lì abbiano sentito parlare delle Rovine di Arcadia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610808
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610808,
					"content": "Davvero? Chi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610809,
					"content": "Piano, piano. Come da regole del mercato nero, per evitare fughe di notizie, manderanno loro qualcuno a parlare con noi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610810
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610810,
					"content": "Incontreremo l'informatore alla Foresta dei Sussurri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610811
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610811,
					"content": "Allora, cosa stiamo aspettando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610812,
						4610815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610812,
					"content": "Non è opportuno che Kaeya mostri il suo volto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610813
					]
				},
				{
					"id": 4610813,
					"content": "Esatto. Mi hai letto nel pensiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610814
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610814,
					"content": "Sono un cavaliere... Non dovrei avere nulla a che fare con il mercato nero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610816
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610816,
					"content": "I miei ringraziamenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610817
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610817,
					"content": "Ovviamente, i Cavalieri vi ricompenseranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610818
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610818,
					"content": "Oh, nessun problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610815,
					"content": "Ti riferiremo le informazioni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610816
					]
				}
			]
		},
