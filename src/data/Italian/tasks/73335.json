			"dialogs": [
				{
					"id": 733350801,
					"content": "Niente male, Sorush! Hai ridato vigore a quest'area in pochissimo tempo, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350802,
					"content": "I poteri delle Pari sono alquanto affascinanti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350803
					]
				},
				{
					"id": 733350803,
					"content": "Ovviamente, molte Pari sanno molto bene come portare in vita i fiori di Sunyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350804
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350804,
					"content": "In parole semplici, anche se il Segno di Apaosha è scomparso, questo fiore di Sunyata non si è ripreso dalla sua corrosione ed è ancora estremamente debole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350805
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350805,
					"content": "Gli altri stagni floreali probabilmente non verranno risparmiati. Questo dev'essere un fatto sconvolgente per Sefana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350806
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350806,
					"content": "Questa Sefana di cui parli dev'essere una brava Pari che lavora sodo per prendersi cura dei fiori!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350807,
					"content": "#Dovremmo andare ad aiutarla, che ne dici, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350808,
					"content": "Per me non è troppo difficile e sarà d'aiuto a Sefana. Yasnapati, per favore sorveglia questi fiori di Sunyata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350809
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350809,
					"content": "Ti farò sapere quando ne vedrò.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350810
					]
				},
				{
					"id": 733350810,
					"content": "Sì! Salviamo questi bellissimi fiori assieme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
