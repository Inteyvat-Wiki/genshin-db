					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600401,
					"content": "Un momento... Sembra che abbiamo abbastanza Fiordolci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200600402,
					"content": "Li portiamo a <color=#00E1FFFF>sorella Jilliana</color>? O vuoi raccoglierne ancora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2006005,
			"completionStepIds": [
