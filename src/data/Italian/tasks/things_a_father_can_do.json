			},
			"dialogs": [
				{
					"id": 200600301,
					"content": "Sembra che ne abbiamo trovati abbastanza. Andiamo a parlare con <color=#00E1FFFF>sorella Jilliana</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2006004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
