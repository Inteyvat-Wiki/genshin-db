			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Guy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "Ehi! Quelli che hai in mano sono Fiordolci? Forse è una richiesta un po' sfacciata, ma potrei comprartene uno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600502,
					"content": "Mio padre ha una brutta tosse che non passa mai: ho chiesto a Jilliana un po' di medicina per la tosse, ma aveva finito gli ingredienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600503,
					"content": "Anch'io sto andando a farmi preparare una medicina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "Oh... capisco. Allora non importa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600505,
					"content": "Scusa se ti ho rallentato. Allora è meglio che vai in fretta alla cattedrale, Jilliana dovrebbe essere ancora lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600506,
					"content": "I Fiordolci sono facili da trovare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "Eh? Oh, capisco... Purtroppo, però, devo stare di guardia all'ingresso. Non posso lasciare la mia postazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600508,
					"content": "Sono stato persino costretto a usare la mia pausa pranzo per andare a parlare con Jilliana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600509,
					"content": "Bene, a guardarti si direbbe che sei la persona giusta per consegnare una medicina. Non ti ruberò altro tempo. Se vai subito alla cattedrale, dovresti trovare Jilliana ancora lì.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				}
			]
		},
		{
