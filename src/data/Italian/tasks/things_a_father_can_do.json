			"dialogs": [
				{
					"id": 200600901,
					"content": "*sospira* Quando passerà questo maledetto raffreddore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600902,
						200600904
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600902,
					"content": "Ecco le tue medicine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600903
					]
				},
				{
					"id": 200600903,
					"content": "Ah, grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600907
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600907,
					"content": "Mi vergogno così tanto che mio figlio sia là fuori a combattere mentre io non posso fare assolutamente nulla per aiutarlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600908
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600908,
					"content": "L'unica cosa che posso fare è cercare di non disturbarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
