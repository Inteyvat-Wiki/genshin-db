				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600701,
					"content": "Quel Tunner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600702,
					"content": "Sono qui per una medicina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "Oh? Non ti ho mai visto qui. Dove sono Moco e Hillie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600704,
					"content": "Vedo che hai portato gli ingredienti. Fammi controllare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		},
		{
			"id": 2006008,
			"completionStepIds": [
				2006009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2006009",
							"2"
						],
						"stepId": 2006009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "La medicina è pronta, ma serve solo ad alleviare i sintomi, non curerà la malattia di per sé. Se vuole davvero stare meglio, deve continuare a prendere le sue medicine e riposarsi più che può.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600802,
					"content": "Devo averglielo detto un migliaio di volte, ma gli entra in un orecchio e gli esce dall'altro. Non importa chi sia la persona a parlargli, non fa altro che dire che si riprenderà.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600803,
					"content": "Beh, allora è meglio che porti a Tunner la sua medicina più in fretta che puoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600804,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600805,
					"content": "Prego. Faccio solo il mio dovere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600806,
					"content": "Grazie, spero di non averti disturbato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600807,
					"content": "Oh, non è niente di che. *sospira* Se solo ci fosse qualcuno a prendersi cura del signor Tunner, non dovrebbe continuare a prendere questa medicina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		},
