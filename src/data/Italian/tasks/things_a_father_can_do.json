			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "Salve, onorevole ospite! Per caso conosci mio figlio, Guy? *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600102,
					"content": "Che succede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "Niente, niente... Solo un dannato raffreddore che proprio non vuole passare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600104,
					"content": "Sono andato nella <color=#00E1FFFF>Chiesa</color> e ne ho parlato con le sorelle, ma non sono riuscite a curarlo e così mi hanno prescritto delle medicine per alleviare i sintomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600105,
					"content": "*sospira* Sto invecchiando e non posso andare molto lontano. Finora, ho sempre chiesto a Moco e Hillie di aiutarmi a ritirare le medicine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600106,
					"content": "Oggi sono impegnate... *tossisce* <color=#00E1FFFF>Jilliana</color> sa cosa fare, però...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600107,
					"content": "Mi serve solo che qualcuno le porti gli ingredienti, e lei preparerà la medicina. Ha solo bisogno di <color=#00E1FFFF>3 Fiordolci</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600108,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600109,
					"content": "*tossisce* G... Grazie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600112,
					"content": "Prendi 3 Fiordolci e portali a sorella Jilliana in chiesa, così preparerà la medicina. <color=#00E1FFFF>Non dire nulla a Guy.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600113,
					"content": "Ho sentito che la Chiesa è collegata ai Cavalieri di Favonius. Ora che il giovane è entrato nelle fila dei Cavalieri, deve stare molto attento a come parla e a quello che fa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600114,
					"content": "Spero vivamente che non finisca per fare qualcosa di avventato per conto di suo padre. Sarebbe terribile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600115,
					"content": "Scusami, hai ascoltato le mie lamentele anche troppo a lungo. Ti lascio andare, fai buon viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600110,
					"content": "Qualcuno come tuo figlio, Guy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600111,
					"content": "*sospira* Se il ragazzo vuole andare in giro a combattere mostri, chi siamo noi per intralciare il suo cammino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				}
			]
		},
