			"dialogs": [
				{
					"id": 100100501,
					"content": "Bene, abbiamo sistemato gli Hilichurl e tutte le barriere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100502,
					"content": "E non abbiamo neanche incendiato la foresta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100503,
					"content": "Sono stata super attenta con il Coniglio Bumbum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100504,
					"content": "Ultimamente vengo mandata in isolamento sempre meno spesso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100505
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100505,
					"content": "Ottimo lavoro, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100506,
					"content": "Forse presto non ti ci manderanno più...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100507,
					"content": "Beh, se solo la maestra Jean permettesse a Klee di far saltare in aria la cella d'isolamento...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100508
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100508,
					"content": "Non è proprio quello che aveva in mente Paimon... Aspetta, e la prova? Abbiamo scoperto qualcosa di nuovo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100509,
					"content": "Sì! Ho trovato questo nel buco creato dall'esplosione del Coniglio Bumbum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100510
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100510,
					"content": "Mmm, un altro biglietto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100511,
					"content": "Sì, e questa è di nuovo la calligrafia della mamma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100512
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100512,
					"content": "\"Dunque, può darsi che Dodoco abbia fatto saltare in aria tutti gli ostacoli, anche se l'approccio più diretto è talvolta il più elegante. In ogni caso, fu così che Dodoco raggiunse la seconda fase della prova...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100513,
					"content": "Che, per pura coincidenza, era anche la fase finale. Dopotutto, anche i bambini più energici hanno bisogno di riposarsi, a un certo punto. Quindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100514,
					"content": "Dodoco si recò sulle rive di un lago di stelle cadute, superò l'ultima prova e ottenne la sua ricompensa. Ma potevano le cose essere davvero così semplici...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100515,
					"content": "Mm, \"un lago di stelle cadute\"... Dev'essere il Lago Stellare!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100516,
					"content": "Andiamo a vedere cosa troviamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100517,
					"content": "Va bene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100518
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100518,
					"content": "Paimon è super curiosa di sapere quale sarà questa ricompensa. Incrociamo le dita che sia una specie di tesoro favoloso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
