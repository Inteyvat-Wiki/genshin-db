			},
			"dialogs": [
				{
					"id": 100100301,
					"content": "Che ci fanno tutte queste cose strane qui intorno? E perché ci sono così tanti Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100302,
					"content": "Mmm, forse sono stati gli Hilichurl a portare tutto qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100303,
					"content": "Ohhhh, scommetto che è qui che troveremo i tentacoli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100304,
					"content": "Ci sei quasi, ma sul biglietto c'era scritto \"ostacoli\", non \"tentacoli\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100305,
					"content": "E qualsiasi cosa stiamo cercando dovrebbe essere sepolta oltre tutti \"gli ostacoli\"... Mmm, ci sono altri indizi qui intorno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100306,
					"content": "Non c'è nessun Dododispositivo che possa aiutarci qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100307,
					"content": "Ehm... No.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100308,
					"content": "Che facciamo, allora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100309,
					"content": "Mmm... La mamma dice sempre che quando ti trovi davanti a un problema, la cosa migliore da fare è provare a risolverlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100310,
					"content": "Allora liberiamoci di questi ostacoli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100311
					]
				},
				{
					"id": 100100311,
					"content": "Sì!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
