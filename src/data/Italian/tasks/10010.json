			"dialogs": [
				{
					"id": 100100601,
					"content": "Ooooh, è un baule!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100602
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100602,
					"content": "Il tesoro finale dev'essere all'interno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100603,
					"content": "Klee, ci faresti l'onore...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100604
					]
				},
				{
					"id": 100100604,
					"content": "Certamente! L'apriremo io e Dodoco, nessun problema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100605
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100605,
					"content": "Ehi, aspetta un attimo... Stanno arrivando dei mostri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100606,
					"content": "A quanto pare non sarà così semplice...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100607
					]
				},
				{
					"id": 100100607,
					"content": "Umpf, vogliono rubare il tesoro di Dodoco, lo so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100608
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100608,
					"content": "Cacciamoli via. Poi potremo aprire il baule!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
