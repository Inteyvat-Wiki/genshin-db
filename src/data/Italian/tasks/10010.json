			"dialogs": [
				{
					"id": 100100801,
					"content": "Fiuu, è fatta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100802,
					"content": "Il biglietto suggeriva che le cose non sarebbero state molto semplici. Paimon immagina fosse a causa di quei mostri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100803,
					"content": "Ma questo significa che... Abbiamo superato la prova!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100804
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100804,
					"content": "Hihi, esatto! Ora, vediamo cosa c'è in questo baule...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100805,
					"content": "Oh, è...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100806
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100806,
					"content": "Un cappellino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100807,
					"content": "Un cappello per Dodoco!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100808
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100808,
					"content": "Nel clan Dodo, solo i Dodoco più fantastici e migliori della terra possono guadagnarsi il riconoscimento del Re Dodo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100809
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100809,
					"content": "Il loro compito è aiutare a proteggere tutti gli altri Dodoco, per questo il Re Dodo dà loro un cappello speciale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100810
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100810,
					"content": "In questo modo gli altri Dodoco li riconosceranno, e sapranno a chi rivolgersi per chiedere aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100811
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100811,
					"content": "Ah! Quindi ora il tuo Dodoco è uno di questi Dodoco speciali con il cappello!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100812,
					"content": "Esatto! Il cappello rende Dodoco un Dodo-Stregone! Può usare una magia speciale di scintille per aiutare ancora più persone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100813
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100813,
					"content": "Klee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100814
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100814,
					"content": "I Cavalieri mi hanno informato che si sentono delle esplosioni provenire dalla foresta fuori città...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100815
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100815,
					"content": "#Ehm, {F#signorina Cavaliere Onoraria}{M#signor Cavaliere Onorario}, Paimon... Un piccolo aiuto, per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100816
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100816,
					"content": "Ah, è perché abbiamo ripulito un accampamento di Hilichurl laggiù, e anche un gruppo di Melmosi. Inoltre, stavamo lavorando al compito di Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100817,
					"content": "Esatto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100818
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100818,
					"content": "Mmh... E per quanto riguarda i pesci di qui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100819
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100819,
					"content": "Potrei... averli fatti esplodere. Ma è perché c'erano dei mostri nel lago! Non l'ho fatto apposta! Non è come le altre volte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100820
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100820,
					"content": "Capisco. Quindi le altre volte lo hai fatto di proposito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100821
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100821,
					"content": "Ehm, non erano... di proposito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100822
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100822,
					"content": "*sospira*... Ho notato l'accampamento distrutto mentre venivo qui, e ho visto i mostri fuggire lungo la riva del Lago Stellare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100823
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100823,
					"content": "#Posso presumere che non ci siano altri danni, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100824,
						100100826
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100824,
					"content": "Il resto è opera di Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100825
					]
				},
				{
					"id": 100100825,
					"content": "...Sì. Conosci Paimon, spazza via i mostri con un solo pugno! È semplicemente fantastica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100827,
					"content": "Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100828
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100828,
					"content": "Vieni con me, torniamo indietro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100829
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100829,
					"content": "Ohh... È di nuovo il momento dell'isolamento per Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100830
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100830,
					"content": "#Beh, dato che {NICKNAME} garantisce per te, suppongo che la tua punizione dovrà essere... un pasto al Buon Cacciatore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100831
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100831,
					"content": "Sei stata in giro tutto il giorno. Avrai sicuramente fame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100832
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100832,
					"content": "Sei la migliore, maestra Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100833
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100833,
					"content": "#Anche voi due siete più che {F#benvenute}{M#benvenuti}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100834
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100834,
					"content": "Hihi, fantastico! Paimon ha una voglia matta di pollo ai Fiordolci!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100835,
					"content": "Jean offre un pasto a te, Paimon e Klee al Buon Cacciatore... \\nAh, insieme a Dodoco, il neo-incoronato \"Dodo-Stregone\" naturalmente. \\nCon questo, la prova si conclude con successo.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 100100826,
					"content": "Questo è tutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100827
					]
				}
			]
		}
	]
