			"dialogs": [
				{
					"id": 750240101,
					"content": "Ah, amici cari, il vostro entusiasmo... è travolgente. Uff... Che ne dite se beviamo qualcosa di fresco e ne parliamo dopo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240102
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240102,
					"content": "Sgraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240103
					],
					"speakerTitle": "\"Fiorrancio\""
				},
				{
					"id": 750240103,
					"content": "Subito sentite un urlo seguito da un tonfo di qualcosa di pesante che cade a terra. Dopodiché si sentono solo ruggiti di Saurici...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240104
					]
				},
				{
					"id": 750240104,
					"content": "Eh?! Starà bene quell'uomo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240105,
					"content": "Oh, è circondato... Non si capisce niente di quello che sta succedendo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240106,
					"content": "E se provassimo a dare un'occhiata da vicino?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240107
					]
				},
				{
					"id": 750240107,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240108,
					"content": "#Mmm, sembrerebbe che {REALNAME[ID(2)|SHOWHOST(true)]} voglia provare... Ok, piccolo, va' pure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240109,
					"content": "Rooar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240110,
					"content": "Mmm, qualcosa non va. È morto o...? No, no, macché! Sarà solo svenuto. In ogni caso, però, non possiamo stare qui a guardare senza far nulla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240111,
					"content": "Ehm, scusate voi tre, potete lasciarci passare, per favore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240112,
					"content": "Sgraaaa! Raaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240113
					],
					"speakerTitle": "\"Fiorrancio\""
				},
				{
					"id": 750240113,
					"content": "Mroar...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240114
					],
					"speakerTitle": "\"Ondino\""
				},
				{
					"id": 750240114,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240115
					],
					"speakerTitle": "\"Smeraldo\""
				},
				{
					"id": 750240115,
					"content": "Woah, non vogliono proprio lasciarci passare... Ma che succede? Visto ciò che ha detto prima quell'uomo, forse conosce questi Saurici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240116,
					"content": "Se solo avessimo più informazioni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240117,
					"content": "...Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240118,
					"content": "#Eh? Hai scoperto qualcosa, {REALNAME[ID(2)|SHOWHOST(true)]}? Ora ti raggiungiamo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502402,
			"completionStepIds": [
				7502402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502402",
							"2"
						],
						"stepId": 7502402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2030.073,
							74.78,
							8497.404
						],
						"pointId": 8382
					},
					{
						"sceneId": 3,
						"position": [
							-2032.248,
							74.7,
							8496.88
						],
						"pointId": 9621
					}
				]
			},
			"dialogs": [
				{
					"id": 750240201,
					"content": "\"...Oggi piove. Ho preparato a Ondino il suo cibo preferito: il <color=#00E1FFFF>ceviche affumicato in agrodolce</color>. Vedendo l'espressione soddisfatta sul suo volto, so che ne è valsa la pena...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240202
					],
					"speakerTitle": "Diario di qualcuno"
				},
				{
					"id": 750240202,
					"content": "\"...Anche se sta nuotando placidamente, nel momento in cui dico le parole \"<color=#00E1FFFF>ceviche affumicato in agrodolce</color>\"... Whoosh! Salta fuori dall'acqua in un baleno, e anche molto aggraziatamente...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240203
					],
					"speakerTitle": "Diario di qualcuno"
				},
				{
					"id": 750240203,
					"content": "\"...Non metterei mai in dubbio l'affetto che prova nei miei confronti. Però credo che ami di più il <color=#00E1FFFF>ceviche affumicato</color>...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240204
					],
					"speakerTitle": "Diario di qualcuno"
				},
				{
					"id": 750240204,
					"content": "Quindi... questo Koholasauro si chiama Ondino, eh? Paimon immagina allora che la pentola di ceviche affumicato in agrodolce fosse per lui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240205,
					"content": "\"...Grandi occhioni tondi, una coda arricciata e dei versi allegri... Smeraldo, o Smeraldo, chi è il Saurico più carino di tutta Teyvat...?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240206
					],
					"speakerTitle": "Diario di qualcuno"
				},
				{
					"id": 750240206,
					"content": "\"...Non ti hanno mai ingannato, né han mai dubitato di te, come se il mondo potesse essere tuo amico e potesse giocare allegramente assieme a te...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240207
					],
					"speakerTitle": "Diario di qualcuno"
				},
				{
					"id": 750240207,
					"content": "\"...Se non avessi sempre tanto lavoro, giocherei con te tutto il giorno e ti guarderei lanciarti in mezzo agli alberi e illuminato dalla luce che penetra tra le chiome, come un figlio del vento come uno spiritello spensierato...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240208
					],
					"speakerTitle": "Diario di qualcuno"
				},
				{
					"id": 750240208,
					"content": "#Ah, quindi il cucciolo di Yumkasauro si chiama Smeraldo, ed è un gran giocherellone. Potresti fare amicizia con lui, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240209,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240210,
					"content": "\"...Ho attraversato mari e monti per trovarti. Se davvero non avessi voluto vedermi, te ne saresti potuto andare...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240211
					],
					"speakerTitle": "Diario di qualcuno"
				},
				{
					"id": 750240211,
					"content": "\"...Però hai pensato a me e al mio ritmo, fermandoti per permettermi di riposare e hai perfino raccolto dei Granifrutti per me. Per non parlare poi di quelle pietre luccicanti...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240212
					],
					"speakerTitle": "Diario di qualcuno"
				},
				{
					"id": 750240212,
					"content": "\"...O Fiorrancio, dolce Fiorrancio, solo io conosco il tenero cuore che si nasconde sotto a quel guscio duro. Mai è stata tua intenzione combattere con tanta ferocia...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240213
					],
					"speakerTitle": "Diario di qualcuno"
				},
				{
					"id": 750240213,
					"content": "Ehm, quindi Fiorrancio sarebbe quel Tepetlisauro scontroso? Se quella lì è dolce e tenera, Paimon è una campionessa di nuoto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240214,
					"content": "Comunque, tornando al discorso... Questi tre Saurici... sono suoi amici? Ma allora perché lo hanno fatto svenire e lo stanno circondando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240215,
					"content": "Prima lo salviamo, poi glielo chiediamo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240216
					]
				},
				{
					"id": 750240216,
					"content": "Sì, giusto. Se solo riuscissimo a farci largo... Un attimo, il diario non diceva che Ondino va matto per il ceviche affumicato in agrodolce? Ce n'è un po' nell'accampamento, possiamo usarlo per attirarlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240217,
						750240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240217,
					"content": "#Per quanto riguarda Smeraldo... potremmo mandare {REALNAME[ID(2)|SHOWHOST(true)]} a fare amicizia con lui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240218
					]
				},
				{
					"id": 750240218,
					"content": "#Giusto! Smeraldo è un monello di prima categoria, {REALNAME[ID(2)|SHOWHOST(true)]} deve solo convincerlo ad allontanarsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240221,
					"content": "Roar! Roooooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240222
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240222,
					"content": "#Vedi? Anche a {REALNAME[ID(2)|SHOWHOST(true)]} piace il piano! Forse, però, il piano più semplice e attuabile è quello del ceviche affumicato in agrodolce, non credi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240219,
					"content": "Potremmo affrontare Fiorrancio in combattimento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240220
					]
				},
				{
					"id": 750240220,
					"content": "#Ehm, cerchiamo di risolvere la situazione in modo pacifico, ok? Ad esempio, convincendo Smeraldo ad andare a giocare lontano con {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				}
			]
		},
