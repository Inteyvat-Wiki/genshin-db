			"dialogs": [
				{
					"id": 750240901,
					"content": "Eheh, a quanto pare l'ha attirato l'odore del cibo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240902,
					"content": "#Lo spazio però non è abbastanza grande. {REALNAME[ID(2)|SHOWHOST(true)]}, ci puoi aiutare a far allontanare Smeraldo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240903,
					"content": "Roar! Roooooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240904,
					"content": "Ottimo! Confidiamo in te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240905,
					"content": "#Appena {REALNAME[ID(2)|SHOWHOST(true)]} avrà convinto Smeraldo ad allontanarsi, andiamo a vedere se l'uomo sta bene, ok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
