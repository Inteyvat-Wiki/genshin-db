							-2032.946,
							73.944,
							8453.382
						],
						"pointId": 9610
					}
				]
			},
			"dialogs": [
				{
					"id": 750240601,
					"content": "Sgraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "\"Fiorrancio\""
				},
				{
					"id": 750240602,
					"content": "Non ti alterare! Vogliamo solo vedere se quell'uomo è ferito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240603,
					"content": "Pare che sia ora di combattere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "#Ehi, non lasciarti andare alla spada così in fretta! Senti, non vogliamo fare niente di male... E siamo {F#sicure}{M#sicuri} che tu non sia il tipo che inizia una rissa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240606,
					"content": "Sgraaaa! Raaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "\"Fiorrancio\""
				},
				{
					"id": 750240607,
					"content": "Oh-oh... Si sta arrabbiando ancora di più!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240605,
					"content": "\"O Fiorrancio, dolce Fiorrancio...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
		},
		{
			"id": 7502407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
