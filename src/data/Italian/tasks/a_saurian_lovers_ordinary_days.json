						],
						"pointId": 9445
					}
				]
			},
			"dialogs": [
				{
					"id": 750240822,
					"content": "Dopo essere stata sconfitta, il Tepetlisauro chiamato Fiorrancio \"trivella\" il terreno e si nasconde solo gli Archon san dove. Ne approfitti per dare un'occhiata all'uomo ferito...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240801
					]
				},
				{
					"id": 750240801,
					"content": "Non ci sono ferite visibili... Ehi, tutto bene? Riesci a sentire Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240802,
					"content": "...Mmm? Fiorrancio? Oh, la mia anima gentile. Eri preoccupata per me? Tranquilla. Mi sono allenato per poter giocare con te senza rischi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240803
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240803,
					"content": "#Ehi, Paimon si chiama Paimon, capito? Non Fiorrancio! {NICKNAME}, secondo te ha battuto la testa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240804,
						750240805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240804,
					"content": "Con un po' di fortuna, tra poco tornerà pienamente cosciente.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240806
					]
				},
				{
					"id": 750240806,
					"content": "Un attimo, tu non sei Fiorrancio. Che sta succedendo? Cosa mi è capitato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240807
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240807,
					"content": "Gli racconti che lo avete trovato svenuto per colpa di Fiorrancio e circondato dai tre Saurici...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240808
					]
				},
				{
					"id": 750240808,
					"content": "Ah, quindi è andata così. Scusate per il disturbo. Mi chiamo Icayo. E come potete vedere, sono un avventuriere a cui piace molto inseguire i Saurici... e a cui a volte capita di essere inseguito da loro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240809
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240809,
					"content": "Poco tempo fa mi sono ammalato e sono dovuto rimanere a letto per un bel po'. Durante quel periodo, le mie energie sono diminuite molto e non sono riuscito ad andare a far loro visita regolarmente...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240810
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240810,
					"content": "Essere circondato da loro prima ancora di arrivare all'accampamento... Ah, che onore essere oggetto di tanta preoccupazione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240811,
						750240812
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240811,
					"content": "Tu sì che pensi positivo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240813
					]
				},
				{
					"id": 750240813,
					"content": "Comunque, nella fretta di salvarti... abbiamo fatto un po' a botte con Fiorrancio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240814,
					"content": "Ah, non c'è da preoccuparsi. Per lei è stato un gioco come un altro. Probabilmente è da qualche parte con il broncio per essere stata sconfitta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240815
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240815,
					"content": "Nonostante le apparenze, è un'anima gentile. Più tardi andrò a consolarla, per cui non preoccupatevi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240816
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240816,
					"content": "#Bene, a quanto pare sei tutto intero. Ci siamo {F#preoccupate}{M#preoccupati} per nulla, ma Paimon è lieta di sapere che stai bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240817,
					"content": "E io vi ringrazio per il pensiero. Ah, già. Non è di gran valore... ma prendete questa mia ricetta del ceviche affumicato in agrodolce in segno di riconoscenza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240818
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240818,
					"content": "#Ondino adora l'aringa affumicata in agrodolce... Magari piace anche al vostro compagno {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240819
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240819,
					"content": "Roar... Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240820
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240820,
					"content": "#Eh? Vuoi assaggiarlo? Nessun problema, {NICKNAME} te ne cucinerà una bella porzione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240821,
					"content": "Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240812,
					"content": "Tu dici...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240813
					]
				},
				{
					"id": 750240805,
					"content": "Sarebbe un bel problema...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240806
					]
				}
			]
		},
