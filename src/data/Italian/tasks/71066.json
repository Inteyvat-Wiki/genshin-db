				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taliesin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "Ehm... Come non detto. Sono un poeta, quindi ho la tendenza a parlare in modo teatrale e a narrare storie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660702,
					"content": "Eheh, a essere sincero, ho trovato l'anello in una tana di Donnoladre... Era ben conservato e molto bello, quindi l'ho tenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660703,
					"content": "Uff, quindi anche tu sei un ladro! Hai rubato ad altri ladri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660704,
					"content": "Non dire così... Ho soltanto colto l'occasione! Sì, esatto, era un'occasione! E per quanto sia accaduto per caso, quell'anello è comunque molto importante per me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660705,
					"content": "Hai idea di dove possa trovarsi ora l'anello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Sì... Ho sentito dire che da queste parti vengono spesso avvistate delle Donnoladre. Forse me l'hanno rubato mentre dormivo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660707,
					"content": "Oh, quindi c'è gente che si toglie gli anelli prima di andare a dormire...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660708,
					"content": "Neanch'io sapevo ci fosse della gente del genere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "Comunque, Paimon non ha quest'abitudine! Se avessi un anello da togliere, dovrei anche pensare a dove metterlo, quando invece potrei già essere nel mondo dei sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660710,
					"content": "Perché, fanno anelli abbastanza piccoli per le tue dita, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "Uff, è ovvio! Ancora non sai un sacco di cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660712,
					"content": "Basta così. Vi prego di non giudicare gli stili di vita degli altri per poi straparlare dei vostri! Non è educato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660713,
					"content": "...Comunque, tenete d'occhio le tane delle Donnoladre... Se vi va di darmi una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660714,
					"content": "Ho sentito dire che da queste parti della mappa c'è un accampamento di Cacciatori di tesori sospetti... Ti ho segnato il punto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660715,
					"content": "Si dice che da queste parti vengano spesso avvistate delle Donnoladre. Probabilmente quegli infidi Cacciatori di tesori c'entrano qualcosa... Comunque, dateci un'occhiata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660716,
					"content": "Uff... Un anello rubato alle Donnoladre, che poi lo hanno rubato nuovamente. Secondo Paimon, è tornato alle sue legittime proprietarie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660717,
					"content": "Oh, suvvia, smettila!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
