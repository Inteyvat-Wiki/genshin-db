			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "Ehi, è successo qualcosa di recente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660802,
					"content": "A proposito delle Donnoladre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "Oh, parli di quelle presenti nella Voragine? Non c'è molto da dire: avevo l'incarico di prendermene cura, ma ho combinato un disastro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660804,
					"content": "Eh... Per me è impossibile ricatturarle. Dopotutto, sono bravissime a nascondersi, quindi è molto difficile rintracciarle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660805,
					"content": "Tuttavia, se queste fastidiose creaturine hanno iniziato a derubare qualcuno, posso darvi una mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660806,
					"content": "Le Donnoladre addestrate dai Cacciatori di tesori mangiano a orari prestabiliti. Esistono tre tipologie di Donnoladre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660807,
					"content": "La Donnoladra dorata è la più furba di tutte... Poi c'è la Donnoladra accaparratrice, che è la più comune, e la Donnoladra dilettante, che è la più stolta. Invece gli orari in cui appaiono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660808,
					"content": "*sospira* Da qualche parte ci dovrebbe essere un manuale d'addestramento con gli orari dei pasti, perché nessuno di noi li ha mai voluti imparare a memoria. Dovresti riuscire a trovarlo nell'accampamento frequentato dalle Donnoladre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660809
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660809,
					"content": "Ah... Stavo dimenticando: per chiamarle dovrai fischiare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660810
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660810,
					"content": "Fischiare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660811
					]
				},
				{
					"id": 710660811,
					"content": "Sì, va bene anche un fischietto vecchio. Non è difficile, il segreto è il tempismo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		}
	]
}