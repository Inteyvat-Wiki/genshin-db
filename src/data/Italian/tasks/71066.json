			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taliesin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "Sì, esatto! Grazie mille!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660302,
					"content": "Eccoti la ricompensa. So che non è molto, ma ti prego di non offenderti. Comporrò una poesia per elogiare le tue gesta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
		{
