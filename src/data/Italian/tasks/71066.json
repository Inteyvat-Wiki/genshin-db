			},
			"dialogs": [
				{
					"id": 710660201,
					"content": "Rieccoti! L'hai trovato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660202
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660202,
					"content": "Dai un'occhiata. È questo il tuo anello?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7106603,
			"completionStepIds": [
