			"dialogs": [
				{
					"id": 761170201,
					"content": "Pfft, che sfigato. Quel tipo è così al verde che non ha nemmeno qualcosa che valga la pena di rubare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170202,
					"content": "Ehi, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170203,
					"content": "Chi va là...? Bene, bene, ma guarda chi c'è, Jahoda! Cosa ti porta qui, mezza calzetta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170204,
					"content": "Rilassati, niente di grave. Dicono che qualche giorno fa hai rubato qualcosa a un tizio di nome Ihanti. È vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170205,
					"content": "Ecco, prendi un po' di soldi e tira fuori la merce. Oggi mi sento generosa, quindi diciamo che te la sto comprando.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170206,
					"content": "Ooh, ma guardati, come fai tutta la civilizzata. Immagino sia quello che succede quando c'è Nefer a coprirti le spalle, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170207,
					"content": "E se preferissi tenermela? Cosa pensi di fare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170208,
					"content": "Fammi un favore, Kaleva. Tu e la tua banda di teste di rapa non potreste provare a comportarvi normalmente, per una volta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170209,
					"content": "Oh, ti prego, non dirmi che sei venuta fin qui aspettandoti di fare degli affari onesti con un ladro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170210,
					"content": "Oppure pensavi davvero che te l'avrei consegnata su un piatto d'argento?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170211,
					"content": "Sembra che questa negoziazione sia andata a rotoli prima ancora di cominciare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170212,
					"content": "*sospira*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170213,
					"content": "Scusa, Kaleva. Non avrei dovuto provare a trattare con te come fa il capo Nef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170214,
					"content": "Un pugno in faccia è l'unico modo per negoziare con un idiota come te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170215,
					"content": "#Dai, {NICKNAME}, liberiamoci di questi teppistelli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170216,
					"content": "#Ci guardate dall'alto in basso, eh? Forza, ragazzi, è ora di rimettere questa mocciosa al suo posto. {F#Prendiamole}{M#Prendiamoli}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaleva"
				}
			]
		},
