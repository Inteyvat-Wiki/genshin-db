						"position": [
							2097.637,
							200.208,
							9562.796
						],
						"pointId": 14264
					},
					{
						"sceneId": 3,
						"position": [
							2098.119,
							200.186,
							9563.697
						],
						"pointId": 14265
					}
				]
			},
			"dialogs": [
				{
					"id": 761170301,
					"content": "Va bene, va bene, avete vinto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170303
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170303,
					"content": "Visto? Se avessi collaborato fin dall'inizio, non ti saresti cacciato in questo pasticcio. Ora, prendi i Mora e vai a cercarti un dottore decente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170304,
					"content": "Umpf, è questo il tuo modo di mostrare pietà?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170305
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170305,
					"content": "Dacci un taglio e prendi i Mora. Se preferisci buttarli o usarli per reclutare degli scagnozzi che mi aggrediscano è una tua decisione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170306,
					"content": "Una cosa è certa, però: avere fame e prenderle di santa ragione sono due cose entrambe terribili. Non peggiorare la tua situazione, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170308
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170308,
					"content": "La merce che ho rubato a quella mummia è laggiù.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170309
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170309,
					"content": "A parte qualche spicciolo, c'erano solo un dipinto e una bambola rotta. I Mora sono spariti da tempo, ma non ho ancora avuto il tempo di buttare via il resto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170310
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170310,
					"content": "Bene, un'ultima domanda... Poco fa hai definito Ihanti una \"mummia\". Cosa intendevi dire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170311,
					"content": "Intendevo esattamente ciò che significa. Quel rammollito è ridotto in uno stato tale che si riesce a capire a fatica se sia ancora vivo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170312
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170312,
					"content": "Quando l'ho trovato la prima volta era disteso lì, rigido come un tronco. Onestamente pensavo che fosse già... Insomma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170313
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170313,
					"content": "...Comunque sia, ho pensato che non avesse più bisogno della sua borsa, quindi l'ho presa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170314
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170314,
					"content": "Segna il punto dove l'hai visto per l'ultima volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170315,
					"content": "Dove l'ho visto l'ultima volta? Direi che era più o meno... qui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170316
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170316,
					"content": "#Bene. {NICKNAME}, Paimon, andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170317
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170317,
					"content": "Vorrei restituire di persona questi oggetti al cliente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
		{
			"id": 7611704,
			"completionStepIds": [
				7611705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
