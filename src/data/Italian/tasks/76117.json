			},
			"dialogs": [
				{
					"id": 761170501,
					"content": "Eccellente, sembra che sia riuscita a completare l'incarico. Un attimo di pazienza, vado a prendere il compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170502,
					"content": "Va tutto bene, signorina Jahoda? Sembra un po' pallida... Non ha avuto problemi, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170503,
					"content": "Tranquilla, sto bene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170504
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170504,
					"content": "Molto bene, allora. Un momento, torno subito con il suo pagamento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170505,
					"content": "Stai davvero bene, Jahoda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170506
					]
				},
				{
					"id": 761170506,
					"content": "Paimon sa che abbiamo promesso di non chiamare un dottore, ma... Ihanti aveva davvero un aspetto terribile. Forse dovremmo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170507,
					"content": "No. Ho detto che avrei rispettato il codice, ed è quello che farò.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170508
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170508,
					"content": "Quindi... Voi due vi conoscete bene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170509
					]
				},
				{
					"id": 761170509,
					"content": "Una volta eravamo \"colleghi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170510,
					"content": "Sarà anche un codardo, ma quando si trattava di racimolare Mora... Eheh, Ihanti era un fuoriclasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170511
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170511,
					"content": "Mentre tutti gli altri facevano stupide truffe e furtarelli, lui era talmente abile che la gente finiva per sborsare il denaro volontariamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170512
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170512,
					"content": "Era un esperto nel convincere la gente. Quando \"lavoravamo\" insieme, ha condiviso molte delle sue abilità con me... e mi portava sempre fuori a mangiare cibo delizioso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170513
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170513,
					"content": "Lo consideri un amico?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170514
					]
				},
				{
					"id": 761170514,
					"content": "Un amico? Ah, figurati. Bisognerebbe essere pazzi per cercare di fare amicizia in quell'inferno. Al massimo... eravamo conoscenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170515
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170515,
					"content": "L'unica ragione per cui si prendeva così tanta cura di me era per mettersi in mostra. Portarsi dietro una piccola aiutante lo faceva sentire importante, immagino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170516
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170516,
					"content": "Ma si è preso cura di me, questo glielo riconosco. Aiutarlo ora è solo il mio modo di ricambiare il favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170517
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170517,
					"content": "Bene... Ecco il suo compenso, signorina Jahoda. La Gilda degli avventurieri la ringrazia per il suo supporto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170518
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170518,
					"content": "#Ecco la tua parte, {NICKNAME}. Grazie per l'aiuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170519
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170519,
					"content": "A ogni modo, sarà meglio che torni al Consiglio. Se il capo vuole farmi fare qualcosa e non mi vede, mi starà di nuovo addosso sicuramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170520
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170520,
					"content": "(Ho detto che non gli avrei trovato un dottore, ma che male c'è nel prendergli degli antidolorifici?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170521
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170521,
					"content": "(Chiederò al capo di aiutarmi, sono sicura che può muovere qualche filo. Nel peggiore dei casi, rinuncerò allo stipendio di questo mese... Anzi, forse solo alla metà...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170522
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170522,
					"content": "(Sì, farò così. È meglio che porti le medicine a Ihanti, domani...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
