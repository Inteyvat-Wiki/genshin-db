			"dialogs": [
				{
					"id": 761170101,
					"content": "Mm-mmm, sembra che abbia gestito l'incarico senza problemi. Grazie, signorina Jahoda. Ecco il suo compenso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170102,
					"content": "Visto? L'avevo detto che sarebbe andato tutto bene! Anche il compenso non è male, eheh... Ci sono altri lavori veloci per guadagnare Mora come questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170103,
					"content": "Posso certamente dare un'occhiata. Un momento, per favore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170104,
					"content": "Eh?! Ma quello non è...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170105
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170105,
					"content": "Ehi, Katheryne... Quel ciondolo laggiù è stato usato per pubblicare una taglia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170106,
					"content": "Proprio così... Che occhio attento, signorina Jahoda. Il signor Ihanti l'ha lasciato come garanzia per una richiesta di taglia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170107,
					"content": "In tal caso, me ne occuperò io. Mi servono solo i dettagli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170108,
					"content": "Il problema è che... la ricompensa non è poi così alta e, al giorno d'oggi, dei gioielli come questo non valgono nemmeno un granché. Non sono sicura che sia il tipo di lavoro che sta cercando, signorina Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170109,
					"content": "Nessun problema, lo prendo volentieri. Sarà come fare un po' di beneficenza. Bisogna accumulare del karma positivo ogni tanto, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170110,
					"content": "Ahah... Molto bene, allora. Solo un momento, per favore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170111,
						761170112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170111,
					"content": "Accetti di nuovo degli incarichi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				},
				{
					"id": 761170113,
					"content": "Cioè, non è che abbia molto altro da fare in questo momento. Non posso mica starmene seduta tutto il giorno a giocare con Ashru, no? Nef... Anzi, il capo Nef mi caccerebbe in un attimo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170114
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170114,
					"content": "#Mm, ora che siete qui... {NICKNAME}, Paimon, voi due siete piuttosto abili. Vi andrebbe di unire le forze per questo incarico? Potremmo dividere la ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170115,
					"content": "#Un incarico, eh? Faresti meglio a chiedere a {NICKNAME}... Dopotutto, l'{F#esperta}{M#esperto} è {F#lei}{M#lui}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170116,
						761170117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170116,
					"content": "Paimon, dai, così mi fai arrossire...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170118,
					"content": "Scommetto che non è niente d'importante. Credetemi, Ihanti è troppo fifone perché si tratti di qualcosa di serio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170119
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170119,
					"content": "Signorina Jahoda, ecco i dettagli dell'incarico del signor Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170120,
					"content": "Bene, vediamo in cosa si è cacciato quel pappamolle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170121
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170121,
					"content": "Ugh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170122,
					"content": "Che succede? Per favore, non dirci che è qualcosa di super difficile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170123,
					"content": "No, niente del genere. Solo che non mi aspettavo che uno che non riuscirebbe a far male nemmeno a una mosca pubblicasse un incarico di vita o di morte come questo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170124,
						761170125
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170124,
					"content": "D-Di vita o di morte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170126,
					"content": "#Tu? Ahahah, certo... Non potresti essere più {F#ligia}{M#ligio} alle regole nemmeno se ci provassi, eh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170127,
					"content": "Rilassati, stavo scherzando. Dice solo di recuperare qualcosa da un gruppo di criminali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170128,
					"content": "Per un criminale i soldi sono la vita, e la vita sono i soldi. Questo la rende una questione di vita o di morte, non ti pare? Ahahah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170129
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170129,
					"content": "Forza, seguitemi. Sono abbastanza sicura di potermi sbarazzare da sola di quei furfanti. È possibile che non abbiate nemmeno bisogno di alzare un dito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170125,
					"content": "Sono una persona che rispetta la legge, giusto per fartelo sapere...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170117,
					"content": "Va bene allora, perché no? Di che tipo d'incarico stiamo parlando?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170112,
					"content": "Sempre indaffarata, a quanto vedo...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				}
			]
		},
