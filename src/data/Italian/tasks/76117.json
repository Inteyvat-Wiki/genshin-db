					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ihanti"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2018.583,
							206.964,
							9782.118
						],
						"pointId": 14266
					},
					{
						"sceneId": 3,
						"position": [
							2020.458,
							206.988,
							9783.119
						],
						"pointId": 14267
					},
					{
						"sceneId": 3,
						"position": [
							2019.785,
							206.972,
							9781.799
						],
						"pointId": 14268
					},
					{
						"sceneId": 3,
						"position": [
							2018.43,
							206.961,
							9782.82
						],
						"pointId": 14269
					}
				]
			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "*ansima*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170402,
					"content": "Chi va là? Non ho Mora, niente di niente... Se siete qui per uccidermi... fate pure...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170403,
					"content": "T-Ti ho riportato le tue cose, Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170404,
					"content": "...Jahoda, sei tu? Riesco a sentire la tua voce, ma non riesco più a vedere chiaramente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170405,
					"content": "Sono io, Ihanti, e sono qui proprio davanti a te. Perché non sei venuto a cercarmi? Hai un aspetto... terribile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170406,
					"content": "Nemmeno un randagio affamato si avventura nella città di un ricco... Non dopo tutte le botte che ha preso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170407,
					"content": "Non sono quel tipo di persona, e non lo è nemmeno Nef... Ahem, il capo Nef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170408,
					"content": "Ecco perché non potevo venire a cercarti. Se gli altri avessero saputo che siete disposte a dare una mano, sarebbero venuti a bussare alla vostra porta ogni giorno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170409,
					"content": "Nessuno sarebbe talmente pazzo da tentare una mossa del genere con il capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170410,
					"content": "Ma tu fai sempre del bene di nascosto, per poi venire pugnalata alle spalle dalle stesse persone che hai aiutato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170411,
					"content": "Ehi. Ho imparato molto dal capo Nef, sai? Nessuno riuscirà più a farmela in quel modo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170412,
					"content": "Ah, non riesci proprio a smettere di preoccuparti per gli altri, vero, Jahoda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170413,
					"content": "...Sono affari miei, e di nessun altro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170414,
					"content": "Eh... Forse è per questo che il capo ti stima così tanto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170415,
					"content": "Potrebbe essere l'unico motivo per cui sono ancora viva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170416,
					"content": "Ahahah-urgh *tossisce*... Hai ragione, Jahoda. Hai ragione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170417,
					"content": "...A ogni modo, se posso fare qualcosa per te, Ihanti, ora è il momento di dirmelo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170418,
					"content": "Sei sempre la stessa, eh...? E se fosse solo una grande truffa, o ti stessi attirando in qualche tipo di trappola?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170419,
					"content": "Non lo faresti mai, considerando da quanto tempo ci conosciamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170420,
					"content": "E questo basta per guadagnarsi la tua fiducia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170421,
					"content": "Suvvia, guarda in che stato sei. Come potresti mai minacciarmi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170422,
					"content": "Ah! Finalmente iniziamo a ragionare. Immagino che salvare un serpente velenoso che riesce a malapena ad aprire la bocca sia abbastanza sicuro, a conti fatti... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170423,
					"content": "Allora fammi un favore: avvolgi il dipinto in quella borsa e mettimelo in tasca. Non ho le forze per farlo da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170424,
					"content": "L'ho dipinto insieme a mia moglie e mia figlia. È l'unica cosa a cui tengo ancora in questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170425,
					"content": "Per quanto mi riguarda, nient'altro ha più importanza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170426,
					"content": "Eh, il te di un tempo si sbellicherebbe dalle risate a sentirti parlare così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170427,
					"content": "Ah... E che fine hanno fatto le cose a cui tenevo di più? Non sono riuscite a salvare mia moglie, né la mia vita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170428,
					"content": "Ma forse è questo il destino di un ladro. Tutto quello che rubiamo finisce sempre per essere rubato a sua volta, e alla fine ci ritroviamo sempre a mani vuote.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170429,
					"content": "Quel ciondolo che ho messo a garanzia per l'incarico era tutto ciò che mi era rimasto... Ah, anche se immagino di non poterlo definire veramente \"mio\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170430,
					"content": "È il primo gioiello che hai rubato. Devi avermi raccontato la storia almeno una decina di volte... Di come te ne sei appropriato, e l'espressione sul volto di quel riccone quando se n'è accorto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170431,
					"content": "Già. Comunque sia, ora è tuo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170432,
					"content": "A chi apparteneva?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170433,
					"content": "A un abitante di Snezhnaya di nome Holomov. Viveva a Nod-Krai, ma probabilmente ormai è già fuggito a casa sua a Snezhnaya. Non starai pensando di...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170434,
					"content": "Non sono più una ladra, e non ho intenzione di aggrapparmi a degli oggetti rubati. Questo ciondolo dovrebbe tornare al suo legittimo proprietario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170435,
					"content": "Ahahah... Ahahah... Sei davvero incredibile, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170436,
					"content": "Il capo aveva ragione... Una come te non potrebbe mai... *tossisce* essere una brava ladra... *tossisce*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170437,
					"content": "*tossisce*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170438,
					"content": "Basta, smettila di sprecare il fiato. Torno indietro e ti trovo un dottore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170439,
					"content": "Lascia perdere. Lasciami andare, com'è destino che sia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170440,
					"content": "Ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170441,
					"content": "Jahoda, conosci il codice del capo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170442,
					"content": "\"Concedi il riposo a coloro che lo cercano\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170443,
					"content": "Sai di cosa sto parlando, quindi lasciami in pace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170444,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170445,
					"content": "D'accordo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170446,
					"content": "Sono felice che sia stata tu a venire ad aiutarmi, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170447,
					"content": "Mi dispiace non avere alcun tesoro da darti. Ma se vuoi, puoi prendere questa bambola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170448,
					"content": "Aspetta, ma... pensavo di averti detto che...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170449,
					"content": "Non preoccuparti, questa l'ho fatta io stesso. Quelle che avevi messo insieme non esistono più da un pezzo... Le ho bruciate tutte quante, proprio come mi avevi detto di fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170450,
					"content": "Ahah. Non male, vero? Soprattutto per qualcuno che era già sull'orlo della cecità...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170451,
					"content": "Prendila, Jahoda. Considerala il mio ultimo regalo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170452,
					"content": "Tornerò a trovarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170453,
					"content": "Ora vai. Addio, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170454,
					"content": "Grazie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ihanti"
				}
			]
		},
