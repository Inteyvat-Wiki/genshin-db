					}
				]
			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "(Colombina non c'è?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "Mi stavi cercando?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350103,
					"content": "Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350104,
					"content": "Mi hai spaventato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "Dopo aver percepito il tuo arrivo, volevo vedere di quanto mi sarei potuta avvicinare alle tue spalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350107,
					"content": "Perché non hai niente di meglio da fare o...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350108,
					"content": "Mm... È così che sembra? Non molto diverso da quand'ero con i Fatui, allora... Non c'era molto da fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350109,
					"content": "La Tsaritsa ricercava solo il potere delle Dee della luna. Non mi ha mai mandato a prendere una Gnosi o qualcosa del genere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350110,
					"content": "Quindi come trascorrevi il tempo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "Passeggiavo, guardavo la luna, a volte cantavo... Ma ho praticamente smesso quando Sandrone me lo ha proibito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350112,
					"content": "Mmmh? Non le piaceva sentirti cantare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350113,
					"content": "No. Le piaceva molto, in realtà, ma mi ero unita ai Fatui da poco e mi disse che gli altri si sarebbero innervositi, ascoltandomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350114,
					"content": "Perché chi non aveva tutte le informazioni... Avrebbe potuto pensare che stessi usando un qualche tipo di potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350115,
					"content": "Oh, ehm... Paimon crede di capirlo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350116,
					"content": "Ah, e c'era anche un'altra motivazione. Mi disse che faceva le sue ricerche soprattutto di notte, e che quindi se avessi cantato di giorno avrei interrotto i suoi tentativi di recuperare il sonno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350117,
					"content": "(Scommetto che era questa la motivazione principale!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "Così cantavo fuori dalla sua porta di notte. Però mi mandava sempre via comunque...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350120,
					"content": "Andavi d'accordo con gli altri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "\"Andarci d'accordo\"? Mmm... Quando ci siamo incontrate per la prima volta, Arlecchino sembrava molto ansiosa di \"andare d'accordo\" con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350122,
					"content": "Mi appariva spesso alle spalle, come ho fatto prima io con voi. Diceva che era un tentativo di \"mettermi alla prova\", credo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350123,
					"content": "Anch'io ho provato a partecipare a quel gioco, ma riusciva sempre a vedermi ancor prima che mi avvicinassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350124,
					"content": "Alla fine ho usato il Kuuvahki e sono riuscita a spaventarla da dietro. Ma, dopo quella volta, non ha mai più giocato con me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350125,
					"content": "(Già, Paimon dubita che per la Fantesca fosse un \"gioco\"...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350126,
					"content": "Cos'altro...? Ah, il Luminare mi chiedeva spesso di aiutarlo con le sue ricerche sul Regno della Luce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350127,
					"content": "L'ho aiutato qualche volta, ma era molto noioso. \"Usa il Kuuvahki per colpire questo\", \"usa il Kuuvahki per controllare quello\"... Dopo un po' ho smesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350128,
					"content": "Sembri di buon umore oggi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "Sì. Anche se sono \"scappata di casa\", ho comunque dei bei ricordi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350131,
					"content": "Arlecchino e Sandrone mi trattavano abbastanza bene, insieme a...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350132,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350133,
					"content": "(Quell'espressione... Mi chiedo a chi stia pensando...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "Dammi la mano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350135,
					"content": "...Eh?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "Rosalyne mi ha insegnato... che esprimere la propria gratitudine nei confronti degli altri è importante.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350138,
					"content": "Quindi grazie per avermi ascoltata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350139,
					"content": "Non c'è di che...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "(Questa è... la Grazia della Dea della Luna?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "Credo che per oggi basti così.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "La Damigella"
				},
				{
					"id": 760350142,
					"content": "Woah, Paimon non se l'aspettava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350143,
					"content": "Shhh, Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "Già, immagino che tu abbia ragione. Beh, non disturbiamola allora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350144,
					"content": "Penso che stia ricordando certe cose del suo passato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "...Perché?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "Hai parlato molto del tuo passato...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "Dovevi proprio spuntare da dietro in quel modo...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}