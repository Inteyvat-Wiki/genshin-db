					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzissenkreuz",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					},
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "Impossibile... Avevo già raggiunto il punto di \"non ritorno\". Come ho fatto a cadere così in basso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650202,
					"content": "E ho perso del tutto il controllo del Mare primordiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650203,
					"content": "Perché, perché è dovuto accadere? Perché mi avete fatto questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650204,
					"content": "Il nuovo mondo non può sorgere. Tutti moriranno all'interno di un sogno fragile come un guscio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650205,
					"content": "Paimon crede che sia tu a doverti svegliare dal sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650206,
					"content": "La fine del mondo è una cosa che dovrebbe spingerci a unire le forze allo scopo di fermarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650207,
					"content": "Capisco. La Spada sacra non è dalla mia parte. Ogni suo colpo scalfisce la volontà universale che mi circonda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650208,
					"content": "Finché infine, il mio ego, debole e ordinario, non torna al suo corpo fisico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650209,
					"content": "Il Mare primordiale non strariperà così presto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "Certo, sento dei cambiamenti nei valori immessi nella formula del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650211,
					"content": "Qualcuno ha preso il controllo della forza vitale, e qualcuno ha aperto i cancelli del regno delle bestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650212,
					"content": "E quindi, c'è un'altra variabile. E quella sei tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650213,
					"content": "La persona destinata a osservare la balena che inghiotte tutto. Il testimone dell'intero evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650214,
					"content": "Capisco, capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650221,
					"content": "Una volta sognavo di diventare una persona proprio come te. Ma quel sogno adesso non c'è più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650222,
					"content": "Tutto ciò che ho fatto non ha senso. Non è che un sogno vuoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650223,
					"content": "No, anche meno di un sogno. Almeno i sogni sono innocui. Ma io... No, anzi, tu e loro avete pagato così tanto per ciò che ho fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650224,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650225,
					"content": "Oh, eccoti qua. Non ti avevo visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650226,
					"content": "Sai chi sono realmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650227,
					"content": "I nomi sono solo etichette. Però sì. Sono a conoscenza dei due colori che si mescolano nella tua anima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650228,
					"content": "La direttrice Lyris non sa cosa sia successo. Si aggrappa a Mary-Ann, che a sua volta è ancora aggrappata alla vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650229,
					"content": "Un presente e un futuro così complessi sono al di là della sua comprensione, e il passato è tutto ciò che spera di preservare. Pertanto, fa l'unica cosa che è in grado di fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650230,
					"content": "Mi chiamo Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650231,
					"content": "Beh, allora ciao, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650232,
					"content": "Sono disposta a perdonarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650233,
					"content": "Che cosa strana da dire. Sin dall'inizio, i miei progetti hanno avuto scopi nobili e sacri. L'egoismo non ci ha mai messo piede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650234,
					"content": "Nessuno è in grado di giudicare o criticare me, né ho bisogno di essere perdonato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650235,
					"content": "I tuoi scopi saranno anche nobili, ma la tua pazzia ha fatto del male a molti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650236,
					"content": "Non hai nemmeno scritto correttamente la formula... e cosa c'è di male nell'essere perdonati per un errore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650237,
					"content": "...Hai ragione. Chiedo scusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650238,
					"content": "Allora per favore, Narzissenkreuz, torna con noi. C'è altra gente che devi vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650239,
					"content": "Questo tizio sembra essere diventato molto più disposto a collaborare. Ma una richiesta così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650240,
					"content": "Ma certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650241,
					"content": "Eh? Ma di solito per cose del genere non si attraversa una fase di conflitto interiore con ore e ore di persuasione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650242,
					"content": "Come detto prima, non sento di aver fatto niente di male. La mia missione non è riuscita, ma il mondo è comunque stato salvato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650243,
					"content": "Chiunque è libero di canzonarmi e maledirmi. Ora sento il vuoto dentro di me, e solo la fiamma di un desiderio rimane accesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650244,
					"content": "Di cosa si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650245,
					"content": "Anche io vorrei tornare alle origini... A prima che gli eroi Narzissenkreuz iniziassero il loro viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650246,
					"content": "Ma è impossibile. Non siamo noi a decidere del nostro destino. Non ho nemmeno più il potere di determinare i miei sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650247,
					"content": "#Beh, Cavalier {NICKNAME}, quando sarai {F#pronta}{M#pronto}, andremo a richiudere le acque primordiali e poi lasceremo questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650215,
					"content": "Quella creatura è già stata sconfitta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "Dovrei aver percepito i cambi nei valori originariamente immessi nella formula del mondo. Una \"variabile\" è discesa su questo mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650217,
					"content": "Non tutto ciò che è al di fuori dell'universo può chiamarsi \"presenza\" o \"variabile\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650218,
					"content": "Ma a quanto pare c'è qualcosa che ho ignorato. Te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650219,
					"content": "Il testimone di tutto, l'arciviatore di tutto, il progettatore di tutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650220,
					"content": "Solo colui che merita un mondo può sfoggiare quel titolo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
			"id": 7416503,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7416505",
							"2"
						],
						"stepId": 7416505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzissenkreuz",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650301,
					"content": "Impossibile... Avevo già raggiunto il punto di \"non ritorno\". Come ho fatto a cadere così in basso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650302
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650302,
					"content": "E ho perso del tutto il controllo del Mare primordiale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650303
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650303,
					"content": "Perché, perché è dovuto accadere? Perché mi avete fatto questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650304
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650304,
					"content": "Il nuovo mondo non può sorgere. Tutti moriranno all'interno di un sogno fragile come un guscio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650305
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650305,
					"content": "Paimon crede che sia tu a doverti svegliare dal sogno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650306,
					"content": "La fine del mondo è una cosa che dovrebbe spingerci a unire le forze allo scopo di fermarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650307,
					"content": "Capisco. La Spada sacra non è dalla mia parte. Ogni suo colpo scalfisce la volontà universale che mi circonda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650308
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650308,
					"content": "Finché infine, il mio ego, debole e ordinario, non torna al suo corpo fisico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650309
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650309,
					"content": "Il Mare primordiale non strariperà così presto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650310
					]
				},
				{
					"id": 741650310,
					"content": "Certo, sento dei cambiamenti nei valori immessi nella formula del mondo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650311
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650311,
					"content": "Qualcuno ha preso il controllo della forza vitale, e qualcuno ha aperto i cancelli del regno delle bestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650312
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650312,
					"content": "E quindi, c'è un'altra variabile. E quella sei tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650313
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650313,
					"content": "La persona destinata a osservare la balena che inghiotte tutto. Il testimone dell'intero evento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650314
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650314,
					"content": "Capisco, capisco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650315
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650315,
					"content": "Una volta sognavo di diventare una persona proprio come te. Ma quel sogno adesso non c'è più.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650316
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650316,
					"content": "Tutto ciò che ho fatto non ha senso. Non è che un sogno vuoto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650317
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650317,
					"content": "No, anche meno di un sogno. Almeno i sogni sono innocui. Ma io... No, anzi, tu e loro avete pagato così tanto per ciò che ho fatto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650318
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650318,
					"content": "Narzissenkreuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650319
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650319,
					"content": "Oh, eccoti qua. Non ti avevo visto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650320
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650320,
					"content": "Sai chi sono realmente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650321
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650321,
					"content": "I nomi sono solo etichette. Però sì. Sono a conoscenza dei due colori che si mescolano nella tua anima.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650322
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650322,
					"content": "La direttrice Lyris non sa cosa sia successo. Si aggrappa a Mary-Ann, che a sua volta è ancora aggrappata alla vita.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650323
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650323,
					"content": "Un presente e un futuro così complessi sono al di là della sua comprensione, e il passato è tutto ciò che spera di preservare. Pertanto, fa l'unica cosa che è in grado di fare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650324
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650324,
					"content": "Mi chiamo Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650325
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650325,
					"content": "Beh, allora ciao, Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650326
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650326,
					"content": "Sono disposta a perdonarti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650327
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650327,
					"content": "Che cosa strana da dire. Sin dall'inizio, i miei progetti hanno avuto scopi nobili e sacri. L'egoismo non ci ha mai messo piede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650328
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650328,
					"content": "Nessuno è in grado di giudicare o criticare me, né ho bisogno di essere perdonato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650329
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650329,
					"content": "I tuoi scopi saranno anche nobili, ma la tua pazzia ha fatto del male a molti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650330
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650330,
					"content": "Non hai nemmeno scritto correttamente la formula... e cosa c'è di male nell'essere perdonati per un errore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650331
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650331,
					"content": "...Hai ragione. Chiedo scusa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650332
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650332,
					"content": "Allora per favore, Narzissenkreuz, torna con noi. C'è altra gente che devi vedere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650333
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650333,
					"content": "Questo tizio sembra essere diventato molto più disposto a collaborare. Ma una richiesta così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650334,
					"content": "Ma certo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650335
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650335,
					"content": "Eh? Ma di solito per cose del genere non si attraversa una fase di conflitto interiore con ore e ore di persuasione?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650336,
					"content": "Come detto prima, non sento di aver fatto niente di male. La mia missione non è riuscita, ma il mondo è comunque destinato a esser salvato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650337
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650337,
					"content": "Chiunque è libero di canzonarmi e maledirmi. Ora sento il vuoto dentro di me, e solo la fiamma di un desiderio rimane accesa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650338
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650338,
					"content": "Di cosa si tratta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650339,
					"content": "Anche io vorrei tornare alle origini... A prima che gli eroi Narzissenkreuz iniziassero il loro viaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650340
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650340,
					"content": "Ma è impossibile. Non siamo noi a decidere del nostro destino. Non ho nemmeno più il potere di determinare i miei sogni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650341
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650341,
					"content": "#Beh, Cavalier {NICKNAME}, quando sarai {F#pronta}{M#pronto}, andremo a richiudere le acque primordiali e poi lasceremo questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		}
	]
