			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Narzissenkreuz",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.815,
							-76,
							3381.435
						],
						"pointId": 6766
					}
				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "#Percepisco... percepisco della \"ragione\". {F#Visitatrici}{M#Visitatori}, siete voi {F#le succeditrici}{M#i successori} di Narzissenkreuz, o siete una minaccia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650102,
					"content": "Avete sguainato le vostre armi. La vostra risposta mi è chiara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650103,
					"content": "Narzissenkreuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650104,
					"content": "Eh? Questa cosa è Narzissenkreuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650105,
					"content": "Se il mio nome vi suona familiare, sapete anche della mia missione per salvare il mondo, per cui l'opportunità di essere salvati è reale per voi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650106,
					"content": "#Sguainate le vostre armi davanti a me solo perché siete {F#state fuorviate}{M#stati fuorviati} da delle falsità. Ma questo non è il momento di sprecare i miei poteri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650107,
					"content": "Gioite. Quando tutto finirà, spiegherò e dimostrerò tutto. Ma ora, posizionate la Spada sacra nella mia mano e scappate verso un rifugio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650108,
					"content": "Non ti daremo la Spada sacra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650109,
					"content": "#Sciocch{F#e}{M#i}, sciocch{F#e}{M#i}. Ma vi perdono e vi salverò comunque.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650110,
					"content": "Riesco a percepire che i quattro ottanti sono stati invertiti. Ma l'albero del flusso non è ancora completo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650111,
					"content": "Non è più possibile salvare tutti. Estenderò la mia benevolenza per quanto possibile, anche se questo significa esaurire la mia forza vitale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650112,
					"content": "Se posso salvare solo cinque persone su dieci, farò tutto il possibile per salvarne sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "Narzissenkreuz"
				},
				{
					"id": 741650113,
					"content": "Ora verrò a prendere la Spada sacra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzissenkreuz"
				}
			]
		},
		{
			"id": 7416502,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
