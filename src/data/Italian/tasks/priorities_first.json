			"dialogs": [
				{
					"id": 760000201,
					"content": "Mmmh... Sembra che questa porta non si apra. Ma Paimon è davvero curiosa di sapere cosa c'è dall'altra parte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000202,
						760000204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000202,
					"content": "Probabilmente non è niente di importante.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000203
					]
				},
				{
					"id": 760000203,
					"content": "Considerando dove si trova, non sembra il tipo di posto dove possa esserci qualcosa di importante...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000206,
					"content": "Comunque, dobbiamo trovare un modo per entrare e dare un'occhiata! Altrimenti, Paimon non troverà pace come quando ha la pancia piena di hot dog di Nod-Krai e non riesce a digerirli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000207,
					"content": "La porta sarà pure chiusa, ma magari c'è un altro modo per entrare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000204,
					"content": "Stanno sicuramente conducendo qualche esperimento malvagio là dentro...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000205
					]
				},
				{
					"id": 760000205,
					"content": "E-Esperimento malvagio... Se è così, la sicurezza qui è troppo permissiva!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				}
			]
