						],
						"pointId": 9634
					}
				]
			},
			"dialogs": [
				{
					"id": 750790301,
					"content": "#{F#Benvenute}{M#Benvenuti}... Uhm, sembra che alcuni di voi abbiano già padroneggiato l'arte del volo. Allora, è {F#questa signorinella}{M#questo giovanotto} che vuole imparare a volare?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790302,
					"content": "Ho già un brevetto di volo a vela.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "Un brevetto di volo a vela? Non ne avevo mai sentito parlare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790305,
					"content": "Qui vogliamo che Saurici e Cavalcatori collaborino per migliorare insieme. Il tuo compagno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790306,
					"content": "Roar, roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "...Uhm, mi spiace, piccoletto, sembra che la Scuola di volo Pakpaka non sia il posto giusto per dimostrare le tue capacità. Non prenderla come un'offesa, non è certo colpa tua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790308,
					"content": "Roar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} è ancora giovane e ha un grande potenziale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "È impossibile che il potenziale di volo di un Tepetlisauro possa competere con quello di un Qucusauro o di un Iktomisauro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790311,
					"content": "#A ogni modo, {F#signorinella}{M#giovanotto}, se ti interessa il nostro addestramento di volo ti consiglio di provare il percorso di allenamento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790313,
					"content": "Cavalcare un Qucusauro richiede di schivare ostacoli e cambiare direzione con agilità. Dopo aver provato il percorso di allenamento, capirai le tue vere abilità!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790312,
					"content": "A dire la verità, ci siamo impegnati molto per promuoverlo. Abbiamo preparato premi, organizzato gare, e tutto il resto. Se superi la prova, vai da Lamizana a riscattare il tuo premio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790304,
					"content": "Cosa puoi insegnarmi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
