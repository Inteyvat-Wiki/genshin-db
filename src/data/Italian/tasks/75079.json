			"dialogs": [
				{
					"id": 750790701,
					"content": "In quanto tuo fratello maggiore e più esperto tra i due, ti insegnerò come integrarti e diventare popolare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790702,
					"content": "Grazie, ma non è necessario. E non sei nemmeno il mio fratello maggiore...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790703,
					"content": "A proposito, puoi smettere di dare cracker a Oberon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790704,
					"content": "Cuuu.... Guguuuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790705,
					"content": "Ehi, moccioso, apri bene le orecchie: se non fosse per tua sorella...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790706,
					"content": "Chiedo scusa, sono qui per riscattare un premio.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "Roar! Roooooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "#Ah, {F#una rara ospite}{M#un raro ospite}. Non vediamo molti Tepetlisauri cuccioli da queste parti. E in più... Beh, hai una certa varietà di amici, direi, no?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790709,
					"content": "#Varietà...?! Paimon e {REALNAME[ID(2)|SHOWHOST(true)]} non hanno nulla in comune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790710,
					"content": "Roar? Rooo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#Eh? No, beh, siamo entrambi compagni di {NICKNAME}, ma non siamo esattamente uguali. Paimon non sta dicendo che uno di noi è meglio dell'altro, non essere triste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790712,
					"content": "La verità fa più male quando viene detta senza intenzione...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#Ehi, non è quello che intendeva Paimon, non provare a complicare le cose. {REALNAME[ID(2)|SHOWHOST(true)]} è un nostro preziosissimo amico!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790714,
					"content": "#Sei un buon compagno, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "Rooo? Roar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#Hihi, Paimon sapeva che l'avresti capito, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790717,
					"content": "Che tacita intesa invidiabile. Dal vostro abbigliamento si capisce che non siete del luogo, eppure la fiducia e l'amicizia che avete stretto con questo Tepetlisauro sono profonde. Qual è il vostro segreto?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790718,
					"content": "Lo dico apertamente: Taruka e il suo Qucusauro sono soci, ma non vanno molto d'accordo. Se conosci davvero un segreto, vorrei che glielo svelassi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790719,
					"content": "Comunque, torniamo a noi... Dove sono i loro premi? Non ditemi che non sono ancora pronti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790720,
					"content": "Certo che sì! Pronti come te a cambiare discorso, in effetti. Ne riparleremo più tardi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790721,
					"content": "Presto si terrà una gara di volo. Se vi interessa, non perdetevela, potrete assistere alla mia sensazionale prestazione! Ora vado, ho altre faccende di cui occuparmi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
