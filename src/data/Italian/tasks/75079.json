			"dialogs": [
				{
					"id": 750790101,
					"content": "È sufficiente passare attraverso quel cerchio... attraverso quel cerchio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790102
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790102,
					"content": "Il percorso di allenamento dovrebbe essere abbastanza semplice ora, no? Cosa? È ancora troppo difficile? Stai dicendo che sarebbe meglio se tutti potessero parteciparvi e superarlo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
