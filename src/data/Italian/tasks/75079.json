			},
			"dialogs": [
				{
					"id": 750790901,
					"content": "È stato davvero facile vincere quei premi... Magari gli incarichi della Gilda degli avventurieri lo fossero altrettanto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790902,
					"content": "#{NICKNAME}, siete {F#delle avventuriere}{M#degli avventurieri}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790903
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790903,
					"content": "Io ho un Manuale dell'avventuriere, Paimon no.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790904
					]
				},
				{
					"id": 750790904,
					"content": "Umpf! Non serve una licenza da avventuriera per esserlo, proprio come a Paimon non serve una licenza di volo per essere brava a volare quanto te!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790905,
					"content": "Ce lo stai chiedendo perché hai un incarico per noi? Un attimo, non dire nulla... Lascia che Paimon provi a indovinare. C'è solo una risposta possibile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790906,
					"content": "#Hai visto quanto {REALNAME[ID(2)|SHOWHOST(true)]} è legato a noi e vuoi sapere i nostri segreti! Non è così?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790907,
					"content": "Roar! Roooooar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790908
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790908,
					"content": "Ehm, no, neanche lontanamente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790909
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790909,
					"content": "Eh? Ma Lamizana ha detto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790910,
					"content": "È lui quello che ha un problema. È davvero bravo ad accattivarsi gli altri. Perfino Oberon lo ascolta dopo che gli dà da mangiare dei Saurocracker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790911
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790911,
					"content": "Arooor, rrroar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790912
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790912,
					"content": "Smettila di comportarti come se la vittima fossi tu. Un Qucusauro di prima classe deve seguire una dieta rigida. E poi, tu ci metti poco a prendere peso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790913
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790913,
					"content": "Quel tipo deve avere un secondo fine per corteggiare così tanto mia sorella Lliwa... Non capisco perché la cosa non sembri turbarla affatto. Anzi, ride spesso anche mentre chiacchierano.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790914
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790914,
					"content": "Eh? Sembra un tipo a posto. Sei prevenuto perché non ti sta simpatico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790915,
					"content": "No, c'è dell'altro. Ultimamente è molto riservato, e non so bene cosa stia combinando...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790916
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790916,
					"content": "Gli adulti hanno sempre tanto da fare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790917
					]
				},
				{
					"id": 750790917,
					"content": "Sì, aveva accennato a una gara di volo, no? Forse è stato impegnato a organizzarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790918,
					"content": "Ha parlato di una gara di volo che si sarebbe tenuta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790919
					]
				},
				{
					"id": 750790919,
					"content": "Ma non ci ha messo molto impegno. I preparativi e il lavoro sporco sono opera di Paran, che ha fatto avanti e indietro con Carrebau per tutto il tempo. È chiaro chi è ad accollarsi i lavori pesanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790920
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790920,
					"content": "Anche io ho sentito qualcosa al riguardo, ieri! Stava parlando di qualcosa di pericoloso con uno straniero, per di più di nascosto. Non ho osato avvicinarmi, perciò non ho sentito tutto, ma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790921
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790921,
					"content": "Li ho sentiti dire \"arriva puntuale il giorno della gara di volo\", \"non allontanarti troppo\", \"vite\", \"l'altra metà alla fine\", e \"discuteremo i dettagli domani sera all'accampamento a nord\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790922
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790922,
					"content": "Come mai hai sentito bene solo la seconda parte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790923
					]
				},
				{
					"id": 750790923,
					"content": "Tutto grazie a Oberon. Era particolarmente irrequieto in quel momento e voleva andare a trovare Lamizana. Alla fine non sono riuscito a fermarlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790924
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790924,
					"content": "Croooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790925
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790925,
					"content": "Non è un complimento, sciocchino. Comunque, l'altra persona se n'è andata velocemente dopo avermi visto inseguire Oberon. E la reazione di Lamizana è stata molto strana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790926
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790926,
					"content": "Oggi deve aver provato a provocarmi perché temeva di essere stato smascherato. Voleva solo trovare una buona scusa per tenermi d'occhio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790927
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790927,
					"content": "Per essere un ragazzino, pensi in modo decisamente complesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790928,
					"content": "Ho capito. Nemmeno tu ti fidi delle parole di un bambino, vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790929
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790929,
					"content": "#Ma è proprio per questo che vorrei chiedere a {NICKNAME} di perlustrare con me l'accampamento a nord stanotte... Sai, nel caso in cui stesse davvero architettando qualcosa di pericoloso...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790930
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790930,
					"content": "#Se è così, dobbiamo fermarlo! Con {F#lei}{M#lui} come testimone, gli altri mi crederanno di sicuro... e anche Lliwa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790931
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790931,
					"content": "#{NICKNAME}, se pensi che siano solo stupidaggini da bambino, allora ti prego, aiutami almeno a trasmettere questo messaggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790932
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790932,
					"content": "Ho scritto una lettera che spiega la situazione. Se non torno entro domani, consegnala a Lliwa, per favore. Le chiederò anche di prendersi cura di Oberon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790933
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790933,
					"content": "Aspetta un attimo! Stai iniziando a essere davvero inquietante. Le cose non possono essere così gravi, no...? Uhm, aspetta, e se invece lo fossero...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790934,
					"content": "#{NICKNAME}, perché non indaghiamo? A Paimon verranno gli incubi se non andiamo a fondo della questione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790935,
					"content": "Volete davvero aiutarmi? Evviva! Allora, stasera ci andremo insieme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790936
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790936,
					"content": "Ce ne occupiamo noi. Tu resta qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790937
					]
				},
				{
					"id": 750790937,
					"content": "Sì! In indagini come questa, essere in troppi tende a complicare le cose. Faresti meglio a rimanere qui e aspettare nostre notizie. Sai, anche Paimon è un'avventuriera esperta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790938,
					"content": "Beh... non posso darvi torto. Resterò qui e mi prenderò cura di Oberon. Devo anche convincere Lliwa a tenersi a distanza da Lamizana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790939
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790939,
					"content": "Allora conto su di voi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taruka"
				}
			]
		},
