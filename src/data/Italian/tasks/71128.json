			"dialogs": [
				{
					"id": 711280201,
					"content": "\"Quando questo albero sarà cresciuto un po', ne taglierò le foglie e ci farò del tè per tutti voi.\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280202
					]
				},
				{
					"id": 711280202,
					"content": "\"Quando quel momento giungerà, inviteremo Vestale delle nuvole e Formamontagne...\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280203
					]
				},
				{
					"id": 711280203,
					"content": "\"Davvero? Pianti alberi a tuo piacimento nel mio territorio e hai il coraggio di blaterare roba del genere?\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280204
					]
				},
				{
					"id": 711280204,
					"content": "...Il giorno in cui le promesse del passato sarebbero state mantenute non era ancora arrivato, ma il vecchio albero silenzioso ricordava ancora il suono di quel giuramento...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280205
					]
				},
				{
					"id": 711280205,
					"content": "...Ormai, l'aroma del tè pervade da tempo la Vallata Chenyu ed è stato portato fino a terre molto lontane...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}