			"dialogs": [
				{
					"id": 741700213,
					"content": "In ogni caso, chi è Kuisel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700214
					]
				},
				{
					"id": 741700214,
					"content": "Non lo so nemmeno io. Non ricordo nessuno all'Istituto di ricerca di Fontaine con quel nome... Forse, per quel che gli riguarda, è forse meglio che non esista nessuno con quel nome?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700215
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700215,
					"content": "Proprio come ha detto lui stesso, Kuisel era un personaggio che faceva comodo. Più era diverso quel personaggio da sé stesso, meglio era. In questo modo era più difficile che qualcuno lo riconoscesse... Anche se questa è solo una mia ipotesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700216
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700216,
					"content": "*sospira* Però, se me lo chiedi, credo che sia cambiato parecchio con il passare del tempo. Non l'ho riconosciuto all'inizio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
