					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "Ce l'hai fatta! Sembra che questa sfida non fosse impossibile, dopotutto! Credo di poter fare richiesta all'Istituto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700402,
					"content": "È un peccato che non abbia finito di controllare tutto quanto, mi tocca ritornarci più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700403,
					"content": "In ogni caso, grazie per il tuo aiuto! Ah giusto, questa è la tua ricompensa. Fai buon viaggio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
