			"dialogs": [
				{
					"id": 741700217,
					"content": "Lasciamo perdere la sfida, cosa mi dici di questi dispositivi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700218
					]
				},
				{
					"id": 741700218,
					"content": "Misterioso, vero? A quanto pare ha apportato... come dire... diverse modifiche a questo posto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700219
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700219,
					"content": "Ormai ricorda ciò che i turisti potrebbero trovare tra antiche rovine... Forse è un giudizio un po' troppo azzardato, però.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700220
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700220,
					"content": "*si schiarisce la voce* Il parere appena espresso è solo la mia opinione personale e non rappresenta l'Istituto di ricerca di Fontaine o il suo punto di vista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
