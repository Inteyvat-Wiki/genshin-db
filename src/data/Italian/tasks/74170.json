			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "Oh, rieccoti qui. Beh, anche io ci sono...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701702,
					"content": "Dopo che l'Istituto ha ascoltato la mia breve relazione, mi è stato chiesto di valutare l'idoneità dell'area come campo di formazione per lo sviluppo della qualità, oltre a svolgere il mio lavoro di recupero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701703,
					"content": "*sospira* Questo è tutto molto familiare. Ricordo che c'è stato un periodo in cui il nostro Segretario amministrativo aveva insistito per far sì che ognuno partecipasse a un addestramento di immersioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701704,
					"content": "Personalmente penso che non serva a niente, ma il lavoro è il lavoro, credo, e un incarico è un incarico... Per non parlare di quanto sia strano questo posto... Voglio dire, unico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701705,
					"content": "È per questo che ho posizionato qualche replica dei rilevatori nell'area. Non preoccuparti, sono tutte finte. Sono sicure al cento per cento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701706,
					"content": "L'obiettivo dell'addestramento attuale è <color=#00E1FFFF>recuperare tutti i rilevatori all'interno dell'edificio entro il tempo limite</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701707,
					"content": "Ti andrebbe di provarci? Posso darti delle ricompense per aver partecipato, farai d'assistente alla ricerca, dopotutto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
