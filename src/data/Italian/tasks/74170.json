			"dialogs": [
				{
					"id": 741700210,
					"content": "Lasciamo perdere la sfida. Cos'è successo a Coutrot?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Essere cacciato via dall'Istituto di ricerca di Fontaine non l'ha fatto rinsavire. È davvero uno stupido.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700212,
					"content": "#Ma nessuno lo sta più supportando ora, quindi puoi stare tranquill{F#a}{M#o}. Non può più causare problemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
