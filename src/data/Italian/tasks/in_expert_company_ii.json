			"dialogs": [
				{
					"id": 741140301,
					"content": "#Hah! Sei {F#la}{M#il} migliore, {NICKNAME}. Davvero {F#la}{M#il} migliore!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140302,
					"content": "Se non fosse per te, tutto quello che c'è nella cassa sarebbe andato perduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140303,
					"content": "Dobbiamo ritornare in città e consegnare le pellicole a Monsieur Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140304,
					"content": "#Dopodiché... mangiamoci un boccone insieme. Se ti va, {NICKNAME}, puoi venire anche tu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140305,
					"content": "Dopo mangiato, ti pagherò la tua ricompensa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140306,
					"content": "Va bene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "Bene! È deciso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140309,
					"content": "Yifeng, porta le pellicole in questa cassa a Monsieur Geisert più tardi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140310,
					"content": "Xingye, vai a comprare delle verdure qui vicino. Mi sono allenata a preparare la zuppa di frutti di mare di Poisson ed è il momento migliore per farla assaggiare a Monsieur Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140311,
					"content": "Capo, stiamo andando a mangiare al ristorante. Perché fai ancora le cose da te?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140312,
					"content": "Per risparmiare...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140313,
					"content": "Ahem! È deciso. Andiamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}, seguimi se vuoi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140307,
					"content": "In effetti ho un po' fame.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
		},
