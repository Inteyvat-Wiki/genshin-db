			"dialogs": [
				{
					"id": 741140401,
					"content": "Questo vaso è piuttosto strano. Mmm... ma dovrebbe utilizzarsi allo stesso modo di quelli di Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140402
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140402,
					"content": "Capo, ecco le verdure, ma sembra che le Marcotte non si trovino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140403
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140403,
					"content": "Non sono riuscito a trovarne neanche un po'.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140404
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140404,
					"content": "#Quello è... l'ultimo ingrediente di cui avevamo bisogno. Beh, ehm, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140405,
						741140406
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140405,
					"content": "Vado a prenderlo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				},
				{
					"id": 741140407,
					"content": "Grazie dell'aiuto. Non preoccuparti, so come lavorano gli avventurieri. So che non è gratis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140406,
					"content": "Includilo nel pagamento.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140407
					]
				}
			]
		},
