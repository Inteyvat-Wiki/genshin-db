			},
			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}, vorrei presentarti un maestro regista: Monsieur Geisert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140602,
					"content": "#Monsieur Geisert, le presento {NICKNAME}, {F#un'esperta avventuriera}{M#un esperto avventuriere}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140603,
					"content": "#Se hai in programma di girare un film d'azione, dovresti decisamente considerare d'ingaggiare {NICKNAME} come per il ruolo di protagonista!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140604,
					"content": "Ahah, la signora Qiu esagera. Non sono un regista esperto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140605,
					"content": "Sono solo una persona che ha abbastanza familiarità con l'uso della luce per la regia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140606,
					"content": "Ah, che modesto che sei. La luce nei tuoi film parla praticamente da sola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140607,
					"content": "Uso della luce per la regia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "Sì. Nella mia teoria delle luci, credo che la loro manipolazione corrisponda alla manipolazione delle emozioni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140611,
					"content": "Ma... Come posso dire...? Le mie teorie devono ancora essere prese in esame dall'industria cinematografica di Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140612,
					"content": "La maggior parte dei registi preferisce usare il movimento diretto o la scena stessa per illustrare le proprie storie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140613,
					"content": "Ho girato qualche film usando solamente le transizioni di luce per esprimere la narrativa, ma non è interessato quasi a nessuno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140614,
					"content": "Ma ora almeno un regista pensa che la mia teoria della luce vale qualcosa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140615,
					"content": "Regista? Io? Ahahah, non scherziamo. Sono solo una che vende il tè.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140616,
					"content": "Chi ha detto che una venditrice di tè non possa essere un regista? Io prima ero solo un giornalista.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140617,
					"content": "Un giornalista... Devi essere bravo a scrivere dei reportage allora. Proprio come quelli sul giornale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140618,
					"content": "Immagino di sì. E quindi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140619,
					"content": "Ah... Così...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140620,
					"content": "Ah! Niente, niente. Mangiamo! Avremo tutto il tempo del mondo per lavorare insieme in futuro, ahahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140621,
					"content": "Tutti si siedono accompagnati dalle risate sincere della signora Qiu.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "Finito di mangiare, la signora Qiu prepara un altro piatto, lo confeziona e te lo mette nella borsa...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "La luce è molto importante quando si parla di regia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "Ovviamente. Nelle mie teorie, la luce è la chiave attraverso cui esprimere l'umore in una scena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				}
			]
		},
