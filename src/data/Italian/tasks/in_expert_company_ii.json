			"dialogs": [
				{
					"id": 741140201,
					"content": "*sospira* Spero che le pellicole non si siano danneggiate con l'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140202
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140202,
					"content": "Non preoccuparti, capo, la cassa è perfettamente sigillata. Non entrerà acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140203
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140203,
					"content": "Per fortuna non è caduta la Videokamera. Altrimenti sarebbe stato un disastro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingye"
