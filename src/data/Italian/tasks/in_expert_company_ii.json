			"dialogs": [
				{
					"id": 741140101,
					"content": "Nessun problema. La nostra cassa è resistente all'acqua. Tutto quello che dobbiamo fare è immergerci e afferrarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140102,
					"content": "Capo, nessuno di noi qui sa immergersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140103,
					"content": "Io so nuotare, ma di immersioni non so niente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140104,
					"content": "L-L'incarico che abbiamo pubblicato alla Gilda degli avventurieri è ancora in bacheca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140105,
					"content": "Capo, prima non hai detto che dovremmo sbrigarci e togliere l'incarico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140106,
					"content": "L'abbiamo fatto ieri. La gilda ha detto che oggi possono restituirci la quota del pagamento anticipato per la pubblicazione dell'incarico.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140107,
					"content": "Se vogliamo pubblicarne un'altra, dovremo pagare un'altra quota per il servizio...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140108,
					"content": "Avete finito il film?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#Avventurier{F#a}{M#e}... {NICKNAME}! Sei arrivat{F#a}{M#o} giusto nel momento del bisogno!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140111,
					"content": "Sai immergerti? O... puoi aiutarmi a cercare qualcuno che sappia immergersi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140112,
					"content": "Volete fare... delle riprese sott'acqua?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "Ne siamo a malapena capaci. E non possiamo permetterci il materiale da registrazione resistente all'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140114,
					"content": "È solo perché la cassa in cui abbiamo messo le pellicole è caduta in acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140115,
					"content": "#D'accordo, voi due, ora basta! {NICKNAME}, devi aiutarci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140116,
					"content": "Non preoccuparti per il pagamento. Ti pagherò in anticipo, come l'altra volta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Signora Qiu"
				},
				{
					"id": 741140109,
					"content": "Cosa ci fate voi qui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
