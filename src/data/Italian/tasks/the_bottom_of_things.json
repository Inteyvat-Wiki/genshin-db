			"dialogs": [
				{
					"id": 1903201201,
					"content": "Uff... sono distrutto. Finalmente posso prendermi una pausa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201202,
					"content": "*sospira* Chissà se ho esagerato... Alcune persone sembravano totalmente terrorizzate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201203,
					"content": "Chi sei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "Eh? Ehi, non dovresti essere qui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201205,
					"content": "*sospira* Lascia perdere. Immagino che tu mi abbia sentito.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201206,
					"content": "Lavoro qui facendo finta di essere un fantasma, ma ora sono in pausa, quindi mi sono tolto il costume. Quando indosso quell'affare mi sembra di essere in un forno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201207,
					"content": "Quindi non ci sono dei veri fantasmi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "Ovviamente, non possono mica esserci dei fantasmi veri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201210,
					"content": "Nessuno vorrebbe vederne uno, né noi né i partecipanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201211,
					"content": "Vengono qui solo per l'atmosfera, o per meglio dire, la possibilità... Tutti cercano l'opportunità di provare il brivido e l'adrenalina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201212,
					"content": "Quando la gente si trova in una situazione spaventosa dice cose che non avrebbe osato pronunciare altrimenti. È questo il senso della prova di coraggio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201213,
					"content": "Penso di capire.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "*sospira* D'accordo... Adesso devo tornare al lavoro. Spero che tu e... chiunque sia con te vi divertiate.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201214,
					"content": "(Chongyun resterà molto deluso.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "È tutto pianificato per spaventare la gente, giusto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
