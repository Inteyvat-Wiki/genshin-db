			"dialogs": [
				{
					"id": 401290101,
					"content": "Suo figlio si sente meglio?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290102,
					"content": "Grazie per averlo chiesto, Freminet. Le sue condizioni sono stabili. Il nostro medico di famiglia ha detto che non dovrebbero esserci problemi nel portarlo a fare un giro fuori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290103
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290103,
					"content": "Zuria! Freminet! Eccoci qua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290104,
					"content": "Eheh, direi che ci siamo tutti, adesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290105
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290105,
					"content": "Non ancora, non manca qualcuno? Ma Paimon ha una mezz'idea di dove potrebbe essere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290106,
					"content": "Ehi! Thelxieeee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290107,
					"content": "-.. -... . -- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290108
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290108,
					"content": "Wow! Thelxie si è portato una spada e uno scudo! Ha un aspetto così fiero.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290109,
					"content": "Eh, già! Con quest'arma in pugno, Thelxie sembra più formidabile che mai. Hai davvero superato te stesso, Freminet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290110
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290110,
					"content": "Abbiamo dato una mano anche noi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290111,
					"content": "Sì, avete davvero buon occhio: i materiali che mi avete portato erano tutti di ottima qualità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290112,
					"content": "A tal proposito, Zuria mi ha appena detto che vuole concludere l'avventura con una cerimonia d'incoronazione, quindi... posso chiedervi di raccogliere anche i materiali per fabbricare la corona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290113,
					"content": "Basterà che li cerchiate sulla strada verso le rovine. Avevo intenzione di andare a raccoglierli da solo, ma mi sono reso conto che voi riuscireste a trovare dei minerali di gran lunga migliori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290114
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290114,
					"content": "Consideralo già fatto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290115
					]
				},
				{
					"id": 401290115,
					"content": "Sembra che siamo pronti ad andare. Vogliamo avviarci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290116,
					"content": "Solo un momento. Stavo pensando... Dato che Thelxie ci ha già mostrato il suo nuovo aspetto, potrebbe essere una buona idea disegnare una nuova pagina all'interno del libro illustrato. Che ne dite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290117
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290117,
					"content": "Ooh, sì! Paimon non vede l'ora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290118,
					"content": "Cosa vorresti disegnare?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290119
					]
				},
				{
					"id": 401290119,
					"content": "Uhm, potremmo usare come riferimento la storia che conosciamo già, ma donandole un'atmosfera meno cupa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290120,
					"content": "Quindi dici di estrapolare le parti tristi e sostituirle con altre più felici? A Paimon sembra un'ottima idea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290121,
					"content": "Va bene, ci provo. Non sono una gran disegnatrice, ma nel mio lavoro ne ho viste tante, di opere d'arte. Riguardo al contenuto effettivo del disegno... ditemi pure cosa vorreste vederci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290122
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290122,
					"content": "Secondo me... dovrebbe mostrare la sua arma. Il principe raccoglie la spada del coraggio e lo scudo della perseveranza, dimostrando di aver superato la palude del dubbio e di essere pronto ad affrontare il potere delle tenebre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290123
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290123,
					"content": "Bene, includerò l'arma... Altre richieste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290124
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290124,
					"content": "Paimon vuole che ci siano anche i suoi amici! Thelxie ora ha degli alleati al suo fianco, non è più costretto a combattere da solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290125,
					"content": "D'accordo, disegnerò dei compagni d'avventura... Altro?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290126
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290126,
					"content": "Non dimenticarti di dare colore al tutto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290127
					]
				},
				{
					"id": 401290127,
					"content": "Il colore. Ah... Ma sì, certo! Questo è importantissimo. Il cammino che si estende davanti a lui non è più un sentiero grigio e fosco, ma una strada traboccante di colore e speranza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290128
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290128,
					"content": "Non mi aspettavo che questa pagina avrebbe generato così tanti stimoli... Che meraviglia. Sono delle splendide idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290129
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290129,
					"content": "Ottimo! Siamo tutti super galvanizzati, specialmente Thelxie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290130,
					"content": "Hai visto, tesoro? Non ti senti entusiasta anche tu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290131
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290131,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290132
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290132,
					"content": "Sono sicuro che lo è, Zuria. E siamo ancora solo alla prima pagina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290133
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290133,
					"content": "Infatti, Paimon non vede l'ora di ammirare il libro una volta che sarà finito tutto! Facciamo il più in fretta possibile, con il cuore sempre colmo di fede e speranza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290134,
					"content": "Mh-mh! Ammetto che quest'eccitazione inizia a contagiare anche me, quindi mettiamoci in marcia e partiamo alla volta del Regno dei folletti dell'acqua!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290135
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290135,
					"content": "Evvai! Le Fantastiche avventure di Thelxie hanno inizio!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4012906,
