			"dialogs": [
				{
					"id": 401290801,
					"content": "Zuria, Freminet, perché non disegniamo prima le nuove pagine? Paimon non vede l'ora di aggiornare il libro illustrato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290802,
					"content": "Ammettilo, vuoi solo che qualcuno disegni la dea Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290803
					]
				},
				{
					"id": 401290803,
					"content": "Ehi! Non c'era bisogno di dirlo ad alta voce!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290804,
					"content": "Ahah, non c'è problema, ne sarò felice. Allora, ecco la mia idea per la storia di oggi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290805
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290805,
					"content": "Dopo innumerevoli peripezie, il principe Thelxie e i suoi prodi compagni giungono finalmente ai cancelli del Regno dei folletti dell'acqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290806
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290806,
					"content": "Al tempo stesso, Paimon, la fatina della compagnia, rivela a tutti la sua autentica natura divina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290807
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290807,
					"content": "Urrà! Arriva la dea, che loda i suoi compagni per la loro purezza e, per premiarli, concede loro un gran numero di benedizioni, pregando che il principe possa riuscire pienamente nel suo intento!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290808,
					"content": "Immersi nella gloria della dea, il principe e i suoi compagni partono alla carica verso il baluardo del male, sgominano tutti i mostri al suo interno e liberano gli splendidi folletti dell'acqua dalla loro prigionia. Il principe riesce infine a reclamare il suo regno, tuttavia la sua corona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290809
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290809,
					"content": "Oh, no, la corona non è ancora pronta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290810,
					"content": "No... Il principe non riesce a ottenere la corona, poiché i mostri l'hanno portata con sé durante la loro fuga. Non hanno rinunciato e sono intenzionati a tornare alla riscossa, ma il principe è certo che riuscirà a riappropriarsi della sua corona nel corso della prossima battaglia. E quando ciò accadrà, un arcobaleno di luce tornerà a risplendere sul regno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290811
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290811,
					"content": "Oh, Paimon riesce già a vederlo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290812,
					"content": "Porca pupazza, queste pagine sono fenomenali... Zuria ha un vero talento per il disegno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290813,
					"content": "Grazie mille a tutti. Con questo, abbiamo completato la seconda pagina del libro illustrato. Il viaggio di Thelxie si avvicina sempre di più al termine e alla tanto attesa incoronazione...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290814
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290814,
					"content": "Tesoro mio... Anche tu ti rallegrerai una volta giunto quel momento, non è vero?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290815
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290815,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290816
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290816,
					"content": "Paimon è sicura di sì, Zuria! Magari il dottore avrà già delle buone notizie una volta tornati a casa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290817,
					"content": "Lo spero di cuore, Altezza Divina. Ah! Freminet, quanto pensi ci vorrà per la corona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290818
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290818,
					"content": "Non preoccuparti, ventiquattro ore saranno più che sufficienti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290819
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290819,
					"content": "Capisco, grazie infinite per il tuo impegno. Perfetto, allora ci rivedremo qui fra due giorni per il finale della nostra avventura, va bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290820
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290820,
					"content": "Per me va benissimo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290821
					]
				},
				{
					"id": 401290821,
					"content": "Allora a fra due giorni, carissimi amici miei. ♪♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290822
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290837,
					"content": "♪♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290822,
					"content": "Bene... Mi sa che è meglio andare anche noi. Tu hai ancora del lavoro da sbrigare, vero, Freminet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290823,
					"content": "Già. Dovrò fare una capatina in città e trovare le parti che mi servono per la base della corona. Vorrei crearne più modelli e scegliere quello che ha l'aspetto migliore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290824,
						401290825
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290824,
					"content": "Freminet si sta impegnando davvero tanto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290825,
					"content": "Freminet sta lavorando davvero sodo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290826,
					"content": "Eh, sì. Paimon sapeva che per te fosse raro accettare incarichi da altre persone... ma non pensava che fossi così tanto scrupoloso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290827,
					"content": "Beh, riguardo a questo... credo sia perché...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290828
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290828,
					"content": "Mmh? Perché...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290829,
					"content": "Perché... spero...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290830
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290830,
					"content": "Eh? Che ti prende? E cos'è quell'espressione? Stai arrossendo... Hai l'aria di uno che è sul punto di rimettersi il casco e scappare via!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290831,
					"content": "Aaah! D-Davvero sto arrossendo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290832
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290832,
					"content": "Non lo prendere in giro, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290833
					]
				},
				{
					"id": 401290833,
					"content": "Hihi, d'accordo, la smetto... Per oggi non ti disturbiamo più, Freminet. Ci rivediamo tra un paio di giorni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290834,
					"content": "...Va bene, grazie. A dopodomani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290835
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290835,
					"content": "Ciao ciao.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290836
					]
				},
				{
					"id": 401290836,
					"content": "...La mia speranza è che chiunque si ritrovi immerso nell'oscurità possa assistere a qualcosa di meraviglioso e ricevere un miracolo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				}
			]
		},
