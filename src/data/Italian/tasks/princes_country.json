			"dialogs": [
				{
					"id": 401290901,
					"content": "Così, queste sono le rovine sommerse che ha trovato Freminet... Sono formidabili, ma non esattamente ciò che si aspettava Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290902,
					"content": "Questo è il Regno dei folletti dell'acqua, Paimon, non sono rovine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290903
					]
				},
				{
					"id": 401290903,
					"content": "Oh, già, Paimon lo sa benissimo, è solo che... Paimon si aspettava di vedere un mondo fatato, con folletti dell'acqua che abitano in case colorate e ponti arcobaleno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290904,
					"content": "Mi dispiace... Speravo di poterci mettere qualche decorazione, ma non ne ho proprio avuto il tempo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290905,
					"content": "Non c'è problema, la fantasia supplisce a tutto!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "Porca pupazza, hai già attivato la modalità Fantasia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290907,
					"content": "#Sembra che {NICKNAME} abbia afferrato la situazione. Dovresti fare lo stesso anche tu, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290908,
					"content": "Ah, non sottovalutare Paimon! Anche Paimon ci riesce senza problemi. Paimon modalità Fantasia... attivata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290909,
					"content": "Ahem... Baldanzosi avventurieri! È Paimon, la dea guardiana di codeste terre, che vi parla. Dichiarate i vostri intenti e il motivo che vi ha spinto sino a questa nazione!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290910,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290911,
					"content": "Siamo compagni del principe Thelxie, o Altezza Divina. Siamo giunti qui per aiutarlo a reclamare la gloria che egli ha perduto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290912,
					"content": "Ooh! Reclamare la gloria! La vostra dea possiede tante glorie: una gloria dorata, una gloria argentata e una gloria bronzata. Quale di esse ha perduto il principe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290913,
					"content": "Cosa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290914,
					"content": "Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290915,
					"content": "Sei uscita dal personaggio, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "Ma quando mai! Questa è la prova della dea! Sulla base delle risposte che avete offerto, la dea ha stabilito che siete degli avventurieri valorosi, senza macchia e senza paura! Come tali, siete degni del più assoluto rispetto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290917,
					"content": "Accettate pertanto le ricompense della dea. Costei concederà a tutti voi tutti i tre tipi delle sue glorie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290918,
					"content": "In quanto al principe... la dea ti concede altresì la gloria iridata, affinché il tuo futuro possa essere più radioso che mai!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290919,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290920
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290920,
					"content": "Ti siamo grati, o Altezza Divina, per queste generose benedizioni. Sento ogni fibra del mio corpo infondersi del tuo mistico potere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290921
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290921,
					"content": "A-Anche... Anche io... Che sia la divina ispirazione di cui narra la leggenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290922
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290922,
					"content": "Rendiamo grazie alla dea Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290923
					]
				},
				{
					"id": 401290923,
					"content": "Hihi! Dunque, avventurieri, proseguite nella vostra impresa e sgominate i mostri che dilagano nel regno! Troverete senza fallo ciò che state cercando!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
