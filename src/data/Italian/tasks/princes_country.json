			"dialogs": [
				{
					"id": 401290601,
					"content": "Fiuuu, è finita! Quindi, abbiamo finalmente sconfitto i mostri malvagi e reclamato il Regno dei folletti dell'acqua?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290602,
					"content": "Sì, ed è tempo di assistere alla cerimonia d'incoronazione di Thelxie... Però, devo ammettere che non credevo sarebbe stato così facile. Pensavo che raggiungere il cuore delle rovine sarebbe stato più impegnativo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290603
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290603,
					"content": "È colpa mia. Avrei dovuto dire prima a Freminet che ci sarebbe servita una corona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290604
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290604,
					"content": "#Questo perché {NICKNAME} e la dea Paimon sono troppo potenti! Abbiamo sterminato tutti i mostri in un colpo solo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290605,
					"content": "È tutto a posto, Zuria. Possiamo sempre ritornare una volta fabbricata la corona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290606
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290606,
					"content": "Allora grazie a tutti per il vostro tempo. E grazie anche a te, Thelxie, tesoro mio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290607
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290607,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290608
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290608,
					"content": "Thelxie si è dimostrato un combattente davvero esperto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290609,
					"content": "Credo che niente possa essere in grado di fermarlo... Ora è un vero principe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290610
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290610,
					"content": "Esatto! Anch'io sono d'accordo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290611
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290611,
					"content": "#Torniamo all'accampamento, per ora. Ho chiesto a {NICKNAME} di cercare dei materiali lungo la strada, così potrò creare la corona il prima possibile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290612
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290612,
					"content": "E possiamo anche aggiornare Le Fantastiche avventure di Thelxie! Ora che abbiamo reclamato il Regno dei folletti dell'acqua, possiamo aggiungere una nuova pagina al libro illustrato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
