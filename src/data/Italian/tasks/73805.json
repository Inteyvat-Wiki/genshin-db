					"nextDialogs": [
						738050106
					]
				},
				{
					"id": 738050106,
					"content": "Non ne ho idea. So solo che è passato di fretta l'altro giorno e ha lasciato la lettera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050107
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050107,
					"content": "Voleva assicurarsi che te la consegnassi. Si è persino offerto di pagare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050108
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050108,
					"content": "Xudong è venuto qui... di fretta? Dev'essergli capitato qualcosa.",
