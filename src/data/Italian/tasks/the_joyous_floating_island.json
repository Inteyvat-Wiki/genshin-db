			},
			"dialogs": [
				{
					"id": 762020401,
					"content": "Pensate che abbia esagerato? Non preoccupatevi, è molto più semplice di quel che sembra: vi basterà riflettere un po', setacciare il posto da cima a fondo e reclamare il premio alla fine. È il vostro pane quotidiano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
