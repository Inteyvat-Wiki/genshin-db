			"dialogs": [
				{
					"id": 762020601,
					"content": "Woah! Perché è scivolata giù all'improvviso così? E quella è... una statua di Mandragora gigante?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020602,
					"content": "Clunk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020603
					],
					"speakerTitle": "Esamina la porta"
				},
				{
					"id": 762020603,
					"content": "Aspettate un attimo. Scusate, un piccolo problema tecnico. Fatemi vedere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020604,
					"content": "Clic... Clac...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "Esamina la porta"
				},
				{
					"id": 762020605,
					"content": "Si sta muovendo! Ehi! Ma ci sta attaccando?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020606,
					"content": "Ah-ha, molto meglio...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762021401,
					"content": "In che senso, \"molto meglio\"?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762021402,
					"content": "#Mmh? Dai, ti sta attaccando a malapena. Puoi sopportare un po' di solletico vivace, no? Inoltre, questa è l'occasione perfetta per {NICKNAME} di mettere in mostra qualche abilità.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021403
