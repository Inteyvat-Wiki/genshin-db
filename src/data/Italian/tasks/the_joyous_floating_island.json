			},
			"dialogs": [
				{
					"id": 762020201,
					"content": "Vi do il benvenuto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020202,
					"content": "Ciao, Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "Wow, che bella casa! A Paimon piace tantissimo come l'hai arredata!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020205,
					"content": "Eheh, sapevo che avresti apprezzato, Paimon. Sentirti parlare così mi ripaga di ogni cosa, anche se ho dovuto ritagliarmi del tempo libero per farcela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020206,
					"content": "Tutto è iniziato il giorno in cui ho finito di costruire questo rifugio segreto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020207,
					"content": "Volevo proseguire sulla stessa scia e costruirne altri, ma non ero minimamente ispirata. Così, dopo un po', il mio entusiasmo si è semplicemente... spento.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020208,
					"content": "\"Davvero non esiste un modo per divertirsi, godersi la vita e sentirsi realizzati allo stesso tempo?\" Poi, la risposta mi è balenata all'improvviso nella mente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020209,
					"content": "Cosa? Siamo già alla risposta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020210,
					"content": "Stai al passo, Paimon! Chi ha tempo non aspetti tempo. Guarda, è proprio davanti a te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020211,
					"content": "Al di là di questa porta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020212,
					"content": "#Beh, non solo di questa porta, ma non hai sbagliato. Tutto deve iniziare da qualche parte, e quale posto migliore di questo? Siete {F#pronte}{M#pronti}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020213,
					"content": "#A-Aspetta un attimo, stai correndo troppo! Paimon non riesce a starti dietro... {F#Pronte}{M#Pronti} per cosa, esattamente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020214,
					"content": "Oh, non preoccuparti. Non devi essere pronta per nulla, è solo un modo di dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020215,
					"content": "Stando a quanto ho osservato e compreso... non siete persone a cui piacciono le presentazioni e le spiegazioni complesse. Preferite tuffarvi direttamente nel vivo dell'avventura, dico bene?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020216,
					"content": "Beh, non posso dire che ti sbagli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "Ahah, sono felice di sentirlo! In tal caso, tenetevi forte, non intendo trattenermi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020219,
					"content": "Noi angeli siamo fatti così: non sappiamo resistere alla soddisfazione di guidare gli avventurieri verso un tesoro.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020220,
					"content": "#Beh, visto che l'obiettivo è essere gentili e aiutare gli altri a trovare la felicità, perché non dovrei iniziare dando {F#alle mie amiche}{M#ai miei amici} qualche dritta in merito?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020221,
					"content": "Così ho avuto un lampo di genio! Ho trasformato il mio piccolo rifugio in un luogo dove rilassarsi e divertirsi. Ho persino nascosto un tesoro in ogni singola stanza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020222,
					"content": "A dire il vero, anche rispetto agli altri angeli, sono un'autentica esperta quando si tratta di nascondere le cose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020223,
					"content": "Se seppellissi un baule in mezzo alla natura senza mostrarvi la strada, temo che non riuscireste a trovarlo nemmeno dopo mesi di ricerche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020224,
					"content": "Ahem! Comunque... non divaghiamo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020225,
					"content": "Non voglio complicarvi la vita di proposito, né mi serve che andiate in giro per la natura al solo scopo d'intrattenermi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020226,
					"content": "Tutto quello che dovete fare è trovare tre piume all'interno di questa stanza! Una volta fatto, ditemelo... Così potrò guardarvi mentre aprite la vostra ricompensa: un bel baule del tesoro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020227,
					"content": "Ahhh, quindi andiamo a caccia di tesori! Paimon è veramente euforica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020228,
					"content": "Esatto! Sarà una caccia al tesoro divertentissima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020217,
					"content": "Ma per stavolta mi piacerebbe avere un'infarinatura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "È un onore essere qui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
