							262.817,
							74.075,
							287.736
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762020301,
					"content": "Un'improvvisa folata di vento ti sfiora il volto.\\nChe strano... Nella brezza senti un aroma di fagottini alla frutta, torta Midsommar, arrosto croccante e caramelle alle erbe e alle bacche.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "Urgh! Una folata super dolciastra è appena entrata in gola a Paimon! *tossisce* Ehi! Dove siamo? Quella teiera e quelle tazze sembrano davvero \"giganteschiche\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020303,
					"content": "#Aspetta un attimo... Ci siamo {F#rimpicciolite}{M#rimpiccioliti}?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020304,
					"content": "Sembra che sia opera della magia di Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "Domando scusa, speravo d'invitare degli attori animali, ma ahimè... Di solito ho a che fare con attori... \"monolitici\", se così possiamo dire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020306,
					"content": "Eh? Nicole, ti sei rimpicciolita anche tu? Paimon pensava che saresti stata enorme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020307,
					"content": "Nicole, la \"Magnifica e Maestosa Maga\", che sorregge i cieli accovacciandosi per parlare? No, grazie! Sono piuttosto soddisfatta della mia taglia attuale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020308,
					"content": "#Cooomunque... {F#Benvenute}{M#Benvenuti} al Tè della Grande Maga! Prego, servitevi pure!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
