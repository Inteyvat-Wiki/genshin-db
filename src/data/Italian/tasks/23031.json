						230310402
					]
				},
				{
					"id": 230310402,
					"content": "Il mio intuito di oggi mi dice... Che ne pensi di un fungo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310403
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310403,
					"content": "I funghi che uso di solito si trovano in un'area speciale, ti mostro dove puoi trovarli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310404
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310404,
					"content": "Trova questo tipo di fungo per me, per favore.",
					"roleType": "TALK_ROLE_NPC",
