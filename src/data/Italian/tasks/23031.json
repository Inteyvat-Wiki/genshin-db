					"nextDialogs": [
						230310202
					]
				},
				{
					"id": 230310202,
					"content": "Il mio intuito di oggi mi dice... pesca di Zaytun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310203,
					"content": "È molto comune, ma pochi la considerano un ingrediente con cui realizzare un'esca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310204
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310204,
					"content": "Potresti trovarne una per me?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
		},
