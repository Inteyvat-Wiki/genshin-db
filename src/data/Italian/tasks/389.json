				}
			]
		},
		{
			"id": 38906,
			"completionStepIds": [
				38906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
