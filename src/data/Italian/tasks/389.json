			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3890601,
					"content": "Oh, non possiamo proseguire. Sembra che le rovine siano protette da antichi <color=#00E1FFFF>sigilli</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890602,
					"content": "Che sia opera di Dvalin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890603,
					"content": "No, non è opera sua. In passato queste rovine facevano parte di un'antica città. Dvalin ne ha semplicemente fatto il suo covo momentaneo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890604,
					"content": "Queste rovine esistevano da molto prima della nascita dei Quattro Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890605,
					"content": "Mondstadt è una città senza alcun sovrano. Tuttavia, in passato ne aveva uno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890606,
					"content": "Ed era un tiranno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890607,
					"content": "In ogni caso... Vi canterò la sua storia non appena ne avremo l'occasione.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890608,
					"content": "Guardate i segni su questo sigillo... Se le mie conoscenze archeologiche non mi ingannano, questo è un <color=#00E1FFFF>attuatore di luce</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890609,
					"content": "Se recuperiamo e <color=#00E1FFFF>reintegriamo</color> tutte le sue <color=#00E1FFFF>parti</color>, forse riusciremo a <color=#00E1FFFF>farlo funzionare</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890610,
					"content": "Non dovrebbe mancare molto al termine del rituale di questo attuatore.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3890611,
					"content": "Rimettiamo <color=#00E1FFFF>l'ultima parte</color> a posto e vediamo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		}
	]
