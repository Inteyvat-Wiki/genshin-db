			"dialogs": [
				{
					"id": 3890301,
					"content": "Non possiamo passare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890302,
					"content": "È bloccato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890303,
					"content": "Ehi, date un'occhiata a quel <color=#00E1FFFF>tetto</color>. Sbaglio o c'è un <color=#00E1FFFF>buco</color> enorme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890304,
					"content": "Mmh... Potremmo sfruttare quella <color=#00E1FFFF>corrente d'aria</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890305,
					"content": "Allora facciamo una piccola deviazione e andiamo su!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890306,
					"content": "Allora facciamo una piccola deviazione e andiamo su!",
					"roleType": "TALK_ROLE_NPC",
