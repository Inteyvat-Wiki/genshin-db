			"dialogs": [
				{
					"id": 752380101,
					"content": "Il tè è di tuo gradimento o preferiresti qualcosa di più forte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 752380102,
					"content": "Il tè va benissimo. Mi sento in colpa a bere alcolici durante il giorno... Preferisco non farlo troppo spesso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380103,
					"content": "Comunque, cosa ti porta a Natlan, signorina Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380104,
					"content": "Sto solo viaggiando un po', faccio visita a delle vecchie conoscenze. Inoltre, volevo ringraziarti per aver accettato di aiutarmi durante la Festa di Fontinalia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 752380105,
					"content": "Sei troppo gentile. E sei venuta fin qui solo per questo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380106,
					"content": "Beh... L'ultima volta sei stata così cortese da non sollevare l'argomento, ma so benissimo di averti causato dei problemi, in passato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 752380107,
					"content": "Ah... La faccenda col tuo subordinato, intendi? L'incidente che coinvolgeva Ineffa, la robottina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380108,
					"content": "Eheh... Strana la vita, vero? Ritrovarsi improvvisamente amica del capo del tuo ex nemico... Addirittura ritrovarsela come capo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380109,
					"content": "Spero che accetterai questo come piccolo gesto di scusa da parte mia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 752380110,
					"content": "M-Ma è... Un'edizione limitata... No, un'edizione da collezione?! Ed è il mio genere preferito?! C-Come facevi a saperlo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380111,
					"content": "#Ho chiesto consiglio a {NICKNAME}. {F#Lei}{M#Lui} conosce abbastanza bene i tuoi gusti letterari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME}...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380113,
					"content": "(Uff...! Cosa sono questi sentimenti contrastanti?! È come se fossi entusiasta e imbarazzata allo stesso tempo.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380114,
					"content": "#(Naturalmente sono lusingata che {F#lei}{M#lui} sappia cosa mi piace, ma deve proprio andarlo a dire a tutti? Preferirei che mi facesse semplicemente un regalo di persona!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380115,
					"content": "Ti piace?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 752380116,
					"content": "Ah... G-Grazie! Sei troppo gentile, signorina Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380117,
					"content": "#Se le tue preferenze sono queste, la prossima volta posso portartene altri. Naturalmente, quando arriverà il momento, dovrò disturbare {NICKNAME} per sceglierli insieme a me.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 752380118,
					"content": "#...C-Con te? Vuoi dire che... siete {F#andate}{M#andati} in libreria insieme a prenderlo?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380119,
					"content": "#Sì. Sembrava {F#determinata}{M#determinato} a scegliere quello perfetto. Magari la prossima volta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 752380120,
					"content": "...Non ci sarà nessuna prossima volta!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380121,
					"content": "Ah... Io... Ehm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "La Marionetta"
				}
			]
		},
		{
