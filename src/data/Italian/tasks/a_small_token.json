					"Citlali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752380201,
					"content": "#Uff... Aspetta solo che {F#le}{M#gli} metta le mani addosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380202,
					"content": "(Restiamo sedute così ancora per un po'.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "La Marionetta"
				},
				{
					"id": 752380204,
					"content": "Si è fatto tardi? D'accordo, signorina Guillotin, fa' attenzione lungo la strada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380203,
					"content": "Credo sia ora di andare.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "La Marionetta"
				}
			]
		}
	]
