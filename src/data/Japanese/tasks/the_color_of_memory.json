						],
						"pointId": 9679
					}
				]
			},
			"dialogs": [
				{
					"id": 150290201,
					"content": "我らは時の中を羽ばたく鳥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290203,
					"content": "（ムービー）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "よく分かってるじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290205,
					"content": "こ…これがオイラたちの作ろうとしてたウォーベン？シトラリ、なんで作り方を知ってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290206,
					"content": "パイモン、これが「神の贈り物」の正体。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "シトラリは二百年以上生きてて、しかもウォーベンの作り方を知ってる…まさか、シトラリがずっとウォーベンを贈ってた「神様」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290208,
					"content": "お告げに選ばれたヒトと会いたくなくて、いつも幻術を使ってウォーベンを残してたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290209,
					"content": "そのヒトたちがそれを「神の贈り物」としか思わなかったのは、ワタシの巫術を見抜けるようなチカラがなかったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290210,
					"content": "どうして黙ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "そうだぞ。なんで二百年もその使命を一人で背負ってたんだ？他の人と接するのが嫌でも、作り方を教えることはできただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290212,
					"content": "…旅人、キミはあの「色」が見えるのよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290213,
					"content": "うん、見える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "あの「色」の本質は「記憶」よ。記憶から色を探す過程で、このウォーベンは染まるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290215,
					"content": "この秘術を継がせるには、まずは誰かと記憶を分かち合い、お互いの記憶に色を残さなきゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290216,
					"content": "イマになってようやくそれが分かった——まあ、前々からいくらか思い当たる節はあったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290217,
					"content": "ウィツィリンがいなくなって、ワタシはヒトと繋がりを持つのをずっと避けてたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290218,
					"content": "そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290219,
					"content": "でも、これは彼女の最期のお願いだったし、ワタシって寿命が長いでしょ。だから、この使命を背負ってあげてもいいと思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290220,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "トラポ"
				},
				{
					"id": 150290221,
					"content": "それなのにクローってば、新しいヒトを選び続けるんだもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290222,
					"content": "新しい友達を紹介しようとしたんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "…ええ、それは最初から気付いてた。記憶を分かち合いたいと思わせてくれるヒトとなら、きっとトモダチになると考えたのよ、このコは。それなのに、ワタシはずっと拒み続けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290224,
					"content": "ま、今回はキミの勝ちよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290225,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "トラポ"
				},
				{
					"id": 150290226,
					"content": "…受け取って。これがキミへの返事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290227,
					"content": "それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290228,
					"content": "「ワタシの色」を選ぶとしたら、それはそのハンカチの色よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290229,
					"content": "この数百年、他人がワタシの記憶の中を生きてきた。けどいつか、ワタシも誰かの記憶の中を生きるコトになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290230,
					"content": "キミ、寿命が長いって言ってたでしょ？つまり、キミが記憶を背負うにふさわしいヒトってコトよ…キミの記憶に、ワタシの色が残ってくれたらなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290231,
					"content": "これで正真正銘、友達だね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "…ちゃんと持っててよ。その時が来たら、色を間違えないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290233,
					"content": "友達になったばっかなのに、もうお別れする時の話をするのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290234,
					"content": "トモダチって、そんなもんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290235,
					"content": "うぅ、重い約束だな…でも、もし旅人がシトラリの記憶に色を残すとしたら、きっと金色だろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290236,
					"content": "それなら、もう残ってる。あの治せなかった副作用があるでしょ？イマになって、ようやくその理由が分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290237,
					"content": "感覚を共有する秘術は意識レベルの交わりだから、自然と「記憶」も関わってくるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290238,
					"content": "キミと感覚を共有したとき、色が記憶に「繋がり」を残したんでしょう。まさか、キミもワタシと同じように、あの「記憶の色」が見えてるなんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290239,
					"content": "そして、その繋がりは秘術に影響を及ぼし、副作用を起こさせた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290240,
					"content": "なるほど。旅人がシトラリの記憶に色を残したから、シトラリは旅人の心の声が聞こえるようになったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290241,
					"content": "じゃあ、旅人がシトラリの心の声を聞いたのは、その逆ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290242,
					"content": "実際は秘術への深い造詣も関わってくるから、もう少しフクザツだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290243,
					"content": "ほら、現に旅人の副作用はしばらく続いたあと落ち着いたのに、ワタシのほうはイマも残ってるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290244,
					"content": "でも安心して。原理はもうパーペキに理解したし、すぐ治せるハズよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290245,
					"content": "そっか、良かったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290246,
					"content": "（まあ、ウソなんだけど…ホントは、相手が自分の記憶にどれだけ深い印象を残したかによって、ココロの声が聞こえるかが決まるのよね。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290247,
					"content": "（今回こうして一緒に過ごしたコトで、旅人にはまたワタシのココロの声が聞こえるようになってるかも。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290248,
					"content": "（あれ！？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "（やっぱりね…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290250,
					"content": "（何か解決策はある？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "（記憶による繋がりである以上、唯一の解決策は、キミがワタシを忘れるか、ワタシがキミを忘れるしかない。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290252,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "（ジョーダンよ。ワタシは謎煙の主の大シャーマンなんだから。副作用の原因が分かったイマ、いくらでも治しようはある。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290254,
					"content": "（ただ、ちょっと時間がかかると思う…当面はガマンしてちょうだい。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290255,
					"content": "（ワタシは隠しゴトなんてないし、聞こえたところで困らないけど…あっ、酔った勢いで言ったのはノーカンね。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290256,
					"content": "（治っちゃうんだ？ちょっと残念…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "（ザンネン？こんなテレパシーが楽しいの？ならもう一回、共感の秘術を使えばいいコトよ。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290258,
					"content": "（あ、先に言っておくけど、イマのは約束したワケじゃないからね。だって、ココロの中に隠しておいたほうがいいコトもあるでしょ？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290261,
					"content": "ん？…んん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290259,
					"content": "（治るんだ？よかった。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "（ええ。やっぱり、ココロの中に隠しておいたほうがいいコトもあるしね。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "シトラリ"
				}
			]
		},
