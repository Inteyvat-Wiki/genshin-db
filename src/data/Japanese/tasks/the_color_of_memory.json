			"dialogs": [
				{
					"id": 150290401,
					"content": "おお、完成したのか？どうやら「七彩の戦い」を調べる冒険は大きな収穫をもたらしてくれたみたいだね。詳しく教えてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290402
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290402,
					"content": "もうウォーベンができたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290403
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150290403,
					"content": "さすがトラポ様に選ばれた人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290404
					],
					"speakerTitle": "アイワスティン"
				},
				{
					"id": 150290404,
					"content": "ええと…旅人が詳しく話すから聞いてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290405,
					"content": "「色」に関するすべてをビラムに説明した。だが、シトラリに関する部分は伏せておいた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290406
					]
				},
				{
					"id": 150290406,
					"content": "なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290407
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290407,
					"content": "ぜんぜん驚いてないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290408,
					"content": "ああ、歴史は部族の記憶であり、記憶の中の色でしか歴史は描けないからね。なんとなく想像はしていたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290409
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290409,
					"content": "あとは、この秘術を伝承させる方法を考えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290410
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290410,
					"content": "旅人の話だと、秘術を伝承させるには、自分の記憶を共有する必要があるんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290411
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290411,
					"content": "えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290412,
					"content": "じゃあ旅人の話をもとに、祭司に秘術を作ってもらうしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290413
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290413,
					"content": "記憶は貴重なものだ。ほとんどの人は一番大切な人としか共有したくないだろう。君に代わって、そんな決断をすることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290414
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290414,
					"content": "旅人はこの使命を見事果たしてくれた。伝承の使命は謎煙の主に任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290415
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290415,
					"content": "おう、頼んだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290416,
					"content": "それと、近々黒曜石の老婆に会うことがあったら、よろしく伝えておいてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290417
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290417,
					"content": "あの方が捕まえたフォンテーヌの商人を尋問したところ、ここ最近「七彩の戦い」の真偽を疑う民たちが現れたのは、彼にあおられてのことだと発覚した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290418
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290418,
					"content": "あの商人はわざわざ人を雇って噂を流し、人為的にいざこざを引き起こしていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290419
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290419,
					"content": "彼の罪をまとめ、近いうちにフォンテーヌとの外交で処理を進めるつもりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290420
					],
					"speakerTitle": "ビラム"
				},
				{
					"id": 150290420,
					"content": "なるほど。あいつ、いざこざの隙につけ込んで調査してたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290421,
					"content": "だと思ったぜ！だって、自分とこの部族の英雄だもんな。その活躍を疑うわけないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290422,
					"content": "#じゃあ、{M#俺}{F#私}たちはこれで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290423
					]
				},
				{
					"id": 150290423,
					"content": "ああ、また会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ビラム"
				}
			]
		},
