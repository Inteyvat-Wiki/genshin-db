					}
				]
			},
			"dialogs": [
				{
					"id": 150290101,
					"content": "あのウォーベンを作るのに、キミの手を煩わすコトはない。でもあの秘術を受け継ぐのは、キミ以外にありえないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290102,
					"content": "ええと…なに言ってんだ、シトラリ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290103,
					"content": "ついて来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290104,
					"content": "この部屋…シトラリも普段ウォーベンを作ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290105,
					"content": "ウォーベン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290106,
					"content": "——ウォーベン？人生でイチバンの自信作を見せてくれるって話だったでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290107,
					"content": "騙したわけじゃないの、友よ。この秘術はウォーベンと関係してるってだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290108,
					"content": "ふぅん…一体どんな秘術？戦況をひっくり返せるとか？それとも災いを止められるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290109,
					"content": "今のキミじゃ、ケンカを売ろうにも起き上がれないだろうし、口ゲンカで勝たせてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290110,
					"content": "ゴホッ…シトラリ、あたしにはもう時間がないんだよ。あなたと勝負する時間がね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290111,
					"content": "ちょっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290112,
					"content": "そんな顔しないで。謎煙の主にはこういう言い伝えがあるでしょ？この地に住む人々は死ぬんじゃない、夜神の国へ——記憶で出来た国に行くだけだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290113,
					"content": "どうして先祖たちが色鮮やかなウォーベンで歴史を記録してきたか、あなたもなんとなく分かってるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290114,
					"content": "「歴史」は部族の「記憶」なんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290115,
					"content": "あの世界に行っても夕日の暖かさを感じられるように、「歴史」をオレンジ色で染めよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290116,
					"content": "あの世界に行っても実りの季節を楽しめるように、「歴史」をグレインの実の模様で飾ろう、とね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290117,
					"content": "それは気付いてた…でも部族の重要な公務なのに、どうして弟子たちに頼まないワケ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290118,
					"content": "あなたを呼んだのは、個人的な想いからだよ——だって友達でしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290119,
					"content": "ゴホッゲホッ…あなたに理解してもらうには、残された時間じゃ足りないかもね。けど、いつか分かってくれるって信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290120,
					"content": "あたしの最期のお願いを、聞いてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "ウィツィリン"
				},
				{
					"id": 150290121,
					"content": "…今回だけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290122,
					"content": "ようやくキミの想いを理解できた。クロー、これを外に運んで。染めるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290123,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "トラポ"
				},
				{
					"id": 150290124,
					"content": "旅人とパイモンも一緒に来て。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				}
			]
		},
