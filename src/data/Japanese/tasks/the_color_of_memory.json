						150290502
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290502,
					"content": "おう！シトラリのことは隠しておいたぜ。危うくバレるところだったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290503,
					"content": "キミたちも「神の贈り物」だとか言ってごまかせば良かったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290504
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290504,
					"content": "ビラムの努力は報われるべきだから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290505
					]
				},
				{
					"id": 150290505,
					"content": "…分かってる。彼はイマまでの族長とちょっと違うしね。ただ、もしバレたら厄介事に巻き込まれると思っただけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290506
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290506,
					"content": "探しました。ここにいたんですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290507
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150290507,
					"content": "フォンテーヌの研究員じゃんか…あの悪徳商人と一緒のところにいると思ったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290508,
					"content": "アリエとお呼びください…僕も取り調べを受けましたが、実際は何の罪も犯していないので釈放されたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290509
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150290509,
					"content": "雇い主を失った今、僕はできるだけ早くフォンテーヌに戻らないとなりません。何しろ、資金源がなくなってしまいましたからね。でもナタを離れる前に、調査を終わらせたいと思いまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290510
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150290510,
					"content": "ナタ人以外にもウィツィリンの功績を知ってもらえるよう、彼女の物語を補完していただけないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290511
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150290511,
					"content": "取材？メンドーね…外のヒトがワタシたち部族の物語を知ってるかどうかなんて気にもしないんだけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290512
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290512,
					"content": "誤解なさらないでください。あなたたちの歴史を改ざんしたり、それで利益を得たりするようなことはしません。僕はただ、他の国の歴史に興味があるだけなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290513
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150290513,
					"content": "本当に素晴らしい物語は、テイワット全土に知れ渡るべきじゃありませんか？文化だってそういった交流を経て、育まれてきたのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290514
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150290514,
					"content": "確かに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290515
					]
				},
				{
					"id": 150290515,
					"content": "じゃあ、早くしてちょうだい。これから大事な予定が入ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290516
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290516,
					"content": "「大事な予定」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290517,
					"content": "ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290518
					],
					"speakerTitle": "アリエ"
				},
				{
					"id": 150290518,
					"content": "アリエはウィツィリンに関する様々な質問をした。シトラリがしびれを切らしたことで、彼はようやく去って行った。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290519
					]
				},
				{
					"id": 150290519,
					"content": "…ハァ、今日もまた「交流」の活動限界を迎えるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290520
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290520,
					"content": "#もうそろそろ{M#俺}{F#私}たちも行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290521
					]
				},
				{
					"id": 150290521,
					"content": "え、ちょ…待ちなさい。絶版本二冊、まだもらってないんだけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290522
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290522,
					"content": "あっ、悪い…やっぱ娯楽小説のこととなると、シトラリは本気度が増すな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290523
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290523,
					"content": "ただ、すぐには見つからないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290524
					]
				},
				{
					"id": 150290524,
					"content": "分かってる。あの絶版本の希少性はキミよりもよく知ってるつもりだから。もしかすると稲妻の八重堂まで行く必要があるかもね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290525
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290525,
					"content": "すぐに見つけてくれとは言わないけど、忘れずに覚えておいてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290526
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290526,
					"content": "おう、見つけたらすぐシトラリのとこに持ってくぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290527,
					"content": "持ってく…二日酔いのときにドアを叩く音で起こされるのはヤだから、こうしましょう…はい、これ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290528
					],
					"speakerTitle": "シトラリ"
				},
				{
					"id": 150290528,
					"content": "これって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290529
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150290529,
					"content": "…うちのカギ。ウルサイのはカンベンだから、次はノックせずに入ってきてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトラリ"
				}
			]
		},
