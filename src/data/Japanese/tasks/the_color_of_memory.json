			"dialogs": [
				{
					"id": 150295101,
					"content": "ナタの英雄が「アビス」に勝った偉業か…確かに、あの特別なウォーベンに記録されるべきだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295102
					],
					"speakerTitle": "カホロム"
				},
				{
					"id": 150295102,
					"content": "次の「お告げ」まで、あとどれくらいだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295103
					],
					"speakerTitle": "アイワスティン"
				},
				{
					"id": 150295103,
					"content": "そういえば昨日、トラポ様が急にいなくなったって報告があったわ。何があったか知らない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295104
					],
					"speakerTitle": "ベスーチ"
				},
				{
					"id": 150295104,
					"content": "イクトミ竜の族親の行動には深い意味がある。我々には理解できないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チョガン"
				}
			]
