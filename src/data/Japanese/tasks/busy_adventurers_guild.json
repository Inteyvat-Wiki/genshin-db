			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "ごめんなさい、またあなたを呼んでしまって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050102,
					"content": "大丈夫、いつも世話になってるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "そう言ってもらえると助かります。なるべく手短に言いますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050106,
					"content": "この間は協会の依頼を達成してくださってありがとうございます、おかげで冒険者協会の評判もますますよくなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050107,
					"content": "でもその影響で依頼を出す人が増えてきて、正直手が回らないというか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050108,
					"content": "宣伝してほしいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205050109,
					"content": "あっ、違うんです、気持ちはありがたいですし、確かにもっといろんな人に協会に入ってほしいとは思っていますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050110,
					"content": "今新人を入れても間に合わない気がするんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050111,
					"content": "だからちょっと聞きたくて、あなたのご友人に任務を手伝ってもらうことってできますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050112,
					"content": "話し合ってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "よかった、ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050117,
					"content": "とにかく説明しますね。今ある依頼で緊急なのは<color=#00E1FFFF>「探索派遣」</color>です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050118,
					"content": "「探索派遣」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "私たちは都市周辺や野外の状況を随時更新しています。たとえば潜在的な危険とか、地下遺跡の異常状況とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050120,
					"content": "他人からの依頼じゃないので、時間の制限はないんですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050121,
					"content": "長時間放置すれば、それが大きな災いになる可能性もあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050122,
					"content": "確かに重要だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205050123,
					"content": "友人たちは理解できるはずだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "彼らが協力してくださるなら、後の手続きは私がしておきますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050127,
					"content": "では早速、「探索派遣」について説明しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050128,
					"content": "「探索派遣」確認",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "報酬は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "安心してください、探索中に入手したものは全部あなたたちのものですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050114,
					"content": "友達を勧誘したいの！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "いえ、誤解しないでください。あなたのご友人にはそれぞれ肩書きがあって、入会してもらう事が難しいのは分かっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050116,
					"content": "だからこれは協会の無理な頼みというか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050104,
					"content": "また報酬がもらえるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "ふふ、確かにそうなります。興味ありそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "キャサリン"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "「探索派遣」はいつでもできます。仲間は派遣されても、一緒に冒険できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050202,
					"content": "探索に必要な時間は、それぞれ異なります。探索が完了した後は、こちらで成果を確認してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050203,
					"content": "「冒険ランク」が上がると、探索できる場所も増えますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050204,
					"content": "つまり能力が高いほど、背負う責任も大きいってことか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 205050205,
					"content": "もちろんこれも皆さんの安全のためです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 205050206,
					"content": "協力してくださってありがとうございます。これからもどんどん「探索派遣」してくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				}
			]
		}
	]
}