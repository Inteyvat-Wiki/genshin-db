			},
			"dialogs": [
				{
					"id": 220140401,
					"content": "これで準備完了だ。この食材をどう処理するか考えるから、少し待っててくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140402,
					"content": "できたぞ。うん…しかし、俺が普段作っている料理と大差はないみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140403,
					"content": "旭東に渡してくれ。この料理が彼の悩みを解決するといいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯師匠"
				}
			]
