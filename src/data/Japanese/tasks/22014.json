			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卯師匠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "おや、旅人か、どうしてここに？さてはうまい料理を食べに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140202,
					"content": "聞きたいことがある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "旭東のやつ、料理するために稲妻に行ったのか、彼も努力家だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140204,
					"content": "知り合いなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "まあな、昔料理対決をしたことがある。まあ…あれはいい勝負だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140206,
					"content": "彼はずっと言ってたんだ、上達するために、世界各地を旅するって…まさか実現してみせるとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140207,
					"content": "しかし、聞いた感じ、行き詰まっているようだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140208,
					"content": "彼の悩みを解決できる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "保証はできないが、試してみるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140214,
					"content": "海草…ウミレイシ…そして何だこれ…緋櫻毬？どんだけ変わった食材なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140215,
					"content": "まあ、俺でももう少し材料があれば、海草とウミレイシを使って料理を作ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140216,
					"content": "旅人、絶雲の唐辛子と鳥肉を持ってきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140217,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "じゃあ頼んだぞ。絶雲の唐辛子と鳥肉を見つけたら、持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140219,
					"content": "さすが定番の食材…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "ははは、もちろんだ。これらの食材は一番頼れる。見つけたら、持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140221,
					"content": "しかし、この緋櫻毬ってやつは、どんな風に料理に使えばいいのか本当にわからないんだ…稲妻の料理人はこれをどうやって調理しているのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140210,
					"content": "香菱なら解決策を見つけられるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "香菱か、うん…あの子の料理は突拍子もないものばかりだ、もしかしたら力になれるかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140212,
					"content": "でも今は、タケノコを採りに軽策荘に行ってるんだ。彼女を探したいのなら、少し時間がかかる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "卯師匠"
				},
				{
					"id": 220140213,
					"content": "旭東は急いでるからな、俺が彼の悩みを解決してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "卯師匠"
				}
			]
		},
		{
