			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "旅人、へへっ、また会ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140102,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "この前約束したご飯のことは覚えているか？その準備をしているところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140106,
					"content": "美味しい料理を作るために、新鮮な食材をあっちこっち探し回ったんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140107,
					"content": "今はちょうど食材を集め終えたところで、どんな料理にするかを考えていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140108,
					"content": "ジュリーとパルヴァネはどこ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "彼女たちのことか。パルヴァネはもっと他の食材を探したいってさ。彼女が言ってた「万能調味料」を作りたいらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140110,
					"content": "それでジュリーを連れて野外へ食材探しに出かけたってわけさ…そう遠くへは行かないから、安心しろって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140111,
					"content": "逆に、俺の方を手伝ってくれないか。稲妻の新鮮な食材をたくさん集めてみたんだが、まだ…奇想天外なアイデアが浮かばないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140112,
					"content": "ほら、海草に…ウミレイシ、そして、これだ…えっと、緋櫻毬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140113,
					"content": "どれも新鮮な食材だが、何を作ったらいいか全く思いつかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140114,
					"content": "本当は稲妻出身の料理人にアドバイスをもらおうと思っていたが、そうしたら全く斬新さのない、普通の「稲妻料理」が出来上がってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140115,
					"content": "だから、璃月の料理人の考え方で、稲妻の食材を調理したい。そうすれば、人をびっくりさせる料理を作れるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140116,
					"content": "旅人、璃月に戻って「万民堂」の卯師匠にコツを聞いてきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140117,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "助かる。俺はここで待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140124,
					"content": "卯師匠にいいアイデアがあるといいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140119,
					"content": "「ピキーン」って感じが欲しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "「ピキーン」って、どんな感じだ？もしかして…うまい料理が人をびっくりさせる感じか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140121,
					"content": "そんなレシピがあればありがたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140122,
					"content": "しかし、そんなレシピを思いつくような人なんて、俺の知り合いにはいないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140123,
					"content": "とにかく、卯師匠に聞いてみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140104,
					"content": "ご飯を奢ってくれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "はははっ、その準備をしてるって言っただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201402",
							"2"
						],
						"stepId": 2201402,
						"stateName": "QUEST_STATE_UNFINISHED"
