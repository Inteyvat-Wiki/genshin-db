					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140601,
					"content": "ここのタケノコはよさそうだね、持って帰ろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140602,
					"content": "あれ？あなた、どうしてここに？またおいしい料理が食べたくなったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140603,
					"content": "教えてほしいことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "璃月の方法で、稲妻の食材を調理する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140608,
					"content": "へへっ、アタシに聞きに来るなんて、あなた本当に見る目あるね。聞いた話だと、稲妻では食材を小麦粉で包んで、油で揚げる調理方法があるらしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140609,
					"content": "そうやって出来上がった料理は、「天ぷら」って呼ぶらしいんだ！それを特製のつゆにつけて食べるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140610,
					"content": "この前「天ぷら」を試しに作ってみた時、その特製のつゆに興味が湧いてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140615,
					"content": "トリックフラワーの蜜や烈焔花とかはもう試したけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140611,
					"content": "スライムの液体にも興味があるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "まさか、スライムの液体はこの料理に合わないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140616,
					"content": "やっぱり雷蛍の羽の粉を入れた方が、味が引き立つと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140613,
					"content": "こうやって口で説明するだけじゃ覚えられないと思うから、紙に書いておくね。後で旭東に渡しといて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140614,
					"content": "はぁ、アタシも稲妻に行きたいなぁ。あそこには試したことのない食材がたくさんあるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140604,
					"content": "卯師匠と全く同じ反応だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "お店にも行ったの？でも、わざわざ食事のために行ったようには見えないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140606,
					"content": "もしかして、料理について悩み事でもあるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "香菱"
				}
			]
