			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バオフェイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716720101,
					"content": "へへっ、昨日の「白馬の仙人」の講談のおかげで、新しい着想が湧いてきちゃったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720102,
						716720103
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720102,
					"content": "どんな着想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716720104
					]
				},
				{
					"id": 716720104,
					"content": "え…？わわっ！こんにちは！よよよ、ようこそ璃月港！じゃなくてようこそ海灯祭…でもなくて、璃月港へようこそ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720105
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720105,
					"content": "萍{RUBY#[D]ひょうけい}渓姉さんには見られてないよね！？うん、多分大丈夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720106
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720106,
					"content": "璃月港へようこそ！海灯祭を見に来られたのですね？では、私の作った「月影の仙跡」もぜひお見逃しなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720107
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720107,
					"content": "仕事モードに入ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716720108
					]
				},
				{
					"id": 716720108,
					"content": "あ、あの、秘密にしておいてください！他の事を考えてたのが姉さんにバレたら、また怒られてしまいます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720109
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720109,
					"content": "頼み込んでようやく屋台を出させてもらえたんです。ってことで、ついでに最後まで話を聞いてもらえると嬉しいです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720110
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720110,
					"content": "えー、こほん、「月影の仙跡」はここ、璃月港に伝わる「白馬の仙人」伝説を題材にしているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720111
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720111,
					"content": "伝説によると、この仙人は月の光に導かれて空を巡り、璃月港から邪悪な魔物を追い払っていたといいます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720112
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720112,
					"content": "…でも、そんな伝説って退屈だと思いません？なので…えへへ、私が聞いた別の話をちょっと盛り込んでみました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720113
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720113,
					"content": "例えば…実は空には怪物がいて、月を食い尽くそうとしていたんですよ！そこを白馬の仙人が防いだってわけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720114
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720114,
					"content": "月が食べられるっていうのがどんな感じかは分からないですけど…劉蘇さんの話では、私たちが焼き餅を食べるみたいに、怪物はもぐもぐと月を食べていったんですって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720115
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720115,
					"content": "数日後に聞きに行った時は、また違う説明を聞かされましたけどね。お団子を食べるみたいに、がぶっと一口で月を飲み込んだって言ってました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720116
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720116,
					"content": "そして物語の最後はいつも、白馬の仙人が霄灯の光で、すべての魔物を一気に追い払ってしまうんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720117
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720117,
					"content": "それも伝説なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720118
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720118,
					"content": "劉蘇さんが講談でそう語ってたんですよ。かっこいいなって思ったんで、「月影の仙跡」に取り入れちゃいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720119
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720119,
					"content": "あっ、いけない、いけない。おしゃべりしてる場合じゃなかったんだ…仕事に戻らないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716720120
					],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720120,
					"content": "「月影の仙跡」を試してみたくなったら、声をかけてくださいね。準備はバッチリですから、いつでも始められますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バオフェイ"
				},
				{
					"id": 716720103,
					"content": "何か物語でも思いついた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716720104
					]
				}
			]
		}
	]
}