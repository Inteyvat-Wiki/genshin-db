			"dialogs": [
				{
					"id": 737130101,
					"content": "ジャジャーン！ここだ！浅瀬から水中に入れば、まるで綺麗な絵巻が広がっていくみたいな景色が楽しめるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737130102,
					"content": "あれ、あなたたち…新しいお友達？その子たちって…キノコン？本でしか見たことないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 737130103,
					"content": "おお、こんなところにメリュジーヌがいるとは思わなかったぜ！ここで遊んでるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737130104,
					"content": "また会ったね、マイン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "遊んでるわけじゃないよ、タイダルガを採ってるの。今年分をそろそろ漬けときたくて。お手伝いのために、みんなも村に帰ってきてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 737130107,
					"content": "アンジェニーナ姉さんもロクサネも休暇を取って戻ってきてる。みんな頑張って採ってるから、あたしもあとで潜るつもり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 737130108,
					"content": "アンジェニーナ姉さんの言った通りだね。青いキノコンって本当にタイダルガにちょっと似てる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 737130109,
					"content": "あ…その、可愛いって意味で、美味しそうってわけじゃないから…うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 737130111,
					"content": "へへっ、見る目あるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737130112,
					"content": "可愛いよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "とにかく、会えてよかった。あたしは労働にいくけど、楽しんでいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "マイン"
				},
				{
					"id": 737130115,
					"content": "オイラたちもそろそろ行こう！キノコンの仲間たちと、フォンテーヌのきれいな水中の景色をたくさん撮ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 737130113,
					"content": "メリュジーヌも負けてないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "はじめまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
