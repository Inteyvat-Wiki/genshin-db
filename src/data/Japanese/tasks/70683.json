			"dialogs": [
				{
					"id": 706830701,
					"content": "栄誉騎士と白い助手さん、協力してくれてありがと。さすがモンドに知れ渡る勇者ね。とても印象に残る指揮だった。何度も分析する価値がありそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830702,
						706830704
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830702,
					"content": "#さすが{M#俺}{F#私}たち！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830703
					]
				},
				{
					"id": 706830703,
					"content": "#へへっ、{NICKNAME}は現実でも数え切れないほどの魔物と戦ってきてるからな！これで騎士団の手伝いができたってことになるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706830705,
					"content": "うん、今回の兵棋演習はとても順調よ。第7小隊、ひいては西風騎士団も、演習結果の分析から有益な情報を得られた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830706
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830706,
					"content": "これを活用すれば、モンド周辺の治安改善のためにもっといい対策が立てられるはず。たとえば、突然現れたスライムがご老人を襲ったり、ヒルチャールがキャラバンを襲ったりとかね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830707
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830707,
					"content": "うわぁ、そういう場面ってもう何回も見た気がするぞ…えっと、つまり、これからはもうそういうことが起きないってことだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706830708,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830709
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830709,
					"content": "そう…なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706830710,
					"content": "それは時間がかかりそう。でもあたしたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830711
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830711,
					"content": "ファニーヤ！ファニーヤ！聞いてください…あっ、栄誉騎士様と白い助手さん、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830712
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830712,
					"content": "…今度は何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830713
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830713,
					"content": "もう、そんな顔しないでくださいよ！まったく、演習に関することを報告しに来たっていうのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830714
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830714,
					"content": "もうっ！とにかく、さっきあなたに言われた通り「静かに演習」していたら、すごいことに気づいたんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830715
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830715,
					"content": "すごいこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830716
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706830716,
					"content": "はい！ただのシミュレーションですが、爆発威力の数値を十倍にして計算すると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830717
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830717,
					"content": "以前開発した小型の爆破ボルトで、遺跡守衛も一気に倒せちゃうんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830718
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830718,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706830719,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830720
					]
				},
				{
					"id": 706830720,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830721
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830721,
					"content": "とりあえず質問させてもらうけど…なんで十倍なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830722
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830722,
					"content": "そうすると、シミュレーション結果がすごくきれいなんですよ！まだ、実現はしていませんが、そういう数値って見てるだけでもワクワクしてきませんか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830723
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830723,
					"content": "ここを目標にして今までの倍の努力をすれば、本当に実現するかもしれませんよ！ボンボン爆弾のおよそ十分の一に値する威力！美しき爆発…！ああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830724
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830724,
					"content": "じゃあ、爆発の威力を百倍にしたら、いいんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830725
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830725,
					"content": "え？確かに！さすがファニーヤです！百倍にしたら、きっと倒せる…いや、きっとどんな魔物でも楽勝ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830726
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830726,
					"content": "特に「ツノツノ魚の大王の戦術コア」を搭載した改良版なら、一発で遺跡重機の群れでさえも一掃できるでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830727
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830727,
					"content": "どうしてそこで止めるの。一千万倍にしてみたら、きっと西風大聖堂だって吹き飛ばせる。海の向こうにフォンテーヌ科学院が見えるようになるかもしれないじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830728
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830728,
					"content": "そして私は教会で見せしめとして罰されてるあなたと縁を切って、普通の人に部屋を貸し出すの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830729
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830729,
					"content": "ううっ、ただの冗談です、冗談ですってば！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830730
					],
					"speakerTitle": "エマート"
				},
				{
					"id": 706830730,
					"content": "大丈夫、こっちも冗談で言ってるんだから。今はあなたの直属の上司だから、そんなことになったら監督不行き届きであたしも責任を負うことになるの。そうなったら、部屋も貸し出せないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830731
					],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830731,
					"content": "なるほど、部屋を貸し出すってことが冗談だったんだな…って、なんだよこの冗談！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706830732,
					"content": "とにかく、栄誉騎士と白い助手さん。改めて、協力してくれてありがと。それとエマート、あなたはパラメータを勝手に変えたことについてしっかり反省して。反論は無しだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファニーヤ"
				},
				{
					"id": 706830704,
					"content": "役に立ててよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830705
					]
				}
			]
		}
	]
}