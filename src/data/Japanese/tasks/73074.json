				"points": []
			},
			"dialogs": [
				{
					"id": 730741701,
					"content": "これが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741702,
					"content": "うん、これがヴァソマの実だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741703
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741703,
					"content": "ヴァソマの実は、ヴァサラの樹の夢と記憶を集めて結ばれたもの。ボクたちにとっては、力を回復させてくれる貴重な果実。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741704
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741704,
					"content": "「アシュヴァッタの樹」にビージャの実を実らせるには、たくさんの力を費やす必要がある。だからボクたちはヴァソマの実でカレを養う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741705
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741705,
					"content": "#ナラ{NICKNAME}、ヴァソマの実を大事に取っておいてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741706
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741706,
					"content": "ああ…それならアランマに「お宝」の意味を教えてやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741707,
					"content": "お宝ってのは、とても貴重なものって意味だ。ヴァソマの実にはたくさんの夢と記憶が詰まっていて、アランナラの力を回復してくれる。これってすごいし、貴重なものだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741708,
					"content": "ヴァソマの実みたいに貴重で大事なもののことをお宝って言うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741709,
					"content": "おーっ！お宝ってそういう意味だったんだ…分かったよ！ありがとうパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741710,
						730741712
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741710,
					"content": "次はどうすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741711
					]
				},
				{
					"id": 730741711,
					"content": "うーん…前にアランラジャが言ってたけど、ヴァソマの実は一個だけじゃないんだろ。つまり、別のアシュヴァッタ堂を探さないといけないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741714,
					"content": "#うん。がんばるよ！ナラ{NICKNAME}、パイモン、後でまた会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741715
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741715,
					"content": "うん！またな、アランマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741712,
					"content": "ありがとうパイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741713
					]
				},
				{
					"id": 730741713,
					"content": "おまえまでなに言ってんだよ…前にアランラジャが言ってたけど、ヴァソマの実は一個だけじゃないんだよな。つまり、別のアシュヴァッタ堂も探さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741714
					],
					"speakerTitle": "パイモン"
				}
			]
		},
