			"dialogs": [
				{
					"id": 730740101,
					"content": "#やあ、ナラ{NICKNAME}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740102
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730740102,
					"content": "また会ったな、アランマ！そっちのアランナラは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730740103,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740104
					],
					"speakerTitle": "アランダサ"
				},
				{
					"id": 730740104,
					"content": "うん。アランダサは「歌摘み」さ。いつもいろんな歌を集めているんだ。カレはあまり話すのが好きじゃないんだ。歌うほうがいいからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740105
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730740105,
					"content": "うーん…まあ、理解できなくもないけど…それより、ここがアシュヴァッタ堂なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730740106,
					"content": "でも木はないし、バラがたくさん…宙に浮いてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730740107,
					"content": "ううん、違う。でも、これもすごい発見だ。ここには、アランナラが長いこと見つけられなかった歌が眠っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740108
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730740108,
					"content": "アランナラの歌摘みは、ずっと歌の美しさを求め続ける。そして終わりの時に、自分だけの歌を残す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740109,
						730740111
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730740109,
					"content": "それとアシュヴァッタ堂に何か関係が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740110
					]
				},
				{
					"id": 730740110,
					"content": "うん！ここには、アランヤマの残した歌があるみたいだ。だとしたら、この近くにヴァサラの樹があるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740113
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730740113,
					"content": "ヴァサラの樹…前にアランラジャが言ってたな。あの…なんだっけ、森林書に書いてあった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730740114,
					"content": "#ヴァサラの樹！ヴァソマの実がもらえるヴァサラの樹だ！オイラたちも手伝おうぜ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730740115,
					"content": "ありがとう！あのバラの中に歌が隠されているんだけど、うーん…ボクとアランヤサがずっと探しても見つからないんだ。あのバラたちは話をしてくれないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740116
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730740116,
					"content": "#なるほど…{NICKNAME}、オイラたちも探してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740117,
						730740118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730740117,
					"content": "ラナを助けるためなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740119
					]
				},
				{
					"id": 730740119,
					"content": "おう！オイラたち、物探しは得意だもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730740118,
					"content": "そうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740119
					]
				},
				{
					"id": 730740111,
					"content": "幸運を祈ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740112
					]
				},
				{
					"id": 730740112,
					"content": "#うん！ありがとうナラ{NICKNAME}。ここには、アランヤマの残した歌があるみたいだ。だとしたら、この近くにヴァサラの樹があるはずだ。運がいい！",
					"roleType": "TALK_ROLE_NPC",
