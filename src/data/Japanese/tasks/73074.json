			"dialogs": [
				{
					"id": 730741101,
					"content": "これが…ヴァサラの樹？見た感じ、思ってたより生気がないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741102,
					"content": "マラーナの侵蝕のせいだ…アランヤマ、ごめん。マラーナの侵蝕がここまで来ているなんて気づかなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741103
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741103,
					"content": "ボクがまだ小さな小さな種のころ、みんなでアランムフクンダとアランヤマ、そしてアランジたちの物語を聞いたことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741104
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741104,
					"content": "アランヤマは元々ナラを嫌ってたから、幻影で障害物を作った。カレはナラの邪魔をして楽しんでた。でもあるナラが、カレのアランラカラリを見破った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741105
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741105,
					"content": "そのナラはカレの障害物を突破した。それから二人は仲良しになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741106
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741106,
					"content": "確かにそういう友情もあるよな…それで、アランヤマはその後どうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741107,
					"content": "物語の最後、災難が起きた。その大きな災難の中で、カレは多くのアランナラとナラを守った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741108
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741108,
					"content": "ああ！だから、カレの残した歌は幻を消すことができるんだ。カレのゲームはもう終わったからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741109
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741109,
					"content": "どうやったらヴァソマの実が手に入るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741110
					]
				},
				{
					"id": 730741110,
					"content": "うん。まずはカレの夢の中に入って、マラーナの影響を取り除く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741111
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741111,
					"content": "「カレ」ってのは…ヴァサラの樹のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741112,
					"content": "そうだよ。準備ができたら、手を伸ばしてカレの夢に入ろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				}
			]
