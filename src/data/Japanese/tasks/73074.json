				"points": []
			},
			"dialogs": [
				{
					"id": 730741801,
					"content": "これで二個目のヴァソマの実を手に入れたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741802,
					"content": "#ナラ{NICKNAME}はすごいね！マラーナをやっつけただけじゃなく、怪物も恐れないなんて。さすがヴァナキを倒せるナラだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741803
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741803,
					"content": "ふふん、オイラたち冒険の中で色々なことを乗り越えてきたからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741804,
					"content": "#すごい！じゃあナラ{NICKNAME}とパイモンにもたくさんの記憶、たくさんの物語があるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741805,
						730741806
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741805,
					"content": "確かに色々あったよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741807
					]
				},
				{
					"id": 730741807,
					"content": "#へえ。じゃあ、ナラ{NICKNAME}とパイモンの物語をボクたちに聞かせてほしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741808
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741808,
					"content": "いいぜ！前にもオイラたちの物語を語ったことがあるけど、あれからずいぶん経った気がするよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741809,
					"content": "そう言えば、ヴァサラの樹の夢…夢の中で、遠くにとても大きな紫色の樹が見えたけど、あれってなんだろうな？ヴァナラーナでも見えるみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741810,
					"content": "あれはね、最初の「アシュヴァッタの夢の樹」さ。うーんと…なんて言えばいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741811
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741811,
					"content": "夢は川に浮かぶ葉っぱみたいなもので、すぐに水と一緒に逃げて行ってしまうんだ。だから、夢を留めておきたければ、夢を根付かせないといけない。そうすれば逃げて行かない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741812
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741812,
					"content": "うう…なんて言えばいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741813,
						730741814
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741813,
					"content": "「アシュヴァッタの夢の樹」は根みたいなもの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741815
					]
				},
				{
					"id": 730741815,
					"content": "#ナラ{NICKNAME}はかしこいね。この樹があれば、アランナラの夢はずっと残るし、たくさんのアランナラを中に入れたり、出したり、ヴァサラの樹と繋がったりもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741816
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741816,
					"content": "そうだったのか…つまり夢の中のヴァナラーナが、ずっと夢の中にあるのも、あの樹のおかげってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741817,
					"content": "うん。だから、マラーナのことが心配だ。後でみんなと一緒に何とかしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741818
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741818,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741819
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741819,
					"content": "#でも、まずはビージャの実を実らせてからだ！だって、ナラ{NICKNAME}とパイモン、そしてアランラナの友達を助けないといけないから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741820
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741820,
					"content": "そうだな！アランマは引き続きアシュヴァッタ堂を探しに行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741821,
					"content": "うん、そのつもり！また会おうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741822
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741822,
					"content": "気を付けろよ、アランマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741823
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730741823,
					"content": "#キミたちもね、ナラ{NICKNAME}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730741814,
					"content": "「アシュヴァッタの夢の樹」は夢を留めておける？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741815
					]
				},
				{
					"id": 730741806,
					"content": "大したことない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741807
					]
				}
			]
		},
