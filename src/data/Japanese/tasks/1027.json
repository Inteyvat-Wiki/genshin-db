				"objectNames": [
					"煙緋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "まさか、こんなところに閉じ込められるとは、参ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280602,
					"content": "たとえ私に知識があっても、その大半は法律に関するものばかり。「脱獄」のことなどさっぱりだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280603,
					"content": "まあ、お父様と「楽しく生きる」ことを契約している身だ…少なくとも、ここで落ち込んではいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280604,
					"content": "いい方向に考えるんだ。そう、ここで見聞を広めたり、旧友と親睦を深めたりするのは良いことだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 10280605,
					"content": "うん…そうだ、これはいいこと。よし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "煙緋"
				}
			]
		},
