			"dialogs": [
				{
					"id": 750701401,
					"content": "クソっ、もう一度初めからだ！ええと…その、もし君たちさえ良ければの話だが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750701402,
					"content": "ふぅ…もうここまで来たんだし、そんなに気にすることないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750701403,
					"content": "このまま続けよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "ああ、すまんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750701405,
					"content": "ちょっと休ませて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "崖から飛ぶのも体力がいるんだ。アイツらにも少し休ませた方がいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750701407,
					"content": "おお…すまない、ワシの考えが足りてなかったな。君らの準備ができたら、そのまま始めてくれ、ワシはここで待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				}
			]
		},
