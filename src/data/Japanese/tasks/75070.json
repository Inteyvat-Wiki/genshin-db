					}
				]
			},
			"dialogs": [
				{
					"id": 750700701,
					"content": "ハハッ！君らとはまた会えると分かっていたぞ！実にいいタイミングだ！君らはワシが第二の傑作を撮影するところに立ち会えるんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700702
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700702,
					"content": "まあ…二つ目ってわけでもないか。他にもいい作品はあるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700703
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700703,
					"content": "とにかく、君らはとてつもなく幸運だぞ。ワシはここで次のアクション写真を撮るつもりだ。ハハッ、アクション写真を撮るのは今回が初めてなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700704
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700704,
					"content": "なにせ写真と言えば、昔、事件現場で被害者を記録するために写真を撮ってたからな…おっと、この話をこれ以上詳しく話す必要はなかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700705
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700705,
					"content": "マニフェコ、つまり今回もオイラたちに手伝ってほしいってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750700706,
					"content": "キュ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750700707,
					"content": "いや…あー、うーん、君たちが手伝ってくれるというのも、悪くないかもな！よし、状況を説明しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700708
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700708,
					"content": "今回はな、この滝でクク竜が水面に向かって急降下するところを写真に撮りたい。そう、クク竜が谷底の水面に最も迫る、あの一番迫力ある瞬間を撮りたいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700709
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700709,
					"content": "実は下準備で、滝の下の池にクク竜を誘う餌を仕込んだんだが…いまだにクク竜たちがいい感じの角度で飛んでいってくれなくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700710
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700710,
					"content": "あれ？あそこの水面にある、あの大きな丸…あれなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750700711,
					"content": "それは気にするな、ワシもよく分からん…的にするために近くの部族から拾ってきた、ただのゴミだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700712
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700712,
					"content": "はぁ、これまで撮ったゴミ写真は、どれも平凡すぎて、本当に頭にくる。ワシはまだ待てるぞ。だが、せっかく君らが来てくれたからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700713
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700713,
					"content": "君たちなら…その、クク竜たちを躾けることができるんじゃねえか？あの生意気なちびっ子どもにちゃんと急降下するように教えるんだ！君らはナタに名をはせるマスターテイマーなんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700714
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700714,
					"content": "よし、ワシはここから合図を出す。「一」までカウントダウンしたら、君たちは正確に的めがけて水面に急降下するんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700715,
						750700717
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700715,
					"content": "頑張ってみるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700716
					]
				},
				{
					"id": 750700716,
					"content": "ハハッ、よかった、なら早速試してみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700717,
					"content": "成功する保証はないけどね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700718
					]
				},
				{
					"id": 750700718,
					"content": "大丈夫だ、失敗したってワシらの時間が少し無駄になっただけだ。ワシらは旅の者。一番持て余しているものこそが時間だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750700719,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
