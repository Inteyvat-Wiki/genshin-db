			"dialogs": [
				{
					"id": 750700901,
					"content": "ハハッ、完璧だ！コピーをやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700902,
					"content": "わあ！やっぱりすごいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750700903,
					"content": "ほら、報酬だ。手伝ってもらったのはこれで二度目…いや、三度目だったな。ワシの撮影の旅が君らなしで続けられるか怪しくなってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700904,
					"content": "ワシの次の目的地はここだ…地図にマークしておいた。もし興味があれば、来てみてくれ。ワシはいつでも君らと仕事をしたいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700905,
					"content": "おっと…そろそろ時間だ、ワシは先に行く。君らの幸運も祈ってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "マニフェコ"
				},
				{
					"id": 750700906,
					"content": "マニフェコは荷物をまとめ、楽しそうに熱気球に飛び乗った。\\n熱気球がゆっくり遠くへ飛んでいく。小さなマニフェコがあげた大きな笑い声が、こだまして長く響いた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
