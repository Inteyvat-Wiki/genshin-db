			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴィクトル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "ふぁでゅいのおじさんたち、うぃんどぶるーむ祭にいくの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090102,
					"content": "お、俺はたぶん参加できない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090103,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "おや？なんだ、またお前か。どうしていつも疑うようなツラしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090105,
					"content": "俺はただこの子と話してるだけだ、何も悪いことをしてない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090106,
					"content": "ファデュイは祭りに参加しないんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}も、うぃんど…ぶるーむ祭…過ごすの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090108,
					"content": "あ、当たり前だろ。俺は勤務が優先だからな。風花祭なんかに参加できるわけないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090109,
					"content": "ドヤ顔されても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "ゴッホン、その話はもういい。お前暇そうだし、少し手伝ってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090111,
					"content": "騒がしい祭りのせいで、この子の両親は仕入れで外に出かけたんだ。だからこの子をここに預けて、シスターに面倒を見てもらってるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090112,
					"content": "しかしお前も知ってると思うが、風花祭のせいで皆忙しいんだ。シスターもこの子の面倒を見る時間なんてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090113,
					"content": "それでこの子はいま俺にくっ付いてるんだ。でも俺は大聖堂を出るわけにはいかないから、せいぜい話をしてあげることしかできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090114,
					"content": "残念だが、俺は「ファデュイ」だ。この子と喋り始めると、隣のシスターが俺を睨んでくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090115,
					"content": "「ファデュイ」である俺が、何か悪だくみをしているとか思ってるんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090116,
					"content": "ふん、あのシスターに文句を言われたくないし、この子にも楽しくいてもらいたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090117,
					"content": "だから「栄誉騎士」、お前みたいな栄光ある正義の味方にお願いしたい。この子を遊びにつれて行ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090118,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "おお、さすが「栄誉騎士」、快諾してくれるとは。てっきり報酬とか要求してくるかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090120,
					"content": "さっそくこの子と遊んであげてくれないか。俺は引き続きここで勤務する、シスターたちに冷たい目で見られながらな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090121,
					"content": "はぁ、こんな生活いつまで続くのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090122,
					"content": "ただリリーに遊んでもらいたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "ま…まさか、俺は「ファデュイ」だぞ、悪者だ、分かってるのか？そんなお人好しな訳がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090124,
					"content": "さあ、はやくこの子を連れて遊びに行ってくれ。ずっと大聖堂の中にいたから、退屈にしているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090125,
					"content": "俺か…俺は引き続きここにいる、シスターたちに冷たい目で見られながらな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 700090126,
					"content": "はぁ、こんな生活いつまで続くのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				}
			]
		},
		{
			"id": 7000902,
			"completionStepIds": [
				7000904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000904",
							"2"
						],
						"stepId": 7000904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}、なんであのふぁでゅいのおじさん、うぃんどぶるーむ祭を過ごさないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090202,
					"content": "彼には重要な仕事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "じゅうようなしごと？ん…うぃんどぶるーむ祭よりもじゅうようなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090207,
					"content": "でも、わるいことたくさんしても、なおしちゃえば、いい人になれるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090208,
					"content": "そうだ！おじさんにおしえる。いい人になったら、うぃんどぶるーむ祭にもいける！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090209,
					"content": "おじさんは今忙しいから、先に外で遊ぼうよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "#そっか…じゃあ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}、リリーをあそびにつれてって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090211,
					"content": "いいよ、あまり遠くに行かないでね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "やったー！はやくあそびにいこう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090204,
					"content": "「ファデュイ」は参加できないんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "どうして？ふぁでゅいは…わるい人たちだからなの？パパ言ってた、おねんね、はみがきしない、ごはん、おててで食べる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090206,
					"content": "やっぱり、わるい人たちなんだ。おじさんのパパも、きっとおこる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "リリー"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000906",
							"2"
						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ブランシュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "旅人さん？どうなさいました～？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "ブランシュ"
				},
				{
					"id": 700090303,
					"content": "それと…リリー？どうして来たのですか、お父さんとお母さんは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "ブランシュ"
				},
				{
					"id": 700090304,
					"content": "#パパとママはだいじなようじがあるの！だから{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_CUTEBIGBROTHER|INFO_FEMALE_PRONOUN_CUTEBIGSISTER]}にあそんでもらってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090305,
					"content": "重要なこと？まったく、ルドルフさんとジリアンナさんは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090306
					],
					"speakerTitle": "ブランシュ"
				},
				{
					"id": 700090306,
					"content": "ねーねー、さっきのワンちゃんどこにいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090307
					],
					"speakerTitle": "リリー"
				},
				{
					"id": 700090307,
					"content": "さっきのワンちゃん？えっと…私にも分かりません。普段は自分の小屋にこもっているのですが、餌ボウルに餌を置いた時にしか来ませんね～。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090308
					],
					"speakerTitle": "ブランシュ"
				},
				{
					"id": 700090308,
					"content": "たぶん街中が賑やかすぎて、逃げ出してしまったんじゃないですかね～？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090309
					],
					"speakerTitle": "ブランシュ"
				},
				{
					"id": 700090309,
