				]
			},
			"dialogs": [
				{
					"id": 746900101,
					"content": "来ましたよ！主役の登場です、クランクインの準備を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900102
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900102,
					"content": "——ふっ！それは違います！商業提携のあり方は映影の脚本のように、起承転結があってこそですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900103
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900103,
					"content": "常識的に言えば、大スターを仲間に誘う第一歩はまず名刺を渡すこと。そして華やかな自己紹介で自分を大きく見せてから、素晴らしい協力のビジョンを提案するものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900104
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900104,
					"content": "相手がある程度の興味を示してから、ようやく協力の形について深く話し合うことができるのです。あなたが提案したフラッシュ映影のアイデアと同じで、本当に急進的すぎます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900105
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900105,
					"content": "メリエスさん、率直に言わせていただきます。もし第一作目の「実験映影」があれほど深刻な損失を出していなければ、あなたの理論にももう少し説得力があったかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900106
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900106,
					"content": "#それに、映影ランドにいた時、{NICKNAME}さんに話しかけようとしたのでしょう？でも、大した印象を残せなかったんじゃないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900107
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900107,
					"content": "…あなたの考えは子供の一方的な思い込みに過ぎません！大人の世界はもっと複雑なんです！そんなに簡単なことじゃないんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900108
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900108,
					"content": "はぁ…年齢で正しさを測ろうとするなど、実に浅はかな行為ですよ、メリエスさん。あなたの今の言動は、まさに僕の正当性を裏付ける、さらなる証左となっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900109
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900109,
					"content": "何ですって？ふんっ——この大人ぶりたがるクソガキめ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900110
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900110,
					"content": "うわぁっ！待て待て、ケンカするなよ！冷静に、座って話し合おうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900111,
						746900112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746900111,
					"content": "落ち着いて、落ち着いて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900113
					]
				},
				{
					"id": 746900113,
					"content": "#えっ…本当に{NICKNAME}さんとパイモンさんに話しかけられましたよ？こんな単純な手口が通用するんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900114
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900114,
					"content": "メリエスさん、だから言ったでしょう。人々は長々とした前置きよりも、目を引く部分の方が気になるものなのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900115
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900115,
					"content": "#{M#彼ら}{F#彼女たち}は、三日三晩行列に並んでも近寄れないほどの有名人ですよ。それが今、僕たちの口論を見て自分から話しかけてくださったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900116
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900116,
					"content": "さて、ここからは僕たちが協力をお願いしたいという意思を直接説明するパートです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900117
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900117,
					"content": "コホン、お二人とも、ちょうどいいところにいらっしゃいました。僕たちの「実験フラッシュ映影」の出来はどうでしたか？目を引く魅力はあったでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900118
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900118,
					"content": "えっ？「映影」？おまえら、さっきまで…ええ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746900119,
					"content": "喧嘩？ふふ、まさか。気品のある大人が、子供の言葉程度で激怒するわけないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900120
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900120,
					"content": "ふふん、その通りです。ませたクソガキが相手の時なんて、特にそうですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900121
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900121,
					"content": "本気の喧嘩にしか聞こえないんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900122
					]
				},
				{
					"id": 746900122,
					"content": "本題に戻りますが、突然感情的で迫力のある場面に遭遇すると、見る人に強い鑑賞意欲が湧くと思いませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900123
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900123,
					"content": "普通の人なら止めに入るだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746900124,
					"content": "しかしもし、それが「映影」だと知っていたらどうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900125
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900125,
					"content": "言われてみれば確かにそうだな…いきなりオイラの興味を引くような場面が出てきたら、たぶん続きを見たくなるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746900126,
					"content": "これこそが「フラッシュ映影」の長所——視聴者は最短時間で最も迫力のあるシーンを見ることができるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900127
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900127,
					"content": "それだけではありません。通常の「映影」は観るのに長い時間を要しますが、この「フラッシュ映影」なら隙間時間で楽しめます。冒険の途中の休憩時間に観ることだってできるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900128
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900128,
					"content": "制作者も、必ずしもプロの監督やカメラマンである必要はありません。誰でも、いつでも、どこでも、創ったり楽しんだりすることができるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900129
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900129,
					"content": "それに、内容は必ずしも物語に限ったものでなくてもいいんです。素敵なダンスや、見ていて心地よい風景だけでも構いません。魅力的な形式だと思いませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900130
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900130,
					"content": "うーん、そうだな。そう言われると、オイラも撮影してみたくなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746900131,
					"content": "もちろん、多くの注目を得るには強力な「スター効果」が必要になってきます。テイワット中に名の知れた有名人こそ、人々の「フラッシュ映影」への関心を引くことができるのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900132
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900132,
					"content": "そう、まさしくあなたたち二人のことですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900133,
						746900134
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900133,
					"content": "スターの出演料は高いよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900135
					]
				},
				{
					"id": 746900135,
					"content": "ご安心ください。私とプチ・ルミエール先生は映影ランドでの修練を経て十分な資金を集めましたので、皆さんへの出演料に関しては絶対に問題ありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900136
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900136,
					"content": "#それに、「フラッシュ映影」がテイワットを席巻するようになれば、あなたたちはフラッシュ映影の{M#父}{F#母}という栄誉を手にする可能性すらあります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900137
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900137,
					"content": "それだけではありませんよ。「フラッシュ映影」という形式は、映像言語の役割をさらに際立たせます。あなたたちのような熟練の撮影者なら、台詞を用いずとも物語を語ることさえ可能でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900138
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900138,
					"content": "#面白そうだぞ！なあ、{NICKNAME}、オイラたちも参加してみようぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900139,
						746900140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746900139,
					"content": "#面白そう！{M#俺}{F#私}たちに任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900141
					]
				},
				{
					"id": 746900141,
					"content": "よかったです！それでは、お二人の準備ができ次第、撮影を開始しましょう。カメラの位置も、もう決めてありますからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900142
					],
					"speakerTitle": "プチ・ルミエール"
				},
				{
					"id": 746900142,
					"content": "映影機、道具、それに撮影後の作業の準備も整えておきました！お二人はただ、思うがままに動いてくだされば大丈夫です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746900143
					],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900143,
					"content": "善は急げです、さっそく始めましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "メリエス"
				},
				{
					"id": 746900140,
					"content": "モラも手に入る？なら、やってみよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900141
					]
				},
				{
					"id": 746900134,
					"content": "もし、これが依頼ならね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900135
					]
				},
				{
					"id": 746900112,
					"content": "話せば解決できるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746900113
					]
				}
			]
		}
	]
}