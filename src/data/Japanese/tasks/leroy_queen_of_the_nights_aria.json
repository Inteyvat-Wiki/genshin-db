						],
						"pointId": 7536
					}
				]
			},
			"dialogs": [
				{
					"id": 741560801,
					"content": "やあ、お義父さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560802
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560802,
					"content": "…ダメだったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560803
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741560803,
					"content": "オータムからあなたが逃亡を図っていると聞いたときは驚きましたよ。こんなに長いこと閉じ込めていたのに、まだ心が折れていなかったとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560804
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560804,
					"content": "しかも二人の「正義の使者」をそそのかして、逃亡を助けてもらうチャンスを得ていたんですね。あなたの生きようとする意志に、僕は感動しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560805
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560805,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741560806,
					"content": "あなたにはいくらでも逃げられる場所があったのに、なぜ最後はよりによってオータムとよくピクニックに来た場所を選んだんですか？悪手にもほどがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560807
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560807,
					"content": "わしは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560808
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741560808,
					"content": "ああ、説明は不要ですよ。ピンチのときに慌てて選択を間違えるのは理解できます。習慣的に自分が最も見知った道を選んでしまった、そうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560809
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560809,
					"content": "オータムがあなたたちの後に出発して幸いでした。彼女の前でこんな話をしたくありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560810
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560810,
					"content": "それで、あなたは一体どうお考えなんです？僕にはまったく分かりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560811
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560811,
					"content": "婚姻を結ぶという名目で、あなたは彼女を商品として他人に売った。それも二度。一度目は彼女を使って、フォンテーヌ廷の大屋敷を手に入れましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560812
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560812,
					"content": "二度目は彼女を追いやるためだけに適当な人を選び、あなたは家やその他の財産をすべて手に入れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560813
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560813,
					"content": "そしてあなたは、彼女が侮辱されたときも見て見ぬふりをしました。結果、彼女は二度目の結婚で産んだ子供をあなたに託すことになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560814
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560814,
					"content": "その子はよそに追いやられました。おそらく、多額の扶養費か何かと引き換えにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560815
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560815,
					"content": "あなたは一体今日、どういうつもりでノンキに子供たちにお菓子をあげ、家に招待したのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560816
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560816,
					"content": "これまでに一瞬でも、良心の呵責を感じたことはないのでしょうか？いくら考えても僕には理解できません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560817
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560817,
					"content": "実を言うと、オータムと初めて出会ったのは、彼女が放浪しているときでした。彼女はとても優しい母親でしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560818
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560818,
					"content": "彼女は、僕の友人の娘であるペニーにとても優しくしてくれました。一日会わないだけで、あの子は「オータムお姉ちゃんに会いたい」と駄々をこねるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560819
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560819,
					"content": "ああ…あなたがまだ逆転の可能性を考えているなら言っておきますが、オータムには今、僕以外にもたくさんの友達がいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560820
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560820,
					"content": "どこへ逃げようと無駄ですよ。地の果てまで追いかけますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560821
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560821,
					"content": "どうして彼女のような人が何一つ持たずに苦しんで、あなたのような男が多額の富を手にしているのでしょう？どうにも僕には納得ができません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560822
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560822,
					"content": "余計な好奇心なんて必要ない。彼にはそんな価値なんてないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560823
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741560823,
					"content": "おっと、聞かれてしまっていたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560824
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741560824,
					"content": "おまえがオータムだったのか！？やっと事情が飲み込めてきたぞ。ルロワの家族ってホント複雑だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741560825,
					"content": "#{NICKNAME}、オイラたちブノワじいちゃんと一緒にここまで来たけど、オイラたちがこれまで考えてたこととは違うとこだらけだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560826
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741560826,
					"content": "こんな状況でも、この件に首を突っ込んでいいのかな？おまえの考えを聞かせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
