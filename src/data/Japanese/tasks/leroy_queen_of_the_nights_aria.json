					"モルティシア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "自分たちで解決すべき。もう口を挟まない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "オータム、本気でわしにこんなことをするのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561103,
					"content": "お前ほど幸せな日々を過ごした娘がサーンドル河に他にいるか？わしはお前にお菓子やシルクのスカート、本を与えて、たくさん金をかけてきたというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561104,
					"content": "他の人たちが寒さや飢えに苦しんでいるとき、お前はペットの犬にネックレスをあげ、スカートを履かせていたのだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561105,
					"content": "そういう暮らしはすべてわしが与えたものだ。何か見返りを考えたことはないのか？何も代償を払わずに見返りを手にするなどあり得ないことだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561106,
					"content": "それでもわしを残酷だと責めるのか？わしは惜しみなくすべてを与えてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561107,
					"content": "オータムよ、よく考えてみてくれ。わしはお前の人生のすべてに手を尽くしてきた。お前が間違った道を歩んだのは、すべてお前自身が選んだものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561108,
					"content": "「ブノワさん」はどうも屁理屈をこねたがるようですね。「すべてを与えてきた」などと言いつつ利己的な目的を果たしてきたのでしょうし、結局はすべて自分のためだったのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741561109,
					"content": "あなたが私に良くしてくれたのは、将来自分が利益を得るためでしょ？綺麗事を並べ立てるのはやめて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741561110,
					"content": "あなたへの最大の慈悲は、苦痛を与えることなく送ってあげること。でもその前に教えて。私の子はどこにいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741561111,
					"content": "以前住んでいた家にも今あなたが住んでいる家にも、あの子の行き先に関する痕跡は何一つ残されてなかった。娘をどこにやったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741561112,
					"content": "それを話せば、わしを解放してくれるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561113,
					"content": "いいえ。その代わり、苦しむことなく逝かせてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741561114,
					"content": "…言っても言わなくても待つのは死か…ふふっ、ならどうしてお前の要望を飲む必要がある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561115,
					"content": "はぁ…オータム、君は本当に嘘のつけないやつだな。それでは永遠に彼女の居場所はわからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741561116,
					"content": "わしは彼女の居場所を知っている…ふふ、だが絶対にお前らには教えんぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561117,
					"content": "二度と彼女を見つけられないだろう。絶対に見つからんさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741561118,
					"content": "この人を連れていくわ、彼の家にね。文句ないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "モルティシア"
				},
				{
					"id": 741561119,
					"content": "ご自由に。口は挟まないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "お、おまえたちであとはなんとかしてくれ！オイラたちはもう関わらないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741561121,
					"content": "ブノワは「絶対に見つからない」とつぶやきながら、何も言わないオータムに連れていかれた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "こんなことを他人に知られるつもりはなかったんだがね。彼女はまだ指名手配されているし、なんなら僕だってそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741561123,
					"content": "いま君たちが執律庭に僕たちのことを通報すれば、大金が手に入るかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741561124,
					"content": "だが、そうすることはお勧めしない。もしそうしてしまえば、僕の友人たちが君のことを絶対に忘れないからね。試してみるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741561125,
					"content": "通報はしないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "ハハッ、僕も君がそう言うと思っていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741561128,
					"content": "では、君にこのレインボーローズを贈ろう。僕たちはこの花が大好きでね。これには色々な意味がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741561129,
					"content": "今送ったこの花の意味は「警告」だ。君がその考えを変えないことを祈ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741561130,
					"content": "お別れだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "アトーズ"
				},
				{
					"id": 741561131,
					"content": "はぁ…まさか、こういう結末になるとはな。ホントに複雑な家族だったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741561132,
					"content": "なんていうかさ…オイラもどう言ったらいいのかわからないけど、とにかく執律庭に通報しなくてよかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741561133,
					"content": "でも、オータムがかわいそうだぞ。結局最後まで子供の居場所がわからなかったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741561134,
					"content": "最初はあいつのこと、いいやつだと思ってたのに…うぅ…なぁ、オイラって騙されやすいのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741561135,
					"content": "気づいちゃったか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "なっ！こんなときに冗談はやめろよ！ふんっ、ホテル·ドゥボールでごちそうをおごってくれなきゃ、オイラ絶対に許さないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741561136,
					"content": "パイモンはおバカさんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "お金には困ってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
