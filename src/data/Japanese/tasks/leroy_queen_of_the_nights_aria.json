			"dialogs": [
				{
					"id": 741560401,
					"content": "#オ、オイラ、だんだん緊張してきたぞ…{NICKNAME}、メモの内容によれば、オイラたちはここで待ってればいいんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741560402,
					"content": "じっと待とう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "ああ、そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741560405,
					"content": "静かにしばらく待っていると、「キイッ」という音とともに、あなたたちのよく知る人物が窓を開けた。ブノワは外を見回してあなたたちを見つけると、注意深く窓から外に出てきた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "ブノワじいちゃん、これっていったい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741560407,
					"content": "早く移動するぞ。彼らに見つかったらまずい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ブノワ·ルロワ"
				},
				{
					"id": 741560403,
					"content": "いくつか彼に聞きたいことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
