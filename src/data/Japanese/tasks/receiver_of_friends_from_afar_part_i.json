			"dialogs": [
				{
					"id": 401430501,
					"content": "お待たせ！さあ、召し上がれ——「金玉満堂」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430503
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430503,
					"content": "えっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430504
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430504,
					"content": "…あ、そういえば旅人とパイモンも今日はずっと忙しかったんでしょ？一緒に食べない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430505
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430505,
					"content": "そう言われるとちょっとお腹がすいてきたな…へへっ、じゃあお言葉に甘えて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430506,
					"content": "でも最初の一口はお客様がお先にどうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430507
					]
				},
				{
					"id": 401430507,
					"content": "そ、そうだな。なにしろ今回はおまえたちがお客さんなんだから…あれ？どうして食べないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430508,
					"content": "（見るからにタレがこってりしてて重そう…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430509
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430509,
					"content": "（璃月のテーブルマナーでは…弟のぼくが先を譲るべきだから…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430510
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430510,
					"content": "…コホン、それじゃ…まず僕が旅人のお手並みを拝見させていただくよ！うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430511
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430511,
					"content": "どう？水、飲む？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430512
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430512,
					"content": "いや…すごく美味しい、素材本来の味だ。タレがたっぷりかかってるのに、ちゃんと海のうま味を感じる…二人も食べてごらんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430513
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430513,
					"content": "う、うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430514
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430514,
					"content": "この味…もしかしてかにみそ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430515
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430515,
					"content": "大正解だ！さすがリネットだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430516,
					"content": "どうりでエビの味とうまくマッチしてるわけだ。こんな料理もあるんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430517
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430517,
					"content": "へへん！この料理のこだわりは「エビにカニを加え、新鮮さにうま味をプラス…柔らかくプリプリのエビにねっとりとしたかにみそが重なり、味も香りも良く、食感も抜群！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430518,
					"content": "「かにみそは金色に輝き、エビのむき身は透き通る玉のよう…」だからこそ「金玉満堂」って美名があるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430519,
					"content": "なるほど…この名前にはそんな由来が。確かにぴったりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430520
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430520,
					"content": "変だな…パイモン、いつからそんなに物知りになったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430521,
						401430522
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430521,
					"content": "レシピを丸暗記してるんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430523
					]
				},
				{
					"id": 401430523,
					"content": "この料理は口に合うと思うよ、リネット…って、あれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430524
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430524,
					"content": "あっ！「金玉満堂」が半分しか残ってない。いつの間に食べたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430525,
					"content": "さっきパイモンがペラペラ喋ってる間に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430526
					]
				},
				{
					"id": 401430526,
					"content": "璃月では、シェフに対する最高のお礼はたくさん食べることだと聞いたから。すごく美味しいわ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430527
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430527,
					"content": "あー！みんなで早いもの勝ちみたいに食べ始めんなよ！オイラの分も残してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430522,
					"content": "ただの受け売り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430523
					]
				}
			]
		},
