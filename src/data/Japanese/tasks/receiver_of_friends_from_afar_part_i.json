							907.387,
							214.468,
							326.214
						],
						"pointId": 310400531
					}
				]
			},
			"dialogs": [
				{
					"id": 401430101,
					"content": "求人広告——急募！望舒旅館での臨時料理人を一名募集。高給·厚待遇、報酬につきましては応相談…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430102,
					"content": "おい見ろよ、高給で急募だってさ！モラを稼ぐチャンスだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430103,
					"content": "望舒旅館がどうして急に料理人を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430104
					]
				},
				{
					"id": 401430104,
					"content": "えっ…たしかにそうだな…まさか言笑になにかあったのか？あいつは、人が勝手に厨房に入っただけで怒鳴り散らすしな…手伝いがいるとは思えないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430105,
					"content": "あれ、続きになにか書いてあるぞ…「興味のある方は上までお越しいただき、支配人の淮安とお話しください」…だってさ。なあ、オイラたちも上に行ってみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430106,
						401430108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430106,
					"content": "言笑に何があったのか聞きたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430107
					]
				},
				{
					"id": 401430107,
					"content": "うん——ついでに報酬がいくらかも聞いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430108,
					"content": "報酬がいくらか聞きに行きたいんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430109
					]
				},
				{
					"id": 401430109,
					"content": "…げ、言笑のことも気になるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4014302,
			"completionStepIds": [
				4014302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4014302",
							"2"
						],
						"stepId": 4014302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							896.893,
							265.09,
							332.755
						],
						"pointId": 310400532
					}
				]
			},
			"dialogs": [
				{
					"id": 401430201,
					"content": "…支配人、本当に必要ないんですって。ただ手を火傷しただけで…料理を作るのに差し支えはないでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430202
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430202,
					"content": "今は差し支えなくても、治りが遅くなってしまうよ。ひとまず数日は休みなさい。何か方法を考えるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430203
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430203,
					"content": "よう、支配人！それに言笑も！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430204,
					"content": "おや、旅人さんにパイモンさんではありませんか。どうしてこちらに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430205
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430205,
					"content": "下で求人広告を見て…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430206
					]
				},
				{
					"id": 401430206,
					"content": "それで上がって来たんだ…言笑になにかあったのか聞いてみようと思ってさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430207,
					"content": "やれやれ、だからあんな張り紙はやめろって言ったんだ。お前たちにまで心配をかけるとはな…大したことでもないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430208
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430208,
					"content": "はは、言笑に代わって、お二人のお心遣いに感謝申し上げます。ほら、あなたも恥ずかしがってないで、説明したらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430209
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430209,
					"content": "分かりましたよ…実は先日の海灯祭で、大勢のお客さんがやって来てな。料理を鍋から取り出す時にちょっと慌てて、うっかり手を火傷してしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430210
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430210,
					"content": "言笑でもそんなミスをするんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430211
					]
				},
				{
					"id": 401430211,
					"content": "そりゃあな、猿も木から落ちるっていうだろ。どんなに腕のいい料理人でも手元が狂うことはある！それにこれっぽっちの怪我なんて、全く問題ない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430212
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430212,
					"content": "強がりはやめるんだ。無理をして怪我がもっと酷くなったら、一日二日休むだけでは済まないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430213
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430213,
					"content": "だけど海灯祭が過ぎて間もないし、店に来てくれるお客さんは多いんです。休んでる場合じゃないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430214
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430214,
					"content": "それに、遠くからはるばるやって来た外国のお客さんもたくさんいるんですよ。…適当な間に合わせの料理人を入れて、万が一にも店の看板に泥を塗るようなことがあったら…真っ先に俺が承知しないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430215
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430215,
					"content": "そう言われると、どっちが支配人だか分からないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430216
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430216,
					"content": "でも、彼が言うことも一理あります。何といっても言笑は「料理王決定戦」の決勝選手ですから。そんじょそこらの料理人では、代わりが務まりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430217
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430217,
					"content": "自慢じゃないですけど…俺レベルの料理人となると、みんな自分の店を持ってますよ？旅館の手伝いに来るほど暇なやつなんて、なかなか見つからないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430218
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430218,
					"content": "まあ、もう少し報酬を上げないといけないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430219
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430219,
					"content": "うーん…料理が上手で、暇なやつ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430220,
						401430221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430220,
					"content": "もしかしたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430222
					]
				},
				{
					"id": 401430222,
					"content": "あっ——それっておまえじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430223,
					"content": "思い出しました。以前聞いたことがありましたね…あの時は、あなたが凄腕の強者だということばかりが印象に残っていて、料理の腕前のことを忘れていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430224
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430224,
					"content": "料理の腕前は覚えてないのに、凄腕なのは覚えてるのか…それでも旅館の支配人なのかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430225,
					"content": "はは、まあ細かいことはお気になさらず。とにかく、あなたが来てくださるのなら、言笑も安心して厨房を任せられるでしょう。ね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430226
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430226,
					"content": "まぁ…お前になら…はぁ、確かに、他のやつに任せるよりかはいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430227
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430227,
					"content": "じゃあ、この仕事を引き受けるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430228,
						401430230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430228,
					"content": "支配人が報酬を上げるって言うなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430229
					]
				},
				{
					"id": 401430229,
					"content": "ははは、言ったからには約束しましょう。決して少ない額ではありませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430231
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430231,
					"content": "けど一つ言わせてくれ。旅館で厨房を取り仕切るのは、自分のために料理を作るのとは訳が違うからな。何日かは俺も厨房に残って、お前が仕事に慣れるまで手伝ってやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430232
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430232,
					"content": "結局心配なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430233,
					"content": "支配人、店にまだ使ってない調理器具があったはず、あれは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430234
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430234,
					"content": "ああ、はいはい、今すぐ準備してこよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430235
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430235,
					"content": "",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401430236
					]
				},
				{
					"id": 401430236,
					"content": "ふぅ——完成です。見てください！あなたに合わせて作ってみました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430237
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430237,
					"content": "支配人って、大工さんなの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430238
					]
				},
				{
					"id": 401430238,
					"content": "いえいえ、ほんのたしなみ程度で、取るに足りません。では言笑、ここはあなた方に任せるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430239
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430239,
					"content": "ここまで大がかりなことをするなんて…今あるかまどをそのまま使えばいいじゃんか！どんだけ調理器具に触られたくないんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430240,
					"content": "いや、そんなことはない。オーナーは「人を使う以上は疑わない、疑わしければ使わない」と言っていた。俺はただ、今のかまどはお前にとって…その…少し高さがあると思ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430241,
						401430242
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430241,
					"content": "言笑からすると誰でもチビでしょ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430243
					]
				},
				{
					"id": 401430243,
					"content": "コホン——さっきも言っただろう、旅館で厨房を取り仕切るのは、自分のために料理を作るのとは訳が違うって。色、香り、味にこだわるだけではなく…「速さ」、「正確さ」、そして「安定感」が必要なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430244
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430244,
					"content": "たとえば、自分に合わないかまどで一日中料理を作っていると、疲れて腕や背中が痛くなるばかりか、料理を出すスピードが遅くなってしまう。すると、待っている客も苛つくだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430245
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430245,
					"content": "だからこそ、調理器具はキチンと準備しておかなければならない——それが「速さ」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430246
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430246,
					"content": "じゃあ「正確さ」と「安定感」ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430247
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430247,
					"content": "「正確さ」とは、正しく見極めることだ。肉塊のどこに包丁を入れるか、油をどのくらい使うか、そして鍋からいつ料理を取り出すか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430248
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430248,
					"content": "自分のために料理をするなら、様子を見つつ水が多ければ塩を足し、塩が多ければ水を足す…といった具合に味を調整できるが、旅館の厨房ではそんな試行錯誤をしてる猶予はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430249
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430249,
					"content": "それならまあ自信がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430250
					]
				},
				{
					"id": 401430250,
					"content": "もし本当に失敗したら、オイラが片付けてやるよ。へへっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430251
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430251,
					"content": "最後の「安定感」は、どんなに意地悪な注文でも、確実に応えなければならないということだ。特に各地からやってくる、味の好みが異なるお客さんをもてなすためには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430252
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430252,
					"content": "元々の食習慣に気を配るだけでなく、ご当地料理を味わいたいという気持ちも考慮しなければならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430253
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430253,
					"content": "うーん…最後のはかなり難しそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430254
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430254,
					"content": "大丈夫だ、旅人は色んな場所を渡り歩いてきたんだろう。実際にやってみたら俺より上手くできるかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430255
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430255,
					"content": "それに、数日は俺も厨房に残って助ける。きっとお客さんの一人一人が「我が家に帰ってきた」ように感じるおもてなしができるさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430242,
					"content": "#{M#俺}{F#私}は大丈夫だけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430243
					]
				},
				{
					"id": 401430230,
					"content": "言笑が厨房を任せるって言うなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430231
					]
				},
				{
					"id": 401430221,
					"content": "…ちょうどここにいるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430222
					]
				}
			]
		},
		{
			"id": 4014303,
			"completionStepIds": [
				4014303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
