					{
						"sceneId": 3,
						"position": [
							922.885,
							258.972,
							363.918
						],
						"pointId": 310400534
					},
					{
						"sceneId": 3,
						"position": [
							924.154,
							258.972,
							367.775
						],
						"pointId": 310400535
