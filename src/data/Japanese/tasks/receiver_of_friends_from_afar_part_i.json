					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401430301,
					"content": "ぐずぐずしてはいられない、さっそくやってみよう。基本的な調理は俺が口出ししなくてもできるはずだな。気をつけるべきことは、テーブル毎に注文の要望が違うことだ。ごっちゃにしないようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430302,
					"content": "へへっ、オイラも覚えるのを手伝うからな！安心していいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430303,
					"content": "一日が過ぎ…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401430304
					]
				},
				{
					"id": 401430304,
					"content": "ええと…何番テーブルだっけ…一番テーブルのお客様はネギはいるけど唐辛子はいらなくて…二番テーブルは唐辛子はいるけどネギはいらない…三番テーブルは…三番テーブルは唐辛子はいるけど唐辛子はいらない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430305,
						401430306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430305,
					"content": "お客さん、全員食べ終わっちゃったよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430307
					]
				},
				{
					"id": 401430307,
					"content": "…はっ！オイラ、さっきまで夢を見てたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430308,
					"content": "途中からおかしなことを言ってた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430309
					]
				},
				{
					"id": 401430309,
					"content": "うぅ…休憩する暇もなかったし、頭の中がごちゃごちゃになっちゃってたぜ…旅館にはいつもこんなにたくさんのお客さんが来るのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430310,
					"content": "まだ繁忙期だからな。初めてこの厨房を切り盛りしたにしては、お前たちは十分よくやってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430311
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430311,
					"content": "でも今回来たのは常連ばかりで、これといっておかしな注文もなくてよかった。でなければもっとややこしいことになってただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430312
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430312,
					"content": "これで「おかしな注文がなかった」のか！？醤油をかけた杏仁豆腐なんて、オイラだって食べたことないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430313,
					"content": "わはは！世の中には色んな人がいて、それぞれの好みも様々だ！それをすべて受け入れられるのが、璃月料理の真髄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430314
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430314,
					"content": "それに、このお客さんたちの注文ははっきりしていたから、指示に従って料理すれば問題なかった。本当に困るのは、「お任せ」とだけ言ってくる客たちだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430315
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430315,
					"content": "ごめんください…もう閉店しちゃったかな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430316
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430316,
					"content": "あれ？この声は…見てくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430317,
					"content": "どうしよう…本当に誰もいないみたいだ…ぼくがもっと早く来ていれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430318
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430318,
					"content": "大丈夫だよ。今から野外キャンプの準備を始めても遅くないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430319
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430319,
					"content": "そう。それに悪いのは「取材」に夢中になって時間を忘れてたお兄ちゃんだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430320
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430320,
					"content": "あーっ！リネとリネット、それにフレミネじゃないか！本当におまえたちなのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430321,
					"content": "パイモン？じゃあ…もしかして旅人も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430322
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430322,
					"content": "いるよ、どうも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430323
					]
				},
				{
					"id": 401430323,
					"content": "旅人にパイモン！まさかここで会えるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430324
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430324,
					"content": "それはこっちのセリフだぞ。オイラと旅人はここで手伝いをしてて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430325,
					"content": "三人に経緯を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401430326
					]
				},
				{
					"id": 401430326,
					"content": "…というワケなんだ。おまえたちこそ、どうしてここに？おまえたちの…その…またなにか「お父様」からの任務があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430327,
					"content": "その逆だよ。僕たちは休みで璃月に来たんだ。うん…ついでにあちこちで「取材」はしてるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430328
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430328,
					"content": "「お父様」が言うには…ここのところ、ぼくたちはずっと忙しかったから、しばらくは休むといいだろう、そのほうが次の任務に都合がいいって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430329
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430329,
					"content": "このあいだ海灯祭があったでしょう。せっかくの機会だからって、お兄ちゃんが璃月に連れてきてくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430330
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430330,
					"content": "じゃあリネが言ってた「取材」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430331
					]
				},
				{
					"id": 401430331,
					"content": "璃月港で面白いマジックをたくさん見たんだ…あれ、璃月じゃ「奇術」って呼ぶんだっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430332
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430332,
					"content": "「奇術」と「璃月劇」、「獣舞劇」を組み合わせてやる人もいて…本当にすばらしかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430333
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430333,
					"content": "それで、ここにもう何日か滞在して、もっとアイデアを集めようと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430334
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430334,
					"content": "先日は軽策荘の若心さんを訪ねたし、今日も近くでインスピレーションを探してて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430335
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430335,
					"content": "挙げ句に時間が経つのも忘れて、今日はまだ何も食べてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430336
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430336,
					"content": "ハハハ…ご飯といえば、知ってるかい？フォンテーヌも璃月も水産物が豊富だけど、調理法にはそれぞれの特徴があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430337
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430337,
					"content": "今回はせっかく来たんだから、たくさん味わっておかないとね。それも長く滞在する理由の一つかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430338
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430338,
					"content": "おお！今まではなにを食べたんだ？オイラのおすすめを教えてやろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430339,
					"content": "…お魚料理なのに、あのすごく辛いやつ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430340
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430340,
					"content": "もしかして…「黒背スズキの唐辛子煮込み」か？たしかにフォンテーヌ人からしたら、辛い魚料理って珍しいもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401430341,
					"content": "ふふ、魚料理だし匂いも美味しそうだったから、リネットは躊躇なくぱくりと一口食べたんだ。そしたら一日中むせて口もきけなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430342
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430342,
					"content": "リネットがもともと無口なほうだったのが不幸中の幸いだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430343
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430343,
					"content": "ぐーーーー",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430344
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430344,
					"content": "（リネットがお腹の鳴る音を口で言ってる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430345
					]
				},
				{
					"id": 401430345,
					"content": "お兄ちゃんとフレミネはお腹すかないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430346
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430346,
					"content": "…う、うん、ちょっとすいてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430347
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 401430347,
					"content": "あは…あはは、それもそうだね。じゃあ旅人、料理をお願いしていいかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430348
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430348,
					"content": "ご注文は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430349
					]
				},
				{
					"id": 401430349,
					"content": "メニューの名前を見ただけじゃ、どんな料理か分からないし…せっかく君がいるんだから、おすすめを貰おうかな。僕たちの味の好みは分かるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430350
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 401430350,
					"content": "…じゃ、厨房に戻って相談してみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430351
					]
				},
				{
					"id": 401430351,
					"content": "あと…お願いだから、唐辛子は入れないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネット"
				},
				{
					"id": 401430306,
					"content": "早く目を覚まして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430307
					]
				}
			]
		},
