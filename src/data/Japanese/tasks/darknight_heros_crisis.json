					"ホフマン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650101,
					"content": "ホフマン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650102,
					"content": "ああ、来てくれたんだな。協力に感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650103
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650103,
					"content": "この間の「闇夜の英雄」の件について…他に情報はないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650104,
						4650106
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650104,
					"content": "何があったか聞いても？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650105
					]
				},
				{
					"id": 4650105,
					"content": "それもそうか。こっちが先に情報を共有すべきだったな。騎士団の礼儀に欠けていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650108,
					"content": "実は…これを見てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650109
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650109,
					"content": "うわっ、へったくそな字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650110,
					"content": "んん？しかもよく見たら…読めないところがたくさんあるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650111,
					"content": "ああ、ほぼ「共通語」ではあるが、「暗号」のようなところも多々ある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650112
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650112,
					"content": "読めるところだけ見ると、大体の内容は分かるがな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650119
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650119,
					"content": "これは、アビス教団が「闇夜の英雄」に宛てた果たし状だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650113
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650113,
					"content": "つまり、「闇夜の英雄」は悪いやつらに狙われているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650114,
					"content": "その通りだ。可能であれば、なるべく早く彼と共に対策を練りたいんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650115
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650115,
					"content": "これは「闇夜の英雄」一人だけではなく、モンド全体に関わる問題だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650116,
						4650117
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650116,
					"content": "情報共有ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650118,
					"content": "ああ、何か気付いたことがあったら、いつでも来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650117,
					"content": "気にかけておく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650118
					]
				},
				{
					"id": 4650106,
					"content": "ごめん、本当に情報がない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650107
					]
				},
				{
					"id": 4650107,
					"content": "そうか…それは残念だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650108
					],
					"speakerTitle": "ホフマン"
				}
			]
		},
		{
			"id": 46502,
			"completionStepIds": [
				46505
