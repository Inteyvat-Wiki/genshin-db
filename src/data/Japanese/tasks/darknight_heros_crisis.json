			},
			"dialogs": [
				{
					"id": 4650501,
					"content": "早く「闇夜の英雄」を見つけないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650502
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650502,
					"content": "果たし状の件、騎士団はどうするつもり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650503
					]
				},
				{
					"id": 4650503,
					"content": "ああ…お前たち、ここだけの話なんだが本当に困ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650504
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650504,
					"content": "先ほどの会議で今回の行動指針が決まったんだが、どうなったと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650505,
						4650508
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650505,
					"content": "見て見ぬふり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650506
					]
				},
				{
					"id": 4650506,
					"content": "冗談はよしてくれ。騎士団はモンドの安全を脅かすものに対して見て見ぬふりなどしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650507
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650507,
					"content": "そんなことになれば、モンドの者たちは騎士団よりも「闇夜の英雄」を頼ることになるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650511,
					"content": "むむむ、じゃあ騎士団はどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650512,
					"content": "「闇夜の英雄」の正体を明らかにして、彼を「保護」することになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650513
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650513,
					"content": "「保護」？あいつの実力なら騎士団の保護なんていらないと思うけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650514,
					"content": "しっ──",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650515
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650515,
					"content": "いや、まあ、お前たちにはいろいろと世話になったからな…はっきりと教えてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650516
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650516,
					"content": "「保護」はあくまで表向きで、本当の狙いは——この一件を騎士団の管理下に置くためなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650517
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650517,
					"content": "「闇夜の英雄」には手を出させないってことか？なんでそこまでするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650518,
					"content": "騎士団の実力を証明するためだよ。「闇夜の英雄」がいなくても、騎士団がモンドを守れると民衆に証明するんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650519
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650519,
					"content": "それにアビス教団が何をするか分からない。万が一、「闇夜の英雄」に何かあれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650520
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650520,
					"content": "…敵の勢いを高めることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650521
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650521,
					"content": "う～ん…騎士団にも騎士団の苦悩があるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650522,
					"content": "それに「闇夜の英雄」の正体も分からない、怪しい人物が多すぎてどこから調査すればいいのかわからないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650523
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650523,
					"content": "そう悩む必要はないさ、ホフマン。俺の言う通りに調査すればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650524
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4650524,
					"content": "ガイア隊長？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650525
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650525,
					"content": "そうだな、最近ディルックのヤツが毎晩「エンジェルズシェア」でバーテンダーをやっているらしいんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650526
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4650526,
					"content": "彼を見張ってみたらどうだ？そう難しいことじゃないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650527
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 4650527,
					"content": "それはもちろん問題ありませんが、しかし…ガイア隊長、つまり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650528
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650528,
					"content": "ディルック様が「闇夜の英雄」であると疑っているんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650529
					],
					"speakerTitle": "ホフマン"
				},
				{
					"id": 4650529,
					"content": "さてね、どうだか。騎士団の中でも疑いの声は上がっているだろう？あいつに遠慮する必要はないさ。一番怪しい人物を真っ先に調査するのが普通だ。",
