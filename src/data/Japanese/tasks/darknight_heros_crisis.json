			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ディルック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650201,
					"content": "ディルックの旦那！今、騎士団で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650202,
					"content": "アビス教団からの果たし状のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650203,
					"content": "もう知っている。わざわざ知らせに来てくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650204,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650205,
					"content": "アカツキワイナリーの情報網は、ビジネスだけじゃないってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650206,
					"content": "じゃあ、ディルックの旦那はどうするつもりなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650207,
					"content": "君たちの意見を聞かせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650208,
					"content": "騎士団と手を組んだ方がいい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "それでは、アビス教団の思うツボだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650210,
					"content": "ヤツらは僕と騎士団の間に確執があると勘付き、僕を騎士団の前に引きずり出そうとしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650211,
					"content": "僕の正体が騎士団に露呈すれば、今後の行動は騎士団の制限を少なからず受けることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650212,
					"content": "権力を握っている組織というのは、部外者が「代わりに正義を執行する」のを許さないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650217,
					"content": "むむ…アビス教団のやつら、なんて難題を投げつけてきやがるんだ。ズル賢いにもほどがあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650218,
					"content": "むろん方法はある。だが、情報が必要だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650219,
					"content": "…果たし状にわざと隠されていた情報がね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650220,
					"content": "わざと隠されていた？読めない部分のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650221,
					"content": "あれはヤツらだけが読める、「暗号」のようなものだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650222,
					"content": "「果たし状」は実は仲間に宛てたもの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "つまり、あれは単なる「果たし状」ではなく、ヤツらの「行動通達」の一種なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650225,
					"content": "双方の立場が対立した時、一方にとっての「英雄」は、もう一方にとっての「悪人」となる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650226
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650226,
					"content": "僕は長いこと、ヤツらにとっての「悪人」となってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650227
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650227,
					"content": "アビス教団が僕という目標を見据えることで、その力はより団結を増すことになるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650228
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650228,
					"content": "…う、う～ん…英雄になるためには、ディルックの旦那みたいなすごい頭脳が必要なのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650229,
					"content": "ただヤツらのことに詳しいだけだ。「英雄」とは見方を変えれば「悪人」だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650230
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650230,
					"content": "でも、読んでも分からない部分について、どうすればいいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4650231,
					"content": "簡単さ、分からなければ聞けばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650232
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650232,
					"content": "ヤツらの<color=#00E1FFFF>拠点</color>はすでに把握している…興味があるならついてくるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650223,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}たちが読めないのに、なぜ書くんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650213,
					"content": "しばらくワイナリーで隠れよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650214
					]
				},
				{
					"id": 4650214,
					"content": "それでは、何もかも騎士団任せになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650215
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650215,
					"content": "彼らが頼りになる相手であれば、ここまで悩みはしないのだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650216
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650216,
					"content": "それに僕は、隠れて騎士団に尻拭いをしてもらうほど落ちぶれてもいない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "ディルック"
				}
			]
		},
