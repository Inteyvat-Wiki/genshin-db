			},
			"dialogs": [
				{
					"id": 4650401,
					"content": "こんなところまで乗り込んで来るとは…騎士団め…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4650402,
					"content": "僕を騎士なんかと一緒にするな。さあ、計画の中身を大人しく吐いてもらおうか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650403,
					"content": "「手紙」を読んだのか…お前にその秘密を教えるわけがないだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4650404,
					"content": "自分の立場をまだ分かっていないようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651001
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4651001,
					"content": "<color=#00E1FFFF>「逆焔の手」</color>を使う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "手を媒介に神の目の炎を放った？…あぅぐ、熱ッ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4650601,
					"content": "いつまで我慢できるか見てみようじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4650405,
					"content": "もう一度<color=#00E1FFFF>「逆焔の手」</color>を使う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "やめろ…頼むからやめてくれ！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4650406,
					"content": "もう一度<color=#00E1FFFF>「逆焔の手」</color>を使う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "ゴホ、ゴホッ……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4651403,
					"content": "死んだふりしても無駄だ、この程度の炎では…ん？<color=#00E1FFFF>気絶</color>したか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4651404,
					"content": "…おい、まだ寝るには早い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4651405,
					"content": "ぐぅあああ──ッ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4650901,
					"content": "言う！言うから！ングッ…止めてくれ、<color=#00E1FFFF>全部教える</color>ッ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4650902,
					"content": "教団は…教団は「闇夜の英雄」を憎む者を、その力のすべてを集結させた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4650903,
					"content": "明日、22時にモンドの<color=#00E1FFFF>正門</color>へと奇襲を仕掛ける…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4650904,
					"content": "知っているのは、これだけだ…本当だ、だからあの炎は…も、もうやめてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "審問"
				},
				{
					"id": 4650905,
					"content": "それだけか？フン…なら、いい。もう何かを隠せるほど強い心も残っていないだろうしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				},
				{
					"id": 4651201,
					"content": "作戦情報を<color=#00E1FFFF>聞き出す</color>…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650901
					]
				}
			]
