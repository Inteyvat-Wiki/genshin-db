			"dialogs": [
				{
					"id": 414020201,
					"content": "そこの旅人、少し待ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020202,
					"content": "なにか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "突然だが…「写真機」に興味はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020204,
					"content": "少し興味ある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "私が持ってるこの「写真機」は普通の物とは違い、フォンテーヌの最新技術を使用している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020207,
					"content": "この「写真機」から撮れた写真は、普通の物にはない色が出るらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020208,
					"content": "どういう原理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "おいおい、全然信じてないな…そんなに疑うなら、冒険者協会に聞いてみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020211,
					"content": "いくらいじっても上手く撮れなかったから、私も信じてなかった。しかし、協会にいた一人の冒険者に手伝ってもらってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020212,
					"content": "この「写真機」の内部にある小さな構造が、普通の物と違うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020213,
					"content": "その構造には特別な薬剤が入っていて、写し出した写真に特別な効果を与える。普通の「写真機」より綺麗に撮れるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020214,
					"content": "どうだ？興味があるなら、これを使って遊んでみないか？薬剤はそんなに多くないが、体験するくらいはできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020215,
					"content": "いずれフォンテーヌに出向いて、新種の薬剤を購入する予定だ。もし興味があったら、また来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020216,
					"content": "あ…ありがとう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "じゃあこの「写真機」は君にあげるよ。気に入ったら、また来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414020217,
					"content": "薬剤はいくら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "それは…ゴホンッ…心配しないでくれ、1本の値段は安い。多く買ってくれたら、もっと割引してもいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020209,
					"content": "本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "まったく興味ない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
