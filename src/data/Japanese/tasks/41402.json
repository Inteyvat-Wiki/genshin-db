			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"季同"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "その「写真機」は君にあげるよ、ちゃんと使ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020302,
					"content": "この「写真機」…くれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "その薬剤は結構持つと思うけど、それでも使い終わったら…私のところから買うといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020305,
					"content": "それに、私はまだまだ新しい種類の薬剤を仕入れる予定だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020306,
					"content": "今後も興味があれば、また来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020307,
					"content": "いやぁ、まさか「写真機」でこんなにいい商売ができるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414020303,
					"content": "薬剤が使い終わったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}