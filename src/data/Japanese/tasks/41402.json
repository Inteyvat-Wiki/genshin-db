			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "あぁ君か、ちょうど話したい事があったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020102,
					"content": "なに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "いや、もう大丈夫だ。原因が分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020105,
					"content": "この前、私にこの「写真機」を売った人を見つけてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020106,
					"content": "「写真機」に問題があるって言っても信じてくれなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020107,
					"content": "前に君が写真をたくさん撮ってくれただろ、あれがなかったら、多分言い逃れされていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020108,
					"content": "あれらの写真のおかげで、私が買った「写真機」を調べてくれる約束をしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020109,
					"content": "ほら、ちょうど昨日、彼からなにかの薬剤をもらった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020110,
					"content": "どうやらこの「写真機」の構造は普通の物とは違い、本体に薬剤を入れることで、正常な写真になるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020111,
					"content": "薬剤がなければ、君が以前撮ったのと同じように、色だけあって、具体的な写真にならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020112,
					"content": "故障じゃなくてよかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "とは言っても、「写真機」よりも、今度はこの薬剤のことが気になるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020115,
					"content": "ほら、「写真機」は普通1台しか買わないだろ？1台あればずっと使える…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020116,
					"content": "でも薬剤は消耗品だ。使い終わったら、新しいのを買わないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020117,
					"content": "それに彼によれば、違う薬剤は違う効果があるみたいだ。彼も今新しい薬剤の研究をしているらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020118,
					"content": "もしかすると…この薬剤は素晴らしい商売になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020119,
					"content": "ゴホンッ…失礼、自分勝手に喋りすぎた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414020120,
					"content": "協力してくれてありがとう。その「写真機」を渡してくれ、薬剤を入れてみる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414020113,
					"content": "じゃあ…もう問題ない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "今日も「色」が強烈な物を撮るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
