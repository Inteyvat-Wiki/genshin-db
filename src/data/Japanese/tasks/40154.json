			"dialogs": [
				{
					"id": 401540101,
					"content": "頑張って経営した結果、錬金ショップの売上は予想を遥かに上回るものだった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "あら、こんな短い期間で、売上をここまで伸ばしてくれるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540103,
					"content": "もしかして、可愛い子ちゃんって商売の天才なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540104,
					"content": "リサさんのサポートのおかげだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "ふふっ、相変わらず謙虚な子ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540106,
					"content": "こんなに素晴らしい成果を出したんだから、もっと誇っていいと思うわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540109,
					"content": "もしあなたが助手として傍にいてくれたなら、わたくしの休暇も二倍になったでしょうに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540110,
					"content": "さあ、売上データはすでに十分集まったわ。お疲れ様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540111,
					"content": "もちろん、もし引き続きお店を手伝ってくれるのなら、お姉さんはとっても嬉しいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540112,
					"content": "これで、ジンにも報告できるわね、ふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540113,
					"content": "旅人、パイモン、久しぶりだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540114,
					"content": "ジン団長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401540115,
					"content": "来てくれたのね。ちょうど可愛い子ちゃんとの仕事の引き継ぎが終わって、騎士団に戻ろうとしていたところよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540116,
					"content": "ああ、他の騎士から大体の状況は聞いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540117,
					"content": "今回も旅人に手伝ってもらうことになるとは思わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540118,
					"content": "あら、こういう大切な仕事で成果を出すには、賢くて有能な協力者が不可欠なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540119,
					"content": "だってわたくしだけだったら、ここまで効率よくこなせなかったもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540120,
					"content": "確かに、君たちの実績は驚くべきものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540121,
					"content": "他の用事を済ませてから様子を見に来ようと思っていたが、なかなか時間が取れなくてな…せめて、面と向かって礼を言いたかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540122,
					"content": "ジン団長はずっと裏で支えてくれてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "ああ、君たちのような優秀な仲間がいてくれて、本当に安心だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540125,
					"content": "ふふっ、この件が一段落したら、ちゃんとお休みをくれるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540126,
					"content": "最近、少し抜け毛が多い気がするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540127,
					"content": "勿論だ。連日、苦労をかけるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540128,
					"content": "君が毎日図書館に入り浸っているのを見て、ずっとそればかりだと退屈するのではないかと思った。それで君の才能をより発揮できるような仕事を手配したのだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540129,
					"content": "一気に負担をかけすぎてしまったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540130,
					"content": "まあ、そんなことないわ。騎士団のみんなのサポートもあるし、頼もしい旅人もお仕事を手伝ってくれたもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540131,
					"content": "たまには本業に戻って、研究をするのもなかなか面白いわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540132,
					"content": "そうか、そう思ってくれているならよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540133,
					"content": "旅人、改めて感謝する。この報酬を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 401540134,
					"content": "そうそう、お姉さんもあなたのために記念品を作ったの。気に入ってくれると嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 401540123,
					"content": "これはみんなが頑張った結果だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "いつの間にかコツを掴んでた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "ええ、やっぱりあなたって学習能力がとても高いのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "リサ"
				}
			]
		}
	]
}