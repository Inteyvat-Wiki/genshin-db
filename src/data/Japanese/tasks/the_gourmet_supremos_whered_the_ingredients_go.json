			"trigger": {
				"objectNames": [
					"ジュリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "えっと…ここのはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260102,
					"content": "ジュリー？どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "あれ？旅人じゃない。へへっ、ここで会えるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260104,
					"content": "旭東が新しい料理の研究を始めたから、私は食材を探しに来たの。パルヴァネもアイデアを出してくれてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260105,
					"content": "旭東は稲妻の「三色団子」を参考にして、甘いフワフワの料理を作ろうとしているの。そのために特別な食材が何種類も必要なんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260106,
					"content": "宗久のおじさんは町でスミレウリを買いに、私はここで「緋櫻毬」を集めてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260107,
					"content": "ある程度集めたんだけど、まだ少し足りないの。もっと奥に行って探したかったんだけど、魔物がたくさんいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260108,
					"content": "だからお願い、旅人！「緋櫻毬」を三つ集めてきてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260109,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "ありがとう！戻ってきたら、美味しいものを食べさせてあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260111,
					"content": "魔物くらい倒せるでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "まあ、普段はそうなんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260113,
					"content": "でも何というか、もし本当に魔物たちと戦ったら、きっと食材集めのことを忘れちゃうと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260114,
					"content": "モンドにいた時もそうだったもの。どんな依頼でも、魔物と戦うとそれに集中し過ぎて、他のことをすべて忘れてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260115,
					"content": "魔物を一体も残らず倒して、そこで初めて、まだ依頼が残っていることを思い出すの…そのせいで、たくさんの依頼を失敗しちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260116,
					"content": "魔物が嫌いなんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "魔物が嫌い？それが原因ってわけじゃないよ。実は…魔物と戦う時、すごく楽しいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260118,
					"content": "魔物を倒すこと以外何も考える必要がない。一つのことに没頭する感じを体験したことある？すごく爽快だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260119,
					"content": "ああ、そんなことはいいから。とにかく、「緋櫻毬」の件は任せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260120,
					"content": "戻ってきたら、美味しいものを食べさせてあげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリー"
				}
			]
		},
