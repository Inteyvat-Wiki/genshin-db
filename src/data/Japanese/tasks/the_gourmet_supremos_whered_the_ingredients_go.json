					"ジュリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "よし、これで十分だと思う。ありがとう。もし君の手伝いがなかったら、一人でそこにいる魔物を全部やっつけなきゃいけないところだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260302,
					"content": "そうなったら、いつ「緋櫻毬」集めのことを思い出せるのか全く分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260303,
					"content": "そうだ、お礼として、この「鳥肉と野生キノコの串焼き」をあげるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 220260304,
					"content": "そろそろ集めた「緋櫻毬」を旭東のところに持って帰らなきゃ。いったいこれで何を作るんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジュリー"
				}
			]
		}
	]
