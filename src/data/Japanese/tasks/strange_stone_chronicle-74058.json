			"dialogs": [
				{
					"id": 740580401,
					"content": "いらっしゃい…ああ、君たちか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580402
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580402,
					"content": "前回約束した鉱石は、持ってきてくれたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580403
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580403,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740580404
					]
				},
				{
					"id": 740580404,
					"content": "まあ、急ぎっていう訳じゃない…前回持ってきてくれたあの鉱石サンプルは、まだ職人たちによって加工中だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580405
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580405,
					"content": "ただ、もし早めにより多くの鉱石が届いたら、職人たちに何か新たな閃きが生まれるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580406
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580406,
					"content": "じゃ、私はここでいい知らせを待ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チェシル"
