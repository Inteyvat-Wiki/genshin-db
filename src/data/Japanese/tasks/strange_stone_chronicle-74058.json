			"dialogs": [
				{
					"id": 740580201,
					"content": "こ…こんなに大量にあるなんて。本当に助かったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580202,
					"content": "たぶん職人さんがこの宝石の性質についてあまり知らないから、ちょっとしたトラブルがあって…前回宝石の加工依頼した分は、未だに完成品が届いてないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580203,
					"content": "でもきっと大丈夫さ。私は自分の見る目を信じてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580204,
					"content": "私はこれらを加工して一番流行するアクセサリーを作るつもりだ。きっとフォンテーヌ全国で大ヒットするに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580205,
					"content": "今度君たちが来た時には、完成品が見られるだろう！そしたら、君たちへのお礼として、サンプル品をプレゼントしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580206,
					"content": "でも、それより先に、上流社会の貴人たちが既に身につけているのを見られるかもしれないな。ははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "チェシル"
				},
				{
					"id": 740580207,
					"content": "それじゃ、またぜひ来てくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チェシル"
				}
			]
		},
