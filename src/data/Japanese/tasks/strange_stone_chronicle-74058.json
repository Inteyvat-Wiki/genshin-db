			"dialogs": [
				{
					"id": 740580101,
					"content": "プーカ、戻ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740580102,
					"content": "#{NICKNAME}{M#兄さん}{F#姉さん}とパイモン！遊びに来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740580103,
					"content": "いや、そうじゃないけど、前に言ってたよな？この周辺の鉱脈と鉱石のことならおまえに聞いたらいいって、だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740580104,
					"content": "うん。この周辺のきれいな石は全部集めたんだ。どんな石を探してるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740580105,
					"content": "実は…えーっと、前回拾ったあの石だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740580106,
					"content": "前回フォンテーヌ廷に行った時、奇妙な鉱石を宝石商人に売ったとプーカに伝えた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "えっ？外の人からしたら、これが貴重な宝石になるの？以前姉さんにも見てもらったのに…外の人の考え方って本当によくわからないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740580108,
					"content": "でも、この石がある場所は他にもたくさん知っているよ。もし必要なら、位置を教えてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "プーカ"
				},
				{
					"id": 740580109,
					"content": "プーカが奇妙な鉱石を見つけられる場所を記してくれた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "ホントによかったぜ。ありがとな、プーカ！そうだ、これはチェシルがオイラたちに前払いしたモラだ。えへへ、そうだな…半分わけてやってもいいぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740580111,
					"content": "いいのいいの、村で暮らすのにそんなものはいらないし…それにいろいろ助けてもらったんだから、これくらい大したことじゃないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プーカ"
				}
			]
		},
