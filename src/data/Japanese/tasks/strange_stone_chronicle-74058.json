			"dialogs": [
				{
					"id": 740580301,
					"content": "いらっしゃい…ああ、君たちか。鉱石を持ってきてくれるっていう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580302
