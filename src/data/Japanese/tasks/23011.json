			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴィクトル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "えーっと…ここはどうやって彫るんだったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110102,
					"content": "やあ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "ったく、誰だよ…邪魔すんな、俺様は今…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110105,
					"content": "はあ！？旅人ぉ！？おま…なんでお前までスメールに来てるんだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110106,
					"content": "まさか…ルドルフか？やつが俺様をぶん殴るためによこしたんじゃないだろうな！？…リリーにちょっとしたプレゼントをあげただけじゃねえか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110107,
					"content": "旅でここに来ただけだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "お前、まだ旅をしてんのか…相変わらず元気なやつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110112,
					"content": "ただ、実際…スメールでお前に出会えるなんて、マジで思わなかったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110113,
					"content": "モンドから転任させられた時、元々は直接スネージナヤに戻るよう命じられてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110114,
					"content": "だが、途中で新たな命令が来た。スメールシティでフセヴォロドさんの仕事の手伝いをするようにとな…俺様は、既に「雄鶏」様の配下になったとのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110115,
					"content": "「雄鶏」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "そうだ…おっと、だめだめ、これ以上は言えないんだ。またフセヴォロドさんに機密に敏感でないだなんだと説教されるからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110118,
					"content": "はぁ、執行官様たちの名前は、別に秘密でもなんでもないんだが…どうしてそこまで敏感になるのかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110119,
					"content": "スメールで何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "ああ、フセヴォロドさんと俺様の主な仕事は…後方勤務の補給がスムーズにいくよう斡旋することだ。簡単に言えば、あっちこっち回ってブツを仕入れるってことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110121,
					"content": "重要な仕事かと言われるとそうでもないが、モンド大聖堂でぼーっとするよりはましだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110122,
					"content": "へへ…それに、この仕事は暇な時間が多くてな。前みたく、誰かにじっと見られてるってこともねえから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110123,
					"content": "ガキの頃にやってた木彫りをまた始めたんだ。スメールは木が多いからな、練習にはもってこいの環境だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110124,
					"content": "意外なことに、俺様の彫ったおもちゃは地元のガキ共に人気でね。あんまりうるさくねだってくるもんだから、一人一つずつ彫ってやるって約束しちまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110125,
					"content": "#{M#君}{F#あなた}、ファデュイだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "そうだ。それがどうした？ったく…ファデュイが子供におもちゃをあげたらダメだ、なんてルールはないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110127,
					"content": "それに、俺様はただの後方勤務だ。天地を揺るがすようなあれこれは、上のお偉いさんたちに任せるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110130,
					"content": "とにかく、俺様の現状は見ての通りだ。スネージナヤには帰れなかったが、スメールも悪くない。食って遊べて、環境もいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110131,
					"content": "仕事が上がったら食い物を買い、日差しのいいところを探して木を彫るんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110132,
					"content": "ま、みんなが俺様を見る表情に多少なりとも不信感があるのはわかってる。お前が俺様と初めて会った時のようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110133,
					"content": "それはどうしようもねえ。俺様はファデュイだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110134,
					"content": "今でも信用していないけどね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "まあいい…とにかく、俺様は今の生活に割と満足してるって言いたかったんだ。貯金も少しできたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110137,
					"content": "あと何年かしたら、スメールに落ち着くなんてことも考えるかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110138,
					"content": "こほん…話は以上だ、旅人。せっかくスメールでこうして会ったんだ。興味があるならまた「等量交換」を再開してもいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110139,
					"content": "だが、今回は教えてやれる情報もないんだよな…ちゃんとした報酬を用意するしかねえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110140,
					"content": "その方がいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "よし、じゃあ依頼内容を説明するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110144,
					"content": "数日前、ハマウィーに木材を1口注文したんだが…それがまだ届いてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110145,
					"content": "俺様はいま勤務中だからな、直接あいつを探しには行けない。またフセヴォロドさんにドヤされちまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110146,
					"content": "旅人、ハマウィーに俺様の注文した木材がいつ届くのか聞いてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110147,
					"content": "報酬を用意しておいて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "安心しな、ちゃんと用意しとくからよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110151,
					"content": "とにかく、この件は頼んだぞ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110149,
					"content": "本当に何も企んでいないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "いままでお前と取引してきて、小細工を弄したことがあるか？安心しろ、俺様はそんなことするほど暇じゃない。これでも平穏な生活を続けたいんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110141,
					"content": "それは「ファデュイ」としての依頼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "もちろん違う。ただの「ヴィクトル」からさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110135,
					"content": "誰が信用すると？馴れ馴れしくしないで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "まさか、子供たちから情報を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "おい！俺様がそんなことすると思うか？いくらファデュイだからって、固定観念が過ぎるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110116,
					"content": "また別の執行官が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "そうだ、一緒にモンドに帰ろう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "ハッハッハ…いいぞ、俺様に手錠をかけられるもんならな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110111,
					"content": "ま、冗談はこのくらいにしとこう…俺様には、まだ大事な用事があるんでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110103,
					"content": "ヴィ…ヴィクトル？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
