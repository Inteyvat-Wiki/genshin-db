			"dialogs": [
				{
					"id": 230110601,
					"content": "どうだ、俺様が注文した木材は届いたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110602,
					"content": "ヴィクトルに事の経過を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "また魔物かよ？世の中の荷車は、必ず魔物に襲われないといけないルールでもあるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110604,
					"content": "…まあ、木材が届いたならそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110605,
					"content": "ほら、これが約束の報酬だ。ちゃんと数えてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110606,
					"content": "それと…その、リリーは元気にしてんのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110607,
					"content": "あいつには何も言わないで出てきたからな…怒ってねえといいんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110608,
					"content": "あの子は元気だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "ならいい、こほん…そ、そんな目で見るなよ！ただ聞いてみただけだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110614,
					"content": "そんなことより旅人、報酬をもう一回数えてくれ。お前への報酬は、約束通り、きちんと用意したからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110610,
					"content": "自分で見に行ったら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "そんな事してみろ、フセヴォロドさんにブン殴られるに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110612,
					"content": "とはいえ手紙を出すのも、なんか違う気がしてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "ヴィクトル"
				},
				{
					"id": 230110613,
					"content": "まぁ…ファデュイから手紙がくるってのも、あまり気持ちのいいもんじゃないしな？ハハハ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "ヴィクトル"
				}
			]
