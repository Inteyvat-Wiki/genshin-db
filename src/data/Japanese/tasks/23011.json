			"dialogs": [
				{
					"id": 230110301,
					"content": "ついてないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "ハマウィー"
				},
				{
					"id": 230110302,
					"content": "ヴィクトルの木材について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "あのファデュイが注文してきた木材のことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "ハマウィー"
				},
				{
					"id": 230110304,
					"content": "はぁ、まったく。あんたらファデュイに関わるとロクなことがない思ってたところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "ハマウィー"
				},
				{
					"id": 230110305,
					"content": "木材は運ぶ途中で魔物に襲われて、人こそ無事だったものの、荷車が壊されてな…木材を全部その場に残さざるを得なかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "ハマウィー"
				},
				{
					"id": 230110306,
					"content": "はぁ…今この状況で行く勇気は俺にはないし、かといって、あの魔物たちを追い払える人をすぐに見つけるのも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "ハマウィー"
				},
				{
					"id": 230110308,
					"content": "#{M#俺}{F#私}はファデュイじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "お前、ファデュイじゃないのか？じゃあどうしてあいつを手伝ってるんだ？妙なことをするもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "ハマウィー"
				},
				{
					"id": 230110310,
					"content": "ともかく、荷車はしばらく取り戻せないんだ。人を雇ってから改めてやり方を考える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "ハマウィー"
				},
				{
					"id": 230110311,
					"content": "急ぎで木材が欲しいなら、荷車の大体の場所を地図に書いてやる。悪いが自分で行ってみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "ハマウィー"
				},
				{
					"id": 230110312,
					"content": "はぁ、やはりファデュイに関わるとろくな事がない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハマウィー"
				}
			]
		},
