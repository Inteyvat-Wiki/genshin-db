			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茅葺一慶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "よっ！そこの異郷人、戦闘に興味はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600102,
					"content": "百戦錬磨の戦士だけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "そいつはよかった、俺の見る目に間違いはなかったようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600106,
					"content": "近ごろ、秘密裏に「百人一揆」を開催してる連中がいるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600107,
					"content": "百人一首？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "いやいや、百人一揆だ。百人一首ってなんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600110,
					"content": "かつて、天狗たちを模倣した「天狗党人」の中に、ある伝統的な儀式があった。簡単に言うと、それは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600111,
					"content": "不景気な時、心が落ち込んでいる時、何か喜ばしいことが起こった時、もしくは単純に暇を感じた時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600112,
					"content": "爽快な戦いを通して、慶祝をしたり、不運を取り除いたりする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600113,
					"content": "それならいつでも開催できそうだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "確かに、よく考えるとそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600115,
					"content": "とにかく、場所を変えて話そう。ここは人が多すぎるから話しにくい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600109,
					"content": "聞かせて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "何か依頼があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "依頼というわけでもないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "茅葺一慶"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266002",
							"2"
						],
						"stepId": 7266002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茅葺一慶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "着いたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600202,
					"content": "この怪しそうな扉の中に入れば、百人一揆の会場だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600203,
					"content": "興奮してきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "「天狗党」はとっくに公序良俗に反するという理由で禁じられていたが、時折こうして秘密裏に百人一揆の乱闘大会を開催している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600206,
					"content": "そして世界各地から、戦いに飢える魔物、冒険者、戦士たちが引きつけられ、その舞台で大いに力を振るう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600207,
					"content": "君も志を共にした仲間や戦友と参戦してみるといい。なんと言っても「百人」だから、人が多いほどいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600208,
					"content": "四方を旅する冒険者の君なら、一緒に参加してくれる友達もいるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600209,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は参加しないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "俺か？俺は傍観者の身分で、君を応援するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600211,
					"content": "実は、俺の目的は面白い格闘系小説を書き、八重堂の「この小説はすごい」の賞を取ることなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600212,
					"content": "そして、君こそが格闘場で最も輝く星だと、俺の直感が教えてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600213,
					"content": "がんばる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "小説の名前も考えてある。『百人一揆——最強武闘大会編』。いつの日か八重堂でこの本を見かけたら、金髪異邦戦士の登場をぜひ確認してみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600216,
					"content": "期待してるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600214,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "なんか怪しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}