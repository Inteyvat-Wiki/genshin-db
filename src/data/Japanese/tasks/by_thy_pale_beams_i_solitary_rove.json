			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620301,
					"content": "どうして…まさか、父が残した釣り餌の配合でもダメだったっていうの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620302,
					"content": "そう落ち込むなって…全部あの遺跡守衛のせいだ！きっとあいつが「海中月」を驚かせちゃったんだ！もう一回やってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726620303,
					"content": "うん、もう一回試してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620306,
					"content": "ちょっと休憩、疲れたわ。もしかしたら、ナンタックの言ったことが正しかったのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620307,
					"content": "はぁ…今は外で気晴らしに行きたい気分ね。これからのことをよく考えないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620308,
					"content": "はいこれ、報酬よ。何はともあれ、手助けありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620309,
					"content": "鯨井さん、一人で落ち着きたい気分みたいだな。しばらく経ってからまた来よう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}