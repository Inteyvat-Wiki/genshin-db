					"鯨井椛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620101,
					"content": "これ見て！父の航海日誌をもう一度調べてみたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620102
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620102,
					"content": "中に付録があって、かつて特殊な釣り餌の配合を研究した記録が書かれてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620103
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620103,
					"content": "父たちが「海中月」に会った時、海草と魔晶鉱を混ぜた特殊な釣り餌を使ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620104
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620104,
					"content": "もし私たちもそれが作れたら、「海中月」を引きつけることができるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620105
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620105,
					"content": "海草は今けっこう持ってるけど、魔晶鉱は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620106
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620106,
					"content": "結構あるから大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620107
					]
				},
				{
					"id": 726620107,
					"content": "えっ？ホント？荒海の方で採掘したやつ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620108
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620108,
					"content": "父の日誌に書かれてたんだけど、魔晶鉱は必ず荒海にある廃墟で採掘する必要があるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620109
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620109,
					"content": "普通の魔晶鉱となんの違いがあるかは知らないけど、やるからには慎重にいかないと。書かれた通りにやった方がいいと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620110
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620110,
					"content": "でも、荒海には魔物がたくさんいて危険だから、冒険者協会で依頼を出してくるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620111
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620111,
					"content": "大丈夫、こっちで解決するから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620112
					]
				},
				{
					"id": 726620112,
					"content": "そうね…君がとても強い冒険者だってことを危うく忘れるところだったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620113
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620113,
					"content": "君がいて本当に助かったわ。じゃあお願いね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620114
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620114,
					"content": "私は餌を作る工具を取ってくる。あとで荒海西側の砂浜で落ち合いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井椛"
				}
			]
		},
		{
			"id": 7266202,
			"completionStepIds": [
				7266204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266204",
							"2"
						],
						"stepId": 7266204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620201,
					"content": "こんなに早く見つけたの？さすが実力のある冒険者ね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620202
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620202,
					"content": "これで足りる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620203
					]
				},
				{
					"id": 726620203,
					"content": "ええ、あとは私に任せて。これをこうして…こうやって…こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620204
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620204,
					"content": "できた、これよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620205
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620205,
					"content": "あとは釣り餌を撒いて、「海中月」を待つだけでいいんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726620206,
					"content": "そうよ。この場所もしっかり考えて選んだの。あの時私たちが岸に上がったのもこの場所だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620207
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620207,
					"content": "私たちの帰り道を指してくれた「海中月」も、ここで消失したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620208
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620208,
					"content": "だから、みんな準備はいい？「海中月」に会ったら願いを祈ることを忘れないでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620209
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620209,
					"content": "もし失敗したら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620210
					]
				},
				{
					"id": 726620210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620211
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620211,
					"content": "そんなこと言わないで。きっと成功する。「海中月」はきっと来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620212
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620212,
					"content": "おう！きっと大成功だ！ちゃんとかかってくれよ！頼むぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726620213,
					"content": "見て見て！水の下に光が！何かこっちに来る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620214
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726620214,
					"content": "本当か？本当に「海中月」が来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726620215,
					"content": "うわっ——遺跡守衛だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726620216,
					"content": "なんでこいつが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7266203,
			"completionStepIds": [
				7266206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
