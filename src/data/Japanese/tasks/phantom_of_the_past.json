			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アデリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "ようこそお越しくださいました。お二方ともご無沙汰しております。変わらずお元気そうで何よりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120202,
					"content": "アデリンメイド長、こんにちは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120203,
					"content": "何かディルック様に御用でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120204,
					"content": "ブドウジュースのために…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "そうだ。アデリンがここにいるなら、直接アデリンに頼んでみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120207,
					"content": "アデリン、実はオイラたちワイナリーの特別価格ブドウジュースをいつも買えないんだ。だから、今回は早めに来て予約しようと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120208,
					"content": "手付金を少し多く払ってもいいから、一本予約してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120209,
					"content": "ええ、問題ありません。それに手付金を払う必要もありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120210,
					"content": "ただ、しばらくお待ちいただくことになるかと思います。アカツキワイナリーの特別価格ブドウジュースは、準備に結構な時間が掛かりますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120211,
					"content": "このブドウジュースを作るため、毎年夏にディルック様が自ら上質なブドウを二樽選んでいるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120212,
					"content": "でも、なんで質のいいものを安く売るんだ？「上質なブドウ」って聞いただけで、高そうな気がするけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120213,
					"content": "旦那様は、そのことについて詳しくお話しされたことはありません。ですので、私も旦那様のお考えを推測することしかできませんが——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120214,
					"content": "特別価格はあくまで一つの手段なんだと思います。特別価格と書かれた品は、お客様をより多く引き寄せることができますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120215,
					"content": "もしかすると、旦那様はこれによりジュースを流行らせ、人々に新しい選択肢を与えたいのかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120216,
					"content": "そうすれば、アルコール依存症の人たちは理想的な代替品を見つけることができます。酔っ払って騒ぎを起こす人もいなくなりますし、お酒を飲めない人たちにとっては新たな楽しみになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120217,
					"content": "ワイナリーの商売に影響はないの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "旦那様は、そのような些細な収益を気にするような方ではありません。ひたすら売上を上げることよりも、おそらく人々が節度を持ってお酒を飲んでくれることを願っているんだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120220,
					"content": "美酒と生活を楽しむと同時に、理性を保ち、他の人に迷惑をかけない…素晴らしいことでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120221,
					"content": "ディルックの旦那は、そこまで考えてるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120222,
					"content": "それで、いまディルックの旦那は今年のブドウを選んでるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120223,
					"content": "いえ、まだ選んでいません。旦那様は目の前の面倒事を片付けてから、その選定作業に移るとのことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120224,
					"content": "もしご興味を持って下さるようでしたら、旦那様からのお声がけがあるかもしれませんね。お二方からアドバイスをいただくために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120225,
					"content": "面倒事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "はい、お二方もご存じかと思いますが、旦那様はよくあらぬ噂を耳にしては、その不徳で無礼なやからを「接待」しています。今回もそれと同じです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120227,
					"content": "本日、旦那様が向かわれたのは鷹飛びの浜。お二方はお気になさらず、ワイナリーでしばしお休みになってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120228,
					"content": "ただ、私はここであるお客様たちを待っていますので、代わりにヘイリーとモコがお二方をおもてなしします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120229,
					"content": "不徳で…無礼？なんだかアデリンの言ってることがよくわからないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120230,
					"content": "ディルックさんの「副業」のことかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "えっ？もしかして、やみ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120232,
					"content": "コホン！「やみ」で悪事を働いてるアビス教団を片付けることか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120233,
					"content": "なら、ディルックの旦那の仲間として、オイラたちが黙って見過ごすわけにはいかないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120238,
					"content": "ええ、お二方が協力してくださるのでしたら、こちらとしても安心です。何しろ、お二方は旦那様に信頼されています。実力は折り紙付きですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120239,
					"content": "お力をお貸しいただき、本当にありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 705120240,
					"content": "気にすんな！ディルックの旦那が早く用事を済ませてくれたら、オイラたちもおいしいブドウジュースを買えるようになるしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120241,
					"content": "じゃ、出発しようぜ！鷹飛びの浜に行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120234,
					"content": "ワイナリーでディルックさんを待とう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "うぅ、ディルックの旦那が外を駆け回ってるのに、ここでぼーっとしてるだけなんて、なんだか気が引けるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120236,
					"content": "オイラたちも鷹飛びの浜に行ってみようぜ。ディルックの旦那が抱えてる面倒事を片付けるのを手伝おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120237,
					"content": "ディルックの旦那は十分強いけど、助っ人は多ければ多いほどいいはずだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120218,
					"content": "つまり、業務の拡大？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "用というほどのことでは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "これ、ディルックの旦那のテントじゃなさそうだな。どっかの冒険者の拠点か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120402,
					"content": "ん？そこに紙とノートがあるぞ。読んでみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120403,
					"content": "「闇夜の英雄」よ、あの時と同じ異常現象が再び発生した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 705120404,
					"content": "過去に君が、完全に問題を解決したというのにだ。またも地脈が何らかの刺激を受け、記録された魔物が放たれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 705120405,
					"content": "君はすぐに駆けつけ、最大の脅威を取り除くことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 705120406,
					"content": "俺は行動規則に従い、このことを必要な人に知らせていく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 705120407,
					"content": "う～ん…この文面からすると、ディルックの旦那の知り合いみたいだな。とりあえず、こいつのことは「旦那の友達」って呼ぼう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120408,
					"content": "こいつは、ここでなにか大変なことに気付いたみたいだ。で、ディルックの旦那に伝言を残した後、ここから離れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120409,
					"content": "でも、こいつもそそっかしいやつだな。この紙切れがもし他の誰かに見られたらどうするんだよ。それに、ノートもここに置きっぱなしだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120410,
					"content": "そういえば、浜辺にあった妙な地脈の穢れって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120411,
					"content": "彼が言ってた「異常現象」のことだと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "けど、周りには魔物もいなかったし、おかしなところもなかったぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120413,
					"content": "旦那の友達のノートを読んでみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120414,
					"content": "もし読まなくてもいいなら、直接あそこに行って、近くで見てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
