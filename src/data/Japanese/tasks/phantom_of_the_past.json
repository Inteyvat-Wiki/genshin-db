			},
			"dialogs": [
				{
					"id": 705120501,
					"content": "わぁ！なんで急に魔物たちが現れたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120502,
					"content": "ん？待った…あれって、ディルックの旦那だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120503,
					"content": "でも、いつもと雰囲気が違うみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120504,
					"content": "なんだか勢いがあって、やる気に満ち溢れてる！まさかこれが、「正義の味方」が力を全解放した姿なのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120505,
					"content": "かつて、ここで戦っていた彼の姿だろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "たしかに…よく見ると、今のディルックの旦那より若いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120508,
					"content": "でも、過去になにがあったんだろ？なんでディルックの旦那はここで戦ってたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120509,
					"content": "う～ん、あとで本人に聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120510,
					"content": "で、オイラたちはどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120511,
					"content": "軽率に動かないほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "じゃあ、過去のディルックの旦那の戦いっぷりを見てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705120512,
					"content": "まずは観察しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "地脈が当時の状況を記録し、再現した。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
			]
