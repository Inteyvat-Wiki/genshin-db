			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"ジュリー",
					"パルヴァネ",
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "…何か用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000202,
					"content": "あなたは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "私は亀井宗久、ただの通りすがりの者です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000204,
					"content": "うわぁ…このおじさんの服、まるで「武士」みたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 728000205,
					"content": "ぶ、武士か？まさか幕府のあの「武士」…聞いた話では、幕府は外国人に対して…微妙な態度をとる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 728000206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000207,
					"content": "心配しないでください。私は既に幕府を離れた武士です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000208,
					"content": "食べ物を探しによく来るのですが、今日は魔物がうろついていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000209,
					"content": "しかも周囲の食材は全部かき集められたようなので、全部倒すしかなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000210,
					"content": "よくここに来るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "普段魔物は殆どいません。私はよく果物を採ったり、動物を狩ったりしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000217,
					"content": "話はここまでにしましょう。ここの魔物は倒しましたので、周囲の魔物はしばらくは寄ってこないはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000218,
					"content": "あなたたちも食べ物を探しに来たのであれば、周囲を探してみてください。私は一人分しか採っていないので、まだ残っていると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000219,
					"content": "では、これで失礼します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000220,
					"content": "も、もう行っちゃった。このおじさん、何だか噂で聞いた武士とそっくり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 728000221,
					"content": "だが、幕府を離れたってどういうことだ？幕府を離れた武士は、つまり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 728000222,
					"content": "この前会った敵みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "以前聞いたんだけど、幕府を離れてあちこちを流浪する武士たちがいて、生計のために通りすがりの人から窃盗するの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 728000225,
					"content": "あのおじさんは悪い人じゃないみたいだけど、やっぱり気を付けた方がいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 728000226,
					"content": "まあまあ。俺たちは食材を探しに来たんだ。だが周囲のこの状況だと、やはり危険な目に遭わないために、深入りしないようにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000227,
					"content": "旅人もずっといてくれたから、きっと疲れてる。ここで料理でも作って休んでから、町に帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000228,
					"content": "あのおじさん、周囲に食材があるって言ってたよな？探してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000223,
					"content": "「海乱鬼」みたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "魔物は全部あなたが倒したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "はい。全て普通の魔物なので、倒しやすいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000214,
					"content": "どうして野外で食べ物を探してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 728000216,
					"content": "それは私自身の事情が原因です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "？？？"
				}
			]
		},
		{
