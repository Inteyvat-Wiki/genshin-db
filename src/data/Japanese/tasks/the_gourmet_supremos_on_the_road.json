			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東",
					"ジュリー",
					"パルヴァネ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "新鮮な食材を探したかったんだが…まあいい、これも使えなくはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000302,
					"content": "すまんな、旨いものを作ってあげたかったんだが、今は適当なものしか作れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000303,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "苦労して送ってくれたんだ。「大丈夫」じゃあ済まないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000305,
					"content": "今回の借りは覚えておくよ。次は絶対にいいもんを食べさせてやるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000308,
					"content": "ジュリー、スープはもう出来上がってるはずだろ？パルヴァネには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000309,
					"content": "ああ、やめてよ。じっくりと煮込んでいればいいの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 728000310,
					"content": "大丈夫、私の改良したレシピに従って味付けしてるだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 728000311,
					"content": "その改良したレシピ、私ですら意味が分からないよ。いいからやめて！旭東もパルヴァネを止めて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 728000312,
					"content": "パルヴァネ！おい！また何か変なものを入れてるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000313,
					"content": "変なもの？これは私が研究した特別調味料！論文にも書いた研究成果よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 728000314,
					"content": "要らない！今日は普通の料理が食べたいんだ！ジュリー、彼女を止めろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000315,
					"content": "ふん、見る目がないのね…まあいい、もう少し改良してみるわ。絶対にどんな料理でも入れるだけで美味しくなる万能調味料を作ってみせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 728000316,
					"content": "万能調味料…そんなもの作れるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000317,
					"content": "誰も作っていないからこそ、私が作って見せるの。そうすれば、教令院の頭の固い奴らをびっくりさせられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 728000318,
					"content": "はは…いいぞ、楽しみにしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000319,
					"content": "そうだ、旅人。長い時間付き合ってくれて、ご苦労だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000320,
					"content": "料理を持ち帰れるようにしてやるよ。外で冒険するなら、お腹いっぱいにしておかないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000321,
					"content": "次回会う時は、必ず美味しい料理をご馳走するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 728000306,
					"content": "また今度食べにくる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
					"id": 728000307,
					"content": "ははっ、よし、約束だぞ。最高の料理を作ってやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "旭東"
				}
			]
		}
	]
}