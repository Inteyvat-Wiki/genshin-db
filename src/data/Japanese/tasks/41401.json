			},
			"dialogs": [
				{
					"id": 414010101,
					"content": "おかしいな、この「写真機」どうなってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010102,
					"content": "この「写真機」がどうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "壊れたのか知らないが…どこかおかしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010104,
					"content": "前にフォンテーヌで「写真機」を仕入れてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010105,
					"content": "仕入れ先から、この「写真機」はフォンテーヌの最新技術を使用してると聞いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010106,
					"content": "撮れた写真に特殊な色と効果があるらしい。だから私も1台買って試してみたんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010107,
					"content": "操作に問題があるのか、それともこの「写真機」本体に問題があるのか、どうしても正常な写真が刷り出せない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010108,
					"content": "もしかして、本当に使い方が間違ってるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010109,
					"content": "そうだ、君は「写真機」について詳しいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010110,
					"content": "まあまあ詳しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "よかった、じゃあ少し手伝ってくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010114,
					"content": "その様子を見ると、旅人だね？たくさんの場所を見て、見識も広いはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010115,
					"content": "だからこの「写真機」で、「色」が強烈な物を撮ってきてほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010116,
					"content": "撮れたら、写真を刷り出して私に渡してくれ。この「写真機」のどこに問題があるのか知りたいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010117,
					"content": "もし分からなくても、それらの写真を持って仕入れ先に問い詰めるよ。撮った写真は証拠にもなるはずだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010118,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "じゃあ任せるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414010120,
					"content": "「色」が強烈な物ってなに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "うーん…例えば、色がはっきりとしている物かな…赤い絶雲の唐辛子とか青い霧氷花とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010122,
					"content": "撮れたら、写真を刷り出して渡してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414010112,
					"content": "触ったことない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "そうか…でも大丈夫、操作は簡単だから…少し手伝ってくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "季同"
				}
			]
		}
	]
}