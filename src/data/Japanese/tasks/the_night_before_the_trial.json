			"dialogs": [
				{
					"id": 150200801,
					"content": "あら？チャスカと…旅人、君たちも来てたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150200802,
					"content": "アルパ？あれっ？あいつらが言ってたクク竜はどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150200803,
					"content": "一歩先に飛んでいっちゃったわ。助っ人が来ると知って、撤退したみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150200804,
					"content": "では、クク竜が人間を襲った目的は…商人が輸送する食べ物だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200805,
					"content": "いいえ、荷は食べ物じゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150200806,
					"content": "——ああ、よかった…！「燃素の翼」は無事だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "若い行商人"
				},
				{
					"id": 150200807,
					"content": "…「燃素の翼」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200808,
					"content": "ああ、本当にありがとう。これは俺たちにとって本当に大切な荷物なんだ。万が一のことがあったら、どうすればいいかと思った…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "イシドル"
				},
				{
					"id": 150200809,
					"content": "…君たちがこの前ワルミイが言ってた商人の方々かしら？私たちと提携の相談がしたいという…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150200810,
					"content": "ああ、まさしく！ということは、あなたが族親のアルパさんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "イシドル"
				},
				{
					"id": 150200811,
					"content": "そうよ。長旅でお疲れの中、こんな目に遭ってびっくりしたんじゃないかしら。一緒に花翼の集に戻ってゆっくり休みましょう。ご用事については、また後でゆっくり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150200812,
					"content": "アルパさん、クク竜の襲撃の件は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200813,
					"content": "うーん、この人たちは大けがをしたわけではないし、荷物にも問題はなかった…たまたま何かのショックを受けてクク竜が暴れただけかもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150200814,
					"content": "この辺りはクク竜だらけなんだから、アクシデントの一回や二回、起こってもおかしくないでしょう。これ以上追跡する必要はないと思うわ…それより、飛行試練の会場はどうなったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150200815,
					"content": "整備は大体終わった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "ほう…飛行試練？ちょうど良かった！アルパさん、俺たちが持ってきた「燃素の翼」は、きっと試練であなたを驚かせるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "イシドル"
				},
				{
					"id": 150200818,
					"content": "へえ？…面白そうな話ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150200819,
					"content": "ヒヒッ、じゃあクク竜のことはひとまず置いておくとして…早く戻って「燃素の翼」の件について話そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "イシドル"
				},
				{
					"id": 150200820,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200821,
					"content": "問題は全部解決したみたいだな？拍子抜けなくらい順調だけど…とにかく、オイラたちも行こうぜ…あれ、チャスカ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150200822,
					"content": "何を見てるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200824,
					"content": "血に染まった…羽根？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200825,
					"content": "この騒動は結局うやむやとなり、花翼の集に平和が戻ってきた。\\n穏やかな日々の中で、飛行試練の準備が大々的に進められていた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "すぐに再始動できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
