			"dialogs": [
				{
					"id": 150200401,
					"content": "こんな短時間で片付けるなんて…さすがあんたたちね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150200402,
					"content": "あとは気体燃素が充満するのを待つだけよ。そうすれば、飛行試練も開催できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150200403,
					"content": "その…インカナック、見落としがないか飛んで確めておきたいんだが、手配してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200404,
					"content": "えっ？でも会場はやっと片付いたばかりなのよ。万が一まだ見つかってない危険があったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150200405,
					"content": "だからこそ、私が試しておくべきなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200406,
					"content": "うーん…確かに。あんたの飛行スキルなら、何か見落としがあったとしても、命取りにはならなそうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150200407,
					"content": "この一帯はまだ不安定な環境だ。実際に飛んでみないと、どこに問題があるかわからない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200408,
					"content": "じゃあ、すぐ手配するわ。準備ができたら、いつでも声をかけて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "インカナック"
				}
			]
		},
