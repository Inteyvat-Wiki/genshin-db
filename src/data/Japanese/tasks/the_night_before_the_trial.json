			"dialogs": [
				{
					"id": 150200601,
					"content": "すごかったな！オイラ、まばたきするのも勿体ないって思っちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150200602,
					"content": "他になにか点検することはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200603
					]
				},
				{
					"id": 150200603,
					"content": "うん…特に大きな問題はなさそうだ。あと数日もすれば、みんなに試練を受けてもらえるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200604,
					"content": "た、助けてくれ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "イシドル"
				},
				{
					"id": 150200605,
					"content": "君たち…花翼の集の人だよな？は、早く助けてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "イシドル"
				},
				{
					"id": 150200606,
					"content": "落ち着いて、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200607,
					"content": "クク竜が…急に襲ってきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "イシドル"
				},
				{
					"id": 150200608,
					"content": "俺の仲間と荷物はまだ大通りに…お願いだ、早く助けてやってくれ！",
