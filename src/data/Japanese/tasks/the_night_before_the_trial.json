			},
			"dialogs": [
				{
					"id": 150200101,
					"content": "あれ、チャスカじゃない。アルパさんに言われて来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150200102,
					"content": "ああ、族親はまだ他の用事があるらしい。こっちの状況はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150200103,
					"content": "えっと…調査結果によると——アビスの侵入が何回かあったでしょ？あれのせいで地脈が乱れて、試練会場にいろんな障害物が現れちゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150200104,
					"content": "理論上、障害物さえ排除すれば、気体燃素が再び充満するはずよ。でも実際にやってみると、色々問題が出てきちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150200105,
					"content": "具体的な状況は、下に行けばわかるわ。現場にいるスタッフにも聞いてみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "インカナック"
				}
			]
		},
		{
			"id": 1502002,
