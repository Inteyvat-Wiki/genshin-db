				},
				{
					"id": 150200610,
					"content": "そんなことは普通ないはず…だが、何事にも例外はある。とりあえず行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャスカ"
				}
			]
