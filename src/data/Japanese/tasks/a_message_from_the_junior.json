			"dialogs": [
				{
					"id": 706990101,
					"content": "旅人さんにゲームを試していただけて、本当によかったです。おかげさまで、僕もだいぶ緊張が解けました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706990102,
					"content": "実は、こういう仕事に携わるのは初めてで、うまくできるか不安だったんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706990103,
					"content": "ほぼ完成形の装置に外装をつけるだけなのに、設計やパラメータのあれこれまで気になってしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706990104,
					"content": "もしアルベド長官のようにゼロから装備を作るとなったら、次々と現れる難題にへとへとになっているでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706990105,
					"content": "完成品はなかなかの出来だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "うぅ…ありがとうございます…旅人さんに認めてもらえるなんて嬉しいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706990108,
					"content": "いつか自力で遊撃小隊の役に立つものを作れるように頑張ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706990109,
					"content": "ゲームでぬいぐるみをいくつかもらったので、よろしければどうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706990110,
					"content": "僕とお揃いです。これを見るたび、あなたが掛けてくれた励ましの言葉を思い出すでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ミカ"
				},
				{
					"id": 706990106,
					"content": "自分を信じて。",
