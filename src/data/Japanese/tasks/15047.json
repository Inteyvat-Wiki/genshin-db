			"dialogs": [
				{
					"id": 150470501,
					"content": "イクトミ竜に憑依して戻った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150470502
					]
				},
				{
					"id": 150470502,
					"content": "ムアラニ、ただいま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150470503,
					"content": "！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "わぁ！こんにちは、いい子だね。旅人は一緒じゃないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470505
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470505,
					"content": "えっと、その、旅人はお腹が痛くなって、トイレだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150470506,
					"content": "（なんでまたそんな変なウソを…まあ、バレなきゃいいけど…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470507
					]
				},
				{
					"id": 150470507,
					"content": "プルルル！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "わあ、親切にどーも！蛍光ツノキノコ、食べる？一口どう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470509
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470509,
					"content": "（不思議な味だ。分厚くて旨味があって、意外と美味しい。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470510
					]
				},
				{
					"id": 150470510,
					"content": "プルル！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470511
					]
				},
				{
					"id": 150470511,
