			"dialogs": [
				{
					"id": 150470101,
					"content": "来たんだね！スタッフは急用でどっか行っちゃったみたいだけど、あたしがすでに遊んで…じゃなくて、テストしておいたから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470102,
					"content": "じゃあいろいろ教えてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150470103,
					"content": "えっと、片方が船に乗って、もう片方が竜のスタッフに指示を出すの。二人で力を合わせて、船を無事に目的地まで運ぶんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470104,
					"content": "あたしと旅人なら息ぴったりだし、大船に乗った気持ちで遊んでよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470105,
					"content": "え？泥船じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150470106,
					"content": "ちょっとパイモン、ひどくない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470107,
					"content": "ごめんごめん。順風満帆に行くといいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150470108,
					"content": "ふふん、きっと大丈夫だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470109,
					"content": "実は船に乗ってみたかったんだ。普段はサーフィンばっかしてるから、たまにはこういうのも悪くないよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470110,
					"content": "#{M#俺}{F#私}もウェーブボートには飽きちゃった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "お～！一瞬で役割分担！やっぱ息ぴったりだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470113,
					"content": "プクフグウェアを空気でいっぱいにして、今すぐにでもフェリーに飛び乗りたい気分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470111,
					"content": "#{M#俺}{F#私}が指示を出すよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
