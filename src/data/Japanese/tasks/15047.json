			"dialogs": [
				{
					"id": 150470401,
					"content": "…あ、ここの設備、まだ未完成だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470402
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470402,
					"content": "イクトミ竜のスタッフがいるぞ！手伝ってもらうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150470403,
					"content": "ごめん！これを造ってくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470404,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470405
					],
					"speakerTitle": "イクトミ仔竜"
				},
				{
					"id": 150470405,
					"content": "ここに…置いて…造るの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470406,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470407
					],
					"speakerTitle": "イクトミ仔竜"
				},
				{
					"id": 150470407,
					"content": "ジェスチャーじゃ伝わらないみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150470408,
					"content": "そうだね…どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470409
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470409,
					"content": "待って待って、いいこと思いついた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470410
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470410,
					"content": "「キュー…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470411
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470411,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470412
					],
					"speakerTitle": "イクトミ仔竜"
				},
				{
					"id": 150470412,
					"content": "「キュー…」「キュー…」「キュー…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470413
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470413,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470414
					],
					"speakerTitle": "イクトミ仔竜"
				},
				{
					"id": 150470414,
					"content": "はぁ…ダメ、コホラ竜の鳴き声じゃ分からないみたい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470415
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470415,
					"content": "じゃあ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470416
					]
				},
				{
					"id": 150470416,
					"content": "…そうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470417
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470417,
					"content": "今度は何を思い出したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150470418,
					"content": "イクトミ竜の大好物は蛍光ツノキノコなんだって。イファが言ってたんだけど、ちょうど持ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470419
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470419,
					"content": "今度こそ助かった～！食べてもらえばきっと心が通じ合うよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470420
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470420,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470421
					],
					"speakerTitle": "イクトミ仔竜"
				},
				{
					"id": 150470421,
					"content": "やっぱり遠出するときはいろいろ用意しておくべきだね…カチーナちゃんの言う通りだった。ありがとう、カチ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470422
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470422,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470423
					],
					"speakerTitle": "イクトミ仔竜"
				},
				{
					"id": 150470423,
					"content": "うーん…通じ合ってなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150470424,
					"content": "終わった…ざぶざぶ湾の全てのアトラクションを制覇する夢が、出航初日に撃沈するなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470425
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470425,
					"content": "大英雄の旅人さん～！何かいい方法知らない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470426,
						150470427
					],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470426,
					"content": "知ってはいるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				},
				{
					"id": 150470428,
					"content": "うん、わかった…じゃあお願い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムアラニ"
				},
				{
					"id": 150470427,
					"content": "イクトミ竜をもう一匹呼んでくるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				}
			]
		},
