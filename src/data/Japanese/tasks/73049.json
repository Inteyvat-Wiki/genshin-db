				"points": []
			},
			"dialogs": [
				{
					"id": 730492601,
					"content": "今回は世話になったね。野営地がそんな妙なことに使われていたとは…不届き者のファデュイたちも連行するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492602
					],
					"speakerTitle": "ルコシャ"
				},
				{
					"id": 730492602,
					"content": "はぁ…学者にその機械を調べてもらったんだが、死域に対する影響力は皆無だった。だけど、その機械自体が周囲を汚染するみたいだ。すぐに止めないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492603
					],
					"speakerTitle": "ルコシャ"
				},
				{
					"id": 730492603,
					"content": "森が壊されてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492604
					],
					"speakerTitle": "ルコシャ"
				},
				{
					"id": 730492604,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730492605
					]
				},
				{
					"id": 730492605,
					"content": "うん。でもこれから機械は三十人団が管理するからね、再発は防げるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492606
					],
					"speakerTitle": "ルコシャ"
				},
				{
					"id": 730492606,
					"content": "ただ、所有権の問題で野営地を一括管理するのは難しいかもしれないが…まあ、大した問題じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492607
					],
					"speakerTitle": "ルコシャ"
				},
				{
					"id": 730492607,
					"content": "それと君たちの証言をもとに、カシムの懸賞金を増額したよ…あいつは根っからの大ウソつきだ。まったく頭が痛いよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492608
					],
					"speakerTitle": "ルコシャ"
				},
				{
					"id": 730492608,
					"content": "今回騙されてここにやってきたエルマイト旅団も、ヤツの罠にかかった。あいつは三十人団を避けてエルマイト旅団の元にやってきて、地脈抽出で大儲けしようと持ち掛けたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492609
					],
					"speakerTitle": "ルコシャ"
				},
				{
					"id": 730492609,
					"content": "まあいい。あいつはまた今度会ったときに片づければいいからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492610
					],
					"speakerTitle": "ルコシャ"
				},
				{
					"id": 730492610,
					"content": "さあ、ファデュイ摘発の報酬を受け取ってくれ！今回は本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492611
					],
					"speakerTitle": "ルコシャ"
				},
				{
					"id": 730492611,
					"content": "ルコシャは立ち去った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
