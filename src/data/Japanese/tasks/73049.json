			},
			"dialogs": [
				{
					"id": 730492701,
					"content": "いや、ここまで来たらさすがに嘘はつかないさ…最近ずっと偽の実験レポートを渡してたから、あいつらも少し疑ってたみたいだしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492702
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492702,
					"content": "拠点の場所は教える。ちゃんと捕まえてくれよ。そしたらオレの嘘もバレずにすむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492703
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492703,
					"content": "うわっ、なんて悪知恵の働くヤツ。ファデュイもこいつと組んだのが運の尽きだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730492704,
					"content": "でも、とにかくこいつの話を聞こう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730492705
					]
				},
				{
					"id": 730492705,
					"content": "アパーム叢林にあるテントの近くに、四つの松明がある。夜、それに火をつけると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492706
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492706,
					"content": "ファデュイが信号灯で山の上の野営地を照らす。近くの断崖できらっと光るところを見つけたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492707
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492707,
					"content": "そこがファデュイの活動拠点なのか！なんだかやたら謎めいてるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730492708,
					"content": "ああ。現地ではファデュイが扉越しに合言葉を確かめてくる。合言葉が合っていれば、中に入れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492709
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492709,
					"content": "合言葉まであるのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730492710,
					"content": "そうなんだ。えっと上の句は確か、「己のルールブックを持って…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492711
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492711,
					"content": "下の句は「他人の縄張りに行くな」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492712
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492712,
					"content": "へえ、ファデュイがその暗号通りに行動してくれたら文句ないのにな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730492713,
					"content": "じゃあ、テストするぞ。「己のルールブックを持って…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492714
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492714,
					"content": "「他人の縄張りに行くな」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730492715
					]
				},
				{
					"id": 730492715,
					"content": "よし、行け！目的がなんであろうと、奴らのことは一網打尽にしてやらないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492716
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492716,
					"content": "へへっ、中々役に立つ情報だろ？…できれば今回は見逃してもらえるとありがたいなぁ…なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492717
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730492717,
					"content": "ふんっ、もう二度と悪事は働くなよ。次に悪さしてるとこを見たら…三十人団に突き出すからな！",
					"roleType": "TALK_ROLE_NPC",
