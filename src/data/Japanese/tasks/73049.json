				"points": []
			},
			"dialogs": [
				{
					"id": 730492501,
					"content": "これだけ人数がいて…また敗北を喫するとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492502
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730492502,
					"content": "しかし実験さえうまくいけば、私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492503
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730492503,
					"content": "残念だったな。カシムのサギなんとかって機械じゃ、死域のエネルギーは吸えないらしいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730492504,
					"content": "つまり、おまえはハナから騙されてたってこと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730492505,
					"content": "そんなまさか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492506
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730492506,
					"content": "三十人団のとこで大人しく懺悔するんだな。もう二度とスメールには来るなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730492507,
					"content": "三十人団の伝令官であるルコシャに報告をした。\\nそして、ファデュイはルコシャの部下によって連行された。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7304926,
			"completionStepIds": [
				7304926
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7304926",
