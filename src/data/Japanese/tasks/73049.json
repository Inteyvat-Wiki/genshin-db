			"dialogs": [
				{
					"id": 730492201,
					"content": "えっ、そんなの知ら…コホンッ、合言葉は「己のルールブックを持って…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492202
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730492202,
					"content": "「他人の縄張りに行くな」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730492203
					]
				},
				{
					"id": 730492203,
					"content": "ふんっ、入れ。お前らは…ああ、応援に来た新人だな。遅かったじゃないか。",
					"roleType": "TALK_ROLE_NPC",
