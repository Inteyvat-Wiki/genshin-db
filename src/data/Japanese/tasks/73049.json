			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"オレグ",
					"カシム",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730490317,
					"content": "#しーっ、{NICKNAME}。あそこ！エルマイト旅団と…ファデュイだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490301
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730490301,
					"content": "カシム…サギラレーザーの運転状況は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490302
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730490302,
					"content": "良好だ、オレグ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490303
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730490303,
					"content": "これが今回の結果レポートだ。順調に行けば…あんたらファデュイの求めているものは、じきに手に入る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490304
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730490304,
					"content": "了解。ハハッ、お前のおかげで、最速で執行官様のご命令を遂行できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490305
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730490305,
					"content": "だが、我々を騙せば…どうなるか分かってるだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490306
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730490306,
					"content": "あんたを騙して、オレに何の得がある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490307
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730490307,
					"content": "分かっているならそれでいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490308
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730490308,
					"content": "ところで、トロフィン·スネージヴィッチだが…力不足ではないか？何年もここにいるが、まったく功績がない。それに比べ、私は瞬く間に成果を挙げた。もし奴がまだ言い訳をするようなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490309
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730490309,
					"content": "トロフィン·スネージヴィッチ…スメールでこの名前は聞いたことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490310
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730490310,
					"content": "ハハハ、当然だろう。そんな名前を使えば、自ら正体をバラすようなものだ…執行官様が与えた任務なのだが、何年経っても進展がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490311
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730490311,
					"content": "…ん？そ、そこにいるのは誰だ？…お前、どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490312
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730490312,
					"content": "#うわっ、{NICKNAME}。見つかっちゃったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730490313,
					"content": "…オレ、そろそろ行かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490314
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730490314,
					"content": "いやぁ、まさかファデュイが、迷い込んだしがない冒険者にやられたりしないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490315
					],
					"speakerTitle": "カシム"
				},
				{
					"id": 730490315,
					"content": "エルマイト旅団に心配される筋合いはない…ふっ、私はこの乱入者を倒してから実験用の野営地へ向かう。そこで落ち合おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490316
					],
					"speakerTitle": "オレグ"
				},
				{
					"id": 730490316,
					"content": "カシムが去って行った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
