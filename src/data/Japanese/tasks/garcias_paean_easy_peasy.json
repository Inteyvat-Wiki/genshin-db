			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガルシア",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "ううっ！手が…痺れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160102,
					"content": "先生、この後ジャーヤさんの帳簿を管理しに行かなければならないんですから、あまり無理しないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230160103,
					"content": "わ、分かってる！わざわざ言わんでもいい、路通くん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160104,
					"content": "もちろん、先生が無理なら、僕が替わりに行ってもいいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230160105,
					"content": "ダメだ！自分で行く。あといくつか…歯車を打ち出したら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160106,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160107,
					"content": "よし、もうダメだ、もうこれ以上は叩けない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160108,
					"content": "今度は何をやってるの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "君か、旅人くん…いや…俺の手がな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160110,
					"content": "この通り、ひどい有様なんだ。なぜかと言えば、アハンガルさんは他に仕事があって、俺の要求する部品ばかり作るわけにもいかなくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160111,
					"content": "それに彼が作った部品はいつも、俺が望むものとは少し違うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160112,
					"content": "だから部品を信頼に足るものにするには、もはやアハンガルさんに鋳造法を教わり、自らの手で作るほかないと思ったわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160113,
					"content": "フォンテーヌにいた時、似たような仕事の経験はあるのだが…アハンガルさんの言うやり方が、ちょっと覚えきれなくてな…やれやれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160114,
					"content": "旅人くん…代わりに、アハンガルさんにもう一度やり方を聞いてきてくれないか？そろそろ本当に休まないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160115,
					"content": "ここで休んでて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "君の協力に感謝する。あたた…手が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160116,
					"content": "ジャーヤって誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "ビジネスパートナーだ！一介の…あー…才能に溢れ、ついでに金も…溢れるほど持っている。そう、ビジネスパートナーなのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160118,
					"content": "我々の間には、帳簿管理に関する長期契約が結ばれている！だから俺は、彼女のところに足しげく通っているのだ。そうだね、路通くん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230160119,
					"content": "おっしゃる通りです、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230160120,
					"content": "と、とにかくそう言うことだ…旅人くん、早くアハンガルさんのところへ行ってくれ。俺はここで待っているから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガルシア"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
