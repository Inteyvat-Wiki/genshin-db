				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アハンガル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "待ってろって言っただろ…ん？どうしてお前が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160202,
					"content": "先生の代理で教えを請いに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "本当に自分でやってたのか…変わったやつだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160205,
					"content": "俺も長年鉄を打ってきたが、あんなに細かい注文をするやつは見たことがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160206,
					"content": "あいつは、わざわざ物差しで鉄パイプの継ぎ目の太さを測るんだ。ネジの切り込みの間隔もな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160207,
					"content": "うんざりして、そんなに気になるなら自分でやれと言ったんだが…次の日、本当に鋳造のやり方を聞きに来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160208,
					"content": "俺はもう観念して、あいつの言う通りにしてやった。材料費さえ自分で出すなら、工具なんかは自由に使わせてやったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160209,
					"content": "はあ…あいつは本当に何がしたいんだか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160210,
					"content": "偉大な機械を作ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "いいさ…どうせ変なもんだろう。お前ら、鋳造のやり方を聞きに来たんだろ？歯車については、もう教えることはないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160213,
					"content": "あいつの欲しがってる歯車が、縁が鋭利で、真ん中がへこんでるやつだというのは知っているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160214,
					"content": "そういう変則的な形の歯車は、金型だけで作るのは難しい。どうしても二次加工が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160215,
					"content": "具体的なやり方は前に教えてあるが、帰ってあいつに伝えてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160216,
					"content": "まず再度炉に入れる時は、<color=#00E1FFFF>燃料を多めに加えること</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160217,
					"content": "そして取り出して加工する時は、<color=#00E1FFFF>内から外へ叩くこと</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160218,
					"content": "どうだ、覚えたか？覚えたなら、戻ってあいつに伝えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160219,
					"content": "本当におかしなやつだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アハンガル"
				},
				{
					"id": 230160211,
					"content": "不思議な機械を作ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "先生なら手が痺れて休んでる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
