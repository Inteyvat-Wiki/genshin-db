			"dialogs": [
				{
					"id": 230165001,
					"content": "先生、私見ですが…僕たちは考え方を変えるべきかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165002
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230165002,
					"content": "考え方を変える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165003
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230165003,
					"content": "例えば、あまり複雑ではなく、それでいて十分優れた機械を作ってみる…といったことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230165004,
					"content": "あなたの才能をもってすれば、必ずやそのような機械が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230165005,
					"content": "親愛なる路通くん、その問題についてはもう議論が終わっている。君は俺の答えを知っているはずだ…しかし、俺は常に君の選択を尊重しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230165006,
					"content": "では、今度ジャーヤさんと夕食を取る場所について議論しましょう、先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230165007,
					"content": "ありがとう、路通くん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230165008,
					"content": "先生、お気になさらず。我々の交わした契約は、まだ終わっていませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
