			"dialogs": [
				{
					"id": 230163901,
					"content": "ガルシアは作業を始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230163902
					]
				},
				{
					"id": 230163902,
					"content": "おおっ！成功だ！この歯車はいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230163903,
					"content": "歯の間隔は…厚みはどうだ…サイズも…ええい、物差しで測らなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "ガルシア"
				},
				{
					"id": 230163904,
					"content": "さて、ガルシア先生を計測に集中させてあげましょう。旅人さん、こちらが報酬です。お受け取りください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230163905,
					"content": "まだ悲観的な見通しを持ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "ええ、それについては変わりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230163907,
					"content": "僕とガルシア先生は、大きな山の前をさまよっています。今は山のふもとに小さな石を運んだだけにすぎません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230163908,
					"content": "事実上、我々はまだ山に入る道すら見つけていないのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230163909,
					"content": "ガルシア先生の才能が、我々を正しい道に導いてくれることを祈ります…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230163910,
					"content": "僕にはひたすら、「山へ向かう車の前には、必ず道が開く」と唱えるほかありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "路通"
				}
			]
		},
