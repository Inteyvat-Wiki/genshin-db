						"position": [
							-306.286,
							274.946,
							2159.712
						],
						"pointId": 330201530
					}
				]
			},
			"dialogs": [
				{
					"id": 735300101,
					"content": "ハハッ、はぁ…ハハハ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300102
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300102,
					"content": "#{NICKNAME}、見ろよ、この泣いたり笑ったりしてるやつ…ん？どこかで見たことあるような…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300103,
					"content": "あっ！久しぶりだね。僕のことは覚えているかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300104,
						735300106
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300104,
					"content": "#{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300105
					]
				},
				{
					"id": 735300105,
					"content": "僕だよ、僕！生論派の学者ジャミ、「フェーイズポーション」を作ったジャミだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300108,
					"content": "ああ、ちょっと思い出してきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300109,
					"content": "どうだ、最近研究は順調か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300110,
					"content": "ハハッ…それはだね…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300111
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300111,
					"content": "あまり順調じゃないみたいだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300112
					]
				},
				{
					"id": 735300112,
					"content": "いやいや、皆さんのおかげで、この前のフェーイズポーションに関する研究はかなりいい成果を収めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300113
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300113,
					"content": "昔は指導教員の期待に応えられないんじゃないかって、ずっとビクビクしていたけど、まさか僕の研究を見てあんなに褒めてくれるとはね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300114
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300114,
					"content": "「ジャミ、よくやった！さすがは私の最も誇れる学生だ！」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300115
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300115,
					"content": "いいことじゃないか？よかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300116,
					"content": "ここまでだったら、確かにいい話だ…はぁ、その後に起きたことが、僕にとっては間違いなく悪夢なんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300117
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300117,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300118
					]
				},
				{
					"id": 735300118,
					"content": "前回のデータがあまりにも理想的だったのか、指導教員——あの笑うと顔がシワまみれになるジイさんが、なんと「自分で試してみたい」って言い始めたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300119
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300119,
					"content": "それで、実験場所をもう一回用意して、丹精込めて一番効果のあるフェーイズポーションを作ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300120
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300120,
					"content": "作ったら…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300121,
					"content": "そしたら、なんというか…数え切れないほどの学生が見ている中、魔物の前で堂々とフェーイズポーションを飲み——そして、魔物にすぐコテンパンにやられたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300122
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300122,
					"content": "幸い、あの人は無事だった。しばらくベッドで休んでいればいいとのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300123
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300123,
					"content": "ぷっ、あっはっはっはっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300124,
					"content": "ハハハ…コホンッ。なにはともあれ、僕の出来が悪いせいで、指導教員の顔に泥を塗ってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300125
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300125,
					"content": "その後、あの性格の悪いジイさんが、「お客さんのニーズを考慮していない」だとか「実際の場面に適用できてない」だとか言って、僕をこっぴどく叱ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300126
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300126,
					"content": "そんなの理不尽だろ。そいつ自身のせいでもあるのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300127,
					"content": "僕もそう思うよ。だから二人にお願いだ、どうか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300128,
						735300129
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300128,
					"content": "そいつを懲らしめる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300130,
					"content": "ちがうちがう！そんな恐ろしいこと考えてないよ、少なくとも今はない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300131
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300131,
					"content": "へへっ、てことは「昔は」あったんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300132,
					"content": "うっ…少しだけ…まぁ、それは重要ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300133
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300133,
					"content": "僕が言いたいのは、この前の実験を振り返って、「長時間持続フェーイズポーション」というのを新しく作ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300134
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300134,
					"content": "長時間持続フェーイズポーション？なんだそれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300135,
					"content": "指導教員が襲われたときの反応を思い返して、こんな問題点に気がついたんだ——僕たち一般人が危機的状況に陥った時、頭は真っ白になって、身体は硬直するし、どうしたらいいのか分からなくなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300136
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300136,
					"content": "危険に遭遇してから、フェーイズポーションを探して飲んでいたら、その効果が出てくるまで待てないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300137
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300137,
					"content": "でも長時間持続フェーイズポーションは違う。一度飲めば、危険に遭遇するたびに勝手に効果が出るんだ。だから、一般人でも反応するまでの時間をもっと稼げるようになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300138
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300138,
					"content": "「危険に遭遇」したかはどう判断するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300139
					]
				},
				{
					"id": 735300139,
					"content": "僕がさっき言ったことを覚えてるかな？一般人は危機的状況に陥ると、身体が硬直する。つまり、長時間持続フェーイズポーションを飲んでも、被験者が普通に行動している限り、効果は発揮されない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300140
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300140,
					"content": "でも動きを止めて、その場で固まっていると、長時間持続フェーイズポーションは効果を発揮するようになる。時間の流れが遅くなったように感じるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300141
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300141,
					"content": "なるほど、だいたいわかったぞ。つまり…実験が完了するよう、オイラたちに手伝ってもらいたいってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300142,
					"content": "ああ、そうだ。長時間持続フェーイズポーションは一般人のために開発したものとはいえ、実験にはリスクも伴う。まずは戦闘経験のある人に手伝ってもらおうと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300143
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300143,
					"content": "うーん、どうしようかな。手伝うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300144,
					"content": "#急に腹が減ってきたぞ。ランバド酒場でたらふく食べたい気分だぜ…{NICKNAME}、オイラたちのモラはまだ足りそうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300145,
						735300146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300145,
					"content": "残念ながら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300147,
					"content": "コホン。実は、指導教員にこっぴどく怒られたとはいえ、その後かなりの額の実験経費が下りた。だから、君たち二人を大金で雇おうと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300148
					],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300148,
					"content": "そういうことなら、オイラたちが力を貸すぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735300149,
					"content": "本当にありがとう！あぁ…お二人はまさに救世主だ！どうかバラバラに砕けてしまった僕の学術界での名誉を挽回してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャミ"
				},
				{
					"id": 735300146,
					"content": "今月は既に赤字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300129,
					"content": "そいつを買収する？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300106,
					"content": "ずっとため息をついてた人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300107
					]
				},
				{
					"id": 735300107,
					"content": "まだあの「あだ名」を覚えていたんだね。そう、僕だよ…指導教員の期待を裏切り、ずっとため息ばかりついている生論派学者。今さら名乗るのは恥ずかしいけど、ジャミだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "ジャミ"
				}
			]
		}
	]
}