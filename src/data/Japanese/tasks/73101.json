			"dialogs": [
				{
					"id": 731010101,
					"content": "#あっ、ナラ{NICKNAME}。どう？夢の中で「カクカク大鉄塊」と戦ってみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010102
					],
					"speakerTitle": "アランダシャン"
				},
				{
					"id": 731010102,
					"content": "「カクカク大鉄塊」に掛けたアランラカラリの制限を一層ずつ解いていって、最後には、アランラカラリの制限がない状態の「カクカク大鉄塊」と戦うんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010103
					],
					"speakerTitle": "アランダシャン"
				},
				{
					"id": 731010103,
					"content": "だからアランダシャンは今回、「カクカク大鉄塊」に制限をかけない。でも大丈夫！アランサタ、アランユタとアランサハが手伝ってあげるから。試してみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランダシャン"
				}
			]
		},
