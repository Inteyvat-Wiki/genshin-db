			"dialogs": [
				{
					"id": 220070101,
					"content": "一体どこにあるのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220070102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "実はね…ある遺跡で考察してたら、急に怪物に襲われて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220070104,
					"content": "慌てて逃げたら、掘り出したばかりの文物をその場に忘れたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220070105,
					"content": "怪物たちが離れた後、こっそり戻ったけど、文物がなくなったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220070106,
					"content": "その周りをいくら探しても見つからなくて、怪物に取られたかもしれないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220070107,
					"content": "探してきてくれないかしら？見つけたら、この箱に入れて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝児"
				}
			]
		},
