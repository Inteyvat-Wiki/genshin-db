					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "よく見て、服を何重も重ねてあるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220070204,
					"content": "私はプロの学者だから、そういう素人みたいなミスはしないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220070205,
					"content": "さあ、文物のことはお願いね、私は怪物の相手なんてできっこないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝児"
				}
			]
