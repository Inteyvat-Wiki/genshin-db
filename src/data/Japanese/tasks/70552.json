				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エウルア"
				],
				"points": [
					{
						"sceneId": 51207,
						"position": [
							2191.087,
							230.089,
							-781.388
						],
						"pointId": 1
					},
					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520101,
					"content": "え？今は君がドリンクスポットの担当なのね…知っていたら、午前中に来ていたのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520102,
						705520103
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520102,
					"content": "応援ありがとう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520104
					]
				},
				{
					"id": 705520104,
					"content": "正直、気になってきたわ——君はドリンク作りに関して、かなりの才能があると聞いていたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520105
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520105,
					"content": "グランフィディアが準備した材料で、一体どんなドリンクを作るのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520106,
						705520107
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520106,
					"content": "そういえば、なんだか忙しそうだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520108
					]
				},
				{
					"id": 705520108,
					"content": "仕方ないわ。重要なことが立て続けにあったから…まず、騎士団では年に一度、全員が戦闘技術の試験を受けるんだけど、今回から基準がかなり引き上げられたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520109
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520109,
					"content": "遊撃小隊の隊長として、私が率先して手本を示さないといけないでしょ？少なくとも、隊長クラスの模擬戦で上位3位以内には入らないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520110
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520110,
					"content": "それで最近は、ずっと訓練を重ねているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520111,
						705520112
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520111,
					"content": "「エウルア隊長」はそういう感じなんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520113
					]
				},
				{
					"id": 705520113,
					"content": "ふんっ、罪人の末裔がそう簡単にこの地位を守れるはずないでしょ？私は一度だって職務を怠ったことはないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520114
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520114,
					"content": "それから、騎士たちの戦闘経験を増やすために、総務の人達がフォンテーヌ廷の有名な決闘代理人を招いて、剣術の交流会を開いたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520115
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520115,
					"content": "私は出勤率の高い隊長たちの中でも両手剣の腕前が良いほうだから、その代表に選ばれてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520116
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520116,
					"content": "しっかり準備をして、決闘代理人との真剣勝負に挑まないといけないの。それと、報告書を最低でも六通は書く必要がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520117
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520117,
					"content": "クロリンデとの手合わせには、かなりのエネルギーを費やしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520118
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520118,
					"content": "レイピアと銃の二重攻撃に対してどう反撃するか、どうやって主導権を奪うか…今でもその細かい部分を思い返している…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520119
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520119,
					"content": "でも結果は上々よ。今回の剣術交流会は、双方にとって実りの多いものになった。6通どころか、24通だって異なる視点で報告書を書けるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520120,
						705520121
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520120,
					"content": "強いのを出そうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520122
					]
				},
				{
					"id": 705520122,
					"content": "そうね、元気が出れば何でもいいわ。好きなものを作って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520123
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520123,
					"content": "（エウルアの今の状態を考えると、「星月のきらめき」を作るのが一番いいかもしれない。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705520121,
					"content": "エネルギー補給が必要みたいだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520122
					]
				},
				{
					"id": 705520112,
					"content": "隊長としての一面を知るのは初めて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520113
					]
				},
				{
					"id": 705520107,
					"content": "最近、仕事を頑張ってるみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520108
					]
				},
				{
					"id": 705520103,
					"content": "いつでも歓迎するよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520104
					]
				}
			]
		},
		{
			"id": 7055202,
