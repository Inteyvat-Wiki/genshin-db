					}
				]
			},
			"dialogs": [
				{
					"id": 705520301,
					"content": "エウルアの好みに合わせた新しいドリンク「波花の剣舞曲」完成！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520302
					]
				},
				{
					"id": 705520302,
					"content": "あら、とても綺麗な色合いね！さっき話題に出た、ロマリタイムフラワーの果汁ジュースも入れたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520303
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520303,
					"content": "香りもすごく良いわ。お酒の刺激と、果実の香りが絶妙なバランスで…ちょっと味わわせてもらうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520304
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520304,
					"content": "詳細の分析、待ってるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520305
					]
				},
				{
					"id": 705520305,
					"content": "ふぅ…はぁ…待って、褒め言葉を考えさせて。ちゃんと考えないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520306
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520306,
					"content": "淑女らしくないし、ワインの味わい方としても、ゆっくり飲むべきなんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520307
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520307,
					"content": "でも…口当たりがあまりにも良すぎる…失礼するわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520308
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520308,
					"content": "もう一杯いただけるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520309,
						705520310
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520309,
					"content": "もちろん！好きなだけ飲んで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520311
					]
				},
				{
