						],
						"pointId": 1
					},
					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520201,
					"content": "エウルア隊長のための特製ドリンク「星月のきらめき」完成！どうぞ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520202
					]
				},
				{
					"id": 705520202,
					"content": "ふふん、ずいぶん自信満々の口ぶりね？それじゃあ、しっかり味わわせてもらうわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520203
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520203,
					"content": "ん？なかなかいいじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520204
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520204,
					"content": "甘くて、刺激的で…弾ける感じがたまらないわ。ソーダが最高のアクセントになっている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520205
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520205,
					"content": "体の中から元気が湧いてくるわ。一杯じゃ物足りないわね…もっと強いのを頼んでもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520206,
						705520207
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520206,
					"content": "これじゃ物足りない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520208
					]
				},
				{
					"id": 705520208,
					"content": "あははっ、遠慮なんていらないわ！私がそんな、お酒に弱いように見える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520209,
						705520210
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520209,
					"content": "話をしながら考えてみよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520211
					]
				},
				{
					"id": 705520211,
					"content": "いいわよ。今夜は第1小隊から書類仕事も任されていないし、ゆっくり昔話でもしながら、新しいレシピを考えてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520212
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520212,
					"content": "しばらく会ってなかったけど、ずっと雪山の近くで任務についてたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520213
					]
				},
				{
					"id": 705520213,
					"content": "そうね、ちょっと前まで面倒な状況になっていて…エンジニアの盗賊団が、機械の制御装置を弄り回して遺跡重機を乗っ取り、キャラバンを襲おうと企んでいたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520214
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520214,
					"content": "そのうえ、ドーンマンポートに常駐している老騎士が、何人か私の小隊に配属されてきて…彼女たちは「ローレンス家の小娘」である私が気に入らなかったみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520215
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520215,
					"content": "彼女たちと任務に向かうのは大変だったわ。雪原に潜伏していた3週間は、火を起こして暖を取ることもできなかった。それでも、やっとの思いで相手の拠点を見つけたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520216
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520216,
					"content": "老騎士たちは寒さで散々苦しみ、盗賊団が密輸した戦闘機械にやられそうになっていたわ…でも幸い、最後はすべて丸く収まって、彼女たちも私を認めてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520217,
						705520218
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520217,
					"content": "大変だったんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520219
					]
				},
				{
					"id": 705520219,
					"content": "私？私なら全然平気よ…気遣ってくれてありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520220
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520220,
					"content": "あの時は確かに心が疲弊したけど、その任務で彼女たちも散々苦労したから、もう私のことを疑うことはないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520221
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520221,
					"content": "今後また私に文句をつけてくる新人がいたら、あの先輩たちに指導を任せればいいわね。一挙解決ってところかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520222
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520222,
					"content": "そういえば、エウルアが持ってきたこのボトルは…輸入したジュース？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520223
					]
				},
				{
					"id": 705520223,
					"content": "ああ、忘れていたわ。商人は「ロマリタイムフラワーの濃縮果汁」って言ってた…独特な香りがするのよ。君にも1本あげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520224,
						705520225
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520224,
					"content": "最近よくこれを飲んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520226
					]
				},
				{
					"id": 705520226,
					"content": "ああ…これは必要な礼儀作法なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520227
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520227,
					"content": "メギストスさんが貸してくれた本…『ブレードダンサーの二十年後』には、こう書いてある——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520228
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520228,
					"content": "「フォンテーヌの剣士たちは、剣術の腕を競い合った後、勝者が敗者にご馳走をする。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520229
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520229,
					"content": "クロリンデを丁重にもてなすために、ずいぶん探し回ってやっと、ドーンマンポートで珍しい品を扱う商人から、この貴重な品を手に入れたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520230
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520230,
					"content": "小説みたいな話だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520231
					]
				},
				{
					"id": 705520231,
					"content": "そうね…私も最初はそう思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520232
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520232,
					"content": "でも、アンバーが言っていたの。現実のフォンテーヌにそういう習慣があるかは別として、フォンテーヌの文化作品をちゃんと理解しようとした証にはなるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520233
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520233,
					"content": "それに、新しい美食が嫌いな人はいないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520234
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520234,
					"content": "剣術交流会の後、食事会でクロリンデにこれを振る舞うつもり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520235
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520235,
					"content": "剣術交流会の後、食事会でクロリンデにこの果汁ジュースを出したんだけど、気に入ってくれたわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520236
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520236,
					"content": "もうすぐ試合だけど、エウルアはどんな気持ち？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520237
					]
				},
				{
					"id": 705520237,
					"content": "あぁ…正直に言うと、ワクワクが止まらないわ…でも、少し緊張もしているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520238
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520238,
					"content": "前回の試合で、エウルアはどんな気持ちだったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520239
					]
				},
				{
					"id": 705520239,
					"content": "あぁ…正直に言うと、クロリンデと手合わせする前は、ワクワクしていて…少し緊張もしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520240
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520240,
					"content": "クロリンデの戦闘スタイルは、謎に満ちた「ファントムハンター」のもの…図書館にある百年以上前のフォンテーヌの新聞にも、その組織の強さについて書かれていたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520241
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520241,
					"content": "数年前の新聞には、クロリンデが海底王国の遺児で、戦闘の前に儀式を行い、剣に魂を宿らせるとまで書かれていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520242
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520242,
					"content": "あとの話は知らないけど、まずは噂を全部事実だと思って…いや、むしろクロリンデの実力はそれ以上だと考えて、万全の心構えで挑むわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520243
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520243,
					"content": "報道の続きは分からないけど、私個人の感覚で言うと、クロリンデの実力はまさにそういった描写通りだと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520244,
						705520245
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520244,
					"content": "歴史に残る勝負だし特製ドリンクがないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520246
					]
				},
				{
					"id": 705520246,
					"content": "ドリンクに「剣術」の要素を取り入れるの？君も面白いことを思いつくわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520247
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520247,
					"content": "確かに気分を盛り上げる必要はあるけど…どうやってドリンクでそれを表現するつもり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520248
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520248,
					"content": "でも、そういう記念の特製ドリンクを一杯もらうのも悪くないわね…君はどうやってドリンクでそれを表現するつもり？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520249
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520249,
					"content": "#{M#俺}{F#私}が見てきた限り…レイピアを使うフォンテーヌの剣士は、突きを得意とする人が多くて、精密な攻撃を…持続的に仕掛けることに長けてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520250
					]
				},
				{
					"id": 705520250,
					"content": "うん…本に書いてある通りね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520251
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520251,
					"content": "ドリンクに例えるなら、コーヒーとか、バブルオレンジ酒…あるいはモンドの果実酒みたいな感じかな。飲んだ時はそれほど刺激的じゃないけど、後味が長く続く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520252
					]
				},
				{
					"id": 705520252,
					"content": "今、この特製ドリンクのベースには、果実酒を使ってるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520253
					]
				},
				{
					"id": 705520253,
					"content": "確かにそうね…さすが玄人、テイワットでこんな比喩を思いつく人、他にいないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520254
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520254,
					"content": "#でもエウルアの剣術は違う。{M#君}{F#あなた}は両手剣のリードダンサーのように、大きな剣身を導き、回転させ、踊らせ、豪快に振るう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520255
					]
				},
				{
					"id": 705520255,
					"content": "一度斬りつければ、雪崩のような破壊力を発揮できる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520256
					]
				},
				{
					"id": 705520256,
					"content": "衝撃を与えた瞬間が重要なのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520257
					]
				},
				{
					"id": 705520257,
					"content": "い、いえ…そんな芸術的な言い方はしなくていいわ！旧貴族流の西風剣術のバリエーションに、私なりのアレンジを加えただけよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520258
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520258,
					"content": "だから、エウルアの剣術は…口に含んだ瞬間、一撃必殺の強烈な衝撃があって…氷のように、余計な後味を残さない強い酒に似てる——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520259
					]
				},
				{
					"id": 705520259,
					"content": "炎{RUBY#[D]プラーミアヴァダー}水ね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520260
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520260,
					"content": "ここ数年、スネージナヤの商人たちが繁栄するにつれて、炎水は各地で人気を集め始めた。ほとんどの酒場で、これをベースにした商品が置かれているわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520261
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520261,
					"content": "一緒にベストアンサーを見つけたね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520262
					]
				},
				{
					"id": 705520262,
					"content": "さすが君ね！じゃあ、試してみましょう。ベースの果実酒を炎水に変えてみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520263
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520263,
					"content": "度数は…問題ないわ！遠征隊の仲間たちは炎水でダウンしてしまったけど、私は…大丈夫な自信があるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520264
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520264,
					"content": "忙しい時は、いつも何を食べてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520265
					]
				},
				{
					"id": 705520265,
					"content": "最近の食事？それなら、後方支援部隊の新しい成果について話さないとね——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520266
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520266,
					"content": "彼らが「騎士の食事改善計画」を立ち上げてね。私たち野外作戦部隊向けに、専用の缶詰を支給し始めたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520267
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520267,
					"content": "以前は乾物しか手に入らなかったから、食事の時だけ鍋と焚火を用意して、サイコロを振って料理当番を決めていたの。他の騎士たちは交代で見張りに立って…ちょっと面倒だったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520268
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520268,
					"content": "今は缶詰を五つと、紙で包まれた「標準戦地配給」を九つ持っていくだけ。それを焚火のそばで温めるだけで、食事の準備ができるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520269,
						705520270
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520269,
					"content": "聞いた感じ、便利そうだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520271
					]
				},
				{
					"id": 705520271,
					"content": "ふふっ、「聞いた感じ」ね？缶詰の提供元は評判が良くて、普通の缶詰なら確かに美味しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520272
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520272,
					"content": "問題は…私たちに支給される軍用缶詰が保存基準を満たすために、しょっぱすぎるってことよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520273
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520273,
					"content": "第五小隊の酷い冗談が好きな副隊長は「この缶詰を開けたら、璃月の竈神様が攻めてくる」って評価していたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520274
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520274,
					"content": "とにかく、一週間その新しい缶詰を食べ続けて、私の味覚は完全に麻痺してしまったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520275,
						705520276
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520275,
					"content": "そんな恐ろしい缶詰なの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520277
					]
				},
				{
					"id": 705520277,
					"content": "後方支援部隊のせいじゃないわ。全員の好みに合わせるのは難しいもの。フィードバックは既に提出したから、缶詰の問題点はすぐに改善されるはずよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520278
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520278,
					"content": "もちろん、拠点で小隊専属の料理人が作る出来立ての料理を食べるのが一番だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520279
					],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520279,
					"content": "うん、エウルアの話を聞いてて、二杯目の特製ドリンクのレシピをひらめいた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520280
					]
				},
				{
					"id": 705520280,
					"content": "いいわね。それじゃあ、今度はどんなひらめきを得たのか、見せてもらおうかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エウルア"
				},
				{
					"id": 705520276,
					"content": "責任は誰が取るべきなんだろう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520277
					]
				},
				{
					"id": 705520270,
					"content": "聞いた感じ、悪くなさそうだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520271
					]
				},
				{
					"id": 705520245,
					"content": "剣術テーマの特製ドリンクで記念する？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520246
					]
				},
				{
					"id": 705520225,
					"content": "どうして持ち歩いてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520226
					]
				},
				{
					"id": 705520218,
					"content": "風邪ひいてない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520219
					]
				},
				{
					"id": 705520210,
					"content": "強いお酒以外にも材料が必要かも！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520211
					]
				},
				{
					"id": 705520207,
					"content": "もっと強いお酒を入れる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520208
					]
				}
			]
		},
		{
			"id": 7055203,
