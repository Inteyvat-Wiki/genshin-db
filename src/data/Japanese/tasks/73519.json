					"ヴィナヤック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735190101,
					"content": "本当によく分からないな…カフェで報告レポートを書こうと言い出したのはあいつなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190102,
					"content": "どうして一人なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "はぁ、あいつなら、一人でレポートを書きに行ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190105,
					"content": "昨日、僕たちはカフェで落ち合うはずだったんだけど、シュリヤのやつ、すごく遅れて来たんだ。しかもレポート用紙や筆記用具すら持って来なかったんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190106,
					"content": "レポートのための時間を無駄にしたことについてあいつに説教していたら、あいつのほうがいきなり怒り始めたんだ！もう自分一人で書くからって言いながら、僕を追い出した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190107,
					"content": "——理不尽もほどがあるだろ！なあ、君もそう思うだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190108,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "はぁ、でもあいつのこのしょっちゅう怒り出す性格にも、とっくに慣れたさ。数日も経てばいつも通りに戻るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190110,
					"content": "——あいつの心も、ギミックみたいに簡単だったらよかったのにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190111,
					"content": "幸運を祈る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "はあ？なんだか含みのある言い方だな…まあいいか。そういえば、この辺りにはまだ影響を受けたウェネトが残ってるんだ。放っておいてもいつかは元に戻るだろうけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190114,
					"content": "でもやっぱり、通行人の安全のために、暇があればそれらを片付けてくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190115,
					"content": "——ちなみに、今ではおかげさまで、元素環境もチャージ装置も元通りだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190116,
					"content": "「対ウェネト殺蟲大砲」の全出力を体験したいなら、今が絶好のチャンスだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィナヤック"
				},
				{
					"id": 735190112,
					"content": "頑張って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "シュリヤはどこ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
}