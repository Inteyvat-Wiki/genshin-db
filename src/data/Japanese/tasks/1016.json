					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10160101,
					"content": "ああ、来たか。注文は俺がしておいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160102,
					"content": "この「三杯酔」はモンドの酒場とは違うぞ。ここの店主は、ジュースのような「空気の読めない」注文を断るからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160103,
					"content": "つまり、今回はお酒が飲める！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "だから、お前には酒醸団子を注文しておいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160105,
					"content": "ハハッ、そうなるよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "…皆様さえよろしければ、凝光様の「群玉閣」のお話を再開いたしますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 10160107,
					"content": "おおっ、講談師がいるぞ！いい雰囲気の店だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10160108,
					"content": "市場での評判を得るには、美味しい酒の他にも環境が大事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160109,
					"content": "しかし、ここで言う「環境」と、『テイワット観光ガイド』に書かれるような酒場の「環境」は別物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160110,
					"content": "皆様ご存知の通り、この港の上には雲上の宮殿、煙霞の行宮があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 10160111,
					"content": "天へ届くかの如し所業とはいかなものでしょう？ご覧ください、これこそが凝光様が築いた天へと通ずる産業でございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 10160112,
					"content": "晴れた日に、宮殿から外を眺めれば——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 10160113,
					"content": "絶景かな！璃月港の景色の大半を一望できます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 10160201,
					"content": "考えてみてください、紙切れとは言え、凝光様が策を練るために用いた「考え」にどれほどの価値がおありか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 10160202,
					"content": "それが一枚や二枚、少しでも多く手に入れば、凝光様の指の隙間から零れ落ちる利益を同業者よりも享受できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "田饒舌"
				},
				{
					"id": 10160203,
					"content": "「天権」凝光…最近、この名前をよく耳にするよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10160204,
					"content": "璃月の人は彼女の話をするし、「ファデュイ」は彼女を嫌うし、「仙祖の亡骸」を隠したのも彼女みたいだし、「迎仙儀式」でも一回見たような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10160205,
					"content": "一体どんな人なんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10160207,
					"content": "やっと見つけました、「絶雲の間から帰ってきた者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160208,
					"content": "誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10160209,
					"content": "パイモン、行こう…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "待ってください。私は千岩軍でも、あなたたちを捕まえに来た者でもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160211,
					"content": "確かに「璃月七星」の使者ですが——私は甘雨、月海亭の秘書です。あなたたちに会うためここに来ました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160212,
					"content": "使者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "正確に言いますと、本職は「七星」全員の秘書ですが、今回は一時的に凝光様の特使として参りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160215,
					"content": "おお、噂をすれば…凝光の使者が現れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10160216,
					"content": "絶雲の間から帰ってきた者…この場で礼儀が十分に行き届いていないことお許しください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160217,
					"content": "しかし、私が持ってきたこの手紙は凝光様が「天権」として、正式に出された招待状です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160218,
					"content": "あなたを「空中宮殿」に招待いたします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160219,
					"content": "招待状…だって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10160220,
					"content": "そうです。凝光様はこう言いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160221,
					"content": "#「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}を連れてきなさい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160222,
					"content": "#「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}に会うわ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160223,
					"content": "#「群玉閣で、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}と一緒に…繁雑な暗流の糸を一本ずつ断ち切るから。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10160213,
					"content": "秘書？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
		{
			"id": 101603,
