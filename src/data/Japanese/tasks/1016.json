			"dialogs": [
				{
					"id": 10160301,
					"content": "凝光…甘雨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10160302,
					"content": "暗流の激しいこの数日間、彼女たちの立場は一体どこにあるのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 101610,
			"completionStepIds": [
				101610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101610",
							"2"
						],
						"stepId": 101610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "あの甘雨っていう使者、言うだけ言ってどっか行ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10161002,
					"content": "でも、「璃月七星」から招待状をもらうなんて、どういうことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}！お金持ちと会うんだから、礼儀には気を付けておこうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10161004,
					"content": "もともと礼儀正しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "ハハッ…客人として「群玉閣」に招待される者は確かに多くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10161007,
					"content": "行ってくるといい。あぁ、「送仙儀式」のことも忘れないでくれ。群玉閣から戻ってきたら、荻花洲で落ち合おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10161008,
					"content": "おう、覚えておくぞ。終わったら、荻花洲で合流しような！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10161005,
					"content": "パイモンが何か企んでる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}