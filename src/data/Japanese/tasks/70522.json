			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曲清"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220101,
					"content": "いらっしゃいませ、お二人ですね。何をお飲みになりますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220102
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220102,
					"content": "あれ…その服装、ここの方ではありませんね？うちのお茶がお口に合うかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220103
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220103,
					"content": "とりあえず、雲来白毫茶をお淹れしましょう。もしお口に合わなければ、またいらしてください。その頃にはモンドのブリュー祭で名物ドリンクを仕入れておけると思いますので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220104,
						705220105
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220104,
					"content": "ありがとう、でも客として来たんじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				},
				{
					"id": 705220106,
					"content": "そうそう、オイラたちは頼りになるパシリだぞ！おまえが出した、美酒祭りでドリンクの買い付けをプロに頼みたいって依頼を聞いて来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220107,
					"content": "どんなドリンクを仕入れたいんだ？なんでもオイラたちに言ってくれよ。発注を手伝うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220108,
					"content": "仕入れを手伝うために…わざわざ璃月まで来てくださったんですか？なんて親切な人たちのかしら…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220109
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220109,
					"content": "こんな面倒な依頼を受けてくれる人なんているかしらと思ってたんですが…じゃあお願いしますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220110
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220110,
					"content": "モンドの船員さんに聞いたんですが、<color=#00E1FFFF>キャッツテール</color>の名物ドリンク「ベリーミンツ」は喉の渇きを癒すだけじゃなくて、心まで落ち着かせてくれるんですって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220111
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220111,
					"content": "だから<color=#00E1FFFF>「ベリーミンツ」を65箱</color>注文して、他の飲み物と一緒に船員さんに提供したいと思ってるんです。そうすれば、落ち着いた気分になって仕事もはかどるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220112
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220112,
					"content": "前はモンドの商人も、こっちの需要に応じて品物を用意してくれてたんですが…今回はブリュー祭のルールに従って、事前に「ブリューゼリー」を集めておいたので、ここからはあなたたちに任せますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220113
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220113,
					"content": "仕入れ資金は多めに見積もって用意したので、余った分がお二人への手間賃です。私の感謝の気持ちを伝えるには足りませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220114,
						705220115
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220114,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220116,
					"content": "#心配するなって。「ベリーミンツ」が65箱だな！注文の方はオイラと{NICKNAME}に任せとけ。なにしろ、オイラたちはプロだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220117,
					"content": "すぐ戻って来るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220115,
					"content": "これくらい楽勝だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220116
					]
				},
				{
					"id": 705220105,
					"content": "#{M#俺}{F#私}たちは飲み物の仕入れを手伝う使い走り。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220106
					]
				}
			]
		},
		{
			"id": 7052202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7052202",
							"2"
						],
						"stepId": 7052202,
						"stateName": "QUEST_STATE_UNFINISHED"
