			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曲清"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220301,
					"content": "曲清さん、ただいま！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220302,
					"content": "頼まれたドリンクを発注してきたぞ。明日さっそく船に積んで、なるべく早くここの埠頭まで届けてくれるってさ。ほら、これが受注書だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220303,
					"content": "もう頼んできてくれたんですか？仕事が早いんですね…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220304
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220304,
					"content": "じゃ、じゃあ今すぐ最高の山泉水でお茶を淹れますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220305,
						705220306
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220305,
					"content": "気を使わなくていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				},
				{
					"id": 705220307,
					"content": "そうそう、これからまだ他の仕入れの手伝いにも行かなきゃならないしな。もてなしには及ばないぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220308,
					"content": "商売がうまくいくよう祈ってるぞ。今度また、美味しい飲み物をいただきにくるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220309,
					"content": "あら…じゃあ今度はあなたたちの好きな飲み物を用意しておきますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220310
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220310,
					"content": "ぜひまた来てくださいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220306,
					"content": "お礼の手数料はもうもらったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220307
					]
				}
			]
		},
		{
			"id": 7052204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
