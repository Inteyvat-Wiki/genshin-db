				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ダイアン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220201,
					"content": "「キャッツテール」へようこそ。何かお求めですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220202
					],
					"speakerTitle": "ダイアン"
				},
				{
					"id": 705220202,
					"content": "こんにちは、ダイアンさん。オイラたち、でかい取引を持ってきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220203,
					"content": "曲清の仕入れの件をダイアンに説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705220204
					]
				},
				{
					"id": 705220204,
					"content": "あれ？璃月の北埠頭に新しくオープンしたっていう、小さなお店のことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220205
					],
					"speakerTitle": "ダイアン"
				},
				{
					"id": 705220205,
					"content": "ドーンマンポートから来た船員たちがその店長さんの話をしていたんです。マーガレットさんも彼女のところから材料を仕入れたことがあるみたいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220206
					],
					"speakerTitle": "ダイアン"
				},
				{
					"id": 705220206,
					"content": "最近、曲清さんは埠頭で船員たちにドリンクを売るとき、軽策荘の山泉水の宣伝も頼んでいるみたいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220207
					],
					"speakerTitle": "ダイアン"
				},
				{
					"id": 705220207,
					"content": "彼女は軽策荘から高値で山泉水を買い取って、基本的な手間賃だけをとって需要のある所に再販してるらしいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220208
					],
					"speakerTitle": "ダイアン"
				},
				{
					"id": 705220208,
					"content": "彼女が橋渡しをしてくれるおかげで、村の外の人も軽策荘の山泉水を使った独特な風味のお酒が作れるし、軽策荘のお年寄りたちもかなりの収入を得られるようになったから、ギブアンドテイクの関係ってやつですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220209
					],
					"speakerTitle": "ダイアン"
				},
				{
					"id": 705220209,
					"content": "そんな事情があったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220210
					]
				},
				{
					"id": 705220210,
					"content": "曲清さんっていい人なんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705220211,
					"content": "そうなんです。今後キャッツテールは彼女と長期的に提携するかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220212
					],
					"speakerTitle": "ダイアン"
				},
				{
					"id": 705220212,
					"content": "さて、本題にもどりましょうか。これだけの「ベリーミンツ」、いくらで買って下さいますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダイアン"
				}
			]
		},
		{
			"id": 7052203,
			"completionStepIds": [
				7052203
			],
