					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"曲清"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705220401,
					"content": "発注、ご苦労様でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220402
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220402,
					"content": "この名物ドリンクがあれば、船員さんたちもまた違った味で喉を潤せます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220403,
						705220406,
						705220409
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220403,
					"content": "味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220404
					]
				},
				{
					"id": 705220404,
					"content": "船員さんたちの好みは人それぞれですから。あっさりしたお茶が好きな人もいれば、甘酸っぱいジュースが欲しいって人もいて…それに、いつも同じ飲み物ばかりじゃ、いつか飽きてしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220405
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220405,
					"content": "だから店にはいつもいろんな味の飲み物を置くようにしてるんです。できるだけ船員さんたちの希望に添えたいと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220406,
					"content": "店舗について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220407
					]
				},
				{
					"id": 705220407,
					"content": "船員さんたちにはずいぶん助けてもらったので、最近こちらの埠頭に店を開いて、飲み物を提供し始めたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705220408
					],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220408,
					"content": "でもまだ慣れないもので、お店の売上はあまり良くなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曲清"
				},
				{
					"id": 705220409,
					"content": "じゃあ、またね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705220410
					]
				},
				{
					"id": 705220410,
					"content": "さようなら、無事に旅ができるよう祈ってますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "曲清"
				}
			]
		},
