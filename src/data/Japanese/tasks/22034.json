					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340203,
					"content": "あいつら、逃げ足だけは速い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340204,
					"content": "宝盗団たちは必ず戻って事情を報告する筈です。そうすれば、私たちの目的は達成です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340205,
					"content": "旅人、お疲れ様でした。報酬を受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340206,
					"content": "私もすぐに帰って、所長に状況を報告します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340207,
					"content": "所長が何か推理出来たかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				}
			]
		},
