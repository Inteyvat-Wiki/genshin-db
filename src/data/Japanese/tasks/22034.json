	"talks": [
		{
			"id": 2203401,
			"completionStepIds": [
				2203401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203401",
							"2"
						],
						"stepId": 2203401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "旅人、お待ちください。所長からお願いがあるようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340102,
					"content": "事件に進展があった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "所長は、まだ準備が必要だと。それ以外は何も言っていませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340104,
					"content": "あなたを待ち、共に野外で探索するようお願いしろ、とおっしゃっていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340105,
					"content": "所長は何がしたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "それは…正直、私にもよく分かりません。しかし所長の言う通りにしていれば、大抵の場合、事件を解決できます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340112,
					"content": "あっ、やはり本題に戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340113,
					"content": "所長によると、天野さんと安藤さんがあの事件を上に報告してから、城内の見回りが強化されたそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340114,
					"content": "でもおかしなことに、城内のお店で窃盗被害が続いているんです。そのうえ、犯人は目標の品以外には手を付けないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340115,
					"content": "所長は、町の外の宝盗団による犯行の可能性は限りなく低いと判断しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340116,
					"content": "この事件の犯人…または犯人たちには、明確な犯行目的があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340117,
					"content": "今わかっているのは、常に城内の中に潜み、外に情報を流し続けている「内通者」がいる可能性が、非常に高いということ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340118,
					"content": "同心たちの苦労が無駄になってしまう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "いいえ、犯人は同心たちの目標が自分ではないと思っているからこそ、犯罪行為を続けているのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340120,
					"content": "彼が罪を重ねれば、残す痕跡も必ず多くなります。そうしたら、所長も彼の正体を暴きやすくなる筈です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340121,
					"content": "犯人を油断させるためには、続けるしかありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340122,
					"content": "旅人。今回の頼みごともそれ故です。私と共に野外に行き、宝盗団の邪魔をしていただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340123,
					"content": "もちろん、報酬はちゃんとお支払いします。それに…この事件が解決できたら、更に報酬をお渡しします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340124,
					"content": "それも珊瑚に指示されたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "うぅ…気付かれましたか。さすが、あなたは本当に鋭い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340126,
					"content": "そうです、先ほど言った内容は、全て所長に指示された事です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340127,
					"content": "ですが、先ほどお話した内容に偽りはありません。信じてください、少なくとも…報酬はちゃんと私の手元にあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340128,
					"content": "だから、お願いします、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340129,
					"content": "でもいったい何をすればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "簡単です。私たちはただ…野外の宝盗団を混乱させればいいのです。騒ぎは大きければ、大きいほどいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340131,
					"content": "宝盗団の拠点の場所は、所長が印をつけてくれました。私も、あなたの地図に印をつけておきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340132,
					"content": "出来ました。では行動開始ですね、そこで合流しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340107,
					"content": "所長自身はどうして来ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "所長はいつもこんな感じです。彼女は…「自分は考えるのは得意だが、行動は苦手」だと言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340109,
					"content": "以前、ある小説の作者が取材しに来て、所長の経験を題材とした小説を書くと言っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340110,
					"content": "そして、所長のことを「安楽椅子探偵」と呼びました。所長はその名前が気に入っているようで、以前から安楽椅子を買いたいと思っていたようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220340111,
					"content": "しかし、探偵所の経費の問題もあり、安楽椅子を買うことが出来なかったらしく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "龍二"
				}
			]
		},
		{
