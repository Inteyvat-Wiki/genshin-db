			},
			"dialogs": [
				{
					"id": 705280401,
					"content": "協会の人手で足りるかな、はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280402,
					"content": "ああ、旅人！すまない、ちょっと協会のことを考えていて、ボーっとしていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280403,
					"content": "この時期にモンド城に来たってことは、風花祭に参加するためだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280404,
					"content": "我々冒険者協会も、ちょうどミニゲームをひとつ作ったところなんだ。手軽に参加できて面白いし、参加するだけで報酬ももらえる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280405,
					"content": "どうだ、やってみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280406,
					"content": "まずはゲームを紹介しよう。ゲームを設計した協会のメンバーは、これを「フローラルチェス」と名付けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280407,
					"content": "設計のアイデアは宙を舞う花びらと、それを追い求める風に由来しているらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280408,
					"content": "ゲーム全編を通して、花びらを追い求めるロマンティックな雰囲気を演出しようとしたとのことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280409,
					"content": "は、背景まで考えられてるんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "その人は吟遊詩人なんだ…まあ…想像力が豊かでね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280412,
					"content": "ルールを簡単に説明すると、盤面にある「ブルームバルーン」をできるだけ多く集めるゲームだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280413,
					"content": "そして、ゲーム中は色んな障害物を避けないといけない…もちろん、盤面には色んな補助アイテムも登場する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280414,
					"content": "製作者が特別にルールブックを一冊書いてくれたから、あとで読んでみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280415,
					"content": "興味があったら、いつでも遊びに来てくれ。参加するだけで報酬ももらえるからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "プローン"
				},
				{
					"id": 705280410,
					"content": "け、結構複雑だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}