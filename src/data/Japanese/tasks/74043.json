			"dialogs": [
				{
					"id": 740430201,
					"content": "抗議抗議！僕の労働権のために抗議する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430202,
					"content": "探してたコアを持ってきたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "おっ？見せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430204,
					"content": "どうしてこんなところで抗議を…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "どんな場所で転んでも、立ち上がらないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430206,
					"content": "何をすればいいんだっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "はぁ、どうしようもないやつだなぁ。地上と地下の色んな場所に、誰かがこの変な機械を設置したんだ。見分ける方法は簡単だよ。周囲に変な光を放っているのがそうさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430208,
					"content": "それを破壊して、中からこういうコアを取り出して僕に渡してくれ。全部で<color=#00E1FFFF>7個必要</color>だ。頼んだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンリ"
				}
			]
		},
