			"dialogs": [
				{
					"id": 740430301,
					"content": "うん。不思議なコアを7つ、確かに受け取ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430302,
					"content": "それで、そのコアは何に使うの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "知るもんか！ボスは、とにかく機械の中にある不思議なコアが7つ必要だって言ったんだ。そのコアをいじれば大儲けできるんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430304,
					"content": "とにかく任務は完了した！僕は今日、仕事の進捗を報告するためにボスとここで会う約束をしてるんだ。なんなら彼に直接聞いてみたらどうだい？どのみち働いた分を精算してもらわないことには、僕も君に分け前を渡せないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430305,
					"content": "仕方ないなぁ。アンリがそう言うなら、しばらく待ってやるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740430306,
					"content": "しばらくして…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "やあアンリ、状況はどうだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "「ボス」"
				},
				{
					"id": 740430308,
					"content": "順調ですよ、ボス！お探しの7つの不思議なコア、全部集まりました。ほら、紹介しますよ。協力者の…えっと、何て名前だっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430309,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "「ボス」"
				},
				{
					"id": 740430311,
					"content": "うっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740430312,
					"content": "あれ、もしかして顔見知りだったの？ならちょうどいいや！そういうわけでして、ボス…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430313,
					"content": "#「ええっ！{NICKNAME}！どうして{NICKNAME}がここに！？」\\n「ボス」は踵を返して逃亡したが、どこからか現れたハンターとターナーに取り押さえられた！\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "うわあっ、お助けを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "「ボス」"
				},
				{
					"id": 740430316,
					"content": "わぁ、あの二人…手慣れてるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740430317,
					"content": "ボス、大丈夫です。命の危険はありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430318,
					"content": "ああ、もちろん。命の危険なんてないに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430319,
					"content": "今のところは、な。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430320,
					"content": "い、今のところは…！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "「ボス」"
				},
				{
					"id": 740430321,
					"content": "さて、この次は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430322,
					"content": "ローストチキンか、あるいは…それ以外だな。ボスさんよ、あんたの態度次第ってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430323,
					"content": "ああっ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "「ボス」"
				},
				{
					"id": 740430324,
					"content": "お前ら、どうしてここにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740430325,
					"content": "前に偶然会ってから…アンリを監視することにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430326,
					"content": "待ってくれ、どうして僕を監視するんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430327,
					"content": "いや、そもそも…なんで僕をつけ狙うんだ！ただ仕事に勤しんでただけじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430328,
					"content": "お前の壊した機械…あれはフォンテーヌ科学院の人間が水質のモニタリングと改善に使う装置だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430329,
					"content": "えっ？汚染を作り出す機械じゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430330,
					"content": "取り出したコアには、最先端のムーブメントとフォンテーヌの水文データが含まれてる。俺たちは…お前の取引先とお近づきになりたいのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430331,
					"content": "え…えっ？なんで？どうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430332,
					"content": "アンリ！騙したんだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "ショック！騙された！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "いやいや！君は僕の恩人なんだ、騙すわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430335,
					"content": "ボス、なんで嘘をついたんですか！大事な機械を壊しちゃったじゃないですかっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430336,
					"content": "わ、私の意志でやったんじゃない…私は単なる末端の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "「ボス」"
				},
				{
					"id": 740430337,
					"content": "ああ？ボスさんよ。いま「私の意志じゃない」って聞こえたが…もう一回言ってくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430338,
					"content": "ああ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "「ボス」"
				},
				{
					"id": 740430339,
					"content": "相当参ってるみたいだな。目を開けたまま気絶しやがった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430340,
					"content": "うう、お、オイラたちだってわざとじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740430341,
					"content": "ああ、それについてはお咎めなしってことになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430342,
					"content": "えっ？いいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740430343,
					"content": "コアと中のデータさえ無事なら、機械なんてどうでもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430344,
					"content": "ま、表向きはな。どのみちあんたらに難癖はつけられないからしょうがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430345,
					"content": "難癖はつけられないってどういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "いや、何でも無い。ほら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430347,
					"content": "俺たちはただ散歩してただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430348,
					"content": "ホントに偶然だな。こんなにいい天気の日に会えるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430349,
					"content": "だが、出会った限りいつかは別れが来るんだ。そろそろ…おさらばするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430350,
					"content": "この美しい出会いを心に留めておくか、あるいは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430351,
					"content": "いいや、忘れたほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430352,
					"content": "えーと…僕たち、もう行っていいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430353,
					"content": "何だ。他に何かあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430354,
					"content": "いやいや、まさか！ハハッ、何にもないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430355,
					"content": "はぁ…親切な人に出会って、ようやく労働を通して運命を変えられるって思ったのに…やっぱり世の中は悪いやつだらけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430356,
					"content": "…おい、アンリ。ちょっと手を貸せ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430357,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430358,
					"content": "不幸なことに、この親切なボスは意識を失った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430359,
					"content": "そこで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430360,
					"content": "仕事に対して真摯で——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430361,
					"content": "忠実で信頼できる——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430362,
					"content": "労働で運命を変えたいと考える…相棒が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430363,
					"content": "そういうこった。相棒、この「いい男」を俺たちの隠れ家に運ぶのを手伝ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430364,
					"content": "この機会に…ボスさんと話がしたくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 740430365,
					"content": "ああ。もちろんしっかり…感謝を示すつもりだぜ——モラでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 740430366,
					"content": "えっ？うん！もちろん手伝うよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430367,
					"content": "よかった！本当にありがとうございます！君たちにも感謝するよ、えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430368,
					"content": "#{NICKNAME}と、こっちはパイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#ありがとう、{NICKNAME}にパイモン！君たちに出会ってから僕の運命は変わり始めた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430370,
					"content": "いいって！頑張れよ、アンリ！もう騙されるんじゃないぞ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740430371,
					"content": "ああ！肝に銘じておくよ。頑張って働いてお金持ちになるんだ！今後人を雇うことがあったら、ぜひ僕に声をかけてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 740430372,
					"content": "ハンター、ターナーの二人とアンリは意識を失ったファデュイを掘り出し、連れて行った。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "アンリのやつ、幸せになれるといいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740430374,
					"content": "…待て！あいつが約束したオイラたちへの報酬は！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}