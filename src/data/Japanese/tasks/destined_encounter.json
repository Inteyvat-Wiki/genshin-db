			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マスルール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80090101,
					"content": "あの、あなたが噂の各国を渡って旅している金髪の旅人さんでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090102
					],
					"speakerTitle": "マスルール"
				},
				{
					"id": 80090102,
					"content": "なんだ？オイラたちになにか用があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090103,
					"content": "よかった、どこを探せばいいか悩んでいたところだったんです。ちょうどあなた宛ての手紙が私の手元にありまして、ある外国人から預かったものなのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090104
					],
					"speakerTitle": "マスルール"
				},
				{
					"id": 80090104,
					"content": "その人に、こちらの郵便システムを上手いこと利用されてしまったんです。「手紙を必ず届ける」という確約を得たのち、極めて曖昧な届け先を記入されてしまいまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090105
					],
					"speakerTitle": "マスルール"
				},
				{
					"id": 80090105,
					"content": "オイラたちに手紙を届けるのってけっこう難しいんだよな。なにしろオイラたち、ずっとあっちこっち駆け回ってるし。手紙を受け取るには、むしろオイラたちのほうから郵便受けに行って探すしかないかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090106,
					"content": "それで、そいつが書いた届け先ってどこなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090107,
					"content": "えっと…「とある喋る白い髪の小さな精霊の隣」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090108
					],
					"speakerTitle": "マスルール"
				},
				{
					"id": 80090108,
					"content": "えっ！オイラのことか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090109,
					"content": "はぁ、そうなんです。しかも、もし手紙を届けられなければ、規則に従ってこちらが賠償しなければなりません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090110
					],
					"speakerTitle": "マスルール"
				},
				{
					"id": 80090110,
					"content": "本当にあの人にはしてやられました。しかし、どうやら運は私の味方をしてくれたようですね。こうやってあなたたちに偶然にも出会えましたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090111,
						80090112
					],
					"speakerTitle": "マスルール"
				},
				{
					"id": 80090111,
					"content": "じゃあ、手紙をちょうだい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090113
					]
				},
				{
					"id": 80090113,
					"content": "ええ、どうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090114
					],
					"speakerTitle": "マスルール"
				},
				{
					"id": 80090114,
					"content": "オイラにも見せてくれ、いったい誰からの手紙なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090115,
					"content": "ガイアからだ！あいつもスメールに来てるんだな…ふん、「悪知恵の働く外国人」って、きっとあいつのことだろうなって思ってたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090116,
						80090117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090116,
					"content": "確かに、そこまで予想外じゃないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090118
					]
				},
				{
					"id": 80090118,
					"content": "手紙の内容から見るに、あいつはこの手紙が無事に届くことにあまり期待してなかったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090119,
					"content": "あっ、むしろもしこの手紙が本当に届いたら、それこそ「運命の定め」ってことになって、オイラたちのほうからあいつのところに行かなきゃならないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090120,
						80090121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090120,
					"content": "手紙まで計算されてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090122
					]
				},
				{
					"id": 80090122,
					"content": "まあ、なんにせよ昔の友だちに会うのは嬉しいことだもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090123,
					"content": "手紙によると、あいつは毎日午後になるとジャファータバーンに行ってるみたいだ。オイラたちも午後になったら時間を見つけて、あいつを探しに行こうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090121,
					"content": "それでもいい、元々彼には挨拶したかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090122
					]
				},
				{
					"id": 80090117,
					"content": "さすがガイア、と言うべきかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090118
					]
				},
				{
					"id": 80090112,
					"content": "手紙を見せて、誰からかすごい気になる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090113
					]
				}
			]
		},
