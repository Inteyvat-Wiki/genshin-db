			"dialogs": [
				{
					"id": 80091001,
					"content": "先ほどの魔物の出現も偶然ではないはずだ。この近くには確かにやつらを誘き寄せる何かが存在している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091002
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80091002,
					"content": "地脈の異常か…それだけではないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091003
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80091003,
					"content": "こうするとしよう。俺はここから少し離れ、近くの地脈に問題がないか調べてくる。時間がかかるかもしれないが、貴様たちはここで待っていてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091004
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80091004,
					"content": "えっ、一人で行くつもりか？まさか、なにかオイラたちに隠しておきたい秘密があるとかじゃないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091005,
					"content": "…くだらん邪推だ。俺はただ調査の要はあくまでこの家屋の付近にあり、誰かをここに残して観察する必要があると考えているだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091006
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80091006,
					"content": "何せ地脈の調査のようなレンジャーでもできることなら、俺一人で十分だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091007
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80091007,
					"content": "うぅ、分かったよ。確かにその通りでもあるしな。じゃあ、オイラたちはここでキャンプでもするか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091008,
					"content": "ちょうどあっちにたき火があったから、美味しいものでも作ろうぜ！あっちこっち走ったし、オイラもうお腹ペコペコだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
