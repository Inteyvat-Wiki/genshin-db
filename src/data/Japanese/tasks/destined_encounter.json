			"dialogs": [
				{
					"id": 80091101,
					"content": "パイモンと一緒にたき火をつけて、気付いたら夜になっていた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80091102
					]
				},
				{
					"id": 80091102,
					"content": "おまえが作る料理はあいかわらず美味しいな。この料理の腕だけで、おまえには一生についていけるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091103,
						80091104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091103,
					"content": "人から食べ物をこうも自然にたかるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091105
					]
				},
				{
					"id": 80091105,
					"content": "そういえばダインのやつ、さすがに遅くないか？空が真っ暗になってもまだ帰ってこないなんて。近くの地脈に問題があるとか言ってたけど、まさか本当になにか大変なことが起こったわけじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091106,
					"content": "はぁ、ここには一緒に来たのに、今はオイラたち二人だけか…でも思い返してみると、二人だけでいる時間ってもうかなり長いよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091107,
					"content": "えっと、その…別に深い意味はないけど、ちょっと、ちょっとだけ聞いてもいいか…オイラと一緒にいるのって退屈だったりしないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091108,
						80091110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091108,
					"content": "パイモンがいるおかげで、すごく楽しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091109
					]
				},
				{
					"id": 80091109,
					"content": "…でへへ、そんなはっきり言われると、オイラもテレちゃうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091112,
					"content": "#だから…えっと、その…話してくれる気になるか分からないけど…オイラ、おまえが{M#妹}{F#お兄}さんと一緒に旅をしてた時のことを知りたいんだ。どんな感じだったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091113,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091114
					]
				},
				{
					"id": 80091114,
					"content": "星空？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091115,
						80091116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091115,
					"content": "こうやって一緒に星空を眺めてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091117
					]
				},
				{
					"id": 80091117,
					"content": "おお…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091118,
						80091119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091118,
					"content": "星海を渡り、一度も離れたことはなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091120,
						80091121
					]
				},
				{
					"id": 80091120,
					"content": "こんな風に離れ離れになるのは初めて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091122
					]
				},
				{
					"id": 80091122,
					"content": "ああ…オイラ、おまえの気持ちはずっと分かってたぞ。離れ離れになった理由すらはっきりしないなんて、ツラすぎるよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091123,
					"content": "オイラが必ずおまえのガイドをちゃんとやり遂げてみせるからな。真相だって、いつか明らかになるはずだ。よし！今に見てろよ、天理！今に見てろよ、テイワット！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091124,
						80091125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091124,
					"content": "今に見てろよ、天理！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091126
					]
				},
				{
					"id": 80091126,
					"content": "へへっ、ごめんな、ツラいこと思い出させちゃって。やっぱりおまえには笑っててほしいんだ。おまえが楽しくないと…オイラも悲しくなってくるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091127,
						80091128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091127,
					"content": "大丈夫だよ、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091129
					]
				},
				{
					"id": 80091129,
					"content": "よし、もう遅いし、おまえは先に休んでていいぞ。今夜はオイラが先に見張っててやる。おまえを魔物に食べさせたりしないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091130,
					"content": "珍しいね、パイモンが先に寝ないなんて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091131
					]
				},
				{
					"id": 80091131,
					"content": "もう、そんなこと言うなって…オイラだってたまにはおまえに気を遣ってやろうと思ってるんだ、えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091132,
						80091133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091132,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091134
					]
				},
				{
					"id": 80091134,
					"content": "おやすみ！安心してぐっすり寝てくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091133,
					"content": "じゃあ、おやすみ。パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091134
					]
				},
				{
					"id": 80091128,
					"content": "ありがとう、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091129
					]
				},
				{
					"id": 80091125,
					"content": "今に見てろよ、テイワット！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091126
					]
				},
				{
					"id": 80091121,
					"content": "少なくとも…何が起きたのか知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091122
					]
				},
				{
					"id": 80091119,
					"content": "宇宙にある様々な希望と絶望を見てきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091120,
						80091121
					]
				},
				{
					"id": 80091116,
					"content": "行きたい星を指でさしてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091117
					]
				},
				{
					"id": 80091110,
					"content": "まあまあ、いないよりましかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091111
					]
				},
				{
					"id": 80091111,
					"content": "ふん、分かってたぞ、おまえならそう言うだろうなって。おまえの性格からして、こういう時にいい言葉を言うわけないもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80091112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80091104,
					"content": "パイモンは簡単に誘惑に負けすぎ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80091105
					]
				}
			]
		},
