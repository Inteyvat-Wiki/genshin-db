					"ダインスレイヴ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80090501,
					"content": "待て、ここは…少し覚えがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090502
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090502,
					"content": "ここか？特に変わったところは見当たらないけど、数百年前もこんな感じだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090503,
					"content": "ああ、この森のすべてが俺の記憶とあまり変わりない。何しろここの環境は、滅多に人に影響されることがないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090504
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090504,
					"content": "近くを調べよう。何か手がかりがあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090505
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090505,
					"content": "これって畑か？そこの家に住んでる人が作ったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090506,
					"content": "でも、長いこと使われてないみたいだ。そのせいでここになにが植えられてたのかまったく分からない…そもそも、本当になにか植えてたことがあるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090507,
					"content": "消されたたき火があるな、レンジャーが残したものかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090508,
					"content": "この痕跡を見た感じ、ここでたき火をしたのはかなり昔っぽいな。ちゃんと火を消して火事にならないよう予防したみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090509,
					"content": "この辺りには価値のある手がかりはなさそうだ。残るはあの家だけか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090510
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090510,
					"content": "えっと、まだ誰か住んでたりしないか？お邪魔していいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090511,
					"content": "いや、そのようには見えない。この辺りには生活をしている形跡もないしな。心置きなく調べられるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090512
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090512,
					"content": "そうなのか…じゃ、じゃあ、まずおまえが先に入れよ、ダイン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
