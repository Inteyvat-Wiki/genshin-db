			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ガイア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80090301,
					"content": "…マスター、俺が飲んだことないものをもう一杯頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090302
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090302,
					"content": "えっと…お客さん、うちのお酒はもうとっくにすべて飲まれていますので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090303
					],
					"speakerTitle": "エイマン"
				},
				{
					"id": 80090303,
					"content": "そうだったか。よし、なら今日はこの辺でおしまいにしよう。ちょうど俺もこれから用事があるしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090304
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090304,
					"content": "ガイア！やっぱりここにいた、オイラたちのことをからかってるんじゃないかってヒヤヒヤしたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090305,
					"content": "おっと、パイモンに旅人じゃないか。どうやら俺はまだ神に見放されていなかったようだな。お前たちに会いたくてしょうがなかったんだぜ。からかうわけがないだろ、ハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090306,
						80090307
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090306,
					"content": "その言葉、本心として受け取るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090308
					]
				},
				{
					"id": 80090308,
					"content": "おまえ、出張中なんだろ？毎日、午後は酒場で暇をつぶしてるみたいだけど、帰ってジン団長に怒られてもいいのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090309,
					"content": "ハハッ…俺はジンをひどく恐れているんだぜ。そんな俺にあいつを不機嫌にさせる真似をする度胸があると思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090310,
						80090311
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090310,
					"content": "そんな風に見えないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090312
					]
				},
				{
					"id": 80090312,
					"content": "実はな、俺が今回スメールに来たのは、ここの酒造業を視察しに来たからなんだ。ジャファータバーンにいつもいるのも、真面目に仕事してるからなんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090313
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090313,
					"content": "スメールが香料で有名なのはよく知られているだろ？ここで香辛料入りのカクテルが発明されたっていう噂が以前流れたんだが、そいつがかなり評判いいらしくてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090314
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090314,
					"content": "そこで騎士団は、酒にもっとも造詣の深い俺を派遣した。それが噂ほどの逸品かどうかを確かめるためにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090315
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090315,
					"content": "それで、結果は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090316,
					"content": "結果は…オルモス港の何人かの香料商人と既に契約を進めているところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090317
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090317,
					"content": "おお、悪くないビジネスチャンスみたいだな。アカツキワイナリーもディルックの旦那も、これを機に大儲けできるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090318,
					"content": "そうだな…まあ、この商売をアカツキワイナリーに任せるかどうかは、最終的に俺の気分次第だがな、ハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090319
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090319,
					"content": "おい！公務に私情を挟むなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090320,
					"content": "ガイアは前にもスメールに来たことあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090321
					]
				},
				{
					"id": 80090321,
					"content": "うん？いきなりそんな質問をしてどうした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090322
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090322,
					"content": "一人で来てるし、馴染みがあるのかなと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090323
					]
				},
				{
					"id": 80090323,
					"content": "ほう、なかなか鋭いじゃないか。馴染みがある…というほどじゃないな。ただ、俺が子供の頃に一度だけこっそり来たことがあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090324
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090325
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090325,
					"content": "うん？それで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090326,
					"content": "おっと…これ以上喋る必要があったか？お前たちと「昔話」をするつもりではあったが、これはあくまで俺自身の「昔」だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090327,
						80090328
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090327,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090329
					]
				},
				{
					"id": 80090329,
					"content": "…分かったよ、お前たちが聞きたいなら仕方ない…これは俺がアカツキワイナリーに引き取られて間もない、まだ幼い頃のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090330
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090330,
					"content": "ある日、俺は義父さんのしていた商談から、キャラバンをスメールに派遣する話を聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090331
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090331,
					"content": "知っての通り、自分の血の中にある故郷のことに興味を持たないやつなんていない。そして俺の故郷…カーンルイアは、スメールの近くの地下深くにあったとされている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090332
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090332,
					"content": "カーンルイア…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090333
					]
				},
				{
					"id": 80090333,
					"content": "だから当時の俺はこっそりと貨物に忍び込み、キャラバンと一緒にスメールまで行ったんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090334
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090334,
					"content": "ワイナリーから俺がいなくなったっていう連絡が、すぐにキャラバンに届いてな。キャラバンの責任者が俺を見つけた後、義父さんの手で直々に連れ戻されたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090335
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090335,
					"content": "すまん、大した昔話じゃなかったな、ハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090336
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090336,
					"content": "カーンルイアのこと、どれくらい知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090337
					]
				},
				{
					"id": 80090337,
					"content": "実を言うと、それほど多くはないんだ。カーンルイアがスメールの近くにあったっていう情報も、幼い頃に自分で資料から調べたもんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090338
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090338,
					"content": "ただ年を重ねるにつれて、俺の生活も次第にカーンルイアと関係のないものになっていった。少しずつだが、カーンルイアのことはそこまで気にならなくなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090339
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090339,
					"content": "昔の俺は、実の父親から何らかの「責任」を受け継いだんじゃないかって、いつもそう思っていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090340
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090340,
					"content": "だが、後になってよくよく考えてみたんだ。父が俺をモンドみたいな自由で平和な城に置いていったのは、ただ真っ当に生きてほしかっただけなのかもしれないってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090341
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090341,
					"content": "「一部の物事」から俺を遠ざけたんだよ。もちろん、楽しく生きられたなら尚更だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090342
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090342,
					"content": "…と言っても、これは全部俺の勝手な想像だけどな。とにかく、お前に有用な情報は提供できそうにない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090343
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090343,
					"content": "今、俺が持っているカーンルイアと関係があるものと言ったら、恐らく「アルベリヒ」という苗字だけだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090344
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090344,
					"content": "…マスター、「午後{RUBY#[D]デス·イン·ディス·アフタヌーン}の死」を頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090345
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090345,
					"content": "…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090346
					]
				},
				{
					"id": 80090346,
					"content": "貴様は…「アルベリヒ」の意味をちゃんと理解しているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090347
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090347,
					"content": "ダイン…ダインスレイヴじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090348
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090348,
					"content": "…近くで盗み聞きするだけじゃなく、やっと俺たちの話に参加していただける気になったようだ。既にモンドで面識があったよな、ダインスレイヴ…で合っているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090349
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090349,
					"content": "俺のことを知っているのなら、旧知と言っていいだろう。ガイア·アルベリヒ…アビス教団創立者の末裔よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090350
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090350,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090351
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090351,
					"content": "アビス教団…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090352
					]
				},
				{
					"id": 80090352,
					"content": "なんだって！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090353
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090353,
					"content": "貴様は今までこのことを知らなかったのだろうな。でなければ、ああも堂々とその苗字を口にはしなかったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090354
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090354,
					"content": "まったく、この苗字にそんな「面倒事」が隠されていたとはな…だが、これで俺の推測は裏付けられた。父が俺をモンドに残した原因はこれか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090355
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090355,
					"content": "こうもあっさり受け入れるとはな。しかも、何の疑いもなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090356
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090356,
					"content": "ああ、ちょうど俺の頭の中にあるいくつかの疑問を解決してくれたからかもしれないな。それに…俺はお前のその瞳が何なのかを知っている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090357
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090357,
					"content": "お前はもっとも純粋な血を持つカーンルイア人、だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090358
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090358,
					"content": "よく頭の回るやつだ。率直に言わせてもらうが、貴様が先ほどこいつに言った言葉、それを裏切るなよ。貴様がその本心を保ち続けることを願っているぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090359
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090359,
					"content": "ガイア…おまえ、まさかアビス教団のやつらとなにか関係があるわけじゃないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090360
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090360,
					"content": "おいおい、話が急にシリアスになりすぎじゃないか？モンド人の俺は、そういうのに慣れていないんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090361
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090361,
					"content": "血筋の由来を知ったところで、それがどうしたっていうんだ？俺が血筋なんかに縛られるやつに見えるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090362
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090362,
					"content": "そう心配するな。これまで同様、機会があれば俺は喜んでアビス教団の連中を懲らしめてやるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090363,
						80090364
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090363,
					"content": "信じるよ、ガイア。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090365
					]
				},
				{
					"id": 80090365,
					"content": "おっと、そろそろ時間だな。香料を扱っている商人と商談の約束があるんだ。先に失礼するぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090366
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090366,
					"content": "そうなのか…じゃあまたな、ガイア。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090367
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090367,
					"content": "ああ、またな。それとダインスレイヴさん、今度酒場で会ったら奢ってやるよ。ただ横で人の話を聞いてるだけなんてもったいないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090368
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 80090368,
					"content": "ふん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090369
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090369,
					"content": "ダインはガイアのこと信用してないのか…二人とも同じカーンルイア人なのに、まるで水と油みたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090370
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090370,
					"content": "俺はあいつのことをまだよく知らない。ゆえに今すぐ結論を出しても意味のないことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090371
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090371,
					"content": "血筋は…果たして本当に人に何の影響ももたらさないのか。俺はそれに疑問を抱いてるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090372,
						80090373
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090372,
					"content": "そういえば、アビス教団を創立したのって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090374
					]
				},
				{
					"id": 80090374,
					"content": "#貴様の血縁者がアビス教団に{M#姫}{F#王子}と呼ばれているのは、まさにこの「継承」に関係してのことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090375
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090375,
					"content": "えっと…でなきゃ、アビス教団の「王」って呼ばれるべきだからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090376
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090376,
					"content": "今回、スメールには何しに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090377
					]
				},
				{
					"id": 80090377,
					"content": "「運命の織機」を追うためだ。この名をまだ覚えているか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090378
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090378,
					"content": "おう。モンドにいた頃、オイラたちが発見したアビス教団の計画のことだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090379
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090379,
					"content": "何か新しい手がかりがあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090380
					]
				},
				{
					"id": 80090380,
					"content": "いや、新しい手がかりとは言えない。ただ…ずっと記憶の摩耗に抗えずにいたというのに、少し前に傷を癒していたところ、偶然にもいくつかのことを思い出してな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090381
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090381,
					"content": "#当時、貴様の血縁者と共に旅をしていた時、{M#彼女}{F#彼}から同じ言葉を聞いていたんだ…「運命の織機」をな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090382,
						80090383
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090382,
					"content": "そんな早い頃に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090384
					]
				},
				{
					"id": 80090384,
					"content": "ああ、俺の記憶とあの言葉が結びついた時には些か驚いた。その記憶によると、あれは当時の俺たちが共にスメールまで旅をしていた頃のことだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090385
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090385,
					"content": "#つまりダインは、そのとき{M#妹}{F#お兄}さんがそれを口にした場所を調べようとしてるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090386
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090386,
					"content": "そうだ。この「概念」が現れたのには、必ず何らかのきっかけがあったはずだ…俺の記憶が正しければ、それはスメールのアビディアの森のどこかだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090387
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090387,
					"content": "じゃあ、さっそく向かおうぜ。数百年も埋もれてた秘密がオイラたちを待ってるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090388
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090388,
					"content": "いや、今はまだその時ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090389,
						80090390
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090389,
					"content": "アビス教団のことを心配してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090391
					]
				},
				{
					"id": 80090391,
					"content": "違う、ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090392
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090392,
					"content": "俺の頼んだ酒がまだだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090393
					],
					"speakerTitle": "ダインスレイヴ"
				},
				{
					"id": 80090393,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80090394
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 80090394,
					"content": "ダインがお酒を飲み終えた後、一行はアビディアの森へ向かうことになった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 80090390,
					"content": "何らかのタイミングを待つ必要があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090391
					]
				},
				{
					"id": 80090383,
					"content": "数百年前から存在してたってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090384
					]
				},
				{
					"id": 80090373,
					"content": "#{M#俺}{F#私}の血縁者が創立者だと思ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090374
					]
				},
				{
					"id": 80090364,
					"content": "きっと…大丈夫なはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090365
					]
				},
				{
					"id": 80090328,
					"content": "これもただのおしゃべり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090329
					]
				},
				{
					"id": 80090311,
					"content": "ガイアが怖がる人なんて本当に存在するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090312
					]
				},
				{
					"id": 80090307,
					"content": "#{M#俺}{F#私}たちもガイアに会いたかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80090308
					]
				}
			]
		},
		{
