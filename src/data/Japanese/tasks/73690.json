					"ダヤ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736900101,
					"content": "こんにちは！クシャレワー学院のダヤです！あなたも学院フェスに参加しにいらしたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900102,
					"content": "こちらは私たちの学院が企画した遊び——「ルート構想計画」ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900103,
					"content": "どうですか？試してみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900104,
					"content": "たしか、クシャレワー学院の研究は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "私たちの学院の研究は、ほとんどがギミックや建築などに関わるものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900107,
					"content": "コホン、話が逸れてしまいましたね…今回の学院フェスに参加するため、我が学院の多くの学生がみんなで知恵を絞りました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900108,
					"content": "そのすえに、「ルート構想計画」という遊びを考案したのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900109,
					"content": "簡単に言うと、プレイヤーはこちらが用意した様々なアイテムを使ってルートを作る必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900110,
					"content": "橋を架けたり、階段を設置したり…最終的な目標は、人が通れるようにしたうえで、目的地にたどり着けるルートを作ることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900111,
					"content": "道の構築が完了した後、私たちが最終的な検証を行います…建物を建てたあとの検収みたいなものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900112,
					"content": "とにかく、安全なルートを作ることができれば目標クリアとなりますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900113,
					"content": "なんだか難しそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "ふふ、心配することはありません。現実世界で建てるわけではありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900116,
					"content": "たとえ失敗して、ルートが崩れてしまっても大丈夫ですよ。作り直せばいいだけですから。試行回数の制限も設けていません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900117,
					"content": "想像力を発揮して、あなたの思う美しいルートを作ればいいのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900118,
					"content": "試してみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "分かりました。それでは、まずこちらをご覧ください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900120,
					"content": "他に用事がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "そうですか…大丈夫ですよ！学院フェス期間中、私たちのブースはずっと開いていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900122,
					"content": "試してみたい時は、いつでも来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ダヤ"
				},
				{
					"id": 736900114,
					"content": "建築の才能はあんまり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
}