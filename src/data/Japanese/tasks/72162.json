			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"藤原俊子",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "あ、ありがとう、ふぅ…あいつら、あんな不意打ちで襲ってくるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620102,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "私は藤原俊子、今ここで…えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620105,
					"content": "まあいいっか、助けてくれたし…教えてあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620106,
					"content": "実は、私はここで先祖の残したお宝を探してるの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620107,
					"content": "お、お宝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721620108,
					"content": "見つけたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "あははっ、もちろん。手がかりに沿って宝の場所を見つけたわ。入る方法もね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620110,
					"content": "でも…装置を起動して中に入ろうとしたら、あの魔物たちに襲われたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620111,
					"content": "君たちが魔物を倒してくれて本当に助かった。ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620112,
					"content": "それで…その…悪いんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620113,
					"content": "もう少しの間、私のことを守ってくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620114,
					"content": "私はまだ宝を探さなきゃならない。でも周りには魔物もいるし、私一人では太刀打ちできない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620115,
					"content": "もし手伝ってくれるのなら…お宝を君たちにも分けるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620116,
					"content": "本当にお宝なんてあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "絶対に見つかる！私を信じて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620119,
					"content": "お宝が隠されている場所に入るための装置も見つけたの、あそこよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620120,
					"content": "でもあの装置、直接は開けられないの。特殊な方法を使わないといけないみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620121,
					"content": "たしかに私の手元には、この仕組みを解く手がかりになりそうな、先祖の残した図があるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620122,
					"content": "でも…あはは…それでもどうやって開けるか分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620123,
					"content": "あっ、君たちも見てみてよ。もしかしたら何か分かるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620124,
					"content": "はぁ、この装置、どうやって解くんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620117,
					"content": "本当に見つかる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620103,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				}
			]
		},
