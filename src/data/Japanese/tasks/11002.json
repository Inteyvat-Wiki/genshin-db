			"dialogs": [
				{
					"id": 110020201,
					"content": "この辺りがいいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020202
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020202,
					"content": "食材はなにを使うか、もう決まってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110020203,
					"content": "もちろん決まってないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020204,
					"content": "その当たり前でしょ、みたいな態度はなんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110020205,
					"content": "へへっ、これがアタシのスタイルなんだ。作る前から何を作るか決めていたら、驚きが生まれないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020206,
					"content": "だから、どんな食材を探すかは決めないの、驚きのためにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020207,
					"content": "適当すぎないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110020208,
					"content": "安心して、「万民堂」の看板料理は、どれもこんな感じでできたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020209,
					"content": "とりあえず、この辺を散策してみよう。何か気になるものがあったら教えるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				}
			]
		},
		{
			"id": 1100207,
			"completionStepIds": [
