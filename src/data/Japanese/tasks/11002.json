			},
			"dialogs": [
				{
					"id": 110020701,
					"content": "まだ何かが足りない気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020702,
						110020703
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020702,
					"content": "何だろう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				},
				{
					"id": 110020704,
					"content": "うん、「ピキーン」って感じが足りないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020705
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020705,
					"content": "そう言われたら、確かに「ピキーン」が足りないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020706,
						110020707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110020706,
					"content": "「ピキーン」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020708,
					"content": "えっへん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110020709,
					"content": "ブロックさんは保守的だけど、その実力は本物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020710
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020710,
					"content": "きっと、とっておきの食材で勝負を仕掛けてくるはずだよ。勝ちたければ、誰も見たことないような料理を作らないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020711
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020711,
					"content": "たとえば、海獣の肉の和え物とか、清心の花の炒め物とか、キノコとスライム炒めとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020712
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020712,
					"content": "キノコとスライム炒め！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110020713,
					"content": "あははっ、少し変わってるのは認めるけど、味は最高なんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020714
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020714,
					"content": "今度、時間があったら作ってあげるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020715,
						110020717
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020715,
					"content": "食べてみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020716
					]
				},
				{
					"id": 110020716,
					"content": "えへへっ、味は保証するよ。見た目はちょっとあれだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020719,
					"content": "あっ、そういえば、前に行きそびれた場所があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020720
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020720,
					"content": "何かいいものが隠されてるって、アタシの直感が言ってるの。行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020717,
					"content": "え、遠慮する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020718
					]
				},
				{
					"id": 110020718,
					"content": "ええっ？美味しいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110020707,
					"content": "パイモンは分かるの！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020703,
					"content": "インパクトかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				}
			]
		}
	]
