			},
			"dialogs": [
				{
					"id": 240140101,
					"content": "…この辺の魚たち、また減ってる。まさかメカフィッシュがまたのさばってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140102,
					"content": "稚魚をもっと水の深い水域に放流しないと。ああ、よりによってこんな時に潜水服が壊れるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140103,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "あら、初めまして、私はリノレアっていうの。環境問題を専門とする記者をやっていてね。ここで…稚魚を放流していたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140105,
					"content": "記者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "そっ、あなたたちもよく知ってるあの記者よ。でも私は公人のゴシップ記事とか、つまらない情報を垂れ流すような記者とは違うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140107,
					"content": "私が今取り組んでるのは、フォンテーヌ廷内で今まさに発生しているものよ。公共生活の安全を脅かすような重大な事件なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140108,
					"content": "で、その出来事が、私がここで稚魚を放流している理由でもあるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140110,
					"content": "…あなたは「メカフィッシュ」に関する話を知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140111,
					"content": "初めて聞いた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "フォンテーヌ廷の固有の魚類？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "どうして稚魚を放流してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140110
					]
				}
			]
		},
