			},
			"dialogs": [
				{
					"id": 240140801,
					"content": "メカフィッシュ…許さないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140802,
						240140803
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140802,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				},
				{
					"id": 240140804,
					"content": "修理は済んだんだけど、すぐにまた壊れちゃったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140805
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140805,
					"content": "このエリアにいるメカフィッシュ、まるで暴走してるみたいなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140806
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140806,
					"content": "さっき稚魚を放流したら、あいつらすぐに飛びかかってきて稚魚を呑み込んじゃったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140807
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140807,
					"content": "稚魚の何匹かが潜水服に引っかかってたせいで、メカフィッシュの一部が私めがけて襲いかかってきてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140808
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140808,
					"content": "私を攻撃したわけじゃないのは分かってるんだけど…やっぱり怖かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140809
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140809,
					"content": "そのあと、水の中で必死にバタバタもがいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140810
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140810,
					"content": "そしたら、いつの間にか潜水服に大きな穴が空いちゃってね…幸い、岸に近いところにいたおかげで何とか陸に上がってこれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140811
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140811,
					"content": "でも、これじゃしばらくは水中に潜って稚魚を放流できないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140812
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140812,
					"content": "旅人さん、また私の代わりに稚魚を放流してくれないかしら？深海エリアでも浅海エリアでもいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140803,
					"content": "潜水服は直ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				}
			]
		}
	]
}