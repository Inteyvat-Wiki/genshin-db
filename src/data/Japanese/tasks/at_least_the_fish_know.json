			"dialogs": [
				{
					"id": 240140601,
					"content": "私の代わりに稚魚は放流してくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140602
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140602,
					"content": "放流してきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140603
					]
				},
				{
					"id": 240140603,
					"content": "ありがとう！それじゃあ、潜水服の修理が終わったら仕事に戻るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140604
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140604,
					"content": "稚魚が大きく育ってくれるといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140605
					]
				},
				{
					"id": 240140605,
					"content": "安心して。各水域の生態系に応じて色々な種類の稚魚を用意したから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140606
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140606,
					"content": "さっきあなたが放流した稚魚は、ここの水域の状況に特化したものを選んであるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140607
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140607,
					"content": "しばらくしたら、もう何度か稚魚を放流するわ。あと私たちが雇った冒険者が到着後、このエリア内のメカフィッシュを一掃してもらうつもり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140608
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140608,
					"content": "今回、放流した稚魚が大きくなって、この水域の生態系を元に戻してくれると信じてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140609
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140609,
					"content": "十分な数の水域の生態系が回復したら、長編のレポートを書くつもりよ。「フォンテーヌ科学院」が自然環境に対してやったことを大衆に知らしめないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140610
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140610,
					"content": "待ってなさい、ダームスティア。今回はもう言い逃れする機会なんてないわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リノレア"
				}
			]
		},
		{
			"id": 2401407,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401401",
							"2"
						],
						"stepId": 2401401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リノレア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240140701,
					"content": "フン！このメカフィッシュはフォンテーヌ科学院が開発したマシナリー製品でしょ。フォンテーヌ廷の水域の生態系を破壊する元凶でもあるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140702
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140702,
					"content": "水域には、それぞれ釣り合いの取れた生態系というものが存在するの。色々な魚や生物がその中で秩序を保って生息しているのよ。その秩序ある生態系は、生物の繁栄にも優位に働くわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140703
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140703,
					"content": "もちろん、水域の秩序が乱れることもある…例えば、誰かがその水域で釣りをしたり、外来魚が侵入したり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140704
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140704,
					"content": "あるいは天候の変化があったりすれば、その水域から居なくなる魚もいるの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140726
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140726,
					"content": "つまるところ、水域の生態系は常に微妙なバランスを保っているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140705
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140705,
					"content": "でもね、フォンテーヌ科学院の愚か者どもがあの「メカフィッシュ」を開発して以来！すべてがめちゃくちゃになったのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140706
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140706,
					"content": "彼らは、この「メカフィッシュ」の役割はゴミや異物をきれいにして水源を清潔に保つことであって、それ以外の目的はないと喧伝していたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140707
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140707,
					"content": "最初、メカフィッシュは確かに水系を浄化していた。だから、こっちも研究員たちのデタラメを信じたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140708
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140708,
					"content": "でもしばらく経った頃、突然報告があったの。メカフィッシュを放した地域内のあらゆる魚たちの数が減り続けているってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140709
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140709,
					"content": "そのとき初めて、メカフィッシュはゴミをきれいにしたあと、他の魚類までゴミと見なして「掃除」していたことに気づいたのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140710,
						240140711
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140710,
					"content": "「水源の浄化」ってそういうことだったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140712
					]
				},
				{
					"id": 240140712,
					"content": "私たちの猛抗議によって研究員はようやくメカフィッシュをすべて停止させ、回収の準備を始めたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140713
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140713,
					"content": "でも、彼らが回収準備をしているとき、フォンテーヌ科学院全体で大きな爆発が起こったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140714
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140714,
					"content": "その後、停止していたはずのメカフィッシュの一部が再び活動を始めて、同じ水域内の魚たちを激しく攻撃し始めたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140715
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140715,
					"content": "私と同僚の何人かは、メカフィッシュの破壊行動をこのまま放っておいたら、フォンテーヌ廷内の水域の生態系が壊滅的な被害を受けて大変なことになると考えたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140716
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140716,
					"content": "そこで私たちは、何人かの生態環境専門家に協力を仰いだの。それで計画的に各水域に適切な「稚魚」を放流して、人工的に魚群を養殖することにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140717
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140717,
					"content": "それと並行して、冒険者を雇ってメカフィッシュの破壊と回収を継続的に行ってもらう。二つの方面から押し進めることで水域の生態系を守ろうとしたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140718,
						240140719
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140718,
					"content": "すごいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140720
					]
				},
				{
					"id": 240140720,
					"content": "ふふ、ありがとう。もしかしたら一介の記者がやるようなことじゃないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140721
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140721,
					"content": "でも文章を書く以前に、記者っていうのは真っ先に最前線に出て、身をもって物事を実践すべきだと思うのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140727
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140727,
					"content": "そういう真なる実態から一番リアルで役立つ情報を得ることで、優れた記事が書けるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140722
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140722,
					"content": "おお…すごい意気込みの記者だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240140723,
					"content": "何か手伝えることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140724
					]
				},
				{
					"id": 240140724,
					"content": "あら？親切にありがとう。実は潜水服が壊れちゃって、水の中に入れなくなっちゃったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140725
					],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140725,
					"content": "もし可能なら、私の代わりに稚魚を放流してくれないかな…深海エリアでも、浅海エリアでも構わないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リノレア"
				},
				{
					"id": 240140719,
					"content": "尊敬すべき事業だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140720
					]
				},
				{
					"id": 240140711,
					"content": "「水」以外は全部ゴミってこと…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140712
					]
				}
			]
		},
		{
			"id": 2401408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
