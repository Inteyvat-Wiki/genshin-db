			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"歩雲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "（刻晴に言われた通りだと、たしか…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210302,
					"content": "こんにちは、月は売ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210303,
					"content": "はい、数はどうします？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "歩雲"
				},
				{
					"id": 10210304,
					"content": "それは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210305,
					"content": "正解です、ここからどうぞ。お二人は凝光様が本日招待したお客様ですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "歩雲"
				},
				{
					"id": 10210306,
					"content": "その通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210307,
					"content": "（けど、今のは「客人」の暗号ではなく、「玉衡限定」の暗号…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歩雲"
				}
			]
		},
		{
			"id": 102104,
			"completionStepIds": [
				102104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
