			"dialogs": [
				{
					"id": 10210201,
					"content": "ん？すごく甘い匂いがするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210202,
					"content": "それに…何か聞こえないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210203,
					"content": "助けを呼んでる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "おう、あそこの遺跡からだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210207,
					"content": "…あっ、あの宝盗団たちが誰かを閉じ込めてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210205,
					"content": "誰かの歌声かな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "違う、助けを呼んでるぞ！あそこの遺跡からだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 102103,
			"completionStepIds": [
				102103
			],
