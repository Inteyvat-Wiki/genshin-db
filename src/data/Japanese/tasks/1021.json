			},
			"dialogs": [
				{
					"id": 10211301,
					"content": "「魔神戦争」は聞いたことあるわね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211302,
						10211303
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211302,
					"content": "よく知らない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				},
				{
					"id": 10211304,
					"content": "かつて魔神が数多といて、長い戦争があった。たくさんの血が流れ、2000年前に戦争は終わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211305
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211305,
					"content": "テイワット大陸に残った7人の勝者は、敗者の残骸の上で国や城を作り、七神の時代が始まった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211306
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211306,
					"content": "「孤雲閣」は見えるかしら？あれは自然にできた景観ではなく、帝君が戦時中に投げた岩の槍よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211307
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211307,
					"content": "岩の槍の下には、七神の座を手に入れられなかったかつての魔神が封印されてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211308
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211308,
					"content": "魔神だけでなく、「俗世の七執政」も死ぬことはあるわ。帝君の逝去は璃月にとって想像できないけど、テイワットの七神は…崩れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211309
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211309,
					"content": "次の岩神が現れる、けれど帝君のことは忘れないわ。その時、璃月の人々と仙人の関係は、きっと昔とは違うでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211310
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211310,
					"content": "新たな時代でも「璃月七星」は帝君の民よ。帝君に刃向かうなんて…するわけないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211311
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211311,
					"content": "じゃあ、なぜ「仙祖の亡骸」を隠した？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211312
					]
				},
				{
					"id": 10211312,
					"content": "ふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211313
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211313,
					"content": "あの日のこと、あまりにも突然で対応しようがなかった。その場にいたなら、分かるわよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211314
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211314,
					"content": "七星の敵はとうに璃月港にいる。厄介なことになる前に、行動しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211315
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211315,
					"content": "だから私は仙祖の亡骸を隠して、敵の行動にけん制を仕掛けたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211316
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211316,
					"content": "その「敵」って誰のこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10211317,
					"content": "さあ、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211318,
						10211319
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211318,
					"content": "まさかあの人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211320,
					"content": "ん？なぞなぞでもしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10211321,
					"content": "正解よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211322
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211322,
					"content": "ん——？？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10211323,
					"content": "はぁ…外の景色は綺麗だけど、高い場所にいるとやはり風が強いわ。さあ、二人とも中へどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 10211319,
					"content": "なんとなくわかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "言葉だけ知ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
