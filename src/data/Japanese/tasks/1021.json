				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "待ってたわ、絶雲の間から帰った人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210402,
					"content": "あー、凝光だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210403,
					"content": "はじめまして、プレゼントを用意したんだ、気に入ってくれると嬉しいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210404,
					"content": "私に？どうも。招待したのは私なのに、却って迷惑だったかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210405,
					"content": "そんなことないぞ、へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210406,
					"content": "「群玉閣」は綺麗だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "ふふっ、気に入ってもらえて嬉しいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210409,
					"content": "この宮殿の位置は全ての山よりも高く、ここから璃月港の全貌を見ることができるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210410,
					"content": "商売を始めた時から、この宮殿を作るための資金を集めてきた。「天権」になった後、凄腕の職人たちに依頼して増築を続け…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210411,
					"content": "最初、部屋一つ程度の広さだった群玉閣も、今や璃月上空の月を覆い隠すほどになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210412,
					"content": "そして、いつか七国を覆うことになると…私は信じてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210413,
					"content": "（この「天権」様は野心家だ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "「群玉閣」に登れる客人はそう多くない。西風騎士団の代理団長は手紙の中であなたを褒めてたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210415,
					"content": "だから、あなたが璃月に着いた日から、私はあなたを探した…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210416,
					"content": "なにッ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210417,
					"content": "そしてあなたたちが望舒旅館についた時に、あなたたちの動向を把握した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210418,
					"content": "まさかオーナーって七星の部下なのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210419,
					"content": "違うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210420,
					"content": "望舒旅館の者全員、私たちの部下よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210421,
					"content": "##%^%*&……！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210422,
					"content": "少し前、「玉衡」にも会った…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "帰終機のところで、そうよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210424,
					"content": "ずっと上で見てたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210425,
					"content": "ふふっ…こんな距離から盗み見はできないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210426,
					"content": "…「耳目」の働きよ。あなたたちに興味がある、関心を持つのも当然よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210427,
					"content": "刻晴が、七星は帝君を殺害してないって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "ええ、仙人と付き合いのあるあなたが、私たちを信じないのも分かる。今回は誤解を解くために招待したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210408,
					"content": "こんな高いところは初めて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
			"completionStepIds": [
				102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102106",
							"2"
						],
						"stepId": 102106,
						"stateName": "QUEST_STATE_UNFINISHED"
