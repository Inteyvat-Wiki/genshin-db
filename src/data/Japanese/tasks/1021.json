					"nextDialogs": [
						10211106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10211106,
					"content": "そうだ、他の物も見ていいか？借りられるものがあったら借りたいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211107
					],
					"speakerTitle": "パイモン"
				},
				{
