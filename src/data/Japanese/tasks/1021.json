				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210601,
					"content": "うわーー！すっごく広い！こんな豪華な部屋は初めて見た…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210602,
					"content": "楽にして、我が家のように思っていいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210603,
					"content": "いいのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210604,
					"content": "ええ、ここに招待したのはあなたたちと友人になりたいからよ。かしこまらなくていいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210605,
					"content": "あれは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "ん？これが「伝説のあの壁」か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210607,
					"content": "あら？知ってるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210608,
					"content": "講談師が言ってたんだ…その壁の紙はみんな欲しいってさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210609,
					"content": "その壁には璃月の秘密があるからよ。商売人は秘密を知りたがるもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210610,
					"content": "でも旅人、璃月商業の秘密はあなたにとって意味ないものよね。あなたは特別、あなたも理解してるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210611,
					"content": "できれば、信頼してほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210612,
					"content": "もし私と刻晴のうち、信頼できる相手を選ぶなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210613,
					"content": "凝光と刻晴なら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "…ふふっ、刻晴を選ぶわよね？それくらい、分かってるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210616,
					"content": "気の強すぎる彼女が七星になっても、私のフォローは必要だと思ってたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210617,
					"content": "「『仙人』の時代は終わった。『璃月七星』さえもそれを受け入れなければ、璃月の未来はどうなる？」と彼女が言った後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210618,
					"content": "私の心にあった迷いは消えたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210619,
					"content": "確かに帝君の逝去は七星にとって有益ね。でも璃月のためには、「七星簒奪」のデマに縛られてはいけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210620,
					"content": "そのデマの裏にはファデュイがいると？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "ええ…さっきから、あなたは私の意図が分かってるのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210622,
					"content": "情報を封鎖し、亡骸を隠したのは形勢を安定させるため…モンドのようなことは避けたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210623,
					"content": "ファデュイは帝君の死を理由に、外交の一線を越えようと数多くの暗躍をしているわ。私も璃月の「天権」として、本気で抵抗しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210624,
					"content": "「送仙儀式」を許可したのも、七星が璃月を全面管理するための時間稼ぎ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210625,
					"content": "むぅ…七星が儀式を許可したのは、オイラたちを利用して目的を果たすためだったのか、鍾離の言った通りだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210626,
					"content": "そうだ！「目的を果たす」と言えば…言ってもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210627,
					"content": "構わないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210628,
					"content": "手土産をあげたら、お返しがもらえるって聞いたけど…どうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210629,
					"content": "パイモン、空気を読んで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "ふふふっ…いいわ、素直な人は好きよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210631,
					"content": "あなたたちにはたくさん迷惑をかけたもの。そのお詫びとして、ここから好きなものをひとつ選んでいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10210632,
					"content": "やったー！待ってたぞ！オイラが欲しいのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210633,
					"content": "あの壁にある<color=#00E1FFFF>紙切れ</color>だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210634,
					"content": "？？？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "そんな目で見るなよ！あの壁の紙切れはたとえ爪の大きさでもすごい金になるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210636,
					"content": "それが丸々1ページだったら…ううっ！想像できないほどの大金だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10210614,
					"content": "やはり刻晴の「不敬」の方が信頼できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
