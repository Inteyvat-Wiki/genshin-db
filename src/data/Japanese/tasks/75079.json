			"dialogs": [
				{
					"id": 750791901,
					"content": "本当、困ったものね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791902,
						750791905
					],
					"speakerTitle": "リヴァ"
				},
				{
					"id": 750791902,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791903
					]
				},
				{
					"id": 750791903,
					"content": "ええ、実は年の離れた弟がいるんだけど、反抗期なのか、誰とも仲良くできなくって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791904
					],
					"speakerTitle": "リヴァ"
				},
				{
					"id": 750791904,
					"content": "あっ…こんなことあなたに話しても仕方ないよね。きっともう少し大きくなったら、良くなるはずだわ、うん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リヴァ"
				},
				{
					"id": 750791905,
					"content": "邪魔しちゃったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791906
					]
				},
				{
					"id": 750791906,
					"content": "ううん、気にしないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リヴァ"
				}
			]
