			"dialogs": [
				{
					"id": 750790701,
					"content": "ここは人生の先輩として、そして兄として、グループに溶け込み人気者になる方法をしっかり教えてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750790702,
					"content": "気持ちはありがたいけど、大丈夫。それに、君は僕のお兄さんじゃないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790703,
					"content": "あと、これ以上オベロンにビスケットをあげるのはやめてくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790704,
					"content": "クワ…クゥ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750790705,
					"content": "はぁ、物分かりの悪い子だな。タルカのお姉さんがリヴァじゃなきゃとっくに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750790706,
					"content": "あの、賞品を受け取りにきたんだけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "キュイ！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "おっ、これは珍しいお客さんだ、ここじゃテペトル仔竜はあまり見かけないっていうのに。それにそっちの子は…ほう、いろんな品種のやつを仲間にしてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750790709,
					"content": "#品種って…オイラは{REALNAME[ID(2)|SHOWHOST(true)]}とは違うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790710,
					"content": "キュイ？クルル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#え？いやいや、確かにオイラたちは{NICKNAME}の仲間だけど、全く同じじゃないだろ。えっと…その、違うっていうのは、誰が良いとか悪いとかじゃなくって…だから気にすんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790712,
					"content": "無意識に出た本音は命取りになる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#{NICKNAME}、変な意味で言ったんじゃないってわかってるだろ、問題をややこしくするなって。{REALNAME[ID(2)|SHOWHOST(true)]}もオイラたちの大切な仲間だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790714,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}も大切な仲間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "キュ？キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#へへっ、{REALNAME[ID(2)|SHOWHOST(true)]}は賢いやつだから、オイラのことを誤解しないってわかってたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790717,
					"content": "いやぁー、本当に羨ましい絆だね。あんたらの装いからすると、ここら辺の人じゃなさそうだけど、テペトル仔竜とそうも深い信頼と友情を築けるなんて、何か秘訣でもあるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750790718,
					"content": "実は、タルカとその仲間のクク仔竜は、上手くいってないんだ。もし仲良くなる秘訣があるのなら、ぜひ教えてあげて欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750790719,
					"content": "僕のことより…この人たちの賞品は？まさか、まだ用意してないわけじゃないよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790720,
					"content": "いやいや用意してあるさ！まさかタルカに話題をそらされるとはな。まあ、この話はまたあとにしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750790721,
					"content": "もうすぐ飛行コンテストも開催される。もし興味があったら観ていってくれ。このオレの素晴らしいパフォーマンスもな！じゃあ、まだ用事があるから、これで失礼するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラミザナ"
				}
			]
		},
