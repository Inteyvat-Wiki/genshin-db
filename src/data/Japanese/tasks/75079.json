					}
				]
			},
			"dialogs": [
				{
					"id": 750790901,
					"content": "こんなに簡単に賞品がもらえるなんて…冒険者協会の依頼もこれくらい楽チンだったらいいのにな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790902,
					"content": "#{NICKNAME}{M#お兄さん}{F#お姉さん}たちは、冒険者なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790903
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790903,
					"content": "#冒険の証を持ってるのは{M#俺}{F#私}だけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790904
					]
				},
				{
					"id": 750790904,
					"content": "#ふん、証がなくたって、冒険者の心は持ってるぞ。飛行免許がなくても、飛行技術に関しちゃ{NICKNAME}に負けないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790905,
					"content": "そんなことを聞くってことは、オイラたちになにか依頼したいことでもあるのか？待てよ、言わないでくれ。オイラが当ててみるぞ、ずばり——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790906,
					"content": "#オイラたちと{REALNAME[ID(2)|SHOWHOST(true)]}がこんなに仲が良いのを見て、仔竜と仲良しになる秘訣を教わりたいんだな！そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790907
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790907,
					"content": "キュー！キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790908
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790908,
					"content": "はぁ、全然違うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790909
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790909,
					"content": "ええっ？でも、さっきラミザナが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790910,
					"content": "全部ラミザナのせいなんだ。人の心を掴むのが得意で、オベロンまで彼のちび竜ビスケットを食べて、ラミザナの言うことを何でも聞くようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790911
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790911,
					"content": "クワッ、クウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790912
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750790912,
					"content": "そんな被害者面をしてもダメだよ。一流のクク竜になるには、もっとちゃんとした食事制限すべきなんだから。それに君は太りやすい体質だし、なおさらね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790913
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790913,
					"content": "あいつは、リヴァ姉さんにもちょっかいを出してる。きっと何か企んでるんだ…リヴァ姉さんも、警戒心がなさすぎるよ。あんなやつと楽しげに話しちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790914
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790914,
					"content": "ん？話を聞く限りだと、性格の良さそうなやつに聞こえるけど…もしかしておまえ、単にラミザナが嫌いで、偏った見方をしてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790915,
					"content": "いや、それだけじゃないよ。あいつ、最近なんだかコソコソしてるんだ。一体、何をしてるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790916
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790916,
					"content": "大人にはいろいろあるんだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790917
					]
				},
				{
					"id": 750790917,
					"content": "そうそう。飛行コンテストを開催するって言ってたし、その準備をしてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790918
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790918,
					"content": "さっき飛行コンテストを開催するって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790919
					]
				},
				{
					"id": 750790919,
					"content": "でも、あの人はあんまり力を入れてないし、準備だって全部パランがやってる。ここ最近、彼と犬のガレフがあちこち忙しそうに走り回ってるのをよく見るから、苦労してるのはパランのほうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790920
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790920,
					"content": "それに昨日聞いたんだ！よそから来た人と、何か危なそうなことを小声で話してた。近づくのが怖くて、全部は聞き取れなかったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790921
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790921,
					"content": "「飛行コンテスト当日は時間通りに」、「手加減して…」、「命には…」、「無事に終わったら残りの半分を払う」、「具体的な話は明日の深夜、北側の拠点で」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790922
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790922,
					"content": "後半になるにつれハッキリ聞こえてるね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790923
					]
				},
				{
					"id": 750790923,
					"content": "それはオベロンのおかげだよ。あの時、なぜかすごく落ち着きがなくて、ラミザナのほうに行きたがってたんだ。僕も止められなくって、それで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790924
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790924,
					"content": "クワッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790925
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750790925,
					"content": "バカ、褒めてるわけじゃないよ。とにかく、竜を追いかける僕を見て、もうひとりの人はすぐ立ち去ったよ。残ったラミザナの振る舞いも、どこか不自然だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790926
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790926,
					"content": "きっとバレるのを恐れて、今日わざと僕にちょっかいをかけてきたんだ。もっともらしい理由をつけて、僕を監視するために…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790927
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790927,
					"content": "おまえってまだ子供なのに、よくそんなことまで考えられるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790928
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790928,
					"content": "分かってるよ、君も子供の言うことは信用できないとか思ってるんでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790929
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790929,
					"content": "#だから、{NICKNAME}{M#お兄さん}{F#お姉さん}にお願いしたいんだ。夜になったら、一緒に北側の拠点を調べてほしい。もしかしたら、本当に何か危険な計画を立ててるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790930
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790930,
					"content": "#そんなの絶対止めないと！{NICKNAME}{M#お兄さん}{F#お姉さん}が証人になってくれれば、他の人も…リヴァ姉さんもきっと信じてくれるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790931
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790931,
					"content": "もし僕の話をただの子供の妄想で、わざわざ行く必要のないものだと思うなら、せめて手紙だけでも届けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790932
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790932,
					"content": "状況を説明する手紙をもう書いてあるんだ。もし明日、僕が戻らなかったら、その手紙をリヴァ姉さんに渡してほしい。オベロンのお世話も、リヴァ姉さんに頼まなきゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790933
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790933,
					"content": "ちょ、ちょっと待ってくれ！なんかだんだん怖くなってきたぞ。まさかそんなことあるわけないよな…うーん、でももしホントだったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790934
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790934,
					"content": "#{NICKNAME}、やっぱり調べてみないか？このまま放っておいて、ホントになにかあったとき、悪夢を見ちゃいそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790935
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790935,
					"content": "#手伝ってくれるの？よかった！じゃあ、{NICKNAME}{M#お兄さん}{F#お姉さん}、夜になったら一緒に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790936
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790936,
					"content": "#{M#俺}{F#私}たちに任せて、タルカはここで待機。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790937
					]
				},
				{
					"id": 750790937,
					"content": "そうだな！こういう調査は、人が多いとかえって良くないし。ここでオイラたちの知らせを待っててくれ。ふふん、どうだ！冒険者の心得はバッチリだろ、オイラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790938
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790938,
					"content": "そう言われると…確かにそうだね。じゃあ、僕はここに残ってオベロンの世話をしてるよ。それと、リヴァ姉さんにも言っておかないと…ラミザナに近づかないようにって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790939
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750790939,
					"content": "それじゃ、頼んだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タルカ"
				}
			]
		},
