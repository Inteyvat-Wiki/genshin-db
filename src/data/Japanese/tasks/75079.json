					}
				]
			},
			"dialogs": [
				{
					"id": 750790301,
					"content": "#ようこそ！…ふむふむ、君たち二人のうち、少なくとも一人は飛行の要領を熟知しているようだね。となると、飛行技術を学びたいのは、そちらの{M#お兄さん}{F#お嬢さん}かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "テマジョ"
				},
				{
					"id": 750790302,
					"content": "もう飛行免許は持ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "飛行免許？それは初めて聞くものだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "テマジョ"
				},
				{
					"id": 750790305,
					"content": "ここでは人と竜が共に成長することを大事にしているんだ。君の仲間は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "テマジョ"
				},
				{
					"id": 750790306,
					"content": "キュ…キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "…あー、おちびちゃん。パパッカ飛行スクールは君の腕を発揮できる場所じゃなさそうだ。でも気にしないで、もちろん君のせいじゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "テマジョ"
				},
				{
					"id": 750790308,
					"content": "キュイ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}はまだ小さいし、伸びしろしかない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "いやいや、テペトル竜の伸びしろって言っても、クク竜やイクトミ竜と飛行を競えるもんじゃないだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750790311,
					"content": "#まぁ{M#お兄さん}{F#お嬢さん}、もし飛行訓練に興味があるんなら、ここのオープン訓練コースをぜひ体験してみてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "テマジョ"
				},
				{
					"id": 750790313,
					"content": "障害物の回避や柔軟な方向転換は、どれもクク竜を操るための必須スキルだ。君の今の実力は、訓練コースに挑戦すればすぐに分かるだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "テマジョ"
				},
				{
					"id": 750790312,
					"content": "実は、ここのことを多くの人に知ってもらえるよう、賞品を用意したり、コンテストを企画したりとかなりの手間を掛けたんだ。もしクリアできたら、ラミザナから賞品を受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "テマジョ"
				},
				{
					"id": 750790304,
					"content": "何を教えてくれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
