			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラミザナ",
					"タルカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "はぁ…その性格、直したほうがいいぞ。これはタルカのために言ってるんだ。もう子供じゃないんだし、お姉さんのためにも自分のためにも、よく考えろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750791702,
					"content": "クワッ…クワッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750791703,
					"content": "ほら、こいつもオレの言うことが正しいってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750791704,
					"content": "物分りの良さという点では、僕は君に負けないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750791705,
					"content": "くっ！この生意気な小僧め…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラミザナ"
				}
			]
		},
		{
			"id": 7507918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507909",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
