					"凪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "おかえり、薬草は採れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230902,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "ありがとう。私も小白を呼んで薬剤作りを手伝ってもらってるよ。さっそくこの薬剤を製粉所に持っていこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凪"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小白"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "…その薬剤も一緒に処理するね。処理が終わったら、薬作りに使えるようになるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718231002,
					"content": "うん、ありがとう。私は薬を甘くする方法を考えなきゃ。じゃないと、子供たちが嫌がるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718231003,
					"content": "毎年こんなに忙しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "うん…だって軽策荘には若い人が少ないから、私たちにできることはなるべく手伝うようにしてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718231005,
					"content": "この何日か耐えれば済む話だから、大丈夫だよ。それに、今年はあなたの手助けもあって、大分楽になったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718231006,
					"content": "以前は…薬草採りだけでも凄く時間がかかって、薬を作るなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718231007,
					"content": "とにかく、手伝ってくれて本当にありがとう。私たちも早く薬作りを終わらせて、霄灯に取りかからなきゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718231008,
					"content": "去年はほぼ霄灯のことを忘れてたから、今年はちゃんと忘れないようにしないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718231009,
					"content": "どんな願い事をするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "うーん…軽策荘の人たちが健康でいられるようにとか？えへへっ、まあそんなとこ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718231011,
					"content": "でも、願い事を口に出したら叶わないから、これ以上は言わないでおくね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718231012,
					"content": "これはあなたにあげる、今日1日手伝ってくれたお礼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凪"
				}
			]
		},
