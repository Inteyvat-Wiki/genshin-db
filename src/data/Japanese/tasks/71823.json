			"dialogs": [
				{
					"id": 718230701,
					"content": "ちょっと待て、まだハスの花托を採る時間じゃないみたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718230702,
					"content": "たしか…夜中の0時から朝の6時までだったよな…今は時間が違うみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7182308,
