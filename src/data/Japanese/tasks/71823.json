			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230201,
					"content": "うーん…やっぱり薬剤が足りないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230202
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230202,
					"content": "薬草採りに行くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230203
					]
				},
				{
					"id": 718230203,
					"content": "うん、今薬草採りに行くところだったの。毎年この時期になると、薬をたくさん用意するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230204
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230204,
					"content": "別にそんなに凄い薬でもないんだけどね…腸チフスを治療したり、消化を助ける薬なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230205
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230205,
					"content": "どうして不卜廬で買わないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230206
					]
				},
				{
					"id": 718230206,
					"content": "だってここから凄く遠いからだよ。ここから璃月港まで歩くのはとても時間がかかるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230207
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230207,
					"content": "それに、軽策荘にいるのはお年寄りと子供ばかりだから、冒険者のあなたみたいにたくさん歩くことはできないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230208
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230208,
					"content": "だから、もしもの時のために、私も事前に薬を用意してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230209
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230209,
					"content": "でも、もし本当に深刻な病気で、処方箋が必要な場合は、不卜廬に行くしかない…はぁ、そんなことにならないよう祈るしかないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230210
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230210,
					"content": "私は薬草採りに行くから、話はここまで。採り終わったらすぐ他のことをやらなきゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230211
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230211,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230212
					]
				},
				{
					"id": 718230212,
					"content": "えっ？手伝ってくれるの？嬉しい！正直一人でどれくらい採れるか心配だったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230213
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230213,
					"content": "えっと…今必要な薬剤はあと3つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230214
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230214,
					"content": "…1つは山頂に生えてる清心。栄養があって消化を助ける作用もあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230215
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230215,
					"content": "もう1つは川辺に生えてる新鮮なドドリアン。体内の湿気を調整する作用がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230216
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230216,
					"content": "あそこの川辺で採れるドドリアンは凄く良質な物なの。他の場所のだと薬の作用が薄くて…だから私はいつもそこで採ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230217
					],
					"speakerTitle": "凪"
				},
				{
					"id": 718230217,
					"content": "最後の1つは隣の池で採れるハスの花托。神経を落ち着かせ、心臓の働きを助ける作用がある。でも採る時にコツがいるの。夜中の0時から朝の6時までに採るのが一番いいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凪"
				}
			]
		},
		{
			"id": 7182307,
