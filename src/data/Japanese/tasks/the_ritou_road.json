			},
			"dialogs": [
				{
					"id": 728090108,
					"content": "やっと届いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090109
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090109,
					"content": "こんなに時間がかかって、まったく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090110
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090110,
					"content": "この箱の角が破れてるじゃないか、ああ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090111
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090111,
					"content": "気を付けろって言ったのに！中のものは割れてないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090112
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090112,
					"content": "よかった、瓶が割れなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090113
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090113,
					"content": "え？この瓶の蓋が緩んでるじゃないか…取ってから、閉めないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090114
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090114,
					"content": "コホン！コホン…、このお酒の材料の匂いが…強過ぎる、早く運ばないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090115
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090115,
					"content": "え、なに、なんでスライムがこんなにいるんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハリソン"
				}
			]
		},
		{
			"id": 7280902,
			"completionStepIds": [
				7280907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280907",
							"2"
						],
						"stepId": 7280907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハリソン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728090204,
					"content": "ありがとう、本当にありがとう、旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090205
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090205,
					"content": "お前に助けられなかったら、ここで死ぬかと思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090206,
						728090208
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090206,
					"content": "#この拠点、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}が作ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090207
					]
				},
				{
					"id": 728090207,
					"content": "え…まあ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090210,
					"content": "お前たちも知っているだろうが、この離島で商売をするのは大変だ。この拠点は…俺の商売のコツみたいなものだと言ってもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090211
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090211,
					"content": "こないだ、ある…友人に、モンドからお酒の材料を送ってくれと頼んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090212
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090212,
					"content": "彼はこの前友人に頼んで、「アカツキワイナリー」が新しく作った試作のお酒を手に入れてくれた。最近運んできたばっかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090213
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090213,
					"content": "でもあいつの手際が悪くて、箱がちょっと破れていた。中にお酒の材料を入れている瓶の蓋も緩んでいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090214
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090214,
					"content": "俺は蓋を取ってから閉めるつもりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090215
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090215,
					"content": "まさか、蓋を取ったら、スライムが駆け寄ってくるなんて。本当に訳が分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090216
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090216,
					"content": "「アカツキワイナリー」のお酒の材料か…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090217
					]
				},
				{
					"id": 728090217,
					"content": "まあいい。お酒の材料のことは、あいつが今度来る時に、落とし前をつけてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090218
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090218,
					"content": "お前たちに助けられたから、礼をしないと…これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090219
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090219,
					"content": "それ以外に、あそこの船を見たか？あれは俺のもう一つの…コツだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090220
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090220,
					"content": "あの船に乗れば、お前たちはここからこっそり鳴神島に行ける。へへ、とても便利だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090221
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090221,
					"content": "なんで「こっそり」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090222
					]
				},
				{
					"id": 728090222,
					"content": "あっ、とりあえず…いざっていう時のために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090223
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090223,
					"content": "さて、俺は戻って貨物の点検をするから、失礼するよ。もう一度礼を言う、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090224
					],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090224,
					"content": "貨物を受け入れる場所を変えないといけないようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハリソン"
				},
				{
					"id": 728090208,
					"content": "ここで何しているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728090209
					]
				},
				{
					"id": 728090209,
					"content": "俺は…貨物を運んでるんだ、ははは、貨物を運んでる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728090210
					],
					"speakerTitle": "ハリソン"
				}
			]
		}
	]
}