			"dialogs": [
				{
					"id": 740090301,
					"content": "どうか説明させてくれ…これは誤解なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "ヴァージル"
				},
				{
					"id": 740090302,
					"content": "ソニィさん…私たちはただこの商売が儲かりそうだと思って…でも上は許可してくれないし、だから仕方なく…ひと儲けしたら、収入を組織に納めようとしてたんだ、本当だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "ヴァージル"
				},
				{
					"id": 740090303,
					"content": "うぅぅっ、オイラを無視するなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090304,
					"content": "組織に不満なんかありゃしない…そうだ、私がこんなバカなことをしでかしたのも、あの悪者に騙されたからなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "ヴァージル"
				},
				{
					"id": 740090305,
					"content": "#なんて素晴らしいこと。{NICKNAME}さん、噂通りの凄腕でいらっしゃいますね。そう思いませんか、親愛なるルカさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090306,
					"content": "すごい。本当に強い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090307,
					"content": "過去のよしみに免じて…ソニィさん…ルカさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "ヴァージル"
				},
				{
					"id": 740090308,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090309,
					"content": "ああっ！やめ、やめてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "ヴァージル"
				},
				{
					"id": 740090310,
					"content": "#ルカさん、お客さんの面前で、あまり失礼なことをしないように。{M#彼たち}{F#彼女たち}に不快な思いをさせてはなりませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090311,
					"content": "了解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090312,
					"content": "ふん！ヴァージル、悪事を働いたことを反省してるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090313,
					"content": "ああ、全部私のせいだ、私が悪かった…どうか許してくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "ヴァージル"
				},
				{
					"id": 740090314,
					"content": "しっかり反省してるならいいぞ。二度と同じマネをするんじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090315,
					"content": "#パイモンさん、{NICKNAME}さん——親愛なるヴァージルさんが二度とそんなことをしないと、この「白手袋」のソニィ、そして私の父と息子の名誉に誓って保証いたしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090316,
					"content": "行こう、パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "おう！ありがとな、ソニィ、ルカ。やっぱりフォンテーヌには悪いやつよりいい人のほうが多い気がするぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090321,
					"content": "#さようなら。また手を組む機会があることを願っています。親愛なるパイモンさん、{M#尊敬する紳士}{F#可愛らしいお嬢さん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090322,
					"content": "ひぃっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァージル"
				},
				{
					"id": 740090317,
					"content": "どうするつもりなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#世間を生きながら、すべてを分かりきってしまえば、あまりに面白くないでしょう？{M#尊敬する紳士}{F#可愛らしいお嬢さん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090319,
					"content": "もしどうしても知りたいなら、まずは彼とゆっくり…お話をするつもりです。これ以上、あなた方の時間を無駄にしないでおきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "ソニィ"
				}
			]
		},
