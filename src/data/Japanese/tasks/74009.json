			"dialogs": [
				{
					"id": 740090201,
					"content": "#{M#尊敬する紳士}{F#可愛らしいお嬢さん}、それに親愛なるパイモンさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090202
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090202,
					"content": "こちらを見てください。ヴァージルが最近拠点として使っている場所です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090203
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090203,
					"content": "ったく、ヴァージルの兄貴はなんでまだ帰ってこないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "ちょっとガラが悪そうに見える人"
				},
				{
					"id": 740090204,
					"content": "これ以上待たされたら、もう我慢できんぞ…これらのロシを飲まずにはいられないっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "ちょっと危険そうに見える人"
				},
				{
					"id": 740090205,
					"content": "おい、ふざけんな！どんだけ苦労して手に入れたもんだと思ってる。勝手なマネしたら、ヴァージルの兄貴にコテンパンにされるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "ちょっと不真面目に見える人"
				},
				{
					"id": 740090206,
					"content": "残念、親愛なるヴァージルはまだ帰ってきていないようですね。なら、先に彼らと「お話」をしてみましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090207,
					"content": "えっと、あいつら…話に付き合ってくれそうに見えないんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090208,
					"content": "そうとも限りませんよ。あなたはどう思います、親愛なるルカさん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090209,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090210,
					"content": "おい！ホントかよ？あいつら、飛びかかってきそうな気がするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090211,
					"content": "おや！なんという思慮深さでしょう、親愛なるパイモンさん。もしそのようなことが起きてしまったら、それはそれは不幸なことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090212,
					"content": "…彼らにとって、ですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソニィ"
				}
			]
