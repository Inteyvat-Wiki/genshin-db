				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "これはこれは、奇遇ですね。そうでしょう？親愛なるルカさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090103,
					"content": "おまえたちは誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090104,
					"content": "これはこれは、大変失礼いたしました。私はソニィと申します。仲間からは「白手袋」と呼ばれることもあります。こちらの「漁師」のルカさんは、特定の人々たちの間で少し名の知れた者です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090105,
					"content": "おう、よろしくな！オイラは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090106,
					"content": "#存じ上げていますよ。あなたはパイモンさん、こちらの金髪の{M#紳士}{F#お嬢さん}は{NICKNAME}さんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090107,
					"content": "ん？オイラたちを知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090108,
					"content": "#勿論ですとも！ただ、今日お会いする前まで、あなたと{NICKNAME}さんを知っていることは、私がヌヴィレット様を知っているのと同じように、一方的なものでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090109,
					"content": "お二人のような傑出した方々が、我々フォンテーヌの地に足を踏み入れたのですから、当然小さな鳥から知らせが届きます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090110,
					"content": "#{M#俺}{F#私}たちってそんなに有名なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "おや、なんて謙虚な方でしょう！あなたが我らがフォンテーヌに現れたことは、一部の人にとっては、エピクレシスの舞台に爆弾が落とされたのと同じぐらいのことですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090112,
					"content": "——もちろん、いい意味で申し上げてるんです！そうでしょう？親愛なるルカさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090113,
					"content": "うぅ、どう理解すればそれがいい意味になるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090114,
					"content": "ふむ…私はどうも言葉が下手なようですね。あなたはどう思います、親愛なるルカさん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090115,
					"content": "リネとリネットのマジックショー。爆弾、逃げるシーン。ビッグニュース。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090116,
					"content": "素晴らしい！私にはそんな言葉、思い浮かびません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090117,
					"content": "な、なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090118,
					"content": "でも、なんでおまえは「白手袋」って呼ばれてるんだ？手袋なんてしてないじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090119,
					"content": "ああ、それはややこしいご質問ですね。なんてご説明すればいいでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090120,
					"content": "あなたが白い手袋をはめているとしましょう。そしたら、何か汚い物に触った時、手袋に汚れがつきますでしょう？という訳で、汚い物を見つけ、処理するのが私の職務なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090121,
					"content": "うーん…つまり清掃員ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090122,
					"content": "その通り、親愛なるパイモンさん！自分の仕事をそれだけ正確かつ簡明に要約するのは、私には無理ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090123,
					"content": "へぇ、じゃあフォンテーヌの街がこんなにきれいに保たれてるのは、ソニィみたいな人のお陰なんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090124,
					"content": "はははっ、嬉しいことを言ってくれますね！そのように考えていただいてよろしいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090125,
					"content": "おう…でも、清掃員も剣を持ち歩く必要ってあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090126,
					"content": "まあ、頑固なゴミを処理する時に使う小道具だと思ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090127,
					"content": "なるほどな！じゃ、ルカが「漁師」って呼ばれてるのは、釣りがうまいからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090128,
					"content": "ふむ——完全にそうとも言い切れないですね。ほら、我らがフォンテーヌにはいろいろな魚がいるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090129,
					"content": "色とりどりの魚たちとどうやったら楽しく、かつ穏やかに過ごせるかを人々に教えるのが、彼の特技なのです。私の説明で合っていますか、親愛なるルカさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090130,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090131,
					"content": "えっ？ちょっとわからないぞ…もしそうなら——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090132,
					"content": "おやまあ、親愛なるパイモンさん、あなたは本当に質問がうまいですね。それに、質問の内容も難しくて、相当レベルが高い。あなたにご満足いただけるお答えができるように、もっとゆっくりとあなたとお話がしたいものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090133,
					"content": "パイモン、もう質問は止めて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "えっ？わかったぞ…それでソニィ、ルカ、オイラたちになにか用があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090136,
					"content": "そうですね。私たちは「ダイビング」に対して非常に興味があるのです。我らがフォンテーヌの水中には、自然にできた、あるいは先人たちが残してくれた無数のお宝がいっぱいあるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090137,
					"content": "噂によりますと、あなたはここである人と仲良くなり、彼と一緒に水中に潜ったことがあるとか…しかも、あなたは潜水道具を必要としない程の実力を持つと聞きました。そうでしょう？親愛なるルカさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090138,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090139,
					"content": "ヴァージルのことについて聞きたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "その通り。ヴァージルさんのことについてお聞かせ願えますか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090141,
					"content": "ヴァージルのやつ…あの悪党め！うぅっ、ムカついてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090142,
					"content": "パイモンと一緒に、「白手袋」のソニィと「漁師」のルカに、この前経験したことを洗いざらい伝えた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "なるほど、そういうことだったのですね。ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090144,
					"content": "気にすんなって！ふん、あの悪者、絶対に忘れないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090145,
					"content": "——もちろん、ヴァージルとの間にあったことを正直に話してくださって感謝しています。でも、それよりもお二人が彼の仲間ではないことが、とても嬉しいのです。さもなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090146,
					"content": "なんと言ったらいいでしょう…さもなければ、あなたと私の間は、些か気まずくなっていたかもしれません。そうでしょう？親愛なるルカさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090147,
					"content": "手に負えなかったかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090148,
					"content": "そうそう、その通りですね。本当にありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090149,
					"content": "いったいどういうことだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090150,
					"content": "彼らはヴァージルの敵ってこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "なるほど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090152,
					"content": "#それはちょっと悲しい言い方ですね、{M#尊敬する紳士}{F#可愛らしいお嬢さん}。私には敵など存在しませんよ。いろいろな友人がいるだけです。ヴァージルさんもその一人。ただし、親愛なるヴァージルさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090153,
					"content": "#彼とはじっくりと「お話」をしなければなりません。お分かりいただけますね？親愛なる{NICKNAME}さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090154,
					"content": "もちろん、あなたとパイモンさんのために仕返しして差し上げなければ、ですね。さもなくば、貴賓であるあなた方にとんだ失礼でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090155,
					"content": "えーっと、オイラちょっと意味がわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090156,
					"content": "彼は白手袋。それだけ分かってればいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "そうなのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090160,
					"content": "ヴァージルと彼の仲間たちの拠点はすでに掴んでいます。拠点で落ち合うのはどうでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090161,
					"content": "#なんで{M#俺}{F#私}たちまで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#{M#尊敬する紳士}{F#可愛らしいお嬢さん}よ！ヴァージルがあなた方にああもひどいことをしたというのに、もし私とルカさんがあなた方に断らず、彼と…お話をしてしまったら、それは大変失礼でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090163,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "ルカ"
				},
				{
					"id": 740090164,
					"content": "ほら、ルカさんもそう思っているようですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090166,
					"content": "ふんっ！オイラもヴァージルと話をするぞ！あいつにはしっかり謝ってもらうからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 740090167,
					"content": "はははっ、あなたは本当にお優しいですね。それでは、目的地でお会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090165,
					"content": "分かったよ、じゃあ行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "パイモンが詳しく知る必要はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#世間を生きながら、すべてを分かりきってしまえば、あまりに面白くないでしょう？{M#尊敬する紳士}{F#可愛らしいお嬢さん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "ソニィ"
				},
				{
					"id": 740090135,
					"content": "#{M#俺}{F#私}たちには何か用があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
			]
		},
