			"dialogs": [
				{
					"id": 740370701,
					"content": "これだけあれば十分だ！少し待っててくれ、すぐに出来上がるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370702,
					"content": "エスタブレは勢いよく作業し始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "これで良しっと、バルブに噴出口、そして付属品の汎用装置のパーツ、全部準備できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370704,
					"content": "エデル、旅人、今からエリニュス島へ行こう。アタシがいれば、すぐにあの噴水を直せるさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370705,
					"content": "それでは、本当に頼みますよ…この荷物たちは私が持ちます。旅人さん、さっそく出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エデル"
				}
			]
		},
