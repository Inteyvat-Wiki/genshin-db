					}
				]
			},
			"dialogs": [
				{
					"id": 740370501,
					"content": "こんにちは、何かお困り…あれ、エデル？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370502,
					"content": "バルブと噴出口を受け取りに来ました。早くあの噴水を直さないと、レモディエールが死ぬほど慌てふためいていますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370503,
					"content": "バ…バルブね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370504,
					"content": "どうして…そんなに歯切れが悪いんですか？エスタブレさん…もしかして、そもそも作ってないとか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370505,
					"content": "違う！ちゃんと作ったとも。でも…この前、とある客からの依頼で、他の修理を緊急でしなきゃいけなくてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370506,
					"content": "それで…流用できる付属部品を一部彼女に渡してしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370507,
					"content": "まあ、落ち着け！今から新しいのを作ろう、すぐにできるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370508,
					"content": "エスタブレさん、私は随分と前に発注したはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370509,
					"content": "分かってるさ！でも、あのお客さんも急いでたんだ。何やら下水バルブの修理に使うとかなんとかでね、それで見かねてしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370510,
					"content": "大丈夫、アタシが買った…鉄の塊が届けば、すぐに作れる！もうすぐ届くはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370511,
					"content": "いつ発注したのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370512,
					"content": "け…今朝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370513,
					"content": "#鉄の塊は{M#俺}{F#私}に任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "本当か？それは助かるよ！じゃあ頼んだよ、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370516,
					"content": "いやぁ、ほんと悪いね！申し訳ないけど、鉄の塊を三つ持ってきてくれるかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370517,
					"content": "はぁ、あなたに任せるしかないみたいです、旅人さん。ですが安心してください、無駄足にならないよう、ちゃんと報酬はお支払いしますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370514,
					"content": "#{M#俺}{F#私}が鉄の塊を持ってくるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
