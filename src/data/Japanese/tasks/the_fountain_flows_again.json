		},
		{
			"id": 7403703,
			"completionStepIds": [
				7403703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403703",
							"2"
						],
						"stepId": 7403703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"エデル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "ここのパイプを交換しないと…バルブに…クリーニングの問題も…本当に問題が山積みですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370302,
					"content": "おや？あなたたち、私に何か用ですか？その様子からして…エスタブレさんが手配した噴水を修理する人でもなさそうですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370303,
					"content": "レモディエールの件について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "あの子のことですか。ふっ…あの子のマジックは本当にすごいんですよ。噴水の底にあるパイプのバルブをひとつ駄目にしたついでに、噴出口も壊したんですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370305,
					"content": "アハハ、冗談ですよ。本当はあの変形したバルブが給水システム全体をストップさせてしまったんです。安全のために、一時的に噴水を丸ごと停止させただけに過ぎません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370306,
					"content": "でも噴出口がどうして壊れたのかは、本当に不明でして…おかしいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370307,
					"content": "噴水が直らないと怒られるって、レモディエールはずっと言ってました…でも、本当にしばらく手が回らなかったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370308,
					"content": "今日になって、やっと少し時間ができまして。エスタブレさんに新しいバルブと新しい噴出口を発注し、今から受け取りに行こうとしていたところです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370309,
					"content": "もしよければ、一緒に取りに行ってくれませんか？思いのほか物がたくさんあるようで、一人だと持ちきれないかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エデル"
				}
			]
		},
