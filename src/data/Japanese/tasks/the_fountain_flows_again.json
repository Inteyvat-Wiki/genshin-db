			},
			"dialogs": [
				{
					"id": 740370801,
					"content": "この噴水です。さっそく作業を始めましょう。随分と長く止まってましたから、そろそろ再稼働させないとですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370802
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370802,
					"content": "二人はテキパキと作業し始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "バルブの設置が完了したよ。さっき全体の点検もしてみたが、特に問題はなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "エスタブレ"
				},
				{
					"id": 740370804,
					"content": "分かりました。ではいったんここを少し離れましょう。この後、私が水栓を開けてきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370805,
					"content": "えーと…元栓はあっちで、サブ水栓も操作が必要みたいですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370806,
					"content": "みんな待っててください、今すぐ水栓を開けてきますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370807,
					"content": "一体、誰がこのシステムを設計したんでしょうか。どうして水栓をこんな離れた場所に配置したのやら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370808,
					"content": "エデルは水栓のところへと駆けていき、しばらくしてから戻ってきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "まったく、水栓を開けるだけで疲れて死にそうです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370810,
					"content": "もう少し待ちましょう。もうすぐ水が流れてくるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370811,
					"content": "くぐもった低音が鳴り響いた後、噴水は再びいつも通り稼働し始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "やった！ついに噴水が直った…これでケラトリーがあの晩のことを話しても、僕は知らんぷりができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "レモディエール"
				},
				{
					"id": 740370813,
					"content": "今後は適当にマジックしないこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "そもそもこれはマジックの問題じゃない気がするけど…とにかくありがとう。これは僕からの感謝の気持ちだ、どうか受け取って欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "レモディエール"
				},
				{
					"id": 740370816,
					"content": "それと、前に君にあげると言った報酬も中に入ってる。手伝ってくれて、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "レモディエール"
				},
				{
					"id": 740370817,
					"content": "そして…エデルさん、エスタブレさん、二人もありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "レモディエール"
				},
				{
					"id": 740370818,
					"content": "やるべきことをやったまでですから、お礼は大丈夫ですよ。次はもう夜遅くに妹を連れまわさない…あっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "エデル"
				},
				{
					"id": 740370819,
					"content": "お兄ちゃん、どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "ケラトリー"
				},
				{
					"id": 740370820,
					"content": "ケラトリー！？どうしてここにいるんだ。たしか…父さん母さんと散歩に行ったんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "レモディエール"
				},
				{
					"id": 740370821,
					"content": "へへっ…この噴水がどうなったのか気になったから、パパとママに内緒で逃げ出してきたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "ケラトリー"
				},
				{
					"id": 740370822,
					"content": "お兄ちゃん、前にマジックでこの噴水を止めたよね？てっきり今日も止まったままかと思ったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "ケラトリー"
				},
				{
					"id": 740370823,
					"content": "ハハッ…その…ハハッ…マジックにはタイムリミットがあるんだ、知ってるよな？限られた時間の中でしか機能しないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "レモディエール"
				},
				{
					"id": 740370824,
					"content": "へぇ…なら、もう一度マジックを見せて！お兄ちゃん、今この噴水をまた止められる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "ケラトリー"
				},
				{
					"id": 740370825,
					"content": "それは…コホン、ケラトリーよ、今は近くに多くの人がいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "レモディエール"
				},
				{
					"id": 740370826,
					"content": "僕が噴水をまた止めてしまうと、噴水が見たい人の機嫌を損ねてしまうんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "レモディエール"
				},
				{
					"id": 740370827,
					"content": "なら…またあとで来よう！パパとママも一緒にね。パパとママもきっとお兄ちゃんのマジックを見たいと思うよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "ケラトリー"
				},
				{
					"id": 740370828,
					"content": "えっ！？いや、その…妹よ、この噴水のマジックはまだ…完全にマスターしていないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
