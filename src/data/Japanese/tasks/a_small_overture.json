			"dialogs": [
				{
					"id": 761860201,
					"content": "とても美味しいハーブティーだ、サンドローネさん。そなたの心遣いが感じられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860204,
					"content": "ああ。次回は私がそなたを招いて茶を振る舞おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
