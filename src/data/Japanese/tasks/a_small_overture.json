			"dialogs": [
				{
					"id": 761860101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860102,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860103,
					"content": "…最近、「霜月の子」はどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860104,
					"content": "まあまあと言ったところだ。月神の帰還により、我々も歩むべき道を進む決意を固めることができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860105,
					"content": "そう、ならよかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860106,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860108,
					"content": "はぁ…やっぱり、ワタシとアナタじゃ話が弾まないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860109,
					"content": "「霜月の子」と「ファデュイ」には、忌むべき過去の因縁が多すぎた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860110,
					"content": "私個人の立場から言えば、ナド・クライを守り、月神を迎えるため尽力してくれたそなたには当然感謝しておる。だが、他の者にとっては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860111,
					"content": "分かっているわ。いろんな事情のせいで、ワタシたちは良好な関係はおろか、互いに利益をもたらすだけの関係すら築けなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860112,
					"content": "でも、今の「ファデュイ」は「霜月の子」から何かを奪おうとするつもりなんてないのよ。ワタシも部下には、アナタたちが困るようなことはしないよう言いつけているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860113,
					"content": "ワタシとしては、せっかくの隣人なのだから、仲良く共存とまではいかなくとも、互いに尊重し合える形で付き合いたいと思っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860114,
					"content": "うむ。だが、もうしばらく時間がかかるだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860115,
					"content": "そうね。でも、できることから一つずつ試してみるのもいいでしょう？まずは、ワタシが淹れたハーブティーを飲んでみるのはどうかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860116,
					"content": "ハーブティー？ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860117,
					"content": "ああ…これほど香り豊かに仕上げられるとは…「霜月の子」の淹れ方か？外の者はこの飲み方が苦手だと記憶しておるが、そなたは如何にして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860118,
					"content": "学びと尊重よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860119,
					"content": "ふふ…一つずつ試してみる、か…悪くない試みだったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860120,
					"content": "アナタの口に合えばいいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 761860121,
					"content": "ああ、とても美味しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860122,
					"content": "茶を通じた交流は、古くから隣人同士が親交を深める良ききっかけとされておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 761860123,
					"content": "今回も例外ではないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラウマ"
				}
			]
		},
