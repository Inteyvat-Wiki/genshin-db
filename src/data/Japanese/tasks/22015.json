			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150205,
					"content": "なるほど、あなたが所長が言ってた「助っ人」ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150206,
					"content": "ここに来ることを知ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "そうではありませんが、誰かが助けに来てくれると所長が言っていたので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150208,
					"content": "おい、なにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150209,
					"content": "あれは、宝盗団？なんでこんなに町に近いところにいるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150210,
					"content": "龍二、君もいたのか。それと、この怪しげな外国人は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150211,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "そうだ、ここにいる外国人は君しかいないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150215,
					"content": "まあ、そう神経を尖らせるなって。そういえば、龍二はここで何してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150216,
					"content": "私はただ所長の指示に従い、怪しい人物の後をつけてきたのです。そこで、宝盗団に遭遇してしまいまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150217,
					"content": "この旅人も所長が雇った助っ人で間違いありません。先ほど、共に宝盗団をやっつけたばかりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150218,
					"content": "そうだったのか…でも、どうして宝盗団がこの辺りに現れたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150219,
					"content": "龍二、君はさっき、怪しい人物を尾行していたと言ったな…おい！もしかして、町から出てきた宝盗団を追っていたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150220,
					"content": "はい。所長は連続窃盗事件について調査を行っていましたから。そして、私は所長の推理を基にして、町の至るところを捜査していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150221,
					"content": "そして、花見坂付近で怪しい人物を発見しました。しかし少し尋問しただけで、その人は慌てて去っていったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150222,
					"content": "私は彼を追って町を出ました。その後のことは、皆さんもご存じの通りです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150223,
					"content": "おぉ…龍二、話が上手くなったな。昔はそんなに喋るタイプじゃなかったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150224,
					"content": "珊瑚と一緒に仕事をするうちに、話も上手くなったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150225,
					"content": "何をしに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "安藤が、町をうろついている怪しい金髪の外国人がいるって言ったから、確認するためについてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150227,
					"content": "それで君たち二人の後を追って、ここまで来たってわけさ。まさか珊瑚の助っ人だったとは、勘違いしていたよ。悪かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150232,
					"content": "でも龍二、さっき怪しい人物を城内で発見したって言ってたよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150233,
					"content": "そうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150234,
					"content": "こいつら、町にまで手を伸ばすとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150235,
					"content": "本当に。私たち…私たちだけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150236,
					"content": "（急に言葉を失ったみたい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "私たちの力だけでは、宝盗団を完全に追い払うことなどできません。皆さんの力が必要なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150239,
					"content": "お二方…それでも証拠が必要だというのであれば、所長のところに行けば、彼女が詳しく説明してくれるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150240,
					"content": "そういうことなら…天野、珊瑚に会いに行こう。もし本当に町に宝盗団がいるなら、放っておけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150241,
					"content": "お…おう！じゃあ、俺たちは珊瑚を探しに行くよ。龍二、君たちも早く帰りなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150242,
					"content": "…ふぅ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150243,
					"content": "私たちも戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150244,
					"content": "今言った話は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "所長に頼まれた事です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150246,
					"content": "もう用は済んだので、戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150237,
					"content": "（言いたいことを忘れたみたい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "怪しい人物を追ってきたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "間違ってはないが、その怪しい人物が君だったんだ、コホン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150230,
					"content": "安藤が、町をうろついている怪しい金髪の外国人がいるって言ったから、確認するためについてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150231,
					"content": "それで君たち二人の後を追って、ここまで来たってわけさ。まさか珊瑚の助っ人だったとは、勘違いしていたよ。悪かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150213,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は珊瑚の助っ人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "助っ人？なんか怪しいな…",
					"roleType": "TALK_ROLE_NPC",
