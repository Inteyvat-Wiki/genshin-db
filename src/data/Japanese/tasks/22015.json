			},
			"dialogs": [
				{
					"id": 220150101,
					"content": "そろそろ時間だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150102
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150102,
					"content": "おや、いらっしゃい。なにかご用件でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150103
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150103,
					"content": "なるほど、君…特に用件はなく、ただ「ぶらぶら」してただけなのね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150104
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150104,
					"content": "こちらは「万端珊瑚探偵所」、いたって普通の、ね。そして私は…探偵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150105,
						220150108
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150105,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150106
					]
				},
				{
					"id": 220150106,
					"content": "私は珊瑚、この探偵所の所長よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150107
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150107,
					"content": "でも所長とは言っても、ここの従業員は二人だけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150113,
					"content": "もしかして、探偵所は初めてなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150108,
					"content": "探偵って何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150109
					]
				},
				{
					"id": 220150109,
					"content": "おや、いい質問だわ。一般人から見ると、探偵という職業は謎に包まれているかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150110
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150110,
					"content": "でも私から見ると、探偵も「お金をもらって仕事をする」、普通の職業でしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150111
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150111,
					"content": "まぁ、たまには変わった仕事とか、変な依頼人が来るときもあるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150112
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150112,
					"content": "でもいずれにしても、「お金をもらって仕事をする」という範囲の仕事だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150113
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 2201502,
			"completionStepIds": [
				2201504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201504",
							"2"
						],
						"stepId": 2201504,
						"stateName": "QUEST_STATE_UNFINISHED"
