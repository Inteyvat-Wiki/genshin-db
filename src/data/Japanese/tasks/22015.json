			"dialogs": [
				{
					"id": 220150301,
					"content": "珊瑚さん、今の話は本当か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150302,
					"content": "町の連続窃盗事件は、本当にあの宝盗団の仕業だというのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150303,
					"content": "間違いないわ。さっきも証拠を見せたわよね、お二人の「プロの勘」も、既に結論を出しているでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150304,
					"content": "宝盗団の奴らめ…いい度胸だ！俺たちのことを舐めやがって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150305,
					"content": "天野！早く戻ってこの事を報告するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150306,
					"content": "見張りを強化しよう。あいつらに付け入る隙を与えてはいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150307,
					"content": "珊瑚さん、この証拠品を貸してくれないか？それを使って上を説得する必要があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220150308,
					"content": "問題ないわ。宝盗団が出現するような大事件なんて、私たち探偵所の手には余るもの。天領奉行のお方に頼むしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150309,
					"content": "安心しな！宝盗団の奴ら…一人も残らず捕まえてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220150310,
					"content": "お疲れ様。今は…そろそろ準備ができるころだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150311,
					"content": "準備？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "ええ、あの奉行所のお二方は、この事件を解決するための重要な「助っ人」なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150316,
					"content": "あの奉行所のお二方が見張りを強化すると、町の宝盗団はさらに警戒するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150317,
					"content": "龍二、私が行かせた場所で、宝盗団と戦ったのよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150318,
					"content": "はい、所長。そして、私と旅人で退治しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220150319,
					"content": "ええ…それでいいわ。十分な騒ぎを起こせたはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150320,
					"content": "残るはチャンスを待つだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150321,
					"content": "旅人、ご苦労様。お礼にこれを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150322,
					"content": "ほとんど何もしなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "そんなことないわ。外国人という身分で注意を引き、安藤と天野に追わせ、龍二と合流させた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150324,
					"content": "そして、宝盗団の脅威に気付かせ、町の見張りを強化させた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150325,
					"content": "これら全ては、君にしかできなかったことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150326,
					"content": "思った通り、私が直接教えるよりも、同心のお二方に宝盗団のことを「自ら発見」させた方が、効果があったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150327,
					"content": "とにかく、これを受け取って。それに、もしかしたら…また頼み事をするかもしれないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150313,
					"content": "何をするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "私は探偵よ。するべきことはもちろん、事件を解決へと導くこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150315,
					"content": "あの奉行所のお二方は、この事件を解決するための重要な「助っ人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
