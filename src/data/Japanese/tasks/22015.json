				{
					"id": 220150501,
					"content": "モンドでは見なかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150502
					]
				},
				{
					"id": 220150502,
					"content": "モンド…モンド城の事かしら。その町について、多少は耳に入っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150503
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150503,
					"content": "モンドで最も有名な特産品は、一つはお酒、もう一つは「自由」、そうよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150504
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150504,
					"content": "ふふふ、この二つの特産品はお互いに補い合ってるのね…もしモンドに探偵がいたら、きっと毎日商売繁盛間違いなしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 2201506,
			"completionStepIds": [],
