			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220150801,
					"content": "でも君の様子を見ると、もしかして探偵所に興味があるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150802,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}も探偵になれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "探偵になりたい？大変な仕事よ、小説とかに騙されてはだめ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150804
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150804,
					"content": "探偵の仕事には、ハラハラする追跡劇も、生死に関わるような決断も存在しないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150805
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150805,
					"content": "部屋中に置かれた書類、泥まみれの山道と、全く手がかりを残さない容疑者…それらこそが、探偵の実態よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150806,
					"content": "まぁ、口だけで説明しても分からないかもしれないわね…ちょうど今、簡単な依頼が来たところなの。この機会に探偵の仕事を体験してみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150815,
					"content": "助っ人の名前は龍二って言うんだけど、手がかりを探しに行ったきりで、まだ帰ってこないのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150816,
					"content": "もうこんな時間だから、十分な手がかりを見つけている筈よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150817
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150817,
					"content": "そこでお願いなんだけど、龍二を連れ帰って欲しいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150818,
						220150821
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150818,
					"content": "危険な目に遭ってないといいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150819
					]
				},
				{
					"id": 220150819,
					"content": "彼には仕事の全てを託しているから、もし不測の事態に遭遇したとしても、彼ならなんとか対応できるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150820,
					"content": "それよりも、私の欲しいものを彼が見つけられているかどうかが気になるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150826,
					"content": "じゃあ、この件は任せたわ。報酬も用意しておくし…それに、探偵という職業を体験するいい機会よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150821,
					"content": "事故に遭ってないといいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "それは安心して、彼には仕事に関する全てを説明済みよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150823
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150823,
					"content": "想定外のことが起きても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150824
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150824,
					"content": "彼ならなんとか対応できるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150825
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150825,
					"content": "それよりも、私の欲しいものを彼が見つけられているかどうかが気になるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150807,
					"content": "何だかめんどくさそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150808
					]
				},
				{
					"id": 220150808,
					"content": "そうかもしれないわね。でも探偵という職業は、「問題処理」のプロなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150809
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150809,
					"content": "ハラハラする追跡劇だの、生死に関わる決断だの…全部小説に書かれたデタラメよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150810
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150810,
					"content": "部屋中に置かれた書類、泥まみれの山道と、全く手がかりを残さない容疑者…それらこそが、探偵の実態よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150811
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150811,
					"content": "でも、小説もデタラメだらけってわけじゃない。探偵には常に様々な助っ人がいる、それは本当のことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150812
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150812,
