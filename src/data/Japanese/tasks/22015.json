			},
			"dialogs": [
				{
					"id": 220150601,
					"content": "璃月では見なかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150602
					]
				},
				{
					"id": 220150602,
					"content": "璃月に探偵は必要なさそうね。璃月では「契約」が重要視されているって話を、少し聞いたことがあるもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150603
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150603,
					"content": "しかも、大小様々な問題を解決するために、すぐ駆けつけてくれる「千岩軍」もいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150604
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150604,
					"content": "そんなところに探偵所があったとしても、全然儲からなくてすぐに潰れてしまいそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
