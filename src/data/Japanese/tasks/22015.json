			},
			"dialogs": [
				{
					"id": 220150701,
					"content": "「法律家」に会ったことはある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150702
					]
				},
				{
					"id": 220150702,
					"content": "「法律家」？あぁ…聞いたことあるけど、そのタイプの人は…一番やっかいなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150703
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150703,
					"content": "そういう人が得意としているのは、単純な問題を複雑にして、複雑な問題を定型化して、定型化したものを契約にしていくことだと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150704
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220150704,
					"content": "できれば、そのような人とは一生会いたくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
			"id": 2201508,
			"completionStepIds": [
				2201501
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201501",
							"2"
