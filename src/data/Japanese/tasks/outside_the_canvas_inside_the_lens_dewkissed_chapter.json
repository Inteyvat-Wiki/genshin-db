			"dialogs": [
				{
					"id": 745140101,
					"content": "さ、寒い…風に当たるのなんて、やめとけばよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140102,
					"content": "#あれ？{NICKNAME}とパイモン！なんで…ハクション！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140103,
					"content": "朝霧？どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "一人でこんなところまで…身体のほうはもういいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745140105,
					"content": "えぇと…その…も、もちろん大丈夫！ほら、もう咳もしてないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140106,
					"content": "あは…はは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140107,
					"content": "本当に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "うわっ！だめ！うぅ…実はこっそり出てきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140110,
					"content": "だって…仕方ないでしょ？ずっと稲妻にいたって、いい絵なんて描けないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140111,
					"content": "君が色んな場所の写真を撮ってきてくれたりはするけど…やっぱり自分の目で見るのが一番でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140112,
					"content": "だから、前に仕事で知り合った先生にキャラバンを紹介してもらって、こっそり出てきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140113,
					"content": "絵の具も全部持ってきたんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "もちろん！キャンバスは私の魂なんだから、手放すわけないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140115,
					"content": "実は、私が描いた絵がフォンテーヌでまあまあ売れててさ。こっちの作家から、小説の表紙を描いてほしいって依頼ももらってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140116,
					"content": "でも…小説に挿絵を入れる習慣はないみたいなんだよね。なんでだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140117,
					"content": "#そうだ、{NICKNAME}！ここで会ったのも何かの縁ってことで…素材探しを手伝ってくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140118,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "ありがとう！君が手を貸してくれるなら安心だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140123,
					"content": "ちょっと待ってね…作家さんから受けた依頼はいくつかあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140120,
					"content": "いいけど、その代わり大人しくしててね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "うん、分かった。あのマシナリーとかいうのに、私は手も足も出ないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140122,
					"content": "変な魔物を倒すことなら、君の右に出る人はいないでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140108,
					"content": "手紙を送って確かめようかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}