			"trigger": {
				"objectNames": [
					"聞冀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716730101,
					"content": "うーむ…何か物足りない気がしますな。もう一味加えたいが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730102
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730102,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730103
					]
				},
				{
					"id": 716730103,
					"content": "#おや、{NICKNAME}殿ではありませんか。お噂はかねがね伺っておりますぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730104
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730104,
					"content": "ご覧の通り、催し会場の設営をしているところでございます。総務司の指示でしてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730105
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730105,
					"content": "えっと…絵を教えるってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730106
					]
				},
				{
					"id": 716730106,
					"content": "いやいや、「絵を教える」のではなく「絵を描いてあげる」のです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730107
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730107,
					"content": "海灯祭は年々盛大になり、訪れる客人も増える一方です。中には璃月以外の地からやってくる方も少なくありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730108
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730108,
					"content": "総務司が無料の「記念撮影」を用意してはいるものの…やはり写真だけでは璃月らしさが足りない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730109
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730109,
					"content": "そこで総務司から、観光客のために絵を描くようお達しがあったのですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730110
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730110,
					"content": "最近、璃月港では「白馬の仙人」の伝説が大変な人気を集めていますから、これを題材に描こうと思いましてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730111
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730111,
					"content": "龍が天に昇り虎が躍り馬が大地を駆け巡る——そんな精神を以て、お客様方のために白馬が翔る「跳躍の絵」を描かせていただく所存です。これ以上の縁起物はございませんぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730112
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730112,
					"content": "#いかがですかな、{NICKNAME}殿？何かいい絵は思いつきますか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730113
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730113,
					"content": "そうだね、色々あるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730114
					]
				},
				{
					"id": 716730114,
					"content": "おお、それはよかった！思い浮かんだら遠慮なくお聞かせください。あなたのために腕を振るいましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "聞冀"
				}
			]
		}
	]
}