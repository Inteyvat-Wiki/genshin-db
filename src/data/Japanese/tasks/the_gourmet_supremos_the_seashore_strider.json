			"dialogs": [
				{
					"id": 721690201,
					"content": "どうだ旅人、収穫はあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690202,
					"content": "おっ！このカニ、いい感じじゃないか。お前なかなかやるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690203,
					"content": "よし、材料も揃ったし、料理を始めるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690204,
					"content": "俺は先に準備してるから、あとでまた来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
		},
