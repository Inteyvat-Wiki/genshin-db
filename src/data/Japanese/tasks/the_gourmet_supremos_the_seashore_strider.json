			"dialogs": [
				{
					"id": 721690301,
					"content": "甲羅焼き…なぜ甲羅焼きなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690302
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690302,
					"content": "まあいい、ひとまず作ってみるとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690303
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690303,
					"content": "完成！これが「かにみそ甲羅焼き」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690304
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690304,
					"content": "1個もらうね！どれがいいかな…うん、これにしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690305
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 721690305,
					"content": "小さいのをちょうだい、食べきれないかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690306
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721690306,
					"content": "さあ旅人、これが旅人の分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690307
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690307,
					"content": "それにこの「かにみそ甲羅焼き」のレシピも書いておいたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690308
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690308,
					"content": "作ってみたところ簡単だったよ、お前も暇な時に試してみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690311
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690311,
					"content": "これから<color=#00E1FFFF>ヤシオリ島</color>の近くに行ってみようと思ってる。時間があれば、お前もそこに来るといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690309
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690309,
					"content": "それじゃ、俺はもうちょっと食べ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690310
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690310,
					"content": "おい！ジュリー！俺の分まで食べるんじゃねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
		},
