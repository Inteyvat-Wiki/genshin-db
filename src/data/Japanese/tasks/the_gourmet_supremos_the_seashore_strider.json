					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "ジュリーにぴったしな料理名だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690102,
					"content": "うん、初めて見た時モンドのお料理かと思った、まさか稲妻の料理だったなんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721690103,
					"content": "こんな素敵な名前の料理、きっと美味しいに決まってるよ。旭東、お願い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 721690104,
					"content": "また会ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "おっ！旅人、へへ、俺の言った通り、また会えたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690107,
					"content": "旭東がさっき城内で新しいレシピを手に入れたんだ！「かにみそ甲羅焼き」って名前でね、素敵な名前でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 721690108,
					"content": "難しい料理ではないが、カニが必要なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690109,
					"content": "普通のカニなら用意してある、だがこれから…特別なカニを探そうと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690110,
					"content": "特別なカニ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "そう、あの雷櫻の下にいるカニだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690112,
					"content": "雷に打たれたカニ…って言った方がいいかもね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721690113,
					"content": "ははは、どうも気になってな、あんな環境で生きるカニの食感が。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690114,
					"content": "でも…あの雷櫻の周りでは常に雷が落ちてくる、俺らじゃ近寄れないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690115,
					"content": "私の本によると…前回のように「雷櫻の枝」に触れて、「雷の種」というものを付着させたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721690116,
					"content": "雷櫻付近の雷に打たれないってあるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721690117,
					"content": "でも、あの雷が落ちる様子を見ると、こんな記載だけを信じて近づけないよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721690118,
					"content": "ものすごい速さで走れば問題ないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690119,
					"content": "あんたさ…人間がいくら速く走っても、雷に勝てるわけないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721690120,
					"content": "じゃあさ、枝を使って遠くからカニを挟むとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "ジュリー"
				},
				{
					"id": 721690121,
					"content": "それなら、水路を掘ってカニが自ら出てくるのを待った方がまし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "パルヴァネ"
				},
				{
					"id": 721690122,
					"content": "ははははッ…みんなガンガン自分の意見を言うなんて、素晴らしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690123,
					"content": "旅人もよかったら、雷櫻付近のカニを捕まえてみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690124,
					"content": "捕まえたカニを俺にくれたら、美味しいもの作ってやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690125,
					"content": "あっ、そうだ、待ってくれ…この餌を持って行け。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690126,
					"content": "カニを捕まえる時、先にこの餌で誘い出してみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690127,
					"content": "そうしたら、もっと簡単に捕まえることができるはずだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690128,
					"content": "雷櫻付近で生きるカニか…どんな味がするんだろな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 721690105,
					"content": "今度はどんな料理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
