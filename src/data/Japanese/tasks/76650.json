			},
			"dialogs": [
				{
					"id": 766500301,
					"content": "「月諭の像」って、こんなに大きかったのか…たしかにこれじゃ、鳥もイタチも取り出せないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500302,
					"content": "しかも、それにこんな大きな鏡の中に収められてたなんて…もしかして、この「月諭の像」ってすごく貴重なものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500303,
					"content": "いや、モラに換算すれば大した金額ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500304
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500304,
					"content": "使われておるのは、この地で取れるごく一般的な石だ。彫刻として出来が良いわけでもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500305
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500305,
					"content": "しかし、当時の「詠月使」や、今の「霜月の子」にとっては、極めて価値の高いものなのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500306
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500306,
					"content": "少なくとも、「月諭の像」の存在が証明されたことで、いくつかの文献にある記載が信頼に足るものだと確認できた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500307
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500307,
					"content": "とにかく、無駄足ではなかったということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500308
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500308,
					"content": "協力に感謝するぞ。やはり私の目に狂いはなかったな。「盈月の鏡」の封印を解くなど、そなたにとっては造作もないことだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500309
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500309,
					"content": "この子も、そなたの手腕に感心しておるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500310
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500310,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500311
					],
					"speakerTitle": "宝盗イタチ"
				},
				{
					"id": 766500311,
					"content": "ラウマ、こいつはなんて言ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500312,
					"content": "——旅人は、これまで見てきたどんな宝盗団よりも、お宝を手に入れるのが上手い。これからは旅人についていき、世界中の宝箱を開けて回りたい、とのことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500313,
						766500314
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500313,
					"content": "人を泥棒みたいに言わないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				},
				{
					"id": 766500315,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500316
					],
					"speakerTitle": "宝盗イタチ"
				},
				{
					"id": 766500316,
					"content": "——今度開けられない宝箱があったら、その時はよろしく頼む、だそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500317
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500317,
					"content": "行っちゃった…オイラたちに反論する機会すらくれなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500318,
					"content": "心配はいらぬ。宝箱探しに付き合えと、毎日モラを持って家の窓を叩きに来たりはしないはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500319
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500319,
					"content": "夜中に部屋に入って来て、鍵が開かなかったと文句を言われることもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500320
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500320,
					"content": "今晩は、寝る前にしっかり戸締まりしておかないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500321,
					"content": "あの子に悪意はない。ただ…おしゃべりが少し過ぎるだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500322
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500322,
					"content": "さて、私たちもそろそろ帰るとしよう。もうすぐ夕食の時間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500323
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500323,
					"content": "しかし、この彫像をどうやって書庫まで運んだものか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500324
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500324,
					"content": "…やはり、知り合いの手を借りるしかなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500314,
					"content": "確かにたくさん開けてきたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				}
			]
		},
