			"dialogs": [
				{
					"id": 766500101,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500102
					],
					"speakerTitle": "長羽トキ"
				},
				{
					"id": 766500102,
					"content": "…これは友の数の問題ではない。たとえ、ヒーシ島にいる長羽トキをすべて呼んでこようと、あの「盈月{RUBY#[D]えいげつのかがみ}の鏡」を運び出すことはできぬのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500103
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500103,
					"content": "仮に運び出せたとて、その中にある「月諭の像」は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500104
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500104,
					"content": "！！！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500105
					],
					"speakerTitle": "宝盗イタチ"
				},
				{
					"id": 766500105,
					"content": "…掘り出す？その方法でも、あの鏡を運ぶのは容易ではないと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500106
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500106,
					"content": "♪♪♪♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500107
					],
					"speakerTitle": "長羽トキ"
				},
				{
					"id": 766500107,
					"content": "なに？本当にヒーシ島の長羽トキをすべて集められるというのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500108
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500108,
					"content": "…イタチは何匹いようと役に立たない…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500109
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500109,
					"content": "！！！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500110
					],
					"speakerTitle": "宝盗イタチ"
				},
				{
					"id": 766500110,
					"content": "やけに賑やかだな。あれ、なんで宝盗イタチと鳥がケンカしてるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500111,
						766500112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500111,
					"content": "実はどっちも盗賊で…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				},
				{
					"id": 766500113,
					"content": "正確には「犯行を企てている」段階だ。今は「犯行方法の詳細」を詰めておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500114
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500114,
					"content": "だが、私の「共犯者」たちが考えた方法は、いささか強引でな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500115
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500115,
					"content": "♪♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500116
					],
					"speakerTitle": "長羽トキ"
				},
				{
					"id": 766500116,
					"content": "ああ、おまえの交友関係が広いことはよく分かった。一体どこで、そんな言い回しを覚えてきたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500117
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500118
					],
					"speakerTitle": "長羽トキ"
				},
				{
					"id": 766500118,
					"content": "…帽子を被った、鉄の腕を持つ小柄な女の子が、そういったことを何度も口にしていたと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500119
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500119,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500120
					],
					"speakerTitle": "長羽トキ"
				},
				{
					"id": 766500120,
					"content": "…おまえが気に入っておるのなら、その話し方でも私は構わない。だが…そのお嬢さんからは、あまり学ぼうとしなくてよい。分かったな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500121
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500121,
					"content": "私はこれから、このお二人と大事な話をする。少し静かにしていてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500122
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500122,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500123
					],
					"speakerTitle": "長羽トキ"
				},
				{
					"id": 766500123,
					"content": "わぁ、本当に静かになった…動物の言葉がわかるっていいな。オイラにも、そんなすごい力があったらいいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500124,
					"content": "パイモン…この力は、そなたが思っておるほど良いものではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500125,
						766500126
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500125,
					"content": "も、もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500127,
					"content": "誤解しないでくれ。この力が災いをもたらすだとか、精神をかき乱すだとか、そういった意味ではない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500128
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500128,
					"content": "いや…実を言えば、心が休まらないというのはある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500129
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500129,
					"content": "自分が動物の言葉を解すると初めて知った時はうれしかった。しかし、すぐに気づいたのだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500130
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500130,
					"content": "この力は常に発動し続け、自分でも制御することができないことに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500131
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500131,
					"content": "えっ…そうなのか、気づかなかったぞ。ラウマ自身も「動物の言葉が分かる力」を制御できないってなると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500132,
						766500133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500132,
					"content": "森でも水辺でも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500134,
					"content": "森で鳥の鳴き声を聞くと、静けさを感じて心が癒される——以前、そんな話を聞いたことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500135
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500135,
					"content": "だが、私はどこに行こうと…そんな風に感じられたことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500136
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500136,
					"content": "森の中にいた時、やはり話し声が聞こえてきた——野良猫、ウサギ、ツノシカ、モサモサアナグマ、長羽トキたちの話し声が。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500137
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500137,
					"content": "「誰々のせいで巣が壊れた」…「どこの木の枝が一番良質か」…そういったことを大声で話し合っていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500138,
						766500139
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500138,
					"content": "耳が休まらないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500140,
					"content": "そ、そうだったのか…オイラ、やっぱりその力は無くていいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500141,
					"content": "朝、鳥の鳴き声で目を覚ますのは悪くないけど…うるさいおしゃべりで起こされるのは、なんか嫌だしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500142,
						766500143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500142,
					"content": "その程度じゃ起きないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500144,
					"content": "今やもう…慣れてしまった。「どの家の水が浸かってて一番気持ちいいか」…そんな話をするヤマガラたちの声が、朝起きても聞こえてこなかったら…却ってすわりが悪い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500145
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500145,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500146
					],
					"speakerTitle": "宝盗イタチ"
				},
				{
					"id": 766500146,
					"content": "…そうだったな、ありがとう。本題を忘れかけていた。しかし、旅人が手伝ってくれるなら、それほど強引な方法でなくとも良いかもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500147,
						766500148
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500147,
					"content": "たしかに友達は世界中にいるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500149,
					"content": "いや、そなた一人で十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500150
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500150,
					"content": "そなたほど聡明な人物なら、先代の「詠月使」が「盈月の鏡」を利用して作った、封印されし保管室を開くのも…きっと容易かろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500151,
						766500152
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500151,
					"content": "先代の「詠月使」が作ったもの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500153,
					"content": "心配はいらぬ。そなたにとっては、そう難しいことではない。では、行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500152,
					"content": "一から詳しく説明してほしい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500148,
					"content": "呼び寄せるには、時間がかかる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500143,
					"content": "今まで何度揺すって起こしたことか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500139,
					"content": "どこに行っても賑やかだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500133,
					"content": "そこに動物がいれば…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500126,
					"content": "すごく危険とか…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500112,
					"content": "盗品の取り分で揉めてるとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				}
			]
		},
		{
