					}
				]
			},
			"dialogs": [
				{
					"id": 766500201,
					"content": "ここだ。眼の前にあるのが「月諭の像」が封印されておる「盈月の鏡」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500202
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500202,
					"content": "その彫像って貴重なものなのか？厳重に保管されてるみたいだけど…この中、変な仕掛けとかあったりしないよな？一歩間違えたら、ピュンピュンピュンって矢が飛んでくるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500203,
						766500204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500203,
					"content": "覚悟はできてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				},
				{
					"id": 766500205,
					"content": "案ずるな。前もってこの子に道を確認してきてもらった。この中にそういった仕掛けはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500206
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500206,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500207
					],
					"speakerTitle": "宝盗イタチ"
				},
				{
					"id": 766500207,
					"content": "あっ！宝盗イタチだ。それなら大丈夫そうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500208,
						766500209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500208,
					"content": "でも見た感じ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500210,
					"content": "ふふっ、その通りだ。依頼をする度に、モラを一枚多く払うことになっておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500211
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500211,
					"content": "報酬の交渉まで出来るのか？さすがだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500212,
					"content": "でも、こいつがラウマの代わりに「月諭の像」をずっと見張ってたんなら…名前を変えたほうがいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500213,
					"content": "そうだな…「宝守イタチ」っていうのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500214,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500215
					],
					"speakerTitle": "宝盗イタチ"
				},
				{
					"id": 766500215,
					"content": "へへっ。オイラは飛べるから、触れないぞ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766500216,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500217,
						766500218
					],
					"speakerTitle": "宝盗イタチ"
				},
				{
					"id": 766500217,
					"content": "こっちに登ってこないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500219,
					"content": "これこれ、客人に対して無礼であろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500220
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500220,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500221,
						766500222
					],
					"speakerTitle": "宝盗イタチ"
				},
				{
					"id": 766500221,
					"content": "それで、どう手伝えばいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500223,
					"content": "うむ…「月諭の像」を取り出すには、二人の人間がそれぞれ別の場所から、同時に装置を操作する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500224
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500224,
					"content": "そなたには、あちらの装置を頼みたい。こちらは私が担当する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500225
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500225,
					"content": "同時にって、どうやって…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500226
					]
				},
				{
					"id": 766500226,
					"content": "心配無用だ。私は空中にも眼がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500227
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500227,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500228
					],
					"speakerTitle": "長羽トキ"
				},
				{
					"id": 766500228,
					"content": "あの子がそなたの位置と、装置の仕様を私に教えてくれる。そなたたちは、私の指示に従ってくれれば大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 766500222,
					"content": "この仕掛けはどう解くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500218,
					"content": "せめて髪は引っ張らないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500209,
					"content": "ただ働きではなさそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500204,
					"content": "そういうのには慣れてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				}
			]
		},
		{
