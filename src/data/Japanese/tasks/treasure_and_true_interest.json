			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アダン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "こんにちは。何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "アダン"
				},
				{
					"id": 190780402,
					"content": "アルカミのことを知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "アルカミ？最近名前を聞くようになった、あの金持ちのことかな？この前私のところで家具のオーダーメイドを依頼してきたけど、なかなか太っ腹だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "アダン"
				},
				{
					"id": 190780405,
					"content": "以前は有名な建築デザイナーだったとかで、ずいぶん財を成したんだそうだ。今は私塾を開いて、富を築くコツをみんなにシェアしてるとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "アダン"
				},
				{
					"id": 190780406,
					"content": "学費があんなに高くなかったら、私も子供のために申し込んでやりたかった。建築デザイナーってのは儲かるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アダン"
				},
				{
					"id": 190780403,
					"content": "アルカミについて聞きたいことがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
		{
			"id": 1907808,
			"completionStepIds": [
				1907808
			],
