			"dialogs": [
				{
					"id": 190785001,
					"content": "カーヴェ先生、すごく怒ってましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "ウザイル"
				},
				{
					"id": 190785002,
					"content": "ほっとけ。どうせ、いつかボクたちに仕事を取られるかもって思ってるだけだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "ワイズ"
				},
				{
					"id": 190785003,
					"content": "そ…そうなのかしら？でも、カーヴェ先生ってあんなに有名人だし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "タニシャ"
				},
				{
					"id": 190785004,
					"content": "どうかな？そういう人に限って偉そうにするんだって、父さんが言ってたよ。アルカミ先生みたいな人のほうが珍しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ワイズ"
				}
			]
		},
