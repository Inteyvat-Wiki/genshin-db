			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アービッド",
					"アディル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "聞いたか？アルカミが、カーヴェを私塾の教師に誘ったって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "アービッド"
				},
				{
					"id": 190780802,
					"content": "ほう。これで、あいつの商売はますます順調だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "アディル"
				},
				{
					"id": 190780803,
					"content": "羨ましい限りだぜ。アルカミのやつ、建築デザイナーの頃から中途半端だったからな…あれで教師が務まるなんて、普通思わないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "アービッド"
				},
				{
					"id": 190780804,
					"content": "宣伝がよかったんだろ…それに、教令院で建築を学べる人間なんてまだまだ数少ないんだ。あそこに入りたきゃ、試験に受からないといけないんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "アディル"
				},
				{
					"id": 190780805,
					"content": "受からなかったやつ、それに手っ取り早く学が欲しいってやつは、自然とあいつの私塾に行くって寸法だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "アディル"
				},
				{
					"id": 190780806,
					"content": "いい金の稼ぎ方だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アービッド"
				}
			]
		},
