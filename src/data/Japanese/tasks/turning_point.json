	"talks": [
		{
			"id": 102402,
			"completionStepIds": [
				102402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102402",
							"2"
						],
						"stepId": 102402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "ハッ…ハッ…つ、疲れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240202,
					"content": "「黄金屋」を出た時に「群玉閣」を見てなかったら、どこに行けばいいか分からなかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240203,
					"content": "間に合ったよな？「渦の魔神」はまだ璃月港に上陸してないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240204,
					"content": "お前たち…なぜここに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10240205,
					"content": "ん？…あっ、仙人たちだ！どうして「群玉閣」にいるんだ？七星と喧嘩したって聞いたけど…もう解決したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240206,
					"content": "互いの不満は一旦置いておいて、今は共に璃月を守るべきだと、そうなったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240207,
					"content": "フン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10240208,
					"content": "なるほどな。じゃあ、何か案があるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240209,
					"content": "ううっ…こんなにも距離が離れてるのに、あの「渦の魔神」をチラッと見ただけで息が詰まりそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240210,
					"content": "千岩軍の新兵たちは、立ち上がることすらできないわ。上古魔神の威圧は、一般人にとって有害なようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10240211,
					"content": "——だからこそ、あの化け物を璃月港に近づけさせるわけにはいかない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10240212,
					"content": "怖い…2000年前の魔神戦争は、こんな敵と戦ってたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240213,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10240214,
					"content": "今ここにいる七星、千岩軍、それと仙人たちの力を合わせれば、あの魔神を倒せそうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240215,
					"content": "話し合ったけど、それは…分からないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240216,
					"content": "うそだろ！？…で、でも、璃月を守る仙人と七星だろ！何か方法はないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240217,
					"content": "方法はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10240218,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10240219,
					"content": "「帰終機」の件で、七星を悩ませたようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10240220,
					"content": "せっかく「帰終機」を作った妾がこの場にいるのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10240221,
					"content": "仙人の装置、凡人には分かるまい。だが妾が少し手を加えれば、想像を超える改良も容易いこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10240222,
					"content": "ふふっ…これも「仙人との縁」かしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240223,
					"content": "ここにいる仙人たちも、装置に仙力を注ぐことができるはずだし、これで「新帰終機」で魔神と戦えるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240224,
					"content": "善は急げ、今が決戦の時よ——作戦開始！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
