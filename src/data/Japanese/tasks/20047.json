					"nextDialogs": [
						200470303
					]
				},
				{
					"id": 200470303,
					"content": "…なるほど、なるほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470304
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470304,
					"content": "大体こんな感じだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470305
					]
				},
				{
					"id": 200470305,
					"content": "どれも価値のある手がかりだったよ、ありがとう。お礼にこれをあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470306
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470306,
					"content": "パチさん！冒険の計画を見直すよ——",
