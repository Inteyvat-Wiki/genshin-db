				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "冒険に完璧なプランはありえない！これ以上ぐずぐずして、いつになったら進展を得られる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "好奇心旺盛なパチ"
				},
				{
					"id": 200470102,
					"content": "完璧なプランがなくても、万全な準備は必要だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "ああ、<color=#00E1FFFF>千風の神殿</color>の中を探検しようと思ってるんだが、パチさんには冒険の経験がなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470105,
					"content": "今は千風の神殿に魔物がたくさんいるし、恐ろしい遺跡守衛もいる…軽率に入ったら、命を落とすだけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470106,
					"content": "パチさんの…コホン、僕たちの安全のために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470107,
					"content": "完璧な冒険プランを作ろうと今説得してるところだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470108,
					"content": "でも僕が調査に行ったら、パチさんはそのまま神殿に入ってしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470109,
					"content": "だから僕はここで彼女を見張っておかないといけないんだ。調査のことは君にお願いできないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470110,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "よかった、隅々まで見てくれると助かる。どんな些細なことも冒険の結果に影響するからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470112,
					"content": "どんな些細なことでもいいから、僕に教えて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470113,
					"content": "好奇心旺盛なパチの見張りはこちらが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "だ、だめだ！元の計画について彼女と討論しないといけないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "ドゥーラン"
				},
				{
					"id": 200470115,
					"content": "新たな手がかりの調査を頼むよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥーラン"
				}
			]
		},
