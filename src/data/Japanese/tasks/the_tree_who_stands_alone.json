			"dialogs": [
				{
					"id": 210070401,
					"content": "へへっ、これでお宝は全部俺のもんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "元良"
				},
				{
					"id": 210070402,
					"content": "兄貴も弟もバカだな、二つだけもらってすぐにどっかに行くなんて、ハハハッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "元良"
				},
				{
					"id": 210070403,
					"content": "祖先の教訓なんて、使えそうなのは一つだけだ。お宝は鉱坑の中、へへへっ、これでお宝は全部俺のもんだ…",
					"roleType": "TALK_ROLE_NPC",
