			"dialogs": [
				{
					"id": 210070501,
					"content": "行った、行った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070502,
					"content": "元青、元良…それと元成、バカな子供たちよ、ちゃんと見て、ちゃんと考えてくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
