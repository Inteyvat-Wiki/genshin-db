			"dialogs": [
				{
					"id": 210070301,
					"content": "何が兄弟だ、兄貴たちはいいものを独り占めするだけだし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070302,
					"content": "親父も見て見ぬふりするし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070303,
					"content": "お宝が鉱坑にあるって、まだ知らないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070304,
					"content": "さっさとお宝をゲットして…遠くへ行かないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元成"
