				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "うわっ…こないだの人たちだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 210070602,
					"content": "頼れない孤木…ハハッ、ひとりは、やっぱ何もできないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "元青"
				},
				{
					"id": 210070603,
					"content": "茂った紅葉は風に吹かれなくても散っていく…もし兄貴や親父の言葉を信じてたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "元成"
				},
				{
					"id": 210070604,
					"content": "紅葉は風に乗って散っていく…お宝…お宝のせいで、何もなくなった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "元良"
				},
				{
					"id": 210070605,
					"content": "盤木森々、家庭を覆い隠す…子供たち、みんな家族だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070606,
					"content": "お宝を鉱坑に隠したって思ってるだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070607,
					"content": "しかし、父さんにお宝なんてあるわけないだろう…この木を覚えてるか？お前たちの幼い頃に、家族みんなで植えたものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070608,
					"content": "父さんは毎年ここにきて、ものを埋めるんだ。お前たちが大きくなったら、また家族みんなで掘り出すようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070609,
					"content": "その時は、中のものを使って、美味しいものや酒を買って、みんなで思い出話をするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "元鴻"
				},
				{
					"id": 210070610,
					"content": "子供たちよ、子供たち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元鴻"
				}
			]
		}
	]
