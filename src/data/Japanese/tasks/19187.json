			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シュヴルーズ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191871901,
					"content": "警察隊が駆けつけるまでは、私がここを見張ってる。安心しろ、もうこいつらに逃げるチャンスはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871902,
						191871903
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191871902,
					"content": "もう一つ気になることが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191871904
					]
				},
				{
					"id": 191871904,
					"content": "それは…本件の原料には真っ当な用途も色々ある。「偽造ロシ」の製造だけに使用するものではない。だから即座に違法とは言い切れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871905
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191871905,
					"content": "通常、港での押収は一時的なものだ。様々な申告をして承認が下りなければ、元の船に戻されることになる。エロルディは返還される前に、原料をすり替えたのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871906
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191871906,
					"content": "原料を運んできた外国の船にも、彼女が事前に連絡をしていたはずだ。だからすり替えられた貨物を受け取っても、何も言わなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871907
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191871907,
					"content": "その犯行についても我々が引き続き捜査する。エロルディが捕まった今となっては、余罪の解明も時間の問題だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 191871903,
					"content": "エロルディが原料をすり替えた方法は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191871904
					]
				}
			]
		},
		{
			"id": 1918720,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1918705",
							"2"
						],
						"stepId": 1918705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リネ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191872001,
					"content": "今日は「真面目モード」の時間が過去最高を記録したんじゃない？…実に珍しいね。一体誰のためなのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872002,
						191872003
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191872002,
					"content": "もう一つ気になることが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191872004
					]
				},
				{
					"id": 191872004,
					"content": "うん…今までに得た手がかりからすると、「偽造ロシ」は最初、フォンテーヌで小規模に流通していたようだ。その小さな商いが次第に大規模な密輸に変わっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872005
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191872005,
					"content": "最初に流通したのは、ピエールが初期に製造した在庫品のはずだ。でもその稚拙な犯罪は、すぐに警察であるエロルディにバレた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872006
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191872006,
					"content": "エロルディはそこに一攫千金と、別人になって新しい暮らしを手に入れるチャンスを見出した。それで彼の初期の犯行を密かに隠蔽して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872007
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191872007,
					"content": "ベノワの名前で手紙を書いた。集めた犯罪の証拠と巨額の儲けをエサに、自分の今後の計画に協力するようピエールを脅したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872008
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191872008,
					"content": "ただ残念ながら、リネットに出会ってしまった。あの子は普段考えるのが好きじゃなさそうに見えるけど、「真面目モード」になると誰よりも鋭いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872009
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 191872009,
					"content": "…でもそのモードだと「エネルギー消費」が激しい。こっちはまだしばらく調書で時間が掛かるから、妹の「チャージ」は君に任せたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネ"
				},
				{
					"id": 191872003,
					"content": "ピエールはどうやって仲間に加わったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191872004
					]
				}
			]
		}
	]
}