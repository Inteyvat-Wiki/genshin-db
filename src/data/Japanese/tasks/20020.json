					"アナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "旅人さん、お帰りなさい。どう？写真は撮れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200201002,
					"content": "写真も実物も全部用意できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "わぁ！こんなに早く…これが経験豊富な冒険者の実力ってやつ？すごいなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200201004,
					"content": "ありがとう、旅人さん！えっと…そうだ。感謝のしるしに、手料理を作ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200201005,
					"content": "どう、いい感じじゃない？ちゃんと味わってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200201006,
					"content": "私はノートの続きを書いてくるよ。うーんと…それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200201007,
					"content": "植物標本の作り方を知ってるか、ジャックに聞いてくるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200201008,
					"content": "セシリアの花は標本にしないで、花瓶に指すだけでいいかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				}
			]
		},
