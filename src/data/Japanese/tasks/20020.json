				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "なるほど、なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200102,
					"content": "お兄ちゃん、この植物の料理以外の使い道、知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200103,
					"content": "そんなの俺が知るわけないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200200104,
					"content": "俺が知ってるのは、これがどこで採れるかと、食べられるかどうかってことだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200200105,
					"content": "うーん…じゃあ私、自分で見に行ってくる。心配しないで。植物を採ってくるだけで、魔物に近づいたりしないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200106,
					"content": "はぁ…ちゃんと分かってるならいいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200200107,
					"content": "分かってるってば。じゃあ、今日はちょっと遅くなるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200108,
					"content": "まだ訓練してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "旅人さん！ちょうどよかった。今、野外の植物を観察しに行こうとしてたところなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200111,
					"content": "冒険者はよく野宿するから、食料を探すのも大事な能力だってサイリュスさんが言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200112,
					"content": "だから、まずは野外の植物を観察して、場所とか特徴を記録してから、ゆっくり覚えていこうと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200113,
					"content": "そしたら、もし野外で食料を探すことになっても、どれが食べられるものか分かるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200114,
					"content": "でも…文字だけじゃ、さすがに分かりにくいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200115,
					"content": "旅人さん、確かあなた「写真機」って道具を持ってたよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200116,
					"content": "その「写真機」で、何種類かの植物の生息環境を撮ってきてもらえないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200117,
					"content": "問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "じゃあ、ドドリアン、イグサ、セシリアの花の生息環境を記録してきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200119,
					"content": "それから、標本にして保存したいから、その三種類の植物自体も採ってきてほしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200120,
					"content": "植物の生息環境を記録した写真と、本物の植物標本、それに詳しい文字での説明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200121,
					"content": "私の「冒険者植物ノート」、きっといいものになるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200122,
					"content": "それじゃお願いね、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200123,
					"content": "ドドリアンは清泉町の泉でたくさん採れるよ。それからイグサは奔狼領で見つかるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200124,
					"content": "セシリアの花は…もちろん星拾いの崖ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200125,
					"content": "私は他の場所で引き続き植物を観察してるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200126,
					"content": "写真を撮り終えたら、城内で落ち合いましょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200200109,
					"content": "訓練はどうなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
		{
			"id": 2002010,
