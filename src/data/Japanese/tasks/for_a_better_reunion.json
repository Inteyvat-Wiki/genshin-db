					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730310310,
					"content": "ラナの様子はどうかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#よし、ラナの様子を見に行こうぜ、{NICKNAME}。少しは良くなってるかもしれない！そしたら、お祭りに連れてこようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
						730310318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310316,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "うん。あとでボクもアランラナに会いに行くよ。アナタたちは先に行ってて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730310321,
					"content": "#ナラ{NICKNAME}、パイモン、またあとで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730310317,
					"content": "そうだといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "あまり期待はできないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310311,
					"content": "#{M#俺}{F#私}も楽しみだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "ああ！よそのお祭りとどう違うんだろうな？友達と一緒にお祭りに行くのって、やっぱわくわくするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310314,
					"content": "…ラナもいたらよかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310315
