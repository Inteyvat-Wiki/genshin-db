			"dialogs": [
				{
					"id": 730310601,
					"content": "ラナの様子は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310602,
					"content": "「ぐっすり眠れた？」って聞きたいけど、さすがに良くないよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310603,
					"content": "（ラナを包む「泡」の中から何やら景色が浮かび上がってきた…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310604
					],
					"speakerTitle": "ラナ"
				},
				{
					"id": 730310604,
					"content": "（景色に浸ってみよう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310605
					]
				},
				{
					"id": 730310605,
					"content": "あなたは森にいる。あまりにも広大で静かな森を、あなたは自由自在に動き回る。\\n時おり木漏れ日が髪を金箔のようにきらめかせた。あなたと同じくらいの背丈の野草が嬉しそうに小さく笑い、通り過ぎるあなたの手にそっと触れる。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310606
					]
				},
				{
					"id": 730310606,
					"content": "風の中で木がハミングし、流水が音楽を奏でる。その時、あなたは不安げな泣き声に気づく。声をたどっていくと、そこには小さな人形がいた。\\n泣き疲れたのか、彼女は草地に突っ伏して眠っていた。あなたは彼女に寄り添い、心安らぐ歌声を響かせた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310607
					]
				},
				{
					"id": 730310607,
					"content": "#…おい！{NICKNAME}、どうしたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310608,
					"content": "大丈夫そうでよかった…おまえの様子を見て、オイラ気絶するかと思ったぜ…ふぅ、ビックリした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310609,
					"content": "#ナラ{NICKNAME}！来てくれたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310610
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310610,
					"content": "わっ！ビックリした！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310611,
					"content": "うわっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310612,
						730310613
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310612,
					"content": "うわっ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				},
				{
					"id": 730310614,
					"content": "ホントに、おまえらアランナラはどうしてこう神出鬼没なんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310615,
					"content": "白いふわふわこそ、どうして急に「わっ！」と言った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310616
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310616,
					"content": "オイラはパイモンだ。白いふわふわじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310617,
					"content": "アランラナは、地面の中でアランラカラリの力を保ってる。こうすれば、ナララナは枯れない。けど、再び強くなるにはやっぱりビージャの実が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310618
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310618,
					"content": "#なるほどな。それはともかく、{NICKNAME}は一体どうしちゃったんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310619,
					"content": "（自分の感じた光景について説明した…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310620
					]
				},
				{
					"id": 730310620,
					"content": "それはアランラナの思い出だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310621
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310621,
					"content": "思い出…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310622,
					"content": "パイモンは知らない。思い出と夢はアランナラの力、もっとも大事なもの。夢と思い出があれば、アランラナはアランラカラリを使って、助けを求めるナラとアランナラを助けられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310623
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310623,
					"content": "#ナラの中には、アランラカラリの中の記憶を感じ取れる者がいる。ナラ{NICKNAME}もそうみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310624
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310624,
					"content": "そう聞くと、アランラカラリってとても大事なものなんだな！この前、あの洞窟でアランラカラリを使ってイッサムを守ったのもアランラナなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310625,
					"content": "そう、アランラナだ。ナライッサム、ナラカブス、ナラスダッベはみんな友達。だからアランラナはカレらを守る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310626
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310626,
					"content": "カレらはいつも森でアランラナと一緒に遊ぶ。アランラナはあの子たちに、森の知識と草花の言葉を教えた。とても大事な友達、ナララナと同じ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310627
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310627,
					"content": "子供が行方不明になることについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310628
					]
				},
				{
					"id": 730310628,
					"content": "そうだ！そういえばイッサムの前にも、カブスとスダッベが行方不明になったんだよな…でも、その後ヴィマラ村に戻ってきた。これもアランラナのしわざなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310629,
					"content": "うん。アランラナは悪いナラとナラワルカが子供たちを連れ去るのを見た。だから、悪いナラに気づかれないようにナラカブスとナラスダッベを助けて連れて行った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310630,
						730310632
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310630,
					"content": "やっぱりそうだったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310631
					]
				},
				{
					"id": 730310631,
					"content": "ああ…でも、なんであいつらはそのことを覚えていなかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310633,
					"content": "アランラナは小さいナラを眠らせて、夢の中で悪いものを取り除いた。そうすれば、小さな苗木が大樹へと育つかのようにカレらが大きくなった時、悪いナラにならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310634
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310634,
					"content": "さもないと、小さいナラはずっと怖さを抱えたまま、やがて「怖さ」の力を信じるようになる。そして大きくなった後、他の人を怖がらせる悪いナラになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310635
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310635,
					"content": "カレらはアランラナの友達、だからアランラナは、カレらが悪いナラになってほしくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310636,
						730310638,
						730310640
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310636,
					"content": "筋が通ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310637
					]
				},
				{
					"id": 730310637,
					"content": "ああ、あいつらはきっといい大人になるぞ！それよりアランラナ、あいつらを連れ去ろうとした悪いナラについて、覚えてることはないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310641,
					"content": "アランラナは決して許さない。あの悪いナラたちは森の子供じゃない。ヤツらはナラワルカを連れてやって来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310642
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310642,
					"content": "ヴィマラ村にも変なナラがいる。あのナラは森の子供じゃなくて、雪の子供。でも、いいナラみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310643
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310643,
					"content": "そのナラはよく小さいナラと一緒にいて、小さいナラもよくカレの話をする。でも、アランラナはカレと悪いナラが一緒に話をしているのを見た。アランナラのことを話していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310644
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310644,
					"content": "ヴィマラ村にいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310645,
						730310646
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310645,
					"content": "ファデュイの仲間？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310647,
					"content": "そ、そんなことって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310648
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310648,
					"content": "うぅ…オイラ、考えたくないぞ。ヴィマラ村の人たちは、家族みたいにあいつを…それに、あいつがラナをこんな風にしたなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310649,
						730310650
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310649,
					"content": "悪いやつは捕まえなきゃ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310651,
					"content": "ああ。どっちにしろ、あいつを捕まえないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310652
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310652,
					"content": "#ナラ{NICKNAME}、パイモン、約束してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310653
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310653,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310654
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310654,
					"content": "必ず悪いナラを罰すると。そうすれば、ナライッサム、ナラカブス、ナラスダッベはもう二度と怖い目に遭わずに済む。小さな木のように、健やかな大きいナラに成長できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310655,
						730310656
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310655,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310657,
					"content": "ナララナは健やかに育った。だからアランラナが見えなくなった。でも、アランラナは悲しくない。アランラナはカノジョが元気なら嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310658
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310658,
					"content": "もう長いことナララナと遊んでない。たくさんの太陽が昇っては沈み、月が空に現れた。たくさんの果実が実り、また地に戻った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310659
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310659,
					"content": "ナララナはどんどん大きくなった。最初はアランラナと同じくらい、でもすぐ小さな木くらいになった。そしてカノジョはもうアランラナと遊ばなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310660
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310660,
					"content": "アランラナはカノジョとたくさんの森の物語を話した。星茸は空の星が地面に落ちてきた影。サウマラタ蓮が咲いているのを見られたら、次の月が昇るまで幸運が続く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310661
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310661,
					"content": "この話はナライッサムたちにも教えた。カレらもナララナのように健やかに育ってほしい。ああ、でもナララナのようにマラーナに行ってはダメ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310662
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310662,
					"content": "あいつらも大人になったら、森の物語を忘れちゃうのか？ラナみたいに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310663
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310663,
					"content": "ナライッサム、ナラカブス、ナラスダッベも大人になる。大人になって、忘れても大丈夫…最後には森がすべてを記憶している。すべては消えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310664
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310664,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310665
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310665,
					"content": "すべては消えない。すべての美しいことは消えない。すべての苦しみも、すべての美しいことの養分になる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310666
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310666,
					"content": "#アランラナ！ナラ{NICKNAME}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310667
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730310667,
					"content": "アランマ！アランマに会うのは久しぶりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310668,
						730310671
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310668,
					"content": "パイモン、「わっ！」って言わないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310669
					]
				},
				{
					"id": 730310669,
					"content": "おい！オイラはそんな簡単に驚いたりしないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310670
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310670,
					"content": "アランマはウツァヴ祭のために、オイラたちをヴァナラーナに連れ戻しに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310672
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310672,
					"content": "#うん！ウツァヴ祭の準備は終わった。みんなナラ{NICKNAME}とパイモンを待ってるよ。行こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310673
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730310673,
					"content": "やった！ウツァヴ祭だ！アランラナも行くよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310674
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310674,
					"content": "ううん、アランラナは行かない。アランラナが長くここを離れると、アランラカラリが崩れてナララナが危険になる。だから、ウツァヴ祭には行けない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310675
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310675,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310676
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310676,
					"content": "#大丈夫。ナラ{NICKNAME}とパイモンが楽しければ、アランラナ、アランマ、そしてヴァナラーナのみんなが楽しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310677
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310677,
					"content": "うん。でもアランラナ、ビージャの実にはアナタの力が必要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310678
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730310678,
					"content": "大丈夫、その時が来たら、アランラナの準備も済んでると思うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310679
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310679,
					"content": "#そうだ。ナラ{NICKNAME}、これをキミに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310680
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310680,
					"content": "小さな花…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310681
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310681,
					"content": "うん、カノジョを守ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310682,
						730310683
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310682,
					"content": "大事に取っておくね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310684,
					"content": "#ありがとう、ナラ{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310685
					],
					"speakerTitle": "アランラナ"
				},
				{
					"id": 730310685,
					"content": "#うん。じゃあ帰ろう、ナラ{NICKNAME}、パイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730310683,
					"content": "うん、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310671,
					"content": "ウツァヴ祭のために戻ったほうがいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310672
					]
				},
				{
					"id": 730310656,
					"content": "できる限りやってみるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310650,
					"content": "あいつを捕まえよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310646,
					"content": "子供に良くない人間？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
