			"dialogs": [
				{
					"id": 730310101,
					"content": "アランラジャ、アランマ、帰ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310102,
					"content": "#またナラ{NICKNAME}とパイモンに会えた！すごく嬉しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730310103,
					"content": "#おお、よくぞ帰られた。多くの者が、大きくて強いナラ{NICKNAME}にとても世話になったと言っておる。皆、とても喜んでおるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730310104,
					"content": "#確かに仕事を手伝ってもらえたら嬉しいもんな！だろ？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310105,
					"content": "とても嬉しい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "そうではない。皆、新しい友達ができたのが嬉しいんじゃ。アランナキン、アランナガ、アランガルは覚えていないが、森はすべてを記憶する。物語は決して消えないんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730310108,
					"content": "おー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730310109,
					"content": "ウツァヴ祭の準備は順調だ。あと少しがんばるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "アランマ"
				},
				{
					"id": 730310110,
					"content": "#うむ、ナラ{NICKNAME}とパイモンが手を貸してくれたおかげじゃ。いよいよウツァヴ祭が始まるぞ。楽しみじゃな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランラジャ"
				},
				{
					"id": 730310106,
					"content": "そうか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				}
			]
		},
