			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イルマリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760210401,
					"content": "今日も収穫ナシか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210402,
						760210405,
						760210412,
						760210417,
						760210421
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210402,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210403
					]
				},
				{
					"id": 760210403,
					"content": "釣りじゃ。今のとこ、魚じゃない変なものばかり釣れとるがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210404
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210404,
					"content": "もし沈没船の小物なんかが釣れれば、行商人が買い取ってくれるんじゃがな。前に釣り上げた靴なんか…おっと、あんまり話すと魚が逃げちまうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210405,
					"content": "この辺りで何か気になったことはない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210406
					]
				},
				{
					"id": 760210406,
					"content": "また宝探しか？月の東、太陽の西にしかない「偉大なる財宝」なんてものは…聞いただけで、ここにはないとわかるじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210407
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210407,
					"content": "ここは昔から船の海難事故が多い場所なんじゃ。沈没船の中には確かに価値のあるものもあるかもしれんがな、見つけ出すのはそう簡単じゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210408
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210408,
					"content": "これは酒場で生き残った船乗りから聞いた話なんじゃが…その夜は月もないのに、荒れ狂う大波の中に光る物が見えたんじゃと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210409
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210409,
					"content": "間違いなく隻眼のケラティに違いないと言っておったのう。月さえも飲み込む怪物が、海の巨蛇と縄張り争いをしておったのじゃと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210410
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210410,
					"content": "その後は長いこと、このあたり一帯が、まるでインク壺をひっくり返したみたいに真っ黒じゃったわい。どの船も怖がって、通らんようになってのう…みんな、水底の亡霊に引きずり込まれるんじゃないかと震え上がっとったもんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210411
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210411,
					"content": "亡霊たちは今でもこの辺りを彷徨っておるかもしれんが…わしには見えとらんから気にならん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210412,
					"content": "あの木について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210413
					]
				},
				{
					"id": 760210413,
					"content": "あの木はちょっと不気味でのう。元々ここいらには渦が出るもんでな、船乗りたちはケラティの眼と呼んでおったんじゃが、ある日突然、生えてきおったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210414
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210414,
					"content": "あの頃起きたおかしなことと言えば、それだけじゃなかったのう。考えてみれば、石っころが空から降ってきた後のことじゃ…もしかしたら、この木も石っころと同じように天外から来たのやもしれんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210415
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210415,
					"content": "たびたび見かけるキラキラした小物も、珍しいものばかりじゃ。ひょっとして、新種の魚でもおるのかもしれんと思って、運試しに来とるんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210416
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210416,
					"content": "もともとは、わしの釣り仲間も一緒に来とったんじゃが…妙な歌声が聞こえると言い出しおってな、怖じ気づいて来なくなってしもうた。半分霜月の子なんじゃが、悪癖はまるっきり、そのものじゃわい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210417,
					"content": "「識者の証」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210418
					]
				},
				{
					"id": 760210418,
					"content": "「識者の証」だの、月の東、太陽の西に眠る「偉大なる財宝」だの…わしに言わせれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210419
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210419,
					"content": "欲に目がくらんで本来手にすべきでないものを追いかけるから、ろくなことにならんのじゃ。アトラス号船長のグレティルも、その「宝」に心を奪われて、破滅したそうじゃぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210420
					],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210420,
					"content": "結局は海の底に沈む羽目になって、宝は何一つ手に入らんかった。骨折り損のくたびれ儲けじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				},
				{
					"id": 760210421,
					"content": "邪魔したね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210422
					]
				},
				{
					"id": 760210422,
					"content": "構わん構わん。どうせ魚の影も見えんからの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イルマリ"
				}
			]
		}
	]
}