			},
			"dialogs": [
				{
					"id": 721630401,
					"content": "おかえり、どうだった？写真は撮れたのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630402,
					"content": "全部撮った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "よかった、どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630404,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630405,
					"content": "あははっ、どこなのかまったく分からないや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630406,
					"content": "でも、あの3枚の風景は、もうだいぶ変わってるようだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630407,
					"content": "あの藤原俊子さんは…これらの場所を知っているのだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630408,
					"content": "でも…ははっ、彼女も知らないと思うけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630409,
					"content": "彼女もセイライ島から来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "正確に言うと、僕と同じく、先祖がセイライ島で暮らしてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630411
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630411,
					"content": "まあ実は、先祖がセイライ島で暮らしてた人は稲妻城にも結構いるんだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630412
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630412,
					"content": "どうしてセイライ島から離れたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630413
					]
				},
				{
					"id": 721630413,
					"content": "それは僕も分からない…もう凄く昔のことだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630414
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630414,
					"content": "雷が激しいからだとか、密輸や密入国を防ぐためだとか、そういう理由じゃないかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630415
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630415,
					"content": "とにかく、幕府の手配で、セイライ島にいたほとんどの人は鳴神島に移住した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630416
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630416,
					"content": "そろそろ話を終わりにしよう。これを受け取ってくれ、手伝ってくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630417
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630417,
					"content": "はぁ、いつになったらセイライ島に行けるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630418
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630418,
					"content": "まずは手元にある仕事を終わらせよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "太田太郎"
				}
