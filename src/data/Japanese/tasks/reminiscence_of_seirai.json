					"古谷昇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "困ったなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 721630202,
					"content": "この図について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "この図にある地形から察するに、セイライ島にある場所みたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 721630204,
					"content": "どうやって分かったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "協会も過去に何度か、セイライ島に関する探索依頼を出したことがあるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 721630206,
					"content": "依頼を受けた冒険者たちが協会へ報告に戻る時、セイライ島に関する情報も一緒に持ってくるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 721630207,
					"content": "でも人手が足りないから、組織的で大規模な調査はまだ行えてない。時々数名の冒険者を調査に送っているだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 721630208,
					"content": "だから、僕が持っているセイライ島の情報にも限りがある。君たちのためにこれを解読するのは難しいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 721630209,
					"content": "ただ、城内に一人だけセイライ島に関わる人がいるのを知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 721630210,
					"content": "名は太田太郎、彼によると…彼の先祖はかつてセイライ島で暮らしていたんだけど、様々な原因からここに移住してきたらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 721630211,
					"content": "そういえばこの前、セイライ島の視察に同行してくれる冒険者を雇うために、協会に来たことがあった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "古谷昇"
				},
				{
					"id": 721630212,
					"content": "これを彼のもとに持っていって聞いてみるといい。何か分かるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古谷昇"
				}
			]
		},
		{
			"id": 7216303,
			"completionStepIds": [
				7216302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
