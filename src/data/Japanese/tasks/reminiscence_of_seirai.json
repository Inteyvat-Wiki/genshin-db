			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"太田太郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "はぁ、いつになったら一緒に行ってくれる人が見つかるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630302,
					"content": "この図について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "君は…冒険者協会から来た冒険者か？やっと協会から人手が！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630304,
					"content": "ただの通りすがりの旅人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "そっか…ん？何か見せたいものがあるって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630306,
					"content": "どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630307,
					"content": "こ、これは！まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630308,
					"content": "何か分かったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "これはセイライ島じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630311,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "あははっ、本当にセイライ島だったのか？実は僕も当てずっぽうだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630314,
					"content": "確かに僕の先祖はセイライ島で暮らしてたけど、それはもうずっと昔のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630315,
					"content": "僕の代じゃ、もうセイライ島に対する印象はほとんどなくなってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630316,
					"content": "家に残ってるセイライ島に関するものも…3枚の風景画しかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630317,
					"content": "じゃあなんで帰りたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "それは…なんて言うか、やっぱり僕の「故郷」だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630319,
					"content": "なんか…絶対に見に行ってみなきゃっていう気持ちがあるのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630320,
					"content": "でも僕はいま商売で忙しくて、ここを離れられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630321,
					"content": "それに…僕をセイライ島まで護送してくれる冒険者の人も見つからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630322,
					"content": "だから、考えを変えて冒険者協会で依頼を出したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630323,
					"content": "僕の代わりにセイライ島まで行き、「写真機」を使ってあの3枚の風景画の場所を記録してきてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630324,
					"content": "でもまだ引き受けてくれる冒険者が見つかってない…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630325,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "ほ、ホント！？手伝ってくれるなんて本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630328,
					"content": "報酬のことは安心して、きちんと準備するから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630329,
					"content": "それじゃ頼んだよ。君が持ってきたのと合わせれば、全部で4枚ある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630330,
					"content": "セイライ島に行って、この4つの場所でそれぞれ写真を撮ってきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "太田太郎"
				},
				{
					"id": 721630326,
					"content": "手伝ってあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "そうだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "#これは{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の家？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
		{
			"id": 7216304,
