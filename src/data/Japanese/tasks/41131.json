				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "隕石に触れたら昏睡状態になる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "ん？ああ…それは聞いたことあるよ。確かに問題だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310403,
					"content": "でも、この問題を解決できる機器が現れると信じてるよ。うん…たぶん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310404,
					"content": "…おっ、なんか動揺してるな。もしかして…この商売にかかる代償を量ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411310405,
					"content": "このまま説得して、この商売が金にならないか…隕石が本当に危ないってことを分からせるべきだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4113105,
