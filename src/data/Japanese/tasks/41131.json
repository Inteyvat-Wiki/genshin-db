				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "他の人も思いつく…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "うん、もちろん。だからいち早くいかないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310303,
					"content": "旅人、君がいいなら、すぐにでも出発しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310304,
					"content": "ここで一秒でも無駄にしてたら、得られるモラが減ってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310305,
					"content": "…うむ…全然説得できないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411310306,
					"content": "この商売が金にならないか…隕石が本当に危ないってことを分からせないとだめだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 4113104,
			"completionStepIds": [
