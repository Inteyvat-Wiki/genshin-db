					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "だから君を雇うんじゃないか、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴァノヴィチ"
