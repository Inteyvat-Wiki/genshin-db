			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"イヴァノヴィチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "うん…悪くない、これは絶対稼げる。けど少し問題が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310102,
					"content": "何の問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "ん？ああ…旅人、君か。ちょうどよかった！その…よかったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310107,
					"content": "神秘的で…偉大で…空前絶後な大稼ぎができる商売？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310108,
					"content": "君の小さな手助けで、私たちは大金持ちになれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310104,
					"content": "北国銀行は守備が固い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "あ、それはもちろん、守衛すらもスネージナヤ人だからそう簡単には…って！違う！何を考えてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310106,
					"content": "どうやら旅をしてきた君は確かに思考が広いね、想像力が豊かすぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310112,
					"content": "しかし今回の私の計画は、間違いなく現実的なものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310113,
					"content": "最近空から降る隕石を知ってるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310114,
					"content": "その隕石を見つけて、そこから欠片をいくつか取ってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310115,
					"content": "それから、職人に加工してもらって装飾品に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310116,
					"content": "これで隕石から作った装飾品の完成…指輪、ネックレス、腕輪、イヤリング。どれにしてもお金持ちがこぞって買うに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310117,
					"content": "旅人、君がすべきことは簡単だ。私が魔物に邪魔されないようにしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310118,
					"content": "どうだ、この話に乗るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310119,
					"content": "隕石に近づいてはいけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "なに？こんな大きなチャンス逃すわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310109,
					"content": "法典でなにか見つけた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "うん、確かに、璃月の法典は厳密で抜け道がない。だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "イヴァノヴィチ"
				},
				{
					"id": 411310111,
					"content": "おいおい違う！私がしようとしてるのは、法典で許された範囲内のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "イヴァノヴィチ"
				}
			]
		},
