			"dialogs": [
				{
					"id": 100120401,
					"content": "やっぱり、騎士団はもう動き始めてるよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120402
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120402,
					"content": "あの人だかりは？なんだか様子がおかしいよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120403
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120403,
					"content": "あれは…アドルノだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120404
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120404,
					"content": "数時間前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100120405
					]
				},
				{
					"id": 100120405,
					"content": "ふぅ…こんなところにいたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120406
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120406,
					"content": "ニャー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120407
					],
					"speakerTitle": "北地ショートヘア"
				},
				{
					"id": 100120407,
					"content": "目を離しちゃ駄目じゃないか。ちゃんと、手の届く範囲で遊ばせないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120408
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120408,
					"content": "ありがとう…本当にありがとう、アドルノおじいちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120409
					],
					"speakerTitle": "モリツティール"
				},
				{
					"id": 100120409,
					"content": "それと、もう一人で街の外へ探しに行かないようにね。お前がその子を心配するように、ハンネローレだってお前を心配してるんだ。今回は秘密にしてあげるけど、これっきりだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120410
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120410,
					"content": "うん…わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120411
					],
					"speakerTitle": "モリツティール"
				},
				{
					"id": 100120411,
					"content": "ニャー…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120412
					],
					"speakerTitle": "北地ショートヘア"
				},
				{
					"id": 100120412,
					"content": "グルル…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120413
					],
					"speakerTitle": "魔物"
				},
				{
					"id": 100120413,
					"content": "あっ！ま…魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120414
					],
					"speakerTitle": "モリツティール"
				},
				{
					"id": 100120414,
					"content": "魔物？どうしてこんなところに…それに、どこか様子も変だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120415
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120415,
					"content": "あっ…ああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120416
					],
					"speakerTitle": "モリツティール"
				},
				{
					"id": 100120416,
					"content": "怖がらなくていい、俺がついてるぞ！ほら、立て！走って逃げるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120417
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120417,
					"content": "で…でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120418
					],
					"speakerTitle": "モリツティール"
				},
				{
					"id": 100120418,
					"content": "早く行くんだ——ここはおじいちゃんに…騎士に任せておけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アドルノ"
				}
			]
		},
