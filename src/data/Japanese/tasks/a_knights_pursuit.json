			},
			"dialogs": [
				{
					"id": 100120501,
					"content": "…その後駆けつけた騎士たちが、近郊に侵入した魔物を片付けたが…やつの力は、常軌を逸していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120502
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120502,
					"content": "それでもアドルノは子供が逃げる時間を稼ぐために、最後まで必死に戦ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120503
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120503,
					"content": "アドルノさん…アドルノさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120504
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120504,
					"content": "ふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120505
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120505,
					"content": "…大丈夫だ。俺の身体のことはお前もよく知ってるだろ…お前がいなけりゃ、今日まで生きてはこられなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120506
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120506,
					"content": "誰かを救うためにまた身体を張るほうが、ベッドで寝てるより…よっぽど騎士らしいと思わないか！…ゴホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120507
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120507,
					"content": "長い間、俺の身体をよく診てくれたのに…残念だが、ここまでみたいだ…苦労をかけたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120508
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120508,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120509
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120509,
					"content": "ローエン…「仁愛騎士」の称号、そして第5小隊の隊長の座は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120510
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120510,
					"content": "俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120511
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120511,
					"content": "——気に入らなければ、放っておけばいい。お前は…お前の生き方をすればいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120512
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120512,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120513
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120513,
					"content": "…ローエン、ちょっと来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120514
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120514,
					"content": "調査小隊の分析結果が出た。アドルノを襲った魔物は、ウルサの気配を纏っていたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120515
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120515,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120516
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120516,
					"content": "ここまできて、まだだんまりを決め込むつもりか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120517
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120517,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120518
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120518,
					"content": "これは尋問じゃない。黙秘を続けても構わないが、できれば洗いざらい話してくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120519
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120519,
					"content": "——ああ、話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120520
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120520,
					"content": "…全部話すし、どんな処罰だって受けてやる。だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120521
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120521,
					"content": "もう一晩だけ、俺に時間をくれ。明日、騎士団本部ですべて説明するから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120522
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120522,
					"content": "これは、騎士としての誓いだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120523
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120523,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120524
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120524,
					"content": "…お前とは長い付き合いだが、騎士の名に懸けて宣誓するのを聞くのはこれが初めてだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120525
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120525,
					"content": "ハッ、俺一人が誓いを立てたところで大した信用がねぇことくらい、分かってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120526
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120526,
					"content": "だが、「仁愛騎士」の願いも上乗せすりゃ、十分な重みになるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120527
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120527,
					"content": "約束だからな、ローエン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120528
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120528,
					"content": "…すまないな、テオドール…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120529
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120529,
					"content": "本当は隊長の座をローエンに譲り、「仁愛」の称号をお前に残すつもりだった…お前が幼い頃からこの称号に憧れていたことを、知っておきながら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120530
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120530,
					"content": "それはあなたのせいじゃありません、アドルノさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120531
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120531,
					"content": "僕にはローエンのように、騎士団の試験に容易く合格できるほどの才能がなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120532
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120532,
					"content": "何年努力しても、いまだに見習い医師のまま…そんな僕が、騎士の名を継ぐわけにはいきませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120533
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120533,
					"content": "ゴホッ…医師であれ騎士であれ、みんなを守っていることに変わりはないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120534
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120534,
					"content": "俺はずっと、お前は「仁愛」の名に相応しい騎士だと思っていたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120535
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120535,
					"content": "…そんなことはありません。僕は、多くの過ちを犯してきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120536
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120536,
					"content": "そして今から…さらに大きな過ちを犯そうとしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120537
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120537,
					"content": "…こうも簡単に彼の頼みを聞き入れてよかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120538
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120538,
					"content": "じゃあ、どうしろっていうんだ？報告書を提出させて、それを承認してから行かせれば満足だったか？勘弁してくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120539
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120539,
					"content": "あいつにとってアドルノがどれほど大きな存在だったかは、よく知ってる。だから、あの誓いの重みも信用できるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120540
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120540,
					"content": "昔、ある男が騎士の名のもとに父に多くの誓いを立てたが、最終的にその友情は裏切られた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120541
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120541,
					"content": "「歪んだ執念と時の移ろいは、友さえ敵へと変貌させる。風向きが変わるのと同じくらい、ありふれたことだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120542
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120542,
					"content": "…クリプスの言葉か？懐かしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120543
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120543,
					"content": "おまえたち…知り合いだったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120544
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120544,
					"content": "かつて、野心に溢れた青二才が三人集まって、それぞれの未来を思い描いてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120545
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120545,
					"content": "騎士に憧れた金持ちの坊っちゃんは、結局ワイナリーの家業を継ぐことになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120546
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120546,
					"content": "規律を破ってばかりの半人前は、最終的に騎士団全体を率いることになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120547
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120547,
					"content": "そして最後の一人は…欲した富も、憧れた力も、何ひとつ手に入れることはできなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120548
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120548,
					"content": "残された執念だけが、日を追うごとに高く高く積み上がっていったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120549,
						100120550
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120549,
					"content": "憧れが執念に変わったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120551
					]
				},
				{
					"id": 100120551,
					"content": "それが、イロックが…「博士」に付け込まれた原因なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120552
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120552,
					"content": "「博士」が何を吹き込んだにせよ、選択をしたのはイロック自身だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120553
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120553,
					"content": "やつの考えが理解できるからといって、同情するわけじゃない。ましてや、同じ轍を踏むなんてことはありえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120554
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120554,
					"content": "今度こそ、俺は部下から目を離さねぇ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120555
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120555,
					"content": "た、大変だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120556
					],
					"speakerTitle": "レッツブルグ"
				},
				{
					"id": 100120556,
					"content": "——お、おい！俺の話はまだ終わってないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120557
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120557,
					"content": "今の声…アドルノじいちゃんがいるほうからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120558,
						100120559
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120558,
					"content": "あの誓いが信用できるかは置いといて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120560
					]
				},
				{
					"id": 100120560,
					"content": "レッツブルグ…何があった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120561
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120561,
					"content": "アドルノじいちゃんが…いない！？それに、ローエンとテオドールもか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120562
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120562,
					"content": "分かりません…見回りに来たらドアが開けっ放しになってて、中を覗いたら…もぬけの殻だったんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120563
					],
					"speakerTitle": "レッツブルグ"
				},
				{
					"id": 100120563,
					"content": "アドルノ隊長はベッドから起き上がれるような状態ではないですし…一体、誰が連れ去ったのでしょう！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120564
					],
					"speakerTitle": "レッツブルグ"
				},
				{
					"id": 100120564,
					"content": "大団長——緊急事態です！ローエン副隊長が巡回中の騎士の制止を振りきって、郊外へ向かいました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120565
					],
					"speakerTitle": "ヴォーナー"
				},
				{
					"id": 100120565,
					"content": "ったく…あいつ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120566
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120566,
					"content": "彼は何か言っていなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120567
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120567,
					"content": "何か…？いえ…副隊長はひどく急がれている様子で、私たちに道を開けるよう叫ばれて走り去ってしまいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120568
					],
					"speakerTitle": "ヴォーナー"
				},
				{
					"id": 100120568,
					"content": "追いかけなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120569
					]
				},
				{
					"id": 100120569,
					"content": "もちろん追いかけました！ですが、私たちではローエン副隊長の足に追いつくことはできず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120570
					],
					"speakerTitle": "ヴォーナー"
				},
				{
					"id": 100120570,
					"content": "追えるところまででいい、追ってくれ！そのあとは俺たちに任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120571
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120571,
					"content": "おい、ディルック、「栄誉騎士」…ひとっ走り付き合ってくれるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120559,
					"content": "早く行ってみよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120560
					]
				},
				{
					"id": 100120550,
					"content": "憧れが嫉妬に変わったんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120551
					]
				}
			]
		}
	]
}