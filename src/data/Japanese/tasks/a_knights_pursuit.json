				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100120101,
					"content": "くそっ…悔しいが、この手にはもうまともに剣を握る力も残っていないんだ。俺が一緒に行ったところで、昨日と同じように邪魔になるだけだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120102
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120102,
					"content": "今日の日課は、俺一人でこなすとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アドルノ"
				}
			]
		},
		{
			"id": 1001202,
			"completionStepIds": [
				1001202
