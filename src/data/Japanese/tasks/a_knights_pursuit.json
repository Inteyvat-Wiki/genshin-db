			"dialogs": [
				{
					"id": 100120301,
					"content": "少し前…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100120302
					]
				},
				{
					"id": 100120302,
					"content": "こいつで最後か…たっぷり楽しませてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120303
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120303,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120304
					],
					"speakerTitle": "魔物"
				},
				{
					"id": 100120304,
					"content": "…あん？誰だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120305
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120305,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120306
					],
					"speakerTitle": "魔物"
				},
				{
					"id": 100120306,
					"content": "チッ…逃げやがったか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120307
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120307,
					"content": "——ワイナリーの旦那が、魔物狩りにここまで熱心だったとはな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120308
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120308,
					"content": "それとも、本当に追ってるのは魔物だけじゃない…ってか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120309
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120309,
					"content": "君が排除したいのも、「魔物」だけというわけではないんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120310
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120310,
					"content": "現場は「何一つ」痕跡が残されていないほど、念入りに処理されていたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120311
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120311,
					"content": "へぇ、そいつは初耳だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120312
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120312,
					"content": "なら、一緒にこの辺りの魔物を調べよう。多くの人が関心を寄せる異常が、どこにあるのかをね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120313
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120313,
					"content": "…やめだやめだ、俺は逃げた魔物を追うとするぜ。調査なんてのは、俺のガラじゃないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120314
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120314,
					"content": "じゃあな、ディルック…「先輩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120315
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120315,
					"content": "君たちが来る前の出来事は、大体こんなところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120316
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120316,
					"content": "ローエンのやつ…一体なにを考えてるんだ？やっぱり「頑丈騎士」はやめて、「横暴騎士」って呼んでやろうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120317,
						100120318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120317,
					"content": "それで、この魔物たちがどうかしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120319
					]
				},
				{
					"id": 100120319,
					"content": "そうだぞ！昨日アドルノじいちゃんが言ってたけど…そいつら、ちょっと変わってるけど、人を襲ったりはしてないんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120320,
					"content": "可能性としては、何者かが陰で密かに処理していると考えられる。そして…どうやら奴らは腹が減ると、優先的に自分の仲間を攻撃する習性があるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120321
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120321,
					"content": "仲間を…攻撃するの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120322
					]
				},
				{
					"id": 100120322,
					"content": "ああ。目撃情報が少なく、確信が持てなかったが…ここに残された魔物の残骸には、確かに互いに攻撃し合った痕跡が数多く残っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120323
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120323,
					"content": "群れを成していながら、互いに殺し合う…自然発生した魔物とは思えないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120324
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120324,
					"content": "確かに、不気味だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120325
					]
				},
				{
					"id": 100120325,
					"content": "えっ？でも、魔物同士で攻撃し合うっていうんなら、ほっといて自滅するのを待てばいいだけじゃないか？どうしてそんなに警戒するんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120326,
					"content": "なにせ、「ウルサの血肉」を持つ魔物が現れたのは、今回が初めてじゃないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120327
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120327,
					"content": "——ファルカ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120328,
					"content": "よう、奇遇だな。栄誉騎士にパイモン、それにディルックも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120329
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120329,
					"content": "…どうやら騎士団も、今回の異常事態について何も知らなかったというわけではないようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120330
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120330,
					"content": "ああ…イロックの悲劇は、二度と繰り返させるわけにはいかないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120331
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120331,
					"content": "さっき言ってた…「ウルサの血肉」？それも、イロックってやつと関係あるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120332,
					"content": "常軌を逸した力を得るため、イロックはかつてドットーレの断片と共謀した。そして、魔龍ウルサの血肉から、その力が込められた血清を抽出したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120333
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120333,
					"content": "俺たちがイロックの粛清を決断した時、あいつと配下の連中はすでにその血清を使っててな…対処に手を焼かされたもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120334
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120334,
					"content": "筋力が大幅に増し、血に飢え、狂気に飲み込まれたやつは、仲間同士で殺し合ってさえいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120335
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120335,
					"content": "皮肉なもんだ…結局、イロックはその力を制御しきれず、配下のやつらにも剣を向け、狂気の果てに自滅しちまったんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120336
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120336,
					"content": "魔龍ウルサ…一体なにものなんだ？そんな恐ろしい力を持ってるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120337,
						100120338
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120337,
					"content": "千年前からいるって聞いた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120339
					]
				},
				{
					"id": 100120339,
					"content": "ああ、そうだ。確かに、そういうこともあったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120340
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120340,
					"content": "じゃあ…なんでその時は封印しかしなかったんだ？まさか、初代大団長でもそいつを倒せなかったってのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120341,
					"content": "いや…伝説の魔龍ウルサは、かつて「天の使い」だったからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120342
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120342,
					"content": "——えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120343,
					"content": "——えっ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120344
					]
				},
				{
					"id": 100120344,
					"content": "遥か昔の話だが…天の使いたちはある選択を迫られたらしい…その時ウルサが選んだのは、己の「力」を残すことだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120345
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120345,
					"content": "心を失い力だけが残されようとも、その天の使いは人間の都市国家に憧れを抱き続けた。だがそいつは、自分が近づいただけで周囲の無数の命を滅ぼしちまうってことすら…もはや分からなくなっていたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120346
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120346,
					"content": "だから、当時のヴァネッサはそれを封印することを決めたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120347
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120347,
					"content": "ああ。だが、ウルサは「博士」の手によって再び目覚めた…これは間違いなく騎士団の過失だ。俺はその事実から目を背けるつもりはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120348
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120348,
					"content": "過去の責任を追求するより…今は目の前の禍根を早急に断つことのほうが重要だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120349
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120349,
					"content": "——魔龍ウルサの血肉の性質が、なぜ今またあの魔物たちに発現したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120350
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120350,
					"content": "…今となっては認めちゃいないが、かつて俺たちは、イロックに対して大きな期待を寄せててな。あいつは騎士団のやり方をよく知ってやがる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120351
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120351,
					"content": "あいつは討たれる前に、実験場に関する情報をすべて破棄したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120352
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120352,
					"content": "おかげで、いまだに実験に使われてた材料の在り処も掴めてない。恐らく、「断片」の援助もあったんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120353
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120353,
					"content": "だがドットーレが残した手駒は、すべて旅人がスメールで片付けた。それはお前も耳にしてるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120354
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120354,
					"content": "当時やつの「断片」がモンドに残した「隠蔽手段」も、それと同時に効力を失ったと考えてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120355
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120355,
					"content": "あっ、じゃああの魔物たちは…その実験場から逃げ出してきたってのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120356
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120356,
					"content": "恐らくそれだけじゃない——何者かが、過去の実験を再開したんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120357
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120357,
					"content": "（実験…ウルサの血肉…天の使いの力…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120358
					]
				},
				{
					"id": 100120358,
					"content": "（まさか…昨日ローエンから感じた力は…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120359
					]
				},
				{
					"id": 100120359,
					"content": "昨日の騒ぎの時…お前も感じたんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120360
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120360,
					"content": "うん、あの時…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120361
					]
				},
				{
					"id": 100120361,
					"content": "つまり、ローエンは人智を超えた力を手に入れるため、禁忌の実験に手を染めた可能性が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120362
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120362,
					"content": "あいつ…そこまで悪いやつじゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120363
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120363,
					"content": "力、富、権力…「善人」を「悪人」に変えるきっかけは、いくらでもある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120364
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120364,
					"content": "ウルサもイロックも…あの選択をするまでは、君が想像するような「悪」ではなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120365
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 100120365,
					"content": "ローエンの動機なんてどうだっていいんだ。俺には、あいつが引き返せなくなる前に連れ戻す義務がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120366
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120366,
					"content": "じゃあ…どうするんだ？このまま、こっそり調査を続けるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120367
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120367,
					"content": "そんな面倒なことをする必要はないさ。俺が今日ドーンマンポートに来た理由…それは——直接、あいつを問いただすためだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120368
					],
					"speakerTitle": "ファルカ"
				},
				{
					"id": 100120368,
					"content": "…ちょこまかとよく逃げるじゃねぇか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120369
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120369,
					"content": "さてと…もう逃げ場はねぇぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120370
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120370,
					"content": "おい——ローエン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120371
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120371,
					"content": "実験体を片付けてる場合じゃない！騎士団が動き出したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120372
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120372,
					"content": "…フンッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120373
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120373,
					"content": "今日、ドーンマンポートに知らない騎士が大勢来てたんだ…昨日のテストが知られたのか？それとも、実験体が捕まったのか？まさか、もう気づかれたんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120374
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120374,
					"content": "元々、時間の問題だっただろ。むしろ、ここまで引っ張れたこと自体が幸運だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120375
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120375,
					"content": "フッ…味方だと頼もしいが、敵に回すと本当に厄介だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120376
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120376,
					"content": "どうするんだよ！早く逃げたほうがいいんじゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120377
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120377,
					"content": "…今ここで逃げたら、もう二度と目的は達成できなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120378
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120378,
					"content": "お前がそれを知らせに来れたってことは、騎士団もまだ半信半疑だってことだ。この機に乗じて、一か八か賭けてみるとしようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120379
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120379,
					"content": "今すぐ、もう一度俺を実験台に使え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120380
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120380,
					"content": "今？でも、前の問題がまだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120381
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120381,
					"content": "何を迷ってんだ？端っから言ってるだろ…俺はお前とは違う。この実験は全部、俺自身のためにやってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120382
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120382,
					"content": "並外れた力を手に入れるためには、並外れたリスクを負わなきゃなんねぇ…覚悟はとっくに出来てんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120383
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120383,
					"content": "でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120384
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120384,
					"content": "何が「でも」だ？さっさとしやがれ。まさか、何のための実験だったか忘れたなんて言わねぇよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120385
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120385,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120386
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120386,
					"content": "——ゴホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120387
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120387,
					"content": "ダメだ！やっぱりダメだよ！…量が少なかったのか？それとも、濃度が足りてないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120388
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120388,
					"content": "まさか…完璧な結果なんて、そもそも存在しないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120389
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120389,
					"content": "ローエン！ひとまず隠れよう！また魔物を集めて実験すれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120390
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120390,
					"content": "…ダメだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120391
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120391,
					"content": "隠れるだと？騎士団がそんな時間をくれるってのか！？俺たちはもともと…この僅かな時間に賭けてたんだろうが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120392
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120392,
					"content": "今逃げれば、あいつらの疑いが確信に変わる。そうなりゃ、今後どこに行こうと騎士団の目を気にしなきゃならねぇ…そんなんで、どうやって目的を達成するってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120393
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120393,
					"content": "それじゃ…この状況でどうするっていうんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120394
					],
					"speakerTitle": "テオドール"
				},
				{
					"id": 100120394,
					"content": "…今夜、ターゲットを盗み出すぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120395
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120395,
					"content": "…俺たちと一緒に、「地獄」へ落ちてもらおうじゃねぇか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120338,
					"content": "初代大団長とも戦ったらしいね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120339
					]
				},
				{
					"id": 100120318,
					"content": "そこまで気にするようなことなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120319
					]
				}
			]
		},
