			},
			"dialogs": [
				{
					"id": 100120201,
					"content": "おーい！アドルノじいちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120202,
					"content": "おお、パイモンに栄誉騎士か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120203
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120203,
					"content": "もう大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120204
					]
				},
				{
					"id": 100120204,
					"content": "はっはっは、もう大丈夫だ。そもそも大した不調じゃなかったし、テオドールにも診てもらって、すっかり治ったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120205
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120205,
					"content": "こんな老いぼれが今でも動き回れるのは、あいつが普段から面倒を見てくれてるおかげなんだ。でなきゃ、とっくに土の中だったろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120206
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120206,
					"content": "テオドール…って、あの第8小隊の見習い医師のことか？あいつ、見かけによらずそんなにすごいやつだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120207,
					"content": "あいつもかつては最前線で戦う騎士を志していたんだが…もしかしたら、医師のほうが向いているのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120208
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120208,
					"content": "ま、それはともかくだ…ローエンを探しに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120209
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120209,
					"content": "そうなんだ。あいつ、昨日のテストの後からどこに行ったのかわからなくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120210,
					"content": "こっちには来なかった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120211
					]
				},
				{
					"id": 100120211,
					"content": "ああ、今朝書き置きを残していったぞ…昨日のことを謝りたい、だとよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120212
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120212,
					"content": "あれは全部芝居で、退屈な日常に耐えられなかったとも書いてあったな。そして、詫びとして——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120213
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120213,
					"content": "「…邪魔な魔物はすべて、俺が殺し尽くしてやる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120214
					],
					"speakerTitle": "ローエン"
				},
				{
					"id": 100120214,
					"content": "なんだよ、その謝り方…まったく、あいつらしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120215,
						100120216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 100120215,
					"content": "ローエンは一人で魔物を探しに行ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120217
					]
				},
				{
					"id": 100120217,
					"content": "ああ…そのへんの魔物ならあいつの敵ではないだろうが、また昨日のようなことが起きないか…少し心配なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120218
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120218,
					"content": "お前たちが見守ってくれるというなら、それに越したことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100120219
					],
					"speakerTitle": "アドルノ"
				},
				{
					"id": 100120219,
					"content": "うん、気にかけておくよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100120216,
					"content": "様子を見に行ったほうがいいかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100120217
					]
				}
			]
		},
		{
