					"content": "え？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130703,
					"content": "オイラ分かったぞ、これは倒すべき悪いやつだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130704,
					"content": "うんうん、なるほど。つまり、玄冬さんは諜報員で、この方法で合図を出して稲妻の悪いやつらを追い払ってるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130705,
					"content": "うるさいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130706
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130706,
					"content": "うわっ！ご、ごめん！オイラたちに「終末」を下さないでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130707,
					"content": "さっさと行ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130708
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130708,
					"content": "今行くから！絵に描いてある場所に行ってみよう、目標が見つかるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
