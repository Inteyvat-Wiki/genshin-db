			"dialogs": [
				{
					"id": 721130701,
					"content": "玄冬さんの態度は相変わらずだな…とりあえず、おみくじの内容を見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130702
					],
					"speakerTitle": "パイモン"
				},
				{
