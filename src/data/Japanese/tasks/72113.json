					"nextDialogs": [
						721130803
					]
				},
				{
					"id": 721130803,
					"content": "そうだな、もし彼女が帰ってこなかったら、今日の運勢を知ることができないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130804,
					"content": "あれ？ここにおみくじがあるぞ。どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130805,
					"content": "それはよくない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130806
					]
				},
				{
					"id": 721130806,
					"content": "大丈夫だって！それに手がかりかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130807
					],
					"speakerTitle": "パイモン"
				},
				{
