			"dialogs": [
				{
					"id": 721130201,
					"content": "おっ、見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130202,
					"content": "わわっ！「大吉」って書いてあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130203,
					"content": "今日はオイラにとって幸運な日みたいだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130204,
					"content": "パイモンにとって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "そう！おまえの幸せはオイラの幸せ！だから逆も同じ、オイラが幸せなら、おまえも幸せってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130206,
					"content": "オイラは美味しいものを食べると幸せになる。だから、おまえの幸せのために、美味しいものをごちそうしてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
