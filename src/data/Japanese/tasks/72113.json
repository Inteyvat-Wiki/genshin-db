			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721130101,
					"content": "おみくじを引きたいんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130102
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130102,
					"content": "うわっ、態度が冷たいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130103,
					"content": "おみくじを引きたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130104
					]
				},
				{
					"id": 721130104,
					"content": "分かりました。流れはこうです。まずは力を入れて、この何とかっていう箱を振ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130105
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130105,
					"content": "たしか「みくじ箱」っていうらしいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130106
					]
				},
				{
					"id": 721130106,
					"content": "そうです。その中から一本のみくじ竹が落ちてきます。そのみくじ竹を私に渡せば、あなたに相応の紙切れを差し上げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130107
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130107,
					"content": "たしか「おみくじ」っていうらしいよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130108
					]
				},
				{
					"id": 721130108,
					"content": "そんなことはどうでもいいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130109
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130109,
					"content": "オイラ質問があるぞ！もし、オイラたちが凶のおみくじを引いちゃったら、どうすればいいんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130110,
					"content": "それが運命というものです。他にどうしろというのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130111
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130111,
					"content": "えっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130112,
					"content": "外に柵みたいなものがあるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130113
					]
				},
				{
					"id": 721130113,
					"content": "チッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130114
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130114,
					"content": "いま露骨に「チッ」って言ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130115,
					"content": "えっと…たしか、「凶のおみくじを『みくじ掛け』に結ぶと、縁起直しができる」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130116
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130116,
					"content": "あっ、そうですね！凶のおみくじを引いてしまったら、あの掛けに結べばいいじゃないですか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130117
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130117,
					"content": "まったく彼らは本当…あっいえ、私たち「鳴神大社」はとても優しいので、凶のおみくじを引いても、あなたたちに運勢を変える機会を与えるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130118
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130118,
					"content": "なんか変なんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130119,
					"content": "#{NICKNAME}、おみくじを引こう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
