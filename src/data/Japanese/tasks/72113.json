			},
			"dialogs": [
				{
					"id": 721131001,
					"content": "あなたたちは何者で、何がしたいのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131002,
					"content": "それを聞きたいのはこっちだぞ！玄冬さん…なんでオイラたちを襲ったんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721131003,
					"content": "無礼です。私の質問に答えてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131004,
					"content": "#{M#俺}{F#私}は{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "あなたの名前は知っています。正直に言ってください。暗号は誰に聞いたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131006,
					"content": "パ、パイモンから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "なにしてるんだよ！早く本当のことを話さないと、玄冬さんに睨まれてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721131010,
					"content": "…なるほど、手記は偶然手に入れたものだったのですか。こうなると、百華はもうすでに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131011,
					"content": "「百華」って誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "手記の主であり、私の同僚でもあります。しかし、彼女はもう稲妻への責務を果たせないみたいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131013,
					"content": "あなたたちが疑問を抱えていることぐらい承知です。教えてあげても構いません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131014,
					"content": "私と百華は「終末番」の忍者です。私たち「終末番」は稲妻にある害を片付ける者、そしてその「紙切れ」は任務のやり取りをするための方法の一つ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131015,
					"content": "その結果、私たちは数々の恨みや危険を背負うことになりました。例えば、稲妻に潜伏している不穏で害をもたらす…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131016,
					"content": "モンド人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "どこにモンド人がいるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721131020,
					"content": "暗号を知っていれば、仲間を見分けることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131021,
					"content": "しかし、一人ひとりの暗号は独特なもの。どうやら百華が故意に自分の暗号を書き留めたのは、考えあってのことでしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131022,
					"content": "…この暗号を利用する敵をおびき出すために…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131023,
					"content": "それって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "合流したのが百華じゃないのを見て、玄冬さんはすぐに異変に気づいたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721131025,
					"content": "もちろんです。そのため、真相を確かめたかったのです。しかし本当に妙ですね…どう考えても筋が通りません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131026,
					"content": "仮にあなたがスネージナヤの偵察員であった場合、どうしてこのことをファデュイに報告せず、大人しく任務を遂行したのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131027,
					"content": "…そうなると、あなたの言った廃棄された拠点の話は信じるに値します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131028,
					"content": "あなたの行動からして、ただの好奇心から合言葉を言っただけなのでしょう。それにあなたたちは稲妻にとって敵ではなく、味方ですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131029,
					"content": "無実の罪は晴らせたけど、こんなに長いこと働かされたのを考えると、ぜんぜん喜べないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721131030,
					"content": "…でもあの人、本当に玄冬さんなのかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "やはりお気付きでしたか。あなたたちに任務を手配していた玄冬は、偽物です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131032,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721131033,
					"content": "あなたを追跡していた途中、何人かのファデュイの偵察員に襲われました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131034,
					"content": "私は一応忍法が少しできるので、死んだふりをして誤魔化しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131035,
					"content": "仲間に変装させ、私の代わりとしてあそこに立たせていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131036,
					"content": "だから変な感じだったのか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "え？つまり、あの優しい方の玄冬さんは偽物だったってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721131039,
					"content": "「優しい」？あちらのほうがお好きだったのでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131040,
					"content": "とにかく、おそらく彼らはあなたを終末番の一員だと信じ、あのような方法で私たちの組織に潜入しようと思ったのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131041,
					"content": "私にとって、これはなかなかいいチャンスです。あの偽物がいないうちに、私は「自分なりの方法」であなたをここに連れてくることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131042,
					"content": "いいですか。あなたに選択肢を差し上げます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131043,
					"content": "外部のメンバーとして、私たちのために働くこと。彼らは私がまだ生きていることを知りません。私たちは優勢を保つことができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131044,
					"content": "#もし{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が断ったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "ほう、試してみますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131046,
					"content": "#いずれにせよ、{NICKNAME}、ファデュイはオイラたちの敵でもあるから。玄冬さんと手を組もう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721131049,
					"content": "賢明な判断です。この「安全屋」の物資も、自由に使ってくれて結構ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131050,
					"content": "では、新たな動きがあれば、あなたに連絡します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131051,
					"content": "今後もよろしくお願いします。さようなら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131047,
					"content": "一理ある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "道理で「おみくじ」を知ってたんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "ファデュイ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "そうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131008,
					"content": "事の経緯は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "オイラたちはある山で、廃れた拠点を見つけたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}