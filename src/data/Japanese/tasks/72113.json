					"content": "え？これって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130808,
					"content": "この場所に行って、次の指示を受けろって意味か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130809
					],
					"speakerTitle": "パイモン"
				},
				{
