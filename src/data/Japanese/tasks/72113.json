						721130503
					]
				},
				{
					"id": 721130503,
					"content": "神社って本当に人間味のないところだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130504,
					"content": "これをどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130505
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130505,
					"content": "うむ、運勢を見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130506,
					"content": "それと、おみくじは一日に一回だけ引くことができます、どうかお忘れなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130507
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130507,
					"content": "そうでなければ私も疲れて…いえ、みくじ掛けがいっぱいに…でもなく、なんでしたっけ？たしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130508
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130508,
					"content": "「おみくじは神様の意志の具現。そのため、神様の意志を尊重し、できる限りのことをすべきである。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130509
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130509,
					"content": "ほら、うまいことが書かれていますよね。だから一日に一回だけなんです、覚えておいてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玄冬林檎"
				}
			]
		},
