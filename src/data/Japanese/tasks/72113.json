					"content": "おっ、見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130402,
					"content": "えっ、「凶」だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130403,
					"content": "この場合、どうしたらいいか覚えてるぜ！確か…「凶のおみくじを『みくじ掛け』に結ぶ」んだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130404,
					"content": "「そして、オイラに美味しいものをごちそうしてくれると、縁起直しすることができる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130405,
					"content": "そうだっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "もちろん！昔の人の教えを疑う気か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130407,
					"content": "昔の人の教えはすごいよな！とりあえず、みくじ掛けを探そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
