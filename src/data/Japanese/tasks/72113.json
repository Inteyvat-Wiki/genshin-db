			"dialogs": [
				{
					"id": 721130601,
					"content": "うん？それって？手記みたいだな…オイラにも見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130602,
					"content": "「…終末…ファデュイ…闇討ち…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130603,
					"content": "なんだこれ。ごちゃごちゃだし、汚れてて全然読めないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130604,
					"content": "お宝の手がかりかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130605
					]
				},
				{
					"id": 721130605,
					"content": "そうだな！もう一回読んでみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130606,
					"content": "「…おみくじの内容を読み解く時の暗号…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130607,
						721130608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130607,
					"content": "おみくじの内容を読み解く？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				},
				{
					"id": 721130609,
					"content": "えっと…「…前半は『朧夜の真中』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130610,
					"content": "ここで途切れてるな。続きはなにが書いてあったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130611,
					"content": "でも合言葉を使うってことは、きっとなにかしらの秘密があるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130612,
					"content": "うーん、気になるな…今度、鳴神大社でおみくじの内容を読み解く時、合言葉を言ってみるとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721130608,
					"content": "暗号？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				}
			]
		},
