			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カズミッチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450601,
					"content": "よし、ようやく商品が全部売れました。やっぱり薄利多売が正解でしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450602
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450602,
					"content": "本当ならもうスネージナヤに戻っていたかったんですが、今の稼ぎはやっと交通費を賄えるくらいで…手ぶらで来て、手ぶらで帰りたくないんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450603
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450603,
					"content": "はぁ、とにかくありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				}
			]
		},
		{
			"id": 7614507,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614507",
							"2"
						],
						"stepId": 7614507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カズミッチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "おや、縁とは不思議なものですね。こんなところでまたお会いできるなんて。どうですか？見ていきます？今回はいいものがたくさんございますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450709,
					"content": "どんないいものがあるか見てみようかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "へへっ、全部ファデュイが使わなくなった古い装備品です。他では手に入りませんよ！欲しいものがあったらまとめて買っていってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450702,
					"content": "スネージナヤに帰ったんじゃなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "実を申しますと、私の故郷はノヴォキッチェヴで、家族全員、鉱山労働者なんです。あの人たちときたら小さき者よりも頑固で、私が商売の旅に出ると言った時は、大反対されたんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450704,
					"content": "でも、大金を稼いで帰ると大口叩いて出てきたのに…まさか、こんな風に旅費すら危ういところまで追い詰められるとは思いもしませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450705,
					"content": "大金とは言いませんが、せめて小遣い程度は稼ぎたいですね。帰ったときの言い訳くらいにはなるでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450706,
					"content": "なんでファデュイなんかの縄張りにいるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "おっと、私は善良なスネージナヤの市民ですよ。ファデュイを見ても、まるで実家に帰ったような気分になるだけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450708,
					"content": "今扱っているのはファデュイが使わなくなった古い装備品ばかりでしてね。彼らから特別に処分を任されたんですよ。他では手に入らない、ここだけの品物でございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450711,
					"content": "大丈夫、もう行くね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
					"content": "ざ、残念です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				}
			]
		},
		{
			"id": 7614509,
			"completionStepIds": [
				7614509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614509",
							"2"
						],
						"stepId": 7614509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カズミッチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450901,
					"content": "本当にありがとうございます。おかげさまで、惨めな思いをしながら帰らなくて済みました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450902
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450902,
					"content": "今度こそ本当にお別れですね。こんなにたくさん物を買ってくれたんですから、もう私たちは友達です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450903
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450903,
					"content": "スネージナヤに来る機会があれば、ノヴォキッチェヴにも来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				}
			]
		}
	]
