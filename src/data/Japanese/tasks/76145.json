			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カズミッチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450101,
					"content": "まずいな…もう少し金を集めて、ナシャタウンで屋台を借りるしかないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450113,
						761450102,
						761450115
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450113,
					"content": "何か良い商品があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450114
					]
				},
				{
					"id": 761450114,
					"content": "ナタで仕入れた小物ばかりですが、お気に入りのものがございましたら、ぜひお手に取ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450102,
					"content": "#{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450103
					]
				},
				{
					"id": 761450103,
					"content": "おや、いらっしゃいませ！こんにちは、カズミッチと申します。スネージナヤから来た旅商人でございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450104
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450104,
					"content": "とはいえ、実際は旅の途中で小さな商売をして旅費を稼いでいるだけなんですがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450105
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450105,
					"content": "ナタを通りかかった時に、あまりにも住民たちが情熱的で、つい調子に乗って…今ある商品を全部売らないと、帰りの切符代も払えなくなってしまいそうなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450106,
						761450110
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450106,
					"content": "スネージナヤに帰るの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450107
					]
				},
				{
					"id": 761450107,
					"content": "はい、商品を売り切ったら、切符を買って列車で帰るつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450108
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450108,
					"content": "あそこは一年中雪が降り続くので、辺り一面が氷と雪に埋もれて、毎日街の中に閉じこもるしかないんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450109
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450109,
					"content": "でも外に長くいると、家でまる一日ゆっくり眠れる日が恋しくなってきますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450110,
					"content": "ここじゃ売れなそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450111
					]
				},
				{
					"id": 761450111,
					"content": "でも街で屋台を借りるには北国銀行からお金を借りるしか…でも、ナシャタウンの支店は評判があまりよくないって聞いたんですよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450112
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450112,
					"content": "まぁ、一応ここは人通りが多いですから。商品は、人が来さえすれば売れるもんです。そうは思いませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450115,
					"content": "ごめん、もう行くよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450116
					]
				},
				{
					"id": 761450116,
					"content": "も、もう行っちゃうんですか？見てみませんか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				}
			]
		},
		{
			"id": 7614503,
			"completionStepIds": [
				7614503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614503",
							"2"
						],
						"stepId": 7614503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カズミッチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450301,
					"content": "わあ、本当に売り切れてしまうなんて！私にも商売のセンスがあったってことですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450302
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450302,
					"content": "これからライトキーパーに厄影の沼地を通すための護衛を依頼します。そこから北へ進めば、あとは普通の道のはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450303
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450303,
					"content": "帰り道で商売のチャンスにも巡り合えるかもしれませんね…では、さようなら。またご縁がありましたら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				}
			]
		},
		{
			"id": 7614504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614504",
							"2"
						],
						"stepId": 7614504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カズミッチ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "なんという偶然でしょう、またお会いしましたね！何かお買い求めになりますか？新商品が売れ残っていますので、ご協力いただけると助かります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450407,
					"content": "どれどれ、いい商品があるかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "地元の特産品ばかりですよ。ご安心ください、最安値でご提供しております！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450402,
					"content": "また仕入れたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "うーん、なんて言えばいいんでしょうか。商売のチャンスは逃せませんからね…ピラミダの町で良い話があって、急いで売りたい商品があるって言われたので、お得に譲ってもらったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450404,
					"content": "興奮のあまり、帰るところだったことを忘れて、全部買い取ってしまいました。その結果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450405,
					"content": "何でそんなに急いで手放したんだと思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "うぅ、言わないでくださいよ。よろしければ何か使えそうな物がないか、見ていきませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				},
				{
					"id": 761450409,
					"content": "ごめん、もう行くね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "もう少し見てみませんか？きっとお客様のお探しの物がございますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズミッチ"
				}
			]
		},
		{
			"id": 7614506,
			"completionStepIds": [
				7614506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
