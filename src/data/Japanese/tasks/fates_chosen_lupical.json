			"dialogs": [
				{
					"id": 4541101,
					"content": "血痕だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541102
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4541102,
					"content": "人じゃない、狼だ。ルピカの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541103
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4541103,
					"content": "だから、ルピカって何なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4541104,
					"content": "ルピカは——運命の家族。狼が人を受け入れ、人が狼を受け入れたら、ルピカだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541105
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4541105,
					"content": "うーん、人間の言葉じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4541106,
					"content": "でも、おかしいでしょ。まさか狼たちと話せるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4541107,
					"content": "彼が、決めた名前だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541108
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4541108,
					"content": "…彼って、誰の事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4541109,
					"content": "この土地の主だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4541110,
					"content": "モンドの主はバルバトスじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4541111,
					"content": "あとで話す。また、手がかりを見つけた。ついてこい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4541112,
					"content": "あっ、待って！説明してほしいことがまだあるんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541113
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4541113,
					"content": "レザー、もう行っちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
