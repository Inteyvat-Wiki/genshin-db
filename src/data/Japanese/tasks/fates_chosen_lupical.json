				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "戻ったぞ！これで足りるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4540302,
					"content": "十分だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4540303,
					"content": "彼と話をしたんだけど、狼たちのルールってすごく不思議だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4540304,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4540305,
					"content": "この辺をぐるっと回ったけど、他に狼はいなそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4540307,
					"content": "狼ってそういうもんだよ。さっき捕まったのがドジなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "ヨトゥン"
				},
				{
					"id": 4540308,
					"content": "な、なんだお前！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4540309,
					"content": "お前に用がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4540310,
					"content": "こいつだよ、噂で聞いた狼に育てられた人間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "ヨトゥン"
				},
				{
					"id": 4540311,
					"content": "へぇ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4540312,
					"content": "お前だったのか。最近どうも狼どもが賢くなったと思ったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4540313,
					"content": "お前が裏で糸を引いていたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4540314,
					"content": "パパとママはどうした、自分が人間だってこと忘れちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "不思議なホプキンス"
				},
				{
					"id": 4540315,
					"content": "やめて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4540316,
					"content": "レザーが口下手だからって、いじめるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4540317,
					"content": "うん？騎士団はコイツを庇うのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "ヨトゥン"
				},
				{
					"id": 4540318,
					"content": "村を襲ったのは、オレたちじゃない──",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レザー"
				}
			]
		},
