			},
			"dialogs": [
				{
					"id": 4540101,
					"content": "誰だ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4540102,
					"content": "落ち着けレザー、オイラたちだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4540103,
					"content": "お前は…お前も、騎士団の人間か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4540104,
					"content": "なんだ、知り合いじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4540105,
					"content": "「赤い、熱い女の子」——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "知らない。赤いけど、あの子ほど熱くない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4540108,
					"content": "あー、分かった、あんたたちが言ってた狼少年って彼のことだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4540109,
					"content": "そう、レザーっていうんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4540110,
					"content": "助けてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4540111,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4540112,
					"content": "説明する時間、ない。ルピカに逃げろと言った。ヤツらが来た。悪意を感じる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4540113,
					"content": "さっきのやつらのことだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4540114,
					"content": "そうだね。でも、その前に聞きたいことがあるんだけど——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4540115,
					"content": "血のにおいだ。急ごう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4540116,
					"content": "まさか、あのバカたちが狼に襲われた！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4540106,
					"content": "本当にアンバーじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
