			"dialogs": [
				{
					"id": 4541301,
					"content": "彼だ。あの人たちに、囚われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541302
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4541302,
					"content": "ひどいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4541303,
					"content": "ひどいとは思うけど、騎士団の立場上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541304
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4541304,
					"content": "村を襲ったのは、オレたちじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541305
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4541305,
					"content": "流浪の黒狼と、その群れ。領地がほしいと、彼が作った掟を破った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541306
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4541306,
					"content": "<color=#00E1FFFF>彼</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4541307,
					"content": "この土地の主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541308
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4541308,
					"content": "それはさっきも聞いたよ。ちゃんと説明して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541309
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4541309,
					"content": "ルピカは、奥深く。一緒に来い。彼が、姿を見せるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レザー"
				}
			]
		},
