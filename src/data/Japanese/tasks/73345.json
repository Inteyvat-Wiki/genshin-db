			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ピュロン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733450101,
					"content": "君たち、また来たのか？まさか、我が識主様に門前払いを食らったんじゃないだろうな？あの方は花霊に容赦ないぞ、この私と違ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450102
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450102,
					"content": "さっさとここから離れたほうがいい。私から何か聞き出そうとしても無駄だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450103
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450103,
					"content": "毎回、おまえが自分からしゃべってたんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450104,
						733450105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733450104,
					"content": "例の「識主」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450106
					]
				},
				{
					"id": 733450106,
					"content": "「霊光絶唱」のこと、そしてナセジュナに裏切られたことをピュロンに伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733450107
					]
				},
				{
					"id": 733450107,
					"content": "でたらめを言うな！識主様は、私が知る中で最も博識な学者だぞ。あんな穢れた者たちと組むわけがないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450108
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450108,
					"content": "おっと、そういうことか。思い通りに行かないからって、我々を仲違いさせようという魂胆だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450109
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450109,
					"content": "だがな、君の作り話はバレバレだぞ。私は絶対に騙されないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450110
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450110,
					"content": "うぅ…そうだ、ナセジュナから預かったノートがあったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733450111,
					"content": "ノートにはナセジュナが書いたメモもあるだろ？それをこいつに見せたら、オイラたちを信じてくれるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733450112,
					"content": "ノート、とは？まだなにか小細工を企んでいるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450113
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450113,
					"content": "「ルネの調査ノート」をピュロンに渡した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733450114
					]
				},
				{
					"id": 733450114,
					"content": "これは、確かに識主様の字だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450115
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450115,
					"content": "なんということだ…スケプティック団にも遂に該博な識主が現れたと思ったのに、まさか団の使命を裏切って、黒淵の穢れた者たちと通じていたなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450116
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450116,
					"content": "はぁ…君たちは知らないかもしれないが、我々は黒淵を追い求める奴らと、もう何百年にも渡って戦ってきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450117
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450117,
					"content": "連中はまるで影のように、我々の背後でスケプティック団の伝統を穢そうと企んでいる。団が今の状態になったのも、奴らと関係があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450118
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450118,
					"content": "しかし、我々の長まで奴らと…まさに一族の不幸そのものだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450119
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450119,
					"content": "ナセジュナめ、今頃は穢れた者たちの仲間になり果て、奴らの陰に身を潜めているんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450120
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450120,
					"content": "彼は以前、アーリヤデーバ先輩を追って教令院で学んでいたことがあるんだが、それを機に古代文献に没頭するようになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450121
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450121,
					"content": "スケプティック団の団員は多くが誠実ではあるものの、どちらかといえば行動派だった。彼のような学者はなかなかいなかったんだ。だからこそ、彼なら団を復興へと導いてくれるんじゃないかと期待したんだが…それがこの始末とは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450122,
						733450123
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450122,
					"content": "#{M#俺}{F#私}たちも予想だにしなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450124
					]
				},
				{
					"id": 733450124,
					"content": "だが、こんな事になった以上、後は私がなんとかする。任せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450125
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450125,
					"content": "何より先に、新しい識主を選出しなければならない。長のいないタイミングを狙われてしまうとまずいからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450126
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450126,
					"content": "えっと、狙う価値があるのかは、何とも言えないけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733450127,
					"content": "君たち、誠に申し訳なかった…お詫びをさせてもらおう。これはナセジュナから保管を依頼された文献なんだが、スケプティック団の伝承について記されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450128
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450128,
					"content": "私には読み解けないが、君たちには興味あるものかもしれない。だからこれは、君たちに渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450129
					],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450129,
					"content": "また私に協力してほしいことがあったら、いつでも来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ピュロン"
				},
				{
					"id": 733450123,
					"content": "#{M#君}{F#あなた}のせいじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450124
					]
				},
				{
					"id": 733450105,
					"content": "言ってることとやってることが違うけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450106
					]
				}
			]
		}
	]
}