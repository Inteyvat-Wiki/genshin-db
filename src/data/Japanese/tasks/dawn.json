	"talks": [
		{
			"id": 301301,
			"completionStepIds": [
				301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301301",
							"2"
						],
						"stepId": 301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30130101,
					"content": "まずはドニアザードのことから話そうぜ。本当に無事でよかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130102,
					"content": "ええ。「花神誕祭の最後の日」、私はあなたたちと別れたあと、シティの外に行って、旅人が話していた光景を見てきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130103,
					"content": "無数にある夢境の中、だんだんと薄れていく夢を見つけたわ…それは、私の推測を裏付けるものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130104,
					"content": "ドニアザードがアーカーシャによる夢の搾取に完全に耐えられなくなった後、その意識は散逸してしまった。だけどそのおかげで、逆にアーカーシャの掌握から逃れることができたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130105,
					"content": "でも、わずかに残った意識も長くは続かず、本来自分があるべき夢へと戻る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130106,
					"content": "そしてそれは、夢境と共に薄れていくの、消失してしまうまでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130107,
					"content": "私は全力でドニアザードの夢境を維持したわ。けど、長くはもちそうになかった。その時、あなたたちが「輪廻」を破ってくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130108,
					"content": "つまり、オイラたちが一緒にドニアザードを救ったってことか。最後の最後で間に合ったんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130109,
						30130110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130109,
					"content": "本当によかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130111
					]
				},
				{
					"id": 30130111,
					"content": "あら？どうして二人とも嬉しそうに笑っているの？こういう時は感動で涙を流すものだと思っていたけど…うん…もっと観察を続けないといけないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130112
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130112,
					"content": "どっちでもいいんだよ！そういうのは人によるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130113,
					"content": "さて、それ以外にも、まだ多くの疑問があるんじゃないかしら？あなたたちは私の敬虔なる信徒を救ってくれた、そのお返しに、私もすべての答えをあなたに与えるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130132,
						30130151,
						30130159,
						30130169
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130114,
					"content": "アビディアの森で気を失った時に見たのは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130115
					]
				},
				{
					"id": 30130115,
					"content": "旅人はアビディアの森にいた時、お香の影響で気を失ったんだ。その時、巨大な樹と赤い空を見たって言ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130116,
					"content": "それに加えて、一人の声が聞こえた、そうでしょ？キーワードは「世界」と「忘却」かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130117
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130117,
					"content": "そうそう！やっぱり知ってたんだな。ずっとそれがなんなのか聞きたかったんだ。赤い空って、カーンルイアと関係してるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130118,
					"content": "どうやら、旅人は世界樹と繋がったようね。それは世界樹の中にある、マハールッカデヴァータの意識の残骸が残したメッセージ…もしくは、彼女が死ぬ間際の、最後の記憶かもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130119
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130119,
					"content": "知っていると思うけど、マハールッカデヴァータはカーンルイアの災厄の後に失踪したの。だからタイミング的には合っているし、あなたたちの疑いは理にかなっているものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130120
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130120,
					"content": "マハールッカデヴァータが残したメッセージ？オイラたち、てっきりあのキングデシェレトのほうかと思ってたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130121,
					"content": "キングデシェレト…あのさらに前に亡くなった魔神？今もまだキングデシェレトを信仰している砂漠の民がいるから、きっとそういう噂を耳にしたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130122
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130122,
					"content": "そうなのか。じゃあ…あのメッセージの内容は、どんな意味だったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130123,
					"content": "…私にはまだ解読できないわ。たとえ今のアーカーシャが持つ能力を使ってもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130124
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130124,
					"content": "マハールッカデヴァータが世界樹に残した意識は、まるで「汚染」されているかのように、非常に危険な気配を含んでいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130125
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130125,
					"content": "たとえ修行を積んでいる数多の学者たちでさえ、それに意識を繋げると、完全に狂ってしまうの…私が何度も教令院に警告しているにもかかわらず、未だに被害者が後を絶たないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130126
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130126,
					"content": "でも、世界樹を救う鍵がその中にあると私は信じている。だからこそ、その解読を諦めてはいないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130127
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130127,
					"content": "幻覚で見たあの樹が世界樹だったのか…ティナリも言ってたよな、世界樹が「病気」になったって。もしかして、「汚染」された意識のせいなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130128,
					"content": "でも、おまえですらあの幻覚の意味がわからないなんて…オイラたち、無駄足だったってことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130129,
					"content": "旅人は、あの「意識」に触れてもまったく影響を受けなかった。そんな人は初めてよ。あなたがいてくれたら、もしかしたら解読することができるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130130
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130130,
					"content": "いえ、私たちは必ず、その中にある秘密を解き明かさなくてはならないわ。実はすでに、世界樹に影響を及ぼしているかもしれない要素をすべて排除してあるの。だから残るはこの一つだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130131
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130131,
					"content": "これは世界樹の…テイワットの存亡を賭けて挑戦する「クイズ」よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130132,
						30130151,
						30130159,
						30130169
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130132,
					"content": "どうしてキャサリンの姿なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130133
					]
				},
				{
					"id": 30130133,
					"content": "厳密に言うと、私はアーカーシャを媒介にして、キャサリンの意識を「占有」しているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130134
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130134,
					"content": "そ、そんなのどうやってやるんだよ！キャサリン、なんかかわいそうだな…他の人の意識も占有できるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130135,
					"content": "アーカーシャ端末をつけている者なら、理論上は彼らの脳裏に「入る」ことができるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130136
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130136,
					"content": "アーカーシャはマハールッカデヴァータの遺産。そして私はクラクサナリデビであり、「最初のアーカーシャ端末」でもある。私の意識は、常にアーカーシャに繋がっているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130137
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130137,
					"content": "でも、私は常にスメールの民の自己意志を尊重している。彼らの意識を占有したことは一度もない。必要な時は、このスネージナヤのバイオニック人形を借りているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130138
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130138,
					"content": "えっ…ちょ、ちょっと待て、なんか今サラッと凄いことが判明しなかったか。キャサリンってそうだったのか…どうりで変なところが多かったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130139,
					"content": "でもおまえ自身の体はどうしたんだよ？なんでずっとこんな方法を使ってるんだ？たしかおまえって、「スラサタンナ聖処」に住んでるんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130140,
					"content": "…それは、かなり昔のことから話さないといけないわね。マハールッカデヴァータが消えた後、賢者たちは生まれたばかりの私を見つけ、スメールに連れ帰ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130141
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130141,
					"content": "当時の私は幼く無力だった。賢者たちは「守る」という名目で、私をスラサタンナ聖処に閉じ込め、ほとんど関わろうとしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130142
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130142,
					"content": "でも私には分かっていたわ。本当に見つけたかったのは、マハールッカデヴァータの逝去を裏付ける私ではなく、マハールッカデヴァータそのものであったことを、どれほど賢者たちがそれを望んでいたかをね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130143
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130143,
					"content": "つまり…賢者たちは自分たちの新しい神を「軟禁」してるってことか？そんなことするなんて…どうして懲らしめてやらないんだよ、ナヒーダ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130144,
					"content": "ある意味では、彼らは間違っていないの。マハールッカデヴァータは全知全能。命が尽き果てても尚、アーカーシャはこの国に力を授け続けている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130145
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130145,
					"content": "それに比べて私は…「知恵の神」の名を担ぐには到底程遠い。国を統治するにも教令院のほうが長けているし、私の存在にそれほど大きな意味はないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130146
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130146,
					"content": "#{M#俺}{F#私}からすれば、ナヒーダは優秀な神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130147
					]
				},
				{
					"id": 30130147,
					"content": "そうそう。ナヒーダにはもう信徒がたくさんいるし、花神誕祭の日に参加した人たちも、みんな心からおまえのことが好きなんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130148,
					"content": "ふふっ、そう言ってくれるなんて、ありがとう。でも実際、意識をアーカーシャに繋げられる私には、身体的な自由は必要ないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130149
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130149,
					"content": "私にとって、世界樹を救うことこそが使命であり、最優先事項。その方法を探しながら、一人前の神になれるよう尽力するわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130150
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130150,
					"content": "…時々、「知恵の神」の責任を担って、道に迷った民を導く…それだけで、十分なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130151,
						30130159,
						30130169
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130151,
					"content": "教令院の賢者たちの計画について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130152
					]
				},
				{
					"id": 30130152,
					"content": "教令院によるスメールの統治に、大きな問題は一度もなかった。彼らが正しい方向から逸脱したのを見たのは、これが初めてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130153
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130153,
					"content": "いったい何が起きたのか、何の目的があって彼らをそうさせたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130154
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130154,
					"content": "ここにいる人々はほとんど異変に気づいていないけど、旅人が「花神誕祭の輪廻」を破ってくれていなかったら、本当に深刻な事態になっていたかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130155
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130155,
					"content": "私もアーカーシャを通して調査したけど、疑わしい資料は何もなかったわ。主要な人物も、アーカーシャ端末をつけていないようね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130156
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130156,
					"content": "おそらく、彼らは意図的に何かを隠そうとしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130157
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130157,
					"content": "そういえば、ガンダルヴァー村にいた時、一人の賢者がティナリをある「プロジェクト」に誘ってたけど…まさかそのことだったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130158
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130158,
					"content": "とにかく、賢者たちの意図を調べ、それを正して罰することを優先しなくてはならないわ…それと同時に、藪をつついて蛇を出さないよう気をつけないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130132,
						30130159,
						30130169
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130159,
					"content": "人々はアーカーシャの問題に気付いてないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130160
					]
				},
				{
					"id": 30130160,
					"content": "アーカーシャのせいで夢を見ないことかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130161
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130161,
					"content": "そうだぞ、こんな長い間、誰もおかしいって思わなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130162
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130162,
					"content": "気づかないのではなく、気にしないの。根本的な原因は、賢者たちによる「ミスディレクション」よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130163
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130163,
					"content": "「ミスディレクション」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130164
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130164,
					"content": "賢者たちは人々に、夢を見ないことが理性と英知の表れであり、スメール人の栄誉だと思わせているわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130165
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130165,
					"content": "…けれど実際は、ただアーカーシャによって夢が「収穫」されているだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130166
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130166,
					"content": "賢者たちはそのおかげでアーカーシャを最大限に利用することができ、過去の研究をよりスムーズに進められるようにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130175
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130175,
					"content": "それに、当時マハールッカデヴァータがアーカーシャを創造したのも、それを有効に使ってほしいと思ったからに違いないわ。だから私はこの件に対して、これといって大きな異論はなかったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130167
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130167,
					"content": "こうして、賢者たちの主張する考え方は、疑いの声をかき消した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130168
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130168,
					"content": "ひいてはアーカーシャ端末を一度も使ったことがなく、夢を見られるスメール人さえも、それを口にしてはならない恥だと思うようになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130114,
						30130132,
						30130151,
						30130169
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130169,
					"content": "もう質問はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130170
					]
				},
				{
					"id": 30130170,
					"content": "そう。私の回答が、「求知者」であるあなたたちに満足してもらえることを願っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130171
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130171,
					"content": "実はドニアザードの消えかかった夢境を維持していた時、私の精神力にも大きな負担がかかってしまったの…だから、少し休まないといけないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130172
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130172,
					"content": "その間、賢者たちの行動はそれほど心配しなくてもいいわ。「花神誕祭の輪廻」のような大掛かりなこと、アーカーシャが短期間で二度も行うことはできないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130173
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130173,
					"content": "おう、寝てていいぞ。オイラたちが見守ってるから安心しろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130174
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130174,
					"content": "ふふっ、頼もしいわね。ふぁあ——こんなに疲れた誕生日は、生まれて初めてだったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130301
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130301,
					"content": "ん…旅人さん？パイモン？私はどうしてここに…何か知っていますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130302
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130302,
					"content": "えっと…夢遊ってやつじゃないか？ほら、夢遊してる人を呼び覚ましちゃだめだって言うからな。オイラたちは…ここを通りかかっておまえが起きるのを待ってたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130303,
					"content": "そうだったんですね。うぅ…そろそろメンテナンスの方を探さなければ。あっ、大丈夫です。私はすぐに戻りますので。ありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 30130110,
					"content": "まさに奇跡だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30130111
					]
				}
			]
		},
