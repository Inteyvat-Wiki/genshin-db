					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130202
					],
					"speakerTitle": "ドニアザード"
				},
				{
					"id": 30130202,
					"content": "実は一晩だけじゃないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30130203,
					"content": "ん？…おかしいわね、私そんなに眠っていたかしら？どうりで頭がこんなに痛いはずだわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
