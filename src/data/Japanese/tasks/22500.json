			"dialogs": [
				{
					"id": 225000201,
					"content": "あら、またあんたやね。今度はどうしたん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000202,
					"content": "ルルのものを取りに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "あの子のもの…思い出した、確かに香膏を作ってほしいと頼まれたわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000204,
					"content": "しかし残念やわ…あんたたちに香膏を作った日から、急に香膏を作ってほしいという依頼が増えてきたんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000205,
					"content": "あないなオーダーに店のこともあるし、一人は無理やで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000206,
					"content": "それにルルはまだ子供やし、大人用の香膏をそのまま渡すのもどうか思うんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000207,
					"content": "ずっと香膏の配合について考えとって、やっとええ案を思いついたんやけど、まだ作ってへんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000208,
					"content": "優先して作ることもできのうはあらへんけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "鶯"
				}
			]
