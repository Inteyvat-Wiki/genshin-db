					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "いらちな人やな…あんたに免じて、ルルの香膏を優先して作んで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000303,
					"content": "そやけど昼間は店のことあるさかい、夜にならな作れへんで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000304,
					"content": "夜になったらまたいらっしゃい。準備作業は済ませとくさかい。",
