			"dialogs": [
				{
					"id": 225000101,
					"content": "いつできるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000102,
					"content": "今日は遊んでないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}だ。最近は遊んでないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000104,
					"content": "モンちゃんは最近笑わなくなって、いつも一人でボーっとしてるし、飛もたまにどこに行ったか分からないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000105,
					"content": "モンちゃんにどうしたのって聞いても教えてくれないの…なんだか、最近みんな変なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000106,
					"content": "大人になるとそうなる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "大人になったら笑わなくなるの？でもモンちゃんも飛も大人になりたいって言ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000108,
					"content": "もし本当にそうなら、私は大人にならなくていいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000109,
					"content": "#それより、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}に手伝ってほしいことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000112,
					"content": "私の代わりに鶯お姉さんからあるものを取ってきてくれないかな？お姉さんに言っておいたし、大丈夫だと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000113,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "#じゃあお願いね、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000115,
					"content": "鶯から…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、誤解しないで、鶯お姉さんにあるものを作ってもらっただけだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000117,
					"content": "#とにかく、お願いね、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ルル"
				},
				{
					"id": 225000110,
					"content": "悩み事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "#私？ううん、でも…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}に手伝ってほしいことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "ルル"
				}
			]
		},
