					"nextDialogs": [
						225000403
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000403,
					"content": "こっちにまだ少し材料残ってるさかい、卯師匠の台所で作業するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000404,
					"content": "あんたにはミントを三つ取って、合成台でオイルに合成してほしいんや。作り方はわかるんやな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "鶯"
				},
				{
					"id": 225000405,
					"content": "ミントのオイルをうちに渡して、うちが香膏を完成させるんや。",
					"roleType": "TALK_ROLE_NPC",
