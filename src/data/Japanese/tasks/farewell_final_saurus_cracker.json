					"nextDialogs": [
						750870304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870304,
					"content": "クワッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870305
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870305,
					"content": "あれ、なんか見ないうちにずいぶん大きくなったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870306,
					"content": "タルカが太りやすいって言ってたのは本当だったんだな。そうだ、タルカはどこだ？一緒じゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870307,
					"content": "クウ…クワ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870308
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870308,
					"content": "うーん、とりあえずこいつを連れて、ここから離れようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870309,
					"content": "もうオベロンを見つけたんだし、隠れる必要もないよな？タルカの行方も気がかりだし…急ごうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
