			"dialogs": [
				{
					"id": 750870501,
					"content": "君たちがここまで来たってことは、私ももう善良な商人のフリをする必要はなさそうね。あんなバカたちと付き合うのはもうウンザリ…そろそろ肩の力を抜かせてもらわないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "クイリア"
				},
				{
					"id": 750870502,
					"content": "このぉ…自分の悪事を他人になすりつけるなんて！オイラたち無実なのに、誤解されたじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870503,
					"content": "私は悪人なんだから、悪いことをするのは当然でしょ？それに、君たちがあのバカ三人に誤解されたのは、私の悪だくみがうまくいった証拠よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "クイリア"
				},
				{
					"id": 750870504,
					"content": "フフッ、今からもっともっと悪いことをするから、逃げないでちょうだいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "クイリア"
				},
				{
					"id": 750870505,
					"content": "さあ、行きなさい！ケダマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "クイリア"
				},
				{
					"id": 750870506,
					"content": "ギャア——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870507
					],
					"speakerTitle": "ケダマ"
				},
				{
					"id": 750870507,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#行け！{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}！自分より遥かにデカいやつに挑むなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870510,
					"content": "クルル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870511
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870511,
					"content": "キュウ！キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "オベロン、なんか元気がなさそうだぞ。タルカと離ればなれなのが不安なのかな。まあ…ただのちび竜ビスケットの食べすぎって可能性もあるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870513,
					"content": "#もしかして{REALNAME[ID(2)|SHOWHOST(true)]}のやつ、オベロンを元気づけようと、勇気を振り絞って守ろうとしてくれてるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870514,
					"content": "この世には勇気だけではどうにもならないことがたくさんあるのよ。そんな曖昧なものより、絶対的な支配力のほうがずっと頼りになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "クイリア"
				},
				{
					"id": 750870515,
					"content": "ケダマ、やりなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "クイリア"
				},
				{
					"id": 750870516,
					"content": "#すごい！{REALNAME[ID(2)|SHOWHOST(true)]}が攻撃をかわしたぞ！まさにテペトル竜の特技を活かした避け方だな。たとえ相手が空の王者でも、これじゃどうにもできないはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870517,
					"content": "攻撃",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}が攻撃の構えを取ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870530,
					"content": "キュウッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "攻撃が当たったぞ！与えたダメージは…いまひとつっぽい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870532,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "まあ、相手にかわされなかっただけでもすごいぞ！ふぅ、まだ1ターンしか経ってないのに、疲れてきたぞ。どういうことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870534,
					"content": "さあ、次は私の番よ。攻撃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "クイリア"
				},
				{
					"id": 750870535,
					"content": "#相手の猛攻に対して、{REALNAME[ID(2)|SHOWHOST(true)]}が急いで防御の構えを取ったぞ！防御成功だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870536,
					"content": "「攻撃」した後に「防御」まで選ぶなんて、卑怯だわ。ルールは破るためにあるわけじゃないのよ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "クイリア"
				},
				{
					"id": 750870537,
					"content": "ルールを破る者が、ターン制を制す！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "次はどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870539
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870539,
					"content": "…グワッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870540
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870540,
					"content": "あれ？オベロンが元気になってきたみたいだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870541
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870541,
					"content": "キュウ！キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870542
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870542,
					"content": "なにを言ってるかわからないけど、こいつらの間でなにかが通じ合ったみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870543,
						750870545,
						750870547,
						750870550
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870543,
					"content": "連携攻撃",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870544
					]
				},
				{
					"id": 750870544,
					"content": "よし！飛行スクールの「明日の星」の実力を見せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870552,
					"content": "キュウッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#おおっ！オベロンが空中への逃げ道を封じて、{REALNAME[ID(2)|SHOWHOST(true)]}が攻撃したぞ！見事な連携攻撃だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870554,
					"content": "ケダマにかなりのダメージを与えたぞ！攻撃は足に当たったみたいだ。まるで机の角に足の小指をぶつけたかのような痛みだろうな！相手は動揺のあまり動けなくなってるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870555,
					"content": "#攻撃——{M#俺}{F#私}が！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#それも一つの選択肢だけど…せっかく{REALNAME[ID(2)|SHOWHOST(true)]}が活躍するチャンスなんだから、譲ってやろうぜ！大人だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870565,
					"content": "クワッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870566,
					"content": "キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#ん？{REALNAME[ID(2)|SHOWHOST(true)]}とオベロンのやつ、なにか策があるみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870568,
					"content": "あっ、ちび竜ビスケット！どこから出したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870569,
					"content": "クワッ！グワッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870570,
					"content": "ま、まさか羽の下に隠し持ってたのか？ずるがしこい仔竜だな…タルカの苦労もわかるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870571,
					"content": "ギャウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870572,
					"content": "今はそんなのほうっておきなさい！こら！止まって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "クイリア"
				},
				{
					"id": 750870573,
					"content": "ん？ケダマが指示を無視して、ちび竜ビスケットのほうに来たぞ！スタミナ5ポイント回復の誘惑に負けたんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870574,
					"content": "ケダマは気づいてないみたいだ！もう「まな板の鯉」だってことにな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870575,
					"content": "#その後もこのような戦いが続いた。\\n{REALNAME[ID(2)|SHOWHOST(true)]}は勇敢に戦った——たとえ飛行スクールで優秀学生の称号を得られないとしても、他の才能で仲間の役に立てることを証明したのだ。\\nオベロンが思わず増やしてしまった体重も、それなりに役立った。普通のクク仔竜より少し大きな体型で空中の戦場を制圧し、ケダマにずっしりとダメージを与えた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "クイリア本人には戦闘能力がないようで、ケダマが戦意喪失した後、彼女は逃げることを選択した。\\n「この卑怯なルール破りめ…次はこんな簡単に勝てると思わないでよ！クビを洗って待ってなさい！」\\nまるで安っぽい悪役のように一通りの捨て台詞を言い終えると、怪我をしたケダマを連れて逃げ出した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "あっ！タルカの居場所を聞くのを忘れてた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870578,
					"content": "クウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870579,
					"content": "おいおい、落ち込むなよ。タルカは賢いやつだし、きっと無事だって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870580,
					"content": "キュウ！キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#おう、{REALNAME[ID(2)|SHOWHOST(true)]}もそう思うよな？とりあえず、まずはオベロンを飛行スクールまで送ろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870557,
					"content": "相手を説得して降伏させる",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "もし会話だけで問題を解決できるなら、この世界にこんなに争いはないはずだぜ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870559,
					"content": "え～っと…つまり、成功確率は低いってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870560,
					"content": "不思議なアイテムで手懐ける",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "え？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870562,
					"content": "今のうちに逃げよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "キュ…キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#おい、{REALNAME[ID(2)|SHOWHOST(true)]}までガッカリしちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870545,
					"content": "防御",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "二対一なのに防御を選ぶのかよ？相手は二体同時に攻撃できないんだから、防御したら1ターン無駄にしちゃうんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870547,
					"content": "アイテム",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "ちび竜ビスケットを使ってスタミナを5ポイント回復したぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870549,
					"content": "…って、そんなの今は全然必要ないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870550,
					"content": "逃げる",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "いま有利なのはこっちだぞ。なんで逃げようとするんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870519,
					"content": "防御",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "キュ…キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}のやつ、防御だと守りに入りすぎだと思ったのか、攻撃の構えを取ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870522,
					"content": "アイテム",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "今使えるアイテムなんてないぞ！トラバサミを仕掛けるにしたって遅すぎるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870524,
					"content": "キュ…キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#おお！{REALNAME[ID(2)|SHOWHOST(true)]}が攻撃の構えを取ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870526,
					"content": "逃げる",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "今は逃げてる場合じゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870528,
					"content": "キュウ…グルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#見ろ、{REALNAME[ID(2)|SHOWHOST(true)]}だってわかってるみたいだぞ。ほら、攻撃の構えを取ってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "パイモン"
				}
			]
		},
