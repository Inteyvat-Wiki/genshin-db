			"dialogs": [
				{
					"id": 750870701,
					"content": "えっ？タルカ！無事だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870702,
					"content": "#{NICKNAME}{M#お兄さん}{F#お姉さん}！みんなも無事でよかった…もうリヴァ姉さんたちには事情を説明したよ。ラミザナはやっぱり思った通りのバカだったみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750870703,
					"content": "クワッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870704,
					"content": "そうだぞ、君よりもおバカさんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750870705,
					"content": "クウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870706,
					"content": "#まあまあ、オベロンもおまえとずっと離ればなれで不安だったんだぞ。それにさっき、{REALNAME[ID(2)|SHOWHOST(true)]}と良いコンビネーションを見せてくれたんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870707,
					"content": "まだ調教の余地がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "おう。まだ仔竜なんだし、タルカが仲良くしてあげれば、きっと立派なクク竜に育つぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870709,
					"content": "クワッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "オベロン"
				},
				{
					"id": 750870710,
					"content": "ところで、おまえはどうやって戻ってきたんだ？他の人が助けてくれたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870711,
					"content": "自力で逃げ出したんだよ。オベロンも一緒に連れて離れるつもりだったけど、ちび竜ビスケットに夢中で、何しても動こうとしなくって。あまりに腹が立ったから一人で逃げたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750870712,
					"content": "えっ？そんなあっさり逃げられたのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870713,
					"content": "うん、見張りの竜の行動パターンを覚えて、隙を見てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750870714,
					"content": "もしかしたら、ここで一番頼りになるのはタルカかもしれないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870715,
					"content": "みんな、どうしてここに？…そのなんだ…謝らせてほしい——オレの早とちりで罪を被せてしまった。代わりと言っちゃなんだが、あのペテン師への仕返しを考えてたところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750870716,
					"content": "もう遅い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "そうだぞ！全部終わってから現れるなんて、手柄の横取りじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870720,
					"content": "返す言葉も無いな。約束した報酬も賠償金も、全部ちゃんと渡す。もし殴って気が済むのなら、一発殴ってくれても構わない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750870721,
					"content": "「漢」たる者、取るべき責任から逃げたりはしない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750870722,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}、パンチを一発お見舞いして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "キュウッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "ぅぐっ！まだ食らってないのに、痛みがッ！か、勘弁してくれ…頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750870727,
					"content": "さっきまで漢は責任を取るとか言ってたのに…情けないやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870728,
					"content": "#まあいいや。オイラたちもそんな器の小さいやつじゃないし。そうだろ、{NICKNAME}、{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870729,
					"content": "キュウッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "ああ。あんたらの器の大きさに感謝するよ。飛行スクールは…ええと、門はないけど、いつでも門戸を開いてあんたらを歓迎するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "ラミザナ"
				},
				{
					"id": 750870731,
					"content": "#君たちが{REALNAME[ID(2)|SHOWHOST(true)]}と仲良くしてるのを見て、僕も仔竜と仲良くする秘訣を教わりたいって思ったよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "タルカ"
				},
				{
					"id": 750870732,
					"content": "へへっ、いいぜ。時間があったらまた来るぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750870724,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}、足の指を蹴って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "キュウッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870718,
					"content": "賠償金を要求する！それと参加賞も。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870719
					]
				},
				{
					"id": 750870719,
					"content": "参加賞のこと、また覚えてたんだな…",
