			"dialogs": [
				{
					"id": 766600101,
					"content": "ようこそ、冒険者さん。今日の依頼を確認しますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600102,
						766600103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 766600102,
					"content": "やっぱりこれが一番しっくりくる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600104
					]
				},
				{
					"id": 766600104,
					"content": "あら…何か急用ですか？お手伝いできることがありましたら、なんなりとお申し付けください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600105,
						766600106
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 766600105,
					"content": "そういうわけじゃないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
				{
					"id": 766600107,
					"content": "オイラたちは、ただおまえに会えて嬉しいだけだぞ！へへっ、やっぱりキャサリンが一番だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766600108,
					"content": "そう思っていただけて何よりです。ただ申し訳ございません、そのユーモアを理解しきれていないかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 766600109,
					"content": "いずれにせよ、ナド・クライへようこそ！この地には無数のチャンスが息づいています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 766600110,
					"content": "お二人はきっと、ここで壮大な冒険を繰り広げ、かけがえのない唯一の宝物を手に入れることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766600111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 766600111,
					"content": "冒険者さんのご武運を祈ります。引き続き冒険をお楽しみください。星と深淵を目指せ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 766600106,
					"content": "#{M#俺}{F#私}たちはただ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766600107
					]
				},
