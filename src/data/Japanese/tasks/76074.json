			"dialogs": [
				{
					"id": 760740101,
					"content": "変なハープだな…どう弾いても全然音が出ないぞ…もしかして、壊れてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740102,
						760740104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760740102,
					"content": "まずは仙霊たちを追いかけよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740103
					]
				},
				{
					"id": 760740104,
					"content": "え？でも確かにハープの音と歌声が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740105
					]
				},
				{
					"id": 760740103,
					"content": "おう！ハープのことはとりあえず置いといて…仙霊の導きに従って上まで行けば、お宝が見つかるはずだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760740105,
					"content": "ホ…ホントか？うーん、オイラは風の音以外、なにも聞こえなかったぞ。もしかして「弾いてる本人にしか聞こえない」とかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760740106,
					"content": "よーし、じゃあオイラも弾いてみるぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760740107,
					"content": "パイモンは力を込めて弦を弾いた…\\n",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760740108
					]
				},
				{
					"id": 760740110,
					"content": "#うーん、やっぱり全然なんにも聞こえないぞ！{NICKNAME}、気のせいじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760740111,
					"content": "まぁ、ハープのことはさておき、仙霊の案内に従って上に行けばお宝を見つけられるはずだよな！",
