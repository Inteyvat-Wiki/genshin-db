				"points": []
			},
			"dialogs": [
				{
					"id": 756600101,
					"content": "ふぅ～いい天気。来てよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600102,
					"content": "あっれー？我らが誇る「トゥマイニ」じゃん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600103,
					"content": "奇遇だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "イラードとのやりとり、そして試験についてシロネンに伝えた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "なるほどね…そういえば、彼女に協力して「こだまの子」のステージを作ったことあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600107,
					"content": "最初は、「テトラウィトルの災い」ウクンガと「セイタードの砂刃」アムルにテストを依頼したみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600108,
					"content": "真っ向勝負にばかりこだわって、「機動性」がまったく活かせてなくて…アドバイスが偏ってたみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600109,
					"content": "で、パカルがウチに相談してきたわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600110,
					"content": "このステージってシロネンが作ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "まぁそういっても間違いじゃないかな。パカルとイラードと話し合って、ステージの構造に微調整を入れることになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600112,
					"content": "戦闘中に有利な位置を確保して、ちょうどいいタイミングで拠点間を移動できるかってことが試されるようにできてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600116,
					"content": "ぜひテストに参加させて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "ナタであんたの実力を知らない人はいない。どんなステージだって楽勝っしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600119,
					"content": "ステージはあっち。ま、よかったら試してみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600117,
					"content": "あまり難しくないといいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "そんな技術もあるなんて、さすがだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "簡単な装置だし、別にそんな難しくないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600115,
					"content": "今回頑張って、「こだまの子」から優秀な戦士を輩出できるようになれば、ウチも少しは楽になる。そしたら、溜まった注文もゆっくり片付けられるっしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 756600104,
					"content": "イラードの依頼で来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}