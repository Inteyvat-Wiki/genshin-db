			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730201,
					"content": "おや？来たんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730202,
					"content": "そろそろ来る頃かなって、そう思ってたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730203,
					"content": "風神のことをもっと知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "風神バルバトス？あいつならもうモンドから消えたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730205,
					"content": "隣の璃月にいる岩神や、稲妻にいる雷神はまだいるけど、モンドの人々はもう長いことその神には会ってないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730206,
					"content": "どうして、風神のことを？トワリンのせいかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730207,
					"content": "それは…「神」のことだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3730208,
					"content": "風魔龍の過去を教えてもらったから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "ふーん。そういえばみんなは「風魔龍」をどう思ってるんだい？気になるなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730210,
					"content": "まあ、そんなに急いで教えてもらわなくてもいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730211,
					"content": "どうやら、不満を抱く者がいるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37304",
							"2"
						],
						"stepId": 37304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "ふぅ…風向きの影響を受けるのは龍だけじゃないようだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730402,
					"content": "そうだ、さっき誰かに龍の過去を教えてもらったって言ってたね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730405,
					"content": "…そうだったのかい？リサという人は、そういう風に思ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730406,
					"content": "そう、ここまで来たのは双方が武力行使をし始めたからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730407,
					"content": "でも彼の最初の憎しみは、人々が「四風守護」を祀らなくなったからじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730408,
					"content": "…あれは自然に生まれた憎しみなんかじゃないんだ。腐食された後の産物だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730409,
					"content": "ふ、腐食？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3730410,
					"content": "心臓に流れ込んだ黒い血が彼を苦しめ、何年もの間、穏やかに眠れていないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730412,
					"content": "アビスの魔術師？聞いたことがない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "モンドで聞いたような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "だから今回、目覚めた彼の精神がアビスの魔術師の呪いによって腐食してしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730413,
					"content": "人ならざる者によって結成されたアビス教団、人類の敵となる組織だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730415,
					"content": "そうさ、人ならざる者によって結成されたアビス教団、人類の敵となる組織だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730416,
					"content": "彼らのことはよく知らないけど、人間の世界に対して深い悪意を持つことだけは知っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730417,
					"content": "荒野のヒルチャールも、ヤツらの指揮で動き、ヤツらの手足となってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730418,
					"content": "ここに来るまで、ボクもトワリンと同じ呪いに蝕まれていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730419,
					"content": "でも、今ボクたちのいる場所は「英雄の象徴」、モンドの全ての源だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730420,
					"content": "木々のすき間から流れる風は心地よく、ボクの好きな匂いがする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730421,
					"content": "君と一緒に木陰の下にいると、龍の涙が浄化された時みたいに、ボクの中にある毒が消えていくんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730423,
					"content": "うん…だいぶ良くなったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730424,
					"content": "それで、おまえはどうして毒を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3730425,
					"content": "それはまあ、前にトワリンと会話しようとした時に…誰かさんに邪魔されてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730427,
					"content": "あの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "つまりこっちのせいで…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "そのせいでトワリンの呪いを払うどころか、自分も「アビス」の毒に蝕まれちゃったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730429,
					"content": "そうだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730431,
					"content": "#ねぇ、{NICKNAME}、お詫びにボクと一緒にモンドの大聖堂に行ってくれないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3730432,
					"content": "モンドの大聖堂？何しに行くんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3730433,
					"content": "取りに行くんだ…ライアー——「天空」をね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		}
	]
}