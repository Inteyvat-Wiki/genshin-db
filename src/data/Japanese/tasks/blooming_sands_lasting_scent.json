			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アザライ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420301,
					"content": "いらっしゃいませ、何をお求めですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230420302,
					"content": "ネルミンの注文について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "ああ、そちらですか…ご用意できておりますよ。どれも質の良い香料で、値段も高くありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230420304,
					"content": "ネルミンはこの香料を使って香水を作るつもりなんでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "アザライ"
				},
				{
					"id": 230420305,
					"content": "まあ、やる気があるのはいいことですが…ネルミンも自分の体には気をつけないとねぇ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アザライ"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304205",
							"2"
						],
						"stepId": 2304205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ネルミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420501,
					"content": "よかった、前の材料がまだ余ってるから、持ってきてくれたものを加えれば、あと何回か試作できます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420502
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420502,
					"content": "ふぅ…もっとよくメモを見て、今度こそ成功させなきゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420503
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420503,
					"content": "そうだ、花びらを何枚か摘んでこないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420504
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420504,
					"content": "ネルミンは緊張しながら香水を作り始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230420505
					]
				},
				{
					"id": 230420505,
					"content": "できた！なかなかいい香り…ベタベタもしないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420506
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420506,
					"content": "これなら成功って言えるよね…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420507,
						230420508
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420507,
					"content": "成功したみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				},
				{
					"id": 230420509,
					"content": "ええ！このための瓶も買いましたから、それに香水を詰めて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420510
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420510,
					"content": "旅人さん、一緒にレイフに香水を届けに行きましょう。気に入ってくれるといいんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420508,
					"content": "少なくとも失敗じゃないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				}
			]
		},
		{
			"id": 2304206,
			"completionStepIds": [
				2304206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304206",
							"2"
						],
						"stepId": 2304206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レイフ",
					"ネルミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "ネルミン、それに旅人…どうしてここに？何かトラブルでもあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 230420602,
					"content": "まさかあの鉢植えに問題でもあったか？俺はまだ当直中だが、上がったらすぐに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 230420603,
					"content": "ネルミンからプレゼントがあるんだって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "はい！ミントの香りがする香水です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420605,
					"content": "最初はザイトゥン桃の香りにしようと思ってたんですが、何故かザイトゥン桃を入れると香水がベタベタしちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420606,
					"content": "あ…ありがとう、でも「香水」って何に使うんだ？虫よけ？それともマーキング…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 230420607,
					"content": "元気を出してもらうためですよ。それに体の汗の匂いをカバーしてくれるんです。毎日そんなに汗臭い匂いを嗅いでたら、めまいがするでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420608,
					"content": "これなら、嗅ぎ慣れてしまったら大丈夫さ。急に匂いがしなくなったらかえって不自然で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 230420609,
					"content": "じゃあ「香水」は私が持って帰ります。使わないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420610,
					"content": "えっ！待てって、冗談だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 230420611,
					"content": "は、早く香水をくれ。頭がクラクラしてきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 230420612,
					"content": "はい、どうぞ。腕に塗ればいいですよ。ジャワヒルおばあちゃんはそう言ってました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420613,
					"content": "いい香りがするな。確かに元気が出るよ。それに塗るとひんやりして気持ちがいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 230420614,
					"content": "ふふっ、ジャワヒルおばあちゃんの秘伝の配合なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420615,
					"content": "それに旅人さんが手伝ってくれたおかげで、こんな素敵な香水が作れたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420616,
					"content": "ちょっと手伝っただけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
					"content": "何度も世話になって、本当にすまなかったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420618
					],
					"speakerTitle": "レイフ"
				},
				{
					"id": 230420618,
					"content": "これをやるよ。お礼だと思ってくれ。本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420619
					],
					"speakerTitle": "レイフ"
