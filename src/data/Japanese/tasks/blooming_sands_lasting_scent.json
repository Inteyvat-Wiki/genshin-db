			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ネルミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "これならきっとレイフにサプライズができるわ…ふふふ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420102,
					"content": "サプライズって？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "わぁっ！旅人さん、びっくりさせないでくださいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420104,
					"content": "真正面から来たんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "考え事をしてたから、まるで気づきませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420106,
					"content": "ねえ旅人さん…「香水」って聞いたことありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420107,
					"content": "ジャワヒルおばあちゃんは、若い頃よく自分で香水を作っていたそうなんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420108,
					"content": "汗の匂いをカバーしてくれるだけじゃなくて、特別な香水の中には人を元気づける効果を持つものもあるんですって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420109,
					"content": "レイフはずっと村の入口で見張りをしているから、毎日暑さで汗びっしょりになってて…帰ってくるといつも陽射しに当てられてめまいがするって言うんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420110,
					"content": "だから彼に「ミントの香水」を作ってあげたいと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420111,
					"content": "ジャワヒルおばあちゃんが香水の作り方を書いてくれたんです。それに、あれこれ材料まで買ってきてくれて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420112,
					"content": "でも、香水を作るって思った以上に面倒なんです…こっそりと材料を合わせていくだけでも時間がかかるし、失敗作もたくさんできてしまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420113,
					"content": "これ以上ぐずぐずしてたら、私が香水を作っていることをレイフに気づかれちゃいます…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420114,
					"content": "そこで旅人さん、材料を買ってきてもらえませんか？こっそり、レイフには気づかれないようにお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420115,
					"content": "彼に言っちゃえばいいのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "だめです、これは長い間準備してきたサプライズなんですから。そんな簡単にバラしちゃうわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420119,
					"content": "実はお願いしたい材料はさほど多くないんです。アザライさんのところで私が注文したものを受け取ってもらって、それからバケツ一杯の水を汲んできてもらえればいいですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420120,
					"content": "ただし、くれぐれもこっそりと、絶対にレイフに気づかれないようにしてくださいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネルミン"
				},
				{
					"id": 230420117,
					"content": "…わかった、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "じゃあお願いしますね。安心してください、報酬ははずみますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "ネルミン"
				}
			]
		},
		{
			"id": 2304203,
			"completionStepIds": [
				2304202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
