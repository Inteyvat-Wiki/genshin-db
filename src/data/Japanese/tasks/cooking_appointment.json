			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドゥラフ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010201,
					"content": "お前が香菱、だな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010202
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010202,
					"content": "ごめんなさい、ドゥラフさん、アタシが全部悪いの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010203
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010203,
					"content": "お前がしたことは全部聞いた。ここに来たからには——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010204
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010204,
					"content": "ひやうっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010205,
						110010206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110010205,
					"content": "ぼ、暴力反対！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				},
				{
					"id": 110010207,
					"content": "——俺たちの食用肉を広めてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010208
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010208,
					"content": "…へっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010209
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010209,
					"content": "突然ですまない。詳しく説明する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010210
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010210,
					"content": "清泉町の肉は高品質で有名だが、その名がモンドだけに留まるのはもったいないと思っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010211
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010211,
					"content": "そんな時、ちょうど香菱シェフがモンドに来たと耳にしてな。呼んで来いとエレンに言っておいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010212
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010212,
					"content": "シェフ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110010213,
					"content": "聞いたことないか？璃月港で庶民向けの料理を出すことで有名な「万民堂」、そこのシェフが香菱なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010214
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010214,
					"content": "食材に対して独特の解釈を持っていて、その料理は璃月の人々に愛されている。観光客の間でも評判がいいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010215
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010215,
					"content": "へへっ、褒めすぎだよ。アタシはただ安くて美味しい料理を作りたいだけだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010216
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010216,
					"content": "香菱のような一流シェフが一流の肉を使って一流の料理を作れば、この清泉町の肉も広く知れ渡るだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010217
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010217,
					"content": "えっと、でも…そのお願いは叶えられそうにないかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010218
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010218,
					"content": "アタシ、美味しい料理を作ることだけ考えてきたから、食材が限定されてたり、宣伝したりするのは苦手で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010219
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010219,
					"content": "ここの肉はお前の使いたい食材なんだろ？何の問題もないと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010220
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010220,
					"content": "ううん、違う、全然違うよ！たとえば、料理にスライムの液体を入れたいってアタシが言ったら、同意してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010221
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010221,
					"content": "そ、それは…もう少し普通の食材ではダメなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010222
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010222,
					"content": "食材に普通もなにもないよ！調理法さえ合っていれば、どんな食材でも美味しい料理になるんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010223
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010223,
					"content": "食材によってインスピレーションが制限されるのは、アタシの信条に欠けるの。だって、そんなのつまらない料理しかできないもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010224,
						110010225
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010224,
					"content": "急に強気になった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010226,
					"content": "はぁ、決心が固いようだな、この話は諦めよう。しかし、本当に残念だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 110010225,
					"content": "これがシェフのこだわり？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010206,
					"content": "殴るなら…こっちを！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				}
			]
		},
		{
			"id": 1100104,
			"completionStepIds": [
				1100104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100104",
							"2"
						],
						"stepId": 1100104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010401,
					"content": "あの、この料理、食べてみてもいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010402
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010402,
					"content": "ごめんなさい、予約でいっぱいでね。今からだと食べれるのは7日後になるけど、大丈夫かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010403
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010403,
					"content": "大人気だな…きっと美味しいに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110010404,
					"content": "おかしい、こんな人気のシェフがいるのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010405
					]
				},
				{
					"id": 110010405,
					"content": "そうだな、なんでドゥラフは香菱に依頼したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110010406,
					"content": "はぁ…たぶん璃月港のような商業の中心地と比べて、モンドの味は万人受けじゃないとでも思ってるんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010407
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010407,
					"content": "でも、私はそうは思わない！私の肉料理は誰にも負けないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010408
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010408,
					"content": "ねぇ、特別に食べさせてよ。何かアドバイスできるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010409
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010409,
					"content": "みんな「美味しい」しか言わないのよ、だから、あんただって…待って…まさか、あんたが香菱！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010410
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010410,
					"content": "うん、そうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010411
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010411,
					"content": "そう、あんたがね。じゃあ、あんたも肉料理が得意なわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010412
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010412,
					"content": "実は、今日一番のお肉をまだ取ってあるの。あんたならどう調理する？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010413
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010413,
					"content": "うーん、肉の質と脂肪量で変わってくるけど、このお肉なら岩焼きにして、海塩、絶雲の唐辛子、清心の花を合わせるかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010414
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010414,
					"content": "清心の花だって！？でも、熱い油と一緒にしたら香りが数倍にも膨れ上がって、肉本来の香りが台無しになるわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010415
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010415,
					"content": "うん、知ってるよ。でも、この清心の花は香料ではなく付け合わせにするの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010416
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010416,
					"content": "試したことがあるんだ。火加減を上手く調節すれば、清心の花の花びらは苦みが取れて、すっきりとした味わいになるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010417
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010417,
					"content": "そこに標高の高い山で取れた絶雲の唐辛子を合わせると、低い湿度と高い温度が相まって独特の風味が生まれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010418
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010418,
					"content": "海塩のしょっぱさ、唐辛子の辛さ、肉のジューシーな香りが全て花びらに集まって、噛むたびに植物の爽やかさを感じられるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010419
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010419,
					"content": "ごちゃ混ぜになって、味がまとまらなくなりそうだけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010420
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010420,
					"content": "焼肉の主役はお肉よ、肉の香りを損なったら本末転倒だわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010421
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010421,
					"content": "わわっ、ケンカはよくない、ダメだって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010422,
						110010423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110010422,
					"content": "もうこっちの声が届いてない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010424
					]
				},
				{
					"id": 110010424,
					"content": "そう、なら料理のことは料理で解決するしかないよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010425
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010425,
					"content": "料理対決を申し込むよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010426
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010426,
					"content": "受けて立つわ！私が勝てば、ドゥラフさんの見る目がなかったことも証明できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010427
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010427,
					"content": "じゃあ、こうしよう！もしアタシが勝ったら、その勝った料理を清泉町の宣伝に使っていい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010428
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010428,
					"content": "ええ、なら私が勝ったら、私の料理を「万民堂」のメニューに入れてもらうわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010429
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010429,
					"content": "「清泉町のお肉専門シェフ、ブロックの一品」って言葉も入れてもらうわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010430
					],
					"speakerTitle": "ブロック"
				},
				{
					"id": 110010430,
					"content": "問題ない、約束するよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010431
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010431,
					"content": "じゃあ、食材を探してくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010432
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010432,
					"content": "おい、待てよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110010433,
					"content": "#{NICKNAME}、追いかけるしかないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110010423,
					"content": "これがライバルか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010424
					]
				}
			]
		}
	]
}