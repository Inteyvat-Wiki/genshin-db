			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "アペか。キノコの収穫はどうだった？ふん…もう祭司様の邪魔はしないでおくれ。何度言おうと私は同意しないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040502,
					"content": "ああいや、悪かったね。一人で家を養うなんて、私にとっては何でもないことさ。悪かったね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040503,
					"content": "私がいけなかった…ごめんよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040504,
					"content": "こんにちは、おばあさん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "おや…あんた！まったく…恥ずかしくないのかね！早く入っておいで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040507,
					"content": "え…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "外での漁獲はどうだった…？魚がなかった…？大丈夫、うちにある作物で十分さね。ただ雷鳥様に捧げる分は足りないね…ん、どうしたんだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040510,
					"content": "何をしてるんだい！今年の祭典はすごく順調で、これから景気もよくなる…祭司様も私たちの家に元気な子が生まれると言ってくれた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040511,
