			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "こんにちは…こんにちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040702,
					"content": "はぁ、ごめんね、年を取ると頭もろくに回らない…あんたは誰だい…？私の知ってる人かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040703,
					"content": "#{NICKNAME}だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "聞いたことがない名前だね…外から来た人かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040706,
					"content": "おかしいねぇ…雷鳥様の許しがなければ、この島には入れないはずなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040707,
					"content": "雷鳥はもういない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "はぁ…あんたを見ると、私のかわいそうな夫を思い出すよ…と言っても今は、もう姿も思い出せないけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040710,
					"content": "あの時はまだ若かった、現実的じゃない幻想を抱えていた…どんなに時間が経っても、成長できない人間もいるもんさね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040711,
					"content": "夫は去っていった。いかだを作って海を渡り、外の島へ行った…自由な狩りをして、見たこともない綺麗な花を摘みたい、そう言っていたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040712,
					"content": "小さい頃からそう言っていた…ずっと大人になり切れてなかったのさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040713,
					"content": "その後、祭司様の子供が浜辺であの人を見つけた…貝殻のように静かに倒れていて、砂浜よりも白かった…その花びらを、手に握りながら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040714,
					"content": "祭司様は泣きながら私にこう言った…先祖の船があの人を拒絶したと。あの人の「霊」は外の土地をさまようしかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040715,
					"content": "あの時、私は子供を産んだばかりだった…こんなこと、どうあの人に言えばいいというのさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040716,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "それから…私の子供にも子供ができた。さらにその後、私は子供たちが銀色の船へ乗るのを見送った…しかし私は依然としてこの大地で生きている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040718,
					"content": "私が心配なのは…もうキトとキナしかいないんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040708,
					"content": "理由を説明するのは難しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#{NICKNAME}って呼んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
