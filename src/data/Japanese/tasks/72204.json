			"dialogs": [
				{
					"id": 722040401,
					"content": "さあ、遊びに行っておいで…ばあちゃんはここにいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040402,
					"content": "花びらよ…おまえの故郷は、どんなところなんだい…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナ"
				}
			]
		},
		{
			"id": 7220405,
			"completionStepIds": [
				7220403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220403",
