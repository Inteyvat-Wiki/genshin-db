					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "船乗りが…キトとキナに代わってこれを私にくれたそうだ。ふう…あの子たちったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040916,
					"content": "まだその時じゃない…その時じゃないさね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナ"
				},
