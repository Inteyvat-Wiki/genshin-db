			"trigger": {
				"objectNames": [
					"ウナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "キト、キナ、来たのかい…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040102,
					"content": "まったく…また走り回って…私の足じゃ追いつかないよ…危ないことに遭ったらどうするんだい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040103,
					"content": "こんにちは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "もう！あんたたちは…まだ小さいのにそんなことを言うでない。年寄りの心が傷ついてしまうだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040106,
					"content": "せっかく来たんだし、走ってばかりいないで…ばあさんと話でもしておくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040107,
					"content": "#ごめん、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "前回の物語はどこまで言ったか…ああ、そうだった…あんたらのおじいさんのおじいさんがまだ若かった頃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040110,
					"content": "霧海の外にある島で、スマリという一族があった…彼らの長は、狐のような女だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040111,
					"content": "彼らによると、そこの土地には、雷色の花が咲いていたという…スマリの人々は、その高い山と野原に家を建て、仲良く暮らしていた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040112,
					"content": "それから…ふぁ…彼らの花は…ふぁ…すぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040113,
					"content": "すぅ…すぅ…霧海の外はな…うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040114,
					"content": "おばあさん…？大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "おや…キト？キナ？もう…行っちゃうのかい？…ごめんね、ばあちゃんまた勝手に寝ちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040117,
					"content": "行く前に、これを忘れないでおくれ…ばあちゃんがあんたたちのために持っておいたんだよ…これは霧海の外から来た綺麗なお花さ…失くさないようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040115,
					"content": "（邪魔しないでおこう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "人間違いかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
