						722040908
					]
				},
				{
					"id": 722040908,
					"content": "あの船乗り、最近ずっと急かしてくるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040909,
					"content": "いつも金色の毛皮と金色の長ズボンを着て、金の絹の冠をかぶり、静かにやって来る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040910,
					"content": "母が私に言ってくれたように、そして私がキトとキナに言ってあげたように…私たちを銀色の船に乗せるのさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040911,
					"content": "光輝く川の上でゆらゆらと…夢の中へ。夢の大地には霧がなく、金色の大きな屋敷があって…七十個、また七十個ものゆりかごが…ゆらゆら…ゆらゆら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040912,
					"content": "私たちはそこで眠りにつき、光となる…そして、地上の子供たちの夢となる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "ウナ"
				},
