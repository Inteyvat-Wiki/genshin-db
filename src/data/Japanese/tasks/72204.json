					"ウナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040301,
					"content": "はぁ…どんどんわからなくなってきたよ…なにも思い出せない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040302,
					"content": "こんにちは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "はぁ…記憶力がどんどん衰えてきてね。年を取ると、たくさんのことを忘れてしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040305,
					"content": "どうしたらいいんだろうねぇ…キトとキナがお腹を空かせてないか、外で危険に遭ってないか心配さね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040306,
					"content": "きっと大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "キト、キナ！やっと帰ってきたか…道で転んだりしてないね？木登りは？危ないからもちろんしてないね…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040309,
					"content": "ばあちゃん心配だったんだよ…はぁ、最近なにが起きたか知らないけど、島の人たちがどんどん減ってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040310,
					"content": "私がまだ名前を覚えてる人も、どんどん少なくなってきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040311,
					"content": "はぁ…もしあんたたちの名前まで忘れちゃったら…どうしたらいいんだろうねぇ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040312,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "はぁ…この花びらをあんたたちにあげるよ。いつかばあちゃんがあんたたちを忘れちゃったら、これをばあちゃんに見せておくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040314,
					"content": "ばあちゃんはまだたくさんの物語を、あんたたちに聞かせたいと思ってるさね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウナ"
				},
				{
					"id": 722040307,
					"content": "手伝おうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "何かあったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
