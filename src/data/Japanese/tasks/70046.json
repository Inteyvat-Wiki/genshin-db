	"talks": [
		{
			"id": 7004601,
			"completionStepIds": [
				7004601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7004601",
							"2"
						],
						"stepId": 7004601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジュリア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "よし、準備はすべて整ったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460102,
					"content": "頑張れ、私。数日で全部捕まえてみせるのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460103,
					"content": "な…何を？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "うわぁ、フォンテーヌにも密猟者がいるんだな…動物を売り捌くのってそんなに儲かるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460106,
					"content": "…じゃなくて！観念しろ！ひっ捕らえて執律庭に送り込んでやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460107,
					"content": "…あら、あなたたちだったのね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460108,
					"content": "私もちょうど執律庭から来たの。道案内してあげてもいいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460109,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460110,
					"content": "素直な人でよかったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "待ってくれ、なんかおかしいぞ…これから捕まるのに全く怖がらないなんて、常習犯なのか？それとも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460114,
					"content": "私は正義の側に立つ、善良な市民よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460115,
					"content": "正確に言うと、環境保全のために戦う執律庭の特別顧問——「密放流ハンター」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460116,
					"content": "私が捕まえようとしているのは、フォンテーヌの水域を荒らす外来魚よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460117,
					"content": "外来魚…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460118,
					"content": "どこかで聞いたような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "確かに、モンドでも似たようなことを聞いた気がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460122,
					"content": "昔のことは気にしないの。今のほうが大事でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460123,
					"content": "この外来魚はね、とある商人たちがわざと放流したのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460124,
					"content": "凶暴な子や繁殖能力の高い子、特別な餌で育った子…もともとここにいた生物たちにとっては、みんなとても厄介よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460125,
					"content": "元々ここにいた種がよそから来たやつらに住処を奪われてしまうと、水中生物の生態系が変わって、フォンテーヌの水質が影響を受けるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460126,
					"content": "フォンテーヌ人の健康…なんていう長いスパンの問題はさておき、身近なところで言えばフォンタみたいな飲み物の風味がまず変わるでしょうね。そうなるとフォンテーヌの経済は、大変なことになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460127,
					"content": "フォンタ…ここで消えちゃだめだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "軽そうに聞こえて、深刻な気がしてきたぞ…放っておくわけにはいかないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460130,
					"content": "魚を捕まえるのはオイラたちも得意だぞ！手伝おうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460131,
					"content": "待ってたわ、その言葉！さすがあなたたちね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460132,
					"content": "すでに囲いは作ってあるわ。中の餌が外来魚を惹きつけるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460133,
					"content": "栄誉騎士さんも白い助手さんも、正義を執行する時の気迫を思い出しながらやってみて！全力でサポートするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 700460134,
					"content": "なぜかこのお姉さん、オイラたちをよく知ってるみたいだぞ…気のせいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460128,
					"content": "フォンタは重要だね。そんなに飲まないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "どういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "どっかで聞いたことあるような気がするぞ。だいぶ前に、たしかモンドで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460112,
					"content": "#待って…{M#俺}{F#私}たち、誤解してるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "確かに、なんかおかしいよな…これから捕まるのに全く怖がらないなんて、常習犯なのか？それとも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700460104,
					"content": "み…密猟？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}