				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368201",
							"2"
						],
						"stepId": 7368201,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ACTIVITY_CLIENT_COND",
						"rawParams": [
							"2016",
							"2016020",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736820101,
					"content": "待っていたわ、勇敢な二人の友よ！このチャンスを掴み、私と一緒に冒険の芸術を楽しみ、自己を超越しましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820102,
						736820103
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820102,
					"content": "冒険の芸術？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820104
					]
				},
				{
					"id": 736820104,
					"content": "えっと、なにを言ってるのかはわからないけど、なんだかすごそうだな！詳しく説明してくれよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736820105,
					"content": "もちろん…ちょっと待って。あなたのことは知ってるわ…まさか、あなたなのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820106
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820106,
					"content": "風魔龍に対抗する空中戦の豪傑、疲れを知らぬ依頼シュレッダー、宝箱探し名人、未知の霧を吹き晴らす者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820107
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820107,
					"content": "あなたが先陣を切ってこのイベントに参加してくれれば、みんなも盛り上がって、この偉大な事業を前進させることができるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820108
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820108,
					"content": "称号がいっぱいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820109
					]
				},
				{
					"id": 736820109,
					"content": "聞いたこともないやつばっかりだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736820110,
					"content": "こういう称号は、酒の席や焚火を囲む子供たちを寝かしつけるお話に出てくるもので、みんなが口々に伝えるものだもの。聞いたことないのも無理ないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820111
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820111,
					"content": "とにかく、あなたが活躍する姿は、幾千万の冒険者を励まし、みんなが強くなる原動力を与えてくれたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820112
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820112,
					"content": "#{NICKNAME}ってモンドの冒険者協会で、こんなに有名になってたのか？じゃあオイラは？オイラの称号はなんなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736820113,
					"content": "コホン！友達から聞いたわ。あなたのことは…「鳥の羽のように軽やかで、北風のように豪快なパイモン様」だと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820114
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820114,
					"content": "「鳥の羽のように軽やか」というのは、あなたの小さくて俊敏な姿のことで、「北風のように豪快」というのは、あなたの北風騎士にも匹敵するような、羨ましいほどの食べっぷりのことよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820115,
						736820116
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820115,
					"content": "なんだか冗談みたいな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820117
					]
				},
				{
					"id": 736820117,
					"content": "よくわからないけど…パイモン様って呼ばれると、偉くなった感じがするぞ！ちゃんと覚えておくぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736820118,
					"content": "#決めた！おまえからならどんな依頼でも、このパイモン様と…えっと…豪傑のシュレッダー、空中戦で宝箱と依頼を吹き晴らす者の{NICKNAME}が手伝ってやるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736820119,
					"content": "さっきは冒険とか、超越とかって言ってたよな。つまり、協会は特別な挑戦イベントでも開催する気なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736820120,
					"content": "ご名答！冒険者協会がよく新人のための特訓を行っているのは、あなたたちも聞いてるでしょ。ちょうどブリーズブリュー祭期間中、強くなってきた西風は特別な「風の種」をもたらしてくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820121
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820121,
					"content": "この「風の種」は冒険者たちの能力を強化してくれる。これはみんなに強くなるっていう素晴らしい体験と、努力する目標を与えてくれるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820122
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820122,
					"content": "だから、これらの「風の種」が点在してる地域の辺りをよく調べて、強い魔物と盗賊の所在地を探し出すよう、サイリュス会長に頼まれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820123
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820123,
					"content": "試練に参加する冒険者たちは、この特別な「風の種」慎重に使い、敵を倒す。腕を磨くため、そして精神的な突破と未来の展望を実現するためにね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820124
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820124,
					"content": "どう？ワクワクしてきた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820125
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820125,
					"content": "へへ。やっぱり、オイラの勘は正しかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736820126,
					"content": "オイラたち、いっぱい飲み食いしたし、体を動かさないと、太っちゃうからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 736820127,
					"content": "でしょでしょ！さっそく腕をまくって試してみて！あなたたちがこの試練に参加してくれれば、冒険者もいっぱい参加してくれるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820128
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820128,
					"content": "それじゃ、初めの挑戦エリアを指定するわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736820129
					],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820129,
					"content": "思いっきり頑張ってきて。私はあなたたちの雄姿を記録して、他の冒険者たちに宣伝するから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レニ"
				},
				{
					"id": 736820116,
					"content": "なんだか今でっちあげたような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820117
					]
				},
				{
					"id": 736820103,
					"content": "自己を超越？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736820104
					]
				}
			]
		}
	]
}