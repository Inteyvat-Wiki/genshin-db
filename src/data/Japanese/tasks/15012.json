						],
						"stepId": 1501204,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_NOT_EQUAL",
						"rawParams": [
							"500701",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"チョウエン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1439.465,
							64.598,
							8237.596
						],
						"pointId": 350100078
					}
				]
			},
			"dialogs": [
				{
					"id": 150120701,
					"content": "どうして「古名」を作るのをやめたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120702
					]
				},
				{
					"id": 150120702,
					"content": "…娘のためだよ。ニエガちゃんが不幸にも重い病気にかかってしまってね。ラゾーリはすべてを放り出して、あの子の看病に専念するようになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120703
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120703,
					"content": "ニエガちゃんの病状が一番ひどかったときのラゾーリは、まるで泥沼に沈んでいく松明のようだった。一生懸命、光と熱を発しながらも、足もとから泥水がどんどん押し寄せてきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120704
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120704,
					"content": "でも幸いなことに、医者の薬と大霊の加護のおかげで、ニエガちゃんの一度消えかかった命の炎は再び燃え盛った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120705
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120705,
					"content": "それから、あの子の体調は徐々に回復していってね。まだ身体は弱ってて、家の中で安静にしてなきゃいけないんだけど、もう手紙を書けるくらいには体力が戻ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120706
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120706,
					"content": "ニエガちゃんはよくあのシロネンにも手紙を出してるって聞くよ。あの子の将来の夢は、古名を作る名職人になって、かつてお母さんが誇りに思っていた職務を引き継ぐことなんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120707
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120707,
					"content": "あと何日かしたら、ニエガちゃんの誕生日なんだ。それでラゾーリがわざわざ私に頼んだんだよ——あの子の誕生日プレゼントのために、純度の高い「火山晶石」を探してきてほしいってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120708,
						150120709
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120708,
					"content": "だから一人でここに来たんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120710
					]
				},
				{
					"id": 150120710,
					"content": "そっか、大事な石なんだな。こんなにきれいなプレゼントをもらったら、ニエガもきっと早く元気になってくれると思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150120711,
					"content": "ありがとう。あの母娘もその言葉を聞いたら喜ぶと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120712
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120712,
					"content": "さて、あんまりイミシュを待たせるわけにもいかない。そろそろ戻ろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120713
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120713,
					"content": "そうだ。よかったら明日、一緒にラゾーリに会いに行かない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120714
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120714,
					"content": "晶石を盗られずに済んだのは、君たちのおかげでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120715
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120715,
					"content": "大事な晶石を守ってくれたんだし、同じくらい重みのあるプレゼントを貰ってもらわないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120716
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120716,
					"content": "ニエガが喜んでくれるといいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120717
					]
				},
				{
					"id": 150120717,
					"content": "おう！気分が良くなれば、病気も早く治るだろうしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150120718,
					"content": "もちろん…オイラたちもちょこっとプレゼントがあれば、気分がよくなるっていうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150120719,
					"content": "はははっ、安心して、絶対に満足する代物だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120720
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120720,
					"content": "それがなんなのかは…明日、ラゾーリが教えるから待っててちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120709,
					"content": "確かに簡単には手放せない晶石だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120710
					]
				}
			]
		},
