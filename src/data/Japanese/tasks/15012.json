						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"502901",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"チョウエン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1439.465,
							64.598,
							8237.596
						],
						"pointId": 350100078
					}
				]
			},
			"dialogs": [
				{
					"id": 150121405,
					"content": "どうして「古名」を作るのをやめたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121406
					]
				},
				{
					"id": 150121406,
					"content": "…娘のためだよ。ニエガちゃんが不幸にも重い病気にかかってしまってね。ラゾーリはすべてを放り出して、あの子の看病に専念するようになったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121407
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121407,
					"content": "ニエガちゃんの病状が一番ひどかったときのラゾーリは、まるで泥沼に沈んでいく松明のようだった。一生懸命、光と熱を発しながらも、足もとから泥水がどんどん押し寄せてきて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121408
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121408,
					"content": "でも幸いなことに、医者の薬と大霊の加護のおかげで、ニエガちゃんの一度消えかかった命の炎は再び燃え盛った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121409
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121409,
					"content": "それから、あの子の体調は徐々に回復していってね。まだ身体は弱ってて、家の中で安静にしてなきゃいけないんだけど、もう手紙を書けるくらいには体力が戻ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121410
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121410,
					"content": "ニエガちゃんはよくあのシロネンにも手紙を出してるって聞くよ。あの子の将来の夢は、古名を作る名職人になって、かつてお母さんが誇りに思っていた職務を引き継ぐことなんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121411
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121411,
					"content": "あと何日かしたら、ニエガちゃんの誕生日なんだ。それでラゾーリがわざわざ私に頼んだんだよ——あの子の誕生日プレゼントのために、純度の高い「火山晶石」を探してきてほしいってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121412,
						150121413
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121412,
					"content": "だから一人でここに来たんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121414
					]
				},
				{
					"id": 150121414,
					"content": "そっか、大事な石なんだな。こんなにきれいなプレゼントをもらったら、ニエガもきっと早く元気になってくれると思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150121415,
					"content": "ありがとう。あの母娘もその言葉を聞いたら喜ぶと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121416
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121416,
					"content": "さて、あんまりイミシュを待たせるわけにもいかない。そろそろ戻ろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121417
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121417,
					"content": "そうだ。よかったら明日、一緒にラゾーリに会いに行かない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121418
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121418,
					"content": "晶石を盗られずに済んだのは、君たちのおかげでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121419
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121419,
					"content": "大事な晶石を守ってくれたんだし、同じくらい重みのあるプレゼントを貰ってもらわないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121420,
						150121423
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121420,
					"content": "ニエガが喜んでくれるといいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121421
					]
				},
				{
					"id": 150121421,
					"content": "おう！気分が良くなれば、病気も早く治るだろうしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121422
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150121422,
					"content": "もちろん…オイラたちもちょこっとプレゼントがあれば、気分がよくなるっていうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150121426,
					"content": "はははっ、安心して、絶対に満足する代物だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121427
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121427,
					"content": "それがなんなのかは…明日、ラゾーリが教えるから待っててちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150121423,
					"content": "もしかして古名をくれるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121424
					]
				},
				{
					"id": 150121424,
					"content": "古名は一つあれば十分だろ？たくさんあればいいってもんじゃないし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150121425,
					"content": "オイラたち…普通のプレゼントで十分だからな、へへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150121413,
					"content": "確かに簡単には手放せない晶石だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121414
					]
				}
			]
		}
	]
}