			"dialogs": [
				{
					"id": 150120501,
					"content": "私はパニックになりながらも、魔物を迂回する道をどうにか進んだよ。ところが外に出た途端、運悪くさっきの盗賊たちに見つかってね…君たちがちょうど来てくれて本当に助かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120502,
					"content": "晶石を持ったまま逃げたのか？そんなに危ないなら、石を置いてけばよかったじゃんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150120503,
					"content": "ほとんど置いてきたよ。この一番純度の高い晶石以外はね。これだけは絶対に持って帰らないといけなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120504,
					"content": "ラゾーリ、それとかわいそうなニエガちゃんのためにも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120505,
					"content": "その二人って…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "ああ、知らないのも無理ないか。ラゾーリは昔…「古名」を作る職人だったんだ。ニエガちゃんはその彼女の娘だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
					],
					"speakerTitle": "チョウエン"
				}
			]
