					"content": "ああ、知らないのも無理ないか。ラゾーリは昔…「古名」を作る職人だったんだ。ニエガちゃんはその彼女の娘だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120609
					],
					"speakerTitle": "チョウエン"
				}
			]
		},
		{
			"id": 1501207,
			"completionStepIds": [
				1501204
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1501204",
