			"dialogs": [
				{
					"id": 150120101,
					"content": "ま、まだ戻ってこない…師匠に何かあったら…ぐす…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 150120102,
					"content": "見ろ、泣いてる子がいるぞ！なにかあったのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150120103,
					"content": "声をかけてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150120104,
					"content": "お嬢ちゃん、どうかしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "ひくっ…チョ、チョウエン師匠が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 150120106,
					"content": "「火山晶石」を採ってくるって言って店を出たまま…帰ってこないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 150120107,
					"content": "守衛のおじちゃんたちにも話したけど、いま部族は人手が足りないし、そこの地形は険しくて、魔物や悪いやつらがいっぱいいるからって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 150120108,
					"content": "ひとまず出来る限りの準備をして、それが済んだら師匠を助けに行くって言われたの…でも、それじゃ手遅れになっちゃうよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 150120109,
					"content": "#安心して、{M#俺}{F#私}が助けてあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "助けてくれるの？よかった！さっき守衛のおじちゃんが偵察した場所を地図に描いてあげるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 150120112,
					"content": "ここにチョウエン師匠がしばらくいたんじゃないかって、おじちゃんたちが言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 150120113,
					"content": "もしかしたら、悪者に追われて「陰縫いの針」のあたりまで行ってるのかも。もし、もしそうだったら…ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 150120114,
					"content": "#{M#お兄ちゃん}{F#お姉ちゃん}、お願い！チョウエン師匠を助けてあげて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イミシュ"
				},
				{
					"id": 150120110,
					"content": "#{M#俺}{F#私}の武勇伝に新たなページが増えるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
