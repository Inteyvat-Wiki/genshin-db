			"dialogs": [
				{
					"id": 150120401,
					"content": "うわぁ…あいつらそそくさと逃げてったぞ。しかも判断が早い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150120402,
					"content": "賢明な判断だね。見逃してあげよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "ふぅ…ありがとう。君たちがいなきゃ崖から落とされるところだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120405,
					"content": "まさか、あの有名な旅人が助けてくれるとは、今日は本当に運がいいみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120406,
					"content": "おっと、ごめん、自己紹介がまだだった。私はチョウエン。最悪の運勢だったけど、今さっき好運に恵まれた宝石職人だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120407,
					"content": "イミシュに頼まれて来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "あの子に…はぁ…心配をかけてしまったようだね。店を出たときは二日くらいで戻れると思ったんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120409,
					"content": "まさか「陰縫いの針」の近くで新しい「火山晶石」の鉱脈を見つけるなんて予想してなくって。しかも鉱量も多いし、純度も格段に高いときた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120410,
					"content": "だから、そこで「火山晶石」を採掘してたんだ。たくさん採れたし、そろそろ引き上げようとしたら…晶石に含まれる燃素が魔物を引き寄せてしまってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チョウエン"
				},
				{
					"id": 150120403,
					"content": "有名なのも役に立つんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
