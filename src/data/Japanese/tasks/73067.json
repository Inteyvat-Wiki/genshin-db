					"アランシャクン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "おまえがアランシャクンか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670402,
					"content": "うぅ…アランシャクンは確かにボクの名前なのだ。わわっ、急にそんなに近寄らないで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670403,
					"content": "二人が助けてくれたのはありがたいけど、ア、アランシャクンは二人にもうちょっと離れてほしいのだ…うう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670404,
					"content": "そしたらアランシャクンは、ちょっと安心できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670405,
					"content": "なんだよ！オイラたち、おまえを助けてやっただけじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670406,
					"content": "ああ…ごめんなさいごめんなさい。アランシャクンの要求がひどすぎて…キミを怒らせちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670407,
					"content": "でも、アランシャクンはここに閉じ込められてて、まだ怖さが収まらなくて…うぅ…失礼だとは思うけど、どうか許して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670408,
					"content": "まあ、気にすんなよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670409,
					"content": "うん、よかった。キミたちの名前を聞いてもいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670410,
					"content": "パイモン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670411,
					"content": "#{M#俺}{F#私}は{NICKNAME}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#うぅ…金色のナラ{NICKNAME}とパイモン、その…どうしてアランシャクンの名前を知ってたのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670413,
					"content": "家にあった日記を見たんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#金髪のナラ{NICKNAME}は、日記を見てアランシャクンを探しに来てくれた。そして閉じ込められたアランシャクンを助けてくれた。とても心優しい、すごいナラなのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670415,
					"content": "うう…アランシャクンが「勇気」をなくしてなければ、さっきみたいに閉じ込められなかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670416,
					"content": "そうだ。日記にも「勇気」がなくなったって書いてたけど、一体どういうことなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670417,
					"content": "それはずっと前のこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670418,
					"content": "たくさんの月の前、アランシャクンは今みたいに「勇気」のないアランシャクンだったのだ…その頃は、木の枝が折れる音を聞いただけでも、アランシャクンは眠れなくなったのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670419,
					"content": "でも、憶病なアランシャクンにもそばにいてくれるナラの友達がいた。ナラの友達は偉大なナラヴァルナじゃなかったけど、とてもいいナラだったのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670420,
					"content": "カレはアランシャクンが臆病だからといって、アランシャクンをからかわなかった。アランシャクンが怖い時には手を握っていてくれた…アランシャクンの永遠に忘れられない友達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670421,
					"content": "でもある日、そのナラは「モジャモジャ仮面魔王」に捕まってしまった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670422,
					"content": "待て、その「モジャモジャ仮面魔王」ってのはなんだよ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670423,
					"content": "「モジャモジャ仮面魔王」は、毛がモジャモジャで、仮面を被ってる…魔王だよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670424,
					"content": "…お、おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670425,
					"content": "パイモンは何か知ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "知ってる方がおかしいだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670429,
					"content": "まあとにかく、その「モジャモジャ仮面魔王」がアランシャクンの友達をさらったと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670430,
					"content": "…「モジャモジャ仮面魔王」はとても邪悪でずる賢いのだ。思い出すだけで、アランシャクンは身体が震えはじめちゃうのだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670431,
					"content": "…うぅ、ナラの友達が捕まったあの時、アランシャクンは「モジャモジャ仮面魔王」にぶたれるのが怖かったけど、ナラの友達に二度と会えない方がもっともっと怖かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670432,
					"content": "だからアランシャクンはがんばって、目を閉じて！歯を食いしばって！手を叩いて！ナラの友達を助け出したのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670433,
					"content": "その後、ナラの友達は花で「勇気のお守り」を作ってアランシャクンに言ったのだ。「アランシャクンは勇気のあるいいアランナラだ！憶病なアランナラじゃない！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670434,
					"content": "アランシャクンはそれで、「勇気」を手に入れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670435,
					"content": "え？勇気って言うなら、おまえの「目を閉じて！歯を食いしばって！手を叩いて！」の部分だって勇気ある行動じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670436,
					"content": "違う違う。アランシャクンはその後で、ナラの友達から「勇気」をもらったんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670437,
					"content": "でも、おまえが友達を助けたってのは、十分勇敢なことだと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670438,
					"content": "違う違う。ナラの友達を助けた時、アランシャクンは怖かったのだ。手足はガクガク。でも「勇気」をもらってからは、アランシャクンの手足はもうガクガクにならなかったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670439,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670440,
					"content": "お守りはただのきっかけ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#うぅ…ナラ{NICKNAME}の話は難しい。アランシャクンには、「勇気のお守り」があるから、アランシャクンに「勇気」があるってことしか分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670443,
					"content": "この間、アランシャクンの「勇気」が盗まれたから、「モジャモジャ仮面魔王」の洞窟にこっそり探しに来たのだ。アランシャクンの「勇気」の証を見つけたくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670444,
					"content": "その結果、スライムに洞窟に閉じ込められたけど…運よくあの「モジャモジャ仮面魔王」だかなんだかには見つからなかったと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670445,
					"content": "#あー、そういえば{NICKNAME}、オイラたちが前にヒルチャールから手に入れたやつ…あれって、まさかアランシャクンのお守りか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670446,
					"content": "アランシャクン！オイラたち、もしかしたらもう、おまえの「勇気」を拾ってたかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670447,
					"content": "#本当に！？ナラ{NICKNAME}とパイモン、本当にアランシャクンの「勇気」を拾ったの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670441,
					"content": "勇気は元々アランシャクンの心の中にある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "アランナラらしい答えだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "だな。その「モジャモジャ仮面魔王」がなんなのか、全然わからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "パイモン"
				}
			]
		},
