			},
			"dialogs": [
				{
					"id": 730670601,
					"content": "これだ！これだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670602,
					"content": "これが、アランシャクンの「勇気のお守り」。アランシャクンの傍を少し離れてたから、花の色もちょっと暗くなっちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670603,
					"content": "でも大丈夫。アランシャクン、これからはちゃんと守る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670604,
					"content": "「アランシャクンは勇気のあるいいアランナラだ！憶病なアランナラじゃない！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670605,
					"content": "#本当にありがとう、ナラ{NICKNAME}とパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670606,
					"content": "今のアランシャクンは「勇気」を取り戻したアランシャクン。もはやボクを止められる者はいない。たかが「モジャモジャ仮面魔王」ごとき、もうアランシャクンの敵ではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670607,
					"content": "（うわあ、しゃべり方も前とは違うぞ）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670608,
					"content": "#「モジャモジャ仮面魔王」は悪の限りを尽くしている。ナラ{NICKNAME}とパイモン、一緒に来てくれ。二人がいればきっとやっつけられる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670609,
					"content": "アランシャクンには分かる。今日こそ…あの魔窟に行ってアイツと決着をつける日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670610,
					"content": "#ああ、{NICKNAME}、オイラたちも一緒に行こうぜ…その「モジャモジャ仮面魔王」が一体なんなのか見てみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
