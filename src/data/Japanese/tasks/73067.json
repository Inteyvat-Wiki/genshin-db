			},
			"dialogs": [
				{
					"id": 730670101,
					"content": "あれ、ヒルチャールたち、変なものを落としてったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670102,
					"content": "花で作ったものみたいだけど…変なの。もう摘んでからずいぶん経つみたいなのに…枯れてないぞ。普通の花なんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670103,
					"content": "凄い量の草元素を感じるぜ…しかもここに捨てられて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670104,
					"content": "きっとアランナラのもの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "うん、多分な。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670108,
					"content": "うーん、たくさんの草元素が宿ってて、ヒルチャールの手の中にあっても枯れてない、花で作られたなにか、か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670109,
					"content": "ずっと持ち歩いてたのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "だな。とにかく、なるべく早くこいつをアランナラに返してやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670112,
					"content": "#中に入ってみようぜ、{NICKNAME}。これを失くしたおっちょこちょいがため息を吐いてるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670110,
					"content": "貴重なものなのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "草元素のヒルチャールのものかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "なに言ってるんだよ。どう考えてもここに住んでるアランナラのだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "パイモン"
				}
			]
		},
