				"points": []
			},
			"dialogs": [
				{
					"id": 730670301,
					"content": "うーん…アランシャクンか。このアランシャクンっていうのが、この日記を書いたアランナラだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670302,
					"content": "この日記の文字、おっきくなったり、ちっさくなったりしてさ。おっきい時はいいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670303,
					"content": "ちっさいのを読むと目が痛くなるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670304,
					"content": "パイモンは小さい文字で気分が悪くなるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "いつも普通の大きさの字ばかり見てりゃ、ちっさい字には慣れないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670306,
					"content": "うーん、このアランシャクンってやつ、日記の最後のページを書いてから帰ってきてないのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670307,
					"content": "東の洞窟とやらに探しに行こうぜ。「勇気」がなくなったって日記には書いてあるけど…「勇気」ってなくなるもんか？ちょっと気になるんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7306704,
			"completionStepIds": [
				7306713
			],
