			"dialogs": [
				{
					"id": 730670701,
					"content": "ちょっぴり予想はしてたけど…「モジャモジャ仮面魔王」ってのは本当にヒルチャールだったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670702,
					"content": "ひるちゃーる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670703,
					"content": "そう。「モジャモジャ仮面魔王」はヒルチャールだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730670704,
					"content": "「ひるちゃーる」はみんな「モジャモジャ仮面魔王」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "アランシャクン"
				},
				{
					"id": 730670705,
					"content": "違う違う…",
					"roleType": "TALK_ROLE_NPC",
