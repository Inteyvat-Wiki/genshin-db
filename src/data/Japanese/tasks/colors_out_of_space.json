			"dialogs": [
				{
					"id": 760280301,
					"content": "#ううっ、やっと見つけたぞ、{NICKNAME}！さっきの光ってるやつがぶつかった後、爆発の衝撃波で吹き飛ばされちゃって…まあ、幸い怪我はなかったけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760280302,
					"content": "ここまで飛んで戻るのに、だいぶかかったけど…おまえが無事でよかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760280303,
					"content": "#{M#俺}{F#私}も結構飛んでたんだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "なるほど…って、えっ？ちょっと待って。「飛んだ」ってどういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760280305,
					"content": "パイモンに先ほど見た光景を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#うーん、テイワットにそんな場所があるなんて聞いたことないぞ…{NICKNAME}、もしかして、なんか変な幻覚でも見たんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760280307,
					"content": "なんにせよ、おまえが無事でよかったぜ！ここは分からないことだらけだし、さっさと離れようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760280312,
					"content": "はぁ、まさかあんな危険な物だったなんて…結局お宝も見つからなかったし…なんであんなものがここに現れたんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760280313,
					"content": "それに、あの光るやつは仙霊じゃないなら、いったいなんなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760280308,
					"content": "#{M#俺}{F#私}、変なところに飛ばされたみたい…",
					"roleType": "TALK_ROLE_PLAYER",
