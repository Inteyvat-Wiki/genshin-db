			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"鯨井坊や",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#よっ！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、いいもんがあるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760102,
					"content": "大丈夫、興味ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "かわいそうに、こんな若いのに怪しげな商売に手を染めるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760104,
					"content": "#違うよ！オレはただ{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}と手まりがしたいだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760105,
					"content": "「手まり」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760106,
					"content": "#まあ簡単に言うと、オレが手まりをこの近くに隠して、手まり唄が1曲終わるまでに、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}がそれを探し出せたら、アンタの勝ちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760107,
					"content": "手まりってこんな遊び方だっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "え？すごい冒険者のお姉さんに教えてもらったんだけど。あの人は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760109,
					"content": "「鯨井、ちゃんと覚えておいて。『アンタが勝ったら、いいもんやるよ』って、ちゃんと言うんだよ。」って言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760110,
					"content": "#だから{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、アンタが勝ったら、いいもんやるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760111,
					"content": "#いいもん！{NICKNAME}、子供と遊んでやるのは当たり前のことだと、オイラは思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760112,
					"content": "でも、普通の手まりと遊び方が違うと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "現地の人しか知らない遊び方かもしれないだろ、細かいこと気にすんなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760114,
					"content": "鯨井坊やだっけ？遊びに付き合ってやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760116,
					"content": "やったー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760115,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
