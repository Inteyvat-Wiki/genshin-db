							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井坊や",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}すごい、すぐ見つけるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760703,
					"content": "#ふふん、{NICKNAME}は百戦錬磨で、たくさんの国を旅した旅人だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760704,
					"content": "へぇ！まさか、「モンド」にも行ったことあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760705,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "すごい！あのお姉さんから聞いたんだけど、モンドは凄くきれいな場所なんでしょ、「風龍遺跡」って名前の高い塔もあるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760707,
					"content": "風龍廃墟だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "うん、あの塔と将軍様の天守、どっちが高いのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760710,
					"content": "鯨井坊やは、なんで1人で外にいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760711,
					"content": "姉ちゃんが釣りをする時、オレがいると魚が逃げちゃうから1人で遊んでるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760712,
					"content": "この前、さっき言った冒険者のお姉さんに会ったんだけど、オレが退屈してるのを見て手まりをたくさんくれたんだ。「欲張りな旅人と遊べ」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760713,
					"content": "欲張りな旅人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "欲張りじゃない！心配してるんだ！鯨井坊やが1人でつまんなさそうにしてたから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760715,
					"content": "#ああ、オレも{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}たちが遊んでくれて楽しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760716,
					"content": "1人で外に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "子供1人で外にいるのは、危ないだろ？いいもんだってたくさん持ってるし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760718,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}優しいね。でも心配いらない、あの冒険者のお姉さんに教えてもらった、一瞬で手まりを爆弾にする方法を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760719,
					"content": "危ないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760720,
					"content": "危なくないよ！ヒルチャールもスライムも、悪いヤツらも、たくさんドカーンして来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760721,
					"content": "おまえの方が危険人物だった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760722,
					"content": "#そうだ、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}も友達と手まりを遊びたいなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760723,
					"content": "ここに1個残しておくよ！遊び方は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760724,
					"content": "手まりを隠す時は、手まり唄が1曲終わるまでにちゃんと隠す。探す人も手まり歌が1曲終わるまでに探し出す。これで公平でしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760725,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "オイラたちが遊んでたのが爆弾だったと考えると、怖いな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760727,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}怖がらないで、「悪いヤツしかドカーンしない、たぶん」って、お姉さんが言ってたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760728,
					"content": "「たぶん」！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760729,
					"content": "#じゃ、オレはまた別のところで遊んでるから！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}またなー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760708,
					"content": "そうだっけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}