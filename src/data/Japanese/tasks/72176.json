			"trigger": {
				"objectNames": [
					"鯨井坊や",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "あれれ、難しすぎたかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760203,
					"content": "さっきはただ調子が悪かっただけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760204,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、もっかいやる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "鯨井坊や"
				},
				{
					"id": 721760205,
					"content": "#もちろんだ！{NICKNAME}、こいつにオイラたちの凄さを見せつけてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 721760206,
					"content": "もう一回！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "わーい！じゃあ、制限時間内に手まりを見つけてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井坊や"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
