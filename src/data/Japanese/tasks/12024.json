			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"九条裟羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240101,
					"content": "お久しぶりです、九条裟羅さん。前に会ったのは、戦場でしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240102
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240102,
					"content": "ああ、あの時はお前のおかげで苦汁を飲まされた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240103
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240103,
					"content": "ところで、なんでお前もいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240104
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240104,
					"content": "今回の交渉を見届けに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120240105
					]
				},
				{
					"id": 120240105,
					"content": "#はい、{NICKNAME}は今回の交渉の証人となります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240106
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240106,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}は私たちの戦いを最初から最後まで経験し、現在の平和に多大な貢献をもたらしました。{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}以上に相応しい者はいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240107
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240107,
					"content": "それもそうだな。では早速本題に入ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240108
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240108,
					"content": "まずは海域の管轄権の問題だ。戦時中、私たちは鳴神島における海祇島漁師たちの活動を制限してきた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240109
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240109,
					"content": "ここより、その制限を正式に解除しよう。だが収穫を海祇島に持ち帰るには、私たち鳴神島の税法に則って税を納めてもらう必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240110
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240110,
					"content": "いいでしょう。ですが鳴神島付近で漁をする方に対し、天領奉行による庇護を約束してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240111
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240111,
					"content": "彼らにもし治安問題による損失があった場合、天領奉行が率先して解決をお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240112
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240112,
					"content": "それは約束しよう、協約の中にも載せる。天領奉行がいる限り、彼らに危険はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240113
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240113,
					"content": "なんか上手くいってるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120240114,
					"content": "それから人員の往来と常備軍の所属問題についてだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240115
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240115,
					"content": "以前までは、我々が海祇島に行こうが、海祇島の人間がこちらに来ようが、厳重な尋問を受けてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240116
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240116,
					"content": "その結果、お互いの交流がますます減り、島々の間で商売をする商人もほとんどいなくなってしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240117
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240117,
					"content": "戦争が終わった今、双方の貿易取引を担当する商人を社奉行から何人か選ぶことを提案する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240118
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240118,
					"content": "貿易取引はお互いに意思疎通をとらなければなりません。双方の商人に参加させるべきです、社奉行に完全に委ねることはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240119
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240119,
					"content": "だが私の知る限り、海祇島は現在あらゆる種類の物資が不足している。社奉行による統一管理は、お前たちにとっても良いことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240120
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240120,
					"content": "物資の不足についてはこちらが対処します、ご心配なく。それに海祇島は資源が豊富なため、多くの商人がここへ来たいと願っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240121
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240121,
					"content": "ましてやこういう事は、神里家と相談するべきこと。天領奉行は…ここまでの権能は持ち合わせていないはずですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240122
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240122,
					"content": "だったら、ひとまず治安について話そう。単刀直入に話すが、海祇島の治安部隊を天領奉行の管轄下に戻したいと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240123
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240123,
					"content": "当分の間、それは不可能なことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240124
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240124,
					"content": "不可能なことなどあるまい。天領奉行が稲妻の治安を管理している以上、海祇島をこのまま例外にするわけには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240125
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240125,
					"content": "卑劣な九条家め、貴様らはファデュイと結託し、俺たち海祇島のすべてを奪おうとしてるんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240127
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240127,
					"content": "心海！この状況は虎の巻の第何条を使えばいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120240128,
					"content": "最後の一条です…しかし、あなたたちが手を出す必要はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240129
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240129,
					"content": "忠勝、状況が変わりました。あなたたちは横で待機してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240130
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240130,
					"content": "ご安心を、あなたたちの思いは理解しています。後のことは私に任せてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240131
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240131,
					"content": "九条さん、このことについて、我々海祇島に説明をしていただけませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240132
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240132,
					"content": "…ああ、少し待ってくれ。全員、私の調査が終わるまで手を出すな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240133
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240133,
					"content": "お前たち二人、こっちに来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240134
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240134,
					"content": "言え、お前たちは本当にファデュイと結託してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240135
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240135,
					"content": "それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240136
					],
					"speakerTitle": "元助"
				},
				{
					"id": 120240136,
					"content": "その…結託とまでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240137
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 120240137,
					"content": "何人かのファデュイたちが、海祇島との戦争を引き延ばすために共に協力しようと言ってきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240138
					],
					"speakerTitle": "元助"
				},
				{
					"id": 120240138,
					"content": "それでその、どうせ害もないと思ったので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240139
					],
					"speakerTitle": "元助"
				},
				{
					"id": 120240139,
					"content": "ですが、私たちは同意したわけではありません。ただ…彼らに海祇島で大暴れをさせてから、状況を判断しようと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240140
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 120240140,
					"content": "九条様、私たちは彼らと結託なんてしていません。ただ少し前に一度話をしただけです。それがなぜ海祇島の人に知られたのかは分かりませんが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240141
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 120240141,
					"content": "もういい…戻って罰を待つんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240142
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240142,
					"content": "何がどうあれ、そいつらはファデュイだ。ヤツらが私たちにしたこと、もう忘れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240143
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240143,
					"content": "協力どころか、最初から関わり合いを持つべきではない相手だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240144
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240144,
					"content": "ヤツらの目的はなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240145
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240145,
					"content": "ファデュイの主力はすでに稲妻から撤退しました。私たちを訪ねたのは、彼らの親分の敵討ちをするためだったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240146
					],
					"speakerTitle": "陶義隆"
				},
				{
					"id": 120240146,
					"content": "あの女の部下か…復讐を果たし、稲妻をまた混乱に導こうとしているのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240147
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240147,
					"content": "いつか必ず、私がヤツらを全員捕らえる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240148
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240148,
					"content": "この件に関しては、たしかに我々の問題だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240149
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240149,
					"content": "すまない、私の管理不足でこのような局面をもたらしてしまった。今一度、和平交渉を続ける機会を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240150
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240150,
					"content": "ふふ…もちろん、九条さんがこのことを上手く処理できると信じていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240151
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240151,
					"content": "ですが、自分たちのことですら管理の行き届いていない天領奉行に海祇島の治安を預けるのは、いささか不安が残ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240152
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240152,
					"content": "返す言葉もない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240153
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240153,
					"content": "この議題はひとまず置いておこう。天領奉行の管理改善を済ませてから、またきちんと話し合いの場を設けさせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240154
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240154,
					"content": "商人に関することは、私も社奉行と相談し、双方が参加できるようにする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240155
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240155,
					"content": "なんだか九条裟羅の勢いが一気に弱まったな。これで交渉が上手くいくはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120240156,
					"content": "まさか海祇島の「軍師」が、戦いだけでなく交渉にも秀でていたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240157
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240157,
					"content": "次会う時は、またこうして座りながら話し合いをしたいものだ。戦場でのお前は、厄介すぎる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240158
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240158,
					"content": "今日はここまでにしよう。私も戻って天領奉行の内部問題について徹底的に調査しなければならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240159
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240159,
					"content": "ファデュイの拠点はすでに私たちが潰しました。もうすぐ彼らから支援の要求連絡が入るでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240160
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240160,
					"content": "相手に感づかれないよう、まずは彼らに従い、現れたところを一網打尽にすることをお勧めします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240161
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240161,
					"content": "考えておく、感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240162
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240162,
					"content": "では私はこれで、次また会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240163
					],
					"speakerTitle": "九条裟羅"
				},
				{
					"id": 120240163,
					"content": "珊瑚宮様、我々は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240164
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240164,
					"content": "海祇島に戻ってからにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
			"id": 1202402,
			"completionStepIds": [
				1202406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202406",
