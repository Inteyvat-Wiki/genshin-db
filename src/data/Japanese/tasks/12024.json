						],
						"stepId": 1202406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240201,
					"content": "珊瑚宮様、すべて知っていたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240202
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240202,
					"content": "あなたたちが事を起こした原因、すでに聞いています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240203
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240203,
					"content": "天領奉行が信じられないため、和平交渉をせず、戦い続けたいのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240204
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240204,
					"content": "結果から見ると、たしかに当てずっぽうで彼らの陰謀を見抜くことができました。ですが、あなたたちのやり方を認めるわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240205
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240205,
					"content": "しかし珊瑚宮様、我々は多くの仲間を犠牲にしてきました。このまま足を止めてしまったら、今までの努力が無駄になるのでは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240206
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240206,
					"content": "このまま戦争を続けることを望みます！私が犠牲になっても構いません、完全な勝利を得られるのなら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240207
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240207,
					"content": "あなたたちの考えも理解はできます…ただし、その考え方で他人を巻き込むようなことはしないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240208
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240208,
					"content": "戦時中、悲しい出来事が多々あった反面、勝利の味も経験してきました。あなたたちにとっては、戦意を掻き立てる経験だったでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240209
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240209,
					"content": "ですが、あなたたちの見えないところで、毎日苦しい思いをしながら生きてきた人々もいたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240210
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240210,
					"content": "海祇島の人々が平和を願うのは、一人一人が戦争にたくさんの力を費やしてきたからです。彼らはもう疲れ切っています。あなたたちをもう一度あの日々に戻すわけにはいきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240211
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240211,
					"content": "しかし…私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240212
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240212,
					"content": "わかっています、すべてあなたたちのせいというわけではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240213
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240213,
					"content": "私の考え不足でした。あなたたちに戦う意志を持つよう伝えたのに、それをどう手放すか教えなかったのは私です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240214
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240214,
					"content": "珊瑚宮様のせいではありません！私たちの…身勝手が招いたことです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240215
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240215,
					"content": "なんにせよ、軍法による処置を受けます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240216
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240216,
					"content": "はい。では、処置を言い渡します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240217
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240217,
					"content": "今日より、秘密軍隊を設立することに決めました。海祇島の安全を守り、一切の危険を島から遠ざけてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240218
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240218,
					"content": "そして、あなたたちと同じ考えを持つ者の加入を許します。ですが訓練は非常に厳しいものになるため、しっかりと頑張ってくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240219
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240219,
					"content": "珊瑚宮様、それはどういう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240220
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240220,
					"content": "今回の交渉から見て、九条家も当分の間は平穏を保てないでしょう。平和を望む者もいれば、戦争を望む者もいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240221
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240221,
					"content": "海祇島が平和を望んでいるとはいえ、自分たちを守るくらいの力は必要です。あなたたちにまだ戦う意志があるのなら、今日から厳しい訓練を受けてもらいましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240222
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240222,
					"content": "一人一人が戦いの場で、幕府の武士を二人やっつけられる程度になるまで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240223
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240223,
					"content": "…ありがとうございます…珊瑚宮様…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240224
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240224,
					"content": "では、ゴローのところで訓練を申し込んでください。今後は何が起きようと、自分勝手な行動は許しません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240225
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240225,
					"content": "もし次またこのようなことがあれば…理由を問わず、弁解の余地がないことをお忘れなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240226
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240226,
					"content": "…かしこまりました。今後は、精一杯訓練に励みます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240227
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240227,
					"content": "こんな機会を与えてくださり、誠にありがとうございます。では、私たちはゴロー様のところに行ってきます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240228
					],
					"speakerTitle": "忠勝"
				},
				{
					"id": 120240228,
					"content": "ふぅ…やっとこれで適切な解決ができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240229
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 120240229,
					"content": "なんだかまた「エネルギー」が減り始めたような気が…一緒に「秘密基地」へ行って休みませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
