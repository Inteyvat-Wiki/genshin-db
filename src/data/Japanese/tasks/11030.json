			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百暁",
					"百識",
					"百聞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110300101,
					"content": "仕事量が多すぎます。私たち3人もいるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300102
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110300102,
					"content": "彼女は一体どうやってこの量を…「七星」の秘書はやはり只者じゃない。屈辱です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300103
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110300103,
					"content": "あら、あなたたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300104
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300104,
					"content": "おまえら、凝光の手下じゃないか！ここでなにしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300105,
					"content": "コホン…凝光様の秘書です、手下ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300106
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110300106,
					"content": "甘雨様を見かけませんでしたか？旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300107
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300107,
					"content": "もう何日も絶雲の間から帰って来ないんです。彼女は「璃月七星」全体を補佐している秘書で、私たちが今代わりに仕事をしているのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300108,
						110300109
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300108,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300110
					]
				},
				{
					"id": 110300110,
					"content": "前に仙人たちが璃月の罪を問いただしに来た件について、和解はしたものの「七星」は仙人への尊重の意を示したいと考えたのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300111
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110300111,
					"content": "そのため、甘雨様を使者として絶雲の間に、璃月騒動の近況を記した手紙を届けさせているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300112
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110300112,
					"content": "でも…本当なら甘雨様はとっくに帰ってきて仕事をしているはずです。なのに、ずっと戻ってきません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300113
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110300113,
					"content": "なるほど…ついでに観光してるんじゃないのか？たまには息抜きも必要だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300114,
					"content": "それはないでしょう…甘雨様は璃月一の働き者ですから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300115
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300115,
					"content": "毎年の休暇期間ですら、甘雨様は「まだ仕事があるから」と、月海亭に残っているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300116
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300116,
					"content": "そのような方が隙を見てサボるなんて…想像もできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300117
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300117,
					"content": "そうなのか…でも、あいつも半分仙人なんだから、無事じゃないか？おまえら、なにをそんなに慌ててるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300118,
					"content": "そんなの…彼女のこの「ありえない」仕事量に決まってるじゃないですか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300119
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110300119,
					"content": "はぁ…最初は3人もいるのだから、仕事場が変わるだけだと思っていたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300120
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110300120,
					"content": "うん、まさか普段の甘雨様の仕事量が、私たち3人の処理能力を越えていただなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300121,
						110300122
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110300121,
					"content": "さすがは仙人の血だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300125
					]
				},
				{
					"id": 110300125,
					"content": "ところで、旅人さんは絶雲の間に自由に出入りできるそうですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300126
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300126,
					"content": "当然。何回も行ってるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300127,
					"content": "よかった…私たちのかわりに絶雲の間に行って甘雨様を探してきてくれませんか？私たちが倒れてしまう前に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300128,
						110300129
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110300128,
					"content": "仕方ない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300130
					]
				},
				{
					"id": 110300130,
					"content": "ふぅ…助かりました。甘雨様は留雲借風真君の所に向かうと言っていました。まずは、そちらを探してはどうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300131
					],
					"speakerTitle": "百暁"
				},
				{
					"id": 110300131,
					"content": "もう時間です。早く戻って仕事をしなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300132
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300132,
					"content": "いや、先に凝光様に残業代について相談した方がいいのでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百識"
				},
				{
					"id": 110300129,
					"content": "命に関わるからね、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300130
					]
				},
				{
					"id": 110300122,
					"content": "もっと残業した方がいいのでは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300123
					]
				},
				{
					"id": 110300123,
					"content": "もうどれくらい働いたか分かりません…今みたいに小休憩を取ることでさえ罪悪感を覚えます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300124
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110300124,
					"content": "つまり、めちゃくちゃ緊急事態ってことなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300109,
					"content": "彼女はなぜ絶雲の間へ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300110
					]
				}
			]
		},
		{
			"id": 1103002,
			"completionStepIds": [
				1103003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103003",
							"2"
						],
						"stepId": 1103003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"甘雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110300201,
					"content": "ここにいたのか、甘雨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300202,
					"content": "お二方…ここでお会いするとは。何かご用でしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300203
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300203,
					"content": "いえ…私はもう俗世から離れました。璃月港の事務的な話なら、月海亭に相談してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300204,
						110300205
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300204,
					"content": "俗世から離れた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300206
					]
				},
				{
					"id": 110300206,
					"content": "甘雨は「七星」の秘書をやめたのか？あいつらはおまえが帰ってくるのを待ってたぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300207,
					"content": "帰ってきてほしい…それがあなたたちの目的ですか？すみません、それはできません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300208
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300208,
					"content": "なんでだ…一体なにがあったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300209,
					"content": "これが歴史の流れにおける選択です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300210
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300210,
					"content": "この前、仙人たちが璃月港の「監視」役を民に引き渡してから、いつかは私も璃月を離れるのだと悟りました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300211
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300211,
					"content": "仙人の血を持つ私に、璃月港での居場所はありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300212
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300212,
					"content": "手紙を届け璃月に戻った後、私の仕事が百聞、百暁、百識に引き継がれていることを知りました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300213
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300213,
					"content": "今回の仕事は、私を璃月から追い出す口実なのでしょう？「七星」がその機会をくれたのなら、きちんと応えないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300214,
						110300215
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300214,
					"content": "何か…すごく誤解しているようだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300216
					]
				},
				{
					"id": 110300216,
					"content": "二人は優しいのですね。でも、慰めは必要ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300217
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300217,
					"content": "千年振りに絶雲の間に戻り、山の間を流れる雲を眺めていると、心がとても休まるのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300218
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300218,
					"content": "なあ、でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300219,
					"content": "騒いでいるのは誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300220
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300220,
					"content": "あっ…留雲借風真君？すまない、オイラたち…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300221,
					"content": "ハハ、ただの冗談だ。お前達がこの地にやってきたことは既に知っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300222
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300222,
					"content": "おぉ、さすが仙人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300223,
					"content": "甘雨と昔話を語りにきたのか？楽しそうに談笑していたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300224,
						110300225
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300224,
					"content": "昔話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300226
					]
				},
				{
					"id": 110300226,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300227
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300227,
					"content": "おや…そういうわけではなかったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300228
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300228,
					"content": "任せよ、話題探しは妾の得意分野だ。この千年の間、自分と会話することで時間を潰してきたからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300229
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300229,
					"content": "そうだ、甘雨の友人たちに甘雨の子供の頃の話をしてやろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300230
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300230,
					"content": "ちょっと、留雲真君！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300231
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300231,
					"content": "ははは…恥ずかしがるな。お前の可愛い子供時代の話、皆も知りたいだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300232,
						110300233
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300232,
					"content": "確かに…少し気になる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300234
					]
				},
				{
					"id": 110300234,
					"content": "聞きたいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300235,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300236
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300236,
					"content": "はは…小さい頃の甘雨はな、頭の角を撫でられるのが大好きだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300237
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300237,
					"content": "妾が面倒を見ていた時は、いつも角を撫でて寝かしつけていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300238
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300238,
					"content": "へえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300239,
					"content": "…その時の甘雨はコロコロに太っていてな、どれくらいかと言うと、妾と共に山へ登った時、つまづいてコロコロと麓まで落ちてしまったくらいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300240
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300240,
					"content": "ププッ…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300241
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300241,
					"content": "…ある日、甘雨は仙人を訪ねてきた人にぶつかってな。それが初めて生きた人間を見た時だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300242
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300242,
					"content": "まさか、びっくりして岩の隙間に丸二日隠れてしまうとは。妾が見つけた時、泣きながら化け物が出たと言っておった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300243
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300243,
					"content": "あっははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300244,
					"content": "留…雲…真…君！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300245
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300245,
					"content": "…ふぅ、もういいです。そろそろ「修行」の時間ですので、先に失礼します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300246,
						110300247
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300246,
					"content": "甘雨、なんだか怒ってたみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300248
					]
				},
				{
					"id": 110300248,
					"content": "ふむ、お前達の間にあった気まずい空気を和らげようと思ったのだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300249
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300249,
					"content": "おまえのせいで更に気まずくなったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300250
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300250,
					"content": "そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300251
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300251,
					"content": "それよりも、甘雨を探しに来てくれたこと嬉しく思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300252
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300252,
					"content": "このような形であの子が絶雲の間に残る事を、妾はよく思っていない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300253
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300253,
					"content": "あの子に関することを話して聞かせよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300254
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300254,
					"content": "…こうして、妾は偶然にも甘雨の思いを聞いてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300255
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300255,
					"content": "心の悩みとは、己の力で抜け出すのが困難なもの。だから、お前達には傍にいてやってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300256
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300256,
					"content": "ああ、確かにそうだな。一人で落ち込んでても仕方ない。しかも、璃月に捨てられたっていうのも誤解だしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300257
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300257,
					"content": "あっ…そういえば、さっき甘雨が言ってた「修行」ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300258
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300258,
					"content": "あの子は戻ってきてから、ずっと仙人の感覚を取り戻したがっている。だから、妾に修行をしてほしいと願い出てきたのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300259
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300259,
					"content": "今は修行に備えて、奥蔵山の南へ向かっているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300260
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 110300260,
					"content": "分かった。さっそく行ってみるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300247,
					"content": "少しは空気を読まないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300248
					]
