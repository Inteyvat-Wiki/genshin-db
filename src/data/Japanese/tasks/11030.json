			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"甘雨",
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110300601,
					"content": "言いつけられた修行を完了しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300602
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300602,
					"content": "報告は必要ない。他人からの評価とお前の修行は無関係だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300603
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300603,
					"content": "修行の結果は、自分自身で感じろ。それがお前のためにもなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300604
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300604,
					"content": "はい…覚えておきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300605
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300605,
					"content": "魈はなにに対しても独特な考えがあるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300606,
						110300607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300606,
					"content": "もう少しやんわりとした言い方でいいのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300608
					]
				},
				{
					"id": 110300608,
					"content": "明日は更に修行の難易度を上げる。お前は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300609
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300609,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300610
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300610,
					"content": "おまえは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300611,
					"content": "はぁ…厄介なヤツがやって来たな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300612
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300612,
					"content": "あとはお前に任せた、甘雨。これも…ふむ、これも修行の一環だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300613
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300613,
					"content": "厄介な奴？こんな所に魈の頭を悩ませる奴がいるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300614,
					"content": "な…なんと！帝君のご加護の元、ついに仙人と出会えるとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300615
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300615,
					"content": "あなた方はこの山の仙人でしょうか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300616
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300616,
					"content": "よかった、私は辛程と申します。仙人様たち、どうか恋愛運と金運と出世運をお恵みください…お願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300617
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300617,
					"content": "仙人を訪ねてきたやつか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300618,
						110300619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300618,
					"content": "欲がすごい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300621
					]
				},
				{
					"id": 110300621,
					"content": "私も…仙人です。修行中の仙人ではありますが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300622
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300622,
					"content": "よかった！無駄足にならずに済んだ。まだ半人前みたいですが、うーん…問題ないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300623
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300623,
					"content": "では、何を恵んでくれますでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300624
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300624,
					"content": "…うぅ、なかなか失礼なやつだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300625,
					"content": "そこの…訪ね人よ、楽な道を探すのはよくありません。仙人も、無償で全ての訪問者を助けているわけではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300626
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300626,
					"content": "無償？つまり、仙人の恵みには金が必要ってことですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300627
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300627,
					"content": "そういうわけではありません。ただ、何事もそれ相応の努力と真面目な生き方が大切だと伝えたかったのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300628
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300628,
					"content": "何もせずに全てを手に入れるのは、他人に不公平です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300629
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300629,
					"content": "ええ、分かっておりますとも。その話は父さんからも何度も聞かされてますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300630
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300630,
					"content": "それは、あなたの父もその苦労と幸せを過ごしてきたからでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300631
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300631,
					"content": "あなたの歳なら、実体の掴めないものに希望を託すのではなく、仕事と家庭に集中するべきです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300632
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300632,
					"content": "あなた本当に仙人ですか？考えも話し方も俺の住んでいる所の人たちとそっくりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300633
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300633,
					"content": "仙人の振りをして、金を騙し取ろうとしてるんじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300634,
						110300635
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300634,
					"content": "まさかの逆ギレ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300638
					]
				},
				{
					"id": 110300638,
					"content": "ちっ、もういい。本物でも偽物でも、どちらにしろ意味がないなら山を降りる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300639
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300639,
					"content": "ふん、おまえみたいなやつ、さっさとどっか行け！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300640
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300640,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300641
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300641,
					"content": "甘雨、あんな失礼なやつは気にしなくていいんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300642
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300642,
					"content": "いえ…彼の態度ではなく、ただ…彼の話は確かに一理あると感じたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300643
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300643,
					"content": "私は絶雲の間に戻り、精一杯修行に励めば仙人に戻れると思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300644
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300644,
					"content": "さっき彼に質問されても、私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300645,
						110300646
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300645,
					"content": "それなら璃月港に帰ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300647
					]
				},
				{
					"id": 110300647,
					"content": "でも…璃月港はもう私を歓迎していません。仙人として私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300648,
						110300649
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300648,
					"content": "それは誤解だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300650
					]
				},
				{
					"id": 110300650,
					"content": "そうだぞ！こいつの言うことを信じろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300651
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300651,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300652
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300652,
					"content": "分かりました。璃月港に戻ってみます。ただ、私はまだ自分の考えを変えるつもりはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300653
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300653,
					"content": "もし、私の判断に間違いがないと証明されれば、再び絶雲の間に帰ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300654
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300654,
					"content": "やっと一歩進んだぞ…じゃあ、戻るか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300649,
					"content": "#人間である{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}を信じてくれないか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300650
					]
				},
				{
					"id": 110300646,
					"content": "甘雨は人間の方が似合う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300647
					]
				},
				{
					"id": 110300635,
					"content": "いい加減にしてください！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300636
					]
				},
				{
					"id": 110300636,
					"content": "うん…？何だ、突然怒り出して。お前も仙人を訪ねて来たんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300637
					],
					"speakerTitle": "辛程"
				},
				{
					"id": 110300637,
					"content": "言われてみれば、確かに甘雨を訪ねて来たからそうとも言えるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300638
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300619,
					"content": "確かに魈が苦手そうなタイプだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300620
					]
				},
				{
					"id": 110300620,
					"content": "うん、妖魔退治は得意でも、変な人間の退治はな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300607,
					"content": "自分なりの考えを持っていて尊敬する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300608
					]
				}
			]
		},
