					]
				},
				{
					"id": 110300404,
					"content": "仙人になるのは大変だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300405
					]
				},
				{
					"id": 110300405,
					"content": "大変なのは…仙人だけでなく、人も同じでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300406
					],
					"speakerTitle": "甘雨"
				}
			]
		},
		{
