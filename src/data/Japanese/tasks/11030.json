			},
			"dialogs": [
				{
					"id": 110300501,
					"content": "30分遅れたな…人間の悪しき習慣が抜けていないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300502
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300502,
					"content": "すみません、留雲真君のところにいたので…私…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300503
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300503,
					"content": "言い訳も許しを請う必要もない。我はただお前に修行を頼まれただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300504
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300504,
					"content": "先生になった魈は…厳しすぎるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110300505,
					"content": "仙人でも人でもないその身を俗世に置いては、迷いが生じるのも必然だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300506
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300506,
					"content": "修行の前に、お前は自身の内側と向き合った方がいいと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300507
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300507,
					"content": "私は…何も隠していません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300508,
						110300509
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300508,
					"content": "魈は甘雨のことをわかっているようだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300510
					]
				},
				{
					"id": 110300510,
					"content": "肉体と魂は一心同体。魂に迷いが生じている時は、肉体から打開策を見つけるのも一つの手だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300511
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300511,
					"content": "我の修行では、お前の肉体に秘められた潜在能力を探る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110300512
					],
					"speakerTitle": "魈"
				},
				{
					"id": 110300512,
					"content": "はい、準備はできています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110300509,
					"content": "魈はとてもいい先生みたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110300510
					]
				}
			]
		},
		{
