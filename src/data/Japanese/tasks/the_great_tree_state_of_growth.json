			},
			"dialogs": [
				{
					"id": 230290101,
					"content": "そろそろ時間ですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290102,
					"content": "まだ聖樹の根を研究してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "旅人さん、いつもいいところに現れますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290104,
					"content": "この前は本当にありがとうございました。聖樹の状況はとても良好です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290105,
					"content": "ラドプと議論した結果、この良い状況はしばらく続くだろうと結論が出ました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290106,
					"content": "これでやっと私たちも、それぞれの論文のための準備に取り掛かることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290107,
					"content": "ほら、私はファルシから「写真機」を借りて、聖樹の状況を記録しようとしていたところです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290108,
					"content": "旅人さん、あなたは記録地点へ行って、聖樹の全貌を記録してくれませんか。場所は地図に描いておきますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290109,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "自分では行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "ええと、あ…あそこは…高すぎて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290112,
					"content": "私、一人で高いところに立つと怖くなるんです…なんだか風が私を…それか私の原稿を吹き飛ばしてしまいそうで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290113,
					"content": "いつもならファルシが記録に行ってくれるんですが、今日彼は忙しくて、あなたにしか頼めないんです、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤスミン"
				}
			]
		},
