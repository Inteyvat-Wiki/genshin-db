			"dialogs": [
				{
					"id": 230290401,
					"content": "どうですか？聖樹の全貌は記録できましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290402
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290402,
					"content": "記録して来たよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290403
					]
				},
				{
					"id": 230290403,
					"content": "わあ！見せてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290404
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290404,
					"content": "いいですね。角度もいいし、映像もきれいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290405
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290405,
					"content": "これは報酬です。ありがとうございました、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290406
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290406,
					"content": "主幹は大丈夫…周囲の枝の輪郭も変化なし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290407
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230290407,
					"content": "あとはラドプとファルシのデータ収集を待って、次の課題に進みます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤスミン"
				}
			]
