			},
			"dialogs": [
				{
					"id": 790710101,
					"content": "#オルビット城へようこそ。{NICKNAME}さん、パイモンさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710102
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710102,
					"content": "あなたたちのお名前と功績については、同僚から聞いています。まさに勇者の名にふさわしい人物だと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710103
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710103,
					"content": "守衛の訓練を任されていなければ、お二人に手合わせを願いたいところだったのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710104
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710104,
					"content": "王城の守衛なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710105
					]
				},
				{
					"id": 790710105,
					"content": "はい。城主様の命を受け、オルビット城の安寧と平和を守ることが私の仕事です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710106
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710106,
					"content": "具体的には、守衛たちの戦闘力を鍛え、職務を全うできるようサポートしています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710107
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710107,
					"content": "後ろにあるのは訓練場？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710108
					]
				},
				{
					"id": 790710108,
					"content": "ええ、先日改修を終えたばかりでして。入り口が秘境につながっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710109
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710109,
					"content": "訓練場では、特定のリズムに合わせて剣を振らせています。戦闘中は場内の照明環境も変化し続けるんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710110
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710110,
					"content": "厳しいんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710111
					]
				},
				{
					"id": 790710111,
					"content": "リズムに合わせて戦わないといけないなんて、難しそうだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790710112,
					"content": "実は、この訓練方法は『フクロウ楽師』という物語を参考に考案したものなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710113
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710113,
					"content": "その本は守衛の間で大変人気で、物語に夢中になるあまり、訓練のことさえ忘れる者も多々ありました。日ごろの巡回にまで影響が出るほどで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710114
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710114,
					"content": "そこで私はひらめいたのです。物語の要素を訓練に取り入れれば、皆がより訓練に集中できるのでは、と。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710115
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710115,
					"content": "その試みは効果抜群で、少なくとも…個人的な理由で巡回をすっぽかす者はいなくなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710116
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710116,
					"content": "はは…ところで、訓練にご興味は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710117
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710117,
					"content": "あなたたちの武勇をもってすれば、訓練場の各種試練にも難なく対処できるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710118,
						790710120
					],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710118,
					"content": "試してみたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710119
					]
				},
				{
					"id": 790710119,
					"content": "その勇気に敬服いたします。それでは、秘境へお進みください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エロフ"
				},
				{
					"id": 790710120,
					"content": "他に用事がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710121
					]
				},
				{
					"id": 790710121,
					"content": "お気になさらず。もし時間があったらまた来てくださいね。しばらくここで見張りをしていますので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エロフ"
				}
			]
		}
	]
}