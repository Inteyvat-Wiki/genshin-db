					"nextDialogs": [
						721960705
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721960705,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}の相手じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721960706
					]
				},
				{
					"id": 721960706,
					"content": "ははっ、大口ばかり叩く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721960707
					],
					"speakerTitle": "稲葉久蔵"
				},
				{
					"id": 721960707,
					"content": "ヤツらを全員追い払えてから、そのようなことは言うんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721960708
