						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クロリンデ"
				],
				"points": [
					{
						"sceneId": 51204,
						"position": [
							2192.178,
							230.089,
							-778.359
						],
						"pointId": 1
					},
					{
						"sceneId": 51204,
						"position": [
							2194.696,
							230.219,
							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490201,
					"content": "ご注文の「フレイム・キャラメル・ポエム」です。どうぞごゆっくり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490202
					]
				},
				{
					"id": 705490202,
					"content": "なるほど、名前通りの酒だな。色は炎のようで…攻撃的な香りを放っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490203
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490203,
					"content": "ごほっ…少し強すぎたようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490204,
						705490205
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490204,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				},
				{
					"id": 705490206,
					"content": "問題ない、じきに慣れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490207
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490207,
					"content": "記憶によれば、最後に酒を飲んだのは去年ナヴィアに誘われて、ワインの試飲会に行った時だったか。サッシカワインを一口だけ飲んだが、今回ほどの強さではなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490208,
						705490209
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490208,
					"content": "それって飲んでないようなものじゃ！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490210,
					"content": "酒は人を酔わせ、仕事の妨げになる。理性的に考えれば、口にしないほうが賢明だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490211
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490211,
					"content": "だが、港まで見送りに来ていたフリーナ様が、モンドは「美酒と詩の国」だと言っていた。ここまで来たのだから、この土地の特色を味わってみるのも悪くないはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490212,
						705490213
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490212,
					"content": "確かに、試さないのはもったいないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490214,
					"content": "それに、私が収集した情報によると、今回手合わせする予定の遊撃小隊隊長は…かなりの酒通だそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490215
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490215,
					"content": "その隊長が公開を許可している戦況報告は、本当に目を見張るものがあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490216
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490216,
					"content": "それに、以前私と剣を交えたエウルアは…かなりの酒通でな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490217
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490217,
					"content": "フォンテーヌ本土では生産が終了し、海外にしか残っていないロマリタイムフラワーの果汁ジュースを私に贈ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490218
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490218,
					"content": "彼女のような実力者に最大限の敬意を示すためにも、モンドの酒についてもっと理解を深めたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490219,
						705490220
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490219,
					"content": "なら、よく考えてもう一杯作ってみるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490221,
					"content": "心遣い感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490222
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490222,
					"content": "モンド城は見て回ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490223
					]
				},
				{
					"id": 705490223,
					"content": "ああ、モンドに着いた日の午前中に、あちこち見て回った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490224
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490224,
					"content": "ナヴィアの調べでは——「テーブルトークシアター」の背景やイラストの多くは、モンド城の景観を参考にしているそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490225
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490225,
					"content": "だが、台本に描かれた街とモンドの全体的な雰囲気は、やはり大きく異なる。モンド城で私が最も印象に残っているのは、剣と盾の匂いだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490226,
						705490227
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490226,
					"content": "剣と盾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490228,
					"content": "そうだな…私が主に鍛冶屋と訓練場を見て回ったからかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490229
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490229,
					"content": "最近モンドで製造されている武器と鎧には、フォンテーヌのものと全く異なる熱処理が施されていて、表層の炭素含有量が高いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490230
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490230,
					"content": "靭性はやや落ちるが、衝撃への耐性は大幅に上がっている。たとえるなら、煮詰まったコーヒーのような…それに塩を山盛り三杯加えたような匂いだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490231,
						705490232
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490231,
					"content": "全然気づかなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490233,
					"content": "この香りに私は良い第一印象を受けた。フォンテーヌ特有の技法で作られる合金には、マルコット草を含んだ保護剤でメンテナンスを施すことが多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490234
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490234,
					"content": "初めはほのかな香りだが、時が経つにつれて甘い匂いが強くなっていくんだ…歯がうずくほどにな。しかし、モンドの剣と盾から漂う匂いには、そういった煩わしさを感じない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490235,
						705490236
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490235,
					"content": "新しい分野の勉強になった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490237,
					"content": "もちろん、そういった問題にも解決法はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490238
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490238,
					"content": "今度フォンテーヌで会ったら、別の保護剤を紹介してあげよう。水のように軽い質感で、余計な香りもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490239
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490239,
					"content": "いつまでも続く甘い香りが苦手なら、あなたもこの保護剤が気に入るはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490240
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490240,
					"content": "クロリンデは普段何を飲んでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490241
					]
				},
				{
					"id": 705490241,
					"content": "普段か？仕事中ならコーヒーをよく飲むな。食事のときは、薄めのバブルオレンジジュースを飲むことが多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490242
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490242,
					"content": "よく肉料理を食べるので、酸味のあるジュースで油っぽさを和らげるんだ。これを続けているうちに、酸っぱいジュースに慣れてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490243
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490243,
					"content": "今日は剣術交流会の後、親切な騎士たちがモンドの名物料理を振る舞ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490244
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490244,
					"content": "八品の肉料理を食べたが、どれもかなり美味かった。驚くほど量が多いだけでなく、確かな品質の肉が使われていて、火加減も絶妙だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490245
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490245,
					"content": "もちろん、改善の余地はあったがな。ニンジンとお肉のハニーソテーや、お肉ツミツミは…観光客に向けて出す場合、ソースの味を控えめにしたほうがいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490246,
						705490247
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490246,
					"content": "随分と食べたみたいだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490248,
					"content": "肉料理に関しては、そのとおりだ。あの食事だけで三日分の仕事をこなせるカロリーだったので、その後の食事の誘いは全部断った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490249
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490249,
					"content": "とりあえず、油っぽさを消さないと…何か方法があるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490250
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490250,
					"content": "これは騎士たちからの贈り物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490251
					]
				},
				{
					"id": 705490251,
					"content": "ああ、このメダルはコードネーム「ヘーゼル03」と「ヘーゼル05」という騎士からもらったんだ。かなり精巧な作りだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490252
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490252,
					"content": "彼らが言うには、この記念メダルはつい最近完成したばかりで、大切な来客に贈るために作られたものだそうだ。あなた専用のメダルも、今デザインの最中だとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490253,
						705490254
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490253,
					"content": "その二人の騎士については初耳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490255,
					"content": "…そうだな。私もパレ・メルモニアの事務官全員の名前なんて、とても覚えられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490256
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490256,
					"content": "だが、いずれあなたも彼らと知り合うことになるだろう。歴戦の戦士たちだ、一目見れば分かる。それに二人は、事務職でありながら鎧をすべて纏って仕事をしているからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490257
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490257,
					"content": "私の用事を片付けた後、彼らは酒場に集まって、昨夜の酒量対決の続きをすると言っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490258
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490258,
					"content": "前日にビールを一樽空けていたというのに、翌日には平然と仕事をして、しかも隙を見せないとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490259,
						705490260
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490259,
					"content": "モンドの精神は自由だからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490261,
					"content": "つまり、モンドの人々は一見自由奔放に見えて、実は酒の「加減」を的確に心得ているということか。感心させられるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490262
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490262,
					"content": "そういえば、エミリエも来てたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490263
					]
				},
				{
					"id": 705490263,
					"content": "ほう？もう依頼を終わらせたのか。効率がいいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490264
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490264,
					"content": "フォンテーヌに戻ったら、シグウィンさんにもうすぐ新作の香水が出るはずと伝えられそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490265
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490265,
					"content": "え、彼女のことよく知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490266
					]
				},
				{
					"id": 705490266,
					"content": "そこまで親しいわけではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490267
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490267,
					"content": "モンドに来る途中、エミリエさんと偶然同じ船に乗り合わせたから、少し言葉を交わしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490268
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490268,
					"content": "以前から、シグウィンさんが彼女の傑作を褒めているのは知っていたが、今回話をしてみて…彼女がとても珍しい、淡泊かつ優雅な人物だと分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490269,
						705490270
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490269,
					"content": "淡泊かつ優雅？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490271,
					"content": "優しくて落ち着いているけど、あまり人と親しくなり過ぎない…おそらく職業柄だろう。そういう在り方は理想的だと思う。心の平静を長く保っていられるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490272,
						705490273
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490272,
					"content": "よく分からないけど…また今度誘うね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490274,
					"content": "ありがとう。でも、私たちが親睦を深める機会を無理に作る必要はない。仕事上の接点も、人付き合いの範囲も、ほとんど重なっていないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490275
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490275,
					"content": "成り行きに任せておけばいいだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490276
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490276,
					"content": "エミリエはお茶が好みだけど、クロリンデはどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490277
					]
				},
				{
					"id": 705490277,
					"content": "もしかして、私たちをもてなす時のことを、もう細かく考え始めているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490278
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490278,
					"content": "前に試した感じだと、私が飲める酒はエミリエさんと同じくらいだろう。せいぜいフルーツリキュールまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490279
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490279,
					"content": "その時は、私たちに似たような飲み物を用意してくれれば間違いないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490280
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490280,
					"content": "レシピの改良案を思いついたから、ちょっと待ってて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490281
					]
				},
				{
					"id": 705490281,
					"content": "ああ、私も心の準備はできている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490282
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490282,
					"content": "もしその一杯が少し強すぎたとしても、できるだけ飲み干すようにしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490273,
					"content": "フォンテーヌに戻ったら一緒に遊ばない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490270,
					"content": "なんだか難しいこと言うね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490260,
					"content": "仕事終わりに酒を楽しむのが習慣なんだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490254,
					"content": "騎士団って本当にたくさん人がいるんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490247,
					"content": "モンドの肉料理は全部食べてみた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490236,
					"content": "剣の材料ってそんなに奥が深いんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490232,
					"content": "クロリンデはすごい例えをするね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490227,
					"content": "どうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490220,
					"content": "満足のいく一杯になるよう改良してみるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490213,
					"content": "量を控えめにすれば、大丈夫なはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490209,
					"content": "お酒に慣れてないなら、無理しないで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490205,
					"content": "水でも飲む？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				}
			]
		},
		{
			"id": 7054903,
