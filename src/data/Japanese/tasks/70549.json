					}
				]
			},
			"dialogs": [
				{
					"id": 705490301,
					"content": "この新作は…「のんびり雷光」と名付けよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490302
					]
				},
				{
					"id": 705490302,
					"content": "決闘代理人専用のスペシャルカクテルだよ。どうぞ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490303
					]
				},
				{
					"id": 705490303,
					"content": "ふぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490304
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490304,
					"content": "ん？フルーツ風味の酒を使ったのか？良い味わいだ。私にはちょうどいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490305
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490305,
					"content": "スノースタイルによる控えめな塩味、口に含んだ時の果実の酸味、そして優しいキャラメルの甘みが絶妙に混ざり合い、最良のバランスを生んでいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490306
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490306,
					"content": "名前と酒の色もよくマッチしているし、「雷光」という言葉のイメージも「フレイム・キャラメル・ポエム」の炎の要素にぴったりだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490307
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490307,
					"content": "ただ、「のんびり」とはどういうことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490308,
						705490309
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490308,
					"content": "モンドはのんびりしてると思わない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490310
					]
				},
				{
					"id": 705490310,
					"content": "なるほど…確かにこの酒が私に与えた印象にぴったりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490311
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490311,
					"content": "この独特な香りと味わいは、モンドでの旅における最高の思い出として残り続けるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490312,
						705490313
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490312,
					"content": "気に入ってくれてよかった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490314
					]
				},
				{
					"id": 705490314,
					"content": "タイミングが合えば、カフェやホテル・ドゥボールで、もう一度バーテンダーをやってみる気はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490315
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490315,
					"content": "えっ、どうしてそんなことを聞くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490316
					]
				},
				{
					"id": 705490316,
					"content": "また君の傑作を味わいたいというのもあるが、どちらかというとナヴィアやフリーナ様のために聞いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490317,
						705490318
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490317,
					"content": "機会があれば、みんなにも振る舞うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490319
					]
				},
				{
					"id": 705490319,
					"content": "分かった、無理強いはしない…とにかく、もてなしに感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490320
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490320,
					"content": "今なら、手練れの遊撃小隊隊長との手合わせも、騎士たちとの戦術体系に関する交流も…万全の状態で臨めそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490321
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490321,
					"content": "今なら、エウルアとの手合わせに関する総括も、騎士たちとの戦術体系に関する交流も…万全の状態で臨めそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490318,
					"content": "タイミングが合えばやってみるよ。",
					"roleType": "TALK_ROLE_PLAYER",
