							2194.696,
							230.219,
							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490101,
					"content": "ああ、やはりそうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490102
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490102,
					"content": "近くを歩いていたら、馴染みのある気配がしたので寄ってみたのだが、やはりあなただったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490103,
						705490104
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490103,
					"content": "こんにちは、クロリンデ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				},
				{
					"id": 705490105,
					"content": "シャルロットさんがこの光景を見たら、きっと何百枚も写真を連写して、こんな記事を書くだろうな——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490106
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490106,
					"content": "#『輝かしき剣士・{NICKNAME}のアルバイト生活——千金に値する一杯』…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490107
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490107,
					"content": "翌日には新聞各紙のトップを飾ることになるはずだ。そして、噂を聞きつけた観光客が大勢フォンテーヌからやって来て、ここは身動きが取れないほど、人で溢れかえることになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490108,
						705490109
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490108,
					"content": "想像したら、すごい状況だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490110,
					"content": "幸いなことに、今回はシャルロットさんの同行の申し出を断ったから、そんな事態にはならないはずだ。この静かなひとときを密かに祝おうじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490111
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490111,
					"content": "話を戻そう——「フレイム・キャラメル・ポエム」を一杯もらおうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490112
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490112,
					"content": "…表情を見るに、まだ私に聞きたいことがありそうだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490113,
						705490114
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490113,
					"content": "まずはお酒を作るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490115,
					"content": "落ち着いていて、余裕が感じられる。この仕事に慣れているようだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 705490114,
					"content": "飲みながら話そう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490109,
					"content": "そうなったら、手に負えないよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490104,
					"content": "どうぞ座って、お客さん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				}
			]
		},
		{
			"id": 7054902,
			"completionStepIds": [
				7054906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
