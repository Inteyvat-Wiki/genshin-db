			"dialogs": [
				{
					"id": 741210801,
					"content": "自由！ああ、甘美な自由！ローストチキンほどじゃないが、それでも甘美だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210802
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210802,
					"content": "…えっと、その手に持っている札は、一体どういう意味なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210803,
					"content": "ん？ああ、これは「抗議」って意味さ、",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210804
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210804,
					"content": "何に対して？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210805
					]
				},
				{
					"id": 741210805,
					"content": "うーん、なんと言うか…あいつら——俺を地に埋めたやつら。あいつらは俺が頑張って働くのを望まないようだから、抗議してるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210806
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210806,
					"content": "いやいや、なんでおまえの努力を望まないやつがいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210807,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210808
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210808,
					"content": "秘密を守れるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210809
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210809,
					"content": "おう、もちろんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210810,
					"content": "じゃあ僕も秘密を守っておくよ。これは確かに言いにくいことだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210811
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210811,
					"content": "なんだよ！もう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210812,
					"content": "やっぱり他の話をしよう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210813
					]
				},
				{
					"id": 741210813,
					"content": "そうだな…じゃあ、そのバケツはなんだ？バケツを身に着けるのも、抗議活動のうちなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210814,
					"content": "えっ？それはどうだろう…あいつらが僕を埋める前に、胸元にバケツをかぶせて行ったんだ。本当に悪趣味だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210815
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210815,
					"content": "じゃあ、おまえはどうしてやつらに埋められたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210816
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210816,
					"content": "あいつらがすごく悪いやつだからだ！理由もなく捕まえて土の中に埋めやがって！あいつら、僕を餓死させるつもりなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210817
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210817,
					"content": "本当に理由はないの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210818
					]
				},
				{
					"id": 741210818,
					"content": "そ、そうだ！ほら、実際僕は土に埋められてたじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210819
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210819,
					"content": "僕の命が欲しいんじゃなかったら、どうして土に埋めるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210820
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210820,
					"content": "#うーん、こいつの言うことも一理あるような…{NICKNAME}、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
