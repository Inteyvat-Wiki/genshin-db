				},
				{
					"id": 741210304,
					"content": "おい！無視するなよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210305,
					"content": "…こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210306
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210306,
					"content": "いい天気だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210307
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210307,
					"content": "あの人について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210308
					]
				},
				{
					"id": 741210308,
					"content": "どの人だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210309
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210309,
					"content": "誰のことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210310
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210310,
					"content": "俺たちは、ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210311
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210311,
					"content": "ここを散歩してるだけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210312
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210312,
					"content": "そう、散歩しているだけ。二人で散歩しているだけの一般人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210313
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210313,
					"content": "天気がいいし、散歩は素晴らしい。そう思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210314
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210314,
					"content": "散歩はとても正常なことだ。そう思うだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210315
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210315,
					"content": "えっ、おまえたち…何を言ってるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210316,
					"content": "さっき助けを求める声が聞こえなかったのか？あそこに土に埋まってる人がいて、カニに食べられちゃうところだったんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210317,
					"content": "そんなことがあったのか？俺たちの散歩してるところで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210318
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210318,
					"content": "こんなにいい天気なのにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210319
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210319,
					"content": "もし彼がカニに食べられてしまったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210320
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210320,
					"content": "そりゃ面白い…あ、いやいや、可哀想すぎるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210321
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210321,
					"content": "残念だが、俺たちはそんなことはさせられない。いや、させてはいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210322
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210322,
					"content": "そうそう、散歩している時にそんな場面に遭遇したら、必ず阻止するさ。いや、もしもの話だけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210323
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210323,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210324
					]
				},
				{
					"id": 741210324,
					"content": "散歩だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210325
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210325,
					"content": "言っただろ？散歩だって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210326
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210326,
					"content": "本当になんにも気づかなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210327,
					"content": "何も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210328
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210328,
					"content": "ああ。俺たちの散歩を邪魔するやつが二人いること以外はまったく気づかなかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210329
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210329,
					"content": "散歩はとても…プライベートなことだ。人に邪魔されるのは好きじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210330
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210330,
					"content": "あんたらも良いところを見つけて、散歩してみたらどうだ。例えば、ルキナの泉は良いところだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210331
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210331,
					"content": "でもここは俺たちが散歩するところだ。いや、大自然を感じるところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210332
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210332,
					"content": "だから人に邪魔されたくないってこった…あばよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ターナー"
				}
			]
		},
