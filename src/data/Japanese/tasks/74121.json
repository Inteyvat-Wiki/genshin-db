			"dialogs": [
				{
					"id": 741210601,
					"content": "ふん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210602
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210602,
					"content": "ぐはぁ…僕は何も…これは僕の最新の美容法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210603,
					"content": "うわっ！おまえら、いつの間に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210604,
					"content": "俺たちは散歩してる。散歩はある種の…運動だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210605,
					"content": "運動は、移動をもたらす。移動が、俺たちをここにもたらしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210606,
					"content": "#{M#君}{F#あなた}たちがやったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "そうだとしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210608,
					"content": "待てハンター、思い出したぞ。こいつをよく見ろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210609,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210610,
					"content": "あの人が言っていた、絶対に手を出していけない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210611,
					"content": "そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210612,
					"content": "なんの話をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210613,
					"content": "何も。俺たちは散歩しているだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210614,
					"content": "そう。俺たちは散歩してるだけ。他に何もないなら、これで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210615,
					"content": "これで。他のところへ引き続き散歩に行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210616,
					"content": "え？君たち、僕に何か怖いことをしていかなくていいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210617,
					"content": "もう十分教訓になっただろう。俺の言ってる意味は理解できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210618,
					"content": "教訓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "いや、その…ローストチキンは危ない。厄介なものを引き寄せるからな。これを貴重な教訓にするんだ。じゃあな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210620,
					"content": "でも、ローストチキン…あれはドゥボールの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "ハンター"
				},
				{
					"id": 741210621,
					"content": "ローストチキンはもう良いから！散歩を続けようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "ターナー"
				},
				{
					"id": 741210622,
					"content": "「今度はソニィ兄貴にローストチキンをおごってもらおう！」\\nターナーはそう言いながら、ハンターを連れて去っていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "ありがとう！ありがとう！君たちなら僕をわかってくれるって思ってたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210624,
					"content": "#どうやら本当に{NICKNAME}が言ってた通りみたいだな…アンリを掘り出そう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210625,
					"content": "でも、それには体力が必要だからな。ローストチキンはオイラのもんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210626,
					"content": "ええ？くそっ、仕方ない、それでいいさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210627,
					"content": "少し時間がかかったが、アンリを無事砂から掘り出した。そして、なぜか彼の身にかぶせられていたバケツを取ってあげた。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "パイモンと一緒に美味しいローストチキンにかぶりついた。\\nアンリは食べたそうにしていたが、約束とプライドを守り、何も言わないでいた。\\nでも、そんなアンリの様子を見て、パイモンは自分から彼にローストチキンを分け与えてあげた。\\n外の皮はカリカリしていて、脂の香ばしい匂いがする…すごく美味しい！",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
