			"dialogs": [
				{
					"id": 741210101,
					"content": "ありがとう！本当にありがとう！君たちは命の恩人だ。この恩は永遠に忘れないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210102
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210102,
					"content": "それよりも、なんでこんな状況に陥ったのかが気になるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210103,
					"content": "はぁ…あのカニはきっと、ローストチキンの香りに引き寄せられて来たんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210104
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210104,
					"content": "オイラもローストチキンの香りに誘われてきたけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210105,
					"content": "カニは君とは違う！やつらは僕を先に食べるかローストチキンを先に食べるか考えてたんだろう。もしやつらが新鮮なほうを食べたいってなったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210106,
						741210109
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210106,
					"content": "うん、新鮮な方がいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210107
					]
				},
				{
					"id": 741210107,
					"content": "おい、そうじゃなくてオイラが聞いてるのはアンリ自身のことだぞ！普通のやつは土に埋もれたりしないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210108,
					"content": "それで、手伝ってほしいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210111,
					"content": "もちろん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210112
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210112,
					"content": "ええと、もちろん必要ない！！僕を掘り出してくれる必要はないぞ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210113
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210113,
					"content": "#うわっ、分かった分かった、そんなに大声で言わなくても、オイラたち聞こえてるぞ。じゃあ行こうぜ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210114,
					"content": "待て！ちょっと待ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210115
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210115,
					"content": "ん？どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210116,
					"content": "僕は…えっと、コホンッ！よく聞いてくれ！！これは新しく発明した美容方法なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210117
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210117,
					"content": "もう、だから叫ばなくていいって言ってるだろ！うるさいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210118,
					"content": "二人とも疑わないでくれ！！僕は賢く、かつ正気だ。この科学的で健康的な美容法を自分で選び！自分の力で、自分を湿った土の中に埋めたんだ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210119
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210119,
					"content": "早くここを離れろ！！僕の太陽の光を遮るな！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210120
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210120,
					"content": "お、おう。じゃあ行こうぜ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210121,
					"content": "興味があるなら、仕方ない！！じゃあ、この美容法の面白いところを教えてあげよう！！えっと、砂の中にいるゴカイなどの動物は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210122
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210122,
					"content": "#（うわぁ、うるさいやつだな。{NICKNAME}、こいつは一体何なんだ？言ってることも支離滅裂だぞ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210123,
					"content": "（何だかうさんくさい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210124
					]
				},
				{
					"id": 741210124,
					"content": "（だよな。どうする？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210125,
					"content": "（まずは周りの様子を見てみよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210126
					]
				},
				{
					"id": 741210126,
					"content": "えっ、もう行っちゃうのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210127
					],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210127,
					"content": "周りの状況を確認してから、またおまえのところに戻ってくるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741210128,
					"content": "ああ！！早く行ってくれ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンリ"
				},
				{
					"id": 741210109,
					"content": "どうして土に埋まってるの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210110
					]
				},
				{
					"id": 741210110,
					"content": "そうだぞ！手伝いはいるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "パイモン"
				}
			]
		},
