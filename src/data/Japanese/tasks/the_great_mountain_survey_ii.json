			"trigger": {
				"objectNames": [
					"アイスター"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080301,
					"content": "ビーコンを設置してくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701080302,
					"content": "置いたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "よかった、ありがとう。これで雪山の高さを観測できるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701080304,
					"content": "あ、そうだ。君への報酬はサイリュスさんに用意してもらったよ。城内に取りに行ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701080305,
					"content": "それと、ついでにこの手紙をサイリュスさんに渡してくれないかな。雪山に入る探検隊がいたら知らせてくれる約束をしてくれたんだけど、何も連絡がないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "アイスター"
				},
				{
					"id": 701080306,
					"content": "壊れたビーコンを修理したら、設置するためにもう一回雪山に入らなきゃ。雪山で観測しなければいけないものは、まだたくさんあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイスター"
				}
			]
		},
		{
			"id": 7010804,
			"completionStepIds": [
				7010805
			],
