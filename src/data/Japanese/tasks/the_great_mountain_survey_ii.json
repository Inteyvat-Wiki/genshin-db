				"objectNames": [
					"サイリュス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "やあ、何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 701080402,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}宛ての手紙がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "手紙？あぁ…彼女からか。さては、探検隊についてのことだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 701080404,
					"content": "はあ、俺にはどうしようもできないさ。今、危険な雪山に行きたがる探検隊は少ないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 701080405,
					"content": "あとで返信を書いて、状況を説明する。届けてくれてありがとうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 701080406,
					"content": "おっと、この前の手紙で君に報酬を準備するように言われていたんだ。受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 701080407,
					"content": "それと…腕が立つ君には余計な忠告かもしれないが、雪山で探索する時は気を付けろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 701080410,
					"content": "はあ、雪山…機会があれば、俺も自ら探検隊を率いて登ってみたいものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイリュス"
				}
			]
		},
