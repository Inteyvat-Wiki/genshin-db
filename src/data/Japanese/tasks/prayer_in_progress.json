					"麻紀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110201,
					"content": "もう片付けが終わったのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110202,
					"content": "終わった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "ありがとうございます。そのおみくじは私の方でお預かりし、正しい場所で保管します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110204,
					"content": "これを受け取ってください。手伝ってくれてありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110205,
					"content": "凶運を断ち切りたい、または幸運に訪れてほしいという気持ちは分からなくはないのですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110206,
					"content": "しかし…本当に目の前のある問題を解決したいのであれば、おみくじに頼るだけではなく、自分から行動を起こすことが大切だと、私は思うのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110207,
					"content": "自ら行動することを拒むのであれば、神様が助けると言って下さっても、道は開かれませんよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麻紀"
				}
			]
		},
