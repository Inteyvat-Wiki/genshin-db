				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麻紀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "困りました…いったい誰がこのような噂を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110102,
					"content": "どんな噂？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "神社のおみくじに関することです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110104,
					"content": "「おみくじを引く」という言葉の意味をご存じでしょうか？簡単に言えば、おみくじを通して吉凶を占う行為のことを言います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110105,
					"content": "おみくじに書かれた内容によって、人々は未来に関する簡単な予言を知ることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110106,
					"content": "いい内容のくじを引いた場合は問題ありませんが、悪いくじを引いた場合は、神社に結び、凶をその場に留めるようお願いするのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110107,
					"content": "しかし…誰が言い出したのかは分かりませんが…悪い内容のくじを木の上に放ってやれば、神様が優先的に厄払いをしてくれる、という噂が流れているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110108,
					"content": "しかも、放った場所が高ければ高いほど、すぐに幸運が訪れ、凶運が消え去るのだとか…全くもって根拠のないふざけた事を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110109,
					"content": "その後、噂はどんどん広まり、今度はおみくじだけではなく、木に向かってモラを投げる人まで出てきたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110110,
					"content": "そして、投げたモラが木の頂上に止まれば、神様が答えてくれるのだとか。願いが叶うだけでなく、一年中の幸運をもたらしてくれると噂されているのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110111,
					"content": "本当にそうなるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "あり得ません！神様が答えてくれるかどうかは別として…モラを投げるだなんてとんでもない。モラって全部同じ見た目をしていますよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110113,
					"content": "神様にモラを一枚ずつ拾って、判別してもらうつもりなのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110116,
					"content": "幸運を求める気持ちは分かりますが、そうやって上に物を投げても、祝福には繋がりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110117,
					"content": "それに、放られたおみくじなどは、風に吹かれてあちこちに落ちてしまっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110118,
					"content": "私も片付けようとしましたが、運動が苦手で…片付けられないばかりか、どうやって降りればいいのかもわからず、苦労しました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110119,
					"content": "しかし、放っておくわけにはいきません…旅人、屋根に登って、掃除を手伝ってくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110120,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "ではこの件は旅人、あなたにお願いします。もしおみくじを見つけた場合、集めて私に渡してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110122,
					"content": "集めたおみくじはどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "蛍美さんによれば、おみくじは…皆様が引いた「運気」なんだそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110124,
					"content": "勝手に捨てるのは不謹慎なので、集めた後は、規則に従ってあるべき場所に保管するつもりです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110125,
					"content": "はぁ、もし皆様が最初からルールを守っていれば、こんな面倒なことにはならなかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110126,
					"content": "ではこの件は旅人、あなたにお願いします。もしおみくじを見つけた場合、集めて私に渡してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麻紀"
				},
				{
					"id": 220110114,
					"content": "しっかりと説明したら？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "そのような人が多すぎて、私一人では説明が追いつかないのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "麻紀"
				}
			]
		},
		{
			"id": 2201102,
			"completionStepIds": [
				2201105
