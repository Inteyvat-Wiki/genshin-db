					"nextDialogs": [
						411111619
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 411111619,
					"content": "<color=#00E1FFFF>裏山</color>にも<color=#00E1FFFF>隕石</color>があってな、<color=#00E1FFFF>エレン</color>のやつがひとりで見に行ってしまったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111620
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 411111620,
					"content": "お前たちも隕石の危険性を知ってるだろ。何か起きる前に、一緒にあいつを探してほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111621
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 411111621,
					"content": "エレンのやつ、こんな時に心配かけさせるなよ！",
