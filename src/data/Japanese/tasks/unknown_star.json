					"nextDialogs": [
						411111409
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411111409,
					"content": "そういえばさ、夢の中でなにを見たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411111410,
					"content": "寒い中、山道を歩いてたとしか…たぶん<color=#00E1FFFF>雪山</color>だと思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111411
					],
					"speakerTitle": "ハルトマン"
				},
				{
					"id": 411111411,
					"content": "山道…？目的とかは？",
