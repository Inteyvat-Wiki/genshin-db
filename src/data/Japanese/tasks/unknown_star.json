					"nextDialogs": [
						411111414
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411111414,
					"content": "（呪い？本当にそうなのだろうか？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111415
					]
				},
				{
					"id": 411111415,
					"content": "とにかく、隕石を片付けるやり方はいける。あとは効率の問題だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
