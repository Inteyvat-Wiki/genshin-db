			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "旅人さん、ちょうどよかったです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110102,
					"content": "キャサリン、なにかあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110103,
					"content": "はい、旅人さんたちにご協力いただきたい大事件が起きてしまったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110104,
					"content": "これは緊急任務となります、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110142,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110105,
					"content": "うわっ…大変なことになってるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110106,
					"content": "我々にとってこういった状況は初めてです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110107,
					"content": "そのため協会は多忙を極めており、それゆえ皆さんの協力が必要なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110108,
					"content": "もちろん協力する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "お待ちください、念のため…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110111,
					"content": "キャサリン！幽夜浄土の民よ、わたくしの名を呼んだのはあなたかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110112,
					"content": "あっ、来てくれたんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110113,
					"content": "またお会いましたね、キャサリン様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110114,
					"content": "わっ！この鴉、話せるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110115,
					"content": "ハハッ、驚く必要はありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110116,
					"content": "我が臣属よ、そのように顔を曇らせているのは、モンドの平和を脅かす罪深きものがまた現れたからかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110117,
					"content": "旅人さん、こちらは冒険者協会モンド支部のメンバー、フィッシュルさんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110118,
					"content": "フィッシュルさん、オズさん、こちらが例の旅人さんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110119,
					"content": "ふーん？あなたがね？ふむ…いい目をしているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110120,
					"content": "西風騎士団の栄誉騎士様とその仲間のパイモン様。お会いできて光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110121,
					"content": "旅人、あなたも深き闇の結晶に裁きを下すつもりなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110122,
					"content": "…えっ、闇？闇に裁きを下す？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110123,
					"content": "キャサリン、話が違う気がする。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "<color=#00E1FFFF>隕石</color>、という意味です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110126,
					"content": "流星群の原因とその影響がまだ判明していないので、皆さんには2人1組で行動していただきたいのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110127,
					"content": "旅人さん、フィッシュルさん、身の安全を優先しつつ支え合いながら行動してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110128,
					"content": "フン、それがキャサリンの願いなら、聞いてあげなくもないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110129,
					"content": "喜びなさい！この断罪の皇女フィッシュルと共に旅できること光栄に思うことね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110130,
					"content": "こちらは我が主、異界·幽夜浄土の皇女フィッシュル様。私はその眷属の鴉、オズでございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110131,
					"content": "な、なんかすごそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110132,
					"content": "#オイラはパイモン、こいつは{NICKNAME}、よろしくな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110133,
					"content": "今、異界って言った？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "徐々に分かってくると思います…フィッシュルさんと一緒にいれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 411110136,
					"content": "旅人のあなたが幽夜浄土のすごさを知らないのは想定の内だし、許してあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110137,
					"content": "許す？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110138,
					"content": "「よろしく」と言う意味です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110139,
					"content": "さっきから漫才してるみたいだな、この2人…ボケる主人とツッコむ眷属、おかしいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110140,
					"content": "聞きたいことがあるようですね、歩きながら話しましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110141,
					"content": "これ、2人1組じゃなくて4人1組だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110134,
					"content": "幽夜浄土…初めて聞いた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110109,
					"content": "教えてくれてありがとう、すぐ動く。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				}
			]
		},
		{
			"id": 4111105,
			"completionStepIds": [
				4111105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111105",
							"2"
						],
						"stepId": 4111105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィッシュル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110501,
					"content": "ここがキャサリンが言ってた事件現場、清泉町だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110502,
					"content": "どうやら想定よりもひどいようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110503
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110503,
					"content": "倒れている人がたくさんいる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110504
					]
				},
				{
					"id": 411110504,
					"content": "祝福の鐘が鳴り、断罪の時が来た！崇めなさい、「断罪の皇女」がここに降臨したわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110505
					],
					"speakerTitle": "フィッシュル"
