					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111407
					]
				},
				{
					"id": 411111407,
					"content": "ええ、いいお知らせですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111408
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411111408,
					"content": "フン、この皇女が手を貸したんだから、これくらいの結果がないとね！",
