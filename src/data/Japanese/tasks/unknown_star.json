					"nextDialogs": [
						411111616
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411111616,
					"content": "邪魔してすまないが、少し時間あるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111617
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 411111617,
					"content": "ドゥラフだ！なにかあったのか？",
