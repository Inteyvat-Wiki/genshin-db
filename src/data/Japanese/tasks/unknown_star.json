				"points": []
			},
			"dialogs": [
				{
					"id": 411111701,
					"content": "あー、死ぬかと思った！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111702
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 411111702,
					"content": "エレン！もう二度と迷惑かけるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111703
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 411111703,
					"content": "ごめんなさい、もう二度と勝手な行動はしないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111704
					],
					"speakerTitle": "エレン"
				},
				{
					"id": 411111704,
					"content": "迷惑かけてすまなかったな、あとでちゃんと説教しとくから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111705
					],
					"speakerTitle": "ドゥラフ"
				},
				{
					"id": 411111705,
					"content": "ちゃんと言うことを聞けよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411111706,
					"content": "あそこに隕石がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111707
					]
				},
				{
					"id": 411111707,
					"content": "何なんだろうな…ん？皇女、その<color=#00E1FFFF>神の目</color><color=#00E1FFFF>光ってる</color>ぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411111708,
					"content": "この幽邃な秘珠に込められた力が運命の挽歌を奏でていることに、こうも早く気づくとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111709
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411111709,
					"content": "うん？神の目ってなにかに反応するものなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411111710,
					"content": "世界の幽邃、群星の囁き。魔骸の呪い、それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111711
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411111711,
					"content": "あー、もう！分かりづらいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411111712,
					"content": "失礼しました。お嬢様は俗世の言葉に詳しくありませんので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111713
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411111713,
					"content": "だから通訳が必要なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411111714,
					"content": "私は通訳ではなく、お嬢様の意志を代わりに伝えているだけです。ちなみに、<color=#00E1FFFF>神の目</color>に影響を与えられるのは<color=#00E1FFFF>元素力</color>だけかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111715
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411111715,
					"content": "うむ、よくやったわ、オズ。俗世に目を塞がれた者は、いつもわたくしの真意を理解できないのだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111716
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411111716,
					"content": "隕石に元素力があるのか？神の目が光るのは、その呼びかけに答えてるから？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111717,
						411111718
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411111717,
					"content": "神の目で元素力を探せないだろうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				},
				{
					"id": 411111719,
					"content": "う～ん、できるんじゃないか？とりあえず、<color=#00E1FFFF>神の目</color>で<color=#00E1FFFF>隕石の欠片</color>を探せないか、やってみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411111718,
					"content": "その呼びかけはこっちからも可能？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				}
			]
		},
