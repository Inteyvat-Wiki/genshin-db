			"dialogs": [
				{
					"id": 411110601,
					"content": "凡人、無礼を許してあげるから詳細を報告しなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110602
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110602,
					"content": "えっと、誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110603
					],
					"speakerTitle": "ジョイス"
				},
				{
					"id": 411110603,
					"content": "突然すみません、患者に関する情報をお聞きしたいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110604
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110604,
					"content": "ああ、オイラたちは冒険者協会のメンバーで調査の依頼を受けてきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110605,
					"content": "ああ、そうなのか。昨日の夜、この人が隕石に触った瞬間、気を失ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110606
					],
					"speakerTitle": "ジョイス"
				},
				{
					"id": 411110606,
					"content": "君たちも隕石に触れないよう気を付けた方がいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110607
					],
					"speakerTitle": "ジョイス"
				},
				{
					"id": 411110607,
					"content": "無用の忠告ね。わたくしには秘珠の加護があるの、黒い結晶なんて怖くないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110608
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110608,
					"content": "お嬢様、皇女たる者、臣下の諫言は聞くべきかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110609
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 411110609,
					"content": "仕方ないわ…従ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110610
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110610,
					"content": "お、おまえも冒険者たるもの、忠告は聞いておくべきかと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110611,
					"content": "わ、わかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110612
					]
				},
				{
					"id": 411110612,
					"content": "たまにはこういう口調も悪くないもんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 411110613,
					"content": "わたくしたちの真似かしら？フン、千の世界の悲願をそう易々と理解できるわけないわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110614
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110614,
					"content": "まあ、いい。あなたにとって、「断罪の皇女」の運命は重すぎるものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110615
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 411110615,
					"content": "は、はい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
