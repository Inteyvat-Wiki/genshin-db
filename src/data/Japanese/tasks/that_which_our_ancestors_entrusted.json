				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "今日の海祇島は南風が吹いていますので、お友達の訪問を予想していました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610102,
					"content": "#おまえがそんなことを言うたびに、オイラと{NICKNAME}は一日中走り回らなければならないんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400610103,
					"content": "そんなこと言わないでくださいよ。私たち、親友ですよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610104,
					"content": "ただ、実は今日お願いしたいことがあります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610105,
					"content": "伝説によると、私の祖先は珊瑚宮の海祇御霊祭にもう一つの試練を加えたと言われています。それは、海祇の存続とは関係なく、真実に関わることです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610106,
					"content": "もう一つの…試練？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400610107,
					"content": "海祇島存続の危機がなくなった、私は先祖代々から受け継がれた義務と責任から、このこと伝えます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610108,
					"content": "「蛇心の地」と呼ばれる場所に行ってみてください。そこには、試練の第二の手がかりが隠されています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610109,
					"content": "これで安心しました。この重責を未来の娘に引き継がせることができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610110,
					"content": "その一言が、先祖代々から受け継がれた任務なのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400610111,
					"content": "…オイラ、未だに露子の考えに追いつかないんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}