					}
				]
			},
			"dialogs": [
				{
					"id": 745090101,
					"content": "しばらくして、パイモンと一緒に「ちびチエキノコン大合戦」の開催場所にやってきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745090102
					]
				},
				{
					"id": 745090102,
					"content": "やっほー！「才知と勇猛の双子星」、あなたたちったらまた「ちびチエキノコン大合戦」をしに来たんですか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090103
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090103,
					"content": "アンジェニーナさんは任務があるようで、先に執律庭へ帰りましたよ。この先は私がお付き合いいたしますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090104
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090104,
					"content": "左右加さん、おかえり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745090105,
					"content": "ハニヤーに会ったとき、ずいぶん面食らったけど、左右加さんもド派手だな。その服は…元気いっぱいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745090106,
					"content": "元気があるのはいいことですよ。仕事はまだまだたくさん残ってますからね。すぐエネルギー切れになるわけにはいかないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090107
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090107,
					"content": "斧を振るうように、難題を一つ一つ切り捨てるんです。えへへっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090108,
						745090109
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090108,
					"content": "新聞社の件は忙しい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				},
				{
					"id": 745090110,
					"content": "計画は着々と進んでます。こんな目新しいイベントは結構注目されるんです。新聞社も大々的な宣伝チャンスを逃すまいとしてますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090111
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090111,
					"content": "新聞の一面は逃しましたけど、最近イベントの人気が右肩上がりなのは一目瞭然です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090112
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090112,
					"content": "それは確かね。最近、「ちびチエキノコン大合戦」を遊ぶためにここを訪れる一般市民が増え続けているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090113
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745090113,
					"content": "「ちびチエキノコン」をどんな編成にすれば効率よく勝てるかについて、議論し始めた人も多いのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090114
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745090114,
					"content": "しかも、「ゴールド流星」と「シルバー伴星」を捜してる人もいるって話も聞いたわ。あなたたちと一戦交えて、達人のお手並みを拝見したいみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090115,
						745090116
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745090115,
					"content": "ははっ！達人は闇雲に手を出さないよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090117,
					"content": "ハニヤーと左右加さんが挑んでくるってんなら話は別だけどな。おまえらは昔なじみだし、オイラたちの戦略をよく理解してんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745090118,
					"content": "おまえらとの対戦こそ…テクニックが一番試されると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745090119,
					"content": "そこまで言うなら…私たちで戦ってみるべきですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090120
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090120,
					"content": "よく考えれば、前回直接戦ったのは第一回「サウマラタ蓮杯テイマー大会」のときでしたね。私はちょちょいのちょいで叩きのめされたんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090121
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090121,
					"content": "ちょっと懐かしいですね…あの後、私とハニヤーには色々ありましたし、変わったこともたくさんあります。あなたたちもきっとそうでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090122
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090122,
					"content": "でも二人が持つ…凛とした勇気と恐れ知らずの豪気は、今も変わらず水晶のように美しく頑丈です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090123
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090123,
					"content": "思えば、「チエキノコン布陣」を準備した後に、あなたたちと組むと決めた私たちの目利きは大正解だったと言えますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090124
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090124,
					"content": "左右加さん…急にしみじみしちゃってるぜ。これが…作家特有の職業病ってやつなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090125,
						745090126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745090125,
					"content": "#{M#俺}{F#私}も懐かしいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090127,
					"content": "そうですね！なんて素敵なセリフでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090128
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090128,
					"content": "それでは期待してますよ。こっちはゲームデザイナーの一人として、とっても強力な切り札を用意してるんですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090129
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090129,
					"content": "左右加、あれを使うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090130
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745090130,
					"content": "そうです。私が盛り上げ、ハニヤーが強靭な敵を指揮します。そうしてあなたたちともう一度、骨のある戦いを繰り広げるのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090131
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 745090131,
					"content": "それじゃ、よろしく頼むわよ。「ゴールド流星」に「シルバー伴星」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090132,
						745090133
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745090132,
					"content": "任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090134,
					"content": "#ずいぶんと久々だよな。こうして{NICKNAME}がまたハニヤーと勝負するって考えたら…オイラも気分が上がってきたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745090135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745090135,
					"content": "でも、今回は純粋なお遊びの勝負だ。楽しまないとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745090133,
					"content": "さあ、始めよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090134
					]
				},
				{
					"id": 745090126,
					"content": "これからも新しい思い出を作ろう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090127
					]
				},
				{
					"id": 745090116,
					"content": "へぇー…わざわざ自分から負けに行くんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090117
					]
				},
				{
					"id": 745090109,
					"content": "イベントの広告は順調？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745090110
					]
				}
			]
		}
	]
}