					"speakerTitle": "パイモン"
				},
				{
					"id": 730152102,
					"content": "パイモンは怖くないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152103
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730152103,
					"content": "オイラか？怖くないに決まってるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
