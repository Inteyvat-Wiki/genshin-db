						730150909
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150909,
					"content": "悪い種を掃除に来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150910
					]
				},
				{
					"id": 730150910,
					"content": "#アランナクラ、大丈夫だって。このくらいのこと、ナラ{NICKNAME}には楽勝なんだぞ！",
