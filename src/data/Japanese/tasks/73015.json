			"dialogs": [
				{
					"id": 730151101,
					"content": "#わぁ！ありがとう、ナラ{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151102
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151102,
					"content": "ヴァーナは、ナラヴァルナが来てからのことを全部覚えてる。大木も、種も覚えてる。でもナラヴァルナが分かってるかどうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151103
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151103,
					"content": "だから目に見える記憶を残した。そうすればナラヴァルナがヴァーナに戻ったとき、分かる。ヴァーナは忘れてない、アランナラも忘れてないって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151104
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151104,
					"content": "なるほど…「石の記憶」は記念碑なんだな。人が記念碑を建てるのも、忘れないためだもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151105,
					"content": "ナラは忘れっぽい生き物だからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151106
					]
				},
				{
					"id": 730151106,
					"content": "…森と比べたら、ナラは小さな苗みたいなもんだな。天を衝くような大木にはなれないし、記憶を刻む年輪もない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151107,
					"content": "アランナラはヴァーナを離れない。アランナラはヴァーナとずっと一緒。でもナラは来ても、また去っていく。ナラヴァルナみたいに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151108
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151108,
					"content": "ヴァーナにたくさんの大木があるように、アランナラはたくさんいる。大木にたくさんの枝葉があるように、アランナラにはたくさんの名前がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151109
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151109,
					"content": "金色のナラは、アランナラの名前をたくさん覚えた。アランナクラの名前も覚えた。舞い散る葉を拾うみたいに。それに、それがどの大木から落ちたかを知ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151110
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151110,
					"content": "#アランナラにとって、ナラヴァルナは「特別」なナラなんだな！だから{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}のために記念碑を建てたんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151111,
					"content": "ちょっと違うけど、前に顔のリアルな彫像を見たことがあるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151112,
					"content": "…神像？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151113
					]
				},
				{
					"id": 730151113,
					"content": "#そう！ナラヴァルナの話を聞いて、{NICKNAME}も{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}がどんな姿か知りたくなっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151114,
					"content": "アランナラは音楽も奏でられるんだし、他のことだって得意かも！リアルな石像も作れるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151115,
						730151117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151115,
					"content": "もしあるなら、確かに見てみたいな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151116
					]
				},
				{
					"id": 730151116,
					"content": "だろだろ！へへっ、ナラヴァルナ、金色のナラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151119,
					"content": "そうだ。今ならヴァルナ神器の「枝」と「葉っぱ」を治しに行けるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151120,
					"content": "#アランナクラがナラ{NICKNAME}とパイモンを案内する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151117,
					"content": "アランナラの芸術は素朴で想像が難しい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151118
					]
				},
				{
					"id": 730151118,
					"content": "#うーん…アランナラの芸術は、{NICKNAME}にはまだ早いかもな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
