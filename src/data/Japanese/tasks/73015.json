			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランナクラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "おまえ、アランナクラだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150302,
					"content": "うわっ！ナ、ナラに見つかった！ど、どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150303,
					"content": "逃げないでくれ！アランパンドゥがおまえの居場所を教えてくれたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150304,
					"content": "あ、ああ…アランパンドゥが教えたってことは、きっといいナラなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150305,
					"content": "#ほー？そんな簡単に信用していいのか？{NICKNAME}は悪いナラで、アランパンドゥの名前を騙ってるだけかもしれないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150306,
					"content": "ええっ！き、金色のナラが騙そうとしてるだって？金色のナラ、本当は悪いナラなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150307,
					"content": "急に罪悪感がわいてきたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150308,
					"content": "#パイモンの話は聞かなくていいから。{M#俺}{F#私}はいいナラだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#よかった…！アランムフクンダ様、感謝します。金色のナラはいいナラでした。ナラ{NICKNAME}はアランナクラが見上げるほどの高さですけど、怖くありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150310,
					"content": "パイモン…パイモンはチビです。怖くありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150311,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150312,
					"content": "パイモンは確かにチビだよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "オイラをバカにしてると痛い目に遭うぞ！フンッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150316,
					"content": "それはさておき、オイラたちはヴァルナ神器の修理に来たんだ。この「ヴァーナ」にもヴァルナ神器の「枝」と「葉っぱ」があるんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150317,
					"content": "アランパンドゥにおまえが困ってるようなら、助けてやれって言われて来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150318,
					"content": "ああ！大勢の悪者がヴァーナに…安全なルートはあるけど、気を付けなきゃ。そこら中に悪い種もあるし、ナラヴァルナのために作ったものすら…ううっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150319,
					"content": "#ナラ{NICKNAME}は立派な体。アランバリカと同じくらい強いかもしれない…ナラ{NICKNAME}なら、何とかできるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150320,
					"content": "#…ナラ{NICKNAME}なら、力になってくれるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150321,
					"content": "#オイラたち、元から手伝う気で来たんだぞ。な、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150322,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "アランナクラ、もう1つお願いがある。ヴァルナ神器を治す前に…石の記憶を取り戻したい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150324,
					"content": "…「石の記憶」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "ヴァーナは忘れない、アランナラも忘れない。でもアランナラは目に見える記憶を残した。悪いヤツが来てからは、悪い種しか見えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150326,
					"content": "アランナラの話はまるで謎々みたいだな…でも、この目で確かめたら分かるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150327,
					"content": "とにかく、アランナクラと一緒に行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150328,
					"content": "いいナラ、いいパイモン！悪いヤツに気づかれないように、安全な道を行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150329,
					"content": "あれ？アランナクラの言ってた「悪いヤツ」ってキノコンだったのか？それなら心配いらないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150330,
					"content": "#ふふんっ、アランナクラ。言っとくけどな、ナラ{NICKNAME}はめっちゃ強いんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150331,
					"content": "それも普通の強さじゃない！めーっちゃくちゃ強いんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150332,
					"content": "アランパンドゥと一緒にいっぱいキノコンを倒したんだぞ。アランパンドゥだって、オイラたちはすごいって言ってた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150333,
					"content": "#わかった。ナラ{NICKNAME}はきっと、アランバリカと同じくらい強い。でも、パイモンは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150334,
					"content": "オイラ？オイラがなんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150335,
					"content": "こんなことがあった…アランナクラは悪いヤツに追いかけられて、土の中にもぐりこんだ。でも掘り返された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150336,
					"content": "おっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150337,
					"content": "悪いヤツの大きな口からは湿った、熱い、果物の腐ったような臭いがする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150338,
					"content": "うわぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150339,
					"content": "アランバリカが来てくれなかったら、アランナクラはもう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150340
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150340,
					"content": "ううぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150341,
					"content": "アランパンドゥには長い長いお説教をされた。太陽が沈んでまた昇り、苗畑にまいた種が芽を出すくらいに長かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150342
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150342,
					"content": "…説教、長すぎだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150343,
					"content": "でも、パイモンとどう関係あるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150344
					]
				},
				{
					"id": 730150344,
					"content": "そうだそうだ、それがオイラとどう関係あるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150345,
					"content": "アランナクラはパイモンよりすごいのに、悪いヤツに食べられかけた。パ…パイモンはチビだから、すごく危ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150346
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150346,
					"content": "#え、なんかちょっと納得？いや、違う！{NICKNAME}は強いから、きっとオイラを守ってくれる。だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150347,
						730150349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150347,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150348
					]
				},
				{
					"id": 730150348,
					"content": "#へへっ、オイラは{NICKNAME}の最高の相棒だもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150351,
					"content": "でも、悪いヤツは大勢いる。アランナクラもヤツらにはかなわない…フム…金色のナラは強い。でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150352
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150352,
					"content": "アランナクラは安全な道を知ってる。そこを通ろう。それでいい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150353
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150353,
					"content": "あれ？もしかして…アランナクラ、キノコンにおびえてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150354
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150354,
					"content": "うう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150355
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150355,
					"content": "へへっ、そういうことだったのか。でもオイラを言い訳に使うなんて悪い子だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150356
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150356,
					"content": "#そういうことなら{NICKNAME}、アランナクラと一緒に安全な道を行ってやろうぜ。キノコンを刺激しないよう、気をつけるんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150357
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150357,
					"content": "経験豊富だから大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150358
					]
				},
				{
					"id": 730150358,
					"content": "だな。もうずっと同じようなことをやってるような気もするぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150359
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150359,
					"content": "うん！アランナクラがラナを安全な道に連れて行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730150349,
					"content": "パイモン一人で逃げればいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150350
					]
				},
				{
					"id": 730150350,
					"content": "#オイラが{NICKNAME}を見捨てて逃げると思うのか！そんなのありえない…と思うぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730150314,
					"content": "パイモンは小さいけど、エネルギッシュだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150315
					]
				},
				{
					"id": 730150315,
					"content": "その通り！オイラはすごいんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "パイモン"
				}
			]
