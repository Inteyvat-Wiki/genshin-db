			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "アランナクラ、ただいま！じゃあ、後のことは頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151602,
					"content": "#パイモン、ナラ{NICKNAME}、ありがとう。アランナクラはどうすればいいか知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151603,
					"content": "おお！これでここはもう大丈夫だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151604,
					"content": "森が早く元通りになるといいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "ヴァルナ神器が治ったらきっと大丈夫。でもマラーナは…絶対に排除しなきゃ。ヴァーナのため、サルバのために。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151606,
					"content": "ナラヴァルナの「記念碑」が悪い種に覆われたみたいに、マラーナのせいで「アシュヴァッタ堂」も影響を受けたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151607,
					"content": "あれはナラヴァルナがヴァナラーナに来るより前に、ナラとアランナラが一緒に作った苗畑だった。でも今は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151608,
					"content": "アランナラはヴィマラ村の子供たちには見えるけど、大人にとっては空想上の存在…苗畑だった場所も、マラーナのせいで荒れちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151609,
					"content": "アランナクラは苗畑一面に花を植えたい。ナラはアランナラを忘れちゃった。けど、関係ない。だって花なら、ナラも見られるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151610,
					"content": "アランナクラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730151611,
					"content": "#ナラ{NICKNAME}、パイモン、ありがとう。アランナクラは忘れない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151612,
					"content": "アランナクラは今から「休憩所」に戻る。「記念碑」がきれいになったと知ったら、アランパンドゥもきっと喜ぶよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151613,
					"content": "#ナラ{NICKNAME}とパイモンも、アランナクラと一緒に「休憩所」まで戻る？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151614,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "金色のナラが一緒なら、とっても安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナクラ"
				},
				{
					"id": 730151616,
					"content": "他に用がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#アランムフクンダが、きっとナラ{NICKNAME}とパイモンを守ってくれる。悪いヤツに呑みこまれないよう気をつけて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランナクラ"
				}
			]
		},
