			"dialogs": [
				{
					"id": 130120201,
					"content": "そう言えば、最近妙なことが起きてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120202
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130120202,
					"content": "とある商人が砂漠の旅行パックのお金を回収しに来たんだが、いきなり百二十五万モラの請求を出してきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120203
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130120203,
					"content": "借金した覚えはないし、金額も遥かに市場価格を上回っていたから、「挑発行為」を理由に商人を監禁したんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130120204
					],
					"speakerTitle": "セノ"
				},
				{
					"id": 130120204,
					"content": "お前ら、何か心当たりないか？",
