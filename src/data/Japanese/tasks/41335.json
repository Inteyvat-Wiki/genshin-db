						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フェルメール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350701,
					"content": "トリックフラワーの蜜は手に入れた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350702,
					"content": "手に入れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "どれどれ、うん、これで間違いないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350704,
					"content": "顔料ができたら、どこか構図に使える場所を決めて絵を描くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350705,
					"content": "ふん、あの詩人が僕の絵を見れば、参ったと言うに違いない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350706,
					"content": "あ…そうだ！そういえば、璃月の海灯祭では「霄灯」を飛ばすんだよね？願い事を書いたりして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350707
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350707,
					"content": "へへっ、僕も霄灯を用意するよ。なんの願い事かは…人に言ったら叶わないらしいから、教えられないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350708
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350708,
					"content": "そうだ、危うく忘れてたよ…はいこれ、手伝ってくれたお礼だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350709
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350709,
					"content": "僕の絵で、あの詩人をぎゃふんと言わせてやる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				}
			]
		},
