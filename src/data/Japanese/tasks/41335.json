			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フェルメール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "これも違うし、あれも違う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "こんにちは、今この近くで絵の取材をしていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350104,
					"content": "ほら、今は海灯祭でしょ？どうやったら海灯祭と璃月港を一枚の絵に収められるのか考えてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350105,
					"content": "はぁ…方法が悪いのか、それとも他に原因があるのか…どうも上手くいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350106,
					"content": "だからこうして、構図に使える場所を探しているんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350107,
					"content": "旅人、何かおすすめの場所はない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350108,
					"content": "近くを探してみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "うぅ…分かった。一緒に見てみよう、いい場所が見つかるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "ここの景色は悪くないね。あれ、この人は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350302,
					"content": "私は清昼、詩人だ。君は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350303,
					"content": "あははっ、詩人だったのか。僕は画家さ、この近くで絵の取材をしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350304,
					"content": "取材？それは奇遇だ、私も取材をしていたんだ。君は何のために取材を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350305,
					"content": "海灯祭と璃月港を一枚の絵に収めたいんだ。だから今、この旅人と構図に適した場所を探してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350306,
					"content": "そうだ、そういう君はなんのために？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350307,
					"content": "ふむ…これも奇遇なんだが、私もちょうど海灯祭と璃月港に関する詩を書くためにここで取材している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350308,
					"content": "うむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350309,
					"content": "ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350310,
					"content": "一篇の詩だけで…海灯祭と璃月港を語るのは無理なんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350311,
					"content": "やっぱり、大きな絵でしか祭りの雰囲気は表現できないと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350312,
					"content": "大きな絵？ふんっ、そんなの墨汁の無駄だ。海灯祭の奥深さも伝えられないし、璃月の風格も失ってしまうだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350313,
					"content": "それに、璃月はこんなにも大きいのに、どうやったら一枚の絵に収められるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350314,
					"content": "あははっ、僕は絵の方がいいと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350315,
					"content": "ふん、詩の方がいいに決まってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350316,
					"content": "落ち着いて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "このまま争ってもきりがない。各自、創作作業に取りかかるのが一番だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350318,
					"content": "作品ができたら、それを並べて他の人に評価してもらうってのはどう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350319,
					"content": "いいだろう。絵ができたら望舒旅館に来るといい。そこで人を呼んで評価してもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350320,
					"content": "よし、約束だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350321,
					"content": "ああ、では私はこれで失礼するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 413350322,
					"content": "あの詩人も結構大口を叩いたものだ。二言三言くらいで海灯祭と璃月港をまとめるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350323,
					"content": "ふんっ、絵ができれば、詩人も負けを認めるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350324,
					"content": "この絵はちゃんと用意しないとな…画材も特別に準備した方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350325,
					"content": "旅人、ちょっと特別な材料を集めてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350326,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "じゃあ頼むよ、えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350329,
					"content": "うーん…トリックフラワー·炎からトリックフラワーの蜜を1つ集めてきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350330,
					"content": "あれがあれば、特別な顔料ができるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 413350328,
					"content": "どんな材料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
		{
			"id": 4133505,
