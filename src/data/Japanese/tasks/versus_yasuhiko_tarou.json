			"dialogs": [
				{
					"id": 726990101,
					"content": "お前の剣の腕前が果たしてどれほどのものなのか、この戦いが楽しみだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990102,
					"content": "#どうして、{M#君}{F#あなた}が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "四人の武者と言ったが、実は自分もそのうちの一人なのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990104,
					"content": "この決闘を主催したのは俺だ。しかし、参加者があまりに少なくてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990105,
					"content": "それに、俺は戦うために生まれてきた。強者と出会った以上、戦わぬという選択肢はない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990106,
					"content": "くくっ、この台詞、前々から言ってみたかったのだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990107,
					"content": "なあ、こいつ本当に強いのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726990108,
					"content": "油断は禁物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "さすがだな！お前のそのすべての者を平等に扱う姿勢、尊敬に値する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990110,
					"content": "先ほども、見た目からあの第四の武者を軽視していなければ、あんなコテンパンにやられはしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990111,
					"content": "#だが今の俺は、あの時とは違う！{NICKNAME}、では始めようか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990114,
					"content": "かかってこい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "参る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安彦太郎"
				},
				{
					"id": 726990112,
					"content": "待って、少し準備する。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "そうか、なら万全な状態で挑んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安彦太郎"
				}
			]
		}
	]
