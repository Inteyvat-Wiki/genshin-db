			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "今度はチーム戦でも考えてみようか？対戦も面白そうだよな？あ、君たちか。訓練場へようこそ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "ヴァイノ"
				},
				{
					"id": 760570102,
					"content": "訓練場について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "ゲストも徐々に増えてきましたよ。これもあなたたちのおかげです。もちろん、子供たちと「地隠会」の頑張りもありますが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "ヴァイノ"
				},
				{
					"id": 760570104,
					"content": "気づいたのですが、訓練場って集まるのにぴったりの場所なんですよ。何年も会ってない友達と急に再会すると、何を話していいか戸惑ってしまいませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァイノ"
				},
				{
					"id": 760570105,
					"content": "「地隠会」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "ああ…今のところ、標的よりもいいモグラの巣の敷き材が見つからなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "ヴァイノ"
				},
				{
					"id": 760570107,
					"content": "子供たちと色んな材料を試してみたんですが、やっぱり的を特に気に入ってるみたいなんです。今のところは彼らと取引して手に入れるしかないんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "ヴァイノ"
				},
				{
					"id": 760570108,
					"content": "でも、あの子たちの宝物の相場もだんだん分かってきて、かなりお得に取引できるようにはなってきたんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァイノ"
				},
				{
					"id": 760570109,
					"content": "また来るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "ええ、いつでも！あなたたちならいつでも無料ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァイノ"
				}
			]
		},
