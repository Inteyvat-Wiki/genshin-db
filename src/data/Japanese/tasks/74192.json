			},
			"dialogs": [
				{
					"id": 741920201,
					"content": "ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920202,
					"content": "カノティラ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "#あれ？{M#お兄さん}{F#お姉さん}…あなたは誰？ぼく以外、ここには入れないと思ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920204,
					"content": "どうしてぼくの名前を知ってるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920205,
					"content": "知り合いだからだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "嘘をつけ！あなたもきっとあの怪物と同じなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920207,
					"content": "#（嘘をつく）セレーネが{M#君}{F#あなた}を捜してって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "そうなのか…彼女をこうも心配させていたとは。ぼくは本当に悪い子だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920209,
					"content": "#{M#俺}{F#私}は{NICKNAME}。覚えてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#{NICKNAME}{M#お兄さん}{F#お姉さん}…思い出した…一口で世界を丸呑みできる大きな怪獣だけど、とてもいい人なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920211,
					"content": "すごく失礼だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "ごめんなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920214,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "ぼく見たんだ、何人かがゆっくりと溶けて怪物になるのを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920216,
					"content": "ああ、とても恐ろしかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920213,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
