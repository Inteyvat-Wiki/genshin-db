			"dialogs": [
				{
					"id": 741920401,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920402
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920402,
					"content": "カノティラ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "あっ！やっと帰ってきたのかよ！うぅ…オイラ、おまえが戻ってこなかったらどうしようって、心配してたんだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920404,
					"content": "おまえが入ってから、外でずっと待ってたんだ。すっごく長く感じたぞ…メリュジーヌに「助けてくれ！」って言ったんだけどさ、みんなどうしたらいいかわかんなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920405,
					"content": "（…ここに長く居すぎたようだ。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "そろそろ行かなきゃ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#えっ？{NICKNAME}、どこ行くんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920408,
					"content": "大丈夫。カノティラを見つけて戻ってくるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "もう少しだけ待ってて。いい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "こんなことを言っても無駄なのは分かってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "でも、信じてほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				},
				{
					"id": 741920413,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920412,
					"content": "心配いらないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				}
			]
		}
