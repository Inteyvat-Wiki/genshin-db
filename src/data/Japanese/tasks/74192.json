			},
			"dialogs": [
				{
					"id": 741920101,
					"content": "ぼくは見た。王座の上の炎はすでに消え、燃え殻が木に変わる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920102,
					"content": "花はあなたの歩みと共に綻び、衰えるはずの未来に変化をもたらす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920103,
					"content": "カノティラ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#あれ。{NICKNAME}{M#お兄さん}{F#お姉さん}！どうしてここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "カノティラ"
				},
				{
					"id": 741920105,
					"content": "あっ、そうだ。金色の蝶々が戻ってきたんだ。急いで見に行かないと。それじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カノティラ"
				}
			]
		},
		{
