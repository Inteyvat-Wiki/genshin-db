			},
			"dialogs": [
				{
					"id": 742220701,
					"content": "やあ。何か見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220702,
						742220703
					],
					"speakerTitle": "ジョヴァンニ"
				},
				{
					"id": 742220702,
					"content": "こんなものを見つけたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "特に何も。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "安全には気を付けるんだぞ。もし何かあれば、すぐに報告してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョヴァンニ"
				}
			]
		},
		{
			"id": 7422208,
			"completionStepIds": [
				7422208,
				7422209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422208",
							"2"
						],
						"stepId": 7422208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジョヴァンニ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "これは…間違いない、蛮族が情報伝達のために使用する信号棒だ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "ジョヴァンニ"
				},
				{
					"id": 742220802,
					"content": "本当に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "くっ、まさか本当に蛮族のスパイが紛れ込んでいるとはな。メッティウス長官の懸念は正しかったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "ジョヴァンニ"
				},
				{
					"id": 742220805,
					"content": "この事を報告すれば、俺も晴れて役目を果たせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "ジョヴァンニ"
				},
				{
					"id": 742220806,
					"content": "とにかく助かったよ。もしあんたがいなかったら、蛮族の大軍が押し寄せてきて内側から防御が崩れ去っていたかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "ジョヴァンニ"
				},
				{
					"id": 742220807,
					"content": "メッティウス長官に出す報告書に、必ずあんたのことを書いておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジョヴァンニ"
				},
				{
					"id": 742220803,
					"content": "さっきは木の剣って言ってたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}