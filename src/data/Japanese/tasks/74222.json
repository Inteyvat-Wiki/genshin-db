				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"モゼ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "皆のもの、警戒を怠るな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220102,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "ん？見ての通り、蛮族の脅威を処理するのに忙しいんだ。最近蛮族がどんどん勢いを増して攻め込んで来ている。スパイが紛れ込んでいるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220104,
					"content": "これは決して小さな問題ではない。増援が到着するまで、さらに警戒を強めておかなければ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220105,
					"content": "他に何かあったら、わが副官に報告してくれたまえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220106,
					"content": "子供が一人でこんなところに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "むっ？子供だと？どこに子供がいる？もしやまた新兵が軍令に違反して、勝手に家族を拠点に連れてきたのではないだろうな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220108,
					"content": "やれやれ、カッシオドル様はこういう新兵たちに甘すぎるんだ。三十年前なら、指揮官は鞭を手にしていただろうに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220109,
					"content": "何か不審な点でもあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "今のところはまだない。だが、蛮族は狡猾な悪の獣のように、いつも警戒を解いたすきに襲いかかってくるんだ。やつらは奇襲が一番得意だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220111,
					"content": "やつらは汚い手段を使って我らの町に潜入し、機密を探っている。わずかな気のゆるみが、大惨事を招きかねん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220112,
					"content": "やれやれ…三十年前、ボエティウス様に従って北方に遠征したときは、彼らはまだただの原始的な部族だったから、こんな狡猾な手段を使うことはなかったのに…一体どこで覚えてきたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220113,
					"content": "三十年前ってご両親も生まれてないんじゃ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "む？今何と言ったかな？歳をとると、耳が遠くなってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220115,
					"content": "やれやれ…その昔ビトリアを征服した時は、遠く離れた所からでも、蛮族の集まる鐘の音が聞こえたというのに…年には勝てんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モゼ"
				},
				{
					"id": 742220116,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "またな、善良な民よ。怪しいやつに出会ったら、すぐに報告してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モゼ"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
