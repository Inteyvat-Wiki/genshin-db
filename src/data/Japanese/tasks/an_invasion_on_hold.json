					}
				]
			},
			"dialogs": [
				{
					"id": 745160101,
					"content": "栄誉騎士さん、白い助手さん、いい知らせよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160102
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 745160102,
					"content": "こちらは執律庭の警察隊員、アンジェニーナさん。密放流者の背後にいた売人を逮捕してくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160103
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 745160103,
					"content": "ふん！店のドアを蹴り破ったとき、やつはなんと金を数えてやがったのよ…本当にドのつく大悪党だったわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160104
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160104,
					"content": "あなたたちのおかげで、この水域の外来魚はぐっと減ったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160105
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 745160105,
					"content": "このペースでいけば、今回の外来生物侵入問題は理論上、まもなく根本的に解決するでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160106
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 745160106,
					"content": "やったぜ！もうフォンタ…じゃなくてフォンテーヌの水を心配しなくてもいいんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745160107,
					"content": "ハンターさんもさすがだね！まさか「超最強のリーダー級戦力」に手伝ってもらえちゃうなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160108
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160108,
					"content": "あのことわざ、なんていったっけ…そうそう、「オオズグロカモメを殺すのに艦砲を使う」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160109,
						745160110
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160109,
					"content": "人のポテトを奪うカモメを討ったところで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160111
					]
				},
				{
					"id": 745160111,
					"content": "そういえば、アンジェニーナとはどこかで会った気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745160112,
					"content": "オイラたち、よく治安維持に協力してるから、その時に見たのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160113,
						745160116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745160113,
					"content": "初めまして、どこかで会った警察隊員さん！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160114
					]
				},
				{
					"id": 745160114,
					"content": "あははっ、そんなにかしこまらなくても！またこうやって会うこともあるだろうしさ。ほらほら、肩の力抜いて～。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160115
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160115,
					"content": "そうじゃないと、今度なにかあって助けてもらうとき、こっちはもっと真面目でかしこまった態度を取らないといけなくなっちゃうでしょ？そんなの疲れちゃう。ぜったいムリムリ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160121
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160121,
					"content": "うへぇ…こんなに長く仕事してたなんて。やっとあがれる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160122
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160122,
					"content": "ザ・ラスティ・ラダーで何杯か飲んで、あいつと密放流者が新聞でボロクソに言われるのを待とうかなぁと思うんだけど…一緒にどお？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160123
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160123,
					"content": "素敵なお誘いありがとう、アンジェニーナさん。でも警戒を怠るわけにはいかないわ、しぶとい外来種のことだから、何が起きるか分からないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160124
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 745160124,
					"content": "この水域の外来種をすべて駆逐できたら…絶対ご一緒させて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160125
					],
					"speakerTitle": "ジュリア"
				},
				{
					"id": 745160125,
					"content": "おお！まだまだやる気満々だねぇ。しばらくは忙しそうだし、じゃあまた今度。約束だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160126
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160126,
					"content": "全身全霊、全力で頑張ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160127
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160127,
					"content": "ジュリアは水辺に戻って、引き続き水域の監視を始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745160128
					]
				},
				{
					"id": 745160128,
					"content": "ジュリアさん…頑張りすぎじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745160129,
					"content": "うーん、私の予想だとねぇ…昔、責任感がすごく強い人を見て、感銘を受けたんだと思うよ。気持ちはすごくわかるなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160130
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160130,
					"content": "あの勢いを見ちゃうと、サボってられないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160131,
						745160133
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160131,
					"content": "やる気があるのはいいこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160132
					]
				},
				{
					"id": 745160132,
					"content": "#ずっと努力し続けるのもすごいことだけど、{NICKNAME}を見習って適度に休憩するのも大事だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745160135,
					"content": "じゃあ、私がタイムマネジメントのコツが知りたいって言ったら、教えないってのはナシだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160136
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160136,
					"content": "とにかく…今回の作戦の経費——特に二人の報酬を申請するとき…金額は「メイン艦砲稼働レベル」にしてもらわないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160137
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160137,
					"content": "次も面倒なことがあったときは、現場に君たちがいて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160138
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160138,
					"content": "腰に手をあてて、笑顔でこういってくれるといいんだけどなぁ。「一件落着！」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160133,
					"content": "努力と休憩のバランスは大事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160134
					]
				},
				{
					"id": 745160134,
					"content": "#そうそう、{NICKNAME}はそれをよくわかってるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745160116,
					"content": "前も一緒に色々やったよね、警察隊員さん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160117
					]
				},
				{
					"id": 745160117,
					"content": "覚えてくれてたんだ！よかった～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160118
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160118,
					"content": "今度会ったときは同僚のように気軽に話してよね！恐る恐る話すのはナシ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745160119,
						745160120
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745160119,
					"content": "うん、気軽にいこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160121
					]
				},
				{
					"id": 745160120,
					"content": "なにかあったらお互い助け合おう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160121
					]
				},
				{
					"id": 745160110,
					"content": "艦砲の使い方も勉強したいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745160111
					]
				}
			]
		}
	]
}