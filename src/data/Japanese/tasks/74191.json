			"dialogs": [
				{
					"id": 741910201,
					"content": "陛下、陛下、大丈夫ですか？まさかまた夢をご覧になったのですか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910202
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910202,
					"content": "騒がしいな。何があった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910203
					]
				},
				{
					"id": 741910203,
					"content": "市民たちがホールに集まっています。陛下にお聞きしたいことがあるようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910204
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910204,
					"content": "最近、「フォボス」のメロディーが何度も途切れていますから、市民たちは疑問に思っているのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910205
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910205,
					"content": "そうするしかないのだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910206
					]
				},
				{
					"id": 741910206,
					"content": "もちろん、陛下のご判断を信じます。最近の出来事は私も耳にしましたが…「フォボス」に何かあったのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910207
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910207,
					"content": "全人類の幸せのために、「フォボス」は一人ひとりに道を作ったはずです。無限に近い「シビラ」の計算力に頼れば、何も問題などないはずではないのですか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910208
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910208,
					"content": "メロディーの中に悲鳴を聞いた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910209
					]
				},
				{
					"id": 741910209,
					"content": "まさか、誰かがこっそり「フォボス」の楽譜を書き換えたのですか？いいえ、陛下や我々調律師以外に、それができる人はいないでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910210
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910210,
					"content": "まさか、あの予言者は何かを隠していたのでしょうか…？いいえ、あり得ません。彼女はすでに己の命を捧げ、彼女の予言も水の主によって証明されました。私心など挟めるはずもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910211
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910211,
					"content": "あるいは、私心がなかったからこそ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910212
					]
				},
				{
					"id": 741910212,
					"content": "今は、誰もが「フォボス」の判断に頼っています。もし「フォボス」に何か問題が起これば、民衆たちは混乱に陥るでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910213,
						741910214
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910213,
					"content": "盲信者たちのところに行ってくれ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				},
				{
					"id": 741910215,
					"content": "つまり、不測の事態を防ぐために、私のメロディーを大楽章から引き離すということですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910216
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910216,
					"content": "しかし…それはまだ早いのではないでしょうか。私の魂はまだ偉大な運命に耐えられるほど強くないかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910217,
						741910218
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910217,
					"content": "信じている。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910219,
					"content": "…分かりました。覚悟はすでにできています。それが陛下の願いなら、叶えて差し上げましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910220,
						741910221
					],
					"speakerTitle": "カッシオドル"
				},
				{
					"id": 741910220,
					"content": "「ウラノポリス」、未来の都…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910222,
					"content": "「██████」が去った後、あなたは金色の回廊を通り抜ける。議論の声が次第に大きくなってくる。\\nあなたがホールの真ん中にある壇上に登ると、あたりはようやく静かになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910223
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910223,
					"content": "偉大なる至尊よ、どうかお告げを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910224
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910224,
					"content": "近頃、「フォボス」のメロディーが聞こえないせいで、市民は恐怖と困惑の最中にいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910225
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910225,
					"content": "偉大な計画は順調に進み…影に潜む蛮族はどんどん消されていき、汚染された水域もイコルで浄化されたというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910226
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910226,
					"content": "陛下は何故、意味もなく尊き戦争を止めようとなさっているのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910227
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910227,
					"content": "私には考えがある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910228
					]
				},
				{
					"id": 741910228,
					"content": "偉大なる至尊、あなた様の権威に逆らうつもりはありません。ですが、蛮族には十分に慈悲深くなさっていると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910229
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910229,
					"content": "私たちは偉大な秩序をもたらしました。黄金の秩序に組み込まれようとする者に、レムリアの扉はいつも開かれています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910230
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910230,
					"content": "しかし、あの蛮族たちはどうでしょう？彼らは我々の高塔を壊し、我々の楽師を殺しました。彼らの魂では、救われるべきではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910231
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910231,
					"content": "我々は赤い血で荒れ果てた大地を浄化しています。そして、秩序と文明というものは滅んだあとに生まれ変わるのです。愚かな種族にとって、これは至高の恩賜と言えるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910232
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910232,
					"content": "そんなことは望んでいない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910233
					]
				},
				{
					"id": 741910233,
					"content": "日差しの下には、どんな影もあってはなりません。これもあなた様の偉大な理想なのではありませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910234
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910234,
					"content": "これはレムリアのすべての市民の願いだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910235
					],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910235,
					"content": "至尊、どうかご命令を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ボエティウス"
				},
				{
					"id": 741910221,
					"content": "そう名乗るがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910218,
					"content": "お前はもう「私たち」じゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910214,
					"content": "そのためにお前に自由意志を与える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				}
			]
		}
	]
}