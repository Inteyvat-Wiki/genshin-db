			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴァスデーヴァ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735210201,
					"content": "はぁ、若い子たちを見ていると、昔のことを思い出してしまうのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210202
					],
					"speakerTitle": "ヴァスデーヴァ"
				},
				{
					"id": 735210202,
					"content": "学院トーナメントはいつの時代も、若き天才たちの舞台じゃ。じゃが残念なのは、すべての天才がその才能を成就させられるわけではないこと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210203
					],
					"speakerTitle": "ヴァスデーヴァ"
				},
				{
					"id": 735210203,
					"content": "どうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735210204
					]
				},
				{
					"id": 735210204,
					"content": "天才の多くは意固地で冷たく、他人の苦しみが分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210205
					],
					"speakerTitle": "ヴァスデーヴァ"
				},
				{
					"id": 735210205,
					"content": "じゃが一方、共感のできる者は、往々にして自己懐疑の末に落ち込んでしまう傾向にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210206
					],
					"speakerTitle": "ヴァスデーヴァ"
				},
				{
					"id": 735210206,
					"content": "固い意志がない者は前へ進まず、それがある者も誤った道に踏み入って戻らなくなる。この中には沢山の試練があるからのう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァスデーヴァ"
				}
			]
		},
		{
			"id": 7352103,
			"completionStepIds": [
				7352103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
