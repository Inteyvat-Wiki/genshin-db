			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フヴィシュカ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2009.721,
							274.996,
							4224.615
						],
						"pointId": 330800394
					}
				]
			},
			"dialogs": [
				{
					"id": 735210301,
					"content": "今年の学院トーナメント、俺が一番有望だと思っているのはセノだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210302
					],
					"speakerTitle": "フヴィシュカ"
				},
				{
					"id": 735210302,
					"content": "大マハマトラとしての手腕はもちろんのこと、過去のトーナメントから見ても、素論派の優勝回数は最多だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210303
					],
					"speakerTitle": "フヴィシュカ"
				},
				{
					"id": 735210303,
					"content": "素論派からは、天才が多く輩出されると言われている。ジュライセン、ルジカ、リサ、セノ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210304
					],
					"speakerTitle": "フヴィシュカ"
				},
				{
					"id": 735210304,
					"content": "とはいえ天才が輝かしいほど、試合への期待が薄れるのも早い。最も激しかったのは、やはり二十年前のあれだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210305
					],
					"speakerTitle": "フヴィシュカ"
				},
				{
					"id": 735210305,
					"content": "当時、俺の友人も大会に出ていたんだ。わざわざ会場まで行って応援してやったな。最後の試合はアビディアの森で行われていたんだが、激しすぎて誰も近づけず、森の奥で一体何が起きたのかは誰にもわからないままだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210306
					],
					"speakerTitle": "フヴィシュカ"
				},
				{
					"id": 735210306,
					"content": "その試合は結局教令院に止められた。それから、学院トーナメントはサバイバルに関連する競技の多くを削除したんだ。試合中に「死闘」をしてほしくない、とな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210307
					],
					"speakerTitle": "フヴィシュカ"
				},
				{
					"id": 735210307,
					"content": "友達はどんな人だった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735210308
					]
				},
				{
					"id": 735210308,
					"content": "そうだな。あいつは…まっすぐで優しくて、同時にか弱くて繊細だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210309
					],
					"speakerTitle": "フヴィシュカ"
				},
				{
					"id": 735210309,
					"content": "一番重要なのは、あいつが俺たち友人のことをとても大切にしてくれたことだ。一緒に酒を飲んだときは、みんないつも笑っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210310
					],
					"speakerTitle": "フヴィシュカ"
				},
				{
					"id": 735210310,
					"content": "だが、過ぎた時間はもう戻らない。残念だ。当時一緒に飲んていた友人たちは、亡くなったやつもいれば、失踪、隠居したやつもいる…諸行無常というのは、本当のことだったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210311
					],
					"speakerTitle": "フヴィシュカ"
				},
				{
					"id": 735210311,
					"content": "どうやら二十年前、本当になにかがあったみたいだな…そうだ、ウィカスのやつ言ってたよな？質問があれば、いつでも訪ねていいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210312,
					"content": "いまは時間があるし、あいつに聞いてみたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7352104,
