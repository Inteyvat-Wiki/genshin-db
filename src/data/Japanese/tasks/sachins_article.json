						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウィカス"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-406.229,
							281.227,
							2791.158
						],
						"pointId": 330201342
					},
					{
						"sceneId": 3,
						"position": [
							-405.308,
							281.227,
							2791.237
						],
						"pointId": 330201343
					}
				]
			},
			"dialogs": [
				{
					"id": 735210401,
					"content": "…二十年前の出来事ですか？どうして急に？何か情報を聞いたのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210402
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210402,
					"content": "二十年前、冠を無くしたことあるってのは聞いたぞ。それに、参加者に性格が豹変しちゃったやつもいたらしいって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210403,
					"content": "色々とご存知のようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210404
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210404,
					"content": "ウィカス、なにかオイラたちに隠してないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210405,
					"content": "隠しているわけでは…二十年前の私はまだ五歳ですよ。何か知っているわけがないじゃないですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210406
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210406,
					"content": "ただ、誰にも言っていないことは確かにあります。私が学院祭の企画委員会に入ったのは、ある先輩の影響を受けたからなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210407
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210407,
					"content": "先輩と知り合ったのはとある旅の途中でした。彼は…少し臆病な人でして、何かあったらまずは隠れてしまうんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210408
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210408,
					"content": "四年前のある日、私は学院祭がもうすぐ始まるから、教令院に行ってくると彼に言いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210409
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210409,
					"content": "それで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210410,
					"content": "学院祭と聞いた途端、彼は驚いたように、自分のせいじゃない、とつぶやきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210411
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210411,
					"content": "その夜、別れの挨拶をしようとしたら、彼は一緒に酒を飲んでくれとせがんできました。そしてある程度飲んだところで、変なことを言い始めたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210412
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210412,
					"content": "当時の私も結構飲んでいましたから、ぼんやりしていて、はっきりと聞いていたわけではなかったのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210413
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210413,
					"content": "おぼろげに覚えているのは、才識の冠を一時無くしたことがあるということでした。彼は当時冠の配置と回収を担当していたため、ショックで死にそうなほどだったそうですが…幸い、最終的に木のうろでそれを見つけたらしいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210414
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210414,
					"content": "オイラたちがこの前見たのと同じだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210415,
					"content": "彼が言うには、才識の冠は非常に貴重な宝物で、多くの書籍にその名を記載されているということです。名高い職人によって作られたもので、知られざる秘密があるという噂ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210416
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210416,
					"content": "何せサーチェンが教令院に任せたのは、冠をただ保管することですから…もし彼の手で無くしてしまったのなら、全財産を支払ってても弁償できませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210417
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210417,
					"content": "一時的な紛失でも、決して誰かに知られてはいけないわけです。でなければ、職務怠慢で教令院から重い処罰を受けてしまいますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210418
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210418,
					"content": "だから、そのことを隠したのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210419
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210419,
					"content": "ええ。当時は問い合わせに来る人も多かったらしいです。子供までいたとか。それでも彼は、冠は無くなっていない、と貫き通しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210420
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210420,
					"content": "しかしやはり怖くなって、ほとぼりが冷めてすぐ、仕事を辞めて教令院を離れたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210421
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210421,
					"content": "あの夜、私も酔いつぶれてしまって…次の日に起きたとき、彼はもういませんでした。今になって思い返せば、彼のような人は、遅かれ早かれ学院祭を大変なことにしていたでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210422
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210422,
					"content": "当時は仕事もなかったので、ちょうど学院祭の企画委員会に参加しました。内部からあの時のことを調べようとしましたが、特に収穫はなかったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210423
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210423,
					"content": "無くした冠は見つかり、性格が豹変したと噂されていた人もこの世を去ってしまいましたから、調べようがありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210424
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210424,
					"content": "二十年はあまりにも長すぎて、当時のことを覚えている人も、気にする人も、もうどこにもいません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210425
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210425,
					"content": "私が知っているのはこれがすべてです。気になるようでしたら、引き続き調べてみるといいでしょう。いつかは真相が分かるかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210426
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210426,
					"content": "簡単に言ってくれるぜ。オイラたちだってこれ以上手がかりがないんだぞ。本当にもうなんも情報はないのか？例えば、その先輩が普段よくいたところとか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210427
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210427,
					"content": "あの先輩の情報はもう何も。その後、私も砂漠へ行って彼を探そうとしましたが…砂の海はあまりに広いですから、ばったり会うことができるはずもなく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210428
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210428,
					"content": "代わりに、サーチェンに関する情報ならありますが、聞きますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210429
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210429,
					"content": "うーん…まあいいや。聞いてやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210430
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210430,
					"content": "外で旅をしていた頃、ある傭兵団の団長に同行したことがあります。話していると、彼は教令院の学者が書いた文書を持っていると言ったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210431
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210431,
					"content": "彼はそれを宝物か何かのように扱って、簡単には見せてくれませんでした。何度もお願いしてようやく一目見られたのです。内容までは確認できませんでしたが、署名にはサーチェンとありました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210432
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210432,
					"content": "あの時はサーチェンが誰か知らなかったので、気にも留めませんでした。学院祭の企画委員会に入ってから、彼が学院祭を支援した因論派の有名人だと初めて知ったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210433
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210433,
					"content": "興味がおありでしたら、砂漠に行ってみるといいでしょう。彼は普段ダーリの谷にいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210434
					],
					"speakerTitle": "ウィカス"
				},
				{
					"id": 735210434,
					"content": "サーチェンに関する手がかりだな？いいぜ。行ってみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
