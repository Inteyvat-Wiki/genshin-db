			"trigger": {
				"objectNames": [
					"スヘイブ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2712.056,
							67.739,
							4387.715
						],
						"pointId": 331000111
					}
				]
			},
			"dialogs": [
				{
					"id": 735210501,
					"content": "何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210502
					],
					"speakerTitle": "スヘイブ"
				},
				{
					"id": 735210502,
					"content": "うわ…この人、顔が怖いぞ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210503,
					"content": "用あるならさっさと言え。なければ帰れ。おれは忙しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210504
					],
					"speakerTitle": "スヘイブ"
				},
				{
					"id": 735210504,
					"content": "実は、サーチェンが書いた文書を持ってるって聞いたんだけど…それ、見てみたいなあと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210505,
					"content": "…おれのことをバカにしてんのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210506
					],
					"speakerTitle": "スヘイブ"
				},
				{
					"id": 735210506,
					"content": "そんなことないぞ！どうしてそうなるんだよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210507,
					"content": "本当に何も知らないのか。この間、その文書を鑑定させたんだが…ただの感想が述べられた旅行記みたいなもんだとわかった。大した価値はないってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210508
					],
					"speakerTitle": "スヘイブ"
				},
				{
					"id": 735210508,
					"content": "そのサーチェンっていうやつは、おれのおやじをボディーガードとして雇ったんだ。彼は歩きながらしきりに質問をして、何かを書いてはぶつぶつと言ってたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210509
					],
					"speakerTitle": "スヘイブ"
				},
				{
					"id": 735210509,
					"content": "ある時、サーチェンの原稿が風に飛ばされてな。彼は執着しなかったが、おやじは、学のある人間が書いたものならきっといい値がすると踏んだんだ。だから夜になっても、松明をつけてあちこち探し回った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210510
					],
					"speakerTitle": "スヘイブ"
				},
				{
					"id": 735210510,
					"content": "うちは誰も字が読めない。それでもおやじはそれを大切な宝物だと思って、おれに残してくれた。それがまさか、全く金にならないとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210511
					],
					"speakerTitle": "スヘイブ"
				},
				{
					"id": 735210511,
					"content": "ちょっとかわいそうだな…その文書はまだ取っておいてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210512,
					"content": "あるぞ。読んでみたいか？好きにしろ。金にならないし、おれまでこれを宝物にする必要はないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210513
					],
					"speakerTitle": "スヘイブ"
				},
				{
					"id": 735210513,
					"content": "これがサーチェンの書いた文書なのか？えっと…あんまりよくわかんないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210514,
					"content": "でも…このぼんやりした字…なんだか、ちょっと悲しそうに見えないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210515,
					"content": "とりあえず、読み終わったぞ。ありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735210516,
					"content": "気にするな。金にはならなかったが、取っておくさ。こんなんでも、おやじが残してくれたもんだからな。もう一度読みたくなったらまた来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スヘイブ"
				}
			]
		},
