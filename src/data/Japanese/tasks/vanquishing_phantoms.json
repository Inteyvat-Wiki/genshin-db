			},
			"dialogs": [
				{
					"id": 140340201,
					"content": "「魔物」が倒され、「魔法使い」も討伐された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340202
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "クロリンデ"
				},
				{
					"id": 140340202,
					"content": "その後、王都に再び平和な日々が訪れた。心を支配されていた臣下たちは、己の犯した過ちを知った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340203
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "クロリンデ"
				},
				{
					"id": 140340203,
					"content": "国を救った英雄である彼らの名前を覚えている者もいれば…何も知らず、生き続ける者もいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340204
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "クロリンデ"
				},
				{
					"id": 140340204,
					"content": "これが、不穏な影を追いかけ、蹴散らし、狩り尽くす「ファントムハンター」の物語だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340205
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "クロリンデ"
				},
				{
					"id": 140340205,
					"content": "人々の記憶に留まろうと留まらなかろうと、彼らはこの街を守り、人々の暮らしを守り続けている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340206
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "クロリンデ"
				},
				{
					"id": 140340206,
					"content": "ふぅ…おしまいかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340207
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340207,
					"content": "素晴らしい結末でしたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340208
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340208,
					"content": "素晴らしいストーリーだったよ。最初はありふれた冒険物語だと思っていたけど、ストーリーが進むにつれ、構成や細部にこだわっている感じが伝わってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340209
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340209,
					"content": "特に最後の決戦のシーンは、本当にリアルだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340210
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340210,
					"content": "あはは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340211
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340211,
					"content": "うん…そうだね。宝物庫で手に入れた武器に、あんな効果があるなんて思いもしなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340212
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340212,
					"content": "そうそう。手に持った武器が輝き出したときは本当にびっくりしたよ。でも、じっくり観察してみたけど、もう二度と光らなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340213
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340213,
					"content": "あ、武器も小道具だから、後で回収するんだろう？ここに置いとくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340214
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340214,
					"content": "フリーナ様、楽しんでいただけましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340215
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340215,
					"content": "うん、楽しかった。またこういう「テトシア」をやる時があれば、ぜひ僕も呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340216
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340216,
					"content": "もちろんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340217
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340217,
					"content": "では、僕は先に失礼するね。帰りながら、物語の余韻を楽しもうっと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340218
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340218,
					"content": "フロリアンが目を覚ましたら、代わりによろしく伝えておいてくれ。よっぽど疲れているんだろうな、こんなに眠り込んでしまうなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340219
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340219,
					"content": "そうですね、相当疲れていたのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340220
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340220,
					"content": "ではみんな、また会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340221
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340221,
					"content": "…もう…聞いていいよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340222
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340222,
					"content": "うん、いいと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340223
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340223,
					"content": "一体どういうこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340224
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340224,
					"content": "…気づいていたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340225
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340225,
					"content": "ははっ…洞窟で目を閉じろって言われたシーンなんて…気づかないでいるほうが難しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340226
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340226,
					"content": "聞きたいところをぐっとこらえたのよ！クロリンデは何事もなかったかのように振る舞ってたし、フリーナったら全然気づいてないみたいだったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340227
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340227,
					"content": "幻想を壊したくないって気持ちは、みんな同じだったみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340228
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340228,
					"content": "ん？いったいなんの話だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340229,
						140340231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340229,
					"content": "何の話？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340230
					]
				},
				{
					"id": 140340230,
					"content": "えっ！相棒、気づいてなかったの…？ごめんごめん、今からでも耳を塞いでて！いや、あたしが塞いであげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340233,
					"content": "後の祭りだと思うけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340234
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340234,
					"content": "えっ？ってことは…さっきまでの出来事は、シナリオじゃなかったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340235,
					"content": "最初から普通の「テトシア」とは違った、と言ったほうがいいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340236
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340236,
					"content": "…えっ？ええーッ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340237,
					"content": "…なんだ、騒がしいな…頭が、痛い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340238
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340238,
					"content": "おい、早く起きろよ！いったいどういうことなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340239,
					"content": "あぁああ！ゆ、ゆすらないでください！頭が…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340240
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340240,
					"content": "フロリアンは一部始終をありのまま説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140340241
					]
				},
				{
					"id": 140340241,
					"content": "お、オイラの聞き間違いじゃないよな？シナリオの後半はおまえたちが即席で作ったものってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340242
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340242,
					"content": "嘘をつかれたのはムカつくけど、フロリアンの創作力も、クロリンデの臨機応変な対応もすごかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340243
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340243,
					"content": "ステージの上で道具を忘れたことに気づいて、その場で素晴らしいマジックを考えて披露するマジシャンみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340244
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340244,
					"content": "そんな怪しい宝物庫だってわかってたら、オイラ怖くて、とっくに逃げてたかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340245,
					"content": "恐れるに足りない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340246
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340246,
					"content": "クロリンデにとっての「恐れるに足りない」場面は、他の人からしたら度肝を抜かれるほどなんだってば。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340247
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340247,
					"content": "私は慣れてしまったのかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340248
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340248,
					"content": "ええ…クロリンデの毎日ってどれだけ刺激に満ちてるんだよ？…だからゲームマスターをやってるときも、いろんなシチュエーションに対応できたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340249,
					"content": "フロリアン、あなたのことだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340250
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340250,
					"content": "…弁明するつもりはありません。今すぐ警察隊のところに行って、自分の罪を告げ、処罰を受けます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340251
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340251,
					"content": "私に言わせれば、あなたはもう十分処罰を受けている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340252
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340252,
					"content": "…えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340253
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340253,
					"content": "最初こそ利に目が眩んでいたようだが、最終決戦の時、あなたは行動を以て自らのファントムハンターとしての資格を証明した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340254
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340254,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340255
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340255,
					"content": "あなたがファントムハンターとしての役目を果たし続けることが、この街のためになるのではないだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340256
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340256,
					"content": "しかし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340257
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340257,
					"content": "無論、鍵を持って二人のファントムハンターを訪ね、きちんと謝罪したうえで、相手の提示した条件にも応じてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340258
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340258,
					"content": "…はい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340259
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340259,
					"content": "しかし他のことについては…私との「決闘」で、あなたはすでに自分自身の誇りを見せてくれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340260
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340260,
					"content": "…！では…おおせの通りに。い…今から二本の鍵を返しに行ってきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340261
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340261,
					"content": "改めて、皆さんにお礼を言わせてください。私にもう一度チャンスをくれた皆さんの期待を絶対に裏切らないことを、ファントムハンターの名において誓います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340262
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340262,
					"content": "それでは…またお会いしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340231,
					"content": "#実は{M#俺}{F#私}も気づいてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340232
					]
				},
				{
					"id": 140340232,
					"content": "えっ！パイモンも気づいてなかったの…？ごめんごめん、今からでも耳を塞いでて！いや、あたしが塞いであげる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "ナヴィア"
				}
			]
		},
		{
			"id": 1403403,
			"completionStepIds": [
				1403403,
