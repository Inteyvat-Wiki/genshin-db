			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1403403",
							"2"
						],
						"stepId": 1403403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"クロリンデ"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2525.035,
							469.746,
							4803.685
						],
						"pointId": 340300464
					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "ところで、洞窟の「宝」はどうするつもりだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340302,
					"content": "現状復帰だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340303,
					"content": "本当にそれでいいのか？街のみんなに開放して、ファントムハンターのことを知ってもらったりしなくていいのかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340304,
					"content": "ああ。それがファントムハンターたちの選んだ道だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340305,
					"content": "私も同じだ。これからも決闘代理人として役目を果たしていきたいと思っている——「ファントムハンター」という身分を人々に覚えておいてほしいとは思っていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340306,
					"content": "「魔術師」の道とはだいぶ違うけど…クロリンデさんの決定には敬意を表するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340307,
					"content": "あれ？そういえば、最後戦ったとき、武器が光っただろ？演出じゃなかったんなら、いったいなんで光ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340308,
					"content": "過去にファントムハンターは、武器に魔物を制圧するための術式を施していた。魔物を感知すると、光るようになっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340309,
					"content": "ああ…！だからあいつの動きを抑えることができたのね。あたし、本当に召喚が成功したのかと思っちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340310,
					"content": "…成功した部分もあると言えるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340311,
					"content": "ん？というと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340312,
					"content": "おそらく、封印されていた「呑魂獣」は、例のファントムハンターたちと同じ時代を生きていたんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340313,
					"content": "皆が名を唱えたファントムハンターたちは、かつてやつの同胞を数え切れないほど狩った、最も勇敢な狩人たちだ。名を聞いた時、やつは明らかに怖気づいていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340314,
					"content": "名前にはそんな力もあるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340315,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340316,
					"content": "…ナヴィア、先ほど「召喚」したときに唱えていたのは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340317,
					"content": "ん？あ…あああ！あれはあたしの本心…あっ、いや、だから、その…本心を言ったってお芝居よ！お願い、聞き流して。蒸し返さないでよ、恥ずかしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340318,
					"content": "…ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340319,
					"content": "まあ、あんたとあたしの仲だしね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340320,
					"content": "コホン…そ、その話はおしまい！あたし、先に行くからちゃんとついてきてよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340321
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140340321,
					"content": "あ…逃げちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140340322,
					"content": "じゃ、僕もそろそろ失礼するよ。今日は収穫が盛りだくさんだったな。帰ったら、素敵な物語をみんなに聞かせてあげないと。一晩中語れそうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340323
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340323,
					"content": "またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340324
					]
				},
				{
					"id": 140340324,
					"content": "うん、また会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340325
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140340325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340326
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340326,
					"content": "旅人…もし誰もあなたの名前を覚えていなくても…誰もあなたの旅のことを語らなくても…その旅には意味があると思うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340327
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340327,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340328
					]
				},
				{
					"id": 140340328,
					"content": "たとえ誰一人覚えていてくれなくても、仲間と過ごした時間、そして一緒に描く未来に意味がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340329
					]
				},
				{
					"id": 140340329,
					"content": "…いい答えだ。覚えておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340330
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340330,
					"content": "クロリンデはどう思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340331
					]
				},
				{
					"id": 140340331,
					"content": "私は…ふふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340332
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340332,
					"content": "「その質問に、ファントムハンターは答えなかった。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340333
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340333,
					"content": "「今宵の静寂は、答えの代わりになるだろうか…？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クロリンデ"
				}
			]
		}
	]
}