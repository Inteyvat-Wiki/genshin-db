			"dialogs": [
				{
					"id": 140340101,
					"content": "やがてあなたたちは教{RUBY#[D]地下室}会の近くへとやってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "クロリンデ"
				},
				{
					"id": 140340102,
					"content": "周囲に漂う不吉な気配が、敵がすぐ近くにいることを示していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "クロリンデ"
				},
				{
					"id": 140340103,
					"content": "（なんか…本当にそんな気配がしてきたぞ…一体どうやって演出したんだ？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "フリーナ"
				},
				{
					"id": 140340104,
					"content": "そして…決戦のときが来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "クロリンデ",
					"speakerSubtitle": "クロリンデ"
				},
				{
					"id": 140340105,
					"content": "さあ、行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "リネ",
					"speakerSubtitle": "ファントムハンター"
				},
				{
					"id": 140340106,
					"content": "フロリアン、待って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340107,
					"content": "どうしました？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340108,
					"content": "外で待っていろ。呑魂獣は一度あなたの意識に侵入したことがある。再び侵入して、身体を操ることは容易いはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340109,
					"content": "それに、やつの本体に近いところで侵入されれば、身体にどんな異変が起こるか分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340110,
					"content": "だからこそ、私は行かなければなりません…先頭に立たせてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340111,
					"content": "…！もしかして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340112,
					"content": "はい、やつを私の身体の中に引き寄せます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340113,
					"content": "危険すぎる。最悪の場合、あなたを殺さないといけない…分かっているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340114,
					"content": "十分承知しています。でもそれで、あなたたちのターゲットも明確になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340115,
					"content": "やつは操りやすい身体から簡単に逃げたりはしないはずですから…あなたも仲間たちが取り憑かれる心配をせずに済みます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340117,
					"content": "クロリンデさん、私と違って、あなたは強くてまっすぐなファントムハンターです。自分が犯した過ちは、きっちり償わせていただきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340118,
					"content": "というより…そうしないと気が済まないのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340119,
					"content": "私自身の誇りのために、あなたに決闘を申し込んだと思っていただけませんか？手加減は一切必要ありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340120,
					"content": "…分かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340121,
					"content": "フロリアン、決闘代理人の名のもとに、「決闘の申し込み」を受け入れよう——あなたに敬意を表する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 140340122,
					"content": "…ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "フロリアン"
				},
				{
					"id": 140340123,
					"content": "さて、本題に入ろうか。ファントムハンターの剣先に震える魔物の醜態を、再びさらけ出してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クロリンデ"
				}
			]
		},
