				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960601,
					"content": "木々のすき間から流れる風は心地よく、ボクの好きな匂いがする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960602
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960602,
					"content": "ハハッ、前回のボクも同じようなこと言ってたよね。はぁ、なんでこのセリフを言う時は、いつもツイてない時なんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960603
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960603,
					"content": "それで…「神の心」って何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960604
					]
				},
				{
					"id": 3960604,
					"content": "…気付かれてたか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960605
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960605,
					"content": "はぁ…一般人に話せる内容じゃないんだけどね。でも、君にならこっそり教えてもいいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960606
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960606,
					"content": "君も知ってると思うけど、「神の目」はごく僅かな人しか持てない外付けの魔力器官だ。それを持つ者たちは「神の目」を通して元素力を導いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960607
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960607,
					"content": "実はね、「神の目」の所有者はみんな、神になる資格を持っているんだよ。その者たちは「原神」と呼ばれて、天空の島に登る資格があるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960608
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960608,
					"content": "「原神」？聞いたことがない言葉だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960609,
					"content": "フフン、それは本当の神しか知らない秘密だからね。とにかく、ボクたちは「神の目」という初歩的な器官はいらないんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960610
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960610,
					"content": "その代わり、神の魔力器官は天空の島と共鳴してつながっている…それが「神の心」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960611
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960611,
					"content": "ウェンティの腰にあるのは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960612
					]
				},
				{
					"id": 3960612,
					"content": "えへっ、ただの光るガラス玉だよ、不要な疑いを避けるためのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960613,
						3960614
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960613,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				},
				{
					"id": 3960615,
					"content": "じゃあさ、さっき会ってすぐオイラを吹っ飛ばして、ウェンティの「神の心」を奪った悪い女は一体誰だ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960616,
					"content": "彼女は「シニョーラ」——ファデュイ十一人の執行官の第8位、コードネーム「淑女」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960617
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960617,
					"content": "ファデュイの執行官はみんな彼女のように、スネージナヤの女皇によって神のような権力を与えられ、凡人を超えた力を手に入れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960618
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960618,
					"content": "スネージナヤの…女皇？それって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960619,
					"content": "うん、七神の一柱、スネージナヤパレスに鎮座する「氷の女皇」、ファトゥス全員が忠誠を誓う唯一の相手だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960620
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960620,
					"content": "七神間の関係は、全員仲が良いわけではないけど、まさか彼女が他の神から「神の心」を奪おうとするとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960621
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960621,
					"content": "氷の女皇はどんな神？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960622
					]
				},
				{
					"id": 3960622,
					"content": "ああ…何て言えばいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960623
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960623,
					"content": "「500年前の彼女」をボクは知ってるけど、「今の彼女」はよく知らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960624
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960624,
					"content": "500年前のとある大きな災害の後、彼女はボクとのつながりを全て断ったからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960625
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960625,
					"content": "でも、氷の神とファデュイのことは、あとでまた話すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960626
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960626,
					"content": "#七神を全員探すとなると、{NICKNAME}の旅はおそらく困難に満ちることだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960627
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960627,
					"content": "まずはモンドの隣国に行くといい——あそこの「岩」の神はボクと違って、自ら「璃月」全域を治めてるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960628
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960628,
					"content": "彼は年に一度だけ公の場に降臨して神託を下し、璃月の新たな1年の経営方針を民に伝えるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960629
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960629,
					"content": "それでも、その仕事の頻度は誰かさんより上だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960630,
					"content": "えへっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960631
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960631,
					"content": "…とにかく、今年の「迎仙儀式」はもうすぐ始まるみたいだ。うん、逃したらまた1年待つことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960632
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960632,
					"content": "#は！？そんな大事なことをなんで早く言わないんだよ？じゃあな、{NICKNAME}、早く行こう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960633,
					"content": "待って、「風を捕まえる異邦人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960634,
						3960636
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960634,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960635
					]
				},
				{
					"id": 3960635,
					"content": "そうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960638,
					"content": "旅人…君が再び旅に出た時、旅そのものの意味を忘れないでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960639
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960639,
					"content": "テイワットの鳥、歌と城、女皇、ファデュイと魔物…みんな君の旅の一部だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960640
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960640,
					"content": "終点は全てを意味するわけではない。終点に辿り着く前、君の目でこの世界を観察するといい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960641,
						3960642
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960641,
					"content": "ウェンティ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960643,
					"content": "うん！風神の忠告はここまで！ここから先はウェンティの時間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960642,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960636,
					"content": "ごめん、勝手に七天神像の風を借りた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960637
					]
				},
				{
					"id": 3960637,
					"content": "ハハッ、ありがたく使っておくれ——ボクに蒲公英酒を奢ってくれたら尚更いいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960614,
					"content": "また騙された、もう慣れてるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				}
			]
		},
		{
			"id": 39608,
			"completionStepIds": [
				39604
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "ボクに聞きたいことがあったら、今聞いておくれ。ボクは吟遊詩人だからね、ずっと同じ場所には留まらないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960702,
					"content": "トワリンについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "トワリン…彼は最後まで「四風守護」としての責任を忘れなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960704,
					"content": "だからボクは、彼からその責任を取っ払って、そしてボクの考える「自由」を彼に押し付けたくないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960705,
					"content": "——トワリン自身に、自由の意味を理解して、選んでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960706,
					"content": "だってボクも神になる前は、こうしてある友人に…「自由の意味」を教わったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960707,
					"content": "アビス教団について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "うん？ガイアが言った情報か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960709,
					"content": "#…なるほど、アビス教団の「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」という人が、トワリンの腐食を計画したんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960710,
					"content": "#トワリンをアビス教団の戦いの道具にするつもりだったのかな。でも、アビス教団に「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」がいるなんて聞いたことがないね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960711,
					"content": "教団の古参じゃないみたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "ボクもそうだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960714,
					"content": "#でも、その最近になって出てきた「{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYD|INFO_FEMALE_PRONOUN_GIRLD]}」は、どうやってアビス教団を率いるポジションにまで上り詰めたんだろう…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960712,
					"content": "教団の新入りなのかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "「淑女」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "さっきのファデュイの執行官、「神の心」を手に入れたらすぐに撤退したな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960717,
					"content": "それは「騎士団の目撃者」を作らないためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960718,
					"content": "だってこんなことをして証拠でも残してしまったら、西風騎士団との外交関係を断絶したと宣言したも同然だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960719,
					"content": "こんなことをしたくせに、よくもモンドの盟友を続けてられるよな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960720,
					"content": "はぁ…アビス教団の脅威に対抗するために、七国の人々は同盟を結ぶべきだったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960721,
					"content": "「ファデュイ」は七国最強を誇る武力を持っている、それを天空のライアーの窃盗、神の力の強奪に使って、龍災に乗じて騎士団に圧をかけるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960722,
					"content": "あっ、「天空のライアー」といえば…あの時、ディルックの旦那もその名前を口にしてた気がする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960723,
					"content": "「ファデュイ」が七国を闊歩し、西風騎士団の脅威となったのは、この11人の執行官が原因だ、って言ったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960724,
					"content": "そう、さっきボクが言ったように彼らは氷の神から権力を授かり、普通の人間を遥かに凌駕する力を手に入れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960725,
					"content": "「氷の女皇」…もう500年も会っていないな。彼女は一体何を考え、そして何を企んでいるのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960726,
					"content": "今回の件の真相は、君の七神を探す旅に、未知の影響を与えるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960727,
					"content": "神について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "さっきも言ったように、「神の目」の所有者は、この世界で「原神」と呼ばれ、天空の島に登る資格がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960729,
					"content": "「神の心」はより上位の元素制御中枢で、七神の座を象徴するものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960730,
					"content": "#ごめんね、ボクも七神のうちの誰が君の{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTER]}をさらったか知らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960731,
					"content": "あっ、そういえば、ボクも七神の一柱として、まだ自分の容疑を晴らせていない…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960732,
					"content": "ウェンティはあの神と全然違うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "でも、「吟遊野郎」の姿は一つの化身だし、見た目で判断しちゃだめだぞ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960734,
					"content": "長い付き合いだから、疑う必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#あははっ、確かにボクたちいいコンビだったね。そうだ、君が{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_SISTER]}を見つけたら、新しい「四風守護」になってみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960736,
					"content": "それは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#うん？{NICKNAME}、なんだか興味がないみたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960738,
					"content": "吟遊野郎！「四風守護」になれば、人から美味いお供え物が貰えるって言うなら…オイラがやってもいいぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960739,
					"content": "あっははは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3960741,
					"content": "もう大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "じゃあ、早く<color=#00E1FFFF>璃月</color>に行くといい。今年の「迎仙儀式」を見逃したら、また1年待つことになるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		}
	]
}