			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーバラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960501,
					"content": "あっ！栄誉騎士、目が覚めたんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960502,
						3960505
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960502,
					"content": "ウェンティは…大丈夫！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960503
					]
				},
				{
					"id": 3960503,
					"content": "うーん…彼の状態は、「大丈夫」って言えないかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960504
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960504,
					"content": "あなたたちが大聖堂の外で倒れていることに気付いて、元素力で治療したんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960510,
					"content": "あの詩人は先に目が覚めてね、でもおかしいんだ。私の治療が彼の傷には全然効かなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960511
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960511,
					"content": "こんな患者は初めて。彼は「これが普通だよ」って言いながら、大聖堂を出て行ったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960512
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960512,
					"content": "出て行った？どこに行ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960513,
					"content": "<color=#00E1FFFF>「モンドの英雄の象徴」</color>…彼はそう言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960514
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960514,
					"content": "止めようとしたけど、ジンが…ジン団長が「行かせてやってくれ」って言うから。何だか変だよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960515,
						3960516
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960515,
					"content": "（その理由が分かった気がする…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960517,
					"content": "確かウェンティは前に、<color=#00E1FFFF>あの木</color>の下で傷を癒してたよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960518,
					"content": "（風神と風立ちの地の繋がりが理由だろうな、きっとジンも気付いたはずだけど、バーバラには言えないよな…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960516,
					"content": "（ジンも理由が分かったようだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960505,
					"content": "ここは…どの星…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960506
					]
				},
				{
					"id": 3960506,
					"content": "星？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960507
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960507,
					"content": "あっ！バーバラ、こいつの言うことは気にしないでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960508,
					"content": "えっ？うん…わかった。とにかく、あなたたちが大聖堂の外で倒れていることに気付いて、元素力で治療したんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960509
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960509,
					"content": "おまえはバーバラの治療をもっと受けた方がいい、特に頭の方をな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 39606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39604",
							"2"
						],
						"stepId": 39604,
						"stateName": "QUEST_STATE_UNFINISHED"
