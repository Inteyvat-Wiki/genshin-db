			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーバラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960201,
					"content": "こちらは、教会から天空のライアーを回収しに来た祈祷牧師のバーバラだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960202
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3960202,
					"content": "風神のご加護があらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960203
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960203,
					"content": "代理団長と比べて、そういう言葉を口にする資格はないかもしれないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960204
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960204,
					"content": "皆さん、モンドを守ってくれて本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960205
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960205,
					"content": "平和に解決できてよかった！本当に風魔龍と戦うことになっていたら、どうなっていたことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960206
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960206,
					"content": "ああ、これで「ファデュイ」も口出しできなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960207
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3960207,
					"content": "こんな風になって、彼らはきっと悔しがっているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960208
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3960208,
					"content": "西風騎士団に圧力をかける理由を失ったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960209
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3960209,
					"content": "スネージナヤが横暴だというイメージを植え付けただけで、外交の進展は何も得られなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960210
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3960210,
					"content": "はいはい。それで、天空のライアーを持ってきてくれたわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960211
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960211,
					"content": "代理団長の担保も無限じゃないわ。枢機卿に何度催促されたことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960212
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960212,
					"content": "…も、持ってきたけど…うん…ちょっとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3960213,
					"content": "ん？貸出料とかは必要ないから安心して。教会には寄付金があるもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーバラ"
				}
			]
		},
		{
			"id": 39605,
			"completionStepIds": [
				39605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
