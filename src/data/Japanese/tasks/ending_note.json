			},
			"dialogs": [
				{
					"id": 3960001,
					"content": "あなたたちを襲ったのは…「ファデュイ」？ひどい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960002
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960002,
					"content": "ジン団長はさっき騎士団本部に帰ったよ、なんとか証拠を見つけ出すって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960003
					],
					"speakerTitle": "バーバラ"
				},
				{
					"id": 3960003,
					"content": "でも、もし彼らがなんの証拠も残していなかったら、騎士団も告発できないかもしれないって…ジン団長が言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バーバラ"
				}
			]
		},
		{
			"id": 39602,
			"completionStepIds": [
				39602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
