				},
				{
					"id": 223050402,
					"content": "よく分かってますね。この値段は多くも少なくもないので、遊びには最適です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050403
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050403,
					"content": "こちらへ。ここから選んでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050404
					],
					"speakerTitle": "石商"
				},
				{
