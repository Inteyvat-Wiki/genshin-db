			"trigger": {
				"objectNames": [
					"石商"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "お客さん！運試しに石はどうですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050102,
					"content": "やってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "はいよ！お客さん今日顔色いいですね、商売するにはもってこいだ、ハハハッ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050116,
					"content": "お客さん、こちらを見てください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "石商"
				},
				{
					"id": 223050104,
					"content": "石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "もちろんうちの店にある天然石のことですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050106,
					"content": "石を割って、中に玉が入ってたら、モラを差し上げます。もちろん、何もなかったらモラもありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050107,
					"content": "お客さん、一回やってみると分かると思いますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050108,
					"content": "これらの石はどこから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "うちの天然石は皆、「層岩巨淵」から来たトップクラスのものばかりです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050110,
					"content": "へへっ、この「解翠行」は数代も続いたんですから。石を選ぶ目は誰にも負けません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050111,
					"content": "しかしそれも昔のことです。ほら…総務司が「層岩巨淵」を封鎖したじゃないですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050112,
					"content": "原産地が封鎖されると、石が少なくなって、出来上がった玉器より高くなるんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050113,
					"content": "だから店の天然石を売ったほうがいいんじゃないかなって思ったんです。工程が省けますし、刺激的ですし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050114,
					"content": "お客さん、一回やってみると分かると思いますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050115,
					"content": "やってみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
		{
