			"dialogs": [
				{
					"id": 223050201,
					"content": "うちの「解翠行」は天然石がたくさんあるから、一つ一つ選んでたら、目がクラクラしますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050202
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050202,
					"content": "なので天然石を粗方分けてみました。どの値段の石で試すか見てみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "石商"
				}
			]
		},
