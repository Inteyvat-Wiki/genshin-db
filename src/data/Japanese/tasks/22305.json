					"content": "200モラ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050302
					]
				},
				{
					"id": 223050302,
					"content": "慎重派ですね…いいでしょう。あちらから選んでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050303
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050303,
					"content": "200モラもお金ですから、慎重に選んでくださいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050304
					],
					"speakerTitle": "石商"
				},
				{
					"id": 223050304,
					"content": "気に入ったものがあったら、すぐ割りますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "石商"
				}
			]
		},
