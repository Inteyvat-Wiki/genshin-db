			"dialogs": [
				{
					"id": 718050401,
					"content": "若いの、何か用かね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "徳安公"
				},
				{
					"id": 718050402,
					"content": "紀芳からの本だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "これは『帝君遊塵記·四』？随分前に注文した本だ、今更来たのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "徳安公"
				},
				{
					"id": 718050404,
					"content": "どれどれ…ん？これは初版じゃないか。だから時間がかかったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "徳安公"
				},
				{
					"id": 718050405,
					"content": "客が多すぎて俺の注文なんて忘れられたかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "徳安公"
				},
				{
					"id": 718050406,
					"content": "本は受け取った。ありがとうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "徳安公"
				}
			]
		},
