				{
					"id": 718050601,
					"content": "2冊の本について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050602
					]
				},
				{
					"id": 718050602,
					"content": "本を届けてくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050603
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050603,
					"content": "届けたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "ありがとう。「万文集舎」が今日までやってこれたのも、常連客たちのおかげよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050605,
					"content": "それに、常連客たちは本を愛しているの。素晴らしい本に心から喜んでくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050606,
					"content": "手伝ってくれてありがとう。これを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050607
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050607,
					"content": "本がほしい時は、いつでも来てね",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紀芳"
				}
			]
		},
