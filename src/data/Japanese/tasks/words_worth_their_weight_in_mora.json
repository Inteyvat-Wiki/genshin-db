			"dialogs": [
				{
					"id": 718050501,
					"content": "若いの、何か用かね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 718050502,
					"content": "紀芳からの本だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "そういえば「万文集舎」で『璣衡経』を注文していたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 718050504,
					"content": "これだこれだ、これがわしが欲しかった本だ。ハハ、客が多すぎて、わしの本なんて忘れていたかと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 718050505,
					"content": "届いたならよかった…おや、この装幀はなかなか趣がある。さすが紀芳だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "天おじ"
				},
				{
					"id": 718050506,
					"content": "ありがとう、本は受け取ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "天おじ"
				}
			]
		},
