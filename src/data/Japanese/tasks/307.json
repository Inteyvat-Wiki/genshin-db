			"dialogs": [
				{
					"id": 3071501,
					"content": "おおっ！良い動きするじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071502,
					"content": "まさか有能な戦士だったとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071503,
					"content": "神殿での戦いは勉強になったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071504,
					"content": "こちらこそ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "はははっ、騎士の「謙虚さ」も兼ね備えてるとはな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071507,
					"content": "お前がモンドを救う雄姿、きっと自由の都の新たな伝説になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071508,
					"content": "俺は騎士団本部にいるから、暇な時いつでも来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071509,
					"content": "そうだ…いい酒場を知ってるから、そこでもいいぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071505,
					"content": "褒めすぎて恥ずかしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				}
