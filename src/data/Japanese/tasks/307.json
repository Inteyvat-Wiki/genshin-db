			"dialogs": [
				{
					"id": 3071101,
					"content": "来たか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071102,
					"content": "近くに来てくれ。何か匂うか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071103,
					"content": "…なにも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "この<color=#00E1FFFF>神殿</color>で少し予想外のことがあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071106,
					"content": "スライム、ヒルチャール…それから…風魔龍が残した魔力の繋がり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071107,
					"content": "ははっ、中はきっと賑やかなことになってるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071108,
					"content": "危ないのか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "ああ…賑やかだが、危なくはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071112,
					"content": "「北風の狼」の神殿が、こんな風になるなんて実に残念だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071113,
					"content": "#行こう、{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOY|INFO_FEMALE_PRONOUN_GIRLA]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071114,
					"content": "「四風守護」は祀られなくなったが、古の風が消えることはない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071115,
					"content": "「四風守護」の周りを掃除してやろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071110,
					"content": "雑魚ばかりだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "ほぅ！気合の入った発言だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "ガイア"
				},
				{
					"id": 3071104,
					"content": "炎スライムが焦げたにおいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				}
			]
		},
