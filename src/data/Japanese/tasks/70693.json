			},
			"dialogs": [
				{
					"id": 706930101,
					"content": "わたしたちにはお見通しなんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930102
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930102,
					"content": "エウルアが一番嫌いなのはきっと…眉間に堅苦しさと古臭さを刻んでる、とにかく細かくて、こだわりが強くて、手順とかで煩わせてくるような人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930103
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930103,
					"content": "ああ…片眼鏡をかけて、手にはいつも本を持っているような、な。だが実は、その本はただの飾りで、実際に読んだわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930104
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930104,
					"content": "ただ、持っていれば「知識人」のような雰囲気が出て、会話の始めから相手を気迫で圧倒できると思っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930105
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930105,
					"content": "ふふっ！的確すぎ！頭の中にもう絵が浮かんじゃった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930106
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930106,
					"content": "煙緋と…アンバー？珍しい組み合わせだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930107,
						706930108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706930107,
					"content": "何の話をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930109
					]
				},
				{
					"id": 706930109,
					"content": "あっ、旅人とパイモン！来てたんだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930110
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930110,
					"content": "「悪者雪だるま」を遊芸の隠し要素として加えてみようかって、煙緋と相談してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930111
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930111,
					"content": "魔物の的…みたいなもんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706930112,
					"content": "うん。でも、定番悪役の魔物以外にも、もっと型破りなキャラクターを入れてもいいと思ったんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930113
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930113,
					"content": "そのキャラクター決めの方向性で、煙緋と意見がピッタリ合っちゃって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930114,
						706930115
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930114,
					"content": "こんなところで煙緋に会えるなんて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930116
					]
				},
				{
					"id": 706930116,
					"content": "なんかすごいな。すっごく相性がよさそうだって、見てるだけでわかるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706930117,
					"content": "#ああ、モンドで{NICKNAME}とパイモンに会えるなんて、驚いたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930118
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930118,
					"content": "実は、私もモンドに来るのは初めてじゃないんだ。前にも民事訴訟の処理を手伝ったことが何回かあってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930119
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930119,
					"content": "今回は、ヨォーヨとの仕事を終えたところで、ちょうど「ドラゴンスパイン国際クロスカントリー大会」の開幕に出くわして、せっかくだから楽しんでいこうと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930120
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930120,
					"content": "それで、会場で道を尋ねたら、偶然アンバーと出会って…それがまた、すごく気が合ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930121
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930121,
					"content": "だからアンバーの担当している遊びを体験するついでに、改善の手伝いをしているというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930122
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930122,
					"content": "へへっ、エウルアの友達は私の友達だもん。面白いゲームは一緒に楽しまないとね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930123
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930123,
					"content": "栄誉騎士とパイモンも試してみない？各国のゲストに馴染んでもらうための、ストレス発散ミニゲーム——「雪玉チャレンジ」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930124
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930124,
					"content": "おう！雪合戦の腕を磨いとくのも悪くないな！いつか役に立つかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706930125,
					"content": "#それから、{NICKNAME}と暇な時に勝負して、負けた方が料理を作るっていうのもありだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930126,
						706930127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 706930126,
					"content": "それは見逃せないね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930128
					]
				},
				{
					"id": 706930128,
					"content": "雪玉を投げるのも、炎弾を投げるのも…元素の投擲には、共通点があるもんね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706930129
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 706930129,
					"content": "お前のような武芸の天才にとっては、お手の物だろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "煙緋"
				},
				{
					"id": 706930127,
					"content": "#{M#俺}{F#私}、雪玉投げには自信あるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930128
					]
				},
				{
					"id": 706930115,
					"content": "二人が一緒にいるのは想像できなかったな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930116
					]
				},
				{
					"id": 706930108,
					"content": "エウルアの嫌いな人のこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706930109
					]
				}
			]
		}
	]
}