				"points": []
			},
			"dialogs": [
				{
					"id": 715040101,
					"content": "ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040102,
					"content": "ホッセイニ、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715040103,
					"content": "前に「プルシナスパイク」を地脈の噴出口まで運ぶ方法を考えるため、坑道に長居しすぎたのかもしれない。少し影響を受けてしまったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040104,
					"content": "でも今は大丈夫。少し休んだから、もうだいぶ回復した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040105,
					"content": "それに、解決策も思いついた。レポートの提出期限を伸ばす口実を考えるより、「プルシナスパイク」を運ぶ方法のほうがよっぽど楽だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040106,
					"content": "黒泥は地面を覆っているだけ。つまり、空中に浮いていれば問題ない。熱気球で坑道の中を運ぼう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040107,
					"content": "そっか、たしかに熱気球はいい方法だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715040108,
					"content": "これで黒泥の問題はある程度解決できる。ただ、黒泥があまりにも多く、通路を塞いでしまった場合は、熱気球の進行に影響を及ぼすだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040109,
					"content": "それに、黒泥の周りには引き寄せられた魔物もいる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040110,
					"content": "この辺りは君たちに任せるしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040111,
					"content": "#安心しろ、オイラと{NICKNAME}が手を組めば、熱気球に近づいてくる魔物たちなんてちょちょいのちょいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715040112,
					"content": "じゃあ、あとはパイモンに任せるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "オ、オイラは隣でおまえを応援する役だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 715040115,
					"content": "ハハハ…ゴホッ、ゴホッ…ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040116,
					"content": "ちょっと笑っただけで咳が止まらなくなるなんて…とにかく、熱気球の準備をするため、図と昊が「プルシナスパイク」の梱包を手伝ってくれている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040117,
					"content": "元々は自分で「プルシナスパイク」を梱包するつもりだったが、ほんの少し立っていただけで、手が震えるほど咳き込んでしまってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040118,
					"content": "本当に恥ずかしい限りだ。どうやらこれからは学術研究だけでなく、体も鍛えなければならないようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040119,
					"content": "早く彼らのところに行ってあげてほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホッセイニ"
				},
				{
					"id": 715040113,
					"content": "この剣はしばらくパイモンに預けとくよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
		{
			"id": 7150402,
