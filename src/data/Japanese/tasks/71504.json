			"trigger": {
				"objectNames": [
					"図",
					"昊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715040201,
					"content": "#おっ、{NICKNAME}、ちょうど梱包が終わったところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040202
					],
					"speakerTitle": "図"
				},
				{
					"id": 715040202,
					"content": "あのスメールの野郎から聞いただろう、この熱気球を使うって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040203
					],
					"speakerTitle": "図"
				},
				{
					"id": 715040203,
					"content": "おい、「スメールの野郎」とは何だ。ホッセイニはこの黒泥を解決してくれるスメールの偉大な学者だぞ！敬意を払うべきだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040204
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715040204,
					"content": "き…君に何が分かる。この呼び方も親しみを込めたものなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040205
					],
					"speakerTitle": "図"
				},
				{
					"id": 715040205,
					"content": "はぁ、もういい。熱気球は使える状態になってる。黒泥を取り除く機器の準備もできた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040206
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715040206,
					"content": "#{NICKNAME}、もしこの採掘スターの協力が必要なら…ゴホッ…ゴホッ…くっ、俺は力になれないかもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040207
					],
					"speakerTitle": "図"
				},
				{
					"id": 715040207,
					"content": "そうだ、君はちゃんと休んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040208
					],
					"speakerTitle": "昊"
				},
				{
					"id": 715040208,
					"content": "とにかく、運搬を開始するなら、熱気球を起動するといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "図"
				}
			]
		},
