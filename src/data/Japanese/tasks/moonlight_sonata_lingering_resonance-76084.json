			"dialogs": [
				{
					"id": 760840601,
					"content": "異国の曲を演奏する…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490801
					]
				},
				{
					"id": 760490801,
					"content": "異国の曲を演奏する…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "不思議な感じ。昔、たまにこんな感じのメロディを聞いてたけど…キミが弾くとまた違った感じがする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490803,
					"content": "旅人のこの国に対する感情がこもってるからじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490804,
					"content": "不思議だね。曲調から風景が想像できる…実際は、私の想像とどれくらい違うんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490805,
					"content": "見たいのか？オイラたちがガイドしてやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490806,
					"content": "うん…いつかその日が来たら、お願い。",
					"roleType": "TALK_ROLE_NPC",
