			"dialogs": [
				{
					"id": 760840201,
					"content": "コロンビーナがよく口ずさんでたあの歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202
					]
				},
				{
					"id": 760490202,
					"content": "コロンビーナがよく口ずさんでたあの歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "（どんな感情を込めて弾こう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "穏やかな曲調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "素敵。私がよく歌ってるメロディ、覚えてくれたんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490605,
					"content": "へへっ、おまえの歌は上手だからな。たまにこっそり聴いてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490606,
					"content": "月霊もうっとりしてるみたい。ちゃんとお手本を覚えてくれたかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490607,
					"content": "また教えてもらうかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490608,
					"content": "手を出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490609,
					"content": "えっ？オイラたちボランティアでやってるから、授業料はいらないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490610,
					"content": "授業料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490611,
					"content": "私はただ、きれいなメロディには美しい月光が合うって思っただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490701,
					"content": "楽しい曲調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "もう終わっちゃったの？まだまだ聴いてたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490703,
					"content": "これは私が唯一覚えてる「子守唄」だっていうのは、前に言ったよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490704,
					"content": "唄に込められた意味はわからないけど…キミの演奏を聴いてると、月の上で私を待ってる答えは、少なくとも素敵なものだって感じられた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490705,
					"content": "手を出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490706,
					"content": "見返りなんていらないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760490707,
					"content": "ううん、このメロディに美しい月明かりを添えたいだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
