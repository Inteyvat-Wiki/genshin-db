			"dialogs": [
				{
					"id": 760840101,
					"content": "来てくれたんだね。この子たち、またライアーで遊んでるの。よかったら、この前みたいに何か弾いてあげてくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760840102,
					"content": "ちょうど私も、普段と違う曲が聴きたくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760840103,
					"content": "（何を弾こう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
