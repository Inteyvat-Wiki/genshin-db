			"dialogs": [
				{
					"id": 755060101,
					"content": "よっ！来てくれたんだ。ここがアビスのミツムシの発見された最後の場所だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060102
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060102,
					"content": "ここを片付ければおしまいってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060103,
					"content": "そう。数匹ぐらい取り逃しても大丈夫。また時間のあるときにウチがやっとくから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060104
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060104,
					"content": "あと、体調を崩してた部族の人たちもほとんど治ったって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060105
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060105,
					"content": "おお、よかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060106,
					"content": "ただ残念ながら、パイっち提案の陰謀論は事実じゃなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060107
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060107,
					"content": "あの実はもともと、ミツムシが集まる場所に生えてるんだってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060108
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060108,
					"content": "うぅ…オイラだって、ファデュイとか…宝盗団とかが黒幕だなんて展開は考えてなかったぞ…ただ、優秀なガイドとしての素質を発揮しただけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060109,
					"content": "引き続きがんばって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060110
					]
				},
				{
					"id": 755060110,
					"content": "へへっ、もちろんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060111,
					"content": "よし、最後の任務もさっさと片付けよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060112
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060112,
					"content": "おう！虫捕り隊の最後の出撃だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
