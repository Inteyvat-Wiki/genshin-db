				]
			},
			"dialogs": [
				{
					"id": 755060201,
					"content": "#シロネン？{NICKNAME}とパイモンも？こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060202
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060202,
					"content": "オロルン？なんでここに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060203
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060203,
					"content": "具合はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060204
					]
				},
				{
					"id": 755060204,
					"content": "心配してくれてありがとう。ばあちゃんに言いつけられて、苦いのを飲んで、何日も休んでたから、もう大丈夫だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060205
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060205,
					"content": "オロルン、おまえもシロネンを手伝いに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060206,
					"content": "ミツムシを？あ、もしかして君たちがマンテンハニーを捕まえたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060207
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060207,
					"content": "ゴクジョウハニーとカクベツハニーがいなくなったのも…そういうことだったんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060208
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060208,
					"content": "えっと…それってミツムシの名前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060209
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060209,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060210
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060210,
					"content": "見分けやすいようにつけたけど、僕はあの子たちを評価したりはしない。たとえミツを作らなくたって、皆立派な生き物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060211
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060211,
					"content": "つまり…こいつらって、おまえが飼ってるミツムシなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060212,
					"content": "ああ。だけど、同じところで暮らしてるだけで、あの子たちの生活に関与したりはしない。仲は…いいほうだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060213
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060213,
					"content": "えっと…ごめん、全然知らなくて。ミツムシがアビスに汚染されたせいで、部族にまで影響が出てたから、なんとかせざるを得なかったんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060214
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060214,
					"content": "そうそう…ミツムシを傷つけたりもしてないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060215,
					"content": "ならよかった…気にやまないでくれ。僕もそのことを処理するために来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060216
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060216,
					"content": "ただ、一つ訂正させてくれ。ミツムシはとても賢い生き物でな。アビスに汚染されたわけじゃなく、自らアビスのエネルギーを呑み込んだんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060217
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060217,
					"content": "えっ？飲み込んだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060218,
					"content": "ああ。一度に少ししか飲み込めないが…その程度の量なら、体がずっと大きくなるだけで、死にはしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060219
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060219,
					"content": "その後、遠くまで飛んで、汚染物が含まれた燃素蜜珠を排出するんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060220
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060220,
					"content": "蜜珠の外殻は、アビスの汚染をある程度防ぐことができる。その方法でミツムシたちは、故郷から少しずつアビスのエネルギーを取り除こうとしているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060221
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060221,
					"content": "数え切れないぐらいの回数を繰り返さないといけないが、みんなコツコツ働いている。アリの引っ越しにも引けを取らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060222
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060222,
					"content": "そうだったのか…故郷を守ってたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060223,
					"content": "あいつらも、この土地が侵蝕されてるってことを知ってたんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060224
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060224,
					"content": "ああ…マンテンハニーをはじめ、みんな必死で頑張っている。いい子たちばかりなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060225
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060225,
					"content": "さすが「戦争の国」だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060226
					]
				},
				{
					"id": 755060226,
					"content": "でもオロルン、どうやってこの場所がわかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060227
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060227,
					"content": "ああ、ミツムシたちにナムベリーの種をあげたんだ。種は消化されないから、間もなくすると排泄される。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060228
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060228,
					"content": "種が土地に落ちるとすぐに育って、実を結ぶ。だから、その植物を辿れば、ミツムシの居場所を特定できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060229
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060229,
					"content": "その場所に着いたら、蜜珠を集めて処理し、またナムベリーを使ってミツムシたちを連れ帰っていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060230
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060230,
					"content": "だが、君たちが代わりに済ませてくれたな。あの子たちを傷つけないでいてくれて、本当にありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060231
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060231,
					"content": "そういうことだったのか。この実になにか裏があるんじゃないかって、オイラ疑心暗鬼だったんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060232,
					"content": "なにか困ったことでもあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060233
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060233,
					"content": "いや、大丈夫だぞ！気にするな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755060234,
					"content": "オロルン、ちゃんとミツムシの汚染を取り除いて返すから、心配しないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060235
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060235,
					"content": "そうしてくれると助かる。みんな大事な命だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060236
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060236,
					"content": "さて、これで一段落だな。僕はこれで失礼する。今度、僕のところに遊びに来てくれ。ほかの仲間を紹介しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060237
					],
					"speakerTitle": "オロルン"
				},
				{
					"id": 755060237,
					"content": "楽しみにしてる。またね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060238
					]
				},
				{
					"id": 755060238,
					"content": "ふぅ、そういうことだったのか。オロルンのやつ、「サプライズ」を仕掛ける才能はピカイチだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060239
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060239,
					"content": "#{NICKNAME}とパイっちも、ありがとね。ウチ一人だったら、ほんっと退屈だったと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060240
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060240,
					"content": "これ、あげる。汚染されてない燃素蜜珠だよ。別に貴重なものじゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060241
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 755060241,
					"content": "ウチらと同じように、ナタのために戦ってくれてる子を覚えておくのには、いい記念になるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				}
			]
		}
	]
}