				{
					"id": 411250203,
					"content": "そうだ、俺は協会の依頼を受けて、野外で隕石の調査をしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 411250204,
					"content": "でも隕石の落下地点にいた魔物が、いつもと違う感じになってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 411250205,
					"content": "攻撃の力も動きも、何もかも異常だ。それに数も多い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 411250206,
					"content": "うっかりやつらに見つかってね、近道を駆使してやっとまいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 411250207,
					"content": "この魔物の異常状態、早く戻ってサイリュスさんに報告しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 411250208,
					"content": "他に何かある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "他に？そうだな…強いて言うなら、学者たちが避難を拒んでることかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 411250210,
					"content": "どんなに説得しても、野外研究を続けたいらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 411250211,
					"content": "今野外調査してる冒険者は少ないし、何日かおきに説得にいくのもありえない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 411250212,
					"content": "本当に困った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "うっかりパラド"
				},
				{
					"id": 411250213,
					"content": "旅人、他に用がないなら、早く戻った方がいい。今は野外でうろうろしてる場合じゃないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "うっかりパラド"
				}
			]
