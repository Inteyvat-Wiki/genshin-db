			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジャック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "はぁ…僕も見に行けたらなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "君か。特に重要なことじゃないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250104,
					"content": "ううぅ、やっぱり少し重要かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250105,
					"content": "隕石の事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "そう、君も見たでしょ。この頃、隕石が無数に降ってくる現象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250107,
					"content": "でも…風神のご加護なのか単に運がいいのか、城内には落ちてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250113,
					"content": "でも多くの隕石が野外に落ちている。しかも…噂によると、その隕石に触った人は、深い眠りに落ちて、目を覚まさないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250114,
					"content": "サイリュスさんがすでに冒険者を招集して、その一部を野外の人たちに城内に避難するよう向かわせてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250115,
					"content": "もう一方で、西風騎士を手伝って隕石の落下地点を確認しているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250116,
					"content": "そして落下地点を中心に、周辺の捜索と救援をしている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250117,
					"content": "僕は…サイリュスさんに、城内で昏睡状態の人の面倒を見た方がいいと言われた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250118,
					"content": "たぶん僕の実力がないせいだろう…こんな雑用ばかりで、強くなるチャンスもない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250119,
					"content": "はぁ、何が何であれ、先にこのことを片付けないと…でも旅人さん、僕のために一つ手伝いをしてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250120,
					"content": "僕のために野外に行って、隕石に関する情報を集めてほしいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250121,
					"content": "集めてどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "サイリュスさんが、冒険を始める前は、万全な準備をしろって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250123,
					"content": "もし僕が万全な準備をして、今の状況を全部理解できたら、サイリュスさんも説得できると思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250124,
					"content": "そうしたら、野外調査にも連れて行ってくれるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250125,
					"content": "でも僕は今この人たちの面倒を見なきゃならない、情報を集めにいく機会がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250133,
					"content": "だから、旅人さん、お願い！僕のために野外調査に行ってよ…囁きの森の近くでいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250134,
					"content": "何か収穫があったら、僕に教えて。僕は野外調査に行けないから…全部頼んだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250126,
					"content": "こっそり野外に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "え？こっそり…ない！ないよ、絶対ない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250128,
					"content": "確かに野外調査には行きたい…けど城内に助けが必要な人がいる、城内のことも大事だよ！勝手に離れるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250129,
					"content": "それは…サイリュスさんはいつも、冒険を始める前は、万全な準備をしろって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250130,
					"content": "もし僕が万全な準備をして、今の状況を全部理解できたら、サイリュスさんも説得できると思う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250131,
					"content": "そうしたら、野外調査にも連れて行ってくれるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250132,
					"content": "でも僕は今この人たちの面倒を見なきゃならない、情報を集めにいく機会がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250108,
					"content": "「鹿狩り」でセールがあること？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "え！？知らなかった！今日「鹿狩り」でセールがあるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250110,
					"content": "あ！違う違う…僕が言いたいのはそうじゃなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250111,
					"content": "君も見たでしょ。この頃、隕石が無数に降ってくる現象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 411250112,
					"content": "でも…風神のご加護なのか単に運がいいのか、城内には落ちてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "ジャック"
				}
			]
