			"dialogs": [
				{
					"id": 4520301,
					"content": "あ、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "ジークフレア"
				},
				{
					"id": 4520302,
					"content": "ふふーん、これくらい楽勝だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520303,
					"content": "最近、狼たちに便乗してヒルチャールまで狂暴になってるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520304,
					"content": "そうなの。でも、ヒルチャールより狼たちの方が悪質だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "ジークフレア"
				},
				{
					"id": 4520305,
					"content": "実は…今日の昼前、清泉町が狼の群れに襲われたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "ジークフレア"
				},
				{
					"id": 4520306,
					"content": "えっ！？町が襲われた！？ひどい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520307,
					"content": "そうでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "ジークフレア"
				},
				{
					"id": 4520308,
					"content": "町が襲われたから、もう道中は襲われないだろうと思ってたのに、今度はヒルチャールが来るなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "ジークフレア"
				},
				{
					"id": 4520309,
					"content": "もしかしたら、町に何か痕跡が残されてるかもしれない。急いで調べてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520310,
					"content": "荷物や荷車は大丈夫？わたしは先に行かせてもらうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520311,
					"content": "あ、うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジークフレア"
				}
			]
