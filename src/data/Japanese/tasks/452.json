			"dialogs": [
				{
					"id": 4520101,
					"content": "#あっ、パイモンちゃんと{NICKNAME}。どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520102,
					"content": "おっす、アンバー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520103,
					"content": "アンバー、聞きたいことが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "そうだ、アンバーって奔狼領にいる男の子を知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520105,
					"content": "うん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520106,
					"content": "アンバーの友達だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520107,
					"content": "えっと、誰のことだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520108,
					"content": "おかしいな、忘れちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520109,
					"content": "パイモンちゃんこそ、変なキノコでも食べたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520110,
					"content": "何言ってるか、全然分からないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520111,
					"content": "あ、あれぇ…えっと、ちなみに食べられないキノコって、どんな色してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520112,
					"content": "紫色だけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520113,
					"content": "…二日前に食べたかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520114,
					"content": "って違う！今はいたって正常だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520115,
					"content": "本当に狼たちと暮らしてる少年を知らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520116,
					"content": "ごめんね、何のことか分からないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520117,
					"content": "でも狼といえば、最近気になることがあってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520118,
					"content": "いつもは「奔狼領」で過ごす狼の群れが、最近やけに活発になってるみたいなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520119,
					"content": "「酔漢峡」付近のキャラバンを襲ったって話も聞いたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520120,
					"content": "だから、時間があったら調査を手伝って欲しいんだけど、いいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520121,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "ふふっ、頼もしいね。じゃあ、出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520122,
					"content": "そっちの方が一大事だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "調子はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "あっ、暇してそうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520126,
					"content": "げっ、この言葉の後はだいたい——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520127,
					"content": "こっちは最近、忙しいんだ。なんたって偵察騎士の責任は重大だからね——もちろん、手伝ってくれるよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520129,
					"content": "やっぱり！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520130,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "最近、狼たちが酔漢峡付近のキャラバンを襲うようになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520133,
					"content": "知ってるかな？狼たちは確かに危険だけど、彼らにもルールがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520134,
					"content": "だからモンドの狼は基本、明冠山地と奔狼領から離れられないはずなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520135,
					"content": "おう、あそこの生態系は原始的だけど、独自のルールがあるって聞いたことあるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520136,
					"content": "そう、だから狼が酔漢峡まで行って人を襲うなんて、おかしいんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520137,
					"content": "狼っていうと、アンバーは奔狼領にいる男の子を知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520138,
					"content": "知らないけど。そんなところに人がいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520139,
					"content": "あれっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520140,
					"content": "「赤くて、熱い女の子」はアンバーのことじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4520141,
					"content": "えっと、何の話かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520142,
					"content": "とりあえず、今から酔漢峡に行って調査しようと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520143,
					"content": "一緒について来てくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4520131,
					"content": "内容次第かな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
