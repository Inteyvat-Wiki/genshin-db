			"dialogs": [
				{
					"id": 206020501,
					"content": "おかえり。状況はどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020502
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 206020502,
					"content": "魔物は活動してるみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206020503
					]
				},
				{
					"id": 206020503,
					"content": "まだ周囲に活動する魔物がいるのか？どうやらあの暴風の影響はまだ消えてないんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020504
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 206020504,
					"content": "ハハハッ、まだチャンスがあるさ、冒険者協会の力を見せるチャンスがな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020505
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 206020505,
					"content": "西風騎士団は城内と城周りの防衛に集中してるから、野外の魔物は俺たち冒険者協会がなんとかするしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206020506
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 206020506,
					"content": "分かった、調査ありがとう。俺も依頼を考え直すよ。これは受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイリュス"
				}
