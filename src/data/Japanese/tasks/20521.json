			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "「ホワイトソースポトフ」を届けに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "ハリスに頼まれたのね、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210303,
					"content": "こんな美味しい物ばかり食べていては、非常食生活に戻れなくなってしまうわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210304,
					"content": "ははは、冗談冗談。私は冒険者だよ、どんな辛い状況でも乗り越えてみせるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210305,
					"content": "さらに先に向かうの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "もちろん。この拠点はただの中間地点よ。頃合いを見て、もう少し先に拠点を作るつもり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210307,
					"content": "そうなったら、もう温かい食事とはしばらくお別れね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210308,
					"content": "でも、やみくもに進むようなことはしないわ。少し状況を確認したら本部に戻って、計画を立てるつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 205210309,
					"content": "料理を届けてくれてありがとう。これを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
