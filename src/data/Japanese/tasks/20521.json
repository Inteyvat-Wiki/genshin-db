			"trigger": {
				"objectNames": [
					"ハリス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "温かい料理を食べたほうがいいだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210102,
					"content": "温かい料理がどうかした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "ああ、雪山に探検に行った玉霞が何か温かい物を食べれたらいいのにと思ってたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210104,
					"content": "玉霞がもう一度探検隊を作って雪山に入りたいと言い出してな。それで、玉霞は雪山の状況を確認するために、一歩先に山に入っていったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210105,
					"content": "玉霞の拠点は遠くないから、物資を届けるのも難しくないが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210106,
					"content": "雪山にずっといるんだから、熱い食べ物を口にした方が元気も出るだろうと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210107,
					"content": "だが俺は雪山に入れないからな…代わりに君がこの「ホワイトソースポトフ」を玉霞に届けてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210108,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "では頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210113,
					"content": "料理はできたばかりでまだ温かい。急いで玉霞に届けてくれ。冷めたら味も悪くなるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210114,
					"content": "もし…万が一何かあって料理がダメになってしまったら、ここに戻って来てくれ。料理を作り直すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210110,
					"content": "彼女はどこに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "確か彼女は山の中腹に拠点があると言っていたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "ハリス"
				},
				{
					"id": 205210112,
					"content": "玉霞のようなベテラン冒険者は慎重だからね。拠点を離れて雪山の奥に行くようなことはないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "ハリス"
				}
			]
		},
