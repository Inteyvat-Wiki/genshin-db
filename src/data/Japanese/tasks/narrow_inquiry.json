				"points": []
			},
			"dialogs": [
				{
					"id": 722470201,
					"content": "汝らの実力であれば…供え物の護送は容易であろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470202,
					"content": "これで、吾も安心できる…頼む、無事に送り届けてくれ、そうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470203,
					"content": "そうすれば、どうなるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722470204,
					"content": "そうすれば…そうすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722470205,
					"content": "うわぁ…なんか壊れたみたいになってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722470206,
					"content": "でも供え物って、これのことだよな…もうボロボロだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7224703,
			"completionStepIds": [
				7224705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
