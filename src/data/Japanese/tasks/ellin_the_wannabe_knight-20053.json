			"dialogs": [
				{
					"id": 200530101,
					"content": "困った…どうすればいいの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "今度の騎士選抜のために、訓練してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530104,
					"content": "…でも、ジン様のような力がないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530105,
					"content": "だから「力」よりも、「コツ」を身につけたほうがいいかなと思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530106,
					"content": "たとえば、一気にこの杭を全部破壊する方法とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530107,
					"content": "時間があったら、一緒に考えてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530108,
					"content": "考えてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "うん、ゆっくり考えよう、杭は逃げたりしないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530111,
					"content": "勝手に逃げていくのは使われた時間と命だけだよ、ううっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530114,
					"content": "この距離だと、片方を倒しながら、もう片方に爆弾をポイできれば最高だと思うんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530115,
					"content": "ハハハッ、冗談だよ。爆弾なんて、簡単に見つけられないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530109,
					"content": "二人で壊す…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "団体戦が得意なの？…いつでも仲間がいる人がうらやましいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "エリン"
				},
				{
					"id": 200530113,
					"content": "私みたいな人はひとりで戦う方法を勉強するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "エリン"
				}
			]
		},
