				"points": []
			},
			"dialogs": [
				{
					"id": 101011001,
					"content": "おかえりなさい。本の保管手続きはもうできたわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011002
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011002,
					"content": "ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101011003,
					"content": "あれっ…そういえば、なにか忘れてるような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011004,
						101011005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101011004,
					"content": "『テイワット観光ガイド』だ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011007
					]
				},
				{
					"id": 101011007,
					"content": "——あっ、あそこの棚にあるの…<color=#00E1FFFF>『テイワット観光ガイド』</color>じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011008
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101011008,
					"content": "しかも、いっぱいあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011009
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101011009,
					"content": "ふふふ…実は<color=#00E1FFFF>『テイワット観光ガイド』</color>って定期刊行されてるものだから、正式な所蔵品ではないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011010
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011010,
					"content": "は、はぁ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011011
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101011011,
					"content": "好きなものを持って行っていいわよ。今日の助手としての報酬ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011012
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011012,
					"content": "あなたがいてくれたおかげで、面倒な仕事も少しは面白かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011013
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011013,
					"content": "『テイワット観光ガイド』は、オイラたちを釣るための餌だったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011014
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101011014,
					"content": "城を出て地下遺跡まで本を探すことになるのは…少しばかり予想外だったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011015
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011015,
					"content": "巻き込んでしまったお詫びに、この「記念品」もあげるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011016
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011016,
					"content": "わぁ、リサさんわざわざ用意してくれてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011017
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101011017,
					"content": "今度一緒にお出かけした時に渡そうと思っていたんだけど…今度のことはまた今度にね。期待しといて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011018
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011018,
					"content": "ふわぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011005,
					"content": "報酬！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011006
					]
				},
				{
					"id": 101011006,
					"content": "ふふっ、欲張りさんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011007
					],
					"speakerTitle": "リサ"
				}
			]
		},
