					"content": "ぐ、あぁああああ——ッ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011215,
						101011216
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 101011215,
					"content": "つ、強い！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011217
					]
				},
				{
					"id": 101011217,
					"content": "ふぅ…人の話を聞かない方には、少しばかり罰を与えてあげないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011218,
						101011219
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011218,
					"content": "リサさんも相手の話を聞いていない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101011220
					]
				},
				{
					"id": 101011220,
					"content": "仕事って、本当に面倒よね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011221
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101011221,
					"content": "さて、本を探しましょう。この近くにあるはずよ。",
