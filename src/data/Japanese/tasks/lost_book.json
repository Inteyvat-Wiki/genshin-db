			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リサ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "犯人は<color=#00E1FFFF>遺跡</color>に住んでるのか？モンドの住人には変わった趣味のやつがいるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010702,
					"content": "モンドの人をそう一括りにしないでほしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010703,
					"content": "それにどちらかというと、犯人は人に好かれない「お邪魔虫」って感じがするわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010704,
					"content": "ヒルチャール？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "本を盗むなんてヒルチャールらしくないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010706,
					"content": "盗んだとしても、薪代わりにしか使わないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010712,
					"content": "そうね、<color=#00E1FFFF>アビス教団</color>の可能性が高いと思う。元々、神出鬼没なヤツらですもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010713,
					"content": "それに…この遺跡の入口に施されている元素封印も、アビスの魔術師の魔力と似ているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010714,
					"content": "封印？どう解けばいいんだ…また手間がかかったりしないよな…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010715,
					"content": "この程度の元素力でわたくしを止めようなんて、わたくしも舐められたものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010716,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010717,
					"content": "入りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010718,
					"content": "わ…わぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010719,
					"content": "これが仕事モードのリサさんか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010707,
					"content": "アビス教団？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "わたくしも同じことを考えていたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010709,
					"content": "冒険者協会？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "まあ…地下遺跡を歩き回るという点ではそうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010711,
					"content": "彼らは人のものを盗ったりしないわ…いえ、少なくとも生きた人のものを取ったりしないはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "リサ"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リサ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "<color=#00E1FFFF>『白姫と六人の小人』</color>だな！名前は覚えてるぞ、これで間違いないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010802,
					"content": "ええ、本が無事でよかったわ。でないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010803,
					"content": "でないと、なんだ？あれ以上すごい罰があるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010804,
					"content": "ふふっ、でないと、わたくしの薬剤学の研究成果を身をもって体験してもらうことになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010805,
					"content": "お、おう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010806,
					"content": "それにしても、「禁書エリア」に分類されていない本をどうして盗んだのかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010807,
					"content": "わたくしがつけた標記以外、特に異常な元素反応もなさそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010808,
					"content": "そうだな、普通におとぎ話の絵本だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010809,
					"content": "なら、どうしてアビス教団が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "（不思議だ、気になる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "でも図書館の司書として、面倒な仕事はこれで終わりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010812,
					"content": "そんなに興味があるなら、貸し出ししましょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010813,
					"content": "えっと…返却期限は…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "「お仕置き」は遠慮したい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "期限は無期限よ。あなたのことは「借り手」ではなく、「保管人」として登録するわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010816
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010816,
					"content": "これは信頼に値する市民への特典なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010817
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010817,
					"content": "特典というより…面倒事を他人に押し付けたような感じがする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010818
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101010818,
					"content": "あら？わたくしの仕事になにか不満でも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010819,
						101010820
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010819,
					"content": "な、ない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010820
					]
				},
				{
					"id": 101010820,
					"content": "本は大事にする…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010821
					]
				},
				{
					"id": 101010821,
					"content": "ふふ、物分かりがいいわね。あなたを助手にして傍に置きたいくらい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010822
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010822,
					"content": "じゃあ、今日のお仕事はここまで。先に戻っているわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010823
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 101010823,
					"content": "あなたも図書館にいらっしゃい。保管人としての登録手続きをするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
