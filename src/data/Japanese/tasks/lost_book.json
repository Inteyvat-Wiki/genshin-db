					"nextDialogs": [
						101011206
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 101011206,
					"content": "モンドにも…あの秘密を…理解する人間がいたとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011207
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 101011207,
					"content": "貴様は…誰だ？",
