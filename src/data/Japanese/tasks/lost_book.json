						101011211
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 101011211,
					"content": "ならば…なおさら、本は返せない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011212
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 101011212,
					"content": "「あの秘密」に…関わる…ものだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011213
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
					"id": 101011213,
					"content": "うぐっ！？…き、貴様、何をする気だ！この元素力…まさか——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101011214
					],
					"speakerTitle": "アビスの魔術師"
				},
				{
