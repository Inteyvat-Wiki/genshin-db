			"trigger": {
				"objectNames": [
					"アペ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "おい！何をしてるんだ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060102,
					"content": "今の若者はいったいどういうことだ。礼儀も分かっておらんのか！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060103,
					"content": "ご、ごめんなさい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "ふん…まあ、間違いを認めればそれでいい。あのキノコはお前さんにやるから…他のキノコには触らないでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060105,
					"content": "これはあなたの育てたキノコ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "そんなことお前に関係ないだろ！もう勝手に採るな、行ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アペ"
				}
			]
		},
