			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アペ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "おい！警告したはずだ！耳が聞こえず目も見えないってのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060302,
					"content": "あっ、幽霊だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "ひぃっ！幽霊！？どこに？幽霊が！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060304,
					"content": "ここにいるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "うわぁ！シッシッ！悪霊退散！！アペの名をもって、ここを去ることを命ずる！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060307,
					"content": "はぁ、縁起でもない！こんなに生きてきたが、これほど凶悪な霊は初めてだ！！早く行った行った！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060308,
					"content": "島の外から来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "霧海の外の悪霊か…ふんっ、怖くないわい！そこでおとなしくしてろ、雷鳥様に駆除されるのを待つといい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060310,
					"content": "雷鳥はもう来ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "何だと…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060313,
					"content": "もうみんな去っていった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "何を…何を言ってる…そんな怖いことを言うな、鳥肌が立ってきたではないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060316,
					"content": "だが…島にいる者は確かに少なくなった…前にキナが、船でどこかに行くと言っていた…はぁ、あの子たち、どこに遊びに行ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060317,
					"content": "そうだ、島の外から来た悪霊さん、あんたは行かないのか…？海辺にある銀色の船に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060318,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}には船が見えない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "ふん…どうりで…あの船は、島の外の者には見えないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060321,
					"content": "伝えに来てくれてありがとう、島の外の悪霊さん。ただ…私はこれほど長く生きたが、まだ見てないものもたくさんある。まだ離れたくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060322,
					"content": "何が必要なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "必要？ははっ、別にそういうわけではない…ただ見たいだけなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060324,
					"content": "小さい頃、ウナ姉さんと賭けをしたことがある…私は島の外には必ず変わったキノコがあると言ったが、彼女は信じてくれなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060325,
					"content": "その後…彼女の夫が外の土地へ向かい、帰って来ることができなかった…夫さんの霊は外の土地をさまようしかないらしい…本当にかわいそうに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060326,
					"content": "それから、ウナ姉さんは今まで一人で過ごしてきた…それを思うと、私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060327,
					"content": "もう他の人を思うのはやめよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "私は祭司様にお願いしたことがある…せめて安らげる場所を与えてはくれないかと…ん？そうだ、そうだ！キノコ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060330,
					"content": "コホンッ…もう船に乗らなければ。私には心残りはないが…ただ島の外のものを見たことがなくてな。一番気にかけていることと言えば、毎日世話してるこのキノコたちだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060331,
					"content": "だから、よかったら霧海の外にあるキノコを持ってきてくれないか…見てみたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060332,
					"content": "頼むよ、島の外の悪霊さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060328,
					"content": "キノコについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}のためのものじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "別れの時が来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "「霧海」はもう過去のこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
