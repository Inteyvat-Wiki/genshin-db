					"アペ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "おお！ははっ…おかしな形だ！これらにも「霊」があるのか？これらのキノコも人の記憶を持ち合わせてるのだろうか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060502,
					"content": "それと…この柔らかい翼のようなもの…飛べるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "アペ"
				},
				{
					"id": 722060503,
					"content": "うむ…不思議でならない。船乗りがもう怒ってしまう…悪いが、いよいよ船に乗る時が来たようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アペ"
				}
			]
		}
	]
