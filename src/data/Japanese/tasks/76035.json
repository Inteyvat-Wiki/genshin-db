				]
			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "（コロンビーナ…いないのかな？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "私に何か用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350103,
					"content": "うわっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760350104,
					"content": "びっくりした…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "キミの気配がしたから、後ろから近づけないか試してみたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350107,
					"content": "よっぽど暇なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760350108,
					"content": "え…そう見える？ファデュイにいた頃と変わらないけど…でも確かに、あの頃も特にやることはなかったかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350109,
					"content": "女皇様が必要としてたのは「月神」の力だけ。神の心を手に入れるようにって指示は受けてなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350110,
					"content": "普段は何してる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "散歩したり、月を眺めたり…たまに歌を歌ったり。でもサンドローネから、歌うのをやめなさいって言われてから、あまり歌わなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350112,
					"content": "サンドローネって、歌が好きじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760350113,
					"content": "ううん。上手だって言ってくれたよ。ただ、私がファデュイに入ったばかりの頃は、私の歌を聞くとほかの人が緊張しちゃうからって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350114,
					"content": "知らない人からすると、私が何か能力を使ってるんじゃないかと誤解するかもって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350115,
					"content": "なるほどな…なんとなくわかる気がするぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760350116,
					"content": "もう一つあるよ。サンドローネはたいてい夜中に研究をして昼間は寝てるんだけど、私が歌うと昼寝ができないんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350117,
					"content": "（本当の理由はこっちだろうね。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "だから、夜中にサンドローネの部屋の前で歌うようにしたんだけど、それでも追い出されてしまったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350119,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760350120,
					"content": "ほかの人とは仲良くしてた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "「仲良く」…？うーん…アルレッキーノと会ったばかりの頃、彼女は私と「仲良く」なりたかったみたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350122,
					"content": "いつも足音も立てずに後ろから近づいてきてた。さっきの私みたいにね…ちょっと試したかっただけだ、って言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350123,
					"content": "だから私もそのゲームをやってみてたんだけど、いつもかなり離れたところで気づかれちゃうの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350124,
					"content": "仕方ないから「月」の力を借りて…その時初めて後ろから驚かすことに成功したんだ。でも、その日を境に彼女はそのゲームをしなくなっちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350125,
					"content": "（そもそもそれ、アルレッキーノは「ゲーム」のつもりじゃなかっただろ…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760350126,
					"content": "「博士」からも、「光界の力」の研究に手を貸してほしいって時々言われたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350127,
					"content": "何回か付き合ったけど、クーヴァキを使ってこれを叩きなさいとか、あれを操作しなさいとかばっかりで…つまらなかったからすぐに行かなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350128,
					"content": "過去のことを聞かせてくれるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "うん、「家出」中だけど、楽しい思い出もあったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350131,
					"content": "アルレッキーノとサンドローネは優しかった。それから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350132,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350133,
					"content": "（誰か思い出したのかな…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "手を出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350135,
					"content": "…ん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "ロザリンに言われたことがあるんだ…感謝の気持ちはちゃんと伝えなさいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350138,
					"content": "今日は話を聞いてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350139,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "（これは…月神の祝福？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "今日はここまでにしておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350142,
					"content": "きゅ、急だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760350143,
					"content": "しーっ…パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "そっか。じゃ、今日はそろそろ引き上げよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760350144,
					"content": "いろいろ思い出したのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "…どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "今日はご機嫌みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "突然後ろから出てこないでよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}