			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アンバー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560401,
					"content": "それで、お礼っていうのはね——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560402,
					"content": "じゃ～ん、<color=#00E1FFFF>風の翼</color>よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560403,
					"content": "偵察騎士はこれで空を駆け抜けるの。モンドに住む人たちも、みんなこれを愛用してるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560404,
					"content": "ここに連れてきたのは、あんたにこれの良さを体験してもらいたかったから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560405,
					"content": "ずいぶんと熱く語るんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3560406,
					"content": "「風」は、モンドの魂だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560407,
					"content": "さあ、さっそく風の翼の性能を試しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560408,
					"content": "操作は簡単だけど、指示はちゃんと聞いてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				}
			]
		}
	]
