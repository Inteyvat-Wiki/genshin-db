			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アンバー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560101,
					"content": "あらためて紹介させてもらうわ。風と蒲公英の牧歌の城、自由の都——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560102,
					"content": "西風騎士団に守られてやって来た旅人さんたち、モンドへようこそ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560103,
					"content": "やっと野宿しないで済むな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3560104,
					"content": "でも、城内のみんなは…あまり元気じゃなさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3560105,
					"content": "最近、みんな風魔龍の件で頭を悩ませてるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560106,
					"content": "でも、ジンさんがいれば、きっと全てうまく行く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560107,
					"content": "ジンさん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3560108,
					"content": "西風騎士団の代理団長——ジン、モンドの守護者だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560109,
					"content": "ジンさんが一緒なら、風魔龍レベルの災害でも、きっと打ち勝てるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560110,
					"content": "（すごい人みたいだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#そうだ、一緒に騎士団本部へ行く前に、{NICKNAME}に渡したい物があるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560113,
					"content": "さっき一緒にヒルチャールの巣を片付けてくれたお礼だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560114,
					"content": "おいおい！オイラにはないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3560115,
					"content": "えっと…パイモンちゃんには使えないものだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560116,
					"content": "でも、今夜はモンド名物のニンジンとお肉のハニーソテーをごちそうしてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560117,
					"content": "ニンジンとお肉のハニーソテー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3560118,
					"content": "とにかく、わたしについてきて。今から…<color=#00E1FFFF>高いところ</color>に行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3560111,
					"content": "（風神のことを知ってるといいな…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
		{
			"id": 35604,
			"completionStepIds": [
				35604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"35604",
