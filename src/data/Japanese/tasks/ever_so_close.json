			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060501,
					"content": "あら、こっちですわよ！お客様たち、またまた早くもお会いしましたわね。今回は、どういったご用件で？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060502
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060502,
					"content": "缶詰知識であろうが何であろうが、ポケットにモラががっぽり入るなら、どんな物でも差し上げて見せますわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060503
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060503,
					"content": "ドリーは、オイラたちが欲しいものならなんでも用意できるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060504,
					"content": "あらあら、その言い方。缶詰知識ではもう満足できないようですのね？何が欲しいのかしら、お聞かせ願いますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060505
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060505,
					"content": "「神の缶詰知識」の行方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060506
					]
				},
				{
					"id": 30060506,
					"content": "おっほほほ。さすが、あなたたちのような気前のいいお客様は、普通の缶詰知識なんてアウトオブ眼中なのですのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060507
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060507,
					"content": "ただ、その情報は決して安くはないですの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060508
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060508,
					"content": "何しろ、取引現場に忍び込むのはとても大変でしたのよ。それに、情報を漏らしたのが私だと知られれば、人に狙われますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060509
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060509,
					"content": "でも、おまえの情報が本当だってどうやって証明するんだよ？しかも、なんで「ちょうど」その情報を持ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060510,
					"content": "ほほほ…私にとって、市場に流通している価値のあるものはすべてが「商品」なんですの。商売をするためには、お宝たちの状況を常に把握する必要があるのですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060511
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060511,
					"content": "それに情報の信憑性については、なおさら心配無用ですの。取引の瞬間を写真機に収めましたから、ごまかしは通用しませんわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060512,
						30060513
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060512,
					"content": "じゃあ、値段をつけて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				},
				{
					"id": 30060514,
					"content": "さすがお客様、毎度ありがとうございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060515
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060515,
					"content": "代金は確かにいただきましたわ。では耳を澄まして聞いてくださいまし。神の缶詰知識は、昨日アフマルの目の頭領であるミズリさんによって確保されましたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060516
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060516,
					"content": "アフマルの目？あのキングデシェレトを信奉するエルマイト旅団か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060517,
					"content": "あら、お客様もよくご存じですのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060518
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060518,
					"content": "アフマルの目は、神の缶詰知識に「キングデシェレト」の力が宿っていると信じてますので、そのために全力を尽くしているのですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060519
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060519,
					"content": "さすがは神の缶詰知識。今まで見たことのないような、真っ赤な輝きを放っていましてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060520
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060520,
					"content": "私が撮った写真にも、神の缶詰知識がはっきりと映っていますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060521
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060521,
					"content": "情報ありがとうな、ドリー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060522,
					"content": "いいんですの。お二人のように知識の豊富なお客様がいてくださるなんて、昨日の苦労は無駄ではなかったんですのね。 今後も、何かあればいつでもお越しくださいまし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドリー"
				},
				{
					"id": 30060513,
					"content": "その情報、もらった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				}
			]
		},
