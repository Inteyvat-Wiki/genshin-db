				"points": []
			},
			"dialogs": [
				{
					"id": 30060701,
					"content": "アルハイゼン…まさかイカレ野郎がまた現れるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060702
					],
					"speakerTitle": "タリク"
				},
				{
					"id": 30060702,
					"content": "この対談は俺から要求したものだ。君たちが約束を守ってくれるかどうか心配だったが、信用できるようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060703
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060703,
					"content": "かなり盛大に迎えてもらっているようだが、俺の方も助っ人を連れてきた。文句はないな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060704
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060704,
					"content": "助っ人？店にいたガキじゃねぇか。このイカレ野郎に助けられたからって、恩返しのつもりか？ふん、いい度胸だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060705
					],
					"speakerTitle": "タリク"
				},
				{
					"id": 30060705,
					"content": "そろそろ無駄話はおしまいにするぜ。お前らを魚の餌にしてやる。野郎ども、かかれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060706
					],
					"speakerTitle": "タリク"
				},
				{
					"id": 30060706,
					"content": "あいつら突っ込んでくるぞ！二人とも気をつけろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 300608,
			"completionStepIds": [
				300612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300612",
							"2"
						],
						"stepId": 300612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060801,
					"content": "いったいなにが起こったんだ？あのデカいやつ、どうして急にあんな姿に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060802,
					"content": "どうやら、彼は神の缶詰知識を使ったらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060803
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060803,
					"content": "ああなったのは、神の缶詰知識による影響ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060804,
					"content": "そういえば、ハイパシアが言ってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060805
					]
				},
				{
					"id": 30060805,
					"content": "それって、世界樹の知識を得るとき、学者たちは神の知識に触れて発狂するって話のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060806
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060806,
					"content": "俺の知る限りでも、「サティアワダライフ」の学者が発狂した例はかなり多い。あいつらの様子は、同じような状況に見える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060807
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060807,
					"content": "どうやら神の缶詰知識は確かに神と関係があるようだ。だが、本当に噂通り、これを所有して神の知恵や力が得られるものだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060808
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060808,
					"content": "あいつの言ってた言葉を聞いたか？「世界が私を忘れて」っていったいどういう意味なんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060809
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060809,
					"content": "（あれは以前世界樹で聞いた言葉とまったく同じだった…もしかして、彼もあの光景を見た？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060810
					]
				},
				{
					"id": 30060810,
					"content": "そいつがマハマトラに連れ去られたんだったら、持っていた神の缶詰知識も教令院に持ってかれるよな？こんなに近くまで来てたのに残念だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060811
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060811,
					"content": "でも、神の缶詰知識があんなに危険だなんて思わなかったぞ。むやみに試したりしてたら、オイラたちもああなってたかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060812
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060812,
					"content": "こうなると、もうオルモス港に留まる理由はない。俺たちの協力関係もこれで終わりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060813
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060813,
					"content": "そういえば、神の缶詰知識を探すのに夢中で、おまえに聞いてなかったんだけど。おまえって教令院の人間なんだろ？クラクサナリデビに会う方法を知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060814,
					"content": "実のところ、俺にも分からない。クラクサナリデビはスメールのシステムの外にいる存在で、普段はその存在すら感じられないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060815
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060815,
					"content": "しかも、教令院には神の知恵を象徴するアーカーシャが存在する。学者たちには、自ら神との接触を図ろうとする理由がない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060816
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060816,
					"content": "そうなのか…クラクサナリデビって、神秘的なやつなんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060817,
					"content": "俺は教令院に戻るつもりだ。君たちはどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060818
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060818,
					"content": "もうすぐ花神誕日だし、オイラたちもスメールシティに戻るか。ここ最近はずっと走り回ってたから、少し休めばまた元気が出るかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060819,
						30060820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060819,
					"content": "そうかもしれない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060821
					]
				},
				{
					"id": 30060821,
					"content": "アルハイゼン、じゃあオイラたちはここでお別れだ！じゃあな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060822
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060822,
					"content": "…さて、「これ」を先に処理するべきか、それとも、上へのレポートを書くべきか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060820,
					"content": "スメールシティに戻ろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060821
					]
				}
			]
		},
