					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060301,
					"content": "今、君のアーカーシャ端末に接続し、データを記録する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060302
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060302,
					"content": "では、この缶詰知識を使おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060303
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060303,
					"content": "これを手に持って。君がこれと接続できるよう手伝う。そうすれば君はこの力を活性化できるようになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルハイゼン"
				}
			]
		},
		{
			"id": 300604,
			"completionStepIds": [
				300606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300606",
							"2"
						],
						"stepId": 300606,
