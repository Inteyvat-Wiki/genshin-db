			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060201,
					"content": "ここにしよう。買った缶詰知識を見せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060202
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060202,
					"content": "はい、これ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060203,
					"content": "「片手剣の戦闘技術·八」…うむ、実践系の缶詰知識か。この手の知識はそうあるものじゃない。ほとんどはエルマイト旅団の人が戦闘力を高めるために使ってしまったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060204
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060204,
					"content": "本当か？よかった、いいものが手に入ったかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060205,
					"content": "これが役に立つかどうかを知りたいのなら、君の戦闘時の状態をテストしてあげよう。もし君が既に強い実力の持ち主であれば、大きな進歩を遂げるのは難しいと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060206
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060206,
					"content": "そうだな、対照実験を行うのはどうだ？この缶詰知識の使用前と使用後に、それぞれ一回ずつ戦おう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060207
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060207,
					"content": "…俺はアーカーシャ端末を通して、戦闘時の君の身体状態を測定しておく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060208
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060208,
					"content": "二回の間で出る体力差や、相手の強度差などは、後で計算して影響を排除するから、安心してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060209
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060209,
					"content": "わぁ…アルハイゼン、おまえ…教令院で成績がとてもいいだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060210,
					"content": "ちょっと気になったんだけど、缶詰知識を卒業に使いたい学生でもあるまいし…なんでマハマトラに狙われるリスクを負ってまでこれを扱おうとしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060211,
					"content": "#{M#俺}{F#私}も少し気になる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060212
					]
				},
				{
					"id": 30060212,
					"content": "学者の行動が理解できない時、ほとんどの場合は「好奇心」で説明できる。これは定理なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060213
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060213,
					"content": "うぅ…なんだかごまかされたような気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060214,
					"content": "もういいだろう、テストを始めよう。いつも通り戦えばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルハイゼン"
				}
			]
		},
		{
			"id": 300603,
			"completionStepIds": [
				300604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
