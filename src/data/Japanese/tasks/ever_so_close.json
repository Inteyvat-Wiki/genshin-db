			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060101,
					"content": "来たか。君たちのその表情…どうやら成し遂げたようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060102
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060102,
					"content": "わぁ、なんだか教令院の人がたくさんいるぞ。なんで待ち合わせ場所をこんなとこにしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060103,
					"content": "そもそもウィカラ隊商宿は教令院の管理下にある。教令院の者がここで働いているのも当たり前のことだ。俺がオルモス港に来たのも表向きには、ここの公務を処理するためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060104
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060104,
					"content": "おまえって本当に大胆なやつなんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060105,
					"content": "そんなに緊張する必要はない——ここの人は俺たちの話題に興味がないからな。それに、ここにマハマトラは来ない。では早速、ドリーと会った時の状況を教えてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060106
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060106,
					"content": "アルハイゼンにこれまでのことを話し、買った缶詰知識を渡した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30060107
					]
				},
				{
					"id": 30060107,
					"content": "アルハイゼン、オイラたちは頼まれたことを果たしたんだ。今なら教令院が失くした缶詰知識のことを教えてくれるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060108,
					"content": "その前に一つ聞きたい。君たちはどうしてあの物を調べてるんだ？…もちろん、答えなくてもいいが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060109,
						30060110
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060109,
					"content": "隠す必要があるような理由じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060111
					]
				},
				{
					"id": 30060111,
					"content": "そうだぞ、こいつは知恵の神に会って大事なことを聞きたいんだ。でも、スメールに来てからだいぶ経っても、方法がなかなか見つからなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060112,
					"content": "そしたら、教令院が失くしたある物が「神」と関係してるかもって聞いた。だから、一か八かって思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060113,
					"content": "それなら、君たちの方向性は間違っていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060114
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060114,
					"content": "このあいだ教令院は、砂漠である缶詰知識を失くした。失くしたのは「神の缶詰知識」。それを使えば、神の知恵が手に入るそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060115
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060115,
					"content": "#わぁ、そんなものまであるのかよ！もしそれを見つけられたら、草神に会う方法も、おまえの{M#妹さん}{F#お兄さん}のこともわかるようになるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060116,
					"content": "それが本当にそれほどすごいものなのかどうか、俺は疑っている。だが、それは確かに存在していて、今はこのオルモス港のどこかにある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060117
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060117,
					"content": "どこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060118,
					"content": "それが、俺たちのこれからの課題だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060119
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060119,
					"content": "#もしかして、{M#君}{F#あなた}もそれを狙ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060120
					]
				},
				{
					"id": 30060120,
					"content": "否定はしない。「神の缶詰知識」とは一体何なのか——俺は興味があるし、解明したいと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060121
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060121,
					"content": "もちろん、オルモス港のエルマイト旅団もそれを狙っている。そのもの自体がとても貴重だというだけでなく、中身の知識は多くの力や富をもたらしてくれるかもしれないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060122
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060122,
					"content": "最近いくつかの旅団がその物の帰属を争っているが、最終的な勝者はまだ決まっていないらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060123
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060123,
					"content": "俺一人の財力と人脈では、彼らと競うのは難しいだろう。だから、色々試した末に、俺はいくつかの旅団と簡単な契約を結んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060124
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060124,
					"content": "俺はこの神の缶詰知識を独占しないが、それを研究する機会を与えてくれると彼らは約束した。まあ、それを解明したって彼らに損はないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060125
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060125,
					"content": "だが、エルマイト旅団の中には、条件の交渉がうまく進まない旅団もある。例えばアフマルの目の人たち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060126
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060126,
					"content": "彼らは、神の缶詰知識にキングデシェレトの力があると信じている。キングデシェレトを世に蘇らせるために、それを手に入れたいようだ。だから、彼らは教令院の者がキングデシェレトの精神を汚すことを決して許さない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060127
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060127,
					"content": "あいつらがおまえと協力してくれないから、この前おまえはやつらとやりとりをしてたんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060128,
					"content": "そうだ。アフマルの目がすごい財力を持つとは言えないが、彼らはそれを手に入れる決意がとても固い。十分な資金を得るために、あらゆる卑怯な手段を使って金を集めているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060129
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060129,
					"content": "だから、俺は彼らの商売を邪魔し続けることで、俺に向き合って話をしてもらおうとしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060130
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060130,
					"content": "神の缶詰知識の秘密取引は、数日のうちに行われるはずだ。旅団たちがそれぞれ入札し、物がこっそり勝者に渡される。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060131
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060131,
					"content": "各旅団は品物の安全を守るため、またマハマトラを警戒して、自分が神の缶詰知識を手に入れたことを宣伝はしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060132
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060132,
					"content": "…もし神の缶詰知識が誰の手にあるのか分からなかったら、彼らとの約束も果たせなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060133
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060133,
					"content": "情報を得るのに最も頼もしいのはドリーだが、この道も行き詰まっていた。しかし君たちがいてくれたおかげで、状況は好転した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060134
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060134,
					"content": "つまり、ドリーと仲良くしろって頼んできたのは、神の缶詰知識の行方を探すためか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060135,
					"content": "うん、そう思ってくれていい。君たちにとっても、デメリットは一つもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060136
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060136,
					"content": "明後日、もう一度ドリーのところに行って欲しい。彼女から、神の缶詰知識の行方に関する情報を買うんだ。もし情報がないと言われたら、もう二日待ってからまた行くといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060137
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060137,
					"content": "俺が神の缶詰知識を研究する機会を得られたら、研究結果を君たちに教える。これが報酬でどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060138,
						30060139
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060138,
					"content": "#これは{M#俺}{F#私}が必要とするものだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060140
					]
				},
				{
					"id": 30060140,
					"content": "それでは、また明後日に会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060141
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060141,
					"content": "アルハイゼン、ちょっと待ってくれ！実はオイラたちも缶詰知識を一個買ったんだけど、その使い方が全然わからないんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060142,
					"content": "君たちは缶詰知識を使ってみたいのか？いいだろう、使い方を教えてあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060143
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060143,
					"content": "だが教令院の人々の前でそんなことを教えるのは少し難しい。ここを出よう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060139,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060140
					]
				},
				{
					"id": 30060110,
					"content": "草神に会う方法を探している。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060111
					]
				}
			]
		},
		{
			"id": 300602,
			"completionStepIds": [
				300602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
