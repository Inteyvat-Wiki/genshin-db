				"objectNames": [
					"アルハイゼン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060401,
					"content": "では、データをもう一度記録する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060402
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060402,
					"content": "アルハイゼン、どうだったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060403,
					"content": "#うん、君たちの買った缶詰知識は確かに{M#彼}{F#彼女}の戦闘能力を向上させたよ。二回目の戦闘時の戦闘機能データは一回目と比べて0.073%アップしたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060404
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060404,
					"content": "待て、いくらだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060405,
						30060406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060405,
					"content": "0.073%。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060407
					]
				},
				{
					"id": 30060407,
					"content": "あああ！くぅぅ…やっぱりあの悪徳商人、オイラたちを騙したんだな！これは百万どころか、十万モラにも値しない気がするぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060408,
					"content": "#まあ、そもそも{M#彼}{F#彼女}が強い実力を持っていた場合、缶詰知識の内容ではこれ以上大きく成長させられないかもしれないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060409
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060409,
					"content": "少なくとも、今回のテストを通して、俺は君たちのことをもっと知ることができた。君たちとの取引はお得かもしれないと思えたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060410
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060410,
					"content": "俺は先に隊商宿に戻る——二日後の連絡を待っているから。そうだ、これはドリーに情報を聞くための経費だ。彼女の提示した額を払えばいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060406,
					"content": "つまり、何もないのと一緒だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060407
					]
				}
			]
		},
		{
			"id": 300605,
			"completionStepIds": [
				300607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300607",
							"2"
						],
						"stepId": 300607,
						"stateName": "QUEST_STATE_UNFINISHED"
