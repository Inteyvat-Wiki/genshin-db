			"dialogs": [
				{
					"id": 30060601,
					"content": "アルハイゼン、情報を手に入れてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060602,
					"content": "そうか、どうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060603,
						30060604
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060603,
					"content": "アフマルの目だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060605
					]
				},
				{
					"id": 30060605,
					"content": "ドリーから取引の証拠をもらったんだ、見ろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060606,
					"content": "ほう、はっきり撮れているな。エルマイト旅団の取引場所に忍び込むだけでなく、至近距離に姿を隠すとは、大した度胸だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060607
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060607,
					"content": "この、上に映っているのがアフマルの目の団長、ミズリだ。彼の持っている独特な赤の缶詰知識は、「神の缶詰知識」である可能性が高い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060608
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060608,
					"content": "こうなると、来週の彼らとの「武力対談」で、強制的に「登場」してもらうしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060609
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060609,
					"content": "アルハイゼンがどうしてアフマルの目の連中を挑発するのか、最初は理解できなかったけど…今ではすっかり優位に立ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060610,
					"content": "あいつらを倒せば、そこのボスと対談できる。神の缶詰知識を貸してもらえるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060611,
					"content": "お疲れ様、ここから何日かは休んでいてもらっていい。その間、俺も準備してくる。あいつらに会う日の午後三時、あいつらより先にここで合流しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060612
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060612,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060613
					]
				},
				{
					"id": 30060613,
					"content": "では、お先に失礼する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060614
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060614,
					"content": "数日後、ついにアフマルの目との約束の日が訪れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30060615
					]
				},
				{
					"id": 30060615,
					"content": "アルハイゼンのやつ遅いな、まだかよ…あ、来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060616
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060616,
					"content": "待たせたな。ファロス灯台の前の桟橋に行くぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060617
					],
					"speakerTitle": "アルハイゼン"
				},
				{
					"id": 30060617,
					"content": "おう、行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30060604,
					"content": "間もなく会うあの相手だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060605
					]
				}
			]
		},
		{
