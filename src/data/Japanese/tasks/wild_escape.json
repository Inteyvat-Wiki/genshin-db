			},
			"dialogs": [
				{
					"id": 3760401,
					"content": "ディルック様、こちらが今週の帳面です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 3760402,
					"content": "今度の風災、やはり影響が大きい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3760403,
					"content": "早く収まるといいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 3760404,
					"content": "オーナー、えっと…人が少ないところないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3760405,
					"content": "二階なら、人は少ないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3760406,
					"content": "しかし、君は吟遊詩人だろう？賑わっている場所の方がいいと思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3760407,
					"content": "あははっ、演奏はまた今度やらせてもらうよ。先に二階に行くね、また後で！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3760408,
					"content": "彼らを見張ってくれ。あの詩人はあやしい。僕は状況を聞いてくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3760409,
					"content": "えっと…誰にですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "チャールズ"
				},
				{
					"id": 3760410,
					"content": "モンドの「警備員」たちにだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				}
			]
		},
		{
