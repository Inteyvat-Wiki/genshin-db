				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "あっ、ディルック様、泥棒を見かけませんでした？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "アート"
				},
				{
					"id": 3760602,
					"content": "何があったんだ？こんなに人を出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3760603,
					"content": "ディルック様はご存知ないのですか？泥棒二人が、天空のライアーを盗もうとしたんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "マイルズ"
				},
				{
					"id": 3760604,
					"content": "ほう？それは珍しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3760605,
					"content": "ええ、天空のライアーは風神様の宝物、これほど貴重な文化財を——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "マイルズ"
				},
				{
					"id": 3760606,
					"content": "金にならないものを盗むバカがいるとはな、うちの酒蔵を狙ったほうがまだ儲かると思うが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3760607,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "アート"
				},
				{
					"id": 3760608,
					"content": "ああ、話が逸れたな。金髪と緑色の二人はあっちに行ったようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3760609,
					"content": "かしこまりました。ディルック様、ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マイルズ"
				}
			]
		},
