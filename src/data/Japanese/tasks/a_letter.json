			},
			"dialogs": [
				{
					"id": 741270301,
					"content": "これが、フォンテーヌ科学院の「学術会堂」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270302,
					"content": "確かに、建物の見た目は「会堂」って感じですけど…「学術」の要素はどこに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270303,
					"content": "それは研究員の頭の中に。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "まぁ、いいでしょう。幸い今日は学術のことで来たわけじゃありませんし。何にせよ、この建築物はなかなか…見事ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270306,
					"content": "それしか残ってないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "…オホンッ！では周囲を見て回ってみましょうか。この辺なら、集合写真にも向いてそうです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270308,
					"content": "当日になってロアルテさんに問い詰められて困らないよう、先にいいアングルを探しておきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270309,
					"content": "#{NICKNAME}、何枚か撮るのに協力してくれませんか？記念撮影が得意だと聞いたので、きっと私より上手でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270310,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "たぶん、この石の中にはないだろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
			]
		},
