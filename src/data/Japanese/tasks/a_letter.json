				]
			},
			"dialogs": [
				{
					"id": 741270101,
					"content": "…親愛なる共律官、前にも言った通り、規定があるのでどうしようもないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270102,
					"content": "確かにロアルテさんは必要な文書のリストを送ってくださいましたし、それらの文書は用意できています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270103,
					"content": "でも、あなたがそのまま「文書を持ち歩く」ことはできません。郵便物送付の規定に反してしまいますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270104,
					"content": "あれ？アイオーヌ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "おお、アイオーヌか。元気そうじゃんか？へへっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741270108,
					"content": "そちらもね。これもロアルテさんとスメイヌさんのおかげですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270109,
					"content": "#あれ？アイオーヌ、{NICKNAME}と顔見知りなんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270110,
					"content": "#ええ。{NICKNAME}には以前助けてもらったんです。もし{M#彼}{F#彼女}がいなかったら、きっと共律庭の仕事は続けていなかったと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270111,
					"content": "そんなことまで？さすが私たちフォンテーヌ科学院の名誉上級研究員ですね。ははははっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270112,
					"content": "精神的なサポートをするのは得意だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "でも、もしあの時あなたの支えが無かったら私は…耐えられませんでしたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270115,
					"content": "ところで、ショワズールさんが今言ってましたけど、フォンテーヌ科学院の「名誉上級研究員」なんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270116,
					"content": "うん、賞状だって持ってるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "へへっ、写真もあるぞ！オイラも写ってるんだ。賞状は持ってないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741270118,
					"content": "#ええ、そうです。{NICKNAME}が残した功績を称えるため、当院は{M#彼}{F#彼女}に名誉上級研究員の称号を授与しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270119,
					"content": "#その「功績」が何かについては…{NICKNAME}から後で直接聞いてみてください。今は本題に戻りましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270120,
					"content": "こほん…例の文書は、今あなたにお渡しすることはできないんです、アイオーヌ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270121,
					"content": "ですが前に言っていた、研究員に道案内してもらい、フォンテーヌ科学院の近くで記念撮影をする…というのはまったく問題ありませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270122,
					"content": "#その役は、まさに{NICKNAME}が適任だと思います。{M#彼}{F#彼女}はこの辺りの地理に詳しいですし、きっとそつなくこなすことができるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270123,
					"content": "#どうでしょう？{NICKNAME}さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270124,
					"content": "問題ない、任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "ご親切にありがとうございます。あなたがいれば安心です。何しろ私が来たとき、この辺りは暴走した装置や魔物だらけでしたから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270127,
					"content": "でも、記念撮影はそこまで重要じゃないんです…実はですね、ショワズールさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270128,
					"content": "アイオーヌ、私も力になってあげたいんですが、規定がある以上難しいんです。どうかハンコしか押せない事務官である私を、あまり困らせないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270129,
					"content": "ええ、分かりました…では戻ってロアルテさんともう一度相談してみます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270130,
					"content": "それではショワズールさん、よい一日を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270131,
					"content": "ありがとうございます。フォンテーヌ科学院でよいひと時をお過ごしください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "ショワズール"
				},
				{
					"id": 741270132,
					"content": "#では{NICKNAME}、ガイドをお願いします。まずは「マリアン記念公園」に行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270125,
					"content": "アイオーヌの力になれるなら嬉しいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "ただオートスタンパーを修理しただけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "だったら、「飛んで持って行く」のは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME}！ここで会えるなんて、奇遇ですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "アイオーヌ"
				}
			]
		},
