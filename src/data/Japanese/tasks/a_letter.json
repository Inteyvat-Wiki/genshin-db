							3851.864
						],
						"pointId": 6040
					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "ええと…ここが「マリアン記念公園」ですか？なんだか公園っぽくないような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270202,
					"content": "ロアルテさん、きっとがっかりするだろうな。人を招いてここでスピーチするつもりだったし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270203,
					"content": "この環境を見るに、スピーチは難しそうですよね…ランドマークになる建物もないし、集合写真も撮れなさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270204,
					"content": "装置を捕まえて記念品にはできるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "あははっ！面白いこと言いますね。でも共律庭にはそういう物を置く場所もないんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270206,
					"content": "それに捕まえたとしても、持ち帰ったら私が装置の評価、登記、分類までしたあとで保存しなきゃならないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270207,
					"content": "おいおい！冗談で言ったんだってば。本気にして仕事のことなんか考えるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741270208,
					"content": "登記と言えば…例の文書を受け取れなかったし、ロアルテさんがまたため息をつくだろうなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270209,
					"content": "ショワズールが無理を言ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "無理というわけではないんですが、その…確かに私のお願いは多少規定違反なので、応じてくれないのは正しいことなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270212,
					"content": "ええ、実はですね…フォンテーヌ科学院が復旧作業を計画しているのはご存知ですよね？それで、物資や人員の配置は共律庭とやり取りする必要がありまして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270213,
					"content": "共律庭は、この件を非常に重視しています。そこでロアルテさんが視察チームを編成して、科学院の近くで実地視察をしようと準備しているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270214,
					"content": "ロアルテさんは共律庭に残って人員の統計を行い、私が科学院側と受け入れに関する調整を進めています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270215,
					"content": "で、たまたま科学院が共律庭に返事を出そうとしていたので、来たついでに手紙を受け取って帰ろうかと思ったんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270216,
					"content": "ショワズールさんが言うには、その行動は規定違反だからできないって言うんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270217,
					"content": "規定違反？どの規定に違反するんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741270218,
					"content": "文書を受け取るのにも規定があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "うわ…もしかして、またハンコをもらうために走り回って、サインをして、最後にくどくど文句を聞かなきゃいけないみたいな…ああいうやつか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741270220,
					"content": "簡単に説明すると——共律庭の大半の公務書簡のやり取りは、必ず「郵便物配達」の手法を用いなければならないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270221,
					"content": "えっ？じゃ…じゃあ手紙を送りたい部署が、通りの一本向こうだとか、すぐ向かい側にある場合はどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741270222,
					"content": "…それも郵便物として送付する必要があります。これも、共律庭内の全公務書簡の「トレーサビリティ」を保証するためなんだとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270223,
					"content": "本当に面倒くさいことするね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "まぁ、思うに皆さんもう慣れているんでしょうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270225,
					"content": "それはさて置き、次の場所に向かいましょう。ロアルテさんが書いてくれたメモを見るに次は…えーと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270226,
					"content": "どうやら…フォンテーヌ科学院の「学術会堂」のようです。あれ、おかしいですね…私が来たときは、そんな看板の建物なんてなかったんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270227,
					"content": "場所を知ってる、ついてきて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "いやぁ、相変わらず頼りになりますね！あなたがいなかったら、仕事になりませんでしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270229,
					"content": "では、さっそく出発しましょう。辺りにはまだ暴走したマシナリーが転がってるかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 741270211,
					"content": "ショワズールと何を話してたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
