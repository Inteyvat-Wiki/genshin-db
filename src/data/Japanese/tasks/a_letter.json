					"content": "撮れたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270903,
					"content": "もうすぐ終わる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270904
					]
				},
				{
					"id": 741270904,
					"content": "それじゃあ写真を撮ったら、持ってきてくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
