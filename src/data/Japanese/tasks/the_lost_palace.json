			"dialogs": [
				{
					"id": 762040201,
					"content": "おーい、ニコ——変だな、誰もいないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762040202,
					"content": "もう着いたの？あたしが各地から集めて栽培した草花は見てくれたかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040203,
					"content": "はぁ…残念だけれど、今はそちらに行けないのよ。フォンテーヌで彫刻の出店を出しているところなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040204,
					"content": "えっと…手伝おうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "遠慮しておくわ。これは、あたしが筆を執って字を書く唯一の機会なのよ。といっても、書くのは数字ばかりだけれど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040206,
					"content": "せっかく来てくれたのだから、遊んでてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040207,
					"content": "確か、西側のヤマガラ像のそばに巻物を置いているはずだけれど…分かるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040208,
					"content": "あったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762040209,
					"content": "その無口なガイドが協力してくれるわ。頑張ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニコ"
				}
			]
		},
		{
			"id": 7620403,
