					}
				]
			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "おめでとう。どれどれ…ほら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040302,
					"content": "今の魔女の花園とはまるで違うわね。ここは、昔…あたしがまだ天の使いだった頃、この神殿で暮らしていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040303,
					"content": "天の使いがいっぱいいるな。それにニコ、すっごく人気者みたいだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762040304,
					"content": "自慢じゃないけれど、みんなあたしの話が大好きなのよ。特に、人間と共に歩み、予兆を示し、文明を築くよう導く…そんな物語がね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040305,
					"content": "重要な場面に差し掛かると、みんなは固唾をのんで聞き入ったわ。楽器の弦や、筆の動きすらも止まるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040306,
					"content": "そして、色とりどりの色彩が溢れ出し、音楽と共に金色の光が万物に注がれる…そう、それこそがあたしたちの悦びの歌よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040307,
					"content": "すっごく素敵だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 762040308,
					"content": "ええ、そうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040309,
					"content": "古き良きものはすっかり消え去ってしまったけれど、今の生活だって新しい驚きに満ちているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040310,
					"content": "あたしが新聞を読んでいる隙に、彫像を盗もうとしたやつがいたですって？ご愁傷さま、メロピデ要塞へご案内してさしあげましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "ニコ"
				},
				{
					"id": 762040311,
					"content": "あたしが新聞を読んでいる隙に、彫像を盗もうとしたやつがいたですって？",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "ご愁傷さま、",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "メロピデ要塞へご案内してさしあげましょう。",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		}
	]
