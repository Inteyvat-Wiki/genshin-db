			},
			"dialogs": [
				{
					"id": 790440101,
					"content": "運命の導きに心より感謝いたします。彷徨える旅人たち、よくぞ来てくださいました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440102
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440102,
					"content": "あなたたちもきっと、想像を上回る出会いと旅を期待していることでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440103
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440103,
					"content": "今、お互いの願いを叶えるチャンスが、あなたたちの目の前にあります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440104
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440104,
					"content": "新たな演劇「ダイアの三日空想」にぜひご参加ください。演劇の舞台に立つことで、かつてない不思議な体験を味わえることでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440105
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440105,
					"content": "モラが溢れるプール…古城の幽霊退治…重力の束縛からの解放…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440106
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440106,
					"content": "合言葉「空想の世界へ連れて行って」をお唱えください。あなたたちの好奇心と情熱を見せ、いざ旅立ちましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440107
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440107,
					"content": "う～ん…スピーカーの向こうで喋ってる人、すっごくテンションが高いな。なに言ってるのか、よくわかんないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440108,
					"content": "旅？演劇？舞台？それと…モラのプール？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440109,
						790440110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440109,
					"content": "新しいアトラクションかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				},
				{
					"id": 790440111,
					"content": "おう！そういうことならオイラにもわかるぞ。昔も似たようなイベントがあったよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440112,
					"content": "つまり、スピーカーの向こうで喋ってるのが「ダイア」ってやつなのか？そいつが演劇の監督っぽいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440113,
					"content": "オイラたちも申し込めば、その演劇の中の登場人物になれるってことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440114,
						790440115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440114,
					"content": "パイモンは興味あるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440116,
					"content": "おう、面白そうだしな！それにオイラ、モラのプールがちょっと気になるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440117,
					"content": "あっ、いや…勘違いするなよ！オイラはあくまで「ヴェルーリヤ·ミラージュ」の中で開催されるアトラクションが、どんだけ不思議なものか気になってるだけだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440118,
					"content": "それじゃあ、一緒に合言葉を唱えてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440119,
					"content": "空想の世界へ連れて行って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440120
					]
				},
				{
					"id": 790440120,
					"content": "空想の世界へ連れて行って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440121,
					"content": "ほほう、まったく躊躇わないのですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440122
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440122,
					"content": "コホン、完璧です！参加申し込みの意志を確認しました。「ダイアの三日空想」、まもなく開幕です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440123
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440123,
					"content": "「古の伝説が再び世に現れ、無上の価値を有する財宝に新たな手がかりをもたらした。そして、義侠心を持つ海賊の一味は武器を手に取り、船の帆を上げるのであった…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440124
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440124,
					"content": "「空に浮かぶ町は空前の危機に瀕している。墜落寸前のこの町を救うのは、奇跡を築く一人の建築家だ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440125
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440125,
					"content": "「不幸に遭遇した仲間を救うべく——はぐれ水形幻霊は、幽霊が徘徊する古城の中にある『呪い』を打ち破る希望を求めた…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440126
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440126,
					"content": "テーマの異なる三つの演目をご用意しております。どうぞご自由にお楽しみください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440127
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440127,
					"content": "これと同じタイプのお知らせ用スピーカーを探し、その傍白の導きに従うことで、空想の地へと向かうことができます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440128
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440128,
					"content": "#なるほど！{NICKNAME}、これと同じスピーカーを探せばいいみたいだぞ、やってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440115,
					"content": "一緒に役者をやる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440110,
					"content": "ゲスト参加型の演劇とか。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				}
			]
		},
		{
			"id": 7904406,
			"completionStepIds": [
				7904405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904405",
							"2"
						],
						"stepId": 7904405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440601,
					"content": "うわっ！なんでこんなにシズクちゃんたちがうじゃうじゃいるんだ…みんなあのデカいマシンを囲んで、わちゃわちゃしてるみたいだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440602,
					"content": "いったい、どうなってるんだ？あのマシンはなんなんだろうな？それにダイアはどこにいるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440603,
					"content": "「三日空想」の舞台裏へようこそ！目の前の光景がいったい何を意味しているのか…あなたたちはきっと疑問に思っていることでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440604
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440604,
					"content": "その詳細を今からお見せいたします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440605
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440605,
					"content": "「サボり魔」、寝ないでください。早く一番のポジションへ行って、ニ番の操作をしてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440606
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440606,
					"content": "「運命の導きに心より感謝いたします。彷徨える旅人たち、よくぞ来てくださいました！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440607
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440607,
					"content": "あのシズクちゃんがスピーカーを操作して、録音された音声を…再生してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440608,
					"content": "オイラ…どこかで同じようなのを聞いた気がするけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440609,
						790440610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440609,
					"content": "最初のお知らせ用スピーカーで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				},
				{
					"id": 790440611,
					"content": "「皆勤王」、三番ポジションで七番の操作をお願いします！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440612
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440612,
					"content": "「新人の前に現れた一等航海士はボロボロになった服を着ていて、全身に包帯を巻いている。どうやら、少し前に激しい戦いに参加したようだ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440613
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790440613,
					"content": "思い出したぞ！これって「ブラッククリスタル号と金を呑む海獣」だ。オイラたちが一等航海士と最初に出会ったシーンでこの傍白が流れてた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440614,
					"content": "あのとき聞いた録音って、こうやって再生されてたのか…タイミングもバッチリだったよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440615,
					"content": "「あわてん坊」、「ブラッククリスタル」号があと少しで財宝近くの障害コースに到着します。早くセットと仕掛けを全部引き上げてください…絶対に間違えないように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440616
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440616,
					"content": "あのシズクちゃん、なにか目に見えない方法で…前の装置を操作してるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440617,
						790440618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440617,
					"content": "観察と放送、それから仕掛けの操作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440619,
					"content": "その通りです。この巨大なマシンの機能は、まさに演劇のすべてをコントロールするものとなります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440620
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440620,
					"content": "勤勉な水形幻霊たちが、演劇の進捗を逐一観察する…そしてゲストが所定の位置に着いた時、台本上の傍白を再生して、正しい仕掛けを起動させます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440621
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440621,
					"content": "ゲストが大人しく流れに沿って進んでいただければ、難なく「三日空想」の全公演を観賞することができるというわけです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440622
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440622,
					"content": "しかし、ゲストが途中下車したり、予期せぬ行為をなさったりした場合は、演劇を完全な状態でご体験いただくことが難しくなります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440623
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440623,
					"content": "当方の従業員は数が足りておらず、そういった状況があると対応いたしかねてしまうのが実情です…ですが、ゲストたちはきっちりとルールを守ってくださる方たちだと信じております！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440624
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440624,
					"content": "おお、すごいな！あの時は遊ぶことに集中してたから、舞台裏がこんな複雑になってるなんて想像もしてなかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440625,
					"content": "いま思い返してみると、演じてる間に起動しなきゃいけない仕掛けってすっごくたくさんあったし、演劇の制御ってかなり大変だったはずだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440626,
						790440627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440626,
					"content": "巧妙な設計だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440628,
					"content": "つまり…今こうしてオイラたちと話している声の主こそが、ダイアってことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440629,
					"content": "おまえがこの水形幻霊たちの力を借りて、演劇「三日空想」を実行してるんだな？どうして直接顔を見せて、オイラたちに説明しないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440630,
					"content": "気になって、聞きたいことがいっぱいだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440631,
					"content": "その推理は正しいですが、完全な正解ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440632
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440632,
					"content": "あなたたちが目にしているこの放送室のすべて——制御装置、「総監督」、「偽脚本家」、「サボり魔」、「皆勤王」、そして「あわてん坊」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440633
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440633,
					"content": "他にもまだ姿を見せていない、声を発していないながらも、演劇を支えている水形幻霊たちがいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440634
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440634,
					"content": "それらすべてをひとまとめにしたものが、この声——「ダイア」の正体です。「ダイア」は演劇を創作し、制御するコアとなるシステムであり、具体的な人間ではありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440635
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790440635,
					"content": "ダイアは人じゃなく…システム？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440636,
					"content": "待て待て、オイラの理解が追い付かなくなってきたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440637
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440637,
					"content": "シズクちゃんたちが賢いのは知ってるけど、本当にこいつらだけでこんな複雑な…システムを作れるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440638,
						790440639
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440638,
					"content": "背後に専門のデザイナーがいるはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440640,
					"content": "最初は確かにそうでした。そして、お客様が驚くのも想定の範囲内です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440641
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440641,
					"content": "少し長い話になりますが…この「ダイアの三日空想」は情熱溢れるゾシモス監督によって創られたものになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440642
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440642,
					"content": "監督が「ヴェルーリヤ·ミラージュ」に滞在していた時、大半の時間をこの一番素晴らしい舞台劇に注いでいました。他の演劇の準備をする余裕もないほどにです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440643
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440643,
					"content": "監督は水形幻霊たちとしばらく一緒に過ごしたことで、彼らに智慧と豊かな感情があることに気づきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440644
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440644,
					"content": "水形幻霊たちも監督の演劇が好きでした。そして、もっと多くの素晴らしい演劇を見届けたいと思うだけでなく、この喜びを他のゲストにもシェアしたいと望んだのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440645
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440645,
					"content": "こうして、ゾシモス監督の中にある一つの考えが芽生えました——水形幻霊たちに演劇をやらせる、ひいては演劇を創作させることはできないかと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440646
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440646,
					"content": "おおっ、突拍子もないアイデアだな！そんなのまるで…子どもたちに「監督のいろは」を教えるようなもんじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440647
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440647,
					"content": "確かに難しい部分があったのも事実です。しかし幸いなことに、全員が一致団結して頑張りましたので、すべての困難を乗り越えることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440648
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440648,
					"content": "ゾシモス監督は演劇が大好きな数体の水形幻霊へと重点的に教えました。そのおかげで、彼らも演劇の肝となる流れを掴めたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440649
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440649,
					"content": "幾度もの試行錯誤を経た後…監督は水形幻霊たちが理解できる言葉で、お手本となる演目を数本と、それから詳細な演劇創作マニュアルを作りました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440650
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440650,
					"content": "そしてイディア様の助けのもと、監督はこの制御装置を作り、装置と繋がっている仕掛けを各地に設置しました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440651
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440651,
					"content": "劇中のセリフ以外にも、ゾシモス監督はよく使う言葉を録音して残してくださっています。私たちはそれを正しく組み合わせることで、ゲストたちとのコミュニケーションが可能になりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440652
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440652,
					"content": "それから時間をかけて稽古をしていき、ついに私たちは三本のお手本演劇をそつなくこなせるようになったのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440653
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440653,
					"content": "それが「ブラッククリスタル号と金を呑む海獣」、「呪いの瞳に固まりて」、「セーブ·ザ·スカイタウン」となります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440654
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440654,
					"content": "つまり…ゾシモス監督は「ダイアの三日空想」ができる最低限の条件を整えて、良い感じの台本と詳細なマニュアルも作ったってわけか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440655
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440655,
					"content": "それを全部シズクちゃんたちが制御してたなんて、遊んでた時はまったく気づかなかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440656
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440656,
					"content": "お褒めいただきありがとうございます！ゲストが楽しめたことで私たちの努力も報われました。そして、いろんな仮説も実証できました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440657
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440657,
					"content": "そのため、あなたたちに手厚い謝礼を用意しております。また、創作の過程のすべてをシェアしたく存じます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440658,
						790440659
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440658,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440660,
					"content": "おう！特別なアトラクションで遊べたし、知らないことも知れたな。ありがとな、ダイア！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440661
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440661,
					"content": "ふふ！これから私たちは次の目標——自分たちだけで作品を作れるように頑張りたいと思います！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440662
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440662,
					"content": "そのためには取材を怠らず、「演劇」に対する理解を深めていかなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440663
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440663,
					"content": "私たちの一員である「偽脚本家」が、いろんなゲストの物語に耳を傾けて、アイデアを充実させることを担当しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440664
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440664,
					"content": "もちろん、ちょうど良いゲストに出くわせないこともあります。そういった時にはゲストとどんなことをしたのか、「偽脚本家」が他の水形幻霊に取材するのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440665
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440665,
					"content": "なるほど。つまり、オイラたちが「偽脚本家」に物語を話せば、おまえたちの演劇創作の助けになるってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440666
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440666,
					"content": "その通りです！お客様にお時間がありましたら、ぜひ「偽脚本家」とお話しいただけますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440667
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440667,
					"content": "そして、引き続き「ヴェルーリヤ·ミラージュ」をお楽しみいただき、たくさんの冒険をして、他の水形幻霊たちと交流していただけますと幸いです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440668
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440668,
					"content": "#心配しなくても大丈夫だぞ。オイラと{NICKNAME}はここがすごく気に入ってるからな！きっと、おまえたちにたくさん素材を提供できると思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440669
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440669,
					"content": "あっ、それからもうひとつ質問があるんだ…ずっと気になってたんだけどさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440670
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440670,
					"content": "「三日空想」の「三日」って、なにを意味してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440671
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440671,
					"content": "もしかして、ゾシモス監督が脚本を一本書き上げるのに掛かった時間が三日なのか？それとも、三本すべて書き終えるのに三日しか掛からなかったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440672,
						790440673
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440672,
					"content": "ははっ、それなら分かる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440674,
					"content": "「昨日」と「今日」と「明日」？なるほど、言われてみれば確かにそっか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440675
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440675,
					"content": "つまり、ゾシモス監督が…いや、「ダイア」のメンバー全員が毎日創作に専念して、すっごく頑張ってるってことだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440676
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440676,
					"content": "素晴らしい考え方です！しかし、それは身に余るお言葉でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440677
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440677,
					"content": "「三日」の本当の意味は——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440678
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440678,
					"content": "「まだ余裕な明日」と「調子がさらに良い明日」と「終わらせないとヤバい明日」です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440679
					],
					"speakerTitle": "ダイア"
				},
				{
					"id": 790440679,
					"content": "そ、そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790440673,
					"content": "「昨日」と「今日」と「明日」のこと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440659,
					"content": "楽しかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440639,
					"content": "台本をコントロールしてる人がいるはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440627,
					"content": "的確な連携だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440618,
					"content": "これらを制御する機能があれば十分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440610,
