			"trigger": {
				"objectNames": [
					"モーリィ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "くんくん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "モーリィ"
				},
				{
					"id": 741003102,
					"content": "ワンワン、いい人ですね。なでなでしてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "モーリィ"
				},
				{
					"id": 741003103,
					"content": "いいよ、モーリィ。なでなでしてあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "モーリィを撫でてあげた。\\n水でできているから湿っている。\\nでも、モーリィは嬉しそうだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "ワンワン、いい人、ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モーリィ"
				},
				{
					"id": 741003106,
					"content": "今度またなでてあげるよ、モーリィ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "バウ…モーリィが悪い犬だから、なでなでしてくれないのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "モーリィ"
				},
				{
					"id": 741003108,
					"content": "いいとか悪いとか関係あるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "ワンワン、いい犬はなでなでして、悪い犬は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "モーリィ"
				},
				{
					"id": 741003110,
					"content": "バウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "モーリィ"
				},
				{
					"id": 741003111,
					"content": "モーリィが悲しそうなのを見て、手を伸ばして撫でてあげた。\\n水でできているから湿っている。\\nモーリィの青い目にパッと輝きがよみがえった。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "ワンワン、なでなでしてくれてありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モーリィ"
				}
			]
		}
	]
