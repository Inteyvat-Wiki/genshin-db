		{
			"id": 7410025,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アル",
					"プティ·シュ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002501,
					"content": "プリンセス·リリスの宝物を取り戻すことができれば、正義陣営の勢力も「時間」と共に大きくなる。「ナルキッソス」を打ち破る…その勝利の日はもう目前だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002502
					],
					"speakerTitle": "アル"
				},
				{
					"id": 741002502,
					"content": "…そのためにも、ネイの犠牲を忘れてはならない。もし彼が宝物を隠していなければ、「ナルキッソス」はとっくに姫のいる塔を攻め落としていただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002503
					],
					"speakerTitle": "アル"
				},
				{
					"id": 741002503,
					"content": "うん、ネイお兄ちゃんはすごい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002504
					],
					"speakerTitle": "プティ·シュ"
				},
				{
					"id": 741002504,
					"content": "#ネイの努力も、{NICKNAME}の努力も無駄にしてはならない。みんなの助けがあれば、きっとプリンセス·リリスを救出できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002505
					],
					"speakerTitle": "アル"
				},
				{
					"id": 741002505,
					"content": "そうだね、プリンセス·リリスを救出できれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002506
					],
					"speakerTitle": "プティ·シュ"
				},
				{
					"id": 741002506,
					"content": "ああ、そうすれば、水仙十字王国は以前のようにきらきらと輝く姿を取り戻せる。姫はまた君を胸に抱いて、君のために毛繕いをし、小さなおでこをそっと撫でてくれるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002507
					],
					"speakerTitle": "アル"
				},
				{
					"id": 741002507,
					"content": "水辺で失われた思い出は再び戻り、友人たちはみな笑顔で姫の周りを取り囲む。何もかもが幸せで満ち足りて、争いも悩みもなくなるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002508
					],
					"speakerTitle": "アル"
				},
				{
					"id": 741002508,
					"content": "かつてのようにね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002509
					],
					"speakerTitle": "プティ·シュ"
				},
				{
					"id": 741002509,
					"content": "…そう、かつてのように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アル"
				}
			]
		},
		{
			"id": 7410026,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジェック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#ああ、お前か{NICKNAME}。リリスさんの宝物を取り戻した後、俺たちは勝利の鍵を手に入れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "ジェック"
				},
				{
					"id": 741002602,
					"content": "ついに侵入してきたよそ者を倒し、リリスさんを救うチャンスを得たのだ。となれば、「オーケストラ·ジェック」も音楽を奏でよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "ジェック"
				},
				{
					"id": 741002603,
					"content": "序曲の最終章を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "ジェック"
				},
				{
					"id": 741002604,
					"content": "まだ序曲なんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "む？もしやリリスさんを救出し、王国を再び救えば、それで何もかも「めでたし」だとでも思っているのか？甘いな！現実の世界はおとぎ話ではないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "ジェック"
				},
				{
					"id": 741002607,
					"content": "お前のような考えを持った浅はかなやつが多いからこそ、歴史は同じ失敗を繰り返すんだ。次は、根深い階級体制と分配方式を覆さないとならん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "ジェック"
				},
				{
					"id": 741002608,
					"content": "合理的で平等な世界では——ああ、言うまでもなく、平等はもちろん合理的な状態であって、リリスさんが目指す状態でもあるものだ。現状を考え、それを並べるのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "ジェック"
				},
				{
					"id": 741002609,
					"content": "お先に失礼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "俺たちはまず…に基づいて…を設立し…を覆すべきだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェック"
				},
				{
					"id": 741002605,
					"content": "もう少し洗練させたほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
		{
			"id": 7410031,
