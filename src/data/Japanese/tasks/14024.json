				]
			},
			"dialogs": [
				{
					"id": 140240201,
					"content": "「召使」と…タルタリヤ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240202,
					"content": "おまえ、スネージナヤに戻って休養してるんじゃなかったのかよ？どうしてまだフォンテーヌにいるんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240203,
					"content": "おっと、君たちか。まさかここで会えるとはね…ゲホッ、ゴホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240204
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240204,
					"content": "原始胎海を離れてから、俺は長いこと意識を失ってた。再び目を覚ました時、スネージナヤに送られる途中だと気付いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240205
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240205,
					"content": "でも、フォンテーヌでまだやり残したことがあるのに…そのまま帰るわけにはいかないだろ？それで無理やり起き上がって、一人で帰ってきたのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240206
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240206,
					"content": "ん？やり残したことってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240207,
					"content": "「スカーク」…俺の師匠に関することさ。師匠にもう一度会いたかったんだけど、戻ってきた頃には、師匠はいなくなってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240208
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240208,
					"content": "でも、まだ聞きたいことが山ほどあるから、仕方なく「召使」に師匠の行方を調べてもらってたんだ。フォンテーヌにいたからには、何か手がかりを残しているはずだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240209
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240209,
					"content": "なるほどな。それで、手がかりは見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240210,
					"content": "壁炉の家はあらゆる方面の事情に通じているが——残念ながら、そのような存在を前にしてはどうしようもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240211
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240211,
					"content": "結局、師匠はまだ俺に会う必要はないって考えてるんだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240212
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240212,
					"content": "でも、簡単に解決する話さ。俺がもっと強くなればいい…ゴホッ、ゲホゴホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240213
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240213,
					"content": "怪我を治してからにしろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240214,
					"content": "ハハッ、もうだいぶ治ったんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240215
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240215,
					"content": "壁炉の家のおかげさ。あのアイロワールって子が変な薬を飲ませてくれてね。全身が痛くなったけど、回復スピードは確かに速まったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240216
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240216,
					"content": "でも、今度こそ本当にお別れだ。爺さんから催促が来たんだ。帰って計画に参加しろってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240217
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240217,
					"content": "「厳冬計画」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240218
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240218,
					"content": "そうだ。はぁ、それから「富者」のことも。帰ってあいつの長話なんて聞きたくないよ。何とかして、もうちょっとフォンテーヌにいさせてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240219
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240219,
					"content": "やっぱり、リネたちに武芸を教えるほうが面白いんだよね。まあ、君が手合わせしてくれたらもっといいんだけど。君の全力はまだ見せてもらったことがないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240220
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240220,
					"content": "フン、随分虫のいいことを言う。まあ——私もじきにここを離れる。我々もその計画の一部なのでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240221
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240221,
					"content": "それに、スネージナヤに残っている富豪や要人に呼びつけられるというのも、一種の「栄誉」なんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240222
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240222,
					"content": "ハハッ…勘弁してくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240223
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240223,
					"content": "なんかこの二人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240224,
					"content": "堂々と同僚の陰口…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240225
					]
				},
				{
					"id": 140240225,
					"content": "それで、壁炉の家のお客人たち。私に何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240226
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240226,
					"content": "えっと…その…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240227,
					"content": "壁炉の家のお父様についてもっと知りたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240228
					]
				},
				{
					"id": 140240228,
					"content": "そうだぞ！リネたちのことはよく知ってるけど、おまえのことはまだよく知らないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240229,
					"content": "そうかな？ちゃんと自己紹介した記憶があるが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240230
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240230,
					"content": "あんな軽い自己紹介になんの意味があるっていうんだ？なんで「お父様」を自称してるのかくらい、教えてくれよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240231,
					"content": "おっと、いい質問だね！俺も知りたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240232
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240232,
					"content": "君たちが知らないということは、こちらの情報工作が上手くいっているという証拠だね。このまま続けておくべきのようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240233
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240233,
					"content": "さすが外交官、こっちの攻勢をいとも簡単に躱すとはね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240234
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240234,
					"content": "他に用がなければ、私は先に帰らせてもらう。まだ処理しなければならない厄介事が家にあるのでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240235
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240235,
					"content": "えっ…ちょっ！ちょっと待ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240236,
					"content": "（「召使」がこのまま帰ったら、リネとクリーヴに鉢合わせちゃうかも…！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240237
					]
				},
				{
					"id": 140240237,
					"content": "（リネのマジックバードを飛ばす？いや…その前に、別の話題を探してみよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240238,
						140240239
					]
				},
				{
					"id": 140240238,
					"content": "壁炉の家について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240240
					]
				},
				{
					"id": 140240240,
					"content": "ほう、その質問は俺も少し気になるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240241
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240241,
					"content": "壁炉の家の子供たちと接触したことがあるけど、みんないい子だね。彼らを見てると、トーニャとテウセルのことを思い出すよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240242
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240242,
					"content": "もし君が彼らを「裏切ったら」、必ず君のところに戦いに来るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240243
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240243,
					"content": "どうして私が彼らを裏切らねばならないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240244
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240244,
					"content": "「壁炉の家」を裏切ったことがあると聞いたんだ。本当かどうかは分からないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240245
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240245,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240246
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240246,
					"content": "まあいいか、白状するよ。爺さん…つまり「雄鶏」が教えてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240247
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240247,
					"content": "（裏切る…もしかして、クリーヴの言ってたことは本当なの？「召使」は、壁炉の家の子供たちを実験体として扱ってる…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240248
					]
				},
				{
					"id": 140240248,
					"content": "お、おまえ…子供たちになにか悪いことをしたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240249
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240249,
					"content": "私のしたことよりも、偉大なる「雄鶏」殿が、私をどう評価してくれているのか聞きたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240250
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240250,
					"content": "そうだな…「仲間」を数多く始末して、挙句の果てに「家族」にまで手を出した、とかか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240251
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240251,
					"content": "ほう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240252
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240252,
					"content": "その様子じゃ、あれは嘘なんだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240253
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240253,
					"content": "いや——表現はあまり気に入らないが、ほぼ事実だと言えるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240254
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240254,
					"content": "厳密に言うと…それはある種の偏見なのだが、今弁明するつもりはない。偏見は真実を隠してくれる…これは、私にとっては好都合だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240255
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240255,
					"content": "私はよく「フォンテーヌ人」だと名乗るが、実際はただフォンテーヌで育ったというだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240256
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240256,
					"content": "えっ？？お、おまえ、フォンテーヌ人じゃなかったのか？じゃあ、どうしてフォンテーヌを危機から助けたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240257
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240257,
					"content": "フォンテーヌで何かをするなら、この身分のほうが役に立つからだ。下心があるんじゃないかと疑われることもない。誰もが故郷を救いたいと思うだろう？ただし、私が本当に守りたかったのは、フォンテーヌ出身のあの子たちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240258
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240258,
					"content": "原始胎海は私には何の影響もないが、壁炉の家には損害をもたらすだろう。この情報で君たちの好奇心が満たされるといいんだがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240259
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240259,
					"content": "（「召使」は積極的に自分の秘密を話し、話題を「壁炉の家を裏切った」ことから逸らした。どうやらまだ自分の過去に触れたくないようだ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240260
					]
				},
				{
					"id": 140240260,
					"content": "子供たちのためにフォンテーヌに残ったのなら、裏切ることもないだろう…俺が穿ちすぎだったな。悪かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240261
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240261,
					"content": "言っただろう。それはむしろ好都合なのだと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240262
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240262,
					"content": "それはそうと、壁炉の家で療養してる間に…すごく興味をそそられる話を聞いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240263
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240263,
					"content": "壁炉の家では、家族間でトラブルが起きたら、ケンカして負けたほうが譲るそうじゃないか。それって、正々堂々と手合わせができるってことかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240264
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240264,
					"content": "それはここ数年の話だね。もっと昔なら、そんなにいい話ではなかった——負けたほうがすべてを失うんだ、自分の命もね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240265
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240265,
					"content": "危なすぎだろ！変わってよかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240266
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240266,
					"content": "今の雰囲気は気に入ってるよ。それどころか…ちょっぴり羨ましいくらいだ。君にはこんなに沢山家族がいて、一緒に暮らせるんだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240267
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240267,
					"content": "家族が多すぎると、ケンカやいざこざが多くなる。トーニャやテウセルが反抗期に入ったら、その気持ちが分かるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240268
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240268,
					"content": "想像してみるといい。テウセルが「雄鶏」のひげを抜くのにハマり、トーニャが自分の髪を四十二色に染める…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240269
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240269,
					"content": "ストップ。完全に理解したよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240270
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240270,
					"content": "トーニャとテウセルの話になると、タルタリヤの話は尽きない。彼は饒舌に話し始めた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240271
					]
				},
				{
					"id": 140240271,
					"content": "いつもなら最後は眠っていたかもしれないが、今回は時間を稼いでくれたタルタリヤに心から感謝した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240272
					]
				},
				{
					"id": 140240272,
					"content": "あっという間にもうこんな時間だ、そろそろ行かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240273
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240273,
					"content": "旅人、パイモン。次はどこで会えるか分からないけど、機会があったらまた勝負しよう…ゲホッ、ゲホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240274
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240274,
					"content": "だから、まずは怪我を治せって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240275
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240275,
					"content": "ああ。それと、今回はありがとうな、アルレッキーノ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240276
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240276,
					"content": "礼を言う必要はない、神の心が手に入ったのは君のおかげでもあるのだから。お互い、貸し借りなしだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240277
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240277,
					"content": "それも悪くないか。それじゃ、また。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240278
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 140240278,
					"content": "オイラたちも行こうぜ…おまえも一緒に帰るか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240279
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240279,
					"content": "何だ、早く帰ってほしいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240280
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240280,
					"content": "えっ…それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240281
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240281,
					"content": "風が気持ちいいんだ。ここに残ってちょっと考え事をすることにする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240282
					],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240282,
					"content": "大したお構いができず、申し訳なかったね。良い夜を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「召使」"
				},
				{
					"id": 140240239,
					"content": "壁炉の家をどう思ってる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240240
					]
				}
			]
		},
		{
