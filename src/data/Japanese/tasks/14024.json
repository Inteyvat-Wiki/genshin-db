					{
						"sceneId": 3,
						"position": [
							2806.94,
							362.234,
							4147.252
						],
						"pointId": 340300432
					}
				]
			},
			"dialogs": [
				{
					"id": 140240301,
					"content": "リネ！どうだった？なにか進捗はあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240302,
					"content": "話すと長くなるんだけど、こっちはちょっとトラブルがあってね——クリーヴは日差しの当たるところには行けないみたいなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240303
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240303,
					"content": "どういうこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240304
					]
				},
				{
					"id": 140240304,
					"content": "僕は彼女を連れて、地上まで行った。そこまでは順調だったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240305
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240305,
					"content": "でも、影になっているところから日向へと踏み出した瞬間…突然、彼女の姿が消えたことに気づいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240306
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240306,
					"content": "振り向くと、彼女は影のすみっこに立ったまま、静かに僕を見つめてた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240307
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240307,
					"content": "あいつ、日差しが苦手なのか？いや、でも…もしそうだったら「日差しの下で暮らしたい」なんて言うはずないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240308,
					"content": "えっと…あいつの背中を押してみたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240309,
					"content": "押せるなら亡霊とは言わないでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240310
					]
				},
				{
					"id": 140240310,
					"content": "それもそうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240311,
					"content": "とにかく、色んな方法を試してみたけど、どれもうまくいかなかった。そのうち太陽が沈んできたから、結局連れ戻るしかなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240312
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240312,
					"content": "リネット、そっちはどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240313
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240313,
					"content": "名簿は手に入れた。ここ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240314
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140240314,
					"content": "本当か？オイラに見せてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240315,
					"content": "こんなに沢山あるのか！全部読むのに一体どれだけかかるんだよ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240316,
					"content": "手分けして読もう、ちょっとずつね——はい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240317
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240317,
					"content": "ラ·プイヤード…ランドワード…ジャン·ベル…オレール",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240318,
					"content": "うわっ…このオレールってやつ、顔にすっごい傷跡があるぞ。なんか恐そうなやつだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240319,
					"content": "あっ、その人となら話したことあるよ。ある任務で怪我をしてたんだけど、その時は好きな人に嫌われちゃうって冗談を言ってたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240320
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240320,
					"content": "おまえはどう返したんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240321,
					"content": "好きな人がいるのって聞いたら、いないって言われて、それでおしまい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240322
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240322,
					"content": "でも、その後彼は本当に誰かを好きになったらしい。その人のために家から逃げ出そうとしたけど、その目論見は成功しなかった。ある日、彼は「お父様」に呼び出されて…それ以来、二度と会ってない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240323
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240323,
					"content": "つまり、あいつは「召使」に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240324,
					"content": "残酷だけど、それが家のルールだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240325
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240325,
					"content": "壁炉の家では誰もが多くの秘密を握ってる。だから、裏切りは許されない。家から出たければ、命を代価として差し出さないといけないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240326
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240326,
					"content": "みんなは重い気持ちで処刑名簿を読み終えたが、その中にクリーヴの名前はなかった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240327
					]
				},
				{
					"id": 140240327,
					"content": "ないね…でもそれも無理ないか。この名簿は不完全で、直近の五年間のものしか載ってないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240328
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240328,
					"content": "別の方向から調べよう。フレミネ、何か分かったかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240329
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240329,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240330
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 140240330,
					"content": "フレミネ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240331
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240331,
					"content": "ごめん、考え事してた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240332
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 140240332,
					"content": "他の人たちと話してみたんだけど、家の雰囲気がちょっと変だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240333
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 140240333,
					"content": "変？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240334
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140240334,
					"content": "うん。実はこの間、家で大きな論争があって…例えばシャプローとフィリオールの間とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240335
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 140240335,
					"content": "物資を配ってた時に会ったやつらか？確かにあいつらって、雰囲気も話題も全然違ったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240336,
					"content": "簡単なことさ。「お父様」は僕たちを壁炉の家に連れてきて、知識と武芸を授けてくださったけど…誰もが心からここに残りたいと思ってるわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240337
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240337,
					"content": "壁炉の家に入った僕たちは自動的に「ファデュイ」としてラベリングされるけど、多くの人にとって、それは堂々と口にできる身分じゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240338
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240338,
					"content": "成長するにつれ、一部の人は別の考えを抱くようになる。でも、壁炉の家には「ルール」があるから、口に出すのは憚られる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240339
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240339,
					"content": "シャプローやフォルツは「お父様」を認めて支持しているし、ファデュイであることを誇りに思ってるけど、フィリオールやナントゥイユにとって、そういう気持ちはずっと希薄だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240340
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240340,
					"content": "こんなトラブルは常に存在し続けてる。もちろん、「お父様」も知ってるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240341
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140240341,
					"content": "でも、その…なんだか状況が深刻になった気がするんだ。フィリオールたちは…こっそり集まって、何かを話してるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240342
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 140240342,
					"content": "あくまでぼくの推測だけど、彼らはクリーヴに会ったことがあるんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240343
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 140240343,
					"content": "クリーヴが彼らを扇動してると思うのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240344
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240344,
					"content": "それはないと思うけど…もしかしたら、クリーヴはみんなに「誰も知らない家の闇」を教えたのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240345
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 140240345,
					"content": "ぼくもクリーヴから聴いたんだ。子供たちを実験体にしてるとか、力を持たない人は戦場に出されるとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240346
					],
					"speakerTitle": "フレミネ"
				},
				{
					"id": 140240346,
					"content": "フィリオールたちはその話を信じたのかい？まったく証拠のないことだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240347
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240347,
					"content": "信じたとは限らないと思う——でも、いい口実ができた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240348
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140240348,
					"content": "はぁ…やっぱり根本的な原因は「厳冬計画」なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240349
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240349,
					"content": "ちょっと、ゆっくり話してくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240350
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240350,
					"content": "「召使」も「厳冬計画」って言ってたけど、それはいったいなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240351
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240351,
					"content": "ごめん…僕も詳細は知らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240352
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240352,
					"content": "ファトゥスの「雄鶏」と「富者」が手を組んで推し進めてる計画で、ファデュイのこれからの戦略に関わってるってことだけ、「お父様」から聞いた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240353
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240353,
					"content": "神の心を無事手に入れたおかげで壁炉の家は認められて、「厳冬計画」でとても重要な仕事を割り振られた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240354
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240354,
					"content": "それっていいことじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240355
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240355,
					"content": "「重要」というのは「危険」に等しい。僕たちにとってはかなり困った事態なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240356
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240356,
					"content": "「お父様」も相当悩まされてるけど、それでも断れない。彼らの計画は合理的だし、僕たちに巨額の経費を与えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240357
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240357,
					"content": "でも…この計画を実行するとなると、こちらは多くの犠牲を払うことになる。これもある意味「制圧」なんだろう。彼らは情報を扱う部署をコントロールできないことに不安を感じてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240358
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240358,
					"content": "（ファデュイの内部は何かを企んでるようだが、リネたちはそれについて詳しく知らないようで、多くの情報を聞き出せなかった。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240359
					]
				},
				{
					"id": 140240359,
					"content": "（これからファデュイと接触する時は、よく観察してみよう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240360
					]
				},
				{
					"id": 140240360,
					"content": "ファデュイの内部がそんなに複雑な状況だとは思わなかったぜ。でも、それがおまえの家で起こってるトラブルとなんの関係があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240361
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240361,
					"content": "外部からの刺激は、内部の対立を激化させる。死の恐怖に心が押しつぶされると、一部の人は間違った行動を取ってしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240362
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240362,
					"content": "クリーヴの件を解決すれば、すべてが元通りになると思ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240363
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240363,
					"content": "今の状況は思ってた以上に厄介だ。もしフィリオールたちをこのまま放っておいたら、「お父様」は遅かれ早かれ手を下すだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240364
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240364,
					"content": "お兄ちゃん、私たちは目の前のことに集中するしかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240365
					],
					"speakerTitle": "リネット"
				},
				{
					"id": 140240365,
					"content": "うん、それもそうだね。今からフィリオールたちを訪ねても、すぐに成果が得られるわけじゃないし、むしろ逆効果だ。とりあえず、まずはクリーヴを送り出す方法を考えよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240366
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240366,
					"content": "もう遅いから、ひとまず戻って休もうか。明日、日が昇ったらすぐに出発だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240367
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240367,
					"content": "リネット、今回は僕と一緒に来て。フレミネ、フィリオールたちが間違ったことをしないように、見張りを頼むよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240368
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 140240368,
					"content": "今日はみんなお疲れ様、明日もよろしくね。おやすみ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネ"
				}
			]
		},
