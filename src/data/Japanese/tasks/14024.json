			},
			"dialogs": [
				{
					"id": 140240413,
					"content": "色んなことが頭から離れず、なかなか眠りにつくことができない…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 140240401,
					"content": "ふぁ…早く寝ないとなのに、全然眠れないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240402,
					"content": "もし「召使」がリネたちのやったことを知ったら、怒るかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240403,
					"content": "あいつ、笑ってるだけでも怖いのに…もし怒ったら…ううぅ、絶対にオイラのことを守ってくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240404,
						140240406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240404,
					"content": "#実は{M#俺}{F#私}もちょっと怖い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240405
					]
				},
				{
					"id": 140240406,
					"content": "#{M#俺}{F#私}の後ろに隠れてればいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240407
					]
				},
				{
					"id": 140240405,
					"content": "おまえもそう思うのか？じゃ、じゃあ、その時は一緒に逃げようぜ！リネたちを連れて、できるだけ早くさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240407,
					"content": "へへっ、やっぱりおまえは頼りになると思ってたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240409
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240409,
					"content": "お、おい！あっちを見ろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240410,
						140240411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240410,
					"content": "クリーヴ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240412
					]
				},
				{
					"id": 140240411,
					"content": "どうして外に出てきたの！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240412
					]
				},
				{
					"id": 140240412,
					"content": "誰かに見つかったらまずいぞ…急いで追いかけよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
