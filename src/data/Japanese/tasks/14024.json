				},
				{
					"id": 140240602,
					"content": "しーっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240603
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240603,
					"content": "誰も見ていないうちに、窓を開けたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240604
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240604,
					"content": "ほら見て、外の景色が綺麗でしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240605,
						140240606
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240605,
					"content": "窓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240607
					]
				},
				{
					"id": 140240607,
					"content": "残念だけど、それが私にできる限界なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240608
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240608,
					"content": "あなたたちから見て、私のしたことって馬鹿馬鹿しいでしょ？希望の見えない抵抗を続けるよりも、美しい夢の中で生きるほうが楽だもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240609
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240609,
					"content": "クリーヴ、一体なにを知ってるんだ？ちゃんと説明してくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240610,
					"content": "いいわ。聞いたら、後悔するかもしれないけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240611
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240611,
					"content": "私を含めて、この家にいる人はみんな、ただの「道具」や「消耗品」に過ぎないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240612
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240612,
					"content": "利用価値のある者は生かされ、価値のない者は「博士」の実験体にされる。死んだほうがマシという人をどれだけ見てきたか…もううんざりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240613
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240613,
					"content": "それって全部「召使」がやったことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240614,
					"content": "そんなこと…ないだろ？確かに怖くみえるけど、そこまで悪いやつとは思えないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240615,
					"content": "うん、信じてもらえないって分かってたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240616
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240616,
					"content": "みんな彼女をいい人だと思ってた。彼女こそが本当の「お母様」だって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240617
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240617,
					"content": "「お母様」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240618,
					"content": "でも彼女はその呼び名を汚した。できることなら、もう二度と顔も見たくないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240619
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240619,
					"content": "ああ…ペルヴィがここにいてくれればいいのに。あの子ならきっとこの気持ちを理解してくれるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240620
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240620,
					"content": "ペルヴィ…またその名前か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240621,
					"content": "なあ、なんか変な感じがしないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240622,
					"content": "オイラたちの会話、なんだかかみ合ってない気がするんだ。クリーヴは本当にオイラたちと話してるのか？それとも、オイラたちを他の人だと勘違いしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240623,
						140240624
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240623,
					"content": "#{M#俺}{F#私}も分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240625
					]
				},
				{
					"id": 140240625,
					"content": "だよな。でもまあ、なにかオイラたちに打ち明けたいみたいだし、もう少し付き合ってやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240626,
					"content": "こんなに小さいのに、心の中で色々考えてるみたいだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240627,
					"content": "風だわ。そろそろ窓を閉めないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240628
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240628,
					"content": "月が綺麗でしょ？あのね、あなたたちにだけ教えてあげる…スネージナヤの夜のオーロラは、今夜の月よりも綺麗なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240629
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240629,
					"content": "見てみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240630
					]
				},
				{
					"id": 140240630,
					"content": "大人になったら一緒に見に行こうって、ペルヴィと約束したのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240631
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240631,
					"content": "でも最近ペルヴィの姿が見えないの。まさかあの子も…ううん、だってあの子は「特別」だもの。ペルヴィはお母様に気に入られてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240632
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240632,
					"content": "お母様と話さなくちゃ。でも喧嘩したばかりだから会ってくれないと思うし…私もお母様に会う勇気がない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240633
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240633,
					"content": "どうすればいいのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240634
					],
					"speakerTitle": "クリーヴ"
				},
				{
					"id": 140240634,
					"content": "そう言ったきり、クリーヴは立ち尽くしたまま、考え込むように沈黙した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240635
					]
				},
				{
					"id": 140240635,
					"content": "しばらくして、彼女はようやく我に返ったようだった。弱々しい笑みを浮かべると、一人で帰っていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140240636
					]
				},
				{
					"id": 140240636,
					"content": "ふぅ…なにを考えてるのか、全然わからないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140240637
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240637,
					"content": "オイラたちも帰ろうぜ。明日は早起きしないといけないしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 140240624,
					"content": "理解を超えた「亡霊」という存在だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240625
					]
				},
				{
					"id": 140240606,
					"content": "ここには何もないけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140240607
					]
				}
			]
		}
	]
}