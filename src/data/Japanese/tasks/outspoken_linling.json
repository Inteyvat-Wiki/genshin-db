					"霖鈴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "うーん…やっぱり現地取材した方がいいのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "霄灯に書けそうな言葉を考えてたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360104,
					"content": "海灯祭って、みんな願い事とか祝福とかを霄灯に書いて飛ばすでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360105,
					"content": "だから、祭りの雰囲気に合わせるために、願い事とか祝福の言葉を…なんというか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360106,
					"content": "「華やか」な言葉に…したいらしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360107,
					"content": "碧波と梟総管と徳貴から頼まれて、「華やか」な祝福の言葉を霄灯に書いてあげないといけないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360108,
					"content": "でもここでずっと考えてても、良い言葉が思い浮かばない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360109,
					"content": "だから、まずは霄灯を準備して、その人たちを観察してから言葉を作ろうと考えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360110,
					"content": "でも私は霄灯を作れないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360111,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "そうなの？じゃあ、霄灯を3つお願いできる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360114,
					"content": "その後で現地取材して、どんな言葉がいいか決めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360115,
					"content": "えへへ、ちょっといいのを思いついたよ。これでもう少しインスピレーションがあれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360112,
					"content": "霄灯を作るのは得意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
