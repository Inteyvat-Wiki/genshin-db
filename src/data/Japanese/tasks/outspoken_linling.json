					"霖鈴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360401,
					"content": "梟総管はそこにいるね、ここから観察してみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360402,
					"content": "梟総管に対する印象は深く残ってるから、彼の分は簡単にできたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360403,
					"content": "今読んであげる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360404,
					"content": "「クソじじい気性荒い」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360405,
					"content": "え！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "「それでも温かい心を持つ」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360408,
					"content": "ん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "お題は…「やっぱいい人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360411,
					"content": "どう、似合ってるでしょ。梟総管見た目は怖そうだけど実はいい人なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360412,
					"content": "他のはないの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "あるにはあるけど、まだ下の句が思いついてないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360414,
					"content": "君が考えてくれるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360415,
					"content": "上の句は「若者に、仏頂面を見舞いして」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360416,
					"content": "「風吹けば、冬眠のように穏やかに」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "いい感じなんだけど…お題がまだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360418,
					"content": "えっと…「山の如く安し」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "あっ！意外と才能あるじゃん。凄くいいと思う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360420,
					"content": "じゃあこれを霄灯に書いてっと、ちょっと待ってて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360421,
					"content": "よし、できた。この霄灯を梟総管に渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360409,
					"content": "一旦やめようか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "ちょっと待って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
		{
			"id": 4133605,
