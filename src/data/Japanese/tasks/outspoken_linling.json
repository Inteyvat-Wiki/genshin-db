					"梟総管"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360501,
					"content": "霖鈴か、何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "梟総管"
				},
				{
					"id": 413360502,
					"content": "この前引き受けた霄灯に使う言葉、旅人と一緒に考えたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360503,
					"content": "はい、もう霄灯に書いてあるから。あげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360504,
					"content": "ありがとう、どれどれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "梟総管"
				},
				{
					"id": 413360505,
					"content": "「若者に、仏頂面を見舞いして」、「風吹けば、冬眠のように穏やかに」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "梟総管"
				},
				{
					"id": 413360506,
					"content": "「山の如く安し」…ははっ、悪くないな、感謝するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "梟総管"
				},
				{
					"id": 413360507,
					"content": "どういたしまして、中にもう一つ入ってるよ、今読んで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360508,
					"content": "次の人を探しに行こう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360510
					]
				},
				{
					"id": 413360510,
					"content": "あっ、そうだね…じゃあ次は徳貴のところに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360511
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360511,
					"content": "徳貴に用意した言葉は、私の自信作なんだ。後で教えてあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360509,
					"content": "まだ送ってない霄灯が残ってる！",
					"roleType": "TALK_ROLE_PLAYER",
