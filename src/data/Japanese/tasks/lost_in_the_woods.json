					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000904,
					"content": "#へへ、すごく気に入ったみたいだぞ。さてと、ナタでおまえの謎が解けるといいんだけどな。{NICKNAME}が急に龍の体の中に入っちゃったことも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000905,
					"content": "聞き忘れてたけど、急に龍になっちゃうなんて、大丈夫だったのか？気分が悪くなったりしてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000906,
					"content": "龍酔いしちゃった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "龍酔いってなんだよ！冗談言ってる場合じゃないだろ。もう次は心配してやらないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000910,
					"content": "でも、「ナタには龍になれるやつがいる」なんて聞いたことないよな…ちょっと変だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000911,
					"content": "やっと着いたばかりなのに、色々起こりすぎだぞ。とにかく、次はどうやってここから出るかってことだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000912,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "おっ？どこから出ればいいか、知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000908,
					"content": "龍になるのも悪くなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000909
					]
				},
				{
					"id": 750000909,
					"content": "ならいいけど…もし龍になって元に戻れなくなっちゃったら、大変なことになるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "パイモン"
				}
