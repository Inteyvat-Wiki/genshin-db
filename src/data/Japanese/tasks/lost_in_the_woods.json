				},
				{
					"id": 750000602,
					"content": "キュン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000603
					],
					"speakerTitle": "「ちび」？"
				},
				{
					"id": 750000603,
					"content": "ど、どうしたんだ？なんだか具合が悪そうだぞ。もしかしてさっき、あのバリアから落ちた時にしっぽをぶつけちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000604,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000605
					],
					"speakerTitle": "「ちび」？"
				},
				{
					"id": 750000605,
					"content": "手当てができたらよかったんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000606
					]
				},
				{
					"id": 750000606,
					"content": "へへっ、オイラの出番だぜ…おまえのバッグはものが多すぎて、探すのが大変だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000607,
					"content": "「パイモンの応急バッグ」にある、このスカーフで手当てするのはどうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000608,
					"content": "パイモンのバッグって、一体どこに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000609
					]
				},
				{
					"id": 750000609,
					"content": "ふん、いつもは簡単には見つからない場所に隠してあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000610,
					"content": "それで、使うのか使わないのか、どっちなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000611,
					"content": "使うよ、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000612
					]
				},
				{
					"id": 750000612,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000613
					],
					"speakerTitle": "「ちび」？"
				},
				{
					"id": 750000613,
					"content": "ちび、じっとしててくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000614,
					"content": "へへっ、こいつ、案外おとなしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000615,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000616,
					"content": "これでよし。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000617
					]
				},
				{
					"id": 750000617,
					"content": "どうだ、ちび。ちょっとは楽になったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000618,
					"content": "クルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000619,
					"content": "よし、元気になってくれたな…ほっとしたぜ。でも、なんであんなバリアの中に閉じ込められてたんだ？それに、あの獣域ハウンドも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000620,
					"content": "キュ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000621,
					"content": "おまえもわからないのか。ま、たとえわかったとしても、「キュンキュン」じゃ伝わらないしな…とにかく、もう大丈夫だから家に帰っていいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000622,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000623,
					"content": "えっ、まさか自分の家がどこにあるかわからないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000624
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000624,
					"content": "じゃあ、家族は？あっ、もしかしてさっきの大きいのが…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000625,
					"content": "#どうしよう、{NICKNAME}…こいつを一人、いや一匹、ここに残していくわけにはいかないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000626,
					"content": "キュン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000627
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000627,
					"content": "とりあえず連れていこうか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000628
					]
				},
				{
					"id": 750000628,
					"content": "おう、ナタでこいつの家族に会えるかもしれないしな…まだこいつと同じようなやつは見たことないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000629,
					"content": "「龍に…選ばれし者…」って、まさか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000630
					]
				},
				{
					"id": 750000630,
					"content": "へえ…そんな言葉が聞こえたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000631
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000631,
					"content": "そういえば、ナタって龍の国なんだよな。じゃあ、もしかして、こいつも…そうなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000632
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000632,
					"content": "キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000633
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000633,
					"content": "そう考えてみると、龍の眷属のヴィシャップに似てる感じもするよな。二本足だし、しっぽもあるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000634,
					"content": "キュウ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000635,
					"content": "連れてくのはいいけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000636
					]
				},
				{
					"id": 750000636,
					"content": "この子の意見も聞かないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000637
					]
				},
				{
					"id": 750000637,
					"content": "それもそうだな。ちび、オイラたちと一緒に旅してくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000638
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000638,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000639
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000639,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000640
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000640,
					"content": "#へへっ、いいってさ。えっと、オイラはパイモンで、こいつは{NICKNAME}だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000641
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000641,
					"content": "キュイオン？キュキュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000642
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000642,
					"content": "そうだ、ちびにも名前を付けてやらないとな…じゃあ…おなかのとこが真ん丸で黄色いから、「ハッシュドポテト」にしようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000643
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000643,
					"content": "グル…グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000644,
						750000646
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000644,
					"content": "鹿狩りでなら人気が出そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000645
					]
				},
				{
					"id": 750000645,
					"content": "なんだよ、他の場所じゃダメって言いたいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000647
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000647,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000648
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000648,
					"content": "#{NICKNAME}に名前を付けてほしいのか？こいつのネーミングセンスは…よくわからないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000649,
						750000650
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000649,
					"content": "いつも普通の名前を付けてるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000650,
					"content": "可哀想…そういう名を授かる運命なんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000646,
					"content": "気に入らないみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000647
					]
				}
			]
		},
