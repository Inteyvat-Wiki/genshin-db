			"dialogs": [
				{
					"id": 750000101,
					"content": "おい、おい…大きいの、大丈夫か？立てるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000102,
					"content": "なんか弱ってるみたいだぞ。まったく、一体なにがあったんだよ…あの飛んでる幽霊犬って本当に嫌なやつだぜ。やっぱり飛んでるやつにはロクなのがいないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000103,
					"content": "パイモンも飛んでるじゃん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "オイラはあいつらとは違うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000105,
					"content": "#そんなことより{NICKNAME}、早くなにか食べられる物を探してやろうぜ。そんで、ちゃんと休ませるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000106,
					"content": "そしたら、きっと元気になるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000107,
					"content": "もう手遅れだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "そんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000110,
					"content": "…グル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "大きいの？"
				},
				{
					"id": 750000111,
					"content": "うぅ…きっとすごく痛いんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000112,
					"content": "敵はもう倒したよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "…グルル。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "大きいの？"
				},
				{
					"id": 750000115,
					"content": "まだ…心残りがあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "何か…伝えようとしてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "…さあ…その手をのばすがいい。龍に…選ばれし者…手を…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "…力を集結し、すべてを見届け…そしてすべてを解放せよ…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#{NICKNAME}、どうしちゃったんだよ！早くなんとかしてくれよ。ボーっとしてる場合じゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000120,
					"content": "なんでもない。でも一瞬何か見えたかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000121
					]
				},
				{
					"id": 750000121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000122
					],
					"speakerTitle": "大きいの？"
				},
				{
					"id": 750000122,
					"content": "…ガゥ…ガルル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000123
					],
					"speakerTitle": "大きいの？"
				},
				{
					"id": 750000123,
					"content": "#それは{M#君}{F#あなた}の願い？それとも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000124
					]
				},
				{
					"id": 750000124,
					"content": "（瀕死の生き物に手を伸ばす…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000125
					]
				},
				{
					"id": 750000125,
					"content": "おい、なにしてるんだ…えっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000126,
					"content": "#{NICKNAME}、おまえ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750000113,
					"content": "ほら、休んでていいよ…よく頑張ったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000108,
					"content": "ずっとしんどかったんだろうね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				}
			]
