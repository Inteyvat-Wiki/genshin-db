					}
				]
			},
			"dialogs": [
				{
					"id": 746720101,
					"content": "あれ？シャルロットじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720102,
					"content": "レピーヌ·ポーリーンとなにか話してるみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720103,
					"content": "お、お願いです、シャルロットさん！いや、シャルロット様…お願いですから、冗談だと言ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720104
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720104,
					"content": "「プクプク獣の変装をし、警備ロボの目を逃れ、犯罪へ」…この事件は事実ですよね！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720105
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720105,
					"content": "「画像認識」技術のために、私は貯金を使い果たしたうえ、銀行から大金を借りたんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720106
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720106,
					"content": "この通り、土下座でもしますから！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720107
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720107,
					"content": "レピーヌ·ポーリーンさん、落ち着いてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720108
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720108,
					"content": "研究に対するあなたの熱い思いと…えーっと…大口発注への渇望は理解できますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720109
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720109,
					"content": "しかし…あれは間違いなく小説です。誰かが趣味で創作して、匿名で投稿した報道記事風の物語なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720110,
						746720111
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720110,
					"content": "事件？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720112
					]
				},
				{
					"id": 746720112,
					"content": "うわ…オイラわかったかもだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720113,
					"content": "もしかして、レピーヌ·ポーリーンが前に『スチームバード新聞』で読んだ記事って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720114,
					"content": "編集者たちが会議で話し合っているのをこの耳で聞いたんですから。編集者たちも、あの小説が民衆に誤解を与えるんじゃないかって懸念して、わざわざ執律庭に問い合わせまでしたんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720115
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720115,
					"content": "しかし思いのほか、執律庭はあの小説が気に入ったみたいで…偽情報が潜在的犯罪者の耳に入れば、目立つ被り物での犯行を誘導できるかもって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720116
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720116,
					"content": "警備ロボの識別能力は、ベテランの警察と肩を並べるほどだから、そんな犯罪を見逃すはずがありません。却って犯行を目立たせるだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720117
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720117,
					"content": "小説が掲載されてからというもの、数多くの「プクプク獣怪盗」、「巨大赤カンムリガラ」に「フライムマン」たちが執律庭によって逮捕されました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720118
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720118,
					"content": "あの小説が治安維持の一助となったのは事実ですが、まさかあなたのような研究員まで引っ掛かるとは…しかも多額の投資までしていたなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720119
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720119,
					"content": "うっ…ああああああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720120
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720120,
					"content": "うぅ…レピーヌ·ポーリーンの研究の動機が…うそっぱちの物語だったなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720121,
					"content": "ってことは、オイラたちの分け前もなくなっちゃったのか…じゃなくて、あいつの投資は全部無駄になっちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720122,
					"content": "旅人とパイモン、戻ってきたのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720123
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720123,
					"content": "近くで取材してたら、偶然レピーヌ·ポーリーンさんに出会ってね。彼女の研究のことと、君たちのことも聞いたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720124
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720124,
					"content": "私も、「画像認識技術」の宣伝文を書いてって頼まれたの。原稿料とレンズの見本まで渡されてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720125
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720125,
					"content": "でも残念なことに、彼女の期待も、君たちの努力も無駄になってしまった…君たちにギャラを払わないといけないって彼女は頭を抱えてたわ…慰めの言葉はかけたけど、すぐには受け入れられないだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720126
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720126,
					"content": "オイラたちもこんなことは初めてだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720127,
					"content": "うーん…その作家はただ面白い物語を書きたかっただけだろうし…執律庭のやり方だって、確かにフォンテーヌの治安維持の役には立ったもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720128,
						746720129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720128,
					"content": "誰のせいでもない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720130
					]
				},
				{
					"id": 746720130,
					"content": "ちょ、ちょっと！レピーヌ·ポーリーンさん、何してるんですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720131
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720131,
					"content": "警備ロボと一戦やるんです。それからエピクレシス歌劇場に行って、メロピデ要塞に住民登録をしようと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720132
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720132,
					"content": "そしたら、借金を返さずに済むでしょう。そう、それが生き延びるための唯一の方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720133
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720133,
					"content": "早まりすぎです！あなたが警備ロボと戦ったって、彼らの外装さえ破れないでしょう！？せいぜい執律庭で数日過ごした後、借金は借金で返さなきゃいけないんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720134
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720134,
					"content": "…それより、この技術に一体いくら注ぎ込んだんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720135
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720135,
					"content": "…二十七…万モラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720136
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720136,
					"content": "えーっと、メロピデ要塞に逃げ込むほどの額でもなさそうですけど…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720137
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720137,
					"content": "旧フォンテーヌ科学院の外注設備エンジニアに過ぎない私にとっては、何年も掛けて一生懸命貯めてきた貯金なんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720138
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720138,
					"content": "それに、失ったのは貯金だけではありません。私が思い描いてきた「画像認識」の輝かしい未来も、億万長者になる夢も、何もかもが消えてしまいました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720139
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720139,
					"content": "ふっ…へへ…はは…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720140
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720140,
					"content": "私の人生も台無しです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720141
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720141,
					"content": "コホンッ！そう落ち込まないでください。レピーヌ·ポーリーンさん、私に一つ提案があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720142
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720142,
					"content": "よく見てみたら、先ほど渡してくれた見本——「画像認識サンプル収集撮影レンズ」は、より正確に収集し分析するための特別設計がなされているようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720143
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720143,
					"content": "本来の機能とは別に、素早くフォーカスを変えられるこのレンズは、きっと記者たちの役に立つと思いますよ。フォンテーヌ新聞業界の進化を推し進める力になるかもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720144
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720144,
					"content": "ですから、あなたのこれまでの研究は決して無駄ではありません。思いがけない分野ですごい真価を発揮できるかもしれませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720145
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720145,
					"content": "ほ、本当ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720146
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720146,
					"content": "もちろんです！こう見えても『スチームバード新聞』で経験を積んできた記者ですよ。同業者たちが仕事でどんな課題を抱えてるのか、よく分かってます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720147
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720147,
					"content": "ですから、まずは気を取り直してください。その後レンズの量産について考えましょう。記者の仲間たちにもあなたのレンズのことを紹介して、取引先をあたってみますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720148
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720148,
					"content": "こんな幸運が訪れるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720149
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720149,
					"content": "もしかしたら…「撮影設備」発展のチャンスを掴めるかも？それで大口発注が来たら、億万長者になるのも夢じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720150
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720150,
					"content": "ええと…もう少し資金を借り入れたほうがいいでしょうか？撮影設備戦争を勝ち抜くためには、いち早くレンズを改善して、市場を先取りしないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720151
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720151,
					"content": "レピーヌ·ポーリーン、夢ばっか見てないで…まずは一歩ずつ進んでいこうぜ。全財産を注ぎ込んで、一夜にして金持ちになるなんて野望はやめたほうがいいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720152,
						746720153
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720152,
					"content": "野望が大きいほど、失望も大きい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720154
					]
				},
				{
					"id": 746720154,
					"content": "ええ…もし知り合いの伝手で、画像認識の設備を必要としてる工房に売ることができたら、もう少しモラを集めることができるわ…ああ、もっと早く考え付けばよかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720155
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720155,
					"content": "善は急げ！一刻も早く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720156
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720156,
					"content": "あっ、もう行っちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720157
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720157,
					"content": "オイラたちの話、全然聞いてないじゃんかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720158
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720158,
					"content": "まあ…少し分かる気もするわ。「インスピレーションと情熱が沸き上がったとき、仕事のことしか頭にないから、人の話が入ってこない」んだよね…新人記者にもそういうタイプが多いの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720159
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720159,
					"content": "心配しないで。今回の出来事を記事にするつもりよ。レピーヌ·ポーリーンさんの様子も時々見に行ってあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720160
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720160,
					"content": "彼女の研究はきっと記者たちの役に立つと思うわ。彼女が軌道から踏み外すことなく、できるだけ早くレンズの大量生産にこぎつけられるように、私もアドバイスしてあげるつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720161
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720161,
					"content": "そしたら、オイラたちも安心だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720162,
						746720163
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720162,
					"content": "さすがはシャルロット！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720164
					]
				},
				{
					"id": 746720164,
					"content": "そうだ、このサンプルレンズは君たちにあげるわ！ほら、君たちってあっちこっちを旅してるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720165
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720165,
					"content": "すごいツールは、すごい人の手に使われて初めてその真価を発揮する。きっと君たちが使ったほうが、素晴らしい瞬間をたくさん記録できると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720166
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720166,
					"content": "ありがとな、シャルロット！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720167
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720167,
					"content": "分け前はなくなったけど、無駄足にはならなかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720168
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720168,
					"content": "大したことないよ！私も特ダネを仕入れることができたしね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720169
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720169,
					"content": "「特殊なニーズがあったからとはいえ、新聞報道と文学作品の境界線はできるだけ線引きさせたほうがいい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720170
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720170,
					"content": "レピーヌ·ポーリーンさんみたいな…善良な市民が不幸な目に遭うことが二度とないよう、編集部にちゃんと話しとくわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720163,
					"content": "さすがは新聞社のエース！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720164
					]
				},
				{
					"id": 746720153,
					"content": "一歩ずつ前に進むのが、成功の近道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720154
					]
				},
				{
					"id": 746720129,
					"content": "傷ついたのはレピーヌ·ポーリーンだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720130
					]
				},
				{
					"id": 746720111,
					"content": "小説？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720112
					]
				}
			]
		},
		{
			"id": 7467202,
			"completionStepIds": [
				7467202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
