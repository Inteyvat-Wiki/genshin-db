							446.167,
							4447.559
						],
						"pointId": 6272
					},
					{
						"sceneId": 3,
						"position": [
							3553.905,
							446.167,
							4447.064
						],
						"pointId": 6273
					},
					{
						"sceneId": 3,
						"position": [
							3552.219,
							446.167,
							4434.63
						],
						"pointId": 6562
					}
				]
			},
			"dialogs": [
				{
					"id": 746720201,
					"content": "あれ？シャルロットじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720202,
					"content": "あいつは友だちなのかな？なんの話をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720203,
					"content": "お、お願いです、シャルロットさん！いや、シャルロット様…お願いですから、冗談だと言ってください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720204
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720204,
					"content": "「プクプク獣の変装をし、警備ロボの目を逃れ、犯罪へ」…この事件は事実ですよね！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720205
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720205,
					"content": "「画像認識」技術のために、私は貯金を使い果たしたうえ、銀行から大金を借りたんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720206
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720206,
					"content": "この通り、土下座でもしますから！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720207
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720207,
					"content": "レピーヌ·ポーリーンさん、落ち着いてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720208
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720208,
					"content": "研究に対するあなたの熱い思いと…えーっと…大口発注への渇望は理解できますが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720209
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720209,
					"content": "しかし…あれは間違いなく小説です。誰かが趣味で創作して、匿名で投稿した報道記事風の物語なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720210,
						746720211
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720210,
					"content": "事件？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720212
					]
				},
				{
					"id": 746720212,
					"content": "うーん…小説について話し合ってるみたいだけど、あのレピーヌ·ポーリーンってやつ、なんでそんなに慌てて不安そうな顔をしてるんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720213,
					"content": "編集者たちが会議で話し合っているのをこの耳で聞いたんですから。編集者たちも、あの小説が民衆に誤解を与えるんじゃないかって懸念して、わざわざ執律庭に問い合わせまでしたんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720214
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720214,
					"content": "しかし思いのほか、執律庭はあの小説が気に入ったみたいで…偽情報が潜在的犯罪者の耳に入れば、目立つ被り物での犯行を誘導できるかもって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720215
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720215,
					"content": "警備ロボの識別能力は、ベテランの警察と肩を並べるほどだから、そんな犯罪を見逃すはずがありません。却って犯行を目立たせるだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720216
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720216,
					"content": "小説が掲載されてからというもの、数多くの「プクプク獣怪盗」、「巨大赤カンムリガラ」に「フライムマン」たちが執律庭によって逮捕されました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720217
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720217,
					"content": "あの小説が治安維持の一助となったのは事実ですが、まさかあなたのような研究員まで引っ掛かるとは…しかも多額の投資までしていたなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720218
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720218,
					"content": "うっ…ああああああ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720219
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720219,
					"content": "えーっと…とりあえず、なにがあったのか聞いてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720220,
					"content": "シャルロット！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720221,
					"content": "旅人にパイモン！二人も来てたんだね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720222
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720222,
					"content": "近くで取材してたら、偶然こちらのレピーヌ·ポーリーンさんに出会ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720223
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720223,
					"content": "彼女は『スチームバード新聞』でこんな記事を読んだそうよ。「プクプク獣」に変装した犯人が、警備ロボの目を逃れて犯行に成功したって内容のね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720224
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720224,
					"content": "それで、彼女は警備ロボの精度を向上させる装置を作って、フォンテーヌの治安を強化したいって思いから、大量のモラと時間を投資して「画像認識技術」の研究に打ち込んだんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720225
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720225,
					"content": "私も、「画像認識技術」の宣伝文を書いてって頼まれたの。原稿料とレンズの見本まで渡されてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720226
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720226,
					"content": "でも残念なことに、それはただの架空の物語で、彼女の期待と努力は水泡に帰してしまった…慰めの言葉は掛けたけど、すぐには受け入れがたいだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720227
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720227,
					"content": "オイラたちもこんなことは初めてだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720228,
					"content": "うーん…その作家はただ面白い物語を書きたかっただけだろうし…執律庭のやり方だって、確かにフォンテーヌの治安維持の役には立ったもんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720229,
						746720230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720229,
					"content": "誰のせいでもない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720231
					]
				},
				{
					"id": 746720231,
					"content": "ちょ、ちょっと！レピーヌ·ポーリーンさん、何してるんですか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720232
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720232,
					"content": "警備ロボと一戦やるんです。それからエピクレシス歌劇場に行って、メロピデ要塞に住民登録をしようと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720233
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720233,
					"content": "そしたら、借金を返さずに済むでしょう。そう、それが生き延びるための唯一の方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720234
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720234,
					"content": "早まりすぎです！あなたが警備ロボと戦ったって、彼らの外装さえ破れないでしょう！？せいぜい執律庭で数日過ごした後、借金は借金で返さなきゃいけないんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720235
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720235,
					"content": "…それより、この技術に一体いくら注ぎ込んだんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720236
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720236,
					"content": "…二十七…万モラ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720237
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720237,
					"content": "えーっと、メロピデ要塞に逃げ込むほどの額でもなさそうですけど…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720238
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720238,
					"content": "旧フォンテーヌ科学院の外注設備エンジニアに過ぎない私にとっては、何年も掛けて一生懸命貯めてきた貯金なんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720239
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720239,
					"content": "それに、失ったのは貯金だけではありません。私が思い描いてきた「画像認識」の輝かしい未来も、億万長者になる夢も、何もかもが消えてしまいました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720240
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720240,
					"content": "ふっ…へへ…はは…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720241
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720241,
					"content": "私の人生も台無しです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720242
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720242,
					"content": "コホンッ！そう落ち込まないでください。レピーヌ·ポーリーンさん、私に一つ提案があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720243
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720243,
					"content": "よく見てみたら、先ほど渡してくれた見本——「画像認識サンプル収集撮影レンズ」は、より正確に収集し分析するための特別設計がなされているようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720244
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720244,
					"content": "本来の機能とは別に、素早くフォーカスを変えられるこのレンズは、きっと記者たちの役に立つと思いますよ。フォンテーヌ新聞業界の進化を推し進める力になるかもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720245
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720245,
					"content": "ですから、あなたのこれまでの研究は決して無駄ではありません。思いがけない分野ですごい真価を発揮できるかもしれませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720246
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720246,
					"content": "ほ、本当ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720247
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720247,
					"content": "もちろんです！こう見えても『スチームバード新聞』で経験を積んできた記者ですよ。同業者たちが仕事でどんな課題を抱えてるのか、よく分かってます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720248
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720248,
					"content": "ですから、まずは気を取り直してください。その後レンズの量産について考えましょう。記者の仲間たちにもあなたのレンズのことを紹介して、取引先をあたってみますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720249
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720249,
					"content": "こんな幸運が訪れるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720250
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720250,
					"content": "もしかしたら…「撮影設備」発展のチャンスを掴めるかも？それで大口発注が来たら、億万長者になるのも夢じゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720251
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720251,
					"content": "ええと…もう少し資金を借り入れたほうがいいでしょうか？撮影設備戦争を勝ち抜くためには、いち早くレンズを改善して、市場を先取りしないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720252
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720252,
					"content": "レピーヌ·ポーリーン、夢ばっか見てないで…まずは一歩ずつ進んでいこうぜ。全財産を注ぎ込んで、一夜にして金持ちになるなんて野望はやめたほうがいいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720253,
						746720254
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720253,
					"content": "野望が大きいほど、失望も大きい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720255
					]
				},
				{
					"id": 746720255,
					"content": "ええ…もし知り合いの伝手で、画像認識の設備を必要としてる工房に売ることができたら、もう少しモラを集めることができるわ…ああ、もっと早く考え付けばよかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720256
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720256,
					"content": "善は急げ！一刻も早く！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720257
					],
					"speakerTitle": "レピーヌ·ポーリーン"
				},
				{
					"id": 746720257,
					"content": "あっ、もう行っちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720258
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720258,
					"content": "オイラたちの話、全然聞いてないじゃんかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720259
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720259,
					"content": "まあ…少し分かる気もするわ。「インスピレーションと情熱が沸き上がったとき、仕事のことしか頭にないから、人の話が入ってこない」んだよね…新人記者にもそういうタイプが多いの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720260
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720260,
					"content": "心配しないで。今回の出来事を記事にするつもりよ。レピーヌ·ポーリーンさんの様子も時々見に行ってあげるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720261
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720261,
					"content": "彼女の研究はきっと記者たちの役に立つと思うわ。彼女が軌道から踏み外すことなく、できるだけ早くレンズの大量生産にこぎつけられるように、私もアドバイスしてあげるつもりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720262
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720262,
					"content": "そしたら、オイラたちも安心だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720263,
						746720264
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720263,
					"content": "さすがはシャルロット！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720265
					]
				},
				{
					"id": 746720265,
					"content": "そうだ、このサンプルレンズは君たちにあげるわ！ほら、君たちってあっちこっちを旅してるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720266
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720266,
					"content": "すごいツールは、すごい人の手に使われて初めてその真価を発揮する。きっと君たちが使ったほうが、素晴らしい瞬間をたくさん記録できると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720267
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720267,
					"content": "ありがとな、シャルロット！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720268
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720268,
					"content": "へへっ、ただ話を聞いただけなのに、プレゼントまでもらえるなんてな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720269
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746720269,
					"content": "大したことないよ！私も特ダネを仕入れることができたしね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720270
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720270,
					"content": "「特殊なニーズがあったからとはいえ、新聞報道と文学作品の境界線はできるだけ線引きさせたほうがいい。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720271
					],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720271,
					"content": "レピーヌ·ポーリーンさんみたいな…善良な市民が不幸な目に遭うことが二度とないよう、編集部にちゃんと話しとくわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シャルロット"
				},
				{
					"id": 746720264,
					"content": "さすがは新聞社のエース！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720265
					]
				},
				{
					"id": 746720254,
					"content": "一歩ずつ前に進むのが、成功の近道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720255
					]
				},
				{
					"id": 746720230,
					"content": "傷ついたのはレピーヌ·ポーリーンだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720231
					]
				},
				{
					"id": 746720211,
					"content": "小説？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720212
					]
				}
			]
		}
	]
}