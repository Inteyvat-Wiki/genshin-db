			},
			"dialogs": [
				{
					"id": 400740201,
					"content": "水占の盤によると、すでに幻境に着いているようですね。まずは入り口を探しましょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740202
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400740202,
					"content": "あれじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400740203,
					"content": "見たところ…池みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740204
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400740204,
					"content": "もしかして、泳いでいかなきゃいけないのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400740205,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740206
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400740206,
					"content": "まさか、私たちの中に泳げない人なんていませんよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740207
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400740207,
					"content": "問題はそこではないと思うが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740208
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400740208,
					"content": "ふふっ、怖いのですか？いいでしょう、ならば私が先頭を行きます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740209
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400740209,
					"content": "始まった！泳ぎへの自信による自慢が始まったわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740210
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400740210,
					"content": "コホンッ！お嬢様、言葉遣いにはご注意を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740211
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400740211,
					"content": "あっ、あわわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740212
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400740212,
					"content": "先に行っていますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740213
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400740213,
					"content": "あっ、モナが池の中に飛び込んだぞ！オイラたちもあとに続こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
