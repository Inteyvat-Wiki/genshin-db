				"points": []
			},
			"dialogs": [
				{
					"id": 400741101,
					"content": "みんな、こっちに集まってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741102
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400741102,
					"content": "皆、目が覚めたでござるか？モナ殿から、重要な話があるようでござる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741103
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400741103,
					"content": "幽夜浄土への君臨を果たした後の夜明けは、実に胸がすくものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741104
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400741104,
					"content": "お嬢様は、すでに次の挑戦への準備を整えた、とおっしゃっています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741105
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400741105,
					"content": "オイラたちもぐっすり眠れたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400741106,
					"content": "はい、では単刀直入に言いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741107
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741107,
					"content": "先ほど水占の盤で見たのですが、新たな幻境があちらの島で形を成したようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741108
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741108,
					"content": "それに…私の勘が間違っていなければ、あれは私と関係あるものかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741109
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741109,
					"content": "今回はモナか。これまでの幻境もモナは付き合ってくれたし、今度はアタイたちが一緒に行く番だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741110
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400741110,
					"content": "えっと…何も面白いものはないですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741111
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741111,
					"content": "メギストス卿、恥ずかしいのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741112
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400741112,
					"content": "い、いえ、そんな…あ、あまりにも貧相な幻境を見せてしまったら、偏見を抱かれるのではないかとか、そんなことまったく心配していませんので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741113
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741113,
					"content": "すべて言ってしまっているでござるな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741114
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400741114,
					"content": "一般的に…占星術師はとても超越した存在だと思われがちですが…もしも私の幻境がそれと違っていたらと思うと心配で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741115
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741115,
					"content": "そんな愚昧な期待、わたくしはしていないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741116
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400741116,
					"content": "アタイもだ。別に期待してないってわけじゃないけど、モナは元から親切で優しいからな、取り繕う必要なんてないと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741117
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400741117,
					"content": "平常心を保てる者は、幻境においても親しみ深さが垣間見える。それは良いことでござろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741118
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400741118,
					"content": "そうだぞ。それにモナの幻境に行くのだって、ただの観光ってわけじゃないだろ。他に目的があるんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741119,
						400741120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400741119,
					"content": "うん。もしかしたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				},
				{
					"id": 400741121,
					"content": "…そうですか、ならいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741122
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741122,
					"content": "過度な期待がなければ、私も緊張はしません。それでは、出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741120,
					"content": "幻象を解決する手がかりがあるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				}
			]
		},
		{
