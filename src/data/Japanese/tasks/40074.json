				"points": []
			},
			"dialogs": [
				{
					"id": 400741201,
					"content": "メギストス卿…これはなんとも痛ましい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741202
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400741202,
					"content": "うぅ、そう慰めないでください。とても恥ずかしいので…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741203
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741203,
					"content": "こういう時は何も言わないほうがいいんだぜ。そうだ、ハグでもしてやろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741204
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400741204,
					"content": "い、いりません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741205
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741205,
					"content": "先ほどのは以前の私が感じていたことです。あの時の私は、まだ占星術に触れて間もない頃でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741206
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741206,
					"content": "経験を積んだ今は、もう素人の意見に心が揺れ動くことはありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741207
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741207,
					"content": "宮廷大魔道士であるメギストス卿にも、低迷していた頃があったなんて。本当に意外だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741208
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400741208,
					"content": "他者に誤解を抱かれる生活は、きっと大変だったであろう…心を晴らすことができて、本当によかったでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741209
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400741209,
					"content": "実は、こういうことに耐えられず、渋々占星術をあきらめる人もいるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741210
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741210,
					"content": "でも私は天才ですから、他の人ができないことだってできます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741211
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741211,
					"content": "こんな壮大で綺麗な場所でそういうこと言うと、なんか余計に迫力があるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741212,
						400741213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400741212,
					"content": "モナは本当にすごいよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				},
				{
					"id": 400741214,
					"content": "うんうん、いいですね。もっと褒めてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741215
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741215,
					"content": "その、水を差すようで申し訳ないのですが…どうやら、あそこに扉があるようでございます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741216
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400741216,
					"content": "では、ここ一帯の問題を解決した後、また私を褒め称える機会を与えましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				},
				{
					"id": 400741213,
					"content": "モナは絶対に天才だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				}
			]
		}
	]
