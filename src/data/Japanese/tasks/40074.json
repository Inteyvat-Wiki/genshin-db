				"points": []
			},
			"dialogs": [
				{
					"id": 400740901,
					"content": "周りの様子が変わった。これは、拙者たちが出発する前の浜辺ではないでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400740902,
					"content": "どうやら、モンドの山地のようですね。まさか、私たちはモンドへ送り返されたのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "オズ"
				},
				{
					"id": 400740903,
					"content": "でも、周りは変わらず果てしない海のままだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400740904,
					"content": "先ほどのように、入れる池が辺りにあるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400740905,
					"content": "こっちだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400740906,
					"content": "…おや？直接入ることができないようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400740907,
					"content": "水面になにか浮かんできたぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400740908,
					"content": "これって絵か？それとも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400740909,
					"content": "とある地点を指しているようでござるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400740910,
					"content": "わたくしに皆をそこへ導かせようとしているのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400740911,
					"content": "どうしてあなたが先頭を…まあいいです、誰でも構いません。とりあえずこの場所を探し出しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
