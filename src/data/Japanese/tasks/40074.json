			"dialogs": [
				{
					"id": 400740301,
					"content": "なんとも壮観な建物でござる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740302
					],
					"speakerTitle": "楓原万葉"
				},
				{
					"id": 400740302,
					"content": "わぁ…アタイ、こんなの見たこともないぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400740303,
					"content": "おいモナ、あんたの幻境、凄すぎだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "辛炎"
				},
				{
					"id": 400740304,
					"content": "幽夜浄土には少し劣るけど、悪くはないわ、メギストス卿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "フィッシュル"
				},
				{
					"id": 400740305,
					"content": "（ふぅ…おばばに叱られている授業とかじゃなくてよかった…これで面目は保たれました…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400740306,
					"content": "天才占星術師の幻境は、もちろん壮大なものでなくてはなりませんからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "モナ"
				},
				{
					"id": 400740307,
					"content": "ではさっそく、少し探索してみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モナ"
				}
			]
		},
		{
