					{
						"sceneId": 3,
						"position": [
							-3611.492,
							199.31,
							-883.231
						],
						"pointId": 321000255
					}
				]
			},
			"dialogs": [
				{
					"id": 401570601,
					"content": "ここだ。私が各地から集めた楽譜と楽器を置いている。フォンテーヌから特別に持ってきたホルンもあるよ。ここでなら、みんな思う存分お気に入りの曲を演奏できるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570602
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570602,
					"content": "遊び疲れたら、あちらに用意してある焼きスミレウリエリアで一休みできるようになっている。一斗さんの言葉を借りると…スミレウリはロッキン芸術食だ！どうだ、試してみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570603
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570603,
					"content": "ならパイモンは空飛ぶロッキン芸術食だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570604
					]
				},
				{
					"id": 401570604,
					"content": "おい、勝手にオイラに変なあだ名を付けるなよ！…一斗のやつ、もう遠くまで行ったよな？あいつに聞かれたらまずいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570605,
					"content": "ドヴォルザークおじさん、さっさと話題を変えようぜ。他に見どころはあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570606,
					"content": "音楽愛好家をさらに招待して、物資ももっと集めて…会場をより華やかに飾ろうと思っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570607
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570607,
					"content": "だが、どれももう暫く時間がかかりそうだ。あの犬のことを話すや否や、荒瀧派の人手はそちらに回されてしまってね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570608
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570608,
					"content": "今は久岐忍というお嬢さんだけが、計画通りに招待状を出してくれている状態だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570609
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570609,
					"content": "まったく、荒瀧派ときたら、忍以外に頼れるやつがいないんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570610,
					"content": "なんなら、オイラたちが手伝ってやろうか？忍の努力を無駄にしないためにも、今回のお祭りが変なものにならないよう、しっかり見守ってやらないとだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570611,
					"content": "ほ…本当にいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570612
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570612,
					"content": "#うん、{M#俺}{F#私}たちに任せて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570613
					]
				},
				{
					"id": 401570613,
					"content": "本当に助かるよ…さっきの件だが、どこも圧倒的人手不足なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570614
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570614,
					"content": "へへっ、遠慮するなって！つまりオイラたちは、音楽愛好家をいっぱい招待して、会場を飾れるものを探せばいいってことだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570615,
					"content": "ああ。元々の計画では、五日以内にすべての準備を整えて、最後にパーティーを開くことになっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570616
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570616,
					"content": "ちょっと待っていてくれ…やってもらいたいことをリストにまとめるよ。君たちにとってもそのほうが便利だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570617
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570617,
					"content": "ああ、そうそう。追加情報だが——なんと、一斗さんは最後の日に舞台で歌を披露するそうだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570618
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570618,
					"content": "牛使い野郎、また一人で目立つ気だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570619,
					"content": "じゃあパイモンも歌ったら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570620
					]
				},
				{
					"id": 401570620,
					"content": "ふふん、オイラが舞台に上がったら、牛使い野郎なんか目じゃないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570621,
					"content": "きっと、「パイモン、まじでロックすぎるぜ！」って泣き叫びながら逃げてくぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570622,
					"content": "ハハッ、パイモンさんはかなり自信があるようだね。こういう人こそ、舞台にふさわしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570623
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570623,
					"content": "ま、言ってみただけだけどな、へへっ。それじゃ、ドヴォルザークおじさんもリストを書くのに時間がいるだろうし、オイラたちは他のところで待っててやろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570624
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570624,
					"content": "ああ。二人とも、会場を自由に回っていてくれ。すぐ済ませるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドヴォルザーク"
				}
			]
		},
