			"dialogs": [
				{
					"id": 401570401,
					"content": "二人とも、会場を自由に回っていてくれ。すぐ済ませるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドヴォルザーク"
				}
			]
		},
		{
			"id": 4015705,
			"completionStepIds": [
				4015705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4015705",
							"2"
						],
						"stepId": 4015705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鹿野院平蔵"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-3615.737,
							201.872,
							-906.978
						],
						"pointId": 321000267
					}
				]
			},
			"dialogs": [
				{
					"id": 401570501,
					"content": "おっと！旅人にパイモン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570502
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570502,
					"content": "わあ！忍。平蔵…！おまえまで来てたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570503,
					"content": "予想外の客人…と言いたいところだけど、それほど予想外ってわけでもないかな。さっきまで忍さんと話してたんだよ。もうすぐ君たちに会えそうな気がするってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570504
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570504,
					"content": "ふふっ、鹿野院同心はさっきから何度も君たちのことを口にしていた。強く願えば叶うというのは、このことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570505
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570505,
					"content": "勘だよ、勘。肝心なときに決定的な人物を思い出すのが習慣になってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570506
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570506,
					"content": "会えて嬉しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570507
					]
				},
				{
					"id": 401570507,
					"content": "予想外だぜ。オイラたち以外の初めてのお客さんが平蔵だなんてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570508,
					"content": "天領奉行への招待状はなるべく早めに出すようにと親分に言われてな。親分は特別に裟羅と鹿野院同心を招待したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570509
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570509,
					"content": "ええ…なら、裟羅のやつはなんで来なかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570510,
					"content": "きっと彼女はまったく一斗に会いたくなかったんだろうね。何せ、招待状にはこんなことが書いてあったんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570511
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570511,
					"content": "「九条天狗！俺様と一緒に、珊瑚宮のてっぺんで最高に燃えるロック相撲をやろうぜ！！」ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570512
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570512,
					"content": "私が裟羅なら、きっと親分を珊瑚宮の宮殿のてっぺんから突き落としてやりたくなるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570513
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570513,
					"content": "そしたら心海もきっと裟羅を突き落とすんじゃないか？頭上で騒がれたらたまったもんじゃないしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570514
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570514,
					"content": "ふふっ、とにかく、裟羅はやはりいい人だ。代わりにと、スミレウリを一箱贈ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570515
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570515,
					"content": "いい人だって？へへっ、僕はあれには別の意味が込められてたと思うけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570516
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570516,
					"content": "別の意味ってなんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570517,
					"content": "「奉行所でスミレウリを食べたくなければ、私に喧嘩を売るな」…とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570518
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570518,
					"content": "なんだよ、平蔵！そこまで深読みするほどのことじゃないだろ！おまえら、確かスミレウリを二箱持ってきてただろ！なら、もう一箱はおまえからだよな？それにも別の意味が含まれてるって言うのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570519,
					"content": "ははっ、もう一箱は奉行所のみんなでモラを出し合って買ったんだよ。僕と一斗を逮捕したことのある他の同心たちとか、一斗が監獄で作った友人たちとかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570520
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570520,
					"content": "だから、このスミレウリの祝福はざっくり言うと「またいつでも遊びに来てね！」ってところかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570521
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570521,
					"content": "親分には黙っていたほうがよさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570522
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570522,
					"content": "ふふっ、スミレウリは届けたし、会いたかった相手にも会えた。僕はそろそろお暇しようかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570523
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570523,
					"content": "あれ？平蔵はお祭りに参加しないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570524
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570524,
					"content": "安心して、最後の宴を逃す気はないよ。ただ、その前に離島でやるべきことを済ませなくちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570525
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570525,
					"content": "離島に行かなきゃいけないのか。探偵って本当に忙しいんだな…あっそうだ！なあ、戦場で活躍してた忍犬についてなにか聞いてないか？離島から広まった噂みたいなんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570526,
					"content": "あぁ…あの犬のことか。今回の音楽祭のきっかけとなったあれだよね？テーマと物語については、忍さんから説明を受けたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570527
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570527,
					"content": "そっか…奉行所ならなにか、内情とか知ってないかなって思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570528,
					"content": "でも…そうだな、僕の経験からすると…これはただの噂話で、犬なんて存在しないと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570529
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570529,
					"content": "おや？その表情、それでも気になるみたいだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570530
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570530,
					"content": "面白い…じゃあこうしよう、僕も用事のついでに聞き回ってみるよ。どうせ離島に行くわけだしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570531,
						401570532
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570531,
					"content": "仕事の邪魔にならない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570533
					]
				},
				{
					"id": 401570533,
					"content": "もう、気を遣いすぎだってば。君が興味を持ってるものは、僕も基本気になるんだからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570534
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570534,
					"content": "へへっ、それじゃ、朗報を待ってて！またね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570535
					],
					"speakerTitle": "鹿野院平蔵"
				},
				{
					"id": 401570535,
					"content": "鹿野院同心は相変わらず自由気ままな行動派だな…さて、私も招待状を送る作業に戻らないと。何と言っても、目玉は最後の夜の宴だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570536
					],
					"speakerTitle": "久岐忍"
				},
				{
					"id": 401570536,
					"content": "じゃあオイラたちも頑張らないとだな！そういや、リストのほうはどうなったかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570537,
					"content": "二人ともお待たせ、リストができたよ。このリスト通りにやってくれれば問題ないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570538
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570538,
					"content": "おお！ばっちりのタイミングだな！これでオイラたちも出発できるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570539
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570539,
					"content": "手間をかけるね…気分転換に音楽を奏でたくなったら、楽曲練習エリアまで来てくれ。そこでみんなを待っているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570532,
					"content": "依頼料はいる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570533
					]
				}
			]
		},
		{
			"id": 4015706,
