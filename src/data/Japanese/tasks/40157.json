				]
			},
			"dialogs": [
				{
					"id": 401570301,
					"content": "ザークの兄貴、安心しろ。たとえ天守閣にいようとも、必ずあの犬を見つけ出してみせるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570302
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570302,
					"content": "一斗さん…あれはただの噂で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570303
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570303,
					"content": "犬って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570304
					]
				},
				{
					"id": 401570304,
					"content": "おっと！ダチ公！それにちび助じゃねぇか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570305
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570305,
					"content": "やっと来てくれたな！会いたかったぜ！ガーハッハッハ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570306
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570306,
					"content": "そうだ、こっちはフォンテーヌから来た音楽家で、ドヴォルザークって言うんだ。ザークの兄貴、こいつらのことは知ってるんだっけか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570307
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570307,
					"content": "わあ！ドヴォルザークおじさん、おまえも来てたのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570308,
					"content": "はは！二人とも、会えて実に嬉しいよ。去年の海灯祭ぶりだな。息災だったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570309
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570309,
					"content": "まあまあだぞ！おまえはなんで牛使い野郎と一緒にいるんだ？まさかこいつと一緒に「イリデッセンスツアー」をやってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570310,
					"content": "チビ助、あたりだ！が、完全に正しいとは言えねぇな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570311
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570311,
					"content": "今回は普通の「イリデッセンスツアー」じゃねぇ。俺様とザークの兄貴っつー実力者二人が手を取り合って開催する「荒瀧·生命のロックイリデッセンスビッグツアー」だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570312
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570312,
					"content": "荒瀧なんとかロックって…牛使い野郎もロックのことがわかるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570313,
					"content": "ああ？「牛使いロック」って、聞いたことねぇのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570314
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570314,
					"content": "モモモ～ドコドコダ～ン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570315
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570315,
					"content": "チビ助、おまえもダラダラと毎日を過ごしてる場合じゃねぇぞ。自分だけのチビ助ロックの道を探すんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570316
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570316,
					"content": "ダラダラしてるのはどっちだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570317
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570317,
					"content": "さっき言ってた犬のことは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570318
					]
				},
				{
					"id": 401570318,
					"content": "コホン…ただ、噂を耳にしただけなんだ。以前、鳴神島と海祇島の間で戦争があったようだが…これは確かだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570319
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570319,
					"content": "無粋な争い、ロックじゃないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570320
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570320,
					"content": "ああ、本当に。気の毒なことに、動物たちにも飛び火したそうだ。カラスや妖狸、宝盗イタチ、いろんな動物たちが怪我をしたとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570321
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570321,
					"content": "えっと…たしかに動物たちに罪はないけど…その、一番重要なのはそこじゃない気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570322,
					"content": "俺様たちロッカーにとっては、すべての生命が大切なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570323
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570323,
					"content": "じゃあ、その犬も怪我したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570324
					]
				},
				{
					"id": 401570324,
					"content": "いや。噂されている犬は、忍犬のような立ち振る舞いだったそうだ。神出鬼没で、戦場に現れては倒れてしまった動物たちを助けて一番安全な避難所まで連れて行っていたという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570325
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570325,
					"content": "まさにロッキンサポートキングだな！そういうやつにこそ荒瀧派の仲間になってほしいもんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570326
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570326,
					"content": "その噂ってどこで聞いたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570327
					]
				},
				{
					"id": 401570327,
					"content": "実は戦争まっただなかの頃、ちょうど離島にいてね。そこで噂を耳にしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570328
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570328,
					"content": "その後、それをテーマに歌を作って、音楽祭を開催しようと思ったんだが…残念なことに、出資者と意見が分かれてしまってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570329
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570329,
					"content": "その件なら、俺様も聞いたぜ。海難に遭ったから予定を取り消したってことになってるらしいが…実際、ただの言い訳だろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570330
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570330,
					"content": "ああ。実際は、テーマのリターンが低いと出資者が判断したからなんだ。それに…なにやら別のリスクも心配していたようだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570331
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570331,
					"content": "リスク？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570332,
					"content": "私も確信を持てないが…おそらく、モラを持てば持つほど見えてくるリスクなのだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570333
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570333,
					"content": "俺様もそう思う。懐に余裕のあるやつは、ロックの精神が減るもんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570334
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570334,
					"content": "ロックの精神ってなんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570335,
					"content": "何にでもロックをかけようとする精神に決まってんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570336
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570336,
					"content": "…その理屈だと、モラに「ロックをかけた」出資者こそ一番ロックなやつってことにならないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570337,
					"content": "とにかく、やつらの役割は、この俺様が受け継がせてもらった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570338
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570338,
					"content": "出来もしないことを約束するなよな。牛使い野郎、おまえは出資者になれるほどモラを持ってるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570339
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570339,
					"content": "一斗さんのことなら、私は信じているよ。荒瀧派はなかなか名の知られた実力のある組織として、奉行のほうでも名前を控えていると聞く。そうなのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570340
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570340,
					"content": "ドヴォルザークおじさん…それ、犯罪記録で名前を控えられてるんじゃないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570341
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570341,
					"content": "荒瀧派を舐めるなよ！今や俺様の言うことには、三奉行だって耳を傾けざるを得ないんだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570342
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570342,
					"content": "よく言うぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570343,
					"content": "チビ助、信じないっつーのかよ？社奉行の無敵家司のことは知ってるだろ？ほら、トーマのあんちゃんのことだ。俺様たちは兄弟同然なんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570344
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570344,
					"content": "それにあいつだ！天領奉行の大将——あの九条天狗！あいつと俺様は命をかけた付き合いだって言っても過言じゃねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570345
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570345,
					"content": "ええ…？命を取られる関係じゃなくてか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570346
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570346,
					"content": "じゃあ勘定奉行は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570347
					]
				},
				{
					"id": 401570347,
					"content": "そっちは確かに知り合いこそあんまいねぇが、やつらの収入源はこの荒瀧派が罰金で支払ったモラなんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570348
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570348,
					"content": "ば、罰金？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570349
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570349,
					"content": "ぜ、税金だ！コホン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570350
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570350,
					"content": "それにだ！三奉行以外の強者たちのことも忘れちゃいけねぇ…例えば…例えば、話題の「札遊び名人綾人」とかな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570351
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570351,
					"content": "「南の綾人、北の一斗」って言葉は知ってるか？そう——俺様以外に、稲妻で綾人の兄貴の右に出るやつなんざいねぇっつー意味だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570352
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570352,
					"content": "そんな言葉があるのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570353
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570353,
					"content": "それに「屋台·幸雄」にいた偉い狐の客人だ。ラーメン王選手権で、あいつの相手になれたのはこの俺様だけだったんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570354
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570354,
					"content": "もっと言うと、天守閣にいるあの寂しがり屋の神を知ってるか？俺様が主催する祭りを見るのが一生の願いなんだそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570355
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570355,
					"content": "前回の豪鼓祭じゃ、自分の将軍様が楽しすぎて我を忘れてしまうのを心配したのか、天領奉行が俺様をわざわざ呼び出して、何日ももてなしてくれたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570356
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570356,
					"content": "おまえってやつは、しばらく会わないと思ったらこれか…その勢いで将軍にでもなるつもりかよ、へっぽこ牛使いのくせに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570357
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570357,
					"content": "さすが荒瀧派だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570358
					]
				},
				{
					"id": 401570358,
					"content": "コホン…多少、誇張があったというのは分かったよ。だが、一斗さんは確かにイベント会場に関する問題を解決してくれたんだ。そこについては礼を言わないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570359
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570359,
					"content": "こんくらい、お安い御用だぜ！この素晴らしい会場は、ゴローの兄弟が審査を通してくれたからこそ手に入ったんだ。後で一緒にあいつに礼を言いに行かねぇとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570360
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570360,
					"content": "おまえ、ゴローとも知り合いだったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570361
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570361,
					"content": "そりゃそうだ。やつが抵抗軍小隊の大将だってこたぁ前から知ってたんだが、まさか別の身分まであったなんてな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570362
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570362,
					"content": "別の身分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570363
					]
				},
				{
					"id": 401570363,
					"content": "ヒナさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570364
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570364,
					"content": "ヒナさんだって！？お、おまえ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570365
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570365,
					"content": "あ？いきなり大声出してどうしたんだ？あのな、ヒナさんが教えてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570366
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570366,
					"content": "前回の豪鼓祭で、俺様は天領奉行にしてやられただろ？だから今回は会場をやつらの手の届かない場所に変えようと思ってな。例えばここだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570367
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570367,
					"content": "そんで、俺様はヒナさんに質問の手紙を送ってみることにした。海祇島で祭りを開催するためにはどんな手続きが必要かってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570368
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570368,
					"content": "するとすぐに返事があって、海祇島の大将に協力を申し出ればいいって書いてあった。そんでその大将の名前が、まさにゴローだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570369
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570369,
					"content": "なんと…ゴローの兄弟は海祇島全体の大将だったんだ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570370
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570370,
					"content": "なんだ、びっくりしたぞ…そういうことかよ…おまえ、大将なんて身分のやつがそう何人もいると思ってたのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570371
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570371,
					"content": "はあ？そりゃ、小隊一つに一人大将がいるもんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570372
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570372,
					"content": "それは隊長だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570373
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401570373,
					"content": "そうなのか？まあいい、とにかく…ヒナさんが教えてくれたおかげで、俺様はやっと理解したんだ。めちゃくちゃロックだぜ！ガーッハッハッハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570374,
						401570375
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570374,
					"content": "めちゃくちゃロックだね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570376
					]
				},
				{
					"id": 401570376,
					"content": "おっと、ダチ公！今思い出したんだが、この後ゴローの兄弟と約束があったんだ。例の犬の件について聞こうと思ってな。ってことで、先に失礼するぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570377
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570377,
					"content": "情報収集、手伝ってあげようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570378
					]
				},
				{
					"id": 401570378,
					"content": "ガーハッハッ！お前らは祭りを楽しむことに専念してくれ！犬探しぐらい、俺様に任せとけって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570379
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570379,
					"content": "祭りの最後を飾る予定の宴まで、あともう数日だ。会場はまだ完全に整ってないが、楽曲練習エリアと焼きスミレウリエリアの準備はすでにばっちりだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570380
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570380,
					"content": "ダチ公！存分に楽しんでくれよ！じゃあな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570381
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 401570381,
					"content": "はぁ…一斗さんは本当に太陽のように情熱的な人だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570382
					],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570382,
					"content": "旅人さん、パイモンさん。そんなわけだから、まずは楽曲練習エリアへ案内しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドヴォルザーク"
				},
				{
					"id": 401570375,
					"content": "ハッハッハ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570376
					]
				}
			]
		},
		{
			"id": 4015704,
			"completionStepIds": [],
