			},
			"dialogs": [
				{
					"id": 726920501,
					"content": "大伴さんも君もこの句が気に入ったのなら、これにしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920502
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726920502,
					"content": "写真がレネさんの句をより引き立たせてくれている。写真を見ながら句を読むと、その情景が目に浮かぶようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920503
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726920503,
					"content": "#{M#兄さん}{F#姉さん}、実は俺も詩を書いているんだ。明日も頼めるだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920504
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726920504,
					"content": "大伴さんも写真が必要なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920505
					]
				},
				{
					"id": 726920505,
					"content": "ふふ、それはまた明日にしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大伴"
				}
			]
		},
