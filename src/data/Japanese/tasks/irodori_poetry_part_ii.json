			"dialogs": [
				{
					"id": 726920201,
					"content": "友よ、写真は撮ってきたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920202
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726920202,
					"content": "撮ってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726920203
					]
				},
				{
					"id": 726920203,
					"content": "どれどれ…うん、よし！アイデアが湧いてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726920204
					],
					"speakerTitle": "レネ"
				},
				{
					"id": 726920204,
					"content": "友よ、今回も君が撮ってくれた写真をもとに、詩句をいくつか書いてみた。どれにするかは君が決めてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レネ"
				}
			]
		},
