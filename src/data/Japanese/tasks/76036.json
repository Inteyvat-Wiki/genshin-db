						760360122
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 760360122,
					"content": "えっと…なんだ？全然わからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360123
					],
					"speakerTitle": "パイモン"
