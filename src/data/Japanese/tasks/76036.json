				},
				{
					"id": 760360302,
					"content": "うん、大満足みたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360303,
					"content": "～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760360304,
					"content": "月霊が絵を描くなんて知らなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360305,
					"content": "人間と同じで、この子たちもそれぞれ違った性格や趣味を持ってるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360306,
					"content": "もしかして、ナド・クライの月霊をみんな知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360307,
					"content": "うん、会ったことがある子ならね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360308,
					"content": "すごいな！ルオンノタルは特徴があるから分かるけど、ほかの月霊はみんな同じに見えるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360309,
					"content": "じゃ、絵を描くこいつはなんて名前なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360310,
					"content": "名前…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360311,
					"content": "えっ、名前をつけてやってないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360312,
					"content": "私はこの子たちを知ってるし、この子たちも私を知ってる。名前はいらないよ…私にも名前はないもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360313,
					"content": "せっかくだから、考え方を変えてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360314,
					"content": "えーと…なにがいいかな…「ルオンノタル」って、「月神の祝福を受けて生まれた命」って意味なんだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360315,
					"content": "じゃ、「絵」って「霜月の子」の言葉でなんて言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360316,
					"content": "えーと…メ…イナ？メイラ？…うん、たしかメイラだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360317,
					"content": "いい響きじゃないか。よし、おまえは今日から「メイラ」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360318,
					"content": "？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760360319,
					"content": "どうだ、メイラ、描き終わったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360320,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760360321,
					"content": "おお！どれどれ…えっ、えぇぇっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360322,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "うますぎるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360324,
					"content": "子供とか、メリュジーヌが描いたみたいな絵を想像してたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360325,
					"content": "月霊は周りの環境を感知する能力が高いんだよ。目にしたものを模写するときは、感じたままを絵で表す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360326,
					"content": "メイラが描いたのは…コロンビーナ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360327
					]
				},
