					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760360103,
					"content": "コロンビーナ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "え？ああ、キミたちか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360106,
					"content": "ちょっとお願いがあるの。ちゃんとお礼はするから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360107,
					"content": "もう…ふつうに頼んでこいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360108,
					"content": "こっちもいろいろ助けてもらったんだし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "そうだぞ。お礼なんかなくても手伝ってやるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360111,
					"content": "で、お願いってなんなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360112,
					"content": "えっと…この子を助けてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "メイラ"
				},
				{
					"id": 760360114,
					"content": "この月霊を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760360115,
					"content": "どこで拾ってきたんだか、筆を持って私の周りを踊ってたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360116,
					"content": "キャンバスと絵の具を用意してあげたら、何かを熱心に描き始めたんだけど、ほしい色がなかなか作れなくて困ってるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760360117,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 760360118,
					"content": "あれ、出てきたぜ。",
