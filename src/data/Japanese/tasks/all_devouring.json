			"dialogs": [
				{
					"id": 150360101,
					"content": "ここって…層岩巨淵の近くだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360102,
					"content": "ここを通れば、お前の夢に出てきた空間へ行ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360103,
					"content": "同じ深淵の秘境でもこの先は相手の縄張りだ。慎重に行動しろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360104,
					"content": "安心しろ、ちゃんとおまえの後ろに隠れとくから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360105,
					"content": "へへっ、おまえも無理するなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360106,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "行くぞ。修行の内容を思い出しておけ。もしかすると、さっそく使うことになるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360107,
					"content": "「盗っ人」を懲らしめてやらないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
