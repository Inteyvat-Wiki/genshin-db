			},
			"dialogs": [
				{
					"id": 150365101,
					"content": "先日よりもずっと顔色がいいですね。悩み事が解消されたのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365102
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 150365102,
					"content": "良かったな。でも安心するのはまだ早いと思うぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 150365103,
					"content": "そうですね。まだ病み上がりなので、もう少し様子を見たほうがいいでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365104
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 150365104,
					"content": "ちょうど最近は患者が少なく、空き部屋も多いので、必要であればもうしばらく泊まっていただいて構いません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365105
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 150365105,
					"content": "助かるぜ！ありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
