				]
			},
			"dialogs": [
				{
					"id": 150360301,
					"content": "旅人、スカーク！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360302,
					"content": "いったいどうなってるんだ？スカーク、その肩——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360304
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360304,
					"content": "帰離原で、なぜ自分が狙われたのか聞いたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360305
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360305,
					"content": "答えが分かった。相手はお前の強さだけでなく、その「アビスを浄化する力」を欲していたのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360306
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360306,
					"content": "「浄化」の本質はさておき、それを利用することで、これまでに成せなかったことを成そうとしている——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360307
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360307,
					"content": "私を怯ませ、力を奪うといったようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360308,
						150360309
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360308,
					"content": "本当のターゲットはスカークだったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				},
				{
					"id": 150360310,
					"content": "いや、恐らく私がここに来ることは知らなかったはずだ。お前の魂の欠片を奪ったのは、単にお前の力が稀有だからだろう。先ほどは必要に駆られて使ったにすぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360311
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360311,
					"content": "いわゆる運命というものがこの世にあるのなら、このようなつまらない偶然を指すのかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360312
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360312,
					"content": "だが、私たちにとっても好都合だった。お前の力が使われるタイミングが判れば、それを逆手にお前の力を取り戻すことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360313
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360313,
					"content": "でも、そのせいでスカークが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360314
					]
				},
				{
					"id": 150360314,
					"content": "気にするな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360315
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360315,
					"content": "さて、腹は満たされたか？質問に答えてもらおう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360316
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360316,
					"content": "なぜ…お前が「呑星の鯨」の権能を持っている？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360317
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360317,
					"content": "呑星の鯨！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360318,
					"content": "あっ…言われてみればあのトゲ…呑星の鯨の頭に生えてた角とそっくりだったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360319,
					"content": "その権能は、お前が自分の力で得たものではないな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360320
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360320,
					"content": "それに、もし呑星の鯨を倒せるほどの実力があるのなら、魔神の残滓などという不完全な力のために駆け回る必要もないはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360321
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360321,
					"content": "となると可能性は一つ。お前は私の師匠——「極悪騎」スルトロッチを知っているのだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360322
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360322,
					"content": "「極悪騎」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360323
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150360323,
					"content": "スルトロッチ…お前ガ「悪」と言われルナド…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360324
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150360324,
					"content": "スルト…ロッチ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360325
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150360325,
					"content": "頭まで力に侵蝕され、対話能力が低下しているようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360326
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360326,
					"content": "マテ…私ハ…まだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360327
					],
					"speakerTitle": "スクフヌーガ"
				},
				{
					"id": 150360327,
					"content": "おい！あれがまた来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360328,
					"content": "力に溺れし者は、その反動に呑み込まれるまで己を顧みない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360329
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360329,
					"content": "どうする？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360330
					]
				},
				{
					"id": 150360330,
					"content": "落ち着け。お前の「理性」で最善を選べ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360331
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360331,
					"content": "#（{M#俺}{F#私}の魂の欠片を取り戻すために、スカークは刺され、力を奪われた。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360332
					]
				},
				{
					"id": 150360332,
					"content": "（元凶は霧の向こうにいる。さっきの戦いで攻撃パターンは掴めた。このまま戦えば勝てるはず。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360333
					]
				},
				{
					"id": 150360333,
					"content": "（でもスカークの息がいつもより浅い。軽率に戦いを挑めば、彼女とパイモンが危なくなるかもしれない。悔しいけど…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360334
					]
				},
				{
					"id": 150360334,
					"content": "一旦ここを離れよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360335
					]
				},
				{
					"id": 150360335,
					"content": "勝敗を決めるのはこの瞬間とは限らない——正しい判断だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360336
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360336,
					"content": "お前の魂の欠片を取り戻せたのだから、今回の目的は果たせた。敵の首はまた後日いただくとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360337
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360337,
					"content": "退くぞ。今回はお前が先導する番だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360309,
					"content": "最初からスカークが狙いだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				}
			]
		},
