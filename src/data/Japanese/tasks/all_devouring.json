			},
			"dialogs": [
				{
					"id": 150360501,
					"content": "ふぅ…ここまで来ればひとまず安心だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360502,
					"content": "やつの気配は感じられない。どうやら、まだ深淵の秘境にいるようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360503
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360503,
					"content": "私の力は弱者が容易く制御できるものではない。身体に馴染むまでまともに動けはしないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360504,
						150360505
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360504,
					"content": "「呑星の鯨」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				},
				{
					"id": 150360506,
					"content": "そう驚くことでもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360507
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360507,
					"content": "いや…あの鯨が星を丸ごと呑み込もうと大口を開ける様を見たことがなければ、驚くのも無理はないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360508
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360508,
					"content": "呑星の鯨は「呑噬」の権能を持っている。生者であろうと死者であろうと、その守りを破って本体に触れれば、相手の力を奪える。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360509
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360509,
					"content": "そういえばオイラたちがあいつと戦ったとき、ヌヴィレットも「呑み込みたいという本能に抗うことができない」って言ってたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360510,
					"content": "古龍の生き残りはその力の本質を見抜き、絶えず「水」の権能でお前たちを守っていた。それにあの時の呑星の鯨は腹を空かせていなかったため、本能で我を忘れることもなかったのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360511
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360511,
					"content": "力を使い果たした瞬間、鯨は本性を見せ、星のすべてを喰らい尽くす。故に、特殊な虚無空間に収容していた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360512
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360512,
					"content": "ただ、この星にその権能を扱える者がまだいるとはな。遥か昔に呑星の鯨を見たことがあるのだろう。つまり、師匠の知人のはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360513
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360513,
					"content": "そういえば「極悪騎」に反応してた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360514
					]
				},
				{
					"id": 150360514,
					"content": "だから私は「今回の目的は果たせた」と言ったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360515
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360515,
					"content": "ここからは私個人の問題になる。お前の身体は元に戻った。好きに旅を続けるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360516
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360516,
					"content": "なに言ってんだよ！おまえの力が奪われたんだぞ？放っておけるわけないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360517,
					"content": "挫折や力の喪失といったことは初めてではない。谷底に落ちたのなら、さらに強くなって崖を登るまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360518
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360518,
					"content": "そうだとしても…もし、おまえのケガが治る前に襲われたらどうするんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360519
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360519,
					"content": "しかも力を失ってるんだろ？前みたいに「シュッ」って深淵の扉を開けられないってことじゃんか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360520,
					"content": "オイラたちとしばらく行動したって、別に悪いことないはずだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360521,
						150360522
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360521,
					"content": "「同情」してるわけじゃなくて——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360523,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360524
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360524,
					"content": "お前たちの考えはよく理解した。これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360525
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360525,
					"content": "それは…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360526
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360526,
					"content": "普段モラを入れている物だ。この世界で生きていくには金が必要なんだろう？それくらいの常識は持っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360527
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360527,
					"content": "しばらく世話になる。次の行動が決まり次第、出発するとしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360522,
					"content": "まだ「借り」が残ってるからね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360505,
					"content": "スカークの力まで奪えるなんて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				}
			]
		},
