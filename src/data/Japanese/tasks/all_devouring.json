			},
			"dialogs": [
				{
					"id": 150360601,
					"content": "なあ、スカークからもらったポーチだけど、モラがかなり入ってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360602,
					"content": "バイトでもしてるのか？いや、万民堂での出来事を見る限り、あいつがバイトしたら、きっと——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360603,
					"content": "「店長、今月の給料を払ってくれ」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360604,
					"content": "「ああ、そうだったな…あれ？おまえさん誰だったか？」…ってなりそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360605,
					"content": "へへっ、あいつに会っても一瞬で忘れちゃうからな。…あれ？じゃあ、このモラはどこで手に入れたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360606,
					"content": "地下にあった持ち主のいない財宝や魔物の討伐で得たものだ。法は犯していないから安心して使うといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360607
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360607,
					"content": "うわぁ！聞こえてたのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360608,
					"content": "あれほどの声量で話していれば、山の向こうにいても聞こえる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360609
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360609,
					"content": "ええっと…もしかして前にオイラがこっそり言ったあれも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360610,
					"content": "なんだ？「冷凍スミレウリ」のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360611,
						150360612
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360611,
					"content": "やっぱり聞こえてた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				},
				{
					"id": 150360613,
					"content": "その…それを言ったのはオイラじゃないぞ！オイラとそっくりなやつが、いつも変なあだ名をつけてるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360614,
					"content": "…ううっ、ごめんってば。あの時はおまえがツンケンしてたからつい…でも今はいいやつだってわかってるぞ！おまえのおかげで旅人も命が助かったんだしな。その…友達になってくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360615,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360616
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360616,
					"content": "ここにはベッドが一つしかないようだな。お前たちが使え。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360617
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360617,
					"content": "えっ？じゃあ、おまえはどうするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360618,
					"content": "私は疲れを感じない、故に休息も必要ない。外で剣の修練をしてこよう。そのほうが早く回復する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360619
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360619,
					"content": "でも、おまえの身体は——って、おい！もう行っちゃうのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360620
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360620,
					"content": "ったく、あいつ…！まあいいや、疲れたら戻ってくるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360621
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360621,
					"content": "オイラたちはふかふかのベッドで寝ようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360622,
					"content": "（スカークは意思が強いし、今休めと言っても聞いてくれなそう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360623
					]
				},
				{
					"id": 150360623,
					"content": "（パイモンの言う通り、疲れたら戻ってくるはずだよね。今日はとりあえず寝よう。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360624
					]
				},
				{
					"id": 150360624,
					"content": "はぁ…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360625
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360625,
					"content": "（スカーク…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360626
					]
				},
				{
					"id": 150360626,
					"content": "#（さすがスカーク、この短時間でもう力がいくらか回復した{M#みたいだ}{F#みたい}。でも、なんだか少し様子がおかしい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360627
					]
				},
				{
					"id": 150360627,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360628
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360628,
					"content": "…黙れ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360629
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360629,
					"content": "（「黙れ」？周りには誰もいないのに。もしかして…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360630
					]
				},
				{
					"id": 150360630,
					"content": "ねえ、覚えてる？あの炎で亡くなった大勢の命を…。あの中で、生き残ったのはあなただけなのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360631
					],
					"speakerTitle": "狼狽する通行人"
				},
				{
					"id": 150360631,
					"content": "剣から目を逸らすな。お前に休む資格などない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360632
					],
					"speakerTitle": "狼狽する通行人"
				},
				{
					"id": 150360632,
					"content": "走りなさい、スカーク。死が訪れるまで、走り続けるんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360633
					],
					"speakerTitle": "男性の爽やかな声"
				},
				{
					"id": 150360633,
					"content": "（そうだ。あの夢の中でもスカークは挫折を味わった後、ひたすら独りで剣を振っていた。その時も同じように無数の声が響いていて…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360634
					]
				},
				{
					"id": 150360634,
					"content": "（あの炎は…いったい何があったんだろう？話してくれたらいいんだけど…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360635
					]
				},
				{
					"id": 150360635,
					"content": "早寝早起きでバッチリ健康！このベッドのおかげでぐっすり眠れたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360636,
					"content": "スカーク、一晩中そこに座ってたのか？ちょっとぐらいは休もうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360637
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360637,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360638
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360638,
					"content": "力は戻った？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360639
					]
				},
				{
					"id": 150360639,
					"content": "六、七割程度は。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360640
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360640,
					"content": "えっ、もう！？てっきり数日はかかると思ってたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360641
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360641,
					"content": "いや…このペースは私の予想よりも遅い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360642
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360642,
					"content": "以前であれば、あと二割は回復していたはずだ。同じ方法、同じ感覚だというのに…なぜこのような。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360643
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360643,
					"content": "もしかして、あのトゲのせい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360644
					]
				},
				{
					"id": 150360644,
					"content": "おそらく問題は私自身にあるのだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360645
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360645,
					"content": "これから二日間、ここで瞑想する。意識を完全に心の中に沈め、何があったのかを見極めたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360646
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360646,
					"content": "瞑想！なんだかすごそうだな。じゃあ、オイラたちは近くで見守ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360647
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360647,
					"content": "感謝する。では二日待ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360612,
					"content": "パイモンは小声が苦手だもんね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				}
			]
		},
		{
