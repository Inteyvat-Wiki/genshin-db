					}
				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "行き止まりだ！ここが敵の隠れ家なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360202,
					"content": "霧が濃すぎてなんも見えないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360203,
					"content": "襲撃に遭い、魂の欠片を奪われたのはここだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360204,
					"content": "欠片の在り処を探知できるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360205,
					"content": "（目を閉じて、身体から飛び散った光の粒を思い出してみよう…。ダメだ、近くにあるのは感じるけど、具体的な場所までは掴めない…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "分かりそうにない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "相手も策を講じているようだ。魂の間で起こる共鳴を防ぐために、欠片の気配を遮断したか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360209,
					"content": "おい、見ろ！あのトゲがまた出てきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150360210,
					"content": "お前の魂はいわば人質だ。反撃は最低限に留め、まずは相手の動きを観察しろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360211,
					"content": "魂の欠片を奪った以上、相手はそれを使って何か企んでいるはずだ。攻撃からその意図を読み取れるかもしれない。見極めてみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "スカーク"
				},
				{
					"id": 150360207,
					"content": "近くにあることしか分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
