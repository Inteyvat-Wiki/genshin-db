			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リサ"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "あらあら、ヘルターさんは戻ったみたいだし、グランフィディアさんもいない…ドリンクスポットはすっかり可愛い子ちゃん任せみたいね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480102,
					"content": "#そう、{M#俺}{F#私}がバーテンダー！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "あら、いいわね。安心してオーダーできるわ。後方支援部隊の奇妙な特製ドリンクを飲んだせいで…一晩中眠れなくなって、徹夜で仕事をするはめになる心配もなさそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480105,
					"content": "徹夜での仕事はもう過去の話でしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "そうよ。今のわたくしは、ただのんびり働いている図書館司書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480108,
					"content": "本の返却が遅れる人がもう少し減ってくれたら、わたくしも回収に走り回らなくて済むのに。そうしたら、もっと早くから可愛い子ちゃんと話して、ドリンクを味わえたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480109,
					"content": "じゃあ、今日は何を飲みたい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "えっと、そうね…特に好みのレシピはないから、気分が良くなるような特製ドリンクをお願いするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480112,
					"content": "あとはリラックスしてぐっすり眠れたら最高ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480113,
					"content": "（ドリンクスポットには既に色々なレシピがある。まずはその中から選んでみようかな…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "（元気を取り戻したいなら、リサさんには「雪の調べと朝の輝き」がいいかも…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "何か特別な味の要望はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "今はそんなに忙しくないんじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "名誉バーテンダーが作ってあげるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
		{
			"id": 7054802,
			"completionStepIds": [
				7054806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
