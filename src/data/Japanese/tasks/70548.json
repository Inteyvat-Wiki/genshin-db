						"stepId": 7054806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リサ"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480201,
					"content": "「雪の調べと朝の輝き」だよ。どうぞごゆっくり。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480202
					]
				},
				{
					"id": 705480202,
					"content": "いいわね、可愛い子ちゃん～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480203
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480203,
					"content": "程よい酸味で、甘すぎず、まろやかな口当たり。後味も爽やかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480204
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480204,
					"content": "でも、この特製ドリンクを飲んだら、なんだか元気が出てきたような気がするわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480205
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480205,
					"content": "もしかしたら、あなたは知らず知らずのうちにグランフィディアさんの秘密を解き明かして、彼女のよりもっと効果的な目覚ましドリンクを作り出したのかもしれないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480206,
						705480207
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480206,
					"content": "ドリンクの成分を調整してみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				},
				{
					"id": 705480208,
					"content": "大丈夫よ、急ぐ必要はないわ。目から好奇心が溢れているわよ。まだわたくしに聞きたいことがあるみたいね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480209
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480209,
					"content": "おしゃべりでもしながら、ゆっくり考えましょう。そうすれば、何かひらめくはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480210
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480210,
					"content": "今日はどんな本を回収してきたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480211
					]
				},
				{
					"id": 705480211,
					"content": "ああ、それが何とも言えない出来事があって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480212
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480212,
					"content": "フォンテーヌからゲーテホテルに赴任したばかりの新米料理人が、とても貴重な『モンド千年スイーツ大全』を借りていったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480213
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480213,
					"content": "彼女ったら、スイーツ作りの発想で肉料理を改良して、脂っこさを減らそうなんて考えたの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480214,
						705480215
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480214,
					"content": "甘味だけの肉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480216,
					"content": "そうね。結果から言うと、彼女はカラメルソースの使いすぎで、本来なら香り高いはずのお肉が、甘くてくどくなっていたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480217
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480217,
					"content": "カラメルソースはとっても素直な子なのにね。どんな飲み物に入れても嫌われることなんてない。わたくしもたまに、小さじ一杯ほどアフタヌーンティーに入れるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480218
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480218,
					"content": "そう考えると、料理っていうのは、工夫を凝らせば凝らすほど良くなるってわけでもないみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480219
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480219,
					"content": "なんでノートを持ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480220
					]
				},
				{
					"id": 705480220,
					"content": "あぁ、今日はもう一つ仕事があって、その記録用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480221
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480221,
					"content": "——もうすぐ、遠征隊の団員たちがモンドに帰ってくるでしょ？彼らは長期間モンドの外で活動していたから、味の好みも変わっているかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480222
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480222,
					"content": "それで、騎士たちの変化した味覚に合う新しい食材を輸入できるよう、ジンに頼まれて、調査対象の家庭十数軒を訪ねてきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480223,
						705480224
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480223,
					"content": "緻密な計画だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480225,
					"content": "彼らはモンドのために、時間と労力を費やしてきたんだもの。労ってあげて当然だと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480226
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480226,
					"content": "調査結果の中で、特に言及が多かった食材は、ナタのショコアトゥルの種と、その変わった植物から作られたココアだったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480227
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480227,
					"content": "多くの騎士が手紙の中で、元気を保つためにココアを飲むという習慣について触れていたの。わたくしもホットココアを試してみたけれど、コーヒーに負けないくらい、眠気覚まし効果があったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480228
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480228,
					"content": "最近、他にどこか行ったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480229
					]
				},
				{
					"id": 705480229,
					"content": "「言い訳を作って、外をぶらついているか」ってこと？見抜かれちゃったわね～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480230
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480230,
					"content": "モンドのマイナーなドリンクを調査するために、アカツキワイナリーに寄ってアデリンメイド長とお話をしてきたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480231
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480231,
					"content": "その帰り道、巡回に出ていた騎士のエマートさんに出会ったの。彼女は手に負えない魔物に遭遇して、慌てふためきながらわたくしに助けを求めてきたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480232
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480232,
					"content": "それで、わたくしも一緒に奔狼領まで回り道して、凶暴な猟犬たちをこらしめてあげたの…久しぶりの運動で、とても気持ちよかったわ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480233
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480233,
					"content": "最近はどんな植物が好きなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480234
					]
				},
				{
					"id": 705480234,
					"content": "あら？ずいぶん慎重な言葉選びね。「最近」って限定するなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480235
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480235,
					"content": "しばらく会っていなかったから、わたくしの好みが変わったと思った？それとも…昔のことはもう忘れちゃったのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480236,
						705480237
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480236,
					"content": "リサさんは物知りで、博識だし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480238,
					"content": "隙のない、いい答えね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480239
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480239,
					"content": "学生の頃なら、本に載っている珍しい植物に心惹かれて、見聞を広めながら、まだ見ぬ世界へ飛び出していたでしょうけど…今はもう、穏やかで規則正しい生活に慣れてしまったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480240
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480240,
					"content": "璃月の法律家の言葉を借りるなら、わたくしはもう「悠々自適な老後」みたいな状態に近づいているのよ。もう気まぐれな人間じゃないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480241
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480241,
					"content": "だから、あなたもきっと覚えているはず——数年前に一緒に冒険した時、わたくしのために甘くて清らかな錬金材料を探してきてくれたことを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480242
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480242,
					"content": "わたくしの好みは今も変わっていないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480243
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480243,
					"content": "よし、決めた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480244
					]
				},
				{
					"id": 705480244,
					"content": "リサさんに改良版の特製ドリンクを作る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480245
					]
				},
				{
					"id": 705480245,
					"content": "やっぱり。可愛い子ちゃんは前よりもまた賢くなったみたいね。ちょっとヒントを与えるだけで、ひらめきを掴めるんだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480237,
					"content": "好みが変わってても変じゃないでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480224,
					"content": "本当に配慮が行き届いてるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480215,
					"content": "独創的なアイデアだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480207,
					"content": "レシピを調整して、もう一杯作ろうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				}
			]
		},
