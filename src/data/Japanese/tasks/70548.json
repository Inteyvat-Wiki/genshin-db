			"dialogs": [
				{
					"id": 705480301,
					"content": "できたよ。リサさんのために、特別に調合した新作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480302
					]
				},
				{
					"id": 705480302,
					"content": "リサさんがすぐに寝つけて、安らかな夢を見られるようにするのが目標だから…名前は「夢薔薇」にしよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480303
					]
				},
				{
					"id": 705480303,
					"content": "色合いから器の形まで調整が加えられていて、最初の一杯とは全く違う雰囲気になったわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480304
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480304,
					"content": "見た目だけで言えば、まさしくわたくしの好みね。それじゃあ、味わってみようかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480305
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480305,
					"content": "うふふ…満点ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480306
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480306,
					"content": "まるで…上質なスイーツを堪能した後、シードル湖のほとりを散歩しながら、優しい風に吹かれて、ゆったりとくつろいでいるみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480307
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480307,
					"content": "本当に疲れが癒えていく…でも、気持ちが昂りすぎることもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480308
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480308,
					"content": "ふふっ、なんだか少し眠くなってきたわ。寝る前のドリンクとして、本当に素晴らしい効果ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480309
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480309,
					"content": "この特製ドリンクを褒め称えるエッセイを書いて、可愛い子ちゃんに「バーテンダー界の新たな天才」って称号を授けてあげたいくらい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480310,
						705480311
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480310,
					"content": "そんなちゃんとしなくていいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				},
				{
					"id": 705480312,
					"content": "そういえば、天気のいい爽やかな日に、湖のほとりを散歩するっていうのは悪くないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480313
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480313,
					"content": "可愛い子ちゃんに付き合ってもらって、おしゃべりしながらお散歩出来たらきっと心地良いはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480314
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480314,
					"content": "そして帰ってきた後、また「夢薔薇」を一杯淹れてもらえたら完璧ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480315,
						705480316
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480315,
					"content": "今度必ず！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480317
					]
				},
				{
					"id": 705480317,
					"content": "うふふ、その真剣な態度、しっかり覚えておくわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480318
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480318,
					"content": "その時になって、言い訳して逃げ出したりしちゃだめよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 705480316,
					"content": "時間を空けておくね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480317
					]
				},
				{
					"id": 705480311,
					"content": "リサさんが気に入ってくれさえすれば！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				}
			]
		}
	]
