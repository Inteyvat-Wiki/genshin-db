				"points": [
					{
						"sceneId": 20321,
						"position": [
							1677.129,
							236.029,
							9524.242
						],
						"pointId": 12
					},
					{
						"sceneId": 20321,
						"position": [
							1630.833,
							238.252,
							9528.693
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 60160201,
					"content": "あら、来たのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160202
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160202,
					"content": "サンドローネ！調子はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160203,
					"content": "アナタたちはワタシの傑作を一番最初に見ることになる人間…とフライムになるかもしれないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160204,
					"content": "おいっ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160205,
					"content": "ほら、まばたきせずによーく見てなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160206
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160206,
					"content": "うわ、なんだこれ。見たことないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160207,
					"content": "なんかすごそう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160208
					]
				},
				{
					"id": 60160208,
					"content": "このメーターは「術式」の進捗を直観的に示してくれているの。今はまだ、一番重要な連結を組み上げているところよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160209
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160209,
					"content": "プロセスが完了したら、アナタの元へ届けるわ。そうすればコロンビーナを取り戻せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160210
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160210,
					"content": "届ける？演算結果だけなら、通信で教えてくれればいいじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160211,
					"content": "…ちっ…バカね。これは単なる「計算式」じゃなくて、特定のルールを構築する「術式」なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160212
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160212,
					"content": "…まぁ、これ以上言ってもわからないだろうし、とにかくそれがコロンビーナが戻ってくるために必要な条件だから、覚えておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160213
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160213,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160214
					]
				},
				{
					"id": 60160214,
					"content": "このデータを共有しておくわね。ニコが作った通信ルートを使わせてもらえたから、ドド通話機でこんな感じに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160215
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160215,
					"content": "はい、これで進捗状況が確認できるようになったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160216
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160216,
					"content": "おお！おまえすごいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160217,
					"content": "当たり前でしょ、何をいまさら。おほほほ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160218
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160218,
					"content": "さて、アナタに伝えることはこれで全部よ。時間があったら、他の人たちのところへも行ってあげて。誰一人ヘマしないように監督してね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160219
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160219,
					"content": "ファデュイでは、こういった監督は叱責には含まれない——ワタシはただ、すべてが順調に進むことを願っているだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160220
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60160220,
					"content": "今、術式が稼働中だから動けないの。ワタシの第二の目となって、使命を果たしてきてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		},
