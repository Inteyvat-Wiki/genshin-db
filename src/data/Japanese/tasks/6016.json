					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 60160503,
					"content": "さっきファルカ団長から届いた情報も加えると…うん、やっぱり事前に相談してくれてたんだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160504
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 60160504,
					"content": "彼女の助けがあれば、状況も安定するはずだ。少なくとも、最低限の安全は保障されるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160505
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 60160505,
					"content": "アルベド、ドゥリン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160506,
					"content": "旅人、パイモン！こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160507
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60160507,
					"content": "ちゃんと休めたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160508
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 60160508,
					"content": "心配ありがとう。そこそこ休めたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160509
					]
				},
				{
					"id": 60160509,
					"content": "なら安心だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160510
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60160510,
					"content": "計画通り、ナシャタウンはボクとアルベドに任せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160511
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60160511,
					"content": "ドットーレのエネルギー領域は着々と広がってきてるけど…全力で守り抜くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160512
					],
					"speakerTitle": "ドゥリン"
				},
				{
					"id": 60160512,
					"content": "ボクたちは何度も共に戦って、その度に良い結果を残してきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160513
					],
					"speakerTitle": "アルベド"
				},
				{
					"id": 60160513,
					"content": "今回もきっとそうなるよ。だから、思う存分戦おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベド"
				}
			]
