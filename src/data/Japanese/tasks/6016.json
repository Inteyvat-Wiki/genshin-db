			"dialogs": [
				{
					"id": 60160401,
					"content": "何を見てるんだい？詠月使さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160402
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60160402,
					"content": "詠月使さん、詠月使様…そなたはいろんな呼び方で私を呼ぶな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160403
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60160403,
					"content": "いけないかい？全部あんたのことじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160404
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60160404,
					"content": "だが私は、そなたを「ネフェル」と呼ぶことにしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160405
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60160405,
					"content": "それがあたしの名前なんだから、別におかしくないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160406
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60160406,
					"content": "何も付け加えずに、名前をそのまま呼ぶということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160407
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60160407,
					"content": "どういうことだい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160408
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60160408,
					"content": "私たちの関係が良くなってきた証かもしれぬな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160409
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60160409,
					"content": "美しい錯覚だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160410
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60160410,
					"content": "ネフェル！ラウマ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160411,
					"content": "パイモン、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160412
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60160412,
					"content": "どうだ！準備は順調か？ちゃんと休みながら進めるんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160413,
					"content": "心配してもらわなくても、みんなの足を引っ張ることはないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160414
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60160414,
					"content": "私も、皆の勝利のために尽くそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160415
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60160415,
					"content": "そうだ、少し検査させてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160416
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60160416,
					"content": "…ふむ、二人とも大丈夫そうで…何よりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160417,
						60160418
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60160417,
					"content": "みんなのおかげだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160419
					]
				},
				{
					"id": 60160419,
					"content": "どういたしまして。あんたにはあたしたちの何倍も働いてもらうんだから、ドットーレと戦う時まで、しっかり休むんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160420
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 60160420,
					"content": "大丈夫だ、オイラがちゃんと見張っててやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160421,
					"content": "それなら安心だ。パイモンも休むのだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160422
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60160422,
					"content": "おう、任せろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160418,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160419
					]
				}
			]
