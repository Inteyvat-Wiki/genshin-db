						],
						"pointId": 11
					}
				]
			},
			"dialogs": [
				{
					"id": 60161501,
					"content": "どうやら、充実した二日間を過ごせたようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161502
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60161502,
					"content": "ドットーレ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161503
					]
				},
				{
					"id": 60161503,
					"content": "私からすれば、喜ばしいことだ。実験対象が早々に死んでしまうのは期待外れだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161504
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60161504,
					"content": "お前たちの屈強さには感謝しかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161505
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60161505,
					"content": "もはや同じ次元にはいないとはいえ——相応の敬意は示そう。創造主たるもの、慈悲と礼儀についてはよくわかっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161506
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60161506,
					"content": "お前たちの時を終わらせる前に…世界は私の降臨を知るべきだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「博士」"
				}
			]
		},
		{
			"id": 601619,
			"completionStepIds": [
				601619,
				601628
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"601619",
