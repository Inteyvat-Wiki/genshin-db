			},
			"dialogs": [
				{
					"id": 60160301,
					"content": "旅人さん、パイモンさん。お会いできて嬉しいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160302
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60160302,
					"content": "フリンズ！そっちの準備はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160303,
					"content": "まあまあ、と言ったところでしょうか。ドットーレと正面から戦う準備はできていますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160304
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60160304,
					"content": "おおっ、今回はいつもより本気みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160305,
					"content": "正直に言うと、全力を出すのはあまり好きではないんです。正体を隠すのに都合が悪いですからね。それに、実力の使い所は選ぶべきですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160306
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60160306,
					"content": "力を温存して、肝心な戦いに備える…今の僕はまさに、その状態です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160307
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60160307,
					"content": "フリンズの本気って聞くと、なんだか安心だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160308,
						60160309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60160308,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160310
					]
				},
				{
					"id": 60160310,
					"content": "お二人に信頼していただけて光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60160311
					],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60160311,
					"content": "どうかゆっくり休んでくださいね。決戦の時には、元気なお姿でお会いできますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フリンズ"
				},
				{
					"id": 60160309,
					"content": "心強い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60160310
					]
				}
			]
		},
