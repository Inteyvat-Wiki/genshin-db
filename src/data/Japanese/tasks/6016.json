				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「博士」"
				],
				"points": [
					{
						"sceneId": 20289,
						"position": [
							800.021,
							1199.812,
							784.112
						],
						"pointId": 1
					}
				]
			},
			"dialogs": [
				{
					"id": 60161901,
					"content": "お前たちが必死に足掻こうと小細工をしているのは分かっていた。だが、残念ながら完遂できなかったようだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161902
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161902,
					"content": "…当ててみようか。コロンビーナを呼び戻そうとしているのだろう？しかし、サンドローネの姿が見えないな。ふむ…やつのために時間を稼いでいる、といったところか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161903
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161903,
					"content": "面白い…なかなか癖のある性格をしたあの二人が、まさかお前たちとここまで深い繋がりを持っていたとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161904
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161904,
					"content": "コロンビーナといえば…私もかつては彼女を妹のように思っていた。彼女がファデュイにいた頃は、仲良く、愉快な時間を共に過ごした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161905
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161905,
					"content": "でもある日突然、彼女は一切の実験に参加しなくなった。今でも分からないが、一体何が彼女の機嫌を損ねてしまったのやら——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161906
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161906,
					"content": "まったく、惜しいことだよ。妹が、家族ができたと思っていたのに。彼女は私を慕ってくれなくなってしまった…はぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161907
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161907,
					"content": "#{M#君には彼女の家族になる資格なんてない。}{F#あなたには彼女の家族になる資格なんてない。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161908
					]
				},
				{
					"id": 60161908,
					"content": "それは否定できないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161909
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161909,
					"content": "こんなに多くの人間が古臭い芝居に執着するなんて、世界は本当に腐っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161910
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161910,
					"content": "そしてお前も、本来ならば正解にたどり着けたる人材だったはずだ。それをこうして殺さなければならないと思うと…ふふ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161911
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161911,
					"content": "だが私は誠意ある男だ。もう一度チャンスをやろう——私と協力しないか？十秒間だけ、猶予をやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161912
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161912,
					"content": "一、二、三…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161913
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161913,
					"content": "#{M#（ふざけるな！）}{F#（ふざけないで！）}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161914
					]
				},
				{
					"id": 60161914,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161915
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161915,
					"content": "サンドローネ？珍しいな、お前がこんな高いところに来るとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161916
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161916,
					"content": "相変わらず胸糞の悪いやり方ね。誰もがアナタが与えるチャンスとやらに感謝すると思わないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161944
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60161944,
					"content": "（サンドローネ…？まだ術式は完成してないはずなのに…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161917
					]
				},
				{
					"id": 60161917,
					"content": "いい時に来た…ちょうど旅人と協力の話をしていたところなのだよ。こう思わざるを得ないな——実に勿体ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161918
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161918,
					"content": "もったいない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161919
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60161919,
					"content": "言ったはずだ。全員に平等にチャンスを与えると。だが、自らここへ来るとは…チャンスが無駄になったということだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161920
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161920,
					"content": "はっ！とんだ戯言ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161921
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 60161921,
					"content": "上を片付けてから、ゆっくりとお前の術式を処理するつもりだったんだが…まあいい。わざわざここまで来てくれて、手間が省けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161922
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161922,
					"content": "CS",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60161923
					]
				},
				{
					"id": 60161923,
					"content": "サンドローネ——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161924
					]
				},
				{
					"id": 60161924,
					"content": "見ろ。機械の創造物など所詮はこの程度だ。軽く触れただけで…壊れてしまうのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161925
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161925,
					"content": "サンドローネがどれほど発明に心を奪われていても、彼女が死ねば、その体内の術式は止まってしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161926
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161926,
					"content": "ここまで持ちこたえたのは素晴らしいことだがな。同僚として、彼女の頑固な姿勢は評価してやってもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161927
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161927,
					"content": "さあ、こちらへ来い。私の隣に座るがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161928
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161928,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161929
					]
				},
				{
					"id": 60161929,
					"content": "先ほどはカウントが中断されたが…特別に与えた二度目のチャンスはまだ有効だ。今なら私の側につくことを許してやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161930
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161930,
					"content": "この力がいかほどのものか、お前はよく理解しているはずだ。なぜ、より完璧な可能性へと歩み出そうとしない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161931
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161931,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161932
					]
				},
				{
					"id": 60161932,
					"content": "私と話したくないと——？フン、確かにいつもよりずいぶん口数が少ないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161933
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161933,
					"content": "では、実のある話でもしよう。サンドローネのことだ。彼女は昔からああだった…誰のことも信用せず、研究成果を共有することを好まない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161934
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161934,
					"content": "彼女に長所がないわけではない。膨大な情報から現在の世界式を編み出し、最適化を成し遂げるとは——実に興味深い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161935
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161935,
					"content": "だが、彼女は決して他者を信用しようとしなかった。術式を誰かに任せ、実行させていれば…お前たちにも、まだ一縷の望みがあっただろうに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161936
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161936,
					"content": "頑固で不器用な者を打ち倒すのは、実に心が痛むものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161937
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161937,
					"content": "…ドットーレ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161938
					]
				},
				{
					"id": 60161938,
					"content": "#{M#人は変わるものだと、君は考えもしなかったんだろう？コロンビーナが逃げた時も、今回のサンドローネのことも。}{F#人は変わるものだと、あなたは考えもしなかったんでしょう。コロンビーナが逃げた時も、今回のサンドローネのことも。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161939
					]
				},
				{
					"id": 60161939,
					"content": "変わる、だと…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161940
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161940,
					"content": "#{M#どんな態度を取ろうと…人を信用しようとしてないのは君のほうだ。}{F#どんな態度を取ろうと…人を信用しようとしてないのはあなたのほうだよ。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60161941
					]
				},
				{
					"id": 60161941,
					"content": "お前から見て、私はそのように見えるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60161942
					],
					"speakerTitle": "「博士」",
					"speakerSubtitle": "偽月の異端者"
				},
				{
					"id": 60161942,
