			"completionStepIds": [
				7166401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166401",
							"2"
						],
						"stepId": 7166401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"キャサリン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716640101,
					"content": "旅人さん、やっと来てくださったのですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 716640102,
					"content": "実は最近、冒険者協会にある重要な依頼が入りました。経験上、あなたこそがそれを対処するのに最も適したお方です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640103,
						716640104
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 716640103,
					"content": "重要な依頼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640105
					]
				},
				{
					"id": 716640105,
					"content": "そうかしこまるなよ、キャサリン。オイラたち、とっくに慣れてるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640106,
					"content": "それに、依頼報酬が豪華じゃなかったら、キャサリンもオイラたちにお願いしてこないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640107,
					"content": "コホンッ…それもそうですが…さすがはお二人、毎回話が早いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640108
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 716640108,
					"content": "それでは、本題に入りましょう。今回の依頼人はフォンテーヌから来た研究家、パトリックです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640109
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 716640109,
					"content": "彼は研究の手伝いをしてくれる、何人かの助手を雇いたいそうです。今は、層岩巨淵の外側で考察を進めています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640110
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 716640110,
					"content": "研究内容の詳細についてはまだお聞きしていないのですが、このような依頼なら、あなたたちはもう慣れたものですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640111
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 716640111,
					"content": "確かに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640112
					]
				},
				{
					"id": 716640112,
					"content": "それじゃいつも通り、さっそく層岩巨淵の近くに行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640104,
					"content": "懐かしい内容…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640105
					]
				}
			]
		},
		{
			"id": 7166402,
			"completionStepIds": [
				7166402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166402",
							"2"
						],
						"stepId": 7166402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パトリック"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716640201,
					"content": "これ以上遅れるわけにはいかない、一刻も早く検証に入らないと…いざとなったら、自らやるしかないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640202
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640202,
					"content": "「怪我を負って、やむを得ず研究を中止した」と…。この理由なら、時間が稼げるはずだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640203
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640203,
					"content": "命さえあればいいだろう、帰って審判を受けるよりましだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640204
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640204,
					"content": "#こいつ、一人でなにをぶつぶつ言ってるんだ？声をかけようぜ、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640205,
					"content": "#こんにちは、{M#君}{F#あなた}がパトリック？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640206
					]
				},
				{
					"id": 716640206,
					"content": "びっくりした！あなたたち、どこから出てきたんだ？…それに、どうして私の名前を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640207
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640207,
					"content": "待ってくれ、まさかあなたたちも私服千岩軍なのかい？また私を追い払いに来たとか…？現地考察の許可証ならもう見せたはずだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640208
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640208,
					"content": "禁区には絶対入らないから！もし信じられないようなら、あの怖そうな短い黒髪のお姉さんに聞けばいいさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640209
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640209,
					"content": "誰のことなのか知らないけど、まあまあ、落ち着けって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640210,
					"content": "オイラたちは善良な、プロの冒険者なんだ。協会の依頼を受けて、おまえの悩みを解決しに来たんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640211,
					"content": "救援だったのか？よかった！やっと来てくれたんだね。これで私の研究にも光が見えてきた。そうでなければいずれ、研究のせいでひどい目に遭うところだったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640212
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640212,
					"content": "どうやらおまえは、大分その研究に苦しめられたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640213,
					"content": "何を言う！研究という行為そのものは、神聖で高貴なものなんだ！私を苦しめているのは、あくまでも「付加的な要因」だけなのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640214
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640214,
					"content": "「付加的な要因」？例えば？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640215,
					"content": "研究が失敗したら死ぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640216
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640216,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640217,
						716640218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640217,
					"content": "…自暴自棄に聞こえるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640219
					]
				},
				{
					"id": 716640219,
					"content": "はぁ、冗談を言ってるんじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640220
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640220,
					"content": "個人の研究者は研究をするために資金を申請しなければならない。この資金を使うということは、フォンテーヌの社会的責任を担うに等しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640221
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640221,
					"content": "大金がかかった結果、もし成果を出せなかったら、その人は罪人扱いされて、審判されてしまうんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640222
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640222,
					"content": "このまま手ぶらで帰ったりすれば、「公有財産の浪費」だけでなく、「学術資源」の占用だとか、他にも数十もの罪に問われるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640223
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640223,
					"content": "これらの罪状に対しては最も厳しい処罰が下るだろう…財産と名誉を失うだけならまだしも、審判の結果次第では本当に命を落としてしまうかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640224
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640224,
					"content": "えっ？さすがにひどくないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640225,
					"content": "だから慌てて大金で助手を雇ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640226,
						716640228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640226,
					"content": "フォンテーヌって怖い国だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640227
					]
				},
				{
					"id": 716640227,
					"content": "恐ろしいのは「付加的な要因」だ！私の美しい故郷に罪はない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640230
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640230,
					"content": "まあ落ち着けって。おまえの未来、それに命がこの研究にかかってるってことはよくわかったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640231,
					"content": "安心しろ、全部オイラたちに任せてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640232,
					"content": "もう今や、あなたたちしか頼れないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640233,
						716640234
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640233,
					"content": "何をすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640235
					]
				},
				{
					"id": 716640235,
					"content": "ああ、さっそく本題に入ろう。私の研究テーマは「振晶映射」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640236
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640236,
					"content": "簡単に説明すると、鉱物や宝石に含まれる元素力を引き出して、エネルギーとして利用するということさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640237
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640237,
					"content": "便利そうだな！実用的だし、面白い機械を作れそうだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640238
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640238,
					"content": "でも、そこの宝石とおまえが言ったなんちゃら晶なんちゃら映とには、なんの関係があるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640239,
					"content": "「振晶」がこういう宝石のことなのかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640240
					]
				},
				{
					"id": 716640240,
					"content": "正解！少し前にある人が宝石の元素力を引き出した時、一部の特殊な宝石の間では奇妙な共鳴が起こるということに気付いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640241
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640241,
					"content": "そして、このような宝石を「振晶」と呼ぶことにした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640242
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640242,
					"content": "「振晶」中の「発振晶」が特定の刺激を受けるとエネルギーを放出し、「受振晶」の共鳴を引き出す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640243
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640243,
					"content": "二つの「振晶」の放つエネルギーが重なり合えば、そのパワーは倍増する！私はこの共鳴を「映射」現象と名付けた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640244
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640244,
					"content": "今、研究は私が導き出した「映射関係」を検証するという、重要な段階を迎えているのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640245,
						716640246
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640245,
					"content": "何か、予感が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640247
					]
				},
				{
					"id": 716640247,
					"content": "今までの経験から察するに、オイラたちに「振晶」の力を借りて魔物を倒してくれってことか？それで、さっき言ってたその「映射関係」を検証したがってる、そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640248
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640248,
					"content": "大正解だ！あなたたちは呑み込みが早いな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640249
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640249,
					"content": "適切なエリアに何セットかの「振晶」で作られた石碑をすでに設置したから、準備ができたら私を呼んでくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640250
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640250,
					"content": "検証が必要な項目は詳しく説明するから、私のヒントに従って戦ってくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640251
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640251,
					"content": "これって、オイラたちには退屈なほど、一番得意な仕事だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640252,
						716640254
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640252,
					"content": "興味が湧いた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640253
					]
				},
				{
					"id": 716640253,
					"content": "おまえはもう数え切れないほど強大な敵をやっつけて来ただろ？これくらい、ちょちょいのちょいだよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640256
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640256,
					"content": "すごい勢いだ！璃月はいいところだなぁ。宝石の原石だけでなく、こんなに頼もしい冒険者までいるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640257
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640257,
					"content": "材料の費用を節約するため、遠路はるばる来た甲斐があったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640258
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640258,
					"content": "元々足が出ることに悩んでいたんだが、あなたたちの報酬を払っても尚、資金はまだ二割ほど残っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640259
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640259,
					"content": "もしうまくいったら、その金で新聞社の人を雇って、私の成果をトップ記事として宣伝してもらおうと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640260
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640260,
					"content": "タイトルはもう考えてある。それが、「衝撃の事実！パトリックの振晶に関する研究！」だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640261
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640261,
					"content": "真面目にやれよ！そのタイトル、どう聞いても学術的な文章に合ってないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640262
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640262,
					"content": "投資してもらうには、奇抜で目立つタイトルが必要なんだ！そしたら、配当金の相談もできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640263
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640263,
					"content": "配当金？なにを言ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640264
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640264,
					"content": "もし「振晶映射」の理論が商品の生産に応用されれば、沢山の利益を得られるはずだ。そうすれば、一定の割合であなたたちに分けることもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640265
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640265,
					"content": "当然、研究が上手く行けばだけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640266
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640266,
					"content": "そんなうまい話があるのかよ！よっしゃー！やる気が出てきたぞ！タイトルなんか、好きなのを選べ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640267,
						716640268
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640267,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640269
					]
				},
				{
					"id": 716640269,
					"content": "#とにかく{NICKNAME}、さっさと終わらせようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640270
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640270,
					"content": "そしたら、パトリックとも配当金のことについて話せるしな、へへへっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640268,
					"content": "よだれをたらさんばかりだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640269
					]
				},
				{
					"id": 716640254,
					"content": "パイモンもやってみる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640255
					]
				},
				{
					"id": 716640255,
					"content": "オオオ、オイラはただ、おまえに面白くて挑戦に満ちた依頼を受けてほしいだけだ…別に文句を言ってるわけじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640256
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 716640246,
					"content": "もう分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640247
					]
				},
				{
					"id": 716640234,
					"content": "研究テーマを教えて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640235
					]
				},
				{
					"id": 716640228,
					"content": "「付加的な要因」、恐ろしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640229
					]
				},
				{
					"id": 716640229,
					"content": "その点については、まあ一長一短というところだな。罪人扱いされない限りは、様々な便宜を図ってもらえる。フォンテーヌ出身の人々なら誰でも、この恩恵を受けたことがあるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640230
					],
					"speakerTitle": "パトリック"
				},
				{
					"id": 716640218,
					"content": "面白い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640219
					]
				}
			]
		}
	]
}