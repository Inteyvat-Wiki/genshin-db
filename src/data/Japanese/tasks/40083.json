			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830501,
					"content": "神子、ごめん！まさかポコポコビーニーがあんなに早く左右加さんを脱落させるとは思わなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830502,
						400830503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830502,
					"content": "#パイモン…テイマーは{M#俺}{F#私}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				},
				{
					"id": 400830504,
					"content": "ほう？左右加はどっぷり落ち込んで、「凡人が敵うものではない」などと大げさに言って地面にしゃがみ込んでおるじゃろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830505,
					"content": "まったくその通りだ。あいつをよく分かってるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830506,
					"content": "これでよかったんじゃ。左右加は今回のショックを貴重な糧とし、主人公が成長する過程で受ける挫折を生き生きと描き、読者の心を引っ張る文章を書けることじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830507,
					"content": "悪役の気迫や素晴らしい決戦過程に関しては、汝らから取材させる必要があった。妾のような半人前の選手の前に脱落されては困るからの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830508,
						400830509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830508,
					"content": "うわぁ、悪役にされた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830510,
					"content": "ご飯をたかるのは今関係ないだろ！神子、左右加さんにオイラのことを書く時は手加減してくれって言っておいてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830511,
					"content": "旅人、パイモン、それに八重お姉さん…コホンッコホンッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830512
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830512,
					"content": "レイラ、無理するなよ。いつ気を失うか気が気じゃないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830513,
					"content": "だ、大丈夫…この前、生論派の学生に手紙を出したでしょう。そしたら意外と熱烈な反応で、たった数時間後に、私の必要な情報の入った手紙を返してきてくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830514
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830514,
					"content": "その資料を基に、テンテンヨーヨー獣に色んなものを作ってみたんだけど、食材が間違ってたのか、テンテンヨーヨー獣はあまり気に入ってくれなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830515
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830515,
					"content": "その後、改良版のリストを作ったの…あ、ポコポコビーニーの好きそうな食材も入れたよ。そのせいで、寝るのが夜中過ぎになっちゃったから、今日は少し息がしづらくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830516
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830516,
					"content": "もう結果が出たのか？すごい効率だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830517,
					"content": "（よく眠れなかっただけで、呼吸まで…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830518
					]
				},
				{
					"id": 400830518,
					"content": "レイラちゃん、そっちの様子はどうじゃ？ちゃんと相手を「おもてなし」できておるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830519,
					"content": "うん！八重お姉さんが修行に連れて行ってくれたおかげで、テンテンヨーヨー獣も私の言うことをよく聞いてくれるようになったの。反応速度も羨ましくなるくらい速いよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830520
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830520,
					"content": "だけど、相手も明らかに強くなっていて、プレッシャーがどんどん大きくなってきてる。準々決勝に入るために、テンテンヨーヨー獣ともう一度訓練しておきたいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830521
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830521,
					"content": "うーん…明日は朝の七時から「全能商人」のところに行って、予定してる食材をぜんぶ買わないといけないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830522
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830522,
					"content": "ならば簡単な話じゃ、訓練には妾が付き合ってやろう。買い物は、童たちに任せればいいのじゃ。何せ、使い走りには慣れておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830523
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830523,
					"content": "そうなの…二人はよく八重お姉さんのために働いてるってこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830524,
						400830525
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830524,
					"content": "そう、喜んで！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830526,
					"content": "あっ！そうそう！オイラたちのことを怖い悪役にしないでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830527,
					"content": "案ずるでない、レイラちゃん。こやつらはついさっきまで、左右加を脱落させたことを謝っておったほどじゃ。先に飲み物でも買って休憩してくるがよい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830528,
					"content": "ありがとう！本当に助かります！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830529
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830529,
					"content": "「全能商人」との待ち合わせ場所はここだよ。食材リストも書いてあるから、受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830530
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400830530,
					"content": "おう、気にするな！おまえもポコポコビーニーの好物を調べてくれたんだし、これくらい当然だ！だから、安心して行っていいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830531
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830531,
					"content": "前回は深く踏み込むことのできなかった話題——この大会の裏の「不安要素」についても…よい切り口があるやもしれぬ。キノコンを育成する材料がの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830532,
						400830533
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830532,
					"content": "「フラワーゼリー」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830534,
					"content": "これは小説における最も素晴らしい展開の一つ——秘密調査じゃ。童はずっと気になっておったじゃろう？…「叡智宝珠」と「フラワーゼリー」の魔力がどこから来たのかについて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830535
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830535,
					"content": "それに、この大会の裏を突き止めもせず、ハニヤーに自分の意志だけで無謀な行動をさせれば、更に大きな混乱を招くことになるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830536
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830536,
					"content": "うぅ…話が急に複雑になって、オイラ、ついてけないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830537
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830537,
					"content": "夜が明ける直前に行動したほうがよい。皆が一番疲れている時間帯じゃ。もしかすると、鍵となる手がかりが見つかるやもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830538
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830538,
					"content": "本当に神子の言う通りにするのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830539,
						400830540
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830539,
					"content": "これが大会に参加した元々の理由だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830541,
					"content": "確かにそうだな。それじゃ、明日の朝早くから、キノコンを育てるところに行ってみようぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830542
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830542,
					"content": "オイラたちは大会の安全性を確認してるだけだ。ポコポコビーニーのことを疑ったりは絶対しないから、安心しろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830540,
					"content": "仲間と安心して共存するためにはね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830533,
					"content": "神子は何か聞いてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830525,
					"content": "#もし断ったら、{M#俺}{F#私}のイメージが…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830509,
					"content": "悪役にご飯をたかるパイモンはもっと悪い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830503,
					"content": "#全責任は{M#俺}{F#私}にある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				}
			]
		},
		{
