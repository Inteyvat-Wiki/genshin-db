			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レイラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831301,
					"content": "旅人、パイモン！無事勝ち残ったの、スケジュールで見たよ。おめでとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831302
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400831302,
					"content": "おお、レイラだ！今日は元気そうだな、テンテンヨーヨー獣も喜んでるところを見ると、どうやら大勝利だったみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400831303,
					"content": "ううん、今回は辛勝だったの。でも、私たちの方がほんの少しだけ上回ってたみたい…八重お姉さんと一緒に訓練しててよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831304
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400831304,
					"content": "あっ、さっき「全能商人」から欲しかったものが届いたよ、本当にありがとう！あとでテンテンヨーヨー獣のケアをしてから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831305
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400831305,
					"content": "うぅ、コホッ…力が抜けた…やっぱり大声で話すのはやめよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831306
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400831306,
					"content": "そういえば、神子を見ないな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400831307,
					"content": "八重お姉さんは何か急用があったみたいで、左右加さんたちと先に行ったよ。「三十人団」の傭兵が道案内をしてたみたいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831308
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400831308,
					"content": "会場に戻った時にはすでに遠くに行ってたから、追いかけて聞くのもなんだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831309,
						400831310
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400831309,
					"content": "まだ仕事があるのかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				},
				{
					"id": 400831311,
					"content": "確かに、このところ神子はずっとバトルしてるし、たまには編集長様の仕事をやっててもおかしくないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400831312,
					"content": "それにあいつ言ってたぞ、休暇を取りながら取材するって。その傭兵もガイドなのかもしれないし、心配はいらないと思うぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400831313,
					"content": "うん。次はいよいよ、肝心の準々決勝だね…ちょっと怖いけど、一緒に頑張ろうね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831314
					],
					"speakerTitle": "レイラ"
				},
				{
					"id": 400831314,
					"content": "おお！なんやかんや、オイラたち結構順調に来たよな。レイラも頑張れよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831315,
						400831316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400831315,
					"content": "#{M#俺}{F#私}たちも気を緩めないでおく。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831317,
					"content": "うんうん、オイラたちも警戒を緩めずに行こう！そうだ、ドリーから貰ったものの写真も撮っておこうぜ。今朝の写真と一緒に保管して、神子に会ったらまた渡そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400831316,
					"content": "バトルも調査も、両方に気を留めておかないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831310,
					"content": "「八重堂」は激務だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				}
			]
		},
		{
			"id": 4008314,
			"completionStepIds": [
				4008307
			],
