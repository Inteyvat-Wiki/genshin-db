			},
			"dialogs": [
				{
					"id": 400831401,
					"content": "見た目はただの「フラワーゼリー」だぞ。まあ、元々は展示用のものだしな…レシピも机の上に置いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831402,
