			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ドリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830901,
					"content": "レイラのメモによると、「全能商人」との待ち合わせ場所はここみたいだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830902,
					"content": "きょろきょろなさって…「全能商人」をお探しですかしら？ならば、いらっしゃいませ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830903
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830903,
					"content": "そうそう、よくわかって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830904
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830904,
					"content": "えっ？なんでドリーがここに？レイラの言う「全能商人」って、おまえのことだったのかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830905
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830905,
					"content": "まったく、何がおかしいのでしょう？「サングマハベイ様の品は一番豊富で一番不思議なもの」、これは全グランドバザールのオーナーとお客様が知っている事実ですのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830906
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830906,
					"content": "「万能」、「全能」、「大能」…能とあるものは、すべてこのドリーの専売特許——他の商人は使うことすらできませんわ。まあ、数百万モラの使用料を払っていただけるならば話は別ですけれど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830907
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830907,
					"content": "うぅ、まあはじめから予想は付いたはずだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830908,
					"content": "ところで、レイラさんはあなたたちに使い走りを頼みましたの？どうやら、彼女は本当にテイマー大会に夢中のようですの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830909
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830909,
					"content": "おまえ、レイラとそんなに仲良かったのか？あいつに随分詳しいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830910
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830910,
					"content": "ふふっ！これは仲とは関係ありませんわ。レイラさんは私のところから買い物をしたことがあります。大した額ではないけれど、学生にとっては相当太っ腹でしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830911
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830911,
					"content": "ですから、彼女の動きを気にして当然でしょう？そうして、その怪しい大会のことも知ったわけですのよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830912,
						400830913
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830912,
					"content": "隠し事を知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				},
				{
					"id": 400830914,
					"content": "いいえ、私はただ、少しおかしいと思っただけですわ。そうだ、ちょうど売れなくて困っている品がありますの…置いておいても錆びるだけですから、ほほほっ、あなたたちにお渡ししましょう～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830915
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830915,
					"content": "ん…？ただのパーツとノートの欠片じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830916
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830916,
					"content": "聞いた話によると…これらは大会の主催側が消そうとした装置と資料だそうですわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830917
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830917,
					"content": "彼らはうっかりさんで、拾い物でお金持ちになりたい者もいるということに配慮できなかったようですわ！すべて回収され、私の手元に来たわけですの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830918
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830918,
					"content": "よく見ると、この資料に書いてある単語…「フラワーゼリー」のレシピに似てるぞ。装置の残骸も「叡智宝珠」と似てるところがあるし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830919,
					"content": "ひょっとすると、実験用のものかもしれないぜ。とりあえず保管しておいて、神子にも見せよう。なにか怪しいところが見つかるかも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830920,
						400830921
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830920,
					"content": "今立てられる仮説は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830922,
					"content": "結局、はじめに心配してたこと現実になっちゃうんだよな…うぅ、もっとポコポコビーニーとのんきに遊んでたかったのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830923
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830923,
					"content": "何についてお話しなのか分かりませんけれど、これらのものがお役に立てたようですわね。それでは、割引して——六千万モラでお譲りしましょう！毎度ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830924
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830924,
					"content": "えっ！それはずるいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830925
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830925,
					"content": "あら、ふふふっ、冗談ですわ。こういうものに興味があるのは、あなたたちとマハマトラくらいですもの。普通の商売をした後の、おまけといたしますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830926
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830926,
					"content": "レイラさんの注文票については任せてくださいまし。レイラさんの欲しいものが分かり次第、品を手配して、専門の業者の手でお届けしますわ。もう使い走りをしなくてもよいですわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830927
					],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830927,
					"content": "あー、びっくりした。努力がすべて無駄になったかと思ったぜ。賞金をゲットしたとしても、簡単に払える額じゃないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830928
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400830928,
					"content": "これがレイラの注文票。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830929
					]
				},
				{
					"id": 400830929,
					"content": "うーん、松茸の屑が混ざった小麦粉に、古いジャム、それにザイトゥン桃ジュース…キノコンって本当にこんなものを食べますの？レイラさんは一体どこからこの情報を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ドリー"
				},
				{
					"id": 400830921,
					"content": "カウトリヤに問題があるということ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830913,
					"content": "情報は掴んでる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				}
			]
		},
		{
			"id": 4008313,
			"completionStepIds": [
				4008313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
