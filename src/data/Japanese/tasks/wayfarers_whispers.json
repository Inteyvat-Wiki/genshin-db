			"dialogs": [
				{
					"id": 756690101,
					"content": "#{NICKNAME}、こっちこっち！いいものを見せてやるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690102,
					"content": "ほら、これ全部旅先で撮った写真だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690103,
					"content": "またいろんな場所を歩き回ったけど、おまえが道を探してる間、オイラもいろいろやってたんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690104,
					"content": "ほら、全部オイラの写真機で撮った写真だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690105,
					"content": "そうだ。ダーモヴィル雑貨店で買った二冊のアルバムのこと覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690106,
						756690108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690106,
					"content": "覚えてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690107
					]
				},
				{
					"id": 756690107,
					"content": "おまえなら覚えてくれてると思ったぜ！あの二冊は、オイラがすっごく前から予約して、コツコツ貯めてきた小銭で買ったんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690111,
					"content": "あの二冊をオイラとおまえで一冊ずつ分けたんだよな。デザインもおそろいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690112,
					"content": "オイラのアルバムには写真がけっこう溜まってるけど…おまえのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690113,
					"content": "予備にしようと思って新しいアルバムを買ったんだけど、おまえのアルバムがいっぱいになってるなら、このアルバムを使ってもいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690114,
						756690117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690114,
					"content": "パイモンは写真を撮るのが好きなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690115
					]
				},
				{
					"id": 756690115,
					"content": "おう！オイラたちって、ホントにいろんな場所を旅して、普通の人が見られないような景色を見てきただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690116,
					"content": "記念に写真を残しておかないと、もったいないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690121,
					"content": "それに、もっと大事なのは…これがオイラたち「二人」の大切な思い出だってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690122,
					"content": "これまでの思い出も、これからの日々も、大事にしてかないといけないんだ。テペトル竜の部族のパカルおじさんが教えてくれた言葉なんだけど、一理あるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690123,
					"content": "今回はオイラの写真機を貸してやるから、いっぱい写真を撮ってくれよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690124,
					"content": "オイラたち、もうすぐスネージナヤに行くだろ？でも、次の旅は一筋縄じゃ行かないって予感がするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690125,
					"content": "だからその前に、これまでの旅で感じてきたことを整理しておこうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690126,
					"content": "どんな困難にぶつかっても、オイラたちが一緒に経験してきたことを思い出せば、勇気がみなぎってくるはずだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690117,
					"content": "パイモンは気配り上手だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690118
					]
				},
				{
					"id": 756690118,
					"content": "えっへん！もちろんだぞ！オイラはテイワット一のガイドだからな。気配り上手なところ以外にも、いいところがいっぱいあるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690119,
					"content": "わざわざ予備のアルバムを買ったのも、写真が好きだからなんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690120,
					"content": "これまで、たくさん特別な景色を見てきただろ？記念に写真を残しておかないともったいないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690108,
					"content": "覚えてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690109
					]
				},
				{
					"id": 756690109,
					"content": "えっ、覚えてないのか？あの二冊は、オイラがすっごく前から予約して、コツコツ貯めてきた小銭で買ったんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756690110,
					"content": "まあ、おまえは気を使うことが他にたくさんあるもんな。心が広くて優しいオイラは気にしないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}