			"trigger": {
				"objectNames": [
					"ラドプ",
					"ファルシ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "僕たちには、もっとデータが必要なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300102,
					"content": "きみのその装置にはデータの裏付けが足りない。それでどうやって正常に動作すると言うんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300103,
					"content": "お前こそ、すべてのデータを完全に集め尽くしてからでないと動けないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300104,
					"content": "お前は魚を捕まえるのに、すべての波を調べ尽くすのかよ？下を見て、魚がいればそれでいいだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300105,
					"content": "それこそが、きみが永遠に魚を捕まえられない理由だと言っている！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300106,
					"content": "ハルヴァタットで勉強したことがないわけじゃないがな、言葉をこねくり回している場合じゃない。何事もまずやってみなけりゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300107,
					"content": "これ以上引き伸ばせば、俺たちとヤスミンの論文は時流から外れるかもしれないんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300108,
					"content": "何を騒いでるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "きみは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300110,
					"content": "ヤスミンが言っていた旅人だな。お前には色々と世話になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300111,
					"content": "これはこれは！旅人さん、お会いできて嬉しいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300112,
					"content": "俺はファルシ、クシャレワー学院で学んでいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300113,
					"content": "僕はラドプ、スパンタマッド学院の学生だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300114,
					"content": "旅人、俺たちもお前に手伝ってほしいことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300115,
					"content": "ヤスミンが最近、この「聖樹」の根の周りに薬を撒いているのは知っているな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300116,
					"content": "しかし…その…最近ヤスミンが撒いた薬には問題があったようなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300117,
					"content": "彼女が薬を撒いた地域の周りには、様々な魔物が出現するようになるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300118,
					"content": "僕は誓って、絶対に薬の処方や投薬の配分を変えていない。きっと…うん、何か予想外のことが起きたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300119,
					"content": "そうは言うけどなあ…とにかく旅人、一緒にヤスミンが薬を撒いた場所を見に行ってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300120,
					"content": "例によって大量の魔物が出現しているかもしれないんだが、俺たちだけでは行く勇気がないんだ…力のあるやつに同行してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300121,
					"content": "もっと重要なのは、たとえキノコンにはあまり危険性がないとしても、教官が僕たちの薬に問題があることを知れば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300122,
					"content": "俺たちの論文の研究計画書は突っ返されるに決まってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300123,
					"content": "特に僕のスパンタマッド学院は、提出したデータに誤りがあった場合、先生から厳しく叱責されるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300124,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "今までどうやって問題を解決してたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "基本は自分たちで冒険者を雇うか、教官のところに行って、教官の名前で信用できるエルマイト旅団のメンバーを探すんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300127,
					"content": "だが、教官の堪忍袋の緒も限界でね。今の状況じゃ、わざわざ会いに行く勇気はないなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300128,
					"content": "だから、きみにお願いするしかないんだ！旅人さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラドプ"
				}
			]
		},
		{
