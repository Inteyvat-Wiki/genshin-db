				"points": []
			},
			"dialogs": [
				{
					"id": 230300201,
					"content": "あっ、あの箱！中身は多分薬だ。ヤスミンがここに来たんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300202,
					"content": "あれ？箱の薬、まだフタが開いてない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300203,
					"content": "そのフタは開けるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300204,
					"content": "うわあ！後ろ後ろ、キノコンが出てきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230300205,
					"content": "なんだって！？今までいなかったのに？何が起こってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300206,
					"content": "#そいつらは放っとけ！{NICKNAME}、行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 2303004,
			"completionStepIds": [
				2303004
