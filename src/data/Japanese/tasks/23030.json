			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラドプ",
					"ファルシ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300401,
					"content": "薬の缶が壊されなくてよかった。もしそうなってたら、僕たちは今ごろゲーゲー吐いてただろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300402,
					"content": "お前、まだこの臭いに慣れてないのか？自分で作ったんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300403,
					"content": "何度も説明しただろう。僕はこれに催吐剤を入れたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300404,
					"content": "慣れる慣れないじゃなくて、これを嗅いだら、誰だって体が勝手に嘔吐反応を起こすんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300405,
					"content": "何回言っても、きみは絶対に理解しないよなあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300406,
					"content": "しかし、ヤスミンは一体どこに？薬も撒かずに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300407,
					"content": "きっと珍しい植物でも見つけて、サンプルを採るのに忙しいんだろう。アムリタ学院の連中の習性を知らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300408,
					"content": "まあいいさ。この薬は僕たちで見張っておこう。ありがとう旅人さん、これを受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300409,
					"content": "あのアムリタどもときたら…まったく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ファルシ"
				}
			]
		},
		{
			"id": 2303005,
			"completionStepIds": [
				2303005
			],
