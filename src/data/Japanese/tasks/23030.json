				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラドプ",
					"ファルシ",
					"ヤスミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "ゲホンゲホン、ゲホゲホ…こ、ここは…？平気か…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300502,
					"content": "う…おえぇ…こ…これ、お前が作ったんだろう！お前が吐いてどうすんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "ファルシ"
				},
				{
					"id": 230300503,
					"content": "おえ…ゲホ…ゲホゲホ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "きみ…きみには…何度も説明しただろう。僕はこれに催吐剤を入れたんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300505,
					"content": "慣れる慣れないじゃなくて、これを嗅いだら、誰だって体が勝手に嘔吐反応を起こすんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300506,
					"content": "何度言っても、きみは絶対に理解しないよな…うぷ…おえぇ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "ラドプ"
				},
				{
					"id": 230300507,
					"content": "あら？ラドプとファルシ、それに旅人さん？どうしてここへ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230300508,
					"content": "薬の缶が割れて…魔物に襲われたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230300509,
					"content": "状況だけ見れば…確かにそうなんだけど。きみが来た時、魔物はいなかったのかい？",
					"roleType": "TALK_ROLE_NPC",
