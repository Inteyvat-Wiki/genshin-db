			"dialogs": [
				{
					"id": 700081401,
					"content": "どう、試しに飲んでくれた人はいたかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081402
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700081402,
					"content": "飲んでもらった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081403
					]
				},
				{
					"id": 700081403,
					"content": "風花祭で「合理的に酔う」ね…どうりで「エンジェルズシェア」にお客さんがあんなに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081404
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700081404,
					"content": "それもいいかもね。「合理的に酔う」人以外に、子供たちや勤務中の衛兵たちもいる。その人たちにとっては、祭り期間中の特製ドリンクだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081405
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700081405,
					"content": "私は引き続きこのドリンクを作るわ。手伝ってくれてありがとう、これを受け取ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081406
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700081406,
					"content": "それと、風花祭を楽しんできてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーガレット"
				}
			]
		},
