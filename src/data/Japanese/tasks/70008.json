					"nextDialogs": [
						700081305
					]
				},
				{
					"id": 700081305,
					"content": "ほんと？じゃあ飲んでみるね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081306
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 700081306,
					"content": "#美味しい！甘くて冷たい！{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}、これってキャッツテールの新しい飲み物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081307
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 700081307,
					"content": "ティミーとリリーにも教えてあげなきゃ！みんなもきっと飲みたいと思う！",
					"roleType": "TALK_ROLE_NPC",
