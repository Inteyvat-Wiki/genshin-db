					"マーガレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700083801,
					"content": "さて、材料も全部揃ったし、ドリンク作りを始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083802
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083802,
					"content": "一体どんな味になるかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083803
					]
				},
				{
					"id": 700083803,
					"content": "君も飲んでみたいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083804
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083804,
					"content": "作り方は別に複雑じゃないわ。私が言った通りの順番で調合すれば、きっと成功できるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083805
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083805,
					"content": "どうせなら…旅人、君が作ってみる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083806
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083806,
					"content": "やってみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700083807
					]
				},
				{
					"id": 700083807,
					"content": "いいわよ。じゃあ調合の順番を言うから、しっかり覚えてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083808
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083808,
					"content": "まず<color=#00E1FFFF>スイートフラワー</color>を入れてから、調合用のベースを入れる。もちろん、今回使うのは<color=#00E1FFFF>牛乳</color>よ。これで爽やかで甘いベースが出来る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083809
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083809,
					"content": "風味を加えるために、今度は<color=#00E1FFFF>風車アスター</color>を入れる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083810
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083810,
					"content": "まだ混ぜたらダメよ。少し<color=#00E1FFFF>置く</color>と、花の香りがゆっくりと引き出されるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083811
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083811,
					"content": "それから<color=#00E1FFFF>蒲公英の種</color>を入れれば、星みたいに綺麗に見えるの。最後に<color=#00E1FFFF>アイス</color>を入れたら完成よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083812
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083812,
					"content": "美味しく調合するためにはこの順番を守る必要があるわ。しっかり覚えてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700083813
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700083813,
					"content": "覚えたら私に言ってちょうだい。もう一度聞いてもいいわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーガレット"
				}
			]
		},
