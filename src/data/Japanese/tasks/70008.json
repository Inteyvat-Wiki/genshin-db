			"dialogs": [
				{
					"id": 700081101,
					"content": "やっぱり…祭りは何か飲まないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081102
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 700081102,
					"content": "キャッツテールの新ドリンクについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081103
					]
				},
				{
					"id": 700081103,
					"content": "俺に試してほしいのか？はははっ、良いけど、俺は酒にうるさいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081104
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 700081104,
					"content": "どれどれ…ん？このドリンク、酒の味がまったくしない。ミルクみたいな味だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081105
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 700081105,
					"content": "うーん、味は悪くないが、酒の味がしないんじゃ、この祭りには合わないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081106
					],
					"speakerTitle": "ニムロド"
				},
				{
					"id": 700081106,
					"content": "みんなこの風花祭で「合理的に酔う」ことを望んでるんだ。こんな酒が一滴も入ってない飲み物、人気がないと思うぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ニムロド"
				}
			]
		},
