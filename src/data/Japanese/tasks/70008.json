				{
					"id": 700081201,
					"content": "こんにちは、何かお困りかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081202
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700081202,
					"content": "キャッツテールの新ドリンクについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081203
					]
				},
				{
					"id": 700081203,
					"content": "悪いけど、今勤務中なんだ。お酒は勘弁してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081204
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700081204,
					"content": "お酒は入ってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081205
					]
				},
				{
					"id": 700081205,
					"content": "お酒が入ってない？あぁ…それなら、ちょうど喉も渇いたし…ありがとう、いただくよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081206
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700081206,
					"content": "うん、この味、美味しいよ！スースーする感じがして目が覚める。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081207
					],
					"speakerTitle": "アラミス"
				},
				{
					"id": 700081207,
					"content": "キャッツテールの新商品って言ったか？時間があったらまた飲みに行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アラミス"
				}
			]
