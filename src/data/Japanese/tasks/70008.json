				},
				{
					"id": 700081505,
					"content": "風花祭にぴったりのドリンクね。君たちに任せて正解だったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081506
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700081506,
					"content": "あとは、誰かを見つけてこのドリンクを試してもらうだけね。旅人、任せてもいいかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081507
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700081507,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700081508
					]
				},
				{
					"id": 700081508,
					"content": "じゃあお願いね。風神像の近くは人も多いから、そこで探してみるといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
