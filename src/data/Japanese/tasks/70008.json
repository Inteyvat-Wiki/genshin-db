			"trigger": {
				"objectNames": [
					"マーガレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700080101,
					"content": "やっぱり、新しい特製ドリンクを出したほうがいいのかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080102
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080103
					]
				},
				{
					"id": 700080103,
					"content": "今風花祭をテーマに、新しい特製ドリンクを出そうかと考えてたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080104
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080104,
					"content": "風花祭はみんな城内で遊ぶから、何か食べたり飲んだりするでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080105
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080105,
					"content": "でもお酒ばっかり飲んでたら酔っぱらっちゃうし、酷い時は西風騎士に連れて行かれてしまうわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080106
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080106,
					"content": "それに、お酒の匂いがきついと、雰囲気を壊しちゃうし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080107
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080107,
					"content": "そ、そうなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080108
					]
				},
				{
					"id": 700080108,
					"content": "もちろんよ…お酒の匂いが好きな人もいるだろうけど、祭りの日に酔っぱらいが道に倒れてるなんていけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080109
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080109,
					"content": "だから、ミルクをベースにした「風」の味がするノンアルコールのドリンクを出そうと考えてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080110
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080110,
					"content": "「風」の味を強調するためには、2種類の特殊な材料が必要ね。蒲公英と風車アスターよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080111
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080111,
					"content": "でも私一人で探してたら時間がかかっちゃうし…旅人、1種類だけ探してきてくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080112,
						700080116
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080112,
					"content": "蒲公英を探してくるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080113
					]
				},
				{
					"id": 700080113,
					"content": "じゃあお願いね。星拾いの崖の近くにある蒲公英は上質なものが多いから、そこで採集してきてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080114
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080114,
					"content": "私も風車アスターを集めておくわ。材料が集まったら、ここに集合しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080115
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080115,
					"content": "ここで作れば、試し飲みしてもらうのも便利だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080116,
					"content": "風車アスターを探してくるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700080117
					]
				},
				{
					"id": 700080117,
					"content": "じゃあお願いね。風立ちの地の近くにある風車アスターは上質なものが多いから、そこで採集してきてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080118
					],
					"speakerTitle": "マーガレット"
				},
				{
					"id": 700080118,
					"content": "私も蒲公英の種を集めておくわ。材料が集まったら、ここに集合しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700080119
					],
					"speakerTitle": "マーガレット"
				},
				{
