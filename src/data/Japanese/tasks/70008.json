					"nextDialogs": [
						700081303
					]
				},
				{
					"id": 700081303,
					"content": "キャッツテール…グレイスおばさんが、子供はお酒を飲んじゃいけないって言ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700081304
					],
					"speakerTitle": "ノーラ"
				},
				{
					"id": 700081304,
					"content": "お酒は入ってない。",
