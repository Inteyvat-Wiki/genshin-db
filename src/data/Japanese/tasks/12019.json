			},
			"dialogs": [
				{
					"id": 120190101,
					"content": "どうした、何か話したいことでもあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190102,
					"content": "「団子牛乳」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "あやつはきっとその飲み物を大層気に入ったんじゃろうな。心の中では大喜びじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190104,
					"content": "きっと「早く、この屋台を『一心浄土』でも開店してください！」と思っていることじゃろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190105,
					"content": "「雷電将軍」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "あの人形のことじゃな。人形の規則を修正することは非常に手を焼くことであると、妾も聞いたことがあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190107,
					"content": "それはきっと、あやつにとって前代未聞と言えるほど大変なことなのじゃろう。想像してみるといい、あの賢い影ですら難しいと感じる事を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190108,
					"content": "「無想の一太刀」でさえも解決できぬことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190109,
					"content": "「娯楽小説」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "転生して雷電将軍になる、面白い考えではないか？娯楽小説は面白ければなんでもいいんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190111,
					"content": "じゃがあやつにとって、なんというか、少し先進的がすぎたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190112,
					"content": "ふむ、今度は「転生して八重宮司になる」という題材で募集してみるというのはどうじゃ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190113,
					"content": "なんでもない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}