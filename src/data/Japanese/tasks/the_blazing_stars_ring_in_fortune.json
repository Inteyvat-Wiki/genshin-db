			"dialogs": [
				{
					"id": 400350701,
					"content": "ふぅ——いっぱい食べた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350787
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350787,
					"content": "♪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350702
					],
					"speakerTitle": "グゥオパァー"
				},
				{
					"id": 400350702,
					"content": "ほんっと香菱、あんなタレを焼き魚につけて食べるなんて方法よく思いつくよね。それにあのタレ、味も最高だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350703
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350703,
					"content": "えへへ、アタシ特製のタレだからね、味は保証するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350704
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350704,
					"content": "絶雲の唐辛子をさっと炒め、ニンニクとネギを入れて混ぜる。それに塩、酢、醤油を加え、最後に熱い油で香りを引き立たせたタレ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350705
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350705,
					"content": "一見雑な手法の裏には、味や調味料の比率を正確に理解している料理人の姿がある。どの過程においても、量は適切でなくてはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350706
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350706,
					"content": "それ即ち「匠の技」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350780
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350780,
					"content": "そうそう。どう？香菱、お褒めの言葉をもらえて、うれしい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350781
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350781,
					"content": "えへへ…すごく照れるよ…ありがとう、鍾離さん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350782
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350782,
					"content": "私も口が上手いほうだと思ってたけど、あなたと比べると、まだまだみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350783
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350783,
					"content": "堂主が俺に礼を尽くす必要はない。堂主の弁舌は璃月港全体が知っていることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350784
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350784,
					"content": "♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350785
					],
					"speakerTitle": "グゥオパァー"
				},
				{
					"id": 400350785,
					"content": "グゥオパァーも何か注文する？遠慮しないで、この堂主の私が奢るから！まあ、香菱につけておくけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350786
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350786,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350707
					],
					"speakerTitle": "グゥオパァー"
				},
				{
					"id": 400350707,
					"content": "また美味しいもんの話でもしてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350708,
					"content": "あっ！旅人とパイモンちゃんじゃない。ここに来るなんて、今日はどういう風の吹き回し？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350709
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350709,
					"content": "待って！まだ言わないで、この堂主が直々に当ててみせるわ…うーん、ずばり、海灯祭に来たんでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350710
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350710,
					"content": "えーっと、別に考えなくても、見ればわかるんじゃないか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350711,
					"content": "まあまあ、お互い知った仲なんだし、ちょっと遊び心を入れたほうが面白いでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350712
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350712,
					"content": "いい時に来たね、ちょうどみんなに新しい料理を試食してもらってたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350779
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350779,
					"content": "三杯酔の店主からは高評価をもらって、鍾離さんと胡桃にも満足してもらえたんだけど、もっといろんな人に試してもらわないといけない気がするの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350713
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350713,
					"content": "どう？あなたたちも食べてみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350714
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350714,
					"content": "食べる食べる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350715
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350715,
					"content": "鍾離先生を訪ねに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350716
					]
				},
				{
					"id": 400350716,
					"content": "えっ？た、食べないのか？うぅ…わかった…先にやることを済ませよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350717,
					"content": "久しいな。旅は順調か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350718
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350718,
					"content": "悪くない、色々学べた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350719
					]
				},
				{
					"id": 400350719,
					"content": "いいことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350720
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350720,
					"content": "それでそれで？うちの客卿に何の用なのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350721
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350721,
					"content": "先に言っておくけど、私たちも今日大事な用事があるの！試食はついでだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350722
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350722,
					"content": "よ、用事って、往生堂の仕事じゃないよな…？お祭りなのにそんな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350723,
					"content": "別に祭りの時でも生老病死は避けられないでしょ？何もそんな怖がらなくても。まあ…驚かせるのはここまでにして、本当は天気がいいから、街に出て仕事の宣伝をしようと思ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350724
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350724,
					"content": "あなたたちは雑談でもしてて、私は香菱と一緒に店主のところへお茶を飲みに行くから。鍾離さん、話が終わったら私に言ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350725
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350725,
					"content": "ああ。ゆっくりしてくるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350726
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350726,
					"content": "では旅人、何があった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350727
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350727,
					"content": "事の経緯は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350728
					]
				},
				{
					"id": 400350728,
					"content": "鍾離に刻晴の状況を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350729
					]
				},
				{
					"id": 400350729,
					"content": "玉衡は正義感が強く、知的で勤勉、そして才能あふれる者だ。だが、何事にも限度というものがある。やはり体が資本だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350730
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350730,
					"content": "何か説得できる方法はない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350731
					]
				},
				{
					"id": 400350731,
					"content": "そうそう、鍾離っていつも理に適ったことを言うだろ。きっとおまえの話なら聞き入れてくれるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350732
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350732,
					"content": "俺が岩王帝君なら彼女を幾らか説得できたと思うが、今の俺は一介の客卿に過ぎない。自分の身分を考慮する必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350733
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350733,
					"content": "それに、玉衡と俺は親しい間柄というわけではない。急に説得を試みても、不快を招くだけだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350734
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350734,
					"content": "えっ…？じゃあどうするんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350735
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350735,
					"content": "直接ではなく、切り口を変えてみるのはどうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350736
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350736,
					"content": "彼女の心を動かすことのできる物語があれば、お前の伝えたい道理も伝わるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350737
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350737,
					"content": "日常生活などの些細なことでも、共感を得ることはできる。親しい者の事柄であれば、より効果的だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350738
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350738,
					"content": "うぅ…どういう意味なんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350739
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350739,
					"content": "刻晴をよく知ってる人に聞いてみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350740
					]
				},
				{
					"id": 400350740,
					"content": "旅人はやはり鋭いな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350741
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350741,
					"content": "物語の素材を探してくるといい。お前が必要だと言うなら、俺からも意見を述べよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350742
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350742,
					"content": "考えがまとまったら、その物語をお前の口から玉衡に伝えてみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350743
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350743,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYFIRST|INFO_FEMALE_PRONOUN_GIRLFIRST]}が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350744
					]
				},
				{
					"id": 400350744,
					"content": "玉衡はお前と友好な関係にある。人選でいえば、お前が最適だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350745
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350745,
					"content": "あっ、わかったぞ！つまり、刻晴のことを知ってる人に事情を聞けばいいんだな？じゃあ、誰からにする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350746
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350746,
					"content": "ここにいたのね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350747
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350747,
					"content": "えっ？こ、刻晴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350748
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350748,
					"content": "鍾離さんもいらしてたのね。この前の「送仙儀式」は鍾離さんのおかげで助かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350749
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350749,
					"content": "些細なことを手伝ったまでだ、礼を言うほどのことではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350750
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350750,
					"content": "ど、どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350751
					]
				},
				{
					"id": 400350751,
					"content": "どうしたの？目が泳いでるみたいだけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350752
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350752,
					"content": "もしかして急に来たから、君と鍾離さんの話を邪魔しちゃったかしら？だとしたら、悪いことをしたわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350753
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350753,
					"content": "いや、邪魔なんてことはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350754
					]
				},
				{
					"id": 400350754,
					"content": "刻晴はどうして急にオイラたちを探しに来たんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350755
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350755,
					"content": "私がここに来たのは、仙人の方々を紹介してほしいからなの。もうすぐ佳節を迎えるから、璃月七星を代表して仙人へ贈り物を届けようと思って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350756
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350756,
					"content": "前に仙人たちと一緒に戦った時に、刻晴も会ってるはずだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350757
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350757,
					"content": "もう知り合いなんだから、直接絶雲の間に行けばいいと思うけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350758
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350758,
					"content": "会ったのはあの一度きりよ。私のことを覚えていないかもしれないわ。それに突然訪問したら、快く思われない可能性だってある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350759
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350759,
					"content": "だから、君たちに紹介してもらうのが、もっとも礼儀正しい方法だと思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350760,
						400350761
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350760,
					"content": "もちろん問題ない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350764
					]
				},
				{
					"id": 400350764,
					"content": "直接贈り物を届けるだなんて、七星って大変なんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350765
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350765,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350766
					]
				},
				{
					"id": 400350766,
					"content": "じゃあ、お願いね。私は戻って贈り物の用意をしてくるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350767
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350767,
					"content": "おめでたい日なのに、私の用事に付き合わせてしまって本当に悪いわね…花火に遅れないためにも、手早く済ませましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350768
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350768,
					"content": "じゃあ、一緒に花火を見よう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350769
					]
				},
				{
					"id": 400350769,
					"content": "へっ？い、一緒に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350770
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350770,
					"content": "いいわよ。用事を済ませたら、一緒に行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350771
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350771,
					"content": "鍾離さんも、今年の「花火大会」はとても良い出来ばえだから、見逃さないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350772
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350772,
					"content": "ああ、ぜひ見物させてもらおう。知らせてくれて感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350773
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350773,
					"content": "それじゃ、私は先に行くわね。旅人、準備が終わったら群玉閣に来てちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350774
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350774,
					"content": "行っちゃったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350775
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350775,
					"content": "玉衡はいつも物事を迅速に済ませる、実に頼りになるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350776
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350776,
					"content": "#鍾離も頼りになるぞ！そうだよな、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350777
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350777,
					"content": "そう言ってもらえて光栄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350778
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350778,
					"content": "先ほど言ったことは、二人とも心に銘じておいてくれ。十分な素材を見つけた後、またここで相談を受けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350761,
					"content": "甘雨には聞かなかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350762
					]
				},
				{
					"id": 400350762,
					"content": "甘雨はここ数日休暇を取っていて、しばらく会っていないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350763
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350763,
					"content": "だから、やっぱり君にお願いするわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350764
					],
					"speakerTitle": "刻晴"
				}
			]
		},
		{
			"id": 4003508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
