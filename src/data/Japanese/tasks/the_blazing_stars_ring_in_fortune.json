	"talks": [
		{
			"id": 4003502,
			"completionStepIds": [
				4003502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003502",
							"2"
						],
						"stepId": 4003502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350201,
					"content": "この通知を総務司へ送り、それに記載された仕事を各部門に手配するよう言ってちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350202,
					"content": "それと、海灯祭ではやるべきことがたくさんあるけれど、どんな些細なことでもきちんとやり遂げるのが大切だと伝えておいて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350203
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350203,
					"content": "凝光！へへっ、遊びに来たぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350204,
					"content": "邪魔しちゃったかな？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350205
					]
				},
				{
					"id": 400350205,
					"content": "賓客の来訪を邪魔だなんて言うわけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350206
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350206,
					"content": "その様子だと、璃月の海灯祭に来たのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350207
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350207,
					"content": "おう！凝光は今年の海灯祭でなにをやってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350208,
					"content": "相変わらず、色々な雑務よ。そうだわ、今年は総務司が「花火大会」を企画したの。ぜひ見に来てちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350221
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350221,
					"content": "海灯祭ではこれまで、「明霄の灯」を空に放つことが祭りの中心だった。けれど、ここ最近璃月では様々なことが起こったから、人々には温もりと団欒が必要だと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350222
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350222,
					"content": "だからせめて今年は、もっと特別な、一人一人に寄り添える形で祝うことにしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350223
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350223,
					"content": "「花火」を璃月各地まで送り届け、時間を見計らって一斉に点火すれば、燃えるような光と熱が人々の気持ちを結ぶ。それが総務司の決定よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350209
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350209,
					"content": "花火？それなら、別のところでも見たことがあるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350210,
					"content": "璃月の花火は、なにか特別なところとかあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350211,
					"content": "花火というのは、元々璃月のとある発明によるものなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350212
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350212,
					"content": "璃月の先祖たちが初めて花火を作った時、それを「爆竹」と名付けたわ。強い光と大きな音を発するから、毒蛇や獣を追い払ったり、周囲への警告に使ったりすることができたのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350213
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350213,
					"content": "昔の人々はみんな外で農作業をしていたから、連絡を取り合うのに不便していた。だから「爆竹」の大きな音は、必要時の伝達手段として使われていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350214
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350214,
					"content": "璃月港が正式に開港した後は、人々の生活も良くなり、百里も離れた場所で農業をしたりする必要がなくなったわ。次第に「爆竹」に頼らなくなっていったというわけね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350215
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350215,
					"content": "けれど、「爆竹」を使って開墾に励んだ先祖たちの精神は、風習として人々に受け継がれた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350216
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350216,
					"content": "だから、「爆竹」は花火の前身なの。「爆竹」を改良したものを、海灯祭期間中に放つことで、私たちは先祖たちの逞しき精神を讃えているのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350217
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350217,
					"content": "さすが璃月だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350218
					]
				},
				{
					"id": 400350218,
					"content": "すごい…璃月のものって歴史が深いんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350219,
					"content": "あなたたちも、もう慣れているでしょ。歴史が古ければ古いほど、その土地にある一つ一つのものが持つ価値は高くなる。それが璃月よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350220
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350220,
					"content": "花火に関する事務は刻晴に任せているわ。もし興味があるのなら、私と一緒に彼女を訪ねてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4003503,
			"completionStepIds": [
				4003503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003503",
							"2"
						],
						"stepId": 4003503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"刻晴",
					"朋義"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350301,
					"content": "…花火の設置場所をもっと増やさないといけないわね。城内だけでなく、全面的に考えないと。軽策荘の人々も海灯祭を過ごすのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350302
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350302,
					"content": "し、しかし刻晴様、そうすると、予算が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350303
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350303,
					"content": "予算というのは、「何かをうまくやるためのもっとも適切な費用」のことよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350304
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350304,
					"content": "もし今の予算では適切に処理できないと思うのなら、総務司に申請をして、もう一度算定してもらうよう頼みなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350305
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350305,
					"content": "我々の目的は海灯祭の開催を成功させること。予算はそれをよりうまく計画するためのものよ。本末転倒になってはいけないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350306
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350306,
					"content": "はっ、かしこまりました。刻晴様。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350307
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350307,
					"content": "ええ。それと、安全は第一に確保しておきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350308
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350308,
					"content": "あら、凝光と旅人。君たちが来るなんて珍しいわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350309
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350309,
					"content": "旅人は海灯祭に参加しに来たの？ちょうどあと少しで準備が終わるところよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350310
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350310,
					"content": "刻晴は何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350311
					]
				},
				{
					"id": 400350311,
					"content": "花火の設置場所の見直し、それと関連施設の確認よ。日常の仕事と大差ないものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350312
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350312,
					"content": "正直、それらの仕事は部下に任せても構わないものだと思うけれど。あなた、もう何日も忙しくしているし、そろそろ休んだほうがいいんじゃないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350313
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350313,
					"content": "些細なことよ、これくらいなんともないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350314
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350314,
					"content": "朋義、悪いけど新しい計画を作って、それを書面にまとめて総務司に提出してちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350315
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350315,
					"content": "私は城内に行って花火の設置場所の状況を確認してくる、またあとで戻ってくるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350316
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350316,
					"content": "旅人、君は大切なお客様だし、今はちょうど佳節でもある。城内に残って、祭りの雰囲気を存分に楽しんでいってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350317
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350317,
					"content": "朋義、さっき言ったこと、全部覚えたかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350318
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350318,
					"content": "はい、すべて承知しました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350319
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350319,
					"content": "ならいいわ。凝光、旅人、私は先に失礼するわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350320
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350320,
					"content": "凝光様、それにそちらの…旅人さん。私もこれで失礼します。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350321
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350321,
					"content": "刻晴様から数々の計画を任されましたので、もう一度新しい計画書を作成する必要が…急がなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350355
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350355,
					"content": "あっ！危うく忘れるところでした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350356
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350356,
					"content": "旅人さん、ここに「花火の筒」があります。あなたが興味を持つかもしれないので、会った時に渡すよう刻晴様に言われていたのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350357
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350357,
					"content": "手先が器用な方なら、これを使って自分だけの花火を作れるはず。もし時間がありましたら、ぜひお試しください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350322
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350322,
					"content": "うぅ、オイラ、全然話に入れなかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350323,
					"content": "いや、「話に入る勇気がなかった」って言ったほうが正しいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350324,
					"content": "刻晴、すごい気迫だったね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350325
					]
				},
				{
					"id": 400350325,
					"content": "おまえもそう思うよな？刻晴の気迫が前よりも増してる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350326,
					"content": "それに以前よりも忙しそうだ…なんでだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350327
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350327,
					"content": "仙人が璃月港の統治を人々に任せるようになってから、民を導く責任は我々七星が受け持っているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350328
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350328,
					"content": "私たちは様々な領域の重要な仕事を引き継ぎ、それを適切に処理している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350329
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350329,
					"content": "とは言っても、すべてを自分で行うのはやっぱり大変なことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350330
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350330,
					"content": "今まで、海灯祭関連の事務は江舟が担当していたの。でも、彼女の父が高齢なため、今年は他の部門へ異動してね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350331
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350331,
					"content": "だから海灯祭の仕事が、私と刻晴のところにまで来たというわけ。私が責任者を担当し、人々が待ち望む花火大会を刻晴が担当しているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350332
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350332,
					"content": "これは非常に重要なことだから、もっとも信頼できる人に託すべきだと思ったの。刻晴は自分自身に厳しく、仕事に対する熱意も持っているから、最適な人選ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350333
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350333,
					"content": "たしかにすごく厳しい人だよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350334,
					"content": "ええ。他人にも自分にもとても厳しいから、追い込み過ぎて、何日も仕事を続けている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350335
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350335,
					"content": "私は、それを長期的な解決策だとは思わないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350336
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350336,
					"content": "過ぎたるは猶及ばざるが如し、璃月人なら誰もが知っている道理よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350337
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350337,
					"content": "もちろん私も彼女を説得したけれど、刻晴の性格はあなたたちも知っているでしょう。どんなに言葉巧みに話す人でも、刻晴を前にしたら説き伏せられてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350338
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350338,
					"content": "旅人、あなたは刻晴と悪くない仲だし、見聞も広いから、私の代わりに彼女を説得してみてくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350339,
						400350340
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350339,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				},
				{
					"id": 400350341,
					"content": "さすが旅人ね。刻晴を説得することは容易じゃない。あなたの助けがあれば私も安心できるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350342
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350342,
					"content": "私はこれから群玉閣に戻って事務処理をしなきゃいけないの。お先に失礼するわね。刻晴のこと、任せたわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350343
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350343,
					"content": "凝光が行っちゃった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350344
					]
				},
				{
					"id": 400350344,
					"content": "本当に刻晴を説得する方法があるのか？凝光ですら、うまくいかなかったんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350345,
					"content": "それに、誰かを説得するには、その人が感じてることを理解する必要がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350346
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350346,
					"content": "うーん…刻晴はずっと忙しくしてて、休む暇もないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350347
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350347,
					"content": "感じてるのは…「疲労」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350348
					]
				},
				{
					"id": 400350348,
					"content": "そんな浅い理解じゃうまくいかないだろ！もう一回考えてみようぜ。もっと重要で深いところにある思いってなんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350349
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350349,
					"content": "それか、こういうことに理解があって、信頼できる友達に聞いてみるってのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350350
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350350,
					"content": "じゃあ、鍾離先生に聞いてみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350351
					]
				},
				{
					"id": 400350351,
					"content": "えっ？鍾離に…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350352
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350352,
					"content": "彼なら璃月人のことをよく知ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350353
					]
				},
				{
					"id": 400350353,
					"content": "おう、たしかに頼りになるな！聞いてみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350354
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350354,
					"content": "今は「往生堂」の客卿をやってるから、「往生堂」に行って鍾離を探してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 400350340,
					"content": "方法を考える。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				}
			]
		},
