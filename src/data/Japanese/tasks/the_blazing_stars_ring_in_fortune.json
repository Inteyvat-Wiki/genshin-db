					"nextDialogs": [
						400350603
					],
					"speakerTitle": "渡し守"
				},
				{
					"id": 400350603,
					"content": "客卿の鍾離先生を探してるんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350604
					]
				},
				{
					"id": 400350604,
					"content": "鍾離先生なら堂主と一緒に外出中でございます。",
