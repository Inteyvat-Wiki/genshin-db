			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"詔勤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715120101,
					"content": "まったく…この区域はもう片付けたのか？ん…終わってるはずか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120102
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120102,
					"content": "はぁ、参ったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120103
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120103,
					"content": "ん…あっ！旅人！すまない。忙しすぎて、君が来たことに気付いていなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120104
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120104,
					"content": "何が忙しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120105
					]
				},
				{
					"id": 715120105,
					"content": "はぁ…今年の海灯祭では、俺たち璃月港の冒険者協会も総務司の管理のもとで、様々な手伝いをしてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120106
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120106,
					"content": "千岩軍は主に城内の重要区域の見回りを担当してる。俺たちはというと、野外にいる魔物の片付けとか…あとは、賊を追い払ったりしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120107
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120107,
					"content": "そうだ…そういえば君も協会に登録している冒険者だったよな。君の冒険譚をいくつも聞いたことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120108
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120108,
					"content": "もしよかったら、少し手伝ってくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120109,
						715120110
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120109,
					"content": "お祭りなのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				},
				{
					"id": 715120111,
					"content": "まあ…祭り期間中は総務司の手伝いをするから、総務司からも特別に報酬が用意されてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120112
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120112,
					"content": "この類の依頼を引き受けてくれた冒険者は、依頼を完了した後、より多くの報酬を得られる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120113,
						715120115
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120113,
					"content": "具体的に…どれくらい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120114
					]
				},
				{
					"id": 715120114,
					"content": "絶対に納得のいく報酬だ、信じてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120123
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120123,
					"content": "まずは仕事がどれくらいあるのか見ないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120116,
					"content": "はははっ、よし！君ならきっとやってくれると思っていたよ。まずは協会が確認した地点をマークしておいてあげよう。それから、この小型の花火の筒を持っていくといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120117
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120117,
					"content": "もし依頼を引き受けてくれるなら…区域を片付けた後、この花火の筒で花火を打ち上げてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120118
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120118,
					"content": "花火が上がったら、こっちから記録員を派遣して、その区域を「片付け済み」に印付ける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120119
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120119,
					"content": "我々は、各区域の片付け具合に基づいて、リアルタイムで計画を調整する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120120
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120120,
					"content": "結構細かい計画だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120121
					]
				},
				{
					"id": 715120121,
					"content": "はぁ…何といっても海灯祭だからな、間違いが起こってはならない。だから…息抜きをする余裕もなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120122
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120122,
					"content": "話はこれで終わりだ。そろそろ状況を確認しに行かないと。それと、嵐姉への報告も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120115,
					"content": "先にどれくらいやらないとなのか見せて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120110,
					"content": "海灯祭なのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				}
			]
		}
	]
}