						790244607
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790244602,
					"content": "#{M#君}{F#あなた}がファデュイになったきっかけは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790244603
					]
				},
				{
					"id": 790244603,
					"content": "ファデュイになったきっかけ？俺のか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790244604
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790244604,
					"content": "それはもちろん、女皇様の念願を果たすためだ…そして、一族がさらなる栄誉を手に入れられるよう、女皇様のために戦えと幼い頃から教えられてきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790244605,
					"content": "ヤコヴについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790244606
					]
				},
				{
					"id": 790244606,
					"content": "はぁ、ヤコヴは正気に戻らないみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エフカ"
				},
