					"nextDialogs": [
						790242222
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790242222,
					"content": "実験も任務も終わったんだよ、ヤコヴ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242223
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790242223,
					"content": "「家族」だったとはな…俺の推測も半分当たってたってことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242224
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790242224,
					"content": "何だよ、どうして僕を見るんだ？何か変なことでも言ってたか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242225
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790242225,
					"content": "いや、何でもない。ただ、やっとあなたの本音を聞けただけ。ヤコヴ、家族って言うのは、血の繋がっている人を指すとは限らないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242226
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790242226,
					"content": "へへっ、俺にとっちゃ、一緒にご飯が食べられる人はもう家族だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242227
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790242227,
					"content": "…わ、分かってるよ、そんなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242228
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790242228,
					"content": "もしよかったら、俺のことを父だと思ってくれて構わないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242229
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790242229,
					"content": "いや、それはちょっと気持ち悪い…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242230
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790242230,
					"content": "ああっ、ヤコヴが元に戻ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790242231,
					"content": "めでたしめでたし！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790242232
					]
				},
				{
					"id": 790242232,
					"content": "あれ、この二人、内部資料にあった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242233
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790242233,
					"content": "えっと、ずっと聞きたかったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242234,
						790242235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790242234,
					"content": "内部資料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790242236
					]
				},
				{
					"id": 790242236,
					"content": "いや、何でもない。重要な情報なんてまったく載ってないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242237
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790242237,
					"content": "そうだ、ヤコヴ。この二人の助けがなかったら、あなたは正気に戻れないままだったかもしれないんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242238
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790242238,
					"content": "う、そうなんだ…何があったかは知らないけど、とにかく、今回はありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790242239
					],
					"speakerTitle": "ヤコヴ"
				},
				{
					"id": 790242239,
					"content": "うーん、まだ少し気になるけど…まあいっか。「情報と依頼の取引」もこれで完了だしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790242235,
					"content": "内部資料って何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790242236
					]
				}
			]
