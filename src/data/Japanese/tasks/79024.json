					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アガフィア",
					"エフカ",
					"ザハール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790240201,
					"content": "どう？何か見つかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240202
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240202,
					"content": "うーん、手がかりとは言えないけど、可能性はあるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240203,
					"content": "ファデュイ小隊のメンバー三名にホラガイの効果を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790240204
					]
				},
				{
					"id": 790240204,
					"content": "へえ、あの変な装置に影響されたホラガイにそんな効果があるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240205
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240205,
					"content": "確かこの時は、叱られるのを怖がっていたヤコヴを、エフカのところに連れて行ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240206
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240206,
					"content": "そう言えば、確かに記憶がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240207
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790240207,
					"content": "でも、それはかなり前の出来事だし、あの巨大な装置に影響されて、うっ…拠点にいた時の記憶も曖昧になってしまったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240208
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240208,
					"content": "でも、ここのホラガイは元々四つあったはずなのに、<color=#00E1FFFF>あと三つ足りない</color>よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240209
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240209,
					"content": "他の記憶は曖昧なくせに、ホラガイの数だけはしっかり覚えてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240210,
					"content": "拠点で休んだ時、スープの容器を忘れたことに気づいて、とりあえず代わりにホラガイを使ったんだ。だから、ホラガイは人数分あったはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240211
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240211,
					"content": "ああ、でも出発する前、ヤコヴはスープを全部飲み終えて、箱の上に残して行ったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240212
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790240212,
					"content": "残ったホラガイは俺たちが一人ずつ、持ち出したんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240213,
						790240214
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790240213,
					"content": "それじゃ、ホラガイは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240215
					]
				},
				{
					"id": 790240215,
					"content": "うぅ…あの時はただの普通のホラガイだと思ってて、スープを飲み終わった時に捨てちゃったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240216
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240216,
					"content": "えっと、確か…<color=#00E1FFFF>北西方向の島</color>に上陸した頃に飲み終えて、水のいっぱいある洞窟に捨てたと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240217
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240217,
					"content": "た、確か、<color=#00E1FFFF>南方向の島</color>にあった遺跡近くの山に捨てたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240218
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790240218,
					"content": "へへっ、俺は<color=#00E1FFFF>北東方向の島</color>の井戸に捨てたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240219
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790240219,
					"content": "うわぁっ、あちこちに捨ててるじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240220,
					"content": "北西方向の島って、辛炎の幻境が現れたボロボロ島のことだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240221
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240221,
					"content": "南方向はハラハラ島で…北東方向だと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240222,
					"content": "フタフタ島だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240223
					]
				},
				{
					"id": 790240223,
					"content": "この三つの島に捨てられたんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240224,
					"content": "全部回収しないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240225
					]
				},
				{
					"id": 790240225,
					"content": "ああ、三つのホラガイを見つければ、ヤコヴを正気に戻す手がかりがわかるかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240214,
					"content": "ホラガイはどこに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240215
					]
				}
			]
		},
