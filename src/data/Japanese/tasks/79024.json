			"trigger": {
				"objectNames": [
					"アガフィア",
					"ザハール",
					"エフカ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790240101,
					"content": "ヤコヴ、ヤコヴ。今の曲、好きでよく聞いてるでしょ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240102
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240102,
					"content": "どう？ヤコヴ、正気に戻った？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240103
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240103,
					"content": "ダメだ、アガシャ。何の反応もないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240104
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790240104,
					"content": "この歌を歌う度、特に「真夏が過ぎ、花は塵に。あなたは遠い旅に発ち、私はいつまでも待ち続ける」の部分になると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240105
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240105,
					"content": "いつも潤んだ目で私を見てたのに…どうして今日は反応してくれないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240106
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240106,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240107
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240107,
					"content": "ヤコヴが大好きなスープも作ってあげたんだぜ。あんまりいい匂いでよだれが出ちゃいそうだけど、こいつはまだ正気に戻ってくれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240108
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790240108,
					"content": "分かったぞ、アガシャ！ヤコヴが一番求めているのは、父親が戻ってくることなんだ。いっそ、俺が父親のふりをして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240109
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790240109,
					"content": "黙って！今はあなたと話したくない！あの時、ヤコヴをあなたと一緒に組ませるべきじゃなかった…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240110
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240110,
					"content": "アガシャ、これは俺じゃなくて、あの実験のせいだって、お前も分かってるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240111
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790240111,
					"content": "はぁ、ヤコヴ、かわいそうなヤコヴ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240112
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240112,
					"content": "どうだ？ヤコヴはまだなにも反応してこないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240113,
					"content": "あなたたちか…はぁ、見ての通り、返事してくれないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240114
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240114,
					"content": "どうすればいいんだろう。このままだと、スネージナヤに戻っても、ファデュイから除名されるだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240115,
						790240116
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240115,
					"content": "ファデュイから除名されるのはよくない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240117
					]
				},
				{
					"id": 790240117,
					"content": "でも、ヤコヴは今ひとりなんだよ…私たちはよく任務の関係で外にいるし、彼の世話をできる人なんていない…もしファデュイを除名されたら、どうやって生きていくって言うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240118
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240118,
					"content": "#そうだ、{NICKNAME}…あなたなら、きっと似たようなことをたくさん解決してきたでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240119
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240119,
					"content": "お願い、お願いだから…ヤコヴを正気に戻す方法を見つけてくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240120
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240120,
					"content": "けど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240121,
					"content": "あなたたち、情報が欲しいんでしょ？機密情報と交換してあげる。例えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240122
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240122,
					"content": "そう、例えば「ファデュイが金リンゴ群島で謎のグッピーを狩ってる」とか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240123
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790240123,
					"content": "ザハール…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240124
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240124,
					"content": "ごめん…これしか覚えてなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240125
					],
					"speakerTitle": "ザハール"
				},
				{
					"id": 790240125,
					"content": "俺たちはただの使いっ走りだ。機密情報なんか持っているわけがない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240126
					],
					"speakerTitle": "エフカ"
				},
				{
					"id": 790240126,
					"content": "エフカ、もういいから、黙ってて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240127
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240127,
					"content": "#えっと…{NICKNAME}、「ファデュイが金リンゴ群島で謎のグッピーを狩ってる」って情報をどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240128,
						790240129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240128,
					"content": "一応、情報と言えるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240130
					]
				},
				{
					"id": 790240130,
					"content": "よし、この情報の価値に免じて、助けてあげようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240131,
					"content": "本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240132
					],
					"speakerTitle": "アガフィア"
				},
				{
					"id": 790240132,
					"content": "けど…一体どうすればヤコヴを呼び起こせるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790240133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240133,
					"content": "#前はずっとこの拠点にいたみたいだな…{NICKNAME}、とりあえず拠点で手がかりを探そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790240129,
					"content": "ギリギリセーフ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240130
					]
				},
				{
					"id": 790240116,
					"content": "いいことに聞こえるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790240117
					]
				}
			]
		},
		{
			"id": 7902402,
			"completionStepIds": [
				7902403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
