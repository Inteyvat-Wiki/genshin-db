			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370901,
					"content": "あんたたちが帰ってくる頃には、志璇も地図を描き終えてるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370902
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370902,
					"content": "だけどその前に、あたしは上にいる輸送隊が道具を下ろしてくれるのを待たなきゃならない。その間、自由に探索するといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		},
		{
			"id": 7103718,
			"completionStepIds": [
				7103713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103713",
							"2"
						],
						"stepId": 7103713,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7014112",
							"2"
						],
						"stepId": 7014112,
						"stateName": "QUEST_STATE_UNFINISHED"
