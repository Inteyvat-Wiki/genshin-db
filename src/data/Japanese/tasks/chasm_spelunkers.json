	"talks": [
		{
			"id": 7103701,
			"completionStepIds": [
				7103702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103702",
							"2"
						],
						"stepId": 7103702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志璇",
					"瑾武",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "ふぅ、久しぶりに来ました…いつもの鉱区の匂いですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370102,
					"content": "気を緩めるんじゃないよ、璇ちゃん。あたしからしたら、いつもと違う匂いのほうが強い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370103,
					"content": "だって、直接飛び降りるわけにもいかないですから…起重機に乗ってガタガタ揺られちゃ、気が緩んでしまうのも無理ないですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370104,
					"content": "あんたはまったく…地上に長く居すぎたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370105,
					"content": "別になにも匂わないけど…鉱区で働いてる人たちって、そんなに鼻がいいのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710370106,
					"content": "あははっ、この環境で鼻が効かなかったら、命取りですからね。まあでも、今はまだ大丈夫です。ほら、ヤマガラも元気そうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370107,
					"content": "あそこを見ろ。流明晶石がここにまで現れてきてる…以前はまだここにはなかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370108,
					"content": "本当ですね、一緒に見に行きましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370109,
					"content": "うぅ…なんかオイラのセリフが取られたような気がするぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武",
					"志璇",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "まさか流明晶石が、こんな地表の近くにまで出てくるなんてね…あたしはてっきり、構造的にもろい場所には増殖しないんだと思ってた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370202,
					"content": "これは地下にある「もの」の破片ですよ。きっと岩の脈に沿って移動してきたものが、最終的にここにたどり着いたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370203,
					"content": "くだらないことを言うんじゃないよ。これはこの地の岩石だ。何らかの変形作用の影響でこんな形に結晶しただけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370204,
					"content": "「七星」から分析を頼まれたことがある…その成分のほとんどは層岩巨淵の鉱物そのものだが…外的要素を受けて、こういう奇特な結晶に変化したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370205,
					"content": "#見ろ！あの晶石、{NICKNAME}の持ってる「触媒」とほとんどおんなじだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710370231,
					"content": "#{NICKNAME}、はやく流明石の「触媒」を出してみろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710370232,
					"content": "そう、流明石の「触媒」とこの晶石は、同じ類のものだ。構造が一致しているから、お互いに共鳴し合うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370206,
					"content": "不気味だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "おい、それだけかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710370209,
					"content": "ケンカするんじゃないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370210,
					"content": "ケンカはしてない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "おう、ケンカじゃないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710370212,
					"content": "ケンカだろうがケンカじゃなかろうが、そんなことは問題じゃない。これから志璇とあたしは前方に臨時の拠点を設置するから、勝手に走り回らないでおくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370213,
					"content": "さっき見つけた結晶は、これからの探検に役立つはずだ。何か新しい発見があれば、あたしに知らせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370214,
					"content": "あたしの腕が鈍ってなけりゃ、あんたの代わりにこの粗っぽい原晶を加工してあげるよ…これからの冒険に役立つだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370215,
					"content": "それと、ケンカは…もうよしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370216,
					"content": "おう、わかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710370217,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "良い子だね。あとで飴をあげよう。それと、もし近くでおかしなものを見つけたら、すぐに知らせるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370219,
					"content": "そういえば、この前瑾武姉さんが言っていた何爺のことですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370220,
					"content": "#大丈夫、忘れてないさ。せっかく{NICKNAME}もいるんだし、ちょっとあたしの手伝いをしておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370221,
					"content": "何爺は鉱区の先輩でね。以前層岩巨淵で鉱夫たちを避難させるときに失踪したうちの一人なのさ…耳がよく聞こえないせいで、警報に気付かなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370222,
					"content": "輝山庁と盛露庁から弔慰金が出て、彼の家でも葬儀が行われた…でもね、あたしはいまだに信じられないんだよ。まだ彼が、この鉱区の下のどこかにいるんじゃないかって思うのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370223,
					"content": "何爺は経験豊富な鉱夫だ…鉱区での災害から避難する方法、脱出する方法、救助を待つ方法…それをすべて知っている。あたしも彼からたくさん教えてもらったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370224,
					"content": "だから、彼はきっとどこかで生きている。あたしはそう信じてる…捜索を諦めちゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370225,
					"content": "あとでいくつか行先を伝えるよ。全部、避難前に何爺が作業してた場所さ…何か手がかりが見つかるかもしれないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370226,
					"content": "私は鉱坑の奥深くを調べて来ますね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370233,
					"content": "それと、飴も持って行きな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370227,
					"content": "一緒に来ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "彼女はあたしたちのために地図を作ってるのさ。層岩巨淵の地下は構造が複雑で、地図なしには探索できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370229,
					"content": "気を付けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "私も初心者じゃないですから、大丈夫です。安心してください、先輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370207,
					"content": "不思議だね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
		{
			"id": 7103703,
			"completionStepIds": [
				7103709
			],
