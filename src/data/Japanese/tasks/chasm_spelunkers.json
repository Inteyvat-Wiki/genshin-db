					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370301,
					"content": "ああ、おかえり。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370302,
					"content": "何爺が情報を残してた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "ん？本当に何か残してたんだね！どれ、早くあたしに見せておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370306,
					"content": "手に入れた情報を瑾武に伝えた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "ふむ…黒い「熔岩」…流明石…キノコ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370305,
					"content": "ふんっ…何度見ても気味が悪いところだね…さ、あたしたちも長居してないで、拠点に行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103711",
							"2"
