			"dialogs": [
				{
					"id": 710370601,
					"content": "手伝って下さり、ありがとうございました。これを受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370602
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370602,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370603
					]
				},
				{
					"id": 710370603,
					"content": "あははっ、そんなに気を遣わないでください、どうせヘディーヴのお金なんですから…おっと静かに、シーッ。あのケチケチスメール人に聞かれたら大変です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370604
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370604,
					"content": "コホンッ…瑾武姉さんを探しに行きませんか？これまでに気になったこと、姉さんなら経験を生かして答えてくれるかもしれませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370607
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370607,
					"content": "さあ、話はここまでにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				}
			]
		},
