			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志璇",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#あっ、{NICKNAME}先輩、来たんですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370502,
					"content": "瑾武から伝言があって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370510,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370503,
					"content": "また「安全」のことですか？はぁ…もう聞き飽きましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370504,
					"content": "私は鉱坑で育ったんですから、どこが危険かなんて全部分かってますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370505,
					"content": "未知のものに対して、大人たちは経験とかで判断しがちなんです…しかも、その結果で自分の経験を正当化する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370506,
					"content": "その傲慢さにはうんざりです…冒険者として先輩であるあなたなら、分かってくれますよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370508,
					"content": "だから——もう私を説得しようとするのはよしてください。こんなことで先輩と言い合いになるのは嫌ですから…えっと、話題を変えません？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370509,
					"content": "そうそう先輩、今地図を描くために、ここの地形を探ってるんですけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370511,
					"content": "えっと…さっきも言いましたけど、地図を描くために地形を探ってるんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370512,
					"content": "でも…以前鉱坑を探索してた時、奇妙な異変のせいで道が塞がれちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370513,
					"content": "もしサンプルや写真が手に入れば、総務司も冒険者協会も喜ぶはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370514,
					"content": "お恥ずかしい話ですが…私の写真機は鉱区に入る時に壊れてしまって…先輩の素晴らしい撮影技術に頼るしかないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370515,
					"content": "それと他の場所…えっと、こことここに、宝盗団のいた形跡がありました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370516,
					"content": "いやいや…どこだよ！全然わからないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710370517,
					"content": "いくつかバツ印と線があるだけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "あははっ、すみません…いつもの癖で。みんなが製図士の直感を持っているわけじゃないって忘れていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370519,
					"content": "でも、大丈夫です。私も先輩と一緒に行って、道案内をしますので！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370520,
					"content": "これらの場所は、どこから始めてもいいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710370521,
					"content": "じゃあ、出発しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "安全に気を付けて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "はい！お気遣いありがとうございます、先輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				}
			]
		},
