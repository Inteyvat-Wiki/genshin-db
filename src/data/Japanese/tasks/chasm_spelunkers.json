			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "ここか…おかしいね、志璇はどこに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370402,
					"content": "志璇、志璇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370403,
					"content": "はぁ…まったくあの子は、また地図を描きに鉱坑の奥まで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370404,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "さっきあんたたちが行ってから、あの子はこの地図を描いてったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370408,
					"content": "多分また奥まで探検に行ってるんだろう。その先は危険だから、勝手に一人で走って行くんじゃないって伝えておいてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370409,
					"content": "…もしまた皆を困らせるようなことがあったら、この瑾武姉さんの拳が容赦しないってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370410,
					"content": "うわぁ…恐ろしいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710370411,
					"content": "恐ろしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "さて、二人とも、くっちゃべってる暇はないよ。拠点の配置か、道の偵察か、どっちかを手伝っとくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370413,
					"content": "悪いね、あたしは遠回しな言い方が苦手なんだ…とにかく、皆のためを思ってのことさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370414,
					"content": "それと、もし途中で流明石の原晶を見つけたら、いくつか持ってきてくれるかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370415,
					"content": "それをどうにかしてより効果的な「触媒」に加工する。あたしの経験からして…そういうものは鉱区では凄く役に立つんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710370405,
					"content": "志璇に危険が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "今はまだないさ…ふんっ、今度また勝手に行ったら、ケツをひっぱたいてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "瑾武"
				}
			]
		},
		{
