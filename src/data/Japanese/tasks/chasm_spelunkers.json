			"dialogs": [
				{
					"id": 710371101,
					"content": "手伝って下さり、ありがとうございました。これを受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371102
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710371102,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710371103
					]
				},
				{
					"id": 710371103,
					"content": "あははっ、そんなに気を遣わないでください、どうせヘディーヴのお金なんですから…おっと静かに、シーッ。あのケチケチスメール人に聞かれたら大変です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371104
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710371104,
					"content": "コホンッ…瑾武姉さんを探しに行きませんか？これまでに気になったこと、姉さんなら経験を生かして答えてくれるかもしれませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371105
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710371105,
					"content": "先輩が雪山にいたときと一緒で…瑾武姉さんも、自分では言いませんが、若い頃は鉱区の伝説の人物だったんですよ…コホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371106
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710371106,
					"content": "千岩軍の救助隊のために道案内をして、窮地の中でたくさんの鉱夫を助けたそうです…あははっ、これを言うと、姉さんに怒られるんですけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371107
					],
					"speakerTitle": "志璇"
				},
				{
					"id": 710371107,
					"content": "さあ、話はここまでにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志璇"
				}
			]
		}
	]
