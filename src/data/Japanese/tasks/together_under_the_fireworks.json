			"dialogs": [
				{
					"id": 120120901,
					"content": "すまんな、力になれなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120902
					],
					"speakerTitle": "今谷三郎"
				},
				{
					"id": 120120902,
					"content": "あの子も、そろそろ自分の本心と向き合うことを学ばないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120903
					],
					"speakerTitle": "今谷香里"
				},
				{
					"id": 120120903,
					"content": "こればかりは、親も教えてやれないことだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "今谷香里"
