					"content": "立ち入り禁止だと言ったはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130204
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130204,
					"content": "ほんま邪魔やわぁ…しゃあない、少し痛い目に遭ってもらうで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
