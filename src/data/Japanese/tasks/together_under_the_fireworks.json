			"dialogs": [
				{
					"id": 120130301,
					"content": "公務を妨害するとは、いい度胸だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130302
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130302,
					"content": "このような所業、天領奉行は許さんぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130303
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130303,
					"content": "どこに逃げようと、必ず誅罰を下してくれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130304
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130304,
					"content": "おっかないこと言うたわりに、逃げ足が速いなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130305
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130305,
					"content": "無駄な時間を使ってしもた。この先におるはずや、行くで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
