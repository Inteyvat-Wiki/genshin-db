			"dialogs": [
				{
					"id": 120130501,
					"content": "はぁ…はぁっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130502
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130502,
					"content": "その剣筋、全然上達してないな、朔次郎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130503
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130503,
					"content": "お前に勝算はないと、十分に分かっただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130504
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130504,
					"content": "最後に、君の手に掛かるとはね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130505
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130505,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130506
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130506,
					"content": "負けを認めるよ。これも僕の運命、言い残すことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130507
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130507,
					"content": "お前がこの国に帰って来たのは、俺の考えを認めたからなんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130508
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130508,
					"content": "好きに思うがいいさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130509
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130509,
					"content": "ふん…さあ、天領奉行まで来てもらうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130510
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130510,
					"content": "この船を作った者も、処罰を免れないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130511
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130511,
					"content": "待ちぃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130512
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130512,
					"content": "そう簡単に突き離したらあかん、お互いに言いたいこともあるんちゃうか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130513
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130513,
					"content": "見覚えのある顔だな、確か長野原家で花火を作ってる…お節介な小娘だったか。ここはお前の出る幕じゃない、下がってろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130514
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130514,
					"content": "大丈夫だ、宵宮。過去のことを語っても、どうしようもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130515
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130515,
					"content": "なら、なんで苦労してまで稲妻に帰ってきたん！？さんざん迷っとったのは、何やったの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130516
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130516,
					"content": "こうやって、ちゃんと話したいからやろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130517
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130517,
					"content": "こいつと話すことなどない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130518
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130518,
					"content": "お尋ね者と天領奉行の役人に、話す余地などないのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130519
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130519,
					"content": "かつての友情に免じて、決闘の申し出を受け入れたまで。昔と変わらない、腑抜けた剣術だったがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130520
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130520,
					"content": "なんでそないなこと言うん？もう嘘はやめえや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130521
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130521,
					"content": "あんたの部下を見張り役に残して、一人もここに近づけさせへんかったのは、話す機会を望んでたからちゃうの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130522
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130522,
					"content": "なんで二人とも話したいって顔しとるのに、何も言わへんのや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130523
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130523,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130524
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130524,
					"content": "お前の考えすぎだ、大体何も知らないくせして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130525
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130525,
					"content": "いいよ、宵宮。この気持ちは僕だけだったみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130526
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130526,
					"content": "あかん！まだ何もできてへんやろ、こんなん納得できるわけあらへん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130527
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130527,
					"content": "今谷さん、決闘に慣れとるんやろ。ほな、うちとも決闘してや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130528
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130528,
					"content": "うちが勝ったら、本音を吐いてもらうで。もう本心を隠すんはやめるんや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130529
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130529,
					"content": "朔次郎、あんたもや！うちが勝ったら、帰ってきた理由を言うんや。どんな結末になろうとも関係あらへん、絶対に言うてもらうで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130530
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130530,
					"content": "こないな状況やないと、もう二度と言われへんかもしれへんで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130531
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130531,
					"content": "もし、お前が負けたら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130532
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130532,
					"content": "負けたら、朔次郎と共犯やって白状したる、天領奉行の言いなりになったるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130533
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130533,
					"content": "宵宮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130534
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130534,
					"content": "その申し出、受けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "今谷佳祐"
				}
			]
		},
		{
			"id": 1201307,
			"completionStepIds": [
				1201307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201307",
							"2"
						],
						"stepId": 1201307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"今谷佳祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130701,
					"content": "こいつら、只者じゃない。長官、もっと増援を呼んできます…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130702
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130702,
					"content": "下がれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130703
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130703,
					"content": "はい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130704
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130704,
					"content": "ここには近寄るなと言ったはずだ！全員下がれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130705
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130705,
					"content": "は、はっ…申し訳ありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130706
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130706,
					"content": "お前という娘は、昔の朔次郎みたいに頑固だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130707
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130707,
					"content": "どうして、俺たちにまだ話す余地があると思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130708
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130708,
					"content": "それは、朔次郎が帰ってきた時、あんたのことは言わへんかったけど、花火の注文をしたからや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130709
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130709,
					"content": "あんたの父ちゃんと母ちゃんから、朔次郎とのこと聞いたで。そん時に分かったんや、この花火にはきっと特別な意味があるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130710
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130710,
					"content": "——やったら、「話すことなどない」ちゃうやろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130711
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130711,
					"content": "孤独を感じるために、花火を咲かすわけあらへん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130712
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130712,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130713
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130713,
					"content": "実は、ずっと迷いを抱えながら帰ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130714
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130714,
					"content": "昔の考え方が変わったわけじゃない。ただ、今の自分は現実から逃げてばかりだと思ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130715
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130715,
					"content": "僕はモンドの自由を、璃月の契約を、スメールの知恵を、フォンテーヌの正義を見てきた…どれも僕にとって感慨深いものだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130716
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130716,
					"content": "稲妻を離れたことを幸せに思った。けどその幸せに浸かる中、稲妻の鎖国令を知ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130717
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130717,
					"content": "僕は逃亡者だ、でもその逃亡を英断だと思っている。そして、僕が真になすべきことは、外の素晴らしさを稲妻に持ち帰ることだと気づいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130718
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130718,
					"content": "未だにここを変えたいと思っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130719
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130719,
					"content": "いや、もうそんな大層なことは思っていない。今はただ、あの時逃げた自分を恥じているんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130720
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130720,
					"content": "君は逃げていないのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130721
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130721,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130722
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130722,
					"content": "僕の心にはしこりがある、君がどうなのかが気になった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130723
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130723,
					"content": "そして、運命に導かれるかのように、帰りたいという気持ちが抑えられなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130724
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130724,
					"content": "…俺は幸せでは…ないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130725
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130725,
					"content": "雷電将軍に憧れ、あのお方の言葉を胸に刻み、命令に従ってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130726
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130726,
					"content": "だが、今やっていることは鎖国令に反する者を裁いたり、神の目を回収したりすること。こんなことのために、天領奉行衆に入った訳ではないというのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130727
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130727,
					"content": "俺は、正しいことをやっているのだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130728
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130728,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130729
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130729,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130730
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130730,
					"content": "船は、見逃そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130731
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130731,
					"content": "えっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130732
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130732,
					"content": "お前をこのまま稲妻に残すことはできない。だからと言って、捕らえるのはもっとごめんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130733
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130733,
					"content": "でも、そんなことして上にどう報告するんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130734
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130734,
					"content": "俺を気にする必要はない、どうにかして見せる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130735
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130735,
					"content": "今の時代、国外にいる稲妻人が帰って来るには、複雑な手続きが必要だと聞いた。だが、方法がないわけではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130736
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130736,
					"content": "お前に手を貸そう。それまでは、外で待っていろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130737
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130737,
					"content": "…道中、死ぬなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130738
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130738,
					"content": "安心してくれ、佳祐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130739
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130739,
					"content": "また君と花火がみたいからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130740
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120130740,
					"content": "ああ、また会おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130741
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130741,
					"content": "左遷は避けられないだろうな、ふっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130742
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130742,
					"content": "俺もいい年して、何をしているんだか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130743
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130743,
					"content": "あの船って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130744
					]
				},
				{
					"id": 120130744,
					"content": "朔次郎が逃走に使おうとした船だ。「禁制品臨時保管」ということにして、部下たちにここへ運ばせておいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130745
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130745,
					"content": "朔次郎をここまで追い詰めたのも、俺の計画通りさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130746
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130746,
					"content": "宵宮の言う通り、当時の俺は決心できていなかった。だが、行動から俺の本音は漏れていたようだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130747
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130747,
					"content": "でも、それでええと思うで。その本音を全部口にすることで、心のわだかまりがやっと解けるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130748
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130748,
					"content": "ああ、今ようやく分かったよ、礼を言う。お前は思ったより頭が回るようだ、俺の頭の中を覗かれた気分だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130749
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130749,
					"content": "へへっ、うちはあんたの両親と仲良しなんや。父ちゃんも母ちゃんも優しい人やろ、せやからあんたも優しい人やと思った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130750
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130750,
					"content": "長野原家の後継ぎの噂は、前々から耳にしている。お喋りなわりには…侮れない人物だとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130751
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130751,
					"content": "そうだ。俺が子供の頃に見た花火、「長野原花火屋」なら再現できるだろう？一つ作ってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130752
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130752,
					"content": "短冊がないと無理や。その短冊は朔次郎が持っていってもうた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130753
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130753,
					"content": "そうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130754
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130754,
					"content": "ならいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130755
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130755,
					"content": "ひひっ、そうヘコまんといて。さっき言うたやろう、朔次郎が帰って来てすぐ花火を注文したって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130756
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130756,
					"content": "あんたのためには作れへんけど、朔次郎の花火ならあるで。このまま納屋に置いとくのも勿体無いし、今回は特別や、あんたにやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130757
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130757,
					"content": "…ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130758
					],
					"speakerTitle": "今谷佳祐"
				},
				{
					"id": 120130758,
					"content": "気にせんといて、花火大会に遅れへんようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130759
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130759,
					"content": "さっきの宵宮、凄く強引だったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130760
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120130760,
					"content": "うちはお喋りが好きやさかい、言葉には不思議な力が宿っとるって信じとるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130761
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130761,
					"content": "会話せんと何も解決はできひん、ずっと問題は残ったままや。それで、みんな…解決する機会を逃してまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130762
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130762,
					"content": "朔次郎と佳祐は昔のようには戻れへんけど、せめて…心残りは晴らすべきやと思うたんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130763
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130763,
					"content": "さあ、行こか。花火を見るんにぴったりの場所があるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130764
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130764,
					"content": "あんたらの花火は、父ちゃんがうちの代わりに打ち上げてくれるで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
			"id": 1201308,
			"completionStepIds": [
				1201309
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201309",
							"2"
						],
						"stepId": 1201309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120130801,
					"content": "ふぁ～、満足満足、今回の花火も泣けるほど綺麗やったわぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130802
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130802,
					"content": "あれ、ほんまに泣いとるかも？目元が濡れとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130803,
						120130804
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130803,
					"content": "綺麗だったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130805
					]
				},
				{
					"id": 120130805,
					"content": "せや、最初に打ち上げられたやつ、あの金色のおっきい花火は見たか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130806
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130806,
					"content": "あれが父ちゃんに頼んで、あんたらに作った花火や。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130807
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130807,
					"content": "おおっ、ひと際迫力があったから覚えてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130808
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120130808,
					"content": "ひひっ、それなら良かった。あんたらの記憶に残るよう頼んだからなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130809
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130809,
					"content": "どこへ行っても何があっても、不安を感じたり疲れたりしても、今日の花火を思い出せることを願っとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130810
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130810,
					"content": "きっと時が深まるほど、この花火はあんたらの心で綺麗になっていくことやろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130811
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130811,
					"content": "せや、あんたらもすっかりうちのお客さんやな。ほな、この短冊を受け取りぃ、また金色の花火が見たくなったら、いつでも来てや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130812,
						120130813
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130812,
					"content": "花火を打ち上げてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130814
					]
				},
				{
					"id": 120130814,
					"content": "でも、花火を見てる時の宵宮はまるで別人みたいだったな。ずーっと黙ってて、なにも聞こえてないみたいだったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130815
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120130815,
					"content": "えっと、実は聞こえてたんや。ただ花火を見てる時は何も喋らへんのが、うちのクセでな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130816
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130816,
					"content": "自分の作ったもんが空に上がるのを静かに見送る、一種の儀式みたいなもんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130817
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130817,
					"content": "さっき、うちにとって花火は何かって聞いたやろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130818
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130818,
					"content": "ああ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120130819,
					"content": "船を用意してくれた耕一にとって、花火は友情を記念するもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130820
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120130820,
					"content": "佳祐の両親にとって、花火は結婚を記念するもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120130821,
					"content": "そして佳祐と朔次郎にとって、花火は…うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130822
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120130822,
					"content": "揺るぎない信念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130823
					]
				},
				{
					"id": 120130823,
					"content": "そうだそうだ、信念！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130824
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120130824,
					"content": "うちにとっては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130825
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130825,
					"content": "せやなぁ…正直言うて考えたことあらへん、よう分からんわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130826
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130826,
					"content": "えっ？てっきり凄い答えが返ってくるかと思ったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130827
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120130827,
					"content": "今まで聞かれたことあらへんかったし、大して気にすることでもないと思うてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130828
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130828,
					"content": "たまたま長野原家に生まれて、たまたま父ちゃんから技術を学んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130829
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130829,
					"content": "ほんで、たまたまみんなと知り合うて、物語を聞いて、大切な想いを花火に込めとることを知った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130830
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130830,
					"content": "ほんの一瞬で消える花火は、将軍様が求める「永遠」からいっちゃんかけ離れとるもんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130831
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130831,
					"content": "せやけど、みんなの想いは消えへん。それが花火の存在する理由や。誰にも求められへんかったら、花火は消えてまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130832
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130832,
					"content": "これもある種の「永遠」なのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130833
					]
				},
				{
					"id": 120130833,
					"content": "みんなが花火に想いを寄せとる限り、長野原はあり続けなあかん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130834
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130834,
					"content": "やないと、みんなをガッカリさせてまうやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130835
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130835,
					"content": "うち、複雑なことを考えんのはあんま得意やないけど——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130836
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130836,
					"content": "長野原家に生まれて、ぎょうさん綺麗な花火を作れて、ほんまに誇らしいんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130813,
					"content": "お祝いしてくれてありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130814
					]
				},
				{
					"id": 120130804,
					"content": "これが噂の長野原。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120130805
					]
				}
			]
		},
