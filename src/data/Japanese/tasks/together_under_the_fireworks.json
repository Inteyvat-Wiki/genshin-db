				"points": []
			},
			"dialogs": [
				{
					"id": 120130101,
					"content": "宵宮姉さん！「袋貉」を追い払う武器、完成した？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130102
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120130102,
					"content": "それなら、龍之介おじちゃんに任しとる、あとで見に行ってみてや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130103
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130103,
					"content": "えー？お姉ちゃん遊んでくれないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130104
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120130104,
					"content": "堪忍なぁ、お姉ちゃん他に用事があるんや、またあとで戻ってくるさかい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130105
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130105,
					"content": "せや、戻ってきたら飴ちゃんあげたる！好きやろ、甘～い飴ちゃん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130106,
					"content": "よっしゃ！飴ちゃん大好き！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130107
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120130107,
					"content": "それでな、聞きたいことがあるんやけど、さっき怖い顔したおじちゃんを見ぃひんかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130108
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130108,
					"content": "見たよ、誰かを追っかけた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130109
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120130109,
					"content": "あのおっさんたち、まさか妖怪を見つけたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130110
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120130110,
					"content": "いやいや、心配あらへんよ、おじちゃんたちの勘違いやから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130111
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130111,
					"content": "あんたらは大人しく城内におるんやで、花火大会が始まるのを待ちながら遊んどき。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130112
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120130112,
					"content": "うん、大人しくしてるよ！宵宮姉さんの言うことボクたちちゃんと聞くから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "松坂"
				}
			]
		},
