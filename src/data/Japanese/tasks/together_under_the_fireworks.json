					"nextDialogs": [
						120130202
					],
					"speakerTitle": "義高"
				},
				{
					"id": 120130202,
					"content": "朔次郎と佳祐、この先におるんやろ？大事なことを伝えに来たんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120130203
					],
					"speakerTitle": "宵宮"
				},
				{
