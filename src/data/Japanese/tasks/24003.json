			"trigger": {
				"objectNames": [
					"ヴェルー",
					"オーレル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "今度の隠れ場所は、絶対に見つからないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030102,
					"content": "もしあそこに隠れるんなら、見つけるのは俺じゃなくてパパとママだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030103,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "おにいちゃんとかくれんぼ！でも…僕が隠れる場所なんて全部お見通しなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030105,
					"content": "ヴェルー…今まで何回かくれんぼしたと思ってるんだよ。俺が知らない隠れ場所なんてもうないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030106,
					"content": "それに、どうして隠れられない場所なのかは、もう何度も説明したろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030107,
					"content": "あそこは別に危なくなんかないよ？パパとママは大げさなんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030108,
					"content": "でも、ああいう場所に隠れたらお前の服やズボンは汚れるか、ボロボロになっちゃうんだぞ。パパとママは仕事で大変なんだから、余計な心配させるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030109,
					"content": "うぅ…わかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030110,
					"content": "だったら…一緒に遊ぶ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "#ホント！？{M#おにいちゃん}{F#おねえちゃん}、一緒に遊んでくれるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030113,
					"content": "こらヴェルー、迷惑だろ！すみません、うちの弟がわがまま言って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030114,
					"content": "大丈夫、ちょうど暇だったから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "やったぁ！おにいちゃん、この人が遊んでくれるって！絶対におにいちゃんより上手く隠れるもん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030117,
					"content": "#わかったよ…じゃあよろしくな、{M#お兄さん}{F#お姉さん}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030118,
					"content": "ヴェルー、前に俺が言った場所には隠れちゃだめだぞ。今日パパとママは帰りが遅いから、服が破れても直してやる人がいないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030119,
					"content": "わかったってば！うるさいなぁもう…じゃあ僕は先に隠れるから、おにいちゃんも早くね～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030120,
					"content": "ああ、行け行け！俺はもう場所を決めたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030121,
					"content": "#ホントに？おにいちゃんってばまた大きなこと言っちゃって…きっと真っ先に{M#おにいちゃん}{F#おねえちゃん}に見つかっちゃうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030122,
					"content": "オーレルとヴェルーはそれぞれ隠れた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "大丈夫、迷惑なんかじゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "#きっと{M#君}{F#あなた}を見つけられないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
