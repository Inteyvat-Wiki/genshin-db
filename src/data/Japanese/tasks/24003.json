			},
			"dialogs": [
				{
					"id": 240030901,
					"content": "#ねえ！僕の隠れ場所を{M#おにいちゃん}{F#おねえちゃん}に教えてないよね？{M#おにいちゃん}{F#おねえちゃん}にすぐ見つかっちゃったよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030902,
					"content": "言ったろ？お前の隠れる場所はわかりやすいんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030903,
					"content": "経験が豊富だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "#そうだったの？じゃあ{M#おにいちゃん}{F#おねえちゃん}、また来てくれる？一緒に遊ぼうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "ヴェルー"
				},
				{
					"id": 240030906,
					"content": "パパとママはいつも家にいないし、おにいちゃんは勉強ばっかりで…なかなか一緒に遊んでくれないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "ヴェルー"
				},
				{
