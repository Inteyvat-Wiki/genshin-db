			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "ヴェルーのやつ、いつになったら言うことを聞くようになるかな…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030702,
					"content": "隠れないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "俺は別に遊びたくないんです。ヴェルーがかくれんぼしたいって騒がないなら、本当は勉強でもしていたいくらいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030704,
					"content": "父と母は仕事がすごく大変だから、早く大人になって…負担を減らしてあげたくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030705,
					"content": "でもヴェルーはしょっちゅうママに会いたいって言って…俺が一緒に遊んでやれば泣き出したりしないんですけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030706,
					"content": "#すみません、ついいっぱい喋ってしまって。{M#お兄さん}{F#お姉さん}、先に集合場所に行ってますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "オーレル"
				},
				{
					"id": 240030707,
					"content": "ヴェルーが服を汚さないといいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オーレル"
				}
			]
		},
