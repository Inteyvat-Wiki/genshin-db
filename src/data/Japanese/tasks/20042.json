				{
					"id": 200420101,
					"content": "…もう、一体どこに隠れたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420102
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200420102,
					"content": "なにを探してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420103
					]
				},
				{
					"id": 200420103,
					"content": "ん？ああ、あやしいヤツを探してるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420104
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200420104,
					"content": "アルバートという男ね、昼間はずっと大聖堂の周りをうろうろしてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420105
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200420105,
					"content": "きっと悪意を持ってるし、なにか恐ろしいことを企んでるんじゃないかと心配してるのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420106
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 200420106,
					"content": "彼を追い払ってくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴィクトリア"
