						205140303
					]
				},
				{
					"id": 205140303,
					"content": "風車！？あいつどうやって登ったんだ！西風騎士を探してくる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "アンソニー"
				},
				{
