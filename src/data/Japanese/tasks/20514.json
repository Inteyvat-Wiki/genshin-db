						205140402
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 205140402,
					"content": "女の子を見かけてない…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "女の子？ああ、アナのことか？彼女なら見たぞ、風車のほうに走っていったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 205140404,
					"content": "あの子体が弱いはずなのに、急に元気になったから気になってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 205140405,
					"content": "俺に挨拶したら、どこかに行ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "サイリュス"
				},
				{
					"id": 205140406,
					"content": "あの子、いつ病気を治したのやら…君は知ってるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サイリュス"
				}
			]
