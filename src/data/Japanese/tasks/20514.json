				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "どういうことだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "ああ、お前か、ちょうどよかった…例の神医の薬を飲んでから、アナの病気が徐々に治ってきたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140104,
					"content": "昔は体が弱くて、安静が必要だったから、ずっと家にいたんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140105,
					"content": "今は元気になったから、外に遊びに行きたいとせがまれてな、俺も強く言えないから、いいよと言ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140106,
					"content": "しかし…今全然アナが見つからないよ、一体どこに遊びに行ったんだか。なあ、探してくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140107,
					"content": "わ、分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "ここで待ってるから、早く行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140109,
					"content": "あいつ、せっかく元気になったのにすぐ無茶して、何かあったらどうするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140116,
					"content": "もう城内を何度も探したんだ…残ったのは冒険者協会だけだが、もう力が出ないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140117,
					"content": "冒険者協会から探してみるといい。それと、サイリュスさんがなんか見たかもしれないから、聞いてみるといい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140118,
					"content": "無事見つかるといいんだが、でないと俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140110,
					"content": "嬉しそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "嬉しい？じょ、冗談はよせ。あいつ、せっかく元気になったのにすぐ無茶して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140112,
					"content": "戻ったら、説教してやるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140113,
					"content": "お腹すいたら戻ってくるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "妹を猫かなんかだと思ってるのか…それに病気治したばかりなのに、腹を空かせちゃだめだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 205140115,
					"content": "さあ、早く探してきてくれ、ここで待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "アンソニー"
				}
			]
		},
