			"dialogs": [
				{
					"id": 727300601,
					"content": "えっへん、楽勝だったぜ！この「空を翔ける白鉄チビ助」の勝ちだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300602
