					"speakerTitle": "パイモン"
				},
				{
					"id": 727300602,
					"content": "チビ助、最高！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300603
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300603,
					"content": "おおッ！すげぇぜ！才能あんじゃねぇか、白鉄チビ助！これで初戦は相手の負けだ！",
					"roleType": "TALK_ROLE_NPC",
