				"points": []
			},
			"dialogs": [
				{
					"id": 727300501,
					"content": "なんとも平凡な相手だ。戦わせるオニカブトムシも、ただ派手というだけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300502
					],
					"speakerTitle": "「電気鞘翅」"
				},
				{
					"id": 727300502,
					"content": "浅はかだね！外見なんてしょせんは無意味なものなのに。オニカブトムシで一番大事なのはその「能力」であり、雷の力と共鳴することだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300503
					],
					"speakerTitle": "「電気鞘翅」"
				},
				{
					"id": 727300503,
					"content": "ゆえに虫相撲の人生を歩む上で大事なのは、オニカブトムシを選び抜く目！それに尽きる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300504
					],
					"speakerTitle": "「電気鞘翅」"
				},
				{
					"id": 727300504,
					"content": "どんな理屈だよ…一番大事なのは実戦で活躍できるかだろ？虫相撲の腕を磨くことに力を入れるべきじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300505,
					"content": "そうだ！チビ助の言う通りだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300506
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300506,
					"content": "実戦で活躍できなきゃ、能力もへったくれもねぇだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300507
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300507,
					"content": "いいか、白鉄チビ助！相手のオニカブトムシの動きを観察するんだ。そして、こっちのオニカブトムシに攻撃を回避させて、相手の隙を突いて一気に攻撃を仕掛けろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300508
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300508,
					"content": "攻撃の範囲内に入ったら、「赤紅一杵」は相手に強力な一撃を与える！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300509
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300509,
					"content": "つまり、相手が攻撃してきたらオニカブトムシを退かせて、相手が隙を見せたらオニカブトムシを前進させる。相手の不意を打つってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300510,
					"content": "なんだ、簡単そうじゃんか。よし、やってみるぜ！旅人も今のを聞いたらできると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300511,
					"content": "付け焼き刃で虫相撲の技を覚えるなんて。人をバカにするにもほどがあるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300512
					],
					"speakerTitle": "「電気鞘翅」"
				},
				{
					"id": 727300512,
					"content": "ふん、無駄話はここまでにしよう。君たちのオニカブトムシを出すといい。この僕が見極めてあげるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「電気鞘翅」"
				}
			]
		},
