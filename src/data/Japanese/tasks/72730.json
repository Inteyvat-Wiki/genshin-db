			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"守",
					"晃",
					"荒瀧一斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727300201,
					"content": "親分、このままにしておくわけにはいかないって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300202
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300202,
					"content": "せっかく「真剣虫相撲大鬼王」の名を轟かせたってのに、あのガキの思い通りにさせていいのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300203
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300203,
					"content": "そうだ。あのガキ、絶対にイカサマしてるぜ。親分を罠にハメたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300204
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300204,
					"content": "ったく、どいつもこいつも、なに慌ててやがる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300205
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300205,
					"content": "この間の戦いは、俺様が油断しただけだ。あのガキ、あんまりにもパッとしなかったからよ！あれは無効だ、無効ッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300206
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300206,
					"content": "あんなガキのイカサマなんかほっといて、計画通り「荒瀧極意堂々虫相撲大試合」を開催すんぞ。んで、俺様が長年鍛えてきた「赤紅一杵」を出場させるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300207
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300207,
					"content": "そうなりゃあ、観客たちは俺様に盛大な歓声を送る。「赤紅一杵」の圧倒的な力をもってすれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300208
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300208,
					"content": "あのガキ、足をがくがく震わせながらビビるに違ぇねぇ。どんなイカサマもできねぇさ！つまり…あいつに勝つなんざ、俺様にとって楽勝ってことだ。ガーッハッハッハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300209
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300209,
					"content": "親分、さすが！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300210
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300210,
					"content": "しかし、忍の姉御はいつ帰ってくるんだ？「荒瀧極意堂々虫相撲大試合」を開催するにしても、どこから手を付けたらいいのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300211
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300211,
					"content": "「荒瀧極上盛世豪鼓大祭典」の経験から考えると、まずは天領奉行に報告して開催許可をもらって…あと会場の使用証明も必要になるんだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300212
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300212,
					"content": "いずれにせよ、どれも経費がかかる。「極意大試合」を「豪鼓大祭典」より盛り上げるには、せめて三倍のモラは用意しないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300213
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300213,
					"content": "待て待て待て待て！天領奉行の名前を聞いたら、頭が痛くなってきた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300214
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300214,
					"content": "経費は…一日働いて三日休むのをやめりゃあいい！ここはひと踏ん張りして、二日働いてから四日休もう！そうすりゃ、俺たち全員合わせて四日も多く働けて、四倍のモラが稼げる。これなら十分足りるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300215
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300215,
					"content": "さすが親分！じゃあ、あとは参加する選手のことだけ考えればいいな！選手はそう強くなくても、親分の手助けができて相手の雑魚さえ倒せれば十分だろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300216
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300216,
					"content": "そうだ！あのガキ、五人の虫相撲名人を引き連れて公正に勝負するとか言ってたよな。けど荒瀧派の中じゃ、虫相撲に精通してるのって親分しかいないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300217
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300217,
					"content": "そいつらが順番に親分一人に挑んできたら、さすがの親分もしんどいんじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300218
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300218,
					"content": "おい、お前ぇら！まだ始まってもねぇのに、なに尻込みしてんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300219
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300219,
					"content": "荒瀧派の闘志を見せてみろ！そんな小さな問題、俺様が何とかしてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300220
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300220,
					"content": "そうだな、昔の虫相撲仲間たちに相談してみるか？それとも、あの長野原花火屋に参加してもらうように話をつけるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300221
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300221,
					"content": "いや、ダメだ！そんなことしたら、俺様がガキに負けたってのがすぐ花見坂中に知れ渡る。そんな辱めは受けたくねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300222
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300222,
					"content": "よっ、牛使い野郎、なにやってんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300223,
					"content": "うおッ！びっくりしたじゃねぇか。いつからそこにいたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300224
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300224,
					"content": "なに言ってんだよ。オイラたちずっとここに立ってたんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300225,
					"content": "旅人と冒険者協会へ行こうと思ったら、遠くからおまえたちが騒いでるのが見えてな。しかも、訳のわからないことばっか言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300226,
						727300227
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300226,
					"content": "「真剣虫相撲鬼王」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300228
					]
				},
				{
					"id": 727300228,
					"content": "おい、「大」が抜けてんぞ！一文字違うだけで、凄みが大きく変わってくんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300229
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300229,
					"content": "ダチ公、お前ぇも虫相撲をもっとやれば、きっとこれの熱い魂を理解できるはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300230
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300230,
					"content": "つまり虫相撲で負けたから、どうやって汚名を返上するか考えてたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300231,
					"content": "そいつは違う。あんなのはズルだ、ズル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300232
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300232,
					"content": "そうそう。あの「花角玉将」とかいうガキは、親分が他の仲間と腕を磨き合って疲れ始めたところに、急に現れて勝負を挑んできたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300233
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300233,
					"content": "で、無駄に大きなオニカブトムシを使って、バシバシっと親分の虫をひっくり返しやがった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300234
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300234,
					"content": "それから、親分に「虫相撲の強者がいる本当の世界」を見せてやるとか言ってた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300235
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300235,
					"content": "おい、守！俺様が負けたところは詳しく説明しなくていい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300236
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300236,
					"content": "話がやっと見えてきた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300237
					]
				},
				{
					"id": 727300237,
					"content": "話を戻すぜ。ダチ公は何をやらせても才能があるらしいじゃねぇか。新しい技なんかもすぐに覚えて、しかもそれが大半のやつより強いときた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300238
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300238,
					"content": "なにを言おうとしてるのかもうわかったぞ、牛使い野郎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300239,
					"content": "代わりにその「花角玉将」ってやつを倒して、仇を取ってくれって言うんだろ？しかも、ただ働きで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300240,
					"content": "ただ働き？空飛ぶチビ助、俺様がそんなチンケな野郎に見えるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300241
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300241,
					"content": "もしダチ公が助けてくれたら、二ヶ月分の昼飯として毎日店の看板ラーメンを一杯奢ってやる。どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300242
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300242,
					"content": "ま、毎日一杯？それなら考えなくもないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300243,
						727300244
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300243,
					"content": "一斗がこんなに気前いいなんて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300245
					]
				},
				{
					"id": 727300245,
					"content": "ハハハッ、これは親分がある勝利と引き換えに手にしたもんなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300246
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300246,
					"content": "この前、「真剣虫相撲大鬼王」を自称してる仲間がいてな。親分はそれを耳にして、納得がいかずにそいつに挑んだ。親分が勝ったら、その称号を渡してもらうっていう約束をしてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300247
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300247,
					"content": "丸一日続いた九十二回の苦しい戦いを経て、ついに親分は辛勝した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300248,
						727300249
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300248,
					"content": "どう考えても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300250
					]
				},
				{
					"id": 727300250,
					"content": "だが、そいつは自分とこのラーメン屋の「看板ラーメン毎日一杯無料券」と引き換えに、二ヶ月後に称号を返すように親分にお願いしてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300251
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300251,
					"content": "そいつんとこのラーメンがどんなもんかは知らないが、二ヶ月分なら十分魅力的な提案だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300252
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300252,
					"content": "それに親分の腕の上達速度からして、その二ヶ月できっともっとカッコいい称号が手に入る。この条件はこっちからしてもおいしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300253
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300253,
					"content": "ただ、そのラーメン屋がどこにあるのか聞き忘れちまったけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300254
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300254,
					"content": "ゴホンッ！そこまでだ！過程なんざどうだっていい！とにかく、ラーメンはダチ公とチビ助にやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300255
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300255,
					"content": "ちょっと待て、オイラたちまだ考えてる途中だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300256
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300256,
					"content": "もう「玉将」には挑戦状を出した。あいつも助っ人を呼んで、俺ら荒瀧派の挑戦に応じるそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300257
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300257,
					"content": "場所についてはもう選んである。そこでダチ公、まずは天領奉行で複雑な手続きを済ませてくんねぇか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300258
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300258,
					"content": "善は急げだ。ダチ公、それにチビ助、さっそく出発すんぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300259
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300259,
					"content": "話がそこまで進んでるなら、さすがに断りにくいな…牛使い野郎もかなり張り切ってるし、ついて行ってやるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300260
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300260,
					"content": "虫相撲のことを勉強して、代わりに相手に勝てばいいんだろ？これくらい簡単そうだしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300261,
						727300262
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300261,
					"content": "看板ラーメンをお腹いっぱい食べたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300263
					]
				},
				{
					"id": 727300263,
					"content": "ん？…おまえ、牛使い野郎の「子供っぽいオーラ」にでも当てられたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300264
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300264,
					"content": "天領奉行へ行き、荒瀧派を手伝って「荒瀧極意堂々虫相撲大試合」の手続きを終わらせた。その後、一斗が言っていた場所に到着した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 727300262,
					"content": "虫相撲の楽しさを味わってみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300263
					]
				},
				{
					"id": 727300249,
					"content": "相手が耐えられなくなっただけのような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300250
					]
				},
				{
					"id": 727300244,
					"content": "仕事で大儲けした？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300245
					]
				},
				{
					"id": 727300227,
					"content": "「極意堂々虫相撲試合」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300228
					]
				}
			]
		},
		{
			"id": 7273004,
			"completionStepIds": [
				7273004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273004",
							"2"
						],
						"stepId": 7273004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"荒瀧一斗",
					"晃",
					"守",
					"「花角玉将」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727300401,
					"content": "悪くねぇ。守と晃が用意した物資も揃ってる。さっそく会場を作ろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300402
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300402,
					"content": "過去の経験をもとに、「荒瀧極意堂々虫相撲大試合」の土俵を作った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						727300403
					]
				},
				{
					"id": 727300403,
					"content": "ガーッハッハッハッ！立派な土俵じゃねぇか。悪くねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300404
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300404,
					"content": "ダチ公、まさかこんなとこでも才能を見せてくれるとはな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300405
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300405,
					"content": "これに俺様の素晴らしい宣伝画も合わされば、最高の雰囲気を演出できる、ガッハッハッハッ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300406
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300406,
					"content": "旅人の腕はさすがだな！親分の画力もすげぇぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300407
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300407,
					"content": "でも、ここって稲妻城から離れすぎじゃないか。本当に見に来るやつなんているのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300408,
					"content": "問題ない問題ない！俺様の知名度をもってすれば、きっと大勢の人が来るに決まってんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300409
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300409,
					"content": "容彩祭の時には、ここで剣術の試合が行われたって聞いたぜ。もちろん、虫相撲の決闘にももってこいの場所だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300410
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300410,
					"content": "さて、次はお前らに俺様が鍛えた天下無敵のオニカブトムシ「赤紅一杵」を見せてやる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300411
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300411,
					"content": "おおっ、本当に赤色のオニカブトムシだ、カッコいいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300412,
						727300413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300412,
					"content": "まるで炎元素の影響を受けてるみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300414
					]
				},
				{
					"id": 727300414,
					"content": "牛使い野郎、案外頑張ってたんだな。どこでこいつを見つけたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300415,
					"content": "もっと近くで見てもいいか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300416
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300416,
					"content": "ハッ！好きに見てくれていいぜ、満足するまでな！ただし、俺様が「赤紅一杵」をどうやって育てたのか、その秘密はそう簡単には教えられねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300417
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300417,
					"content": "あれ？なんか嗅いだことある香りがするな。ヴァルベリーのジャムか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300418,
					"content": "き、気のせいだろ。きっと腹を空かしてるからじゃねぇか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300419
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300419,
					"content": "そういえば親分、「威嚇塗装」の保護膜をまだ塗ってないんじゃないか？雨が降ったら、九千モラで買った輸入品のジャムが無駄になっちまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300420
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300420,
					"content": "心配いらねぇって！「荒瀧極意堂々虫相撲大試合」はまだ始まってねぇし、「赤紅一杵」に最後の保護膜を塗るまで時間は十分にある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300421
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300421,
					"content": "お前らはまずチラシを準備して、客がしっかり入るよう呼び込みをしてこい。俺様は、ダチ公とチビ助が慣れるまでここで指導してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300422
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300422,
					"content": "そんで、一緒に飯を食って祝おうじゃねぇか。はぁ、こんなに働くなんて、俺様って大変だな、ふぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300423
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300423,
					"content": "へぇ？お前ら、結構気合い入ってるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300424
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727300424,
					"content": "出た！「花角玉将」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300425
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300425,
					"content": "そんなバカな！どうしてここが分かったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300426
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300426,
					"content": "「真剣虫相撲大鬼王」、忘れたのかい？虫相撲の強者たちは引かれ合うんだ。前回もそうだっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300427
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727300427,
					"content": "まさか、俺たちとどう戦えばいいか分からず、慌てて準備してたなんてことないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300428
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727300428,
					"content": "な、なにバカなこと言ってんだ！俺様は…オニカブトムシと心を通わせてない時は、強者の気配を隠してんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300429
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300429,
					"content": "ただ単にお前の洞察力を下に見てただけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300430
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300430,
					"content": "あっ、こいつが牛使い野郎を負かしたやつだな？見た目は普通の子供だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300431
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300431,
					"content": "なんか言葉遣いが独特だな。この感じ…牛使い野郎の天敵っぽいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300432,
						727300433
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300432,
					"content": "実際は二人とも気が合いそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300434
					]
				},
				{
					"id": 727300434,
					"content": "「花角玉将」！ここまで来れたのは褒めてやる。この「真剣虫相撲大鬼王」も本気を出す甲斐がありそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300435
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300435,
					"content": "だが、すぐに後悔することになんぜ。お前ぇらの無謀な行動は、自ら頭を差し出して殴ってみろと言ってるみてぇなもんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300436
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300436,
					"content": "ほう、かなり自信があるみたいだ。どうやら、お前も最強の切り札を手にしたみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300437
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727300437,
					"content": "初っ端から負かしてもつまらないし、まずは部下が相手しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300438
					],
					"speakerTitle": "「花角玉将」"
				},
				{
					"id": 727300438,
					"content": "ふん！子分で俺たちを試すってか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300439
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300439,
					"content": "それじゃ、俺様は空飛ぶチビ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300440
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300440,
					"content": "おっと、待てよ。空飛ぶチビ助は荒瀧派を代表して戦うんだ。気合いであいつに負けちゃいけねぇな。称号もカッコよくしてやんねぇと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300441
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300441,
					"content": "よし！「空を翔ける白鉄チビ助」、お前があいつを懲らしめてやれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300442
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300442,
					"content": "えっ！なんでオイラが？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300443,
						727300444
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300443,
					"content": "速度上昇型パイモンになった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300445
					]
				},
				{
					"id": 727300445,
					"content": "親分！もうこいつらと対決するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300446
					],
					"speakerTitle": "晃"
				},
				{
					"id": 727300446,
					"content": "まだ試合の宣伝もできてないし、親分の親友とそのチビ助も虫相撲の実戦をやったことないだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300447
					],
					"speakerTitle": "守"
				},
				{
					"id": 727300447,
					"content": "ちっ、そうだった！だが売られた喧嘩だ。俺様が怯むわけにもいかねぇ！宣伝なんざ後だッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300448
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300448,
					"content": "虫相撲のコツは、俺様が横から空飛ぶチビ助…いや、「空を翔ける白鉄チビ助」に直接指導してやる！実戦も勉強のうちだ、負けても気にすんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300449
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300449,
					"content": "ひどいぞ…まだ始まってもないのにオイラが負ける前提で話すなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300450
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300450,
					"content": "白鉄チビ助！荒瀧派の気合いを見せてやれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300451
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300451,
					"content": "それにお前に先陣を任せたのは、俺様が考えに考えた戦略だ！この戦略のヒラメキは、忍が話してくれた璃月の物語を参考にしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300452
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300452,
					"content": "「我が陣営の最弱を敵方の最強と戦わせよ。我が陣営の中堅を敵方の最弱と戦わせよ。我が陣営の最強を敵方の中堅と戦わせよ。さすれば、三戦のうち二勝が確約されるだろう！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300453
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300453,
					"content": "お前には確かに才能がある、だが実戦の経験は少ない。俺たち虫相撲の強者の中では、ただのヘナチョコだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300454
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300454,
					"content": "そんなヘナチョコを先に行かせて、あっちの名人が活躍する場を一人分削れるならこっちのもんだ！ガーッハッハッハッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300455
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300455,
					"content": "でもそれだと、おまえが後であいつらの親分の「花角玉将」と勝負することになるよな。つまり、おまえがこっちの最弱ってことにならないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300456
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300456,
					"content": "ちょっと待て、そうなるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300457
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300457,
					"content": "う…うるせぇ！俺様の戦略がさっきの物語と全く同じだなんて言ってねぇだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300458
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727300458,
					"content": "わかった、わかった。行けばいいんだろ。オイラだってなめられたくないしな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727300459
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300459,
					"content": "よく見てろよ！オイラがヘナチョコなんかじゃないってところ見せてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 727300444,
					"content": "防御強化型パイモンになった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300445
					]
				},
				{
					"id": 727300433,
					"content": "邪魔しないでおこう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300434
					]
				},
				{
					"id": 727300413,
					"content": "確かに独特な威圧感がある…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727300414
					]
				}
			]
		},
