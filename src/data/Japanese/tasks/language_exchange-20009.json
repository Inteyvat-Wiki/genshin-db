			"dialogs": [
				{
					"id": 200090101,
					"content": "旅人、ここ、ここよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090102
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200090102,
					"content": "あのヒルチャールたちには気付かれないように。どうしてあなたはいつもまっすぐ集落に向かって突っ走るの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090103
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200090103,
					"content": "まあいいわ。今までずっとヒルチャールの言葉を研究してきたけど、記録よりもその話し方を勉強したいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090104
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200090104,
					"content": "せっかくここで完全なヒルチャール集落に出会ったんだ、このチャンスは逃さないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090105
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 200090105,
					"content": "だからね、練習相手になってくれるヒルチャールを探したいんだけど、一緒に集落に入ってくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エラ·マスク"
				}
			]
		},
