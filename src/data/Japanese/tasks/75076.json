			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"サカウ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "最近、海の霧がますます濃くなっている。ああ…心配だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760404,
					"content": "まさか、あの伝説は本当だったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760405,
					"content": "伝説？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "そうだな…異郷の勇士がどんな伝説を聞きたいかによるが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760407,
					"content": "海に浮かぶ島と巨大なラクガキの由来については、二つの説があってな。一つは物語で、もう一つはより真実味のある伝説だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760402,
					"content": "異郷の勇士、どれを聞きたい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760408,
					"content": "物語について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "ああ、物語だから、ロマンチックな要素があってな…浮き島に描かれたラクガキは、『クイールとウククの物語』の一部に基づいているという内容だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760403,
					"content": "クイールという少女は父である太陽と連絡を取るために海辺に巨大なラクガキを残したそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760410,
					"content": "彼女の父である太陽は、空からラクガキを見つけ、地上にいた娘を連れ戻した——大体こんな内容だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760417,
					"content": "人々を不安にさせるあの霧は、父親である太陽が、地上の部族に与えた罰と言われているんだ。部族の民が娘の力を奪ったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760415,
					"content": "はぁ、物語だろうと伝説だろうと、海面から霧が立ち昇るのは決して吉兆とは言えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760416,
					"content": "異邦の勇士よ…あそこにはとんだ危険が潜んでいるかもしれない。くれぐれも気を付けてくれ。あまり近づかないほうがいいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760411,
					"content": "伝説について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "伝説では…遥か昔、ある邪悪な魔法使いがいて、大霊に扮して部族の勇士を惑わしていたそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760413,
					"content": "部族の勇士たちは、あの漆黒の魔法使いを巨大なラクガキの下に封印しなければならなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "サカウ"
				},
				{
					"id": 750760414,
					"content": "海面があんな風になったのは、邪悪な魔法使いが封印を破って逃げ出し、悪事を働かんとする兆しだと伝えられている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "サカウ"
				}
			]
		},
