							8534.72
						],
						"pointId": 9973
					}
				]
			},
			"dialogs": [
				{
					"id": 750761201,
					"content": "ああ、ついに…——もし異邦の勇士の助けがなかったら、ここはとうに漆黒の敵に呑み込まれていただろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "弱った大霊の化身"
				},
				{
					"id": 750761202,
					"content": "…遥か昔、ここに暮らしていた部族は、漆黒の敵が顕現した姿に惑わされ、多くの夜魂がアビスにまとわりつかれてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "弱った大霊の化身"
				},
				{
					"id": 750761203,
					"content": "封印された場所は、夜の化身の力さえ少しずつ呑み込まれていった…封印により、ここは外界から隔離され、同時に部族の信念の源も絶たれてしまったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "弱った大霊の化身"
				},
				{
					"id": 750761204,
					"content": "戦う力を授かるには、封印を解くのみ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "弱った大霊の化身"
				},
				{
					"id": 750761205,
					"content": "ありがとう、異邦の勇士よ…おかげで夜魂は夢の故郷に帰り、夜神の国は汚れた瘤に侵されずに済んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "弱った大霊の化身"
				},
				{
					"id": 750761206,
					"content": "ああ、やっと静かな夜に戻れる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弱った大霊の化身"
				}
			]
		}
	]
