						],
						"pointId": 9971
					},
					{
						"sceneId": 3,
						"position": [
							-2606.36,
							-668.697,
							8537.296
						],
						"pointId": 9972
					},
					{
						"sceneId": 3,
						"position": [
							-2604.116,
