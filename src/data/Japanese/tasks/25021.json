			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "（ホーリーはリラックスするどころか、困惑した様子でこちらを見ている）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212710,
					"content": "（カズーガが作業を引き継いでくれた。丁寧な工程の末、ホーリーの爪の手入れを終えることができた…）",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "大丈夫、大丈夫。俺だってホーリーの気持ちを読み間違えることはある。でも、あんたがいい友達だってホーリーもきっと分かってるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212702,
					"content": "キュキュー、キュ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250212703,
					"content": "はは、ほらな。言った通りだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212704,
					"content": "手伝ってくれてありがとな。これを報酬として受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212705,
					"content": "竜の気持ちを理解するのはとても難しいんだ。俺もホーリーの気持ちがわかるまで随分時間がかかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212706,
					"content": "でも、それができて、もう十分満足してる。俺とこいつはまだこれから長く付き合っていかなくちゃだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212707,
					"content": "あれ？ホーリーは？ま、まさかまた逃げたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212708,
					"content": "おーい！ホーリー——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズーガ"
				}
			]
		},
