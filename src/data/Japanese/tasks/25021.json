				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カズーガ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "ホーリー、今日は逃げ回っちゃだめだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210102,
					"content": "キュ、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250210103,
					"content": "今日はいい子にしてるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "そうだな。あんたが作るのを手伝ってくれたあの「フロートボール」のおかげだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210105,
					"content": "これがあると、水浴びだけじゃなくて、食事も、寝るのも、訓練も本当に楽になるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210106,
					"content": "特に爪切りだよ！前は逃げ回るホーリーを追いかけるだけでへとへとになってたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210107,
					"content": "今はボールをこいつの前に置くとすぐに大人しく座ってくれるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210108,
					"content": "キュキュ、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250210109,
					"content": "ホーリー、この人のこと覚えてるか？ 一緒におもちゃを作ってくれた人だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210110,
					"content": "キュー、キューッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250210111,
					"content": "いい子いい子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "おっ、嬉しそうだな。あんたのこと覚えてるみたいだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210114,
					"content": "こいつの爪切ってみるか？ついでに角も磨いてやってくれるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210115,
					"content": "テペトル竜は土や岩を掘るからさ、爪の手入れはすっげえ大事なんだ。しょっちゅう爪を磨いて、歪んだり割れたりしたところを切ってやらなきゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210116,
					"content": "そうして初めて、テペトル竜が成長してもきれいな爪を保てるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210117,
					"content": "さあ、これを持って！爪の手入れついでにホーリーの全身をピカピカにするぞ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210118,
					"content": "そこまで全部言わなくても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "キュキュ、キュ——。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250210121,
					"content": "オホン…せっかくホーリーが言うことを聞いてくれるからな。ホーリーを集落中、追いかけ回さなくていいって思ったら、つい嬉しくなっちゃってさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210122,
					"content": "#…大変だ{M#ね}{F#ね}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "そんなことないさ！じゃあ、隣でやり方を教えるから、真似してやってみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210124,
					"content": "まずはリラックスさせるんだ。大きなブラシで背中を優しくブラッシングして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210130,
					"content": "それから、細毛ブラシで角をクリーニングする。力が弱いと細かい溝の汚れが落ちないから、強めにやってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210125,
					"content": "で、タオルで全身を拭いてやる…するとだんだん力が抜けて、引っ込められてた爪が出てくる。そうなったら爪の手入れを始めていいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210126,
					"content": "すごく丁寧に説明するんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "そりゃもう、俺が育てたんだからな。集落中…いや、ナタ中を探しても俺よりホーリーのことをわかってるやつなんていないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210129,
					"content": "さあ、今教えた通りに爪を切ってやってほしい。俺はすぐそこにいるから、もし分からないことがあれば、いつでも聞いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250210127,
					"content": "ホーリーのことをよく知ってる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "なんか急にテンション上がった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "（ホーリーをなでなでする）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
