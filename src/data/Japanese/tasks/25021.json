			"dialogs": [
				{
					"id": 250213701,
					"content": "（ホーリーは首を傾げ、自分のお腹を搔きながら、ぼんやりとあなたを見つめる。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213702
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250213702,
					"content": "ホーリーと遊んでばっかじゃダメだな。まだやるべきことがあるんだし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213703
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250213703,
					"content": "コホンッ！やっぱり俺がやるよ。洗い方の手本を見せてやろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213704
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250213704,
					"content": "（カズーガが作業を引き継いでくれた。丁寧な工程の末、ホーリーの爪の手入れを終えることができた…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213705
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250213705,
					"content": "ホーリーと遊んでくれるのはいいけど、やるべきことは済ませてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213706
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250213706,
					"content": "キュッ！キュ、キュキューッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213707
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250213707,
					"content": "ははははっ、ホーリーはあんたと遊ぶのが好きみたいだな。どうりで洗う時は大人しかったわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213708
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250213708,
					"content": "とにかく、手伝ってくれてありがとうな。これを報酬として受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213709
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250213709,
					"content": "ふむ、そうだな…今度はホーリーと思いっきり遊んでから洗ってやろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213710
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250213710,
					"content": "ホーリー、このアイデア、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213711
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250213711,
					"content": "あれ？ホーリーは？ま、まさかまた逃げたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213712
					],
