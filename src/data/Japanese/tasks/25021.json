			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カズーガ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "（ホーリーはだんだんリラックスして、体を伸ばし爪を出した。これで爪の手入れができそうだ）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250212610,
					"content": "カズーガの指導のもと、丁寧にホーリーの爪の手入れをした。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "あははっ！あんた、案外こういうのが得意みたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212602,
					"content": "キュキュ、キュー、キュー——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250212603,
					"content": "ホーリーもありがとうってさ。丁寧に手入れしてくれたから、土掘りもきっと捗るよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212604,
					"content": "これを報酬として受け取ってくれ。あ、そうだ…今度ほかの竜の世話をすることになったら、今日教えたやり方そのまんまはやるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212605,
					"content": "竜は一匹一匹性格も違うし、世話の仕方も違う。俺は長年かけてやっとホーリーの世話の仕方がわかってきたけど、ほかの竜のことまでは分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212606,
					"content": "でも…こいつの世話のやり方がわかっただけで十分満足だ。俺とこいつはこれから長く付き合っていくからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212607,
					"content": "あれ？ホーリーは？ま、まさかまた逃げたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250212608,
					"content": "おーい！ホーリー——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズーガ"
				}
			]
		},
