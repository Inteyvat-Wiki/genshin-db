			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "本当に…不思議にゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140102,
					"content": "彫刻はできた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "あの石、最初のころは全然うちに似ていにゃかった。だけど、毎回見るたび、うちに似てきたにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140104,
					"content": "主ら人間は本当に不思議にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140105,
					"content": "音はうるさいが、うちは代理宮司、これしきの事は気にしにゃい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140106,
					"content": "主ら、この魚をあの背の高い人間に渡すにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140107,
					"content": "これは良いもの、あいつの「ほーしゅー」にするにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140108,
					"content": "魚だけ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "うむ、あの子らにヤマガラを捕まえるよう「昆布丸」に頼んだが、なかなかうまくいかにゃかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140110,
					"content": "あの子らにとっては、魚を捕るほうが簡単にゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140111,
					"content": "「報酬」でしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "にゃにゃ、うるさいにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "「寝子」"
				},
				{
					"id": 722140113,
					"content": "早くあいつに渡すにゃ、これも良いものにゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寝子」"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221402",
							"2"
						],
						"stepId": 7221402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "ようやくここまで来たか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140202,
					"content": "ははっ、君たちか。これを見てくれ、代理宮司様に似てきたんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140203,
					"content": "確かに様になってきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "そうだろ？はははっ、何日も徹夜してやった甲斐があったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140207,
					"content": "うぅ、少し腹が減った…何か食べるものを探してくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140208,
					"content": "#寝子から{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}への魚肉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "えっと…気持ちはありがたいが…やはり自分で何か食べ物を探してくるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140210,
					"content": "もう何日も連続で魚肉を食べてる、これ以上は無理だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140211,
					"content": "今のところ毎日、自分で食べ物を探してる。運が良ければ、ヤマガラやハトなんかを見つけることができる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140212,
					"content": "はぁ、やっぱり獣肉が食べたいぜ…身が引き締まってて、ジューシーな獣肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140213,
					"content": "その…旅人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140214,
					"content": "もしよかったら、獣肉を3つ…探してきてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140215,
					"content": "俺は狩りが苦手でな…もう何日も試してるんだが獣肉を1つも手に入れてない…頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140216,
					"content": "分かった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "それじゃ頼んだよ、獣肉を3つ持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140217,
					"content": "なんで一回鳴神島に戻らないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "理由は二つある。一つは遠いから。もう一つは…いま彫刻を彫る感覚が絶好調でな、もし鳴神島に帰ったら…その感覚がなくなってしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140219,
					"content": "やっぱりここでパパっと食べて、引き続き彫刻を続けた方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140205,
					"content": "彫刻が寝子よりだいぶ大きい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "それはもちろんさ。代理宮司様は元々普通の猫より大きいが…気迫あるものにするためには、大きいものにする必要がある。それに、なんてったって神社に置く彫像だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "大島純平"
				}
			]
		},
		{
