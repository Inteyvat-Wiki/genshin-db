		{
			"id": 7221404,
			"completionStepIds": [
				7221403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221403",
							"2"
						],
						"stepId": 7221403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "おお！この獣肉の品質…本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140402,
					"content": "すぐにこれを使って料理を作ってくる！この肉を食べたら、きっと彫刻もより早く完成するぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140403,
					"content": "その二つになんの関係が…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "良質な肉を食べたら、力が出る。そしたら、仕事もうまくいくだろ！以前は小魚ばかり食べてて、かなづちを握る力もなかったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140405,
					"content": "この状態が続いてたら、彫刻を彫るのにかかる期間が延びていただろう…肉を見つけて来てくれて助かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140406,
					"content": "何せ人のために…いや、猫のためにやる仕事だからな。延期はできれば避けたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140407,
					"content": "とにかく、できる限り早めにこの彫刻を完成させる。代理宮司様も言っていた、この彫刻ができたら、何か良いことが起こるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140408,
					"content": "それがどんなことなのかは知らないが…ははっ、楽しみにしてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140409,
					"content": "彫刻ができたら、必ず神社に来て、完成品を見てみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
			]
		}
	]
}