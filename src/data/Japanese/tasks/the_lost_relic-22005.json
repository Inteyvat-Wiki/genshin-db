					"宝児"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "一体どこにあるのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050102,
					"content": "なにしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "うわっ！どこから湧いてきたのよ？気配が全然しなかったじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050104,
					"content": "私？私は…学者よ、今帰離原の古代建築と遺物を研究してるわ。そうね…宝児と呼んで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050105,
					"content": "実はね、研究に夢中になりすぎて、うっかり荷物を落としたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050106,
					"content": "中には苦労してやっと見つけた宝…文物が入ってるわ。探してくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050107,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "よかった、この辺りにあるはず…もしくはもうちょっと先にあると思う。とにかく、一緒に探してほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050108,
					"content": "どんな荷物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "えっと…普通の荷物よ、四角形の箱で…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050112,
					"content": "どうして文物をそれに入れてるかって？えっと、それは…箱のほうが便利だからよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050113,
					"content": "それに、文物が壊れないように箱の中に服を何着か入れておいたわ。早く探してきてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050109,
					"content": "どんな文物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "えっと…とにかく、すごく貴重な文物よ！説明しても分からないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "宝児"
				},
				{
					"id": 220050115,
					"content": "私みたいな専門家だけがその価値がわかるわ。お願い、探してきてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宝児"
				}
			]
		},
