					}
				]
			},
			"dialogs": [
				{
					"id": 755040101,
					"content": "おお！戻ってきたか、君たち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040102
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040102,
					"content": "その目つきを見るに、各地の風景や物産を心ゆくまで眺め、インスピレーションを得てきたようだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040103
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040103,
					"content": "まあまあかな…でもなかなか楽しかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040104,
					"content": "決まった目標があって、今までは目に入ってなかった細かいところに気づけたし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040105,
					"content": "かなり見識が広がって、素材がたくさん集まったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040106,
						755040107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040106,
					"content": "ただ、ラクガキに使えるかは分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040108
					]
				},
				{
					"id": 755040108,
					"content": "まあ、そう焦らなくてもいいさ！私も君たちに、ナタを一度回っただけですぐに前衛の何たるかを理解してもらおうとは思っていないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040109
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040109,
					"content": "では、君たちが得た見聞を教えてくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040110
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040110,
					"content": "ラクガキ指南書に記録した内容と、撮影した様々な写真を「カラフルノロマ」に見せた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						755040111
					]
				},
				{
					"id": 755040111,
					"content": "なんてことだ…君たちの撮影センス…絶妙じゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040112
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040112,
					"content": "まさか、写真機の扱いにこうも長けてるとは思わなかったよ。無意識のうちに最高の構図を選び出しているようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040113
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040113,
					"content": "なら、過分なアドバイスはかえって悪い影響を及ぼすだろう。私がちょっと導くだけで、君たちはすぐにでもアイデアを広げられるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040114
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040114,
					"content": "さあ、私の手記を受け取ってくれ。今後の旅で時間があるときに目の前の景色に合わせてこれを読めば、迫力満点の構図が浮かび上がるはずさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040115
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040115,
					"content": "えっ？てっきりオイラたちの写真を一枚一枚分析して…前衛的理念をレクチャーしてくれるもんだと思ってたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040116,
					"content": "それにオイラもラクガキをしてみたかったんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040117,
					"content": "いや、もともと才能がある君たちなら、自分の力で学ぶことができる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040118
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040118,
					"content": "独学で才能を開花させられる天才に向かって、教科書どおりの几帳面なラクガキの手法を教えては、成長を妨げてしまうかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040119
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040119,
					"content": "だから、私は全責任を持つ指導教員かつ案内人という立場から、君たちに助言を与える先輩になろうと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040120
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040120,
					"content": "二人のインスピレーションが湧き上がり機が熟したら、ラクガキ用の塗料缶を手に、大いに本領を発揮するといい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040121
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040121,
					"content": "オイラたちって、そんな才能もあったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040122,
					"content": "へへっ…今まで画家とか映影監督の依頼をたくさん受けてきたけど、無駄じゃなかったってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040123,
						755040124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040123,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040125
					]
				},
				{
					"id": 755040125,
					"content": "ああ。でも気張りすぎないようにね。君たちの才能があれば、自分なりの理解をもって前衛芸術の要点を掴むことができるはずさ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040126
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040126,
					"content": "私は普段「謎煙の主」でラクガキユニオン総本部の建設準備を進めている。もし聞きたいことがあったら、いつでも来てくれて構わないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040127
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040127,
					"content": "君たちのためにラクガキ用装備のセットを用意して待っていよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040128
					],
					"speakerTitle": "「カラフルノロマ」"
				},
				{
					"id": 755040128,
					"content": "おう。ラクガキユニオンの総本部は「謎煙の主」に建てられるんだな。覚えとくぜ…それじゃあ頑張れよー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040129,
						755040130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040129,
					"content": "とっても楽しかった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040131
					]
				},
				{
					"id": 755040131,
					"content": "時間ができたら、「カラフルノロマ」の手記を読んでオイラたちの芸術的思考をもっと磨いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755040132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040132,
					"content": "そのうち、本当にラクガキと絵描きの達人になって、その才能で臨時収入を稼げるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 755040130,
					"content": "また今度！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040131
					]
				},
				{
					"id": 755040124,
					"content": "理解を深められるよう、頑張るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040125
					]
				},
				{
					"id": 755040107,
					"content": "もっと前衛的な理念を磨かないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755040108
					]
				}
			]
		}
	]
}