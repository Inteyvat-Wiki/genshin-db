			"dialogs": [
				{
					"id": 750730301,
					"content": "うぅ、やっと出られた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730302,
					"content": "この熱気球、すごく揺れるわね。強い風が吹いたら、まるごと吹き飛ばされちゃうかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730303,
					"content": "そうなったら、黒曜石の老婆が来てもきっと助からないわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730304,
					"content": "#{M#君}{F#あなた}は誰？どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "あっ、まだ自己紹介してなかったわね。私はコヌラフ、「謎煙の主」の見習い祭司よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730306,
					"content": "祭司の修行中なの…えっと、ずっと集落で暮らしてたんだけど、部族の年長者に「外の世界を見てみなさい」って言われて——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730307,
					"content": "修行って名目で集落から追い出されちゃった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730308,
					"content": "でも、ヒルチャールに捕まるような「外の世界」って、やっぱり見ない方がいいと思うの。恩人様、そう思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730309,
					"content": "一人で冒険するのは危ない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "でしょ、そうでしょ？恩人様が来てくれなかったら、ずっとここに閉じ込められたままだったかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730313,
					"content": "とにかく、助けてくれて本当にありがとう…ここは風が強いし、とりあえず下りてから、修行を続けるかどうか考えよっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730314,
					"content": "人から受けた恩は必ず返しなさいって家族に言われてるの。手持ちは多くないけど、良かったら、これを受け取って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730311,
					"content": "十分強ければ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "ふん…バカにしないでよね。あなたほど強い冒険者なんて、数えられるほどしかいないことくらい、知ってるわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "コヌラフ"
				}
			]
		},
