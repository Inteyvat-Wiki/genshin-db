				"points": []
			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "あっ、恩人様！ヒルチャールを倒してくれてありがとう。助かったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730102,
					"content": "さっき崖の上で景色を眺めてたんだけど、油断してたのね、ヒルチャールに頭をぶたれて気を失っちゃったみたい。目が覚めたら、ここに閉じ込められてたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730103,
					"content": "閉じ込められ…あ、鍵…鍵はあそこの箱の上にあるわ。お願い、もう一度その優しい手を差し伸べてくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "コヌラフ"
				},
				{
					"id": 750730104,
					"content": "このご恩は一生忘れないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "コヌラフ"
				}
			]
		},
