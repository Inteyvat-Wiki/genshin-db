				"points": []
			},
			"dialogs": [
				{
					"id": 745040101,
					"content": "君たち、そんなに楽しみなんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040102
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745040102,
					"content": "こっそり教えてやるけどな、俺に言わせりゃ、今回の企画には期待せえへんほうがいいで。こんなことに時間を割くぐらいやったら、ルポート時計店に行って遊んだほうがマシやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040103
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745040103,
					"content": "うわっ！それがおまえの本音なのか？そんなにあっさり言って大丈夫なのかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745040104,
					"content": "しーっ、静かに。人に聞かれたらまずい。俺があっちから派遣されてきたスパイやって思われたら大変やで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040105
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745040105,
					"content": "はぁ、この話はこの辺で止めとこう。俺は一介の雇われの身やからな。やっぱ仕事の話に戻ろか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040106
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745040106,
					"content": "まず、今回の企画におけるデータ収集は大きく二つに分かれてる。俺とアルボンがそれぞれ一つずつ担当してるんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040107
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745040107,
					"content": "俺が担当してるデータ収集は、決闘代理人の戦闘力をシミュレートするためのものや。君には戦闘プロジェクトにトライしてほしいんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040108
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745040108,
					"content": "俺らは野外で魔物の集まる場所を見つけて、その近くにデータ記録の装置を設置したんや。君らはそいつらを片付けてくれればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040109
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745040109,
					"content": "具体的な位置はすでに地図に記しておいた。他の注意事項については、このハンドブックに書いてあるから、後で確認してや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040110
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745040110,
					"content": "他に質問はあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040111
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745040111,
					"content": "特に質問はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745040112
					]
				},
				{
					"id": 745040112,
					"content": "ほな、データ収集がうまくいくことを祈ってるやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルベール"
				}
			]
		}
	]
}