			"completionStepIds": [
				7166901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166901",
							"2"
						],
						"stepId": 7166901,
						"stateName": "QUEST_STATE_UNFINISHED"
