				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"振塵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME}、職員から聞いたよ。発信装置をつけた動物を全部見つけたってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690102,
					"content": "驚いたよ。だって、警戒心の強い動物もいただろう？そういう子は初めて見る人が近づくと、すぐに逃げてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690103,
					"content": "しかし、君が近づいても逃げなかったってことだ。本当に不思議だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690104,
					"content": "動物に好かれるタイプだから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "ははっ、羨ましいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690107,
					"content": "職員と一緒に動物に餌をやりに行ったことがあるけど、吠えられたり噛まれたりで大変だったよ、私は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690112,
					"content": "まだ腕のあちこちに傷跡が残ってて、痛いんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690113,
					"content": "まぁ、動物に懐かれるタイプじゃないのは残念だけど…可愛い子たちが元気に生きてるのを見れれば、それで満足さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690114,
					"content": "里親になってくれた人たちも、きっと同じ気持ちだろう。動物たちの自由な暮らしを見守りつつ、よりよい環境を整えてあげたいと願っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690115,
					"content": "多くの冒険者にとって、野生動物は重要な食材の一つだってことは知ってるし、「アニマルトゥギャザー」としても、会員に狩りを禁止させようなどとは思っていない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690116,
					"content": "だが、動物の乱獲には反対している。もし皆がその原則を守ることができれば、きっと周りの環境もより豊かで美しいものになるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690117,
					"content": "#{NICKNAME}にも、会員としてぜひこの原則に賛同していただきたいものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690118,
					"content": "うん、同感だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "見識の広い君なら、きっとそう言ってくれると思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690122,
					"content": "他人に考えるきっかけを与えることができたら、今の活動に意味はあると思ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690123,
					"content": "「アニマルトゥギャザー」の次のイベントでも、君に会えることを願っているよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690124,
					"content": "それまで腕に新たな傷を増やさないよう頑張るつもりだ、ははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690120,
					"content": "ノーコメントで…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "ああ、強要するつもりはない。だが、動物に手を下す前に、一度立ち止まって考えてほしい——個人としてはそう願っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "振塵"
				},
				{
					"id": 716690105,
					"content": "これぞ、冒険者の才能。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
		{
			"id": 7166902,
