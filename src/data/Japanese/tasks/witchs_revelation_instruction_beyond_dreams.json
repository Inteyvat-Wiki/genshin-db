			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バーベロス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746970101,
					"content": "ん？あそこにいるのって、瑞希と獏じゃないか？もうバーベロスと話してるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746970102,
					"content": "旅人とパイモン…？さっきバーベロスさんからキミたちのことを聞いてね、会えたらいいなって思ってたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970103
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970103,
					"content": "ふふっ…どうやら、「運命」はすでにあたしたちが出会う場所を用意してくれてたみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970104
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970104,
					"content": "瑞希は旅行に来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970105
					]
				},
				{
					"id": 746970105,
					"content": "うん…まあ、そうとも言えるかな。心理学の知識を普及するための映影の準備が順調に進めば、この辺りを散策して息抜きできるかも。でもそれまでは、やっぱり仕事に集中しないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970106,
						746970107
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970106,
					"content": "心理学の映影？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970108
					]
				},
				{
					"id": 746970108,
					"content": "映影ってそんなこともできるのか？なんだかすごそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746970109,
					"content": "うん、最近思いついた新しい手法だよ。前に「秋沙銭湯」の宣伝をした時、フォンテーヌの映影を参考にして、娯楽番組をいくつか収録したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970110
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970110,
					"content": "そしたら、みんなすごく興味を持ってくれたみたいでね。毎回しっかり見てくれただけじゃなく、番組の中で説明した心理学の知識まできちんと覚えてくれたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970111
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970111,
					"content": "だから、いっそのこと直接「心理的な病気」をお題にした映影を何本か撮って、楽しみながら学べる形で、みんなに心理学の基礎知識を解説してみようって思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970112
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970112,
					"content": "…基礎が身につけば、みんなも「心理的な病気」に対して基本的な客観的認識を持てるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970157
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970157,
					"content": "…そうすれば、実際に存在する症状をでたらめだと思い込んだり、過剰に恐れたりすることもなくなるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970113
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970113,
					"content": "それにあたしが診療する時も、もっと円滑に進むようになるかもしれないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970114,
						746970115
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970114,
					"content": "瑞希は色々と考えてるんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970116
					]
				},
				{
					"id": 746970116,
					"content": "そうだね。なにせ心の病には形も色もないから、それを把握する…いや、その存在に気づくことすら簡単なことじゃないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970117
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970117,
					"content": "けど…それをどう捉えて、映影の台本に落とし込めばいいのか分からないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970118
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970118,
					"content": "恥ずかしい話だけど、普段から心理的な病気に関する論文はたくさん書いてるのに、台本を書くとなると全然筆が進まなくなっちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970119
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970119,
					"content": "時には一日中部屋にこもって、数行の台詞や数十秒の展開をずっと練り直すんだけど、それでも答えが出ないこともあるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970120,
						746970121
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970120,
					"content": "すごく大変そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970122
					]
				},
				{
					"id": 746970122,
					"content": "もしかしたら、あとちょっとひらめきが足りないだけかもな？オイラと旅人も、なにかに行き詰まってる時は、別のことをするようにしてるんだ。そしたら、「ピキーン」ってなにか思いつくかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746970123,
					"content": "うん、あたしたち同じ考え方だね。だからここに来て、「おみくじ」とはまったく違った占いの形式を試してみようと思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970124
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970124,
					"content": "こちらの魔女さんの「月諭のアルカナ」が、あたしに特別な閃きをもたらしてくれるといいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970125
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970125,
					"content": "閃きねえ…以前、アンヤは「月諭のアルカナ」の一枚一枚に、特別な童話を書きたいと言っておった。あいつが書きたかった物語はたくさんあったのに、時間は…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970126
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970126,
					"content": "おまえさんが閃きを求めておるのなら、カードを一枚引いとくれ。あの魔女の未完の童話が、物語の閃きへの導きになるとよいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970127
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970127,
					"content": "はい。でも、あたしが知ってる「占い」は大抵…鳴神大社に関係するものだったので、カードで占うのはこれが初めてなんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970128
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970128,
					"content": "もし儀式の作法にそぐわないことをしてしまったら、遠慮なく指摘してください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970129
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970129,
					"content": "おや、逆位置の「月」だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970130
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970130,
					"content": "「月」は正位置と逆位置の意味が似ておる。「逃避」、「隠蔽」、「自己欺瞞」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970158
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970158,
					"content": "まるで暗い月の下を歩く者のように、進むべき道を見失い、どう抜け出せばいいのかも分からない状態だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970131,
						746970132
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970131,
					"content": "あまり良くないのかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746970133
					]
				},
				{
					"id": 746970133,
					"content": "そうだな。なんだかその説明だと、警告みたいに聞こえるぞ…どう考えても、ヤバそうな気がするぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746970134,
					"content": "だが、夢見月さんがこの予言を聞けたということは、事態はまだ窮地に陥ってはおらんということでもあるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970135
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970135,
					"content": "少し努力すれば、道を覆い隠す暗雲から抜け出して、求める物を見つけられるかもしれない…そう考えることもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970136
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970136,
					"content": "逃避と隠蔽、そして…「自己欺瞞」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970137
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970137,
					"content": "単純にカードを読み解くなら、そういうことだ。もっとはっきり言うと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970138
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970138,
					"content": "おまえさんはすぐ目の前にある答えから逃げておる。わざわざ遠回りをしてまで、それから離れようとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970139
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970139,
					"content": "つまり、あたしの台本を批評してくれる人は、実はすぐ目の前にいるということですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970140
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970140,
					"content": "台本に限った話じゃないがね。ただ、具体的にカードが持つ意味をどう理解するかは、自分次第だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970141
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970141,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970142
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970142,
					"content": "目の前にある答え、遠回りの逃避…何を指してるのか、大体分かってきたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970143
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970143,
					"content": "ふふっ…言われてみれば、確かにあたしは「自己欺瞞」してる…それか、無意識のうちに「遠回り」をするようになってたみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970144
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970144,
					"content": "以前から八重堂を訪ねて、宮司様に映影の台本について助言をもらおうと思ってたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970145
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970145,
					"content": "心理療法の観点から言えば、それも「無意識の逃避」ってことになるね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970146
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970146,
					"content": "ありがとうございます、バーベロスさん。やっぱり、カードはあたしに閃きをもたらしてくれました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970147
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970147,
					"content": "礼には及ばないよ。運命の糸を解きほぐしたのはおまえさんで、わしはその糸口を渡してやっただけさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970148
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970148,
					"content": "ただ、その宮司もまた、運命に翻弄される者の一人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970149
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970149,
					"content": "絡み合う糸は往々にして厄介事を引き起こすものだよ。その観点からすれば、おまえさんがその者と距離を置くのも、決して悪いこととは言い切れないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970150
					],
					"speakerTitle": "バーベロス"
				},
				{
					"id": 746970150,
					"content": "宮司様に原稿を見てもらって、少し意見をもらうだけなら、その「運命」に関わることはありませんよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970151
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 746970151,
					"content": "さっきも言った通り、解釈はおまえさん次第だよ。わしは一枚のカードから、未来の細部まで見通せるわけじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746970152
					],
					"speakerTitle": "バーベロス"
