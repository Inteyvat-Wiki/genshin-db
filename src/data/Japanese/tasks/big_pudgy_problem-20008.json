			"dialogs": [
				{
					"id": 200080101,
					"content": "助けてくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "アーサー"
				},
				{
					"id": 200080102,
					"content": "このスライムたちが急に出てきて、まさかここにいると思わなかったから逃げそびれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "アーサー"
				},
				{
					"id": 200080103,
					"content": "父さんには言わないでよ。最近スライムたちが凶暴だから家にいろって言われてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "アーサー"
				},
				{
					"id": 200080104,
					"content": "しかもスライムはモンド城周辺に出現し始めただろう。もう家に何日もいたから退屈で、今日はこっそり抜け出したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "アーサー"
				},
				{
					"id": 200080105,
					"content": "もしよければだけど、この先に行ってみてくれないかな。スライムがいたら、倒してほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "アーサー"
				},
				{
					"id": 200080106,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "やった！やっと安心して遊べるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アーサー"
				},
				{
					"id": 200080107,
					"content": "他に急用がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "で、でも父さんには言えないんだ…頼めるのは君だけだよ、頼む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アーサー"
				}
