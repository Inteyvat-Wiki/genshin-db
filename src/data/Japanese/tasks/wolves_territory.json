			"dialogs": [
				{
					"id": 4510601,
					"content": "ほら、捕まえてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510602,
					"content": "ありがとう。でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510603,
					"content": "オレたちなら、5、6頭は捕まえる。それだと、メシ食えない狼、出てくる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510604,
					"content": "そ、そうなのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510605,
					"content": "気にするな、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510606,
					"content": "騎士団の、赤い、熱い女の子——その友達より、やる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510607,
					"content": "彼女なら、山を燃やす。イノシシ、捕まえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510608,
					"content": "そろそろ行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510609,
					"content": "ここ、安全じゃない。お前たちも、気を付けろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510610,
					"content": "変わったやつだったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510611,
					"content": "そういえば、騎士団にいる赤くて、熱い女の子って──",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}、誰のことか分かるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
