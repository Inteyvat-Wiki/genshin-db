			"dialogs": [
				{
					"id": 4510101,
					"content": "「奔狼領」は、モンドの人でもあまり足を踏み入れないところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510102,
					"content": "モンドからそう離れてないけど、開拓されてないから生態系が原始的で、大自然って感じの場所だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510103,
					"content": "まさに弱肉強食の世界、スライムもかなりデカい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510104,
					"content": "ほら、ちょうどこんな風に——きょ、だい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510105,
					"content": "…来る！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45104",
							"2"
						],
						"stepId": 45104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"レザー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "た、たすかったぜ——あっ！奔狼領の狼が来る、逃げるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510303,
					"content": "心配ない。狼は友達。お前たちは、誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510304,
					"content": "オイラたちはただの旅人だけど……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510305,
					"content": "お前たち、普通じゃない。でも、知ってる匂いが、する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510306,
					"content": "知ってる匂い？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510307,
					"content": "騎士団、だろ？騎士団に、友達いる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510308,
					"content": "名前は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "オレ、レザー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510311,
					"content": "おまえも騎士団の一員なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510312,
					"content": "騎士団とは、関係ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510314,
					"content": "うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510315,
					"content": "あの狼は…いったい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "ああ……狼は、家族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510317,
					"content": "家族？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510318,
					"content": "家族。オレを育てた、一緒に暮らす、家族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510319,
					"content": "なんか複雑な事情がありそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510320,
					"content": "彼らに怒られた。お前たち助けるために、待ち伏せ、バレた。イノシシ、逃がした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510321,
					"content": "#そうだったのか…じゃあ、{NICKNAME}が手伝うっていうのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510322,
					"content": "#{NICKNAME}もなかなかやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510323,
					"content": "や、やめておく。騎士団の友達が、手伝うと、いつも狼が腹、空かせる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510324,
					"content": "遠慮するなよ。満足させてやるから、待ってろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4510309,
					"content": "騎士団の人間？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "オレはレザー。騎士団とは、関係ない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "レザー"
				}
			]
		},
		{
