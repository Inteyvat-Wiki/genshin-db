			"dialogs": [
				{
					"id": 4510501,
					"content": "あっ、本当に、手伝うのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510502
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510502,
					"content": "狼には、方法がある、効率がいい。でもこの罠、新しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510503,
					"content": "置いて、イノシシを近づかせる、だろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "レザー"
				},
				{
					"id": 4510504,
					"content": "爆発はない、だろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "レザー"
				}
