			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賀摩",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722500101,
					"content": "うわぁ！お、お許しを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500102
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500102,
					"content": "その、ここ最近、須婆達の彦を中心とした謀反にお偉いさん方は頭を抱えていると聞きまして。だから、大日御輿の守りが薄くなっていると思い、魔が差してしまったんです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500103
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500103,
					"content": "私はまだ、大病を患っている母と十二人の愛しい孤児たちの面倒を見なければなりません！どうかお許しください！何卒、この通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500104
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500104,
					"content": "コホンッ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722500105
					]
				},
				{
					"id": 722500105,
					"content": "えっと、その、大日御輿の…守衛ではないのでしょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500106
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500106,
					"content": "その奇抜な服装…なるほど、どこか怪しい場所から来た同業者だったんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500107
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500107,
					"content": "オイラたちは同業者なんかじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722500108,
					"content": "ここまで来たんですし、今さら隠すこともないでしょう。はぁ…まったく、出鼻をくじかれました。やっとのことで大日御輿に入って、色々と漁ったのに、からくりに足止めされるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500109
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500109,
					"content": "今日は少々運が悪かったみたいですね…金持ちから金品を奪い、それを貧者に与えるような善行には向かない日だったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500110
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500110,
					"content": "ふんっ、そんな綺麗ごと言って、けっきょく泥棒じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722500111,
					"content": "あなたたちに何がわかるんですか。お偉いさん方は毎日、歌と美酒に囲まれた生活をしている。それに引き換え私たち底辺の者は、まさに死ぬほど疲弊するまで働いているんです。彼らの尿瓶の手入れをしたり、草鞋を温めたり…そんなことをやっているんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500112
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500112,
					"content": "はぁ、そうだ。私を救ってくれたお礼に、ある秘密をお教えしましょう。以前、大日御輿の整備をしていた大工を買収して得た情報なんですけど、このようにお宝が隠された部屋が、あと二つもあるそうです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500113
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500113,
					"content": "あと二つも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722500114,
					"content": "#{NICKNAME}、オ、オイラたちも、お金持ちの金品で貧しい人たちを救うべきだと思わないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722500115,
					"content": "ですが、その二つの部屋の位置は分かりません。あの大工も、それ以上は言えなかったようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500116
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500116,
					"content": "どうですか、とても良い情報でしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500117
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500117,
					"content": "どうせ今の淵下宮には誰もいないし…それに、大昔の骨董品がいっぱい手に入るかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 722500118,
					"content": "#{NICKNAME}、あとでこっそ～り近くを探してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}