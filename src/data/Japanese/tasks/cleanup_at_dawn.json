			"dialogs": [
				{
					"id": 708240101,
					"content": "真面目に掃除しなさい！ワイナリーに対するお客様の第一印象に影響するでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 708240102,
					"content": "ごめんなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 708240103,
					"content": "気を付けます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 708240104,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "あなたでしたか。アカツキワイナリーへようこそ。暴風は収まりましたが、ワイナリーの片付けはまだ残ってます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 708240106,
					"content": "掃除の仕事をモコとヘイリーに任せようとしましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 708240107,
					"content": "ごめんなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 708240108,
					"content": "気を付けます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 708240109,
					"content": "さっきも聞きました！謝る暇があったら、もう一度しっかり掃除してきなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "アデリン"
				},
				{
					"id": 708240110,
					"content": "あの子たちったら、あの調子ではいつ終わるか分かりません。まだ屋内の掃除もあるというのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アデリン"
				}
			]
		},
