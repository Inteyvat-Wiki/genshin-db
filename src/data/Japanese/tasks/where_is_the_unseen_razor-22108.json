				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "今回も見つからなかった、もう手がかりが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "誰？協会のことが知りたいなら、そこにいるキャサリンに聞くといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080104,
					"content": "すでに冒険者だったの？ごめんなさい、支部長だけど協会のことはあまり詳しくないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080105,
					"content": "だから新人のこともよく知らなくて…でもその様子じゃ、冒険についてはそれなりに分かってるでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080106,
					"content": "では、ひとつ手伝ってくれるかしら？先に言っておくけど、協会の任務ではなく、私個人の依頼よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080107,
					"content": "わかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "話が早いわね。でも詳細も聞かずに依頼を受けるのは賢い行動とは言えないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080111,
					"content": "依頼の件だけど、大盾を持つヒルチャールを2体倒して欲しいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080112,
					"content": "そいつらの盾には「岩」属性の力がついてる。そんなに危険ではないけど、気を付けたほうがいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080113,
					"content": "あなたのするべきことはそいつらを倒すことよ。倒したら私のところに来て、相応しい報酬を支払うから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080114,
					"content": "そうだ、もし「剣」に関する何かを見つけたら、持ってきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080115,
					"content": "もしなかったらそれでいいわ。ヒルチャールを倒してくれればちゃんと報酬を支払うから、安心しなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080108,
					"content": "どういう依頼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "慎重な人ね、前にひどい目でも遭ったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "嵐姉"
				}
			]
		},
