					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "頼もしいわね、確かに冒険者らしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080304,
					"content": "さあ、報酬を受け取りなさい。これで周りも少しは安全になるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080305,
					"content": "「剣」に関するものはなかったかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080306,
					"content": "…そう。大丈夫、それも想定内だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "嵐姉"
				},
				{
