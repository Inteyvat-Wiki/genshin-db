						221080202
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080202,
					"content": "まだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "急がなくていいわ。焦りは自分自身を窮地に追い込むだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 221080204,
					"content": "でもノロノロしすぎるのもだめ、報酬は所要時間と関係があるからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				}
			]
		},
