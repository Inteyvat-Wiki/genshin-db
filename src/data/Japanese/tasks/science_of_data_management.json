			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "ほぼ片付いたかな…これらの書類が役に立つといいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160102,
					"content": "まだ書類整理をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "やっ、お会いできて光栄だよ、名誉上級研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160104,
					"content": "ええ、レモンドさんの指示で、相変わらずここで資料や書類の整理をしているの…あれ、言ってなかったっけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160105,
					"content": "こんな広いところで、一人で仕事するのは大変だな。レモンドはなんで人を派遣してくれないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240160106,
					"content": "科学院は今あれこれ忙しくて、それどころじゃないの、無理もないと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160107,
					"content": "「主任」って呼ばれてるのに…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "「フォンテーヌ科学院文書回収班主任」の肩書きのこと？冗談はやめて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160109,
					"content": "私が「主任」なんてとんでもない。私はずっと、書類整理の平職員だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160110,
					"content": "レモンドさんからここを整理するように言われて、突然与えられた肩書なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160111,
					"content": "ショワズールさんの意見だって。私たちの仕事はキツイから、手当を増やしてもらいやすいというのが主な理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160112,
					"content": "や！誰にも言わないでね、ああ…何でこんなことを言ったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160113,
					"content": "言わないよ、大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "良いことみたいだな。多くの仕事をがんばってこなしている人なら、報酬を多くもらっても問題ないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240160115,
					"content": "でもどうしてそんな回りくどいことするんだ？みんなに報酬をあげたらいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240160116,
					"content": "科学院では普通のことだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "ああ、ショワズールさんとレモンドさんが何を考えているのかわからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160119,
					"content": "でもとにかく、私は仕事を続けなきゃ。まだやることがたくさんあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160120,
					"content": "名誉上級研究員。手伝ってくれない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160121,
					"content": "もちろん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "じゃあ、周りの汚れをきれいにして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160125,
					"content": "整理の時はなるべく<color=#00E1FFFF>周りの書籍やそれらの書類</color>に触らないでね。そっちも汚れてしまったらまずいことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160126,
					"content": "それじゃお願い、私は書類の整理を続けなければ。ああ、院内にこれほど書類があるなんて、普段気にもしてなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160122,
					"content": "#じゃあ、{M#俺}{F#私}の名誉にもっと箔をつけて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "うん、問題ない。あなたの親切の証人になってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160117,
					"content": "とにかく、もらえればいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
