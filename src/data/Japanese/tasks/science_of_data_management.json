			"dialogs": [
				{
					"id": 240160301,
					"content": "ふぅ…ありがとう。手伝ってくれなかったら、いつまでかかっていたことか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160302,
					"content": "さすが名誉上級研究員、どんな仕事もテキパキこなせるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160303,
					"content": "#{M#俺}{F#私}はいつだって切れ者だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "改めてお手伝いありがとう、名誉上級研究員。どうかこれを受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160304,
					"content": "掃除には多少の心得がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "え？本当に多才な人ね。さすが名誉上級研究員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
