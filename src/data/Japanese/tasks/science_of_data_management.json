				},
				{
					"id": 240160402,
					"content": "でももう少しお手柔らかにしてくれれば、もっとありがたいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160403,
					"content": "ごめん…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "あ、いえいえ！責めているんじゃないんだ、相当助かったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "シャラメ"
				},
				{
					"id": 240160406,
					"content": "どうかこれを。ありがとう、名誉上級研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シャラメ"
				},
				{
