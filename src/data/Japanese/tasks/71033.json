			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フェルメール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "旅人、旅人！こっち！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330102,
					"content": "前に清昼と言い争ってた画家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "あぁ僕だ。海灯祭について各自芸術作品を作ると、あの詩人と約束したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330104,
					"content": "この前僕のために材料を集めてくれたよね、覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330105,
					"content": "覚えてる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "絵は…ゴホッ、まあ…たくさん書いたよ、景色とか、人物とか、動物とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330108,
					"content": "絵に関しては自信がある、でも…どの絵も、海灯祭を表現できてるとは言えない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330109,
					"content": "はぁ、もう何日も食事と睡眠を取ってないんだ。それでもまだ納得できる絵ができてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330110,
					"content": "だから、あの詩人を訪ねて、彼の詩がどうなったか知りたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330111,
					"content": "旅人、あの詩人がどこに行ったか知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330112,
					"content": "軽策荘に行った。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "軽策荘？なんでそんな場所に…まさか、現地取材か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330114,
					"content": "旅人、早く軽策荘に行って彼を探そう！あの場所が創作に適してるなら、僕も何かひらめくかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330115,
					"content": "ゴホンッ！とりあえず、出発しよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330106,
					"content": "じゃあ絵は…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
