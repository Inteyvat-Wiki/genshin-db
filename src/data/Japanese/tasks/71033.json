				"objectNames": [
					"フェルメール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331101,
					"content": "やっと来たか、詩はできたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331102
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331102,
					"content": "詩はできなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331103
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331103,
					"content": "き、君も…ゴホンッ、ど、どうしてできなかったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331104
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331104,
					"content": "璃月の大地、霄灯の町、どんなに考えても、一篇の詩に収められなかった。君は？絵はできたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331105
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331105,
					"content": "ぼ…僕もできてない…璃月がこんなに大きいなんて！これを描くには、空と同じくらい大きい紙が必要だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331106
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331106,
					"content": "ということは、私たち二人とも、璃月と海灯祭の詩と絵を作れなかったというわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331107
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331107,
					"content": "それなら、「引き分け」ということかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331108
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331108,
					"content": "いいだろう…それで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331109
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331109,
					"content": "清昼おじさん！清昼おじさん！灯謎出して！当てるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331110
					],
					"speakerTitle": "佐"
				},
				{
					"id": 710331110,
					"content": "灯謎？なんだ灯謎って？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331111
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331111,
					"content": "気にしなくていい。子供たちと遊ぶための、灯謎遊びさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331112
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331112,
					"content": "どんな灯謎なんだ、聞かせてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331113
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331113,
					"content": "「船が波間に揺れる中、孤雲が夜から白夜へと。大海背にして沈むのは、龍宮彩魚と眠るため。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331114
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331114,
					"content": "それが子供たちに書いた灯謎なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331115
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331115,
					"content": "清昼おじさん、このおじさんは誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331116,
						710331117
					],
					"speakerTitle": "佐"
				},
				{
					"id": 710331116,
					"content": "この人は画家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				},
				{
					"id": 710331118,
					"content": "元々僕と勝負する気がなかったのなら、どうしてあんな約束をしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331119
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331119,
					"content": "それは誤解さ。初めはもちろん真剣に勝負しようとした…最高の詩を作るために、一生懸命取材して…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331120
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331120,
					"content": "しかし君も感じただろ、言葉だけでこの璃月と海灯祭を表現することはできない。だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331121
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331121,
					"content": "だからここに来て子供たちと遊んでいるというのか？灯謎遊びまでして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331122
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331122,
					"content": "だからこそ、子供たちと灯謎遊びをして、詩に使えるひらめきを得ようとした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331123
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331123,
					"content": "ふふ、結局思いつかなかったが、灯謎は結構作れたよ。子供たちも喜んでくれてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331124
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331124,
					"content": "もしかすると…これが私が追い求めていた「詩」なのかもしれない。しかし、字に表せなかったから、君との勝負にも当然使えない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331125
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331125,
					"content": "…君たち璃月人は本当に変だ！勝負はどうなるんだ？誰が勝ちなんだ？引き分けなんか認めるものか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331126
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331126,
					"content": "このおじさんうるさい…清昼おじさんの勝ちに決まってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331127
					],
					"speakerTitle": "佐"
				},
				{
					"id": 710331127,
					"content": "清昼おじさんすごいんだよ。灯謎をたくさん出せるし、おじさんじゃ絶対に当てられないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331128
					],
					"speakerTitle": "佐"
				},
				{
					"id": 710331128,
					"content": "この詩人が…ん？待てよ、僕に案がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331129
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331129,
					"content": "そ、そうだ！もう一度勝負だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331130
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331130,
					"content": "ほう？どうやって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331131
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331131,
					"content": "君はその子供たちと灯謎遊びをしていただろ？僕は取材をしていた時、霄灯をたくさん見た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331132
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331132,
					"content": "だから君が灯謎を作って、僕が霄灯を描く。それで子供たちにどっちが好きか決めてもらうというのはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331133
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331133,
					"content": "それはいい案だ！海灯祭にぴったりじゃないか。これに越したことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331134
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331134,
					"content": "じゃあ、僕が画具を用意したら、ここでもう一度勝負だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331135,
						710331136
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331135,
					"content": "やる気満々…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331137,
					"content": "さあ、子供たち、その詩人が書いた灯謎を教えてくれ。僕がとても綺麗な霄灯を描いてあげるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331138
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710331138,
					"content": "ふふ、君の霄灯を描く速度が、私の灯謎作りについてこられるといいが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331136,
					"content": "二人とも頑張って…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331117,
					"content": "清昼と勝負してる人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				}
			]
		},
