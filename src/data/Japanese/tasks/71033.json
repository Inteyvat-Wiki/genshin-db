				{
					"id": 710331402,
					"content": "#私はこの{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}と用事があるから、終わったらまた遊ぼう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331403,
					"content": "ええ——清昼おじさん、なんの用事があるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "六"
				},
				{
					"id": 710331404,
					"content": "画家の人との…勝負だよ。詩を書いて、彼の絵とどっちが優れてるか決めるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331405,
					"content": "そんなの、清昼おじさんの勝ちに決まってるよ。灯謎も全部すごくよかったし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "佐"
				},
				{
					"id": 710331406,
					"content": "そうかい、ありがとう。君たちはその霄灯を持って軽策荘に戻ってね。野外は危ないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331407,
					"content": "安心して、ここは詳しいから、自分たちで帰れるよ。早くあの画家をやっつけてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "佐"
				},
				{
					"id": 710331408,
					"content": "じゃあ…清昼おじさん、勝負が終わったら、早く戻って来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "佑"
				},
				{
					"id": 710331409,
					"content": "もちろん、終わったらすぐ行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331410,
					"content": "確かにいい詩だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "この詩なら勝負に勝てる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "ははっ、詩だなんて、これはただの灯謎さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331413,
					"content": "よし、ではあの画家を探しに行こう。今頃待ちくたびているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
