					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "あの二人か、大丈夫、子供たちと遊んでくれるのはいいことじゃよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331204,
					"content": "祭りは賑わう方がいいからのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331205,
					"content": "それにしても、私たち軽策荘のためにこんなにも手伝ってくれて、ご苦労さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331206,
					"content": "大丈夫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "本当に熱心な子じゃ、ありがとう…さあ、これを受け取って。あなたも祭りを楽しんでおくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331209,
					"content": "今後の海灯祭も、こんな賑やかだといいけどねぇ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 710331207,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
