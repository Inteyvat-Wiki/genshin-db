			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "おや、旅人かい。あなたのおかげで、この軽策荘も祭りで賑わってるわい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330402,
					"content": "おや？隣の方、見慣れない顔だね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330403,
					"content": "この人は画家、清昼を探しにきた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "清昼を？うむ、ちょうどいいじゃろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330405,
					"content": "何日か前に望雅がここを離れた時、清昼はまだここにいたいと言ったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330406,
					"content": "それでまだ子供たちと灯謎を遊んでるから、多分、外にいるのかね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330407,
					"content": "彼を探すなら、外に行ってみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330408,
					"content": "本当に灯謎が好きなんだな…旅人、悪いけど探してきてくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330409,
					"content": "あの詩人に僕が来たことを伝えてくれると助かる。僕はここで準備するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330410,
					"content": "どうしても、今日決着をつけたいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清昼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "あははっ、君たちも結構コツを掴んできたね、ますます上手になってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330502,
					"content": "フェルメールが来てる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "フェルメール…あぁ、あの画家か。どれどれ、確かに約束を実行する時が来たね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330505,
					"content": "でも惜しいことに、私の詩はまだ完成できてない。それに子供たちとの灯謎もまだ遊び足りてないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330506,
					"content": "ふふ、もしかするとこれが私の限界かな…そうだ、ひらめきを得るために少し付き合ってくれないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330507,
					"content": "いや…ひらめきを得るというより、普通に散歩に付き合ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330508,
					"content": "清昼おじさん！灯謎はやらないの？？俺はまだやりたいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "佐"
				},
				{
					"id": 710330509,
					"content": "私もまだ灯謎やりたい、清昼おじさん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "六"
				},
				{
					"id": 710330510,
					"content": "うぅ、私ももう少し…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "佑"
				},
				{
					"id": 710330511,
					"content": "#はははっ、皆慌てないで。この{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}と少し歩くだけだから。帰ってきたらまた遊ぼう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330512,
					"content": "君たちは先に軽策荘に帰ってて。後で探しに行くよ、どうかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710330513,
					"content": "いいよ！清昼おじさん本当にすごいね、こんなにたくさん灯謎が思いつくなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "佐"
				},
				{
