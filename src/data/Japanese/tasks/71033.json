			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フェルメール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "ここが軽策荘か…あの詩人は？どこで取材をしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330302,
					"content": "前は子供たちと灯謎遊びしてた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "灯謎遊び？なんで…そんなこと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330304,
					"content": "詩が思い浮かばなくて、あきらめたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330305,
					"content": "まあいい、彼が何をしようが関係ない。もう海灯祭は残り何日もないんだ、これ以上待っていられない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "フェルメール"
				},
				{
					"id": 710330306,
					"content": "ここの管理人に聞いてみよう、今日ここで決着をつけるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フェルメール"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103304",
							"2"
						],
						"stepId": 7103304,
						"stateName": "QUEST_STATE_UNFINISHED"
