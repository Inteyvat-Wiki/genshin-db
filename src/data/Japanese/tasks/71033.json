			},
			"dialogs": [
				{
					"id": 710331001,
					"content": "清昼おじさんが帰ってきた！清昼おじさん、新しい灯謎はできたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331002
					],
					"speakerTitle": "六"
				},
				{
					"id": 710331002,
					"content": "今回は…絶対に当てる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331003
					],
					"speakerTitle": "佐"
				},
				{
					"id": 710331003,
					"content": "今回はちゃんと考えなきゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331004
					],
					"speakerTitle": "佑"
				},
				{
					"id": 710331004,
					"content": "あははっ、もう灯謎はできてるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "清昼"
				},
				{
					"id": 710331005,
					"content": "旅人、ちょっと手伝ってほしい。この霄灯をなるべく高い場所に飾ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清昼"
				}
			]
		},
		{
