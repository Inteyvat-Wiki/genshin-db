			"dialogs": [
				{
					"id": 726530101,
					"content": "旅人さん、おかえりなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530102
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530102,
					"content": "前に集めてきてくれた欠片を船で研究しました。まだまだ…「若い」らしいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530103
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530103,
					"content": "何かしらの新しく形成された元素の塊…例えて説明すると、つい最近雪に残った、もっと深い足跡ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530104
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530104,
					"content": "そして今回は、もっと「浅い」足跡を調査してもらいたいのです…足跡に逆らって、源を追撃するのです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530105
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530105,
					"content": "「もっと浅い足跡」は、ある程度まで凝結して、地面の近くで沈積した雷元素の重合体のことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530106
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530106,
					"content": "一定量のサンプルに分類法を加えれば、大まかな進行ルートを算出できるはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530107
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530107,
					"content": "なっ…何が深い足跡で進行ルートだ…ぜんぜん分からないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726530108,
					"content": "確かに…分かりにくい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726530109
					]
				},
				{
					"id": 726530109,
					"content": "ハハ、例え方がおかしかったかも知れませんが、そこに着けば何となく分かるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530110
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530110,
					"content": "さあ、お喋りはこの辺にして、さっさと出発出発！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕珍"
				}
			]
		}
	]
