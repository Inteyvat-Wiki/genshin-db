			"dialogs": [
				{
					"id": 790000401,
					"content": "見つけた！お宝お宝～中になにが入ってるかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790000402,
					"content": "あれ？鍵がかかってる…暗号を入れる必要があるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000403,
						790000404
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790000403,
					"content": "鍵を壊せば開けられるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000405
					]
				},
				{
					"id": 790000405,
					"content": "ちょっと待て！中の物まで壊したらどうするんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790000406,
					"content": "やっぱり鍵を開ける方法を考えようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790000410,
					"content": "でもこの箱に入ってるのが「家宝」で、「暗号」の形でロックされてるんなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790000411,
					"content": "この箱に鍵をかけた人は、少なくとも覚えやすい「暗号」を使ったんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790000412,
					"content": "どうやら、ホラガイに保存されてる声を聞くのが唯一の手がかりみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790000413,
					"content": "もう一度ホラガイの中の声を詳しく聞いてみよう。「暗号」に繋がる手がかりがあるといいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790000404,
					"content": "鍵を開ける方法を考えよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000407
					]
				},
				{
					"id": 790000407,
					"content": "でも、石碑、壁画、紙切れ、刻まれた文字、ノート…どれもこの周りにはないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790000408,
					"content": "それに学者も宝盗団も冒険者もいない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000409
					]
				},
				{
					"id": 790000409,
					"content": "そうだな、うぅ。前代未聞の試練だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
