			"dialogs": [
				{
					"id": 733550201,
					"content": "あら？冒険者協会に伝言を残すまでもなかったかしら。私たち、不思議な縁があるんだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550202
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550202,
					"content": "また会えたわね、「ゴールド流星」、「シルバー伴星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550203
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550203,
					"content": "変わらず元気そうね。なんだか時間が止まってるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550204,
						733550208
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550204,
					"content": "ハニヤー、久しぶり！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550205
					]
				},
				{
					"id": 733550205,
					"content": "本当におまえたちだったんだな！ハニヤーとポコポコビーニー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550206,
					"content": "どうりで伝言を見た時、なんだか懐かしい感じがしたわけだぜ…オイラとポコポコビーニーの絆は健在だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550207,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 733550212,
					"content": "実はどう再会するか、色々考えていたのよ。豪華なパーティとか、歓迎式とか、サプライズとかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550213
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550213,
					"content": "でも、それだとかえって他人行儀な気もするし、二人とも忙しいから、あまり長く引き止めるのは迷惑かと思って、自然な形にしたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550214
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550214,
					"content": "それに、キノコンの仲間たちも静かな環境が好きだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550215
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550215,
					"content": "素晴らしいと思います！このところ散文を読んでいたおかげか、やっと穏やかに過ごすことの価値に気づかれましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550216
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 733550216,
					"content": "やっぱり、こうやって気楽にお喋りするのが一番楽しいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550217
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 733550217,
					"content": "～♫",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550218
					],
					"speakerTitle": "喜炎"
				},
				{
					"id": 733550218,
					"content": "左右加さん！喜炎も久しぶりだな。それと、そっちはたしか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550219,
					"content": "私のキノコンの仲間、信風舞姫ですよ。あの時は、ベスト三十二で「ポコポコビーニー」にあっという間に倒されちゃいましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550220
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 733550220,
					"content": "おお、さすが左右加さん！よく覚えてるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550221,
						733550222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550221,
					"content": "懐かしい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550223,
					"content": "でも、お二人とも！もう次に会う時間や場所を約束する必要はありませんよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550224
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 733550224,
					"content": "ハニヤーと私でここを買い取って、「ちびチエキノコンの森」に改装したんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550225
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 733550225,
					"content": "えっ！つまり…ここの施設はテーブルゲームのために一時的に借りたんじゃなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550226,
					"content": "そう。これから私たちはずっとバイダ港で生活して、人々にキノコンのテーブルゲームや、動物たちと交流する方法を広めていくつもりなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550227
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550227,
					"content": "時間があれば、いつでもキノコンの仲間たちと遊びに来てくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550228
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550228,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550229,
						733550230
					],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 733550229,
					"content": "やったー！キノコンの仲間と遊び放題！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550231,
					"content": "おおおー！最高だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550232,
					"content": "実は最初のキノコン大会の後、オイラ、ポコポコビーニーと一緒にできる遊びをたくさん考えてたんだ。いろいろ試して行けそうだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550233,
					"content": "でも、キノコンの仲間が食べられるようなおやつは持ってきてないんだよな…キノコンを抱っこしながら、一緒にごちそうを食べたかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550234
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550234,
					"content": "その点は心配しないで。私がいま執筆中の『キノコン概論』では、キノコンの好む食べ物を基礎から研究してるところなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550235
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550235,
					"content": "キノコンも人間も食べられるようなものを探して、仲間たちが一年中「マーベラスゼリー」ばかり食べ続けなくても済むようにすることが目標よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550236
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550236,
					"content": "いつか必ず、両方の舌を満足させられる食材を見つけ出して、絶品料理を作ってみせるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550237
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550237,
					"content": "実際の調理は、私が担当します！…十一個目の鍋を焦がされるのは阻止したいですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550238
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 733550238,
					"content": "それって、キノコンの仲間たちと一緒の食卓でご飯を食べられる日は、そう遠くないってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550239,
						733550240
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550239,
					"content": "朗報を待ってるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550241,
					"content": "とにかく、いつでも「ちびチエキノコンの森」に遊びに来てね。私たちもキノコンの仲間たちも、待ってるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550242
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 733550242,
					"content": "はい。もしかしたら、予想よりもずっと早くサプライズをお届けできるかもしれません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550243
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 733550243,
					"content": "♪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ポコポコビーニー"
				},
				{
					"id": 733550240,
					"content": "左右加の手料理、楽しみ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550230,
					"content": "これからは頻繁に会えるね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550222,
					"content": "なんだか落ち着くね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550208,
					"content": "こんにちは。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550209
					]
				},
				{
					"id": 733550209,
					"content": "本当にハニヤーとポコポコビーニーだったんだな！サウマラタ蓮杯テイマー大会…懐かしいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550210,
					"content": "確かあの後、オルモス港の近くとか、フォンテーヌ廷でも会ったよな？気づけば長い友達だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550211,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "ポコポコビーニー"
				}
			]
		}
	]
}