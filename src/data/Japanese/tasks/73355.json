			"dialogs": [
				{
					"id": 733550101,
					"content": "ん？いま向こうにキノコンが飛んでったぞ。大丈夫なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550102,
					"content": "普通に考えて、キノコンが街の中をうろついてるなんて、ちょっと危ないよな！訓練を受けた、すっごく聞き分けのいいやつなら話は別だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550103,
					"content": "ん？なんかデジャヴだな。前にも似たようなことなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550104,
						733550107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550104,
					"content": "待って、ポコポコビーニーじゃない！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550105
					]
				},
				{
					"id": 733550105,
					"content": "そうだ！スメールで出会ったキノコンの仲間のポコポコビーニーだ！きっとあいつだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550106,
					"content": "ずいぶん久しぶりだな！早く会いに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550107,
					"content": "話は別って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550108
					]
				},
				{
					"id": 733550108,
					"content": "ほら…いただろ？ポコポコビーニーだっけ？スメールで知り合ったキノコンの仲間…もしかして、あいつじゃないのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733550109,
					"content": "ずいぶん久しぶりだな！早く会いに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
