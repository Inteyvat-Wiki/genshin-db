			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヴィア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140180901,
					"content": "へへっ…あたしの考えすぎだったみたいね。こうなったら一刻も早く立ち直って、より頼りになる存在にならなくちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180902
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180902,
					"content": "思い返せば、今日は恥ずかしいとこばっかり見せちゃったね…あはは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180903,
						140180907,
						140180912
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180903,
					"content": "みんなのプレゼントについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180904
					]
				},
				{
					"id": 140180904,
					"content": "他の人は当たり前に持ってるものなのに、自分はどうしても手に入れられないものって、誰にでもあるでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180905
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180905,
					"content": "あたしにとっては、家族が全員揃った記念写真がそういうものだったんだ。小さい頃からずっと、憧れてた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180906
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180906,
					"content": "それをまさか、こんな形で叶えてもらえるなんて…へへ、あたしも、たまにはツイてることもあるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180907,
					"content": "クレメンタインについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180908
					]
				},
				{
					"id": 140180908,
					"content": "昔から思ってた…あたしが楽しく生きられるようにってママは願ってたけど、実際それはそれで、かなり大きい期待なんじゃないかなって…もしかしたらパパのよりも、応えるのが難しいかもってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180909
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180909,
					"content": "表に出てた性格は全然違うように見えて、二人は心の底からお互いを認め合ってたんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180910
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180910,
					"content": "巡水船はフォンテーヌ全体に利益をもたらす大掛かりなプロジェクトだから、「家族」の目線から考えたり、評価したりはしづらかったんだろうなって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180911
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180911,
					"content": "だからママはパパを止めなかったのかもね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180912,
					"content": "「相棒だと思ってくれてる？」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180913
					]
				},
				{
					"id": 140180913,
					"content": "ちょっとちょっと、何で急にあたしの真似なんかするわけ！？ダメダメ、それ以上言わないで！本気で恥ずかしいんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180914
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180914,
					"content": "さっさと忘れて！今すぐ忘れなさい！あっ…いやでも、完全に忘れられたらちょっと困るかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180915
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 140180915,
					"content": "と·に·か·く！心の奥底にしまって、もう二度と掘り返さないでちょうだい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				}
			]
		}
	]
}