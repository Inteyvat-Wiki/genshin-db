			},
			"dialogs": [
				{
					"id": 733350701,
					"content": "おお、やるじゃないかソルシュ！一気に周りが生き生きとしてきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733350702,
					"content": "花霊の力はとても不思議だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350703
					]
				},
				{
					"id": 733350703,
					"content": "驚くにはあたらないワ！「シューニャター花」を救うぐらい、私の偉大な能力にかかればわけないんダカラ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350704
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733350704,
					"content": "暗色の浸蝕は未だに拡大しているワ。ここの「シューニャター花」は、被害者のほんの一部にすぎないノ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350705
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733350705,
					"content": "他の花池もこの災難を免れることはできなかったみたいネ。セファーナはきっとあたふたしているに違いないワ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350706
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733350706,
					"content": "おまえの話を聞く限り、そのセファーナってやつはまじめな花の世話役みたいだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733350707,
					"content": "#{NICKNAME}、その花霊を助けてやろうぜ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733350708,
					"content": "このぐらいの功績なら、偉業の柱につけるちょっとした飾りといったところネ。我が「謁賛主」、ほかの「シューニャター花」も注意して探すのヨ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350709
					],
					"speakerTitle": "ソルシュ"
				},
				{
					"id": 733350709,
					"content": "また見つけたら教えるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350710
					]
				},
				{
					"id": 733350710,
					"content": "おう、オイラたちでかわいい花たちをいっぱい助けようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
