					}
				]
			},
			"dialogs": [
				{
					"id": 711630301,
					"content": "どうなってんだ？なんでこんなところに？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630302,
					"content": "どう？私が用意した物は、気に入ってくれた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630303,
					"content": "兹白、ここにいたのか！この傘はなんなんだ？一瞬でオイラたちをここまで運んできたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630304,
					"content": "君たちも記憶力に難があるようね。前に一緒に乗ったでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630305,
					"content": "思い出した？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630306,
					"content": "あっ！そ…そうだ！月宮の車！どおりで見覚えがあるわけだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630307,
					"content": "ふふ、私が記憶を頼りに作っただけなのだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630308,
					"content": "これも旅人が持ってきた玉符のおかげよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630309,
					"content": "なるほど！前にこいつに贈り物を作るって言ってたけど、これのことだったのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630310,
					"content": "その通り、この玉符で作った車なら君たちを目的地まで素早く運べるでしょう？旅の役に立つはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630311,
					"content": "どうぞ受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630312,
					"content": "すごいぞ…てっきり言ってみただけかと思ってたぜ。こんなに早くできるなんて、びっくりだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630313,
					"content": "実は、私もかなり手間がかかると思っていたの。この玉符は損傷が激しく、霊気も完全に失われていたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630314,
					"content": "けれど、運がいいことに、ここは沈玉の谷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630315,
					"content": "ん？沈玉の谷がどうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630316,
					"content": "私の今いる場所が沈玉の谷のどこなのか、知っている？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630317,
					"content": "うーん…遺瓏埠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630318,
					"content": "ふふ、君はまだここのことをよく知らないようね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630319,
					"content": "私たちが今立っているこの場所は、璃月の地脈が交差する重要な結節点の一つなの。そういった結節点は、全部で八つあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630320,
					"content": "生、死、休、杜、開、景、驚、傷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "逆に君は私の想像以上に、ここについて良く知っているわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630322,
					"content": "おお！オイラも思い出したぞ、地脈の八門のことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630323,
					"content": "そう、ここがその八門の一つ、大吉の門——生門の中央地帯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630324,
					"content": "生門は成長と繁栄、万物の蘇りを司る。故に私は短時間で玉符の霊気を補って、この車を作り出すことができたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630325,
					"content": "おお、そんなにすごい効果があるのか？沈玉の谷って風水が本当にいいんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630326,
					"content": "ええ…此処こそが、君たちの暮らすべき場所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630327,
					"content": "「君たち」…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630328,
					"content": "何でもないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630329,
					"content": "さあ、私の用事は済んだし、君たちは戻るといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630330,
					"content": "私はもう少し、この山の中を散策してみるつもり。ここで別れましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630331,
					"content": "ありがとう、兹白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "気にしないで。私を目覚めさせてくれたのは君なのだから、私こそ君に借りがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630333,
					"content": "ほとんどは鍾離のおかげだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "同じ言葉を、私から彼に言ったことがあったわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630335,
					"content": "彼から聞いたのだけれど、君は今、長い旅の途中だそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630336,
					"content": "次の目的地は、あの遥か遠くにある雪国？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630337,
					"content": "うん、スネージナヤだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "スネージナヤ…どのような国かはよく知らないけれど、氷と雪に覆われたその道のりは、きっと易しくないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630339,
					"content": "もし助けが必要になったら、私を訪ねるといいわ。どこにいるかは知っているわね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "兹白"
				},
				{
					"id": 711630340,
					"content": "うん。またよろしくね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "ええ、気を付けて行ってきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "兹白"
				}
			]
		}
	]
}