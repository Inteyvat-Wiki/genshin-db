			"dialogs": [
				{
					"id": 711630201,
					"content": "兹白はここにいないみたいだな。あいつが呼び出したはずなのに、どこに行っちゃったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630202,
					"content": "あれ？この傘、なんか見覚えがあるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630203,
					"content": "兹白の物かも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630204
					]
				},
				{
					"id": 711630204,
					"content": "オイラもそう思うけど…なんで傘を宿屋の入り口に置いてったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630205,
					"content": "記憶力に難があるから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630206
					]
				},
				{
					"id": 711630206,
					"content": "どうしよう…このままじゃ、いつかご飯を食べてる最中に箸が見つけられなくなっちゃうんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630207,
					"content": "はぁ…早いとこあいつを探そうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630208,
					"content": "待って…これ、傘じゃないみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630209
					]
				},
				{
					"id": 711630209,
					"content": "傘じゃないのか？うーん？もう一回じっくり見せてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 711630210,
					"content": "うわあ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7116303,
