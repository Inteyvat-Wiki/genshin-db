	"talks": [
		{
			"id": 1102002,
			"completionStepIds": [
				1102002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102002",
							"2"
						],
						"stepId": 1102002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110200201,
					"content": "ん？まさかここで会うとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200202
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200202,
					"content": "ご友人かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200203
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200203,
					"content": "#ああ、ついこの間、知り合ったんだ。{NICKNAME}は見聞が広く、博学多才でいろいろとタメになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200204
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200204,
					"content": "「歴史上の岩王帝君」について話し合っているんだが、お前も興味あるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200205
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200205,
					"content": "この方は岩王帝君の力を甘く見ているようでな、プロの考古学者として少し訂正してあげていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200206,
						110200207
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200206,
					"content": "実は彼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200208
					]
				},
				{
					"id": 110200208,
					"content": "ちょうど今、「世界最初のモラ」の話をしていたところだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200209
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200209,
					"content": "世界最初のモラ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110200210,
					"content": "岩王帝君の導きにより先人たちは鉱石を製錬し、諸国と貿易を展開したのは誰もが知っているだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200211
					],
					"speakerTitle": "逸軒"
				},
				{
					"id": 110200211,
					"content": "今の璃月には全大陸で唯一モラを製造できる権利がある。そして最初のモラは、数千年前に岩王帝君が作ったと考えられる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200212
					],
					"speakerTitle": "逸軒"
				},
				{
					"id": 110200212,
					"content": "アタシの考察…それから推測だと、この歴史的意味のあるモラは「記念品」として今も大事に保存されてると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200213
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200213,
					"content": "例えば…璃月を管理する「七星」は、就任前に秘密裏に行われる儀式があって、そこで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200214
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200214,
					"content": "いやいや、私の研究だとこの「最初のモラ」はそう単純なものではない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200215
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200215,
					"content": "ご存知の通り、モラは触媒のひとつである。今もモラを使って武器を強化する術が存在する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200216
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200216,
					"content": "世界最初のモラには強い力が秘められているはずだ。だから、今度出す私の本でこの10年間の研究成果を証明してみせようと思っている！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200217
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200217,
					"content": "ずばり——岩王帝君はそのモラを使って、刀と剣を強化したという歴史を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200218
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200218,
					"content": "刀と剣を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110200219,
					"content": "ハハッ、知りたければ私の本を買うといい。ちなみに、その刀と剣を手に入れれば璃月の王になれると言われ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200220
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200220,
					"content": "…それはどうだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200221
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200221,
					"content": "おや？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200222
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200222,
					"content": "刀剣の真相の考察は置いておくとして…モラが生まれた理由は、「契約」を結ぶための手段だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200223
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200223,
					"content": "モラを使って取引させることこそが、本意だと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200224
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200224,
					"content": "だから「最初のモラ」も、普通に通貨として使われているだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200225
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200225,
					"content": "ふむ…私は翰学殿の仮説は面白いと思う。逆に鍾離殿、なぜ証拠もなしに否定を？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200226
					],
					"speakerTitle": "逸軒"
				},
				{
					"id": 110200226,
					"content": "いや…俺はあくまで事実を述べたまでだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200227
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200227,
					"content": "私よりも岩王帝君の御心が分かると言うのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200228,
						110200229
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200228,
					"content": "実は彼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200230
					]
				},
				{
					"id": 110200230,
					"content": "歴史に関しては俺も詳しくはない。だが、意見が分かれなければ切磋琢磨もできなくなる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200231
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200231,
					"content": "では聞こう。千年前、岩王帝君が先人たちに建築の技術を教えた。その時、使われた模型は全てモラで鋳造されたものだった、そうだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200232
					],
					"speakerTitle": "逸軒"
				},
				{
					"id": 110200232,
					"content": "その通りだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200233
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200233,
					"content": "では、仮にモラに神力がないとして、なぜ岩王帝君はそんな贅沢なことをしたのだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200234
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200234,
					"content": "簡単だ。それはモラが最も手に入りやすく、最もコストのかからない材料だったからだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200235
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200235,
					"content": "うっ、うーん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200236
					],
					"speakerTitle": "翰学"
				},
				{
					"id": 110200236,
					"content": "他人事みたいに言うんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200237
					]
				},
				{
					"id": 110200237,
					"content": "ハハッ、岩王帝君の話だからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200238
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200238,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200239
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200239,
					"content": "鍾離殿！その…考古学に関してあなたに聞きたいことがあるんだけど、場所を変えて聞いてもいいかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200240
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200240,
					"content": "#ああ、構わないが、友人も一緒でいいか？{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}はきっと力になると思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200241,
						110200242
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200241,
					"content": "いいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200243
					]
				},
				{
					"id": 110200243,
					"content": "ぜひご一緒してほしいわ！さあ、行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200242,
					"content": "何やらいろいろ聞けそうだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200243
					]
				},
				{
					"id": 110200229,
					"content": "彼より分かる人はいないかと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200230
					]
				},
				{
					"id": 110200207,
					"content": "彼より分かる人はいないかと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200208
					]
				}
			]
		},
		{
			"id": 1102003,
			"completionStepIds": [
				1102003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102003",
							"2"
						],
						"stepId": 1102003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宛煙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110200301,
					"content": "これから話すことは、少し岩神に対して不敬だから…人の少ない場所の方がいいと思ってね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200302
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200302,
					"content": "鍾離殿の話は理に適っていた。多数の意見になびくことなく、非常に客観的だったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200303
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200303,
					"content": "だから、他の学者とは違う答えがもらえるかと思って…鍾離殿、岩神に殺された魔神はみんな悪だったと思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200304
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200304,
					"content": "…善悪はさておき、岩王帝君は「契約」を尊ぶ。だから殺された魔神はきっと「契約」を反故にしたはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200305
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200305,
					"content": "おう、罪もないやつを殺すなんてこと、岩王帝君はしないと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110200306,
					"content": "でも、考古学の研究をしていく中で「塩の魔神」に関する伝説を耳にしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200307
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200307,
					"content": "「塩の魔神」ヘウリア…彼女は善良な魔神だった。でも戦争でモラクスに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200308
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200308,
					"content": "モラクスに、実に不名誉な方法で…暗殺された。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200309
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200309,
					"content": "えっ？嘘だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110200310,
					"content": "…それは話せば長くなるな。真相もお前の知りたいものではないかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200311
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200311,
					"content": "構わないわ、知ってることを教えて欲しいの！ずっと…ずっとこの件を調べてきたから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200312,
						110200314
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200312,
					"content": "鍾離先生、少し困ってるみたいだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200313
					]
				},
				{
					"id": 110200313,
					"content": "いや…ただ、どこから話せばいいか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200316
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200316,
					"content": "おっ、いたいた！鍾離先生！探したぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200317,
						110200318
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200317,
					"content": "ファデュイ！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200319
					]
				},
				{
					"id": 110200319,
					"content": "武器を降ろせ！離れろ！…千岩軍に通報するぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200320
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110200320,
					"content": "武器なんか持ってないんだが！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200321
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200321,
					"content": "な、なあ…落ち着いてくれ、俺はスネージナヤから来たただの考古学研究員だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200322
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200322,
					"content": "ファデュイは信じないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110200323,
					"content": "ちゃんと璃月総務司にも報告したし、正式な許可書類も持ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200324
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200324,
					"content": "これから璃月で考古学調査を行い、その調査結果を全て総務司にも共有することになっている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200325
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200325,
					"content": "それで、往生堂の鍾離先生は物知りだと聞いて、俺の顧問になってほしく往生堂に大金を支払ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200326
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200326,
					"content": "つまりは往生堂の仕事、だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200327,
						110200328
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200327,
					"content": "どうする？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200329
					]
				},
				{
					"id": 110200329,
					"content": "仕事なら仕方ないさ。往生堂には世話になっているからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200330
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200330,
					"content": "さすが鍾離先生！じゃあ今すぐ出発しようか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200331
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200331,
					"content": "待って、アタシもついてっていい？アタシも考古学者だから役に立てるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200332
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200332,
					"content": "#では先ほどの話はまた後にしよう。そうだ、{NICKNAME}、お前も一緒に来い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200333,
						110200334
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200333,
					"content": "どうして？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200335
					]
				},
				{
					"id": 110200335,
					"content": "この先の経験はお前の力になるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200336
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200336,
					"content": "あれは七神が確立される前のこと…魔神はもういないし、お前の目標でもないが、お前の旅に少しは意味をもたらすと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200337
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200337,
					"content": "待て、これは観光じゃなくて考古学チームだ！人が多すぎる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200338
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200338,
					"content": "しかし、俺の友人には唯一無二の才能がある、かなり役に立つと思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200339
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200339,
					"content": "へえ？どんな才能だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200340
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200340,
					"content": "——宝箱を絶対に見逃さないという才能だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200341
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200341,
					"content": "オイラも得意だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200342
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 110200342,
					"content": "…確かに役に立つなぁ、許可しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200343
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200343,
					"content": "では早速、例の「渦の魔神」が群玉閣によって鎮圧された場所を見に行こう。何かあるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200344
					],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200344,
					"content": "古物や痕跡、魔神の欠片があればもっといい…とにかく、きっと何かしら収穫はあるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クリメント"
				},
				{
					"id": 110200334,
					"content": "考古学はよく分からないけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200335
					]
				},
				{
					"id": 110200328,
					"content": "慎重になった方がいいと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200329
					]
				},
				{
					"id": 110200318,
					"content": "止まれ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200319
					]
				},
				{
					"id": 110200314,
					"content": "複雑な話なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200315
					]
				},
				{
					"id": 110200315,
					"content": "ああ、どこから話せばいいか迷っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200316
					],
					"speakerTitle": "鍾離"
				}
			]
		},
