			},
			"dialogs": [
				{
					"id": 705590101,
					"content": "こんにちは！みんな、調子良さそうだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705590102,
					"content": "お気遣いありがとうございます。この数日間で大きな収穫がありましたよ。ミカ教官やエルウィン、それに栄誉騎士とパイモンさんに感謝します…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590103
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590103,
					"content": "うーん、なんだか受賞スピーチみたいになってない？でもそれでも間違いじゃないかもね。だって、トレスの成果は大成功と言っても過言じゃないんだし！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590104
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705590104,
					"content": "その通りです…騎士団の任務という観点から考えると、トレスさんの現在の測量技術は、すでに九割以上の状況に対応できるレベルに達しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590105
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705590105,
					"content": "もちろん、栄誉騎士先輩が「測量と探し物」に挑戦した時の発想がヒントになっていなければ、今回の訓練には三倍の時間がかかっていたかもしれません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590106
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705590106,
					"content": "#つまりオイラたちの連携がうまくいって、相性ぴったりってことだな！そうだろ、{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590107,
						705590108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705590107,
					"content": "今回の体験はかなり新鮮だったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590109
					]
				},
				{
					"id": 705590108,
					"content": "探し物チャレンジからもひらめきを得たよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590109
					]
				},
				{
					"id": 705590109,
					"content": "ほ、本当ですか？栄誉騎士先輩にそう言っていただけると、なんだか緊張がほぐれてきた気がします…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590110
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590110,
					"content": "僕はいつも心配してしまうんです。もしうまくできなかったら、ミカ教官が言っていたような状況になってしまうんじゃないかと——「結果が影響するのは、自分だけではありませんから」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590111
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590111,
					"content": "もう！君はもう栄誉騎士に認められたのよ…私だっていつかそんなことを言われたいわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590112
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705590112,
					"content": "エルウィンもすごいよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590113
					]
				},
				{
					"id": 705590113,
					"content": "え…えっ！？ホントですか？私が…？わ、私、その言葉を心に刻みこみます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590114
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705590114,
					"content": "…この素晴らしき日をどう祝えばいいの…ちょっと考えさせてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590115
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705590115,
					"content": "お祝いといえば、僕に考えがあるんですけど…温かくて美味しい食事以上にお祝いにふさわしいものはないと思いませんか？エルウィンは料理の腕前がすごいと聞きましたが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590116
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590116,
					"content": "え？私の料理を食べたいの？行軍中にしか作ったことがないし、いつも運が悪くて当番になってただけだけど…もちろん、まずくても構わないなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590117
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705590117,
					"content": "そんなことないでしょう？あなたの料理は騎士団でも評判だと有名ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590118
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590118,
					"content": "確かに…悪い評価は一つも聞いたことがないですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590119
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705590119,
					"content": "うわぁ！それならもっと気になるぞ！エルウィン、おまえの料理を食べさせてくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705590120,
					"content": "みんながそう言ってくれるなら、作らないわけにはいかないわね！ちょっと準備が必要だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590121
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705590121,
					"content": "みんなで一緒に食材の下ごしらえをして、臨時のかまどを組んだ。そして、エルウィンは見た目は普通でも、とても食欲をそそる香りがする料理をたくさん作った…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						705590122
					]
				},
				{
					"id": 705590123,
					"content": "ふぅ…お腹いっぱいだ！食べたら大満足できて…心も体もポカポカになる料理だったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705590124,
					"content": "オイラ、全部一口ずつ食べたから、もう飛べなくなりそうだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705590125,
					"content": "これが騎士の「拠点飯」なんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590126
					]
				},
				{
					"id": 705590126,
					"content": "#こんなに食べたの、{M#俺}{F#私}も久しぶりだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590127
					]
				},
				{
					"id": 705590127,
					"content": "雪山付近で長期間任務を遂行するために考案された料理ですからね。具材がたっぷり入っていて、カロリーも高めになっているんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590128
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705590128,
					"content": "お二人も少し休んだら、適度に運動してもいいかもしれませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590129
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705590129,
					"content": "百聞は一食に如かず、心残りは一切ありません！今後も、遊撃小隊とこんな風に協力していきたいです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590130
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590130,
					"content": "でも、お腹いっぱいになったら、もうお別れの時間なんですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590131
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590131,
					"content": "先日、同僚から手紙が届きました。次の定期訓練がもうすぐ始まるので、早めに戻るよう言われているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590132
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590132,
					"content": "今思うと、真剣に何かを学んでいる時って、本当にあっという間に時間が過ぎていくんですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590133
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590133,
					"content": "学んだ成果を試す時が来ましたね。リラックスしてください、きっとうまくいきますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590134
					],
					"speakerTitle": "ミカ"
				},
				{
					"id": 705590134,
					"content": "おめでとう、トレス！おまえはミカの訓練をやり遂げたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 705590135,
					"content": "ミカ先生の講座修了だね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705590136
					]
				},
				{
					"id": 705590136,
					"content": "全力を尽くして、ミカ教官から教わった全ての知識を今後しっかり活かしてみせます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590137
					],
					"speakerTitle": "トレス"
				},
				{
					"id": 705590137,
					"content": "君が有名になったら、私も他の人にこう言えるわ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705590138
					],
					"speakerTitle": "エルウィン"
				},
				{
					"id": 705590138,
					"content": "ねえ、あの騎士団のトレスって知ってる？彼、私と同じ測量講座のクラスメイトなんだよ、って！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エルウィン"
				}
			]
		}
	]
}