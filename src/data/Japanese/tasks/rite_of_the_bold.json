						],
						"pointId": 8923
					}
				]
			},
			"dialogs": [
				{
					"id": 750190701,
					"content": "よーし、勝ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190702,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "ふぅ…部族で最強を誇る戦士も、お前には歯が立たないだろうな…お前の勝ちだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190704,
					"content": "ハハ、ちびっ子に負かされちまった気分はどうだ。俺たちもまだまだ鍛えないといかんってこった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190705,
					"content": "グルルー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "ウチュ"
				},
				{
					"id": 750190706,
					"content": "素晴らしい勝負だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190707,
					"content": "マンク、横で感想ばかり喋ってないで、お前も戦ってみたらどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190708,
					"content": "いや、ここは遠慮させてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190709,
					"content": "#フン、つまらないやつだな。とにかく、実に気持ちのいい戦いだった。{NICKNAME}、恐れ入った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190710,
					"content": "ウォーミングアップも終わってないのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "ハハハッ、天狗になってるな？だが、その心意気は気に入った。強者は少々威張っていたって許されるものだ。じゃないと、強くなるメリットがないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190714,
					"content": "キュキュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#ハハッ、{REALNAME[ID(2)|SHOWHOST(true)]}、お前もしっかり面倒を見てもらっているようだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190716,
					"content": "#もちろんだ。{REALNAME[ID(2)|SHOWHOST(true)]}はオイラたちの仲間だからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190717,
					"content": "なら、俺も安心だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190718,
					"content": "ほら、これが族長の認めた証だ。さあ、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190719,
					"content": "たしか学名があったよな。マンク、お前が喋る番だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190720,
					"content": "ワシャクラフン·ウバ·カンの護符…「盗炎の賢者」の護符だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190721,
					"content": "その名前は覚えられそうにないが——炎の龍王が亡くなり、初代炎神が烈火から蘇った後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190722,
					"content": "「盗炎の賢者」と初代炎神が、火山から象徴物を一枚ずつ持ち去ったということは知っている。その二枚の象徴物を手に入れた者は、火山の中にある浄火に入ることで、あらゆる呪いや災厄を祓うことができるという。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190723,
					"content": "それにしても、「盗炎の賢者」は一体どれだけ生きていたんだ、マンク？たしか「部族」の時代から、オシカ·ナタや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190724,
					"content": "「陰縫いの針」にまで、その伝説が残っているだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190725,
					"content": "何しろ、初めて燃素の使い方を身につけた人間だからな…伝説に登場するほどの人物ともなれば、どんなことも可能なのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190726,
					"content": "一説によれば、彼の肉体…そして魂までもが燃素と化し、ナタの風、大地、花と一体となって、部族の人々の祈りを聞き入れてくれているそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190727,
					"content": "一方で、「盗炎の賢者」の名を受け継ぐ者がいて、それは代々受け継がれている…という説もある。この時代にも継承者がいるという噂もあるほどだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190728,
					"content": "だが、正直なところ…ほとんどは物語を語る側の憶測だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190729,
					"content": "ハハッ、ティトゥが聞いたらまた怒るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190730,
					"content": "さて、俺の出番はここまでだ…おっと、忘れるところだった。伝統と慣例に従って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190731,
					"content": "旅に出る勇者とその仲間に祝福を捧げないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190732,
					"content": "キュ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "へえ、そんな儀式もあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190734,
					"content": "ま、一種のゲン担ぎみたいなもんさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190735,
					"content": "#では、{NICKNAME}、そして{REALNAME[ID(2)|SHOWHOST(true)]}よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190736,
					"content": "はい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "最も丈夫な翼を持つ鳥のように、山を越え——\\n最も頑丈な石のように、荒波に立ち向かうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190739,
					"content": "世は数多の危険と苦難に満ちているが、恐れずに乗り越えてゆけ。\\nいずれ別れは訪れるものだが、いつまでも互いのことを忘れてはならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190740,
					"content": "お前たちが目指す地にたどり着き、願いを叶えられることを…何より、無事に帰ってこられることを、心から祈っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190741,
					"content": "頑張る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "えっ、オイラにはなにもないのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190744,
					"content": "おっと、パイモンには…お腹いっぱい食べて、ぐっすり寝て、健やかに育つことができるよう祈ってやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190745,
					"content": "よかったね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "へへ、しょうがないな。祝福を受け取ってやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190749,
					"content": "ああ、これで見届け人の儀式は終わりだ。くれぐれも気を付けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190750,
					"content": "おう！じゃ行ってくるぜ。パカル…それとウチュもまたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190751,
					"content": "クルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "グル…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "ウチュ"
				},
				{
					"id": 750190753,
					"content": "じゃあな。健闘を祈る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190746,
					"content": "パイモンって、まだ育つの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "当たり前だ！いつか三つの山くらいデカくなってやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190712,
					"content": "いい勝負だったよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "情けは無用だ。だが、俺がもう少し若ければ…結果は違ったかもしれないぞ。はぁ、もっと若かった頃にお前と勝負したかったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "パカル"
				}
			]
