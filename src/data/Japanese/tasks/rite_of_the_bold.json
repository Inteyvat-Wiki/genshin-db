					"マンク"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750190601,
					"content": "#無礼を承知で言わせてもらう…{NICKNAME}、君の実力は知っているが、くれぐれも用心してくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190602,
					"content": "パカルは「古名」こそ授からなかったが、確かな実力の持ち主だ…ここ数年トレーニングを怠っていなければの話だがな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190603,
					"content": "準備ができたら、始めていいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マンク"
				}
			]
		},
		{
			"id": 7501907,
