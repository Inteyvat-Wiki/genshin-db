			"dialogs": [
				{
					"id": 750190301,
					"content": "…どうしてもだめか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190302
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190302,
					"content": "あのな、マンク…ティトゥから聞かなかったか？もう五百年近く、誰もそんなことはやっていないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190303
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190303,
					"content": "入り口を見つけたと言われても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190304
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190304,
					"content": "それがどうした？って感じだ。歴史上、その道を歩んだやつやその仲間は、誰も帰ってこなかった。いいか？——「誰一人」帰ってこなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190305
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190305,
					"content": "ふむ…率直に言わせてもらおう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190306
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190306,
					"content": "龍の遺物研究会のあいつだ。隣にいるのは、「こだまの子」の族長か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190307,
					"content": "おーい、遺物研究会のやつ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190308,
					"content": "#{NICKNAME}…パイモン、それに{REALNAME[ID(2)|SHOWHOST(true)]}も。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190309
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190309,
					"content": "クルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190310,
					"content": "おおっ、しっぽに赤いスカーフがついてるテペトル竜か…元気だな！何というか、ひと味違う雰囲気じゃないか。よしよし、もう一回やってみろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190311
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190311,
					"content": "クルルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190312,
					"content": "#悪くない。お前が{REALNAME[ID(2)|SHOWHOST(true)]}か。じゃあ、そこの二人が{REALNAME[ID(2)|SHOWHOST(true)]}の選んだ勇者だな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190313
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190313,
					"content": "#{NICKNAME}にパイモン、最近よく聞く名前だな…マンクだけじゃなくて、ティトゥも集落に戻ったときに言っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190314
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190314,
					"content": "お前たちの功績は、もはや「伝説」みたいなもんだ。うちの仔竜たちもお世話になっているようじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190315,
						750190316
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190315,
					"content": "それほどでも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				},
				{
					"id": 750190317,
					"content": "ハハッ、立派な若者だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190318
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190318,
					"content": "マンク、お前の考えを検証するには、この二人を危険な目に遭わせなきゃならん。それはうちの「おもてなし」の道に反するぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190319
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190319,
					"content": "少なくとも俺はそうしたくない。そんなことは、できない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190320
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190320,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190321
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190321,
					"content": "なんの話をしてるんだ？危険ってなんのことだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190322,
					"content": "すまない。俺が説明しよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190323
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190323,
					"content": "「焔の主の祝福」の印を消すには、二つの象徴物を持って火山に行かなければならないと言っただろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190324
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190324,
					"content": "その一つは、こだまの子の外にある遺跡に残されている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190325
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190325,
					"content": "ただ、そこに入るには条件がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190326
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190326,
					"content": "慣例じゃ——もちろん、ウォーベンを調べて分かった限り、だが——長い間、誰もこんなことをしようとしてこなかったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190327
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190327,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190328
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190328,
					"content": "竜の仲間を火山に連れて行って、「焔の主の祝福」を洗い流すには、部族の族長の許可を得なければならない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190329
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190329,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190330
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190330,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190331
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190331,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190332,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}はテペトル竜だから、「こだまの子」の族長の承認が必要なわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190333
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190333,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190334,
					"content": "キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190335,
					"content": "つまり、パカルの承認が必要ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190336
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190336,
					"content": "#その通りだ。正直、このしきたりが部族以外の人間にも有効なのかどうかは、俺にも分からないがな。しかし{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190337
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190337,
					"content": "ここ数百年間、竜の仲間たちの血に刻まれた…呪いのようなものから解放してやりたいと思った勇者は大勢いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190338
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190338,
					"content": "でも、誰一人成功しなかった…これも、部族の者たちがこれをやらなくなった理由だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190339
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190339,
					"content": "えっ、誰も成功しなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190340,
					"content": "ああ、それほど危険なことなんだ。それに、象徴物を得るための試練では、勇者だけでなく、仲間の竜も試される…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190341
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190341,
					"content": "お前たちは部族の人間じゃないが、無駄死にはしてほしくない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190342
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190342,
					"content": "#だから{NICKNAME}、やっぱり{REALNAME[ID(2)|SHOWHOST(true)]}をこだまの子に残していってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190343
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190343,
					"content": "少なくとも俺は、そいつが夜神の国に入るまで、ちゃんと世話をすると保証できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190344
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190344,
					"content": "で、でもそうしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190345,
					"content": "#…前にも言ったように、{REALNAME[ID(2)|SHOWHOST(true)]}は…大きくなれないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190346
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190346,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190347,
					"content": "嫌がってるみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190348
					]
				},
				{
					"id": 750190348,
					"content": "やれるだけやってみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190349
					]
				},
				{
					"id": 750190349,
					"content": "危険だと知ってもか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190350
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190350,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190351
					]
				},
				{
					"id": 750190351,
					"content": "お前はどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190352
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190352,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190353
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190353,
					"content": "ハハハ、いいぞ。その揺るぎない目、心の中にある熱い炎を感じさせてくれる。燃素岩みたいな、いいやつらだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190354
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190354,
					"content": "いいだろう。火山の巡礼に行く資格があると認めてやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190355
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190355,
					"content": "クルル！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190356
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190356,
					"content": "やった。じゃあ、さっそく一つ目の象徴物を探しに行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190357
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190357,
					"content": "いや、ちょっと待て。資格を得た後は、見届け人の試練に挑戦する必要がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190358
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190358,
					"content": "古いしきたりでは、勇者と竜は森の奥にあるケツァールの羽を取り、十二の獣の皮を捧げ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190359
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190359,
					"content": "共に部族のために五十回の戦いに勝利し、九十六個の良質な宝石を捧げなければならないという…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190360,
						750190361
					],
					"speakerTitle": "マンク"
				},
				{
					"id": 750190360,
					"content": "#{M#俺}{F#私}には資格がないみたい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190362,
					"content": "もういい。マンク、それはいつの時代の話だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190363
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190363,
					"content": "あんなのはそもそも、竜と人がどこまで手を取り合えるか試し、腕を磨くための細かいルールでしかない——俺はもううんざりだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190364
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190364,
					"content": "#それに見ろ。{NICKNAME}と{REALNAME[ID(2)|SHOWHOST(true)]}の関係は、あんなもので証明する必要なんてない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190365
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190365,
					"content": "#もっと簡単な方法で行こう…{NICKNAME}、ナタではこういう状況に遭遇した時、一番手っ取り早い方法を取るんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190366
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190366,
					"content": "俺と戦って、お前たちの実力を証明してみろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190367
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190367,
					"content": "どんなものか見せてあげる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190368
					]
				},
				{
					"id": 750190368,
					"content": "キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190369
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190369,
					"content": "えっ、ここで戦うのか？…それとも、舞台の上でか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190370
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750190370,
					"content": "いやいや、ハハッ。舞台の上じゃ、潜れないだろう？こだまの子の決闘場は裏山にあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190371
					],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190371,
					"content": "さあ、裏山に行って思いっきり戦おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パカル"
				},
				{
					"id": 750190361,
					"content": "モラじゃだめ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190316,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				}
			]
		},
		{
			"id": 7501906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
