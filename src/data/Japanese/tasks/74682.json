			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ランジット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "遂にこの日が来たか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820102,
					"content": "子供の頃のあの夢はどうなった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "大人になってからようやく、当時レンジャー長が難しい顔をしていた理由が分かったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820104,
					"content": "コホン…とにかく、少なくとも試しはした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820105,
					"content": "それに、未加工の爆炎樹の実を持ってマッシュラプトルに近づいてはいけないことも思い知らされたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820106,
					"content": "焦げた匂いを嗅いだ時にはもう遅かった。危うくやつがばらまく胞子に呑み込まれるところだったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820107,
					"content": "キノコンとキノシシはまったく違う種だっていうのにね、それをつい忘れてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820108,
					"content": "たしかに。そういえばキノコンって、キノコ類なんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746820109,
					"content": "ああ。スープに入れると、これまた美味しくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820110,
					"content": "あー…えっと、やっぱり今日の挑戦相手の話に戻そうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746820111,
					"content": "どう料理するかはまだ…おっと！そうだ、「交渉」の話だったね。失礼した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820112,
					"content": "原海アベラントの頂点に立つ、二つの覇者の物語を聞いたことはあるだろうか？物語では、千年真珠の海駿を描写する際、「孤高」や「高潔」といった言葉がよく使われてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820113,
					"content": "それに比べて、鉄甲熔炎帝王は名前からして厄介そうだ。強くて乱暴な感じがするだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820114,
					"content": "なんだ。てっきり強いほうを選ぶと思ってたぜ。前に「冒険譚を語るなら、やはりそれなりに手ごわい相手を選ばないと」って言ってたし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746820115,
					"content": "鉄甲熔炎帝王は確かに強いが、しょせんは重甲ヤドカニ。それに比べて、千年真珠の海駿は飛べる海{RUBY#[D]タツノコ}馬だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820116,
					"content": "だったら、天馬と呼ぶべきかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "いや、気になるのはそこかよ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746820119,
					"content": "とにかく、あれに一度またがることができたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820120,
					"content": "わかったよ。考えを変えるつもりはないってことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 746820121,
					"content": "せっかく来たんだ、何もせずに帰るわけにはいかないだろ？準備ができたら、さっそく出発しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820122,
					"content": "準備できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "他に用事があるから、またあとで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "ああ。じゃあ、ここで待ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ランジット"
				},
				{
					"id": 746820118,
					"content": "#{M#俺}{F#私}からすると大差はない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}