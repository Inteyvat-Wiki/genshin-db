				]
			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "おおっ、勇者たちよ！「北風に乗って」に挑戦しに来たのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740102,
					"content": "さっそく案内しよう！君たちなら、誰より立派に飛べそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740103,
					"content": "落ち着いて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "飛ぶときに、冷静さを保つ必要なんかないさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740106,
					"content": "冷静になればなるほど、風の感覚が鈍る。いきなり強風に立ち向かってこそ、秘めた能力を発揮できるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740107,
					"content": "今時のモモンガたちはガッツがなさすぎる！『勇敢な北風』の教えを完全に忘れちまってる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740108,
					"content": "安全な場所から、風に舞う葉っぱを眺めながらその勇気を称えるばかりで、自分からその風の中に足を踏み入れる勇気なんてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740109,
					"content": "このままじゃ、プリンセスとともに王国を守ることなんて、絶対できやしないっつーの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740110,
					"content": "やたら元気なモモンガだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790740111,
					"content": "飛ぶのが大好きなんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "ああ。それで強風が通る風の通り道を見定めて、それに沿って色んな装置を置いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740113,
					"content": "最も勇敢で飛行術に長けた度胸ある者だけが完走できるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740114,
					"content": "さて、君たちに勇気はあるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740115,
					"content": "試してみたい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "いい答えだ！「風道」はすぐそこだ。ついて来てくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740117,
					"content": "えっと…他に用事があって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "準備がいるのか？分かった、ここで待ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740119,
					"content": "挑戦したくなったら、俺のところに来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "クランシェ"
				},
				{
					"id": 790740104,
					"content": "まだ一言もしゃべってないよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}