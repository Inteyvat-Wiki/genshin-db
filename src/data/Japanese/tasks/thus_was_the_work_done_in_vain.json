			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790130201,
					"content": "うん、たしかに鳥肉のスイートフラワー漬け焼きはうまいよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130202,
					"content": "この「ウォルフガング」って冒険者が食べたがってる気持ちもわかるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130203,
					"content": "でもかわいそうに、ここに閉じ込められたままじゃあ、鳥肉のスイートフラワー漬け焼きなんか食べられないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130204,
						790130205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130204,
					"content": "このノートはだいぶ古い…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				},
				{
					"id": 790130206,
					"content": "#そっか、そうだよな…あ、そういえば…{NICKNAME}、島の池みたいなところから、もう片方の島に行けたのを覚えてるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130217,
					"content": "池の中の島にある建物は、外にあるものよりだいぶしっかりしてるみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130218,
					"content": "あっちに比べると、こっちの島の建物はまるで廃墟みたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130219,
						790130220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130219,
					"content": "池の中の建物って、もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130221,
					"content": "たしかに！池の中の建物こそ、外にある廃墟の本来の姿なのかもしれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130222,
					"content": "#{NICKNAME}、もしかしたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130223,
					"content": "池の中の島って、かつての島の姿なんじゃ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130224
					]
				},
				{
					"id": 790130224,
					"content": "きっとそうだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130207,
					"content": "それに、ほら…この前の密室がどこにあるかわかれば、こいつを助けられるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130208,
						790130209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130208,
					"content": "幻境の影響下で起こったことだから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130210,
					"content": "でも…たとえ全部が嘘で、実際はこんな冒険者がいなかったとしても…かわいそうだから助けてやりたいんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130211,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130212,
						790130214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130212,
					"content": "うん、パイモンの言う通りだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130213
					]
				},
				{
					"id": 790130213,
					"content": "#へへ！{NICKNAME}ならそう言ってくれると思ってたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130216,
					"content": "さっそく池の中の島に行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130214,
					"content": "じゃあ、見に行こう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130215
					]
				},
				{
					"id": 790130215,
					"content": "おう。冒険者「ウォルフガング」を助けに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790130216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790130209,
					"content": "この現状は変えられない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130210
					]
				},
				{
					"id": 790130220,
					"content": "池の中のほうが本来の姿なのかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130221
					]
				},
				{
					"id": 790130205,
					"content": "遥か昔の出来事だと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790130206
					]
				}
			]
		},
