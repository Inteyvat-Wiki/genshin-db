			"dialogs": [
				{
					"id": 790131801,
					"content": "（刻まれた古い痕。このような内容が記されている…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131802
					],
					"speakerTitle": "刻まれた痕"
				},
				{
					"id": 790131802,
					"content": "「風が強いから、ノートは使わないでおく。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131803
					],
					"speakerTitle": "刻まれた痕"
				},
				{
					"id": 790131803,
					"content": "「ここの朝日は実に美しい。数々の困難を乗り越えて、辿り着いた甲斐があったというものだ。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131804
					],
					"speakerTitle": "刻まれた痕"
				},
				{
					"id": 790131804,
					"content": "「いつか、オレの他にもこの景色を見に来るやつがいるんだろうか。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131805
					],
					"speakerTitle": "刻まれた痕"
				},
				{
					"id": 790131805,
					"content": "「…これほどの困難を乗り越えたんだ。次はドラゴンスパインに行くぞ！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131806
					],
					"speakerTitle": "刻まれた痕"
				},
				{
					"id": 790131806,
					"content": "「ここは本当に最高だ。だが、今ここに鳥肉のスイートフラワー漬け焼きがないのが残念でしかたない…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131807
					],
					"speakerTitle": "刻まれた痕"
				},
				{
					"id": 790131807,
					"content": "「ウォルフガングより」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "刻まれた痕"
				}
			]
		},
		{
