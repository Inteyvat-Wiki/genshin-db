			"dialogs": [
				{
					"id": 790131101,
					"content": "扉が開いたぞ！この装置、面倒だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131102,
					"content": "ここにはウォルフガングのノートがないみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131103,
					"content": "つまり、彼はまだここを訪れていない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131104
					]
				},
				{
					"id": 790131104,
					"content": "オイラたち、事前に密室を開けてやれたってことだよな…これなら、あいつも閉じ込められずに済むぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131105,
						790131106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131105,
					"content": "この装置が何度も起動するタイプだったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				},
				{
					"id": 790131107,
					"content": "うーん、どうしたらいいんだ…あっ！それなら、あいつにメッセージを残そうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131108,
					"content": "わかりやすいところにメッセージを刻んで、装置の解除方法を教えてやればいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131106,
					"content": "一度だけ解除しても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131107
					]
				}
			]
		},
