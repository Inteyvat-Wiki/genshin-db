				"points": []
			},
			"dialogs": [
				{
					"id": 790131901,
					"content": "ノートがなかったのは、メッセージを柱に刻んだからだったんだな…どうやら無事にここまで辿りついたみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131902,
					"content": "でも、こいつの自信はいったいどこから来るんだ…オイラたちの助けがなかったら、密室に閉じ込められたままだったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131903
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131903,
					"content": "雪山になんか行った日には、きっと「冷製鮮肉」になっちゃうぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131904,
						790131906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131904,
					"content": "「冷製鮮肉」はさすがにひどい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131905
					]
				},
				{
					"id": 790131905,
					"content": "え、えーと、つまり雪山に行ったりしたら危ない目に遭うってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131908
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131908,
					"content": "雪山には行かないよう、あいつに忠告しないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131909,
					"content": "じゃあ、もう一回メッセージを残そう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131910
					]
				},
				{
					"id": 790131910,
					"content": "おう、それがいいな…そうだ、今回も鳥肉のスイートフラワー漬け焼きを作ろうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131911,
