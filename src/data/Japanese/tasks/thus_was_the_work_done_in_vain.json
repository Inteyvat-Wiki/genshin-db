					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790131601,
					"content": "なんだよ、こいつ、かっこつけちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131602,
					"content": "仕方ない、オイラたちも雪山に行かないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131603,
						790131604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131603,
					"content": "幻境を変化させても、過去は変わらない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				},
				{
					"id": 790131605,
					"content": "…あ…そうだよな。金リンゴ群島全体があの装置の影響を受けてるから、ウォルフガングは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131606,
					"content": "オイラ、ウォルフガングをあの密室から救い出したと思ってたけど…本当は最初の密室から出られてないんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131607,
					"content": "でも！「ウォルフガング」ってやつ、やっぱムカつくよな…こんなに助けてやったのに、「他の人のために罠にはまる」のをいいことだと思うなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131608,
					"content": "もっと、自分の命を大事にしてほしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131609,
						790131610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131609,
					"content": "追い求めるものは人それぞれだから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131611,
					"content": "うぅ、そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131612,
					"content": "それでも、やっぱりもう少しいい結末を迎えてほしいぞ。たとえばモンドに戻って偉大な冒険者になるとか…レストランで猫と遊んだり、鳥肉のスイートフラワー漬け焼きをたらふく食べたり…とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131613,
					"content": "なんで、そういう結末を迎えられないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790131610,
					"content": "彼らみたいな人がいたからこそ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131611
					]
				},
				{
					"id": 790131604,
					"content": "「ウォルフガング」は雪山に辿り着けない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790131605
					]
				}
			]
		},
