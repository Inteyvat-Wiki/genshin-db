			"dialogs": [
				{
					"id": 790131201,
					"content": "ここなら目立つな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131202
					],
					"speakerTitle": "メッセージ"
				},
				{
					"id": 790131202,
					"content": "ウォルフガング、どうかこれを見て、この密室に入らないようにしてくれよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790131203
					],
					"speakerTitle": "メッセージ"
				},
				{
					"id": 790131203,
					"content": "戻って確認してみようぜ。ノートに新たな変化が現れてるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
