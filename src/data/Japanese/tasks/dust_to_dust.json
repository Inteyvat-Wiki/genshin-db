			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "やっと戻ってきた。絶雲の間はどうだったかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031802,
					"content": "…なるほど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031806,
					"content": "全ての仙人に会えなかったのは…彼らの言い方だと「縁がなかった」ということだね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031807,
					"content": "大丈夫！また時間があったら、行ってみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031808,
					"content": "それに降魔大聖の情報だけでも十分価値がある。お礼に、君にいい情報を教えてあげよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031809,
					"content": "神の死に対して、璃月七星の反応がとても興味深くてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031810,
					"content": "真犯人が捕まらない限り「仙祖の亡骸」を目にすることは許さないと、彼らが公言したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031811,
					"content": "その上、情報を封じようとしている…けど儀式を見に行った人はたくさんいたし、たとえ七星でも噂を止めることはできないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031812,
					"content": "仙祖の亡骸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10031813,
					"content": "璃月の通説では、岩王帝君も仙人だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031814,
					"content": "岩神は契約の神であり、仙人たちの祖とも呼ばれているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031815,
					"content": "全ての「三眼五顕仙人」は、過去に璃月を守る契約を結んでいるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031816,
					"content": "そうか…どうりで璃月のことになるとすぐに動いたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10031817,
					"content": "その通り。彼らには責任も、その資格もある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031818,
					"content": "——もし璃月を管理する七星に問題があったら、それを非難する資格がね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031820,
					"content": "こっちにとってかなり迷惑だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "そんなやり方は受け入れられない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "岩神の魂が天に召されたとして、その亡骸をなぜ七星が隠そうとする？どう考えても疑わしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031822,
					"content": "あっ、そうだよ！オイラたちはあの神に会いに来たんだった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10031823,
					"content": "もし璃月七星が「仙祖の亡骸」を隠してて、誰も近づけさせないなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10031824,
					"content": "#{NICKNAME}が七神を訪ねるっていう目標が叶わなくなる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10031826,
					"content": "そっちとは関係がない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "ノーコメント。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "ん？七神を訪ねる？それはまたどうして？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031828,
					"content": "ふふっ…いい答えだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031829,
					"content": "いとも簡単に「ファデュイ」に騙されるような騎士では、いい騎士とは呼べない、そうだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031830,
					"content": "でも…今回に限っては君を助けることができるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031831,
					"content": "えっ？本当か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10031832,
					"content": "少し時間が欲しい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031833,
					"content": "人探しする時間がね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031834,
					"content": "この行き詰った状況を打破してくれる人を、見つけてくるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031835,
					"content": "ああ…面白い。この布局の段階で平静を保っていられるほど、最終的に訪れる混乱は激しくなる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10031836,
					"content": "この目で決壊する暗流を見るために、俺と再会するまでどうか生きていてくれよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				}
			]
		},
