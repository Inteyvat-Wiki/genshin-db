			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201501,
					"content": "どうだ、全部終わったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201502
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718201502,
					"content": "終わった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201503
					]
				},
				{
					"id": 718201503,
					"content": "ありがとう、本当に助かったよ。お客さんを待たせちゃ悪いから、さっさと料理を完成させないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
		{
			"id": 7182016,
			"completionStepIds": [
				7182016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182016",
							"2"
						],
						"stepId": 7182016,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴェル·ゴレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201601,
					"content": "おかえりなさい、言笑の方は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201602
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718201602,
					"content": "少し楽になったみたいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201603
					]
				},
				{
					"id": 718201603,
					"content": "よかったわ…手伝ってくれてありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201604
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718201604,
					"content": "ここにもいないわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201605,
						718201606
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201605,
					"content": "望雅さん？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				},
				{
					"id": 718201607,
					"content": "あら、旅人。ここで会えるなんて、奇遇ね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201608
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201608,
					"content": "霄灯送り…そうとも言えるわね。軽策荘は知ってる？璃月港から離れていて、お年寄りと子供ばかりが住んでいる所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201609
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201609,
					"content": "毎年海灯祭になると、総務司が人手を手配して、祭り用の物資を届けるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201610
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201610,
					"content": "物資はもう届けたけど、祭りの雰囲気を作り上げるために、もう少し何かしてあげたいと思って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201611
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201611,
					"content": "だから、詩人の清昼に、軽策荘の子供たちと灯謎遊びをしてもらえないか頼んだの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201612,
						718201613
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201612,
					"content": "清昼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201614,
					"content": "あの大詩人に任せれば心配ないわね。それと、お年寄りのために、霄灯に付け加える字を伯桓に頼もうと思ってるの。彼の字はなかなかのものだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201615
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201615,
					"content": "でも、どこに行っても伯桓が見つからないのよ。荻花洲に取材に来てるって聞いたから、ここで探してるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201616,
						718201617
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201616,
					"content": "オーナーなら知ってるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201618,
					"content": "伯桓？確かに…最近ここに来たわね。近くで取材をするって言ってたような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201619
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718201619,
					"content": "でもあの一帯は魔物が多いから、本当にそこにいるかどうかまでは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201620
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718201620,
					"content": "そう…直接行って確かめてみたいけど…私は清昼と望舒旅館で会う約束をしてるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201621
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201621,
					"content": "旅人、私の代わりに伯桓を探してきてくれないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201622
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201622,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201623
					]
				},
				{
					"id": 718201623,
					"content": "じゃあお願いね。私はここで清昼を待ってるわ。もう少し彼に用事を頼みたいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201624
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201624,
					"content": "もう…やることが多すぎるわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				},
				{
					"id": 718201617,
					"content": "オーナー、伯桓について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201618
					]
				},
				{
					"id": 718201613,
					"content": "（あれ、フェルメールとの約束は…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201614
					]
				},
				{
					"id": 718201606,
					"content": "「霄灯送り」に来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201607
					]
				}
			]
		},
		{
			"id": 7182019,
			"completionStepIds": [
				7182019
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
