			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯桓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718201901,
					"content": "ありがとう…はぁ…危ないところだったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201902
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201902,
					"content": "ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201903
					]
				},
				{
					"id": 718201903,
					"content": "ここで取材してたんだ。ほら、今海灯祭でしょ？だから友達のために、綺麗な字を何枚か書いて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201904
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201904,
					"content": "元々ここへは、特殊な墨汁を作るための材料を探しに来たんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201905
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201905,
					"content": "それがまさか魔物に出くわすなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201906
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201906,
					"content": "望雅さんの頼み事について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201907
					]
				},
				{
					"id": 718201907,
					"content": "軽策荘の人たちに字を…いいよ、任せて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201908
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201908,
					"content": "軽策荘…確かお年寄りの人がたくさんいたな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201909
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201909,
					"content": "そうだ、石珀を1つと清心を1つ集めてきてくれる？僕は墨汁を作りに行くから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201910
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201910,
					"content": "そんなので…墨汁ができるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201911
					]
				},
				{
					"id": 718201911,
					"content": "はははっ、知らなかったでしょ。石珀の粉を墨汁に入れると、書き出された字が金色がかって凄くめでたいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201912
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201912,
					"content": "清心を墨汁に入れると、とてもいい香りを放つ。墨汁の質が良ければ、一段と上品な香りになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201913,
						718201914
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201913,
					"content": "す、すごく専門的だ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				},
				{
					"id": 718201915,
					"content": "なんてことないよ。本物の専門家が作る墨汁は、もっと手が込んでるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201916
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201916,
					"content": "今回は簡単なものでいいよ。集め終わったら僕に渡してね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718201917
					],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201917,
					"content": "さて…僕は少し休憩するよ、さっきので疲れちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯桓"
				},
				{
					"id": 718201914,
					"content": "そんなに面倒なの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718201915
					]
				}
			]
		},
