				{
					"id": 718202101,
					"content": "伯桓は見つけた？なんて言ってたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202102
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718202102,
					"content": "同意してくれた、あとで来る。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718202103
					]
				},
				{
					"id": 718202103,
					"content": "良かった。私もさっき清昼に会ったわ。考え事をするって言って、眉をひそめながら出て行ったけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202104
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718202104,
					"content": "旅人、手伝ってくれてありがとう。私は伯桓と詳しいことについて話さないといけないから、ここで彼を待つことにするわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202105
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718202105,
					"content": "それから璃月港に戻って、他の用事を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202106
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718202106,
					"content": "どうやら、望舒旅館と璃月港の間を往復することになりそうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202107
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718202107,
					"content": "雑用が終わったら私も軽策荘に行くから、もし良かったらあなたも来てね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718202108
					],
					"speakerTitle": "望雅"
				},
				{
					"id": 718202108,
					"content": "はぁ、雑用仕事を早く終わらせなきゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "望雅"
				}
			]
		},
