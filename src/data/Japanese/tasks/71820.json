			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヴェル·ゴレット"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200201,
					"content": "やっぱり祭りの時は忙しいわね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200202
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718200202,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200203
					]
				},
				{
					"id": 718200203,
					"content": "旅館のことよ。みんな家に帰って海灯祭を過ごしてるから、人手が足りないのよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200204
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718200204,
					"content": "お客さんに対応したり、旅館を掃除したり…祭りの物も用意しないといけなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200205
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718200205,
					"content": "普段やってることも疎かにできないし…もう言笑もへとへとよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200206
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718200206,
					"content": "旅人、もしよかったら、言笑の手伝いをしてくれるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200207
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718200207,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200208
					]
				},
				{
					"id": 718200208,
					"content": "それじゃあ頼んだわね。言笑は厨房にいるから、直接行くといいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200209
					],
					"speakerTitle": "ヴェル·ゴレット"
				},
				{
					"id": 718200209,
					"content": "私は他の事を片付けないと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴェル·ゴレット"
				}
			]
		},
		{
			"id": 7182003,
			"completionStepIds": [
				7182003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182003",
							"2"
						],
						"stepId": 7182003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718200301,
					"content": "誰だ！勝手に入る…おう、お前か…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200302,
					"content": "何か用か？注文なら少し待ってくれ、今忙しいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200303,
						718200304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200303,
					"content": "手伝いに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				},
				{
					"id": 718200305,
					"content": "手伝いに来たのか？それは…助かる。今やることが山ほどあるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200306
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200306,
					"content": "まずは旅館の下に行って、さっき届いた食材を持ってきてくれ、今すぐ使わないといけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718200307
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200307,
					"content": "それから、霄灯を旅館の入り口にある2つの木の上に掛けてくれないか…支配人にずっと言われててな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 718200304,
					"content": "何か手伝うことはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718200305
					]
				}
			]
		},
		{
			"id": 7182015,
			"completionStepIds": [
				7182015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182015",
							"2"
						],
						"stepId": 7182015,
						"stateName": "QUEST_STATE_UNFINISHED"
