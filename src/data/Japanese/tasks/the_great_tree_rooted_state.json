			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヤスミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280501,
					"content": "ヤスミン姉ちゃんだ！うわーっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "い、息ができない！早くここを出よう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "なんだこれ…ゲホッ、ゲホゲホ！なんて臭いだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230280504,
					"content": "ラドプの仕事が上手くいったようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280505,
					"content": "ここはもう撒き終わったので、次の場所へ行きましょう。すぐ近くですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤスミン"
				}
			]
		}
	]
