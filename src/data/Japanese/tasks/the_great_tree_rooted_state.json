			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ヤスミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "旅人さん、いいところに。助けが必要だったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280102,
					"content": "聖樹の根に問題が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "聖樹の状況はすべて正常です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280104,
					"content": "そして私のすべき仕事は、その正常な状態を保つことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280105,
					"content": "具体的には、この薬を聖樹の根の周りに撒くくことなんですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280106,
					"content": "こんなにたくさんの薬、私一人では運べません。ラドプとファルシも、仕事に追われて手伝ってくれませんし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280107,
					"content": "だから、この薬を運ぶのを手伝ってほしいんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280108,
					"content": "ラドプとファルシって…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "私と同じ学生ですが、ラドプはスパンタマッド学院に、ファルシはクシャレワー学院に属しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280110,
					"content": "私たちには共通の課題があり、それぞれの理念は違いますが、今は協力しています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280111,
					"content": "この薬は、私たちの協力の成果です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280113,
					"content": "ええ、私はこの缶を運びますから、残りをお願いします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280114,
					"content": "運ぶ時は気を付けてくださいね。ラドプによると、人が誤って飲まないように、薬をとても臭くしたそうですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280115,
					"content": "薬が服にでも付いたら、しばらくは臭いが洗っても取れませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280112,
					"content": "それじゃあ出発しよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
