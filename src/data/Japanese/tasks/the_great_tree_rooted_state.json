			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アワン",
					"ヤスミン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "ヤスミン？どうしてここに…あっ、またその薬を撒きに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "アワン"
				},
				{
					"id": 230280402,
					"content": "もうその薬を撒かないでもらえないか？その根は正常に見えるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "アワン"
				},
				{
					"id": 230280403,
					"content": "そうだとしても、心を込めてお世話を続けなければなりません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280404,
					"content": "問題が起きてから対策を練るのは、フィッシュロールを作る時に、生地を巻いてから魚肉が生だったと気づくようなものです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280405,
					"content": "一から作り直すにせよ、巻いた生地を剥がすにせよ、どちらも面倒なことです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280406,
					"content": "あまり言いたくないが…前回もその薬の臭いについて話しただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "アワン"
				},
				{
					"id": 230280407,
					"content": "この近くに住む者としては、その臭いを嗅ぎながら眠りたくないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "アワン"
				},
				{
					"id": 230280408,
					"content": "安心してください。もうラドプに薬の処方を変更させました。臭いはもう刺激的ではありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280409,
					"content": "はぁ、分かった。もう帰るが…うちの庭でその薬を撒かないでくれ。絶対に耐えらないから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "アワン"
				},
				{
					"id": 230280410,
					"content": "はいはい、分かりました。旅人さん、その箱の中の薬をください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280411,
					"content": "ヤスミンと一緒に薬を撒いた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "うえっ…この薬、ひどい臭いだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230280413,
					"content": "#{M#君}{F#あなた}は何も感じないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "臭いのことを言っているなら…私はこれよりもっとくさいものにたくさん触れてきましたからね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280415,
					"content": "これでよし。データもたくさん採れましたから、ファルシもきっと喜ぶでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280416,
					"content": "これは報酬です。旅人さん、お手伝いありがとうございました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "ヤスミン"
				},
				{
					"id": 230280417,
					"content": "ラドプとファルシの仕事はどうなったかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヤスミン"
				}
			]
		},
