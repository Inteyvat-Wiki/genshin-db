			},
			"dialogs": [
				{
					"id": 3540401,
					"content": "風神のご加護があらんことを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540402,
					"content": "わたしは西{RUBY#[D]セピュロス}風騎士団の偵察騎士、アンバーよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540403,
					"content": "あんた、モンドの人じゃないよね？身分の証明はできる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540404,
					"content": "落ち着いて、怪しい者じゃないんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3540405,
					"content": "怪しい人は皆そう言うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540406,
					"content": "#こんにちは、{NICKNAME}だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "…ここら辺の地域じゃ、めずらしい名前ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540408,
					"content": "それからその…マスコットはなんなの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540409,
					"content": "友達だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "ああ、まだ知り合って2ヶ月ぽっちの仲間だけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3540411,
					"content": "今じゃもう大親友だよなっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3540414,
					"content": "とにかく、旅人よね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540415,
					"content": "近頃、モンド城の周辺で大きな龍が出没しているの。だから、早く城に入った方がいいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540416,
					"content": "そうだ。ここからモンドまでそう遠くもないし、ここは騎士の務めとして城まで送ってあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540417,
					"content": "え？任務があって城を出たんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3540418,
					"content": "もちろん任務もあるわ。でも安心して、任務を行いながらでも、あんたたちの身を守ることくらいはできるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540419,
					"content": "それに…怪しい者を放っておくわけにもいかないからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540420,
					"content": "こっちを信用してないようだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "あ、うっ…ごめん。優秀な騎士にあるまじき言動だったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540423,
					"content": "謝るよ、えっと…見知らぬ、その……尊敬できる旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540424,
					"content": "ぎこちない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3540425,
					"content": "『騎士団ガイド』で決められた言葉に不満でもあるの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 3540421,
					"content": "こういう言い方は客人に失礼だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "非常食だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "全然違う！マスコット以下じゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}