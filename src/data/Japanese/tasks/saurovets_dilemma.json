			"dialogs": [
				{
					"id": 750180101,
					"content": "——ギャァァァウッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "グルル"
				},
				{
					"id": 750180102,
					"content": "お願い、いい子だから。薬を飲まないと元気になれないでしょ…きゃっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180103,
					"content": "#危ない！{NICKNAME}、助けに行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
