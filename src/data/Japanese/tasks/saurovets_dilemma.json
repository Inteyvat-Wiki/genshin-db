						750180344
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180344,
					"content": "全然反応が違うな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180345,
					"content": "一応、グルルが飲んでくれさえすれば、どちらも身体の回復に役立つものになってる。両方とも渡しておくから、どっちを飲ませるかの判断は任せるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180346
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180346,
					"content": "キュウッ！",
