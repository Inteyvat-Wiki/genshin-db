							-1245.777,
							277.26,
							9383.85
						],
						"pointId": 9801
					}
				]
			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "「ギャァァァウッ！」\\n敵わない相手だと悟ったのか、クク竜は吠えながら遠くへ飛んでいった…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "うわぁ！は、速い！あっという間に逃げちゃったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180303,
					"content": "パイモン、追いかけて！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "えっ、お、オイラがか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180307,
					"content": "——逃げられちゃった…でも、あの速さだと体力はほぼ戻ったみたいね。次は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180308,
					"content": "なぁ、あいつ、なんであんなに怒ってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180309,
					"content": "…あっ、わかったぞ！おまえ、あいつのおやつを盗み食いでもしたんだろ？食べ物の恨みは怖いからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180310,
					"content": "おやつ？確かに食べたことはあるけど、グルルは細かいことを気にしない性格だし、そんなことで怒らないと思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180311,
					"content": "「グルル」？ああ、あいつの名前か。…でも、さっきだっておまえに襲い掛かりそうだったし、気性は荒そうだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180312,
					"content": "ううん…さっきのは仕方ないの。治療中だったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180313,
					"content": "殴られるのも治療法の一環なんだ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "キュイ！キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#そんな治療法あるわけないだろ！ったく、{REALNAME[ID(2)|SHOWHOST(true)]}に変なこと聞かせるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180316,
					"content": "キュ？キュイッ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "ふふっ、もし本当にそんな治療法があったら、ぜひ試してみたいよ！でも竜は人間と違って、元気になるためって言っても、理解できないから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180318,
					"content": "あっ、自己紹介がまだだったね。私はマズカル。普段はこの辺で怪我や病気の竜の面倒を見てるの。自慢じゃないけど、私の調合した薬は結構評判がいいのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180319,
					"content": "うん、あなたたちの仲間は私が診てあげなくてもよさそうね。健康そのものよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180320,
					"content": "キュー！キュイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "竜の医者だったのか。でも、さっきのグルルの状況からして、大変な仕事みたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180322,
					"content": "別に大変だと思ったことはないわ。ただ、グルルの状況はちょっと特殊でね…人間を信用できなくなってるせいで、治療どころか薬も飲んでくれないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180323,
					"content": "はぁ、私も竜だったらよかったのに。あの子を観察してみたんだけど、他の竜とは仲良くしてるみたいなの。竜に言われたら、薬だって飲んでくれるかもしれないでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180324,
					"content": "キュ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "それなら、オイラたちが力になれると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180326,
					"content": "えっ？も、もしかして…見た目と違って竜なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180327,
					"content": "いやいや、考えが飛躍しすぎだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180328,
					"content": "#えっとだな…そう！{REALNAME[ID(2)|SHOWHOST(true)]}はすごく賢い竜なんだ！こいつの力を借りられば一発だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180329,
					"content": "えっ？そんなにすごいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180330,
					"content": "#{M#俺}{F#私}に付いてきたんだから、見る目はある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "確かにそうだけど…ポイントがずれてないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180333,
					"content": "#とにかく{REALNAME[ID(2)|SHOWHOST(true)]}に任せたら大丈夫だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180334
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 750180334,
					"content": "キュイッ！キュイッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180335,
					"content": "#じゃ、{REALNAME[ID(2)|SHOWHOST(true)]}、グルルの代わりに先にお礼を言っとくね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180336
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180336,
					"content": "あの子、このままじゃ古い傷が治るどころか、新しい傷までできるんじゃないかって心配だったの…けど、あなたたちのおかげで安心できそう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180337
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180337,
					"content": "グルルのために二種類の薬を用意したの。治療効果と味を両立させたいんだけど、まだそういった調合は思いつかなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180338
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180338,
					"content": "この二種類の薬のうち、治療効果がいいほうは竜にとって苦いの。でも、竜が好きそうな味のほうは効果がいまいちで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180339
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180339,
					"content": "#えっと…言葉で説明するより、{REALNAME[ID(2)|SHOWHOST(true)]}に嗅がせたほうが早いかも。この子の反応を見れば分かるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180340
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180340,
					"content": "こちらが治療効果がよりいいほう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180341
					],
					"speakerTitle": "マズカル"
				},
				{
					"id": 750180341,
					"content": "キュ…キュウ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180342
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180342,
					"content": "こちらは効果はいまいちだけど、見た目からして食欲をそそるもの。",
