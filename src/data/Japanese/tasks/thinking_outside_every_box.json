			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"トゥレーヌ",
					"アンジェニーナ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745180101,
					"content": "ふむふむ…守りの固い敵陣を攻める時、機動部隊の進路と防衛部隊の配置はどうすべきか…なるほど、興味深い課題ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180102
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180102,
					"content": "#うーん、{NICKNAME}さんの指揮はあまりにも型破りで、定石が通用しないからなぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180103,
						745180104
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745180103,
					"content": "参考になりそう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745180105
					]
				},
				{
					"id": 745180105,
					"content": "もちろんです！主力部隊が動いたら、短時間で撤退することはほぼ不可能。そうなると、側面を援護して敵の増援を遮断することが重要になってきます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180106
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180106,
					"content": "でも、限られた兵力からどれぐらい援護に回すべきかは難しい問題ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180107
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180107,
					"content": "うーん、送る人が多すぎると主力部隊が弱っちゃうし、少なすぎると敵の増援を防げない…っていうジレンマなんだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180108
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745180108,
					"content": "特巡隊の方針では、主力部隊から四分の一ぐらいを割いて、敵の増援が予想される方向を巡回することになってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180109
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745180109,
					"content": "一般的なケースでは、それで問題ないはずだよ。でも、必ず成功するってわけじゃない。巡回部隊は敵の影すら見てないのに、主力部隊は人員不足で危機に陥ってしまったってことが過去にもあったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180110
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745180110,
					"content": "でも副隊長は、主力部隊の進攻ルートを巧みに組み立て、巡回部隊との連携を可能にした。見事な戦術です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180111
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180111,
					"content": "これなら、必要な時にお互いを支援できるので、兵力を無駄なく活かすことができます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180112
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180112,
					"content": "主力部隊による攻撃が鈍ったら巡回部隊が支援し、巡回ルートに敵の増援が来たら主力部隊が支援する——まさに攻防一体の構えですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180113,
						745180114
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180113,
					"content": "まさにそういう戦略だった！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745180115
					]
				},
				{
					"id": 745180115,
					"content": "なんにせよ、アンジェニーナ教官を手こずらせた三つ目のステージを、柔軟な戦略で見事乗り切りったのは事実です！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180116
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180116,
					"content": "むぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180117
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745180117,
					"content": "もう、負けを認めればいいんでしょ？約束の競技用弾はあとで渡すから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180118
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745180118,
					"content": "ふふっ。正々堂々、賭けで勝ったのですから、遠慮なくいただきます～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180119
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180119,
					"content": "シュヴルーズ隊長も使っている限定版の競技用弾…素晴らしい精度と弾速で、離れた的にもバシバシ命中…えへへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180120
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180120,
					"content": "コホン！そういえば、副隊長も銃に興味をお持ちですよね？よろしければ、申請手続きを手伝いましょうか？やり方は同僚から教えてもらっています。副隊長なら、必ず許可が下りるはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745180121
					],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180121,
					"content": "今度お時間がある時、一緒に手続きを済ませましょう。いくつか測定をするだけで、自分専用の銃を造ってもらえますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "トゥレーヌ"
				},
				{
					"id": 745180114,
					"content": "適当に戦っただけだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745180115
					]
				},
				{
					"id": 745180104,
					"content": "「興味深い課題」って本当？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745180105
					]
				}
			]
		}
	]
}