					}
				]
			},
			"dialogs": [
				{
					"id": 150160101,
					"content": "あっ、来てくれたんだ？ちょうど全部片付いて、今から休もうとしてたとこだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160102
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160102,
					"content": "ラゾーリはどんな罰を受けるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160103
					]
				},
				{
					"id": 150160103,
					"content": "まだ検討中だってさ。古名の技術を使った犯罪なんて、参考にできる事例が限られてるからね…パカルはしばらく頭を抱えることになるんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160104
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160104,
					"content": "ただ、ラゾーリおばちゃんの工房は完全に閉鎖されて、作りかけの「燃晶名刻」は処分されることになったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160105
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160105,
					"content": "もう完成してる「燃晶名刻」については、ウチが対応することになったけど。はぁ、またメンドーな仕事が増えちった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160106
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160106,
					"content": "とにかく、おばちゃんの「古名」に問題が生じなかったのは不幸中の幸いだよ。じゃなきゃ、今頃ヤバイことになってただろうし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160107
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160107,
					"content": "あっ、古名といえば、いいニュースもあんだ。「燃晶名刻」に取り込まれた記憶は元に戻せるんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160108
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160108,
					"content": "すべての「燃晶名刻」の機能が停止したら、記憶は元の道を辿って持ち主のところに戻るみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160109,
						150160110
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160109,
					"content": "みんなのニエガに関する記憶も…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160111
					]
				},
				{
					"id": 150160111,
					"content": "そゆこと。でも今になって思うとさ…おばちゃんはニエガを取り戻そうとして、みんなにその存在を忘れさせたんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160112
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160112,
					"content": "けど本当にいなくなった今、こうして思い出せるようになるなんて…ほんと、めちゃくちゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160113
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160113,
					"content": "ニペカの調子はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160114
					]
				},
				{
					"id": 150160114,
					"content": "今はウチの工房で休んでるよ。部族の人にも相談して、出自を調べてもらってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160115
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160115,
					"content": "その結果が出るまで時間が掛かるだろうし、しばらくはあの子の世話をしながら、鍛造の技術でも教えよっかなって思ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160116
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160116,
					"content": "ま、どれも今後の話だけどね。今はゆっくり眠らせてあげないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160117
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160117,
					"content": "睡眠を十分に取ることこそ、面倒事を片付ける上で一番大切だからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150160110,
					"content": "一緒に戻るってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160111
					]
				}
			]
		}
	]
}