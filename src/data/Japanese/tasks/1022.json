			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220201,
					"content": "札と白紙の紙がたくさんあるぞ。なにに使うんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220202,
						10220203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220202,
					"content": "札の模様を書き写している。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				},
				{
					"id": 10220204,
					"content": "この模様、どこかで見たような…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220205,
					"content": "そうだ、「公子」がくれた「禁忌滅却の札」も同じ模様だったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220206,
					"content": "ふむ…仙人に関するものを「公子」が持ってるのも、確かにあやしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220207,
					"content": "それだけじゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220208
					]
				},
				{
					"id": 10220208,
					"content": "ああ、「禁忌滅却の札」は目印として使うために作ったわけじゃないって、留雲借風真君が言ってたよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220209
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220209,
					"content": "確か、魔神戦争中に仙力を発揮するために作られたって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220210,
					"content": "ファデュイが「禁忌滅却の札」を書き写してるのは、本物の効果を再現しようとしてるからか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220211,
					"content": "戦争中に仙力を発揮する…ううっ、危なそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220212,
						10220213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220212,
					"content": "ファデュイは何か企んでる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220214,
					"content": "複雑だな…とにかく、「公子」を警戒しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220215,
					"content": "さて、そろそろ鍾離と待ち合わせの時間だぞ、ここを出ないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220216,
					"content": "「送仙儀式準備の旅」の終点…確か荻花洲だったよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220217,
					"content": "早く行こうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220213,
					"content": "もらった札もその企みの一部にすぎない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220203,
					"content": "偽物を作ろうとしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				}
			]
		},
		{
			"id": 102203,
			"completionStepIds": [
				102203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
