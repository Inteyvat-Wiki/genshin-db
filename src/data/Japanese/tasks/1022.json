			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220301,
					"content": "時間通りだな、俺も今着いたところだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220302
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220302,
					"content": "群玉閣はどうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220303
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220303,
					"content": "すごーーく広かったぞ！そして豪華！たくさんお金かけてるなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220304,
					"content": "確かに、その点においては璃月一かもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220305
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220305,
					"content": "凝光にも会ったんだろ。どうだった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220306
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220306,
					"content": "お金持ちで、気前がよくて、親切な人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220307,
					"content": "その「親切」も商人の武器だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220308
					]
				},
				{
					"id": 10220308,
					"content": "うーん…こいつはオイラと違って、素直に話す「玉衡」の方が信頼できるって思ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220309,
					"content": "おや？刻晴に会ったのか？何か言われたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220310
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220310,
					"content": "「『仙人』の時代は終わった。『璃月七星』さえもそれを受け入れなければ、璃月の未来はどうなる？」って言われたな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220311
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220311,
					"content": "ハハハッ…不敬だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220312
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220312,
					"content": "確かに同じ七星であっても、何でも話す刻晴より凝光の方が典型的な商人だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220313
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220313,
					"content": "親切ではあるが、裏がどうなっているかは分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220314,
						10220315
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220314,
					"content": "凝光は策略家だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				},
				{
					"id": 10220316,
					"content": "ああ、彼女は実力で七星の座を手に入れたんだ。只者じゃないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220317
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220317,
					"content": "「群玉閣」はまさにその志の現れであり、彼女にとって二番目に大事なものだと聞いた。何があっても彼女は群玉閣を捨てないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220318
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220318,
					"content": "群玉閣が二番目？じゃあ一番は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220319,
					"content": "モラさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220320,
						10220321
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220320,
					"content": "さすがだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220322,
					"content": "そうだ、「ファデュイ」に関する話もしたぞ。帝君が殺害された後、ファデュイは璃月で悪いことをたくさんしてるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220323,
					"content": "「ファデュイ」はいつもそうだからな、想定の内だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220324
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220324,
					"content": "禁忌滅却の札の偽物を作ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220325
					]
				},
				{
					"id": 10220325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220326
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220326,
					"content": "「ファデュイ」の目的は知らないが、彼らと接触する時はくれぐれも気を付けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220327
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220327,
					"content": "そういえば、荻花洲にも送仙儀式に必要な品があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220328
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220328,
					"content": "ああ、今日は野生の琉璃百合を探すぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220329
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220329,
					"content": "琉璃百合？なんでここで？玉京台にたくさんあるぞ…軽策荘にもあるって聞いたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220330
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220330,
					"content": "そうだ、ピンばあやに会った時、彼女は花を見てた。彼女に聞いてみるか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220331,
					"content": "いや…あれは人工栽培のもので使えないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220332
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220332,
					"content": "琉璃百合はかつて荻花洲に大量にあってな、人々の歌声を聞く花なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220333
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220333,
					"content": "荻花洲は昔、陸地だった。魔神戦争で山が崩れ、陸が水没し、そのせいで琉璃百合はほとんど絶滅してしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220334
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220334,
					"content": "今、城内には人工栽培のものが残っている。だが、それでも野生の琉璃百合が完全に消失したわけではない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220335
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220335,
					"content": "野生の琉璃百合の香りは濃く、粉にして永生香の香炉に入れることが、「送仙」の伝統だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220336
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220336,
					"content": "しかし、花を手に入れるには、お前の力が必要になる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220337,
						10220339
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220337,
					"content": "労働力ってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220338
					]
				},
				{
					"id": 10220338,
					"content": "いや、その香りを濃くするために歌ってほしいんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220341,
					"content": "#うっ…{NICKNAME}、歌は得意か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220342,
						10220343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220342,
					"content": "まあまあかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220344,
					"content": "ふーん？本当かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220345
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220345,
					"content": "やってみれば分かるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220346
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220343,
					"content": "得意だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220339,
					"content": "まさか…歌とか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220340
					]
				},
				{
					"id": 10220340,
					"content": "ああ、お前の歌声が花の香りをより一段上げる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220321,
					"content": "意外ではない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220315,
					"content": "凝光は高い志を持ってる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				}
			]
		},
