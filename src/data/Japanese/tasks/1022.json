			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220601,
					"content": "琉璃百合じゃないぞ、琉璃百合は殴ったりしない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220602
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220602,
					"content": "想像を超えた敵だった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220603
					]
				},
				{
					"id": 10220603,
					"content": "これは「トリックフラワー」という魔物だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220604
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220604,
					"content": "ん？この花弁…？面白い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220605
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220605,
					"content": "「トリックフラワー」は琉璃百合と長い間一緒に埋まっていたせいで、今や最高の薬材となっている…花弁を仕舞っておこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220606
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220606,
					"content": "本当か？じゃあ、この花弁は送仙儀式に使えるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220607,
					"content": "残念だが、できないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220608
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220608,
					"content": "えー、そんなぁ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220609,
					"content": "あの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220610
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220610,
					"content": "琉璃百合をお探しですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220611
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220611,
					"content": "あっ！おまえ！えっと…名前が思い出せない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220612,
						10220614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220612,
					"content": "こんにちは、甘雨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220613
					]
				},
				{
					"id": 10220613,
					"content": "こんにちは、旅人。名前を覚えてくれたんですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220617,
					"content": "ところで、「群玉閣」はどうでしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220618
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220618,
					"content": "甘雨が行き方を教えてくれなかったせいで、苦労したんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220619,
					"content": "えええっ？わ、私、教えていませんでしたか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220620
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220620,
					"content": "道は他の人に聞いたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220621,
						10220622
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220621,
					"content": "みんな知ってるから言わなかったとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220623,
					"content": "は…はい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220624
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220624,
					"content": "（しまった、忘れてた…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220625
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220625,
					"content": "ん？甘雨、なんか顔色が悪いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220626
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220626,
					"content": "それに最初に会った時とオーラも違う…あの時の厳しさがないというか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220627
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220627,
					"content": "あっ…あの時は「天権の使者」で、今は花見をしてるだけですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220628
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220628,
					"content": "花見？なんで城内じゃなく、ここでするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220629,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220630
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220630,
					"content": "玉京台は帝君逝去の場所。あそこで花見をするのは寂しいものですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220631
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220631,
					"content": "ここ数日、玉京台で仕事する時は景色を見ないように、窓を閉めてました…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220632
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220632,
					"content": "あうっ…ごめん、この話はやめとこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220633
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220633,
					"content": "まだ…気持ちの整理ができてないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220634
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220634,
					"content": "2000年前、魔神戦争が終わった後、最初の七神は璃月で盃を交わしました…しかし、そのうちの5人は既に去っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220635
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220635,
					"content": "それってつまり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220636
					]
				},
				{
					"id": 10220636,
					"content": "ええ、帝君の魂が高天へと帰り、俗世にいる最初の七神はモンドのバルバトス様だけとなりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220666
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220666,
					"content": "他の5人、稲妻の雷電将軍を含め、2000年前とは違います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220637
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220637,
					"content": "今の「俗世の七執政」、最も若いスメールの草神は500歳です。岩王帝君は6000年以上も生きてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220638
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220638,
					"content": "3700年の歴史を持つ璃月は、建立当初から帝君がいたゆえに神との「お別れ」を知らないのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220639
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220639,
					"content": "では、その「お別れ」について、どう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220640
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220640,
					"content": "えっ？急に聞かれても…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220641
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220641,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220642
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220642,
					"content": "「人」として、帝君のいない璃月は今でも想像できません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220643
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220643,
					"content": "「仙人」として…いずれ受け入れなければならない事実だと思います。帝君の逝去は、仙人と璃月の「契約」の終わりを意味しますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220644
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220644,
					"content": "ん？今…「仙人」って言ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220645
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220645,
					"content": "…私は人類と麒麟の混血、半分は仙人です。魔神戦争の時も、帝君や璃月のために戦いました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220646
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220646,
					"content": "戦争が終わった後、私は帝君と「契約」を結び、歴代七星の秘書として今日まで働いてきました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220647,
						10220648
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220647,
					"content": "道理で角がある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220649,
					"content": "コ、コホン。他の話をしましょう。そうだ、琉璃百合ですよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220650
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220650,
					"content": "野生の琉璃百合の場所を知ってます。ちょうど今持ってますので、よかったらどうぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220651
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220651,
					"content": "ではいただくぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220652
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220652,
					"content": "えっ？甘雨も歌ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220653
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220653,
					"content": "ええ、伝統はちゃんと把握してます。歌ったのは璃月の民謡でしたからご安心を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220654
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220654,
					"content": "わぁ、さすが甘雨、ありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220655
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220655,
					"content": "こちらこそ、まさか帝君の「送仙儀式」の力になれるなんて、この出会いに感謝です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220656
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220656,
					"content": "そろそろ戻ります。うまく行くといいですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220657
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220657,
					"content": "これで、「送仙儀式」に必要な準備は大体終わったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220658
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220658,
					"content": "花の件は他のものより比較的簡単だから、最後にとっておいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220659
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220659,
					"content": "鍾離先生の性格は開拓者に向いてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220660
					]
				},
				{
					"id": 10220660,
					"content": "うん、鍾離が璃月で商売したら、きっと起業の難しさも楽しいだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220661
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220661,
					"content": "ハハッ…そういう暮らしは過去にあったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220662
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220662,
					"content": "起業、開拓…なんでも最初は難しいが、その分思いは込められる。しかし軌道に乗り、時間が経つと、その感情は「摩耗」する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220663
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220663,
					"content": "「摩耗」が多いと、自分を見つめ直す必要が出てくる。でないと、取り返しのつかないことになる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220664
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220664,
					"content": "へぇ！経験者は語るってやつだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220665
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220665,
					"content": "さて、用事は終わったし、そろそろ璃月港に戻ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220648,
					"content": "道理で必要な事を言わなかったわけだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220622,
					"content": "無駄足になるところだった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220614,
					"content": "こんにちは、香菱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220615
					]
				},
				{
					"id": 10220615,
					"content": "香菱？何を言ってるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220616
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220616,
					"content": "私は甘雨、ちゃんと覚えてください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "甘雨"
				}
			]
		},
		{
			"id": 102208,
			"completionStepIds": [
				102208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102208",
							"2"
						],
						"stepId": 102208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィリックス"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220801,
					"content": "ああ、「往生堂」の鍾離先生か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220802
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220802,
					"content": "千岩軍が我々を監視してる。今は非常時だ、先生も軽率な行動を控えた方がいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220803
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220803,
					"content": "非常時？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220804
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220804,
					"content": "ああ、「絶雲の間」の仙人が動いた。何かするつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220805
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220805,
					"content": "非難しに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220806
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220806,
					"content": "おそらく。七星のうち数名が迎えに行った…まあ、迎えというか、仙人たちを止めるというか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220807
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220807,
					"content": "双方とも強気に出てるから、膠着状態なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220808
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220808,
					"content": "…こうなるのも、必然か。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220809
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220809,
					"content": "仙人たちが重要視するのは岩神との「契約」だけだ。彼らが強引に攻めるなら、きっと止められないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220810
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220810,
					"content": "だが「璃月七星」が動かないわけがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220811
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220811,
					"content": "フン、彼らが強気に出たせいで、人間と仙人の間にある矛盾点が一触即発の状態を作り出したんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220812
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220812,
					"content": "それで？どうして「ファデュイ」が非難の的に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220813
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220813,
					"content": "はあ…全部あの凝光のせいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220814
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220814,
					"content": "「嵐が来ようとする時こそ、ファデュイの動向を徹底的に把握しろ」ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220815
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220815,
					"content": "ちっ！今さら俺らの行動を制限するって？七星も大したことないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220816
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220816,
					"content": "とにかく、鍾離先生は「公子」様の協力者だ。弱みを握られないように行動してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220817
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220817,
					"content": "どうやら、璃月港の様々な矛盾が限界に達したみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220818,
						10220819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220818,
					"content": "何かできることは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				},
				{
					"id": 10220820,
					"content": "それは、特殊な中立的立場から仲裁したいのか、それともお前個人の武力で何かを変えたいという意味か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220821
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220821,
					"content": "どちらにせよ、簡単ではないだろうが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220822
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220822,
					"content": "あっ、そうだ！鍾離先生、「往生堂」も巻き込まれて今千岩軍と対峙してると聞いたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220823
					],
					"speakerTitle": "フィリックス"
				},
				{
					"id": 10220823,
					"content": "…まずい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220824
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220824,
					"content": "俺は往生堂に戻らせてもらう。胡堂主がうまく対応しているといいんだが…トラブルは御免だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220825
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220825,
					"content": "旅人、一触即発の爆発を止めるより、「信管」はどこにあるか、お前も考えてみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220827
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220827,
					"content": "ふう…「ファデュイ」と「仲良し」になると、メリットもトラブルもつきものだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220828
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220828,
					"content": "それで、鍾離が言った「信管」ってなんだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220829,
						10220830,
						10220831
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220829,
					"content": "「公子」…タルタリヤ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220832,
					"content": "なるほど！…確かに、こういうトラブルを楽しみにしてるやつといえば、あいつしか思いつかないもんな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220833
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220833,
					"content": "きっとみんなが忙しい時を狙って、悪いことしてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220834
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220834,
					"content": "でも、どこに行けば会えると思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220835
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220835,
					"content": "こういうどこもかしこも混乱に陥っている時…彼はどこに行くんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220836,
						10220837
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 10220836,
					"content": "ついてきて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220837,
					"content": "彼の行きそうな場所は一つだけ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220830,
					"content": "いつもお金くれる人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220831,
					"content": "鍾離先生の財布。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220819,
					"content": "見て見ぬふりはしたくない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				}
			]
		}
	]
}