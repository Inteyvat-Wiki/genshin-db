			"dialogs": [
				{
					"id": 250220101,
					"content": "うーん…レシピを変えたほうがいいかもしれないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220102,
					"content": "キュー、キュッキュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220103,
					"content": "おっ、お前も何かいいアイデアがあるのか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "キュッ、キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220107,
					"content": "いつもは果物をたくさん食べて、一日中遊びほうけてたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220108,
					"content": "今は前の半分しか食べられなくなってるし、食べ終わったらじっとして動かないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220109,
					"content": "だから病気かと思ってな。その夜、医者のところに行ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220110,
					"content": "二人で一晩中頭を悩ませて分かったんだが、ホーリーの食欲の無さは病気なんかじゃなくて、ただの好き嫌いだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220111,
					"content": "それで医者が言うには、レシピを変えるのが一番いいらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220112,
					"content": "あと、ホーリーが食事してるときに音楽を流すのをオススメされた。食欲が湧くかもしれないってな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220113,
					"content": "いいアイデアだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "あはは…音楽ってのはほんと不思議だよな。実はその日、ちょうどいいレコードを見つけてさ。ホーリーもその音楽を気に入ってくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220116,
					"content": "けど、急にホーリーが跳び上がって、レコードを半分噛んじまった…で、その方法は使えなくなってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220117,
					"content": "テペトル竜にとって、黒曜石と燃素でできたレコードは結構なご馳走だしな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220118,
					"content": "てなわけで、「懸木の民」に頼んで、珍しい食材を見つけてもらうしかなくなったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220119,
					"content": "食材を探してきてあげる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "いいのか？それは助かる！「懸木の民」はナタの食材しか探せないけど、あんたならナタの外にも行けるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220124,
					"content": "ちょっと待っててくれ。医者からもらった食材リストを見てみるから。あの医者、本当に物知りでさ、ナタの外のことも結構知ってるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220125,
					"content": "どれどれ…<color=#00E1FFFF>「レインボーローズ」「スミレウリ」</color><color=#00E1FFFF>「清心」</color>を食べさせてみるといいって書いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220122,
					"content": "それじゃあ、頼んだぜ。珍しい食材を見つけたら俺のところに持ってきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220123,
					"content": "キュー、キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220120,
					"content": "食材探しは得意分野だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "#そんなレコードがあるの{M#}{F#}？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "（ホーリーをなでなでする）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "キュッ、キュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
					],
					"speakerTitle": "ホーリー"
				}
			]
		},
