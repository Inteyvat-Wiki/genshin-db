			"dialogs": [
				{
					"id": 250220301,
					"content": "見た目も名前もきれいな花だな。ホーリー、食べてみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220304,
					"content": "キュッ！キュキュ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220305,
					"content": "（ホーリーは慎重に花びらを噛んでその味を確かめた）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220306,
					"content": "キュッ、キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220307,
					"content": "おっ、どうやら気に入ったみたいだな。でも、花びらだけじゃ腹いっぱいにはならないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220308,
					"content": "それに、この花は見るからに高そうだ…とりあえずメモしとこう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220309,
					"content": "しっかし、花を使った食べ応えのある料理って、どう作ればいいんだ？うーん、生地で包んでみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズーガ"
				}
			]
		},
