				{
					"id": 250220501,
					"content": "おお…この花、清らかな感じの香りがする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220504,
					"content": "ホーリー、食べてみ…うわっ！もう食べちゃったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220505,
					"content": "（ホーリーはパクッと清心を丸呑みし、目をぱちぱちさせた）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220506,
					"content": "突然、ホーリーは振り向いて、ボウル半分の残った果物を一気に食べてしまった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "急に食欲が戻った？清心って食欲増進効果があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "カズーガ"
				},
