						250220405
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220405,
					"content": "（ホーリーはスミレウリを頬張り、あっという間に完食した）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220406,
					"content": "キュー、キューキュー！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220407,
					"content": "ははは、一瞬で平らげたな。気に入ったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "カズーガ"
				},
				{
					"id": 250220408,
					"content": "キュキュー、キュー！キュー——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "ホーリー"
				},
				{
					"id": 250220409,
					"content": "よし！じゃあ、あとで誰かに…いや、先に稲妻から来てる商人がどこかにいないか聞いてみて、スミレウリを買い込もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カズーガ"
				}
			]
		},
