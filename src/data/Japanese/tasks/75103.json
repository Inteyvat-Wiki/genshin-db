					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031103
					],
					"speakerTitle": "イーワイ"
				},
				{
					"id": 751031103,
					"content": "魚肉はたーっくさん用意してるからね！これで浮流ペンギンたちを全部引き寄せることができれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031104
					],
					"speakerTitle": "パニア"
				},
				{
