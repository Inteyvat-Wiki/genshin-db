				]
			},
			"dialogs": [
				{
					"id": 751030101,
					"content": "うわぁ、魚肉がこんなにたくさん！おまえたち、ここでなにをしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751030102,
					"content": "#えっ？あっ、こんにちは！金髪の{M#お兄ちゃん}{F#お姉ちゃん}、それと白い、白い…えっと、妹さん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030103,
					"content": "あたしとイーワイはちょうどここで浮流ペンギンが岸辺に上がってくるのを待っているんだ。どうせほかにやることがないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030104,
					"content": "浮流ペンギンが岸に上がるのを待つ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751030105,
					"content": "キュッ！キュ、キュキューッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "イーワイ"
				},
				{
					"id": 751030106,
					"content": "よしよし、イーワイはいい子だね。我慢だよ我慢、焦っちゃダメ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030107,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "イーワイ"
				},
				{
					"id": 751030108,
					"content": "とにかく、あたしたちは本来はここで遊ぶつもりだったの。普段は、ロンゴおじさん以外、誰もここに来ることがなくてね。だからここはあたしたちの秘密基地みたいなとこなんだ！そんな感じ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030109,
					"content": "それがまさか、今日あの浮流ペンギンたちに先を越されちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030110,
					"content": "だからね、誘き寄せようと思って、魚肉を用意したんだ！浮流ペンギンたちは、魚肉が大好物だから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030111,
					"content": "それにしては引きつけられてないような？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "そうなの。たぶん距離が遠すぎて、魚肉の匂いが届いてないのかもしれないね。もし岸辺まで誘き寄せることさえできれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030117,
					"content": "そうだ！もしロンゴおじさんだったら、たぶん<color=#00E1FFFF>「岸辺にぶつけて上がってきてもらえばいい」</color>みたいなことを言うはず…でもあたしとイーワイ、力が弱すぎて逆に突き飛ばされちゃいそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030118,
					"content": "#なぁ…{NICKNAME}、オイラたちでやってみるか？もしあいつらに岸辺に上がってきてもらえたら、魚肉に引き寄せられるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751030112,
					"content": "なるほど、パイモンも浮流ペンギンだったのか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "丸っこくて魚肉が好き…確かに、浮流ペンギンだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030114,
					"content": "キュウ、キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "イーワイ"
				},
				{
					"id": 751030115,
					"content": "そんなわけあるかー！ってそんなことより、あいつらまったく引き寄せられてないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "パイモン"
				}
			]
		},
