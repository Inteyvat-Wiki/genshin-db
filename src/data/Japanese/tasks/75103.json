					}
				]
			},
			"dialogs": [
				{
					"id": 751030801,
					"content": "うわぁ、魚肉がたくさんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751030802,
					"content": "#あっ、動かさないで、金髪の{M#お兄ちゃん}{F#お姉ちゃん}！あれは浮流ペンギンたちを誘き寄せるために置いたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030803,
					"content": "えっと、浮流ペンギン？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751030804,
					"content": "そう。あたしとイーワイはちょうどここで、浮流ペンギンが岸辺に上がってくるのを待っているんだ。どうせほかにやることがないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030805,
					"content": "キュッ！キュ、キュキューッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "イーワイ"
				},
				{
					"id": 751030806,
					"content": "よしよし、イーワイはいい子だね。我慢だよ我慢、焦っちゃダメ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030807,
					"content": "キュー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "イーワイ"
				},
				{
					"id": 751030808,
					"content": "とにかく、あたしたちはもともとここで遊ぶつもりだったの。普段は、ロンゴおじさん以外、誰もここに来ることがないしね。だから、ここはあたしたちの秘密基地…みたいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030809,
					"content": "それがまさか、今日あの浮流ペンギンたちに先を越されちゃって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030810,
					"content": "だからね、誘き寄せようと思って、魚肉を用意したんだ！浮流ペンギンたちは、魚肉が大好物だから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030811,
					"content": "それにしては引きつけられてないような？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "そうなの。たぶん距離が遠すぎて、魚肉の匂いが届いてないのかもしれないね。もし岸辺まで誘き寄せることさえできれば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030817,
					"content": "そうだ！もしロンゴおじさんだったら、たぶん<color=#00E1FFFF>「岸辺にぶつけて上がってきてもらえばいい」</color>みたいなことを言うはず…でもあたしとイーワイ、力が弱すぎて逆に突き飛ばされちゃいそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030818,
					"content": "#なぁ…{NICKNAME}、オイラたちでやってみるか？もしあいつらに岸辺に上がってきてもらえたら、魚肉に引き寄せられるかもしれないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 751030812,
					"content": "なるほど、パイモンも浮流ペンギンだったのか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "丸っこくて魚肉が好き…確かに、浮流ペンギンだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "パニア"
				},
				{
					"id": 751030814,
					"content": "キュウ、キュウ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "イーワイ"
				},
				{
					"id": 751030815,
					"content": "そんなわけあるかー！ってそんなことより、あいつらまったく引き寄せられてないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "パイモン"
				}
			]
		},
