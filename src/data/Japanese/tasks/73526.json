{
	"id": 73526,
	"type": "WQ",
	"name": "「幻のおもちゃ王」と「ヒャッホーギツネ」",
	"description": "「ヴェルーリヤ·ミラージュ」を散歩していると、困っていそうな商人を発見した。彼女を助けると、珍しい報酬がもらえるかもしれない…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 2023,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
