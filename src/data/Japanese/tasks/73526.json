	],
	"talks": [
		{
			"id": 7352601,
			"completionStepIds": [
				7352601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352601",
							"2"
						],
						"stepId": 7352601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マディーハ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735260101,
					"content": "最初から誰かに依頼すればよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260102
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260102,
					"content": "最初のテストで山を越えなきゃいけないなんて…どんな苦行よ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260103
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260103,
					"content": "おまえ、大丈夫か？喋る気力もなさそうだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260104,
					"content": "#{NICKNAME}、こいつ…弱りきってるみたいだぞ。なにか作って食べさせてやろうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260105,
					"content": "近くのかまどで熱々の大根の揚げ団子とステーキを作って、衰弱した見知らぬ人の体力を回復させた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735260106
					]
				},
				{
					"id": 735260106,
					"content": "うふふふ！おかげで復活しました！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260107
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260107,
					"content": "良い腕なさってますね。食材と調味料の品質がよくないせいで、口当たりが少しパサパサしてましたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260108
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260108,
					"content": "こういうときに文句言うなよな。腹いっぱい食べられたんだから、それでいいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260109,
					"content": "いやいや！貧しいときこそ、贅沢な生活を想像するものですよ。そうすることで、戦い続けるモチベーションが生まれるんですから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260110
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260110,
					"content": "資金が回らなくなったときこそ、多額の借金を作る——そうすることで転機を掴んで一発逆転できるんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260111
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260111,
					"content": "それでこそ私、「幻のおもちゃ王·マディーハ」の逆転法——局面を打破するビジネスの秘訣です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260112
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260112,
					"content": "ま…幻のおもちゃ王？たいそうな名前だけど、おまえのそのやつれた姿を見る限り、なんか裏がありそうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260113,
						735260114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260113,
					"content": "おもちゃはまだ作れてないんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260115
					]
				},
				{
					"id": 735260115,
					"content": "あなたたち！どうやって見抜いたのですか…！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260116
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260116,
					"content": "だってさっき、お腹が空きすぎて行き倒れそうになってたし、ぶつぶつとテストだの、誰かに依頼するだの、うわごとを言ってただろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260117,
					"content": "どう見てもおまえはまだ看板おもちゃを作れてなさそうだよな？ご飯にすらありつけないなんて、憐れすぎるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260118,
					"content": "くっ…そう言われると、なんだかすごく悔しいです！私の「ヒャッホーギツネ」はもう生産前の最終段階に来てるんですからね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260119
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260119,
					"content": "あとは「ヒャッホーギツネ」の飛行エンベロープさえ割り出せれば、キノコンにだって読める説明書が完成します。そこで更に借金をして大量生産すれば、利益を上げられるはずです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260120
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260120,
					"content": "飛行エンベロープってなんだ？なんの説明書だよ？専門用語を使わないでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260121,
					"content": "言葉だけじゃ言い尽くせません。ご覧になっていただければ手っ取り早い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260122
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260122,
					"content": "マディーハはバッグから青い包みを1つ取り出して、素早く空気を入れた。\\n少し経つと、独特な形のおもちゃが形を成して、目の前で穏やかに宙を浮かんだ。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735260123
					]
				},
				{
					"id": 735260123,
					"content": "これがおまえの看板おもちゃなのか？どう見ても「キツネ」じゃないだろ！いっそ、「デカミミ夕暮れの実爆弾·青い星限定版」みたいな名前にしちゃえよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260124,
					"content": "それに、「ヒャッホー」ってなんだよ？どう見ても嬉しそうな表情じゃないよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260125,
					"content": "いえいえいえいえ、それは空気噴射装置が作動する時、人が大笑いしているように聞こえるからですよ！ほら、聞いてみてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260126
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260126,
					"content": "（おもちゃは形容し難い、低い唸り声をあげた。おそらく、多分、ギリギリ、「ヒャッホー」と表現できる…？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260127
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260127,
					"content": "#一体どこでこんな笑い声を聞いたんだよ…{NICKNAME}、こいつの精神状態がちょっと心配だぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260128,
					"content": "とにかく、「ヒャッホーギツネ」は小型の熱気球によって浮いていて、隠れた小さな空気噴射口が推進力を提供しています。操作性も悪くないはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260129
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260129,
					"content": "考えてみてくださいよ、これは自由自在に飛行させられるおもちゃなんですよ！普通の子どもは勿論、大人だってこの誘惑には抗えませんから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260130,
						735260131
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260130,
					"content": "そう言われると、確かに目新しい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260132
					]
				},
				{
					"id": 735260132,
					"content": "なんだかよく知った匂いだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260133,
					"content": "次は——「報酬をお支払いしますので、最後のテストをあなたたちにお願いしたいです」って言うんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260134,
					"content": "#それはちょっと、{NICKNAME}とじっくり話し合わないといけないぞ。オイラたちはすっごく忙しいからな。少しの報酬しかもらえないんじゃ、割に合わないぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260135,
					"content": "いえいえいえ、少しだけの報酬なんてとんでもない、そうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260136
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260136,
					"content": "「ヒャッホーギツネ」の一年間の売上のうち六割、いえ、七割を分け前とします。これならいかがです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260137
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260137,
					"content": "七割！それは多すぎるんじゃ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260138,
					"content": "コホン…それでこそ「幻のおもちゃ王」だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260139,
						735260140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260139,
					"content": "一年以内に量産できるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260141
					]
				},
				{
					"id": 735260141,
					"content": "お二人とも、そこが重要なところです！早くテストを終わらせれば、「ヒャッホーギツネ」の生産販売にも早く着手できます。そうすれば分け前も増えますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260142
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260142,
					"content": "一緒に頑張って製品を最高な状態にできれば、ウィンウィンですから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260143
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260143,
					"content": "それもそうか、考えれば考えるほどその通りだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260144,
					"content": "#へへっ、{NICKNAME}、これでオイラたちも、おもちゃ業界に足を踏み入れたことになるよな。つまり、ビジネス業界の人になったってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735260145,
					"content": "それでは早速始めましょう。以前、冒険者のみなさんに教えを乞うたことがありまして、彼らの経験を参考に、いくつかの地点に飛行エンベロープをテストする挑戦を配置しました。大まかな場所を教えますね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260146
					],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260146,
					"content": "「ヒャッホーギツネ」の未来、そして「幻のおもちゃ王」の看板を、あなたたちに託しましたよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マディーハ"
				},
				{
					"id": 735260140,
					"content": "量産しても利益が出るとは限らない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260141
					]
				},
				{
					"id": 735260131,
					"content": "よく売れるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260132
					]
				},
				{
					"id": 735260114,
					"content": "破産済みとか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260115
					]
				}
			]
		}
	]
}