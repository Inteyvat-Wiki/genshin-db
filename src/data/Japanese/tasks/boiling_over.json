{
	"id": 73509,
	"type": "WQ",
	"name": "爆発、振動、沸騰！",
	"description": "雨林の南西部の防砂壁一帯で、あなたとパイモンはとある奇妙な学生に出会った。彼女は、あなたたちのことをよく覚えているようだ…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5129,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
