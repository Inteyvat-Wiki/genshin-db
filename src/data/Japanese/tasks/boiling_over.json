	],
	"talks": [
		{
			"id": 7350901,
			"completionStepIds": [
				7350901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350901",
							"2"
						],
						"stepId": 7350901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハジャナド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735090101,
					"content": "うふっ…えへっ…あははははっ…ついに完成した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090102
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090102,
					"content": "次は傭兵たちを雇って、テスト要員として配置するだけ。十日以内になんとか初期戦闘能力を達成しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090103
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090103,
					"content": "前線の傭兵から報告をもらったら、指導教員を説得して予算枠を増やせるわ。そしたら、これが錬金薬の最強形態だって教令院に証明できる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090104
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090104,
					"content": "あいつ、どうしたんだ？砂漠に向かって一人でにやけてるぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090105,
					"content": "しかも、傭兵とか戦闘とか呟いてるし…もしかして戦闘マニアか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090106,
					"content": "#{NICKNAME}、どうする？やっぱり…近づかないほうがいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090107,
						735090124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090107,
					"content": "面白そう、まずは様子を見てみよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090108
					]
				},
				{
					"id": 735090108,
					"content": "は？…はぁ、そういえば、おまえも戦闘マニアだったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090109,
					"content": "たしか、前にも似たようなことがあった気がするぞ——相手と話が盛り上がって、その場で頼みごとを受けることになったんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090110,
					"content": "もし、こいつが悪巧みをしてるんじゃなくて、モラをたーくさんくれるなら、検討してやってもいいけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090111,
					"content": "ん？後ろから声が…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090112
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090112,
					"content": "あっ…あなたたちは！金髪の異邦人と「白色高知能浮遊アシスタントユニット」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090113
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090113,
					"content": "ん？オイラたちを知ってるのか？そんなあだ名、付けられた覚えはないけど？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090114,
					"content": "自己紹介してくれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090115
					]
				},
				{
					"id": 735090115,
					"content": "私のこと忘れたの…？ま、無理もないか。こっちは一般人で、対してあなたたちは伝説だものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090116
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090116,
					"content": "結構前のことだけど、戦闘をサポートする新型錬金薬のテストをあなたたちが手伝ってくれたのよ——私の自信作「リメルトタブレット」をね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090117
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090117,
					"content": "テストは順調に進み、あなたたちは心ゆくまで戦闘を満喫した後、大量のデータとアイデアを提供してくれたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090118
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090118,
					"content": "あなたたちのお陰で、私の人生が変わったと言っても過言ではない。心から感謝しているのよ！私の研究結果も、一部の「三十人団」の力になって、スメールの治安に貢献できたわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090119
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090119,
					"content": "オ…オイラたちそんなにすごいことしたのか？頑張って思い出さないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090120,
					"content": "あれ？そういえば、おまえさっき戦闘とか、薬とか言ってたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090121,
					"content": "もしかして、今回もオイラたちの協力が必要な感じか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090122,
					"content": "ええ！あなたたちが手伝ってくれるなら、傭兵に頼まないで済むわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090123
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090123,
					"content": "実は、傭兵たちにぼられたり、薬をタダでよこせって脅されたりしないか、ちょっと心配だったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090139
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090139,
					"content": "「ボイルドミクスチャー」のテストを手伝ってくれたら、研究予算の全額をあなたたちにあげるわ。何回も協力してくれたお礼にね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090140
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090140,
					"content": "およそ五十人分の給料に当たるモラよ。報酬としては悪くないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090141
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090141,
					"content": "ご…五十人分の給料！？つまり…一日働いたら、しばらくはずっとぶらぶらしてられるってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090142,
					"content": "#儲かる依頼だ。{NICKNAME}、こんなのめったにないチャンスだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090143,
						735090144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090143,
					"content": "いい機会だし、さっそく働こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090145
					]
				},
				{
					"id": 735090145,
					"content": "よし、相変わらず決断が早いわね！じゃあ、さっそく本題に入りましょう——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090146
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090146,
					"content": "「リメルトタブレット」のテストをする時に、「薬剤の温度」に欠陥を見つけたの——暑い環境だと、タブレットが爆発する時の効果がまったく基準を満たせないみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090147
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090147,
					"content": "そこで薬剤を安定した液体に溶かし、比較的融点の高いタブレットと分けて保存したのち、使用する際にこの二つを混ぜて、容器内圧を上げることにしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090148
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090148,
					"content": "沸騰した液体の中でタブレットを爆発させることによって、より効率が良く、安定性に優れた「爆発振動沸騰効果」を実現できた。だからこの新しい装置も「ボイルド装置」って名前に変えたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090149
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090149,
					"content": "これによって、たとえ一日中、烈焔花の傍に置いてあったとしても、錬金薬を正常に使用して戦闘を助けることができるの。装置全体の信頼性が飛躍的に上がったというわけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090150
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090150,
					"content": "その他にも、装置に起動タイマーと記録の機能を搭載したわ。戦闘を開始したら、「ボイルド装置」が自動的に反応して、戦闘の情報が記録してくれるようになったから、操作性がさらに便利になってるわよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090151
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090151,
					"content": "と…とにかく便利かつ凄い補助装置で、オイラたちはそれを使って敵を倒せばいいんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090152,
					"content": "その通り！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090153
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090153,
					"content": "素人にここまで丁寧に説明してくれるなんて、ハジャナドって本当にまじめなんだな。なんとなく仕組みを理解できた気になってきたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090154
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090154,
					"content": "もし偏屈な学者なら…「既知の問題をいくつか修正した」とか、そんな適当な会話で終わってただろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090155,
						735090156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090155,
					"content": "どうせ自動的に起動して記録するわけだし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090157
					]
				},
				{
					"id": 735090157,
					"content": "よし。じゃあ以前と同じように、ハジャナドの装置の効果をテストしてみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090158
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090158,
					"content": "オイラたちの得意分野だから、ちょいと戦っただけでわんさかモラがもらえるぞ。ハジャナドの役にも立つし、スーパーウィンウィンってやつだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090159
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090159,
					"content": "これ以上ないほどスムーズな対話だったわね！やっぱり、傭兵よりあなたたちのほうがよっぽど仕事が捗るわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090160
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090160,
					"content": "テストの場所は既に決めてあるの。そう遠くないところに秘境があるから、さっそく出発してもらおうかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090161
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090161,
					"content": "私はここでテスト結果を待っているわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090156,
					"content": "具体的な原理はそこまで詳しく知らなくても…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090157
					]
				},
				{
					"id": 735090144,
					"content": "「ボイルドミクスチャー」のレクチャーを——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090145
					]
				},
				{
					"id": 735090124,
					"content": "ちょっと待って、会ったことがあるかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090125
					]
				},
				{
					"id": 735090125,
					"content": "言われてみれば、確かに見覚えがある気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090126,
					"content": "思い出したぞ。昔、雨林の崖のところで会ったやつだよな！なんて名前だっけ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090127,
						735090129
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090127,
					"content": "「錬金釜炒り茶」の巨匠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090128
					]
				},
				{
					"id": 735090128,
					"content": "う～ん…真面目な錬金術師だってことは覚えてるけど、錬金釜で研究以外のことをしてた覚えはないぞ…あっ、確かハジャナドって名前だったよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090131,
					"content": "ん？後ろから声が…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090132
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090132,
					"content": "あっ…あなたたちは！金髪の異邦人と「白色高知能浮遊アシスタントユニット」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090133
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090133,
					"content": "まさかここで再会するなんてな！ハジャナド、元気だったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090134
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735090134,
					"content": "ええ、おかげさまでと～っても元気よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090135
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090135,
					"content": "あなたたちのお陰で、「リメルトタブレット」の研究結果をまとめた論文を発表できて、薬効も証明できたわ。「三十人団」からもある程度関心を得られたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090136
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090136,
					"content": "当時の指導教員は大した能力もないくせに、私に見向きもしなかった。けど、私の論文は指導教員はもちろん、すべての学生よりも優れたものだったわ。だから、その指導教員のもとを離れたの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090137
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090137,
					"content": "新しい指導教員は私の研究を評価してくれて、研究プロジェクトの他に、かなりの予算まで組んでくれたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090138
					],
					"speakerTitle": "ハジャナド"
				},
				{
					"id": 735090138,
