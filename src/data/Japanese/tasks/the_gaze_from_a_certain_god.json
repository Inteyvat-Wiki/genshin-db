			"trigger": {
				"objectNames": [
					"タシフィン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170101,
					"content": "止まれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170102
					],
					"speakerTitle": "タシフィン"
				},
				{
					"id": 30170102,
					"content": "金髪の旅人に、空を飛ぶ小さな精霊、間違いないらしいな。周りを見てみろ、お前たちは我々の待ち伏せに遭ったのさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170103
					],
					"speakerTitle": "タシフィン"
				},
				{
					"id": 30170103,
					"content": "おまえたちは！「三十人団」のやつらか？オイラたちを捕まえに来たのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170104,
					"content": "「三十人団」…あの骨折り損ばかりの雑用係のことか？あんな上の犬などと同じにしてもらっては困るな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170105
					],
					"speakerTitle": "タシフィン"
				},
				{
					"id": 30170105,
					"content": "俺たちはスメールでもトップクラスの報酬を得ているエリート傭兵団だ。今回は、「追放者」という方からの依頼を果たしに来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170106
					],
					"speakerTitle": "タシフィン"
				},
				{
					"id": 30170106,
					"content": "「追放者」…教令院の追放者か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170107,
					"content": "「博士」みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170108
					]
				},
				{
					"id": 30170108,
					"content": "でも、オイラたちを捕まえたいなら、なんで直接ファデュイに頼まないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170109,
						30170110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170109,
					"content": "現地の傭兵団の方が有利だしね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				},
				{
					"id": 30170111,
					"content": "ぺちゃくちゃ話す余裕があるとは、よほど命が惜しくないと見える。かかれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170112
					],
					"speakerTitle": "タシフィン"
				},
				{
					"id": 30170112,
					"content": "オ、オイラたちも、行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170110,
					"content": "教令院の資財を使ったんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				}
			]
		},
		{
			"id": 301703,
			"completionStepIds": [
				301703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
