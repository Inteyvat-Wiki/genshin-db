			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"タシフィン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170301,
					"content": "たしかに厄介だな、これが傭兵の中のエリートってやつか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170302,
					"content": "待ち伏せはこれだけじゃないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170303
					]
				},
				{
					"id": 30170303,
					"content": "そうだな、今後も警戒したほうがよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170304,
					"content": "でも「博士」って怖いやつだな。オイラたちがティナリのところに行くこともお見通しで、ここに待ち伏せさせたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170305
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170305,
					"content": "頭のいいやつを相手にするのって大変だぜ…引き続き進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 301704,
			"completionStepIds": [
				301704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301704",
							"2"
						],
						"stepId": 301704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"コレイ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170401,
					"content": "あれ？旅人にパイモン。どうして戻ってきたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170402
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170402,
					"content": "コレイ！また会ったな、元気だったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170403,
					"content": "あたしは…正直、あまり良くないんだ。最近、魔鱗病の悪化が加速してきててさ、細かい作業とかをこなすのが難しくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170404
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170404,
					"content": "だからティナリ師匠もパトロール任務には来なくていいって。残ってみんなの手伝いをすることだけ許してくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170405
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170405,
					"content": "そうだったのか…コレイ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170406,
					"content": "世界樹を治すことでしか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170407
					]
				},
				{
					"id": 30170407,
					"content": "ところで、ティナリはどこだ？パトロールか？オイラたち、あいつに用があって来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170408,
					"content": "師匠はつい最近アビディアの森を離れて、パルディスディアイに行ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170409
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170409,
					"content": "えっ？ティナリがここを離れたのか？でも…ティナリはずっとアビディアの森を離れることを嫌がって、賢者の誘いですら断ってただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170410,
					"content": "あたしもおかしいと思ってるんだ…師匠はずっとレンジャー長の仕事を重視してた。そう簡単には離れようとしなかったのに、今回はすごく急いで出て行ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170411
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170411,
					"content": "なにをしに行ったか聞いてないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170412,
					"content": "ううん、何も。それどころか、ここを発ったことすら書き置きで知ったんだ。色んな業務とかスケジュールについても書いてあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170413
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170413,
					"content": "あんなに急いで行ったってことは、きっと一刻を争うようなことが起きたんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170414
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170414,
					"content": "さっき言ったパルディスディアイって、どんなところなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170415,
					"content": "師匠は以前、教令院の生論派で学んでたんだ。パルディスディアイはその生論派の研究基地みたいな場所で、研究に使う珍しい植物を色々と植えてるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170416
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170416,
					"content": "師匠はレンジャー長になる前、パルディスディアイで長いこと学術研究をしてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170417
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170417,
					"content": "研究基地か…ティナリはいったいどんな研究をしようと思い立ったんだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170418,
					"content": "時間もないし、そのパルディスディアイってところに行ってティナリを探そうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170419,
						30170420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170419,
					"content": "体に気をつけて、コレイ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				},
				{
					"id": 30170421,
					"content": "あっ…うん、あたしは大丈夫だ。魔鱗病の症状になんかとっくに慣れてる。師匠に会ったら、よろしく伝えといて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170422
					],
					"speakerTitle": "コレイ"
				},
				{
					"id": 30170422,
					"content": "おう、わかったぜ。じゃあな、コレイ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170420,
					"content": "無理しないでね、コレイ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				}
			]
		},
		{
			"id": 301705,
			"completionStepIds": [
				301705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
