			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ナヒーダ",
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170501,
					"content": "あっ、あそこにいるのって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170502,
						30170503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170502,
					"content": "ナヒーダ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				},
				{
					"id": 30170504,
					"content": "やっぱり無事だったのか、よかった！オイラたち、すごく心配してたんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170505,
						30170506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170505,
					"content": "意識はナヒーダのだよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170507,
					"content": "おいっ、感動的な再会の雰囲気をこわすなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170508
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170508,
					"content": "パイモン、今の私を警戒するのはとても賢明な判断よ。何せ「博士」は、人の意識を操るような力を見せたんだもの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170509
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170509,
					"content": "別れてから私と「博士」に何が起こったのか、あなたたちは知らないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170510
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170510,
					"content": "災害レベルの暴雨の後は、地面に溜まった水が空に見えてしまうことと同じだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170511
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170511,
					"content": "うぅ…たしかにこんな変な比喩を使えるやつ、本物のナヒーダぐらいしかいなさそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170512,
						30170513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170512,
					"content": "#{M#俺}{F#私}もそう思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170514,
					"content": "ん？私は別に信用を得るために今の話をしたわけじゃないわ。ただより簡単に理解できるようにと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170515
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170515,
					"content": "まあまあ、もうわかったから。ナヒーダ、オイラたちが離れた後、なにが起きたのか教えてくれよ。あの市民たちはどうなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170516
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170516,
					"content": "あなたたちが離れてから、私は全力ですべての民の意識を修復していたわ。幸い「博士」の言っていた「情報を潜在意識に投入する」というのは、脳に直接書き込むわけじゃなくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170517
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170517,
					"content": "…人々の脳裏に幻覚を作り出すようなものだった。だから私の今の力でも解決できたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170518
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170518,
					"content": "彼が私をコントロールしようとした瞬間、全員の意識修復が完了した。だからすぐに、意識転移を使ってその場を逃れたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170519
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170519,
					"content": "ふぅ…「博士」の不意打ちなんか予想してなかったからな。ナヒーダがいてくれてよかったぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170520
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170520,
					"content": "それほどよくもないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170521
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170521,
					"content": "人々の意識を修復する過程において、「博士」は私の本当の身分を見抜いたわ。これで私たちの切り札がまた一枚減った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170522
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170522,
					"content": "それに…彼にアーカーシャ端末を改造する力があるのなら、私の意識を「捕獲」するのも時間の問題かもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170523
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170523,
					"content": "じゃあ、もう今までみたいに自由に意識を転移できなくなったってことか。いったいどうすれば…あいつは今教令院にいるし、たしかにまたアーカーシャに細工するかもしれないよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170524,
						30170525
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170524,
					"content": "急がないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170526,
					"content": "うぅ…なんだかもてあそばれてる感じだ。厄介な相手だぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170527
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170527,
					"content": "それに噂じゃ、「博士」は単純な武力だけでも確実に「第二位」の座につけるらしいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170528
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170528,
					"content": "まだ落ち込むには早いわ。突破口を探しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170529
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170529,
					"content": "おう。そういえば、ナヒーダはどうしてオイラたちがパルディスディアイに来ることを知ってたんだ？おまえもここで待ち伏せてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170530
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170530,
					"content": "ええ、私は旅人の元素力を感知することができる。力の移動する方向を頼りに場所を推測したの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170531
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170531,
					"content": "あなたたちも観光のためにきたわけじゃないんでしょ？何か手がかりを見つけたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170532
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170532,
					"content": "オイラたち、以前知り合った学者を探しに来たんだ。ティナリって言うんだけど、前に賢者に勧誘されてるのを見た。ナヒーダも一緒に行ってみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170533
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170533,
					"content": "ええ、行くわ。その彼を巻き添えにせずにすめばいいのだけれど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170525,
					"content": "このままじゃ後手後手になってしまう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170513,
					"content": "信じるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170506,
					"content": "「博士」に何かされてない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170503,
					"content": "キャサリン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				}
			]
		},
		{
			"id": 301706,
			"completionStepIds": [
				301706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301706",
							"2"
