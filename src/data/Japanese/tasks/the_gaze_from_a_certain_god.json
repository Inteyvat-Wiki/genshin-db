			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハイパシア",
					"ナヒーダ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170601,
					"content": "旅人？旅人ではありませんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170602
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170602,
					"content": "あっ！おまえは…ハイパシア！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170603,
						30170604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170603,
					"content": "久しぶり！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170605
					]
				},
				{
					"id": 30170605,
					"content": "本当ですわ。なんて嬉しいことでしょう、あなたたちに会えるなんてとっても幸運ですわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170606
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170606,
					"content": "この人は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170607
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170607,
					"content": "オイラたちがアビディアの森にいたときに会った、修行中の学者なんだ。あの時は…「サティアワダライフ」の段階にいたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170608
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170608,
					"content": "そうなの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170609
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170609,
					"content": "ええ、よく知っているお友達です。ここに来てからというもの、私と話をして下さる方はほとんどいませんでしたわ…本当に、ちょうどいいところに来て下さいました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170610
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170610,
					"content": "ハイパシア、喜びすぎだぞ。ところで、アビディアの森を離れるなんて、もう森で修行しなくてもいいのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170611,
					"content": "いや、待てよ…もしかして、修行が終わって、もう「パリプーナライフ」に入ったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170612,
					"content": "ふふっ…どうでしょうね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170613
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170613,
					"content": "私…意識の中で神に会いましたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170614
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170614,
					"content": "…ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170615
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170615,
					"content": "えっ？本当か！？よかったじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170616,
						30170617
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170616,
					"content": "自分の事みたいに嬉しいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170618
					]
				},
				{
					"id": 30170618,
					"content": "ふふふっ…あなたたちとこの崇高な喜びを分かち合うことができるなんて、なんと素晴らしいのでしょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170619
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170619,
					"content": "神と意識を交わすことができたあの瞬間は、比類なき至高の体験でした…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170620
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170620,
					"content": "そんなにすごかったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170651,
						30170652
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170651,
					"content": "実はティナリを探しに来た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170621
					]
				},
				{
					"id": 30170621,
					"content": "そうなんですの…あっ、少し待って下さいな。あなたたちとの約束を忘れていなくてよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170622
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170622,
					"content": "あのとき、もし私が真の知恵を手に入れたら、あなたたちがかつて世界樹で見たものを説明できるかも、と言いましたでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170623
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170623,
					"content": "今の私は、知恵を手に入れただけではございません。あなたたちの意識と神の意識を繋げるお手伝いだってできますのよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170624
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170624,
					"content": "そ、そんなことができるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170625,
					"content": "ナヒーダ、信じてもいいと思う？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170626
					]
				},
				{
					"id": 30170626,
					"content": "聞いたことはないわ。でも…試してみたいのなら、私はあなたの意識を全力で守る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170627
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170627,
					"content": "少し待っていて下さいな、パラハァムを少々持ってきますから。これは必要不可欠な「儀式」なんですの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170628
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170628,
					"content": "またあのお香か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170629
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170629,
					"content": "さて、では…私の手を握って下さいませ。意識を繋ぐ「通路」を作ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170630
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170630,
					"content": "ええ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170631
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170631,
					"content": "準備はよろしいかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170632
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170632,
					"content": "これは…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170633,
						30170634
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170633,
					"content": "マハールッカデヴァータの意識じゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170635
					]
				},
				{
					"id": 30170635,
					"content": "オイラたちが見たのって、「散兵」の過去なのか！？色んな情報が重なったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170636
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170636,
					"content": "でも、ハイパシアの言う「神」が「散兵」なんかとなんの関係があるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170637
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170637,
					"content": "ご覧になりましたか、感じましたか？崇高なる神、崇高なる意志、崇高なる感情を！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170638
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170638,
					"content": "はぁ…残念です、本当に残念です…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170639
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170639,
					"content": "私のこの胸の中で鼓動しているのは、ただの汚い人間の心…神よ、どうか私に慈悲を、私に救済を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170640
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170640,
					"content": "気づいているかしら？これは「パリプーナライフ」なんかじゃないわ。おそらく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170641
					],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170641,
					"content": "しっかりして、ハイパシア！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170642
					]
				},
				{
					"id": 30170642,
					"content": "あっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170643
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170643,
					"content": "ど…どうして怒鳴りつけるのですか？どうしてあの方たちは私を避けるのです？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170644
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170644,
					"content": "私は神の知恵を手に入れたのですわ。褒められるべきではありませんか。暗闇の中で探索を続け、光を見つけたのですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170645
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170645,
					"content": "ハイパシア…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170646
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170646,
					"content": "そうあるべきですのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170647
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170647,
					"content": "いえ、お待ちを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170648
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170648,
					"content": "まさか…私は気が狂ったのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170649
					],
					"speakerTitle": "ハイパシア"
				},
				{
					"id": 30170649,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170650
					]
				},
				{
					"id": 30170650,
					"content": "待って、辺りがおかしいわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヒーダ"
				},
				{
					"id": 30170634,
					"content": "キングデシェレトの意識でもない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170635
					]
				},
				{
					"id": 30170652,
					"content": "今は用事があるから、また今度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170621
					]
				},
				{
					"id": 30170617,
					"content": "ハイパシアはすごいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170618
					]
				},
				{
					"id": 30170604,
					"content": "まさかここで会えるなんて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170605
					]
				}
			]
		},
		{
			"id": 301707,
			"completionStepIds": [
				301707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301707",
							"2"
						],
						"stepId": 301707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ティナリ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170701,
					"content": "ここまでは追って来られないみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170702,
						30170703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170702,
					"content": "！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170704
					]
				},
				{
					"id": 30170704,
					"content": "大丈夫か、ナヒーダ…いや、違う！おまえ…この感じ、戻ってきたのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170705
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170705,
					"content": "ん？今度はまた旅人本人なの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170706,
						30170707
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170706,
					"content": "#うん、{M#俺}{F#私}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170708
					]
				},
				{
					"id": 30170708,
					"content": "さっきまでずっとナヒーダがおまえの体を操ってたんだ。キャサリンの人形が壊される直前に、意識を急いでおまえの体に移したみたいだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170709,
					"content": "そしたら…ティナリが騒ぎを聞きつけてやってきて、一緒に傭兵たちを倒してくれたんだ。それでここまで逃げてきたってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170710,
						30170711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170710,
					"content": "今回のはただの「意識転移」じゃない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170712
					]
				},
				{
					"id": 30170712,
					"content": "えっ？「交換」？もしかして、おまえの意識もナヒーダの体に入ってたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170713,
					"content": "それで、ナヒーダの意識はどうなったんだ？今どこにいるんだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170714
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170714,
					"content": "意識をこうして自由に転移させられるなんて、この目で見てなかったら信じられなかったよ…これは、まだ人が到達できる範疇のことじゃないだろうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170715
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170715,
					"content": "そうだ、さっき逃げるとき、君の肉体に入っていた意識から君への言伝を頼まれたんだ。彼女はこう言っていた——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170716
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170716,
					"content": "「『博士』はすでに意識を閉じ込めておく方法を見つけた。もう同行はできない。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170717
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170717,
					"content": "「けれど、たとえ『月』のない夜でも——『星の光』は『虚幻』と『嘘』を突き破ることができる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170718
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170718,
					"content": "うぅ…これでナヒーダは完全に「スラサタンナ聖処」に閉じ込められたってことか。まずいぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170719
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170719,
					"content": "ナヒーダが言い残したのはそれだけか？わけがわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170720,
						30170721
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170720,
					"content": "#{M#俺}{F#私}たちにしか分からない「隠語」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170722
					]
				},
				{
					"id": 30170722,
					"content": "あっ、そっか！「博士」はもうナヒーダの意識をとらえてるから、ナヒーダがなにを言ったかわかっちゃうんだもんな。慎重なんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170723,
					"content": "「たとえ『月』のない夜でも、『星の光』は『虚幻』と『嘘』を突き破ることができる。」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170724
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170724,
					"content": "「月」と「虚幻」と「嘘」は、花神誕祭のときの錬金占いだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170725
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170725,
					"content": "「星の光」もナヒーダが前に使ってた比喩だったような…たしか、セタレに関係があったか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170726,
						30170727,
						30170728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170726,
					"content": "「月」はナヒーダ自身。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170729,
					"content": "おお！そう言えばそうだったな。つまりナヒーダは、砂漠に助けを求めに行けって言いたかったのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170730,
					"content": "でもナヒーダがいない今、オイラたちだけで大丈夫かな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170731
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170731,
					"content": "パイモン、今「スラサタンナ聖処」って言った？君たちの言う「ナヒーダ」…つまり旅人の身体の中にいた意識は…もしかして、草神様なわけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170732
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170732,
					"content": "えっと…たしかにあってるけど、今は複雑な状況で、ちょっと説明するのが難しくて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170733
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170733,
					"content": "いや、大丈夫。学者の好奇心は何も、時と場所を完全に選ばないわけじゃない。状況がどれほど複雑なのかは、丁度さっきこの目で見てるしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170734
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170734,
					"content": "君たちとはひとときを共に過ごした仲だし、クラクサナリデビ様も君たちの味方みたいだから…僕は君たちを信じるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170735
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170735,
					"content": "おう！ありがとな、ティナリ。そうだ、オイラたち前から聞きたかったんだけど、賢者たちの進めてる「プロジェクト」についてなにか知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170736
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170736,
					"content": "それが…僕は確かにプロジェクトに参加しろって誘われたけど、賢者たちは一切その詳細を話してくれなかった。だから断ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170737
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170737,
					"content": "僕が知っているのは、プロジェクトが「世界樹の修復」と関係してるかもってことだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170738,
						30170739
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170738,
					"content": "プロジェクトの内容が大体わかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170740
					]
				},
				{
					"id": 30170740,
					"content": "ん？ナヒーダと意識を交換してたときになにか見たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170741
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170741,
					"content": "教令院は…散兵を「神にする」手伝いをしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170742
					]
				},
				{
					"id": 30170742,
					"content": "えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170743
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170743,
					"content": "…根拠は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170744,
						30170745
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170744,
					"content": "造られている途中の「神の未完成品」を見た。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170746
					]
				},
				{
					"id": 30170746,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170747
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170747,
					"content": "ナヒーダと意識を交換した時に見たものを説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30170748
					]
				},
				{
					"id": 30170748,
					"content": "そうか、なるほど…どうりでハイパシアの症状が以前の狂った学者たちとは違うと思った。今生まれようとしてる、新たな神の意識に触れたからだったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170749
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170749,
					"content": "ティナリはハイパシアのためにアビディアの森を離れたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170750
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170750,
					"content": "そう、ハイパシアの精神の異常に気づいたんだ。だけど症状が特殊だったから、こっそり彼女をパルディスディアイまで連れてきて、彼女を元に戻す方法を探ろうとした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170751
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170751,
					"content": "そうでもしなければ、今頃彼女はマハマトラたちによって砂漠のアアル村に追放されていただろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170752
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170752,
					"content": "ところで、僕も以前から教令院がクラクサナリデビ様を軽視していることは知っていたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170753
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170753,
					"content": "まさか「新たな神の創造」なんて傲慢でうぬぼれたことをしようとしてたなんてね。誘いを受けなくて正解だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170754,
						30170755
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170754,
					"content": "ファデュイも裏で糸を引いてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
				{
					"id": 30170756,
					"content": "「博士」と「散兵」…ファデュイの執行官が二人もスメールにいるのか…先が思いやられるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170757
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170757,
					"content": "でも君の説明からすると、「プロジェクト」はまだ完全には終わってない。つまり、まだやつらを止める余地はあるってことだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170758
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170758,
					"content": "「新たな神の創造」と「世界樹の修復」に、一体どんな繋がりがあるのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170759
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170759,
					"content": "うぅ…賢者たちの目的は、未だにはっきりわかってないんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170760,
						30170761
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170760,
					"content": "まずは砂漠に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170762,
					"content": "おう、今ある情報もだいぶ整理できたしな。まずは行動しようぜ…ティナリ、なにか考えはないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170763
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170763,
					"content": "僕はひとまずここに残る。ハイパシアのほうも、なんとかしてあげたいしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170764
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170764,
					"content": "砂漠に行くなら、まずはキャラバン宿駅に行くといいよ。あそこが砂漠地帯へ行く一番便利なルートだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170765
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170765,
					"content": "何か僕に手伝えることがあったら、ここまで来てくれ。君たちに知恵が訪れますように。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170766
					],
					"speakerTitle": "ティナリ"
				},
				{
					"id": 30170766,
					"content": "おう、ハイパシアがよくなるといいな。それじゃまたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 30170761,
					"content": "なんとしても阻止しないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170755,
					"content": "ファデュイに後押しされたのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
				{
					"id": 30170745,
					"content": "ハイパシアが見せてくれた「神の意識」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170746
					]
				},
				{
					"id": 30170739,
					"content": "さっき新たな情報を手に入れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170740
					]
				},
				{
					"id": 30170727,
					"content": "「星の光」は砂漠の民。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170728,
					"content": "「虚幻と嘘」は教令院の計画。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170721,
					"content": "「博士」に次の行動を知られないため。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170722
					]
				},
				{
					"id": 30170711,
					"content": "今のは「意識交換」だった…",
					"roleType": "TALK_ROLE_PLAYER",
