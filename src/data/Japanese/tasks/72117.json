			"dialogs": [
				{
					"id": 721170101,
					"content": "旅人、ちょうどいいとこに来た。データの収集がそろそろ終わるから、ビーコンを回収してほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721170102,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "では頼んだ。ファデュイに見つからないうちに、なるべく早く戻って来てほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721170104,
					"content": "どうして分かるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "このビーコンを製作する時、詳しい取扱説明書が付いていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721170106,
					"content": "さまざまな状況に応じた説明が書かれていて、それによってデータの収集時間も違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "グザヴィエ"
				},
				{
					"id": 721170107,
					"content": "「祟り神」といった「未知のエネルギー」に属するものは、最も時間が掛かるからそこから計算した…とりあえず、ビーコンの回収は頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "グザヴィエ"
				}
			]
		},
