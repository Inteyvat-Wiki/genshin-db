					"nextDialogs": [
						721170303
					]
				},
				{
					"id": 721170303,
					"content": "よかった。あとはそのデータを参照して装置を微調整する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170304
