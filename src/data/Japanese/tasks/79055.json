			"dialogs": [
				{
					"id": 790550101,
					"content": "これは『折れた船の古き夢』の撮影でボツとなったシーン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790550102,
					"content": "もともと構想していた物語は、海を漂流する折れた船で、二人の水形幻霊が恋に落ちるものだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790550103,
					"content": "水形幻霊たちが互いに気持ちを打ち明けた後、夕日の中で船首に立つシーンは、それはもうロマンチックなことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790550104,
					"content": "それでも、このシーンがボツとなった理由は…役者として水形幻霊では性格が活発すぎて、動きを止めることができなかったからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790550105,
					"content": "はぁ、<color=#00E1FFFF>二人同時に船首にいる</color>シーンを収められたら良かったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "撮影地の備考"
				},
				{
					"id": 790550106,
					"content": "——「監督」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "撮影地の備考"
				}
			]
