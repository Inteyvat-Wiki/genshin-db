					"アイオーヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "ちょ…ちょっと！何するんですか！彼らはパレ·メルモニアの忌々しいやつらとは違うんですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190802,
					"content": "つい、うっかり…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "はぁ…とっさのことで止めようもありませんでした。どうしてあんなことを？もしかして、紫金オオズグロカモメが攻撃でもしてきたんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190804,
					"content": "とにかく、紫金オオズグロカモメたちは皆、飛んで行ってしまいました。仕方ありません…数日後、お詫びに私が何か餌を持っていってあげますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				}
			]
		},
