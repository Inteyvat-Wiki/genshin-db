			"trigger": {
				"objectNames": [
					"アイオーヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "これくらいで十分かな。お腹いっぱいになるといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190102,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "紫金オオズグロカモメたちにエサをあげてるんです。見てください、ちゃんとお腹いっぱいになってくれたみたいですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190104,
					"content": "うわぁ…おまえ、いつの間に紫金オオズグロカモメたちとそんなに仲良くなったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240190105,
					"content": "フィッシュアンドチップスは取られない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "はい。しょっちゅうエサをあげにくる人がいますから、紫金オオズグロカモメたちは私のフィッシュアンドチップスなんかに興味を示さないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190107,
					"content": "でも、この前は職場から離れすぎるとマズいって言ってなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240190108,
					"content": "はははっ、大丈夫ですよ。今日は貴重な休日ですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190109,
					"content": "ここには仕事の話をしてくる同僚もいないし、僕のフィッシュアンドチップスを取る人や動物もいない…一息つくには最高の場所です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190110,
					"content": "それに、ここの紫金オオズグロカモメたちはとても人懐っこくて、フィッシュアンドチップスを取ったり、懐に飛び込んできて暴れたりもしないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190111,
					"content": "何度か自分からエサをあげたら、紫金オオズグロカモメたちも私のことを覚えてくれたみたいで。私が羽を撫でても嫌がらないんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190112,
					"content": "パレ·メルモニアの周辺にいる紫金オオズグロカモメたちと比べたら、紳士と呼んでもいいくらいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190113,
					"content": "もし彼らが爪を使ってタイプライターを叩くことを覚えたら、私たちの仕事のほとんどを代われるかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190114,
					"content": "カモメが人間の手伝いをすることはないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "でも少なくとも、紫金オオズグロカモメが事態を悪化させることはないでしょう。それに、一部のことは紫金オオズグロカモメにとって難しすぎて、そもそも不可能ってことをみんな知っていますし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190118,
					"content": "まあ、こんな話は置いといて…あなたも「紳士」たちと友達になってみませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190119,
					"content": "もはや、紳士呼びしてるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240190120,
					"content": "いきなり近づいたら気分を害すかも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "いえ、紳士たちはとても心が広いんです。直接羽を触らなければ大丈夫ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190124,
					"content": "さあ、こちらを——僕が独自に加工した魚肉です。これをお皿に置いてみてください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190125,
					"content": "リラックスしてください。紫金オオズグロカモメはとても心が広いので、エサをくれる人には好意を持ってくれますよ。この魚肉の産地や製法について、聞いてくることもありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190122,
					"content": "友達になるには、何に気を付ければいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "特別なことはありませんよ。ただ直接羽を触らなければ大丈夫です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240190116,
					"content": "カモメは人の話を理解できないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "それはどうでしょう？ひょっとすると彼らは理解できないフリをすることで、自分の生活を快適にさせているのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "アイオーヌ"
				}
			]
		},
