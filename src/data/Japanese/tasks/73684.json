			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フィンケル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736840101,
					"content": "えー、冒険者の皆さん、寄ってらっしゃい、見てらっしゃい。協会では新しいイベントを開催——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840102
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840102,
					"content": "このイベントに参加すれば、協会からの報酬だけじゃなく、追加のプレゼントまで——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840103,
						736840104
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840103,
					"content": "冒険者協会でイベント？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840105
					]
				},
				{
					"id": 736840105,
					"content": "あなたは…旅人さんじゃないっすか！これはこれは、こんなところで先輩に会えるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840106
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840106,
					"content": "ご覧の通り、今、協会のあるイベントのために参加者を募集してるんっすよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840107
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840107,
					"content": "初めての協会からの正式なお仕事なんで、しっかりやんないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840108
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840108,
					"content": "今回のイベントについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840109
					]
				},
				{
					"id": 736840109,
					"content": "あっ、そうだった！すんません、先輩はまだ今回のイベントを知らないんすよね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840110
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840110,
					"content": "今回のイベントはジャック先輩が「野を越えた追跡」って名前にしたんすけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840111
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840111,
					"content": "ジャック先輩が言うには「簡単で面白くて、冒険者自身の実力を検証できる」イベントだそうっす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840112
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840112,
					"content": "具体的に言うと、各地に「野跡風船」を設置する、みたいな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840113
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840113,
					"content": "そんで冒険者たちは、ヒントを参考にして「野跡風船」を見つけて、風船の分布の軌跡に沿って進むんすよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840114
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840114,
					"content": "限られた時間でより多くの「野跡風船」を集められれば、より評価は高くなり、報酬も増える、ってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840115,
						736840119
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840115,
					"content": "その風船を割ったら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840116
					]
				},
				{
					"id": 736840116,
					"content": "風船は特注品っすよ。普通の弓の射撃くらいなら耐えられるんで、近いところからしか割れないっす。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840117
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840117,
					"content": "まあ、前もこういうイベントをやったんすけど、冒険者たちは風船を見た瞬間、さって弓を上げて射るんすよね。何度言っても覚えてくれないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840118
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840118,
					"content": "だから今回、協会はこの特注風船をつかうことにしたんすよね。効果あるといいけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840124
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840124,
					"content": "あっ！雑談してる場合じゃなかった。参加者を募集しないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840125
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840125,
					"content": "まあ、興味があったら、参加してみてくださいよ！もし今回のイベントに参加してくれたら、ジャック先輩とサイリュス会長もきっと喜ぶっすから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840119,
					"content": "ただの長距離走じゃないの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840120
					]
				},
				{
					"id": 736840120,
					"content": "あー…ジャック先輩が言うには…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840121
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840121,
					"content": "「風船を探すのは冒険者たちの『洞察力』を検証するためさ。色んな環境で進み続けることは冒険者たちの『基礎』を検証するためで…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840122
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840122,
					"content": "「『ヒントに沿って行動する』というのは冒険者たちの『規律』を検証するもの…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840123
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840123,
					"content": "俺も協会に入ったばっかなんで、この手の事はよくわからないんすけど…でもジャック先輩が言うんだし、なんか絶対それなりの理屈があるんじゃないっすか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736840124
					],
					"speakerTitle": "フィンケル"
				},
				{
					"id": 736840104,
					"content": "今度は何をやってるの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736840105
					]
				}
			]
		}
	]
}