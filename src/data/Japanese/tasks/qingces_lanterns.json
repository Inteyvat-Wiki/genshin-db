					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313705,
					"content": "若心ばあちゃん、早く食べないと、私が作った料理が冷めちゃうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313706
					],
					"speakerTitle": "小白"
				},
				{
					"id": 413313706,
					"content": "わぁ、美味しそうな食べ物がいっぱい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313707
					],
					"speakerTitle": "六"
				},
				{
					"id": 413313707,
					"content": "ばあちゃん、いってくるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313708
					],
					"speakerTitle": "トントン"
				},
				{
					"id": 413313708,
					"content": "もうこの子たちったら…いいよ、行っておいで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313709
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313709,
					"content": "行かないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313710
					]
				},
				{
					"id": 413313710,
					"content": "私かい？もう少し霄灯を見てるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313711
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313711,
					"content": "そうじゃ、これを受け取ってくれ。手伝ってくれて嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313712
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313712,
					"content": "ありがとう、おばあちゃん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413313713
					]
				},
				{
					"id": 413313713,
					"content": "いいんじゃよ。若いのにそんなに頑張って…疲れたじゃろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313714
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313714,
					"content": "ここで一息ついて、祭りを楽しんでおくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413313715
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413313715,
					"content": "休める時は、休んだほうがいい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
