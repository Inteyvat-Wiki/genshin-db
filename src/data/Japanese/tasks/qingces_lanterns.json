			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413310201,
					"content": "また海灯祭の時期になったのう、はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310202
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310202,
					"content": "何か心配？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310203
					]
				},
				{
					"id": 413310203,
					"content": "海灯祭はもっと賑わうものなんじゃがのう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310204
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310204,
					"content": "ここ軽策荘は…老いぼれと小さい子供ばかりなんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310205
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310205,
					"content": "都会に出稼ぎに行ってる子たちも、仕事で帰ってこられないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310206
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310206,
					"content": "もしくは遠すぎて間に合わないんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310207
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310207,
					"content": "みんなが集まるせっかくの祭りなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310208
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310208,
					"content": "外で大変なのは分かるが、それでも祭りだけはのう…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310209
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310209,
					"content": "まあ、もう何も言わんわい。祭りなのにこんなこと考えてはいかんの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310210
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310210,
					"content": "そうじゃ、もしよかったら、小白を手伝ってくれんかのう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310211
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310211,
					"content": "あの子はみんなに料理を準備するために忙しいみたいじゃ、一人で大丈夫か不安でね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413310212,
						413310213
					],
					"speakerTitle": "若心"
				},
				{
					"id": 413310212,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				},
				{
					"id": 413310214,
					"content": "じゃあ頼んだよ、ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 413310213,
					"content": "手伝うから心配しないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413310214
					]
				}
			]
		},
