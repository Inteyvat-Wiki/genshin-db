			"dialogs": [
				{
					"id": 760540101,
					"content": "あれ？コロンビーナは？どこにもいないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540102,
					"content": "ここだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540103,
					"content": "わっ！なんでそんな高いとこにいるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540104,
					"content": "こっちきて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540105,
					"content": "ええっ？今度はなんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540106,
					"content": "前に集めた石のこと、覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540107,
					"content": "石？ああ、クーヴァキを吸収して光る、あの鉱石か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540108,
					"content": "うん。あの後、月霊がまたいくつか集めてくれたの。私たちはその石を、明るい色と暗い色に分けた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540109,
					"content": "明るい色と暗い色？なんでだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540110,
					"content": "「月並べ」をやるんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540111,
					"content": "えっ、？つ…「つきならべ」ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540112,
					"content": "やったことないの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540113,
					"content": "ない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "そうなんだ…昔「霜月の子」のみんなが地面にマス目を描いて遊んでたのを見て、ずっとやってみたかったの。でも、一緒に遊んでくれる人なんていなかったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540115,
					"content": "具体的にはどんなルールなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540116,
					"content": "うーん…こうやって説明した方がわかりやすいかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540117,
					"content": "わっ！！す、すごい…どうやってやったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540118,
					"content": "えっ？クーヴァキを使っただけだよ。できないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540119,
					"content": "オイラたちは神様じゃないんだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540120,
					"content": "そっか。これが盤面…ゲームで言う「夜空」。二人が持ってる石は「月」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540121,
					"content": "二人は交互に「月」を「夜空」に置いていく。先に三つの「月」を一直線に並べられた人が勝ち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540122,
					"content": "おお！三つの石を一直線に並べるゲームってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540123,
					"content": "このゲーム、ナド・クライでは「月並べ」っていうのか…ここらしい呼び方だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540124,
					"content": "でも、「月」は巡ってく。夜空に「月」は三つより多くは存在できないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540125,
					"content": "だから「夜空」の「月」が一定数に達すると、最初に昇った「月」は消えちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540126,
					"content": "な…なるほど…ちょっと複雑になったな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540127,
					"content": "うん。やってみる？私も初めてだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760540128,
					"content": "（すごくやりたそう…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "へへっ、じゃあオイラは審判になるぞ！こいつ、すごく頭の回転が早いから、気をつけろよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 760540130,
					"content": "わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
