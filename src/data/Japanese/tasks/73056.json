			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハイヤーム",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "ははっ、実に愉快じゃ…これでこの森も…良くなるじゃろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560102,
					"content": "よう！じいちゃん、迷子か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560103,
					"content": "はあ…？カイコ…？ん、わしに何か用かね？ああ、ははっ、迷子と言ったのかな？いやいや、そうではないんじゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560104,
					"content": "やあ、子供たち。わしは生論派のダステアで、ギャシ·ハイヤームじゃ。ははっ…ハイヤームと呼んでくれたまえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560105,
					"content": "うーんと…初めまして。ハイヤームさん！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560106,
					"content": "そうではない…こうやって舌先をグッと下げてから巻く…ハイ——それから唇を丸くして…ヤ——最後に自然に口をすぼめて…ム——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560107,
					"content": "えっと…ハイ——ヤ——ム——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560108,
					"content": "そうじゃ！よくできたな！よし、金髪の君も言ってみたまえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560109,
					"content": "ハイ——ヤー…ム…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "ははっ、いいぞ！白いおチビさんよりずっといい！な？だから、わしにも音声学が教えられると言ったんじゃ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560113,
					"content": "だから、ハイヤームさん…迷子でもないのに、こんなとこでなにしてるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560114,
					"content": "何をしているかだって？くくっ…わしは森林学者じゃ。我々にとって森は家も同然。久しぶりの帰宅だからといって、わしが迷子になると思うかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560115,
					"content": "いやあ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560116,
					"content": "この森は「死域」に侵略され、この三十年で植物は数を減らし、種類も激減した。逆に有害なキノコ類は増える一方じゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560117,
					"content": "じゃが、最近になって「死域」が消えた。一度は消滅の危機に瀕した植物が再生したと同時に、キノコ類の繁殖力は弱まりつつある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560118,
					"content": "これと同じケースは、六十年前に一度見たきり…だから、わしの止まったままの思考を検証するために、ここに来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560119,
					"content": "そうなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560120,
					"content": "思考の検証について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "ははっ、もう六十年も前のことじゃ…老いぼれの記憶力には期待せんでくれよ。じゃが、「死域」の消滅があの件と関係していることだけは確かじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560122,
					"content": "だから、その推理を裏付けるために、この洞窟に入ってサンプルを集めてこようと思ったんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560126,
					"content": "そっか…でも、洞窟の「マラーナ」は消えたけど、それでもまだ危険だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560127,
					"content": "ははっ、わしに言わせれば、大したことではないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560128,
					"content": "ん、待て…今、何と言った？洞窟の…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560129,
					"content": "「マラーナ」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "ふむ…そうだな。確かに君たちの助けが必要かもしれん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560132,
					"content": "ふふんっ、だから言っただろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560133,
					"content": "はは、失礼した…まだ君たちの名を聞いていなかったね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560134,
					"content": "#{NICKNAME}って呼んで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "オイラはパイモン！パ·イ·モ·ン！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560136,
					"content": "パイモン？パイモンか…ほほっ、これは愉快な名前じゃ…人から…いや精霊からそんな名前を聞いたのは初めてじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560137,
					"content": "おっと、これは大変失礼した…わしが言いたかったのは、このおチビさんのことじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560138,
					"content": "誰がチビだ！十分失礼だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560139,
					"content": "いやはや、無駄話はこれくらいにして。「ジエマン」たち、一緒に来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560140,
					"content": "「ジエマン」…ってなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560141,
					"content": "我が故郷の古い言葉で、「勇敢な若者」という意味じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560142,
					"content": "正確には…「巨悪に立ち向かい、大きな不正と勇敢に戦う若者」という意味じゃの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560143,
					"content": "ふふんっ、まさしくオイラたちのことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560144,
					"content": "ほう？自負しておるのか？ははっ、それなら着いてきなさい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560145,
					"content": "あれ？ハイヤームさん、その足で本当にオイラたちについて来られるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560146,
					"content": "ははっ…わしには三十年も森の調査をしてきた経験がある。お年寄りの体力を舐めるでないぞ！君たちは好きにゆくがいい、すぐに追いつくからの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560130,
					"content": "「死域」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "手伝おうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "ははっ…それはご親切に。だが体は老いても、頭は若い頃のままじゃ。わしを甘く見てもらっては困るぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560125,
					"content": "森のご機嫌をとって、自分の身を守る方法くらい知っておる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560111,
					"content": "ハイヤームさん、ここで何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "ん…君は早口が過ぎるな。まぁいい…少しゆっくり話してみたまえ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "ハイヤーム"
				}
			]
		},
		{
