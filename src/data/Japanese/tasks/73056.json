						730560718
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730560718,
					"content": "ほら、思い出しただろ？おまえもオイラたちに同じ花をくれたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560719
					],
					"speakerTitle": "パイモン"
				},
