					"nextDialogs": [
						730560602
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560602,
					"content": "そうそう、もしよければ…大したものではないんじゃが、記念にこれを受け取ってほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560603
					],
