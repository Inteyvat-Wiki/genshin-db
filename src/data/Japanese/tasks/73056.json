			},
			"dialogs": [
				{
					"id": 730560301,
					"content": "面白い…この植物たちは…息を吹き返したようじゃ。「マウティイェマ」がまた役に立ったのだな…実に不思議じゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560302
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560302,
					"content": "あれ…ハイヤームさんも「マウティイェマ」を知ってるのか？アランナラしか知らないと思ってたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560303,
					"content": "パイモン、しっ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "今「アランナラ」と言ったか？君たちも彼らに会ったのだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560306,
					"content": "え…？あ…う、うん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560307,
					"content": "ハイヤームさん、どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "「イラムは薔薇と衰えて…ジャムシードの聖杯はいずこかへ…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560310
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560310,
					"content": "では次の場所に移動しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560308,
					"content": "#{M#君}{F#あなた}もアランナラに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560304,
					"content": "パイモン…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				}
			]
		},
		{
			"id": 7305604,
			"completionStepIds": [
