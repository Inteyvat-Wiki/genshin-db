						730560607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560606,
					"content": "これは…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "そうじゃ。わしの推測が正しければ…君たちも同じものを贈られたのではないかね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560609,
					"content": "ははっ…わしらの出会いは、単なる偶然ではないと分かっていた…わしは偶然などというものを信じない性質じゃからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560610,
					"content": "この花を、君に預ける。どうかわしらの共通の友人に渡してほしいんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560611,
					"content": "うん、別にいいけど。ただ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560612,
					"content": "#彼らは{M#俺}{F#私}を覚えてないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560613
					]
				},
				{
					"id": 730560613,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560615
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560615,
					"content": "わしはもう、彼らには会えん…彼らの存在すら信じられなくなった…あれは幼き日の幻に過ぎないのかもしれないとな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560616,
					"content": "だがそれでもやはり、これを彼らに渡してほしいのだ…君が彼らに会えるうちに、奇跡が起きる可能性があるうちに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560614,
					"content": "#彼らは{M#君}{F#あなた}を覚えてないかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560615
					]
				},
