			"dialogs": [
				{
					"id": 730560701,
					"content": "なんでここに来た、キミたち？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560702
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730560702,
					"content": "うわっ！びっくりしたあ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560703
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560703,
					"content": "ボクの名前を知ってる、キミたち。でも、ここでキミたちに会ったのは初めて、アランナガ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560704
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730560704,
					"content": "だから…なんでここに来た、キミたち？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560705,
						730560708
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730560705,
					"content": "その、うまく説明できないんだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560706
					]
				},
				{
					"id": 730560706,
					"content": "おまえは色々忘れちゃってるかもしれないけど、オイラたち、悪意はないぞ。いつまでもおまえたちの味方だし、「マウティイェマ」を助ける！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560707
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560707,
					"content": "「マウティイェマ」…キミたち知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730560710,
					"content": "ふーん…悪人には見えないな、キミたち。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560711
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730560711,
					"content": "でも留まらないで、ここには。早く立ち去って、キミたち。いま回復している、森…だから、留まっちゃいけない、新しいお客さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "アランナガ"
				},
				{
					"id": 730560712,
					"content": "あっ…ちょっと待ってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560713
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560713,
					"content": "渡したいものがあるんだ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560714
					]
				},
				{
					"id": 730560714,
					"content": "もの、ボクに？",
