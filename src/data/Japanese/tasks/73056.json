						730560604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560604,
					"content": "君たちも、この風に乾いた小さな花に見覚えがあるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "ハイヤーム"
				},
				{
