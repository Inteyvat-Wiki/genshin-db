			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハイヤーム",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "おおっ！これを見たまえ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560402,
					"content": "え？新種の植物か？なにをそんなに興奮してるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560403,
					"content": "いや、新種の植物よりも嬉しいものを見つけたんじゃよ！…見てごらん、わしらの「秘密の城」じゃ！もうすっかりボロボロになっているがね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560404,
					"content": "え…？「秘密の城」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560405,
					"content": "ははっ、学者オマールが星々の秘密を携えて帰ってきたぞ！イルファンとシマンはどこにいる？早く出て来い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560406,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560407,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "おっと…ゴホンッ、すまない。少し…興奮しすぎたようじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560409,
					"content": "年を重ねると、目の前のことよりも、昔のことをしきりに思い出すものでね。ははっ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560410,
					"content": "イルファンとシマンは、わしの友達じゃ。三人で一緒にこの「城」を作った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560411,
					"content": "あの頃はイルファンが演奏家でシマンが元帥、わしが占星学者だった。時々入れ替わることもあったがね。子供というのは…飽きればすぐに目先を変えたがるもんじゃからの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560412,
					"content": "イルファンはウードが得意じゃった。背が高くて腕っぷしの強いシマンには誰も勝てんかった。わし？ははっ、わしは勉強がほんの少し得意なだけのお坊ちゃんじゃったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560413,
					"content": "子供の頃、いつもここで遊んでたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "いや、ここはわしらの秘密の国じゃったからの、とても慎重に扱っていた。わしらは大きくなったら「再興軍」を作って城を取り戻そうと、かたく誓い合ったものだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560418,
					"content": "ははっ、二十年が過ぎた頃じゃった。みなはすっかり「城」のことを忘れていての…そこでわしはここを、森林研究の小さな拠点として三十年前まで使っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560419,
					"content": "その後「マラーナ」が現れたが、「再興軍」は姿を見せなかった。ははっ、それもそうじゃ…子供の約束が、死を追い払えるはずもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560420,
					"content": "でも…ハイヤームさんはみんなのことを覚えてるんだし、みんなだって絶対同じだと思うぞ。そう落ち込むなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560421,
					"content": "落ち込む？いやいや、落ち込んでなどいないよ。子供たちの「幻の友達」は、大人の世界にはいない。少し残念な気もするが…時間はもう戻らないんじゃ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560422,
					"content": "「幻の友達」って…まさかアランナラ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730560423,
					"content": "パイモン…しーっ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560426,
					"content": "ははっ…これはいかん。新しい植物のサンプル採集のために君たちを呼んだのに、つい無駄話をしてしまったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560427,
					"content": "余計な話をしてしまってすまんの。さあ、作業を続けよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560424,
					"content": "パイモンてば、余計だよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "#全部、{M#君}{F#あなた}たちが残していったの…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "いやいや、全部ではないよ。あの頃はみんなと、大きくなったら「再興軍」で兵をあげてこの土地を奪還しようと約束したものだ…ははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "ハイヤーム"
				},
				{
					"id": 730560417,
					"content": "その後、教令院で植物学を専攻したわしはこの地に舞い戻り、ガラクタを出し入れして改装を進めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "ハイヤーム"
				}
			]
		},
