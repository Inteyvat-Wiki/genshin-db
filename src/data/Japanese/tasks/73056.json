					"nextDialogs": [
						730560734
					]
				},
				{
					"id": 730560734,
					"content": "でも畑に誘ってくれた…つまり、友達になってもいいってことだよな？暇になったら一緒に行ってみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
