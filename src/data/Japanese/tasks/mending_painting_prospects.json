	"talks": [
		{
			"id": 7152101,
			"completionStepIds": [
				7152101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7152101",
							"2"
						],
						"stepId": 7152101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バトロ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715210101,
					"content": "次の絵は…うん、これだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210102
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210102,
					"content": "何をしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210103
					]
				},
				{
					"id": 715210103,
					"content": "#君が…噂の{NICKNAME}さんか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210104
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210104,
					"content": "多くの同僚から名前は聞いているよ、今回の盛宴に来ていただけるだろうかと思っていたところさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210105
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210105,
					"content": "まさかここでお会いできるなんて、実に光栄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210106
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210106,
					"content": "紹介したいものはたくさんあるけれど、その前にまずは自己紹介を。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210107
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210107,
					"content": "私はバトロ、画家だ…この職業についてはもうご存知だろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210108
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210108,
					"content": "だが私にはそれ以外にも「絵画修復師」という身分がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210109
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210109,
					"content": "どんな破損…火事や鼠の食害、カビや腐敗などに遭った絵でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210110
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210110,
					"content": "私に任せれば！一番完璧だった頃の輝きを取り戻せるだろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210111
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210111,
					"content": "絵画修復…元の絵をそっくり描くの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210112
					]
				},
				{
					"id": 715210112,
					"content": "ハハハ、いやいや。元の絵に合わせて描き直すのは「なぞる」としか言わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210113
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210113,
					"content": "我々は絵を最初の形に修復するのだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210114
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210114,
					"content": "色、筆使い…キャンバスの素材まで。どんな細かいところも元の絵とそっくりそのままにするんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210115,
						715210116
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210115,
					"content": "本当に複雑そうだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210117
					]
				},
				{
					"id": 715210117,
					"content": "だろう？絵の修復には優れた画法、さらには絵に対するきめ細かい観察力が求められる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210118
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210118,
					"content": "だがそれが…助っ人を集められない理由なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210119
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210119,
					"content": "画家であると同時に高い画法と、きめ細かな観察力を持つ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210120
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210120,
					"content": "そんな人が自分の絵を描かず、他人の絵の修復に来てくれるわけがないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210121
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210121,
					"content": "おまけに絵の修復なんて金にならないし、往々にしてものまねしか能のない三流画家だと思われる仕事だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210122
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210122,
					"content": "でもどんな仕事でも、誰かが引き受けなきゃいけないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210123
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210123,
					"content": "絵とは尊いものだ。優れた絵は歴史や物語や感情を伝え…さらには市場価値を生み出す。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210124
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210124,
					"content": "誰に何と言われようが、画家として私は絵を朽ちさせるわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210125
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210125,
					"content": "…だが繰り返しになるが、金にはならず誤解される仕事だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210126
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210126,
					"content": "人手集めに励んでいるものの、まだ私だけでこの仕事をしている状態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210127
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210127,
					"content": "今回ここへ来たのも、私の仕事を皆に宣伝して多くの人に来てもらうためだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210128
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210128,
					"content": "なのに…人手も集まらないまま、古画の修復を多く請け負ってしまって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210129
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210129,
					"content": "モンドや璃月の絵で、山水、人物、動物…それに…子供のクレヨン画…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210130
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210130,
					"content": "クレヨン画の修復もできるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210131
					]
				},
				{
					"id": 715210131,
					"content": "その…原則として絵なら何でも修復を承っているんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210132
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210132,
					"content": "それに子供が心血を注いだクレヨン画だ、彼らの芸術への第一歩だったかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210133
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210133,
					"content": "だから親が修復を頼んできたのも…自然なことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210134,
						715210136
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210134,
					"content": "不本意そうな顔をしてるけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210135
					]
				},
				{
					"id": 715210135,
					"content": "え？まさか！不本意ではない、ただ…ただ…クレヨン画の知識をいくらか覚えなきゃいけないだけで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210138
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210138,
					"content": "#{NICKNAME}さん、もしよければご協力いただけるかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210139
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210139,
					"content": "ご覧の通りここには私だけ…だが絵の修復のためには構図を取らなければ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210140,
						715210141
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210140,
					"content": "そんなことまでするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210142
					]
				},
				{
					"id": 715210142,
					"content": "ああ。それ以外にも、絵に関する様々な資料を探さなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210143
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210143,
					"content": "景色が描かれた時代の様子や、描かれた動物の形について…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210144
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210144,
					"content": "幸運にも、急ぎの依頼絵は比較的最近のものだから、景色もそれほど変わっていないはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210145
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210145,
					"content": "構図取りに行く準備をしているが…野外は危険で、絵筆しか持てない人が冒険するのはよろしくない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210146
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210146,
					"content": "だから…私の代わりに行ってきてくれないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210147
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210147,
					"content": "#{M#俺}{F#私}は絵が得意じゃないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210148
					]
				},
				{
					"id": 715210148,
					"content": "ご心配なく！準備はできているから…以前他の人に構図取りをお願いした時と同じようにね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210149
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210149,
					"content": "ほら、これが修復する絵の写真だ、重要な景色がいくつもあるから…マークしておいた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210150
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210150,
					"content": "この景色が見える場所に行って、写真機で撮影してくれればすべて完了だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210151
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210151,
					"content": "つまり、撮影すればいいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210152
					]
				},
				{
					"id": 715210152,
					"content": "ああ、だが撮影の前にこれらの絵をよく見ておくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210153
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210153,
					"content": "絵に込められた美学と芸術的センスを…君の脳裏に刻んでほしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210154
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210154,
					"content": "これらの絵を完全に理解すれば、撮影時に制作の全過程を「見る」ことができるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210155
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210155,
					"content": "下絵、線画、着色、細部の洗練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210156,
						715210157
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210156,
					"content": "それって幻覚では？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210158
					]
				},
				{
					"id": 715210158,
					"content": "その通り。私は個人的に…芸術とはある種の——幻覚だと思うんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210159
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210159,
					"content": "そして芸術家がすべきなのは、その幻覚を正確に捉え、客観的に表現すること。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210160
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210160,
					"content": "信じてほしい、私が渡した写真をよく観察すれば、きっとこの絵に込められた「芸術の幻覚」を感じられるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210161
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210161,
					"content": "#とにかく、この件は任せる、{NICKNAME}さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210162
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210162,
					"content": "私は…次はこっちの絵の修復だな…うん、次の絵は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210157,
					"content": "幻覚まで見るのはやり過ぎじゃない…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210158
					]
				},
				{
					"id": 715210141,
					"content": "大変な事前準備だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210142
					]
				},
				{
					"id": 715210136,
					"content": "じゃあクレヨン画は描けるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210137
					]
				},
				{
					"id": 715210137,
					"content": "あ…ああ！だがほんの少しだけだ。クレヨンで絵を描く知識を今から覚えなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210138
					],
					"speakerTitle": "バトロ"
				},
				{
					"id": 715210116,
					"content": "なんだかスゴそう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210117
					]
				}
			]
		}
	]
}