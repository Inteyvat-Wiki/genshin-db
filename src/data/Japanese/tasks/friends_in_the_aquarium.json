				]
			},
			"dialogs": [
				{
					"id": 747040101,
					"content": "よう！コロンビーナ。水槽の魚を眺めてるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747040102,
					"content": "うん…すごく綺麗になったね。私が今まで見たことのない魚がたくさんいる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040103,
					"content": "これまでにもアクアリウムに行ったことがあるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747040104,
					"content": "ううん。でも、水槽ならスネージナヤでいくつか見たことある。目を開けてなかったから、本当に見たとは言えないかもしれないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040105,
					"content": "今はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747040106
					]
				},
				{
					"id": 747040106,
					"content": "すごく綺麗。水中の景色ってこんなに色鮮やかだったんだね。まるでみんな、永遠に花が咲き誇る春を生きてるみたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040107,
					"content": "あ、あの魚見て。この前も思ったけど、サンドローネにそっくり。それとあの二匹…ずっとお互いについて回ってて、キミたちみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040108,
					"content": "本当だ！言われてみれば確かにそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747040109,
					"content": "あのずっと忙しそうにしてるのは、ラウマみたい。あっちの珊瑚の間で警戒してるのは、ネフェルっぽい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040110,
					"content": "コロンビーナは、魚を見ながら、どの友達に似てるか考えるのが好きなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747040111,
					"content": "うーん、ちょっと違うかな。みんなのことが好きだから、気が付くとみんなを思い出してしまうの。魚を見てるときもそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040112,
					"content": "へへっ、そうだったのか。すっごく嬉しいぞ！他にはどんな魚がみんなに似てると思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747040113,
					"content": "最近、新しい友達がたくさんできたから…全員にぴったりな魚を見つけるのは難しそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040114,
					"content": "そうだな。でもオイラたちも、この水槽をどんどん充実させていくから、また見に来てくれよ。もしかしたら、他の友達も見つかるかもしれないぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747040115,
					"content": "友達を水槽の中に入れるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040116
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747040116,
					"content": "友達に似てる魚の話だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}