					],
					"speakerTitle": "マハン",
					"speakerSubtitle": "「豊穣の邦」トレーニングマスター"
				},
				{
					"id": 751830102,
					"content": "今すぐ挑む！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [],
