			"dialogs": [
				{
					"id": 751830101,
					"content": "感じる！感じるぞ！お前たちの「烈力」、なかなかにいいじゃないか！どうだ？「戦士の挑戦」に挑んでみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751830102,
						751830103,
