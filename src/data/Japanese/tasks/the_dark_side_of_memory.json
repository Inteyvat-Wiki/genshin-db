			"dialogs": [
				{
					"id": 60080101,
					"content": "あれから数日経ったけど、どうなってるだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080102,
					"content": "見た感じ、案外変わってなさそうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "落ち着いてきてるみたいだよな。ラウマは本当によくやってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080104,
					"content": "ラウマ、来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080105,
					"content": "この数日、どうだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "後片付けは想定よりもずっと複雑で、溜まっている仕事を処理するのに難儀した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080107,
					"content": "このペースなら、あと数週間はかかるだろう。しかし、残っている者たちの心の迷いは晴れ、積極的になってきている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080108,
					"content": "まるでようやく自分たちの信仰に出会ったかのようだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080109,
					"content": "これも全部ラウマのおかげだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080110,
					"content": "いいや…もっと早くやるべきだったのだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080111,
					"content": "近頃は無理しすぎぬよう、気を付けておる。「月髄」がそなたの中にある今なら、過去を見せることもできるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080112,
					"content": "覚えててくれたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "そういえば、あの幻影についてなにか新しい情報はないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080114,
					"content": "こちらでも聞いてみたのだが…特に進展はなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080115,
					"content": "そちらはどうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080116,
					"content": "こっちも大きな進展はないけど、ざっと話すと——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080117,
					"content": "なるほど…そなたらも大変だ。自分の体を第一にな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080118,
					"content": "では、こちらへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080119,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "どうした？なにか見えたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080121,
					"content": "（ここは…ナド・クライ？見覚えのある風景だ…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "（空にあるのは…流れ星？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "#（…！違う！{M#俺}{F#私}たちの宇宙船だ！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "お、終わったのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080125,
					"content": "遥か昔の出来事のようだな。私の力では…記憶が乱れていて、これくらいしか覗けなかったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080126,
					"content": "（少なくとも、宇宙船がナド・クライに不時着した時の場所は分かった…スターダストビーチの近くみたい。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#{M#（蛍に教えてもらった事実とも一致してるけど…やっぱりもっと知りたい…）}{F#（お兄ちゃんに教えてもらった事実とも一致してるけど…やっぱりもっと知りたい…）}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "ルオンノタル"
				},
				{
					"id": 60080129,
					"content": "えっ、突然どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080130,
					"content": "花の色が変わった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080131,
					"content": "（この花は「少女」の力を表してるはず。まさか「少女」の体が、また…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "（確か、「少女」は「月髄」を使って力を回復したいって言ってた…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "パイモン…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "おう、わかってるぞ！早くあいつのところに行って、なにかできないか見てみようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080135,
					"content": "うむ…頼んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080136,
					"content": "そうだ、おまえが「秘聞の館」に注文してた薬だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080137,
					"content": "持って来てくれたのか…感謝する。助かった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080138,
					"content": "そうだ…一つ推測がある。「クータル」ならば、そなたの宇宙船について、より多くの断片を見せられるやもしれぬ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "ラウマ"
				},
				{
					"id": 60080139,
					"content": "確かに！あいつは「月神」なんだもんな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080140,
					"content": "ひとまず、「少女」の安否を確かめにいってくるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080141,
					"content": "それじゃ、また後でな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
