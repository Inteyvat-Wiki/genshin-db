					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080204,
					"content": "また体調が悪くなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "…頭がくらくらする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080206,
					"content": "…月に戻っちゃいそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080207,
					"content": "おいおい、そこまでじゃないだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080208,
					"content": "あれ…？キミの体から…月の力を感じる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080209,
					"content": "「ファデュイ」から「月髄」を奪い返したよ。これで力になれる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "うん…今回は何が欲しいの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080211,
					"content": "なにいってるんだよ？おまえの体の一大事だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080212,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080213,
					"content": "（ずっとお互いを利用し合う環境で生きてきたから、そういう風にしか考えられなくなってるのかな…？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "あとでちょっとお願いがあるかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "…わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080216,
					"content": "手を出して。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080217,
					"content": "ふぅ…ありがとう、戻って来れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080218,
					"content": "おまえは最初からここにいたぞ。…もう大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080219,
					"content": "うん、だいぶよくなってきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080220,
					"content": "何したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "キミの体内に、水面に映る鏡像のように静かな月が佇んでる…本当に不思議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080223,
					"content": "私はただその水から月の光を少しもらっただけ…地面に戻って来られるだけの月の光を、ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080224,
					"content": "ほかにも何か変化を感じたけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "それは「月神の祝福」だよ。私と接触した者には、そういう印がつくの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080226,
					"content": "害はないよ。しばらくすると自然に消えるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080227,
					"content": "そう言えば、力も取り戻したことだし、「月髄」をおまえに渡しておいたほうがいいんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080228,
					"content": "これも元々「神」のものなんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080229,
					"content": "これは「恒月の女神・アリア」の遺骸だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080230,
					"content": "やっぱり——えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080231,
					"content": "知らなかったの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080232,
					"content": "ラウマはただ…ほかの欠片と違って、神の力を感じられるとしか言ってなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080233,
					"content": "彼女の言う通りだよ。さっき月の光を分けてもらった時、月髄の中の記憶も少し受け取ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080234,
					"content": "その記憶が、この欠片はかつて「恒月の女神」のものだったって教えてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080235,
					"content": "ラウマも月髄で歴史を見たはずなのに、なんで気づかなかったんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080236,
					"content": "（ラウマは、過去の記憶をぼんやりとしか見ることができない…これは「月神」にしか感じられないものかも…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "かつて、空には三つの月があって、三人の女神がそれぞれ自分の月を支配していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080238,
					"content": "でも、葬火の戦いで女神は三人とも命を落とし…三つの月のうち二つが砕けてしまった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080239,
					"content": "「恒月」を支配する「アリア」が亡くなった後、その力は月髄に凝縮された…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080240,
					"content": "「虹月」のほうは残骸すら見つかってない。そんな中で「霜月」だけは、女神が亡くなっても壊れなかったんだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080241,
					"content": "そして、そういう月には必ず新たな神が生まれるという預言があった。それが「霜月の子」の言う「クータル」だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080242,
					"content": "私も、自分の力が「霜月」のものだって感じとれる。でも、それは偽りの空の外にあって、私からは遠すぎるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080243,
					"content": "今の私は霜月を操るどころか、感じることすら難しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080244,
					"content": "え、えっと…オイラたちが手に入れたのは「恒月」で、「虹月」はどっか行っちゃってて…ってことは、おまえの体の中には「霜月」の月髄があるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080245,
					"content": "ううん、「月髄」は月の神が死んだ後に力が凝集した核みたいなものだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080246,
					"content": "だからそれは、月に星があるかって聞いてるのと一緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080247,
					"content": "…おお！つまりおまえは「霜月」の力そのものってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080248,
					"content": "そうだよ。「神の心」を持つ魔神は神と呼ばれるよね？なら、「月髄」を持つキミは…「月神」になれるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080249,
					"content": "それは違うと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "月神になりたくないの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080251,
					"content": "そういう問題じゃないだろ！おまえ、よっぽどその座から降りたいんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080252,
					"content": "誰が月神かって問題はともかく、この「月髄」はおまえに返すべきじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080253,
					"content": "嫌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080254,
					"content": "…ええっ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080255,
					"content": "私のところには来たくないみたいだもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080256,
					"content": "どういうことだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080257,
					"content": "さっきこの力に触れた時、「拒絶」を感じたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080258,
					"content": "私も「月神」だからかもしれない。二つの月が同時に昇ることはないし、互いに飲み込むこともない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080259,
					"content": "#{M#じゃあこのまま俺が持ってるしかないか…}{F#じゃあこのまま私が持ってるしかないね…}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "ええ？ラウマがおまえの体はこの力をうまく隠してるって言ってたけど、「少女」はこの力を感じられたんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080261,
					"content": "じゃあ「ワイルドハント」にも探知できちゃうんじゃないのか？もしあいつにバレたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080262,
					"content": "「ワイルドハント」？それって現象だよね？どうして人みたいに言うの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080263,
					"content": "だって、裏に黒幕がいる気がしないか？人みたいに明確な目的があるみたいだし…前にも「月髄」に執着してたしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080264,
					"content": "なんか、聞いたことあるかも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080265,
					"content": "え？本当か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080266,
					"content": "「ファデュイ」にいた頃、同僚たちが話してた気がする…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080267,
					"content": "カーンルイアから来て、災厄の時代に「アビス」の力を手に入れた…「月」に対して強い執念を持つ人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080268,
					"content": "カーンルイア？あの幻影とカーンルイアが関係あるかはわからないけど…そこ以外は特徴がぴったり合ってるな。なんてやつだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080269,
					"content": "他の人たちは彼を——「月の狩人」って呼んでた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080270,
					"content": "五大罪人！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "ああ…そんな呼び方もあったかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080272,
					"content": "えっ！？それってダインの言ってたやつか？オイラたちが相手にするのは…あの伝説の五大罪人…「月の狩人」レリルなのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080273,
					"content": "でも、五大罪人なら…実力はあの程度じゃないはず…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "「月の狩人」はカーンルイアの災厄が起きてから間もなく、姿を消したって聞いたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080275,
					"content": "同僚に彼はどこに行ったのって聞いたら、「本当に知らないのか？」って逆に聞かれちゃった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080276,
					"content": "なんで知ってると思ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080277,
					"content": "月の狩人は最後、二度と戻れない「月の影」に落ちちゃったらしいから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080278,
					"content": "待て待て…情報が多すぎて、反応が追いつかないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080279,
					"content": "あの頃の私もそうだったよ。同僚たちは「月」に関することなら、私が何でも知ってるって思ってたみたいだけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080280,
					"content": "でも、前にも言ったでしょ…私の「序章」は偽りの空の外で失われちゃったの。私は自分の名前すらわからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080281,
					"content": "そうだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080282,
					"content": "とにかく、「月の狩人」が消えた後、ナド・クライの「ワイルドハント」現象は急激に悪化して、アビスにおける災いの代名詞になったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080283,
					"content": "今のワイルドハントは、その名を受け継いだ、似たような現象ってだけ。規模も危険度も、昔とは段違いだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080284,
					"content": "まさか、伝説の「五大罪人」の一人がオイラたちの相手だなんて…なんだか信じられないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080285,
					"content": "危なすぎるだろ！スターダストビーチの時は、ただ運がよかっただけなのか…それとも、まだ向こうが本気を出してなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080286,
					"content": "それでも…あの「傀儡」ですら倒されたんだからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080221,
					"content": "#というより、{M#俺}{F#私}が何かしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
