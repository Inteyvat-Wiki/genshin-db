			"dialogs": [
				{
					"id": 60080401,
					"content": "ん？今なんて言った？もう一回言って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080402,
					"content": "えっ？おまえの…えっと、前の同僚？の「傀儡」は、スターダストビーチでオイラたちと一緒にいたとき、ワイルドハントにやられたみたいだったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080404,
					"content": "えっと…今、笑ったのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080405,
					"content": "…笑ってないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080406,
					"content": "（絶対に笑ったぞ！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080407,
					"content": "あいつと仲が悪いのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080408,
					"content": "ううん、ただ、あの子が悔しがる姿を想像しただけで、笑えるなぁって思っただけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080409,
					"content": "「傀儡」は結構ショックを受けてたみたいだったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080410,
					"content": "一瞬だけだよ。「傀儡」は自分の感情を調整するのが上手だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080411,
					"content": "話が逸れたけど、月髄を狙うやつは本当に危険な存在だっていうのはわかったぞ。本当にそれ、持ったまま行くのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080412,
					"content": "ファデュイの情報が確かなら、月の狩人が全力を出せば、ナド・クライ全土の人々が束になったって相手じゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080413,
					"content": "今は…もしかしたら何か制限があるのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080414,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "#{M#月髄をどうするか決める前に、コロンビーナに頼みたいことがあるんだ。}{F#月髄をどうするか決める前に、コロンビーナに頼みたいことがあるの。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "頼みたいこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080417,
					"content": "#{M#俺と妹の宇宙船がナド・クライに着陸した時に起きたことを見せてもらえないかな？}{F#私とお兄ちゃんの宇宙船がナド・クライに着陸した時に起きたことを見せてくれない？}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "いいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080419,
					"content": "ずいぶんあっさりオーケーしてくれるんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080420,
					"content": "言ったでしょ。そんなこと、私にとっては水面から月の光を吸い取る程度のことだって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080421,
					"content": "さあ、手を取って。心の準備をしておいてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080422,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "（前に見たのと同じだけど、はっきりしてる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "（あの時、無事に不時着できてよかった…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "（ずいぶん時間が経ったみたい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#{M#（蛍と俺はまだ中にいるはず。俺たちは宇宙船の中にこんなに長くいたのか…蛍はいつ外に出たんだろう？）}{F#（お兄ちゃんと私はまだ中にいるはず。私たちは宇宙船の中にこんなに長くいたんだ…お兄ちゃんはいつ外に出たんだろう？）}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#{M#（あれっ！？あれは…蛍！？）}{F#（あれっ！？あれは…お兄ちゃん！？）}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "（どうして…宇宙船が墜落した後は、誰も外に出てないはずなのに！宇宙船のドアだって、一度も開かなかった！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "#{M#ここは…どこだ？}{F#ここは…どこ？}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#お兄ちゃん！早くここから離れよう！}{F#蛍！早くここから離れよう！}",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "…あれ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "お…おまえ、大丈夫か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080434,
					"content": "#{M#着陸してからずっと…俺たちの宇宙船を…}{F#着陸してからずっと…私たちの宇宙船を…}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#{M#出入りした人はいなかった。でも、蛍は…宇宙船の外で俺を見つけた…}{F#出入りした人はいなかった。でも、お兄ちゃんは…宇宙船の外で私を見つけた…}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "えっ！？そ…そんな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080437,
					"content": "なんでだろう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "記憶ってビスケットみたい。一口食べると、あちこちに食べかすが散らばっちゃう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080439,
					"content": "（どういうことだろう…怪しすぎる。絶対に調べないと。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "（でも、ネフェルの言う通り、もしその前にナド・クライが壊滅的な被害を受けてしまったら、調べる術はなくなる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "#{M#月髄のことは俺に任せて。}{F#月髄のことは私に任せて。}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "え、えっ？お、おまえがそう言うなら…でも、それは…うぅ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080444,
					"content": "何か力になれることはある？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080445,
					"content": "力になれること？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "「月髄」を隠す手伝いならできるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080447,
					"content": "本当か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080448,
					"content": "元々体内に隠せば気づかれにくいけど、今から教えるクーヴァキの使い方をマスターすれば、さらに「月髄」の気配を隠せるはず。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080449,
					"content": "ほら、こうやって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080450,
					"content": "おお！なんだかシールドみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080451,
					"content": "（すごく…優しい感じ…まるで月の光みたい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "感じ取れた？その状態を保ってみて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080453,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "飲み込みが早いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080455,
					"content": "丈夫そうなシールドだな。いざって時には身も守れるんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080456,
					"content": "教えてくれてありがとう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "コロンビーナって普段からずっとここにいるのか？外に出かけたりしないのかよ？まあ、今外に出ても危ないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080458,
					"content": "えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080459,
					"content": "知らない人は好きじゃないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080460,
					"content": "#{M#俺}{F#私}たちはもう「知り合い」ってこと？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "知らない人よりかはマシかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080462,
					"content": "「ワイルドハント」が一段落したら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "そうだよな！「霜月の子」も変わったんだぞ！今ならコロンビーナも気に入るかもしれないな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080465,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080466,
					"content": "考えてみる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080467,
					"content": "少し疲れてるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080468,
					"content": "こんなに喋ったのは久しぶりなんじゃない？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "とにかく、手伝ってくれてありがとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 60080470,
					"content": "…別に、大したことじゃないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080471,
					"content": "ここのお花は、キミみたいなお客さんが好きだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 60080463,
					"content": "一緒に出かけようよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}