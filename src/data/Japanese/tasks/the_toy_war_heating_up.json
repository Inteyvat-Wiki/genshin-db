							3556.893,
							446.167,
							4435.611
						],
						"pointId": 340100226
					}
				]
			},
			"dialogs": [
				{
					"id": 745010301,
					"content": "店主、お二人さんが戻ってきたで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010302
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010302,
					"content": "やっぱりお前たちは仕事が速い。今回もきっと盛りだくさんの収穫を持ってきたんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010303
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010303,
					"content": "リーヴァ、なんでおまえは毎回遅れて出てくるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010304,
					"content": "おっと、怠慢だったな。次は絶対に真っ先に出てくると約束しよう。ふふ、それであのおもちゃについては…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010305
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010305,
					"content": "ベネットの物語をリーヴァに伝えると、彼は眉間に皺を寄せた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010306
					]
				},
				{
					"id": 745010306,
					"content": "ベネットという冒険者のために作ったおもちゃだと？なるほどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010307
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010307,
					"content": "リーヴァ、それから、あいつに聞いちゃいないけどさ、オイラはおまえの弟がおまえの店のデマを流したとは思えないし、そんなマネするようなやつとは思えないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010308,
					"content": "ほう？それで？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010309
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010309,
					"content": "彼はリーヴァに申し訳なく思ってるみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010310
					]
				},
				{
					"id": 745010310,
					"content": "カロンから聞いた話を伝えると、リーヴァの目線は少しずつあなたたちをすり抜けていき、まるで焦点を合わせる写真機のように、どことなく遠くへと向けられた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010311
					]
				},
				{
					"id": 745010311,
					"content": "そして…しばらくすると、不満げな声を小さく漏らした。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010312
					]
				},
				{
					"id": 745010312,
					"content": "ふん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010313
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010313,
					"content": "正直に言うと、俺もあいつがそんなことをするとは思っていなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010314
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010314,
					"content": "なんだよ、だったらなんで対策とやらを講じたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010315
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010315,
					"content": "店主は言い訳がほしかったんや。自分に逃げ道を用意して、ついでにあの物語について調べたかったんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010316
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010316,
					"content": "俺も大方同じ見解やで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010317
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010317,
					"content": "商売をする者にとっては、メンツが大事やからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010318
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010318,
					"content": "しかも兄貴やし、余計にメンツが大事になってくるやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010319
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010319,
					"content": "これ以上一言でも喋ったら、一発でぶっ飛ばすぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010320
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010320,
					"content": "リーヴァって、ホントにカロンの言ってた通りだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010321,
					"content": "お客さんたちよ…たった今思いついたんだが、私もそろそろあいつに会ってみるべきかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010322
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010322,
					"content": "わあ！じゃあようやく兄貴としてのプライドを捨てて、謙虚に弟に教えを乞うってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010323
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010323,
					"content": "そんなわけないだろう。私はただ、あいつに面と向かって私に謝る機会を与えてやろうとしてるんだ。あいつも私を裏切ったと思ってるんだろう？私に申し訳ないと思ってるんじゃなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010324
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010324,
					"content": "うぅ…たしかにそうは言ったけど…でも謝らなきゃいけないような裏切りじゃない気が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010325
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010325,
					"content": "ふん…とりあえず決まりだな。アルボン、購買予約の受付は中止だ。手付金も返金すべき分は返金しろ。掲示板も一旦撤収だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010326
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010326,
					"content": "何やて？店主！プロジェクトを取りやめるってことか？じゃこの先のデータ収集はどうするんや？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010327
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010327,
					"content": "実はまだ調整の余地がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010328
					]
				},
				{
					"id": 745010328,
					"content": "いや、データ収集は続ける。別の考えがあるんだ。それにせめてお前たちへの報酬はきちんと払わないとだろう？私は商売において、必ず信用を守るからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010329
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010329,
					"content": "うっ、こんなところに信用を持ち出してきたぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010343
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010343,
					"content": "さすがは店主。我がまま言うときでさえ店主らしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010330
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010330,
					"content": "ふん、あいつのおもちゃに対する態度も、捨てたもんじゃないかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010331
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010331,
					"content": "数日後、データ収集が終わったら、あいつのルポート時計店を訪ねてみよう。もしよかったら、当日はお前たちにも来てもらいたい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010344
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010344,
					"content": "今日はちょっと店のことがあるので、先に失礼させてもらう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010345
					],
					"speakerTitle": "リーヴァ"
				},
				{
					"id": 745010345,
					"content": "リーヴァはきびすを返して店に入っていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745010332
					]
				},
				{
					"id": 745010332,
					"content": "お、おう…。リーヴァってホントに変なやつだな…まさか本当に謝ってもらうつもりじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010333
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010333,
					"content": "おやおや、どうやら、今回もまた第三者によって転機が訪れたみたいやな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010334
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010334,
					"content": "ん？第三者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010335
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010335,
					"content": "お二人さんのことや。君たちが来てくれたお陰で、リーヴァ店主とカロンの間にあるわだかまりが溶ける兆しが現れたんや。前もそうやったんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010336
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010336,
					"content": "前もそうだった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010337
					]
				},
				{
					"id": 745010337,
					"content": "そうや。君たち気づいたか？うちの店とルポート時計店は北国銀行を挟む形になってるやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010346
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010346,
					"content": "実は店主は当初、ルポート時計店の隣に店を構えて、バッチバチの競争を繰り広げるつもりやったんやで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010338
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010338,
					"content": "その場所は元々、北国銀行によって抑えられてしまってたんやで。北国銀行は店主のことを知らなかっただろうけど、ある意味、仲裁役を務めた第三者やって言えるんちゃうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010339
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010339,
					"content": "それは面白いな。ファデュイって他人の事に首を突っ込むのが大好きだけど、そんな形での首の突っ込み方はたぶん初めてなんじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010340
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010340,
					"content": "だから、第三者は大事だって話や。コントには観客が一人は必要なのと同じぐらい大事なんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010341
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010341,
					"content": "じゃ、一人コントはどうなんや？演者一人に観客が一人いればええやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010342
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010342,
					"content": "なんの話や？君も俺を裏切ろうとしてるんか？一発でぶっ飛ばされたいんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルボン"
				}
			]
		},
