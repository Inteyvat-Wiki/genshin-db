				]
			},
			"dialogs": [
				{
					"id": 745010101,
					"content": "掲示板の評判、なんかおかしいで。絶賛のコメントで埋め尽くされるべきやろ？前はこんなじゃなかったのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010102
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010102,
					"content": "予想外やで。絶対誰かが裏で手を回したに違いないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010103
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010103,
					"content": "さすが、店主は知恵が回る。とっくに対策を講じたんやって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010104
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010104,
					"content": "当然やで。ちごたら店主なんて務まらへんやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010105
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010105,
					"content": "アルボン、アルベール、リーヴァはいるか？オイラたちに用事があるそうなんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010106,
					"content": "よしよし、対策が来た。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010107
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010107,
					"content": "対策？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010108
					]
				},
				{
					"id": 745010108,
					"content": "お二人さんのことや。これも店主のアイデアなんやけど、店主は今店にいないから、やっぱり俺たちが説明させてもらうで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010109
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010109,
					"content": "じゃあざっと説明するで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010110
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010110,
					"content": "先日うちの店は「決闘代理人」プロジェクトを公開して、街全体に広告を打ち出したんや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010138
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010138,
					"content": "購買予約の始まりや。手付金として半額を支払えば体験優先権がゲットできるで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010111
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010111,
					"content": "それから評価欄も置いた。入口にある、あの掲示板。皆が高評価を書き残せるようにな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010112
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010112,
					"content": "ああ、新商品を盛り上げるってやつや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010113
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010113,
					"content": "最初は店主の思惑通り、店は一気に盛り上がった。でも予約までしてくれる人はあまりいなくて、掲示板にも特に好評らしきコメントはなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010114
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010114,
					"content": "「誠意が足りない」やの「中身が貧弱」やの「時代遅れ」やの…そんなコメントだらけや。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010115
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010115,
					"content": "どうやら市場のニーズはおまえたちが思ってたのとは違ったみたいだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010116,
					"content": "そんな単純な話とちゃうんやで。フォンテーヌにはこんな言葉がある。「火のない所に煙は立たない」ってな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010117
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010117,
					"content": "つまり、誰かがデマを流してるってことや！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010118
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010118,
					"content": "悪質な誹謗中傷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010119
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010119,
					"content": "真っ赤なウソ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010120
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010120,
					"content": "空騒ぎ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010121
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010121,
					"content": "店主が言うには、弟が人を雇ってデマを流してるに決まってるって。「決闘代理人」プロジェクトが成功したら、一番困るのは他でもないルポート時計店やからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010122
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010122,
					"content": "それでおまえたちはどうするつもりだ？まさか、オイラたちを雇ってやり返させるつもりじゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010123,
					"content": "フリーナ様のお膝元で、そんなことを考えるなんてありえへんやろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010139
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010139,
					"content": "なんてったって、うちの店主はカロンの兄貴や。やつらがそんな手段を使ったとしても、うちは正々堂々やつらに勝てるはずやで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010124
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010124,
					"content": "その通りや。兄貴として弟を教育せんとアカンしな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010125
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010125,
					"content": "#じゃあ{M#俺}{F#私}たちは何をすればいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010126
					]
				},
				{
					"id": 745010126,
					"content": "やつらがやつらの誠意と中身をさらけ出すようにしてやってくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010127
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010127,
					"content": "さらけ出す？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010128,
					"content": "だって、そうしてもらわへんかったら公平ちゃうやろ？フォンテーヌは公平さを重んじる国やから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010129
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010129,
					"content": "公平さってそんな意味じゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010130,
					"content": "店主が言うに、人々が他のところのパッケージに誠意を感じる言うんやったら、俺たちも同じことをすればいいって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010131
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010131,
					"content": "彼らが冒険者をどうパッケージングしてるか…その方法を真似て、俺たちも決闘代理人をパッケージングすればいい。それに加えて俺たちは充実したデータがある。きっと逆転勝利やで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010132
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010132,
					"content": "パッケージングっていうけど、あいつはただ冒険者の物語をおもちゃにしただけだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010133
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010133,
					"content": "まさにその物語や！どんな物語か聞いてきてくれへんか？頼む、きっとその物語がパッケージングに決まっとる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010134
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010134,
					"content": "俺が小耳に挟んだ噂によると、ある日カロンが酒を飲んでた時、そのおもちゃは誰かのために作ったんやって、こぼしたんやって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010135
					],
					"speakerTitle": "アルベール"
				},
				{
					"id": 745010135,
					"content": "そんなことを言うくらいだから、やつとその冒険者は何かものすごい事を経験したんちゃうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010136
					],
					"speakerTitle": "アルボン"
				},
				{
					"id": 745010136,
					"content": "#えっ！？カロンとあの冒険者が、か？どんな物語か急に知りたくなってきたぞ。{NICKNAME}、もう一度行って聞いてみないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010137,
					"content": "#ほんまに助かるわ！マドモワゼル·パイモン、{M#サー}{F#マドモワゼル}·{NICKNAME}、頼むで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルボン"
				}
			]
		},
		{
			"id": 7450102,
			"completionStepIds": [
				7450102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7450102",
							"2"
						],
						"stepId": 7450102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"カロン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3627.395,
							446.263,
							4474.6
						],
						"pointId": 340100067
					},
					{
						"sceneId": 3,
						"position": [
							3627.172,
							446.167,
							4477.734
						],
						"pointId": 340100123
					},
					{
						"sceneId": 3,
						"position": [
							3626.387,
							446.167,
							4476.965
						],
						"pointId": 340100124
					}
				]
			},
			"dialogs": [
				{
					"id": 745010201,
					"content": "また会ったね。最近どうしてたんだ？冒険者のおもちゃはもう試したかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010202
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010202,
					"content": "へへ、元気か、カロン。実はちょっと聞きたいことがあって来たんだ。偶然にも、そのおもちゃのことなんだけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010203,
					"content": "ああ——偶然、か。私は偶然が好きだ。寝坊したい気分だと思ったら、偶然休みの日だったとか、買いたいものがあるときに偶然十分なモラがあった、とかね。だから、何でも聞いてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010204
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010204,
					"content": "このおもちゃの物語について聞かせてほしい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010205
					]
				},
				{
					"id": 745010205,
					"content": "そうそう！このおもちゃは誰かのために作られたって聞いたけど、きっと物語の主人公にもなってる、例の冒険者のことなんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010206,
					"content": "はは、その話か。確かにあの冒険者は私に深い印象を残してくれたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010207
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010207,
					"content": "モンドを離れようとしたとき、清泉町の外である冒険者に出会ったんだ。当時彼はとある依頼をしくじったところでね。たしか…出前サービスの依頼だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010208
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010208,
					"content": "彼は道中で何度も魔物に遭遇して、時間に間に合わなかったうえに、料理をこぼしてしまったと言う。それで、私は少しばかり料理ができるから、彼のために作り直してあげたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010209
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010209,
					"content": "カロン…おまえってホントに親切だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010210,
					"content": "はは、でも親切心だけじゃ不十分だったよ。君たちには想像もつかないだろうな。たかが料理を作るだけなのに、想定外の事故の連続だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010211
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010211,
					"content": "火を起こすための薪は濡れてたし…鍋にはでかい穴が開いていて…皿に盛りつけるときには、どこからだか石が飛んできて皿が割れたりしてね…しかもそのうち一つは私の頭に当たって、すごく痛かったんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010212
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010212,
					"content": "なんとか依頼任務は終わらせたものの、結局お客さんからクレームを受けてしまったよ。料理に入っていた石で歯が割れたって理由でね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010237
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010237,
					"content": "ああ、フリーナ様…！これはまさか私の頭に当たったあれか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010213
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010213,
					"content": "その冒険者って、もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745010214
					]
				},
				{
					"id": 745010214,
					"content": "ベネットっていう冒険者だけど、もしかして…君たちも彼を知ってるのか？すごく不思議な子だったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010215
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010215,
					"content": "その後、彼はお礼にと言って、モンドでもあまり人のいないところを色々と案内して回ってくれたんだ。道は歩きにくかったけど、景色は素晴らしかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010216
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010216,
					"content": "てっきり、相当な旅行愛好家なんだろうと思ったら、なんと冒険のときに足を踏み外して落っこちたり、道に迷った末に偶然見つけたりした場所だって言うじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010217
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010217,
					"content": "帰る日には、別れの挨拶をしに来てくれた。それで、私は彼に「不運な体質で困ってないか」って聞いてみたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010218
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010218,
					"content": "そしたら、彼は親指を立てながらこう答えたのさ。「世の中には色んな人がいるけど、一番ついてないのはきっとオレだろうな」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010219
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010219,
					"content": "「でも、それってつまり、オレは一番勇気のある人でもあるってことなんだ。だからこそ、オレはオレにしか見れない景色を見つけることができる。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010220
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010220,
					"content": "本当にカッコいい考えだと思ったよ。不幸に満ちた道のりを、大笑いしながら前へと突き進む…その気質こそ、真の冒険者ではないだろうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010238
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010238,
					"content": "そうそう！ベネットは冒険者中の冒険者だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010239
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010239,
					"content": "はは、もし不運が伝染するんだったら、冒険心だってきっと伝染するだろう。それも、もっと遠くにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010221
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010221,
					"content": "帰って報告するには十分な物語を聞かせてあげられたかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010222
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010222,
					"content": "えっ…カロン、おまえまた分かってたのかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010223
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010223,
					"content": "火のないところに煙は立たぬ…フォンテーヌ人の暮らしの基本さ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010224
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010224,
					"content": "もし君たちがこの物語を知りたいと思ったら、きっと初日に聞いてくれただろう。今日になって聞いてきたのは、恐らく兄さんに頼まれたからじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010225
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010225,
					"content": "うぅ、一発でバレちゃったぞ！カロンはこんなに優しくて頭の回転も早いのに、どうしてリーヴァは弟に偏見を持ってるんだ？信じられないぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010226
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010226,
					"content": "きっと俺に怒ってるからだろう。私に裏切られたと、未だに腹を立ててるんだと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010227
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010227,
					"content": "えっ？裏切られたって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010228,
					"content": "私の家は代々、クロックワーク工芸で名を知られた家なんだ。私は小さい頃からクロックワーク玩具の制作が得意でね、兄さんはそういう面では私に及ばなかったけど、優れた商売のセンスを持っていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010229
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010229,
					"content": "二人しておもちゃが大好きだったから、大人になったら最強のおもちゃ屋さんを開こうって約束してたよ。でも、大人になったら…誰かが家業、つまりこの時計店を継がないといけないってことになった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010230
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010230,
					"content": "兄さんは親父と大喧嘩した末に、独立して店を立ち上げたんだ。一方の私は説得に折れてしまってね、兄さんにはついて行かなかった。これって、裏切りだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010231
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010231,
					"content": "うぅ…それは裏切りなんかじゃないだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010232
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010232,
					"content": "少なくとも、冒険心に欠けていたことは間違いないだろう。もし何も成し遂げられなかったら、惨めな姿で家に戻らないといけないのが怖かったんだ…趣味を仕事にすることのプレッシャーを背負えなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010233
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010233,
					"content": "小さい時から、私はいつもそうだった。面倒な不良に絡まれたときも、私はただ泣くばかり。兄さんは私を後ろにかばって、「こんなやつら、兄さんが一発でぶっ飛ばすからな！」なんて言ってくれたものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010234
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010234,
					"content": "おまえたち兄弟の関係って、ちょっと複雑みたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745010235,
					"content": "はは、まあ、そんなところだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745010236
					],
					"speakerTitle": "カロン"
				},
				{
					"id": 745010236,
					"content": "何はともあれ、また何か聞きたいことがあったら、いつでもおいで。私はいつもここにいるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "カロン"
				}
			]
		},
