						"rawParams": [
							"2102208",
							"3"
						],
						"stepId": 2102208,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102209",
							"2"
						],
						"stepId": 2102209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220301,
					"content": "遺跡から手がかりを見つけた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229501
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210229501,
					"content": "石碑を五つ見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "よかった、見せて…うっ、これらの文字、順番がめちゃくちゃだね。ちょっと整理するね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220302,
					"content": "…文字がたくさん欠けてるね、途切れ途切れだし、この順番で合ってるかどうかも分からない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220303,
					"content": "とりあえず、並べてみたけど、この文字たちをつなぎ合わせると…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220304,
					"content": "「…の初め、農業で繁盛し、集落に…神が降臨、名は『帰終』、埃を巻き上げ、空を隠す……」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220305,
					"content": "「…四つの忠告を民に…その後また神が降臨し、岩を器に、璃月に民を集め…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220306,
					"content": "「…二柱の神の名とりて、此の地『帰離』と名付けき…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220307,
					"content": "うん、どうやらこれは「帰離集」の歴史と、「帰離集」を守る、「塵」を操る神についての話だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220308,
					"content": "でも、上にはもう一人の魔神がここに来て、自分の民を連れてきたって書いてある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220309,
					"content": "この「帰離集」って名前も、二人の神の名前から一文字ずつ取って、作った名前だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220310,
					"content": "珍しいね。今までの文献だと、二人の魔神が平和に、互いに協力するようなことはなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220311,
					"content": "二人の魔神というよりも、仲のいい友人に見えるね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220312,
					"content": "でもおかしいな、その後の話がない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220313,
					"content": "それに、「帰離集」はどうして廃墟になった？二人の魔神が守るとなると、普通の災害だと「帰離集」を丸ごと消滅させることはないはずなのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220314,
					"content": "きっと魔神でも解決できないような災害があったんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220315,
					"content": "旅人、もう一度手がかりを探してくれないかな？予想外の出来事がなければ、君が以前発見した石碑はここにもっとあるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220316,
					"content": "もしかしたら、その石碑たちにはその後の話が載ってるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220317,
					"content": "でもこの石碑たちの内容と文献の記載とは少し違うみたい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220318,
					"content": "はあ、まさかこんなに説があるとは…一体どれが本物だろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				}
			]
		},
