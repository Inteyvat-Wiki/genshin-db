			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ソラヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220501,
					"content": "おかえりなさい。もう待ってられないよ。何かあった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229601
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210229601,
					"content": "また石碑を二つ見つけた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "早く見せて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210229603,
					"content": "「…『帰離原』に戰ひ起こりき、空漆黒にしみて、全ての岩割られき…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210229604,
					"content": "これは…帰離原に戦争があったみたいだね、しかもかなり大規模の…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210229605,
					"content": "「帰離集」はこの戦争で壊れたと考えられる。でももう一つの文章は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210229606,
					"content": "…「帰離集」から離れたくない人が残したものみたいだね。あの人はずっとここを守ってる、そして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210229607,
					"content": "そして宝物がある。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "…君はそれに対して敏感だよね。でも文章だけ見ると、この「帰離原」には確かに宝物が隠されてるはずだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220503,
					"content": "でも「…『帰終の忠告』を引用する…」、その後は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220504,
					"content": "「知で教え、徳で約束し、骨を固く、心を一つ。この四つは『帰離集』となる」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220505,
					"content": "うーん…どこから理解すればいいか分からない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "ソラヤー"
				},
				{
					"id": 210220506,
					"content": "まずは望舒旅館に戻ろう。少し休んでから、またこの「帰終の忠告」を解読しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ソラヤー"
				}
			]
		},
