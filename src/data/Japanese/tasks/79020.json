			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "オイラにも見せてみろ！うーん…もしかしたら、お宝の地図かもな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200102,
					"content": "本当に？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "おう、お宝の匂いがするぜ。間違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200116,
					"content": "ほら、図を残したのは「海賊赤穂百目鬼の一味」って書いてあるぞ。なんか、どっかで聞いたことある名前だよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200104,
					"content": "それにほら、「秘宝が隠されている場所…」ってあるから、きっとお宝があるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200105,
					"content": "えっと、それから…「秘密は…四カ所にある…」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200106,
					"content": "四カ所にあるって、何かを四つに分けたってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200107,
					"content": "宝が四つある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "わからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200110,
					"content": "でも「四つの大きな島の岩礁」とも言ってるから、たぶん金リンゴ群島の四つの島の岩礁のことだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200111,
					"content": "あれ、ここってその岩礁じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200112,
					"content": "どうやら宝の手がかりみたいだったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "それに、オイラたち四つの島の岩礁の近くにいるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200114,
					"content": "金リンゴ群島の四つの島って言ったら、きっとあの一番大きな四つのことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200115,
					"content": "他の三つの島の岩礁にも行って、探してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790200108,
					"content": "宝の手がかりが四つある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				}
			]
		},
