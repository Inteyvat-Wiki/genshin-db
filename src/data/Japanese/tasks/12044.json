						],
						"pointId": 322100696
					}
				]
			},
			"dialogs": [
				{
					"id": 120440301,
					"content": "ん？女の子がいるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440302,
					"content": "すごく苦しそうだ…様子を見に行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440801
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440801,
					"content": "さっきのは一体…あの女の子と目が合っただけなのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440802
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440802,
					"content": "待った。いつの間にこんなに人が…？なにかあるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440803
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440803,
					"content": "この人たち、並んでるみたい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440804
					]
				},
				{
					"id": 120440804,
					"content": "そうみたいだな…あっ！さっきの子がいるぞ！もしかしたら…なにか知ってるかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440805
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440805,
					"content": "今から旅に出ても、間に合うだろうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440806
					],
					"speakerTitle": "手島"
				},
				{
					"id": 120440806,
					"content": "どうして話がまとまらないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440807
					],
					"speakerTitle": "茂"
				},
				{
					"id": 120440807,
					"content": "報告したら、仕事に不和が生じる。だが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440808
					],
					"speakerTitle": "真田"
				},
				{
					"id": 120440808,
					"content": "うん…アイデアが湧かないことから生まれる不安だね…でもそういうのは普通、焦れば焦るほど出てこないものだ。今回の治療で少しでも心が軽くなることを願うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440809
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440809,
					"content": "…ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440810
					],
					"speakerTitle": "若紫"
				},
				{
					"id": 120440810,
					"content": "…過去の悪行からくる後悔、行き詰った現状に対する嘆き…それらにもっと明るく向き合えるようにしてあげるけど、キミ自身も頑張るんだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440811
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440811,
					"content": "…感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440812
					],
					"speakerTitle": "西口"
				},
				{
					"id": 120440812,
					"content": "次の方…ケホッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440813
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440813,
					"content": "ど、どうしたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440814,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440815
					]
				},
				{
					"id": 120440815,
					"content": "大丈夫、次の方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440816
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440816,
					"content": "これって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440817
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440817,
					"content": "…ふふっ！美味しい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440818
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440818,
					"content": "えっ？どうしたんだよ、急に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440819
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440819,
					"content": "これは…うっ！悪いけど、ちょっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440820
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440820,
					"content": "「悪いけど」？なにが起きてるかさっぱりだぞ…説明してくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440821
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440821,
					"content": "ん？ああ、おそらくキミたちは、あたしの夢に迷い込んだんだよ。二人が起きてから説明してあげる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440822
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440822,
					"content": "夢？いつの間に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440901
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440901,
					"content": "う、う～ん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440902,
					"content": "おはよう。「夢から覚めた」って感じかな？まさか、あの旅人があたしの夢に現れるなんてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440903,
					"content": "#{M#俺}{F#私}のことを知ってるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "うん、キミのことをよく話してくれる子がいるんだよ。ふむふむ…噂から想像はしてたけど…まあまあ合ってるみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440905,
					"content": "えっと、おまえは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440906,
					"content": "そういえば、初めましてだったね。では、改めて自己紹介を——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440907,
					"content": "あたしは夢見月瑞希、瑞希って呼んで。夢喰い獏の一族なの。稲妻の妖怪のひとりよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440908,
					"content": "夢喰い獏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440909,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "幼い夢喰い獏"
				},
				{
					"id": 120440910,
					"content": "あっ、さっきの小っちゃいやつ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440911,
					"content": "これがあたしたち一族の本当の姿。キミたちはさっきこの子に釣られてあたしの夢に迷い込んだんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440912,
					"content": "夢喰い獏には、人間の悪夢を喰らう能力があるの。食べた悪夢は、自分の夢の中で消化する必要があってね。さっき見たのは、あたしが悪夢を消化してた光景なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440913,
					"content": "ただ、悪夢を一気に食べ過ぎたことで詰まらせちゃって、少し消化不良を起こしてね…この子がキミたちを連れてきてくれてよかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440914,
					"content": "ま、こうしてキミたちに会えたんだから、怪我の功名ってやつだ。おかげで助かったよ。今なら悪夢をちゃんと消化できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440915,
					"content": "おまえが辛そうにしてたときは、なにがあったのかわからず駆け寄ったけど、役に立てたならよかったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440916,
					"content": "それにオイラ、悪夢は大っ嫌いだしな！悪夢を食べてくれる妖怪ならちゃんと助けないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440917,
					"content": "ただ、謝らなきゃいけないことがあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440918,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "夢の中でキミが近くに来たとき、取り出したのは悪夢ではなく、良い夢だった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440920,
					"content": "あれだけの悪夢を食べたものだから、つい反射的に、思わず一口いただいてしまったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440921,
					"content": "夢喰い獏って、良い夢も食べていいんだな…ちなみに、それっていけないことなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440922
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440922,
					"content": "うん、良い夢は人間にとって大切な宝物だからね。悪夢のように勝手に食べていいわけがない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440923
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440923,
					"content": "夢喰い獏の一族には暗黙の了解があるんだ——他人の良い夢を許可なく食べてはいけないって。あたしとしたことが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440924,
						120440925
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440924,
					"content": "そんなに自分を責めないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				},
				{
					"id": 120440926,
					"content": "キミ、気分が落ち込んだりしてない？それか、急に悲しい出来事をたくさん思い出したりは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440927
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440927,
					"content": "ないけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440928
					]
				},
				{
					"id": 120440928,
					"content": "良い夢を少し食べられたのに精神状態がこんなに安定してるなんて、滅多に見ない例だよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440929
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440929,
					"content": "う～ん…たぶんこいつが良い夢をいっぱい見てきたからじゃないか？少しくらい食べられたって大丈夫だよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440930
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440930,
					"content": "それでもお詫びしないと…そうだ、これを。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440931
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440931,
					"content": "秋沙銭湯特別招待券…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440932
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440932,
					"content": "ええと…「心理療法士が多数在籍、温泉と美味しい食べ物であなたをおもてなし。帰る頃には、その胸の悩みも喜びに変わる…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440933
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440933,
					"content": "招待券に住所が書いてあるでしょ？あたしはそこで働いてるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440934
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440934,
					"content": "それを使えば、キミたちは最高級のおもてなしを無料で体験できる…あっ、そろそろ戻らないと。お店をずっとほっとくわけにはいかないからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440935
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440935,
					"content": "それじゃ、来るのを楽しみにしてるから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440936
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120440936,
					"content": "え～っと、あの夢喰い獏の子は心理療法士でもあるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440937,
						120440938
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440937,
					"content": "意外ではないかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440939,
					"content": "悩みを解決してくれるってことだよな。…まあ、オイラの悩みって、次になにを食べるかくらいで他にないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440940
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440940,
					"content": "でも、そのなんとか銭湯には美味しい食べ物もあって、この招待券があればタダで食べれるってことだろ？こんなチャンス、無駄にしたらもったいないよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440938,
					"content": "へぇ、面白いね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440925,
					"content": "#{M#俺}{F#私}は平気だから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				}
			]
		},
