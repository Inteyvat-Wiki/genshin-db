			},
			"dialogs": [
				{
					"id": 120440201,
					"content": "なんだか、狸を追いかけたときのことをふいに思い出したぜ…ちょっと懐かしいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440202,
					"content": "ん？なんだあれ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440203,
					"content": "狸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "いやいや、どう見ても違うだろ？もしかして、稲妻でまだ会ったことない妖怪かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440206,
					"content": "えっと…ついてきてほしいみたいだぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 120440204,
					"content": "子豚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
		{
			"id": 1204403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
