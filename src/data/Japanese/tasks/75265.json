				"objectNames": [
					"マノウ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "やあ、そこのキミ、いいものがあるんだが。値段もお手頃だぞ。どうだい、見ていかないかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "マノウ"
				},
				{
					"id": 752650102,
					"content": "あれ？これって、あのコホラ竜のぬいぐるみじゃないか？前にのびのびマーケットで見たような気がするぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752650103,
					"content": "見る目があるな。だがうちのは安いぞ、あっちの半額だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "マノウ"
				},
				{
					"id": 752650104,
					"content": "どうしてそんなに安いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "へへ、心配しなくてもいい。うちにはうちのやり方があるからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "マノウ"
				},
				{
					"id": 752650106,
					"content": "安いけど、色がちょっと変な気がするぞ…まさか偽物じゃないだろうな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752650107,
					"content": "偽物だと？見る目のないチビめ…失せやがれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "マノウ"
				},
				{
					"id": 752650108,
					"content": "さあ、行った行った！お前らになんか売ってやるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マノウ"
				}
			]
		},
		{
