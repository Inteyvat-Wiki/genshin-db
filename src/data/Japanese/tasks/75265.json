			},
			"dialogs": [
				{
					"id": 752650301,
					"content": "やあ、そこのキミ、いいものがあるんだが…ってまたお前らか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "マノウ"
				},
				{
					"id": 752650302,
					"content": "売らないと言ったはずだ、聞こえなかったのか？あっちに行け。邪魔だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "マノウ"
				},
				{
					"id": 752650303,
					"content": "コイツ…今なら謝っても間に合うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 752650304,
					"content": "ハア？何の話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "マノウ"
				},
				{
					"id": 752650305,
					"content": "偽物を売ってるよね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "ハァ？だったら何だってんだ？余計なことに首を突っ込まないほうがいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マノウ"
