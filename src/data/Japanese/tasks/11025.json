			"dialogs": [
				{
					"id": 110240301,
					"content": "もう少しここにいようと思う。過去に思いを馳せる機会はそうそうないからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
						110240305,
						110240308
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240302,
					"content": "「塩の魔神」、少し可哀想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "魔神戦争の時代、善悪を判断する基準は今とは違う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240304,
					"content": "もちろん…今の俺は、彼女には優しい時代に生まれて欲しかったと思っている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240305,
					"content": "これでオセルの力は強くなる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "確かに遺物には力があるが、オセルにとっては取るに足らないものだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240307,
					"content": "たとえいつか彼が復活しても…フッ、きっとまた敗れるだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240308,
					"content": "これからどうするの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "いい質問だ。昔なら具体的な答えを出せたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240310,
					"content": "今は…ああ、往生堂の客卿としての責務を果たそうと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240311,
					"content": "もし今回の旅を楽しめたなら、次の「記録」もまた俺を呼ぶといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		}
	]
