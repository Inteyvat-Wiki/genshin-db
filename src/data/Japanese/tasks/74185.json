			"dialogs": [
				{
					"id": 741850301,
					"content": "へへっ、「ウッスー」、ここがおまえの新しいおうちだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850302,
					"content": "ニャ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "ウッスー"
				},
				{
					"id": 741850303,
					"content": "でもちょっと変な感じだな。カッシオドルはもういないんだろ。それじゃ、今の「ウッスー」はいったい誰なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850304,
					"content": "カッシオドルに取り付かれる前の猫か、それとも一緒に冒険したウスさんなのか…うーん、頭がこんがらがってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850305,
					"content": "パイモンには難しい問題だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "確かにさっぱりわからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850309,
					"content": "とにかく、ウッスーにも家を見つけてやれたし、これからは時間があったらウッスーと一緒に遊べるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850310,
					"content": "ニャオ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウッスー"
				},
				{
					"id": 741850307,
					"content": "「ウッスー」は「ウッスー」だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "よくわからないけど、ま、確かにそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "パイモン"
				}
			]
		}
