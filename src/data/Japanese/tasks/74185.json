			},
			"dialogs": [
				{
					"id": 741850101,
					"content": "エスト、戻ってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850102,
					"content": "ああ、君たちか…ん？待て、君たちは誰だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850103,
					"content": "#えっ？オイラたちのことが分からないのか。{NICKNAME}とパイモンだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME}とパイモン…確かに聞いたことはある…でも、あれは夢の中のはずだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850105,
					"content": "うーん、でもあの時、エストは目が覚めてたんだけどな。それにオイラたち、下で一緒にあいつに会ったじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850106,
					"content": "はぁ、夢では町のみんなが石像になって、僕だけが残されて打つ手がなくて悩んでた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850107,
					"content": "そこへ二人の勇者が町に来て、みんなを救おうとしてくれたんだ…まさか、あれは夢じゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850108,
					"content": "さあ、どうだろう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "おう、とにかく、みんなもう元通りになっただろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850111,
					"content": "でも、みんな変な夢を見ていたようだ。一体何があったんだ？もしかして僕たちは、集団催眠にでもかかっていたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850112,
					"content": "話せばまる一日かかっちゃうかもな…催眠のことはいったん忘れようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850113,
					"content": "催眠術か…そういえば、君たちは猫を連れてきているんだな。賢そうな子だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850114,
					"content": "うん、賢いよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "こいつはオイラたちの仲間だぞ。まあ、こっから先の旅に連れて行くわけにもいかないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850118,
					"content": "ならちょうどいい。クラブには猫ハウスがある。催眠術を研究してたやつが猫を連れて旅に出た後、ずっと空いてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850119,
					"content": "もしよかったら、その子をここに預けて行ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850120,
					"content": "どうしてかは分からないけど、僕たちには特別な縁があるみたいだ。ちゃんと世話するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850121,
					"content": "猫ハウスは建物の向こうにある。行けば分かるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "エスト"
				},
				{
					"id": 741850116,
					"content": "この子は仲間だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "そうだけど、旅に連れて行くわけにもいかないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 741850109,
					"content": "そこは重要じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
