				{
					"id": 102020401,
					"content": "だーれだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102020402,
					"content": "あっ、パイモンちゃんの声だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "反省室"
				},
				{
					"id": 102020403,
					"content": "ここから出そうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "うん、おねが——だ、だめ！クレーは真面目に反省してるんだから、ユーワクしないで！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "反省室"
				},
				{
					"id": 102020406,
					"content": "反省中は、ここでバドルドー祭のために特別な「宝物」を作ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "反省室"
				},
				{
					"id": 102020407,
					"content": "「宝物」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102020408,
					"content": "へへっ…羽球の形にしてみたんだよ、かわいいんでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "反省室"
				},
				{
					"id": 102020409,
					"content": "羽球の形…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "うん、バドルドー祭が始まったら、きっとみんな気に入ってくれると思う！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "反省室"
				},
				{
					"id": 102020412,
					"content": "はあ、ジンがこの話を聞いたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102020413,
					"content": "きっと、クレーの反省室で過ごす時間が長くなるだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 102020410,
					"content": "それ、爆弾だよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "食べ物を持って来ようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
