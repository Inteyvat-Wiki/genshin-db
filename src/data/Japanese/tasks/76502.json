			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アイノ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#{NICKNAME}にパイモン！どしたの？まさか、天才機械技師のアイノの腕を借りなきゃならないような、すっごい依頼が舞い込んだとか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020102,
					"content": "えへへっ、顔なじみだし、二割引きにしてあげるよ！こっそりお菓子を分けてくれたらの話だけど…しーっ！イネファには内緒にしといてね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020103,
					"content": "この辺りを見てまわってただけだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "ふふん！じゃあ、ここに来て正解だね！アイノの工房には、キラキラ光る素敵なものがたくさんあるから！よそでは見られないものばっかだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020106,
					"content": "でもパーツにつまづいて転ばないよう、足元には気を付けてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020107,
					"content": "このロボット、変わった見た目だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "ふふん、もちろん！この子の名前は「ボコボコダック」！本当は鉄くずを片付けるために、ゴミ分別ロボットを作るつもりだったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020110,
					"content": "うっかり頑丈になりすぎちゃって…しかもアームもやたら自在に動くようになったの。そこでピーン！ってひらめいて、超強力な防衛機能を追加したんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020111,
					"content": "これで、アイノの工房に忍び込もうとする悪いやつがいたら、全員「不燃ごみ」としてお片付けできちゃうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020112,
					"content": "アイノは相変わらず、とんでもないアイデアがポンポン出てくるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765020113,
					"content": "せっかくだし…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "ア、アイノの写真？「ボコボコダック」と一緒の？普段はみんな、アイノの発明にしか興味を持たないから…写真を撮られるなんて新鮮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020116,
					"content": "でも、アイノという天才機械技師と、その無敵の部下の日常を記録したいなら、好きにしていいよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020117,
					"content": "でも…アイノ、自分の写真を撮ることなんてないし、どんなポーズをしたらいいかも分からないな…もし、かわいく撮れなかったらどうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020118,
					"content": "いつも通りにしてくれればいいよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "うん、じゃあ任せるよ。「ボコボコダック」の強そうなところをばっちり撮ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイノ"
				},
				{
					"id": 765020119,
					"content": "全力で一番キマってるところを撮るから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "アイノの写真を撮ってもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "この子もアイノの「部下」なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "ついでにいい被写体を探してるんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
