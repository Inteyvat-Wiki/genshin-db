			"dialogs": [
				{
					"id": 752500101,
					"content": "おもちゃを買えた観光客たちは、次々と帰っていったが、この時何人かの招かれざる客がモコモコ駄獣園にやって来た——",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "昨日強盗しにきたファデュイじゃない！？今度は何する気！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752500104,
					"content": "#{M#俺}{F#私}がいるから心配しないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "いや…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "リーダー格のファデュイは手を振ると、メモを渡してきた。広げてみると、くねくねの字でこう書かれていた——",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "も…もしかして、昨日のあれは、お金を払ってくれてたの…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752500113,
					"content": "ご、ごめんなさい…私、勘違いしちゃって…本当にごめんなさい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752500114,
					"content": "ここにあるもの…全部持って行ってください！感謝の気持ちです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752500115,
					"content": "リーダー格のファデュイは首を横に振ると、指で「三」を示した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "…あなたがたはナタの英雄と同じく、尊敬に値する戦士です…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "アロハ"
				},
				{
					"id": 752500117,
					"content": "じゃあ、一番ぴったりな色のものを用意しますね。ありがとうございます！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アロハ"
				}
			]
		},
