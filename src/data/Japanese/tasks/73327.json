			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ジェイド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}！？君…君なの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270102,
					"content": "パイモンも！ここで君たちに会えるなんて思ってもみなかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270103,
					"content": "ジェイド！！わぁ、ジェイドじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733270104,
					"content": "ははっ、声大きすぎ！狙ってた魚までビックリして逃げちゃったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270105,
					"content": "ピピー！…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "ブンブン"
				},
				{
					"id": 733270106,
					"content": "あれ…釣りをしてたのか？釣り竿は見当たらないけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733270107,
					"content": "ピ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "ブンブン"
				},
				{
					"id": 733270108,
					"content": "#ブンブン、余計なこと言わないで！とにかく…{NICKNAME}、他の話しよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270109,
					"content": "#{M#君}{F#あなた}の釣り竿は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "君…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270111,
					"content": "あれは…そう、ひとりでに壊れたの…えへへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270112,
					"content": "はぁ…まさか釣りが狩りとは全然違うなんて思わなかった…難しくて…本当に難しすぎるんだよ！ここでずっと座って魚を待つ忍耐力はないし…自分で川に魚を捕まえに行ったの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270113,
					"content": "結局それでも捕まえられなかった、だろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733270114,
					"content": "ふん、もちろん捕まえたよ、めっちゃデカいやつをね。君よりおっきいよ…うーん、君よりブンブン一つ分くらい長かった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270115,
					"content": "ピピ！ピピ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "ブンブン"
				},
				{
					"id": 733270116,
					"content": "全部焼いて食べちゃったから、君の分はないの！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270117,
					"content": "ピピ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "ブンブン"
				},
				{
					"id": 733270118,
					"content": "うんうん、ブンブンも食べたよね。君の分だけ残ってないの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270119,
					"content": "誰が信じるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733270120,
					"content": "ははははっ！信じるも信じないも君の勝手だけど！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270125,
					"content": "最近はどう？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "うん？悪くないよ、心配しないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270127,
					"content": "どうせ一人で旅をするのも、初めてじゃないしね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270128,
					"content": "ピピ！ピピ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "ブンブン"
				},
				{
					"id": 733270129,
					"content": "ハハッ、はいはい！君も一緒だよね！分かってる分かってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270130,
					"content": "タニットの一件から、砂漠であたしにテントと食べ物を提供してくれる部族はなくなった…あたし、部族の保護を失ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270131,
					"content": "その後…「三十人団」のルコシャ兄貴があたしを受け入れてくれたんだけど…シティってどうしても不自由に感じてちゃってさ。その、母さんのこと、思い出しちゃうんだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270132,
					"content": "だからシティを離れて…やっぱり他の国に行こうと思って。今まで見たことのない景色を見てみたかったしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270133,
					"content": "それで、商船に乗って…気付いたらここに辿り着いてたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270134,
					"content": "それからは…ははっ、言えるほどのことは特にないよ！どこに行ったってボディガードの需要はあるから。特にこういうキャラバンが往復する大都市だとね！だから、まあまあな生活を送ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270135,
					"content": "へへっ、このままでもいいかもね…こういう流浪の日々を過ごすのもなかなか悪くないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270136,
					"content": "あたしとブンブンって、君とパイモンに似てる。そう思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270137,
					"content": "ふん、オイラはブンブンよりすごいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733270138,
					"content": "ピピーッ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "ブンブン"
				},
				{
					"id": 733270139,
					"content": "#はははっ、まあとにかく…{NICKNAME}、これ以上引き留めないでおくよ。ほんとは君たちに思う存分美味しいものをご馳走したかったけど、ヒョウ局の掟があるしね…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270140,
					"content": "コホン、こんなテンションだだ下がりの話はやめとこ。君に千のハグをあげる！これからの旅が順風満帆でありますように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270141,
					"content": "#{M#忘れないでね。あたしたちの旅路は、いつか必ずまた交わる日が来るから！}{F#…タニットにいた時に話したことも、忘れないでね。君が疲れたときや、休みたくなったとき…あたしたちはまた会えるかもしれない。}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270121,
					"content": "まさかここで会えるなんて思わなかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "うん…あ、あたしもまさかこんなところで君たちに会えるなんて思わなかった。すごく嬉しいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "ジェイド"
				},
				{
					"id": 733270123,
					"content": "へへっ、オイラたち、おまえが魚釣り…じゃなくて魚獲りしてるところを邪魔しちゃったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 733270124,
					"content": "うるさいな、パイモンちゃんったら！しゃべり過ぎだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "ジェイド"
				}
			]
		},
		{
