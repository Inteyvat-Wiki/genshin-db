			},
			"dialogs": [
				{
					"id": 732790201,
					"content": "どうだ、タッドラーは見つかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790202
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790202,
					"content": "そうか、まだ時間がかかりそうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790203
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790203,
					"content": "どうか一日も早くタッドラーを助けてくれ…時間は待ってくれないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マシーラ"
				}
			]
		},
		{
			"id": 7327904,
			"completionStepIds": [
				7327904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
