			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"マシーラ",
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790101,
					"content": "おお、旅人。尊き「ジンニーの主」、よく来てくれた。歓迎しよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790102
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790102,
					"content": "はぁ、砂漠の奴隷がまた一人、めでたいことですわ。我が主よ…まあ、構いません。あなたにはご自身の考えがあるのでしょうから、お任せしますわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790103
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790103,
					"content": "時間があったら、一度私のところに来てくれないか…明月と雨露を渇望するかのように、君の来訪を待ちわびていよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790104
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790104,
					"content": "そんなにへりくだった言い方だと、裏があると思われる。はっきり言ったほうがいいと思うけれど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790105
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790105,
					"content": "そ…そうか。ジンニーの主よ…確かに君に頼みがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790106
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790106,
					"content": "ははっ、大したことじゃないんだが…私の猟鷹「タッドラー」が…どうも危険な状況にあるみたいでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790107
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790107,
					"content": "まったく…私の足腰がしっかりしていれば、君に頼むこともなかったんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790108
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790108,
					"content": "なるほど。つまり、オイラたちがそいつを助けに行ったら、そのお礼にモラをたくさんくれて、それからお祝いにたらふくごちそうを振る舞ってくれる、ってことだろ！な？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790109,
					"content": "えっ…そ、そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790110
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790110,
					"content": "そういうことなら、オイラたちに任せとけ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790111,
					"content": "こういうときは、頭が冴えてるよね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790112
					]
				},
				{
					"id": 732790112,
					"content": "はぁ…では、この欲張りのおチビちゃんをお腹いっぱい食べさせるために、そうしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790113
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790113,
					"content": "ありがとう…それじゃあ、頼んだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790114
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790114,
					"content": "ああ…それとタッドラーが最後にいた場所はここだ。印をつけてあげよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790115
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790115,
					"content": "君たちに探してもらいたい人の名前はタッドラー…彼女は背が高く、肌が黒くて、淡い色の長髪で、長弓を携えている…えーと、これくらい情報があれば十分だろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790116
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790116,
					"content": "どう、覚えられそうかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790117
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790117,
					"content": "おう…背が高くて、肌の黒い女性。淡い色をした長髪で、長弓を持ってるんだな！へへっ、記憶力には自信があるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790118,
					"content": "ああ…黄砂と数々の困難を乗り越えられるよう、君たちを導く風があらんことを願おう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790119
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790119,
					"content": "よーし、行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7327902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
