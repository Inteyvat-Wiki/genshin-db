			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マシーラ",
					"タッドラー",
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "ああ、帰ってきたんだね、私の猟鷹よ！感謝する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790702,
					"content": "申し訳ありません…待ち伏せをされました。幸い、こいつらに助けられ、帰ってくることができました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790703,
					"content": "「こいつら」…？我らが尊き「ジンニーの主」だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790704,
					"content": "申し訳ありません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790705,
					"content": "そんなこと気にするなよ！タッドラーは怪我してるんだから、優しくしてあげないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790706,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790707,
					"content": "…怪我をしているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790708,
					"content": "…申し訳ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790709,
					"content": "どの獣に怪我を負わされた？もしかして人にか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790710,
					"content": "北方の人間です。やつらに待ち伏せされました…尾行していたことに気づかれ、罠を仕掛けられたのです…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790711,
					"content": "罠は君が仕掛けるものだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790712,
					"content": "捕るべき獲物に逆に捕られるとは、猟鷹であるというのに恥ずかしくないのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790713,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790714,
					"content": "…少し休め、今は休んだほうがいい。あとで怪我の手当をしよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790715,
					"content": "タッドラーはただ黙って頷き、痛みを我慢しながらゆっくり離れていった。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "マシーラはタッドラーにちょっと厳しいな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790717,
					"content": "#{M#君}{F#あなた}たちの関係は…悪いの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "うん？いやいや、そんなわけないだろう！あの子は私の最愛の猟鷹だ…だが、決して溺愛するつもりはない。獲物の捕れない猟鷹を甘やかすわけにはいかないだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790719,
					"content": "なるほど…あらあら、あの子、楽な生き方はできそうにないですわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790723,
					"content": "これは君への報酬だ、ぜひとも受け取ってくれ。尊き「ジンニーの主」よ、感謝する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790724,
					"content": "コホン、お礼の相手に漏れがあるのでは？あと二人いたような。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790725,
					"content": "ヘヘっ、その一人は「人」とは言えないけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790726,
					"content": "ああ…うっかりしていた。こちらのおチビちゃんは人間ではなかったのだったな。でも、私たちも感謝されるべきだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790727,
					"content": "おいっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790728,
					"content": "はっはっはっ、すまん、すまん。追加の報酬も受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790729,
					"content": "追加の報酬までくれるのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790730,
					"content": "…それでも物足りないけれど、我が主が納得なさるのなら、それでよしとしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790731,
					"content": "なら、よかった。あっ…もし時間があるなら、もう一度来てくれないか…我が「猟鷹」には、まだ君の助けが必要なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790720,
					"content": "タッドラーをあまりいじめないで。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "いじめる？いや、私が甘やかしたせいで、あの子の腕は鈍ってしまったんだ…だから、教育しているだけさ。あの子は優秀な「猟鷹」だ。私がどうして傷づけるというんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "マシーラ"
				},
				{
					"id": 732790722,
					"content": "猟鷹はどんな結末を迎えるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "リルパァール"
				}
			]
		}
	]
}