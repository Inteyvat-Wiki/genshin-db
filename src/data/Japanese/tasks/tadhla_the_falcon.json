			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"リルパァール",
					"ファデュイ先遣隊甲",
					"ファデュイ先遣隊乙",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790401,
					"content": "しっ…！見ろ…あそこに誰かいるぞ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790402,
					"content": "ああ…我が主よ、あれは…あなたたちが何度も口にしてた「ファミュイ」とかいうやつらですわね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790403,
					"content": "「ファデュイ」だよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "何が違うのでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790405,
					"content": "静かに！バレちゃうぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790406,
					"content": "問題ない、彼らにこちらの話は聞こえないのだから。証明してやろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790407,
					"content": "ハーイ！おデブさん！こっち、こっち！ごはんの時間ですよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790408,
					"content": "うん…？何か聞こえなかったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "ファデュイ先遣隊甲"
				},
				{
					"id": 732790409,
					"content": "いや、特に？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "ファデュイ先遣隊乙"
				},
				{
					"id": 732790410,
					"content": "そうか…メシの時間かと思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "ファデュイ先遣隊甲"
				},
				{
					"id": 732790411,
					"content": "フフッ、ほら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790412,
					"content": "リルパァールもこんなお子さまっぽいいたずらをするんだな…ヘヘっ、カワイイとこあるじゃんかよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790413,
					"content": "おい…あれ！閉じ込められてるのって、タッドラーじゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790414,
					"content": "えっと、たしか…背が高くて、肌が黒くて、淡い色の髪…タッドラーに間違いないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790415,
					"content": "記憶力がいいではないか、おチビちゃん。さあ、我が主よ、助けにいきましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790416,
					"content": "よーし、旅人、行くぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7327906,
			"completionStepIds": [
				7327906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7327906",
							"2"
						],
						"stepId": 7327906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"タッドラー",
					"リルパァール"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790601,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790602
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790602,
					"content": "えーと…タッドラーだよな？オイラたち、おまえを助けにきたんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790603,
					"content": "ん…？そうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790604,
					"content": "あなたたちはやつらを逃がした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790605,
					"content": "あいつらは脅威にならない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "…やつらは帰って他の連中に告げるはずだ。そしたら、私たちの居場所が知られてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790608,
					"content": "ほう、私も同じことを考えていた——この子、気に入りましたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790609,
					"content": "心配はいらないぞ！あいつらが来たら、オイラたちがまたやっつけるから！それより、おまえ怪我してるのか…ツラかったら手を貸すぞ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790610,
					"content": "大丈夫、まだ歩ける。死に場所にたどり着くくらいは余裕だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790611,
					"content": "ああ…ならよかった。死に場所まで行けるなら——って、おい、それはまずいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 732790612,
					"content": "冗談だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790613,
					"content": "ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790614,
					"content": "この子のユーモアセンス…何となく好きだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790615,
					"content": "ありがとう、もう帰ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790616,
					"content": "足は大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "大丈夫じゃないけど、手助けはいらない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790618,
					"content": "少し休憩しようか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "休憩…？いや、あなたたちとはまだそんな仲じゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790620,
					"content": "でも、お互いのことをもう少し知ってもいいだろう？どうだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "リルパァール"
				},
				{
					"id": 732790621,
					"content": "ありがたい申し出だが、それはまた今度にする。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タッドラー"
				},
				{
					"id": 732790606,
					"content": "すべて倒す必要はない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
		{
			"id": 7327907,
			"completionStepIds": [
				7327907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
