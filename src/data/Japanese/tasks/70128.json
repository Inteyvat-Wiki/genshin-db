				"points": []
			},
			"dialogs": [
				{
					"id": 701280101,
					"content": "あれ、この瓶やけにずっしりしてるな。何か入ってるみたいだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280102,
					"content": "「昨日、古い友人が悪い知らせを持ってきました…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280103,
					"content": "「長い間ずっと返信をもらっていません。彼の言う通り、私は現実を受け入れるべきかもしれません」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280104,
					"content": "「それでも。もしあなたがまた旅して回っていて、この手紙を受け取ったのなら、どうか返信をください」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280105,
					"content": "「一目であなたからだと分かるように、手紙にはあなたの徽章を付けてくださいね」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280106,
					"content": "「『烏有亭』を覚えていますか。そこで相まみえましょう。酒代も手紙に入れておきました」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280107,
					"content": "「もしこれを読んでいるあなたが、私が求めている人ではないのなら…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "漂流瓶"
				},
				{
					"id": 701280108,
					"content": "「どうかこの手紙を手元に残して、私の人探しを手伝ってください。このモラはお礼です」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "漂流瓶"
				}
			]
		}
	]
}