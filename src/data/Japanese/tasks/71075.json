			"dialogs": [
				{
					"id": 710750101,
					"content": "おい、そこのお前！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750102,
					"content": "兄貴たちが半日探しても見つからなかったんだが、お前のようなここをよく知ってるやつなら見つけられるよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750103,
					"content": "見つけられない？それなら見つけられる誰かさんを待って、探させて、見つけた後に奪うだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750104,
					"content": "俺は「小軽策」って呼ばれてる。層岩巨淵の鉱夫ごときに手こずってどうするってんだ？ほら、俺に渡してみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750105,
					"content": "千岩軍の宝は、俺たち宝盗団がいただくぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750106,
					"content": "何を求めてるかは知らないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "お前の話なんか信用できるかよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750109,
					"content": "…ふん、お前ら、毎日のようにあちこちを駆けずり回ってるようだが、意外と頑丈じゃないんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750110,
					"content": "さあ選べ。俺のパンチを喰らって無理やり持ち物を調べられるか、それとも大人しく「加護の冠」を渡すか、どっちにするんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750111,
					"content": "#{M#俺}{F#私}に喧嘩を売らない方が身のためだよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "ほう、いい度胸じゃねぇか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750113,
					"content": "こうなったらもうやるしかねぇな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750107,
					"content": "ここにはない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				}
			]
		}
	]
