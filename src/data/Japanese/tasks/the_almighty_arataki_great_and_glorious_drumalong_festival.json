			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木村"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840301,
					"content": "何かお困りごとですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840302
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840302,
					"content": "開催されるお祭りについて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840303
					]
				},
				{
					"id": 726840303,
					"content": "うん？お祭り？お祭りが開催されるという話は聞いていませんが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840304
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840304,
					"content": "もっと詳しい情報はありますか？たとえば、そのお祭りの名前とか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840305
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840305,
					"content": "お祭りの名前は荒瀧極上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840306
					]
				},
				{
					"id": 726840306,
					"content": "荒瀧極上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840307,
						726840308
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840307,
					"content": "荒瀧極上盛世…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				},
				{
					"id": 726840309,
					"content": "荒瀧派が主催してる荒瀧極上盛世豪鼓大祭典だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840310
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840310,
					"content": "ああ！この前、容彩祭で騒ぎを起こしたあの荒瀧派ですね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840311
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840311,
					"content": "では、あの未認可の催しのことを言っているんでしょうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840312
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840312,
					"content": "未認可の催し？いやいや、違うぞ。荒瀧極上盛世豪鼓大祭典のことを言ってるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840313,
					"content": "あ、いえ、そう何度も名前を言わずとも状況はだいたい理解しました。その件について説明しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840314
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840314,
					"content": "確かに数日前、私どもはここで荒瀧派の者を見かけています。彼らは、ここの景観を損なうようなものをあちこちに積み上げていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840315
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840315,
					"content": "ここで容彩祭よりも大きな祭りを開催するんだ、と先頭に立った者が言っていました。あれがたぶん、あなたたちの言う祭りのことなんだと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840316
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840316,
					"content": "話を聞いてみたところ、彼らは催しの開催許可も会場の使用証明も持っていませんでした。奉行所で事前に申請すべき手続きにも、そういった記録は一切ありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840317
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840317,
					"content": "明らかに未認可なものでしたので、私たちは規定に従い、強制的にその催しを中止させたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840318
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840318,
					"content": "え？強制的に中止？じゃあ、あいつらまさか捕まったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840319,
					"content": "いえ、彼らはそういった経験が浅かっただけで、安全対策も一応用意していたので、そこまではしませんでした。簡単にその辺の決まりを彼らに教えて終わらせています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840320
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840320,
					"content": "安全対策、あいつらも安全意識はしっかり持ってるんだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840321,
					"content": "もし荒瀧派をお探しでしたら、甘金島に行ってみてはどうでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840322
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840322,
					"content": "甘金島は、社奉行が大小さまざまな祭りのために用意した会場です。その上、民間が主催する文化的な行事を育むことも目的としています。ですので、手続きも費用も最小限なものになっているんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840323
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840323,
					"content": "このことは荒瀧派の人にも教えました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840324
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840324,
					"content": "もし彼らに祭りを開催する気がまだあったら、あそこが一番適した場所でしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840325
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840325,
					"content": "うぅ…なんだか不安な気がしてきたけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840326,
					"content": "せっかく来たんだし…甘金島に行って探してみるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840308,
					"content": "荒瀧極上盛世豪鼓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840309
					]
				}
			]
		},
		{
			"id": 7268404,
