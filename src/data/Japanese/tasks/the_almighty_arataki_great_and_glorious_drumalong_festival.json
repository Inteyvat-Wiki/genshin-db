				"objectNames": [
					"晃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726847101,
					"content": "俺は荒瀧豪鼓祭で感想の募集を担当してる晃だ。今回の祭りに対する感想を教えてくれないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847102,
						726847103,
						726847104
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726847102,
					"content": "とても良いと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847105,
					"content": "なるほど。感想は確かに受け取った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847106
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726847106,
					"content": "え？他には何かないのかって？別に話すことは特にないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847107
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726847107,
					"content": "それに…「感想を教えてくれないか？」と「感想は確かに受け取った。」とだけ言えばいいって、親分に言われてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847108
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726847108,
					"content": "もし客からいつになったら意見を反映するんだと言われたら、「しばらくお待ちください。」と答えればいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847109
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726847109,
					"content": "他の催しでもみんなそうやってるって、親分が言ってたぜ。いい部分だから真似したんだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847110
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726847110,
					"content": "でも、これじゃあ客を誤魔化しているだけだと、忍の姉御に言われた。で、姉御は俺に筆記帳を用意してくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847111
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726847111,
					"content": "ほら、お前の感想もこれに書いておいたぞ。忍の姉御が戻ってきたら見せるつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "晃"
				},
				{
					"id": 726847103,
					"content": "普通だと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				},
				{
					"id": 726847104,
					"content": "良くないと思う。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847105
					]
				}
			]
		},
		{
