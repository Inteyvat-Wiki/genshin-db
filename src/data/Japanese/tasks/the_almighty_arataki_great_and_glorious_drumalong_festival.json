				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840660,
					"content": "宵宮も来てるって聞いたけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840661
					]
				},
				{
					"id": 726840661,
					"content": "あの長野原花火屋の店主のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840662
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840662,
					"content": "あいつは、ほんと熱くておしゃべりなやつだよな。甘金島に荷物を届ける途中、たまたま俺らの祭典を知ったみてぇだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840663
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840663,
					"content": "この祭典を気に入ってくれたらしくて、お祝いに来てくれた。次は花火を用意してくれるとも言ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840664
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840664,
					"content": "今後は荒瀧派も、長野原花火屋にちょくちょく顔を出したほうが良さそうだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840631,
					"content": "それより兄弟、今回の祭典について何か聞きてぇことはねぇか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
		{
			"id": 7268433,
