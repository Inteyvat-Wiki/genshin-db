				"points": []
			},
			"dialogs": [
				{
					"id": 726840701,
					"content": "俺は荒瀧豪鼓祭の案内人の元太だ。豪鼓祭演を始める準備はできたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840702
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840702,
					"content": "あっ、そうだ。この小鼓だが、親分が一つ説明するのを忘れててな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840703
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840703,
					"content": "俺たちみんな楽器には詳しくないから、始める前にお前が調整したほうがいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840704
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840704,
					"content": "そうすれば、より美しい音が出るはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840705
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840705,
					"content": "さあ、試してみてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "元太"
				}
			]
		},
		{
