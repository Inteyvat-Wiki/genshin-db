			]
		},
		{
			"id": 7268405,
			"completionStepIds": [
				7268405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268405",
							"2"
						],
						"stepId": 7268405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博彦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840501,
					"content": "二人とも、何か用かい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840502
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840502,
					"content": "荒瀧派を探してる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840503
					]
				},
				{
					"id": 726840503,
					"content": "ああ、分かったぞ。君たちもあの荒瀧極上なんとか大祭典っていうのに参加しに来たんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840504
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840504,
					"content": "君たちも？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840505
					]
				},
				{
					"id": 726840505,
					"content": "そうだ。ついさっき天領奉行の九条裟羅様と、長野原花火屋の宵宮さんも来たんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840506
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840506,
					"content": "宵宮さんは花火を届けに来た際、彼らが会場の準備をしているところをたまたま見かけたみたいでね。興味をそそられたのか、見に行ったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840507
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840507,
					"content": "九条裟羅様のほうはいったい何のためにここへ来たのか、よく分からなかったが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840508
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840508,
					"content": "オイラたちよりも先にここに着いた人がいたんだな！へへへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840509,
					"content": "で、荒瀧派のやつらは今どこにいるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840510
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840510,
					"content": "それが残念ながら、最近は島に空いている場所がなくてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840511
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840511,
					"content": "だから、彼らには北西の小さな浜辺を会場として手配した。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840512
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840512,
					"content": "もう少し早く申し込んでくれていれば、もっと良い場所を用意してあげられたんだが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840513
					],
					"speakerTitle": "博彦"
				},
				{
					"id": 726840513,
					"content": "北西の方に向かえば、彼らを見つけられるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博彦"
				}
			]
		},
		{
			"id": 7268406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268406",
							"2"
						],
						"stepId": 7268406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"荒瀧一斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840601,
					"content": "ガーッハッハッハッ！やっと来てくれたか、マブダチ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840602
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840602,
					"content": "ちょうど、お前がいつ来るのかと思ってたところだ。来てくれて嬉しいぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840603
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840603,
					"content": "俺様の会場を見てみろ。どうだ？これ以上、いい場所はねぇだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840604
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840604,
					"content": "三方は海に囲まれ、空気も澄んでる。町の喧噪から遠く離れ、よそでは見ることのできない絶景を楽しめる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840605
					],
					"speakerTitle": "守"
				},
				{
					"id": 726840605,
					"content": "甘金島を背にしたここは、祭り文化の中心とも言えるだろう。極上のおもてなしと施設を独占できる好立地だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840606
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726840606,
					"content": "さらに陸路も水路も利用できて交通の便がいい。徒歩や船であっという間に来ることができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840607,
						726840608
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840607,
					"content": "確かに、いい会場だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				},
				{
					"id": 726840609,
					"content": "この会場を見た瞬間、俺様はビッときた——「ここしかねぇ」ってな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840610
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840610,
					"content": "あの瞬間、世界は大きく変わった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840611
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840611,
					"content": "親分最高！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840612
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840612,
					"content": "ぜったい、天領奉行のやつらに追い出されただけだよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840613,
					"content": "ゴホンッ…それより本題に入ろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840614
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840614,
					"content": "今回お前らに来てもらったのは、もちろん俺様の荒瀧極上盛世豪鼓大祭典に参加してもらいたいからだ！そして、この祭典には大きな意味がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840615
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840615,
					"content": "俺ら荒瀧派の名を宣伝することにもなるから、今後仲間を募集するのに役立つって親分は言ってたぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840616
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840616,
					"content": "それから、忍の姉御の卒業をお祝いすることができるとも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840617
					],
					"speakerTitle": "守"
				},
				{
					"id": 726840617,
					"content": "あと、資金不足で過去数回に渡って延期された団体活動の埋め合わせもだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840618
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726840618,
					"content": "まさに「大きな意味のある」祭典だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840619
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840619,
					"content": "晃…最後の一言は余計だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840620
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840620,
					"content": "忍がいないみたいだけど？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840621
					]
				},
				{
					"id": 726840621,
					"content": "祭典っつうのは、宣伝すればするほど参加する人も増える。だから、忍にはチラシを配ってもらってんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840622
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840622,
					"content": "おい！忍は主役なんだろ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840623
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840623,
					"content": "あいつが真面目に仕事してて、どうしておまえらがここでぶらぶらしてんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840624
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840624,
					"content": "俺様だって真面目に…真面目にお前らをもてなしてんだろうが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840625
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840625,
					"content": "実は、親分はさっき帰ってきたばかりなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840626
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840626,
					"content": "お前らがもうすぐ来るかもしれないから、わざわざ帰ってきたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840627
					],
					"speakerTitle": "守"
				},
				{
					"id": 726840627,
					"content": "親分も忍の姉御と一緒に、頑張って客寄せしてくれてたんだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840628
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726840628,
					"content": "おいおい、そう褒めんじゃねぇよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840629
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840629,
					"content": "へぇ、牛使い野郎も真面目に働いてたんだな。珍しく頼りになるじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840630
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840630,
					"content": "ふん、空飛ぶチビ助に話すことはねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840631
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840631,
					"content": "それより兄弟、今回の祭典について何か聞きてぇことはねぇか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840608,
					"content": "何だか、楽観的だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840609
					]
				}
			]
		},
