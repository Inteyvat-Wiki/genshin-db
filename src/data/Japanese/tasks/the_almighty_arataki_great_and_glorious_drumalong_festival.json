				"points": []
			},
			"dialogs": [
				{
					"id": 726847201,
					"content": "俺は荒瀧豪鼓祭で雰囲気作りを担当する守だ。どうした、何か困ったことでもあったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847202
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847202,
					"content": "うん？俺の仕事が気になると？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847203
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847203,
					"content": "俺の仕事は、ここで熱気に包まれた雰囲気を作ることだ。そうすることで、この祭典に来た人を「最高の気分だぜ」って気持ちにさせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847204
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847204,
					"content": "どうだ、そういう気持ちになってくれたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847205,
						726847206
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847205,
					"content": "まったくなってない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				},
				{
					"id": 726847207,
					"content": "おいおい…そんなこと言わないでくれよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847208
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847208,
					"content": "そう冷たくあしらわれたら、俺のやる気が削がれるだろ！まるで俺の仕事に意味がないみたいじゃないか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847209
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847209,
					"content": "親分のダチとして、親分の代わりに俺を鼓舞してくれないか。頼む、あの言葉を言ってほしい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847210
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847210,
					"content": "あの言葉って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847211
					]
				},
				{
					"id": 726847211,
					"content": "「最高の気分だぜ」って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847212,
						726847215
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847212,
					"content": "最高の気分だぜ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847213
					]
				},
				{
					"id": 726847213,
					"content": "おお！よかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847214
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847214,
					"content": "それこそ、俺に対する一番の評価だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847218,
					"content": "さあ、みんな！音を奏でろ！踊らにゃ損だぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "守"
				},
				{
					"id": 726847215,
					"content": "さ…さい…ごめん、言えない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847216
					]
				},
				{
					"id": 726847216,
					"content": "うっ…そうか、分かった。だが、たとえそう言われたとしても、荒瀧派のやつらはみんな自分の仕事を全うしてる。俺だけサボる訳にもいかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847217
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847217,
					"content": "どんな挫折を味わおうとも諦めてはならない、それが親分の教えだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726847218
					],
					"speakerTitle": "守"
				},
				{
					"id": 726847206,
					"content": "なるわけがない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726847207
					]
				}
			]
		}
	]
