					"荒瀧一斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726840632,
					"content": "祭典にはどんなイベントがあるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726840633
					]
				},
				{
					"id": 726840633,
					"content": "ハハハハッ！いろいろあんぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840634
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840634,
					"content": "あそこの小さい丘が見えるか？あれは豪歌嶺っつって、あそこに立てば、海に向かって自由に歌うことができる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840635
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840635,
					"content": "この篝火は、スミレウリを焼くのにピッタシだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840636
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840636,
					"content": "で、こっちの箱は『七聖召喚』をやるにも、虫相撲をやるにもちょうどいい大きさをしてる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840637
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840637,
					"content": "本当に「いろいろ」あるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840638
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840638,
					"content": "だが、この祭典の一番の目玉は豪鼓祭演だ。ほら、これを見てみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840639
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840639,
					"content": "お前らにこっそり教えてやる。これは俺様が秘密の仕入れ先から入手した上物だ。とある有名な陰陽師が残した小鼓で、本来なら八百万モラもする代物だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840640
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840640,
					"content": "だがその売り手は、このカッケェ俺様と「彼女」には縁があるっつって割引してくれた。たった八十万モラでいいって言ってくれたんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840641
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840641,
					"content": "八百万モラもするものが八十万モラになるなんて…どう考えても騙されてるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840642
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840642,
					"content": "当然、俺様だってそんな安っぽい手口には騙されはしねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840643
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840643,
					"content": "この小鼓のふちが破れてることに、俺様は一目で気が付いた。つまり、これは不良品だったんだよ！そんなもんが俺様に縁があるなんて、笑えるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840644
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840644,
					"content": "だから、俺様はもう一度値切った。最終的に八万モラで交渉成立したってわけだ。ガッハッハッ！本当に儲けもんだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840645
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840645,
					"content": "得したのは相手のほうな気もするけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840646
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840646,
					"content": "それより、牛使い野郎が八万モラも出せるなんて、そっちのほうが驚いたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840647
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840647,
					"content": "たかが八万モラだ、俺様を甘く見るなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840648
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840648,
					"content": "そのうちの二万は俺が出したけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840649
					],
					"speakerTitle": "元太"
				},
				{
					"id": 726840649,
					"content": "俺も…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840650
					],
					"speakerTitle": "守"
				},
				{
					"id": 726840650,
					"content": "ええっ！？親分、なんで俺だけ三万なんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840651
					],
					"speakerTitle": "晃"
				},
				{
					"id": 726840651,
					"content": "二万、二万、そして三万…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840652
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840652,
					"content": "牛使い野郎…自分は一銭も出さずに、子分から八万モラも搾り取ったのかよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840653
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726840653,
					"content": "おいおい、お前どういう計算してんだよ。お…俺様だって残りの一万モラを出してる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840665
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840665,
					"content": "さて、ダベんのはここまでだ。もうこんな時間だし、そろそろ忍のとこに戻んねぇと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840666
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840666,
					"content": "祭典はまだまだ始まったばかりだ。賑やかにするにはもっと人を呼ばねぇとなんねぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840667
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840667,
					"content": "その小鼓をちゃんと持ってろよ。豪鼓祭演を始める準備ができたら、元太に声をかけてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840668
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 726840668,
					"content": "そんじゃ、また後でな！兄弟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
		},
