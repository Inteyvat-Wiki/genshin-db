			"dialogs": [
				{
					"id": 726840401,
					"content": "他に何か質問はありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726840402
					],
					"speakerTitle": "木村"
				},
				{
					"id": 726840402,
					"content": "荒瀧派をお探しでしたら、甘金島に行ってみてください。",
					"roleType": "TALK_ROLE_NPC",
