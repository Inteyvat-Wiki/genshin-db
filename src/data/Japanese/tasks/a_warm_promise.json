			},
			"dialogs": [
				{
					"id": 765070101,
					"content": "#わあ、{NICKNAME}、見ろよ！いつの間にか、アルバムがいっぱいになってるぜ！どれも素敵だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070102,
					"content": "ほんとだね、時間が経つのは早いね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "へへっ。こんなにきれいな場所をたくさん見つけられただけでなく、こんなにたくさんの仲間の写真を撮れるとは思わなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070105,
					"content": "この写真！この最高のアングルを見つけ出すために、オイラすっごく苦労したんだぞ。でも、いい写真が撮れて本当によかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070106,
					"content": "パイモンの才能のおかげだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "へへっ、そりゃそうだぞ！オイラはおまえの最高のガイドだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070109,
					"content": "楽しい思い出を作ることが出来て、満足だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME}、この写真機を使って撮ってみた感じ、どうだったんだ？一気に上達して、もうすぐマスター・ルブランに追いつけそうな気分になってたりするか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070111,
					"content": "技術は…まだまだかな。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "#おう、そうだな！楽しいことが一番大事だ！それに{NICKNAME}の写真は、撮影マスターに全然負けてないとオイラは思うぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070114,
					"content": "全ての写真に、オイラたちが一緒に経験した物語が詰まってるんだからな。オイラにとっては、かけがえのない作品だぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070115,
					"content": "今後…えーっと、ほかのところで冒険する時にこの楽しい日々を思い出したら、きっと楽しい気分になれるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070116,
					"content": "これからも一緒に、沢山写真を撮ろうね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "おう！じゃあ約束だな。次のアルバムは、今よりもっと素敵にするぞ！オイラたちだけの思い出をもっともっと作ろうな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 765070112,
					"content": "重要なのは過程を楽しむことだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "「非常用資金」のおかげだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "写真の中には、それぞれ思い出が隠されてるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
}