			"dialogs": [
				{
					"id": 747100101,
					"content": "うん…心を込めて飾られた広い水槽の中で、お利口なお魚たちが泳ぎ回る…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100102
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100102,
					"content": "たしかに、とても綺麗な光景ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100103
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100103,
					"content": "アクアリウムの売りの一つだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747100104,
					"content": "外の水域でもこんなにおとなしくしてくれたらいいのにね。そうすれば、水中に潜る人たちは、自然の生命の美しい景色にもっと浸れるのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100105
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100105,
					"content": "本題に入るけど、キミたちの協力のおかげで、このお魚たちが暴れてる原因が分かったのよ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100106
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100106,
					"content": "ここ数年、水難事故が次々と起きたのと、悪い人たちがゴミを不法に廃棄するせいで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100107
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100107,
					"content": "大量の人工物が海底に沈んで、たくさんのお魚のすみかを壊しちゃったのよ。そのせいで、お魚たちもどんどん攻撃的になってる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100108
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100108,
					"content": "すでに、プロの潜水士に依頼して、そういうゴミの処理は始めてもらってるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100109
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100109,
					"content": "もう少し急いでもらわないとダメみたいね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100110,
						747100111
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100110,
					"content": "短期間では解決できそうにないね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				},
				{
					"id": 747100112,
					"content": "ええ、地道にお迎えを続けて、できるだけ多くのお魚を療養させてあげましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100113
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100113,
					"content": "患者さんを病気の原因となる環境から隔離するのは、とっても重要な手順なのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100114
					],
					"speakerTitle": "シグウィン"
				},
				{
					"id": 747100114,
					"content": "おう！安心してオイラたちに任せてくれ。引き続き患者を探してくるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747100111,
					"content": "すぐには処理しきれなさそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				}
			]
		}
	]
}