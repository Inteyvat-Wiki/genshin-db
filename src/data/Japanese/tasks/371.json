			"dialogs": [
				{
					"id": 3710101,
					"content": "さっき…言わなかったことがあるよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3710102,
					"content": "あの時、オイラたちが見たのは、龍と結晶の他に…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710103,
						3710104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3710103,
					"content": "自分で調べたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				},
				{
					"id": 3710105,
					"content": "ああ、やっぱり覚えてたんだな、あの緑の野郎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3710106,
					"content": "——下にいるあの人と同じくらい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710107,
						3710111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3710107,
					"content": "本当に色が似てる！すごいね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710108
					]
				},
				{
					"id": 3710108,
					"content": "そうだろ？そうだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3710109,
					"content": "でもさ…なんかあいつ…見れば見るほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3710110,
					"content": "同じ人じゃないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3710111,
					"content": "たぶん…本人だと思う…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710112
					]
				},
				{
					"id": 3710112,
					"content": "なに——！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3710104,
					"content": "彼は悪い人に見えない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				}
			]
		},
