			},
			"dialogs": [
				{
					"id": 790080101,
					"content": "たぶんこれだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080102
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 790080102,
					"content": "ん？そこに手紙が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080103
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 790080103,
					"content": "縁あってここに来ることになった友へ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080104
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 790080104,
					"content": "こんにちは。遠くから来てこの手紙を読んでいるということは、私の残したバドルドーを見つけたみたいだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080105
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 790080105,
					"content": "金リンゴ群島にはバドルドーに関するゲームがたくさんあるから、私も友達たちと一緒にここで楽しい夏を過ごしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080106
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 790080106,
					"content": "だから私が作ったバドルドーをここに残しておくね。このバドルドーを偶々見つけたあなたが、私と同じ喜びを得られることを願って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080107
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 790080107,
					"content": "太陽の光、海の風、夏のゲームを楽しんでね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080108
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 790080108,
					"content": "——バーバラより",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790080109
					],
					"speakerTitle": "調べる"
				},
				{
					"id": 790080109,
					"content": "さすがバーバラだ。おかげで、オイラたちもバドルドーが手に入ったな！よし、じゃあ思いっきり遊ぶぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "調べる"
				}
			]
		},
