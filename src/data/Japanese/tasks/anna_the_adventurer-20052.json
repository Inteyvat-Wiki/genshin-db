			},
			"dialogs": [
				{
					"id": 200520101,
					"content": "よし…今日も任務完了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520102,
						200520106
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200520102,
					"content": "やる気満々だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520103
					]
				},
				{
					"id": 200520103,
					"content": "もちろん。だって冒険者をやるのって、本当に面白いもの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520104
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200520104,
					"content": "でも…えへへ、依頼をこなす時、まだちょっと慣れないことがあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520105
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200520105,
					"content": "旅人さん、また私と一緒に依頼を受けてもらえないかな？他にもあなたに教わりたいことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200520108,
					"content": "じゃあ、出発しよう。今日の依頼は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520109
					],
					"speakerTitle": "アナ"
				},
				{
					"id": 200520109,
					"content": "うん…また運搬用の熱気球の護送…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アナ"
				},
				{
					"id": 200520106,
					"content": "一緒に行こうか？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520107
					]
				},
				{
					"id": 200520107,
					"content": "いいの？えへへ、聞いてみたいことがまだまだあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "アナ"
				}
			]
		},
		{
			"id": 2005202,
			"completionStepIds": [
				2005204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2005203",
