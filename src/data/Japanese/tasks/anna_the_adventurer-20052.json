			"dialogs": [
				{
					"id": 200520301,
					"content": "旅人、アナのことを頼むよ。あの子、最近少しはしゃぎすぎてる気がするんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520302
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200520302,
					"content": "冒険者になってほしくないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520303
					]
				},
				{
					"id": 200520303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520304
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200520304,
					"content": "妹の夢は尊重してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520305
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200520305,
					"content": "病気が治って、やっと自分の夢を追うチャンスを手に入れたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520306
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200520306,
					"content": "アナの兄として、俺は…全力でそれを応援するつもりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520307
					],
					"speakerTitle": "アンソニー"
				},
				{
					"id": 200520307,
					"content": "ただ、それだけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンソニー"
				}
			]
		}
