			},
			"dialogs": [
				{
					"id": 2005902001,
					"content": "うーん、でも「売れそうなもの」だけではきっとわからないですよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902002
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 2005902002,
					"content": "そうですね、<color=#00E1FFFF>「ヒルチャールと関係する戦利品」</color>にしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 2005902003,
					"content": "自分の実力を見せたい冒険者たちは興味を持ってくれると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マージョリー"
				}
			]
		},
