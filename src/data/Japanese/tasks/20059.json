					"nextDialogs": [
						2005906002
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 2005906002,
					"content": "少し待っててください、これを売ったらまたお礼を渡しますね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005906003
					],
