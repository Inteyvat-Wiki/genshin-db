			"dialogs": [
				{
					"id": 2005910001,
					"content": "これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 2005910002,
					"content": "お客さん、すごいですね！これはうちの店の一番のおすすめですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 2005910003,
					"content": "これはこの旅人さんがヒルチャールの首領から入手したばかりの戦利品です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 2005910004,
					"content": "あのヒルチャールは長い間モンドを脅かしてきたんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 2005910005,
					"content": "旅人さんでも苦戦したんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 2005910006,
					"content": "そ、そんなに強いヒルチャールなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 2005910007,
					"content": "…これをサイリュスさんやスタンレーさんに見せたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 2005910008,
					"content": "僕のことを見直してくれるかもしれない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "ジャック"
				},
				{
					"id": 2005910009,
					"content": "その通りですよ。心配しないでください、うちはお客さんのプライバシーを必ず守りますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 2005910010,
					"content": "迷わないでください、この品はめったに手に入りませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 2005910011,
					"content": "もう少し考えさせてくれ…旅人、彼女の言ったことは本当なのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ジャック"
				}
			]
		},
