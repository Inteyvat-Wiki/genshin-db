			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"マージョリー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "まずいよ、どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200590102,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "旅人さん！ちょうどよかった！ここはうちが開いた記念品ショップだってことはあなたも知っていますよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200590104,
					"content": "前までは父さんが他の冒険者が持ち帰った戦利品を買って、店に置いていたのですが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200590105,
					"content": "冒険者協会が…前みたいに賑やかじゃなくなってから、買える戦利品も少なくなってしまったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200590106,
					"content": "その上、価値があまりないものばかりで、買ってくれるお客さんが全然いないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200590107,
					"content": "旅人さんはよく冒険に行くんですよね？何か売れそうな戦利品を探してきてくれませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200590108,
					"content": "分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "ではお願いしますね！きっといい値段で売ってみせますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200590110,
					"content": "パイモンはどうかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "ごめんなさい、それは売れないと思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "マージョリー"
				},
				{
					"id": 200590112,
					"content": "だって…絶対に自分で逃げてしまいますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マージョリー"
				}
			]
		},
		{
