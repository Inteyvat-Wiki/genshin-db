					},
					{
						"sceneId": 3,
						"position": [
							2590.03,
							341.248,
							2215.468
						],
						"pointId": 311500202
					}
				]
			},
			"dialogs": [
				{
					"id": 401990401,
					"content": "そうね、まずはこの辺を調べてみましょうか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990402
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990402,
					"content": "沈玉の谷の北東にある、人気のない道を夜蘭と共に進んでいく…\\n夜蘭の導きで目立たない場所に着くと、そこから海辺の状況を偵察した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990403
					]
				},
				{
					"id": 401990403,
					"content": "「ブラックマネー・ロード」の手下はおらず、周囲にも特に異常はないようだ。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990404
					]
				},
				{
					"id": 401990404,
					"content": "結局…ここは普通の郊外だったのか？悪者の痕跡なんて、どこにもなさそうだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990405,
						401990406
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990405,
					"content": "焦らないで、パイモン。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990407
					]
				},
				{
					"id": 401990407,
					"content": "もうすっかり役に入り込んでいるわね。最上級エージェントも顔負けだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990408
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990408,
					"content": "現段階で必要なのは「餌まき」に使う餌、つまり「ブラックマネー・ロード」の収集品よ。人を探すよりも、「カギとなる品を見つけること」のほうが大事なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990409
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990409,
					"content": "そして、その品を見つけるには、拠点の特定が不可欠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990410
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990410,
					"content": "ここは視界が開けてると思わない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990411
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990411,
					"content": "確かに…遺瓏埠の港、遠くに浮かぶ船、それに塔まで見えるぞ…そういえば、あの塔はなんのためのものなんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990412
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990412,
					"content": "千岩軍の灯台よ。普段は水域の見張りに使われている。光信号を送ることもあって、通信手段としての役割も担っているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990413,
						401990419
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990413,
					"content": "ここに来るメリットが分かったかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990414
					]
				},
				{
					"id": 401990414,
					"content": "そう？教えてくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990415,
						401990416,
						401990417
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990415,
					"content": "千岩軍を監視しておけば優位に立てる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990418,
					"content": "まあそんなところね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990425
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990425,
					"content": "沈玉の谷の重要な地域の治安を維持するため、千岩軍は毎日のように見回りの部隊を派遣している。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990426
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990426,
					"content": "ここの視界を利用して千岩軍の光信号を観察し、その行動パターンを予測できるようになれば、「ブラックマネー・ロード」の収集品を運搬するうえで大いに役立つわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990427
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990427,
					"content": "だから、この辺りに「ブラックマネー・ロード」の見張りが残した痕跡があるはずなの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990428
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990428,
					"content": "ふ、複雑すぎて、オイラ全然ついてけないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990429
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990429,
					"content": "とにかく、この<color=#00E1FFFF>総合映像記録器</color>を使って、周囲の調査と記録をお願い。入念に調べれば、きっと収穫があるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990416,
					"content": "ここが「対偵察」に最適な場所だから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990417,
					"content": "安全な輸送ルートを決めたいから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990418
					]
				},
				{
					"id": 401990419,
					"content": "ここに来る理由が分からない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990420
					]
				},
				{
					"id": 401990420,
					"content": "予想してみて？外れても構わないわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990421,
						401990422,
						401990423
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990421,
					"content": "隠れて千岩軍を偵察できるから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990424,
					"content": "やっぱり、君の勘は鋭いわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990425
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990422,
					"content": "ここから見張れば、主導権を握れるから？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990423,
					"content": "ここは拠点じゃなく、偵察スポット。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990424
					]
				},
				{
					"id": 401990406,
					"content": "まだその時じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990407
					]
				}
			]
		},
