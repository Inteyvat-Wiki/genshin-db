						],
						"pointId": 311500249
					}
				]
			},
			"dialogs": [
				{
					"id": 401990701,
					"content": "見つけたぞ！ここが例の荷物が隠されてる拠点か…結構わかりにくかったな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990702
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990702,
					"content": "すごい手際の良さね、本当に驚いたわ。君が一人で事件を捜査する日も、そう遠くなさそうね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990703
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990703,
					"content": "それじゃあ、見つけた鍵を使ってみましょう。何が待っているか、楽しみね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990704
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990704,
					"content": "千岩軍の見回りエリアに入ったからか、もう罠は設置されてなさそうね。こちらとしては好都合だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990705
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990705,
					"content": "ここから先は私に任せてちょうだい。拠点に入った後は、一切痕跡を残さないよう、慎重に動かないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990706
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990706,
					"content": "調査中に敵と鉢合わせないよう、外の見張りをお願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990707
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990707,
					"content": "おう！こんな仕事は初めてだけど、旅人なら絶対おまえを守ってくれるはずだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990708,
						401990709
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990708,
					"content": "夜蘭なら絶好のタイミングを選ぶはず…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990710
					]
				},
				{
					"id": 401990710,
					"content": "そ、それもそうか…夜蘭のやつ、いつも抜け目ないからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990711,
					"content": "夜蘭は拠点の扉を開けると、中を細かく観察し、この拠点が普通の地下室であることを確認した…\\nまだ工事が終わっていないのか、拠点上部と側壁は未完成で、ところどころ土壌から水が滲み出し、拠点内を流れている…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990712
					]
				},
				{
					"id": 401990712,
					"content": "夜蘭は薄い水元素で手を覆った。\\nこれなら、拠点内の物に触れても、時間が経てば自然と水が蒸発し、彼女の痕跡を消してくれる。\\n準備が終わると、夜蘭は慎重に拠点に踏み入り、中の荷物を調べ始めた…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990713
					]
				},
				{
					"id": 401990713,
					"content": "これでよし。拠点内の磁器、花瓶、茶葉の特徴はすべて記録したわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990714
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990714,
					"content": "この特徴を目印にすれば、競売で収集品を落札した買い手を追跡できる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990715
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990715,
					"content": "早い！やっぱ手慣れてるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990716,
						401990717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990716,
					"content": "これからどうする？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990718
					]
				},
				{
					"id": 401990718,
					"content": "そう焦らないで。フォンテーヌでは競売が頻繁に開催されているの。全部調べるとなると、人手がいくらあっても足りない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990719
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990719,
					"content": "私はこの近くに潜伏して見張りを続けながら、暗号を解読してみるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990720
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990720,
					"content": "犯人の二人が荷物を移動させたら、それ以降の競売に絞って調査を始めましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990721
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990721,
					"content": "わかった。なら今はとにかく待つしかないな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990722
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990722,
					"content": "あいつらがボロを出したら、痕跡をたどって、黒幕を見つけ出す…あとはそいつをボコボコにしてやるだけだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990723,
					"content": "エドラー捜査官も、あの二人を翹英荘まで誘い出した後、彼らが立ち去るのを待って、逆に尾行する手筈よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990724
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990724,
					"content": "この前あれだけ圧をかけたんだもの。焦って二日もしないうちに動き出すと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990725
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990725,
					"content": "その頃になったら、遺瓏埠の港近くで落ち合いましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990717,
					"content": "次のプランは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990718
					]
				},
				{
