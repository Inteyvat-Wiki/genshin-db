					{
						"sceneId": 3,
						"position": [
							2724.933,
							340,
							2188.074
						],
						"pointId": 311500205
					}
				]
			},
			"dialogs": [
				{
					"id": 401990601,
					"content": "なかなかの収穫ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990602
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990602,
					"content": "まず、鍵が一本。重要な扉を開くためのものかしら？そして、沢山の暗号が書かれた手紙。これは伝書鳩の通信筒に入っていたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990603
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990603,
					"content": "うわぁ…本当に犯行に使った道具があったのか？あいつら、いい度胸だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990604,
					"content": "偵察中に千岩軍に捕まって調べられたらどうしよう…とか考えないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990605
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990605,
					"content": "残っていたものから判断して、「ブラックマネー・ロード」の見張りは漁師に成りすましている可能性が高いわ。肝が据わっているはずよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990606
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990606,
					"content": "静かな場所で休憩していただけだと主張されれば、千岩軍も決定的な証拠がなければ一般市民を拘束して調べることはできない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990607
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990607,
					"content": "うぅ…シラを切る姿が目に浮かぶぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990608,
						401990609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990608,
					"content": "幸い、手がかりは見つかった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990610
					]
				},
				{
					"id": 401990610,
					"content": "痕跡はまだ新しかった。エドラー捜査官に捕まっていない見張りが、まだいるってことね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990611
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990611,
					"content": "調査中、相手に悟られないよう注意しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990612
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990612,
					"content": "夜蘭はあらかじめ用意していた道具セットを取り出すと、カギをコピーし、手紙の暗号の一部を記録した…\\nその後、現場を元通りにして、調査の痕跡をすべて消した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401990613
					]
				},
				{
					"id": 401990613,
					"content": "「ブラックマネー・ロード」がここに見張りを置いていた、という推測は正しかった。なら、荷物を隠した拠点はどこに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990614
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990614,
					"content": "君はどう思う？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990615,
						401990618
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990615,
					"content": "もしかしたら分かったかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990616,
						401990617
					]
				},
				{
					"id": 401990616,
					"content": "見張れる時間は限られてるから…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990621,
					"content": "勘がいいわね。もうあまりヒントは必要なさそう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990622
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990622,
					"content": "伝書鳩の速さを基に、短時間で飛べる距離を計算し、ここを中心に円を描く…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990623
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990623,
					"content": "そして灯台から見える、人通りが多い場所を除くと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990624
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990624,
					"content": "…暝垣山の北の浅瀬か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990625
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990625,
					"content": "そこが一番怪しいわね。山に隠れた地形を利用できるし、まさに「灯台下暗し」と言える最適な場所だわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990626
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990626,
					"content": "次の目的地も決まったし、早速出発しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990617,
					"content": "情報を最速で伝えないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990618,
					"content": "まだ確信はないけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990619,
						401990620
					]
				},
				{
					"id": 401990619,
					"content": "重要な情報を伝えるなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990620,
					"content": "伝書鳩の飛行時間を考えないと…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990621
					]
				},
				{
					"id": 401990609,
					"content": "手がかりをもとに調査を進められる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990610
					]
				}
			]
		},
