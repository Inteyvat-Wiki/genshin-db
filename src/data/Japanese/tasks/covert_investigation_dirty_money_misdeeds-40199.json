			"dialogs": [
				{
					"id": 401990501,
					"content": "見た感じ、ここもただの郊外みたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990502,
						401990503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990502,
					"content": "でも前回の経験からすると…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990504
					]
				},
				{
					"id": 401990504,
					"content": "怪しい痕跡を見逃さないでちょうだい。君たちを信じているわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990503,
					"content": "一見普通の場所にも何か隠されてるかも…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990504
					]
				}
			]
		},
		{
			"id": 4019906,
			"completionStepIds": [
				4019906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
