			},
			"dialogs": [
				{
					"id": 401990101,
					"content": "ちょっと待て、あそこにいるのって…夜蘭じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990102,
					"content": "友達とお茶会か…？絶好のタイミングだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990103,
						401990104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990103,
					"content": "（いや、違う。あの雰囲気は…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990105
					]
				},
				{
					"id": 401990105,
					"content": "えっ、挨拶しに行かないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990106,
					"content": "お疲れ様。これでもう全員捕まえたはずよね、エドラー捜査官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990107
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990107,
					"content": "こっちでの任務が終わるまであと数日あるし、自分へのご褒美に少し休んでいったら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990108
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990108,
					"content": "お気遣いありがとう、夜蘭さん。このところ、ずっと忙しくて死ぬかと思った…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990109
					],
					"speakerTitle": "エドラー",
					"speakerSubtitle": "「執律庭」エージェント"
				},
				{
					"id": 401990109,
					"content": "はぁ…拠点が十三ヶ所もあるなんて…宝盗イタチかよって感じだよね！あんまりゾロゾロ人が出てくるもんだから、なにかの間違いじゃないかと思っちゃった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990110
					],
					"speakerTitle": "エドラー",
					"speakerSubtitle": "「執律庭」エージェント"
				},
				{
					"id": 401990110,
					"content": "でもまあ、経済犯たちを一網打尽にできてよかったよ！これから翹英荘に行って、エンジニアの友達と久々に会う予定なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990111
					],
					"speakerTitle": "エドラー",
					"speakerSubtitle": "「執律庭」エージェント"
				},
				{
					"id": 401990111,
					"content": "そう。執律庭のみんなに、お茶やお菓子のお土産を持って帰ってあげたら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990112
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990112,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990113
					],
					"speakerTitle": "コーダー"
				},
				{
					"id": 401990113,
					"content": "あっ、夜蘭の友達、行っちゃったぞ。挨拶しようと思ってたのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990114,
						401990115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990114,
					"content": "（盗み聞きしてたあの二人は絶対怪しい…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990116
					]
				},
				{
					"id": 401990116,
					"content": "二人とも奇遇ね。ほら、座って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990117
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990117,
					"content": "店主、一番上質な「雲来の白豪」をちょうだい。茶器も二セットお願い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990118
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990118,
					"content": "さっき盗み聞きをしてた二人に興味があるって顔ね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990119
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990119,
					"content": "えっ、盗み聞き！？どういうことだ？他に人がいたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990120,
						401990121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990120,
					"content": "あの二人は明らかに何かを企んでた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990122
					]
				},
				{
					"id": 401990122,
					"content": "盗み聞きだけじゃないわ。おそらく、エドラー捜査官を尾行して私たちの行動ルートを把握しようとしているはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990123
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990123,
					"content": "わ、わかったぞ！夜蘭は犯罪者を追ってるんだな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990124,
					"content": "あいつら、おまえたちを尾行しようだなんて大した度胸だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990125
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990125,
					"content": "これくらいリスクを顧みないやつらじゃないと、私の相手に相応しくないでしょ？本当は同業者に手柄を譲って、ゆっくり休むつもりだったんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990126,
						401990127
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990126,
					"content": "夜蘭が動くなんて、深刻な事態なの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990128
					]
				},
				{
					"id": 401990128,
					"content": "「モラロンダリング」、つまり資金洗浄よ…額は十数桁に上るわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990129
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990129,
					"content": "モラロンダ…なんだって？ていうか…じ、十数桁っていくらなんだ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990130,
					"content": "簡単に言うと、あるフォンテーヌの商人が不法に手に入れたモラを大量に所有していたの。フォンテーヌの法執行機関であれば、それがどうやって得たモラなのか、簡単に特定できてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990131
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990131,
					"content": "だから彼は、モラを「合法的な」ものに変換する必要があった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990132
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990132,
					"content": "そこで商人はある方法を思いついた——「高価な美術品」を競売に出すのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990133
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990133,
					"content": "各地で買い集めた品々をフォンテーヌに運び込み、美しい美術品と偽って高値をつける。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990134
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990134,
					"content": "そして、競売で自らそれを競り落とし、不法に手に入れたモラで支払う。すると、手数料を差し引いて、手元に残ったモラが「キレイ」になるというわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990135
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990135,
					"content": "商人はこの手段で自分だけでなく、他の犯罪者の資金洗浄も請け負うようになった。そうして彼は「ブラックマネー・ロード」と呼ばれるようになったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990136,
						401990137
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990136,
					"content": "その収集品が璃月のものなんでしょ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990138
					]
				},
				{
					"id": 401990138,
					"content": "沈玉の谷の品は値段が手頃なうえ、精巧で歴史があるものが多いから、狙われるのも無理ないわ。茶器、磁器、玉玦、石彫…どれも高価な美術品になりうる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990139
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990139,
					"content": "でも、璃月の品を利用した悪事を放置していたら、貿易に計り知れない損害を与えることになるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990140
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990140,
					"content": "たまたま休暇でフォンテーヌに行っていただけなんだけど…そういうわけで、仕事をする羽目になったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990141
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990141,
					"content": "なるほど…夜蘭の説明ってわかりやすいな！つまり、目くらましを使っただけで…実際はお金を右から左に移しただけってことだな…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990142,
					"content": "でも、犯行の手口がもうわかってるなら、それを手がかりに捜査すれば、逮捕できるんじゃないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990143
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990143,
					"content": "競売の会場で悪者を待ち伏せして、そいつが璃月の品を買おうとした瞬間に捕まえるとか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990144,
					"content": "冴えてるじゃない、パイモン。でも、慎重さに欠けるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990145
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990145,
					"content": "仮に君が黒幕だとして、他の人たちが見ている中を、わざわざ自分の足で動き回るかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990146
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990146,
					"content": "確かに、誰かに見られるのはマズいよな…もしオイラが悪者だったら、旅人をパシリに使うかも？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990147,
					"content": "いやいや、たとえオイラが悪者になっても、こいつは悪者になったりしないはずだ！それなら…たくさん子分を雇って、買い物や汚れ仕事を任せる、とか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990148
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990148,
					"content": "おお…なるほど、そういうことか…オイラにもわかったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990149
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990149,
					"content": "たとえ問題の収集品を追跡できたとしても、黒幕の「ブラックマネー・ロード」が競売に来ない限り、こっちはなにもできないってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990150
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990150,
					"content": "競売への参加だけじゃないわ。国外からの購入、国内への輸送、そして出品者や競売主催側との連絡…すべてが部下に任されている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990151
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990151,
					"content": "取引に使われた収集品の追跡も一筋縄ではいかないわ。彼は様々な手段で美術品を転々とさせていて、取引の痕跡がかなり錯綜しているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990152
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990152,
					"content": "今のところは、このまま泳がせるのが一番合理的なやり方ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990153
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990153,
					"content": "カモフラージュをかいくぐりつつ、はっきりとした足跡が残る餌を使って、裏にいる「ブラックマネー・ロード」を引っ張り出す…それが最終目標よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990154,
						401990155
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990154,
					"content": "それで、わざと盗み聞きさせたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990156
					]
				},
				{
					"id": 401990156,
					"content": "て、てっきり仕事が終わったから、気を抜いてたのかと思ったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990157
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990157,
					"content": "やっぱり君には素質があるわね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990158
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990158,
					"content": "少し前、千岩軍と連携して、エドラー捜査官と「ブラックマネー・ロード」の拠点を大量に潰したから、組織の人員はほぼ捕えられたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990159
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990159,
					"content": "さっきの二人は「ブラックマネー・ロード」でも特に重要な代理人で、彼と直接連絡を取れる腹心たちよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990160
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990160,
					"content": "一人はフォンテーヌ骨董品協会で幹事をしているコーダー。主に競売に関する業務を担当している。もう一人はスメールの船主ドッダマーニ。長年、貨物輸送業に携わっているわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990161
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990161,
					"content": "私たちはわざと彼らを見逃したの。慎重な彼らなら、きっとこの機会を無駄にせず、モラや荷物の処理に取り掛かるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990162
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990162,
					"content": "彼らがエドラー捜査官を尾行するのもそのため。璃月にいる残りの部下が安全に荷物を移せるよう、彼女の行動を確認しておきたいんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990163
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990163,
					"content": "彼らの不意を突くなら、エドラー捜査官に注意が向いている今だと思うの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990164
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990164,
					"content": "どう？一緒に来てくれるかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990165
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990165,
					"content": "今度は君がどんな才能を発揮してくれるのか、楽しみだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990166,
						401990167
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990166,
					"content": "#{M#俺}{F#私}も犯罪者を許せない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990168
					]
				},
				{
					"id": 401990168,
					"content": "おう！こんな重大事件に出会ったら、見て見ぬふりなんてできないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990169
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990169,
					"content": "夜蘭の力になれるだけじゃなくて、沈玉の谷のみんなや…ええと…璃月の経済を助けることにも繋がるからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990170
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401990170,
					"content": "素晴らしい責任感だわ、旅人、パイモン…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990171
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990171,
					"content": "でも、自分たちの利益も忘れないで。君たちには、フォンテーヌでいう「最上級エージェント」が危険な任務を遂行した場合と同等の報酬が支払われるはずよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990172
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990172,
					"content": "何事も最初が一番難しいものだけど、幸い手がかりはもう掴めている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990173
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990173,
					"content": "「ブラックマネー・ロード」の組織はとても慎重なの。だから、彼らの偵察活動を逆に利用する「対偵察」から始めるのがいいと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401990174
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990174,
					"content": "大体の予想はついているから…まずは北東に行って、それを確かめてみましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 401990167,
					"content": "#{M#俺}{F#私}も夜蘭と一緒に仕事をしてみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990168
					]
				},
				{
					"id": 401990155,
					"content": "さっきは油断したフリをしてたんだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990156
					]
				},
				{
					"id": 401990137,
					"content": "でなきゃ夜蘭が動くわけない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990138
					]
				},
				{
					"id": 401990127,
					"content": "彼らはどんな組織で何の罪を犯したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990128
					]
				},
				{
					"id": 401990121,
					"content": "さっきの友達との会話も聞かれてた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990122
					]
				},
				{
					"id": 401990115,
					"content": "（夜蘭が気づいてないわけがないけど…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990116
					]
				},
				{
					"id": 401990104,
					"content": "（怪しい視線を感じる…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401990105
					]
				}
			]
		},
