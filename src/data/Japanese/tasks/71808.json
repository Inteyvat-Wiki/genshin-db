					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "「あの方」の復活を見に来たのかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "阿鳩"
				},
				{
					"id": 718080204,
					"content": "ちょっと早く来てしまったな…まあ、早すぎってこともないけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "阿鳩"
				},
				{
					"id": 718080205,
					"content": "彼女は何を言ってるんだ、さっぱりわからない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 718080206,
					"content": "うーん、何言ってるんだ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "ふふ、まだ気づいてないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "阿鳩"
				},
				{
					"id": 718080208,
					"content": "君にとっては、それもいい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "阿鳩"
				},
				{
					"id": 718080209,
					"content": "帰った方がいい、「あの方」が復活する時、全てが分かる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿鳩"
