					"nextDialogs": [
						718080307
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 718080307,
					"content": "地震だったり魔物だったり、あの子に何も起きなきゃいいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "嘉義"
				},
				{
					"id": 718080308,
					"content": "ありがとう、これを受け取って。手伝ってくれて助かった。",
