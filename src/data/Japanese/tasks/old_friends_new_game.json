						735070506
					]
				},
				{
					"id": 735070506,
					"content": "#来たな、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070507
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070507,
					"content": "「チエキノコン布陣」のほうは順調か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070508,
						735070509
					],
					"speakerTitle": "パイモン"
				},
