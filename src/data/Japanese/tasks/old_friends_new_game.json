			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ハニヤー",
					"バルフォア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#「ゴールド流星」の{NICKNAME}に「シルバー伴星」のパイモン…久しぶりね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070102,
					"content": "相変わらず元気そうじゃない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070103,
					"content": "また会ったね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "おまえ、ハ…ハニヤー！それに責任感が超強い…バルフォアじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070105,
					"content": "まさか、またオルモス港で会えるなんて思わなかったぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070114,
					"content": "ところで、ハニヤーとバルフォアはこんなところでなにしてるんだ？ここって確か、「フラワーゼリー」の屋台があったんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070115,
					"content": "これはこれは、大英雄のお二人さんじゃないか！君たちの声を聞いてるだけで、なんだか俺も自信が湧いてくるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070116,
					"content": "さて、お二人に仕事の成果を報告する時だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070117,
					"content": "前回、お二人は「サウマラタ蓮杯テイマー大会」のチャンピオンとして、大会の開催を一旦休止し、教令院に「叡智宝珠」を改良させた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070118,
					"content": "お二人はまだ、こいつの知らせを待ってるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070119,
					"content": "おう！進展があったら、レイラかセノ、それか担当の学者が知らせに来てくれるはずだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070120,
					"content": "パイモンはこんなこと分からないもんね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "そうなんだよな。オイラたちが聞いたところで役に立てないし、むしろ邪魔になっちゃうかもしれないだろ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070123,
					"content": "君たちはずいぶん落ち着いてるな！それに慎重だ。俺なんか、前回の大会の盛り上がりをしょっちゅう思い出しては、うずうずしちまって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070124,
					"content": "それでこないだ、教令院の関係者に何とか状況を聞いたんだが…そしたら詳しい返答が帰ってきたんだ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070125,
					"content": "今んとこ、改良版「叡智宝珠」は未だに理論段階で、生産までには、まだまだ時間がかかるらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070126,
					"content": "だが、第一回の大会の話題性は薄れて、だんだん忘れ去られつつある。このまま大会の影響力を無駄にしていちゃいけない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070127,
					"content": "そこで、俺はハニヤーさんを見つけだして、新しい「テーマイベント」を開催することにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070128,
					"content": "「テーマイベント」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "もしかして、机の上にある…このキノコンの形をした駒のことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070130,
					"content": "そうよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070131,
					"content": "バルフォアさんは次の大会のために、ずっと新しい案を準備してたわ。資金調達に走り回って、ビジネスの勉強のために璃月にまで行って来たのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070132,
					"content": "璃月で経営を学んでいたときに、彼は「機関棋譚」という新しいゲームに出会った。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070133,
					"content": "それでバルフォアさんは、「機関棋譚」をスメールで開催する権利を買い取って、私を顧問に雇い——目新しいゲームを一緒に企画したってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070134,
					"content": "その名も「チエキノコン布陣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070135,
					"content": "「チエキノコン布陣」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070136,
					"content": "待てよ、当ててやるぜ…今回はキノコンを指揮して、色んな機関と戦えって言うんだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070137,
					"content": "はは、さすが「シルバー伴星」だ。一発正解だな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070138,
					"content": "俺が思うに、このゲームは理解しやすいし、広めやすい。とんでもない将来性を秘めてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070139,
					"content": "「テイマー大会」の派生ゲームという名目で流行らせられれば、みんなに大会を覚えてもらえるし、期待してもらえる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070140,
					"content": "そしたら、次の大会を開催する時、より沢山の選手と観客を集められるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070141,
					"content": "もちろん、これにはまずお二人の許可が必要だ。何せ、今や大会の決定権を握っているのは君たちだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070142,
					"content": "試す価値はあると思う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#そうだな。オイラも{NICKNAME}も、ビジネスのことはよくわかんないけど、バルフォアの言ったことは筋が通ってると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070145,
					"content": "これはハニヤーとバルフォアが一緒に頑張った結果なんだし、おまえたちの才能を信じてるから、思い切ってやってみてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070146,
					"content": "オイラはまだプレイしたわけじゃないけど、きっと沢山の人がハマってくれると思うぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070147,
					"content": "そう言ってくれてよかった！お二人さんから許可も得たことだし、これからは思い切って「チエキノコン布陣」を広められるぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070148,
					"content": "現在、「チエキノコン布陣」はまだテスト段階にある。試遊してくれた人からの意見を集めて、改良を重ねなくちゃならないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070149,
					"content": "テイワットで流行りのゲームを数十種も熟知する「ゴールド流星」にも遊んでもらえれば、きっと的確なアドバイスがもらえると思うんだが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070150,
					"content": "#よし行け、{NICKNAME}！おまえの得意分野の一つだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070151,
					"content": "なんか指揮されたような…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "でも、その…もう一つハニヤーに聞きたいことがあるんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070154,
					"content": "ポコポコビーニーたちのこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070155,
					"content": "その通りだ！キノコンの仲間たちが恋しいんだ。あいつらは今、どうしてるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070156,
					"content": "安心して。みんな元気で、気ままな毎日を生きてるわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070157,
					"content": "テンテンヨーヨー獣と百雷遮羅は、<color=#00E1FFFF>オルモス港の北にある私の仮住まい</color>にいる。前回の参加者がしばらく世話をしてくれているの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070158,
					"content": "ポコポコビーニーと喜炎はすぐ近くにいるから、一緒に遊んであげるといいわ、「シルバー伴星」さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070159,
					"content": "#近くにいるんだな！じゃあ{NICKNAME}、あとでおまえが新しいゲームを遊んでる間、オイラはポコポコビーニーと遊んでくるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070160,
					"content": "行ってらっしゃい！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "それじゃあ早速、「ゴールド流星」にテスト版「チエキノコン布陣」を体験していただこう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070161,
					"content": "#{M#俺}{F#私}もすぐ行くから！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "うん、「ゴールド流星」出撃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "色々と骨を折らせたね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "#{M#俺}{F#私}には分からないから、口出ししない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "#{M#君}{F#あなた}たちは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#{NICKNAME}、なに言ってるんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070108,
					"content": "前、「サウマラタ蓮杯テイマー大会」に参加して、キノコンの仲間たちと楽しく遊んだだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070109,
					"content": "ハニヤーはそのとき知り合った友達じゃないか。で、バルフォアは一番責任感に溢れてた大会のスタッフだったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070110,
					"content": "まさか、キノコンの仲間の「ポコポコビーニー」とか「テンテンヨーヨー獣」のことも忘れちゃったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070111,
					"content": "あっ！思い出した！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "ったく、びっくりさせるなよな。医者に見せたほうがいいかと思っちゃったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070112,
					"content": "ははっ、冗談冗談！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				}
			]
		},
		{
			"id": 7350703,
			"completionStepIds": [
				7350703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
