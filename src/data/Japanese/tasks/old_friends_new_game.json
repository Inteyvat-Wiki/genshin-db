			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"バルフォア",
					"ハニヤー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070301,
					"content": "どうだった、「ゴールド流星」？初めて「チエキノコン布陣」を試してみた感想は？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070302,
					"content": "あら、まだ結論は出せないって顔ね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070303,
					"content": "まだ一つのステージしかテストしてない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "ああ、試遊できる内容が少なすぎちゃ、「チエキノコン布陣」のどこが良くてどこが悪いかなんて、なかなか分からないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070306,
					"content": "でも大丈夫だ。これからしばらくの間、俺とハニヤーさんはずっとここにいる。毎日一つずつ「チエキノコン布陣」の新しいステージを用意するつもりだ——合計七ステージをな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070307,
					"content": "時間があるときに来てくれれば、いつでも試遊できるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070308,
					"content": "それから、君は主催側の最終決定権を握っているとは言え、このゲームは俺とハニヤーさんが勝手に準備したもので、君の計画に元々あったものじゃない。つまり、俺たちは君の時間をいただくってわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070309,
					"content": "だから、君には報酬を用意した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070310,
					"content": "ははっ、それじゃ遠慮なく！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "ははは、率直だな！その豪気には感心するぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "バルフォア"
				},
				{
					"id": 735070313,
					"content": "キノコンの仲間たちについても十分な滞留期間を申請したわ。「チエキノコン布陣」のテスト期間中、あの子たちはずっとオルモス港に居られる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070314,
					"content": "「シルバー伴星」もポコポコビーニーとゆっくり遊べるわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070315,
					"content": "パイモンも喜ぶと思う！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "ふふっ、君も早くポコポコビーニーに会いに行ってあげて。あの子も君を恋しがってたんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070318,
					"content": "そうだ、これを持っていってちょうだい。一緒に遊ぶとき、ポコポコビーニーや喜炎にあげるといいわ。あの子たちの大好物なの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 735070316,
					"content": "#{M#俺}{F#私}ももう待ちきれない！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "次の大会の給料で埋め合わせするね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070304,
					"content": "もっとがっつり遊んでみないと。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				}
			]
		},
