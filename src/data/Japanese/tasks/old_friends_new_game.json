					"nextDialogs": [
						735070503
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070503,
					"content": "はぁ、喜炎とも仲良くなってきたけど、ポコポコビーニーと交流するときみたいにはうまく行かないみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070504,
						735070505
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 735070504,
					"content": "パイモン、楽しそうだね！",
