			"dialogs": [
				{
					"id": 722070101,
					"content": "まだ足りない…まだ足りない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "シトキ"
				},
				{
					"id": 722070102,
					"content": "兄さんが残してくれた宝は、全部ホラガイにある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "シトキ"
				},
				{
					"id": 722070103,
					"content": "ホラガイよホラガイ…辺りに散らばっている…まんべんなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "シトキ"
				},
				{
					"id": 722070104,
					"content": "兄さんの宝だ…僕が離れるわけにはいかない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "シトキ"
				},
				{
					"id": 722070105,
					"content": "宝…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "兄さんは霧海以外の場所に行った。祭司様はすごく怒ってる…兄さんの霊は二度と戻ってこれないらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "シトキ"
				},
				{
					"id": 722070108,
					"content": "でも兄さんが言っていた。「あそこには綺麗な花があって、真珠の海がある…父さんもそこで船を漕ぎ、妹を連れて手を振ってる」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "シトキ"
				},
				{
					"id": 722070109,
					"content": "兄さんは自分の宝を残し、ここを離れた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シトキ"
				},
				{
					"id": 722070106,
					"content": "お兄さんについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
		},
