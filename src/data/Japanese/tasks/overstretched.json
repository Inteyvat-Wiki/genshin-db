				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033002,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "ん？何者だ？大橋を往来する者は取り調べを受ける決まりだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033004,
					"content": "まあ…その恰好、きっと悪者じゃないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033005,
					"content": "理屈…？だって、悪いことをしようとするなら、目立たない恰好をするのが普通だろ？君のような目立った格好はしないはず…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033015,
					"content": "ここでなにしてるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033006,
					"content": "俺はこのエリアを担当する「千岩軍」だ。ここは荻花洲の要路だから、品物も通行人も皆ここを通る。だから俺はここに派遣されたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033007,
					"content": "数日前、そこで怪物の群れを見つけて…どうやらそこで集落を作ったみたいなんだ。まだ動きはないが、念のため見張っておかないとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033008,
					"content": "すぐにでも倒したいところだが、ここを離れると、また通行人を襲う怪物が出てくるんじゃないかって心配で、離れられないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033009,
					"content": "もう全部倒したよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "もう倒したのか？そ、それはよかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033011,
					"content": "君には迷惑をかけた、俺の仕事なのに、すまない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033012,
					"content": "はあ、上の考えが分からないな。ずっと人を派遣してこないし、俺ひとりじゃ、全部できっこないよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033013,
					"content": "機会を見つけて、この件を上にちゃんと報告しないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210033014,
					"content": "ありがとう、お礼としてこれを君にあげるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "橋西"
				}
			]
		},
