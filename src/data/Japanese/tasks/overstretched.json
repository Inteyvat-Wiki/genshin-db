			"dialogs": [
				{
					"id": 210030111,
					"content": "はあ、もっと人手があればいいのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030112
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210030112,
					"content": "すぐにでも倒したいところだが、ここを離れると、また通行人を襲う怪物が出てくるんじゃないかって心配で、ここを離れられないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030113
					],
					"speakerTitle": "橋西"
				},
				{
					"id": 210030113,
					"content": "すまないが、俺の代わりにあの怪物たちを倒してくれないか？その隙に俺も他の問題を解決できるし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "橋西"
				}
			]
		},
		{
