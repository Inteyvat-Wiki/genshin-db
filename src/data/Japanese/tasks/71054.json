			"dialogs": [
				{
					"id": 710540401,
					"content": "<color=#00E1FFFF>錬金拠点</color>を先に落としたほうが弱体化できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540402
					]
				},
				{
					"id": 710540402,
					"content": "はい、では今すぐあいつらの錬金装置を押収しに行きます。",
					"roleType": "TALK_ROLE_NPC",
