					"content": "<color=#00E1FFFF>炊事拠点</color>を先に襲撃したほうがいい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540302
					]
				},
				{
					"id": 710540302,
					"content": "分かりました、やつらの食糧を至急運び出します。",
					"roleType": "TALK_ROLE_NPC",
