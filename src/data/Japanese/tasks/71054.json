			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"彦博",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540101,
					"content": "ま、待ってください！話を聞いてください！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540102
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540102,
					"content": "おまえたちは宝盗団だろ？何を説明するって言うんだよ。大人しく自首すればいいんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540103,
					"content": "#千岩軍、層岩巨淵管轄区域、中隊長の彦博です。お会いできて嬉しいです、{NICKNAME}さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540104
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540104,
					"content": "えっと…それから…有名な空飛ぶ英雄さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540105
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540105,
					"content": "おい、なんでオイラの名前だけ忘れるんだよ！オイラはパイモンだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540106,
					"content": "ハハ…失礼しました。本当にすみません…でも私たちの間には、どうやら誤解があるようですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540107,
						710540109
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540107,
					"content": "待って…宝盗団じゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540108
					]
				},
				{
					"id": 710540108,
					"content": "もちろん、しかもその真逆ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540112,
					"content": "コホン、実は、この作業場は宝盗団に乗っ取られた拠点でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540113
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540113,
					"content": "作業員たちがここを離れた後、やつらがやってきました…隙があればすぐ潜り込むんですから。最初は鉱石と琉璃晶砂を盗採して密輸し、私たちの巡察隊とかくれんぼをしていた程度でしたが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540114
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540114,
					"content": "あいつらはますます大胆になっていって、鉱夫が残した古い倉庫を乗っ取ると、安物の装飾品を作って売るようになったのです！はぁ、本当に…見ただけで心が痛みますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540115
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540115,
					"content": "見ただけで心が痛む？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540116
					]
				},
				{
					"id": 710540116,
					"content": "あんな粗悪な装飾品じゃ、初めて璃月に来た観光客や、見る目のない読書人を騙すくらいしかできませんよ…安価を売りに璃月の市場に入り込みたい？ふん、看板に泥を塗るだけですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540117
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540117,
					"content": "やつらに元々看板なんてないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540118,
					"content": "へへっ、その通りです。そのようなもので儲けようとするなんて、品がないですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540119
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540119,
					"content": "だから私たちは、ここを乗っ取った宝盗団を片付けに来たんです。そしてやつらになりすまして、ここに潜んでいます…ああ、少し前までの話ですが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540120
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540120,
					"content": "それから、あいつらの頭領たちが「ファデュイ」のとある部隊と連絡を取り合っていることが分かりました。何か危険な物資の取引をしているようです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540121,
						710540124
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540121,
					"content": "ファデュイと宝盗団の連絡について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540122
					]
				},
				{
					"id": 710540122,
					"content": "先日、ファデュイの企みを打ち砕いた所ですが、璃月の野外にはまだ残党がいます…やつらの能力と戦闘力を甘く見てはいけません。私たちにとって、やつらは非常に危険な存在です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540123
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540123,
					"content": "もし宝盗団とあいつらが共謀して、私たちに対抗したら…非常に厄介な、安全問題になってしまいます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540126,
					"content": "とにかく、準備は万端ですから、あとは総攻撃を仕掛ける時を待つだけです。あいつらを全部やっつけさえすければ、何を企んでいるかもはっきりします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540127
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540127,
					"content": "それじゃオイラたちが来るなんて、思ってもみなかったよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540128,
					"content": "はぁ…あなたたちの腕が立つのは知っていましたが、まさかこんなに強いとは…私のチームの半分以上があなたたちに倒されてしまいましたよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540129
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540129,
					"content": "もちろん、ここに駐留している理由はまだあります…「七星陣法」の「磐鍵」がちょうどここに位置しているんです。宝盗団のような、邪な心を持つ者の手に落ちてはいけませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540130,
						710540132
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540130,
					"content": "う…ごめん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540131
					]
				},
				{
					"id": 710540131,
					"content": "ハハハ、大丈夫です！あなたたちだと気づかなかったのは、こちらの過ちです…あなたたちに道を開けろという命令を受けてはいましたが、まさかこんなに早く来るとは！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540134,
					"content": "わぁ…千岩軍の人ってこんなに優しいのか！それじゃオイラたちはもう行ってもいいよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540135,
					"content": "私があなたたちを責めないからと言って、璃月の法律があなたたちを見逃してくれるとは限りませんよ。へへ、すみませんね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540136
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540136,
					"content": "えっ——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540137,
						710540138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540137,
					"content": "次からは話を最後まで言って！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540139,
					"content": "うん…そうですね、挑発行為、千岩軍の公務執行妨害、「七星陣法」を故意に破壊したこと、それにもう一つ…既存現場の破壊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540140
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540140,
					"content": "ですが千岩軍の当事者からの許しを得ているので、それを差し引くと…お二方、おめでとうございます！うまくいけば、璃月港にもう五年から十年、滞在できますよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540141
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540141,
					"content": "ええ？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540142,
						710540144
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540142,
					"content": "弁護士を雇ってもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540143
					]
				},
				{
					"id": 710540143,
					"content": "うぅ…弁護士のリストをくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540146,
					"content": "コホン…しかし…！話を最後まで聞いてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540147
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540147,
					"content": "しかしながら、法を守っている市民や外国からの旅人は、千岩軍の業務執行を助け、相応の報酬や補償を獲得するためにあらゆる合法手段をとることができる…これも璃月の法律の規定です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540148
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540148,
					"content": "だから、英雄さんたち、先程の争いは無駄ではありませんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540149
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540149,
					"content": "#{M#君}{F#あなた}たちを助けて、何を得られるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540150
					]
				},
				{
					"id": 710540150,
					"content": "押収された贓品には手を出せませんが、お二方に協力していただく気があるならば、捕まえる過程で見つけた価値のある物…そうですね、例えば「宝盗団の秘宝！」などは、あなたたちに処置をお任せしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540151
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540151,
					"content": "それに同僚たちと貯めたモラも、少しですがもしよろしければ…このような予想外の「助け」は、予算に入っていないものでして…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540152
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540152,
					"content": "うぅ…それってつまり、オイラたちは牢獄に入らなくて済んで、その上、宝も手に入れられるってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540153
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540153,
					"content": "その通りです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540154
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540154,
					"content": "よし！それじゃ受けて立つぞ！道案内してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540155,
						710540156
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540155,
					"content": "待って…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540157,
					"content": "お二方も遠慮しないでください…私は先に集合場所に戻って待機します。必ず着いてきてくださいよ…でなければこちらも、先に行動を取りますから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540158
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540158,
					"content": "うんうん、早く行こうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540159
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540159,
					"content": "ちょっと…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540160
					]
				},
				{
					"id": 710540160,
					"content": "急ごうぜ、オイラたちは千岩軍の事件解決を手助けしてるんだ！それにモラだって、たくさんもらえるだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540156,
					"content": "#{M#俺}{F#私}はまだ…！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540144,
					"content": "知ってたらもっと滅茶苦茶にしてたのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540145
					]
				},
				{
					"id": 710540145,
					"content": "ふん、オイラたちはならず者たちを倒しただけだ。あいつらがちょうど宝盗団の服を着ていたせいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540138,
					"content": "わざとだよね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540132,
					"content": "じゃあ本当に人違いをしちゃったんだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540133
					]
				},
				{
					"id": 710540133,
					"content": "ええ、でもあなたたちのせいではありません。こちらが悪かったのですから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540124,
					"content": "危険な物資について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540125
					]
				},
				{
					"id": 710540125,
					"content": "情報提供者によれば、ファデュイたちは大量のモラと軍事用の物資を取引材料に、宝盗団から何かを買っているらしいのです…しかし彼は、食糧と日用品しか見つけられませんでした。何らかの方法で目くらましをしたのかもしれません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540109,
					"content": "#{M#君}{F#あなた}たちは…千岩軍の人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540110
					]
				},
				{
					"id": 710540110,
					"content": "ハハ、事前に説明する時間がなかったもので、すみません…あなたたちを、破壊のためにここに来た者だと思ったんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540111
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540111,
					"content": "うぅ…ある意味、その通りだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7105402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
