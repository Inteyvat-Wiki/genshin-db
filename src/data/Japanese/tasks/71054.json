		},
		{
			"id": 7105407,
			"completionStepIds": [
				7105413
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105413",
							"2"
						],
						"stepId": 7105413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"彦博",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540701,
					"content": "素晴らしかったです！ご協力ありがとうございました。そうだ、こちらがお約束した報酬です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540702
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540702,
					"content": "やった！モラがいっぱい！えっ…いつの間に着替えたんだ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540723
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540723,
					"content": "あなたたちが戦う時…コホッ、つまり、まあいいです…誤って傷つけられないためにも、服を変える必要があります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540703
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540703,
					"content": "千岩軍はあなたたちの協力に感謝します。あ、約束通り、何か必要なものがないか、見て回ってくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540704
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540704,
					"content": "えっと…押収された贓品以外なら大丈夫ですので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540705,
						710540707
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540705,
					"content": "おめでとう、任務達成だね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540706
					]
				},
				{
					"id": 710540706,
					"content": "ハハ、もちろんです。こんなにうまくいったのも、あなたたちが助けてくれたおかげですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540709,
					"content": "うん、つまり…こいつら賊のように、何事も近道を行こうだなんて考えない限りは、私たちもあなたたちを困らせるようなことはしません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540710
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540710,
					"content": "ふん、オイラたちはそんなやつじゃないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540711
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710540711,
					"content": "ハハ、そうですね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540712
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540712,
					"content": "はぁ、ところで、あなたのような元素力を使える存在は、善行をしようと悪事をしようと、侮れませんね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540713
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540713,
					"content": "私たちが何週間、何か月かけて解決できるような任務も、あなたたちにとっては簡単な話なのかもしれません…ですが、元素力を悪事に使えば、小さな代償の割に、恐ろしい破壊を招くことになります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540714
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540714,
					"content": "だから、「神の目」を持っていないと言うのも、そう悪くはないと思っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540715
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540715,
					"content": "常人を超える力を求めるあまり、命まで費やした人を沢山見てきましたが、彼らは結局他人の道具や傀儡にすぎなかった…。教えてください、それだけの価値が本当にあるのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540716
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540716,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540717
					]
				},
				{
					"id": 710540717,
					"content": "この世には神の目を持たない無力な人のほうが多いですが、彼らを理解し、守るのも、ほとんどは同じく普通の人なのです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540718
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540718,
					"content": "そんな普通の人でありながら、多くの人を守るために責務を果たすことができて、私は光栄です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540719
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540719,
					"content": "もしいつの日か、人が神の目を手に入れられなくなり、璃月港を守る仙人までもが逝去されたとしても…私はこの責務を諦めません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540720
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540720,
					"content": "あっ、すみません…私の話ばかりで、お時間を取らせてしまいましたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540721
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540721,
					"content": "さて、私たちはこれから贓品の調査と記録の仕事がありますので、おしゃべりはここまでです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540722
					],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540722,
					"content": "同僚たちを代表して、改めて感謝いたします。これからの旅もご無事であることを願っています。千岩牢固、揺るぎない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彦博"
				},
				{
					"id": 710540707,
					"content": "これで牢屋に入らなくて済むよね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540708
					]
				},
				{
					"id": 710540708,
					"content": "もちろんです、あなたたちは千岩軍に協力し…えっと、千岩軍の協力の下で大規模な密輸事件を解決した大英雄ですから。英雄を牢屋に入れるわけがないでしょう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "彦博"
				}
			]
		},
