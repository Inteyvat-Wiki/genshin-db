			},
			"dialogs": [
				{
					"id": 745080101,
					"content": "しばらくして、パイモンと一緒に「ちびチエキノコン大合戦」の開催場所にやってきた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "ふんふふ～ん！ツルツル、プリプリ、フワフワ、プニプニのキノコンは最高！まだまだ遊び足りない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745080103,
					"content": "#{M#君}{F#あなた}は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "私はアンジェニーナ。トゥレーヌが特巡隊に入る前、彼女の教官だったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745080105,
					"content": "私はトゥレーヌとは違うんだ、違うんだよ。君たちが「超最強のリーダー級戦力」だからって、私は屈したりしない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745080106,
					"content": "この生意気なメリュジーヌが…トゥレーヌの教官だって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745080107,
					"content": "落ち着いて。「ゴールド流星」と「シルバー伴星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745080108,
					"content": "トゥレーヌさんは少し前に、別の任務を引き受けて特巡隊の駐屯地へ戻ったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745080109,
					"content": "アンジェニーナさんはトゥレーヌさんに頼まれてここに来てくれたの。彼女の代わりにイベント会場の保安を担当してくれるプロフェッショナルね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745080110,
					"content": "彼女も「ちびチエキノコン大合戦」が大好きで、私と一緒に楽しんでくれてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "ハニヤー"
				},
				{
					"id": 745080111,
					"content": "そうそう。テーブルゲームも、現実のまんまるキノコンも大好き！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745080112,
					"content": "ツルツル、プリプリ、フワフワ、プニプニ。まるでタイダルガみたい…へへへ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745080113,
					"content": "なんでよだれを垂らしてるの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "食べるわけないよ！抱きしめてスリスリするくらいいいでしょ！私が喜炎をむにむにしたってハニヤーは気にしないのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745080116,
					"content": "#だ、だったらおまえは、喜炎だけをむにむに～っとしてるんだな！ポコポコビーニーを抱っこするのはオイラと{NICKNAME}だけだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745080117,
					"content": "なんてケチなヤツ！私はぜ～んぶやりたいのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745080118,
					"content": "ハニヤーが言ってた。君たちはこのゲームのプロなんでしょ。私と対戦してみない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745080119,
					"content": "もし私が勝ったらポコポコビーニーをむにむにさせてもらうよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "アンジェニーナ"
				},
				{
					"id": 745080120,
					"content": "むっ！オイラたちをナメるなよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745080121,
					"content": "#{NICKNAME}、やってやろうぜ！「ちびチエキノコン大合戦」の先人として、実力を思い知らせてやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745080122,
					"content": "「サウマラタ蓮杯初代優勝者」でもある！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "そうだそうだ！オイラたちの輝かしい肩書きの数々にはれっきとした理由があるんだぞ。そう簡単に負けてたまるか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 745080123,
					"content": "あと「才知と勇猛の双子星」ね！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "仲間のキノコンを食べちゃダメ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}