			"dialogs": [
				{
					"id": 3840201,
					"content": "よし、揃ったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840202
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840202,
					"content": "ここ、景色が綺麗だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3840203,
					"content": "「運命の再会」というテーマに相応しいでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3840204,
					"content": "じゃあ、そろそろ準備を始めるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3840205,
					"content": "ああ、どんな結果が待ち受けていようと、少なくとも転機は見えてきた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3840206,
					"content": "ここ最近、モンドは様々な問題を背負いすぎた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3840207,
					"content": "だが、まさか問題を解決してくれるのが旅人と詩人になるとはな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840208,
					"content": "…ああ、騎士団も少しは役に立ったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840209,
					"content": "はいはい、みんな少し離れて——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3840210,
					"content": "この世で最も優れた吟遊詩人が琴をつま弾くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				}
			]
		},
		{
			"id": 38404,
			"completionStepIds": [
				38405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"38405",
							"2"
						],
						"stepId": 38405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ウェンティ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3840401,
					"content": "バル…ウェンティ殿、自分の身を守ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840402
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3840402,
					"content": "ははっ、ボクの正体はとっくに分かってるんだろう？ジン。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840403
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3840403,
					"content": "でも、その名前でボクを呼んでくれてありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840404
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3840404,
					"content": "天空のライアーはどうなった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840405
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840405,
					"content": "まだ弾けそうか？…それか、龍の涙でまた直せそうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840406
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840406,
					"content": "ふむ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840407
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3840407,
					"content": "こんな風に壊されたら…もう無理かもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840408,
						3840410
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3840408,
					"content": "ヤツをこのまま取り逃がすわけには…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840409
					]
				},
				{
					"id": 3840409,
					"content": "その通り。腐食の根源を倒さないと、トワリンが受ける苦しみは減らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840413,
					"content": "じゃあ、偵察騎士を招集して追跡を…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840414
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3840414,
					"content": "その必要はない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840415
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840415,
					"content": "ん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840416
					],
					"speakerTitle": "ジン"
				},
				{
					"id": 3840416,
					"content": "少し前に四風守護の神殿遺跡で、そいつの同類をこの手で斬ったことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840417
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840417,
					"content": "え！？それっていつ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3840418,
					"content": "あの怪物たちを追跡するなら、僕の情報網と手口があれば事足りる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840419,
					"content": "ディルックの旦那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3840420,
					"content": "騎士団が嫌いなのに、自分のやり方でモンドを守ってるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 3840421,
					"content": "パイモンちゃんの口調が急に愛に溢れ始めた…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840422
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 3840422,
					"content": "ふん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840423
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840423,
					"content": "とにかく、僕の情報を待つといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840424,
					"content": "ヤツらに分からせてやる。アビス教団がどれだけ好き放題な連中でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840425,
					"content": "モンドでは、やってはならないことがあるとな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840410,
					"content": "トワリンの状況が危ない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840411
					]
				},
				{
					"id": 3840411,
					"content": "いや、罪の根源に代価を支払わせなければ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840412
					],
					"speakerTitle": "ディルック"
				},
				{
					"id": 3840412,
					"content": "腐食の根源を倒さないと、トワリンが受ける苦しみは減らない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "ディルック"
				}
			]
		}
	]
}