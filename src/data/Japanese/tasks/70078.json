						],
						"pointId": 16306
					}
				]
			},
			"dialogs": [
				{
					"id": 700780701,
					"content": "うぅ…来るな…もう光らないでくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780702
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780702,
					"content": "おや、ウィンスロー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780703
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780703,
					"content": "だ、誰だ！扉は閉めたはずだぞ、どうやって入ってきた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780704
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780704,
					"content": "ゆ、幽霊なのか——や、やめてくれ、俺が悪かった！近寄らないでくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780705
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780705,
					"content": "思ってたより重症みたいだな…かなりヤバそうじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780706
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780706,
					"content": "白い…白い幽霊が来る——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780707
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780707,
					"content": "そう叫んで、ウィンスローと呼ばれる男は気を失いかけた…\\n彼はオルドフになだめられ、ようやく少し落ち着き、徐々に理性を取り戻した。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700780708
					]
				},
				{
					"id": 700780708,
					"content": "ウィンスロー、気分は良くなりましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780709
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780709,
					"content": "気分が良いかだと…？オルドフ…何しに来たんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780710
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780710,
					"content": "どうせ俺を笑いに来たんだろう！そこの白いやつまで連れてきて…怖がらせるつもりなんだろう！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780711
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780711,
					"content": "あんたら地元民は、ずっと俺をのけ者にして…俺がここに住んでるのを妬んでるんだ。くそっ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780712
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780712,
					"content": "落ち着いてください、ウィンスロー。私たちはあなたを助けに来たんですよ。これまでもずっと、あなたを助けていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780713
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780713,
					"content": "地下の「陰湿で、不気味で、厄介な代物」を港の外の荒れ地に移すぞとあなたが喚いていた時も、私たちはあなたのためと思って、やめるように忠告したんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780714
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780714,
					"content": "「報いを受けることになりますよ、ウィンスロー」…あの時、私はこう言いましたよね…ほら、今やこんなことになってしまって、私も心が痛いんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780715
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780715,
					"content": "あんた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780716
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780716,
					"content": "#そして、先日スネージナヤから帰ってきたら、あなたがここの幽霊かなにかで苦しんでるという話を聞いたものですから、問題を解決できる{NICKNAME}さんとパイモンさんをすぐに呼んできました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780717
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780717,
					"content": "ずっと、あなたを助けていたんですよ、ウィンスロー…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780718
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780718,
					"content": "どうだかな…あんたたち、わざとやったんじゃないだろうな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780719
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780719,
					"content": "#はぁ…私のことが信じられなくても、{NICKNAME}さんのことは信じてください。{NICKNAME}さんは、騎士団の栄誉騎士なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780720
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780720,
					"content": "俺は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780721
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780721,
					"content": "もういいでしょう。これ以上ここにいるのは、精神衛生上よくありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780722
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780722,
					"content": "#{NICKNAME}さん、パイモンさん、哀れだと思いませんか。私は彼を上へ連れて行って、外の空気を吸わせてきます。遺跡のことはお二人にお任せしますよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780723
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780723,
					"content": "#もし{M#俺たち}{F#私たち}が失敗したら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780724
					]
				},
				{
					"id": 700780724,
					"content": "やつらの一員になるんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780725
					]
				},
				{
					"id": 700780725,
					"content": "ひ、ひぃぃ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780726
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700780726,
					"content": "まったく、またヘンなこと言ってるぜ！この状況で怖がらせるなよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780727
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780727,
					"content": "ははっ、下はそれほど危険じゃないと思いますよ。無事解決できることを祈っています。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780728
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780728,
					"content": "おう、オイラたちに任せとけって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780729
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780729,
					"content": "オルドフは、顔色が悪く足取りもおぼつかないウィンスローを支えながら、灯台の下の遺跡を後にした…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
