				},
				{
					"id": 700781602,
					"content": "こうして見ると、なにもなさそうだな…アビスの魔物も、幽霊もいないぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700781603,
					"content": "むしろ、ちょっと寂しいくらいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700781604,
					"content": "…寂しさは、一番恐ろしい悪魔だよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700781605
					]
				},
				{
					"id": 700781605,
					"content": "ふーん、そういうものか？オイラにはさっぱりわかんないぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700781606,
					"content": "でも、さっきまであんなに吹いてた風はどこから…あっ、違う、上だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700781607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700781607,
					"content": "なにか落ちてきたぞ！うわぁっ——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7007820,
			"completionStepIds": [
				7007820
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
