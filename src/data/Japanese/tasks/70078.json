			"dialogs": [
				{
					"id": 700780101,
					"content": "オルドフ、お前は知らないかもしれないが、騎士団の人たちはもう何度も行ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780102
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780102,
					"content": "おや、私はここしばらくずっとスネージナヤにいましたが、騎士団が灯台のほうへ行っていたとは初耳です。結果はどうでしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780103
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780103,
					"content": "結果も何も、あの古い灯台の警報は今でも時折点滅してるよ。ウィンスローのやつ、最初は「アビスだ、アビスだ！」なんて言ってたけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780104
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780104,
					"content": "その言葉を真に受けた騎士団は、大敵に挑むかのように完全武装でそこへ向かったものの、アビスの痕跡なんてこれっぽっちもなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780105
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780105,
					"content": "そんなことが何度か続いて、彼らも相当振り回されたみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780106
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780106,
					"content": "俺に言わせりゃ、あの灯台の下にある警戒装置が老朽化しただけだと思うんだが…そういえば、最近は妙な噂もあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780107
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780107,
					"content": "ほう、噂とは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780108
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780108,
					"content": "あそこに出没するのは、実はかつて戦死した騎士の幽霊だとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780109
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780109,
					"content": "ゆ、幽霊！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780110,
					"content": "うわぁっ！怖い話をしてる時にいきなり叫ぶなよ。お前たちのほうが幽霊よりよっぽど怖いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780111
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780111,
					"content": "わ、悪かったよ。オイラもわざとじゃないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780112,
					"content": "いいんですよ、おしゃべりは大勢でしたほうが賑やかになりますからね。お二人は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780113
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780113,
					"content": "テーブルで会話する人たちと、お互いに自己紹介をした…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700780114
					]
				},
				{
					"id": 700780114,
					"content": "#{NICKNAME}さんにパイモンさん…ああ、なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780115
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780115,
					"content": "そういえば、ウィンスローは元気にしているのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780116
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780116,
					"content": "あの警戒装置の光に、かなり怯えてるみたいだ。古い灯台に住んでて、たまに装置が作動するってんじゃ、誰だって耐えられないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780117
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780117,
					"content": "最近は、相当参ってるって話だ…ま、それも一種の報いだろうし、お前が気にする必要はないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780118
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780118,
					"content": "だからといって、放っておくわけにはいきません。私自身、あの灯台の近くに住んでいますし、それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780119
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780119,
					"content": "もしかしたら、あの下に別の何かがあるかもしれません。見に行かないとやはり心配です。あのままウィンスローをあそこにいさせるわけにもいかないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780120
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780120,
					"content": "あっ…まさか、オイラたちが前に古い灯台のとこで会ったのって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780121,
						700780123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780121,
					"content": "パイモンに食べられそうになってた…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780122
					]
				},
				{
					"id": 700780122,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780124,
					"content": "ん？灯台で何に遭遇したんです…？まさか幽霊ではないでしょうね、ははっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780125
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780125,
					"content": "違うぞ、なんだかすっごく慌てふためいてて、様子がおかしいやつに会ったんだ。たぶん、その古い灯台に住んでるやつじゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780126,
					"content": "ウィンスロー…ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780127
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780127,
					"content": "ウィンスローを助けにいくのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780128
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780128,
					"content": "言っておくが、あそこの下は元々古戦場だったんだ。俺はあんな場所で冒険なんてごめんだよ。それに、騎士団でも解決できなかったんだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780129
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780129,
					"content": "それなら、西風騎士団よりもっと頼りになる人を探さないといけませんね。例えば、かつてモンドを救った英雄とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780130
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780130,
					"content": "ふふ～ん！その英雄には、どこにいけば会えるんだろうな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780131,
						700780132
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780131,
					"content": "英雄なら、ここにいるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780134
					]
				},
				{
					"id": 700780134,
					"content": "ふふっ…英雄のお二人さん、どうか私の身勝手なお願いを聞いていただけないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780135
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780135,
					"content": "うーん…でも、悪さをする厄介な幽霊がいるんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780136,
					"content": "しかし、物語の中には、山の奥深くに隠されたお宝を守るためにさまよう幽霊だっているでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780137
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780137,
					"content": "おおっ、お宝か！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780138,
						700780139
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780138,
					"content": "さすが、お宝が大好きなパイモン！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780140
					]
				},
				{
					"id": 700780140,
					"content": "お、お宝目当てなんかじゃないぞ。話を聞いてると、あの灯台に住んでるやつが本当にかわいそうだったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780141
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780141,
					"content": "はいはい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780142
					]
				},
				{
					"id": 700780142,
					"content": "お二人なら、快く力を貸してくださると信じていましたよ。ああ、たとえお宝がなくとも、この冒険に見合う報酬をご用意します！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780143
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780143,
					"content": "#…さて、私も少し準備をしなければ…では、{NICKNAME}さん、後ほど古い灯台の下で落ち合いましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780144
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780144,
					"content": "まったく、やってらんないよ。俺はこの件には関わらないからな。飲みすぎたし、ちょっと家で横になってくる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780145
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780145,
					"content": "#ゆっくり休むといい、レナート。それじゃ、無事を祈ってるよ。{NICKNAME}がついているとはいえ、危険な真似はしないようにな、オルドフ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780146
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780146,
					"content": "もちろんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780139,
					"content": "チョロすぎるよ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780140
					]
				},
				{
					"id": 700780132,
					"content": "まずい、狙われてる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780133
					]
				},
				{
					"id": 700780133,
					"content": "ちょうどお二人がここにいらっしゃったので…この世において、詩と偶然性ほど美しいものはありませんからね。実際、あなたたちがいなかったとしても、私一人で様子を見に行くつもりでしたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780134
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780123,
					"content": "うん、あの見るからに怪しげな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780124
					]
				}
			]
