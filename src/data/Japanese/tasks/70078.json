			"dialogs": [
				{
					"id": 700780401,
					"content": "なんだか妙だな…オルドフのやつ、今回はやけに親切だ…ウィンスローと揉めてたんじゃなかったのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780402
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780402,
					"content": "あいつの話を聞いたら、冷やかしの一つでも言うかと思ってたんだが…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "マテオ"
				}
			]
		},
