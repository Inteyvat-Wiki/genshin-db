			"dialogs": [
				{
					"id": 700780201,
					"content": "オルドフ、お前は知らないかもしれないが、騎士団の人たちはもう何度も行ってるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780202
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780202,
					"content": "おや、私はここしばらくずっとスネージナヤにいましたが、騎士団が灯台のほうへ行っていたとは初耳です。結果はどうでしたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780203
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780203,
					"content": "結果も何も、あの古い灯台の警報は今でも時折点滅してるよ。ウィンスローのやつ、最初は「アビスだ、アビスだ！」なんて言ってたけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780204
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780204,
					"content": "その言葉を真に受けた騎士団は、大敵に挑むかのように完全武装でそこへ向かったものの、アビスの痕跡なんてこれっぽっちもなかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780205
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780205,
					"content": "そんなことが何度か続いて、彼らも相当振り回されたみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780206
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780206,
					"content": "俺に言わせりゃ、あの灯台の下にある警戒装置が老朽化しただけだと思うんだが…そういえば、最近は妙な噂もあって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780207
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780207,
					"content": "ほう、噂とは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780208
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780208,
					"content": "あそこに出没するのは、実はかつて戦死した騎士の幽霊だとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780209
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780209,
					"content": "ゆ、幽霊！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780210,
					"content": "うわぁっ！怖い話をしてる時にいきなり叫ぶなよ。お前たちのほうが幽霊よりよっぽど怖いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780211
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780211,
					"content": "わ、悪かったよ。オイラもわざとじゃないんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780212,
					"content": "いいんですよ、おしゃべりは大勢でしたほうが賑やかになりますからね。お二人は…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780213
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780213,
					"content": "テーブルで会話する人たちと、お互いに自己紹介をした…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700780214
					]
				},
				{
					"id": 700780214,
					"content": "#{NICKNAME}さんにパイモンさん…ああ、なるほど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780215
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780215,
					"content": "そういえば、ウィンスローは元気にしているのでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780216
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780216,
					"content": "あの警戒装置の光に、かなり怯えてるみたいだ。古い灯台に住んでて、たまに装置が作動するってんじゃ、誰だって耐えられないだろうな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780217
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780217,
					"content": "最近は、相当参ってるって話だ…ま、それも一種の報いだろうし、お前が気にする必要はないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780218
					],
					"speakerTitle": "マテオ"
				},
				{
					"id": 700780218,
					"content": "だからといって、放っておくわけにはいきません。私自身、あの灯台の近くに住んでいますし、それに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780219
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780219,
					"content": "もしかしたら、あの下に別の何かがあるかもしれません。見に行かないとやはり心配です。あのままウィンスローをあそこにいさせるわけにもいかないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780220
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780220,
					"content": "ウィンスローを助けにいくのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780221
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780221,
					"content": "言っておくが、あそこの下は元々古戦場だったんだ。俺はあんな場所で冒険なんてごめんだよ。それに、騎士団でも解決できなかったんだし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780222
					],
					"speakerTitle": "レナート"
				},
				{
					"id": 700780222,
					"content": "それなら、西風騎士団よりもっと頼りになる人を探さないといけませんね。例えば、かつてモンドを救った英雄とか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780223
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780223,
					"content": "ふふ～ん！その英雄には、どこにいけば会えるんだろうな！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780224,
						700780225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700780224,
					"content": "英雄なら、ここにいるよ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780227
					]
				},
				{
					"id": 700780227,
					"content": "ふふっ…英雄のお二人さん、どうか私の身勝手なお願いを聞いていただけないでしょうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780228
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700780228,
					"content": "うーん…でも、悪さをする厄介な幽霊がいるんだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780229
					],
					"speakerTitle": "パイモン"
				},
				{
