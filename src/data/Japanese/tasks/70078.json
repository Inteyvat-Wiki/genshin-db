					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700780304
					]
				},
				{
					"id": 700780304,
					"content": "いえ、準備はもう済んでいます…ああ、さきほどの発言のことなら、あなたたちを責めていたわけではありません。むしろ、称賛ですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700780305
					],
