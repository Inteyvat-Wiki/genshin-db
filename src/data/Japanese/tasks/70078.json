			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"オルドフ",
					"ウィンスロー"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3561.412,
							207.298,
							-233.211
						],
						"pointId": 16312
					},
					{
						"sceneId": 3,
						"position": [
							3563.65,
							207.473,
							-235.83
						],
						"pointId": 16313
					},
					{
						"sceneId": 3,
						"position": [
							3563.435,
							207.301,
							-232.469
						],
						"pointId": 16314
					}
				]
			},
			"dialogs": [
				{
					"id": 700782001,
					"content": "オルドフ、戻ったぞ！どうだ、警戒装置はまだ問題ありそうか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700782002,
					"content": "もう大丈夫ですよ。点滅は止まりました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782003
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782003,
					"content": "さすがですね。こんなに手早くトラブルを解決してしまうとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782004
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782004,
					"content": "そうだ、あの風のことだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782005
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700782005,
					"content": "あの風はきっと、ここを離れたくない騎士たちの魂が放つ怒号…警戒装置の点滅は、単なる警告に過ぎないのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782006
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782006,
					"content": "えっ、待てよ。じゃあ、幽霊って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782007
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700782007,
					"content": "幽霊たちは、あなたを本気で傷つけようとしたわけではないんですよ、ウィンスロー。ただ、追い出されることに、不満を感じていただけです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782008
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782008,
					"content": "そ、そうだったのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782009
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700782009,
					"content": "彼らはアビスとの戦いの際、ここで命を落とした英雄たちです。あなたを傷つけるような真似をするはずがないでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782010
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782010,
					"content": "#コホン…こちらの{NICKNAME}さんとパイモンさんには感謝しませんとね。西風騎士団の栄誉騎士であり、トップクラスの…そう、幽霊とのトップクラスの敏腕交渉人なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782011
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782011,
					"content": "えっ…うーん…でも、その肩書きはけっこうカッコイイな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700782012,
					"content": "先ほどの、まるで足元の石畳が割れるような轟音…お二人は怪我などされていませんか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782013
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782013,
					"content": "かすり傷一つないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700782014
					]
				},
				{
					"id": 700782014,
					"content": "#それは何よりです。少し心配していたんですよ。あの物凄い音は実は…{NICKNAME}さんとパイモンさんが騎士団の幽霊たちと行った…えー、交渉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782015
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782015,
					"content": "…その…超心霊…腕相撲交渉術です！地元の住民ならみんな知っています。いやあ、幽霊の怒りを鎮めるための、とても危険な方法なんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782016
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782016,
					"content": "ちょ、超心霊腕相撲？ほ、本当か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782017,
						700782019
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700782017,
					"content": "ただ崩落しただけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700782018
					]
				},
				{
					"id": 700782018,
					"content": "#聞きましたか！？幽霊との腕相撲で怪力を発揮して遺跡を崩落させるなど、敏腕交渉人の{NICKNAME}さんにとっては日常茶飯事なんです！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782021
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782021,
					"content": "とにかく、交渉を経て、幽霊たちの怒りも鎮まったでしょう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782022
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782022,
					"content": "な、なら二度と悪さをしにくることは…いや、つまり、警戒装置に影響を与えることはないってことだよな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782023
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700782023,
					"content": "それはどうでしょうね。ウィンスロー、あなたの行い次第ってところですかね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782024
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782024,
					"content": "お、俺だって…ここ最近はすごく頑張ったんだぞ。英雄たちの墓地の草むしりもしたし、墓石も丁寧に拭いた…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782025
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700782025,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782026
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782026,
					"content": "#おやおや、よくやりましたね、ウィンスロー。{NICKNAME}さんの交渉が順調に進んだのも、あなたの償いが大いに功を奏したのでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782027
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782027,
					"content": "その心がけを忘れずにいれば、英雄たちもきっと、土の下で安らかに眠っていられるはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782028
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782028,
					"content": "安らかに眠っていられるのであれば、わざわざ出てきて騒ぐ必要もないですからね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782029
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782029,
					"content": "#もう神経を張り詰めなくていいんですよ。ほら、何事も解決するんです。もし警戒装置にまた問題が起きたら、{NICKNAME}さんに交渉を依頼しましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782030
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782030,
					"content": "ああ…そうだな、オルドフ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782031
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700782031,
					"content": "あんたたちも、ありがとう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782032
					],
					"speakerTitle": "ウィンスロー"
				},
				{
					"id": 700782032,
					"content": "#さて、{NICKNAME}さんとパイモンさん。ご協力ありがとうございました。こちらをお受け取りください…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782033
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782033,
					"content": "前に、報酬を用意すると言っていたでしょう。あなたたちなら、この事件を解決できると信じていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782034
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782034,
					"content": "報酬のことだったのか。てっきり、冒険に役立つアイテムかと思ったぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782035
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700782035,
					"content": "自分の実力はわきまえていますよ。商売ならまだしも、冒険は得意ではありませんから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782036
					],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782036,
					"content": "さて、お二人とも、ぜひまた酒場にいらしてください。その時は、もっと面白い話をしましょう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "オルドフ"
				},
				{
					"id": 700782019,
					"content": "ちょっと力を込めただけ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700782020
					]
				},
				{
					"id": 700782020,
					"content": "#こんなことは{NICKNAME}さんにしかできません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700782021
					],
					"speakerTitle": "オルドフ"
				}
			]
		}
	]
}