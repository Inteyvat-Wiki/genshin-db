			},
			"dialogs": [
				{
					"id": 402260201,
					"content": "ナヴィアとクロリンデを見本市の会場に案内した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "想像してたよりずっと広いのね。でもまだ人が少なくて、ちょっと寂しいかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260203,
					"content": "見本市はまだ始まってないからな。ヤフォダもまだまだ忙しいみたいだし、手伝いに行ったほうがよさそうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260204,
					"content": "こっちはあたしとクロリンデで大丈夫よ。手が空いたら、ぜひあたしたちの展示品も体験しに来てちょうだいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				}
			]
		}
	]
