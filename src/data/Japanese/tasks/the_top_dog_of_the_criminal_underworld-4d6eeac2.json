			"dialogs": [
				{
					"id": 402260101,
					"content": "フラッグシップ…？きっと、宿の手続きをしてるんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260102,
					"content": "相棒！それにパイモンも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260103,
					"content": "ナヴィア！久しぶりだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260104,
					"content": "もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "そうよ、棘薔薇の会も出展するの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260107,
					"content": "おお…おまえが「裏社会のドン」か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260108,
					"content": "おお…おまえが「裏社会のドン」か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260109,
					"content": "あははっ、何それ。あたしの新しい呼び名？なかなかかっこいいじゃない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260110,
					"content": "実はオイラたち、見本市の出展者登録とか、展示品のチェックとかを手伝ってるところなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260111,
					"content": "なるほどね。座って話しましょ、ちょうど美味しい料理をたくさん頼んだところなの。クロリンデとシュヴルーズも荷物を置いたら戻ってくるから。あっ、噂をすればなんとやらね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260112,
					"content": "私たちの話か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 402260113,
					"content": "クロリンデとシュヴルーズも来てたんだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260114,
					"content": "ナド・クライは秩序が乱れていて危険だ。棘薔薇の会のフォンテーヌにとっての意義を考えれば、現会長に何かあっては困る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 402260115,
					"content": "こんなに強いあたしに「何かある」とは思えないんだけどな。ま、友達と一緒に旅できて楽しいけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260116,
					"content": "気が緩みすぎだと何度言えば…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "クロリンデ"
				},
				{
					"id": 402260117,
					"content": "わかったわかった、とにかく改めて紹介させて。今のあたしのボディガード——フォンテーヌ一番の凄腕決闘代理人よ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260118,
					"content": "裏社会のドンと、そのボディガード…よし、登録したぞ。シュヴルーズは？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260119,
					"content": "私は公務で来ただけだ。最近起きた大事件に、ナド・クライと関係するものが多くてな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402260120,
					"content": "おお…じゃあこれ以上聞かないでおくぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260121,
					"content": "そうそう、棘薔薇の会が展示する商品も登録させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260122,
					"content": "これよ！フォンテーヌ科学院が新しく開発したウーシアとプネウマの中継システム。これを制御すれば、ウーシアとプネウマのエネルギーを使って戦えるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260123,
					"content": "ってことは…武器か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260124,
					"content": "法律に縛られないマーケットでは、一番の売れ筋でしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260125,
					"content": "それは確かにそうなんだけど…シュヴルーズの前でそういうことを言われると、なんだか落ち着かないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260126,
					"content": "構わない。犯罪小説で、「無法地帯」の描写は山ほど読んできた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402260127,
					"content": "警察として、こういった場所で活動するにあたって最も重要なのは…一時的に「規定」を捨てることだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402260128,
					"content": "では、私はこれで失礼する。隊員たちが待っているからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "シュヴルーズ"
				},
				{
					"id": 402260129,
					"content": "もしよかったら、オイラたちが会場まで案内してやるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402260130,
					"content": "ありがと！じゃあ今すぐ行きましょ。あたしも欲しい物がないか見て回りたいし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ナヴィア"
				},
				{
					"id": 402260105,
					"content": "#…{M#君}{F#あなた}も出展しに来たの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
