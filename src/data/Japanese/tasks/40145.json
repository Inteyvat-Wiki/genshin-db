			"dialogs": [
				{
					"id": 401450201,
					"content": "旅人さん、パイモンさん、こんにちは！何かお手伝いできることはありますか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401450202,
					"content": "えっと、最近ちょっと人手不足でさ。経営効率を上げろってリサさんに言われたんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450203,
					"content": "ああ、その件ならリサさんと詳しく話し合いましたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401450204,
					"content": "現段階で向上させられそうなのは、錬金技術と栽培技術、それから販売規模です。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401450205,
					"content": "効率が上がれば、経営も楽になると思います。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401450206,
					"content": "おお、なんだかすごそうだな…さっそく試してみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450207,
					"content": "経営効率を上げたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "アップグレードのための準備は出来ています。色々と試してみてくださいね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401450209,
					"content": "物資の購入について。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "最近、新しい物資が届いたばかりです。必要なものがないか、ぜひご確認ください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレダ"
				},
				{
					"id": 401450211,
					"content": "さようなら。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "経営がうまく行きますように！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "フレダ"
				}
			]
		}
	]
