			"dialogs": [
				{
					"id": 401450101,
					"content": "経営を続けていくうちに、錬金ショップはどんどん繁盛していった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "ふぅ、最近はお客さんがどんどん増えてきて、目がまわる忙しさだぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450103,
					"content": "商売は順調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "今の注文数だと、やっぱりオイラたち二人だけじゃ、無理があるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450106,
					"content": "そろそろ新しい助っ人を呼んだほうがいいんじゃないか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450107,
					"content": "可愛い子ちゃんたち、今休憩中かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401450108,
					"content": "最近の売上データを見たんだけど、やっぱり二人には経営の才能があるのね。本当にたくさん売れているわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401450109,
					"content": "リサさん、来てくれたんだな！ちょうど今、助っ人がほしいって話してたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450110,
					"content": "あら？注文が多くなって、だんだん手が回らなくなってきた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401450111,
					"content": "そうなんだ。こんなにお客さんが来るなんて思ってなかったぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450112,
					"content": "ふふっ、わたくしは予想していたけれど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401450113,
					"content": "実はあなたたちが開店準備に勤しんでいた時、わたくしとフレダは経営効率を上げる方法について話し合っていたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401450114,
					"content": "あなたたちの経営を観察してみたけれど、錬金術も薬草の栽培も販売方法も、まだまだ改善の余地があるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401450115,
					"content": "えっ。こっそりそんなことしてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450116,
					"content": "てっきり、ずっとサボってるのかと思ってたぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450117,
					"content": "あらあら、お姉さんも肝心な時は頼りになるのよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401450118,
					"content": "じゃあ、教えてくれよ。その効率を上げる方法って、具体的にどんな方法なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 401450119,
					"content": "そうね…具体的な改善案については、すでにフレダと話をしたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "リサ"
				},
				{
					"id": 401450120,
					"content": "詳しいことは、彼女から聞いてちょうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リサ"
				},
				{
					"id": 401450104,
					"content": "名をあげたね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
