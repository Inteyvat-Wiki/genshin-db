			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"ラフィク",
					"綺珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "よし…！これでいいはずだ。何が起こるか、見てみよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210601,
					"content": "うわっ！あそこ水漏れしてるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230210615,
					"content": "な、何っ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210602,
					"content": "ふ、船が傾いた！なんだよこれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 230210603,
					"content": "は、早く荷物を降ろそう、なにかトラブルが起きたに違いない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210604,
					"content": "ラフィクと共に荷物を船からすべて降ろした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "はぁ…はぁ…割と少なくて助かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210606,
					"content": "これは…一体どこが問題だったんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210607,
					"content": "だから最初に言ったでしょう？あなたが算出した数字は極端すぎるんです。とても信頼できるものではありませんでした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210608,
					"content": "あぁ…えっと…そうだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210609,
					"content": "まさか、あんなに綿密に計算したのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210610,
					"content": "旅人、ひとまず協力ありがとう…さあ、報酬だ。受け取ってくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210611,
					"content": "帰ったらもう一回計算し直しだ…綺珊、今度は手伝ってくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210612,
					"content": "…なんだか、私が今まで全く手伝っていなかったような言い草ですね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210613,
					"content": "ま、いいでしょう…終わったら、コーヒーをおごってくださいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "綺珊"
				}
			]
		},
