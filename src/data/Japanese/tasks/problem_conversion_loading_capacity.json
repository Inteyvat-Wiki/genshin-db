			"dialogs": [
				{
					"id": 230210801,
					"content": "やった、大成功だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210802,
					"content": "船体の構造は問題ない…喫水線も安定してるし、傾きもない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210803,
					"content": "綺珊、どうだ。俺の設計と計算は完璧だろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210804,
					"content": "これは荷重試験の第一段階に過ぎません。喜ぶのはまだ早いですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210805,
					"content": "それに…悪天候や航行時の揺れによる貨物の移動、重心の変化は考慮されていません…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210806,
					"content": "いや、それはまあそうなんだが…ひとまず喜ばせてくれ…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210807,
					"content": "そうだ…旅人、これは君への報酬だ。受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210808,
					"content": "綺珊、ちょっとは俺を励ましてくれよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210809,
					"content": "それが船を造る役に立つんですか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210810,
					"content": "そんなことより…ご自分の財布がどうやったら膨れるのか、そっちを考えてください！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "綺珊"
				}
			]
		},
