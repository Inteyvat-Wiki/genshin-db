				"points": []
			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "旅人！いいところに来た。船はさっき進水したところだが、十分に安定してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210102,
					"content": "ま、俺の計算が完璧だったってことだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210103,
					"content": "それで、約束の荷重試験はいつ始まるんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210104,
					"content": "そう慌てるな。旅人も来たことだし、ぼちぼち始めるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210105,
					"content": "荷重試験ってなに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "ざっくり言うと、重量物を使って船の荷重能力を測る試験だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210107,
					"content": "そして重量物ってことは…つまり、俺と一緒にそいつを船に運んでくれる人手が必要なわけだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210108,
					"content": "旅人、この間気づいたんだが…君は体も丈夫だし力もある。こういう作業にピッタリだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210109,
					"content": "そんな理由で呼びつけたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "待て待て、早まるなって！俺1人ではどうにもならなくて、君に頼むしかなかったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210112,
					"content": "それに、報酬はたっぷりはずむ！安心しろ。でかい船を修理してひと稼ぎしたばっかりなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210113,
					"content": "へえ…ひと稼ぎ、ですか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210114,
					"content": "いや、その…ほとんど船を造るのにつぎこんじまったけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210115,
					"content": "ぜ、全部ですか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210116,
					"content": "いや、ちょっとは残してあるって！…その、コーヒーくらいはおごるからさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210117,
					"content": "旅人、とっとと始めようぜ。ほらほら！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ラフィク"
				},
				{
					"id": 230210110,
					"content": "怒るよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
			"id": 2302106,
			"completionStepIds": [
				2302106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
