				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100101,
					"content": "#{NICKNAME}、あれ見てみろよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100102,
					"content": "あ、あの子、一人だよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100103,
					"content": "でも誰かと話してる！ほら、笑ってるぞ！うううっ、不気味だ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100104,
					"content": "小さい頃よく「空想の友達」と遊んだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#えっ？{NICKNAME}も経験あるのか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100106,
					"content": "まさか幻覚でも見てたんじゃないのか？それとも、本当に見えない友達が？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100107,
					"content": "幻覚の産物こそが空想の友達。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "空想の友達…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100111,
					"content": "えっと、それってつまり…「想像上の友達」ってことだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100112,
					"content": "おまえの「空想の友達」って、どんな感じなんだ？オイラにも紹介してくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100113,
					"content": "今はもう出てこない…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "えっ？まさか「空想の友達」って、大きくなると消えちゃうのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100116,
					"content": "そうだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#むぅ…見てみたかったな…そうだ、おまえの{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE_LOWER_SUBJECT|INFO_FEMALE_PRONOUN_SISTER]}にも空想の友達っているのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100119,
					"content": "いるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "いるのか！便利だな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100121,
					"content": "そうだ、璃月のボードゲームを知ってるか？普通は4人でやるんだけど、おまえたち兄妹なら2人でできるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100122,
					"content": "やあ、旅人！奇遇だね、こんなところで会うなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100123,
					"content": "吟遊野郎、どうしておまえが！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100124,
					"content": "あははっ、実は最近リサが面白いものを作ってくれてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100125,
					"content": "リサさんの「面白い」は、なんだか嫌な予感がするぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100126,
					"content": "まあまあ、レディをそんな風に言わない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100127,
					"content": "この面白いものを作るために、わざわざスメールから危険な材料を取り寄せてくれたんだからさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100128,
					"content": "いま「危険」って言ったよな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100129,
					"content": "眼鏡型の探測器？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "その通り、モノクルに見えるけど探測器なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100133,
					"content": "でも、残念ながらリサには使えない代物でね。だから、代わりにボクが借りたんだ。ついでに実験の手伝いも兼ねてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100134,
					"content": "ん？なんでリサさんには使えないんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100135,
					"content": "それは…自由を愛する子供心が足りないというか…はたまた別の原因があるというか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100136,
					"content": "今度、彼女に聞いてみるといいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100137,
					"content": "じゃあさ、吟遊野郎には見えるんだよな？こいつの空想の友達ってどんな感じなんだ、オイラに教えてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100138,
					"content": "それは…うん、秘密かな、えへへっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100139,
					"content": "とにかく、これを君に貸してあげよう。これでノーラの「空想の友達」を見てみたらどうだい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100140,
					"content": "どうだどうだ？見えるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100141,
					"content": "本当にいる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "やっぱり、君がつけると見えるんだね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100144,
					"content": "くぅー、オイラも見たいぞっ！——けど、この探測器のサイズじゃ、オイラに合わない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100145,
					"content": "#とにかく、{NICKNAME}だけが頼りだ！<color=#00E1FFFF>他の人たち</color>の空想の友達がどんな感じか見に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100142,
					"content": "ノーラと気が合いそうな子だ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "モノクルに見えるけど。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "そうだろ？ボクもそう思ったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100117,
					"content": "残念だけど、そうだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "もう見えなくなったよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "空想の友達は幻覚の産物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "幻覚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 1011002,
			"completionStepIds": [
				1011002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011002",
							"2"
						],
						"stepId": 1011002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"フローラ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101100203,
					"content": "ほら、あれが彼女の空想の友達だよ。ふわふわした植物…ポンポンの実だね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100204
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100204,
					"content": "空想の友達って植物もありなのか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100205,
					"content": "ふふっ、旅人さん、詩人さん、こんにちは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100206,
						101100207
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 101100206,
					"content": "こんにちは、少し聞いてもいい？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100208
					]
				},
				{
					"id": 101100208,
					"content": "いいよぉ、フローラに何かご用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100209,
						101100212
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 101100209,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYSECOND|INFO_FEMALE_PRONOUN_GIRLSECOND]}の隣にいるのは…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100210
					]
				},
				{
					"id": 101100210,
					"content": "あれ？ポンポンちゃんが見えるの？他の人には見えないのに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100211
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 101100211,
					"content": "ポンポンちゃんはフローラの大親友なの。小さい頃から一緒にいるんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100216
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 101100216,
					"content": "（ううっ…なんだこのオイラだけ仲間はずれみたいな感じは…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 101100217,
					"content": "フローラ、どうして君の友達はポンポンの実なのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100218
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 101100218,
					"content": "だめ？空を飛ぶ植物と友達になりたかったんだもん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100219
					],
					"speakerTitle": "フローラ"
				},
				{
					"id": 101100219,
					"content": "空を飛ぶ植物と友達に？なんでだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100220
