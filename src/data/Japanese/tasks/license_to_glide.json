			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "読み終わったけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "規則は…苦手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "あ、来たね。『飛行指南』は読み終わった？規則や制度も理解した？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820204,
					"content": "うん、その渋々って感じ、分かるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820205,
					"content": "『飛行指南』はつまらないからね、わたしも読みたくな…あっ、このことはジンさんに内緒ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820206,
					"content": "そうか？このお話、けっこう面白かったけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4820207,
					"content": "面白い？あっ──もしかして、付録の実例集のこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820208,
					"content": "わたしも好きなのがあるよ。一番好きなのは風スライムで飛ぶやつかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820209,
					"content": "風スライムが破れた時に発生する気流を使うと、高く飛べるらしいね。いつか試してみたいなぁ──",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820210,
					"content": "それじゃないぞ！鳥が空を飛ぼうとする話だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4820211,
					"content": "うん…えっ！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820212,
					"content": "ちょっと見せて…あっ、これわたしが小さい頃に大好きだった童話だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820213,
					"content": "ご、ごめん！飛行指南書と同じところに置いてたから、出かける時に取り違えたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820214,
					"content": "全然違う本なのに…間違えたりするか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4820215,
					"content": "えっと…こんな話するの少し恥ずかしいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820216,
					"content": "間違えた原因は、わたしに飛び方を教えてくれたのがこの本だったから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820217,
					"content": "「大事なのは強き風ではなく勇気だ、それが君たちをこの世界で初めて飛ぶ鳥にした」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820218,
					"content": "この言葉が、わたしに飛ぶ勇気をくれた…偵察騎士や飛行チャンピオンになれたのも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820219,
					"content": "ま、まあ、この話はおしまい！さっそくテストを始めようか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820220,
					"content": "緊張しないで、いつもと同じように飛べばいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4820222,
					"content": "準備できた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "わたしが<color=#00E1FFFF>マークしたルート</color>通り、ゴールまで飛んでね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "アンバー"
				}
			]
		},
