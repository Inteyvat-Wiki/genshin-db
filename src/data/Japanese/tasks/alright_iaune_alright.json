			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アルエ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130201,
					"content": "旅人、店を手伝いに来てくれたのか？よく来てくれたな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130202
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 240130202,
					"content": "いや、オイラたちはただ、友達にコーヒーを淹れてやりたいんだ。あいつは…えーっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130203,
						240130204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240130203,
					"content": "少し落ち込んでるみたいだから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				},
				{
					"id": 240130205,
					"content": "友達って…あそこに座ってるアイオーヌのことかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130206
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 240130206,
					"content": "知り合いなの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130207
					]
				},
				{
					"id": 240130207,
					"content": "ロアルテとは旧知の仲なんだ。彼から、オフィスに勤勉で頭の回る若者が入ってきたって聞いてたけど、アイオーヌのことだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130208
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 240130208,
					"content": "心配しなくたっていい。共律庭に入ったばかりの若者はみんな、しばらくは落ち込むもんさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130209
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 240130209,
					"content": "自分だけの居場所を見つけられれば、よくなるはずだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130210
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 240130210,
					"content": "なんでそんなことが分かるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130211
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240130211,
					"content": "私もかつては、共律庭の畑に根を下ろした大根の一人だったからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130212
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 240130212,
					"content": "だが私は大根で居続けることに満足できなかった。だもんで、畑を離れて…このカフェを開いたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130213,
						240130214
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 240130213,
					"content": "色々と歴史があったんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130215,
					"content": "ハハハ、そうかもな。だが、今の私はしがないカフェのオーナーだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130216
					],
					"speakerTitle": "アルエ"
				},
				{
					"id": 240130216,
					"content": "さあさあ、アイオーヌにコーヒーを淹れてやるんじゃなかったか？マシーンを調節しておくから、準備ができたら来てくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アルエ"
				},
				{
					"id": 240130214,
					"content": "沢山ストーリーがありそう…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130215
					]
				},
				{
					"id": 240130204,
					"content": "かなりストレスを抱えてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130205
					]
				}
			]
		},
		{
