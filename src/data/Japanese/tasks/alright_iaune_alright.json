		},
		{
			"id": 2401304,
			"completionStepIds": [
				2401304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401304",
							"2"
						],
						"stepId": 2401304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アイオーヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "旅人さん、本当にコーヒーを淹れてくれたんですか？わざわざこんな事までしてもらって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130402,
					"content": "どういたしまして。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "…こ、これ！共律庭で飲むコーヒーよりずっと美味しいですよ！も…もはや同じ次元のコーヒーじゃないくらいだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130405,
					"content": "もし毎日こんなコーヒーが飲めるなら、午後も眠くならなくて済むんですけどね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130406,
					"content": "ごちそうさまでした。これを飲み終わったらまた仕事に戻ります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130407,
					"content": "頑張って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "もちろんです。早く一人前に成長して、ロアルテさんみたいに一人で何でもできる人にならないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130410,
					"content": "はぁ。でもそれまでに、あと何回悪夢を見なきゃいけないんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130408,
					"content": "気合を入れてこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130403,
					"content": "熱いうちにどうぞ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				}
			]
		},
		{
			"id": 2401331,
