			"trigger": {
				"objectNames": [
					"アイオーヌ"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "はぁ、やっぱり納得がいかない。どうしてなんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130102,
					"content": "アイオーヌ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "やあ、旅人さん。コーヒーでも飲みにきたんですか？ごちそうしますよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130105,
					"content": "どうしたんだ？なんか顔色が悪いけど…また徹夜でもさせられたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240130106,
					"content": "あはは、お気遣いなく。今回は自分自身の問題なんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130107,
					"content": "最近よく考えるんですよ…私の仕事の意義って何だろう、って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130108,
					"content": "私はずっと、共律庭は公正で合理的な、誰もが協力し合える最高の機関だと思っていました。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130109,
					"content": "実際、共律庭の管理のもと、フォンテーヌ廷はより良い方向へ発展しているはずです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130110,
					"content": "でも今になって考えると…ぼろぼろの機械仕掛けの建物みたいだなって思うんですよ。ギアもレバーもジブアームもめちゃくちゃにぶら下がっていて…外観だけはいつまでも輝きを保っている、みたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130111,
					"content": "ただ一連の偶然や教訓があるから動かせるんであって、緻密な思考や設計によってそれらを動かしているわけではないんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130112,
					"content": "何か行動を起こしたいけど…手の下しようがないんです。何か一つ間違いを起こしただけで、この機械仕掛けの建物全体が崩壊しちゃうんじゃないかって思うと怖くて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130113,
					"content": "ロアルテさんはいつも私に「もっと呑気に構えてろ」って言います。どんなにミスをしたって、今より状況が悪くなることはないって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130114,
					"content": "そ、それって慰めになってるのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240130115,
					"content": "ああ…すみません、愚痴ってしまって。私が今日気晴らしに出てきたのは、そういう事から逃げたかったからなんですよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130116,
					"content": "コーヒーを淹れてあげるよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "えっ、コーヒーが淹れられるんですか？それはすごいなぁ。私も以前勉強しようと思ったんですけど、時間がなくて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130118,
					"content": "じゃ、お言葉に甘えて。私はここで待ってますから…カフェにまで仕事が舞い込んでこないことを祈りながら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アイオーヌ"
				},
				{
					"id": 240130103,
					"content": "今日はお休み？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401302",
							"2"
						],
						"stepId": 2401302,
						"stateName": "QUEST_STATE_UNFINISHED"
