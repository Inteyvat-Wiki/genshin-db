			"dialogs": [
				{
					"id": 240130301,
					"content": "うーん…今回は何を使ってコーヒーを淹れるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
