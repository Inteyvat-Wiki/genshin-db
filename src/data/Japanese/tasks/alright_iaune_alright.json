					"content": "悪くなさそうだな。じゃあさっそく始めようぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240133102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 240133102,
					"content": "コーヒーを淹れ始めた…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "おお…いい香りがするぞ！早くこのコーヒーをアイオーヌのところに持ってって、元気出してもらおうぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
