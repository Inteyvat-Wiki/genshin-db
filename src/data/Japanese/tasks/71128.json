			"dialogs": [
				{
					"id": 711280201,
					"content": "「この木が成長したら、葉を摘んで茶を淹れよう」",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280202
					]
				},
				{
					"id": 711280202,
					"content": "「その時が来たら、留雲借風と理水畳山たちをここに呼び…」",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280203
					]
				},
				{
					"id": 711280203,
					"content": "「私の土地に木を勝手に植えたくせに、そんなことを考えるとは…」",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280204
					]
				},
				{
					"id": 711280204,
					"content": "…かつての約束は果たせず、無言の古樹はその言葉を依然として覚えている…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280205
					]
				},
				{
					"id": 711280205,
					"content": "…今の茶の香りは、既に沈玉の谷の山々に漂い、さらに遠く彼方へと流れてゆく…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
