			},
			"dialogs": [
				{
					"id": 747030101,
					"content": "待って…この帳簿…アナタたち、計算を間違えてないわよね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030102
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747030102,
					"content": "ん？なにか問題か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747030103,
					"content": "…儲かりすぎじゃないかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030104
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747030104,
					"content": "取り分を三割にしたこと、後悔してる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "そんなにケチなヤツだと思っているわけ？純粋に、アナタたちの経営手腕に感心しているだけよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747030106,
					"content": "オイラは「千霊映影祭」のおかげもあると思ってるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747030107,
					"content": "この売上額…ウィンガレット号を借りた代金を回収できたどころか、かなりの黒字よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747030108,
					"content": "転職する気になった？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "そこまでじゃないわ。ワタシが商売に向いていないのは分かっているもの。それに、機械構造や術式の研究のほうが興味があるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747030110,
					"content": "でも…そうね、魚が一匹もいなかった頃を思い出すと、今こんな姿になっているのは驚きね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747030111,
					"content": "へへっ、サンドローネが気前よく貸してくれたおかげだぞ！飾り付けた部屋がみんなに好かれるのって、嬉しいもんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747030112,
					"content": "ふん、ほんの少しだけね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 747030113,
					"content": "少しだけなのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 747030114,
					"content": "三割しかもらえないからかな…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030115
					]
				},
				{
					"id": 747030115,
					"content": "気にしてないと言っているでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「傀儡」"
				}
			]
		}
	]
