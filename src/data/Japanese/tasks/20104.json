					"nextDialogs": [
						201040202
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040202,
					"content": "綺麗に片付けた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040203
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040203,
					"content": "綺麗に片付けたよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "すごすぎ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040205,
					"content": "さすが旅人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040206,
					"content": "これでメイド長に怒られずに済むよ、ありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040207,
					"content": "これを受け取って、お礼だから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040208,
					"content": "別の場所の掃除をしないと…本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モコ"
				}
			]
		},
