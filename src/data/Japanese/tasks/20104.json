			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040102,
					"content": "またメイド長に怒られる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040103,
					"content": "どうしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "アデリンさんにワイナリーの外周を掃除するように言われてね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040105,
					"content": "他の場所は別にいいんだけど、周りに草の束がたくさんあるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040106,
					"content": "コナーさんが意図的に作ったもので、ちゃんとした用途があるらしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040107,
					"content": "ちゃんとくくったから、暴風に吹き飛ばされることはないけど、落ち葉が草の束に入っちゃったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040108,
					"content": "いろいろ試したけど、草の束の中にある落ち葉を綺麗に掃除できてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040109,
					"content": "このままだと、メイド長に怒られるよ。どうしよう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040110,
					"content": "任せて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "あっ？いいの？よかった、じゃあお願いするね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040112,
					"content": "難しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "落ち葉と草の束がごちゃごちゃになって、手でゆっくりかき分けてたけど、あまりにも時間がかかるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040114,
					"content": "何かいい方法があるなら、教えてほしいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘイリー"
				}
			]
		},
