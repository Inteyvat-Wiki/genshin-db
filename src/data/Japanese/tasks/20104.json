			"dialogs": [
				{
					"id": 201040301,
					"content": "な、何してんのよ、草の束をまるごと焼くなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040302,
					"content": "今回は怒られて済む話じゃないよ、きっとクビだよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040303,
					"content": "つい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "そうなるって分かってたら、手でゆっくりかき分けたほうがよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040305,
					"content": "終わった…何もかも終わったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040306,
					"content": "あの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "旅人、もう行っていいから、この件は私たちの責任だから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040308,
					"content": "掃除の仕方が分からない人に手伝わせた私たちが悪かった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "ヘイリー"
				},
				{
					"id": 201040309,
					"content": "メイド長は私たちをどうするのかな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "モコ"
				},
				{
					"id": 201040310,
					"content": "終わった…何もかも終わったよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヘイリー"
				}
