			"dialogs": [
				{
					"id": 742500201,
					"content": "ごちそうさまです、サンドローネさん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500202,
						742500203
					],
					"speakerTitle": "リネ"
				},
				{
					"id": 742500202,
					"content": "（もう少し、座っていようかしら。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "「傀儡」"
				},
				{
					"id": 742500204,
					"content": "はい、お気をつけて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "リネ"
				},
				{
					"id": 742500203,
					"content": "そろそろお茶会はお開きにしましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "「傀儡」"
				}
			]
