				"points": []
			},
			"dialogs": [
				{
					"id": 730633501,
					"content": "うわぁ！んぐっ…ゴボゴボッ！ゲホゲホゲホッ！！水…水が押し寄せてきた！溺れる！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633502,
						730633503,
						730633504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730633502,
					"content": "寒い。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633506
					]
				},
				{
					"id": 730633506,
					"content": "「チューバ境」は「バルサムフラワー」の夢。だから「バルサムフラワー」が目覚めたら、夢が空気中に拡散する。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633507
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633507,
					"content": "それで水の重さに耐えきれなくなって、水が溢れる！うーっ！バシャバシャッ！！涼しいだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633508
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633508,
					"content": "もうっ…水に流されたら戻って来られないんだぞ。そんなこと言ってる場合かよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633509
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730633509,
					"content": "へへっ、アランガルはナラと白いふわふわがどこにいるか分かる。草木もオマエたちの居場所を教えてくれる。だから帰れる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633510
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633510,
					"content": "「バルサムフラワー」は手に入ったから、次は「ゾーラ茸」と「ヤグナ草」を見つける。そしたらアランナガに「アランハオマ」を作ってもらえる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633511,
						730633516
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633511,
					"content": "「ゾーラ茸」を手に入れた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633512
					]
				},
				{
					"id": 730633512,
					"content": "#おお、ありがとう。ナラ{NICKNAME}と白いふわふわ！アランナガだったら絶対、「似ている、ナラヴァルナに…」って言ってたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633513
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633513,
					"content": "#へへっ、つまりナラ{NICKNAME}と白いふわふわはすごいってことだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633514
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633514,
					"content": "じゃあ、仲間のアランナガに会いに行こう。きっとオマエたちに頼みたいことがまだあるはずだ。アイツは「マウティーマ稠林」にいる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633515
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633515,
					"content": "うん、わかった！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730633521,
					"content": "これから…ボクもマウティーマ稠林に行って、「アランハオマ」儀式の準備をする。また向こうで会おう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633516,
					"content": "アランナガについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633517
					]
				},
				{
					"id": 730633517,
					"content": "アランナガはボクたち三つの中で一番年上で、愉快な仲間だ！面白い話をたくさんしてくれる。ナラのことも色々知ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633518
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633518,
					"content": "うーん、でもアイツも、ナラのことは結構忘れてる…ボクたち三つは忘れっぽい。花粉が風に舞うみたいに消えちゃったり、曖昧になったり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633519
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633519,
					"content": "でもアランナガは一番知ってる、覚えてる。だからボクたちはアイツと遊ぶのが好きだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633520
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633520,
					"content": "アイツはマウティーマ稠林の花園で、「マウティイェマ」を見張ってる。そこへ行けば会える！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633521
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633503,
					"content": "びしょびしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633506
					]
				},
				{
					"id": 730633504,
					"content": "うるさい…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730633505
					]
				},
				{
					"id": 730633505,
					"content": "おい！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633506
					],
					"speakerTitle": "パイモン"
				}
			]
		},
