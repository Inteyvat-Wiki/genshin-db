			"dialogs": [
				{
					"id": 730630601,
					"content": "金色のナラと白いふわふわ、よく来たな。ボクはアランガルだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630602
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630602,
					"content": "オマエたちが来るって、草木とキノコが教えてくれた。ずっと待ってたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630603
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630603,
					"content": "え…？オイラたちのこと知ってるのか…？それで、なにか用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630604
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630604,
					"content": "用だ！めちゃくちゃ大事な用だ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630605
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630605,
					"content": "まぁそう興奮するなって。落ち着けよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630606,
					"content": "うん。「マラーナ」が巨大化してる。ずっとずっと。森はあいつを恐れて黙ったまま、息もできなくなってるんだ…だって「マラーナ」がいる、「マラーナ」は森を食べる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630607
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630607,
					"content": "アランナガは「マラーナ」を止める「アランハオマ」の儀式で忙しい。でも「アランハオマ」には…「バルサムフラワー」が足りない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630608
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630608,
					"content": "なるほどな…その「バルサムフラワー」ってどこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630609,
						730630611
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630609,
					"content": "パイモン、名前を間違えなかったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630610
					]
				},
				{
					"id": 730630610,
					"content": "ふふん、バル！サム！フラワー！すごいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630612
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630612,
					"content": "「バルサムフラワー」はキノコが生えてる場所にある。いくつもの月が昇って沈む前、あそこはナラの家だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630613
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630613,
					"content": "でもその後…じめじめした土がナラの夢を埋め尽くした。それから、カレらの記憶が新しい草木を生み、枯れては蘇った…ボクたちが行くのは、つまりそういう場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630614
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630614,
					"content": "うっ…なんかよく分かんないけど、なんとなく怖いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630615
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630615,
					"content": "怖くない、怖くない。ナラが怖い場所、草木は好き。だからそこには草木がたくさんある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630616
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630616,
					"content": "そこにはナラたちとアランナラが一緒に残した符文がある。忘れないために、忘れた後に確かめるために。そこに行けば、「バルサムフラワー」がある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630617
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630617,
					"content": "うん…じゃあ、一緒に行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630618
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630618,
					"content": "そう、そう！それに、「クサヴァ」もある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630619
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630619,
					"content": "「クサヴァ」があれば、アランナラは元気が出る。元気が出たら、みんなの道案内ができる！アランガルは石を砕ける！ハッ！ハッ！バリンッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630620
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630620,
					"content": "アランガルはチビのくせに、怪力なんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630621
					],
					"speakerTitle": "パイモン"
				},
