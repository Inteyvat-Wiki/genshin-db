					"nextDialogs": [
						730631606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730631606,
					"content": "そうか、それは白いふわふわがバカだからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631607,
						730631608
					],
					"speakerTitle": "アランガル"
				},
				{
