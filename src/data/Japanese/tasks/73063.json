			},
			"dialogs": [
				{
					"id": 730633101,
					"content": "ここだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633102
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730633102,
					"content": "でもここ…ツル草で塞がれてるぞ？これじゃ入れないじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730633103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730633103,
					"content": "へへっ、白いふわふわ、落ち着け！見てろよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				}
			]
		},
		{
