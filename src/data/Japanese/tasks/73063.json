			},
			"dialogs": [
				{
					"id": 730632301,
					"content": "ここが「チューバ境」だ！草木の美しい夢が隠れてる場所、それがここだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632302
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632302,
					"content": "ほら、あそこに生えてるヤツ、あれが「バルサムフラワー」だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632303
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632303,
					"content": "うわぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632304,
						730632306
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632304,
					"content": "ここは静かだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632305
					]
				},
				{
					"id": 730632305,
					"content": "うん…静かすぎて不安になるくらいだぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632308,
					"content": "「チューバ境」は弱い…キノコ類が来て、養分をほとんど食い尽くした。でも「バルサムフラワー」は被害を受けてない…今のところは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632309
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632309,
					"content": "カレの封印を解いて、話をしよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632310
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632310,
					"content": "だな。封印はオイラたちが解くから、おまえはやつと話してみてくれ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632306,
					"content": "「バルサムフラワー」はここにあるのか…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632307
					]
				},
				{
					"id": 730632307,
					"content": "うーん…どっからどう見ても異常だぜ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632308
					],
					"speakerTitle": "パイモン"
				}
			]
		},
		{
			"id": 7306329,
			"completionStepIds": [
				7306329
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
