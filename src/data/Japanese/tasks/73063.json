			"dialogs": [
				{
					"id": 730631101,
					"content": "ほら、ここだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631102
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730631102,
					"content": "なんだこれ？…子供の絵みたいだな…なにが描いてあるのか全然わからないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631103
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730631103,
					"content": "これは記憶！アランナラの記憶は塊茎にも種にもあって、葉脈を流れてる…でも、ナラの記憶は石に刻まれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631104
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730631104,
					"content": "へへっ、月が空のてっぺんに昇るたびに、ボクたち三つのアランナラはここでナラみたいに過去の「物語」を記憶した！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631105
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730631105,
					"content": "えっと…それで、これはなんの絵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631106
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730631106,
					"content": "絵じゃなくて、符文だ…流光の河、その上には満開の星々の花の茎。河と星は、ボクたちの元にナラの勇者を送ってくれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631107
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730631107,
					"content": "草木のご主人様は勇者ナラの心に知恵の芽を授け、アランナラにカレらを案内させる…そうして水面は、キラキラ光る洞窟になるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730631108
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730631108,
					"content": "えっと…まぁそんな感じだ。近くに他の符文もある。見ながら歩こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				}
			]
