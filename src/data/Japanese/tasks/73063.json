			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"パイモン",
					"アランガル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730632901,
					"content": "アランガル、「バルサムフラワー」と話せばそれで終わりなんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632902
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632902,
					"content": "し——っ！し——っ！声が大きいって。カレがびっくりするだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632903
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632903,
					"content": "アランガルは「バルサムフラワー」とコソコソ話をした…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730632904
					]
				},
				{
					"id": 730632904,
					"content": "「バルサムフラワー」は、ボクたちのせいで夢から覚めたって怒ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632905
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632905,
					"content": "え…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632906
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632906,
					"content": "でも「アランハオマ」のためなら、仕方ないから許してやるって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632907
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632907,
					"content": "「バルサムフラワー」、「バルサムフラワー」、アランハオマのため、「マウティイェマ」の復活のため…仲間になってくれるよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632908
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632908,
					"content": "へえ…？うーん…んんん？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632909,
						730632911
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632909,
					"content": "パイモン、何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632910
					]
				},
				{
					"id": 730632910,
					"content": "「バルサムフラワー」がなんて答えるか聞いてる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632913
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632913,
					"content": "よかった。「バルサムフラワー」、一緒に冒険してもいいって！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632914
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632914,
					"content": "やったぁ！「バルサムフラワー」ゲットだぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632915
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632915,
					"content": "うーんと、それから…「バルサムフラワー」が、頭を守れって言ってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632916
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632916,
					"content": "…どういう意味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632917
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632917,
					"content": "頭と根っこを守らないと、水が来た時に衝撃で壊れちゃうんだって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632918
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632918,
					"content": "え…？あれ…なんの音だ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632919
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730632919,
					"content": "危ない！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730632911,
					"content": "彼らの言葉を理解できるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730632912
					]
				},
				{
					"id": 730632912,
					"content": "…というか、聞こえない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730632913
					],
					"speakerTitle": "パイモン"
				}
			]
		},
