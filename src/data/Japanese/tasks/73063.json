			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"アランガル"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730630501,
					"content": "金色のナラと白いふわふわ、よく来たな。ボクはアランガルだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630502
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630502,
					"content": "オマエたちが来るって、草木とキノコが教えてくれた。ずっと待ってたんだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630503
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630503,
					"content": "え…？オイラたちのこと知ってるのか…？それで、なにか用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630504
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630504,
					"content": "用だ！めちゃくちゃ大事な用だ！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630505
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630505,
					"content": "まぁそう興奮するなって。落ち着けよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630506,
					"content": "うん。「マラーナ」が巨大化してる。ずっとずっと。森はあいつを恐れて黙ったまま、息もできなくなってるんだ…だって「マラーナ」がいる、「マラーナ」は森を食べる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630507
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630507,
					"content": "アランナガは「マラーナ」を止める「アランハオマ」の儀式で忙しい。でも「アランハオマ」には…「バルサムフラワー」が足りない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630508
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630508,
					"content": "なるほどな…その「バルサムフラワー」ってどこにあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630509,
						730630511
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630509,
					"content": "パイモン、名前を間違えなかったね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630510
					]
				},
				{
					"id": 730630510,
					"content": "ふふん、バル！サム！フラワー！すごいだろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630512
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630512,
					"content": "「バルサムフラワー」はキノコが生えてる場所にある。いくつもの月が昇って沈む前、あそこはナラの家だった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630513
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630513,
					"content": "でもその後…じめじめした土がナラの夢を埋め尽くした。それから、カレらの記憶が新しい草木を生み、枯れては蘇った…ボクたちが行くのは、つまりそういう場所だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630514
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630514,
					"content": "うっ…なんかよく分かんないけど、なんとなく怖いぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630515
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630515,
					"content": "怖くない、怖くない。ナラが怖い場所、草木は好き。だからそこには草木がたくさんある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630516
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630516,
					"content": "そこにはナラたちとアランナラが一緒に残した符文がある。忘れないために、忘れた後に確かめるために。そこに行けば、「バルサムフラワー」がある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630517
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630517,
					"content": "うん…じゃあ、一緒に行ってみよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630518
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630518,
					"content": "そう、そう！それに、「クサヴァ」もある！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630519
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630519,
					"content": "「クサヴァ」があれば、アランナラは元気が出る。元気が出たら、みんなの道案内ができる！アランガルは石を砕ける！ハッ！ハッ！バリンッ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630520
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630520,
					"content": "アランガルはチビのくせに、怪力なんだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630521
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 730630521,
					"content": "へへっ、そうだ。怪力だ！うーん…でも緑色のツル草が絡みついた石だけ。石一個丸ごとなら…割れ目がなかったら、力が足りなくて砕けない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630522,
						730630525
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630522,
					"content": "「クサヴァ」って？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630523
					]
				},
				{
					"id": 730630523,
					"content": "「クサヴァ」は記憶と夢の入れ物だ。丸々してて、苦くて、力がいっぱい。花が咲いた植物の実、新しくって新鮮な命の種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630524
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630524,
					"content": "これ、やる。大事にしろ。アランナラはそれを大切な相手にしか預けない。だから…うん、食べちゃダメだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630527
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630527,
					"content": "えっと…月が出てきてまた去って、もうそんなに残ってない…歩くキノコはずっと中にいて、どんどん増えてる…まずい。急がないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630525,
					"content": "「バルサムフラワー」ってなに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630526
					]
				},
				{
					"id": 730630526,
					"content": "「バルサムフラワー」はアランナラの仲間。「アランハオマ」のために咲く花で、霊薬の源だ。えっと…その花を犠牲にした汁で、「アランハオマ」が精製できるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730630527
					],
					"speakerTitle": "アランガル"
				},
				{
					"id": 730630511,
					"content": "きっと見つけにくいんだろうね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730630512
					]
				}
			]
		},
