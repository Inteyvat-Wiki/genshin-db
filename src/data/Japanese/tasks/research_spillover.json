				]
			},
			"dialogs": [
				{
					"id": 761380201,
					"content": "ネフェルさん？それから…ゾンパイコさん。何かご用ですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761380202,
					"content": "ナタから来たこの客人が、「霜月の子」に会いたいらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380203,
					"content": "突然訪ねるのは無礼だからと、案内を頼まれてね。ゾンパイコ、これでいいだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380204,
					"content": "こんにちは、リーリキさん！お会いできてうれしいよ。あ…これはナタから持ってきた…化石の標本だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380205,
					"content": "ありがとうございます。でも…ゾンパイコさん、初めましてでもありませんのに。そんなにかしこまらないでください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761380206,
					"content": "えっ？どうして俺のことを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380207,
					"content": "前に食事を配っていた時、近くで見ていたでしょう？行ったり来たりしていましたけど、列には並びませんでしたよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761380208,
					"content": "並ぶのが恥ずかしかったのかと思って…それで、こっそりあなたの分を残していたんですよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761380209,
					"content": "でも…一度も食事を取りにきたことはありませんでしたね。もし今日来なかったら、私から、何か助けが必要か聞こうと思っていましたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761380210,
					"content": "そ…それは…すまなかった！どう声をかければいいか迷ってたものだから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380211,
					"content": "それじゃあ、リーリキさん。さっそくだけど「霜月の子」を訪ねてもいいかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380212,
					"content": "ええ、どうぞ。「霜月の子」にはもともと外部から来たお客さんもいますから。でも、何をするおつもりなんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761380213,
					"content": "写真を撮って、資料を調べて、あと、できれば…伝説について誰かに聞いてみたいな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380214,
					"content": "俺はナタの「龍の遺物研究会」の会員なんだ。研究に関係する資料が見つけられたらいいなと思ってね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380215,
					"content": "ああ…では、本を見たいということですね？それなら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "リーリキ"
				},
				{
					"id": 761380216,
					"content": "二人ともうまく知り合いになれたようだし、この依頼は完了ということにしてあたしは失礼するよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380217,
					"content": "ありがとう、ネフェルさん！あの…料金はちゃんと支払うからさ。さすがにタダってわけにはいかないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380218,
					"content": "そうかい、まあ好きにするといいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380219,
					"content": "それじゃ、お先に失礼するよ。あとは好きにやりな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ネフェル"
				}
			]
		}
	]
}