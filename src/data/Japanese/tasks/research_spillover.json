			"dialogs": [
				{
					"id": 761380101,
					"content": "あっ…ネフェルさん！ちょうどよかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380102,
					"content": "決心はついたかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380103,
					"content": "えっ？決心って…な、なんのことだ？まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380104,
					"content": "知ってるよ。あんたはずっと「霜月の子」へ行きたいと思ってたんだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380105,
					"content": "まずはリーリキと知り合いになって、「霜月の子」を訪ねるための足がかりにするつもりだった。違うかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380106,
					"content": "し…知ってたのか。はは…絶対誰にも言わず、心に留めてきたんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380107,
					"content": "ゾンパイコさん。秘密を守りたいなら、「秘密を守っている」ことを隠す方法も学ばないとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380108,
					"content": "じゃないと、いくら心の中で「壁」を築いたって、簡単に穴が開いてしまう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380109,
					"content": "はぁ…故郷にいた頃は、何も隠し事なんてしてなかったんだけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380110,
					"content": "まあいいや。そこまでわかってるんなら、いっそ紹介してくれないか？俺は外国人だし、いきなりリーリキさんのとこに行ったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380111,
					"content": "「霜月の子」の人々はみな親切だよ。訪問者が外国人だろうと人外だろうと、優しく迎え入れてくれるさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380112,
					"content": "えっ？そうなのか…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380113,
					"content": "いや…でも、やっぱりいきなりお邪魔するのは気が引けるな。やっぱりネフェルさんから紹介してもらいたいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "ゾンパイコ"
				},
				{
					"id": 761380114,
					"content": "いいよ。ちょうど食事も配り終えた頃だろうし、話すにはいいタイミングだ。じゃあ行くよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380115,
					"content": "ああ…今回はタダでいいよ。たまたま通りがかっただけだしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "ネフェル"
				},
				{
					"id": 761380116,
					"content": "ありがとう、ネフェルさん！すぐに支度してくるよ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ゾンパイコ"
				}
			]
		},
