			"trigger": {
				"objectNames": [
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756570201,
					"content": "#{NICKNAME}、ここだ、ここ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570202
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570202,
					"content": "へへっ、覚えてるか？オイラたちの旅が始まった場所だぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570203
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570203,
					"content": "気づいたら、いろんな場所を旅してたよな！よし、ここでオイラが一句！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570204,
						756570205
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570204,
					"content": "大詩人パイモン、どうぞ——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570207
					]
				},
				{
					"id": 756570205,
					"content": "ぷぷっ…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570206
					]
				},
				{
					"id": 756570206,
					"content": "邪魔するなよ。ちょっと考えさせてくれ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570207
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570207,
					"content": "テイワット 広大すぎて",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570208
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570208,
					"content": "歩ききれない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570209,
						756570210
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570209,
					"content": "（黙ったままでいる）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570210,
					"content": "字余りがすごい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570211,
					"content": "え、えーっと、テイワット…うぅ、なんも出てこないぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570212,
						756570214
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570212,
					"content": "あははっ！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570213
					]
				},
				{
					"id": 756570214,
					"content": "旅の大変さを詠みたかったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570215
					]
				},
				{
					"id": 756570213,
					"content": "ふんっ、好きなだけ笑ってろ！ずっと一緒に旅してきたから、もう笑われるのは慣れっこだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570215,
					"content": "#そう！オイラが伝えたかったのはそれだ。やっぱり{NICKNAME}はわかってるな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570216,
					"content": "真面目な話するとさ…旅がこう長くなってくると、最初の頃のことを忘れてくるだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570217
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570217,
					"content": "オイラも、あのとき食べた鳥肉のスイートフラワー漬け焼きの味を思い出せなくなってきたし…すごく美味しかったのに…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570218,
					"content": "だから、このアルバムを買ったんだ。旅で歩いたところや出会った人たちを写真に残そうと思ってさ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570219
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570219,
					"content": "娯楽小説や映影にも、こういうパターンってよくあるだろ？始まりの場所に戻ったら、もう結末が近いみたいな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570220
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570220,
					"content": "ここを撮影場所に選んだのは、思い出を懐かしむためだけじゃないぜ。これまでの道のりを見つめ直して、この先の旅にゆとりを持てるようにするためだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570221,
						756570222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570221,
					"content": "万葉との会話を盗み聞きしてた？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570224
					]
				},
				{
					"id": 756570222,
					"content": "パイモンが進化してる！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570223
					]
				},
				{
					"id": 756570223,
					"content": "うっ…たしかに万葉との話を盗み聞きしたのは認めるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570224,
					"content": "まったく。せっかく雰囲気を作ろうと思ったのに、台無しだぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570225
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570225,
					"content": "パイモンの言いたいことは分かる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570226
					]
				},
				{
					"id": 756570226,
					"content": "これからも一緒に旅を続けよう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570227
					]
				},
				{
					"id": 756570227,
					"content": "へへっ、わかってくれればいいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570228,
					"content": "よーし！ここのモデルは、テイワットの最高のガイドが一肌脱いでやるぞ。どんなポーズを取ってほしいか言ってみろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570229,
						756570230,
						756570231
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 756570101,
					"content": "あれ、ちょっと待った。オイラが貸した写真機はどうしたんだ？まさか…失くしたとか言わないよな。ほら、はやく出せって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
