			},
			"dialogs": [
				{
					"id": 790450101,
					"content": "人員と設備の配置完了。仕掛けの準備完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450102
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790450102,
					"content": "演劇「ダイアの三日空想」、「ブラッククリスタル号と金を呑む海獣」の章——これより開幕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450103
					],
					"speakerTitle": "楽園のお知らせスピーカー"
				},
				{
					"id": 790450103,
					"content": "お宝埋蔵地に最も近い港で、海賊船ブラッククリスタル号は人員と物資を補充し、大事な最後の航海のために準備をしている…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450104
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790450104,
					"content": "#経験豊富な冒険者たちがブラッククリスタル号のデッキに足を踏み入れた。{M#彼ら}{F#彼女ら}は卓越した戦闘の専門家だが、航海においてはただの素人に過ぎない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450105
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790450105,
					"content": "そこの新人、早くこっちへ来い！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450106
					],
					"speakerTitle": "一等航海士"
				},
				{
					"id": 790450106,
					"content": "あれ、スピーカーの声が変わったな。なんか厳しそうな人が大声でなにか言ってるぞ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450107
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450107,
					"content": "もしかしてこの声、オイラたちに話しかけてるのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450108,
					"content": "当然だ！お前たちは新人の中でも重要なポジションだ。欠けてはならんやつらだからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450109
					],
					"speakerTitle": "一等航海士"
				},
				{
					"id": 790450109,
					"content": "俺はこのブラッククリスタル号の一等航海士。これからしばらくの間、俺についてもらうことになる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450110
					],
					"speakerTitle": "一等航海士"
				},
				{
					"id": 790450110,
					"content": "気合い入れてけよ！今日はお前らの着任初日ってことで料理長が良い肉とクリーム、それからクッキーや蒲公英酒を振舞って歓迎してくれるぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450111
					],
					"speakerTitle": "一等航海士"
				},
				{
					"id": 790450111,
					"content": "スピーカーから流れる傍白が引き続き目の前の光景を語る——\\n\\n新人の前に現れた一等航海士はボロボロになった服を着ていて、全身に包帯を巻いている。\\nどうやら、少し前に激しい戦いに参加したようだ。\\n辺りを見渡すと、デッキにいる船乗りの大半はひどい怪我を負っていた…\\nしかし、彼らはなおも闘志に溢れていて、士気も高く、少したりとも落ち込んだり委縮したりしていなかった…\\n船乗りたちは新人を囲って盛大な拍手で迎き入れながら、歓迎の品とたくさんの食べ物を渡してきた。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790450112
					]
				},
				{
					"id": 790450112,
					"content": "なるほど、今みたいにシチュエーションを想像できるよう、細かな描写をする際は傍白が担当してくれるのか——オイラたちはこのブラッククリスタル号に来たばかりで、みんなに盛大に歓迎されてるみたいだな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450113,
					"content": "オイラたちも…この話に合わせて演じたほうがいいんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450114
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450114,
					"content": "へへへ、みんなありがとな！船の肉とクッキーはまだ食べてないけど、きっとおいしいんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450115,
						790450116
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450115,
					"content": "演者と道具が見当たらないのが残念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450117
					]
				},
				{
					"id": 790450117,
					"content": "そうだな…ところでこのアトラクション、名前が「三日空想」っていうだけあって、本当に「空想」——つまり、頭の中で想像していかないといけないのかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450118,
					"content": "きっとコストを削減しようとしたんだろうな…本物の海賊船を作って、自由に航行できる場所を用意するとなると、たくさんのモラが必要になるから…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450119
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450119,
					"content": "でも言葉だけで話が進んでいくなんて、さすがに厳しくないか！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450120,
						790450121
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450120,
					"content": "試してみないことにはまだ分からない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450122
					]
				},
				{
					"id": 790450122,
					"content": "わかったよ。それじゃあ、やってみるか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450123
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450123,
					"content": "騒がしい雰囲気がひと段落した後、屈強な男が屋外の艦橋に現れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450124
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790450124,
					"content": "彼は普通の船乗りと同じ服を着ているが、荒い作りの三角帽子を被っている。左手は見当たらず、代わりに錆びた鉄のフックがそこにはあった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450125
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790450125,
					"content": "総員、注目！ウィル船長が来たぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450126
					],
					"speakerTitle": "一等航海士"
				},
				{
					"id": 790450126,
					"content": "兄弟たちよ、ついにこの時が来た！各自持ち場に戻れ。武器と補給を確認し、船の状態を整えろ。まもなく出航だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450127
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450127,
					"content": "おっ！船長のお出ましだぞ、ずいぶんと野太い声だ…聞いただけで頼りになる人だってわかるな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450128
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450128,
					"content": "宝が埋まってる場所まであと少しだ。ここから先の航路は、今回の遠征の中で最も重要だと肝に銘じろ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450129
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450129,
					"content": "これまで負傷した兄弟たちも、水に落ちた物資も、消えた暝彩鳥の相棒も、なんとか金をかき集めて買った酒樽も…すべてが報われる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450130
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450130,
					"content": "伝説のお宝を見つけりゃあ、期日通りに海獣に財宝を献上できる！恩知らずの商人を探し回って、やつらの船を略奪せずに済む！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450131
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450131,
					"content": "船乗りとしての気概を見せろッ！俺たちの町の安全のために、故郷のみんなの安寧のために、全速前進だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450132
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450132,
					"content": "財宝！財宝！全速前進！安全安寧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450133
					],
					"speakerTitle": "船乗りたち"
				},
				{
					"id": 790450133,
					"content": "戦いに長けた新人を迎え入れた後、ブラッククリスタル号は出航の準備を整え、お宝埋蔵地へと向かおうとしていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450134
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790450134,
					"content": "おおっ、早くも大事な設定っぽいな？なんだか、海賊たちがお宝を探そうとしてる理由が普通じゃない気がするけど…これからなにが起こるのか、オイラ気になってきたぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450135
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450135,
					"content": "スピーカーが言うには「びゅんびゅん爆速車」に乗れば、劇の進捗を進められるみたいだ…うん、物語の展開もサクサクしてて悪くないペースだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450136
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450136,
					"content": "#そんじゃ、さっそく出発しようぜ、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450121,
					"content": "#パイモンと{M#俺}{F#私}の劇、堂々開演！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450122
					]
				},
				{
					"id": 790450116,
					"content": "セットがあれば臨場感を味わえたはず。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450117
					]
				}
			]
		},
		{
			"id": 7904508,
			"completionStepIds": [
				7904508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904508",
							"2"
						],
						"stepId": 7904508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790450801,
					"content": "お見事！二人の新人船乗りの助けによって、ウィル船長の仇は一目散に逃げていった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450802
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790450802,
					"content": "すべての困難を乗り越えた今、ブラッククリスタル号の行く手を阻むものはもう存在しない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450803
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790450803,
					"content": "あいつらの待ち伏せに遭ってもまったく動揺せずに対処するとは、さすが俺の兄弟たちだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450804
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450804,
					"content": "もちろん、新人の活躍も忘れちゃいねぇぜ！お前らがずっと先陣を切って手強い連中を片付けてくれたおかげで、俺たちは無事目的地まで辿り着けた！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450805
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450805,
					"content": "#どうってことないぜ！あんな悪い海賊の船が二隻来ようと三隻来ようと、オイラと{NICKNAME}の相手じゃないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450806,
						790450807
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450806,
					"content": "パイモン、ずいぶん役に入り込んでるね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450808
					]
				},
				{
					"id": 790450808,
					"content": "ま、まあまあだな！ここまでの道のりはかなり危険だったし、ウィル船長たちとは一緒に困難を乗り越えてきた仲だろ？だったら、真面目にやらないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450809
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450809,
					"content": "調べによると、あの石の壁を崩せば伝説のお宝が手に入るらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450810
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450810,
					"content": "ついにこの時が来た！この最も心躍る一撃は、我らが新星——新人の二人に任せよう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450811
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450811,
					"content": "それと…これが済んだら考えてることがあってな、みんなに相談させてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450812
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790450812,
					"content": "#へへっ、{NICKNAME}！ウィル船長はますますオイラたちのことを気に入ってくれたみたいだぞ。大事な一撃をオイラたちに任せてくれるなんて！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790450813,
						790450814
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790450813,
					"content": "一緒に重砲を発射しよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450815
					]
				},
				{
					"id": 790450815,
					"content": "祝いの時は来た！やっちまえ、新人ども！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一等航海士"
				},
				{
					"id": 790450814,
					"content": "一緒にお宝を開けよう！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450815
					]
				},
				{
					"id": 790450807,
					"content": "体験は悪くないみたいだね？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790450808
					]
				}
			]
		},
		{
			"id": 7904510,
			"completionStepIds": [
				7904510,
				7904511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904511",
							"2"
						],
						"stepId": 7904511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790451001,
					"content": "やったぜ！伝説のお宝が見つかったぞ！本当に見渡す限り全部モラだ、本当に泳げそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451002
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790451002,
					"content": "でも…なんかこのモラ、普段見るやつとちょっと違わないか？まさか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451003
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790451003,
					"content": "これは果たしてどういうことか…伝説の「モラプール」を埋め尽くしているのは、なんと装飾品の偽の金貨であった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451004
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790451004,
					"content": "予想外の事態に対し、ブラッククリスタル号の船員たちはどう反応するのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451005
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790451005,
					"content": "船長！こんなの情報と違うじゃないか。伝説のお宝がどうして、全部…偽物なんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451006
					],
					"speakerTitle": "一等航海士"
				},
				{
					"id": 790451006,
					"content": "はぁ…悪い予感が当たっちまったか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451007
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451007,
					"content": "伝説のお宝はただの餌で——何者かが良からぬことを企んでるのかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451008
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451008,
					"content": "黒幕の狙いは、幾多の困難を乗り越え、お宝を求めてやって来た者たちだ…そいつらは上等な武器を持っていて、優れた性能の船に乗っている。いずれも価値の高いものばかりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451009
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451009,
					"content": "疲れ果てた戦士たちを捕らえることができれば、奴隷として売ることもできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451010
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451010,
					"content": "くぅ～…全員騙されてたってことか！どうしてこんなワナがあるんだよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451011,
						790451012
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790451011,
					"content": "コストの関係上、理解できる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451013
					]
				},
				{
					"id": 790451013,
					"content": "えっと…た、確かにそうだな。おまえに言われてなかったら、演劇に参加してるってことを忘れるところだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451014
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790451014,
					"content": "他の演者もいないし、舞台セットも少し残念だけど…舞台裏のスタッフたちが本当に頑張ってるのはわかるんだよな。オイラたちも真剣に向き合わないと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451015
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790451015,
					"content": "ブラッククリスタル号のみんなの考えを聞いてみようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451016
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790451016,
					"content": "偽物のお宝の前で、ウィル船長が落ち込む船員たちを集めた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451017
					],
					"speakerTitle": "スピーカーから流れる傍白"
				},
				{
					"id": 790451017,
					"content": "もしかして、船長を恨んでる人がこれを仕組んだんじゃ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451018
					],
					"speakerTitle": "一等航海士"
				},
				{
					"id": 790451018,
					"content": "いや、そいつらにそんなタマはねぇ。俺たちが来なきゃ、失望するのはあいつらのほうだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451019
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451019,
					"content": "もしかすると…黒幕はここへ向かってる途中かもしれないな。今の俺たちの状態でそいつらを迎え撃つのは、賢い選択じゃあない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451020
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451020,
					"content": "まずは戦場を片付けるとしよう。他に宝箱があるかどうか確認してから、撤退の準備をしてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451021
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451021,
					"content": "俺たちはこれまでの貢献に応じて報酬を分けてきた。目の前の宝箱は新人たちの戦利品だ。俺たちが手ぶらで帰ることになったとしても、誰も新人のもんを横取りすんじゃねぇぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451022
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451022,
					"content": "クソッ、今回の航海で一銭も稼げてない。むしろ赤字になるとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451023
					],
					"speakerTitle": "船乗りたち"
				},
				{
					"id": 790451023,
					"content": "さて、どうしたもんか…また悪徳商人から強盗をして、あちこち金をかき集め、海獣に渡さなきゃならんのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451024
					],
					"speakerTitle": "船乗りたち"
				},
				{
					"id": 790451024,
					"content": "いいか、よく聞け。今回の航海で、俺たちブラッククリスタル号は決して収穫がゼロだったわけじゃねぇ。俺たちは、モラよりもずっと貴重な宝物を見つけた——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451025
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451025,
					"content": "危険な海域を突き進むテクニック、強敵に打ち勝つ戦い方、そして困難を克服する勇気だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451026
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451026,
					"content": "ちゃんと考えてみろ。俺たちが本当にお宝を見つけて、数えきれないほどのモラを手に入れたとして…それで本当に海獣から町を守り、平和になるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451027
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451027,
					"content": "つまり…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451028
					],
					"speakerTitle": "船乗りたち"
				},
				{
					"id": 790451028,
					"content": "あの海獣の欲深い本性を考えると、これまで以上に供え物を要求してくるかもしれないってことか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451029
					],
					"speakerTitle": "船乗りたち"
				},
				{
					"id": 790451029,
					"content": "そういえば、一番か二番に数えられるぐらい裕福な町が、俺たちの数十倍もの財宝を献上したって聞いたことがある。それでも、海獣は満足しなかったとか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451030,
						790451031
					],
					"speakerTitle": "船乗りたち"
				},
				{
					"id": 790451030,
					"content": "海獣の要望に応じること自体…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451032
					]
				},
				{
					"id": 790451032,
					"content": "おまえの言う通りだな。オイラたちなら、きっとその海獣を好き勝手暴れさせたりしないけど…でも、ウィル船長たちはみんな普通の人だし、そんな勇気はないかもしれないな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451033
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790451033,
					"content": "だから、俺たちは根本から問題を解決する必要がある。つまりだ…財宝の献上という、一番理不尽なことをどうにかしなきゃならない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451034
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451034,
					"content": "これまでの戦いを経て、俺は確信した——俺たちにはあの暴れん坊の海獣をやっつける力があるってな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451035
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451035,
					"content": "兄弟たちよ、俺を信じてくれるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451036
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451036,
					"content": "リスクは高いが、試す価値はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451037
					],
					"speakerTitle": "一等航海士"
				},
				{
					"id": 790451037,
					"content": "それ以外に、俺たちに選べる余地はないだろうしな。ずっと逃げてばかりいたら、いつか逃げ道もなくなっちまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451038
					],
					"speakerTitle": "船乗りたち"
				},
				{
					"id": 790451038,
					"content": "船長の話を聞いたら、ますます腹が立ってきた。海獣と相討ちになっても構わん、もうこれ以上は我慢の限界だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451039
					],
					"speakerTitle": "船乗りたち"
				},
				{
					"id": 790451039,
					"content": "よし！なら、ブラッククリスタル号の次の目標はそれだ。だが、まずはしっかり鍛えて準備しないとだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451040
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451040,
					"content": "特に今、俺たちには強い新人も加わった。こいつらは向かうところ敵なしの腕を持ってやがる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451041
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451041,
					"content": "新人たち、今このウィルに金はない。だが、もしお前らが協力してくれるなら、ブラッククリスタル号の全員がその恩に全力で報いるだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451042
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451042,
					"content": "ブラッククリスタル号に同行してくれ！そして、きっちり鍛えた後、あの強欲な海獣を一緒に懲らしめてくれねぇか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451043
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451043,
					"content": "おう、そのほうがよっぽどいいぞ。勇気を出して、悪者の海獣を退治しようぜ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451044
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790451044,
					"content": "#{NICKNAME}、ブラッククリスタル号のみんなを助けてやるだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451045,
						790451046
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 790451045,
					"content": "喜んで力を貸す！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790451047
					]
				},
				{
					"id": 790451047,
					"content": "さすがだ！新人、今からお前たちはブラッククリスタル号の中心メンバーとなる。そして、この船長ウィルと兄弟たち、それから同郷たちの良き助っ人で大恩人だ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451048
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451048,
					"content": "この後、ブラッククリスタル号は駐屯地に戻る。十分な力をつけた後、総力を上げて出撃し、海獣に重い一撃を食らわせてやろう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451049
					],
					"speakerTitle": "ウィル船長"
				},
				{
					"id": 790451049,
					"content": "スピーカーから流れる傍白が幕引きを簡単に語り出す——\\n\\n数多の困難を経て、戦闘に長けた新人たちはブラッククリスタル号の中心メンバーとなった。\\nウィル船長に率いられ、ブラッククリスタル号は重要な反撃に向けて準備を始める…\\n「ブラッククリスタル号と金を呑む海獣」第二幕——「新人船乗りの反撃の狼煙」乞うご期待！",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790451050
					]
				},
				{
					"id": 790451050,
					"content": "傍白が終わると、洞窟内の仕掛けも動作しなくなり、辺りは静かになった…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790451051
					]
				},
				{
					"id": 790451051,
					"content": "わっ、ここで終わるのかよ！せっかく盛り上がってきたところなのに！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790451052,
						790451053
					],
