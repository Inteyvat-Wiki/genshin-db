					"nextDialogs": [
						150221308
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150221308,
					"content": "普段もこんな風に銃の手入れをしてるのかよ…",
					"roleType": "TALK_ROLE_NPC",
