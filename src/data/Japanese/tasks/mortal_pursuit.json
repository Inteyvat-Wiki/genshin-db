			"dialogs": [
				{
					"id": 150220301,
					"content": "チャスカ、やっと戻ってきたか。部族の雰囲気はどんどん険悪になっている。調査に進展はあったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "ムトタ"
				},
				{
					"id": 150220302,
					"content": "私たちが飛行隊をひいきして、「燃素の翼」を弾圧するために商人たちを抑えつけたんじゃないかと疑っている者もいるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150220303,
					"content": "商人は捕まえたのに、対立は大きくなった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "いくつかの手がかりは見つけたが、確固たる証拠を見つけるには、まだ一つ難関が…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220306,
					"content": "チャスカはテパルの状況と、空中工房にまつわる推測を説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "灰燼の都の「遺物」——？これほどの年数を経てもなお、オチカンの残した「毒」が対立を引き起こすとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "ムトタ"
				},
				{
					"id": 150220308,
					"content": "空中工房…試練用の熱気球…次の目的地はこの二つね？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150220309,
					"content": "そこへ行く方法はある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "クク竜でも「燃素の翼」でも、あんなに高くは飛べないわ…そんな場所に、テパルは本当にいるのかしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150220311,
					"content": "うーむ…方法は…ないわけではないが。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "ムトタ"
				},
				{
					"id": 150220312,
					"content": "——本当か！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220313,
					"content": "試練会場に噴出口があったのを覚えているか？以前は地脈の異常と滞りによって、気体燃素が不足していた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "ムトタ"
				},
				{
					"id": 150220314,
					"content": "しかし、気体燃素が充満している今、逆にそれを塞いだら……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "ムトタ"
				},
				{
					"id": 150220315,
					"content": "つまり…一番高いところの噴出口だけを残して、すべての圧力をそこに集中させるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220316,
					"content": "そうすれば、集まった気体燃素は、最高地点で強烈な風圧を生成する…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "ムトタ"
				},
				{
					"id": 150220317,
					"content": "——そしたら、オイラたちは風に乗って上に飛べるってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220318,
					"content": "そういうことだ。リスクはあるが、チャスカの技術なら…行けるだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "ムトタ"
				},
				{
					"id": 150220319,
					"content": "本当に危険な策ね…でも確かに可能性はある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "アルパ"
				},
				{
					"id": 150220320,
					"content": "噴出口の塞ぎ方については、試練会場のインカナックに聞いてみるといい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "ムトタ"
				},
				{
					"id": 150220321,
					"content": "チャスカ…空中工房とやらが空に浮かんでいる証拠を掴めるかどうかは、君たちにかかっている…頼んだぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ムトタ"
				},
				{
					"id": 150220304,
					"content": "騒ぎ立ててるのは商人たちだけじゃない…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
