			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"シロネン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "アルパの話だと…テパルはこだまの子から来たんだよな？どうやって探せばいいんだ？一人ずつ聞いていくか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220102,
					"content": "こだまの子の知り合いに助けを求めるのが早い。この時間、一番捕まえやすいのは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220103,
					"content": "——シロネン、起きる時間だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220104,
					"content": "ふぁ～…あんたたちね…うんっ…ちょっと待って…いま木から降りるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220105,
					"content": "ふわぁ…んん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220106,
					"content": "二人とも木の上が好きなんだね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "私が木に登るのは、より遠くを見たり、より長く飛んだりするためだ。普通は、木の上で休んだりしない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220108,
					"content": "誰もがあんたみたいに、一日中せわしなく動き回ってるわけじゃないっつーの…さて、一体どういう要件でウチの貴重な休み時間を邪魔しに来たの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220109,
					"content": "すまない、シロネン。だが、緊急の要件なんだ——テパルという職人を知らないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220110,
					"content": "テパル？えっと、確か…プマーんちの息子かな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220111,
					"content": "こだまの子に戻ってきてる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "いや、数年前からいないけど…てか、そいつを探してどうするわけ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220113,
					"content": "話せば長くなる…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "事の経緯を簡潔に説明した…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "「燃素の翼」？テパルのやつ、相変わらずとんでもないものを作ってんだね…はぁ、今日の休み時間はこれで終わりらしい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220116,
					"content": "相変わらず…って、前も似たような研究をしてたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220117,
					"content": "そうだよ。花翼の集から帰ってきてから、人工物で空を飛ぶ方法を研究し始めたんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220118,
					"content": "「失翼者」になった後か…人工物って…お前が作ってくれた銃みたいなものか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220119,
					"content": "あんたのその「銃」は、いちばん誇り高いクク竜よりも手懐けるのが難しいんだ——それと、テパルが手に入れたがってたのは、才能のない一般人でも自由に空を飛べる道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220120,
					"content": "でもあの頃のテパルはいつも失敗してた。工房を何度も爆破して…自分の命さえ危うかったんだ。だから、その後のことは、気にしてなかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220121,
					"content": "テパルの両親は若い頃から外を旅してて、テパルが生まれてから部族に戻ってきた。でも、辺鄙な場所に住んでいて、人付き合いも多くなかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220122,
					"content": "だから、みんなあんまりあの人たちとは親しくないんだよね。テパルについて詳しく知りたいのなら、やっぱり家族にあたった方がいいと思うな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220123,
					"content": "すぐにプマーを呼んでくるから、あんたたちはウチの工房の前で待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				}
			]
		},
		{
			"id": 1502202,
