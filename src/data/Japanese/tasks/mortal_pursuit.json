			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"プマー",
					"シロネン"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "シロネンの工房の前でしばらく待った…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "お待たせ。この人がテパルの母親、プマーだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220203,
					"content": "こんにちは、オイラたちは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220204,
					"content": "挨拶は結構です、あの子のことはあまり話したくないので。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "プマー"
				},
				{
					"id": 150220205,
					"content": "えっ…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220206,
					"content": "あの子は私たちとは関係ないですから…あんな子、うちの子じゃありません！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "プマー"
				},
				{
					"id": 150220207,
					"content": "テパルに見えているのは、空を飛ぶ白昼夢だけ…私たちがいくら説得しても目を覚まそうとしない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "プマー"
				},
				{
					"id": 150220208,
					"content": "ふん…最後に去っていく直前には、地上のやつらに指図されないで済むように、空に工房を建てるとかなんとか言ってましたけどね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "プマー"
				},
				{
					"id": 150220209,
					"content": "こちらはテパルが残した手記です。知りたいことがあるのなら、自分たちで確認してください。これ以上は何も言いたくありません。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "プマー"
				},
				{
					"id": 150220210,
					"content": "最初からあんな子はいなかった…あの子も私を母親だとは認めていなかったしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "プマー"
				},
				{
					"id": 150220211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220212,
					"content": "こ、こんなに仲が悪かったとは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220213,
					"content": "プマーの旦那さん……つまり、テパルの父親はちょっと前に亡くなったの。テパルは父親の葬式にさえ来なかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220214,
					"content": "だから、プマーはもうテパルのことを完全に諦めちゃったのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220215,
					"content": "ウチはプマーを慰めてくる。また後で話そう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 150220216,
					"content": "ああ、頼む。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220217,
					"content": "じゃあ、今は…この手記しか手がかりがないってことか？なにが書いてあるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220218,
					"content": "えっと…「燃素の翼」の初期構想…それから…「空中工房」の構想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220219,
					"content": "「灰燼の都」オシカ・ナタ…「燃素の翼」の技術のプロトタイプは、オシカ・ナタのものみたいだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220220,
					"content": "まさか、本当に空に浮かぶ工房を作ろうとしてたのか？あいつ一人だけで…そんなこと、できるのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220221,
					"content": "気球の設計図…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "——あっ！試練会場の上にあったやつだ！めちゃくちゃ高く飛んでた気球じゃないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220224,
					"content": "あの気球が現れてしばらく経つけど、どうやってあそこへ飛んでいったのかは誰も知らなかった…でも、誰かが意図的に「飛ばした」のでなく…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220225,
					"content": "なにかしらの問題が起きて、より高い雲の上から…今の高さまで「降りてきた」ものだったんだとしたら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220226,
					"content": "もしかして…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "——空中工房の一部ってことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220228,
					"content": "その可能性は高い。だからイシドルでさえテパルの拠点がどこにあるか知らなかったわけだ…まさか、雲の上に隠れていたとは。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220229,
					"content": "まさか本当に空の上に隠されてるなんてな…でも、一体どうやって行けばいいんだ？チャスカ、おまえは…あんなに高く飛べるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220230,
					"content": "それは難易度が高すぎる。それに旅人も連れて行くとなると、なおさら不可能だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220231,
					"content": "たとえ「燃素の翼」を使ってもあんなに高くは飛べないはずだ…この手記に書いてある「遺物」を使わない限り。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220232,
					"content": "「遺物」はまだテパルが持ってるはずだけど…期待はできそうにないよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220233,
					"content": "パイモンはあれくらい高く飛べる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "飛べるか！どう考えても飛べるわけないだろ！だいいち、オイラを一人でテパルと戦わせて心が痛まないのかよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220235,
					"content": "安心しろ。私たちが方法を思いつかないからって、みんなもそうとは限らない。花翼の集の「飛行マスター」は私だけじゃないんだからな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220236,
					"content": "あっ…そうだな！アルパに聞くのもよさそうだぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150220237,
					"content": "ムトタもかつては飛行隊の達人だった。花翼の集に戻って、二人の意見を聞いてみよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150220222,
					"content": "この気球、どこかで見たような…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
