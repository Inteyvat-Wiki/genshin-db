					"nextDialogs": [
						150221103
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150221103,
					"content": "インカナック、時間がないんだ。噴出口を一刻も早く塞げないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221104
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150221104,
					"content": "技術面から言えば、しっかり計測して、プランニングまでしてから具体的な施策に落とし込むべきだと思うけど…あんたたちはきっとそんな話は聞きたくないんでしょうね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221105
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150221105,
					"content": "うん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221106
					]
				},
				{
					"id": 150221106,
					"content": "…なら、単純で乱暴極まりない方法しかないわ——あそこの固形燃素が見える？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221107
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150221107,
					"content": "前に調べた時、内部になにかしらの安定した構造ができてて、そう簡単に壊れなくなってるのが分かったの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221108
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150221108,
					"content": "でも同じ理由で、構造上の弱点も生じてる。一気にダメージを受けなければ、大丈夫なんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221109
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150221109,
					"content": "一斉に攻撃したら、何か起こるのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 150221110,
					"content": "——そのまま崩れるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221111
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150221111,
					"content": "…なるほどな、計画は大体わかった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221112
					],
					"speakerTitle": "チャスカ"
				},
				{
					"id": 150221112,
					"content": "さすがね！角度を合わせて全弱点を一斉に攻撃して、噴出口に向かって叩き落とせば…噴出口を塞げると思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221113
					],
					"speakerTitle": "インカナック"
				},
				{
					"id": 150221113,
					"content": "確かに単純で乱暴極まりないプランだな。私にぴったりだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "チャスカ"
				}
