					"nextDialogs": [
						150221303
					]
				},
				{
					"id": 150221303,
					"content": "ああ。見た目は部族の熱気球と変わらないが、中身は完全に改造されているな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
