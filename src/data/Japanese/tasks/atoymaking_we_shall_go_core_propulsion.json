			"trigger": {
				"objectNames": [
					"バートランド"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726960101,
					"content": "ふぅ…危なかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960102
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960102,
					"content": "あと少し、あと少しで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960103
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960103,
					"content": "バートランドのやつ、汗だくになってどうしたんだろ。なんだか、ぐったりしてるみたいだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726960104,
					"content": "「してるみたい」じゃなくて、本当にぐったり「してる」んだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960105,
						726960106
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960105,
					"content": "どうかしたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				},
				{
					"id": 726960107,
					"content": "ふふっ、あとちょっとで失敗するところだった。だが、俺の機転により緊急調整したおかげで、やっと安定したんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960108
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960108,
					"content": "今、それら元素が少しずつ、以前収集した原材料と組み合わさってる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960109
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960109,
					"content": "はぁ、まさに九死に一生とはこのことだろう。もし元素力を抑えられていなかったら、長野原家の花火とどっちが輝いているか勝負するところになっていた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960110
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960110,
					"content": "爆発しないって言ってたのに…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960111
					]
				},
				{
					"id": 726960111,
					"content": "俺が言ったのは、あくまで「おもちゃは爆発しない」だ。おもちゃの製造マシンが爆発しないことを保証した覚えはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960112
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960112,
					"content": "だが、今回は君たちが実験に協力してくれて本当によかった。もしあのまま生産過程に入っていたら、おもちゃが一つも作れないどころか、「大工機」も失っていたかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960113
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960113,
					"content": "よし、あとは最後の工程、「コア活性化」だけだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960114
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960114,
					"content": "コア活性化…前に聞いた感じだと、元素生物と関係があるんだよな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960115
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726960115,
					"content": "ああ。元素生物には、元素力を流動させるための動力があるんだ。その動力をマシンに入れることが、最後の工程だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960116
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960116,
					"content": "もし、おもちゃ作りに無事成功して、生産を続けられたら…大金を稼いで、借金を返済できる。そしたら、稲妻で幸せに暮らすんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960117
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960117,
					"content": "あれ？フォンテーヌには帰らないのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960118
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726960118,
					"content": "フォンテーヌか…ふっ、フォンテーヌ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960119
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960119,
					"content": "#{NICKNAME}、パイモン、君たちはまだフォンテーヌに行ったことがなかったね。行けば分かるさ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960120
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960120,
					"content": "一部の人からすれば、確かにあの国の生活は便利だろう。だが、ある一部の人にとっては、あそこは悲しみに満ちた失意の地なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960121
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960121,
					"content": "あそこのエネルギーシステムは少し特殊でな。いつまで続くか誰にも分からない。本当の崩壊が起こる前に、代わりとなるエネルギー資源を見つける必要がある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960122
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960122,
					"content": "しかし、変化とは想像よりも難しいもの。結果的に…俺は今、フォンテーヌ以外の地で、エネルギー源を自分で研究しなければならなくなった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960123
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960123,
					"content": "実は「大工機」も、新しいエネルギー源を研究していた際の産物なんだ。だから、まだ安定性に欠けていて、気をつけないと爆発してしまう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960124
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960124,
					"content": "だがいつか必ず、最高のエネルギー源を見つけてみせる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960125
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960125,
					"content": "フォンテーヌに帰るのは、その時が来てからでも遅くはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960126
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960126,
					"content": "バートランド…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960127
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 726960127,
					"content": "おしゃべりはこの辺にして、最後の工程を始めよう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726960128
					],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960128,
					"content": "#フォンテーヌへ帰るまで、稲妻でどんな生活を送れるのかは、君にかかってる、{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "バートランド"
				},
				{
					"id": 726960106,
					"content": "元素反応に失敗したの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726960107
					]
				}
			]
		},
		{
