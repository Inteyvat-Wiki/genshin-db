				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "この先は行き止まりみたいだね…あいつ、どこに隠れてるんだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850302,
					"content": "アンバー、あそこだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850303,
					"content": "やはり来たか…ん？ただの小娘だと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850304,
					"content": "あんたが「怪鳥」！もう逃げられないよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850305,
					"content": "ハハハッ、逃げなくとも、お前はここまで来られないだろう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850306,
					"content": "うっ──確かに高い…それに遠い。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850307,
					"content": "小娘、今から戻って団長でも呼んで来たらどうだ？そしたら降参するかもな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850308,
					"content": "西風騎士団を挑発してるつもり？今すぐ飛び超えて捕まえてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850309,
					"content": "落ち着いて。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "あっ…そうだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850312,
					"content": "目の前にいるのに、このまま飛んでいけたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850313,
					"content": "けど、怪鳥はどうやって行ったんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850314,
					"content": "まさか、行き来する装置が？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "わたしが見たところ、そんな装置は見当たらないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850316,
					"content": "それに、装置を設置できそうな壁もないし。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850322,
					"content": "さらばだ、小娘──",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850323,
					"content": "あっ、あいつ逃げる気だぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850324,
					"content": "迷ってるヒマなんてないのに。でも、「飛ぶ」以外に、ここを越える方法なんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850325,
					"content": "けど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850326,
					"content": "心配しないで、わたしはモンドの飛行チャンピオンだよ！あの怪鳥にできて、わたしにできないはずがない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850327,
					"content": "おい、偵察騎士。死にたいなら、風の翼なしでモンドの風神像から飛び降りた方がお前らしいぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850328,
					"content": "アンバーの言っている意味が分かった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#ああ、「飛行」以外に答えはないって、{NICKNAME}も分かってるみたいだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}、わたしが間違えて渡した本…覚えてる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850332,
					"content": "「最初の鳥は飛べなかった。鳥たちが勇気を振り絞ったから飛べた」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850333,
					"content": "わたしの答えを見ていて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850334,
					"content": "がんばれ！偵察騎士！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "うん！あいつに偵察騎士の勇気を見せてやる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850336,
					"content": "お、おい、馬鹿な真似はやめろ！大人しく帰れ！小娘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850337,
					"content": "どうして？よく聞いてみてよ。周囲から聞こえてくる囁きを…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850338,
					"content": "飛べる──風はそう言ってるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850329,
					"content": "勇気が必要なだけ、これは自殺じゃない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "元素魔法を使った可能性は？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#{NICKNAME}の元素視角で痕跡は見えないか？…うーん、やっぱないか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850319,
					"content": "カギ縄でも使ったのかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "飛んでも辿り着けないのに、投げてどうにかなるわけないだろ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850321,
					"content": "地面に引っかき傷も見当たらないしね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850310,
					"content": "周りを観察しよう…そう言ったでしょ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
