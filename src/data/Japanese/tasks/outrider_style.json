			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"アンバー"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "怪鳥を捕まえたね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850602,
					"content": "実は空中からしかあの風域が見えない仕掛けだったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850603,
					"content": "怪鳥が逃げた先は、もう行き止まりだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850604,
					"content": "だから、怪鳥がここから脱出するには、引き返すほかなかったんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850605,
					"content": "ああ──だから、オイラたちを諦めさせようと、あんなこと言ってたのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850606,
					"content": "まあ、そう簡単に騙されたりしないけどな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850607,
					"content": "#{NICKNAME}の言葉のおかげだよ。これこそ「不可能を排除し、最後に残ったものがいかに奇妙であっても、それが真実」ってやつだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850608,
					"content": "とにかく、飛行っていうのはね、7%の技術と3%の勘、残った90%が全て勇気なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850609,
					"content": "さっきのアンバーは、勇気が99%だったけどな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850610,
					"content": "へへっ、なんかわたしが初めて飛行テストを受けた時みたい…すごく緊張したけど、最後は無事免許を取れた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850611,
					"content": "それからのテストは、そういった緊張感が全然なかったから、なんだか物足りなかったんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850612,
					"content": "…待った、アンバーって飛行免許を持ってるんだろ？それ以外に何のテストを受けたんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 4850613,
					"content": "それは…モンド城内って飛べないエリアとか、着陸禁止エリアとかが多くて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850614,
					"content": "せっかく手に入れた飛行免許もすぐ取り上げられちゃってたから、全部で15回くらい受けたかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 4850615,
					"content": "でも、いつも一発合格だったよ。やっぱり、わたしの本は最高の指南書だね。",
					"roleType": "TALK_ROLE_NPC",
