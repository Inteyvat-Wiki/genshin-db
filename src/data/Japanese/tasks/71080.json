					"speakerTitle": "タリエシン"
				},
				{
					"id": 710800602,
					"content": "物語を語るだけなら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800604
					]
				},
				{
					"id": 710800604,
					"content": "快い返事をありがとう！ではさっそく、ありがたく聞かせてもらうよ！",
