					"ヴィクトリア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "あら？何か用かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030602,
					"content": "バーバラの休暇について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "そのことね。確かにバーバラは休暇を取ったわ、ある友達と一緒に過ごすっていう理由で。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030604,
					"content": "でも、本当に珍しいわね…バーバラが友達のために休みを取るなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030605,
					"content": "それはさておき、私に何か用かしら？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030606,
					"content": "「偉大なる幻想憂鬱珊瑚気泡茶」について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "え？バーバラがあなたと一緒にその…特製ドリンクを？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030608,
					"content": "もしかして、バーバラが言ってた友達ってあなたのこと？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030609,
					"content": "そう…「栄誉騎士」であるあなたなら、納得だわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030610,
					"content": "うん、状況は理解したからバーバラのことはお願いね、「栄誉騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030611,
					"content": "どうして行き先を伝える必要があるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "そのことね…バーバラがモンド城で凄く人気なのは、あなたも知ってるわよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030613,
					"content": "その人たちにとっては好意のつもりなんだろうけど、数が多すぎてバーバラの手に負えないことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030614,
					"content": "仕事中なら教会の人が彼女を助けてあげられるけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030615,
					"content": "休暇中だと…彼女一人で対応しなくちゃならないでしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030616,
					"content": "それに彼女…優しすぎるの。皆の要求に一人ずつ応えてるから、休日なのに仕事よりも疲れるなんてことがままあるらしいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030617,
					"content": "だからね、バーバラの行き先を知っておくことにしたの。本当に助けが必要な時、すぐに駆けつけてあげられるようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030618,
					"content": "本音を言うと、バーバラにはもう無理をしないで欲しいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "ヴィクトリア"
				}
			]
		},
