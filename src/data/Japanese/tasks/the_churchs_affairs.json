					"ヴィクトリア"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "あら、バーバラならまだ帰ってきてないわよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030302,
					"content": "奔狼領でバーバラを見つけた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "そうなの…無事ならよかったわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030305,
					"content": "ということは、すぐには帰ってこれないのね。教会のことは他の人にお願いしなきゃ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030306,
					"content": "手伝うよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "あら、手伝ってくれるの？ごめんなさいね、面倒かけて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030308,
					"content": "そうね…大聖堂の周りを掃除してくれないかしら。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030309,
					"content": "大聖堂の周りは人がたくさん来るから、汚れやすいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030310,
					"content": "いつもバーバラに任せてたから、彼女がいないとすぐ汚れちゃって…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030311,
					"content": "こんな広い場所、いつもバーバラ一人で？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "そう、バーバラったら自分でやるから大丈夫って言って、毎回一人でやろうとするの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030313,
					"content": "でも掃除が終わると、いつも凄く疲れてるのよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030314,
					"content": "だから、バーバラがあなたに手伝いをお願いするなんて正直驚いてるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030315,
					"content": "でも、これで彼女の負担も少し減るかしら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030316,
					"content": "とりあえず、掃除のことはお願いね、「栄誉騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "ヴィクトリア"
				},
				{
					"id": 190030303,
					"content": "バーバラはトゥナーの看病をしてる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
