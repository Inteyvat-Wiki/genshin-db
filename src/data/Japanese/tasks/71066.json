			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"タリエシン",
					"パイモン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "コホンコホン…すまないね、しかし詩人である以上、よりドラマチックに、より新しい物語を試みるものだろう？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660702,
					"content": "ハハッ…実はあの指輪は何年か前、宝盗イタチの巣から取ってきたものなのさ…保存状態もかなり良さそうだし、とても綺麗だったから、身に着けていたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660703,
					"content": "ふんっ、泥棒の盗品を盗んだってことか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710660704,
					"content": "そんな風に言うものじゃない…正しく言えば、拾ったんだ！私はあの宝をとても大事にしていたんだよ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660705,
					"content": "指輪について、何か手がかりはある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "そうだね…この辺りではよく宝盗イタチが出没するから、もしかしたら私が寝ているうちに、盗まれたのかもしれないね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660707,
					"content": "寝てるときも指輪をつけてたのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710660708,
					"content": "聞いたことがない。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "まあでも、オイラだったら外さないぞ！指輪を外したら、どこに置くか考えないといけないし、寝る時間が無駄になっちゃうからな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710660710,
					"content": "パイモンがつけられる指輪なんてある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "ふんっ、もちろんあるさ。世界はこんなに広いんだ、おまえが知らないものもたくさんあるぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710660712,
					"content": "二人とも、勝手に人の習慣を評価して話題にするのはやめてくれたまえ。とても失礼だよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660713,
					"content": "とにかく、もし指輪を探してくれるのなら…宝盗イタチの巣穴がないか探してみてくれるかい？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660714,
					"content": "地図のこの場所に…宝盗団が怪しい拠点を建てたと聞いたんだ。はい、マークしておいたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660715,
					"content": "そこには、宝盗イタチがよく出没するらしい。宝盗団と関係している可能性もある…とりあえず、そこへ行って調べてきてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660716,
					"content": "ふんっ…宝盗イタチから盗んだ指輪が、また宝盗イタチに盗まれたんなら、落とし主に返されただけのことじゃないか！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710660717,
					"content": "もう嫌みを言うのはやめてくれたまえよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タリエシン"
				}
			]
		},
		{
			"id": 7106608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
