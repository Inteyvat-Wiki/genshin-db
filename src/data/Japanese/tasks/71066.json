				"objectNames": [
					"クレイトポン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660801,
					"content": "やあ、何か用か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710660802,
					"content": "宝盗イタチについて…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "ほう、層岩巨淵の宝盗イタチについて聞きたいんだな？ははっ…元々は俺が管理してたんだが、ヘマしちまったんだ…何も言うことはない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710660804,
					"content": "まあ…もう一回やつらを捕まえるのは無理だな…やつらは神出鬼没で、追うのが難しい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710660805,
					"content": "だが、誰かの持ち物がやつらに盗まれたってんなら、ちょっとしたヒントくらいは教えてやれる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710660806,
					"content": "宝盗団が飼う宝盗イタチには、決まった時間に餌やりをする。そして、宝盗イタチは三種類ある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710660807,
					"content": "一番凄いのは「宝盗イタチ·黄金」…続いてよく見かける「宝盗イタチ·中堅」、そして少しマヌケな「宝盗イタチ·新米」、でも出現する時間帯は…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "クレイトポン"
				},
				{
					"id": 710660808,
					"content": "はぁ…訓練ハンドブックがあるはずだ。時間帯ならそれに書かれているから、わざわざ覚える必要なんかない。たぶん、宝盗イタチの出没地近くの拠点にあると思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660809
					],
					"speakerTitle": "クレイトポン"
				},
				{
