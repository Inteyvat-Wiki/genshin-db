					"タリエシン"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660301,
					"content": "間違いないよ、これだ！本当にありがとう！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660302,
					"content": "心ばかりの礼だけど、報酬を受け取ってくれるかい…この事は詩に詠んで、きっと世間に広めるよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "タリエシン"
				}
			]
		},
		{
