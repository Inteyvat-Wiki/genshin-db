			},
			"dialogs": [
				{
					"id": 710660101,
					"content": "はぁ…おかしいなぁ、実におかしい…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660102,
					"content": "ここにあったはずなのだけれど…どうして見つからないのだろうか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660103,
					"content": "何があったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "私の指輪が…見つからないんだ。あの指輪は私にとってとても重要なもので、こんなところで失くしてはならないのだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660105,
					"content": "どんな指輪だったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "銅製のリングに、綺麗な赤い宝石がはめられているんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660107,
					"content": "伝説の魔龍ドゥリンが墜落した地、その隣にある熔岩池で拾ってね。その宝石には、暗黒の炎のような光沢があるんだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660108,
					"content": "へぇ……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 710660109,
					"content": "伝説によると、それを身に着けると、「アビスの大君」に凝視され、暗黒の大軍に追われると言う…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "タリエシン"
				},
				{
					"id": 710660110,
					"content": "へぇ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		},
