			"dialogs": [
				{
					"id": 210340801,
					"content": "ふん、どうやらここみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340802,
						210340803
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340802,
					"content": "嵐姉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340804
					]
				},
				{
					"id": 210340804,
					"content": "あら？奇遇ね、まさかこんなところでまた会えるなんて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340805
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340805,
					"content": "そうよ、また協会から…ふふん、「適切」な依頼を見つけたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340806
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340806,
					"content": "状況も前回と同じ。今回もあの魔物たちを一緒に片付けに行ってもらいたいの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340807
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340807,
					"content": "左側の拠点にはヒルチャールの群れが集まってる。あなたにとって、一体のヒルチャールは大したことないでしょうけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340808
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340808,
					"content": "ここのヒルチャールの数は少なくない。もし奴らが群がってきたら、たとえあなたでも手間がかかるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340809
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340809,
					"content": "右側のほうにいるのは「ヒルチャール·岩兜の王」よ。あいつの危険性については…説明しなくても、あなたなら分かるはずよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340810
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340810,
					"content": "お願いしたのは私のほうだから、あなたがどの拠点を片付けるのか、先に決めてくれていいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340803,
					"content": "まだあの剣の欠片を探しているの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340804
					]
				}
			]
		}
