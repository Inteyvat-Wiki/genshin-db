					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "え？もちろんよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340404,
					"content": "何といっても、私は冒険者協会璃月支部の支部長だから。この程度の普通の魔物相手なら、あまり手間はかからないわ。",
					"roleType": "TALK_ROLE_NPC",
