			"dialogs": [
				{
					"id": 210340501,
					"content": "旅人、あの拠点にいる魔物を全部片付けたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340502,
						210340503
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340502,
					"content": "全部片付けた。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "ただの普通の魔物相手だったし、あまり手間はかからなかったわ。それに私はツイてるみたい。価値のある剣の欠片をまた見つけたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340505,
					"content": "#{M#俺}{F#私}のほうは何も見つからなかった…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "大丈夫よ、あなたは間違った場所を一つ排除してくれたんだから。ありがとね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340507,
					"content": "これは報酬よ、受け取って。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340508,
					"content": "もしすべての欠片を見つけられたら…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "やりたいことは単純よ。私は…「蔵鋒」を鋳直したい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340511,
					"content": "「蔵鋒」を鍛造した時に使われた設計図はもう失われてしまって、どんな材料で鍛造されたのかは分からないけど…まあ、何とかなるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340512,
					"content": "もし私が本当に「蔵鋒」を鋳直すことができたら、兄もきっと…はぁ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340509,
					"content": "欠片を探して何をしたいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340503,
					"content": "そっちは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				}
			]
		},
