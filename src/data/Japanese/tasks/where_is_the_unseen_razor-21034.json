			},
			"dialogs": [
				{
					"id": 210340101,
					"content": "ふん、どうやらここみたいね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340102,
					"content": "嵐姉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "旅人、まさかこんなところで会えるとはね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340105,
					"content": "この間探してくれたあの剣柄、まだ覚えてるかしら？あれは確かに「蔵鋒」の一部だったわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340106,
					"content": "面白いことに、そうだとわかったのは…子供の頃、こっそりナイフで印を刻んでおいたからなの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340107,
					"content": "そのとき兄に、もし他の剣に持ち替えることがあったら、「蔵鋒」を私にちょうだいと言ったのよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340108,
					"content": "ふふん、まさかこんな形で「蔵鋒」を手にすることになるとは…あの時の私も兄も思わなかったでしょうね。どうやら、この剣は…本当に壊れてしまったようだわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340109,
					"content": "さて、世間話はここまでにしましょう。せっかくここで出会ったんだから、もう一つあなたにお願いしたいことがあるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340110,
					"content": "この先に魔物の集落が二つあるわ。奴らはあちこちから壊れた武器をたくさん集めてきて、何らかの目的で拠点に置いている。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340111,
					"content": "協会はやつらが周囲に迷惑をかけないか心配で依頼を出すつもりだったけど、私はそれを見て自分で引き受けたの。もしかしたら、ここでまた「蔵鋒」の欠片を見つけられるかもしれないわ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340112,
					"content": "旅人、手分けして拠点を片付けに行きましょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340113,
					"content": "左側の拠点にはヒルチャールの群れが集まってる。あなたにとって、一体のヒルチャールは大したことないでしょうけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340114,
					"content": "ここのヒルチャールの数は少なくない。もし奴らが群がってきたら、たとえあなたでも手間がかかるでしょう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340115,
					"content": "右側のほうにいるのは「ヒルチャール·岩兜の王」よ。あいつの危険性については…説明しなくても、あなたなら分かるはずよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340116,
					"content": "お願いしたのは私のほうだから、あなたがどの拠点を片付けるのか、先に決めてくれていいわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姉"
				},
				{
					"id": 210340103,
					"content": "どうしてここに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
