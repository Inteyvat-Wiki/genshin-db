					"nextDialogs": [
						210340607
					]
				},
				{
					"id": 210340607,
					"content": "うん…確かに剣の欠片のようね。ありがとう、持ち帰ってよく調べてみるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
