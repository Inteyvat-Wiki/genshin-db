			"dialogs": [
				{
					"id": 761500101,
					"content": "ケホッ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 761500102,
					"content": "大丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "…大丈夫です。長い、長い悪夢を見ていた気がします。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 761500104,
					"content": "…ううん…大丈夫なんかじゃない…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 761500105,
					"content": "もう耐えられない…どうして私がこんな目に遭わなきゃいけないの…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 761500106,
					"content": "どうしていつも私なの？お父さんとお母さん、それにお姉ちゃんまで…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 761500107,
					"content": "#大丈夫、{M#俺}{F#私}がついてるから。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "…ごめんなさい。八つ当たり…でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 761500109,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "みっちゃん"
				},
				{
					"id": 761500110,
					"content": "みっちゃんは何を拾ったんですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 761500111,
					"content": "僕が「亡念の破片」と呼んでいるものだよ。死の中で生を求めるための活路となり得るかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761500112,
					"content": "一緒に行こう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "はい。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "カテリンド"
				},
				{
					"id": 761500114,
					"content": "カテリンドも見つかったことだし、ここから脱出する方法を探しに行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761500115,
					"content": "本当に、自力でここから出られるのですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "アラーラ"
				},
				{
					"id": 761500116,
					"content": "メランタとニヒリットが人を連れて自由に出入りできるんだから、みっちゃんにだってできるはずだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761500117,
					"content": "～♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "みっちゃん"
				},
				{
					"id": 761500118,
					"content": "「亡念の破片」を三つ集めたね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761500119,
					"content": "あっ、「亡念の破片」というのは仮の名前だよ。みっちゃんがこれを集めて何をするつもりなのかわからないし…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761500120,
					"content": "みっちゃん、次はどうする？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "イストリア"
				},
				{
					"id": 761500121,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "みっちゃん"
				},
				{
					"id": 761500122,
					"content": "みっちゃんが示す方へ進もう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "イストリア"
				}
			]
		},
