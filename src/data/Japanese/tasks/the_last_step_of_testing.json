			"dialogs": [
				{
					"id": 766580101,
					"content": "よう、ジェネット！この前回収したロボットのデバッグは終わったか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766580102,
					"content": "終わったわ。二人のおかげよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766580103,
					"content": "そういえば、おまえが言ってたようにいろんな発見があったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766580104,
					"content": "本当？話してくれる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766580105,
					"content": "何があったのかジェネットに話した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "そのロボットの行動の意味は…たぶん、あなたたちが好きだから「一緒に遊ぼう」って誘っているんだと思うわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766580107,
					"content": "ほんとか？へえ、面白いな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766580108,
					"content": "そっか…やっぱりそういうことだったのね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766580109,
					"content": "またなにか思いついたのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766580110,
					"content": "今度こそ確信できたわ。私のアイデアは、ロボット同士の交信を通じて実現できるの。だから、ロボットをたくさん見つければ見つけるほど、最初のアイデアに近づけるわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766580111,
					"content": "今のこの子たちは、もう他の子と交流できるようになってるわ。残りのロボットを全部集めれば…私のアイデアは実現する！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766580112,
					"content": "おお、楽しみだな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 766580113,
					"content": "あっ…ただ悪いけど、引き続き二人に頼らないといけないの。次のエリアも地図に記しておおくから、お願いね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "ジェネット"
				},
				{
					"id": 766580114,
					"content": "よし、さっそく行こうぜ！オイラもロボットたちが最終的にどうなるのか気になってきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				}
			]
		}
	]
}