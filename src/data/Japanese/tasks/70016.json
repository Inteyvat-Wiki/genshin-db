			"dialogs": [
				{
					"id": 700160101,
					"content": "…Yaya dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160102
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 700160102,
					"content": "Mimi tomo, mimi mosi mita, Muhe mita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160103
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700160103,
					"content": "Mita…? Gusha… Dada ika odomu Plata mimi, mimi mosi gusha…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160104
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 700160104,
					"content": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160105
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700160105,
					"content": "Mani…? Dada! Kundala zido mi, mi dada, mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160106
					],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 700160106,
					"content": "自然に会話できてる…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160107,
						700160108
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700160107,
					"content": "さすがマスクさん。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				},
				{
					"id": 700160109,
					"content": "口数が少ないだけよ。もう必要な情報は聞き出せたわ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160110
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700160110,
					"content": "敵を倒すだけでいいみたい。あとは任せたわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160111
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700160111,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヒルチャール"
				},
				{
					"id": 700160108,
					"content": "順調みたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				}
			]
		},
