			"dialogs": [
				{
					"id": 402170501,
					"content": "ヴァレサ、トレーニングの様子を見にきたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170502
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170502,
					"content": "あれ～パイモンちゃんの声がする？パイモンちゃん～！旅人さん～！会いたかったよぉ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170503
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170503,
					"content": "シロネンと一緒に、これまでのことを説明した。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402170504
					]
				},
				{
					"id": 402170504,
					"content": "あははっ！アラニさんとイーガンさんったら、なんで急に漫画のセリフで話し始めちゃったの～？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170505
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170505,
					"content": "まったくだ！オイラも反応に困ったぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170506
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170506,
					"content": "うーん、私だったら最初は「爆裂パワー！！」って言うかなぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170507
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170507,
					"content": "いや、それも反応に困るやつっしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170508
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170508,
					"content": "ってか、あんたに会いに行った人から聞いたけど、話をする前からミニーを持ち上げて、くるくる回してたんだって？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170509
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170509,
					"content": "あぁ～今考えるとちょっと恥ずかしいかも～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170510
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170510,
					"content": "初めて実際に会ったからついね～今までは手紙とかイラストを送り合うだけだったから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170511
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170511,
					"content": "ミニーちゃんだって分かったら、つい興奮しちゃったんだ～えへへ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170512
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170512,
					"content": "そういえばシロネンは、なんでさっきみんなを紹介するとき、「『炎魂戦士特戦隊』とウチ」なんて言ったんだ？一緒に来たんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170513
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170513,
					"content": "まるで仲間じゃないみたい。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170514
					]
				},
				{
					"id": 402170514,
					"content": "ああ、そもそもウチは、そのサークルのメンバーじゃないんだよね。ニペカがメンバーで、今回ウチは代わりに来たってだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170515,
						402170516
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170515,
					"content": "ニペカ？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170517
					]
				},
				{
					"id": 402170517,
					"content": "元気にやってるよ。よく食べて、よく眠ってるし、勉強の進み具合も順調。漫画にハマっただけじゃなくて、ミニーっていう文通相手とも知り合えた。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170518
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170518,
					"content": "時々、ニペカがウチの耳元であれこれ話してくるんだ。ミニーは絵が描けて、漫画の道具が作れて、人の相談に乗るのも得意。すっごくいい人なんだ、って…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170519
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170519,
					"content": "その話を聞いて、一度ミニーの年齢を疑ったこともあった。でも実際会ってみたら、年齢どおりの見た目で驚いちゃったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170520
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170520,
					"content": "ミニーがみんなに「雪山クロスカントリー」への参加を提案したって聞いて、ニペカも来たがってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170521
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170521,
					"content": "でも…あの子も自分の体のことは分かってる。そこで、ウチが代わりに参加するよう頼まれたってわけ。ミニーによろしく伝えられるようにね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170522
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170522,
					"content": "えへへ。わたしは前から旅行の準備をしてたから、シロネンさんと一緒に来られたんだぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170523
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170523,
					"content": "そーゆーこと。なぜかウチが副隊長ってことになってるけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170524
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170524,
					"content": "あ、当たり前だよぉ！シロネンさんの実力は隊長級でしょ！つまりほら…隊長級の副隊長ってこと！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170525
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170525,
					"content": "隊長になれる実力があるなら、なんでウチが副隊長を…っと、この話はここまで。危うく乗せられるところだった。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170526
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170526,
					"content": "ま、せっかく来たわけだし、ウチもニペカのために「炎魂戦記」の…えっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170527
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170527,
					"content": "グッズを買うんでしょ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170528
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170528,
					"content": "ああそう、グッズ。たぶんバッジとか、漫画の複製原画とか…あとはキャラが描かれた紙や木の板とかだよね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170529
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170529,
					"content": "え、ヴァレサ、なんでそんな怪訝な顔でウチを見てんの？なんか間違ってた？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170530
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170530,
					"content": "ううん、全部合ってるよ～ただ、シロネンさんがすっごく真面目にグッズのことを紹介してるのが不思議だな～って思ったの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170531
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170531,
					"content": "万能の名匠シロネンさんが、グッズの箱を抱えて戻ってくる光景…わあ～想像できない！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170532
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170532,
					"content": "でも、そんなにたくさん、全部ニペカちゃんが欲しがってるの～？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170533
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170533,
					"content": "ううん。ニペカはあの性格だから、プレゼントとか欲しがらないっしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170534
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170534,
					"content": "でもウチが知ってるニペカなら、このグッズをもらったら…めちゃくちゃ喜ぶと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170535
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170535,
					"content": "それはそうだよ～こんなプレゼントをもらったら、ニペカちゃんは大喜びだよ！えへへ～シロネンさんはニペカちゃんのことなら何でも知ってて、まるでお姉ちゃんみたいだねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170536
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170536,
					"content": "まぁ、そーだね。ウチらは家族だから。理解し合ってるかってなると…ニペカと一緒に過ごした時間はそんな長くないけど、それなりに分かり合えてんじゃないかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170537
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170537,
					"content": "ふぅ…腕立て伏せ…ヴァレサお姉ちゃん…腕立て伏せ、終わったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170538
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170538,
					"content": "わぁ、これで四セット目完了だね。う～ん、ちょっと休憩しよっか～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170539
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170539,
					"content": "ミニーちゃん、紹介するね。この二人は、旅人さんとパイモンちゃん。わたしとシロネンさんがナタで知り合った友達だよ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170540
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170540,
					"content": "金髪に…空飛ぶ白い…えっ、もしかして…モンドの栄誉騎士様？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170541,
						402170542
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170541,
					"content": "その通りだよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170543
					]
				},
				{
					"id": 402170543,
					"content": "うわあ、本物だ！わたし、お兄ちゃんが酒場で働いてて、よく色んな話を聞くんです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170544
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170544,
					"content": "酒場のお客さんが言うには、どの国に行っても、あなたたちの活躍が話題になってるそうです。まるで漫画の中の話みたいですよね！すごいです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170545
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170545,
					"content": "あの、一番印象深かった冒険について聞いてもいいですか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170546
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170546,
					"content": "そばにいるナタの友人二人を見ながら少し考えたあと、ナタで経験したことを話すことにした。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402170547
					]
				},
				{
					"id": 402170547,
					"content": "衝撃的です…フィエテナが暮らしてた国って、そんなに不思議なところなんですね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170548
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170548,
					"content": "他にもあるよ～「豊穣の邦」の近くに大きな火山があるんだけど、時々炎の弾を噴き出すの！すごく危ないんだけど、英雄の試練にはぴったりなんだ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170549
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170549,
					"content": "ヴァレサお姉ちゃん。わたし、ずっとモンドを離れて外の世界を見てみたいと思ってたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170550
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170550,
					"content": "いいと思うよ～！モンド人ってすごく自由だって聞いたし…どこへ行っても大丈夫だよねぇ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170551
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170551,
					"content": "でも…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170552
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170552,
					"content": "栄誉騎士様みたいに前へ進み続けて、どんな危険に遭遇しても絶対引き下がらないようにするには、すごく強い心が必要だよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170553
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170553,
					"content": "まあ、旅人さんほど強い人はほとんどいないけど…わたしたちだって、自分なりのやり方で努力できるよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170554
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170554,
					"content": "忘れないで。粘り強く前へ進み続けることも、フィエテナさまの精神のひとつだよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170555
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170555,
					"content": "そうだね。うん、わたし頑張る！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170556
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170556,
					"content": "それにお父さん、お母さんとの約束のためにも、練習を頑張っていい成績を残さないと。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170557
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170557,
					"content": "約束？そんなこと初めて聞いたけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170558
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170558,
					"content": "あ…それは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170559
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170559,
					"content": "大丈夫だよ～いつも競技の前は、わたしもイアンサコーチに「今回は絶対前よりいい成績を出す」って約束してるからぁ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170560
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170560,
					"content": "最終的にどれくらい力を発揮できるかは分からないけど、プレッシャーをかけたほうが、モチベーションが上がることもあるでしょ～？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170561
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170561,
					"content": "でも、「楽しむ」ことを忘れちゃダメだよ～！一番最初に「みんなと一緒に楽しく遊ぶ」っていう目的があったからこそ、今回みんな雪山に集まったんだから！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170562
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170562,
					"content": "分かってるよ、ヴァレサお姉ちゃん！でも…競技であることに変わりはないしね。へへっ、やっぱりいい成績は出したいかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170563
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170563,
					"content": "うん！そう思うんなら～もっと練習に付き合ってあげるね！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170564
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170564,
					"content": "よーし！ヴァレサお姉ちゃんについてくよ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170565
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170565,
					"content": "やめときなって。さっき練習終わったばっかっしょ？ヴァレサは平気かもしんないけど、ミニーは休んだほうがいいよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170566
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170566,
					"content": "わたしはまだ…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170567
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170567,
					"content": "ぐう～…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170568
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170568,
					"content": "ほら。そろそろ食事の時間でしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170569
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170569,
					"content": "そうだぞ。お腹が減ってたら、練習なんてできないからな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170570,
						402170571
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170570,
					"content": "バランスよく食べること。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170572
					]
				},
				{
					"id": 402170572,
					"content": "そうそう～食事もトレーニングの大事な一部なんだよ！イアンサコーチのスペシャルレシピを教えてあげるね。これで明日も元気いっぱいだよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170573
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170573,
					"content": "そうなの？ヴァレサお姉ちゃん、モンドの料理だと、トレーニング後は何がいいか知ってる？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170574
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170574,
					"content": "よく分からないけど～食事に関しては…胃袋の直感を信じればいいんだよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170575
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170575,
					"content": "まずは獣肉ハリケーンからだね…あと魚のミントソースグリル、タタコス、カウサ、グレイン・ポソレ、それからアップルシュトゥルーデルも！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170576
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170576,
					"content": "えっ——これ全部食べなきゃいけないの！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170577
					],
					"speakerTitle": "ミニー"
				},
				{
					"id": 402170577,
					"content": "うんうん。胃袋を解放して料理を楽しく味わえば、気づかないうちに食べ終わっちゃうよ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170571,
					"content": "そして適度にトレーニングすること。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170572
					]
				},
				{
					"id": 402170542,
					"content": "#{M#君}{F#あなた}も知ってたの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170543
					]
				},
				{
					"id": 402170516,
					"content": "彼女は今どうしてるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170517
					]
				}
			]
		},
