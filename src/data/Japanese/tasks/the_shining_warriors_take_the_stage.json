			"dialogs": [
				{
					"id": 402170601,
					"content": "そうだ～もうすぐキャンプに着くけど、さっきシロネンさんの話を聞いて、これは絶対に忘れちゃいけないなって思ったの～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170602
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170602,
					"content": "はい！『炎魂戦記』の二巻だよ。前に、みんな読みたいかもしれないって思ったから、漫画を多めに持ってきたんだ～",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170603
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170603,
					"content": "でも、荷造りする時に一巻を入れるのを忘れちゃって～友達に漫画をすすめるなら、本当は一巻を貸したほうがいいんだけど…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170604
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170604,
					"content": "時間のある時に読んでみて～もし気に入ってくれたら嬉しいなぁ。そしたら、きみみたいなすっごい人が、同じ趣味の仲間ってことになるでしょ～！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170605,
						402170606
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170605,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170607
					]
				},
				{
					"id": 402170607,
					"content": "それじゃ、わたしたちはみんなとの集まりがあるから～時間があったらまた一緒に遊ぼうねぇ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170608
					],
					"speakerTitle": "ヴァレサ"
				},
				{
					"id": 402170608,
					"content": "え～、ここで終わりかよ。フィエテナたちの戦闘もカッコよかったし、オイラ続きが見たいぞ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170609
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170609,
					"content": "旅人、時間ができたら次の巻の内容を聞きに、ヴァレサたちに会いにいこうぜ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170606,
					"content": "時間ができたら見てみる。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170607
					]
				}
