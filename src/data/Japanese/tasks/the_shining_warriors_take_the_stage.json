			"dialogs": [
				{
					"id": 402170301,
					"content": "よう、アンバー。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170302
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170302,
					"content": "あ、旅人にパイモン、また会えたね！話に夢中で二人が来たのに気づかなかったよ、ごめんごめん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170303,
						402170304
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170303,
					"content": "こんにちは、アンバー。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170305
					]
				},
				{
					"id": 402170305,
					"content": "ハインツさんと競技について話し合ってたんだ。それで、二人は雪山まで何しに来たの？もしかして、また何かの依頼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170306
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170306,
					"content": "いや、大会の宣伝チラシをもらって、ちょっと気になったから見にきたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170307,
						402170308
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170307,
					"content": "大会に参加するのが今から楽しみ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170309
					]
				},
				{
					"id": 402170309,
					"content": "それなら、いいところに来たね！わたしとハインツさんは大会組織委員会のメンバーなんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170310
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170310,
					"content": "どうも、栄誉騎士。そして君はパイモンだね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170311
					],
					"speakerTitle": "ハインツ"
				},
				{
					"id": 402170311,
					"content": "私は騎士団第1小隊の佐官、ハインツ。お二人に会えて光栄だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170312
					],
					"speakerTitle": "ハインツ"
				},
				{
					"id": 402170312,
					"content": "大会はまだ正式には始まっていなくて、今は観客席と来賓席のチケットをそれぞれ配布している段階なんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170313
					],
					"speakerTitle": "ハインツ"
				},
				{
					"id": 402170313,
					"content": "よかったら、これを受け取ってほしい。君たち用の来賓席チケットだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170314
					],
					"speakerTitle": "ハインツ"
				},
				{
					"id": 402170314,
					"content": "どうもありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170315
					]
				},
				{
					"id": 402170315,
					"content": "いえいえ。\\nどういたしまして。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170317
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170317,
					"content": "たしかチラシに「ドラゴンスパイン国際クロスカントリー大会組織委員会」って書いてあったけど、アンバーが言ってたのってそれのことか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170318
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170318,
					"content": "そうだよ。今回の組織委員会は、西風騎士団の団員と清泉町の住民代表によって、共同で編制されてるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170319
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170319,
					"content": "具体的に言うと、わたしとハインツさんはエントリー手続きと会場の安全管理を受け持ってて、清泉町の人たちは審判と運営のサポート業務を担当してるの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170320
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170320,
					"content": "もし問題が起きたら、遠慮なくわたしたちのところに来てね！参加者と観客全員が大会を楽しめるように頑張るから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170321,
						402170322
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170321,
					"content": "アンバーは相変わらず頼もしいね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170323
					]
				},
				{
					"id": 402170323,
					"content": "今大会はこれまでより規模が大きいんだ。国外からの参加者もいて、ナタ人の選手まで来ている。間違いなく盛り上がるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170324
					],
					"speakerTitle": "ハインツ"
				},
				{
					"id": 402170324,
					"content": "あっ、誰のこと考えてるか、分かったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170325
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170325,
					"content": "あのチームの人でしょ…ピンク髪で、頭に立派な白い角が生えてる女の子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170326
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170326,
					"content": "彼女、ホントにすごい食欲だよね！その子と一緒に食事するのをみんな楽しんでるって、スタッフさんが言ってたよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170327
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170327,
					"content": "ふふっ、彼女ってすごく美味しそうに食べるから、ついこっちまでご飯をおかわりしたくなるんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170328
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170328,
					"content": "もう一人のメンバーは、黄色と黒のしましま尻尾を持ってて、すごく触り心地が良さそうだった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170329
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170329,
					"content": "でも彼女ってクールな感じだから、さすがに触っていいかお願いするのは抵抗あったな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170330
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170330,
					"content": "あれっ、その説明…もしかしてオイラの知ってるやつらか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170331,
						402170332
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170331,
					"content": "ヴァレサとシロネンかも。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170333
					]
				},
				{
					"id": 402170333,
					"content": "ああ、知り合いなんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170334
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170334,
					"content": "二人に会いたいなら、あそこにある彼女たちのチームのキャンプに行ってみて。特別な模様が描かれたテントのところだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170335
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170335,
					"content": "あのキャンプってキレイだし、漫画もたくさん置いてあるんだよね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170336
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170336,
					"content": "おぉ、あれだな。あとで見にいってみるぜ。ありがとな！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170337
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170337,
					"content": "そだ！よかったら、彼女たちのところで漫画を一冊借りてきてくれないかな？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170338
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170338,
					"content": "あのチームの選手って、いつも漫画の話をしてるから興味が湧いたんだけど、仕事が忙しくて行けてないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170339
					],
					"speakerTitle": "アンバー"
				},
				{
					"id": 402170339,
					"content": "いいぜ。オイラたちに任せとけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170332,
					"content": "挨拶しにいこう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170333
					]
				},
				{
					"id": 402170322,
					"content": "競技を観戦しにくるね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170323
					]
				},
				{
					"id": 402170308,
					"content": "顔なじみがいないかなと思って。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170309
					]
				},
				{
					"id": 402170304,
					"content": "何してるの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170305
					]
				}
			]
		},
