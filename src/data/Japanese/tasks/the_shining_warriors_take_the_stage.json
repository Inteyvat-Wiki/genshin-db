			},
			"dialogs": [
				{
					"id": 402170401,
					"content": "こんにちは！ヴァレサとシロネンはいるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170402
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170402,
					"content": "おお、隊長と副隊長を探してるのか。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170403
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170403,
					"content": "…旅人？見間違いかと思ったけど、やっぱりあなただ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170404,
						402170408
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170404,
					"content": "アラニ、論文はどうなったの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170405
					]
				},
				{
					"id": 402170405,
					"content": "再会して早々、そんな残酷な話をしないで。今は貴重な休暇中なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170406
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170406,
					"content": "私は論文のことで頭を悩ませ続けてきた。でも生身の人間である以上、厳しい現実に打ち負かされることだってある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170407
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170407,
					"content": "私は論文に打ち負かされたの。もう一度論文と向き合うのは、しばらく休んでから。お願いだから、もうここではその話題に触れないで。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170412
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170412,
					"content": "どこに行っても知り合いだらけだ。テイワットって狭いよな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170413
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170413,
					"content": "みんなヴァレサとシロネンのことを知ってるなら、説明は簡単だな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170414
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170414,
					"content": "あいつらが雪山での競技に参加するって聞いて、ちょっと挨拶にきたんだ。へへっ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170415
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170415,
					"content": "ヴァレサとシロネンなら今はいないけど、キャンプの中で待っていても構わないよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170416
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170416,
					"content": "わかった。おまえらのテントって独特だよな…おっ、漫画がたくさん置いてあるぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170417,
						402170418
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170417,
					"content": "アンバーの言ってたとおりだ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170419
					]
				},
				{
					"id": 402170419,
					"content": "そういえば、おまえたちがすごく熱心に漫画のことを語ってるのを見て、友達が面白そうだって言ってたぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170420
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170420,
					"content": "どんな漫画について話してたのか、教えてくれないか？オイラも少し興味あるんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170421
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170421,
					"content": "漫画？あなたたちも漫画に興味があるの？ふふっ、やっぱりね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170422
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170422,
					"content": "「激しさ」と「激しさ」は惹かれ合い、「最強」と「最強」はいずれ相まみえるもの…ってのは、まさにこのことだな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170423
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170423,
					"content": "いいよ。そんな風にお願いされたら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170424
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170424,
					"content": "このタン・イーガン、答えないわけにはいかない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170425
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170425,
					"content": "この漫画こそ、俺たち「炎魂戦士特戦隊」の聖典——『炎魂戦記』だ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170426
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170426,
					"content": "あなたたちは今、「炎魂戦士って何者？」「『炎魂戦士特戦隊』ってどんな組織なの？」って聞きたくて仕方がないんじゃない？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170427,
						402170428
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170427,
					"content": "いや、別に…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170429
					]
				},
				{
					"id": 402170429,
					"content": "イーガン、教えて。炎魂戦士の鉄則とは何なのかを！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170430
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170430,
					"content": "「其の一：涙と忠告だけで平和を保とうなんて、考えが甘すぎる！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170431
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170431,
					"content": "「其の二：命を燃やし尽くそうと、永遠の闇には勝てない。それでも俺は戦い続ける！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170432
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170432,
					"content": "私たち「特戦隊」は命をかけて炎魂戦士についていく。そう、我らは——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170433
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170433,
					"content": "失敗や痛みを決して恐れることなく、愛と想像力を永遠に守り続ける！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170434
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170434,
					"content": "ああ、ついでに言っておくと、今話した炎魂戦士の鉄則二つは『炎魂戦記』第六巻・ダークファントム編からの引用だよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170435
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170435,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170436
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170436,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170437
					]
				},
				{
					"id": 402170437,
					"content": "な…なんで無反応なの？心の奥底にある情熱が、ほんの一瞬でも燃え上がったような気がしなかった？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170438
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170438,
					"content": "いや…全然。説明が抽象的で、オイラにはわからなかったぞ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170439
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170439,
					"content": "うーむ、なんという屈辱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170440
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170440,
					"content": "それ以上「情熱」を燃やすのはやめときなって。やりすぎると、みんな灰になっちゃうっしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170441
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170441,
					"content": "よかった、副隊長が戻ってきた。ちょっと聞いて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170442
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170442,
					"content": "あー、旅人とパイっちの顔を見たらどういう状況か分かったから、だいじょぶ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170443,
						402170444
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170443,
					"content": "#誰か{M#俺}{F#私}に説明して。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170445
					]
				},
				{
					"id": 402170445,
					"content": "アラニとタン・イーガンに色々と…わけわかんない話を聞かされたんでしょ？冗談だと思ってくれればいいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170446
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170446,
					"content": "さっき二人が言ってた「セリフ」は全部、八重堂から出版されてる長編バトル漫画『炎魂戦記』に載ってるやつだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170447
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170447,
					"content": "そんで「炎魂戦士特戦隊」っていうのは、簡単に言えば「漫画好きのサークル」ってとこかな。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170448
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170448,
					"content": "お…おお！やっと理解できたぞ。それで、おまえらのサークルは、どうしてモンドに集まってるんだ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170449
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170449,
					"content": "さぁね。まぁ、どうせ「雰囲気がー、情熱がー」って感じの答えっしょ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170450
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170450,
					"content": "はっきり言ったね…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170451
					]
				},
				{
					"id": 402170451,
					"content": "アラニだって分かってないかんね。理由を聞いたって、きっと…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170452
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170452,
					"content": "俺たちは炎魂戦士だろ？青春真っ盛りの情熱は、最も挑戦的なフィールドがあってこそ光り輝くんだ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170453
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170453,
					"content": "…こんな風に答えるだけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170454
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170454,
					"content": "実は、今回集まる場所を提案したのは、メンバーの一人「ミニー」って子で、「雪山クロスカントリー」も彼女のアイデアなんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170455
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170455,
					"content": "色々考えた結果、悪くない計画だってことで、ミニーの提案に従ってあいつらも進めることにしたってわけ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170456
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170456,
					"content": "で、最終的に「炎魂戦士特戦隊」とウチがここにやってきたの。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170457,
						402170458
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170457,
					"content": "それで、漫画は借りられる？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170459
					]
				},
				{
					"id": 402170459,
					"content": "もちろんいいよ。ここに来る前、漫画に興味のある人に出会えるかもと思って、わざわざ多めに持ってきたから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170460
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170460,
					"content": "友達っていうのはどの人？近くにいるの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170461
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170461,
					"content": "実はオイラたち、組織委員会の友達アンバーに頼まれて借りにきたんだ。赤いリボンを着けてて、すごく明るい騎士の女の子なんだけど知ってるか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170462
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 402170462,
					"content": "ああ、覚えてる。あのすごく親切な子ね！だったら私が直接漫画を渡しにいく。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170463
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170463,
					"content": "俺も一緒に行こう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170464
					],
					"speakerTitle": "タン・イーガン"
				},
				{
					"id": 402170464,
					"content": "オッケー、じゃあ頼んだかんね。旅人、ヴァレサにも会っておきたいっしょ？トレーニング場のほうにいると思うよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170465
					],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170465,
					"content": "シロネンは一緒に来ないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170466
					]
				},
				{
					"id": 402170466,
					"content": "うーん、休みたかったんだけど…ま、いいや。あんたがそう言うなら一緒に行く。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "シロネン"
				},
				{
					"id": 402170458,
					"content": "#{M#俺}{F#私}の友達が読みたいんだって。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170459
					]
				},
				{
					"id": 402170444,
					"content": "（困った顔で頭をかく）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170445
					]
				},
				{
					"id": 402170428,
					"content": "#{M#俺}{F#私}は聞いてないよ。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170429
					]
				},
				{
					"id": 402170418,
					"content": "相当漫画が好きみたいだね。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170419
					]
				},
				{
					"id": 402170408,
					"content": "前に会ったことある？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170409
					]
				},
				{
					"id": 402170409,
					"content": "私のことを覚えてないの…？まぁ、それもそうか。大変な出来事を何度も経験してれば、誰と会ったかなんて、いちいち覚えていられないものね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170410
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170410,
					"content": "私はアラニ。教令院のハーバッド…のちょっと下の、ダリオッシュね。ふふっ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170411
					],
					"speakerTitle": "アラニ"
				},
				{
					"id": 402170411,
					"content": "でも卒論さえ書き終えれば、いずれ私もハーバッドになれる！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170412
					],
					"speakerTitle": "アラニ"
				}
			]
		},
