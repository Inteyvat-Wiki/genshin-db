			},
			"dialogs": [
				{
					"id": 700250101,
					"content": "こんにちは、旅人さん。依頼の達成状況はすでに確認しました。冒険者協会への貢献ありがとうございます！報酬を受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250102
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700250102,
					"content": "変わったヒルチャールを捕えることはできず、騒動の原因も分かりませんでしたが…野外の安全は保障できました。お疲れ様でした。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250103
					],
					"speakerTitle": "キャサリン"
				},
				{
					"id": 700250103,
					"content": "そういえば、エラ·マスクさんが図書館でお待ちしております。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "キャサリン"
				}
			]
		},
		{
			"id": 7002502,
			"completionStepIds": [
				7002502
