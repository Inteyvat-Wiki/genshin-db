				"points": []
			},
			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu…mimi tomo…うん…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250202,
					"content": "こんにちは？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika！！あっ…あなたたちだったの。驚かさないでよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250204,
					"content": "えっ、そっちがオイラたちを呼んだんだろ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700250212,
					"content": "ん？あら、あなたたちだったの。手伝いありがとう。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250205,
					"content": "ハンドブックの内容は正しかった？ヒルチャールと交流はできたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250206,
					"content": "簡単だった。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "よし、私の辞書にとって大きな一歩ね！人間とヒルチャールが共存できる論証がまた増えたわ！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250209,
					"content": "ただ惜しいのは、あのヒルチャールと会話できなかったことね…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250210,
					"content": "私の集めた材料からすると、あのヒルチャールは友達が欲しいだけなのかも。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250213,
					"content": "ちゃんと交流できなかったのは残念ね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250214,
					"content": "それと、これはお礼よ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250215,
					"content": "こんなに手伝わせてしまって申し訳ないわ。機会があればまた今度一緒に。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "エラ·マスク"
				},
				{
					"id": 700250211,
					"content": "なんだ、話せばわかるやつなのかもな…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "パイモン"
				},
				{
					"id": 700250207,
					"content": "やっぱり自分のやり方が好き。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				}
			]
		}
	]
