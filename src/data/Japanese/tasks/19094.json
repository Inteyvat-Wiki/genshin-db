			"dialogs": [
				{
					"id": 190940701,
					"content": "…ガイアって、ほんと「食えないやつ」だよね。でも、奢ってもらったお酒は本当に美味しかったよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940702
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 190940702,
					"content": "断れば良いのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940703
					]
				},
				{
					"id": 190940703,
					"content": "西風教会の合唱へのこだわりはよく知らないけど、でも大丈夫。本当に音楽が好きな人なら、ボクの力は必ず役に立つはずだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190940704,
						190940705
					],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 190940704,
					"content": "なんか大変そうだけど…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				},
				{
					"id": 190940706,
					"content": "えへへっ、ボクが幸せになれて、シスターも幸せになる——そのうえ聴衆まで幸せになれたら、いいこと尽くしでしょ？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "ウェンティ"
				},
				{
					"id": 190940705,
					"content": "本当にお酒で動いたわけじゃないの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190940706
					]
				}
			]
		},
