			"dialogs": [
				{
					"id": 728070401,
					"content": "こんにちは、「木南料亭」へようこそ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070402
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070402,
					"content": "鎌治が予約したお菓子について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070403
					]
				},
				{
					"id": 728070403,
					"content": "ああ、鎌治さんが予約したお菓子ならもう準備してあるよ。今渡すね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070404
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070404,
					"content": "でも、鎌治さんはこれを誰に届けようとしてるんだろう…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070405
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070405,
					"content": "公家の間のやり取りだよ、木南さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070406
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070406,
					"content": "以前、柊慎介様が父に良質な茶を届けてくれたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070407
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070407,
					"content": "父は柊慎介様のご令嬢である千里さんが、お菓子が好物なのを知ってたから、お礼としてこれを届けるようにって。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070408
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070408,
					"content": "だけど届けるまでに時間がかかりすぎたり、途中で崩れたりするのが心配だったから…この旅人さんにお願いして届けてもらうことにしたんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070409
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070409,
					"content": "木南さん、そのお菓子を見せてもらってもいいかな？見落としがないか確認したいから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070410
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070410,
					"content": "ああ、はい…どうぞ、ここに。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070411
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 728070411,
					"content": "確かにすべて揃ってる。ありがとう、木南さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070412
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070412,
					"content": "さあ、旅人、邪魔にならないように移動しよう。それともう一つ話したいことがある。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070413
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070413,
					"content": "これが「通行証」だよ、受け取ってくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070414
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070414,
					"content": "この通行証があれば、離島を自由に出入りできる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070415
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070415,
					"content": "ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070416
					]
				},
				{
					"id": 728070416,
					"content": "どういたしまして。この通行証があれば、お菓子を届ける時も順調にいくと思う。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070417
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070417,
					"content": "あっ…それとこの手紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070418
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070418,
					"content": "直筆の手紙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070419
					]
				},
				{
					"id": 728070419,
					"content": "そう。一番まともに書いたものを選んだ…柊さんが気を悪くしないといいんだけど。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070420
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070420,
					"content": "この手紙もお菓子と一緒に柊さんに届けてくれ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070421
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070421,
					"content": "またあそこに戻らないといけないの…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070422
					]
				},
				{
					"id": 728070422,
					"content": "あはは、この「通行証」があれば、自由に出入りができるよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070423
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070423,
					"content": "じゃあ旅人、このことは頼んだよ。僕は公務に戻る。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070424
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070424,
					"content": "はぁ、いつになったら直接会いに行けるのか…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九条鎌治"
				}
			]
		},
		{
