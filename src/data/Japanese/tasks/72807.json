				},
				{
					"id": 728070202,
					"content": "鎌治について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "鎌治坊ちゃん？坊ちゃんに何か？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070204,
					"content": "（手紙を見せる）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070205
					]
				},
				{
					"id": 728070205,
					"content": "柊千里さんからの手紙？これは…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070206,
					"content": "だけど、もしこの手紙が本当に柊千里さんのだったら…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "真田"
				},
				{
					"id": 728070207,
					"content": "やはり…直接鎌治坊ちゃんに聞いてみてくれ。最近はよく橋のほうで散歩してる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真田"
				}
			]
		},
		{
