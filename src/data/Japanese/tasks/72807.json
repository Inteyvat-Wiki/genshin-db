			},
			"dialogs": [
				{
					"id": 728070501,
					"content": "おかえりなさい、旅人さん。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070502
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070502,
					"content": "もう手紙を鎌治さんに渡されたようですね…「通行証」は手に入れましたか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070503,
						728070505
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070503,
					"content": "手に入れた、ありがとう。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070504
					]
				},
				{
					"id": 728070504,
					"content": "どういたしまして、これもすべて鎌治さんが通行証を手配してくれたおかげです。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070506
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070506,
					"content": "おや？これは、お菓子…それと…鎌治さんからの手紙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070507
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070507,
					"content": "あなたに届けさせたのですか？この「三色団子」…私のためにこんなものを用意してくれるなんて…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070508
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070508,
					"content": "旅人さん、ありがとうございます。このお菓子はじっくりと味わいたいと思います。この手紙も…きちんと読みます。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070509
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070509,
					"content": "お疲れ様でした。これを報酬として受け取ってください。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070510
					],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070510,
					"content": "今後も…お世話になります。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柊千里"
				},
				{
					"id": 728070505,
					"content": "これは鎌治からのもの。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070506
					]
				}
			]
		},
