					"九条鎌治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728070301,
					"content": "君は…ああ、国外から来た旅人か。どうしたの？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070302,
					"content": "柊千里さんの手紙について…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "この手紙、柊さんからの頼みで届けに来たのか？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070304,
					"content": "この筆跡、やはり彼女だ…よかった…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070305,
					"content": "届けに来てくれてありがとう、旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070306,
					"content": "柊さんの頼みなら、「通行証」の件は…しっかり手配しておくよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070307,
					"content": "だけど、少し準備する必要がある…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070308,
					"content": "こうしよう。君はさきに「木南料亭」に行って僕を待ってて。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070309,
					"content": "どうしてそこに？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "それは…ちょっと手伝ってほしいことがあるからだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070311,
					"content": "実は…僕もこの頃ずっと、柊さんに送りたいものがあったんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070312,
					"content": "木南さんのところでお菓子を買って、手紙と一緒に柊さんに届けようと思ったんだ。柊さんへの贈り物としてね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070313,
					"content": "だけど父さんに知られたら、叱られるかもしれない…どうやって届けようかと考えてた時に、君がやって来たんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070314,
					"content": "贈り物を届けるだけなのに。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "父さんは僕が柊さんとやり取りしてるのが気に入らないんだ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070316,
					"content": "もちろん父さんの考えも理解できる。僕は九条家の一族で、天領奉行の執行者の一人なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070317,
					"content": "そして、柊さんは勘定奉行、柊家の令嬢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070318,
					"content": "僕たちの関係が親密になると、他の者に言いがかりをつけられるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070319,
					"content": "確かにただの贈り物だけど、一部の人にとってはそんな簡単なものじゃないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070326,
					"content": "あはは、こんな込み入ったことを話しても意味なかったね。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070327,
					"content": "旅人、さきに「木南料亭」に行って僕を待ってて。僕は「通行証」を手配してくるから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070320,
					"content": "お父さんは厳しいの？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "父さんは…たしかに厳しい。だけど僕に、柊さんと連絡してほしくない気持ちも理解できる。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070322
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070322,
					"content": "僕は九条家の一族で、天領奉行の執行者の一人なんだから。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070323
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070323,
					"content": "そして、柊さんは勘定奉行、柊家の令嬢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070324
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070324,
					"content": "僕たちの関係が親密になると、他の者に言いがかりをつけられるかもしれない。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070325
					],
					"speakerTitle": "九条鎌治"
				},
				{
					"id": 728070325,
					"content": "確かにただの贈り物だけど、一部の人にとってはそんな簡単なものじゃないんだよ。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "九条鎌治"
				}
			]
